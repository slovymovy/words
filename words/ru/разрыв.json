{
    "word_family": [
        "разрывать",
        "разрывной",
        "рвать",
        "разорвать",
        "прорыв",
        "перерыв",
        "обрыв",
        "срыв",
        "надрыв"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3e92563e-4728-387f-8567-e12230bd3548",
                    "sense_definition": "Полное прекращение отношений между людьми, обычно сопровождающееся ссорой или конфликтом.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "social_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она очень тяжело переживала <разрыв> с любимым человеком.",
                            "target_lang_translations": {
                                "en": "She took the <breakup> with her beloved very hard.",
                                "de": "Sie hat die <Trennung> von ihrem geliebten Menschen sehr schwer verkraftet."
                            }
                        },
                        {
                            "text": "Их постоянные споры неизбежно вели к полному <разрыву> отношений.",
                            "target_lang_translations": {
                                "en": "Their constant arguments were inevitably leading to a complete <rupture> of relations.",
                                "de": "Ihre ständigen Streitigkeiten führten unvermeidlich zum vollständigen <Beziehungsbruch>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ссора",
                        "разлад",
                        "раскол"
                    ],
                    "common_phrases": [
                        "разрыв отношений",
                        "полный разрыв",
                        "разрыв с прошлым",
                        "инициатор разрыва"
                    ],
                    "target_lang_definitions": {
                        "en": "A complete end to a relationship or connection between people, usually accompanied by a quarrel or conflict.",
                        "de": "Ein vollständiges Ende einer Beziehung oder Verbindung zwischen Menschen, meist begleitet von einem Streit oder Konflikt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "breakup",
                                "target_lang_sense_clarification": "of a romantic or personal relationship"
                            },
                            {
                                "target_lang_word": "rupture",
                                "target_lang_sense_clarification": "formal; a breach of relations"
                            },
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "severing of ties"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Trennung",
                                "target_lang_sense_clarification": "allgemein für das Ende einer Beziehung"
                            },
                            {
                                "target_lang_word": "Beziehungsbruch",
                                "target_lang_sense_clarification": "formell; das Zerbrechen einer Beziehung"
                            },
                            {
                                "target_lang_word": "Bruch",
                                "target_lang_sense_clarification": "das abrupte Ende von Beziehungen oder Kontakten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cfef30e-a435-3827-a91f-eaff01a28f4d",
                    "sense_definition": "Свободное пространство, промежуток или отверстие между частями чего-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_gap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сквозь <разрыв> в облаках выглянуло яркое солнце.",
                            "target_lang_translations": {
                                "en": "Bright sun peeked through a <break> in the clouds.",
                                "de": "Durch eine <Lücke> in den Wolken kam die helle Sonne zum Vorschein."
                            }
                        },
                        {
                            "text": "Туристы заметили глубокий <разрыв> в скальной породе.",
                            "target_lang_translations": {
                                "en": "The tourists noticed a deep <gap> in the rock formation.",
                                "de": "Die Touristen bemerkten einen tiefen <Spalt> im Felsgestein."
                            }
                        }
                    ],
                    "synonyms": [
                        "промежуток",
                        "просвет"
                    ],
                    "antonyms": [
                        "соединение"
                    ],
                    "common_phrases": [
                        "разрыв в облаках",
                        "разрыв цепи",
                        "разрыв кольца"
                    ],
                    "target_lang_definitions": {
                        "en": "A free space, opening, or hole between parts of something.",
                        "de": "Ein freier Raum, eine Öffnung oder ein Loch zwischen Teilen von etwas."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gap",
                                "target_lang_sense_clarification": "space or opening between things"
                            },
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "opening in clouds or continuity"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Lücke",
                                "target_lang_sense_clarification": "allgemeiner Raum oder Zwischenraum"
                            },
                            {
                                "target_lang_word": "Spalt",
                                "target_lang_sense_clarification": "schmaler, länglicher Zwischenraum"
                            },
                            {
                                "target_lang_word": "Öffnung",
                                "target_lang_sense_clarification": "Durchlass oder Loch"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bcda076-66dd-3b09-90fc-e44d8c9413b8",
                    "sense_definition": "Существенная разница, несоответствие или дистанция между какими-либо показателями, уровнями или явлениями.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "abstract_gap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Экономисты отмечают растущий <разрыв> между богатыми и бедными слоями населения.",
                            "target_lang_translations": {
                                "en": "Economists note the growing <gap> between the rich and poor segments of the population.",
                                "de": "Ökonomen stellen eine wachsende <Kluft> zwischen den reichen und armen Bevölkerungsschichten fest."
                            }
                        },
                        {
                            "text": "Нам необходимо сократить <разрыв> в уровне знаний учеников.",
                            "target_lang_translations": {
                                "en": "We need to close the <gap> in the students' level of knowledge.",
                                "de": "Wir müssen die <Diskrepanz> im Wissensstand der Schüler verringern."
                            }
                        }
                    ],
                    "synonyms": [
                        "несоответствие"
                    ],
                    "common_phrases": [
                        "разрыв в доходах",
                        "технологический разрыв",
                        "разрыв цен",
                        "сократить разрыв"
                    ],
                    "target_lang_definitions": {
                        "en": "A significant difference, discrepancy, or distance between indicators, levels, or phenomena.",
                        "de": "Ein signifikanter Unterschied, eine Diskrepanz oder ein Abstand zwischen Indikatoren, Niveaus oder Phänomenen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gap",
                                "target_lang_sense_clarification": "disparity between groups, levels, or amounts"
                            },
                            {
                                "target_lang_word": "disparity",
                                "target_lang_sense_clarification": "inequality or difference"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Kluft",
                                "target_lang_sense_clarification": "großer, oft sozialer oder wirtschaftlicher Abstand"
                            },
                            {
                                "target_lang_word": "Diskrepanz",
                                "target_lang_sense_clarification": "Unterschied oder Widerspruch zwischen Werten"
                            },
                            {
                                "target_lang_word": "Abstand",
                                "target_lang_sense_clarification": "Differenz zwischen Werten oder Niveaus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49d35b36-3732-3b18-b82a-2a979053fa97",
                    "sense_definition": "Нарушение целостности предмета, материала или тканей организма под действием силы; повреждение.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_rupture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач диагностировал у спортсмена <разрыв> связок голеностопного сустава.",
                            "target_lang_translations": {
                                "en": "The doctor diagnosed the athlete with a <tear> of the ankle ligaments.",
                                "de": "Der Arzt diagnostizierte bei dem Sportler einen <Riss> der Sprunggelenksbänder."
                            }
                        },
                        {
                            "text": "Сильное давление воды вызвало <разрыв> старой трубы в подвале.",
                            "target_lang_translations": {
                                "en": "High water pressure caused the <rupture> of the old pipe in the basement.",
                                "de": "Der starke Wasserdruck verursachte einen <Bruch> des alten Rohrs im Keller."
                            }
                        }
                    ],
                    "synonyms": [
                        "разрывание",
                        "разлом"
                    ],
                    "antonyms": [
                        "срастание",
                        "соединение"
                    ],
                    "common_phrases": [
                        "разрыв связок",
                        "разрыв сердца",
                        "разрыв линии",
                        "разрыв шаблона"
                    ],
                    "target_lang_definitions": {
                        "en": "A violation of the integrity of an object, material, or body tissue under force; damage.",
                        "de": "Eine Verletzung der Integrität eines Objekts, Materials oder Körpergewebes durch Krafteinwirkung; Beschädigung."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rupture",
                                "target_lang_sense_clarification": "of organs, pipes, or vessels"
                            },
                            {
                                "target_lang_word": "tear",
                                "target_lang_sense_clarification": "of ligaments, muscles, or tissue"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Riss",
                                "target_lang_sense_clarification": "allgemeine Beschädigung durch Auseinanderreißen"
                            },
                            {
                                "target_lang_word": "Bruch",
                                "target_lang_sense_clarification": "bei Knochen oder starren Materialien"
                            },
                            {
                                "target_lang_word": "Ruptur",
                                "target_lang_sense_clarification": "medizinischer Fachbegriff für das Reißen von Gewebe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a77f118-c623-3161-87a2-72b8d85d7644",
                    "sense_definition": "Взрыв боеприпаса (снаряда, мины, бомбы) и звук, сопровождающий это действие.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "explosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Солдаты залегли в окопы, услышав громкий <разрыв> снаряда неподалёку.",
                            "target_lang_translations": {
                                "en": "The soldiers lay down in the trenches upon hearing the loud <burst> of a shell nearby.",
                                "de": "Die Soldaten gingen in den Schützengräben in Deckung, als sie in der Nähe eine laute <Explosion> hörten."
                            }
                        },
                        {
                            "text": "На месте <разрыва> мины образовалась глубокая воронка.",
                            "target_lang_translations": {
                                "en": "A deep crater formed at the site of the mine <explosion>.",
                                "de": "An der Stelle des <Einschlags> der Mine bildete sich ein tiefer Krater."
                            }
                        }
                    ],
                    "synonyms": [
                        "взрыв"
                    ],
                    "common_phrases": [
                        "разрыв снаряда",
                        "точка разрыва",
                        "глухой разрыв"
                    ],
                    "target_lang_definitions": {
                        "en": "The explosion of a projectile (shell, mine, bomb) and the sound accompanying this action.",
                        "de": "Die Explosion eines Geschosses (Granate, Mine, Bombe) und das damit verbundene Geräusch."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "explosion",
                                "target_lang_sense_clarification": "violent release of energy"
                            },
                            {
                                "target_lang_word": "burst",
                                "target_lang_sense_clarification": "of a shell or projectile"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Explosion",
                                "target_lang_sense_clarification": "allgemeine Detonation"
                            },
                            {
                                "target_lang_word": "Einschlag",
                                "target_lang_sense_clarification": "das Auftreffen und Detonieren eines Geschosses"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1df33890-473e-3a4b-b10c-229c280487e9",
                    "sense_definition": "Деепричастие прошедшего времени от глагола <w>разрыть</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<Разрыв> кучу старых бумаг, он наконец нашёл нужный документ.",
                            "target_lang_translations": {
                                "en": "<Having dug through> a pile of old papers, he finally found the necessary document.",
                                "de": "Nachdem er den Stapel alter Papiere <durchwühlt> hatte, fand er endlich das benötigte Dokument."
                            }
                        },
                        {
                            "text": "Собака, <разрыв> яму в саду, спрятала туда кость.",
                            "target_lang_translations": {
                                "en": "The dog, <having dug> a hole in the garden, hid a bone there.",
                                "de": "Der Hund hatte ein Loch im Garten <aufgewühlt> und dort einen Knochen versteckt."
                            }
                        }
                    ],
                    "synonyms": [
                        "разрывши"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gerund of разрыть"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past adverbial participle (gerund) of the verb 'to dig up' (разрыть).",
                        "de": "Partizip Perfekt des Verbs 'aufwühlen' oder 'durchwühlen'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "having dug up",
                                "target_lang_sense_clarification": "action completed in the past"
                            },
                            {
                                "target_lang_word": "having dug through",
                                "target_lang_sense_clarification": "searching by digging"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "aufgewühlt",
                                "target_lang_sense_clarification": "durch Graben an die Oberfläche gebracht"
                            },
                            {
                                "target_lang_word": "durchwühlt",
                                "target_lang_sense_clarification": "durch Graben durchsucht"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}