                "senses": [
                    {
                        "sense_id": "9eeac0a3-b714-335b-ab57-42aa1c90613e",
                        "entry_id": "87c67e81-6f0d-3951-84a5-beddebe98748",
                        "glosses": [
                            "(auch übertragen) beim Bearbeiten von etwas als Abfall anfallende Stückchen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "60d2b505-04af-43fc-8a2e-e51f2fdc1eaf",
                                "sense_id": "9eeac0a3-b714-335b-ab57-42aa1c90613e",
                                "text": "Dies ist nur Abgängsel von dem Stoff, den wir bearbeitet haben."
                            },
                            {
                                "example_id": "2c66a48d-8b48-44ce-bac1-8bebaac7c8f8",
                                "sense_id": "9eeac0a3-b714-335b-ab57-42aa1c90613e",
                                "text": "„Wir haben heute Masken, Schatten und Abgängsel von Dichtern, die neuen Dichter und Philosophen sind echtestenfalls Goldschläger, Vergolder und Ziseleure ….“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
