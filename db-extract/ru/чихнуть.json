                                        "glosses": [
                                            "Expirer violemment, avec un mouvement convulsif des muscles, à la fois par le nez et par la bouche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74aec4ff-ad8b-42aa-9ec2-ecc836569c5a",
                                                "sense_id": "0333c00f-4edf-345d-885f-08ee714721ef",
                                                "text": "Il éternue souvent."
                                            },
                                            {
                                                "example_id": "ee97ccfa-d116-4cdb-b0d6-13feedc8cc28",
                                                "sense_id": "0333c00f-4edf-345d-885f-08ee714721ef",
                                                "text": "Nous ne restons pas très longtemps parce que la poussière nous fait bientôt éternuer et pique nos yeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c755092d-c0e3-31e7-b945-936a780edd0b",
