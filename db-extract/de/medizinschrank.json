                ],
                "senses": [
                    {
                        "sense_id": "dfe76aab-4774-33b0-b547-ac0771e39cc0",
                        "entry_id": "75b8fd91-1f24-32c2-b43b-a500c889ce96",
                        "glosses": [
                            "ein (vor unbefugtem Zugriff gesicherter) Schrank zur Aufbewahrung von Medikamenten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a616dec6-30a6-41b7-9136-2f7f637f27c2",
                                "sense_id": "dfe76aab-4774-33b0-b547-ac0771e39cc0",
                                "text": "Gedopt wird mit allem, was der Medizinschrank hergibt – und vielem mehr."
                            },
                            {
                                "example_id": "ffca766e-9ad5-4ed8-acfa-4b3d8240f82a",
                                "sense_id": "dfe76aab-4774-33b0-b547-ac0771e39cc0",
                                "text": "Mit wichtiger Kennermiene befühlte er das geschwollene Handgelenk und drückte und knutschte daran herum, daß mir ganz blümerant wurde; dann holte er aus seinem »Medizinschrank« etwas zum Einreiben und etwas zum Schmieren."
                            },
                            {
                                "example_id": "733a0041-e7f2-4c79-b4af-313cc6ef7a04",
                                "sense_id": "dfe76aab-4774-33b0-b547-ac0771e39cc0",
                                "text": "Falls Sie nicht wissen, wie Sie Ihren Medizinschrank ausstatten oder was Sie darin aufbewahren sollten, fragen Sie ihren Arzt oder Apotheker."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "00e535d5-6091-3080-9fe5-763ebb177870",
                        "entry_id": "75b8fd91-1f24-32c2-b43b-a500c889ce96",
                        "glosses": [
                            "eine Quelle oder ein Fundus für Heilmittel oder Heilmethoden"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "d7f9eb6c-81c9-4c7b-b8ba-1749a146d832",
                                "sense_id": "00e535d5-6091-3080-9fe5-763ebb177870",
                                "text": "Man kann die Regenwaldnatur mit gewisser Berechtigung als zukünftigen Medizinschrank des Menschen begreifen."
                            },
                            {
                                "example_id": "132f036e-b525-425b-b01c-8054a385d80f",
                                "sense_id": "00e535d5-6091-3080-9fe5-763ebb177870",
                                "text": "Er möchte Cannabis in den Medizinschrank zurückholen und dafür in der Ärzteschaft eine Lobby gewinnen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d913785b-9531-462b-ace1-56afb4e7e28e",
                        "source_entry_id": "75b8fd91-1f24-32c2-b43b-a500c889ce96",
                        "source_sense_id": "dfe76aab-4774-33b0-b547-ac0771e39cc0",
                        "source_sense_description": "ein (vor unbefugtem Zugriff gesicherter) Schrank zur Aufbewahrung von Medikamenten",
                        "target_lang_word": "armoire à pharmacie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "armoire à pharmacie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d270104e-26ee-3c9b-bfc1-f8a48ecac6f1",
                                        "entry_id": "da927b15-dd54-346d-ad56-8939dd3087dd",
                                        "glosses": [
                                            "Meuble destiné à entreposer des médicaments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc604398-ea46-4dc8-98b4-f9210f4e16f0",
                                                "sense_id": "d270104e-26ee-3c9b-bfc1-f8a48ecac6f1",
                                                "text": "Ah ! La voilà, dans l’armoire à pharmacie, derrière les boîtes de sulfamides."
                                            },
                                            {
                                                "example_id": "c82a3291-198a-4a2d-befc-27aa2ae80e60",
                                                "sense_id": "d270104e-26ee-3c9b-bfc1-f8a48ecac6f1",
                                                "text": "Le paracétamol, antalgique star des armoires à pharmacie familiales et des trousses de secours, a le don de provoquer des réactions enfiévrées. Il faut dire que les Français en avalent chaque année des quantités impressionnantes."
                                            },
                                            {
                                                "example_id": "a4103777-208e-49f4-8c98-8305f8849a61",
                                                "sense_id": "d270104e-26ee-3c9b-bfc1-f8a48ecac6f1",
                                                "text": "Dans l'appartement vide de sa mère, elle prend un bain, fouille dans l'armoire à pharmacie pour trouver de l'Aspirine. C'est plein de calmants, sa mère en prend tout le temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
