                "senses": [
                    {
                        "sense_id": "7b343a36-72ce-3674-97d7-629f227b6c67",
                        "entry_id": "b4f6e95f-b5cb-3ffa-960e-a86297868d83",
                        "glosses": [
                            "waarbij geweld gebruikt wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3d26d8-9c4b-4648-97ab-01ea4cc89bc5",
                                "sense_id": "7b343a36-72ce-3674-97d7-629f227b6c67",
                                "text": "De politie trachtte op een gewelddadige wijze de bezetting van het plein te beëindigen."
                            },
                            {
                                "example_id": "16734c25-0c12-4863-9657-6be043946b3c",
                                "sense_id": "7b343a36-72ce-3674-97d7-629f227b6c67",
                                "text": "Onze complete misdadigheid beperkte zich tot onwettig affiches ophangen, demonstreren zonder politietoestemming, ongehoorzaamheid ten opzichte van de politie, scheldwoorden ((belediging') gericht tegen dezelfde politie gepaard aan gewelddadig verzet wanneer de agenten optraden tegen de scheldwoorden."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ba079e2-3087-3194-9fe1-f6af71705075",
                        "entry_id": "b4f6e95f-b5cb-3ffa-960e-a86297868d83",
                        "glosses": [
                            "geneigd geweld te gebruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c4e215f-9e8e-4a34-adfd-5e85a92d5472",
                                "sense_id": "0ba079e2-3087-3194-9fe1-f6af71705075",
                                "text": "Hij stond bekend als een gewelddadig man."
                            }
                        ]
                    }
                ],
