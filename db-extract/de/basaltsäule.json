                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf9b047f-7308-494b-aa26-9b6c0aab9826",
                                "sense_id": "0cc59067-420b-329b-a240-ee1769ec2240",
                                "text": "„Dieses Ufer von fremdartiger Schönheit besteht aus einer langen Reihe fast 10 m hoher Basaltsäulen, über denen basaltene Architrave liegen, die zum Wasser hin leicht vorspringen.“"
                            },
                            {
                                "example_id": "f3efe920-d5c0-47cb-9a60-6fdf18415275",
                                "sense_id": "0cc59067-420b-329b-a240-ee1769ec2240",
                                "text": "„Dann sprach ich mit dem bärtigen Mann und berichtete ihm von meinem neuen Verlangen, nach dem fernen Cathuria zu reisen, das noch kein Mensch je gesehen hat, das jedoch alle jenseits der Basaltsäulen des Westens vermuten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
