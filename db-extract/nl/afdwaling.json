                                            {
                                                "example_id": "3b74e7ce-7f72-4454-9d81-0eda4da4a6c3",
                                                "sense_id": "98d61a83-9d89-34c2-8bf9-cd7216ffb20c",
                                                "text": "This was the time when Venerable Master Hsing Yun first arrived in Taiwan as a wandering monk and was refused lodgings. He was nearly reduced to begging on the street. Fortunately, the old Venerable Miaoguo of Yuanguang Temple in Chungli took him in."
                                            }
