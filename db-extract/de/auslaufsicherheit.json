                "senses": [
                    {
                        "sense_id": "3a3c37c8-875f-30b9-b43b-66b4e8d7a899",
                        "entry_id": "f8299cf9-8614-3d06-9319-af616814cb34",
                        "glosses": [
                            "Schutz gegen unerwünschten Austritt von Flüssigkeit, zum Beispiel bei Batterien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5c57aa9-3d43-4b10-9332-0974a316c07f",
                                "sense_id": "3a3c37c8-875f-30b9-b43b-66b4e8d7a899",
                                "text": "„Die Kapselung der Einzelzellen im 9V-Pack erhöht die Auslaufsicherheit, reduziert aber die Packungsdichte und damit die Kapazität.“"
                            },
                            {
                                "example_id": "8403a880-4ca1-4183-9d2c-3c7822f76212",
                                "sense_id": "3a3c37c8-875f-30b9-b43b-66b4e8d7a899",
                                "text": "„Wenn Wasserstoff ausgast ist die Auslaufsicherheit und die Lagerfähigkeit der Batterie gefährdet und es besteht das Risiko dass die Batterie anschwillt.“"
                            },
                            {
                                "example_id": "164c9533-d3ae-4ed6-98a5-5cdb541af919",
                                "sense_id": "3a3c37c8-875f-30b9-b43b-66b4e8d7a899",
                                "text": "„Durch einen neuartigen Labyrinthdeckel wird die Auslaufsicherheit gewährleistet.“"
                            },
                            {
                                "example_id": "c6968cd7-5917-4cf1-815b-90f4e4fe8c6a",
                                "sense_id": "3a3c37c8-875f-30b9-b43b-66b4e8d7a899",
                                "text": "„Batterie mit einem zylindrischen Gehäuse, welches eine Anode, eine Kathode und einen Elektrolyten enthält, dadurch gekennzeichnet, dass ein Dichtungsring aus Kunststoff zur Erhöhung der Auslaufsicherheit vorgesehen ist.“"
                            }
                        ],
