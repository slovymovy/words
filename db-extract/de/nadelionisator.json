                "senses": [
                    {
                        "sense_id": "b188b49d-09b5-3fa0-8b7b-ebfc9051f4e2",
                        "entry_id": "9be1d100-7089-3e04-84fe-cc6aa092a22f",
                        "glosses": [
                            "nadelförmiger Ionisator, der zur Ionisation der Luft und elektrostatischen Entladung verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "700b10ba-ba49-4342-8015-4d67fec3fdab",
                                "sense_id": "b188b49d-09b5-3fa0-8b7b-ebfc9051f4e2",
                                "text": "„Der Nadelionisator NI erzeugt positive und negative Ionen.“"
                            },
                            {
                                "example_id": "b6572d91-30af-4144-9d65-4532b3452a46",
                                "sense_id": "b188b49d-09b5-3fa0-8b7b-ebfc9051f4e2",
                                "text": "„Nadelionisatoren eignen sich besonders zur Entladung und Reinigung von schwer zugänglichen Materialoberflächen, wie z.B. Reinigen der Behälterinnenseiten von Kunststoffflaschen.“"
                            },
                            {
                                "example_id": "3850689d-d480-4dbf-98bd-5560d0f34056",
                                "sense_id": "b188b49d-09b5-3fa0-8b7b-ebfc9051f4e2",
                                "text": "„Sie sind eine optimale Lösung: Entladedorne und Nadelionisatoren tauchen in Gefäßöffnungen ab 4 mm Innendurchmesser ein und entfernen dort elektrostatische Ladungen.“"
                            },
                            {
                                "example_id": "dbc81b7c-879a-42c3-aafe-dfe4e23e0fd6",
                                "sense_id": "b188b49d-09b5-3fa0-8b7b-ebfc9051f4e2",
                                "text": "„Ein Nadelionisator war an der Einlaßmündungsplatte eines Rohrs mit einem Durchmesser von 2,5 cm angebracht, wobei die Nadel des Ionisators so angebracht war, daß die Spitze der Nadel in der Mündung zentriert war.“"
                            },
                            {
                                "example_id": "b0661259-bd58-43f4-a8bd-e1b1fddffb92",
                                "sense_id": "b188b49d-09b5-3fa0-8b7b-ebfc9051f4e2",
                                "text": "„Der Nadelionisator \"NI\" zur elektrostatischen Entladung in Spritzenkanülen oder Vials. Ganze Batterien von Nadelionisatoren können pro Vorschubtakt in mehrere Kanülen gleichzeitig eintauchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
