                        "glosses": [
                            "Stelle in einem Text"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44d23270-8ad7-40b5-a723-531ba555667e",
                                "sense_id": "36b9f66e-d439-33ec-a3da-eabee097b421",
