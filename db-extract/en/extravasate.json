                        "cross_references": [
                            {
                                "target_word": "extravaser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4e7daaf-b383-3438-8047-ef7283dbb194",
                                        "entry_id": "78f0d3eb-0357-3b0b-a8ef-9b3aa8ff59ee",
                                        "glosses": [
                                            "Se répandre hors des vaisseaux ou de leur emplacement normal, en parlant du sang ou d’un autre liquide présent dans le corps d’un animal ou dans une plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53d36130-e9d6-42fd-9407-a11271325c88",
                                                "sense_id": "c4e7daaf-b383-3438-8047-ef7283dbb194",
                                                "text": "Fils d’un tailleur de l’Houmeau, dédaigné par ses camarades de collège, Pierre Petit-Claud paraissait avoir une certaine portion de fiel extravasée dans le sang."
                                            },
                                            {
                                                "example_id": "f0d17f61-8447-4f81-bb7d-abc0e1063e91",
                                                "sense_id": "c4e7daaf-b383-3438-8047-ef7283dbb194",
                                                "text": "Je manquais de mémoire - plus encore de l'habitude d'une mémoire qui fut prégnante, à cran et à croc, apte à extravaser dans ma gorge, pour salive, le sang des moments vécus ensembles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "482b2706-637c-32bc-94a1-384e5a012587",
                                        "entry_id": "78f0d3eb-0357-3b0b-a8ef-9b3aa8ff59ee",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36c7ae9c-b373-4c39-afa8-696e428b615b",
                                                "sense_id": "482b2706-637c-32bc-94a1-384e5a012587",
                                                "text": "Tout ce que cette crise malsaine avait pour ainsi dire extravasé dans mes sentiments les plus purs, tout cela se dissipa comme par enchantement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95aefdc8-6b7a-3859-92dd-225f528382c9",
                                        "entry_id": "78f0d3eb-0357-3b0b-a8ef-9b3aa8ff59ee",
                                        "glosses": [
                                            "Se répandre hors d’un espace physique, d’un domaine en parlant du paysage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f169d62-67b6-4a94-b96d-443c682e38f8",
                                                "sense_id": "95aefdc8-6b7a-3859-92dd-225f528382c9",
                                                "text": "[…] quels sont les guichets par lesquels il (l’espace) s'extravase à son tour et s'ouvre sur les lointains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
