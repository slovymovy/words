                        ],
                        "examples": [
                            {
                                "example_id": "5099dc11-a5cb-464c-8f6e-fa14998df4e6",
                                "sense_id": "3dc7dfba-086f-3a4f-b8d6-a184da4c3d0a",
                                "text": "Alle Graduationen und Peripetien der Liebe, Eifersucht und Trauer, Erschöpfung und Ekstase, sind bei dem Geizigen in der Sparsucht, beim Sammler in der Sammelwut gespiegelt, denn jede absolute Vollkommenheit vereinigt die Summe der Gefühlsmöglichkeiten."
                            }
                        ]
                    }
