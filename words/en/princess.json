{
    "word_family": [
        "prince",
        "princely",
        "principality",
        "princedom"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f087d0d-ae03-3251-930b-61a9a8cd1a2f",
                    "sense_definition": "A daughter or granddaughter of a monarch, such as a king or queen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "royalty_member",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>princess</w> waved to the crowd from the castle balcony.",
                            "target_lang_translations": {
                                "ru": "<w>Принцесса</w> помахала толпе с балкона замка.",
                                "zh": "<w>公主</w>在城堡阳台上向人群挥手。"
                            }
                        },
                        {
                            "text": "In the fairy tale, the <w>princess</w> had to sleep on a mattress with a pea underneath.",
                            "target_lang_translations": {
                                "ru": "В сказке <w>принцессе</w> пришлось спать на матрасе, под который положили горошину.",
                                "zh": "在童话故事里，<w>公主</w>必须睡在垫着一颗豌豆的床垫上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fairy tale princess",
                        "Disney princess",
                        "little princess"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дочь или внучка монарха, например короля или королевы.",
                        "zh": "君主（如国王或女王）的女儿或孙女。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принцесса",
                                "target_lang_sense_clarification": "дочь короля"
                            },
                            {
                                "target_lang_word": "царевна",
                                "target_lang_sense_clarification": "дочь царя или героиня сказок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公主",
                                "target_lang_sense_clarification": "君主的女儿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7b1bd7a-87c3-30ea-9911-1e5c3296c97c",
                    "sense_definition": "The wife of a prince, or the female ruler of a principality.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "royalty_member",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the royal wedding, she officially became a <w>princess</w>.",
                            "target_lang_translations": {
                                "ru": "После королевской свадьбы она официально стала <w>принцессой</w>.",
                                "zh": "皇家婚礼后，她正式成为了<w>王妃</w>。"
                            }
                        },
                        {
                            "text": "The <w>princess</w> governs her small nation with great dedication.",
                            "target_lang_translations": {
                                "ru": "<w>Принцесса</w> управляет своим маленьким народом с большой самоотдачей.",
                                "zh": "这位<w>女大公</w>以极大的奉献精神治理着她的小国。"
                            }
                        }
                    ],
                    "antonyms": [
                        "prince"
                    ],
                    "common_phrases": [
                        "Crown Princess",
                        "Princess of Wales"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жена принца или правительница княжества.",
                        "zh": "王子的妻子，或公国的女性统治者。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принцесса",
                                "target_lang_sense_clarification": "жена принца"
                            },
                            {
                                "target_lang_word": "княгиня",
                                "target_lang_sense_clarification": "жена князя или правительница"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "王妃",
                                "target_lang_sense_clarification": "王子的妻子"
                            },
                            {
                                "target_lang_word": "女大公",
                                "target_lang_sense_clarification": "公国的女性统治者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f06f9fab-cb72-33d7-bf74-942e87c65d79",
                    "sense_definition": "An affectionate term used to address a young girl.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "endearment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Come here, my little <w>princess</w>, it is time for your bedtime story.",
                            "target_lang_translations": {
                                "ru": "Иди сюда, моя маленькая <w>принцесса</w>, пора читать сказку на ночь.",
                                "zh": "过来，我的<w>小公主</w>，该听睡前故事了。"
                            }
                        },
                        {
                            "text": "Her father always treated her like a <w>princess</w> and bought her everything she wanted.",
                            "target_lang_translations": {
                                "ru": "Отец всегда относился к ней как к <w>принцессе</w> и покупал ей всё, что она хотела.",
                                "zh": "她父亲总是把她当<w>小公主</w>一样宠着，要什么买什么。"
                            }
                        }
                    ],
                    "synonyms": [
                        "darling",
                        "sweetie"
                    ],
                    "common_phrases": [
                        "daddy's princess",
                        "my little princess"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a term of endearment"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ласковое обращение к девочке.",
                        "zh": "对小女孩的亲昵称呼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принцесса",
                                "target_lang_sense_clarification": "ласковое обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小公主",
                                "target_lang_sense_clarification": "对女孩的爱称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae4cf061-1f16-3da3-82f3-828941125830",
                    "sense_definition": "A girl or woman who is considered vain, spoiled, or demanding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop acting like a <w>princess</w> and help us clean up the kitchen.",
                            "target_lang_translations": {
                                "ru": "Хватит вести себя как <w>принцесса</w> и помоги нам убраться на кухне.",
                                "zh": "别再摆<w>娇小姐</w>的架子了，快来帮我们打扫厨房。"
                            }
                        },
                        {
                            "text": "She can be such a <w>princess</w> when she does not get her way immediately.",
                            "target_lang_translations": {
                                "ru": "Она бывает такой <w>принцессой</w>, когда не получает желаемого сию же минуту.",
                                "zh": "当事情没能如她所愿时，她简直就是个<w>娇小姐</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "diva",
                        "prima donna",
                        "brat"
                    ],
                    "common_phrases": [
                        "such a princess",
                        "acting like a princess"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "pejorative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Девушка или женщина, которую считают тщеславной, избалованной или требовательной.",
                        "zh": "被认为虚荣、被宠坏或挑剔的女孩或女人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принцесса",
                                "target_lang_sense_clarification": "иронично о капризной девушке"
                            },
                            {
                                "target_lang_word": "царевна",
                                "target_lang_sense_clarification": "о высокомерной девушке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "娇小姐",
                                "target_lang_sense_clarification": "讽刺被宠坏的女性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57fc5558-d470-3dbe-b1cd-f5d72d39de0e",
                    "sense_definition": "A woman who is highly successful or prominent in a particular field, especially entertainment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was widely known as the <w>princess</w> of pop music during the late nineties.",
                            "target_lang_translations": {
                                "ru": "В конце девяностых она была широко известна как поп-<w>принцесса</w>.",
                                "zh": "九十年代末，她被公认为流行音乐界的<w>天后</w>。"
                            }
                        },
                        {
                            "text": "The media crowned the young actress the new <w>princess</w> of Hollywood.",
                            "target_lang_translations": {
                                "ru": "СМИ окрестили молодую актрису новой <w>принцессой</w> Голливуда.",
                                "zh": "媒体将这位年轻女演员誉为好莱坞的新晋<w>天后</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pop princess"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "journalistic or informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женщина, добившаяся большого успеха или известности в определенной области, особенно в сфере развлечений.",
                        "zh": "在特定领域（尤其是娱乐界）取得巨大成功或声名显赫的女性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принцесса",
                                "target_lang_sense_clarification": "звезда, знаменитость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天后",
                                "target_lang_sense_clarification": "领域内的杰出女性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e0ff42e7-c893-3cdd-b1e4-27cf17f0d2f9",
                    "sense_definition": "A female given name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Princess</w> is coming over for dinner tonight.",
                            "target_lang_translations": {
                                "ru": "Моя подруга <w>Принцесса</w> придет сегодня на ужин.",
                                "zh": "我的朋友<w>普林塞斯</w>今晚要来吃晚饭。"
                            }
                        },
                        {
                            "text": "People often ask if <w>Princess</w> is her real name or just a nickname.",
                            "target_lang_translations": {
                                "ru": "Люди часто спрашивают, настоящее ли это имя — <w>Принцесса</w>, или просто прозвище.",
                                "zh": "人们常问<w>普林塞斯</w>是她的真名还是绰号。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "zh": "女性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Принцесса",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普林塞斯",
                                "target_lang_sense_clarification": "音译名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}