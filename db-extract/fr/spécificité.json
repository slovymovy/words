                "forms": [
                    {
                        "form_id": "6f593d98-a9ce-4b72-8fc5-be3c61d1c43e",
                        "entry_id": "d3b9019b-5734-301d-ac3a-76d3189cb88d",
                        "tags": [
                            "plural"
                        ],
                        "form": "spécificités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "328790f7-1e10-30c8-be95-5e711dfad9a9",
                        "entry_id": "d3b9019b-5734-301d-ac3a-76d3189cb88d",
                        "glosses": [
                            "Caractère spécifique de quelque chose ; caractère qui lui est propre spécialement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5e6b049-2d09-4e33-8594-1e3d3efe44ba",
                                "sense_id": "328790f7-1e10-30c8-be95-5e711dfad9a9",
                                "text": "Dans le passage de l’oral à l’écrit, la spécificité du messager s'efface derrière celle du message. Peut-être y perd-on en spontanéité, mais on y gagne en cohérence, celle précisément d'une forme littéraire."
                            },
                            {
                                "example_id": "a0d1a5ff-a9bf-4263-b097-2f89c96888e0",
                                "sense_id": "328790f7-1e10-30c8-be95-5e711dfad9a9",
                                "text": "Avec l’utilisation d’antigènes de tréponèmes pâles tués, les réactions sérologiques ont vu leur sensibilité et leur spécificité nettement améliorées."
                            },
                            {
                                "example_id": "82652eed-de93-4431-ab3f-216464d77c15",
                                "sense_id": "328790f7-1e10-30c8-be95-5e711dfad9a9",
                                "text": "Le dextran est inerte et, à cause de sa taille, ne peut diffuser d’une cellule à l’autre, ce qui permet à cette substance de remplir deux des conditions d’un bon marqueur cellulaire, la spécificité et l’innocuité."
                            }
                        ]
                    },
                    {
                        "sense_id": "68fe6b91-add3-3f1d-a711-03a68c134645",
                        "entry_id": "d3b9019b-5734-301d-ac3a-76d3189cb88d",
                        "glosses": [
                            "Probabilité, dans un test binaire, d'identifier correctement un vrai négatif."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe902b88-ba85-44d7-931e-3d38e8b5ca20",
                        "source_entry_id": "d3b9019b-5734-301d-ac3a-76d3189cb88d",
                        "source_sense_description": "Caractère spécifique de quelque chose",
                        "target_lang_word": "Besonderheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besonderheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d94ff0f7-12cc-3da9-b948-1d0e11475341",
                                        "entry_id": "0174f0da-4953-31c7-8ca4-8f5c794de72b",
                                        "glosses": [
                                            "besondere Eigenschaft, spezielles Merkmal von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ce5e4e-eb4c-4a5c-ab3b-c3f8e67d43ad",
                                                "sense_id": "d94ff0f7-12cc-3da9-b948-1d0e11475341",
                                                "text": "Die Besonderheit an Wikipedia ist, dass jeder die Inhalte der Seiten ändern kann."
                                            },
                                            {
                                                "example_id": "a9c65dd3-5597-4f1e-8151-df000231c162",
                                                "sense_id": "d94ff0f7-12cc-3da9-b948-1d0e11475341",
                                                "text": "Hohe Intelligenz, eine ausgeprägte Sprache und komplexe soziale Strukturen machen unter anderem die Besonderheiten des Menschen aus."
                                            },
                                            {
                                                "example_id": "4ebc00d3-cf67-4730-983b-81578f8b7f04",
                                                "sense_id": "d94ff0f7-12cc-3da9-b948-1d0e11475341",
                                                "text": "Die Besonderheit des Romans besteht in der Verwendung eines emotionalen und ausdrucksstarken Vokabulars."
                                            },
                                            {
                                                "example_id": "bd0917b3-e0b1-4075-9326-01d108223e98",
                                                "sense_id": "d94ff0f7-12cc-3da9-b948-1d0e11475341",
                                                "text": "Eine große Besonderheit des Mistkäfers ist, dass er über das Tausendfache seines eigenen Körpergewichtes befördern kann."
                                            },
                                            {
                                                "example_id": "0d10e8a2-b0f9-4bdf-8a41-a2bf8ef6956f",
                                                "sense_id": "d94ff0f7-12cc-3da9-b948-1d0e11475341",
                                                "text": "„Eine geologische Besonderheit ermöglichte in Rom und Latium die Anlage großer unterirdischer Friedhöfe.“"
                                            },
                                            {
                                                "example_id": "2f3146c8-b294-45b9-8bd1-c2597630f679",
                                                "sense_id": "d94ff0f7-12cc-3da9-b948-1d0e11475341",
                                                "text": "„Eine Besonderheit der Europawahl ist, dass sie von den 27 Mitgliedsstaaten nicht einheitlich organisiert wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bee85f4c-6b26-436b-b238-02d2bd96afba",
                        "source_entry_id": "d3b9019b-5734-301d-ac3a-76d3189cb88d",
