                        "examples": [
                            {
                                "example_id": "6a2cfe89-df3a-4a64-8147-7dbd766bf483",
                                "sense_id": "ba4961e4-72d7-3dac-af84-daa87dfddc4c",
                                "text": "Parmi les antilopes galopaient cinq loups des tropiques, qu’on appelle les loups-peints, et qui sont les pires ennemis des herbivores sans défense."
                            },
                            {
                                "example_id": "557bd094-9e25-4b4b-8b39-d91b53d908f7",
                                "sense_id": "ba4961e4-72d7-3dac-af84-daa87dfddc4c",
                                "text": "Les Lycaons, Cynhyènes ou Loups-peints, que les Anglais nomment « Loups chasseurs », sont des canidés sauvages propres à l’Afrique, et particulièrement à l’Afrique du Sud."
                            }
                        ]
                    }
