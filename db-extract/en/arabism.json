                "senses": [
                    {
                        "sense_id": "647e25cf-050a-3d89-931d-227cee150f9b",
                        "entry_id": "be77eb54-4bca-3dfd-8e5d-e2c4a873005b",
                        "glosses": [
                            "An idiom characteristic of the Arabic language."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7899446b-2763-4de2-a20d-d5f2c1ce836d",
                                "sense_id": "647e25cf-050a-3d89-931d-227cee150f9b",
                                "text": "The translator, Joseph-Charles Mardrus, knew Arabic and he used some Arabic texts as the basis of his rewriting of the collection of ancient Eastern tales which he titled, in a daring Arabism in French, Les Mille Nuits et Une Nuit […]"
                            },
                            {
                                "example_id": "0b5e9733-22a8-49d0-957d-7b4f06a8b02b",
                                "sense_id": "647e25cf-050a-3d89-931d-227cee150f9b",
                                "text": "Arabisms, properly speaking, occur only as it respects form, in a few words; and this, it is probable, is only the result of negligent transcription. The Arabic language never exercised any predominating influence over the Hebrew."
                            }
                        ]
                    }
                ],
