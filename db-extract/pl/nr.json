                "translations": [
                    {
                        "translation_id": "6a094324-e5fb-4a81-891e-26a8256f5e7f",
                        "source_entry_id": "8424ee6a-05f8-3610-a5d4-ad1c2cf1be40",
                        "source_sense_id": "11e8a0c4-c4ab-3cd5-8563-801f5a6c3cef",
                        "target_lang_word": "No.",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "No.",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "572ba042-bd12-3072-ad35-c01afbef0884",
                                        "entry_id": "8cdb2632-e57e-3add-b701-cb616d7e7276",
                                        "glosses": [
                                            "Abbreviation of in number or to the number of."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c039e99b-237a-43e3-ae19-e181b43845ad",
                                                "sense_id": "572ba042-bd12-3072-ad35-c01afbef0884",
                                                "text": "They goe two months, & then bring forth a blind off-spring like bitches, nᵒ. eight or nine."
                                            },
                                            {
                                                "example_id": "1f6798a4-3676-4210-ab14-cbc167a54efc",
                                                "sense_id": "572ba042-bd12-3072-ad35-c01afbef0884",
                                                "text": "Take of Jujubes Nᵒ vi. that is, Six in number."
                                            },
                                            {
                                                "example_id": "ab7e31a1-fd70-445e-92f3-301514ca3564",
                                                "sense_id": "572ba042-bd12-3072-ad35-c01afbef0884",
                                                "text": "No., abbreviation of L. numero, ‘to the number of’."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "No.",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1cec78f-a168-34e4-89b0-7d07d82d5eac",
                                        "entry_id": "4137d360-8478-323a-a5f4-49d0d23ba02e",
                                        "glosses": [
                                            "Abbreviation of number."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8262b93d-23c7-4ca9-818b-1445e46c4ecd",
                                                "sense_id": "c1cec78f-a168-34e4-89b0-7d07d82d5eac",
                                                "text": "See Tab. of Birds, Nᵒ 28."
                                            },
                                            {
                                                "example_id": "58a576ce-2a67-427b-b521-b66502d67a03",
                                                "sense_id": "c1cec78f-a168-34e4-89b0-7d07d82d5eac",
                                                "text": "I am curious to see how the idea of the first No. of my projected work, strikes you."
                                            },
                                            {
                                                "example_id": "249cf977-9339-41da-a65e-0c8ecae86392",
                                                "sense_id": "c1cec78f-a168-34e4-89b0-7d07d82d5eac",
                                                "text": "It's No. 276 Coalporter Street."
                                            },
                                            {
                                                "example_id": "1945dd7d-97d7-4846-a765-6fda77f77bd3",
                                                "sense_id": "c1cec78f-a168-34e4-89b0-7d07d82d5eac",
                                                "text": "Red No. 3, red No. 40, blue No. 2 and green No. 3 all have been linked with cancer or tumors in animals. Other sources say red No. 40 and yellow No. 5 and No. 6 contain or may be contaminated with known carcinogens."
                                            },
                                            {
                                                "example_id": "0f472ea7-4be2-4546-8d94-f0100aa4c22b",
                                                "sense_id": "c1cec78f-a168-34e4-89b0-7d07d82d5eac",
                                                "text": "The king made a gift of No. 10 to his old Eton roommate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "448ae4f8-ab3e-431f-87ed-d596d192684f",
