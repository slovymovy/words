{
    "word_family": [
        "dweilen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cee3094d-0c85-31d2-ae9e-638474108eac",
                    "sense_definition": "Een stuk textiel dat nat wordt gebruikt om een gladde vloer schoon te maken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "schoonmaakgerei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Maak die <w>dweil</w> eerst eens schoon, anders verplaats je het vuil alleen maar.",
                            "target_lang_translations": {
                                "en": "Clean that <w>mop</w> first, otherwise you're just moving the dirt around."
                            }
                        },
                        {
                            "text": "Na het morsen van de limonade pakte ze direct de <w>dweil</w> uit de kast.",
                            "target_lang_translations": {
                                "en": "After spilling the lemonade, she immediately grabbed the <w>mop</w> from the closet."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwabber"
                    ],
                    "common_phrases": [
                        "natte dweil"
                    ],
                    "target_lang_definitions": {
                        "en": "A piece of fabric or an implement used wet to clean a smooth floor."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mop",
                                "target_lang_sense_clarification": "An implement for washing floors, made of cloth or yarn attached to a handle."
                            },
                            {
                                "target_lang_word": "floorcloth",
                                "target_lang_sense_clarification": "A cloth used for cleaning floors."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27be153b-34e3-32aa-9dc9-5db54c3ec2cf",
                    "sense_definition": "Iemand die slap of karakterloos overkomt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij durft nooit voor zijn eigen mening uit te komen, wat een <w>dweil</w>.",
                            "target_lang_translations": {
                                "en": "He never dares to stand up for his own opinion, what a <w>doormat</w>."
                            }
                        },
                        {
                            "text": "Laat je niet als een <w>dweil</w> behandelen door je baas.",
                            "target_lang_translations": {
                                "en": "Don't let your boss treat you like a <w>doormat</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Wordt vaak gebruikt als belediging."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who appears weak, spineless, or lacking character."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "doormat",
                                "target_lang_sense_clarification": "A person who allows others to treat them badly without complaining."
                            },
                            {
                                "target_lang_word": "spineless person",
                                "target_lang_sense_clarification": "Someone who lacks courage or strength of character."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "50f4d925-c4b3-35b3-bdea-2a8eee72b4d8",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>dweilen</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>dweil</w> elke zaterdag de hele woonkamer.",
                            "target_lang_translations": {
                                "en": "I <w>mop</w> the entire living room every Saturday."
                            }
                        },
                        {
                            "text": "Voordat de gasten komen, <w>dweil</w> ik nog even snel de keuken.",
                            "target_lang_translations": {
                                "en": "Before the guests arrive, I'll quickly <w>mop</w> the kitchen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vervoeging van het werkwoord dweilen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'dweilen' (to mop)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mop",
                                "target_lang_sense_clarification": "To clean a floor using a mop."
