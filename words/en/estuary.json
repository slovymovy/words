{
    "word_family": [
        "estuarine"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d7799db3-3505-3d41-92df-9ef59aeeb04b",
                    "sense_definition": "A wide part of a river where it nears the sea, and where fresh and salt water mix.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many species of migratory birds feed in the muddy waters of the river <w>estuary</w>.",
                            "target_lang_translations": {
                                "ru": "Многие виды перелётных птиц кормятся в мутных водах речного <w>эстуария</w>."
                            }
                        },
                        {
                            "text": "A shallow boat carried the researchers across the wide <w>estuary</w> towards the sea.",
                            "target_lang_translations": {
                                "ru": "Мелкосидящая лодка перевезла исследователей через широкое <w>устье</w> по направлению к морю."
                            }
                        }
                    ],
                    "synonyms": [
                        "firth",
                        "inlet"
                    ],
                    "common_phrases": [
                        "river estuary",
                        "tidal estuary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкая часть реки в месте её впадения в море, где пресная вода смешивается с солёной; воронкообразное устье реки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эстуарий",
                                "target_lang_sense_clarification": "воронкообразное устье реки"
                            },
                            {
                                "target_lang_word": "устье",
                                "target_lang_sense_clarification": "место впадения реки в море или океан"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "21b41ae0-c880-3568-bc7c-3378f4a7fc0a",
                    "sense_definition": "An English accent associated with London and the southeast of England, sharing features with Cockney and Received Pronunciation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "After living near London for a few years, he began to speak in a mild <w>Estuary</w> accent.",
                            "target_lang_translations": {
                                "ru": "Прожив несколько лет недалеко от Лондона, он заговорил с лёгким <w>эстуарным</w> акцентом."
                            }
                        },
                        {
                            "text": "Linguists often study the spread of <w>Estuary</w> among younger generations across the region.",
                            "target_lang_translations": {
                                "ru": "Лингвисты часто изучают распространение <w>эстуарного английского</w> среди молодого поколения в регионе."
                            }
                        }
                    ],
                    "synonyms": [
                        "Estuary English"
                    ],
                    "common_phrases": [
                        "speak Estuary",
                        "Estuary accent"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in the UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английский акцент или диалект, распространённый в Лондоне и на юго-востоке Англии (в бассейне реки Темзы)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эстуарный английский",
                                "target_lang_sense_clarification": "название диалекта/акцента"
                            },
                            {
                                "target_lang_word": "эстуарный акцент",
                                "target_lang_sense_clarification": "акцент долины Темзы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
