            {
                "entry_id": "913a36e1-e250-34f1-899e-e22f614a82ea",
                "word": "transformiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2705fbaa-bf06-4f3c-8aea-15759a3ee8a0",
