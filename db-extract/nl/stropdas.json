                                "target_senses": [
                                    {
                                        "sense_id": "9cae9799-7dbe-3c3f-acfc-f8fef53e54a6",
                                        "entry_id": "3b9dc490-9477-3445-9ba9-f4efb266a7f5",
                                        "glosses": [
                                            "schmales Stoffband, dass man um den Hals und Kragen bindet, meist zum Anzug getragen"
                                        ],
                                        "tags": [
                                            "Kleidungsstück"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26de4576-26a4-4108-9858-30e08c9be699",
                                                "sense_id": "9cae9799-7dbe-3c3f-acfc-f8fef53e54a6",
                                                "text": "Zu diesem Anzug trage ich heute eine dunkelblaue Krawatte."
                                            },
                                            {
                                                "example_id": "62b1f796-44c8-4cd8-9606-f1fac8a0dc2d",
                                                "sense_id": "9cae9799-7dbe-3c3f-acfc-f8fef53e54a6",
                                                "text": "\"Die xxx Krawatte sorgt für Farbenfreude im Leben des Mannes und drückt das Zeitgefühl durch Mode aus. Eine gut gewählte Krawatte reflektiert die positive Einstellung zum Leben.\""
                                            },
                                            {
                                                "example_id": "d17b0d28-377e-46bd-915d-7fe9095b6eb0",
                                                "sense_id": "9cae9799-7dbe-3c3f-acfc-f8fef53e54a6",
                                                "text": "„Es war die Zeit, als sich die Jugend an der Universität noch siezte, als Studenten Anzüge und Krawatten trugen und ihre Kommilitoninnen Kleider mit weißen Kragen oder Perlenketten.“"
                                            },
                                            {
                                                "example_id": "ee4906e6-0df3-4627-9956-65fd479c67eb",
                                                "sense_id": "9cae9799-7dbe-3c3f-acfc-f8fef53e54a6",
                                                "text": "„Papa kauft sich weder Fliegen noch Krawatten, alle Fliegen und Krawatten hat Mama für Papa gekauft.“"
                                            },
                                            {
                                                "example_id": "043cd090-91e5-460a-90a9-e3dcda066a67",
                                                "sense_id": "9cae9799-7dbe-3c3f-acfc-f8fef53e54a6",
                                                "text": "„Er lockerte seine Krawatte und grinste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bdef0b3-5470-4536-89b5-5f7bf6153db4",
                        "source_entry_id": "6b1e8135-d93f-36ad-8e6f-4e43e68d747a",
