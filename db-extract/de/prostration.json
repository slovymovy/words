                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a6e059-25b4-4da7-83fb-d407eb24b31d",
                                "sense_id": "73e0a499-d673-3468-8f58-cef1056b74e3",
                                "text": "„In Lhasa sah ich tibetische Mönche, die den weiten Weg von ihrem Dorf per Prostration zurückgelegt hatten: bäuchlings, sie also die Beine nur noch benutzten, um sich aufzurichten und ein weiteres Mal auf den Boden zu werfen.“"
                            }
                        ],
