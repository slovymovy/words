{
    "word_family": [
        "nobility",
        "noble",
        "nobly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d9c84946-4f0c-32fc-ae03-ceb04a3f4f69",
                    "sense_definition": "Not honorable or morally good; base.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt ashamed of his <w>ignoble</w> behavior during the argument.",
                            "target_lang_translations": {
                                "pl": "Wstydził się swojego <w>niecnego</w> zachowania podczas kłótni."
                            }
                        },
                        {
                            "text": "It was an <w>ignoble</w> act to betray his closest friend for money.",
                            "target_lang_translations": {
                                "pl": "Zdrada najbliższego przyjaciela dla pieniędzy była <w>niegodziwym</w> czynem."
                            }
                        }
                    ],
                    "synonyms": [
                        "base",
                        "vile",
                        "shameful",
                        "disgraceful"
                    ],
                    "antonyms": [
                        "noble",
                        "honorable"
                    ],
                    "target_lang_definitions": {
                        "pl": "Niehonorowy, niemoralny lub podły."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niecny",
                                "target_lang_sense_clarification": "odnoszący się do czynów niemoralnych lub haniebnych"
                            },
                            {
                                "target_lang_word": "niegodziwy",
                                "target_lang_sense_clarification": "charakteryzujący kogoś lub coś jako złe i nieuczciwe"
                            },
                            {
                                "target_lang_word": "nikczemny",
                                "target_lang_sense_clarification": "bardzo niski moralnie, podły"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfb69b7c-8d4e-3750-9feb-db4f7fe53422",
                    "sense_definition": "Not belonging to the nobility; common or plebeian.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king refused to marry a woman of <w>ignoble</w> birth.",
                            "target_lang_translations": {
                                "pl": "Król odmówił poślubienia kobiety <w>nieszlacheckiego</w> pochodzenia."
                            }
                        },
                        {
                            "text": "She was proud of her <w>ignoble</w> roots despite her current wealth.",
                            "target_lang_translations": {
                                "pl": "Była dumna ze swoich <w>plebejskich</w> korzeni pomimo obecnego bogactwa."
                            }
                        }
                    ],
                    "synonyms": [
                        "common",
                        "plebeian",
                        "vulgar"
                    ],
                    "antonyms": [
                        "noble"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in historical contexts regarding social class."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Niepochodzący ze szlachty; pospolity lub plebejski."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nieszlachecki",
                                "target_lang_sense_clarification": "nieposiadający pochodzenia szlacheckiego"
                            },
                            {
                                "target_lang_word": "plebejski",
                                "target_lang_sense_clarification": "związany z niższymi warstwami społecznymi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d32c81e2-b13d-3c7d-807e-60d8aaadfe7b",
                    "sense_definition": "Describing a chemical element that is highly reactive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scientific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sodium is considered an <w>ignoble</w> metal because it reacts violently with water.",
                            "target_lang_translations": {
                                "pl": "Sód jest uważany za metal <w>nieszlachetny</w>, ponieważ gwałtownie reaguje z wodą."
                            }
                        },
                        {
                            "text": "The <w>ignoble</w> element quickly oxidized when exposed to the open air.",
                            "target_lang_translations": {
                                "pl": "Ten <w>nieszlachetny</w> pierwiastek szybko utlenił się po wystawieniu na działanie powietrza."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Opisujący pierwiastek chemiczny, który jest wysoce reaktywny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nieszlachetny",
                                "target_lang_sense_clarification": "w chemii: metal łatwo wchodzący w reakcje chemiczne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73c321e6-3992-384d-97c0-c8c78935a9ed",
                    "sense_definition": "Not considered a true or noble falcon in traditional falconry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "falconry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The goshawk was traditionally classified as an <w>ignoble</w> bird for hunting.",
                            "target_lang_translations": {
                                "pl": "Jastrząb był tradycyjnie klasyfikowany jako <w>nieszlachetny</w> ptak łowczy."
                            }
                        },
                        {
                            "text": "Falconers often distinguished between noble falcons and <w>ignoble</w> hawks.",
                            "target_lang_translations": {
                                "pl": "Sokolnicy często rozróżniali szlachetne sokoły od <w>nieszlachetnych</w> jastrzębi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used specifically in the context of historical falconry."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "W dawnym sokolnictwie: ptak nieuważany za szlachetnego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nieszlachetny",
                                "target_lang_sense_clarification": "w dawnym sokolnictwie: ptak łowczy niższej rangi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8795633a-f045-3c5e-a964-d39e6f488b52",
                    "sense_definition": "To make someone or something appear or become ignoble.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "moral_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Such greed will only <w>ignoble</w> his reputation in the long run.",
                            "target_lang_translations": {
                                "pl": "Taka chciwość na dłuższą metę tylko <w>splami</w> jego reputację."
                            }
                        },
                        {
                            "text": "Do not let these petty squabbles <w>ignoble</w> your character.",
                            "target_lang_translations": {
                                "pl": "Nie pozwól, by te małostkowe kłótnie <w>poniżyły</w> twój charakter."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Sprawiać, że ktoś lub coś staje się niegodne lub traci szacunek."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "hańbić",
                                "target_lang_sense_clarification": "przynosić komuś wstyd lub ujmę"
                            },
                            {
                                "target_lang_word": "poniżać",
                                "target_lang_sense_clarification": "obniżać czyjąś godność lub wartość"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}