                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "düster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8494935-a35c-35f8-98fa-62d06b33979f",
                                        "entry_id": "5c5a9a8a-be95-362e-9aa0-40ebee8e7419",
                                        "glosses": [
                                            "schlecht beleuchtet, von wenig Licht erhellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "320a11a7-fd76-4472-b519-d08b0c4e2daf",
                                                "sense_id": "e8494935-a35c-35f8-98fa-62d06b33979f",
                                                "text": "In der Nacht ist es düster."
                                            },
                                            {
                                                "example_id": "c041e1ca-c757-4f9d-bbf9-64366c471aaf",
                                                "sense_id": "e8494935-a35c-35f8-98fa-62d06b33979f",
                                                "text": "Sie saßen in der düstersten Ecke des Lokals."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bd268946-2d47-3e9c-bad2-170b1dee6d0d",
                                        "entry_id": "5c5a9a8a-be95-362e-9aa0-40ebee8e7419",
                                        "glosses": [
                                            "schwer einzuschätzen, aber unheimlich bis bedrohlich gedeutet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "340e3872-bd56-4133-9446-11b9a3c698e3",
                                                "sense_id": "bd268946-2d47-3e9c-bad2-170b1dee6d0d",
                                                "text": "Die Prognose über den Kampfausgang ist düster."
                                            },
                                            {
                                                "example_id": "3635fb66-b987-4af8-8ebb-7c19d067427f",
                                                "sense_id": "bd268946-2d47-3e9c-bad2-170b1dee6d0d",
                                                "text": "Dort auf der anderen Straßenseite stehen ein Paar ganz düstere Gesellen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5c1decda-31e7-3c53-891f-ced5f13532ab",
                                        "entry_id": "5c5a9a8a-be95-362e-9aa0-40ebee8e7419",
                                        "glosses": [
                                            "voller negativer, schlimmer Gedanken/Befürchtungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c874cd91-01e0-4314-9c87-0d0b191056be",
                                                "sense_id": "5c1decda-31e7-3c53-891f-ced5f13532ab",
                                                "text": "Die Stimmung nach dem Unfall war düster."
                                            },
                                            {
                                                "example_id": "4cab750a-16d3-452d-a910-ad6c043b6a2c",
                                                "sense_id": "5c1decda-31e7-3c53-891f-ced5f13532ab",
                                                "text": "„Wer wissen will, wie es um die Natur wirklich bestellt ist, muss alle Insekten in den Blick nehmen. Und da sieht es düster aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "319d81ca-14ca-38e3-97b8-ed763cbb202e",
                                        "entry_id": "5c5a9a8a-be95-362e-9aa0-40ebee8e7419",
                                        "glosses": [
                                            "schwer einzuschätzen und deshalb undeutlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7b6c8d3-8064-4a35-a2bb-d1f92ef54671",
                                                "sense_id": "319d81ca-14ca-38e3-97b8-ed763cbb202e",
                                                "text": "Man hatte nur eine düstere Ahnung, was da kommen könnte."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "999ac1a4-2135-42d0-8527-e7aa71a3eb28",
                        "source_entry_id": "67f91962-6b73-3ec7-95e8-f08e84966f90",
                        "source_sense_id": "5f24d863-7594-37f1-95e9-89ee01feab75",
                        "target_lang_word": "finster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "finster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b311d43-3d29-3650-bc53-acb2bd984816",
                                        "entry_id": "06afc5f1-13b9-3f45-8047-fcccdd982397",
                                        "glosses": [
                                            "sehr dunkel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987bc6c9-1585-4adc-8507-ab837f354d23",
                                                "sense_id": "3b311d43-3d29-3650-bc53-acb2bd984816",
                                                "text": "Ein grausiger Schrei ertönte aus dem finsteren Wald."
                                            },
                                            {
                                                "example_id": "19f27712-d0d6-4c04-b1b7-10c9f01892c3",
                                                "sense_id": "3b311d43-3d29-3650-bc53-acb2bd984816",
                                                "text": "Eine finsterere Ecke hast du wohl nicht finden können? Hier sieht uns also bestimmt niemand."
                                            },
                                            {
                                                "example_id": "98c614af-9895-4f80-9d4d-6743d7ee4074",
                                                "sense_id": "3b311d43-3d29-3650-bc53-acb2bd984816",
                                                "text": "„… und wie mit des fernen Donnersgetose entstürzen sie schäumend dem finstern Schoße …“"
                                            },
                                            {
                                                "example_id": "fcb39978-011c-4a44-9330-0568b584bac4",
                                                "sense_id": "3b311d43-3d29-3650-bc53-acb2bd984816",
                                                "text": "Da sehen wir wohl einer finsteren Zukunft entgegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24d35a94-862d-3abc-9787-deb65d605f2f",
                                        "entry_id": "06afc5f1-13b9-3f45-8047-fcccdd982397",
                                        "glosses": [
                                            "bedrückt, pessimistisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b6c2a22-1378-46a8-83e7-b26c9d7a2def",
                                                "sense_id": "24d35a94-862d-3abc-9787-deb65d605f2f",
                                                "text": "Da sehen wir wohl einer finsteren Zukunft entgegen."
                                            },
                                            {
                                                "example_id": "7cc34cc8-cab7-441b-ab7b-be1f6d5cda93",
                                                "sense_id": "24d35a94-862d-3abc-9787-deb65d605f2f",
                                                "text": "Er blickte uns finster an."
                                            },
                                            {
                                                "example_id": "99f5a019-a6d6-4f44-8c3b-bbafdd956bee",
                                                "sense_id": "24d35a94-862d-3abc-9787-deb65d605f2f",
                                                "text": "Nicht weit vom Haus entfernt stand ein finsterer Geselle mit einer riesigen Schrotflinte und ballerte in der Gegend herum."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "10ca61fc-2762-3cdf-b884-3585c772a652",
                                        "entry_id": "06afc5f1-13b9-3f45-8047-fcccdd982397",
                                        "glosses": [
                                            "übel und rückständig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d29b81-aa7e-4163-beb4-5213bc9b76c1",
                                                "sense_id": "10ca61fc-2762-3cdf-b884-3585c772a652",
                                                "text": "Das kommt ja einem Rückfall in finstere, mittelalterliche Moralvorstellungen gleich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
