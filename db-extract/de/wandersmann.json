                "senses": [
                    {
                        "sense_id": "dd1552d8-ec60-3761-a42e-fc20344cf81e",
                        "entry_id": "7b964289-a7aa-333f-8568-cba7d04e3ad9",
                        "glosses": [
                            "veraltet: Mann auf Wanderschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "898bde46-97d5-48de-b9a7-10afb6d8a28c",
                                "sense_id": "dd1552d8-ec60-3761-a42e-fc20344cf81e",
                                "text": "Auf, du junger Wandersmann / Jetzo kommt die Zeit heran / Die Wanderzeit, die bringt uns Freud'. - (Volkslied)"
                            },
                            {
                                "example_id": "3ee14f1c-ef80-4d29-abf2-f5a006bf1a2b",
                                "sense_id": "dd1552d8-ec60-3761-a42e-fc20344cf81e",
                                "text": "„Da erwies es sich, daß der Mann keine Almosen wünschte, sondern ein Wandersmann unterwegs nach Skálholt war, der ein Anliegen in einer wichtigen Sache an die Herrin von Braedratunga hatte und bat, auszurichten, daß sie ihn erkennen würde, so sie ihn vorlassen wollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "daa16fe4-226a-338f-bc41-ed9ec2579e1e",
                        "entry_id": "7b964289-a7aa-333f-8568-cba7d04e3ad9",
                        "glosses": [
                            "scherzhaft: Mann auf einer Wanderung"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83891d90-302c-440f-aa8c-3672520c0d20",
                        "source_entry_id": "7b964289-a7aa-333f-8568-cba7d04e3ad9",
                        "source_sense_id": "dd1552d8-ec60-3761-a42e-fc20344cf81e",
                        "source_sense_description": "veraltet: Mann auf Wanderschaft",
                        "target_lang_word": "wayfarer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wayfarer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1d6cd72-6682-347c-92d9-f62d5bb6065c",
                                        "entry_id": "383c0f85-16c4-3b67-a61c-65f9234d1162",
                                        "glosses": [
                                            "A traveller, especially one on foot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14fc19a5-36ce-40f2-a5f2-65775e8c7604",
                                                "sense_id": "a1d6cd72-6682-347c-92d9-f62d5bb6065c",
                                                "text": "English travellers are sometimes found grumbling because the señor who keeps a wayside posada, or even a more pretentious inn in one of the towns, does not stand, hat in hand, bowing obsequiously to the wayfarer who deigns to use the accommodation provided."
                                            },
                                            {
                                                "example_id": "937ee97b-e90f-40b9-9f1b-de04436084aa",
                                                "sense_id": "a1d6cd72-6682-347c-92d9-f62d5bb6065c",
                                                "text": "ESTRAGON: That would be too bad, really too bad. (Pause.) Wouldn't it, Didi, be really too bad? (Pause.) When you think of the beauty of the way. (Pause.) And the goodness of the wayfarers. (Pause. Wheedling.) Wouldn't it, Didi?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c463e44-27d6-465c-bac0-ab6f274c2955",
                        "source_entry_id": "7b964289-a7aa-333f-8568-cba7d04e3ad9",
                        "source_sense_id": "dd1552d8-ec60-3761-a42e-fc20344cf81e",
                        "source_sense_description": "veraltet: Mann auf Wanderschaft",
                        "target_lang_word": "randonneurs",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "randonneurs",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31983f87-1b83-3443-85b3-bf16a96eb3c6",
                                        "entry_id": "0e06cc07-c374-34a3-b1c5-2bbc1a8a7859",
                                        "glosses": [
                                            "Pluriel de randonneur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "079c1d8d-56fe-4fe2-96a4-d26056f8f300",
                                                "sense_id": "31983f87-1b83-3443-85b3-bf16a96eb3c6",
                                                "text": "Après avoir parcouru avec mes amis randonneurs le trajet d’Hendaye au cirque de Gavarnie, ensemble nous attaquons en cette année 1987 le tronçon des Pyrénées centrales qui doit nous mener vers Bagnères-de-Luchon par la HRP, le massif de la Maladeta et le pic d’Aneto, point culminant des Pyrénées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
