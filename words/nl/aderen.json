                    "sense_id": "d7ed1789-4346-3594-a224-db78efdf36b1",
                    "sense_definition": "meervoud van <w>ader</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bloed stroomt door de <w>aderen</w> van het menselijk lichaam om zuurstof te vervoeren.",
                            "target_lang_translations": {
                                "en": "Blood flows through the <w>veins</w> of the human body to transport oxygen."
                            }
                        },
                        {
                            "text": "Toen hij boos werd, zag je de <w>aderen</w> in zijn nek duidelijk kloppen.",
                            "target_lang_translations": {
                                "en": "When he got angry, you could clearly see the <w>veins</w> in his neck throbbing."
                            }
                        }
                    ],
                    "synonyms": [
                        "aders",
                        "bloedvaten"
                    ],
                    "common_phrases": [
                        "bloed in de aderen",
                        "aderen in de nek"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of vein; blood vessels that carry blood toward the heart"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "veins",
                                "target_lang_sense_clarification": "plural of the blood vessel"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eeb2aef7-b3a6-3496-8807-1d2aca55de76",
                    "sense_definition": "voorzien van lijnen of patronen die lijken op aders, zoals bij marmer of hout",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "textuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kunstenaar probeerde het witte marmer voorzichtig te <w>aderen</w> met grijze verf.",
                            "target_lang_translations": {
                                "en": "The artist tried to carefully <w>vein</w> the white marble with grey paint."
                            }
                        },
                        {
                            "text": "Je kunt dit type gesteente prachtig <w>aderen</w> om een luxe uitstraling te creëren.",
                            "target_lang_translations": {
                                "en": "You can <w>grain</w> this type of rock beautifully to create a luxurious look."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to provide with lines or patterns resembling veins, such as in marble or wood"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vein",
                                "target_lang_sense_clarification": "to mark with a vein-like pattern"
                            },
                            {
                                "target_lang_word": "grain",
                                "target_lang_sense_clarification": "to texture a surface in imitation of wood or stone"
                            },
                            {
                                "target_lang_word": "marble",
                                "target_lang_sense_clarification": "to stain or vein in imitation of marble"
                            }
                        ]
                    }
                }
            ]
        }
    ]
