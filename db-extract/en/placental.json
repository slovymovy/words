                "entry_id": "c596d0eb-2177-37a7-99a7-c2a3e267df8b",
                "word": "placental",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9cd112b9-141c-3456-8802-ab2b1a6f5224",
                        "entry_id": "c596d0eb-2177-37a7-99a7-c2a3e267df8b",
                        "glosses": [
                            "Of or pertaining to the placenta."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8017c4e6-4a3b-3c17-97f0-8ea3eeecb861",
                        "entry_id": "c596d0eb-2177-37a7-99a7-c2a3e267df8b",
                        "glosses": [
                            "Pertaining to the Placentalia, comprising those mammals not marsupials or monotremes."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "cc292b28-d18f-44a6-bf8d-cfc98ea02d2a",
                                "sense_id": "8017c4e6-4a3b-3c17-97f0-8ea3eeecb861",
                                "text": "We do not know exactly how many placental lineages survived to leave descendants; most estimates are around ten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce27377d-5eef-4beb-a55b-e19294d7df44",
                        "source_entry_id": "c596d0eb-2177-37a7-99a7-c2a3e267df8b",
                        "source_sense_description": "pertaining to placenta",
                        "target_lang_word": "placentární",
