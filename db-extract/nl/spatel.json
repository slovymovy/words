                                        "examples": [
                                            {
                                                "example_id": "7a33a757-afd7-4729-9a79-123914942630",
                                                "sense_id": "a1ecefd7-053d-33d8-b1a4-f138607cbe3e",
                                                "text": "A book on Pastels referes [sic] to a rough Modeling paste to be spatulaed over cotton duck."
                                            },
                                            {
                                                "example_id": "6c8489f8-e9b7-4abd-b9b3-9de2cc704481",
                                                "sense_id": "a1ecefd7-053d-33d8-b1a4-f138607cbe3e",
                                                "text": "So if you get road-pizzaed, should you have to pay in order to get yourself spatulaed off of the street?"
                                            },
                                            {
                                                "example_id": "47f06760-dbbe-40af-b9f6-ce184807a779",
                                                "sense_id": "a1ecefd7-053d-33d8-b1a4-f138607cbe3e",
                                                "text": "Eddie spatulaed the patty onto a bun and extracted tomatoes, lettuce, and sliced pickles from a Tupperware."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e67337d-f956-3f95-9157-0cea7f49a4c9",
                                        "entry_id": "4058e7cf-2fa8-3f04-8137-00a0c4e44553",
                                        "glosses": [
                                            "To strike with a spatula."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8119155e-ade6-4cc7-a14f-e1c3d0fa5f77",
                                                "sense_id": "0e67337d-f956-3f95-9157-0cea7f49a4c9",
                                                "text": "Or if you're a Ranma Character. I mean, they've been kicked/punched/thrown/hammered/spatulaed into the stratosphere enough times, you gotta figure they've developed a prretty high threshold of pain/injury."
                                            },
                                            {
                                                "example_id": "d114644c-f599-4bb6-a642-384b0067873f",
                                                "sense_id": "0e67337d-f956-3f95-9157-0cea7f49a4c9",
                                                "text": "i.....am............dying.....................i'vebeen..............spatula'd........................to.........death..."
                                            },
                                            {
                                                "example_id": "b045c34e-3324-4d80-873f-a917cd0f9185",
                                                "sense_id": "0e67337d-f956-3f95-9157-0cea7f49a4c9",
                                                "text": "I haven't spatulaed anyone in ages..."
                                            }
                                        ]
                                    }
                                ]
