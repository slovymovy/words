                ],
                "senses": [
                    {
                        "sense_id": "250afc01-5b55-33d2-a006-e6f71d3ddcf0",
                        "entry_id": "56d9b518-89b7-36e9-a227-e3e6bdfb26d4",
                        "glosses": [
                            "Dyslalie caractérisée par la mauvaise articulation des consonnes occlusives ou constrictives (= fricatives et affriquées)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cfd8cfc-8de1-4bb8-a447-04b87275abae",
                                "sense_id": "250afc01-5b55-33d2-a006-e6f71d3ddcf0",
                                "text": "Les sigmatismes survenant sur des consonnes occlusives sont fréquents chez l'enfant sourd."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6d4423b-f99a-3f55-ac8d-530305277bc1",
                        "entry_id": "56d9b518-89b7-36e9-a227-e3e6bdfb26d4",
                        "glosses": [
                            "Allitération en S, ou emploi abusif de cette même lettre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc2db77e-3292-4062-9cd4-ad81fb0f4cd0",
                                "sense_id": "b6d4423b-f99a-3f55-ac8d-530305277bc1",
                                "text": "«Pour qui sont ces serpents qui sifflent sur vos têtes» ? Est un sigmatisme de Jean Racine, dans Andromaque."
                            },
                            {
                                "example_id": "203a0f55-34a2-4697-9dcf-3567006bede5",
                                "sense_id": "b6d4423b-f99a-3f55-ac8d-530305277bc1",
                                "text": "Le vers 444 d'Oreste est un des plus remarquable pour le sigmatisme : Esosa s'ôs isasin Hillinón hosi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98fc705b-5b38-4a49-9217-4591953f7562",
                        "source_entry_id": "56d9b518-89b7-36e9-a227-e3e6bdfb26d4",
                        "target_lang_word": "Sigmatismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4cc32461-1d2d-44b7-bd97-4edda3eab01f",
                        "source_entry_id": "56d9b518-89b7-36e9-a227-e3e6bdfb26d4",
                        "target_lang_word": "Lispeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lispeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee63c8cf-7df7-3132-ad63-c1fba27be2e7",
                                        "entry_id": "2440a21d-001a-3d9a-874d-02ea86299cfd",
                                        "glosses": [
                                            "fehlerhaftes Sprechen durch Platzierung der Zunge an den Schneidezähnen"
                                        ],
                                        "tags": [
                                            "Sprechen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcdbe263-5e8a-4e2b-819b-db4e8446a79a",
                                                "sense_id": "ee63c8cf-7df7-3132-ad63-c1fba27be2e7",
                                                "text": "„Lispeln und Stottern sind wohl die häufigsten Sprachfehler.“"
                                            },
                                            {
                                                "example_id": "b95f9199-5814-48f2-9b22-dbe1bf66d105",
                                                "sense_id": "ee63c8cf-7df7-3132-ad63-c1fba27be2e7",
                                                "text": "„Seit frühester Jugend quälte ihn das Lispeln, er hatte eine überlange Zunge, die im Mund unruhig umherfuhr und neugierig auch an ungeeigneten Buchstabenfolgen wie die Zunge einer giftigen Schlange den Weg nach draußen suchte, dann aber jedesmal erschrocken in die Höhle zurückfloh.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72a090b4-bfa0-421a-bc45-ec9c7947d34b",
                        "source_entry_id": "56d9b518-89b7-36e9-a227-e3e6bdfb26d4",
                        "target_lang_word": "sigmatism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sigmatism",
