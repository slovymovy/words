                        "examples": [
                            {
                                "example_id": "32853032-4ff6-42b1-ad58-f70bffbbad93",
                                "sense_id": "dd7eadab-e210-3ef5-82ff-c41addb95fa8",
                                "text": "„Auch werde ich nicht beschreiben, wie es mich mit kalten Leichenhänden emporhob, mich auf abscheulichste Weise abschnüffelte und wie ich im Angesicht seines stinkenden Atems und Sabbers fast ohnmächtig wurde.“"
                            },
                            {
                                "example_id": "5ad77ef1-82c6-4c6f-8b7d-f92d0e6af869",
                                "sense_id": "dd7eadab-e210-3ef5-82ff-c41addb95fa8",
                                "text": "„Hände in Latexhandschuhen sehen gelblich aus, genau wie Leichenhände.“"
                            }
                        ],
