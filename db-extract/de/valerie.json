                                        "entry_id": "850666f5-43f8-39fa-9f5b-92c420194d18",
                                        "glosses": [
                                            "Ancienne province de l’empire romain, issue de la subdivision de la Pannonie inférieure (Basse Pannonie) sous Dioclétien (fin du IIIᵉ siècle)."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "note": "Selon certains auteurs, il aurait nommé la province du nom de sa fille, Galeria Valeria",
                                        "examples": []
