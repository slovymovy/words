                        "examples": [
                            {
                                "example_id": "943f550a-b047-4a32-a889-8ab73ab070b7",
                                "sense_id": "a599b632-04f0-37f0-987a-b57a9fa89782",
                                "text": "Положе́ние бы́ло преглу́пое: вдруг переста́ть посеща́ть знако́мый дом выходи́ло гру́бостью, а яви́ться туда́ — то́же каза́лось некста́ти.",
                                "translation": "The situation was a most stupid one: to suddenly stop visiting acquaintances would be rude, but to appear there also seemed inappropriate.",
                                "english": "The situation was a most stupid one: to suddenly stop visiting acquaintances would be rude, but to appear there also seemed inappropriate."
                            }
                        ]
