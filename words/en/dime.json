                {
                    "sense_id": "24cf09b5-0e29-3164-b327-6182fdf2ad10",
                    "sense_definition": "A playing card with the rank of ten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need a <dime> to complete my straight.",
                            "target_lang_translations": {
                                "ru": "Мне нужна <w>десятка</w>, чтобы собрать стрит.",
                                "zh": "我需要一张<w>十点牌</w>来凑成顺子。"
