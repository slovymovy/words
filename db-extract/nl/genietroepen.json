                            {
                                "example_id": "82e6ff1e-6269-4f1d-86bb-851ad583afbb",
                                "sense_id": "b1a660c3-5a00-30c1-ac85-03d1bbcfc407",
                                "text": "Genietroepen van het Amerikaanse leger zijn van plan water uit een aantal stuwmeren ten westen van Houston in een nabijgelegen rivier te lozen. De meren staan zo hoog, dat het risico bestaat dat de dammen het begeven. Daardoor zou de stad nog verder onder kunnen lopen."
                            },
                            {
                                "example_id": "fef71806-5d3d-4dc4-a981-179fba00a466",
                                "sense_id": "b1a660c3-5a00-30c1-ac85-03d1bbcfc407",
                                "text": "Genietroepen zijn donderdag begonnen met de voorbereidingen voor de laatste dag, de Dag van Cuijk. De militairen bouwen weer de traditionele pontonbrug voor de wandelaars."
                            }
                        ]
