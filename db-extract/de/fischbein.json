                "senses": [
                    {
                        "sense_id": "724d252d-6085-3e48-a19c-b0acf7c78138",
                        "entry_id": "0890d81c-5893-3336-83e9-bb2793cd01e6",
                        "glosses": [
                            "ein faseriges Material, das aus den Barten bestimmter Wale gewonnen wird und das besonders vom 17. bis 19. Jahrhundert für Modeartikel, insbesondere Korsettstäbe, verwendet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a10f61a5-b13f-4a5b-aa5d-c95de7a6d126",
                                "sense_id": "724d252d-6085-3e48-a19c-b0acf7c78138",
                                "text": "Die Jagd nach Fischbein dezimierte den Bestand an Bartenwalen beträchtlich."
                            },
                            {
                                "example_id": "3b52cc44-55fa-46e9-98a5-5b3c07217c69",
                                "sense_id": "724d252d-6085-3e48-a19c-b0acf7c78138",
                                "text": "„Krinoline (französisch crinoline), ursprünglich ein steifer Stoff (aus Rosshaar) für Soldatenkragen, später auch für breite, abstehende Damenröcke, der durch einen weiteren steifen Rock sowie Polster, Holz- und Drahtkonstruktionen, Fischbein u. a. noch weiter versteift wurde.“"
                            },
                            {
                                "example_id": "c2033afc-cb50-4f2b-a20c-86d709b7ae34",
                                "sense_id": "724d252d-6085-3e48-a19c-b0acf7c78138",
                                "text": "„Der Ingenieur fing an, aus dem Fischbein kleine Stäbchen zu machen und sie an den Enden anzuspitzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
