                    {
                        "translation_id": "b3810da4-a79d-448e-a24c-420efaadc015",
                        "source_entry_id": "bd1cc816-0b69-3d7f-8acf-88a94bd53f56",
                        "target_lang_word": "драный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "драный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4254c1cd-e2b8-3d2c-a36a-bb959fc365b9",
                                        "entry_id": "9f4a54c6-47dc-3998-9671-3c2ddc0d3fff",
                                        "glosses": [
                                            "изорванный, истрепанный, изношенный до дыр (о вещах, одежде, обуви и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e507f53e-e704-430a-a8cf-1b2cc9058f48",
                                                "sense_id": "4254c1cd-e2b8-3d2c-a36a-bb959fc365b9",
                                                "text": "Всё пространство, вровень с печкою, было занавешено ситцевой драной занавеской, сквозь которую виднелись кровать и комод."
                                            },
                                            {
                                                "example_id": "b7582263-5d78-4953-9e48-58c3c0072a60",
                                                "sense_id": "4254c1cd-e2b8-3d2c-a36a-bb959fc365b9",
                                                "text": "Я бы теперь в одном драном сюртучке да в портках в кабаке бы сидел пьяный, а вот я барином живу по его милости!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14f5faf4-f562-3933-86d0-b96b82850299",
                                        "entry_id": "9f4a54c6-47dc-3998-9671-3c2ddc0d3fff",
                                        "glosses": [
                                            "облезлый, с вылезшей шерстью (о животных)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6da50d88-5cf7-48b3-9d76-ea3384814332",
                                                "sense_id": "14f5faf4-f562-3933-86d0-b96b82850299",
                                                "text": "― Да вот кошечку в лесу нашла, пожалела, ― ответила Катерина Федосеевна и показала из-под кофты безусую кошачью мордочку. ― С ума ты сошла, Федосеевна, драную кошку на грудях в дом несешь! Да еще из лесу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a16ea54f-408a-3175-886a-ed56d3248830",
                                        "entry_id": "9f4a54c6-47dc-3998-9671-3c2ddc0d3fff",
                                        "glosses": [
                                            "прост. израненный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82baf41d-755c-43e8-ad68-143283597b36",
                                                "sense_id": "a16ea54f-408a-3175-886a-ed56d3248830",
                                                "text": "― Привезли ― узнать нельзя, лица на нём нет, оборванный весь, кафтанишка висит клочьями, рубаха с плеч валится, сапоги без подошв, сам весь рваный да перебитый: синяк на синяке, рубец на рубце. Лева рука перешибена, спина драная… Сам еле дышит, насилу в избу втащили."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7c59567-8f98-3505-9729-f5fcde57b35e",
                                        "entry_id": "9f4a54c6-47dc-3998-9671-3c2ddc0d3fff",
                                        "glosses": [
                                            "прост. паршивый, дрянной"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be23f958-19b8-4595-a387-4cec3411579f",
                                                "sense_id": "e7c59567-8f98-3505-9729-f5fcde57b35e",
                                                "text": "Кабы ты настоящий мужик был, а то драный, какой в тебе толк?"
                                            },
                                            {
                                                "example_id": "525b01df-e072-4773-9ae1-2f616ff997f6",
                                                "sense_id": "e7c59567-8f98-3505-9729-f5fcde57b35e",
                                                "text": "― Коза драная; право, что коза, ― бормотала старуха, крестя барышню и уходя за двери."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
