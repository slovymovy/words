{
    "word_family": [
        "mouth",
        "piece"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "404e1714-049f-3806-9d74-ea88fa22abe5",
                    "sense_definition": "The part of a musical wind instrument that is placed into or against the player's mouth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "device_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before playing the trumpet, she carefully cleaned the brass <w>mouthpiece</w>.",
                            "target_lang_translations": {
                                "zh": "吹小号之前，她仔细清理了铜质<w>号嘴</w>。"
                            }
                        },
                        {
                            "text": "He attached a new reed to the saxophone <w>mouthpiece</w> before the rehearsal.",
                            "target_lang_translations": {
                                "zh": "排练前，他在萨克斯管的<w>笛头</w>上安装了一片新哨片。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brass mouthpiece"
                    ],
                    "target_lang_definitions": {
                        "zh": "管乐器的吹口、笛头或号嘴，演奏时含在嘴里或贴在嘴唇上"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "吹口",
                                "target_lang_sense_clarification": "管乐器的吹嘴部分"
                            },
                            {
                                "target_lang_word": "号嘴",
                                "target_lang_sense_clarification": "铜管乐器专用的吹嘴"
                            },
                            {
                                "target_lang_word": "笛头",
                                "target_lang_sense_clarification": "木管乐器（如萨克斯、单簧管）的吹嘴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "377ca5b3-c180-305a-94ed-a455c19c0d97",
                    "sense_definition": "A person, newspaper, or organization that speaks on behalf of another or expresses their opinions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "representative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel's protagonist often serves as a <w>mouthpiece</w> for the author's own political opinions.",
                            "target_lang_translations": {
                                "zh": "这部小说的主人公常常充当作者本人政治观点的<w>传声筒</w>。"
                            }
                        },
                        {
                            "text": "Critics accused the state television channel of being a propaganda <w>mouthpiece</w> for the government.",
                            "target_lang_translations": {
                                "zh": "批评人士指责这家国家电视台是政府的宣传<w>喉舌</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "spokesman",
                        "spokesperson"
                    ],
                    "common_phrases": [
                        "party mouthpiece",
                        "propaganda mouthpiece"
                    ],
                    "target_lang_definitions": {
                        "zh": "代他人或组织表达意见的人、报刊或喉舌"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "喉舌",
                                "target_lang_sense_clarification": "代为发声的代言人或宣传机关"
                            },
                            {
                                "target_lang_word": "代言人",
                                "target_lang_sense_clarification": "代表某人或某团体发声者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f9bfc29-2439-39ce-ab97-f89d4ae3d5ce",
                    "sense_definition": "A protective piece worn inside the mouth by athletes to protect the teeth and gums; a mouthguard.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "protective_gear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer adjusted his rubber <w>mouthpiece</w> before stepping into the ring for the final round.",
                            "target_lang_translations": {
                                "zh": "拳击手在踏入最后一轮拳台前调整了一下自己的橡胶<w>护齿</w>。"
                            }
                        },
                        {
                            "text": "Rugby players are required to wear a fitted <w>mouthpiece</w> to prevent dental injuries during collisions.",
                            "target_lang_translations": {
                                "zh": "橄榄球运动员必须佩戴贴合的<w>护齿</w>，以防止碰撞中牙齿受伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mouthguard"
                    ],
                    "common_phrases": [
                        "wear a mouthpiece"
                    ],
                    "target_lang_definitions": {
                        "zh": "运动员佩戴在嘴里以保护牙齿和牙龈的护齿套"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "护齿",
                                "target_lang_sense_clarification": "运动时保护牙齿的护具"
                            },
                            {
                                "target_lang_word": "牙套",
                                "target_lang_sense_clarification": "运动护牙套"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf2e4db8-25a1-37ba-a9da-4630b6b92cce",
                    "sense_definition": "The part of a telephone or headset that is held close to the mouth to speak into.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "device_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She covered the <w>mouthpiece</w> with her hand so the caller could not hear her whisper.",
                            "target_lang_translations": {
                                "zh": "她用手捂住电话的<w>送话口</w>，以免对方听到她的低语。"
                            }
                        },
                        {
                            "text": "He spoke directly into the telephone <w>mouthpiece</w> so that his voice would sound clear.",
                            "target_lang_translations": {
                                "zh": "他对准电话<w>话筒</w>直接说话，以便让自己的声音更清晰。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "telephone mouthpiece"
                    ],
                    "target_lang_definitions": {
                        "zh": "电话或耳机的送话器、话筒，靠近嘴部用于讲话"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "送话口",
                                "target_lang_sense_clarification": "电话的对着嘴说话的部分"
                            },
                            {
                                "target_lang_word": "话筒",
                                "target_lang_sense_clarification": "受话器、送话器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2edb756-a502-3bf7-a352-810756c07cae",
                    "sense_definition": "A lawyer, especially one representing a criminal defendant.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "representative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The arrested gangster refused to answer questions until his <w>mouthpiece</w> arrived at the police station.",
                            "target_lang_translations": {
                                "zh": "被捕的帮派分子在自己的<w>律师</w>到达警局之前拒绝回答任何问题。"
                            }
                        },
                        {
                            "text": "He hired an expensive legal <w>mouthpiece</w> who managed to get all criminal charges dismissed.",
                            "target_lang_translations": {
                                "zh": "他请了一位身价不菲的<w>辩护律师</w>，成功让所有刑事指控被撤销。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lawyer"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used especially in criminal or underworld contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（俚语，尤指为刑事被告辩护的）辩护律师"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "辩护律师",
                                "target_lang_sense_clarification": "刑事律师"
                            },
                            {
                                "target_lang_word": "律师",
                                "target_lang_sense_clarification": "代理律师"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}