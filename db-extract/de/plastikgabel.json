                ],
                "senses": [
                    {
                        "sense_id": "48fd08fa-40f3-369f-b7ed-cbcd4ad91117",
                        "entry_id": "65dfc79a-1147-3d97-89ac-cb61d81bc03f",
                        "glosses": [
                            "Gabel aus Plastik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "288c3edd-4de7-4f9f-a1c5-ce46f7ba7f08",
                                "sense_id": "48fd08fa-40f3-369f-b7ed-cbcd4ad91117",
                                "text": "„›Woher wussten Sie, dass es Rucksacktouristen waren?‹, fragte er, piekte mit der Plastikgabel ein paar Fritten auf und führte sie hastig zum Mund.“"
                            },
                            {
                                "example_id": "2c77dc6a-0a3e-42e3-8f5c-0a3f46adac71",
                                "sense_id": "48fd08fa-40f3-369f-b7ed-cbcd4ad91117",
                                "text": "„Gedankenverloren schaute sie auf ihren Salat, nahm die Plastikgabel und fing an zu essen.“"
                            },
                            {
                                "example_id": "ca33efd9-aa6a-4f7d-9833-8ebdda796f25",
                                "sense_id": "48fd08fa-40f3-369f-b7ed-cbcd4ad91117",
                                "text": "„Deswegen hat Gräfin Weitblick in jedes Türschloss eine Plastikgabel gesteckt und die Zinken darin abgebrochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
