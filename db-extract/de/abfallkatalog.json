                "senses": [
                    {
                        "sense_id": "aa4b3e76-d870-31a1-aba8-1287e0be18fd",
                        "entry_id": "d5e6aafc-d35f-38e2-9a2e-ffed17e4948f",
                        "glosses": [
                            "systematisch erstelltes Verzeichnis von Abfällen, die nach dem Stand der Technik recycelt werden können und einem internationalen Nummernkreis zuzuordnen sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d14d334-8fc2-4aa0-9331-c681a1c46a7a",
                                "sense_id": "aa4b3e76-d870-31a1-aba8-1287e0be18fd",
                                "text": "„Der europäische Abfallkatalog bezeichnet Abfälle und dient der Einstufung hinsichtlich ihre Überwachungsbedürftigkeit.“"
                            },
                            {
                                "example_id": "50b011dc-3aae-4a08-bc79-b432f5c02cef",
                                "sense_id": "aa4b3e76-d870-31a1-aba8-1287e0be18fd",
                                "text": "„In der Abfallverzeichnisverordnung, kurz Abfallkatalog (PDF), finden Sie alle Stofffraktionen beziehungsweise Abfallschlüssel – kompakt und übersichtlich dargestellt als PDF-Datei in drei Sprachen.“"
                            },
                            {
                                "example_id": "83cc0580-808b-434a-b370-0ed4cdcc67cc",
                                "sense_id": "aa4b3e76-d870-31a1-aba8-1287e0be18fd",
                                "text": "„Am 20. Dezember 1993 wurde der Europäische Abfallkatalog - E A K - (englisch European Waste Catalogue - E WC), bekannt gegeben und die Mitgliedstaaten dadurch verpflichtet, den Abfallkatalog einzuführen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
