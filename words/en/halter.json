                    "frequency": "Low",
                    "semantic_group_id": "execution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The convicted pirate stood quietly on the scaffold as the hangman adjusted the coarse <w>halter</w> around his neck."
                        },
                        {
                            "text": "He knew that continuing this rebellion would inevitably lead him straight to the <w>halter</w>."
