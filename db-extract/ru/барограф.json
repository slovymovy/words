                                    {
                                        "sense_id": "0f2b64ee-1955-30ab-a8f5-08c60c15b52d",
                                        "entry_id": "2d45bd29-e1fc-3684-bcaf-8dd3b517ba64",
                                        "glosses": [
                                            ", Appareil qui enregistre la pression atmosphérique dans la durée."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ca81cc4-9ff8-4f06-9a09-757ee771ec2e",
                                                "sense_id": "0f2b64ee-1955-30ab-a8f5-08c60c15b52d",
                                                "text": "Un barographe n’est autre qu’un altimètre, dont l’aiguille de très grande dimension et munie à son extrémité d’une plume se déplace sur un cylindre enregistreur."
                                            },
                                            {
                                                "example_id": "c4fe1592-2124-43e6-aed1-4f0b1848ad8b",
                                                "sense_id": "0f2b64ee-1955-30ab-a8f5-08c60c15b52d",
                                                "text": "Mais la principale cause d'erreur provient de ce que, dans la plupart des barographes, le jeu des organes varie avec la température ; il conviendrait donc, pour les sondages convenablement organisés, d'imposer des barographes compensés […]."
                                            }
                                        ]
                                    }
