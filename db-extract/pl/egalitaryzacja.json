                    {
                        "sense_id": "335ffca4-f7f4-340a-945e-b3f33ebd7251",
                        "entry_id": "fc208112-fdfe-303a-bc08-029b84cbfc37",
                        "glosses": [
                            "zrównanie, ujednolicenie"
                        ],
                        "tags": [
