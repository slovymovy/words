    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "791772b8-2179-312b-a0fa-c3423ea174f0",
                "word": "catchword",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bb0669fb-4db0-4a0c-808c-702ea8da92d1",
                        "entry_id": "791772b8-2179-312b-a0fa-c3423ea174f0",
                        "tags": [
                            "plural"
                        ],
                        "form": "catchwords"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c0368cf-07c7-3a90-8511-bfe7e19dc154",
                        "entry_id": "791772b8-2179-312b-a0fa-c3423ea174f0",
                        "glosses": [
                            "A word under the right-hand side of the last line on a book page that repeats the first word on the following page."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "161c8360-af43-3f16-bc73-ff2ca18a5d9a",
                        "entry_id": "791772b8-2179-312b-a0fa-c3423ea174f0",
                        "glosses": [
                            "The last word of a speech, serving as a cue for the next speaker."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2a137679-abf2-3258-9566-06d32fe8e04a",
                        "entry_id": "791772b8-2179-312b-a0fa-c3423ea174f0",
                        "glosses": [
                            "A word or expression repeated until it becomes representative of a party, school, business, or point of view."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d1029e2-3b9b-4623-8be0-f958c0701960",
                                "sense_id": "2a137679-abf2-3258-9566-06d32fe8e04a",
                                "text": "One could give a long list of such intellectual fashions and catchwords which in the course of two or three generations have in turn dominated the thinking of the intellectual."
                            },
                            {
                                "example_id": "476a0b0f-f73d-4aa5-8346-03daa2fd295b",
                                "sense_id": "2a137679-abf2-3258-9566-06d32fe8e04a",
                                "text": "The war itself has several names, including \"the famine war\" (ḥarb al-majā'a) and seferberlik, a Turkish word, meaning \"travel by land,\" that began its wartime career as a reference to \"military conscription\" but quickly became a catchword for all the calamities and suffering experienced by civilians."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3364f030-44c2-4bb3-9675-5fb58ae8be77",
                        "source_entry_id": "791772b8-2179-312b-a0fa-c3423ea174f0",
                        "source_sense_description": "word that repeats the first word on the following page",
                        "target_lang_word": "Kustos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kustos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "afacc758-2c9d-3dff-b94f-60826197c268",
                                        "entry_id": "946fea8f-b937-31f2-880a-efb75d28d169",
                                        "glosses": [
                                            "wissenschaftlicher Betreuer einer Sammlung oder eines Museums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a490a0d-e10c-44d4-95ff-8ffabbcfc538",
                                                "sense_id": "afacc758-2c9d-3dff-b94f-60826197c268",
                                                "text": "Der Kustos des Kupferstichkabinetts zeigt die Schätze der Sammlung."
                                            },
                                            {
                                                "example_id": "02d29e86-28b9-4f02-a88b-c12e5fa98db4",
                                                "sense_id": "afacc758-2c9d-3dff-b94f-60826197c268",
                                                "text": "„Bevor der Sommer vorüber war, hatte man etwa 1500 Gemälde aus jüdischem Besitz in ein Depot ausgelagert, das der Botschaft unterstand, und aus Berlin traf ein Kustos ein, der mit der Inventarisierung der Beute beginnen sollte.“"
                                            },
                                            {
                                                "example_id": "be74c56e-da76-42e3-8466-225e61c95b87",
                                                "sense_id": "afacc758-2c9d-3dff-b94f-60826197c268",
                                                "text": "„Wenn er wollte, könnte er längst von einem naturwissenschaftlichen Museum angestellt sein; denn mehr als einmal ist ihm eine Stelle als Kustos angeboten.“"
                                            },
                                            {
                                                "example_id": "3c5a726d-1ed6-4a9a-a6bf-4f71ef1c51dd",
                                                "sense_id": "afacc758-2c9d-3dff-b94f-60826197c268",
                                                "text": "„So verzichtete er auch auf die Stelle des Kustos an der Vatikanischen Bibliothek unter dem neuen Papst Alexander VIII., die ihm unter der Bedingung des Übertritts zum Katholizismus angeboten worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "00ae5129-3b5d-3269-9476-f4909ec2294d",
                                        "entry_id": "946fea8f-b937-31f2-880a-efb75d28d169",
                                        "glosses": [
                                            "Kirchendiener oder auch (beispielsweise) der Regionalvorsteher des Franziskanerordens"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e2b9718-5695-4433-b89f-04b66fe07d54",
                                                "sense_id": "00ae5129-3b5d-3269-9476-f4909ec2294d",
                                                "text": "Der Kustos des Heiligen Landes ist der Vorsteher der Kustodie des Heiligen Landes."
                                            },
                                            {
                                                "example_id": "9bae444c-8021-4f83-8869-9161ad9eca87",
                                                "sense_id": "00ae5129-3b5d-3269-9476-f4909ec2294d",
                                                "text": "„Die Liste ihrer Kustoden - der franziskanischen Hüter der Heiligen Stätten und Oberen ihrer Kirchen und Klöster dort - ist achthundert Jahre und hundertsiebenundsechzig Namen lang, und der erste Name darauf ist Franziskus von Assisi.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d777246f-1b92-4314-805c-1990b28b2288",
                        "source_entry_id": "791772b8-2179-312b-a0fa-c3423ea174f0",
                        "source_sense_description": "word that repeats the first word on the following page",
                        "target_lang_word": "Kustode",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kustode",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7940dd7f-727a-3f56-8ba2-0323d6c0f3e0",
                                        "entry_id": "633d3777-9556-37bc-bf91-a53b85904d62",
                                        "glosses": [
                                            "Kennzeichen für die Lage einer Handschrift zum Finden des Textanschlusses"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2f45754-0a27-4ff8-96f7-ec3903f54318",
                                                "sense_id": "7940dd7f-727a-3f56-8ba2-0323d6c0f3e0",
                                                "text": "Durch die Kustode konnte ich den richtigen Textanschluss finden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0186b338-4640-34ad-8922-f7b18bec4112",
                                        "entry_id": "633d3777-9556-37bc-bf91-a53b85904d62",
                                        "glosses": [
                                            "in Büchern oder Manuskripten am rechten unteren Seitenrand das erste Wort der folgenden Seite oder die Seitenzahl der folgenden Seite"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "079f72df-5646-4adc-87dd-ce1dfdccfe0b",
                                                "sense_id": "0186b338-4640-34ad-8922-f7b18bec4112",
                                                "text": "Als Kustode wurde bei diesem Buch jeweils das erste Wort der folgenden Seite verwendet."
                                            },
                                            {
                                                "example_id": "4275abcd-92c0-45e4-8376-949a26baa9b4",
                                                "sense_id": "0186b338-4640-34ad-8922-f7b18bec4112",
                                                "text": "„Dieser Fehler begegnet vorzugsweise am Seitenanfang von Verso-Seiten und fällt beim Lesen des Originaltextes beinahe nicht auf, da die Kustode der vorangehenden Seite das fehlende Wort stets enthält.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kustode",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae7f9609-f2a6-3ce9-b00d-c04a8297a392",
                                        "entry_id": "86991dba-9ea0-31ee-a338-121d1bb9df64",
                                        "glosses": [
                                            "wissenschaftlicher Betreuer einer Sammlung oder eines Museums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7a09abb-587f-4358-a3b2-5a7fc35e9a49",
                                                "sense_id": "ae7f9609-f2a6-3ce9-b00d-c04a8297a392",
                                                "text": "Der Kustode überwacht den Transport der Ausstellungsstücke."
                                            },
                                            {
                                                "example_id": "b956c6dc-1885-44cc-9047-1c606c767bf3",
                                                "sense_id": "ae7f9609-f2a6-3ce9-b00d-c04a8297a392",
                                                "text": "„Auf einem Treffen des Parteiortsverbands Sydstreymoy ließ Eigil die boshafte Bemerkung fallen, ihr Vorsitzender sei Kustode des Mausoleums, in dem die besten Männer der Nation unter Glas lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d04835c2-2767-4e36-b3aa-7acd9eed86bd",
                        "source_entry_id": "791772b8-2179-312b-a0fa-c3423ea174f0",
                        "source_sense_description": "word that repeats the first word on the following page",
                        "target_lang_word": "hasło",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hasło",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "bdb09d38-4686-39d9-9d49-745248764135",
                                        "entry_id": "861be8e1-3580-3989-b0b4-77be98390736",
                                        "glosses": [
                                            "myśl przewodnia, idea"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34d76e50-1868-4223-9f99-944af980b806",
                                                "sense_id": "bdb09d38-4686-39d9-9d49-745248764135",
                                                "text": "Jego „prawa ręka”, Wołodymyr Horbulin, ukuł wtedy hasło, że w polityce zagranicznej Kuczma jest nacjonalistą, w wewnętrznej — liberałem, a w społecznej — socjaldemokratą."
                                            },
                                            {
                                                "example_id": "b51b9130-6d7a-4801-b017-c801fb96e446",
                                                "sense_id": "bdb09d38-4686-39d9-9d49-745248764135",
                                                "text": "Hasło tej akcji jest bardzo znane."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "70829830-935f-381d-872a-929953c78749",
                                        "entry_id": "861be8e1-3580-3989-b0b4-77be98390736",
                                        "glosses": [
                                            "znak, sygnał do działania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eea7a893-79e3-4b8b-ae4e-0b17d5eea00c",
                                                "sense_id": "70829830-935f-381d-872a-929953c78749",
                                                "text": "Na umówione hasło idziemy do działania."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "42360141-8b42-3cde-b985-2c96200d1a49",
                                        "entry_id": "861be8e1-3580-3989-b0b4-77be98390736",
                                        "glosses": [
                                            "tajny wyraz lub ciąg znaków"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8592dfe7-19a2-492a-bb66-40caa13210f7",
                                                "sense_id": "42360141-8b42-3cde-b985-2c96200d1a49",
                                                "text": "Aby wypłacić pieniądze z konta musi pan podać hasło."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "3aafc1dc-7b31-37e0-84e7-328e5ea91d44",
                                        "entry_id": "861be8e1-3580-3989-b0b4-77be98390736",
                                        "glosses": [
                                            "wyraz lub wyrażenie stanowiące odrębną część w słowniku lub katalogu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec4293c-6481-4554-b862-62d2e990eb25",
                                                "sense_id": "3aafc1dc-7b31-37e0-84e7-328e5ea91d44",
                                                "text": "W słowniku hasła są ułożone alfabetycznie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "31c648df-ea61-3b16-aac4-908d370ef9d5",
                                        "entry_id": "861be8e1-3580-3989-b0b4-77be98390736",
                                        "glosses": [
                                            "jeden z możliwych elementów kampanii marketingowej lub politycznej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e844278d-3e16-4dda-b3a1-3381ba66bc06",
                                                "sense_id": "31c648df-ea61-3b16-aac4-908d370ef9d5",
                                                "text": "Bez dobrego hasła, kampania będzie nieskuteczna."
                                            }
                                        ],
                                        "sense_index_json": "\"1.5\""
                                    },
                                    {
                                        "sense_id": "1d4732eb-0fc7-3c6b-a39e-ba99805a33aa",
                                        "entry_id": "861be8e1-3580-3989-b0b4-77be98390736",
                                        "glosses": [
                                            "wyraz wpisywany w pola krzyżówki"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92a4cfaa-d76f-4a6c-912e-638bb30a7f02",
                                                "sense_id": "1d4732eb-0fc7-3c6b-a39e-ba99805a33aa",
                                                "text": "Do zrobienia krzyżówki zostały mi dwa hasła."
                                            }
                                        ],
