    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "483e21b4-4689-3c47-962c-ed0ced98a450",
                    "sense_definition": "Se dit d'un animal sauvage et craintif qui fuit dès qu'on essaie de l'approcher.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune cerf reste très <w>farouche</w> et s'enfuit au moindre bruit dans la forêt.",
                            "target_lang_translations": {
                                "en": "The young deer remains very <w>wary</w> and runs off at the slightest sound in the forest.",
                                "ru": "Молодой олень остаётся очень <w>пугливым</w> и убегает от малейшего шума в лесу.",
                                "de": "Der junge Hirsch bleibt sehr <w>scheu</w> und flieht bei dem geringsten Geräusch im Wald.",
                                "es": "El joven ciervo sigue muy <w>arisco</w> y huye al menor ruido en el bosque.",
                                "zh": "这只年轻的鹿依然非常<w>胆小</w>，稍有一点儿响动就逃进树林里。"
                            }
                        },
                        {
                            "text": "Il faut beaucoup de patience pour approcher une bête <w>farouche</w> sans lui faire peur.",
                            "target_lang_translations": {
                                "en": "It takes a lot of patience to approach a <w>wild</w> animal without frightening it.",
                                "ru": "Чтобы подойти к <w>пугливому</w> зверю, не напугав его, нужно много терпения.",
                                "de": "Um sich einem <w>scheuen</w> Tier zu nähern, ohne ihm Angst einzujagen, braucht man viel Geduld.",
                                "es": "Hace falta mucha paciencia para acercarse a una bestia <w>arisca</w> sin asustarla.",
                                "zh": "要靠近一只<w>胆小</w>的野兽而不让它受惊，需要很大的耐心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sauvage",
                        "craintif",
                        "indompté"
                    ],
                    "common_phrases": [
                        "bête farouche",
                        "animal farouche"
                    ],
                    "target_lang_definitions": {
                        "en": "Said of a wild, timid animal that runs away as soon as someone tries to approach it.",
                        "ru": "О диком пугливом животном, которое убегает, как только к нему пытаются приблизиться.",
                        "de": "Ein wildes Tier, das ängstlich ist und sofort flieht, sobald man sich ihm nähert.",
                        "es": "Dicho de un animal salvaje y temeroso que huye en cuanto se intenta acercarse a él.",
                        "zh": "指野生而胆怯的动物，一靠近就逃跑。"
                    },
