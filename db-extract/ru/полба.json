                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1eedffda-bfc3-4d22-a9cf-20241bf992c9",
                                                "sense_id": "db260413-37f0-3b03-b0fe-7df016a5ec1b",
                                                "text": "Yes, yes; he teaches boys the hornbook. What is a, b, spelt / backward with the horn on his head?"
                                            }
