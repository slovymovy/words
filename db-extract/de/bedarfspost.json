                    {
                        "sense_id": "bcf8df17-a79c-3c40-ac5f-d8922662f33b",
                        "entry_id": "777fd7fa-73c9-30b8-80b8-07d1c823970b",
                        "glosses": [
                            "Beförderung des Postguts aufgrund bestehenden Informationsbedarfs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51f192f1-f8b6-47d5-b71c-faac70139e61",
                                "sense_id": "bcf8df17-a79c-3c40-ac5f-d8922662f33b",
                                "text": "„Da bei der »Tin Can Mail« Bedarfspost kaum belegt ist, gilt sie überwiegend als künstlich gemacht und spekulativ.“"
                            },
                            {
                                "example_id": "87cd39ca-c265-41de-a704-b20266b01851",
                                "sense_id": "bcf8df17-a79c-3c40-ac5f-d8922662f33b",
                                "text": "„Während philatelistisch motivierte Sammlerpost oft nur aus einem frankierten Beleg mit Empfängeradresse ohne eigentliche Mitteilung besteht, zeichnet sich Bedarfspost oft durch das Vorhandensein von Information aus - entsprechend dem ursprünglichen Sinn der Post.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ebf07912-2767-31ed-8f04-4c97f59e2063",
                        "entry_id": "777fd7fa-73c9-30b8-80b8-07d1c823970b",
                        "glosses": [
                            "das aufgrund bestehenden Informationsbedarfs beförderte Postgut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aef8a695-6a88-4085-bde9-566349e3aede",
                                "sense_id": "ebf07912-2767-31ed-8f04-4c97f59e2063",
                                "text": "„Bedarfspost, auch philatelistische Geschäftspost mit Postwertzeichen zum Tag der Briefmarke muß man erst einmal finden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
