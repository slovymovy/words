                {
                    "sense_id": "2bf6d65b-ace4-33a5-93dc-e14c3a77a561",
                    "sense_definition": "Een vlak stuk land dat in een rivierengebied ligt of door water is omgeven.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koeien grazen rustig in de groene <w>waard</w>.",
                            "target_lang_translations": {
                                "ru": "Коровы мирно пасутся в зеленой <w>пойме</w>.",
                                "en": "The cows are grazing peacefully in the green <w>floodplain</w>.",
                                "it": "Le mucche pascolano tranquille nella verde <w>golena</w>."
                            }
                        },
                        {
                            "text": "Door het hoge water is de <w>waard</w> gedeeltelijk ondergelopen.",
                            "target_lang_translations": {
                                "ru": "Из-за высокой воды <w>пойма</w> частично затоплена.",
                                "en": "Due to the high water, the <w>floodplain</w> is partially flooded.",
                                "it": "A causa dell'acqua alta, la <w>golena</w> è parzialmente allagata."
                            }
                        }
