                    {
                        "translation_id": "7cc5f49f-3868-4474-8084-e4aaad7bd29c",
                        "source_entry_id": "8c37e8af-cd8c-34a7-b0ef-3eea1a8b8063",
                        "source_sense_description": "α Ursae Minoris — see also North Star",
                        "target_lang_word": "Polarstern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polarstern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cffbe552-b198-3d24-82b8-6c611060a78c",
                                        "entry_id": "c4d94cb6-8abc-3411-b20a-792c7e58fc87",
                                        "glosses": [
                                            "hellster Stern im Sternbild Kleiner Bär"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b474a6dc-3d0d-4408-8af4-7953d1972233",
                                                "sense_id": "cffbe552-b198-3d24-82b8-6c611060a78c",
                                                "text": "…, dort steht ein Stern, der sich nicht sonderlich bewegt, und der Angelstern oder Polarstern heißt, …"
                                            },
                                            {
                                                "example_id": "b00c58b1-839e-403b-a577-62896347a7de",
                                                "sense_id": "cffbe552-b198-3d24-82b8-6c611060a78c",
                                                "text": "Mit Hilfe des Großen Wagens kann man den Polarstern und damit den nördlichen Himmelspol leicht finden."
                                            },
                                            {
                                                "example_id": "c40e46c2-0945-4cfd-bfab-cce0745a59f2",
                                                "sense_id": "cffbe552-b198-3d24-82b8-6c611060a78c",
                                                "text": "„Den Polarstern gab es nicht mehr, die Sternbilder im Zenith waren nicht mehr die gleichen wie am Nordhimmel der Neuen Welt.“"
                                            },
                                            {
                                                "example_id": "78a39849-40c1-41cf-a6b7-56e0c94a1a5f",
                                                "sense_id": "cffbe552-b198-3d24-82b8-6c611060a78c",
                                                "text": "„Da drehte ihn Pécuchet mit dem Blick auf den Großen Bären und zeigte ihm den Polarstern, dann Cassiopeia, deren Konstellation ein Y bildet, die funkelnde Wega im Sternbild der Leier und unten am Horizont den roten Aldebaran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
