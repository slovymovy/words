                ],
                "senses": [
                    {
                        "sense_id": "90653586-65dc-3e30-82cd-5471686e57fc",
                        "entry_id": "0cc2607d-0fc7-3137-bf92-be486b3290c6",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7ba9aee-60f7-4f28-b647-895e18b21651",
                                "sense_id": "90653586-65dc-3e30-82cd-5471686e57fc",
                                "text": "Frau Beierle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ec3d0d5a-b77b-4444-b040-c87a3d6c72e7",
                                "sense_id": "90653586-65dc-3e30-82cd-5471686e57fc",
                                "text": "Herr Beierle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "67cdecea-3dbd-460f-8aa1-1579100dd1d9",
                                "sense_id": "90653586-65dc-3e30-82cd-5471686e57fc",
                                "text": "Die Beierles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8f349f52-df62-4585-844c-8d93068a0366",
                                "sense_id": "90653586-65dc-3e30-82cd-5471686e57fc",
                                "text": "Der Beierle trägt nie die Schals, die die Beierle ihm strickt."
                            },
                            {
                                "example_id": "fa4db281-6461-4edc-ade1-378d945a95c9",
                                "sense_id": "90653586-65dc-3e30-82cd-5471686e57fc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Beierle kommt, geht der Herr Beierle.“"
                            },
                            {
                                "example_id": "67078058-c5ab-439a-b677-4320fb0e1aa8",
                                "sense_id": "90653586-65dc-3e30-82cd-5471686e57fc",
                                "text": "Beierle kommt und geht."
                            },
                            {
                                "example_id": "57f6ef3d-0a7b-4641-972b-d9c80a1b7fca",
                                "sense_id": "90653586-65dc-3e30-82cd-5471686e57fc",
                                "text": "Beierles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
