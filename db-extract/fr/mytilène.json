                "forms": [],
                "senses": [
                    {
                        "sense_id": "30e821b6-2aed-3021-b57f-4f4f4a11a718",
                        "entry_id": "c24d0986-457b-384d-9396-e52278fa36f5",
                        "glosses": [
                            "Capitale de Lesbos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e1b21e4-7b00-484a-8b19-38a4e39139fc",
                                "sense_id": "30e821b6-2aed-3021-b57f-4f4f4a11a718",
                                "text": "Très peu de voyageurs récents peuvent compter, parmi leurs excursions, un séjour à Mytilène."
                            },
                            {
                                "example_id": "ce845720-03e9-41b3-b050-189c8db312e5",
                                "sense_id": "30e821b6-2aed-3021-b57f-4f4f4a11a718",
                                "text": "Mytilène a été bombardée hier, malgré son nom si doux. C’est un peu comme si on fusillait une jeune fille. Amiens, Soissons, soit. Ce sont des filles à soldats. Mais la tendre Mytilène ?"
                            },
                            {
                                "example_id": "34bd5ef5-9a81-4eb1-a829-c092aecf1234",
                                "sense_id": "30e821b6-2aed-3021-b57f-4f4f4a11a718",
                                "text": "A tribord, le feu vert, c’est Mytilène."
                            }
                        ]
                    }
                ],
