            },
            {
                "entry_id": "ec3b037b-bca9-37b2-9021-6b82cf66cb33",
                "word": "chiliaste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a93820eb-b3d8-4b08-a1cf-148acd0176d7",
                        "entry_id": "ec3b037b-bca9-37b2-9021-6b82cf66cb33",
                        "tags": [
                            "plural"
                        ],
                        "form": "chiliastes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8a54727-975a-3062-878c-2270848bc90f",
                        "entry_id": "ec3b037b-bca9-37b2-9021-6b82cf66cb33",
                        "glosses": [
                            "Partisan de la doctrine qui prône qu’après le jugement universel, les prédestinés demeureraient mille ans sur la terre et y jouiraient de toutes sortes de plaisirs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b58a041a-23c3-4179-a73c-9a9376959bfa",
                                "sense_id": "b8a54727-975a-3062-878c-2270848bc90f",
                                "text": "Mais ce Père jouissait-il d’un tel crédit qu’une ligne de lui eût déterminé l’opinion générale, y compris les Alexandrins eux-mêmes, qui ne devaient pas être disposés à beaucoup de crédulité envers un chiliaste tel que Papias ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4aeff4f7-b88a-4b58-876b-3b0a2b7da2cc",
                        "source_entry_id": "ec3b037b-bca9-37b2-9021-6b82cf66cb33",
                        "source_sense_id": "b8a54727-975a-3062-878c-2270848bc90f",
                        "target_lang_word": "chiliast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiliast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc4cb8b3-b70b-35a5-9473-72240a4732f9",
                                        "entry_id": "7096a4ac-6e2b-3ef5-a795-a11136faa570",
                                        "glosses": [
                                            "Synonym of millenarian: a person who believes the Second Coming of Jesus Christ will involve his physical rule on Earth for 1000 years."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbe2c7b-a2c8-40f2-b2b3-be68e29e9ce8",
                                                "sense_id": "bc4cb8b3-b70b-35a5-9473-72240a4732f9",
                                                "text": "... Agreed on all sides, except the Chiliasts..."
                                            },
                                            {
                                                "example_id": "9d103ae7-e5fe-46f2-af24-2fe724ac4602",
                                                "sense_id": "bc4cb8b3-b70b-35a5-9473-72240a4732f9",
                                                "text": "All Anabaptists were and are still Chiliasts, expounding literally that Kingdome of a thousand years of Revel. xx. 6 to be a temporall Kingdome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
