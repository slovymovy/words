                {
                    "sense_id": "dd58f1c2-65c1-33a8-a207-8046c32940cb",
                    "sense_definition": "Verbindet zwei oder mehr Alternativen, Gegensätze oder Partner bei einer Auswahl, Unterscheidung oder Beziehung.",
