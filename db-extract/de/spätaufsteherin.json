                        "target_lang_word": "lève-tard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lève-tard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dfc1bcdd-7d5b-329a-af77-5741701e9327",
                                        "entry_id": "2b6de876-3f9d-3a19-87b4-6dfa143fe3d0",
                                        "glosses": [
                                            "Qui aime se lever tard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fbadee7-4596-479c-a69e-e09f717143df",
                                                "sense_id": "dfc1bcdd-7d5b-329a-af77-5741701e9327",
                                                "text": "Avec l'adolescence, la fille est devenue lève-tard."
                                            },
                                            {
                                                "example_id": "1bccded5-657d-4a63-956d-e2f2b33a3028",
                                                "sense_id": "dfc1bcdd-7d5b-329a-af77-5741701e9327",
                                                "text": "Le buraliste, plutôt lève-tard et de mauvaise humeur, montait à peine son rideau de fer récalcitrant en poussant quelques jurons."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lève-tard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4f3a64a-9db0-3839-9826-43e1896128b1",
                                        "entry_id": "db8630d3-08ff-3524-8dd5-2ced04806f91",
                                        "glosses": [
                                            "Personne qui a l’habitude de se lever tard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ae31ac-1ed3-4a67-a184-83775bd5fa81",
                                                "sense_id": "c4f3a64a-9db0-3839-9826-43e1896128b1",
                                                "text": "Je ne suis pas du matin, je suis un lève-tard."
                                            },
                                            {
                                                "example_id": "22a3401e-ca59-4a13-b491-6ce5fde16d97",
                                                "sense_id": "c4f3a64a-9db0-3839-9826-43e1896128b1",
                                                "text": "Maria, dans son tablier noir de satinette à fleurs, m’accueillit au bas de l’escalier avec cette chaleur un peu moqueuse qu’on réserve aux lève-tard, mais m’abandonna ensuite devant mon bol de thé au lait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
