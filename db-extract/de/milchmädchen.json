                    {
                        "sense_id": "dd7b4ce7-45df-36e4-aae5-35c4f9e00a8c",
                        "entry_id": "98949ad5-1770-3ffc-ace6-2c33d618963f",
                        "glosses": [
                            "Berufsbezeichnung für junge Frauen, die Kühe melken, Milch verarbeiten und verkaufen"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "9469b7f8-a728-4464-a0a1-ca88b7ef7bdd",
                                "sense_id": "dd7b4ce7-45df-36e4-aae5-35c4f9e00a8c",
                                "text": "Den Milchmädchen kam in der historischen Milchindustrie eine wichtige Rolle zu."
                            },
                            {
                                "example_id": "927fabb5-3b20-4576-aea2-6d574308f523",
                                "sense_id": "dd7b4ce7-45df-36e4-aae5-35c4f9e00a8c",
                                "text": "„Und so erhielten die Veteranen und Kriegsversehrten in diesem Jahrzehnt Gesellschaft von ehemaligen Verkäuferinnen, früheren Milchmädchen, einstigen Arbeiterinnen und entlassenen Dienstmädchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
