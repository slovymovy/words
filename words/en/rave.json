                },
                {
                    "sense_id": "da8b06aa-7803-37a0-b8b0-ae9bd2d6e175",
                    "sense_definition": "To stray from a path or to err.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is easy to <w>rave</w> from the truth when one is under pressure.",
                            "target_lang_translations": {
                                "ru": "Легко <w>отклониться</w> от истины, когда находишься под давлением."
                            }
                        },
                        {
                            "text": "The sheep began to <w>rave</w> from the flock into the dangerous hills.",
                            "target_lang_translations": {
                                "ru": "Овцы начали <w>отбиваться</w> от стада, уходя в опасные холмы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This sense is no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбиться с пути или совершить ошибку."
