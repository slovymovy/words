                                "target_lang_sense_clarification": "лингвистический термин"
                            },
                            {
                                "target_lang_word": "вариант",
                                "target_lang_sense_clarification": "форма существования языка"
                            },
                            {
                                "target_lang_word": "идиом",
                                "target_lang_sense_clarification": "научный термин для диалекта или говора"
                            }
                        ]
