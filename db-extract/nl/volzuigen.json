                        "sense_id": "78662c7d-f22a-34a0-ac25-293aa582668e",
                        "entry_id": "66f361c8-a2ef-313e-b930-d4132204cdf5",
                        "glosses": [
                            "zich helemaal door iets laten doordrenken"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "c24b675e-e1a9-4e6d-999d-db76582a9f98",
                                "sense_id": "78662c7d-f22a-34a0-ac25-293aa582668e",
                                "text": "De cellen worden opgesloten in een zogenaamde hydrogel. Dat zijn lange ketens moleculen waarin vocht zit opgesloten. Ze zitten bijvoorbeeld ook in babyluiers. Het zijn de kleine balletjes die zich helemaal volzuigen met vloeistof."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1edc221-3d2e-3ebd-bbd9-acb77200c90e",
                        "entry_id": "66f361c8-a2ef-313e-b930-d4132204cdf5",
                        "glosses": [
                            "zich helemaal vullen door een verlaagde inwendige druk"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "8ae23686-2992-472c-806a-28ee583f9146",
                                "sense_id": "f1edc221-3d2e-3ebd-bbd9-acb77200c90e",
                                "text": "De fabriek is gelegen in de bossen, op 700 tot 800 meter boven de zeespiegel. Daar worden cilinders gevuld met 8 liter geperste lucht die afkomstig is van de berg Jiri. Voor omgerekend iets meer dan 11 euro kunnen de Koreanen met een speciaal masker vervolgens ongeveer 160 keer hun longen volzuigen."
                            }
                        ]
                    }
