                ],
                "senses": [
                    {
                        "sense_id": "a24d6ab5-1860-3aec-82d7-cdfc44c72114",
                        "entry_id": "7d2794f8-1cf8-37b7-aabd-078c75fd49d5",
                        "glosses": [
                            "Zusammenschluss mehrerer Künstler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac5b994f-b639-4b51-b2ab-fd1b42474b0c",
                                "sense_id": "a24d6ab5-1860-3aec-82d7-cdfc44c72114",
                                "text": "„Die Ausstellung der Künstlergruppe AnDer in der Luftschiffhalle in Mülheim erntet viel Lob.“"
                            },
                            {
                                "example_id": "5217216b-5778-4270-9454-b9a7093180e6",
                                "sense_id": "a24d6ab5-1860-3aec-82d7-cdfc44c72114",
                                "text": "„Die Moerser Künstlergruppe „Spektrum“ hat sich mit dem Thema „Landmarken – Wegmarken“ befasst.“"
                            },
                            {
                                "example_id": "200b48a4-6474-404b-99d3-a51fe63f5a14",
                                "sense_id": "a24d6ab5-1860-3aec-82d7-cdfc44c72114",
                                "text": "„Die Künstlergruppe „Junges Rheinland“ wird 100 Jahre alt.“"
                            },
                            {
                                "example_id": "182a2f38-7014-4182-9f60-cc44c67c5013",
                                "sense_id": "a24d6ab5-1860-3aec-82d7-cdfc44c72114",
                                "text": "„Am Mittwoch gibt es ein Treffen ihrer Künstlergruppe zusammen mit Freunden.“"
                            },
                            {
                                "example_id": "6148dd07-fa4e-4d34-b456-babd43b88794",
                                "sense_id": "a24d6ab5-1860-3aec-82d7-cdfc44c72114",
                                "text": "„Mit Blick auf die Soziologie fällt jedoch schnell auf, dass Untersuchungen zu Künstlergruppen äußerst rar sind.“"
                            },
                            {
                                "example_id": "c33e519b-d4e0-4471-aeed-5876b17b8edc",
                                "sense_id": "a24d6ab5-1860-3aec-82d7-cdfc44c72114",
                                "text": "„Zahlreiche Künstler malten sich inmitten derjenigen Künstlergruppe, deren inhaltliche und stilistische Vorstellungen über die Kunst sie teilten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
