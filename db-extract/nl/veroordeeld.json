                                        "entry_id": "2939d478-7526-3d26-9ea4-9337c2afae29",
                                        "glosses": [
                                            "als Beschuldigter oder Angeklagter ein gerichtliches Urteil rechtswirksam empfangen habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81279646-1d85-4920-b645-6f74d2545fe4",
                                                "sense_id": "e71f1105-da12-3b14-8544-9690c3aa6a27",
                                                "text": "Nach sechs Monaten Untersuchungshaft und der abschließenden Gerichtsverhandlung wurde der verurteilte Sexualstraftäter in die Psychiatrie überstellt."
                                            },
                                            {
                                                "example_id": "b5249360-9c30-4a65-b84d-4e33434c1ac5",
                                                "sense_id": "e71f1105-da12-3b14-8544-9690c3aa6a27",
                                                "text": "Der wegen Steuerhinterziehung zu einer hohen Geldstrafe verurteilte Firmeninhaber musste immerhin nicht ins Gefängnis."
                                            },
                                            {
                                                "example_id": "0c6a5cbc-70e3-4d16-b587-8133189a4294",
                                                "sense_id": "e71f1105-da12-3b14-8544-9690c3aa6a27",
                                                "text": "Pakistan will 500 verurteilte Extremisten hinrichten"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "39fe8f79-00b5-3b65-9bda-9508549e65ee",
                                        "entry_id": "2939d478-7526-3d26-9ea4-9337c2afae29",
                                        "glosses": [
                                            "etwas Negatives hinnehmen müssend"
                                        ],
                                        "tags": [
                                            "übertragen auch auf andere als rein juristische Folgen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "307de3fe-d528-4908-8add-ba9fde02abe2",
                                                "sense_id": "39fe8f79-00b5-3b65-9bda-9508549e65ee",
                                                "text": "Nach seiner Abwahl aus dem Bundestag war der Abgeordnete zur Bedeutungslosigkeit verurteilt."
                                            },
                                            {
                                                "example_id": "6d6b0a01-c23a-4d0f-9bce-545f80f60581",
                                                "sense_id": "39fe8f79-00b5-3b65-9bda-9508549e65ee",
                                                "text": "Dieses Projekt ist so komplex, wir haben nicht genügend Ressourcen, wir sind von vornherein zum Scheitern verurteilt."
                                            },
                                            {
                                                "example_id": "17ae5310-2e93-498a-b349-4cd38b0f9f2e",
                                                "sense_id": "39fe8f79-00b5-3b65-9bda-9508549e65ee",
                                                "text": "Verurteilt zur Untätigkeit konnte er nichts anderes tun, als abzuwarten."
                                            },
                                            {
                                                "example_id": "ed565515-0ac0-497c-a653-d974f45d52b9",
                                                "sense_id": "39fe8f79-00b5-3b65-9bda-9508549e65ee",
                                                "text": "Dieser Sechsjährige ist zum Sterben verurteilt wenn er nicht sehr bald eine Herztransplantation erhält!"
                                            }
                                        ],
