{
    "word_family": [
        "cradler",
        "cradleside",
        "cradlesong"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c00bbfe-81f0-3efd-ae89-d3e2a940cd73",
                    "sense_definition": "A small bed for a baby, often one that can be rocked from side to side.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "baby_furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother gently rocked the <w>cradle</w> until the infant fell fast asleep.",
                            "target_lang_translations": {
                                "zh": "母亲轻轻地摇着<w>摇篮</w>，直到婴儿熟睡。"
                            }
                        },
                        {
                            "text": "They bought a beautiful wooden <w>cradle</w> for the new baby's nursery.",
                            "target_lang_translations": {
                                "zh": "他们为新生儿的育婴室买了一个漂亮的木制<w>摇篮</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rock the cradle",
                        "wooden cradle",
                        "baby cradle"
                    ],
                    "target_lang_definitions": {
                        "zh": "婴儿睡的小床，通常可以左右摇晃。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摇篮",
                                "target_lang_sense_clarification": "指婴儿睡的、可以摇晃的小床。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3409427a-38c2-3c75-9077-d5a735bc5a67",
                    "sense_definition": "A frame or rest designed to hold a telephone handset or other electronic device when not in use.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "device_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please place the phone back in its <w>cradle</w> to ensure it charges properly.",
                            "target_lang_translations": {
                                "zh": "请把电话放回<w>底座</w>，以确保正常充电。"
                            }
                        },
                        {
                            "text": "He slammed the handset into the <w>cradle</w> after the frustrating conversation.",
                            "target_lang_translations": {
                                "zh": "那次令人沮丧的谈话后，他重重地把听筒扣回了<w>底座</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rest"
                    ],
                    "common_phrases": [
                        "telephone cradle",
                        "charging cradle"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于放置电话听筒或电子设备的底座或支架。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "底座",
                                "target_lang_sense_clarification": "指放置电话听筒或充电设备的支撑架。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abed1b96-fc0a-3f84-904a-4f595f18537a",
                    "sense_definition": "The period of infancy or very early life.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "life_stages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two friends had known each other from the <w>cradle</w>.",
                            "target_lang_translations": {
                                "zh": "这两个朋友从<w>幼年</w>起就认识了。"
                            }
                        },
                        {
                            "text": "He was taught to respect his elders from the <w>cradle</w> to the grave.",
                            "target_lang_translations": {
                                "zh": "他从小到大都被教导要尊敬长辈。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "from the cradle",
                        "cradle to grave"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in idiomatic expressions about life duration"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指婴儿时期或生命早期。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "幼年",
                                "target_lang_sense_clarification": "指生命的最早期阶段。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cd0b72b-4460-3f3f-b9eb-a49cf8c84484",
                    "sense_definition": "The place where something originated or was nurtured in its early stages.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ancient Greece is often described as the <w>cradle</w> of Western civilization.",
                            "target_lang_translations": {
                                "zh": "古希腊常被称为西方文明的<w>发源地</w>。"
                            }
                        },
                        {
                            "text": "This city was the <w>cradle</w> of liberty during the revolution.",
                            "target_lang_translations": {
                                "zh": "这座城市是革命时期自由的<w>发源地</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cradle of civilization",
                        "cradle of liberty"
                    ],
                    "target_lang_definitions": {
                        "zh": "某事物起源或早期发展的发源地。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发源地",
                                "target_lang_sense_clarification": "指文明或某种思想的起源处。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45c6a4c2-48c6-3599-9719-6ff2a014993b",
                    "sense_definition": "A machine on rockers used by miners to wash gold from earth or gravel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mining_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners used a <w>cradle</w> to separate the gold flakes from the river sediment.",
                            "target_lang_translations": {
                                "zh": "矿工们用<w>淘金槽</w>将金屑从河沙中分离出来。"
                            }
                        },
                        {
                            "text": "He spent all day rocking the <w>cradle</w> in hopes of finding a nugget.",
                            "target_lang_translations": {
                                "zh": "他整天都在摇动<w>淘金槽</w>，希望能找到金块。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rocker"
                    ],
                    "common_phrases": [
                        "mining cradle",
                        "gold cradle"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in historical mining contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "矿工用来从泥沙中淘洗黄金的摇动式工具。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "淘金槽",
                                "target_lang_sense_clarification": "指用于淘洗矿石的摇动式设备。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "419733a7-593c-3677-ab54-5c5060ee01b5",
                    "sense_definition": "To hold someone or something gently and protectively in one's arms.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "holding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat on the sofa <w>cradling</w> the injured cat in her arms.",
                            "target_lang_translations": {
                                "zh": "她坐在沙发上，双臂<w>怀抱</w>着那只受伤的猫。"
                            }
                        },
                        {
                            "text": "He was <w>cradling</w> the fragile vase as if it were made of thin ice.",
                            "target_lang_translations": {
                                "zh": "他小心翼翼地<w>怀抱</w>着那个易碎的花瓶，仿佛它薄如冰片。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cradling in arms",
                        "gently cradle"
                    ],
                    "target_lang_definitions": {
                        "zh": "温柔且保护性地抱住某人或某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "怀抱",
                                "target_lang_sense_clarification": "指用双臂温柔地抱住。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12ccba80-016b-3409-af07-450b1e06f433",
                    "sense_definition": "To rock a baby gently, typically to help them fall asleep.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The father <w>cradled</w> the crying infant until the room was silent.",
                            "target_lang_translations": {
                                "zh": "父亲轻轻<w>摇</w>着哭闹的婴儿，直到房间安静下来。"
                            }
                        },
                        {
                            "text": "She sang a soft lullaby while <w>cradling</w> the baby to sleep.",
                            "target_lang_translations": {
                                "zh": "她唱着轻柔的摇篮曲，把婴儿<w>摇</w>入梦乡。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cradle to sleep"
                    ],
                    "target_lang_definitions": {
                        "zh": "轻轻摇晃婴儿，通常是为了哄其入睡。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "摇",
                                "target_lang_sense_clarification": "指通过摇晃动作哄孩子入睡。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e2e4043-db00-32b5-85ff-9ecf01af88ae",
                    "sense_definition": "In lacrosse, to move the stick back and forth to keep the ball in the pocket using centrifugal force.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player began <w>cradling</w> the ball as he ran toward the goal.",
                            "target_lang_translations": {
                                "zh": "球员向球门跑去时，开始<w>持球摆动</w>。"
                            }
                        },
                        {
                            "text": "You must learn how to <w>cradle</w> properly to prevent the defender from poking the ball away.",
                            "target_lang_translations": {
                                "zh": "你必须学会正确地<w>持球摆动</w>，以防防守队员把球捅走。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cradle the ball"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to the sport of lacrosse"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在长曲棍球运动中，通过摆动球杆利用离心力使球保持在球袋内。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "持球摆动",
                                "target_lang_sense_clarification": "长曲棍球术语，指保持球在网兜内的动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}