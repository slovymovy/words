        "fr-extract.jsonl": [
            {
                "entry_id": "a2cd911e-fec6-3ad1-8194-d09f4168c814",
                "word": "gynocide",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f3453bc2-6019-4ccb-9145-23e60cfdbbcd",
                        "entry_id": "a2cd911e-fec6-3ad1-8194-d09f4168c814",
                        "tags": [
                            "plural"
                        ],
                        "form": "gynocides"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e94e5cc-8989-3fc2-a256-5b81b5738382",
                        "entry_id": "a2cd911e-fec6-3ad1-8194-d09f4168c814",
                        "glosses": [
                            "Tentative d’éliminer les femmes."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "e91f0646-7cfb-4016-96c3-8b18f26b04b1",
                                "sense_id": "1e94e5cc-8989-3fc2-a256-5b81b5738382",
                                "text": "Antoinette Fouque, adoptant le ton de l’incantation féminine, dénonce alors les Féministes révolutionnaires qui contribuent elles-mêmes au « gynocide »."
                            },
                            {
                                "example_id": "6dacb893-5285-46cf-abed-ae464fd35a87",
                                "sense_id": "1e94e5cc-8989-3fc2-a256-5b81b5738382",
                                "text": "Ce gynocide [l'avortement sélectif des fœtus féminins, l’infanticide ou l’abandon des petites filles en Chine] est semblable à celui qui se déroule, dans le plus grand silence médiatique, aux Émirats Arabes Unis et en Inde où le manque de femmes pose de graves problèmes."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff3fbdd5-3bd9-3f52-906d-a565d115eb66",
                        "entry_id": "a2cd911e-fec6-3ad1-8194-d09f4168c814",
                        "glosses": [
                            "Crime de masse patriarcal, usant de formes et de degrés variés de violence jusqu’à la mort, perpétré par le groupe des hommes à l’encontre des femmes afin de les affaiblir, les avilir, les contrôler et les asservir durablement en tant que groupe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b35ec73-e09f-4ba0-ac76-3b54ab096b91",
                                "sense_id": "ff3fbdd5-3bd9-3f52-906d-a565d115eb66",
                                "text": "Nous sommes ici ce soir pour parler de gynocide. Un gynocide est la mutilation, le viol et/ou le meurtre systématiques des femmes par les hommes. Gynocide est le mot qui désigne la violence perpétrée sans relâche par la classe de genre hommes contre la classe de genre femmes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "945626d1-2570-4c82-aefa-c7c8178c4bf2",
                        "source_entry_id": "a2cd911e-fec6-3ad1-8194-d09f4168c814",
                        "target_lang_word": "femicide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "femicide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b96e2d7d-0e04-32ec-aae8-75603980940e",
                                        "entry_id": "084d667e-cf63-3282-84c7-8b5ccd3b519a",
                                        "glosses": [
                                            "The killing of a woman or girl, originally (figurative) with reference to loss of virtue but now usually (law) specifically because of their gender and especially such a killing by a man motivated by misogyny."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39e95aff-3c53-40a8-9634-9a587a7d31ab",
                                                "sense_id": "b96e2d7d-0e04-32ec-aae8-75603980940e",
                                                "text": "One of the most pernicious nuisances of London is the insistence of voluptuaries, who, relying on the respectability of their rank, and the weight of their purse, endevour in open day to seduce young women who attract their attention in the public streets!... This species of delinquency may be denominated femicide; for the monster who betrays a credulous virgin, and consigns her to infamy, is in reality a most relentless murderer!"
                                            },
                                            {
                                                "example_id": "4f18c4c5-127c-4045-8639-a89a489406cc",
                                                "sense_id": "b96e2d7d-0e04-32ec-aae8-75603980940e",
                                                "text": "But when Mexican feminists hit the streets on Valentine’s Day to denounce their country’s worsening femicide crisis, she saw a chance to ensure her mother’s life and death were remembered."
                                            },
                                            {
                                                "example_id": "915d9436-0bef-431b-a0d4-6c6e58d5661b",
                                                "sense_id": "b96e2d7d-0e04-32ec-aae8-75603980940e",
                                                "text": "Mexico is tied with Paraguay, Uruguay and Bolivia as the countries with the fourth-highest rates of femicide in Latin America and the Caribbean, according to the latest data from the United Nations economic commission for Latin America and the Caribbean, at 1.3 such deaths for every 100,000 women in 2023."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "693c0faf-fe2b-319c-8cc5-0c71bbbcb7f9",
                                        "entry_id": "084d667e-cf63-3282-84c7-8b5ccd3b519a",
                                        "glosses": [
                                            "A person who commits such an act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70ff6506-a2d6-4511-abeb-6b3a124ff8a0",
                        "source_entry_id": "a2cd911e-fec6-3ad1-8194-d09f4168c814",
                        "target_lang_word": "gynocide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gynocide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b68747b3-5abf-328a-94a9-7454b021d7a6",
                                        "entry_id": "fe5d6f06-ca52-3b1c-b84a-a59b748f0751",
                                        "glosses": [
                                            "The killing of women and girls, especially considered as a social phenomenon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4da9677a-7961-4fe8-9ea1-430189e95d73",
                                                "sense_id": "b68747b3-5abf-328a-94a9-7454b021d7a6",
                                                "text": "We find that millions upon millions of women have died as the victims of organized gynocide."
                                            },
                                            {
                                                "example_id": "22f968c5-6467-4fda-a335-51b7bbccaf91",
                                                "sense_id": "b68747b3-5abf-328a-94a9-7454b021d7a6",
                                                "text": "In the contemporary Age of Sex Crime, it is another traditional female scapegoat, the prostitute, who is the paradigmatic target of gynocide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c28ea209-9f5e-4726-9dbc-55d1954cc420",
                        "source_entry_id": "a2cd911e-fec6-3ad1-8194-d09f4168c814",
                        "target_lang_word": "ginocidio",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d77a0001-5d99-4525-af36-577b21c211d1",
                        "source_entry_id": "a2cd911e-fec6-3ad1-8194-d09f4168c814",
                        "target_lang_word": "γυναικοκτονία",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "γυναικοκτονία",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "401faf2c-d0b2-331b-bfb3-d449b5fe8c5d",
                                        "entry_id": "4cca3052-e8a0-353a-9218-08dde8d5a477",
                                        "glosses": [
                                            "η δολοφονία γυναίκας (ιδίως όταν υποκρύπτονται μισογυνικά κίνητρα)"
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa53f7de-d2f0-4d1a-8d5e-a16807c5df19",
                                                "sense_id": "401faf2c-d0b2-331b-bfb3-d449b5fe8c5d",
                                                "text": "※ Όλο και περισσότερες επιστημονικές μελέτες περιγράφουν τη γυναικοκτονία ως ένα «νέο» εγκληματολογικό και ανθρωπολογικό φαινόμενο που αφορά τις πιο ακραίες εκδηλώσεις σεξιστικής βίας από μέρους των ανδρών σε βάρος των γυναικών, οι οποίες δολοφονήθηκαν, επειδή παραβίασαν τον δήθεν προκαθορισμένο –βιολογικά και κοινωνικά– ρόλο τους ως… γυναίκες. (*)"
                                            },
                                            {
                                                "example_id": "77611795-0564-4b35-b937-bac928eaa991",
                                                "sense_id": "401faf2c-d0b2-331b-bfb3-d449b5fe8c5d",
                                                "text": "※ «Η Αμίλητη»: Η ιστορία μιας φρικτής γυναικοκτονίας του 1850 που ανεβαίνει στη Λυρική. Ένα σύγχρονο χορικό με στίχους από πραγματικά μοιρολόγια αφηγείται την συγκλονιστική ιστορία της Μηλιάς, μιας νεαρής γυναίκας που δολοφονήθηκε από τον πατέρα και τα αδέλφια της, για να «ξεπλυθεί η ντροπή» της οικογένειας. (www.lifo.gr, 30/9/2019)"
                                            },
                                            {
                                                "example_id": "a6dbb585-d4de-461b-815d-024f1ebf744f",
                                                "sense_id": "401faf2c-d0b2-331b-bfb3-d449b5fe8c5d",
                                                "text": "※ Γυναικοκτονία στη Θεσσαλονίκη: 49χρονος δολοφόνησε τη σύζυγό του και παραδόθηκε (news247.gr, 29/11/2021 https://www.news247.gr/koinonia/thessaloniki-dolofonise-ti-gynaika-toy-kai-pige-sto-tmima-gia-na-paradothei.9442242.html)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b378878-3350-4301-8a85-4bc6dfb680ff",
                        "source_entry_id": "a2cd911e-fec6-3ad1-8194-d09f4168c814",
                        "target_lang_word": "jinkujî",
                        "target_lang_code": "ku",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jinkujî",
                                "target_lang_code": "ku",
                                "target_senses": [
                                    {
                                        "sense_id": "83896a95-16f2-3e5a-bd9e-e99e00ffd062",
                                        "entry_id": "0c9ce652-365b-302f-b6d1-05d6684ca720",
                                        "glosses": [
                                            "Kuştina jinan."
                                        ],
                                        "tags": [
                                            "mirin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5461a51c-e395-400f-bca7-0667e5b0fc72",
                                                "sense_id": "83896a95-16f2-3e5a-bd9e-e99e00ffd062",
                                                "text": "Ez bawer im di dirindeyî û jinkujiya zilamekî de destê jinekê li pişt e."
                                            },
                                            {
                                                "example_id": "58e88d1a-f29d-4077-977b-1f1983b80c5c",
                                                "sense_id": "83896a95-16f2-3e5a-bd9e-e99e00ffd062",
                                                "text": "Dil dixwest ku di vê nivîsê de em qala têkoşîn, berxwedan, jêhatîbûn û destkeftiyên jinan ên bi derfêtên kêm, lê bi xebatên serkeftî dimeşînin bikin. Lê mixabin meseleya jinkujiyê nayê taloqkirin û temaşekirin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
