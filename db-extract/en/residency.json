                                    },
                                    {
                                        "sense_id": "37c8b0ae-cdc8-3419-8e3f-01eeba86b64d",
                                        "entry_id": "b1920deb-8a8e-3a18-ac38-ca78b6c6ccf0",
                                        "glosses": [
                                            "Auftreten einer Person bei der Veranstaltung einer Partei, Organisation oder Ähnlichem, zu der sie nicht gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0a14299-c66d-4576-a8f2-a1fb14f0c0bf",
                                                "sense_id": "37c8b0ae-cdc8-3419-8e3f-01eeba86b64d",
                                                "text": "„Beim Grünen-Parteitag 2016 sorgte Resch fast für einen Eklat, weil er bei einem Gastauftritt von Daimler-Chef Dieter Zetsche auf einer Gegenrede bestand.“"
                                            }
                                        ],
