                        "glosses": [
                            "causative; factitive (verbal mode where the subject causes the action to be done)"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "0e24fc3a-bad7-4899-ae90-cf49a937460a",
                                "sense_id": "802ad8c4-4915-31c7-a648-936a16ba2a35",
                                "text": "Le factitif s’applique à un verbe transitif et indique que le sujet fait effectuer une action par un autre agent que lui-même.",
                                "translation": "The factitive applies itself to a transitive verb and indicates that the subject has an action performed by an agent other than itself.",
                                "english": "The factitive applies itself to a transitive verb and indicates that the subject has an action performed by an agent other than itself."
                            }
                        ]
