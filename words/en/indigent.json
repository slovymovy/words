{
    "word_family": [
        "indigence",
        "indigently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4ff2faab-ed0a-367a-8a00-82fb9090a4b5",
                    "sense_definition": "Extremely poor and lacking the basic necessities of life.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "poverty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital provides free medical care for <w>indigent</w> patients who cannot afford insurance.",
                            "target_lang_translations": {
                                "zh": "这家医院为负担不起保险费的<w>贫困</w>患者提供免费医疗服务。"
                            }
                        },
                        {
                            "text": "The state is required to provide legal counsel for <w>indigent</w> defendants in criminal cases.",
                            "target_lang_translations": {
                                "zh": "州政府有责任在刑事案件中为<w>贫困</w>被告人提供法律顾问。"
                            }
                        }
                    ],
                    "synonyms": [
                        "destitute",
                        "impoverished",
                        "needy",
                        "penniless"
                    ],
                    "antonyms": [
                        "affluent"
                    ],
                    "common_phrases": [
                        "indigent patients",
                        "indigent defendants"
                    ],
                    "target_lang_definitions": {
                        "zh": "非常贫困的；贫乏的，缺乏基本生活必需品的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贫困的",
                                "target_lang_sense_clarification": "生活极度穷困"
                            },
                            {
                                "target_lang_word": "贫乏的",
                                "target_lang_sense_clarification": "资源或财力极度欠缺"
                            },
                            {
                                "target_lang_word": "身无分文的",
                                "target_lang_sense_clarification": "形容极度贫穷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "781c34c4-0e53-3b1d-830b-b034e8746948",
                    "sense_definition": "Lacking or in need of something specific.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lacking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry soil was <w>indigent</w> of the moisture required for the crops to grow.",
                            "target_lang_translations": {
                                "zh": "干燥的土壤<w>匮乏</w>庄稼生长所需的水分。"
                            }
                        },
                        {
                            "text": "The report was <w>indigent</w> of clear evidence to support its bold claims.",
                            "target_lang_translations": {
                                "zh": "该报告<w>缺乏</w>明确的证据来支持其大胆的主张。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely literary or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（书面或旧）缺乏的，缺少某特定事物的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "匮乏的",
                                "target_lang_sense_clarification": "缺少特定资源或要素"
                            },
                            {
                                "target_lang_word": "缺乏的",
                                "target_lang_sense_clarification": "缺少必需事物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1175713-77cf-3639-8392-3d1ba44df6ae",
                    "sense_definition": "A person who is extremely poor and lacks basic necessities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "poverty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city opened a new shelter to provide temporary housing for <w>indigents</w>.",
                            "target_lang_translations": {
                                "zh": "该市开设了一个新的收容所，为<w>贫民</w>提供临时住处。"
                            }
                        },
                        {
                            "text": "Social services struggled to support the growing number of <w>indigents</w> in the downtown area.",
                            "target_lang_translations": {
                                "zh": "社会服务部门难以应对市中心日益增多的<w>穷人</w>的救助需求。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pauper",
                        "beggar"
                    ],
                    "target_lang_definitions": {
                        "zh": "极度贫困者；缺乏基本生活必需品的人"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贫民",
                                "target_lang_sense_clarification": "生活贫困的人"
                            },
                            {
                                "target_lang_word": "穷人",
                                "target_lang_sense_clarification": "缺乏基本财力的人"
                            },
                            {
                                "target_lang_word": "特困人员",
                                "target_lang_sense_clarification": "极度贫困、需要社会救助的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}