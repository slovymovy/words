                        "sense_id": "a9e87cdf-f871-38f7-8f3b-576665037b02",
                        "entry_id": "37867acf-16d2-3c12-bc33-0c3e06a3ce90",
                        "glosses": [
                            "A diminutive of the female given name Caroline."
                        ],
                        "tags": [],
                        "examples": [
