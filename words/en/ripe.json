        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05d63992-295d-3014-a8e0-84c0122bf322",
                    "sense_definition": "To become ripe or mature.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "maturity_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fruit will <w>ripe</w> on the branch if you leave it long enough.",
                            "target_lang_translations": {
                                "ru": "Фрукт <w>созре́ет</w> на ветке, если оставить его там достаточно долго.",
                                "de": "Die Frucht wird am Zweig <w>reifen</w>, wenn man sie lange genug hängen lässt."
                            }
                        },
                        {
                            "text": "We must wait for the corn to <w>ripe</w> before the harvest begins.",
                            "target_lang_translations": {
                                "ru": "Мы должны подождать, пока кукуруза <w>поспе́ет</w>, прежде чем начнется сбор урожая.",
                                "de": "Wir müssen warten, bis der Mais <w>reift</w>, bevor die Ernte beginnt."
                            }
                        }
                    ],
                    "synonyms": [
                        "ripen",
                        "mature"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern English typically uses 'ripen'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться спелым или зрелым.",
                        "de": "Reif oder erwachsen werden."
                    },
                    "translations": {
