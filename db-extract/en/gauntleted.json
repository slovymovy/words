        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cc7fd9c8-dca7-3b95-8d9d-fea4727593bb",
                "word": "gauntleted",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a2fa8b64-a341-3ce9-b76c-30a393b7c4cf",
                        "entry_id": "cc7fd9c8-dca7-3b95-8d9d-fea4727593bb",
                        "glosses": [
                            "Adorned with one or more gauntlets"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f54cf0fd-e472-4fd9-b53e-58428495bfdf",
                                "sense_id": "a2fa8b64-a341-3ce9-b76c-30a393b7c4cf",
                                "text": "It was brought to General Lee as he sat on his horse near the Chancellorsville House, and, unable to open it with his gauntleted hands, he passed it to me with directions to read it to him."
                            },
                            {
                                "example_id": "f97c7074-500f-4a3a-9a82-fdb559846e4d",
                                "sense_id": "a2fa8b64-a341-3ce9-b76c-30a393b7c4cf",
                                "text": "One of the Duke's gauntleted hunting-gloves lay on the floor; she stooped and lifted it and put it to her lips."
                            },
                            {
                                "example_id": "a68033bf-10d7-4359-9443-f8e980b4a0dd",
                                "sense_id": "a2fa8b64-a341-3ce9-b76c-30a393b7c4cf",
                                "text": "Jess, who loved a romance, clasped her gauntleted hands."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd25ce82-7554-365b-9d52-161721ec9dc1",
                        "entry_id": "cc7fd9c8-dca7-3b95-8d9d-fea4727593bb",
                        "glosses": [
                            "Having a gauntlet (overlapping parallel rail tracks)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "02b8c7a5-3444-4415-a395-06dd00f3e319",
                                "sense_id": "fd25ce82-7554-365b-9d52-161721ec9dc1",
                                "text": "The opportunity was also taken to remove one of the few examples of gauntleted tracks in this country, interlacing the down fast and slow lines over the bridge."
                            },
                            {
                                "example_id": "032b977b-2a98-4964-bd4e-053239c11254",
                                "sense_id": "fd25ce82-7554-365b-9d52-161721ec9dc1",
                                "text": "The narrow gauge is gauntleted with the up main line through a tunnel beneath the town and then turns away to its separate station."
                            }
                        ]
                    }
                ],
