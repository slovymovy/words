                                "target_lang_word": "постоянный",
                                "target_lang_sense_clarification": "неизменный"
                            },
                            {
                                "target_lang_word": "действующий",
                                "target_lang_sense_clarification": "имеющий силу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "常设的",
                                "target_lang_sense_clarification": "长期存在、不临时改变的"
                            },
                            {
                                "target_lang_word": "长期有效的",
                                "target_lang_sense_clarification": "一直有效、持续生效的"
                            }
                        ]
