                ],
                "senses": [
                    {
                        "sense_id": "80a2569e-ca91-34d5-b1f1-356aaa438333",
                        "entry_id": "cdc55857-fa19-3b60-9f55-88d7e008ad4b",
                        "glosses": [
                            "Rendre méridional."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "611e6a30-a627-41ca-9ebe-90b9c7a9de89",
                                "sense_id": "80a2569e-ca91-34d5-b1f1-356aaa438333",
                                "text": "L’œuvre des Arabes, qui a survécu à leur domination, a, comme jadis celle des Phéniciens, contribué à méridionaliser la Méditerranée."
                            },
                            {
                                "example_id": "e002bd4a-e43e-419f-bdc3-8eed2d4822b7",
                                "sense_id": "80a2569e-ca91-34d5-b1f1-356aaa438333",
                                "text": "Il s’agit ni plus ni moins de déterritorialiser la langue, de la méridionaliser, de l’orientaliser de Bruxelles à Tanger, de Paris à Genève, de Port-au-Prince à Montréal."
                            },
                            {
                                "example_id": "14da6099-5cef-4fc6-9052-e866c010bf49",
                                "sense_id": "80a2569e-ca91-34d5-b1f1-356aaa438333",
                                "text": "Le centre a la capacité réconciliatrice d’attirer à lui ce qui n’est pas au centre, si bien qu’il méridionalise le Nord et septentrionalise le Midi. Dans cette activité fusionnelle on perd sans doute le détail pittoresque, mais on y gagne l’unité."
                            }
                        ]
                    }
                ],
