                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7727e93d-30ba-3197-80d3-fc2f4ea668d2",
                                        "entry_id": "0fefa91b-1502-3260-b5b4-599837db0144",
                                        "glosses": [
                                            "A mountain lion or cougar (Puma concolor)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68863d33-78b0-3ec2-8b3b-72153c4aad48",
                                        "entry_id": "0fefa91b-1502-3260-b5b4-599837db0144",
                                        "glosses": [
                                            "Any feline belonging to the genus Puma."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35f4d691-6f06-3f03-bf74-5dfb3234b09b",
                                        "entry_id": "0fefa91b-1502-3260-b5b4-599837db0144",
                                        "glosses": [
                                            "A woman in her 20s or 30s who seeks relationships with younger men; a younger cougar."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4f3d918-9115-46ab-8893-6e643d247a0e",
                                                "sense_id": "35f4d691-6f06-3f03-bf74-5dfb3234b09b",
                                                "text": "“Younger can be good. How much younger?” Regina asked, inspecting the appetizer plates for any lingering bites. “I don't know,” Alexa said frowning. “Why does that matter?” “Less than eight years makes you a Puma. Over eight years makes you a Cougar,” Regina said wisely, grinning as Lauren nodded excitedly in agreement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f71aad1f-9550-4cb3-bf91-e136ac830930",
                        "source_entry_id": "672a5f82-bde5-345a-9250-74a537fef5dd",
                        "source_sense_id": "6df455ee-bb6f-30cf-9919-0339ec259d74",
                        "source_sense_description": "bepaald soort zoogdier, Felis concolor",
                        "target_lang_word": "cougar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cougar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94612256-d80e-3c26-bee9-6dfb3d073e1a",
                                        "entry_id": "4c15d9c7-aeca-3a38-a0a9-e7790b0df59f",
                                        "glosses": [
                                            "A wild feline, of species Puma concolor, native to the Americas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46408a23-c11a-4452-b357-ccc03eb201f1",
                                                "sense_id": "94612256-d80e-3c26-bee9-6dfb3d073e1a",
                                                "text": "They are found in Brasil, Paraguay, and in the country of the Amazons; and there is reason to believe that the animal, described by some travellers, under the name of the Ocorome, in Peru, is the same as the cougar, as well as that in the country of the Iroquois, which has been considered as a tiger, thought it is neither striped like that animal, nor spotted like the panther."
                                            },
                                            {
                                                "example_id": "53d63ec4-9e41-4b1a-bfa6-07b837ddcade",
                                                "sense_id": "94612256-d80e-3c26-bee9-6dfb3d073e1a",
                                                "text": "The Cougar has entirely disappeared, or is very rarely met with. This animal was about the size of the wolf, of a gray color, strong, active, fierce and untameable."
                                            },
                                            {
                                                "example_id": "6353ccc4-3b36-44f4-8962-d4abc39cd03e",
                                                "sense_id": "94612256-d80e-3c26-bee9-6dfb3d073e1a",
                                                "text": "The only indigenous long tailed cat in America north of the parallel of 30 degrees is the cougar. The wild cats, so called, are lynxes with short tails; and of these there are three distinct species."
                                            },
                                            {
                                                "example_id": "20dcba1c-0179-4d8b-834f-8fc35548a98d",
                                                "sense_id": "94612256-d80e-3c26-bee9-6dfb3d073e1a",
                                                "text": "Winter’s task was to illustrate cougars—also known as mountain lions—in an urban environment. His research led him to biologist Jeff Sikich, whose work with a mountain lion population in the Santa Monica Mountains National Recreation Area on the outskirts of L.A. seemed promising."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61c1b3ed-ca25-3874-b1f0-22293828f0ac",
                                        "entry_id": "4c15d9c7-aeca-3a38-a0a9-e7790b0df59f",
                                        "glosses": [
                                            "An older woman who actively seeks the casual, often sexual, companionship of younger men, by implication a female “sexual predator”."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96ca33d2-22da-4c17-853d-b87357d1822b",
                                                "sense_id": "61c1b3ed-ca25-3874-b1f0-22293828f0ac",
                                                "text": "A cougar approached Warren at the Palomino Club and asked for a dance."
                                            },
                                            {
                                                "example_id": "83bdd5ba-0d37-42e3-8070-8f14c6139ee8",
                                                "sense_id": "61c1b3ed-ca25-3874-b1f0-22293828f0ac",
                                                "text": "I am 26 years old and in a respectful but super-sexual relationship with a recent divorcée in her 40s. (A \"cougar,\" in local slang.)"
                                            },
                                            {
                                                "example_id": "4d26c6d7-8693-4e28-af60-c3ad1d6d5fd5",
                                                "sense_id": "61c1b3ed-ca25-3874-b1f0-22293828f0ac",
                                                "text": "Barney Stinson: She's a cougar, Ted! / Robin Scherbatsky: I thought you said you can't be a cougar if you're over 50."
                                            },
                                            {
                                                "example_id": "3563c9e8-0af8-4353-86fd-e9a5aab7d834",
                                                "sense_id": "61c1b3ed-ca25-3874-b1f0-22293828f0ac",
                                                "text": "“Younger can be good. How much younger?” Regina asked, inspecting the appetizer plates for any lingering bites. “I don't know,” Alexa said frowning. “Why does that matter?” “Less than eight years makes you a Puma. Over eight years makes you a Cougar,” Regina said wisely, grinning as Lauren nodded excitedly in agreement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
