                    {
                        "translation_id": "8afa0f22-163f-49bb-ab69-fd6ca9c8abc8",
                        "source_entry_id": "b72f1e00-7a20-3013-84b1-e7363c298544",
                        "source_sense_id": "6d8e8e3a-1dd7-3ea8-833a-371e98e37006",
                        "target_lang_word": "Forstwirt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Forstwirt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bd8e441-afb4-36ee-96a7-c9966d7dcab9",
                                        "entry_id": "100a3b7e-9681-33b0-983b-7c1141bd0b14",
                                        "glosses": [
                                            "Person, die Wald nach ökonomischen Grundsätzen bewirtschaftet oder bewirtschaften lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81468cc5-b8bd-49ec-9008-d567da456b5c",
                                                "sense_id": "3bd8e441-afb4-36ee-96a7-c9966d7dcab9",
                                                "text": "„Die Wildschweinpopulation stellt seit Jahren ein zunehmendes Problem für Land- und Forstwirte dar.“"
                                            },
                                            {
                                                "example_id": "9275559c-4962-4067-be7a-e1def46e1f09",
                                                "sense_id": "3bd8e441-afb4-36ee-96a7-c9966d7dcab9",
                                                "text": "„Die Forstwirte betrachteten es als gefährlich und zerstörerisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "732da76d-e23b-3a27-96ee-95be5244c7c8",
                                        "entry_id": "100a3b7e-9681-33b0-983b-7c1141bd0b14",
                                        "glosses": [
                                            "staatlich anerkannter Ausbildungsberuf für einen Waldarbeiter in Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa0a619b-768e-4f24-9ec9-202955e4babf",
                                                "sense_id": "732da76d-e23b-3a27-96ee-95be5244c7c8",
                                                "text": "„Ein Forstwirt führt alle anfallenden Tätigkeiten im Forstbetrieb (Waldarbeit) aus, von der Begründung neuer Waldbestände bis zur Holzernte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67e0e3ab-2cee-4c5d-a9dd-8f1eb1518437",
                        "source_entry_id": "b72f1e00-7a20-3013-84b1-e7363c298544",
                        "source_sense_id": "6d8e8e3a-1dd7-3ea8-833a-371e98e37006",
                        "target_lang_word": "лесник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лесник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9a0cdfc9-f17b-391c-995a-0255bd2f20ab",
                                        "entry_id": "f4e91a36-586f-3fed-adf0-d31753dff148",
                                        "glosses": [
                                            "лесной сторож"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52aff9ca-0ee5-423e-8ccd-8be44c1ab63f",
                                                "sense_id": "9a0cdfc9-f17b-391c-995a-0255bd2f20ab",
                                                "text": "В деревне своей был я лесником: должность наша такая, чтоб день спать, а ночь ходить по лесу."
                                            },
                                            {
                                                "example_id": "4572c52a-f2fd-4af9-865e-da03862f031f",
                                                "sense_id": "9a0cdfc9-f17b-391c-995a-0255bd2f20ab",
                                                "text": "На хижине, покрытой сосновыми ветвями, написано: «Царю хорошо в своём дворце, а леснику в своём шалаше» .."
                                            },
                                            {
                                                "example_id": "2121e25d-fdc0-4395-ad84-319ec36f201a",
                                                "sense_id": "9a0cdfc9-f17b-391c-995a-0255bd2f20ab",
                                                "text": "Вольнопрактикующий землемер Жмакин и студент Николай Николаевич .. возвращаются со съёмки. Идти домой, в Сердюковку, им поздно и далеко: они заночуют сегодня в казённом лесу, у знакомого лесника — Степана."
                                            },
                                            {
                                                "example_id": "607f6aab-1871-4e91-8265-cca35372222a",
                                                "sense_id": "9a0cdfc9-f17b-391c-995a-0255bd2f20ab",
                                                "text": "За домом волновался сад, и всё долетал оттуда разносимый ветром злой и беспомощный, отрывистый лай собак над ямой в ёлках: там сидела лисица, которую поймал в капкан и принёс на барский двор лесник Казаковой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72dc4dd5-4648-39ce-bb91-f217725200fc",
                                        "entry_id": "f4e91a36-586f-3fed-adf0-d31753dff148",
                                        "glosses": [
                                            "работник лесного хозяйства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6e38607-d94d-424b-9e50-336f78bb020c",
                                                "sense_id": "72dc4dd5-4648-39ce-bb91-f217725200fc",
                                                "text": "Канадский тополь, как выражаются лесники, самое «гонкое» дерево, растёт со сказочной быстротой – по полтора, а то и по два метра в год."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e8ee4d7-3be3-3e7b-b473-e22b6a521051",
                                        "entry_id": "f4e91a36-586f-3fed-adf0-d31753dff148",
                                        "glosses": [
                                            "мифологическое существо у славян"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
