                "senses": [
                    {
                        "sense_id": "dd97006c-a624-3a46-861a-f83c8a2c75ca",
                        "entry_id": "d160197a-fe0c-3c4b-9d37-7ca7448f9186",
                        "glosses": [
                            "Unterricht über einen bestimmten Zeitraum, der dem Aufbau oder der Verbesserung der Deutschkenntnisse der Kursteilnehmer dient"
                        ],
                        "tags": [
                            "Bildung"
                        ],
                        "examples": [
                            {
                                "example_id": "f095745e-ffe3-4660-bae7-5c731e81a088",
                                "sense_id": "dd97006c-a624-3a46-861a-f83c8a2c75ca",
                                "text": "„Dazu erklärte Frau Schmidt, dass es zwar um das Deutschstudium gehe, der Großteil der Studierenden aber an sprachpraktischen Deutschkursen teilnehme.“"
                            },
                            {
                                "example_id": "5e45ea48-49a4-4a02-9415-291f9536b075",
                                "sense_id": "dd97006c-a624-3a46-861a-f83c8a2c75ca",
                                "text": "„An einigen Schulen wird die Information über die stattfindenden Deutschkurse ebenfalls über das interne Computersystem verteilt sowie über die Internetseite der jeweiligen Schule.“"
                            },
                            {
                                "example_id": "1c9455cf-b1ec-4d46-ac1a-1abde70bdd84",
                                "sense_id": "dd97006c-a624-3a46-861a-f83c8a2c75ca",
                                "text": "„Zudem beschließt Luise, einen Deutschkurs zu belegen und ihre Muttersprache wieder zu erlernen.“"
                            },
                            {
                                "example_id": "890d1282-27a5-4b77-b24c-0d475d847383",
                                "sense_id": "dd97006c-a624-3a46-861a-f83c8a2c75ca",
                                "text": "„Während mein Onkel in Russland plötzlich auf der Straße stand und seine Familie zu ernähren hatte, absolvierte mein Vater einen Deutschkurs, der ihm ebenso gezahlt wurde wie ein Praktikum zur Umschulung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
