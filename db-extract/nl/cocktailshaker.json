                    {
                        "translation_id": "954cd0e0-d509-404d-b442-5ea123e5ded5",
                        "source_entry_id": "ff036773-edaf-384c-bfd9-ce2c86827651",
                        "source_sense_id": "ba16b541-0fdb-30b8-8f80-b3c6db487bc2",
