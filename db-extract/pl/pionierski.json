                "translations": [
                    {
                        "translation_id": "0322ec9e-6c65-4a65-adaa-9e1270f2e7d8",
                        "source_entry_id": "935a8166-b07c-3b17-ae84-276354de746d",
                        "source_sense_id": "d0dc2dd4-5cce-392e-936c-d06f90e21814",
                        "target_lang_word": "ground-breaking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ground-breaking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3beca83-ee21-3ab1-980a-c0f6c4345ab4",
                                        "entry_id": "f267b0e8-1f18-31f8-9de7-c0f9c7dab5cb",
                                        "glosses": [
                                            "innovative, different than other things of its type."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "460af536-082b-474c-8255-75b6edaf04f2",
                                                "sense_id": "f3beca83-ee21-3ab1-980a-c0f6c4345ab4",
                                                "text": "ground-breaking technology"
                                            },
                                            {
                                                "example_id": "2f99407c-0f99-432e-aa51-37ef031bccb5",
                                                "sense_id": "f3beca83-ee21-3ab1-980a-c0f6c4345ab4",
                                                "text": "There were papers such as John Aspinall's presidential address about his ground-breaking work on railway electrification in 1909 [...]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ground-breaking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b49860c-8494-321a-a3d6-e7f3410ae0a5",
                                        "entry_id": "d09e7eec-ec49-331d-a99f-e3dc2d4af292",
                                        "glosses": [
                                            "A ceremony marking the commencement of construction of a road, bridge, or building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74627ce-7fd3-44fd-a09e-6b16cc680c76",
                                                "sense_id": "2b49860c-8494-321a-a3d6-e7f3410ae0a5",
                                                "text": "I HAVE had a hand in numerous ground breakings and ribbon cuttings, but never before have I approached one with the eagerness and enthusiasm that I possess for today's ceremony."
                                            },
                                            {
                                                "example_id": "abf653e2-2b9a-4cfd-a122-809333ecf406",
                                                "sense_id": "2b49860c-8494-321a-a3d6-e7f3410ae0a5",
                                                "text": "At anniversaries and graduations, ground breakings and inaugurations — the various community occasions when achievements are recognized and ventures launched […]"
                                            },
                                            {
                                                "example_id": "492396c1-444a-4d75-be21-01029dc4f2d4",
                                                "sense_id": "2b49860c-8494-321a-a3d6-e7f3410ae0a5",
                                                "text": "Union executives are available for ceremonial celebrations of growth (ribbon cuttings, announcements of government contracts, urban redevelopment ground breakings)."
                                            },
                                            {
                                                "example_id": "322796f3-9764-447b-9312-e900a6106b89",
                                                "sense_id": "2b49860c-8494-321a-a3d6-e7f3410ae0a5",
                                                "text": "A ground-breaking ceremony took place on September 15 with representatives from GA and contractor Walker Construction, as well as Rayleigh and Wickford MP Mark Francois (Conservative)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "960663f5-fecf-40e9-a57d-37ef885c80a9",
                        "source_entry_id": "935a8166-b07c-3b17-ae84-276354de746d",
                        "source_sense_id": "d0dc2dd4-5cce-392e-936c-d06f90e21814",
                        "target_lang_word": "trailblazing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trailblazing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "777fd16f-7da3-32f0-a122-6ea374848603",
                                        "entry_id": "6be73211-06a0-3f38-a114-e9fd8cddebb4",
                                        "glosses": [
                                            "Resembling a trailblazer; innovative or pioneering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4805c4cc-55e8-4dce-9478-63f6f639a490",
                                                "sense_id": "777fd16f-7da3-32f0-a122-6ea374848603",
                                                "text": "One can only wonder what led Rothstein to claim that Neville was such a trail-blazing pornographer."
                                            },
                                            {
                                                "example_id": "d7a92345-bd51-4a38-ad93-0f62a755e4b9",
                                                "sense_id": "777fd16f-7da3-32f0-a122-6ea374848603",
                                                "text": "The trailblazing Oaxacan chef Alejandro Ruiz […] has spiked this black-bean sauce with a hidden depth charge of flavor: patches of foliage from a local avocado tree. The leaves electrify the sauce with an unexpected thrum of black licorice."
                                            },
                                            {
                                                "example_id": "cd8193a4-852e-4f85-b2c0-a0eea678df03",
                                                "sense_id": "777fd16f-7da3-32f0-a122-6ea374848603",
                                                "text": "Traditional social codes can sometimes prove as strict as any government diktat. Late last year, Chinese e-commerce giant JD faced a boycott by customers infuriated by its casting of trailblazing woman comedian Yang Li in a promotional live stream."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trailblazing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "025f73df-eefb-3d83-b726-c2e53327287a",
                                        "entry_id": "60d869e4-015f-35a0-a2ee-868b8d4cec68",
                                        "glosses": [
                                            "present participle and gerund of trailblaze"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e5706c7-ecb2-4f43-9e15-f9107c863acd",
                        "source_entry_id": "935a8166-b07c-3b17-ae84-276354de746d",
                        "source_sense_id": "d0dc2dd4-5cce-392e-936c-d06f90e21814",
                        "target_lang_word": "pionýrský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1b750349-a863-443c-ba36-faa21ac55689",
                        "source_entry_id": "935a8166-b07c-3b17-ae84-276354de746d",
                        "source_sense_id": "d0dc2dd4-5cce-392e-936c-d06f90e21814",
                        "target_lang_word": "avant-gardiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avant-gardiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cba2109e-5381-3692-95cd-55e537e66d0d",
                                        "entry_id": "65bfaee2-53e3-3ab6-ac49-8a226646a66d",
                                        "glosses": [
                                            "Qui est à l'avant-garde, en avance sur son temps, à la pointe du progrès ou du savoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95ec0640-c0b6-490d-9f07-b0c1e4836cfb",
                                                "sense_id": "cba2109e-5381-3692-95cd-55e537e66d0d",
                                                "text": "Si transition s'oppose fondamentalement à l'un des traits les plus saillants de la problématique avant-gardiste – la rupture –, elle se réclame en même temps de l’avant-gardisme en en réinvestissant les cadres rhétoriques."
                                            },
                                            {
                                                "example_id": "bdcf941b-4bec-4fe0-9abd-139b28ffb72c",
                                                "sense_id": "cba2109e-5381-3692-95cd-55e537e66d0d",
                                                "text": "Sur le plan littéraire, aussi bien que sur le plan existentiel, la double position de l'appartenance à l’avant-garde et de son dépassement, volontaire ou involontaire, constitue l'idée de base de notre étude. En effet, nous voulons démontrer que le cheminement littéraire de René Daumal part de la transgression des années avant-gardistes pour s'orienter vers la transcendance des années de sa maturité."
                                            },
                                            {
                                                "example_id": "4dc88b9d-0a84-4c50-8907-c91c2f984d0a",
                                                "sense_id": "cba2109e-5381-3692-95cd-55e537e66d0d",
                                                "text": "Que penserait Joseph-Armand Bombardier de tout ça ? « Avant-gardiste comme il l'était, je pense qu'il verrait ça d'un bon oeil », avance Denys Lapointe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7265bf21-9223-3195-8eae-ddfe2ba66ade",
                                        "entry_id": "65bfaee2-53e3-3ab6-ac49-8a226646a66d",
                                        "glosses": [
                                            "Non-conforme aux standards."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a227a5e-60b6-4e90-a312-5597fb1412ab",
                                                "sense_id": "7265bf21-9223-3195-8eae-ddfe2ba66ade",
                                                "text": "Nous avons même vu le Prince lui-même au volant de ce \"colosse illégal\" en Europe, ce qui montre l'engouement même des figures royales pour ce véhicule avant-gardiste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "avant-gardiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "724132e6-d295-3b99-8b9b-ddbb7e1ea308",
                                        "entry_id": "b0cef660-cbc4-37ec-af10-3010cfc21cb1",
                                        "glosses": [
                                            "Personne qui est à l'avant-garde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74dd3f46-706c-4cee-974e-77457e58aa58",
                                                "sense_id": "724132e6-d295-3b99-8b9b-ddbb7e1ea308",
                                                "text": "Solitaire, incompris de la masse, l’avant-gardiste créerait, au prix d’un labeur ingrat, la musique de l’avenir."
                                            },
                                            {
                                                "example_id": "790e48e2-35b5-4d51-90ce-07783bcb2948",
                                                "sense_id": "724132e6-d295-3b99-8b9b-ddbb7e1ea308",
                                                "text": "La femme est, ainsi, dans cet ouvrage, une avant-gardiste, une révélatrice de nouveaux modes de vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "027a9db6-7510-4def-b4e2-7572e032fe92",
                        "source_entry_id": "935a8166-b07c-3b17-ae84-276354de746d",
                        "source_sense_id": "d0dc2dd4-5cce-392e-936c-d06f90e21814",
                        "target_lang_word": "innovateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "innovateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8325aa7f-bce5-33e7-82c4-d0f0df3fb2cb",
                                        "entry_id": "63d1fa6f-a495-3f82-b529-63835669d13f",
                                        "glosses": [
                                            "Personne qui est à l’origine de nouveauté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "602ca8b6-dae7-4f29-828b-e66e46b73f23",
                                                "sense_id": "8325aa7f-bce5-33e7-82c4-d0f0df3fb2cb",
                                                "text": "[Delacroix] est, dans son art, l'innovateur et l'oseur par excellence."
                                            },
                                            {
                                                "example_id": "edd3eed7-1b09-4c52-8c6f-58b52069de9b",
                                                "sense_id": "8325aa7f-bce5-33e7-82c4-d0f0df3fb2cb",
                                                "text": "Toutefois, si l’innovativité est un trait assez général de la personnalité, il va se manifester différemment d’un domaine à l’autre : un innovateur en matière d’informatique ne sera pas nécessairement un innovateur en matière de produits culturels ou d’alimentation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c8b9e28-2bb0-3b14-afb9-71ca205445ef",
                                        "entry_id": "63d1fa6f-a495-3f82-b529-63835669d13f",
                                        "glosses": [
                                            "Chef d’entreprise ou salarié, qui, au sein d’une entreprise, innove ou fait des innovations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c748bbf-7015-425c-a7b9-f15a9f3dcaf3",
                                                "sense_id": "0c8b9e28-2bb0-3b14-afb9-71ca205445ef",
                                                "text": "Siemens et Edison furent véritablement les premiers innovateurs. Ils ont recherché systématiquement (...) où il leur était possible d'innover."
                                            },
                                            {
                                                "example_id": "0dfdff11-7cfb-4ce5-b365-ec6a223ba1cc",
                                                "sense_id": "0c8b9e28-2bb0-3b14-afb9-71ca205445ef",
                                                "text": "Un innovateur vraiment radical. Elon Musk est l’un des seuls entrepreneurs vivants capable de se lancer des défis d’innovation jugés a priori inatteignables. Il n’hésite pas à bousculer les règles établies pour inventer des services avec des modèles qui deviennent progressivement des références dans leur secteur, tels que : x.com pour la banque en ligne ou PayPal pour les systèmes de paiement en ligne."
                                            },
                                            {
                                                "example_id": "13d798f2-8969-4c92-a1fc-1f24f55b309e",
                                                "sense_id": "0c8b9e28-2bb0-3b14-afb9-71ca205445ef",
                                                "text": "Devenir une innovatrice ou un innovateur ne dépend, pour une grande part, que de vous !"
                                            },
                                            {
                                                "example_id": "a2e59bf7-d62c-4cbf-8c20-df8f94d84aa8",
                                                "sense_id": "0c8b9e28-2bb0-3b14-afb9-71ca205445ef",
                                                "text": "L'innovateur est celui qui définit (ou modifie) le standard technique et le modèle économique puis qui démontre la validité de ses choix en réalisant les premières ventes significatives,"
                                            },
                                            {
                                                "example_id": "ba723d2f-2bbd-4c27-ac15-5c3fa6f8af8d",
                                                "sense_id": "0c8b9e28-2bb0-3b14-afb9-71ca205445ef",
                                                "text": "Un vendeur qui arrive à vendre des réfrigérateurs à des Esquimaux pour empêcher leur nourriture de geler, sera un innovateur tout comme s'il avait lancé de nouveaux produits brevetés ou inventé un nouveau produit."
                                            },
                                            {
                                                "example_id": "ae00598d-c543-4199-9f53-10b66797773a",
                                                "sense_id": "0c8b9e28-2bb0-3b14-afb9-71ca205445ef",
                                                "text": "Notre étude distingue quatre types d'innovateurs : (1) ceux qui créent une start-up, (2) les intrapreneurs (qui initient une structure innovante au sein de l'entreprise), (3) les innovateurs de produits (qui inventent un nouveau produit), et (4) les innovateurs de processus (qui élaborent un nouveau processus)."
                                            },
                                            {
                                                "example_id": "caba15b0-12f9-4c81-ab0f-2db11cb09d00",
                                                "sense_id": "0c8b9e28-2bb0-3b14-afb9-71ca205445ef",
                                                "text": "Un schéma qu'il est nécessaire de connaître pour toute personne travaillant avec des nouvelles technologies est celui du dilemme de l'innovateur tiré du livre du même nom de Clayton Christensen"
                                            },
                                            {
                                                "example_id": "cf2cff52-4989-4e81-9575-b20b19512a53",
                                                "sense_id": "0c8b9e28-2bb0-3b14-afb9-71ca205445ef",
                                                "text": "L'inventeur ou le concepteur (d'un objet ou d'une organisation) peuvent être des génies dénués de sens pratique, mais pas l'innovateur qui se charge de trouver un marché ou un usage à ces découvertes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df685f13-8fc9-3b16-b642-c15cfce629f7",
                                        "entry_id": "63d1fa6f-a495-3f82-b529-63835669d13f",
                                        "glosses": [
                                            "Individu et plus particulièrement consommateur, qui innove en adoptant en premier une innovation proposée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0401fcd-7c4a-4c54-a7ad-95bd9bb31d27",
                                                "sense_id": "df685f13-8fc9-3b16-b642-c15cfce629f7",
                                                "text": "\"Deux sociologues Everett Rogers et Roger Moore opposent les conservateurs aux innovateurs."
                                            },
                                            {
                                                "example_id": "80b00bee-174d-4fb1-8207-d5a56e97d58c",
                                                "sense_id": "df685f13-8fc9-3b16-b642-c15cfce629f7",
                                                "text": "Dans la mesure où les innovateurs initient le processus de diffusion, ils ont une importance toute particulière"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "innovateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0db1de06-cc1d-3af3-87e2-fb865f0bc780",
                                        "entry_id": "d1216d22-9387-331d-9fa1-8c24cd11120a",
                                        "glosses": [
                                            "Qui innove."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38902133-f054-4ddb-839d-0332342b4368",
                                                "sense_id": "0db1de06-cc1d-3af3-87e2-fb865f0bc780",
                                                "text": "Améliorer les performances innovatrices des entreprises est un des objectifs des Nations Unies."
                                            },
                                            {
                                                "example_id": "25094225-cec1-4dd0-b20c-c25e8dec4fcc",
                                                "sense_id": "0db1de06-cc1d-3af3-87e2-fb865f0bc780",
                                                "text": "Les organisations innovatrices utilisent des technologies de pointe pour répondre aux nouveaux défis et aux besoins très spécifiques de marchés de plus en plus exigeants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f89b1f4-44ae-35ac-9b4d-ddf2cb63540e",
                                        "entry_id": "d1216d22-9387-331d-9fa1-8c24cd11120a",
                                        "glosses": [
                                            "Qui recherche la nouveauté."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc0a8a74-f103-3623-9b01-052eb7688a00",
                                        "entry_id": "d1216d22-9387-331d-9fa1-8c24cd11120a",
                                        "glosses": [
                                            "Qui tend à innover en politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16337e40-c453-46a5-9501-5a86a2d88cb2",
                                                "sense_id": "cc0a8a74-f103-3623-9b01-052eb7688a00",
                                                "text": "Un pouvoir innovateur en Russie, en Chine, au Portugal, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2e9e786-9eb7-3e35-86b1-1d1489f281ac",
                                        "entry_id": "d1216d22-9387-331d-9fa1-8c24cd11120a",
                                        "glosses": [
                                            "Qui est favorable à la vie moderne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b74dddca-3ba6-4275-9a92-c0ba963057e0",
                                                "sense_id": "e2e9e786-9eb7-3e35-86b1-1d1489f281ac",
                                                "text": "De toutes les villes du département du Nord, Douai est, hélas ! celle qui se modernise le plus, où le sentiment innovateur a fait les plus rapides conquêtes, où l’amour du progrès social est le plus répandu. Là, les vieilles constructions disparaissent de jour en jour, les antiques mœurs s’effacent. Le ton, les modes, les façons de Paris y dominent. […] Le cossu des formes bataves aura cédé devant la changeante élégance des nouveautés françaises."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
