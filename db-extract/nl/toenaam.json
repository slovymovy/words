                "translations": [
                    {
                        "translation_id": "aaf7a352-64fe-4429-9ca4-40085b4f1ab9",
                        "source_entry_id": "ae6a131e-d0dc-386d-b68a-339e8f0816d7",
                        "source_sense_id": "0c9c825a-2e12-3437-b375-1debbfc5a8a4",
