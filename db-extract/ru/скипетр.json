                "senses": [
                    {
                        "sense_id": "e10dfd71-eee2-3dda-8576-f454f104683c",
                        "entry_id": "7d25a069-3df2-323f-bac5-88cb2ab136cf",
                        "glosses": [
                            "истор. символ власти в виде укороченного посоха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3b01eba-e9a1-4f90-9606-b8dd032c4ad8",
                                "sense_id": "e10dfd71-eee2-3dda-8576-f454f104683c",
                                "text": "Монарху подобает милосердье //Самой короны пуще; грозный скипетр, // О мимолётной власти говорящий, // Не только знак величья, но и страха // Толпы, трепещущей пред королями."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ef83fcc-ab23-4a88-8729-cc176ef5ed8c",
                        "source_entry_id": "7d25a069-3df2-323f-bac5-88cb2ab136cf",
                        "source_sense_id": "e10dfd71-eee2-3dda-8576-f454f104683c",
                        "target_lang_word": "scepter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scepter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "48f59522-95a8-3019-a8ac-49efa75a2944",
                                        "entry_id": "c3e5cb1d-a80c-3820-aa09-7ea4a24f7208",
                                        "glosses": [
                                            "American and archaic form of sceptre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "081176ea-6f3d-4b76-8f59-bb3fe885c483",
                                                "sense_id": "48f59522-95a8-3019-a8ac-49efa75a2944",
                                                "text": "Edwards great linage by the mothers ſide,\n Fiue hundred yeeres hath helde the ſcepter vp,"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scepter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6779f63-f185-3e7e-beb7-c9f829b2dd13",
                                        "entry_id": "36b176db-b13e-30e6-a80b-3265380cb746",
                                        "glosses": [
                                            "American form of sceptre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07840a93-483a-471c-8f54-e5d809fa9a7b",
                        "source_entry_id": "7d25a069-3df2-323f-bac5-88cb2ab136cf",
                        "source_sense_id": "e10dfd71-eee2-3dda-8576-f454f104683c",
                        "target_lang_word": "Zepter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zepter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb87384c-1b7b-3813-b507-398f03384022",
                                        "entry_id": "4478e575-04c8-313f-bcb6-7c901d0522e9",
                                        "glosses": [
                                            "eines der Reichsinsignien eines Herrschers (Kaiser, König, später Fürst), das er zu seiner Krönung erhält, die Form eines Stabes hat und meist reich mit Edelsteinen verziert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67535ccd-b5a5-424c-b025-ff19ccc7ae33",
                                                "sense_id": "bb87384c-1b7b-3813-b507-398f03384022",
                                                "text": "„Die Insignien des Königreichs Norwegen, auch Krönungsinsignien genannt, bestehen aus drei Kronen, zwei Zeptern, zwei Reichsäpfeln, dem Reichsschwert und einem Salbungshorn.“"
                                            },
                                            {
                                                "example_id": "18fdd50e-44fb-4246-8561-07cc17e7c5a6",
                                                "sense_id": "bb87384c-1b7b-3813-b507-398f03384022",
                                                "text": "Eine Hand hielt den Schaft des Zepters fest umschlossen, die andere langte nach der zu Boden gefallenen Krone."
                                            },
                                            {
                                                "example_id": "6d77dc8f-3338-46fb-8381-f0a45629df74",
                                                "sense_id": "bb87384c-1b7b-3813-b507-398f03384022",
                                                "text": "„Man hat also Macht, wenn man das Zepter so zu handhaben versteht wie der Pharao oder die Würdenträger des Staates.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
