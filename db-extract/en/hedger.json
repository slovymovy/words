                ],
                "translations": [
                    {
                        "translation_id": "034009e8-0d78-46f0-a019-dac202b8ea4c",
                        "source_entry_id": "bdca688a-0fc2-3015-bd77-04d610c78ce4",
                        "source_sense_id": "51157316-ff85-31f4-8b13-ab56a67b72b9",
                        "source_sense_description": "eine Person, die sich um eine Hecke kümmert; Gärtner",
                        "target_lang_word": "Gärtner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gärtner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                        "entry_id": "466811f2-e496-329e-b181-46d5b9161a23",
                                        "glosses": [
                                            "Person, die beruflich im Gartenbau tätig ist"
                                        ],
                                        "tags": [
                                            "Beruf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9261b79d-2e8c-4969-8f92-71d72caaf50e",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "Ein Gärtner ist bei Wind und Wetter draußen und arbeitet in den Beeten."
                                            },
                                            {
                                                "example_id": "0c1c6692-895d-4076-b5d0-959b621f4803",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "Sie führte ein Telefonat mit dem Gärtner über das Anlegen neuer Rhododendronhecken."
                                            },
                                            {
                                                "example_id": "63ad1bf9-10c4-41fe-9f8c-7d6f3343031e",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "„Der französische Präsident dagegen sieht von seinem Arbeitszimmer nur die Gärtner, die in seinem Privatpark unter den uralten Bäumen den Rhododendron stutzen.“"
                                            },
                                            {
                                                "example_id": "577482b9-3d15-487a-9715-ad0662140884",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "„Ihre wundervollen Kinder würden eine gute Schule besuchen, und sie hätte drei Dienstmädchen, einen Gärtner, einen Chauffeur und eine Köchin.“"
                                            },
                                            {
                                                "example_id": "980a5c37-69f2-4912-93dd-f0d62d23eae3",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "„Anna ist Friedas Schwester und die Frau des Gärtners von Rumbske, den – wie fast alle Männer – der Krieg fortriß.“"
                                            },
                                            {
                                                "example_id": "8ce48aec-8237-4bd4-bc1f-2caa227f117c",
                                                "sense_id": "949bd972-1347-305d-b66e-8a6275ce0abe",
                                                "text": "„Fried kam in die Lehrlingsgruppe der Schreiner, und ihn steckte man zu den Gärtnern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6742ec4-5a71-4f00-bb44-f769a2ca3c04",
                        "source_entry_id": "bdca688a-0fc2-3015-bd77-04d610c78ce4",
                        "source_sense_id": "07566423-4bf7-33ee-b49d-0a37c92902c0",
                        "source_sense_description": "Anwender eines Absicherungsgeschäftes; Hedger",
                        "target_lang_word": "Hedger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f7364d99-f3d1-4f38-9ef7-5e1d816873c1",
                        "source_entry_id": "bdca688a-0fc2-3015-bd77-04d610c78ce4",
                        "source_sense_id": "54043fa7-f1a1-3096-8933-1c92d811801f",
                        "source_sense_description": "Drückeberger",
                        "target_lang_word": "Drückeberger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Drückeberger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                                        "entry_id": "0e596b6a-0a06-365a-bc83-cc6fb203096c",
                                        "glosses": [
                                            "jemand, der sich der Ausführung einer Aufgabe entzieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee226764-875c-4e93-8abd-28a069f743d6",
                                                "sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                                                "text": "Er ist ein richtiger Drückeberger, immer wenn er einen Eintrag belegen soll, verschwindet er."
                                            },
                                            {
                                                "example_id": "b5b51f27-a36b-4310-bf16-f4d195e99179",
                                                "sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                                                "text": "„Die Stimmung in der Kompanie wurde immer schärfer gegen die Banden hinter der Front, vor allem, als die Nachricht kam, dass in Brüssel die Drückeberger aus den Spelunken gekrochen wären, in denen sie sich bei den Einwohnern verborgen gehalten hätten.“"
                                            },
                                            {
                                                "example_id": "798aa86e-42fe-4a8d-9fc5-1e9f3c08fbce",
                                                "sense_id": "f89abe10-21f0-3b95-886d-61d9f109d52b",
                                                "text": "„Ich habe keinen Grund dazu, aber ich fühle mich wie ein Drückeberger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
