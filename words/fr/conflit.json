{
    "word_family": [
        "conflictuel",
        "conflictualité"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "562db5e9-67b9-3a93-a9f0-4f27767c230c",
                    "sense_definition": "Opposition vive ou désaccord profond entre des personnes, des groupes ou des intérêts divergents.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "desaccord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les deux collègues ont réussi à résoudre leur <w>conflit</w> grâce à une discussion franche."
                        },
                        {
                            "text": "Ce désaccord persistant a fini par créer un grave <w>conflit</w> au sein de la famille."
                        }
                    ],
                    "synonyms": [
                        "antagonisme"
                    ],
                    "antonyms": [
                        "accord",
                        "entente",
                        "harmonie"
                    ],
                    "common_phrases": [
                        "entrer en conflit",
                        "résoudre un conflit",
                        "situation de conflit"
                    ]
                },
                {
                    "sense_id": "8d22cc46-8c49-3e21-aea2-fbce9f1686a1",
                    "sense_definition": "Lutte armée ou affrontement violent entre des États ou des forces militaires.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "guerre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreuses organisations humanitaires apportent une aide d'urgence aux civils touchés par le <w>conflit</w>."
                        },
                        {
                            "text": "Le pays voisin a décidé d'intervenir diplomatiquement pour mettre un terme à ce <w>conflit</w> destructeur."
                        }
                    ],
                    "synonyms": [
                        "guerre"
                    ],
                    "antonyms": [
                        "paix"
                    ],
                    "common_phrases": [
                        "conflit armé",
                        "zone de conflit"
                    ]
                },
                {
                    "sense_id": "ea0f9249-219e-32a4-9b3a-38ee02b2488b",
                    "sense_definition": "Incompatibilité ou contradiction logique entre deux règles, normes ou obligations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incompatibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une nouvelle loi a été adoptée pour éviter tout <w>conflit</w> entre ces deux textes juridiques."
                        },
                        {
                            "text": "L'avocat a souligné un <w>conflit</w> évident entre les obligations contractuelles et le droit du travail."
                        }
                    ],
                    "antonyms": [
                        "compatibilité"
                    ],
                    "common_phrases": [
                        "conflit de lois",
                        "conflit de devoirs"
                    ]
                },
                {
                    "sense_id": "0e318780-30a1-3dec-904c-9e30e9f707c2",
                    "sense_definition": "Tiraillement psychologique provoqué par des désirs, des sentiments ou des impératifs moraux contradictoires.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le héros de cette tragédie est déchiré par un profond <w>conflit</w> intérieur."
                        },
                        {
                            "text": "Cette lourde responsabilité a plongé l'adolescent dans un véritable <w>conflit</w> de loyauté."
                        }
                    ],
                    "antonyms": [
                        "sérénité"
                    ],
                    "common_phrases": [
                        "conflit intérieur",
                        "conflit psychique"
                    ]
                },
                {
                    "sense_id": "c2b3acfb-f587-3572-aa73-92ab93e1bc02",
                    "sense_definition": "Incompatibilité survenant lors de la modification concurrente et contradictoire d'un même fichier par plusieurs utilisateurs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le logiciel de gestion de versions a signalé un <w>conflit</w> lors de la fusion du code."
                        },
                        {
                            "text": "Le programmeur doit inspecter les lignes modifiées afin de régler le <w>conflit</w> avant la livraison."
                        }
                    ],
                    "common_phrases": [
                        "résoudre un conflit"
                    ]
                }
            ]
        }
    ]
}