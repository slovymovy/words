                "senses": [
                    {
                        "sense_id": "c9eae648-172e-357a-a521-40c6e2f33da2",
                        "entry_id": "7b0baa14-fd58-33a9-89d7-4223c74be30b",
                        "glosses": [
                            "Transformer un signal ayant une valeur bien définie en une valeur « floue » (comme « grand », « petit », « moyen »)."
                        ],
                        "tags": [
                            "Automatique"
                        ],
                        "examples": [
                            {
                                "example_id": "a57c4f88-f625-4ca2-bac4-6cca14b49f01",
                                "sense_id": "c9eae648-172e-357a-a521-40c6e2f33da2",
                                "text": "Pour \"fuzzifier\" les entrées, nous allons utiliser le programme créé précédemment pour la fonction gaussienne."
                            },
                            {
                                "example_id": "3448cb8b-d684-46d9-838f-8b5603aa4b35",
                                "sense_id": "c9eae648-172e-357a-a521-40c6e2f33da2",
                                "text": "D’autre part, il apparaît intéressant de \"fuzzifier\" le concept de dépendance pour prendre en compte des situations telles que : \"l’âge détermine approximativement le salaire\"."
                            }
                        ]
                    }
                ],
