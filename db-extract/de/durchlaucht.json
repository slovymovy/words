                "senses": [
                    {
                        "sense_id": "1ec2bd1a-21d5-3760-afbf-da7af9f9cbd5",
                        "entry_id": "75e73690-c512-391a-9d3a-e650636493a6",
                        "glosses": [
                            "Anrede für einen Adligen"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5309e064-08d2-45ab-beb6-976afbde838b",
                                "sense_id": "1ec2bd1a-21d5-3760-afbf-da7af9f9cbd5",
                                "text": "Seine Durchlaucht möchte heute keinen Besuch empfangen."
                            },
                            {
                                "example_id": "49bb80d4-9265-43d5-8e59-057c8d16f09e",
                                "sense_id": "1ec2bd1a-21d5-3760-afbf-da7af9f9cbd5",
                                "text": "„Noch in der Hauptstadt hatte der Haushalter Di-Tjän dem Musterprüfling Zai mitgeteilt, daß in Klarenfluß ein Tausendschaftsführer und Günstling seiner Durchlaucht namens Simen lebe, der einer bedeutenden, reichen und wohlgesitteten Familie angehöre.“"
                            },
                            {
                                "example_id": "ada2e111-a745-46c5-ba79-4c106444c3fb",
                                "sense_id": "1ec2bd1a-21d5-3760-afbf-da7af9f9cbd5",
                                "text": "„Man weiß nie recht, wie man mit ihr dran ist und wie man sie nennen soll, Oberförsterin Katzler oder Durchlaucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
