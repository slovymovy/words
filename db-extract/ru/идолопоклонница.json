                    },
                    {
                        "translation_id": "f577b14f-89fe-46aa-ac3a-969b15c2af6f",
                        "source_entry_id": "5f1558ac-c948-3be4-b260-562495dd3b19",
                        "source_sense_id": "90ff579a-92eb-3199-871c-662519299cfa",
                        "target_lang_word": "idolâtre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idolâtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ada3bb84-0033-36a1-8511-a1fe9c6fe7eb",
                                        "entry_id": "a8a35815-b33c-3bdb-bc75-49096b32e412",
                                        "glosses": [
                                            "Qui adore les idoles et leur rend des honneurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2f49849-5f5a-4d9b-b210-a7eaa3ca7252",
                                                "sense_id": "ada3bb84-0033-36a1-8511-a1fe9c6fe7eb",
                                                "text": "Les nations, les peuples idolâtres. — Rendre un culte idolâtre."
                                            },
                                            {
                                                "example_id": "a1496d46-bdea-46b5-960a-3b7ed32ec218",
                                                "sense_id": "ada3bb84-0033-36a1-8511-a1fe9c6fe7eb",
                                                "text": "Donc, le sang de Naboth crie en vous poursuivant,\nAkhab de Samarie, et toi, vile idolâtre !"
                                            },
                                            {
                                                "example_id": "72996871-33f4-4949-8db8-0581930a4b25",
                                                "sense_id": "ada3bb84-0033-36a1-8511-a1fe9c6fe7eb",
                                                "text": "Les Juifs ne voulaient plus de ses mœurs idolâtres, tous les autres de sa domination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47130540-8339-3c75-8972-a3f00e2c4a45",
                                        "entry_id": "a8a35815-b33c-3bdb-bc75-49096b32e412",
                                        "glosses": [
                                            "Qui rend un culte divin à des êtres vivants ou à des choses autres que des idoles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c792bf5b-34dc-4845-b79c-d41bb291e9d2",
                                                "sense_id": "47130540-8339-3c75-8972-a3f00e2c4a45",
                                                "text": "Les Perses, qui adoraient le feu, les égyptiens, qui adoraient les crocodiles, étaient idolâtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc09205c-2bd6-3235-af7a-5ec3c7982d5d",
                                        "entry_id": "a8a35815-b33c-3bdb-bc75-49096b32e412",
                                        "glosses": [
                                            "Qui aime quelqu’un avec excès, ou qui estime trop une chose, qui en raffole."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba2d1901-4496-4c9e-a5d1-c8793ded33e0",
                                                "sense_id": "dc09205c-2bd6-3235-af7a-5ec3c7982d5d",
                                                "text": "Cette femme l’a subjugué, il en est idolâtre."
                                            },
                                            {
                                                "example_id": "acb1bf0e-ec7a-4623-88ee-3b2176d7f378",
                                                "sense_id": "dc09205c-2bd6-3235-af7a-5ec3c7982d5d",
                                                "text": "Cette mère est idolâtre de ses enfants."
                                            },
                                            {
                                                "example_id": "7578cdae-208e-4af8-a488-44ecebb2c620",
                                                "sense_id": "dc09205c-2bd6-3235-af7a-5ec3c7982d5d",
                                                "text": "Cette femme est idolâtre de sa beauté."
                                            },
                                            {
                                                "example_id": "2019daf1-6f3d-4d9d-9c25-8b3a54270935",
                                                "sense_id": "dc09205c-2bd6-3235-af7a-5ec3c7982d5d",
                                                "text": "Madame de Chasteller, bien dirigée par un mari idolâtre des petits moyens qui font tant d’effet à la cour, fut bien reçue des princesses, et jouit bientôt d’une position fort agréable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "idolâtre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd162173-4313-3bed-80ea-b0f3b52b2d91",
                                        "entry_id": "5aac3773-d9ca-3def-b415-59c8e38c307b",
                                        "glosses": [
                                            "Adorateur des idoles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4832886-787b-484c-94a1-1ae26e81ff55",
                                                "sense_id": "fd162173-4313-3bed-80ea-b0f3b52b2d91",
                                                "text": "Es-tu chrétien ? Je répondis que je n’avais point trahi les Génies de ma cabane. À ces mots, l’Indienne fit un mouvement involontaire. Elle me dit : Je te plains de n’être qu’un méchant idolâtre."
                                            },
                                            {
                                                "example_id": "1a896be6-1476-4913-8f36-f8575b4fbac7",
                                                "sense_id": "fd162173-4313-3bed-80ea-b0f3b52b2d91",
                                                "text": "Il y a souvent chez eux, avez-vous ajouté, des exagérations de mortification que vous êtes les premiers à condamner chez les mahométans et les idolâtres."
                                            },
                                            {
                                                "example_id": "eeede2ea-feda-46cc-aaad-1f72aae17f53",
                                                "sense_id": "fd162173-4313-3bed-80ea-b0f3b52b2d91",
                                                "text": "Il y avait même, dans un endroit écarté, une étuve à la romaine ; mais le bon seigneur s’en privait, estimant que c’est un usage des idolâtres."
                                            },
                                            {
                                                "example_id": "1d8dded7-275e-4bf0-aaae-15f7e61b8ec9",
                                                "sense_id": "fd162173-4313-3bed-80ea-b0f3b52b2d91",
                                                "text": "De l'autre côté de l'Arabie, il y a encore des terres conquises à l’Islam, puis des régions habitées par des idolâtres, l’Inde et la Chine, qui atteignent le limbe oriental du disque terrestre."
                                            },
                                            {
                                                "example_id": "5908f797-a96a-4b16-be27-6ef4dbf1de42",
                                                "sense_id": "fd162173-4313-3bed-80ea-b0f3b52b2d91",
                                                "text": "Et ce qu’il y a de certain, c’est que l’Esprit que nous venons de voir chez les idolâtres pythoniser la statue, la matière inerte et l’animal, c’est-à-dire les médiums de pierre, de bois ou de chair vive, communique à chacun d’eux une partie de ses propres facultés, sa vie, son intelligence, sa science et son mouvement au sein de l’air, où il règne en prince; principes aeris hujus[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
