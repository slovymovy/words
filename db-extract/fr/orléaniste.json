                    }
                ],
                "senses": [
                    {
                        "sense_id": "29ffb676-686c-3f98-a0dd-1a82957d6d16",
                        "entry_id": "454c4a58-e586-34c5-bbb4-6b190d7f1fbf",
                        "glosses": [
                            "Partisan du duc d’Orléans et de sa politique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1becac69-47a9-415c-8326-4f8c5e335181",
                                "sense_id": "29ffb676-686c-3f98-a0dd-1a82957d6d16",
                                "text": "Dès lors, la réaction fut maîtresse de la ville. Toutes les opinions étaient représentées dans cette réaction ; jamais on ne vit un pareil mélange de libéraux tournés à l’aigre, de légitimistes, d’orléanistes, de bonapartistes, de cléricaux."
                            },
                            {
                                "example_id": "ce4dcfff-1f5e-4eff-8905-fa1cc1081f36",
                                "sense_id": "29ffb676-686c-3f98-a0dd-1a82957d6d16",
                                "text": "Il me disait qu’il était fâcheux pour nous de voir presque toutes les grandes fortunes aller par mariage aux mains des orléanistes."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
