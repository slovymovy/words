                    },
                    {
                        "translation_id": "c21b9c56-2551-42f5-b929-bbf7f173fe6e",
                        "source_entry_id": "3d347b9c-c9f3-37af-8bcd-7d3d87ea2161",
                        "source_sense_id": "5b1e6f78-9112-33de-b913-1a02b737e1d7",
