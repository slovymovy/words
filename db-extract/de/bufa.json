        "de-extract.jsonl": [
            {
                "entry_id": "d6bf5d52-50b3-3ecd-afa9-707c3ec65f56",
                "word": "Bufa",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4b1a5711-7fa3-338e-b041-778d3dc5d070",
                        "entry_id": "d6bf5d52-50b3-3ecd-afa9-707c3ec65f56",
                        "glosses": [
                            "Bild- und Filmamt"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "e295fc57-042b-44c8-be55-ed1c55080024",
                                "sense_id": "4b1a5711-7fa3-338e-b041-778d3dc5d070",
                                "text": "„Werbearbeit für den Hilfsdienst, für Kriegsanleihen, Aufklärung Neutraler durch Flugblätter und durch Photographien, Anlage eines gewaltigen Archivs von Photos und Filmen dokumentarischen Wertes und Verbreitung von Filmaufnahmen aus Heimat und Kampfgebiet, damit sind die Aufgaben der »Bufa« noch nicht einmal erschöpft.“"
                            },
                            {
                                "example_id": "56ad0c3c-de28-4e2d-a615-6272a2b089fa",
                                "sense_id": "4b1a5711-7fa3-338e-b041-778d3dc5d070",
                                "text": "„Man kann heute keine illustrierte Zeitschrift aufschlagen, ohne auf Bilder zu treffen, die durch den untergedruckten Vermerk »Bufa« oder »Bild- und Film-Amt« ihre Herkunft verraten.“"
                            },
                            {
                                "example_id": "266a55e3-c0e3-4e45-bd79-05710f071045",
                                "sense_id": "4b1a5711-7fa3-338e-b041-778d3dc5d070",
                                "text": "Aber das Reichsschatzamt war immer wieder dahin vorstellig geworden, daß das Reich nicht mit Kosten für wirtschaftliche Einrichtungen des Bufa belastet werden dürfe, die an die Ufa abzutreten seien, und daß die gesamte Tätigkeit des Bufa nunmehr neu geregelt werden müsse."
                            },
                            {
                                "example_id": "a35026e3-7b97-416d-ab2f-54ee190c8822",
                                "sense_id": "4b1a5711-7fa3-338e-b041-778d3dc5d070",
                                "text": "„Die militärischen Stellen, die durch die Gründung des ›Bufa‹ verantwortlich geworden waren, mußten bis zu Ludendorf hinaufgehen, um eine Entscheidung zu erreichen.“"
                            },
                            {
                                "example_id": "d60afd0c-57d7-4c54-bf0c-8ff9395a1535",
                                "sense_id": "4b1a5711-7fa3-338e-b041-778d3dc5d070",
                                "text": "„Die Bufa war ein Kind der Militärs, im Januar 1917 als Bild- und Film-Amt (Bufa) der Armee gegründet.“"
                            },
                            {
                                "example_id": "c2daa956-4ad5-4f98-ae8b-2d6e95bf7575",
                                "sense_id": "4b1a5711-7fa3-338e-b041-778d3dc5d070",
                                "text": "„Die Oberste Heeresleitung betonte von Beginn an, daß das Bufa keine Unterabteilung des AA sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "935855a1-08ce-30dd-96f2-65b9fbd99597",
                        "entry_id": "d6bf5d52-50b3-3ecd-afa9-707c3ec65f56",
                        "glosses": [
                            "(Deutsche) Bundesfachschau für das Hotel- und Gaststättengewerbe"
                        ],
                        "tags": [
                            "Deutschland (BRD)",
                            "1950er-1970er"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "9283fb51-9091-3d78-9bfb-0dd23de55fc0",
                        "entry_id": "d6bf5d52-50b3-3ecd-afa9-707c3ec65f56",
                        "glosses": [
                            "Bundesfachschule"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "ab1c3384-662d-475d-b976-fc7c883f9bc2",
                                "sense_id": "9283fb51-9091-3d78-9bfb-0dd23de55fc0",
                                "text": "„Im Anschluss war Leo Weiß im wissenschaftlichen Bereich tätig und absolvierte von 1975 bis 1977 das Referendariat an der Heinrich-Hübsch-Schule in Karlsruhe mit Abordnungen sowohl an die Bufa Karlsruhe als auch an die Balthasar-Neumann-Schule in Bruchsal, wo er ab Februar 1977 Studienassessor war.“"
                            },
                            {
                                "example_id": "d9146626-408d-4935-a781-cb6ca827bc9d",
                                "sense_id": "9283fb51-9091-3d78-9bfb-0dd23de55fc0",
                                "text": "„An der Bufa als Lehrer tätig zu sein, ist ja eigentlich schon ein Privileg an sich, und es war für mich und ist für alle Kolleginnen und Kollegen an der Heinrich-Meidinger-Schule eine schöne und befriedigende Tätigkeit, motivierte Fachschüler unterrichten zu können.“"
                            },
                            {
                                "example_id": "70698a4e-a529-4951-9c7a-920d9418b876",
                                "sense_id": "9283fb51-9091-3d78-9bfb-0dd23de55fc0",
                                "text": "„Vorgesehen ist am 18. 5. 1984 eine Fachtagung des ZVSHK, am 19. 5. 1984 ein Festakt (vormittags) und ein Festball (abends), an beiden Tagen ein \"Tag der offenen Tür\" mit Ausstellungen und Info-Ständen im Bufa-Gebäude, am 20. 5. 1984 Frühschoppen, Ausklang (vormittags).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "c7f83e22-1ba9-4d1a-8461-9548927f7fd0",
                        "source_entry_id": "d6bf5d52-50b3-3ecd-afa9-707c3ec65f56",
