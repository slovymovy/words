    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3fd72648-6bb2-3902-9b8a-237eed4e1cc5",
                "word": "Suprematism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7817de3a-8a05-3d89-8c27-1aada65b64da",
                        "entry_id": "3fd72648-6bb2-3902-9b8a-237eed4e1cc5",
                        "glosses": [
                            "A genre of abstract art based on simple geometric forms championed by the Russian avant-garde in the early twentieth century."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9bcfd6cb-ed35-4123-a1d0-f06170e5efa5",
                                "sense_id": "7817de3a-8a05-3d89-8c27-1aada65b64da",
                                "text": "The Suprematism of Kasimir Malevich is an even more extreme version of similar character."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6af51b9e-4afc-4bf7-98b5-c8d491369f6a",
                        "source_entry_id": "3fd72648-6bb2-3902-9b8a-237eed4e1cc5",
                        "source_sense_id": "7817de3a-8a05-3d89-8c27-1aada65b64da",
                        "source_sense_description": "genre of abstract art",
                        "target_lang_word": "Suprematismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Suprematismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fe40cc2-1568-354c-8544-3abf5cf04c4e",
                                        "entry_id": "a7ec561c-b700-3e9e-90cd-3842a2b72a59",
                                        "glosses": [
                                            "Stilrichtung der Moderne der bildenden Kunst Russlands, die von 1915 bis zum Beginn der 30er Jahre des 20. Jahrhunderts Geltung hatte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "def82aeb-9a90-4850-b4d1-98d19e148a99",
                                                "sense_id": "4fe40cc2-1568-354c-8544-3abf5cf04c4e",
                                                "text": "„Nicht immer ist die moderne, abstrakte Malerei durch kräftige Farben geprägt; man denke zum Beispiel an das Schwarze Quadrat auf weißem Grund von Kasimir Malewitsch (Moskau 1915); er gilt als Begründer des Suprematismus …“"
                                            },
                                            {
                                                "example_id": "ca9fa6ef-90ca-462e-ac8e-cdd70f75fe4a",
                                                "sense_id": "4fe40cc2-1568-354c-8544-3abf5cf04c4e",
                                                "text": "„Die gesamte bisherige und heutige Malerei vor dem Suprematismus, die Skulptur, das Wort und die Musik, waren Sklaven der Naturformen; sie warten auf ihre Befreiung, um ihre eigene Sprache sprechen zu können und nicht mehr abhängig zu sein vom Verstand, vom Sinn, von der Logik, Philosophie, Psychologie und von verschiedenen Gesetzen der Ursächlichkeit sowie der technischen Veränderung des Lebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6eeb1f19-554a-44da-ad64-e145d56d8cc8",
                        "source_entry_id": "3fd72648-6bb2-3902-9b8a-237eed4e1cc5",
                        "source_sense_id": "7817de3a-8a05-3d89-8c27-1aada65b64da",
                        "source_sense_description": "genre of abstract art",
                        "target_lang_word": "супремати́зм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "супремати́зм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6ee96833-a03b-3086-a650-a47d2e9e85bb",
                                        "entry_id": "73b6747e-2b68-3e3f-8466-751ecb7417f9",
                                        "glosses": [
                                            "искусств. направление в авангардистском искусстве, основанное в первой половине 1910-х годов К. С. Малевичем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cc781b2-2e60-4142-bf26-192933f934c3",
                                                "sense_id": "6ee96833-a03b-3086-a650-a47d2e9e85bb",
                                                "text": "Митрофанова интересовало всё: биология, география, теория поля, чревовещание, филателия, супрематизм, основы дрессировки…"
                                            },
                                            {
                                                "example_id": "46d39ee2-f7ce-4d73-b94a-a79a6ddc51c7",
                                                "sense_id": "6ee96833-a03b-3086-a650-a47d2e9e85bb",
                                                "text": "Выставка Ольги Розановой «Червовая дама русского авангарда», открывшаяся в Московском центре искусств, ― иллюстрация к гипотезе искусствоведа Фаины Балаховской, решившейся отгадать, кто скрывается за дамами, королями и валетами карточной серии художницы, вместе с Казимиром Малевичем открывшей супрематизм."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
