                        "examples": [
                            {
                                "example_id": "b1b205cc-1155-4e91-b380-8426ecfb6cef",
                                "sense_id": "3845f310-3829-3e30-9d8f-a69c22d99193",
                                "text": "Der Sportlehrer turnte die Übungen am Reck der Klasse vor."
                            },
                            {
                                "example_id": "adc58861-3a64-4783-8fe7-b1eb63195cb1",
                                "sense_id": "3845f310-3829-3e30-9d8f-a69c22d99193",
                                "text": "„Das wäre früher anders gewesen, hatte ihm der stille Sportlehrer einmal gesagt.“"
                            },
                            {
                                "example_id": "d182b2a8-9e0c-41ca-8c47-25024a1fccd9",
                                "sense_id": "3845f310-3829-3e30-9d8f-a69c22d99193",
                                "text": "„Mein Begleiter aus Dar es Salaam verriet, Sportlehrer zu sein und gerade seine dritte Besteigung geschafft zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
