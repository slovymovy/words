                "senses": [
                    {
                        "sense_id": "3b14fe90-aa5f-3ff7-bf86-9cfb8e3d3074",
                        "entry_id": "f0d1cc93-7d7d-3f3c-bc8c-8a88764ad773",
                        "glosses": [
                            "met veel wrijving; beetje vervelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "075a94b6-51b4-4224-a5f4-820b5c4d7a13",
                                "sense_id": "3b14fe90-aa5f-3ff7-bf86-9cfb8e3d3074",
                                "text": "Ook Abbring kreeg er van langs op sociale media. Ze zou zich onvoldoende hebben verdiept in haar gast en onvoldoende kennis hebben gehad over voetbal, zo werd gesteld. Ze zou 'geen match' met Van Gaal zijn geweest. Volgens sommige kijkers werd Abbring tijdens het 'schurende' gesprek op 'van Gaalse wijze' gecorrigeerd."
                            },
                            {
                                "example_id": "e258ed9b-dbb5-489c-80ee-df8d554cf67a",
                                "sense_id": "3b14fe90-aa5f-3ff7-bf86-9cfb8e3d3074",
                                "text": "Een regelrechte beauty is het nog altijd niet door het licht op de oogbollen schurende cab forward design, maar de jaren van naar pure doelmatigheid riekende ontwerpen liggen gelukkig achter ons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67a3956f-c5c7-48fe-9346-9febb52094ef",
                        "source_entry_id": "f0d1cc93-7d7d-3f3c-bc8c-8a88764ad773",
                        "source_sense_id": "3b14fe90-aa5f-3ff7-bf86-9cfb8e3d3074",
                        "source_sense_description": "met veel wrijving; beetje vervelend",
                        "target_lang_word": "abrasive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abrasive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41ad8581-ad7f-366d-8af5-b21aaa7ffce7",
                                        "entry_id": "1a51e359-5686-35e3-beb4-157bc92eb612",
                                        "glosses": [
                                            "Producing abrasion; rough enough to wear away the outer surface."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0170eb7-ca67-3e3d-9429-006dae8fa7b7",
                                        "entry_id": "1a51e359-5686-35e3-beb4-157bc92eb612",
                                        "glosses": [
                                            "Being rough and coarse in manner or disposition; overly aggressive and causing irritation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "331db488-33d0-44b4-b4a5-6193d78ec6db",
                                                "sense_id": "e0170eb7-ca67-3e3d-9429-006dae8fa7b7",
                                                "text": "An abrasive person can grate on one's sensibilities."
                                            },
                                            {
                                                "example_id": "9efc990e-28a3-46c2-b60a-de139325cbd2",
                                                "sense_id": "e0170eb7-ca67-3e3d-9429-006dae8fa7b7",
                                                "text": "Despite her proper upbringing, we found her manners to be terribly abrasive."
                                            },
                                            {
                                                "example_id": "f032c389-267a-4300-bb13-ecdb6761afd6",
                                                "sense_id": "e0170eb7-ca67-3e3d-9429-006dae8fa7b7",
                                                "text": "The women of the movement, it struck me, were more humorless and more single-minded in their total dedication to the ideology than were the men. In fact, Chiang Ching was unpleasantly abrasive and aggressive. At one point that evening she turned to me and in a challenging voice asked, \"Why did you not come to China before now?\" Since the ballet was in progress at the time, I did not respond."
                                            }
                                        ]
                                    }
                                ]
                            },
