                "senses": [
                    {
                        "sense_id": "b5170109-631d-3a89-a7c6-e8d67edeea29",
                        "entry_id": "f67ab1d6-7fc0-3ec3-a834-5eee492cb39f",
                        "glosses": [
                            "het op een foute manier gebruiken van de taal door het maken van taalfouten, het niet goed gebruiken van woorden, het gebruiken van woorden die niet tot de gebezigde taal behoren e.d."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9742f6e0-2008-4d99-8c6a-582fea41edae",
                                "sense_id": "b5170109-631d-3a89-a7c6-e8d67edeea29",
                                "text": "TAALBEDERF: Wat hebben we toch gelachen om die Belgen! Hoe lang is het al weer geleden dat zij dachten het Vlaams te kunnen verbeteren door het van alle Franse smetten te zuiveren."
                            },
                            {
                                "example_id": "b2d4a187-6edd-428b-978f-2d9eb96eb684",
                                "sense_id": "b5170109-631d-3a89-a7c6-e8d67edeea29",
                                "text": "In veel notities en strategische beleidsstukken – ook die van onszelf! – kun je in toenemende mate taalbederf constateren. Op het eerste gezicht lijkt het op een onschuldige kwaal, maar als je niet oplet wordt het een pestilentie die sluipenderwijs ons dierbare Nederlands naar de Filistijnen helpt."
                            }
                        ]
                    }
