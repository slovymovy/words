                    },
                    {
                        "sense_id": "77e08dd3-1f2f-3949-9ace-1bec4a1de3d0",
                        "entry_id": "3a22edbc-8558-3e98-a2da-82af4710f511",
                        "glosses": [
                            "The production of stigmata upon the body."
                        ],
                        "tags": [
