                                "target_senses": [
                                    {
                                        "sense_id": "f2a0a871-1511-3856-94a9-aa2151b5cd38",
                                        "entry_id": "85e58e12-eba0-3248-ac65-ef6fd3a2b103",
                                        "glosses": [
                                            "In a joyful manner; joyously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a86700d2-d9ea-4b65-b251-8cb9780dc6ab",
                                                "sense_id": "f2a0a871-1511-3856-94a9-aa2151b5cd38",
                                                "text": "I ended my aimless-roaming-short-term-odd-jobs lifestyle and joyfully went to work at a local restaurant in Langley Park, Maryland, as a carhop."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3fd31c1-c239-4db8-a50b-fa069ed1cb4c",
                        "source_entry_id": "7a600934-0ada-3541-9503-7b3c325c2d87",
                        "source_sense_id": "de5d529e-becc-3fc2-b2f8-4bad52ef8676",
                        "target_lang_word": "fröhlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
