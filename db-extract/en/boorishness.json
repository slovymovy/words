    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "69a609b3-127e-3283-8ac2-aabc8a44da66",
                "word": "boorishness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c8babfaf-b8d9-4128-a65c-6eb0d2d434b2",
                        "entry_id": "69a609b3-127e-3283-8ac2-aabc8a44da66",
