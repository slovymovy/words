                                    {
                                        "sense_id": "84ed1193-7e9e-3b22-a649-a2b3f3b886c0",
                                        "entry_id": "5913bdd8-e688-39d8-bd69-7f8921bd3b47",
                                        "glosses": [
                                            "A flowing wide-sleeved robe worn by men in much of West Africa, and to a lesser extent in North Africa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90d26cf3-839e-4ae7-b397-1f6acae84f2c",
                                                "sense_id": "84ed1193-7e9e-3b22-a649-a2b3f3b886c0",
                                                "text": "In Bamako’s thriving market, a group of moneychangers in brightly colored boubous, the traditional robes worn here, said that Moussa Magassa, who owns the house in the Bronx where his family and the Soumares lived and who lost five children in the blaze, stopped by once or twice a year on his trips home to Mali and was well known in the community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "864289c1-e17e-3e77-b498-e4e2d488750f",
                                        "entry_id": "5913bdd8-e688-39d8-bd69-7f8921bd3b47",
                                        "glosses": [
                                            "Any of certain species of birds in the bushshrike genus Laniarius."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
