                ],
                "senses": [
                    {
                        "sense_id": "a071ab58-dae3-38eb-be8c-b08aac23e32e",
                        "entry_id": "ee343f05-5db8-378d-a04c-d715a3df40b3",
                        "glosses": [
                            "техн. дополнительная опора, увеличивающая устойчивость передвижного устройства против опрокидывания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a10f1c34-fc77-470e-ba45-b83ab9bc9b43",
                                "sense_id": "a071ab58-dae3-38eb-be8c-b08aac23e32e",
                                "text": "При погрузке и укладке плит плитоукладчик или автокран должен быть заторможен, а автокран должен быть установлен на аутригеры и заторможен ручным тормозом."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d0ad962-2779-3018-b0c0-9be5eba25458",
                        "entry_id": "ee343f05-5db8-378d-a04c-d715a3df40b3",
                        "glosses": [
                            "морск. гребное судно с выносными уключинами для вёсел"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8a1483b-a562-487c-a77c-82de4db4d122",
                                "sense_id": "7d0ad962-2779-3018-b0c0-9be5eba25458",
                                "text": "Проскользнув между купальщиками, гичка пошла по Невке, пролетела под мостом, несколько секунд висела на руле у четырехвесельного аутригера из клуба «Стрела», обогнала его…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06d968ef-168c-43b7-8dfa-80a91a953130",
                        "source_entry_id": "ee343f05-5db8-378d-a04c-d715a3df40b3",
                        "source_sense_description": "дополнительная опора",
                        "target_lang_word": "outrigger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outrigger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bf3f300-2489-335f-aa50-b9a24b9438a6",
                                        "entry_id": "33f58c3b-f8bd-3c2d-8c6c-e77c144ca00c",
                                        "glosses": [
                                            "Any of various projecting beams or spars that provide support for a sailing ship's mast."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07ede1e8-2664-3f38-b134-4a780ac6e2e4",
                                        "entry_id": "33f58c3b-f8bd-3c2d-8c6c-e77c144ca00c",
                                        "glosses": [
                                            "A long thin timber, pontoon, or other float attached parallel to a canoe or boat by projecting struts as a means of preventing tipping or capsizing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e6824d5-3f26-492e-85aa-4262707ca2fd",
                                                "sense_id": "07ede1e8-2664-3f38-b134-4a780ac6e2e4",
                                                "text": "The Sentinelese hunt in the rainforest and fish in the coastal waters using spears, bows and arrows, as well as homemade narrow outrigger canoes, according to Survival International."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e28495f-d6b5-3a44-b1a5-0eb97d69e564",
                                        "entry_id": "33f58c3b-f8bd-3c2d-8c6c-e77c144ca00c",
                                        "glosses": [
                                            "An outrigger canoe or boat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01868ca5-d804-3589-aa44-79cc90cf2e0a",
                                        "entry_id": "33f58c3b-f8bd-3c2d-8c6c-e77c144ca00c",
                                        "glosses": [
                                            "An iron bracket or brace for an oarlock projecting from the side of a rowing boat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "500b78b9-7b57-3b9d-98c8-f4df062534b7",
                                        "entry_id": "33f58c3b-f8bd-3c2d-8c6c-e77c144ca00c",
                                        "glosses": [
                                            "An extension mechanism, often retractable when not in use, on a boat, vehicle, or structure which helps to stabilize it to keep it from tipping over."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a4cdd21-cb5e-41f1-8d3e-c6d021a6f25f",
                                                "sense_id": "500b78b9-7b57-3b9d-98c8-f4df062534b7",
                                                "text": "From the cowcatcher hung the outrigger of the tricycle, leaping about as though in the grip of death itself, beating against the iron that had shattered it, striking the road, sending the gravel flying."
                                            },
                                            {
                                                "example_id": "636ff613-58f5-438a-9b01-5864d9902e66",
                                                "sense_id": "500b78b9-7b57-3b9d-98c8-f4df062534b7",
                                                "text": "These piles supported long lengths of hard timber (approximately 2-ft. square section) which provided a firm anchorage for the outriggers supporting the cranes."
                                            },
                                            {
                                                "example_id": "c14c9e33-9a3b-4496-894b-87e07df50fdb",
                                                "sense_id": "500b78b9-7b57-3b9d-98c8-f4df062534b7",
                                                "text": "The cranes are supplied with outriggers and jacks for use when lifting heavy loads or when working at extended radii."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4bdfdbb-df28-32a5-9dfe-0d71dc962d36",
                                        "entry_id": "33f58c3b-f8bd-3c2d-8c6c-e77c144ca00c",
                                        "glosses": [
                                            "A type of ski pole, with skis attached at the bottom, instead of the spike/pick found on a normal pole. It is used in downhill skiing variants of para-skiing, especially those that use a sit-ski, such as the monoski."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "616313a7-1285-4ba1-aa1d-5808a22e1789",
