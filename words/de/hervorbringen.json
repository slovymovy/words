                {
                    "sense_id": "a964719f-6938-3cc2-881d-526873d3e614",
                    "sense_definition": "etwas durch kreative, geistige oder natürliche Arbeit neu erschaffen oder erzeugen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "erzeugen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Diese Region <w>bringt</w> jedes Jahr hervorragende Weine <w>hervor</w>."
                        },
                        {
                            "text": "Die Zusammenarbeit beider Künstler hat bedeutende Kunstwerke <w>hervorgebracht</w>."
                        }
                    ],
                    "synonyms": [
                        "erschaffen",
                        "erzeugen",
                        "herstellen",
                        "produzieren",
                        "schaffen"
                    ],
                    "common_phrases": [
