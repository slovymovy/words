                        "sense_id": "f70e7058-fb0b-30a2-99f1-309eadd35fec",
                        "entry_id": "3d7277a8-fd2e-376e-b959-7038b38fe4bc",
                        "glosses": [
                            "een samenhangend geheel van wegen in een bepaald gebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fc66b7f-431c-4f10-9e97-04f5f0e0c45f",
                                "sense_id": "f70e7058-fb0b-30a2-99f1-309eadd35fec",
                                "text": "Bij regen rijden automobilisten voorzichtiger, met meer onderlinge afstand en lagere snelheden, waardoor de capaciteit van het wegennet kleiner wordt."
                            },
                            {
                                "example_id": "6689e9f4-6489-4d42-bfdf-9d5e7f7753b8",
                                "sense_id": "f70e7058-fb0b-30a2-99f1-309eadd35fec",
                                "text": "De ontwikkeling van een goed wegennet houdt doorgaans gelijke tred met een groeiende bevolking, ontdekte de befaamde Amerikaanse econoom Julian Simon al in de jaren zeventig."
                            }
                        ]
                    }
