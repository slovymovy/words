                    {
                        "translation_id": "11a24d04-8ceb-4f8f-97bb-cf035432d01e",
                        "source_entry_id": "e8bf861c-08c7-3195-8f38-59082ce96b49",
                        "source_sense_id": "c4b7bf29-064d-3666-8e06-8d25d75f39a6",
                        "source_sense_description": "spier- en peesachtig tussenschot tussen borstholte en buikholte",
                        "target_lang_word": "Zwerchfell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwerchfell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c24e6273-14bd-31f9-9e17-0ee03ef8b1bd",
                                        "entry_id": "7c13f1da-36f6-3c94-a697-5ec505746b5f",
                                        "glosses": [
                                            "Muskel, der die Bauch- von der Brusthöhle trennt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4195819d-961f-4f02-8b19-6d2092969754",
                                                "sense_id": "c24e6273-14bd-31f9-9e17-0ee03ef8b1bd",
                                                "text": "„Die zentrale Steuerung des Zwerchfells erfolgt über das Atemzentrum im verlängerten Mark und in der Brücke.“"
                                            },
                                            {
                                                "example_id": "a2578b75-cb8c-4f48-83c1-97fab5416766",
                                                "sense_id": "c24e6273-14bd-31f9-9e17-0ee03ef8b1bd",
                                                "text": "„Die Regulation des Atemstroms wird im Wesentlichen durch die Flexibilität und Spannung des Zwerchfells bestimmt, das aus einer Art Muskelgeflecht besteht.“"
                                            },
                                            {
                                                "example_id": "874a53c6-e833-4f42-a2b7-3836e358de7d",
                                                "sense_id": "c24e6273-14bd-31f9-9e17-0ee03ef8b1bd",
                                                "text": "„Manchmal muß ich so lange spucken, bis mich das Zwerchfell schmerzt.“"
                                            },
                                            {
                                                "example_id": "268f4a8c-0663-4b84-8904-d692e4dee5c7",
                                                "sense_id": "c24e6273-14bd-31f9-9e17-0ee03ef8b1bd",
                                                "text": "„Dann hoben sie den Brustkorb ab und sahen die beiden Lungen, zwei Schwämmen gleich, das Herz, das wie ein großes Ei aussah, in wenig nach links hinten gerückt, das Zwerchfell, die Nieren, die ganze Masse der Eingeweide.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "19ee32a6-6efa-4c0d-b5aa-7a9289e39fb7",
                        "source_entry_id": "e8bf861c-08c7-3195-8f38-59082ce96b49",
                        "source_sense_id": "c4b7bf29-064d-3666-8e06-8d25d75f39a6",
