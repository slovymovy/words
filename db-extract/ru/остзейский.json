                        ],
                        "examples": [
                            {
                                "example_id": "0f241e85-7db9-4b86-948b-906294c90bb0",
                                "sense_id": "afe7c5a6-08ce-3516-acfe-38e5e747f6fd",
                                "text": "остзе́йское дворя́нство",
                                "translation": "Baltic German nobility",
                                "english": "Baltic German nobility"
                            },
                            {
                                "example_id": "251a1604-c9de-476d-b940-fb1605af407c",
                                "sense_id": "afe7c5a6-08ce-3516-acfe-38e5e747f6fd",
                                "text": "Вы́шли четы́ре остзе́йские не́мки. Все то́лстые, полногру́дые блонди́нки, напу́дренные, о́чень ва́жные и почти́тельные.",
                                "translation": "Four German women from the Baltic provinces came out. All of them stout, full-breasted, blonde, powdered, very important and respectful.",
                                "english": "Four German women from the Baltic provinces came out. All of them stout, full-breasted, blonde, powdered, very important and respectful."
                            }
                        ]
                    }
