                "senses": [
                    {
                        "sense_id": "766c9247-04c6-3b1f-891e-74a398a2801f",
                        "entry_id": "d1eaf1f2-010b-3256-bb23-9e8a95fe9dd0",
                        "glosses": [
                            "technische Einrichtung zur Gewinnung von Brauch- oder Trinkwasser durch Entsalzung von Meer-, Brackwasser oder Sole"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "710cf028-611a-4944-b1b1-f4cac38e3f7f",
                                "sense_id": "766c9247-04c6-3b1f-891e-74a398a2801f",
                                "text": "Ein Beispiel für eine große Entsalzungsanlagen kann man am Roten Meer finden."
                            },
                            {
                                "example_id": "151c9e84-7682-4404-9923-25feffc49116",
                                "sense_id": "766c9247-04c6-3b1f-891e-74a398a2801f",
                                "text": "Es gibt verschiedene technische Lösungen um eine Entsalzungsanlage zur Trinkwassergewinnung zu realisieren."
                            },
                            {
                                "example_id": "8b70f5a4-0db1-4dc8-881e-cdfda999246c",
                                "sense_id": "766c9247-04c6-3b1f-891e-74a398a2801f",
                                "text": "„Allein für die Entsalzungsanlage werden pro Tag durchschnittlich etwa 1000 Liter Diesel verbrannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
