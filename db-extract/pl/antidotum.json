                                    {
                                        "sense_id": "f0421758-84c0-39d8-bb2a-2e81315d1e9b",
                                        "entry_id": "50084bdb-81a2-3d9e-9603-b0b0a8811997",
                                        "glosses": [
                                            "Mittel gegen die Wirkungen einer Vergiftung; Gegengift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c4fd033-14e6-48f9-855a-32ad5af8acaf",
                                                "sense_id": "f0421758-84c0-39d8-bb2a-2e81315d1e9b",
                                                "text": "Die Wirkung des Antidotes ist zu bezweifeln."
                                            },
                                            {
                                                "example_id": "4e649720-e964-4c75-853f-82c85de31d79",
                                                "sense_id": "f0421758-84c0-39d8-bb2a-2e81315d1e9b",
                                                "text": "„Mir war klar, daß es Schwerarbeit sein würde, einen Lastwagen zehn- bis zwölftausend Meilen weit zu fahren, allein und unversorgt, über alle Arten von Straßen, aber für mich stellte es das Antidot gegen das Gift des berufsmäßig kranken Mannes dar.“"
                                            },
                                            {
                                                "example_id": "ce6a0c06-d27a-4052-946f-df1df52a1510",
                                                "sense_id": "f0421758-84c0-39d8-bb2a-2e81315d1e9b",
                                                "text": "„Er verlobt sich, wie er sagt, als Antidot gegen seine Leidenschaft; er bemüht sich, sie zureichend liebenswert zu finden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "788a6c9b-734d-4019-bc34-300d0296e532",
                        "source_entry_id": "96b57707-d857-3838-bfd8-e3998f8eb3bd",
