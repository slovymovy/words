{
    "word_family": [
        "fortunate",
        "fortunately",
        "unfortunate",
        "unfortunately"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ddb7ae0a-94f1-3e56-90b6-ffe0f02dcdfe",
                    "sense_definition": "A state of bad luck or an unfortunate condition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bad_luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The worst tour I have ever had the <w>misfortune</w> to experience.",
                            "target_lang_translations": {
                                "ru": "Худший тур, который мне «посчастливилось» <w>испытать</w>."
                            }
                        },
                        {
                            "text": "It was my <w>misfortune</w> to be called to the office without any previous training.",
                            "target_lang_translations": {
                                "ru": "Мне «повезло» <w>оказаться</w> вызванным в офис без какой-либо предварительной подготовки."
                            }
                        }
                    ],
                    "synonyms": [
                        "bad luck",
                        "ill luck",
                        "adversity"
                    ],
                    "antonyms": [
                        "good luck",
                        "fortune"
                    ],
                    "common_phrases": [
                        "have the misfortune"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние невезения или неблагоприятные обстоятельства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуда́ча",
                                "target_lang_sense_clarification": "отсутствие успеха или нежелательный исход событий"
                            },
                            {
                                "target_lang_word": "несча́стье",
                                "target_lang_sense_clarification": "неблагоприятное стечение обстоятельств или горестное событие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e854fb94-413c-3015-86f2-02cbb4f0e73b",
                    "sense_definition": "An undesirable event or accident that causes suffering.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bad_luck",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to come to terms with a number of <w>misfortunes</w>.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось смириться с рядом <w>несчастий</w>."
                            }
                        },
                        {
                            "text": "The snowstorm was the cause of their <w>misfortune</w> during the winter.",
                            "target_lang_translations": {
                                "ru": "Снежная буря стала причиной их <w>беды</w> зимой."
                            }
                        }
                    ],
                    "synonyms": [
                        "mishap",
                        "mischance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нежелательное событие или происшествие, которое приносит страдания или ущерб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несча́стье",
                                "target_lang_sense_clarification": "горестное событие, беда"
                            },
                            {
                                "target_lang_word": "беда́",
                                "target_lang_sense_clarification": "крайне тяжёлое или неприятное событие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}