                "senses": [
                    {
                        "sense_id": "615d7aa9-d9a8-36c7-b017-b811361f9170",
                        "entry_id": "3156cab9-f47b-33fd-894f-d06cbb91d4b9",
                        "glosses": [
                            "metalen constructie die een verbinding vormt tussen het chassis van een auto en een wiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6e40247-f911-4e21-8ddf-f51c54b57a09",
                                "sense_id": "615d7aa9-d9a8-36c7-b017-b811361f9170",
                                "text": "Koolstofvezel wordt alleen gebruikt in onder andere de middentunnel, de hoedenplank, de dorpels, de A- B- en C-stijlen en de dakbogen inclusief de dwarsverbindingen. Allemaal plekken hoog in de auto om zo het zwaartepunt van de auto drastisch te verlagen. In de deuren maakt BMW gebruik van aluminium, maar ook het dak, remschijven/remklauwen, de draagarmen, het fuseehuis en de wielen zijn van het lichtmetaal gemaakt. De Telegraaf BART OOSTVOGELS"
                            },
                            {
                                "example_id": "62ab13cf-63f7-47db-848a-7667be2e4dda",
                                "sense_id": "615d7aa9-d9a8-36c7-b017-b811361f9170",
                                "text": "De vooras is van het oude, vertrouwde McPherson-principe waarbij de veerpoot op een boemerangvormige onderste draagarm staat. Deze ophanging is, op een aantal details na, identiek aan die van de Safrane."
                            },
                            {
                                "example_id": "dd49fbf7-7f38-44d7-8615-40bc7eb82323",
                                "sense_id": "615d7aa9-d9a8-36c7-b017-b811361f9170",
                                "text": "Rondom onafhankelijke wielophanging met dubbele draagarmen zorgt voor uitgebalanceerde en comfortabele rijeigenschappen. Voor extra rijplezier is het af-fabriek sportonderstel een aanrader."
                            }
                        ]
                    },
                    {
                        "sense_id": "859319df-0584-3ed2-9280-4fbeed2f54cf",
                        "entry_id": "3156cab9-f47b-33fd-894f-d06cbb91d4b9",
                        "glosses": [
                            "uitstekende delen waaraan een voorwerp kan worden opgehangen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54048bdd-790b-4827-8f94-58f2ad3d3c85",
                                "sense_id": "859319df-0584-3ed2-9280-4fbeed2f54cf",
                                "text": "Van mijn Leifheit rollenhouder (ruim 3 jaar oud) was het mesje voor het plastic folie kapot en van de keukenrolhouder waren beide draagarmen gescheurd. Reserveonderdelen waren alleen verkrijgbaar bij Leifheit zelf. Via internet bestelden we beide artikelen, maar aan het einde van de bestelling zagen we geen rekening."
                            }
                        ]
                    }
