                ],
                "senses": [
                    {
                        "sense_id": "6769058a-6739-3980-860b-b70be9fb6a5a",
                        "entry_id": "403e6efd-b473-3b7e-b9e6-876b16c951ad",
                        "glosses": [
                            "speziell beschichtete Weißwandtafel, auf der man mit speziellen Whiteboard-Markern (Board-Markern) schreiben kann; das Geschriebene lässt sich leicht mit einem trockenen Schwamm abwischen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee09649-7576-4a0d-b674-b3f631be0e8f",
                                "sense_id": "6769058a-6739-3980-860b-b70be9fb6a5a",
                                "text": "Das Whiteboard ist eine Weiterentwicklung der klassischen, mit Kreide zu beschreibenden Schultafel."
                            },
                            {
                                "example_id": "1aa3818d-cfb1-4414-b753-44f3a00b303c",
                                "sense_id": "6769058a-6739-3980-860b-b70be9fb6a5a",
                                "text": "Permanent-Marker sollte man nicht auf einem Whiteboard verwenden."
                            },
                            {
                                "example_id": "2106deb1-9716-4673-b052-31a8c93d9005",
                                "sense_id": "6769058a-6739-3980-860b-b70be9fb6a5a",
                                "text": "„Er schrieb den Namen des Opfers mit Rotstift auf ein glänzendes Whiteboard.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f289886e-bf30-3d64-b962-8d0ff050fcfe",
                        "entry_id": "403e6efd-b473-3b7e-b9e6-876b16c951ad",
                        "glosses": [
                            "elektronische Tafel mit großer Projektionsfläche, die mit einem Computer und Beamer verwendet wird und multimediale Darstellungen ermöglicht, die mithilfe eines Stiftes oder Fingers gesteuert und bearbeitet werden können"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "7ae2b72b-d93e-4b4d-b8c2-c31f05c3cd60",
                                "sense_id": "f289886e-bf30-3d64-b962-8d0ff050fcfe",
                                "text": "Immer mehr Schulen werden mit Whiteboards ausgestattet."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b41a9978-6a73-4e45-b626-28f569289bbb",
                        "source_entry_id": "403e6efd-b473-3b7e-b9e6-876b16c951ad",
                        "source_sense_id": "6769058a-6739-3980-860b-b70be9fb6a5a",
                        "source_sense_description": "speziell beschichtete Weißwandtafel",
                        "target_lang_word": "whiteboard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whiteboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f5c5b93-d165-3b3f-92a3-59a0d71f1ff3",
                                        "entry_id": "b49f5e01-a033-3625-80d8-6d4d88352f8b",
                                        "glosses": [
                                            "A writing board finished with a hard white material, which can be written upon using special non-permanent markers and subsequently wiped clean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9162b77-1ee7-4306-b6eb-32e83697187d",
                                                "sense_id": "7f5c5b93-d165-3b3f-92a3-59a0d71f1ff3",
                                                "text": "1995, Gary Wolf, \"The Curse of Xanadu\", Wired Magazine\nMark Miller gave himself up to Xanadu's pull and rejoined the project full time. The new Xanadu site on Palo Alto's California Avenue was remodeled to resemble the environment at Xerox PARC. The programmers' offices opened onto a large common space, and the walls were covered with white board, which quickly became a tangle of multicolored lines, words, circles, and squiggles."
                                            },
                                            {
                                                "example_id": "04518a47-b8a1-4c96-8133-dc2717db6170",
                                                "sense_id": "7f5c5b93-d165-3b3f-92a3-59a0d71f1ff3",
                                                "text": "Discussion turns to the station whiteboard, which even has its own Twitter page. It's been in place for a number of years and is located right in the middle of the concourse. It's used to provide service information, upcoming alterations and event advice. There is also a 'Chuckle of the Day'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea7ec0ee-99a1-3975-b32e-0bd699c4854e",
                                        "entry_id": "b49f5e01-a033-3625-80d8-6d4d88352f8b",
                                        "glosses": [
                                            "A collaborative tool allowing several users to write and draw on the same shared display."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "whiteboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df825224-f336-3fbc-8eb2-e800c39143fd",
                                        "entry_id": "0328c210-7b3f-338b-b4df-1db059195427",
                                        "glosses": [
                                            "To use a whiteboard, to write on a writeboard"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69f223d5-3fe1-46ac-a8d8-1f01b1a5d23f",
                        "source_entry_id": "403e6efd-b473-3b7e-b9e6-876b16c951ad",
