                    {
                        "sense_id": "d7ad9cd8-5ff4-3661-bcbd-0d737b6b290e",
                        "entry_id": "76dcca3c-9eb3-3a91-bb38-8b40d2af1f3d",
                        "glosses": [
                            "ausgelassene, meist im großen Stil und im Freien stattfindende Tanzveranstaltung mit elektronischer Musik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db87ac14-06a7-4900-9ada-7103ee84a46e",
                                "sense_id": "d7ad9cd8-5ff4-3661-bcbd-0d737b6b290e",
                                "text": "„An den Wochenenden feierten Jugendliche Raves auf den Straßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33507d2b-5dc7-4169-9134-34eec2dd1eeb",
                        "source_entry_id": "76dcca3c-9eb3-3a91-bb38-8b40d2af1f3d",
                        "source_sense_id": "d7ad9cd8-5ff4-3661-bcbd-0d737b6b290e",
                        "source_sense_description": "Tanzveranstaltung mit elektronischer Musik",
                        "target_lang_word": "rave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad09790a-b44f-3223-8684-c3a21139e0aa",
                                        "entry_id": "0d0d7b51-f11a-3268-b4f5-6686829f08cb",
                                        "glosses": [
                                            "One of the upper side pieces of the frame of a wagon body or a sleigh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f981f79-032b-46b3-a1b1-bb03ec54ea74",
                                                "sense_id": "ad09790a-b44f-3223-8684-c3a21139e0aa",
                                                "text": "It was astonishing to see how he had gnawed the rave of the sled."
                                            },
                                            {
                                                "example_id": "8a769fa0-caa5-482f-8500-9384a0b2f4cc",
                                                "sense_id": "ad09790a-b44f-3223-8684-c3a21139e0aa",
                                                "text": "The main lever rests upon the rave when not in use."
                                            },
                                            {
                                                "example_id": "1ce7698b-82ff-4fbf-99ff-5dc0e14da179",
                                                "sense_id": "ad09790a-b44f-3223-8684-c3a21139e0aa",
                                                "text": "Next I weld a collar on, A, to keep the brake in place when on the sled; then make a two-eyed bolt to fasten the brake to the rave."
                                            },
                                            {
                                                "example_id": "db7c538f-4eea-492b-9cc9-3e9a23938b09",
                                                "sense_id": "ad09790a-b44f-3223-8684-c3a21139e0aa",
                                                "text": "The superstructure of the tender is modified by the removal of the side raves, and compartments for the fire-irons are formed on each side of the coal bunker."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff88527d-236c-3032-a5f0-6f5580c67a94",
                                        "entry_id": "ef019d44-33b8-3d00-81d1-75e9769c9a7b",
                                        "glosses": [
                                            "simple past of rive"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "obsolete",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43d07840-bf14-368f-84cd-26fba36fbd19",
                                        "entry_id": "155cd8e7-a983-33e9-b72e-60be813e335c",
                                        "glosses": [
                                            "An enthusiastic review (such as of a play)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a1ccea5-1815-4609-8f27-385ea9146ce4",
                                                "sense_id": "43d07840-bf14-368f-84cd-26fba36fbd19",
                                                "text": "The first-night audience, yes. The first-night reviewers, not exactly. The notices have so far been mixed, only The Financial Times having delivered itself of an unequivocal rave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3200853a-6687-3eb7-9640-cd5a66caa8fa",
                                        "entry_id": "155cd8e7-a983-33e9-b72e-60be813e335c",
                                        "glosses": [
                                            "An all-night dance party with electronic dance music (techno, trance, drum and bass etc.) in small unknown clubs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8171e052-e794-380f-a367-605893c2fae8",
                                        "entry_id": "155cd8e7-a983-33e9-b72e-60be813e335c",
                                        "glosses": [
                                            "The genres of electronic dance music made to be played in rave parties."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77ccbc62-2f47-4222-b047-c06c06df4136",
                                                "sense_id": "8171e052-e794-380f-a367-605893c2fae8",
                                                "text": "Maybe I wear baggies / And white socks with flip-flops / Maybe I don't like listening to rave / And I'm not on the social mountaintops"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e11e8730-8023-35e4-aba7-d09f86fba851",
                                        "entry_id": "48a9be04-7d99-3301-8472-00c4539c19fc",
                                        "glosses": [
                                            "To be mentally unclear; to be delirious; to talk or act irrationally; to be wild, furious, or raging."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "758a3e47-2778-49ba-bc44-4068931b0f30",
                                                "sense_id": "e11e8730-8023-35e4-aba7-d09f86fba851",
                                                "text": "Have I not cause to rave and beat my breast?"
                                            },
                                            {
                                                "example_id": "7ec3016e-724f-422c-a905-0d3793b79d7f",
                                                "sense_id": "e11e8730-8023-35e4-aba7-d09f86fba851",
                                                "text": "The mingled torrent of redcoats and tartans went raving down the valley to the gorge of Killiecrankie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a79f356-0c73-3452-9264-79133f788046",
                                        "entry_id": "48a9be04-7d99-3301-8472-00c4539c19fc",
                                        "glosses": [
                                            "To speak or write wildly or incoherently."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13e44bf2-cad3-4d1b-91fc-9ae985bd6dd5",
                                                "sense_id": "1a79f356-0c73-3452-9264-79133f788046",
                                                "text": "\"She is in trance. Your daughter, sir, is a powerful medium.\" \"A medium! You are raving.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75389a5e-6646-3ac0-a44d-e1b0bb200d59",
                                        "entry_id": "48a9be04-7d99-3301-8472-00c4539c19fc",
                                        "glosses": [
                                            "To talk with excessive enthusiasm, passion or excitement."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea220f4a-972b-4503-96a2-7138babaf60d",
                                                "sense_id": "75389a5e-6646-3ac0-a44d-e1b0bb200d59",
                                                "text": "He raved about her beauty."
                                            },
                                            {
                                                "example_id": "80767bc1-1c24-4105-93c1-bbac0daea0af",
                                                "sense_id": "75389a5e-6646-3ac0-a44d-e1b0bb200d59",
                                                "text": "The hallowed scene / Which others rave on, though they know it not."
                                            },
                                            {
                                                "example_id": "b9df6727-62b8-4fbe-9fa5-6677513f6bfc",
                                                "sense_id": "75389a5e-6646-3ac0-a44d-e1b0bb200d59",
                                                "text": "“A beautiful country!”\n“I suppose it is. Everybody says so.”\n“Your cousin Feenix raves about it, Edith,” interposed her mother from her couch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0aec978-588f-39ae-881b-87320264f940",
                                        "entry_id": "48a9be04-7d99-3301-8472-00c4539c19fc",
                                        "glosses": [
                                            "To rush wildly or furiously."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55d64c0a-9c04-4e15-ad89-d022b0b5538e",
                                                "sense_id": "e0aec978-588f-39ae-881b-87320264f940",
                                                "text": "Under a mightie rocke, gainst which do rave\nThe roaring billowes in their proud disdaine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20e21779-40c5-3908-b518-19f95a878676",
                                        "entry_id": "48a9be04-7d99-3301-8472-00c4539c19fc",
                                        "glosses": [
                                            "To attend a rave (dance party)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc9f06e4-0532-42d5-8031-32f7f4b49fc1",
                                                "sense_id": "20e21779-40c5-3908-b518-19f95a878676",
                                                "text": "The situation with Tommy's parents made me grateful my parents hadn't caught on to my partying that summer. How had I gotten away with raving every weekend, and sometimes on Thursday nights too?"
                                            }
                                        ]
                                    }
                                ]
                            },
