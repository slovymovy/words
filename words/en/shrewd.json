                            {
                                "target_lang_word": "obrotny",
                                "target_lang_sense_clarification": "radzący sobie w życiu"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "pişkin",
                                "target_lang_sense_clarification": "hayat tecrübesi olan"
                            },
                            {
                                "target_lang_word": "cin fikirli",
                                "target_lang_sense_clarification": "pratik zekalı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec2c7299-5102-33d6-8c1d-fe37eb82a52f",
                    "sense_definition": "Artful, tricky, or cunning in a deceptive way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deviousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician used <w>shrewd</w> tactics to undermine his opponent's credibility.",
                            "target_lang_translations": {
                                "pl": "Polityk użył <w>chytrych</w> taktyk, aby podważyć wiarygodność swojego przeciwnika.",
                                "tr": "Politikacı, rakibinin güvenilirliğini sarsmak için <w>sinsi</w> taktikler kullandı."
                            }
                        },
                        {
                            "text": "He is known for his <w>shrewd</w> and manipulative schemes.",
                            "target_lang_translations": {
                                "pl": "Znany jest ze swoich <w>przebiegłych</w> i manipulacyjnych intryg.",
                                "tr": "O, <w>hilekar</w> ve manipülatif planlarıyla tanınır."
                            }
