            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f32dbfb2-0851-3094-b2be-0fd7e8066767",
                    "sense_definition": "in staat om volledig in de eigen behoeften te voorzien zonder hulp van buitenaf",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "onafhankelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De eigenaren leiden de lokale bevolking op om <w>zelfvoorzienend</w> te zijn en een sterke economie op te bouwen.",
                            "target_lang_translations": {
                                "en": "The owners are training the local population to be <w>self-sufficient</w> and to build a strong economy."
                            }
                        },
                        {
                            "text": "Zij droomt van een <w>zelfvoorzienend</w> leven op een boerderij met eigen groenten en zonnepanelen.",
                            "target_lang_translations": {
                                "en": "She dreams of a <w>self-sufficient</w> life on a farm with her own vegetables and solar panels."
                            }
                        }
                    ],
                    "synonyms": [
                        "selfsupporting",
                        "zelfverzorgend"
                    ],
                    "antonyms": [
                        "afhankelijk"
                    ],
                    "common_phrases": [
                        "volledig zelfvoorzienend",
                        "zelfvoorzienend leven"
                    ],
                    "target_lang_definitions": {
                        "en": "able to provide for one's own needs without external help"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "self-sufficient",
                                "target_lang_sense_clarification": "general use for individuals or systems"
                            },
                            {
                                "target_lang_word": "self-supporting",
                                "target_lang_sense_clarification": "financially or physically independent"
                            },
                            {
                                "target_lang_word": "self-reliant",
                                "target_lang_sense_clarification": "relying on one's own powers and resources"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52a31784-c10c-348f-b3e7-ec56673cf67c",
                    "sense_definition": "gezegd van een land of economie die niet afhankelijk is van import uit het buitenland",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onafhankelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bewind wilde versneld <w>zelfvoorzienend</w> worden om minder afhankelijk te zijn van internationale handel.",
                            "target_lang_translations": {
                                "en": "The regime wanted to become <w>self-sufficient</w> more quickly to be less dependent on international trade."
                            }
                        },
                        {
                            "text": "Een <w>zelfvoorzienend</w> land produceert genoeg voedsel voor de gehele eigen bevolking.",
                            "target_lang_translations": {
                                "en": "A <w>self-sufficient</w> country produces enough food for its entire population."
                            }
                        }
                    ],
                    "synonyms": [
                        "autarkie"
                    ],
                    "antonyms": [
                        "importafhankelijk"
                    ],
                    "common_phrases": [
                        "economisch zelfvoorzienend"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in politieke of economische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "referring to a country or economy that is not dependent on imports from abroad"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "self-sufficient",
