                ],
                "senses": [
                    {
                        "sense_id": "8e9d135d-22c4-3da8-85a3-8706ddc8315e",
                        "entry_id": "90e2dcb2-2196-3470-b432-d03a0ae0e848",
                        "glosses": [
                            "Person, die (illegale) Drogen einnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eabc2205-a8ea-49df-a7f6-d208cb85fd25",
                                "sense_id": "8e9d135d-22c4-3da8-85a3-8706ddc8315e",
                                "text": "„Viele der meist jüngeren Drogenkonsumenten beschränken sich dabei nicht nur auf eine illegale Substanz und nehmen diese in Kombination etwa mit Alkohol.“"
                            },
                            {
                                "example_id": "75157626-a7bd-4ae9-9f49-76f65236694b",
                                "sense_id": "8e9d135d-22c4-3da8-85a3-8706ddc8315e",
                                "text": "„Zum Schluss hab ich ihr dann noch gesagt, und vielleicht hätt ich das nicht sagen sollen, ich hab ihr gesagt, dass es kein Drogengeschäft ohne Drogenkonsumenten gibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
