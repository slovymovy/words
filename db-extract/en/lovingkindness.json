                                        "sense_id": "b5d9557b-494f-3404-9f13-c787a87fbd61",
                                        "entry_id": "31af4e5a-78fc-3175-b37c-808296eddd9d",
                                        "glosses": [
                                            "die Handlung, eine Strafe, die man verhängen kann, einzuschränken oder aufzuheben; die juristisch bindende Anordnung, eine bereits verhängte Strafe zu mindern oder insgesamt zu erlassen"
                                        ],
                                        "tags": [
                                            "auch",
                                            "Rechtswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b8a8e99-5c2b-4e88-b8bd-9d635902f159",
                                                "sense_id": "b5d9557b-494f-3404-9f13-c787a87fbd61",
                                                "text": "Die Verurteilten wollten öffentlich um Gnade bitten."
                                            },
                                            {
                                                "example_id": "2c1637fd-7eb4-4d95-a7dd-67953ab6646c",
                                                "sense_id": "b5d9557b-494f-3404-9f13-c787a87fbd61",
                                                "text": "Gib deinem Herzen einen Ruck und zeig Gnade. Verzichte auf weitere Maßnahmen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7fc66059-7cea-34ab-a0f6-5af658fd74c2",
                                        "entry_id": "31af4e5a-78fc-3175-b37c-808296eddd9d",
                                        "glosses": [
                                            "die Hilfe Gottes in den prophetischen Religionen (Judentum, Christentum, Islam), Sünden unverdient zu vergeben"
                                        ],
                                        "tags": [
                                            "Theologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38791b88-d164-4447-826b-3a0fcc1c80d7",
                                                "sense_id": "7fc66059-7cea-34ab-a0f6-5af658fd74c2",
                                                "text": "„Die Botschaft der Gnade steht im Mittelpunkt der paulinischen Theologie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "96eed299-1586-3dc2-9bc6-7a6af6961acf",
                                        "entry_id": "31af4e5a-78fc-3175-b37c-808296eddd9d",
                                        "glosses": [
                                            "die Gunst, die Unterstützung, die zum Beispiel eine höherrangige Person oder auch besondere Umstände gewähren können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c3979c9-d83f-4422-bc9d-e9f284252ea5",
                                                "sense_id": "96eed299-1586-3dc2-9bc6-7a6af6961acf",
                                                "text": "Wenn du die Gnade deiner Angebeteten verlierst, dann wird es hart für dich, das ist dir schon klar, oder?"
                                            },
                                            {
                                                "example_id": "bd8cb7d6-fc6a-4651-a4f2-fd0efa9aaf1f",
                                                "sense_id": "96eed299-1586-3dc2-9bc6-7a6af6961acf",
                                                "text": "Es war schon eine Gnade, dass sie in diesen schweren Zeiten bei einer so fürsorglichen Familie untergekommen war."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e63a370-a3e2-4380-b5fb-1b79775c2d4e",
                        "source_entry_id": "321f72ea-1dba-3529-8fdc-f69d077a7956",
                        "source_sense_id": "b1ed4377-ca33-3918-9c38-852fcdc7e622",
                        "source_sense_description": "kindness which is based upon love",
                        "target_lang_word": "Barmherzigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barmherzigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5362e817-6d87-3840-8b3f-3848aaa192c8",
                                        "entry_id": "497ae4e7-7238-39ac-a79e-a0b8e01c1af1",
                                        "glosses": [
                                            "die Eigenschaft, barmherzig zu sein und/oder zu handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0024f39b-f47c-4a5c-b15b-d44025d235ac",
                                                "sense_id": "5362e817-6d87-3840-8b3f-3848aaa192c8",
                                                "text": "„Mitten in einer unbarmherzigen Welt ist die Barmherzigkeit jene Gerechtigkeit, nach der Jesu Jünger hungern und dürsten.“"
                                            },
                                            {
                                                "example_id": "09bc80b3-57ba-4299-ac56-15824674baf4",
                                                "sense_id": "5362e817-6d87-3840-8b3f-3848aaa192c8",
                                                "text": "„Denn die Menschen brauchen nach islamischer Lehre nicht Erlösung, sondern Gottes Barmherzigkeit.“"
                                            },
                                            {
                                                "example_id": "229d69dc-e90e-4dc4-9dda-f3b4178c3d7b",
                                                "sense_id": "5362e817-6d87-3840-8b3f-3848aaa192c8",
                                                "text": "„Dennoch ist ein Mangel an menschlicher Barmherzigkeit ein beschämender Charakterfehler, daher verurteile ich die Handlungen dieser Menschen nicht, aber ich stelle sie in Frage und empfinde sie als überwiegend fehlgeleitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15ff6023-accc-4ba7-aad2-3a96e2f02a43",
                        "source_entry_id": "321f72ea-1dba-3529-8fdc-f69d077a7956",
                        "source_sense_id": "b1ed4377-ca33-3918-9c38-852fcdc7e622",
                        "source_sense_description": "kindness which is based upon love",
                        "target_lang_word": "Güte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Güte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                        "entry_id": "2cdf01de-4927-35ad-baa0-17f5449253b1",
                                        "glosses": [
                                            "eine freundliche, wohlgesonnene, großzügige Einstellung und Handlungsweise gegenüber einer anderen Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61ccc6ac-e23b-4f61-96b8-ed4f8ddeddee",
                                                "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                                "text": "Ich aber bin gewiss, zu schauen die Güte des HERRN im Land der Lebenden."
                                            },
                                            {
                                                "example_id": "81102cd9-78a1-4152-b65f-36e2cf1d1936",
                                                "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                                "text": "Sein Handeln gegenüber Kollegen und Untergebenen war von großer Güte bestimmt."
                                            },
                                            {
                                                "example_id": "9ecf68bf-95b0-4a14-894c-74a7c72ba63a",
                                                "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                                "text": "„Hätten Sie die Güte und reichten mir einmal die Karte herüber. Vielen Dank.“"
                                            },
                                            {
                                                "example_id": "0a7ff6fc-619f-422a-b8d3-5b9f7001e86e",
                                                "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                                "text": "Wie kann Gott Inbegriff der vollkommenen Güte sein, wenn er den Menschen schreckliche Schicksale auferlegt?"
                                            },
                                            {
                                                "example_id": "bfa4399e-bcaa-4b7b-95b3-325f01c8717f",
                                                "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                                "text": "Symbol [für die Menschlichkeit] ist Pater Maximilian Kolbe geworden. Seine sozusagen sein Leben abschließende Tat war ein Akt der Liebe für einen Mithäftling. Und letztlich hatte nicht die SS das letzte Wort, sondern die Güte dieses Paters."
                                            },
                                            {
                                                "example_id": "ecbaafc4-cd23-4938-af92-01861c20be12",
                                                "sense_id": "d4cf7e70-5fcf-32e0-a81d-1b658cd6e300",
                                                "text": "Ein Foto zeigt sie [die 83-jährige Marissa Mavrapidou] und ihre Freunde, wie sie das Baby einer geflüchteten Frau trösten. Das Foto wurde in den Sozialen Medien weit verbreitet. Im Angesicht des ganzen Elends wurden die Frauen zu einem Symbol der Güte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "df7a2d3a-30ed-39b4-9236-c8a97817df7a",
                                        "entry_id": "2cdf01de-4927-35ad-baa0-17f5449253b1",
                                        "glosses": [
                                            "der Grad der erwünschten und beabsichtigten Beschaffenheit (= Qualität) eines Materials oder eines Instruments"
                                        ],
                                        "tags": [
                                            "Materialwirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aaa1e6d-7ca8-4823-97d0-aaa44f6518be",
                                                "sense_id": "df7a2d3a-30ed-39b4-9236-c8a97817df7a",
                                                "text": "Auf den Plantagen von São Tomé und Príncipe wächst Kakao von hervorragender Güte."
                                            },
                                            {
                                                "example_id": "fc4baf90-6b5e-44c0-a2e3-967bbacfdf4f",
                                                "sense_id": "df7a2d3a-30ed-39b4-9236-c8a97817df7a",
                                                "text": "[…] nur die wenigsten Ärzte [können] ihren Patienten zum Beispiel wirklich erklären, welchen Wert ein Krebstest hat. Dazu müssten sie etwas über die Güte des Tests wissen, aber auch über die Häufigkeit der Erkrankung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
