    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "794dc7e4-f5b9-3916-a090-b9d72c98f652",
                    "sense_definition": "The Pacific Ocean, the largest ocean on Earth, separating Asia and Australia from the Americas.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ocean_name",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "We flew across the <w>Pacific</w> to reach Japan.",
                            "target_lang_translations": {
                                "ru": "Мы перелетели через <w>Тихий океан</w>, чтобы добраться до Японии.",
                                "zh": "我们飞越了<w>太平洋</w>到达日本。"
                            }
                        },
                        {
                            "text": "Many unique fish species live deep in the <w>Pacific</w>.",
                            "target_lang_translations": {
                                "ru": "Многие уникальные виды рыб обитают в глубинах <w>Тихого океана</w>.",
                                "zh": "许多独特的鱼类生活在<w>太平洋</w>深处。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Pacific",
                        "across the Pacific",
                        "South Pacific"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тихий океан, самый большой океан на Земле, отделяющий Азию и Австралию от Америки.",
                        "zh": "太平洋，地球上最大的海洋，将亚洲和大洋洲与美洲隔开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тихий океан",
                                "target_lang_sense_clarification": "географическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "太平洋",
                                "target_lang_sense_clarification": "地理名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "761a3b2f-9712-3181-828c-768597540e99",
                    "sense_definition": "A city in Franklin County, Missouri, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They stopped in <w>Pacific</w> while driving through Missouri.",
                            "target_lang_translations": {
                                "ru": "Они остановились в <w>Пасифике</w>, проезжая через Миссури.",
                                "zh": "他们开车穿过密苏里州时，在<w>帕西菲克</w>停留了一下。"
                            }
                        },
                        {
                            "text": "The small town of <w>Pacific</w> has a rich local history.",
                            "target_lang_translations": {
                                "ru": "Небольшой город <w>Пасифик</w> имеет богатую местную историю.",
                                "zh": "<w>帕西菲克</w>这个小镇有着丰富的当地历史。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в округе Франклин, штат Миссури, США.",
                        "zh": "美国密苏里州富兰克林县的一个城市。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пасифик",
                                "target_lang_sense_clarification": "название города"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帕西菲克",
                                "target_lang_sense_clarification": "城市名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3948f0bb-8f9d-3746-867a-2d3d16bda0ed",
                    "sense_definition": "Of, relating to, or bordering the Pacific Ocean.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ocean_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Pacific</w> coast is famous for its beautiful beaches.",
                            "target_lang_translations": {
                                "ru": "<w>Тихоокеанское</w> побережье славится своими красивыми пляжами.",
                                "zh": "<w>太平洋</w>沿岸以其美丽的沙滩而闻名。"
                            }
                        },
                        {
                            "text": "Several <w>Pacific</w> islands are popular tourist destinations.",
                            "target_lang_translations": {
                                "ru": "Несколько <w>тихоокеанских</w> островов являются популярными туристическими направлениями.",
                                "zh": "一些<w>太平洋</w>岛屿是热门的旅游目的地。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Pacific Ocean",
                        "Pacific coast",
                        "Pacific region",
                        "Pacific Time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Тихому океану или граничащий с ним.",
                        "zh": "与太平洋有关的，或濒临太平洋的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тихоокеанский",
                                "target_lang_sense_clarification": "относящийся к океану"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "太平洋的",
                                "target_lang_sense_clarification": "形容词，指地理位置"
                            },
                            {
                                "target_lang_word": "太平洋沿岸的",
                                "target_lang_sense_clarification": "形容词，指沿海地区"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdf0886a-9e6e-3053-8a8e-29b5c781ff0d",
                    "sense_definition": "Characterized by peace, calm, or tranquility.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "peaceful_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lake looked wonderfully <w>pacific</w> in the early morning light.",
                            "target_lang_translations": {
                                "ru": "Озеро выглядело удивительно <w>спокойным</w> в утреннем свете.",
                                "zh": "清晨的阳光下，湖面看起来格外<w>平静</w>。"
                            }
                        },
                        {
                            "text": "He maintained a <w>pacific</w> demeanor even when others were shouting.",
                            "target_lang_translations": {
                                "ru": "Он сохранял <w>мирное</w> выражение лица, даже когда другие кричали.",
                                "zh": "即使在别人大喊大叫时，他依然保持着<w>温和</w>的态度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "calm",
                        "peaceful",
                        "serene",
                        "tranquil",
                        "placid"
                    ],
                    "antonyms": [
                        "violent"
                    ],
                    "common_phrases": [
                        "pacific waters",
                        "pacific mood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся миром, спокойствием или безмятежностью.",
                        "zh": "以和平、平静或宁静为特征的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спокойный",
                                "target_lang_sense_clarification": "безмятежный"
                            },
                            {
                                "target_lang_word": "мирный",
                                "target_lang_sense_clarification": "тихий, не бурный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平静的",
                                "target_lang_sense_clarification": "形容环境或状态"
                            },
                            {
                                "target_lang_word": "宁静的",
                                "target_lang_sense_clarification": "形容氛围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b31792d-f30a-3c40-ad22-beb04d402b6d",
                    "sense_definition": "Disposed to peace or of a peaceful nature; desiring to avoid conflict and violence.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "peaceful_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government pursued a <w>pacific</w> policy to avoid entering the war.",
                            "target_lang_translations": {
                                "ru": "Правительство проводило <w>миролюбивую</w> политику, чтобы избежать вступления в войну.",
                                "zh": "政府推行<w>和平</w>政策以避免卷入战争。"
                            }
                        },
                        {
                            "text": "Her <w>pacific</w> nature made her an excellent mediator during disputes.",
                            "target_lang_translations": {
                                "ru": "Её <w>миролюбивый</w> характер делал её отличным посредником в спорах.",
                                "zh": "她<w>爱好和平</w>的天性使她成为纠纷中出色的调解人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peaceable",
                        "nonviolent",
                        "dovish"
                    ],
                    "antonyms": [
                        "bellicose",
                        "hawkish",
                        "militant",
                        "martial"
                    ],
                    "common_phrases": [
                        "pacific intentions",
                        "pacific solution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к миру или мирный по своей природе; стремящийся избегать конфликтов и насилия.",
                        "zh": "爱好和平的，或具有和平性质的；渴望避免冲突和暴力的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "миролюбивый",
                                "target_lang_sense_clarification": "стремящийся к миру"
                            },
                            {
                                "target_lang_word": "мирный",
                                "target_lang_sense_clarification": "неагрессивный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爱好和平的",
                                "target_lang_sense_clarification": "形容性格或政策"
                            },
                            {
                                "target_lang_word": "温和的",
                                "target_lang_sense_clarification": "形容不具攻击性的态度"
                            }
                        ]
                    }
                }
            ]
        },
