                ],
                "senses": [
                    {
                        "sense_id": "f77d8bc9-1970-3714-9175-dacbc20e28cf",
                        "entry_id": "b742b12c-b516-354a-b5eb-3a503b5b731a",
                        "glosses": [
                            "od lico albo lice (twarz, oblicze; policzek)"
                        ],
                        "tags": [
                            "diminutive",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "dd886ee9-5171-4019-ba28-91818df1b585",
                                "sense_id": "f77d8bc9-1970-3714-9175-dacbc20e28cf",
                                "text": "Mama promieniała patrząc na różane liczka Ignasiunia, na długie złociste włosy, które niecierpliwie odgarniał z czoła"
                            },
                            {
                                "example_id": "f4c6aad6-32d0-495d-9acd-683d7a94661d",
                                "sense_id": "f77d8bc9-1970-3714-9175-dacbc20e28cf",
                                "text": "Miał król córkę jedyną, królewnę modrooką, ślicznego była liczka, kochano ją głęboko"
                            },
                            {
                                "example_id": "3f595297-7892-40cb-97ba-13a188a86922",
                                "sense_id": "f77d8bc9-1970-3714-9175-dacbc20e28cf",
                                "text": "U tych tam baletniczek / Kochają gładkość liczek"
                            },
                            {
                                "example_id": "067a401e-f6a6-4512-a328-6b3204a8436b",
                                "sense_id": "f77d8bc9-1970-3714-9175-dacbc20e28cf",
                                "text": "Oczy Basi zabłysły; śliczne liczko rumieńcem się pokryło"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "91f1f0c1-7182-3377-b5ba-156480a8b17f",
                        "entry_id": "b742b12c-b516-354a-b5eb-3a503b5b731a",
                        "glosses": [
                            "powierzchnia skóry od strony włosia; gładka, górna powierzchnia wyprawionej skóry"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "814b3cde-4336-4be8-8534-df82c299d48e",
                                "sense_id": "91f1f0c1-7182-3377-b5ba-156480a8b17f",
                                "text": "Skóry świńskie odznaczają się bardzo ładnym i trwałym liczkiem"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "07ba7dc8-6438-3d15-bc3b-15b99f66a1a4",
