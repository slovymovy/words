                "senses": [
                    {
                        "sense_id": "f6033c9a-d7d3-360f-a511-782a9de2089e",
                        "entry_id": "cc12c589-ab77-3f2d-959e-6ced244f23c1",
                        "glosses": [
                            "Käufer, Abnehmer von Wein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51845867-3733-46c5-81c0-f6cb5487d4c5",
                                "sense_id": "f6033c9a-d7d3-360f-a511-782a9de2089e",
                                "text": "„Zu solchen Beziehungen, die einen Anruf rechtfertigen, gehöre auch der Kontakt, den ein Weinkunde mit dem Vertreter einer Weinhandlung unterhalte.“"
                            },
                            {
                                "example_id": "30255587-0a73-47dd-adb0-47e79efd063a",
                                "sense_id": "f6033c9a-d7d3-360f-a511-782a9de2089e",
                                "text": "„Die Weinkunden, die natürlich nichts davon wussten und die auch nichts schmeckten, kauften folglich eine andere Qualität als die, die sie glaubten zu kaufen.“"
                            }
                        ],
