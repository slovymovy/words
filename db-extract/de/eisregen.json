                        "entry_id": "7e2b5427-f61d-35b5-8dcb-889abe408541",
                        "glosses": [
                            "Regen, der in Form von kleinen Eiskörnern niedergeht und sofort einen festen Eisüberzug bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38981487-6628-4e57-b825-1052d439068e",
                                "sense_id": "b95905c6-5a41-3eb5-a2ed-1e4693f77e2b",
                                "text": "Eisregen ist extrem gefährlich für den Verkehr."
                            },
                            {
                                "example_id": "ff95bb9d-3174-41a9-b81e-8442453552ca",
                                "sense_id": "b95905c6-5a41-3eb5-a2ed-1e4693f77e2b",
                                "text": "„Als sie am Schwarzenbergplatz den Ring überqueren wollten, begann ein heftiger Eisregen, von Blitz und Donner begleitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
