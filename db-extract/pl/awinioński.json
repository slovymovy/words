                "senses": [
                    {
                        "sense_id": "bac8b345-f8ee-3a36-a639-3979d62c05dc",
                        "entry_id": "37fcd611-aa54-39a0-94ea-247fb7af6c49",
                        "glosses": [
                            "związany z Awinionem (miastem we Francji)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3befef22-a38b-47b3-a5d9-aad6eb307ba3",
                                "sense_id": "bac8b345-f8ee-3a36-a639-3979d62c05dc",
                                "text": "Pod tym względem pałac Watykański wybudowany za pontyfikatu Mikołaja III z długimi ceremonialnymi przejściami, mnogością wielkich reprezentacyjnych pomieszczeń antycypował koncepcję rezydencji awiniońskiej"
                            },
                            {
                                "example_id": "1e0cbc1e-41e1-4d6d-aab0-401161b00a69",
                                "sense_id": "bac8b345-f8ee-3a36-a639-3979d62c05dc",
                                "text": "Rozłam w Kościele katolickim utrzymywał się przez trzy dekady. Obozy rzymski i awinioński powoływały swoich kolejnych papieży, powodując dewastację autorytetu władzy papieskiej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
