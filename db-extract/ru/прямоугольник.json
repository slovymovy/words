                "senses": [
                    {
                        "sense_id": "368dc828-8a59-318a-a96f-2925fdff0c01",
                        "entry_id": "6d51f7f1-b3c6-3f69-aacc-d25784fcd883",
                        "glosses": [
                            "геометр. четырёхугольник, у которого все четыре угла прямые"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a410d71-380d-4e55-916c-9f82c4809654",
                                "sense_id": "368dc828-8a59-318a-a96f-2925fdff0c01",
                                "text": "Противоположные стороны прямоугольника равны."
                            },
                            {
                                "example_id": "6d0e54c2-3fbf-4a18-819c-9d3d36662de7",
                                "sense_id": "368dc828-8a59-318a-a96f-2925fdff0c01",
                                "text": "Любой прямоугольник является параллелограммом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6c8cf96-62f2-4acf-80a9-727873e6db9f",
                        "source_entry_id": "6d51f7f1-b3c6-3f69-aacc-d25784fcd883",
                        "source_sense_id": "368dc828-8a59-318a-a96f-2925fdff0c01",
                        "target_lang_word": "rectangle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rectangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93bffba8-cfc3-3c65-8ce8-eb210c580d24",
                                        "entry_id": "82be9a4a-70e8-33a0-8c64-75f232f2bd5a",
                                        "glosses": [
                                            "Any quadrilateral having opposing sides parallel and four right angles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab064e0e-b329-3a8c-b2c7-f27c1b0dda63",
                                        "entry_id": "82be9a4a-70e8-33a0-8c64-75f232f2bd5a",
                                        "glosses": [
                                            "Such a quadrilateral that is oblong (longer than it is wide): one that is not regular (equilateral), that is, any except a square."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ad1b3bc-043e-3367-995b-b95f8cd99680",
                                        "entry_id": "82be9a4a-70e8-33a0-8c64-75f232f2bd5a",
                                        "glosses": [
                                            "A right angle."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64147a08-8662-4b9d-9630-916e6afe0a30",
                                                "sense_id": "2ad1b3bc-043e-3367-995b-b95f8cd99680",
                                                "text": "For why should you praise, for example, the integrity of a Square who faithfully defends the interests of his client, when you ought in reality rather to admire the exact precision of his Rectangles?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4bbda37-53b9-3fee-83f7-7428dd5dabe7",
                                        "entry_id": "82be9a4a-70e8-33a0-8c64-75f232f2bd5a",
                                        "glosses": [
                                            "The product of two quantities."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "959cbb32-331b-42df-a23a-51fc2baf5594",
                                                "sense_id": "b4bbda37-53b9-3fee-83f7-7428dd5dabe7",
                                                "text": "In Lines it [the product] is always (and ſometimes in Numbers) call'd the Rectangle between the two Lines, multiply'd by one another."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rectangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2801a1e1-54e9-3cda-b50c-dd4c581229ea",
                                        "entry_id": "bf08906e-0d61-332d-95a0-9fd066ca0fef",
                                        "glosses": [
                                            "Right-angled."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7559662-7cbb-437f-b763-8f554ca5771b",
                                                "sense_id": "2801a1e1-54e9-3cda-b50c-dd4c581229ea",
                                                "text": "a rectangle triangle"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d30c9726-d70a-4d18-bf94-78bfb87427d9",
                        "source_entry_id": "6d51f7f1-b3c6-3f69-aacc-d25784fcd883",
                        "source_sense_id": "368dc828-8a59-318a-a96f-2925fdff0c01",
                        "target_lang_word": "Rechteck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechteck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "907e954f-3d61-32eb-aa16-bea81f6936a7",
                                        "entry_id": "1c28812c-4e96-30a1-bf62-1637c107d609",
                                        "glosses": [
                                            "geometrische Figur mit vier Seiten, bei der die gegenüberliegenden Seiten parallel zueinander verlaufen und benachbarte Seiten rechtwinklig aufeinanderstehen (also ein Parallelogramm mit 4 rechten Winkeln)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f147aba7-5029-4ffc-b5e1-78e30a504667",
                                                "sense_id": "907e954f-3d61-32eb-aa16-bea81f6936a7",
                                                "text": "Ein Fußballfeld hat die Form eines Rechtecks."
                                            },
                                            {
                                                "example_id": "fd815f13-80e6-47e7-9319-8bc282792bb1",
                                                "sense_id": "907e954f-3d61-32eb-aa16-bea81f6936a7",
                                                "text": "„Später würde eine Untersuchungskommission feststellen, dass das ausgebrochene Stück der Tragfläche ein Rechteck war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00c8c5aa-e347-4491-9365-24a72b7f48ab",
                        "source_entry_id": "6d51f7f1-b3c6-3f69-aacc-d25784fcd883",
