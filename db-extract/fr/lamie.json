        "fr-extract.jsonl": [
            {
                "entry_id": "367902c8-7e44-3357-969d-25fa6a8c49aa",
                "word": "lamie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "45133360-61c2-43c3-aa80-0f54bb6ec645",
                        "entry_id": "367902c8-7e44-3357-969d-25fa6a8c49aa",
                        "tags": [
                            "plural"
                        ],
                        "form": "lamies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eea76ae6-3023-3702-8e5c-7d8f5d670413",
                        "entry_id": "367902c8-7e44-3357-969d-25fa6a8c49aa",
                        "glosses": [
                            "Être fabuleux qui passait pour dévorer les enfants et qu’on représentait ordinairement avec une tête et torse de femme et un corps de serpent."
                        ],
                        "tags": [
                            "Mythologie grecque"
                        ],
                        "examples": [
                            {
                                "example_id": "fc6012a8-0a16-487d-89dd-2edd083ab14e",
                                "sense_id": "eea76ae6-3023-3702-8e5c-7d8f5d670413",
                                "text": "Des êtres surnaturels, répondit le magister Hermod d’une voix qui imposait. Pourquoi ne seraient-ce pas des esprits, des babeaux, des gobelins, peut-être même quelques-unes de ces dangereuses lamies, qui se présentent sous la forme de belles femmes…"
                            },
                            {
                                "example_id": "4a302c86-ef08-4d18-8b6d-b7e35ff94d4c",
                                "sense_id": "eea76ae6-3023-3702-8e5c-7d8f5d670413",
                                "text": "Jamais une sombre lamie, une mante décharnée n’osa étaler la hideuse laideur de ses traits dans les banquets de Thessalie."
                            },
                            {
                                "example_id": "63468e06-105d-4ed2-a76a-20842e173a2a",
                                "sense_id": "eea76ae6-3023-3702-8e5c-7d8f5d670413",
                                "text": "Nous dînâmes tous ensemble dans la cour, à la lueur de trois ou quatre lampes de cuivre jaune assez semblables aux lampes antiques funèbres, dont l’air de la nuit faisait vaciller la flamme en ombres et en lumières bizarres qui nous donnaient l’air de lamies et de goules déchirant des morceaux d’enfant déterré."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8a58c43-4820-3a45-bb8b-fa7882043402",
                        "entry_id": "367902c8-7e44-3357-969d-25fa6a8c49aa",
                        "glosses": [
                            "Requin pouvant mesurer jusqu’à 8 mètres, de couleur gris bleuâtre sur la face supérieure et blanche sur la face inférieure. Lamna nasus ou touille-bœuf ou melantoun, ou maraîche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33398751-18aa-44f3-be17-75d628039e6d",
                                "sense_id": "a8a58c43-4820-3a45-bb8b-fa7882043402",
                                "text": "La lamie se nourrit surtout de poissons pélagiques comme le hareng, le cavalo ou le maquereau, elle consomme aussi de la morue, du sébaste, de l’aiglefin, de l’encornet ainsi que des mollusques et crustacés, mais pas de mammifères marins."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5cb89f2-c274-479e-85ca-5ef3867203a7",
                        "source_entry_id": "367902c8-7e44-3357-969d-25fa6a8c49aa",
                        "source_sense_id": "eea76ae6-3023-3702-8e5c-7d8f5d670413",
                        "source_sense_description": "Être mythologique",
                        "target_lang_word": "lamia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lamia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0630b6e6-b6cf-36fb-b4f0-ddd9971729e9",
                                        "entry_id": "ea66ab67-a608-3312-969c-620c36370fe7",
                                        "glosses": [
                                            "A monster preying upon human beings, who sucked the blood of children, often described as having the head and breasts of a woman and the lower half of a serpent."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a377e106-aba6-47a9-b04b-e5eb79f16d27",
                                                "sense_id": "0630b6e6-b6cf-36fb-b4f0-ddd9971729e9",
                                                "text": "Apollonius […] by some probable conjectures, found her out to be a serpent, a lamia, and that all her furniture was like Tantalus' gold described by Homer, no substance, but mere illusions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c70775cd-ca7f-4743-bbce-3511bf6fba63",
                        "source_entry_id": "367902c8-7e44-3357-969d-25fa6a8c49aa",
                        "source_sense_id": "eea76ae6-3023-3702-8e5c-7d8f5d670413",
                        "source_sense_description": "Être mythologique",
                        "target_lang_word": "λάμια",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "λάμια",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "c04620e2-8db7-3294-8b39-ffb22959a2c5",
                                        "entry_id": "0fa03e7e-1517-3a10-98a0-3dbbdd033b77",
                                        "glosses": [
                                            "τέρας που έπλασε η λαϊκή φαντασία με μορφή γυναίκας"
                                        ],
                                        "tags": [
                                            "μυθολογία"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b033a9ca-ce88-40f9-a786-9ff033a91518",
                                                "sense_id": "c04620e2-8db7-3294-8b39-ffb22959a2c5",
                                                "text": "πρόσεχε γιατί θα σε φάει η λάμια"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91eca616-2a7e-3417-9709-3aac09598aeb",
                                        "entry_id": "0fa03e7e-1517-3a10-98a0-3dbbdd033b77",
                                        "glosses": [
                                            "πολύ κακιά γυναίκα"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "765d7902-6b50-4c49-9bf6-e586a4cf5372",
                                                "sense_id": "91eca616-2a7e-3417-9709-3aac09598aeb",
                                                "text": "※ Ακόμη κι αν της άρεσε, έπρεπε να το στραγγαλίσει το αίσθημα και να πάρει τα πόδια της να τσακιστεί η λάμια. Η αντροχωρίστρα. Τον άντρα της αδελφής της , το πουταναριό. Θυμωμένη, έξαλλη σαν σκύλα, μπήκε στην κουζίνα και την πλάκωσε στο ξύλο. Η άλλη μαζεμένη το δεχόταν, γιατί ήξερε πως ήταν δίκαιο (Ευγενία Φακίνου, Τυφλόμυγα, εκδ. Καστανιώτη, 2000)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
