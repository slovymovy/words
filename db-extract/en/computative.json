                                    {
                                        "sense_id": "258e372a-e352-3a55-b9cd-09717e5c6406",
                                        "entry_id": "f6bd4bb7-fe94-3944-b1c4-34c757cfeeae",
                                        "glosses": [
                                            "rechnerisch, auf Berechnungen beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c4b8be7-ab18-49a2-b65b-fe0545e4d882",
                                                "sense_id": "258e372a-e352-3a55-b9cd-09717e5c6406",
                                                "text": "\"Diese neue, komputativ hergestellte Grundkarte wird dann als zuverlässige Grundlage … dienen\""
                                            },
                                            {
                                                "example_id": "9c947bb3-9abd-49a9-88bc-4eb1f24f4acd",
                                                "sense_id": "258e372a-e352-3a55-b9cd-09717e5c6406",
                                                "text": "\"Dadurch soll eine weitgehende Übereinstimmung der komputativ ermittelten Punktaggregate mit den visuell erkennbaren Gebieten erzielt werden.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0b1f56a-2a07-452f-8418-6216a66b5811",
                        "source_entry_id": "6931a6fe-4e9e-33e4-9754-2bceb0c9a4df",
                        "source_sense_description": "computational",
                        "target_lang_word": "rechnerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
