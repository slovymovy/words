                        "examples": [
                            {
                                "example_id": "ce49d1a3-15ec-40ce-b23f-c309eb1e9b3e",
                                "sense_id": "5a2f4dba-ddc1-3e35-8e2f-ec18a7378a12",
                                "text": "Pour réunir & souder ces quatre bougies, on se sert d’un soudoir de fer épais vers le milieu, & qui va en diminuant vers les deux bouts, qui n’ont environ qu’une demi-ligne d’épaisseur."
                            },
                            {
                                "example_id": "528b6e70-5bfa-4ebd-83e7-57d43a3fa9cb",
                                "sense_id": "5a2f4dba-ddc1-3e35-8e2f-ec18a7378a12",
                                "text": "On applique la soudure d’étain au moyen d’un instrument nommé soudoir, dont les formes et les dimensions varient. … La partie du soudoir qui doit appliquer la soudure est étamée à l’étain, soit avec le sel ammoniac, soit avec la colophane."
                            }
                        ]
                    }
