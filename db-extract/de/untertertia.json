                ],
                "senses": [
                    {
                        "sense_id": "dae96513-e01a-33f5-b2c2-8ec102896ddf",
                        "entry_id": "ce128846-285f-327e-a505-a178a3092c23",
                        "glosses": [
                            "vierte Klasse am Gymnasium, insgesamt Klasse 8"
                        ],
                        "tags": [
                            "Germany",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "7e31773e-d82a-4d67-b08a-de0a47f6ef64",
                                "sense_id": "dae96513-e01a-33f5-b2c2-8ec102896ddf",
                                "text": "„Auch der nette Chemielehrer, der die Schüler einschließlich der Untertertia unterrichtete, sollte bis ans Ende an das Regime geglaubt haben.“"
                            },
                            {
                                "example_id": "6a75d72a-66cd-4eda-b0dd-5cedace3f6f8",
                                "sense_id": "dae96513-e01a-33f5-b2c2-8ec102896ddf",
                                "text": "„Den nächsten Vormittag traf in der Lindenallee 113 ein Brief ein, in dem der Direktor des Realgymnasiums Averhoffstraße Alf Bertini ohne Angabe von Gründen mitteilte, daß sein Sohn Ludwig die Schule mit Abschluß der Untertertia im kommenden September zu verlassen habe.“"
                            },
                            {
                                "example_id": "2a0b712a-dc8d-49d5-9bc4-ae2fb126ea88",
                                "sense_id": "dae96513-e01a-33f5-b2c2-8ec102896ddf",
                                "text": "„Obwohl er ein guter Schüler war – er besuchte damals die Untertertia der Eichwalder Oberschule –, sah er doch sein Vorwärtskommen gehindert oder zumindest gehemmt, zumal einige Lehrer nun die Maske vom Gesicht nahmen und sich durch besonders strenge Behandlung des ›Sozibengels‹ einen guten Ruf bei den Parteidienststellen und dem neuen Bürgermeister zu erringen suchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
