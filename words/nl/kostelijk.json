                            }
                        },
                        {
                            "text": "Die oude komedie is nog steeds een <w>kostelijke</w> film om naar te kijken.",
                            "target_lang_translations": {
                                "fr": "Cette vieille comédie reste un film <w>délicieux</w> à regarder."
                            }
                        }
                    ],
                    "common_phrases": [
