    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "25297733-07a0-3771-a2b1-178e310b30a3",
                "word": "therefrom",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "87736957-a504-3d9c-bcb1-5584ecd2a9ba",
                        "entry_id": "25297733-07a0-3771-a2b1-178e310b30a3",
                        "glosses": [
                            "From that."
                        ],
                        "tags": [
                            "formal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7333f482-d77a-4702-b59f-a38dcc49758d",
                                "sense_id": "87736957-a504-3d9c-bcb1-5584ecd2a9ba",
                                "text": "No man ever deliberately does injury to another without himself suffering therefrom, at some future day, as much as the party he has injured; although it may be after a different fashion."
                            },
                            {
                                "example_id": "3c5d668f-c5f1-4adb-9a62-97351c38c413",
                                "sense_id": "87736957-a504-3d9c-bcb1-5584ecd2a9ba",
                                "text": "Therefrom Boshy's saving propensities, being but the idiosyncrasies of the rich, were mercifully endured and spoken of by Mr. Civil."
                            },
                            {
                                "example_id": "d425bdaf-00bf-457c-92d1-df39cf2cd437",
                                "sense_id": "87736957-a504-3d9c-bcb1-5584ecd2a9ba",
                                "text": "Little disappointed, then, she turned attention to \"Chat of the Social World,\" gossip which exercised potent fascination upon the girl's intelligence. She devoured with more avidity than she had her food those pretentiously phrased chronicles of the snobocracy—[…]—distilling therefrom an acid envy that robbed her napoleon of all its flavor."
                            },
                            {
                                "example_id": "fc8b87e2-1b8a-4117-9d4b-d152424a0e70",
                                "sense_id": "87736957-a504-3d9c-bcb1-5584ecd2a9ba",
                                "text": "Death is merciful, for there is no return therefrom"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9c9da18-15e8-477c-8979-00b2f4773817",
                        "source_entry_id": "25297733-07a0-3771-a2b1-178e310b30a3",
                        "source_sense_id": "87736957-a504-3d9c-bcb1-5584ecd2a9ba",
                        "source_sense_description": "within this content or context",
                        "target_lang_word": "daaruit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daaruit",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "883d97d8-0c71-318e-b931-3882144ae973",
                                        "entry_id": "84451de6-6080-384b-b0fa-391417d72925",
                                        "glosses": [
                                            "uit dat, uit deze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd5a395-c28b-47a7-8cdb-94e52d21c3f0",
                                                "sense_id": "883d97d8-0c71-318e-b931-3882144ae973",
                                                "text": "Daaruit wordt goud gewonnen."
                                            },
                                            {
                                                "example_id": "688b081e-eb0d-4e8c-bfd4-1cd6f80faac0",
                                                "sense_id": "883d97d8-0c71-318e-b931-3882144ae973",
                                                "text": "Daar wordt goud uit gewonnen."
                                            },
                                            {
                                                "example_id": "bc822b00-4b66-419f-88a2-9f819b277776",
                                                "sense_id": "883d97d8-0c71-318e-b931-3882144ae973",
                                                "text": "Daaruit trok hij de conclusie dat hij nooit meer gezond zou worden."
                                            },
                                            {
                                                "example_id": "a7abea35-9430-47f9-a32f-35703b2d4263",
                                                "sense_id": "883d97d8-0c71-318e-b931-3882144ae973",
                                                "text": "Ik zei tegen Georgia dat haar broer in diepe slaap was en dat we niet wisten wanneer hij daaruit zou komen."
                                            },
                                            {
                                                "example_id": "27f7141d-91a9-4e5b-b9df-06fcb44db4a0",
                                                "sense_id": "883d97d8-0c71-318e-b931-3882144ae973",
                                                "text": "Mocht deze regeling u schikken, bericht u me dan per kerende post of u op het aanbod ingaat en dan zullen we van daaruit verder kijken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a872e91-ad91-4d76-b384-2f91e350a4c0",
                        "source_entry_id": "25297733-07a0-3771-a2b1-178e310b30a3",
                        "source_sense_id": "87736957-a504-3d9c-bcb1-5584ecd2a9ba",
                        "source_sense_description": "within this content or context",
                        "target_lang_word": "de là",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de là",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41173fc1-29e9-3830-9878-b132f14868fd",
                                        "entry_id": "67bc0ee2-83ea-3b8a-83c9-ce19fdaaadb6",
                                        "glosses": [
                                            "De ce lieu-là, de cet endroit, de cette situation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32a63ae0-18c7-44ac-bba9-7b81ddad9339",
                                                "sense_id": "41173fc1-29e9-3830-9878-b132f14868fd",
                                                "text": "Le régiment fut d’abord rapatrié à Toulon, puis à Brest à l’autre bout du pays. De là, il devait partir pour l’Extrême-Orient. Le Vietnam."
                                            },
                                            {
                                                "example_id": "e2a314de-8bfe-470a-a29d-a0ea6fa73ce6",
                                                "sense_id": "41173fc1-29e9-3830-9878-b132f14868fd",
                                                "text": "De là au village il y a deux kilomètres."
                                            },
                                            {
                                                "example_id": "5397354b-ff40-4061-91e7-cac02d4653dd",
                                                "sense_id": "41173fc1-29e9-3830-9878-b132f14868fd",
                                                "text": "À quelques pas de là."
                                            },
                                            {
                                                "example_id": "05b26db4-633b-4c59-bc21-8d34725571d1",
                                                "sense_id": "41173fc1-29e9-3830-9878-b132f14868fd",
                                                "text": "Ôtez-vous de là."
                                            },
                                            {
                                                "example_id": "1f584e8a-c34f-43b1-9be9-9f823eca45e6",
                                                "sense_id": "41173fc1-29e9-3830-9878-b132f14868fd",
                                                "text": "Tirez-vous de là comme vous pourrez."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3dcd66e-08e8-336a-9cd6-627db48bdb2e",
                                        "entry_id": "67bc0ee2-83ea-3b8a-83c9-ce19fdaaadb6",
                                        "glosses": [
                                            "De ce temps-là, de ce moment-là."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f7726b4-3383-45e9-8c58-fca7b8f579f7",
                                                "sense_id": "b3dcd66e-08e8-336a-9cd6-627db48bdb2e",
                                                "text": "À quelques jours de là."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "354e4d18-10f2-3c9c-beb0-eb00cf5de84f",
                                        "entry_id": "67bc0ee2-83ea-3b8a-83c9-ce19fdaaadb6",
                                        "glosses": [
                                            "De cette cause, de cet événement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ebdf98b-6757-45fd-a188-7e26224d40dc",
                                                "sense_id": "354e4d18-10f2-3c9c-beb0-eb00cf5de84f",
                                                "text": "À cette occasion, il n’avait pas marchandé de dures vérités à son auditoire. De là, sa réputation."
                                            },
                                            {
                                                "example_id": "a9e5ed27-1b17-42c4-8a34-60ac83ccbab1",
                                                "sense_id": "354e4d18-10f2-3c9c-beb0-eb00cf5de84f",
                                                "text": "De là sont venus tous nos malheurs."
                                            },
                                            {
                                                "example_id": "7e6fc65a-f9c0-4e1c-a877-c99735fd885f",
                                                "sense_id": "354e4d18-10f2-3c9c-beb0-eb00cf5de84f",
                                                "text": "Que concluez-vous de là ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb5899fb-1fb4-3e06-9084-cc918f7e9043",
                                        "entry_id": "67bc0ee2-83ea-3b8a-83c9-ce19fdaaadb6",
                                        "glosses": [
                                            "Ce qui explique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "141e0078-c978-4742-82ac-e1d67ff050b2",
                                                "sense_id": "bb5899fb-1fb4-3e06-9084-cc918f7e9043",
                                                "text": "Pour ma part, je crois m'en tirer assez bien sur le plan diététique, mais il est vrai que le métier d'historien m'amène à dépenser assez peu de calories – de là la course, et la montre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3dd1fa9a-cc6a-4000-8829-92cd28530185",
                        "source_entry_id": "25297733-07a0-3771-a2b1-178e310b30a3",
                        "source_sense_id": "87736957-a504-3d9c-bcb1-5584ecd2a9ba",
                        "source_sense_description": "within this content or context",
                        "target_lang_word": "daher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c0d9974-71a7-32b4-9bac-d5bb8d88d6e1",
                                        "entry_id": "daf1f4f2-79f1-367c-89c0-ae45a30849b7",
                                        "glosses": [
                                            "ersetzt einen bestimmten Ort, der zuvor erwähnt wurde, von dort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2f06a0c-f16e-4446-8afd-3f0663d01521",
                                                "sense_id": "9c0d9974-71a7-32b4-9bac-d5bb8d88d6e1",
                                                "text": "Wolltest du nicht zu deiner Schwester? Daher komme ich gerade."
                                            },
                                            {
                                                "example_id": "ce354e30-8b42-4733-aefc-f3d7e0a5b23f",
                                                "sense_id": "9c0d9974-71a7-32b4-9bac-d5bb8d88d6e1",
                                                "text": "Von Kallmeier? Daher beziehe ich auch meinen Wein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "904e1256-179c-3caf-ba17-d6742f5a4ea6",
                                        "entry_id": "daf1f4f2-79f1-367c-89c0-ae45a30849b7",
                                        "glosses": [
                                            "hier her, an den gemeinten, gezeigten Ort"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f342c8fb-ccdd-40a9-87c0-cdb8b50672da",
                                                "sense_id": "904e1256-179c-3caf-ba17-d6742f5a4ea6",
                                                "text": "„Komm mal daher, du bleibscht haut drin, dau gehscht mit in de Schul, haut ham ma dat alt Testament.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7c7fd367-c111-3908-8259-d8efa64bd29e",
                                        "entry_id": "daf1f4f2-79f1-367c-89c0-ae45a30849b7",
                                        "glosses": [
                                            "eine Schlussfolgerung einleitend; ersetzt einen erwähnten Hintergrund, Grund, Umstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c84b4307-661c-490e-9a74-11b3ec527e94",
                                                "sense_id": "7c7fd367-c111-3908-8259-d8efa64bd29e",
                                                "text": "Er war frech, daher warf ihn der Lehrer aus der Klasse."
                                            },
                                            {
                                                "example_id": "7b2af07c-9852-44be-a3f5-9179d2edb2a8",
                                                "sense_id": "7c7fd367-c111-3908-8259-d8efa64bd29e",
                                                "text": "Daher, dass sie es nie gemacht hatte, konnte sie es auch nicht."
                                            },
                                            {
                                                "example_id": "d94630b2-10eb-4df2-8eac-fc7a23b5599b",
                                                "sense_id": "7c7fd367-c111-3908-8259-d8efa64bd29e",
                                                "text": "„Die Darstellung ist schon durch die Zweideutigkeit des in einem ganz uneigentlichen Sinne gebrauchten Wortes Deus, und auch noch außerdem, undeutlich; daher er sich in Dunkelheit verliert und es am Ende heißt: nec impraesentiarum haec clarius possum explicare.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
