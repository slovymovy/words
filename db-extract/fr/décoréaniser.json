                "senses": [
                    {
                        "sense_id": "7abd0e36-4251-3f34-9da9-dfa8faf553e3",
                        "entry_id": "7cc27cd7-170d-39d8-a0d4-2a97213f7b77",
                        "glosses": [
                            "Faire perdre son caractère coréen à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3a745d3-e2ab-40a8-babc-f8a01adb8215",
                                "sense_id": "7abd0e36-4251-3f34-9da9-dfa8faf553e3",
                                "text": "En bref, les Japonais visaient à “décoréaniser” totalement l’éducation."
                            },
                            {
                                "example_id": "2e758a93-d268-4697-8db6-6f6f9e0b8d13",
                                "sense_id": "7abd0e36-4251-3f34-9da9-dfa8faf553e3",
                                "text": "Danielle Risterucci-Roudnicky remarque que la mention « roman coréen » des éditeurs français de littérature étrangère « décoréanise » des textes qui ne sont pas des romans."
                            },
                            {
                                "example_id": "a2295726-b063-4235-b963-d0b197932790",
                                "sense_id": "7abd0e36-4251-3f34-9da9-dfa8faf553e3",
                                "text": "Ce n’est pas un déplacement officiel qui lui permettra d’entrer véritablement en contact avec le pays parce que ce genre de voyage décoréanise la Corée."
                            }
                        ]
                    }
                ],
