                "senses": [
                    {
                        "sense_id": "a2e5ab29-f75f-3143-a6a3-5f8944f41efd",
                        "entry_id": "d43deaae-f730-31f3-b887-5523be03f625",
                        "glosses": [
                            "To cause, bring about (an event); to accomplish, to carry out (a wish, plan etc.)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "33807f1b-e2b5-4a54-8412-164f9f0506b1",
                                "sense_id": "a2e5ab29-f75f-3143-a6a3-5f8944f41efd",
                                "text": "[T]he next necessary step was to elude the vigilance of my guard: and in this manner did I effectuate my purpose."
                            },
                            {
                                "example_id": "4428d610-ff94-44e0-a2f4-35e7ad8146f6",
                                "sense_id": "a2e5ab29-f75f-3143-a6a3-5f8944f41efd",
                                "text": "A military draft derives from Congress’s power to raise armies; federal jury duty effectuates the Sixth Amendment right to a jury trial."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b714627-27f8-4cbd-a389-439be7e85c8f",
                        "source_entry_id": "d43deaae-f730-31f3-b887-5523be03f625",
                        "source_sense_id": "a2e5ab29-f75f-3143-a6a3-5f8944f41efd",
                        "source_sense_description": "to be the cause of",
                        "target_lang_word": "πραγματοποιώ",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "πραγματοποιώ",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "e3b5bc81-c7ca-3786-ae0f-19f65ca24d6f",
                                        "entry_id": "dffd2b61-82c4-3360-9aef-57049e4f9cdd",
                                        "glosses": [
                                            "κάνω κάτι πραγματικό, το υλοποιώ, μεταβάλλω τα λόγια σε πράξεις"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe9583d0-ca69-4f09-9496-36394676cdc0",
                                                "sense_id": "e3b5bc81-c7ca-3786-ae0f-19f65ca24d6f",
                                                "text": "Αυτά που λες δεν μπορούν να πραγματοποιηθούν μαγικά, αφού κάθεσαι άπραγος"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe957686-eaac-3349-ba47-61f704ae2902",
                                        "entry_id": "dffd2b61-82c4-3360-9aef-57049e4f9cdd",
                                        "glosses": [
                                            "κατορθώνω κάτι σχετικά δύσκολο που σχεδίαζα εγώ ή άλλος"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb33343e-1c6a-45d6-9842-22f6825a617e",
                                                "sense_id": "fe957686-eaac-3349-ba47-61f704ae2902",
                                                "text": "Ηθελε από παιδί να σπουδάσει Αρχαιολογία και τελικά πραγματοποίησε το όνειρό του στα 50!"
                                            },
                                            {
                                                "example_id": "0987119f-8453-4f96-b7bc-b9fb3c9a31a2",
                                                "sense_id": "fe957686-eaac-3349-ba47-61f704ae2902",
                                                "text": "Η ευχή του πραγματοποιήθηκε χάρη στους..."
                                            },
                                            {
                                                "example_id": "914f152c-2f36-4248-821d-9f11e8939313",
                                                "sense_id": "fe957686-eaac-3349-ba47-61f704ae2902",
                                                "text": "Τελικά πραγματοποίησε την απειλή του! Το' πε και το' κανε"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8eceeed4-d875-3439-8c66-bb596dfaba91",
                                        "entry_id": "dffd2b61-82c4-3360-9aef-57049e4f9cdd",
                                        "glosses": [
                                            "διεκπεραιώνεται κάτι, όχι απαραιτήτως σημαντικό, υλοποιείται, λαμβάνει χώρα"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b162c8c-70d8-491a-9f02-8d4823e72ede",
                                                "sense_id": "8eceeed4-d875-3439-8c66-bb596dfaba91",
                                                "text": "Η εκδήλωση πραγματοποιήθηκε στο Ζάππειο"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
