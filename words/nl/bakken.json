                {
                    "sense_id": "1e7d27bf-95b2-33b4-aa3f-cbace7c710b9",
                    "sense_definition": "Niet slagen voor een examen of toets.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "education_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft niet genoeg gestudeerd en is voor het examen <w>gebakt</w>.",
                            "target_lang_translations": {
                                "en": "He didn't study enough and <w>failed</w> the exam.",
                                "ru": "Он недостаточно учился и <w>провалился</w> на экзамене.",
                                "pl": "Nie uczył się wystarczająco dużo i <w>oblał</w> egzamin.",
                                "de": "Er hat nicht genug gelernt und ist durch die Prüfung <w>durchgefallen</w>.",
                                "fr": "Il n'a pas assez étudié et a <w>raté</w> son examen.",
                                "it": "Non ha studiato abbastanza ed è <w>stato bocciato</w> all'esame.",
                                "cs": "Učil se málo a u zkoušky <w>rupnul</w>.",
                                "tr": "Yeterince çalışmadı ve sınavdan <w>kaldı</w>.",
                                "es": "No estudió lo suficiente y ha <w>suspendido</w> el examen."
                            }
                        },
                        {
                            "text": "Als je nu niet begint met leren, zul je zeker <w>bakken</w>.",
                            "target_lang_translations": {
                                "en": "If you don't start studying now, you will definitely <w>fail</w>.",
                                "ru": "Если ты сейчас не начнешь учиться, ты точно <w>завалишь</w> экзамен.",
                                "pl": "Jeśli nie zaczniesz się teraz uczyć, na pewno <w>zawalisz</w>.",
                                "de": "Wenn du jetzt nicht anfängst zu lernen, wirst du bestimmt <w>durchfallen</w>.",
                                "fr": "Si tu ne commences pas à étudier maintenant, tu vas sûrement <w>échouer</w>.",
                                "it": "Se non inizi a studiare adesso, verrai sicuramente <w>bocciato</w>.",
                                "cs": "Pokud se teď nezačneš učit, určitě <w>vyletíš</w>.",
                                "tr": "Şimdi çalışmaya başlamazsan, kesinlikle <w>çakacaksın</w>.",
                                "es": "Si no empiezas a estudiar ahora, seguro que vas a <w>suspender</w>."
                            }
                        }
