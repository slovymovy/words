                ],
                "senses": [
                    {
                        "sense_id": "7b1b7962-972a-3827-97a0-ed4f2b587c95",
                        "entry_id": "3f4ae804-bb18-3522-b271-aee2ec34aef5",
                        "glosses": [
                            "Se dit d'un produit qui augmente l’activité de quelque chose."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "6ca6d288-088d-4f34-852a-6a855338c15e",
                                "sense_id": "7b1b7962-972a-3827-97a0-ed4f2b587c95",
                                "text": "Un activateur de compost n’est pas indispensable si le dosage est bien fait."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ef0bbf4-d3ef-3e7f-9521-c9b4df279eb2",
                        "entry_id": "3f4ae804-bb18-3522-b271-aee2ec34aef5",
                        "glosses": [
                            "Substance qui, mélangée dans une proportion infime à un corps photoconducteur, augmente son activité et, souvent, modifie ses caractéristiques spectrales."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "902325dc-535f-312e-acf1-45ee4f297b39",
                        "entry_id": "3f4ae804-bb18-3522-b271-aee2ec34aef5",
                        "glosses": [
                            "Protéine codée par un gène régulateur, qui se fixe sur un site d'initiation de la transcription d'un autre gène et stimule cette transcription."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63f09026-f25e-4399-85ef-17a249faed8f",
                        "source_entry_id": "3f4ae804-bb18-3522-b271-aee2ec34aef5",
                        "source_sense_description": "1",
                        "target_lang_word": "Aktivator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktivator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12476d70-c1de-3b73-86a2-140eaa64bae5",
                                        "entry_id": "4edb6600-380e-3084-a3f8-97373eb10ff9",
                                        "glosses": [
                                            "etwas/jemand, das/der etwas fördert, anregt, vorantreibt, vorwärtsbringt"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "906787c0-99b8-34ab-bb77-e0f4daa745ca",
                                        "entry_id": "4edb6600-380e-3084-a3f8-97373eb10ff9",
                                        "glosses": [
                                            "Faktor, der chemische Reaktionen oder biologische Prozesse aktiviert oder beschleunigt, zum Beispiel Substanz, die die Aktivität von Enzymen steigert und deren katalytische Reaktionen beschleunigt"
                                        ],
                                        "tags": [
                                            "Biochemie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c62b80d-1c41-4ce6-9d9e-915b2b66be8e",
                                                "sense_id": "906787c0-99b8-34ab-bb77-e0f4daa745ca",
                                                "text": "„Dieser Aktivator wandelt Plasminogen in Plasmin um. Während die Aktivatorbildung mit Streptokinase streng spezifisch ist für Humanplasminogen, wirkt der Aktivator unspezifisch auf Plasminogen verschiedener Herkunft […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a6b3065b-69ea-3a53-88b6-4eec3a4f166b",
                                        "entry_id": "4edb6600-380e-3084-a3f8-97373eb10ff9",
                                        "glosses": [
                                            "Stoff (Regulator-Protein), der die Aktivität von Genen aktiviert, indem er an spezifische DNA-Stellen bindet und die Transkription fördert"
                                        ],
                                        "tags": [
                                            "Genetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77e7b21f-5fd8-4b52-8fee-a4548b97bdd1",
                                                "sense_id": "a6b3065b-69ea-3a53-88b6-4eec3a4f166b",
                                                "text": "„Ein Aktivator bindet an Stellen vor einem Gens und fördert die Anlagerung der RNA-Polymerase.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7cdf1070-4650-3d8f-a51f-d35a9292e710",
                                        "entry_id": "4edb6600-380e-3084-a3f8-97373eb10ff9",
                                        "glosses": [
                                            "herausnehmbare Zahnspange, die sowohl Ober- als auch Unterkiefer in einem Stück abdeckt"
                                        ],
                                        "tags": [
                                            "Kieferorthopädie"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
