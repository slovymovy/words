                                    {
                                        "sense_id": "6b6134c0-872d-399a-8908-cc8cbcf4d4e9",
                                        "entry_id": "69537467-e687-3ddb-b472-fb2008c72eb6",
                                        "glosses": [
                                            "verantwortbar, vermittelbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e77ba727-daf4-4133-ba01-6a271e580aa6",
                                                "sense_id": "6b6134c0-872d-399a-8908-cc8cbcf4d4e9",
                                                "text": "„Der neue Liberalismus jedenfalls, der heute vertretbar ist, und den ich mit meinen Freunden vertrete, fordert einen starken Staat, einen Staat oberhalb der Wirtschaft, oberhalb der Interessenten, da, wo er hingehört. Und mit diesem Bekenntnis zum starken Staat im Interesse liberaler Wirtschaftspolitik und zu liberaler Wirtschaftspolitik im Interesse eines starken Staates – denn das bedingt sich gegenseitig, mit diesem Bekenntnis lassen Sie mich schließen.“"
                                            },
                                            {
                                                "example_id": "3a3a188f-6e93-4e96-93e0-cc0ea8e48913",
                                                "sense_id": "6b6134c0-872d-399a-8908-cc8cbcf4d4e9",
                                                "text": "„Die Gefangenen setzen sich untereinander auseinander, zumindest in dem Rahmen, der vertretbar ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
