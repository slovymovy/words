                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41e1844e-75bd-4389-aff4-4a8c290d2208",
                                "sense_id": "46390389-bb4d-3c15-bb7c-c6b4403f4705",
                                "text": "„Die [Vernetzungsstelle Schulverpflegung Ostbayern] unterstützt Kindertagesstätten und Schulen, die einheitliche Qualitätsstandards beim Pausenverkauf oder dem Mittagessen einführen möchten.“"
                            },
                            {
                                "example_id": "4c699ed4-fe13-4925-9c6e-754011a3b765",
                                "sense_id": "46390389-bb4d-3c15-bb7c-c6b4403f4705",
                                "text": "„‚Das sind 20 Prozent aller Schulen, die einen Pausenverkauf haben‘, sagt Projektleiterin Walpurga Weiß.“"
                            },
                            {
                                "example_id": "cc95b174-a10f-4bc0-bdcc-2db4eed1c8af",
                                "sense_id": "46390389-bb4d-3c15-bb7c-c6b4403f4705",
                                "text": "„Schon 2007 versuchte eine Klasse, einen Pausenverkauf zu realisieren.“"
                            }
                        ],
