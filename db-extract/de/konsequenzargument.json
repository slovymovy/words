                ],
                "senses": [
                    {
                        "sense_id": "44bb1f8d-7504-3459-8693-cc0cf98c198c",
                        "entry_id": "a4191110-d6fa-3340-8253-6caf71ce2296",
                        "glosses": [
                            "inkompatibilistisches Argument, das aus der determinierten Vergangenheit und deren, ebenfalls determinierten, Folgen sowie der menschlichen Machtlosigkeit, die Naturgesetze zu ändern, schließt, dass es keinen freien Willen gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88325ea5-5a7c-4903-9111-667db5e9fa07",
                                "sense_id": "44bb1f8d-7504-3459-8693-cc0cf98c198c",
                                "text": "„In der heutigen Freiheitsdebatte spielt das sogenannte Konsequenzargument, mit dem die Unvereinbarkeit von Freiheit und Determinismus nachgewiesen werden soll, eine zentrale Rolle.“"
                            },
                            {
                                "example_id": "82e75fbe-b655-475d-ad1b-b92401fdff63",
                                "sense_id": "44bb1f8d-7504-3459-8693-cc0cf98c198c",
                                "text": "„Um die Unvereinbarkeit von Freiheit und Determinismus deutlich sichtbar zu machen, haben Inkompatibilisten das sogenannte Konsequenzargument ersonnen.“"
                            },
                            {
                                "example_id": "ee725d80-129a-4506-b391-327ca16dd6a3",
                                "sense_id": "44bb1f8d-7504-3459-8693-cc0cf98c198c",
                                "text": "„Dass dies keine leichte Aufgabe ist, wird besonders durch das vor allem mit Peter van Inwangen assoziierte Konsequenzargument illustriert.“"
                            },
                            {
                                "example_id": "c1d1bc23-faf2-4665-9b15-b5b1ff831cd3",
                                "sense_id": "44bb1f8d-7504-3459-8693-cc0cf98c198c",
                                "text": "„Sie müssen nun - in Reaktion auf die kompatibilistische Erwiderung auf das Konsequenz-Argument - zeigen, daß es unplausibel ist, ‚x hätte anders handeln können‘ konditional zu lesen.“"
                            },
                            {
                                "example_id": "13613803-96e3-459f-a98f-7c23a830714c",
                                "sense_id": "44bb1f8d-7504-3459-8693-cc0cf98c198c",
                                "text": "„Das Konsequenzargument ist ein Argument für den Inkompatibilismus …“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
