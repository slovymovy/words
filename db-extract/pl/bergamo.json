                "senses": [
                    {
                        "sense_id": "d97deb2f-f9e6-3289-8a8c-6f912a7096e9",
                        "entry_id": "40f471c2-f8c1-350c-8857-a7777d17425d",
                        "glosses": [
                            "miasto i gmina we Włoszech, w Lombardii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6d3ca47-5877-4f83-9e5a-cae16d8260d3",
                                "sense_id": "d97deb2f-f9e6-3289-8a8c-6f912a7096e9",
                                "text": "Przenieśmy się teraz […] w rejon włoskiego miasta Bergamo w północnej Lombardii, słynącego jako ojczyzna technologii wielkopiecowej. W rejon Bergamo, gdzie w XVI wieku narodziły się nie tylko wielkie piece, ale najsławniejsza z masek komedii dell'arte, arlekin […]"
                            },
                            {
                                "example_id": "6aecf93c-d79b-4468-bd02-54c4f336465d",
                                "sense_id": "d97deb2f-f9e6-3289-8a8c-6f912a7096e9",
                                "text": "W 463 roku z rozkazu Egidiusza Alanowie najechali na Italię. Zostali pobici w bitwie pod Bergamo i musieli się wycofać"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
