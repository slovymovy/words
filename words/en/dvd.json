                    "frequency": "Middle",
                    "semantic_group_id": "media storage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to watch a <w>DVD</w> because the internet connection was too slow for streaming.",
                            "target_lang_translations": {
                                "ru": "Я решил посмотреть <w>DVD</w>, потому что интернет-соединение было слишком медленным для стриминга."
                            }
                        },
                        {
                            "text": "She has a large <w>DVD</w> collection of classic movies from the nineties.",
                            "target_lang_translations": {
                                "ru": "У неё большая коллекция <w>DVD-дисков</w> с классическими фильмами девяностых."
                            }
                        }
                    ],
                    "synonyms": [
                        "digital versatile disc",
                        "digital video disc"
