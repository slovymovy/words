                "senses": [
                    {
                        "sense_id": "430abdd1-a305-3067-81a7-32046d2b8f5f",
                        "entry_id": "7fa67684-ab79-3999-af40-1bf787276033",
                        "glosses": [
                            "Prozess der Nahrungsaufnahme mit der Umwandlung von Nährstoffen in körpereigene Stoffe, die der Organismus zum Wachsen benötigt"
                        ],
                        "tags": [
                            "meist Singular"
                        ],
