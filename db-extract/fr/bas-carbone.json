                "senses": [
                    {
                        "sense_id": "36c23c56-451e-340c-aede-9a5f508d8990",
                        "entry_id": "5a4d8151-49e4-3ab2-8481-b5061c4fc6de",
                        "glosses": [
                            "Qualifie une technologie, un produit ou une activité dont les émissions de dioxyde de carbone, et par extension de gaz à effet de serre, sont relativement faibles par rapport à des solutions de référence."
                        ],
                        "tags": [
                            "Sciences de l’environnement",
                            "Industrie de l’énergie",
                            "Politiques publiques"
                        ],
                        "examples": [
                            {
                                "example_id": "9ad78630-1951-41cf-9874-ce93e8a6419c",
                                "sense_id": "36c23c56-451e-340c-aede-9a5f508d8990",
                                "text": "\"Toutes les branches du groupe commencent à s'agréger à Ciry-Salsogne\", les innovations étant ensuite appliquées sur des chantiers comme celui de la mise à 2x2 voies de la Route Centre-Europe Atlantique (RCEA, future A79), ou celui du RER E Eole, à Paris : sur ce dernier projet, des variantes techniques bas-carbone sont utilisées, comme le remplacement du béton par une grave optimisée avec un liant hydraulique bas-carbone, ou encore la fabrication de cette grave en fonds de puits, une première technique."
                            },
                            {
                                "example_id": "92d2605a-66d5-4739-ab9f-0b51b65eb8b8",
                                "sense_id": "36c23c56-451e-340c-aede-9a5f508d8990",
                                "text": "La région Normandie lance un programme baptisé « Tarif bas-carbone » afin d’inciter les touristes à utiliser les moyens de transport les moins polluants."
                            }
                        ]
                    }
