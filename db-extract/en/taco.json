            {
                "entry_id": "dbf1a3eb-71f3-315a-9066-2f80d7a89593",
                "word": "TACO",
                "pos": "phrase",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "de1fe983-34db-3454-8da2-c6a70513f840",
                        "entry_id": "dbf1a3eb-71f3-315a-9066-2f80d7a89593",
                        "glosses": [
                            "Acronym of Trump always chickens out."
                        ],
                        "tags": [
                            "US",
                            "abbreviation",
                            "acronym",
                            "alt-of",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "748bd2a0-88e0-4c27-94c8-ab5cfc0a254f",
                                "sense_id": "de1fe983-34db-3454-8da2-c6a70513f840",
                                "text": "This is the TACO theory: Trump Always Chickens Out,\" Armstrong wrote on May 2."
                            },
                            {
                                "example_id": "411339ba-c4db-42e3-9f81-f8b648995beb",
                                "sense_id": "de1fe983-34db-3454-8da2-c6a70513f840",
                                "text": "The “TACO” trades, first coined by the Financial Times, are one of the ways Wall Street has managed to profit from the chaos of the Trump administration."
                            },
                            {
                                "example_id": "7da09955-d40a-46da-a8e9-02a59bded496",
                                "sense_id": "de1fe983-34db-3454-8da2-c6a70513f840",
                                "text": "This time, Trump appeared to relish declaring that there would not be another TACO moment, writing on social media last night, “IT’S MIDNIGHT!!! BILLIONS OF DOLLARS IN TARIFFS ARE NOW FLOWING INTO THE UNITED STATES OF AMERICA!”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
