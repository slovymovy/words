                ],
                "translations": [
                    {
                        "translation_id": "37086fcc-6c8d-4a7e-973d-f5afb5e13eef",
                        "source_entry_id": "fd6620ee-86a3-3fb5-b386-5ed23fe56a85",
                        "source_sense_id": "5926939e-1d1f-3405-b75e-e47ff409a949",
                        "target_lang_word": "forbid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forbid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3648a667-a757-3653-be92-b9f934314aec",
                                        "entry_id": "5b74d8c2-bf7d-304a-86ae-f6135e6bc565",
                                        "glosses": [
                                            "To disallow; to proscribe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b32e47fd-8bf1-4e15-91af-71a87278f472",
                                                "sense_id": "3648a667-a757-3653-be92-b9f934314aec",
                                                "text": "Smoking in the restaurant is forbidden."
                                            },
                                            {
                                                "example_id": "f6aee8ea-a590-49ef-80a7-48fe8bb1d55e",
                                                "sense_id": "3648a667-a757-3653-be92-b9f934314aec",
                                                "text": "[…] the Mole recollected that animal-etiquette forbade any sort of comment on the sudden disappearance of one's friends at any moment, for any reason or no reason whatever."
                                            },
                                            {
                                                "example_id": "6d6fd9fe-3ef4-460b-b8ea-c8887e205d0e",
                                                "sense_id": "3648a667-a757-3653-be92-b9f934314aec",
                                                "text": "Solon also forbade the export of corn and other agricultural products, with the single exception of olive oil, of which Athens had a surplus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48d68804-8100-3828-bb8a-a137a0f11201",
                                        "entry_id": "5b74d8c2-bf7d-304a-86ae-f6135e6bc565",
                                        "glosses": [
                                            "To deny, exclude from, or warn off, by express command."
                                        ],
                                        "tags": [
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3da4ac2d-5dcc-4adf-8ea6-d86a935ad14c",
                                                "sense_id": "48d68804-8100-3828-bb8a-a137a0f11201",
                                                "text": "Have I not forbid her my house?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1401b0e-8883-3097-87ff-5f7966d2332e",
                                        "entry_id": "5b74d8c2-bf7d-304a-86ae-f6135e6bc565",
                                        "glosses": [
                                            "To oppose, hinder, or prevent, as if by an effectual command."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25cc347a-d2a4-419b-a04e-5d3281075242",
                                                "sense_id": "b1401b0e-8883-3097-87ff-5f7966d2332e",
                                                "text": "An impassable river forbids the approach of the army."
                                            },
                                            {
                                                "example_id": "dc600537-79b3-498b-b01b-ce2dd748f0a6",
                                                "sense_id": "b1401b0e-8883-3097-87ff-5f7966d2332e",
                                                "text": "a blaze of glory that forbids the sight"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26a89df8-1dfa-3e7d-b6a0-af75f7c06ed3",
                                        "entry_id": "5b74d8c2-bf7d-304a-86ae-f6135e6bc565",
                                        "glosses": [
                                            "To accurse; to blast."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af579f2c-9122-4f5d-8ebc-bee164424918",
                                                "sense_id": "26a89df8-1dfa-3e7d-b6a0-af75f7c06ed3",
                                                "text": "He shall live a man forbid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3921ccde-d257-3121-ad03-00c786c7c933",
                                        "entry_id": "5b74d8c2-bf7d-304a-86ae-f6135e6bc565",
                                        "glosses": [
                                            "To defy; to challenge."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46e100b6-fe20-4353-b292-2cbc5df0dd4d",
                                                "sense_id": "3921ccde-d257-3121-ad03-00c786c7c933",
                                                "text": "What part of \"no\" do you forbid to understand?"
                                            },
                                            {
                                                "example_id": "47ea8b64-e9f8-481e-923e-0a27a4bea826",
                                                "sense_id": "3921ccde-d257-3121-ad03-00c786c7c933",
                                                "text": "So there is a resemblance between the partie that here gives licence to come to the tree of life, and the other that forbid to come to it. The one threatned with a sword; the other promiseth to the persons that keep the condition here expressed"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57ab5282-3799-460f-8a99-77724c46658e",
                        "source_entry_id": "fd6620ee-86a3-3fb5-b386-5ed23fe56a85",
                        "source_sense_id": "5926939e-1d1f-3405-b75e-e47ff409a949",
                        "target_lang_word": "prohibit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prohibit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91fd2aa4-66e9-312c-9fe0-8efadf7dfab7",
                                        "entry_id": "eb92be49-5074-3a0a-a785-67c1cc12ac33",
                                        "glosses": [
                                            "To forbid, disallow, or proscribe officially; to make illegal or illicit."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8c9777f-f4a2-427f-b40c-6865a695ae19",
                                                "sense_id": "91fd2aa4-66e9-312c-9fe0-8efadf7dfab7",
                                                "text": "The restaurant prohibits smoking on the patio."
                                            },
                                            {
                                                "example_id": "5defa098-d84f-47ad-86db-57ff218ee15d",
                                                "sense_id": "91fd2aa4-66e9-312c-9fe0-8efadf7dfab7",
                                                "text": "I was prohibited to come."
                                            },
                                            {
                                                "example_id": "e026d349-b69a-45e5-8088-3c3f83442ab1",
                                                "sense_id": "91fd2aa4-66e9-312c-9fe0-8efadf7dfab7",
                                                "text": "Crossing the border without permission is prohibited."
                                            },
                                            {
                                                "example_id": "3286e29c-3e11-4152-afaa-b7d3c5d39fd8",
                                                "sense_id": "91fd2aa4-66e9-312c-9fe0-8efadf7dfab7",
                                                "text": "In his submission to the UN, [Christof] Heyns points to the experience of drones. Unmanned aerial vehicles were intended initially only for surveillance, and their use for offensive purposes was prohibited, yet once strategists realised their perceived advantages as a means of carrying out targeted killings, all objections were swept out of the way."
                                            },
                                            {
                                                "example_id": "7babf8d4-e32b-440b-adb8-36dcc0375ade",
                                                "sense_id": "91fd2aa4-66e9-312c-9fe0-8efadf7dfab7",
                                                "text": "Like the previous rules, the new guidance doesn’t prohibit membership in an extremist organization, but officials said it makes it very difficult to participate. […] For years, the Defense Department relied on a nebulous definition of extremist activity that listed it among a wide array of prohibited behavior. […] “It’s threading a very fine needle when we’re engaging in prohibiting conduct that may be protected by the First Amendment,” said one official. “There’s always going to be this balancing that goes on.”"
                                            },
                                            {
                                                "example_id": "7ae9535b-7ae7-48c1-8e6b-f9d750541d5c",
                                                "sense_id": "91fd2aa4-66e9-312c-9fe0-8efadf7dfab7",
                                                "text": "The Foreign Assistance Act bars assistance to any country that “prohibits or otherwise restricts, directly or indirectly, the transport or delivery of United States humanitarian assistance.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
