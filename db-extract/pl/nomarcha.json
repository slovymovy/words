                "senses": [
                    {
                        "sense_id": "a932b6b0-2a05-38d5-97e4-8223ca9e5762",
                        "entry_id": "2d735691-7e47-367d-b640-55402bd92f6c",
                        "glosses": [
                            "zarządzający nomem w starożytnym Egipcie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "665a351b-7926-484b-a70e-a993465fb8ca",
                                "sense_id": "a932b6b0-2a05-38d5-97e4-8223ca9e5762",
                                "text": "Na tę wieść nomarchowie, szlachta, wojsko, lud i cudzoziemcy szaleli z radości, ale święty stan kapłański tym gorliwiej obchodził żałobę po zmarłym faraonie"
                            },
                            {
                                "example_id": "317e6cd4-da8f-46b6-8f54-67f7e0994408",
                                "sense_id": "a932b6b0-2a05-38d5-97e4-8223ca9e5762",
                                "text": "Stojący na czele nomów nomarchowie uniezależniali się od faraonów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
