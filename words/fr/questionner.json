    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b843cd0-c3d2-33d0-86f6-58e124b6f084",
                    "sense_definition": "Poser des questions à quelqu'un afin d'obtenir des informations ou des éclaircissements.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interroger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a décidé de <w>questionner</w> le témoin pour obtenir plus de précisions sur les faits."
                        },
                        {
                            "text": "Le professeur <w>questionne</w> les élèves pour vérifier s'ils ont bien compris la leçon."
                        }
                    ],
                    "synonyms": [
                        "interroger",
                        "sonder"
                    ],
                    "antonyms": [
                        "répondre"
                    ],
                    "common_phrases": [
                        "questionner un témoin",
                        "questionner quelqu'un"
                    ]
                },
                {
                    "sense_id": "4724238e-fbe5-3b52-8be8-1fd5f6432f08",
                    "sense_definition": "Examiner de manière critique, mettre en doute la validité ou la pertinence de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "douter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau livre cherche à <w>questionner</w> la légitimité de nos modèles économiques traditionnels."
                        },
                        {
                            "text": "Les journalistes <w>questionnent</w> les motivations réelles de cette réforme controversée."
                        }
                    ],
                    "synonyms": [
                        "contester"
                    ],
                    "antonyms": [
                        "approuver",
                        "confirmer"
                    ],
                    "common_phrases": [
                        "questionner la légitimité",
                        "questionner le bien-fondé"
                    ]
                },
                {
                    "sense_id": "2aa49eda-1cb1-363d-8406-316d180b7858",
                    "sense_definition": "Poser sans cesse des questions insistantes ou indiscrètes de façon habituelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interroger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet enfant particulièrement curieux ne cesse de <w>questionner</w> tous les adultes de la maison."
                        },
                        {
                            "text": "Arrête de me <w>questionner</w> ainsi avec insistance, je ne te dirai rien de plus."
                        }
                    ],
                    "synonyms": [
                        "harceler",
                        "inquisitionner"
                    ],
                    "common_phrases": [
                        "cesser de questionner"
                    ]
                },
                {
                    "sense_id": "3be3d410-c77b-304a-9f21-3104f48075a8",
                    "sense_definition": "Soumettre un accusé ou un prisonnier à la torture pour lui arracher des aveux.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "torture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au Moyen Âge, les juges faisaient <w>questionner</w> les captifs soupçonnés d'hérésie."
                        },
                        {
                            "text": "Le bourreau s'apprêtait à <w>questionner</w> le suspect dans les profondeurs du château."
                        }
                    ],
                    "synonyms": [
