                "translations": [
                    {
                        "translation_id": "a012ae20-57b0-4b05-959a-131090e00729",
                        "source_entry_id": "e1ac8070-55c8-3139-b291-4534b42b63d3",
                        "source_sense_id": "ccf69f6c-e98f-3ee1-98de-16245ff1ef86",
                        "source_sense_description": "Mittel zur Empfängnisverhütung",
                        "target_lang_word": "contraceptive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contraceptive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0d9ee3b-73d9-32bf-b3a8-abca8be6ad95",
                                        "entry_id": "8fa73c34-a7c5-3396-9b76-48788176867f",
                                        "glosses": [
                                            "That acts to prevent conception as a result of sexual intercourse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e69667f7-ae26-4ba6-99cd-c7c386d8c7c5",
                                                "sense_id": "c0d9ee3b-73d9-32bf-b3a8-abca8be6ad95",
                                                "text": "She was careful to take her contraceptive pill at the same time every day."
                                            },
                                            {
                                                "example_id": "083fefe5-0d94-4696-83ba-efedd4881e8f",
                                                "sense_id": "c0d9ee3b-73d9-32bf-b3a8-abca8be6ad95",
                                                "text": "This has led to the selection of 4-guanidinobenzoates with either acetamenophen or ethylparaben as the phenol moiety for clinical evaluation, because they are orders of magnitude more contraceptive than nonoxynol-9 and less irritating to the vagina."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "contraceptive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09391c8e-2534-3849-a98a-ba8eb10284ca",
                                        "entry_id": "93c952ae-b64c-39e0-b7dc-bbae697b7237",
                                        "glosses": [
                                            "A mechanism or means by which conception as a result of sexual intercourse can be prevented or made less likely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b2d8f07-d55a-4efe-90b8-a5dcef418286",
                                                "sense_id": "09391c8e-2534-3849-a98a-ba8eb10284ca",
                                                "text": "Putting a pig's bladder over one's penis before intercourse is not a good contraceptive."
                                            },
                                            {
                                                "example_id": "4941f8e2-583c-4445-86f0-118c0205f9d7",
                                                "sense_id": "09391c8e-2534-3849-a98a-ba8eb10284ca",
                                                "text": "The document covers the following family planning methods: combined oral contraceptives (COCs), combined injectable contraceptives (CICs), progestogen-only pills (POPs), depot medroxyprogesterone acetate (DMPA), norethisterone enantate (NET-EN), levonorgestrel implants, emergency contraceptive pills (ECPs), copper-bearing interuterine devices, levonorgestrel-releasing interuterine devices (LNG IUDs), fertility awareness-based methods, and sterilization."
                                            },
                                            {
                                                "example_id": "a1a73732-6928-46f2-914e-3fcb0417894e",
                                                "sense_id": "09391c8e-2534-3849-a98a-ba8eb10284ca",
                                                "text": "The US Food and Drug Administration has approved the oral contraceptive Opill for over-the-counter use, making it the first nonprescription birth control pill in the United States, but it will be months before it’s available. […] Amies Oelschlager said in a statement that oral contraceptives that contain estrogen may cause side effects such as headaches, nausea, and breast tenderness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b5ad5dd-b375-4012-bb7e-c54ff20c30b1",
                        "source_entry_id": "e1ac8070-55c8-3139-b291-4534b42b63d3",
                        "source_sense_id": "ccf69f6c-e98f-3ee1-98de-16245ff1ef86",
