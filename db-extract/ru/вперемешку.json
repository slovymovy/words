                    {
                        "translation_id": "906ac18e-43ad-4b00-9251-1d4f724c4e89",
                        "source_entry_id": "7062ad06-5138-3e3a-90f2-d94cbbd347f5",
                        "source_sense_description": "беспорядочно перемешиваясь, смешиваясь",
