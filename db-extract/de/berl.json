                "senses": [
                    {
                        "sense_id": "f9940c79-cde2-3095-8950-0087a077a457",
                        "entry_id": "a787b3c2-3aa0-3d87-9915-c729868fa506",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc17933-ba42-441a-b0cc-626eae853398",
                                "sense_id": "f9940c79-cde2-3095-8950-0087a077a457",
                                "text": "Der Berl trägt nie die Pullover, die die Berl ihm strickt."
                            },
                            {
                                "example_id": "94647fe1-8be9-49ad-bb46-6857fb349729",
                                "sense_id": "f9940c79-cde2-3095-8950-0087a077a457",
                                "text": "Frau Berl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c262f519-2a0e-4166-84e2-f897b809919d",
                                "sense_id": "f9940c79-cde2-3095-8950-0087a077a457",
                                "text": "Herr Berl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "398a88c3-201e-4488-866c-55066455f08a",
                                "sense_id": "f9940c79-cde2-3095-8950-0087a077a457",
                                "text": "Die Berls fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "d66dab5a-832b-4b1b-9347-6d0718418cb3",
                                "sense_id": "f9940c79-cde2-3095-8950-0087a077a457",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Berl kommt, geht der Herr Berl.“"
                            },
                            {
                                "example_id": "bafed223-dddc-4d0b-bf0a-a6f518a138a7",
                                "sense_id": "f9940c79-cde2-3095-8950-0087a077a457",
                                "text": "Berl kommt und geht."
                            },
                            {
                                "example_id": "402960b2-1b7c-4985-ae46-c624d60fcb3d",
                                "sense_id": "f9940c79-cde2-3095-8950-0087a077a457",
                                "text": "Berls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
