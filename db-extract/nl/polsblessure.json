                        "examples": [
                            {
                                "example_id": "79370fd4-0082-42a3-9b25-7fc11f846b0d",
                                "sense_id": "8cf5322d-ba16-3d40-a0ba-49f5da976ccd",
                                "text": "Luiten, die dit seizoen lang aan de kant stond met een polsblessure en eerder vreesde dit jaar niet meer in actie te kunnen komen, staat op de 57ste plaats."
                            },
                            {
                                "example_id": "d74b04c5-8d13-4d78-b783-408077edcd6c",
                                "sense_id": "8cf5322d-ba16-3d40-a0ba-49f5da976ccd",
                                "text": "Donderdag was Van der Poel, die vanwege een polsblessure even niet mag mountainbiken, ook al tweede geworden in de 4,5 kilometer lange proloog van de Franse etappekoers. Een dag later verraste de renner van het Belgische Corendon-Circus het peloton na 176 kilometer op het laatste stuk naar de finish in Gorron."
                            }
                        ]
