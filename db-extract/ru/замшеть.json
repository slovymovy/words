                    },
                    {
                        "form_id": "b820dd5f-df3b-4f4c-8ff7-2fa88239bd83",
                        "entry_id": "a1aed100-5a70-392a-818f-2ecdbde8ae2b",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "замше́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "571f4554-f346-370a-bc19-2341f7c905a4",
                        "entry_id": "a1aed100-5a70-392a-818f-2ecdbde8ae2b",
                        "glosses": [
                            "покрыться мхом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6b054e9-6c10-4b1c-a3d5-4e797104617d",
                                "sense_id": "571f4554-f346-370a-bc19-2341f7c905a4",
                                "text": "Серые брёвна частокола понизу обметала зелёная гниль, а валунные насыпи замшели."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34a88ef6-4949-4187-9c71-7b14e7be7d13",
                        "source_entry_id": "a1aed100-5a70-392a-818f-2ecdbde8ae2b",
                        "source_sense_id": "571f4554-f346-370a-bc19-2341f7c905a4",
                        "target_lang_word": "become",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "become",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3e7fb86-a143-3ddb-811c-ddc312cfee8a",
                                        "entry_id": "3640dad8-2991-32b9-90d1-596b035ecafd",
                                        "glosses": [
                                            "begin to be; turn into."
                                        ],
                                        "tags": [
                                            "copulative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "314869c6-2fe5-4cdd-98ca-ff5de7fc625c",
                                                "sense_id": "f3e7fb86-a143-3ddb-811c-ddc312cfee8a",
                                                "text": "She became a doctor when she was 25."
                                            },
                                            {
                                                "example_id": "985c6b3e-61d2-4f7f-b547-2cb958d0f303",
                                                "sense_id": "f3e7fb86-a143-3ddb-811c-ddc312cfee8a",
                                                "text": "The weather will become cold after the sun goes down."
                                            },
                                            {
                                                "example_id": "b2f67620-5020-4a11-8755-7aa871233802",
                                                "sense_id": "f3e7fb86-a143-3ddb-811c-ddc312cfee8a",
                                                "text": "The sense ‘state or process of bearing fruit’ has become imposed on fruition as the 20c. proceeded."
                                            },
                                            {
                                                "example_id": "6f764ca4-61ac-41e9-ba0b-fff2523642b7",
                                                "sense_id": "f3e7fb86-a143-3ddb-811c-ddc312cfee8a",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again; for, even after she had conquered her love for the Celebrity, the mortification of having been jilted by him remained."
                                            },
                                            {
                                                "example_id": "29a5d549-faf3-42e9-8277-31187b103c88",
                                                "sense_id": "f3e7fb86-a143-3ddb-811c-ddc312cfee8a",
                                                "text": "Then, as the Sunderland fans' cheers bellowed around the stadium, United's title bid was over when it became apparent City had pinched a last-gasp winner to seal their first title in 44 years."
                                            },
                                            {
                                                "example_id": "bd3fa34e-6bb6-4ee4-9f7f-ce4fc4723dc2",
                                                "sense_id": "f3e7fb86-a143-3ddb-811c-ddc312cfee8a",
                                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close (less than half a meter) above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93bb17ea-7332-30d2-886d-e6f76a0d38bd",
                                        "entry_id": "3640dad8-2991-32b9-90d1-596b035ecafd",
                                        "glosses": [
                                            "To come about; happen; come into being; arise."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6cb824d-f374-43cf-85d3-92093f80d297",
                                                "sense_id": "93bb17ea-7332-30d2-886d-e6f76a0d38bd",
                                                "text": "What became of him after he was let go?"
                                            },
                                            {
                                                "example_id": "30fb657e-3630-47c5-ad71-b0ab88f81353",
                                                "sense_id": "93bb17ea-7332-30d2-886d-e6f76a0d38bd",
                                                "text": "It hath becomen so that many a man had to sterve."
                                            },
                                            {
                                                "example_id": "77241a05-baa0-4710-890a-7c2a088370b7",
                                                "sense_id": "93bb17ea-7332-30d2-886d-e6f76a0d38bd",
                                                "text": "And Time went forth into the worlds to obey the commands of the gods, yet he cast furtive glances at his masters, and the gods distrusted Time because he had known the worlds or ever the gods became."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f616b2d1-bddc-327a-9b49-d43859be2522",
                                        "entry_id": "3640dad8-2991-32b9-90d1-596b035ecafd",
                                        "glosses": [
                                            "To be proper for; to beseem."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4857fad3-ce69-4b7e-b58c-e76131f6d2d0",
                                                "sense_id": "f616b2d1-bddc-327a-9b49-d43859be2522",
                                                "text": "It doesn’t become a true gentleman to speak in such a manner."
                                            },
                                            {
                                                "example_id": "946721b9-452b-43c0-b502-1d803c6bfc0f",
                                                "sense_id": "f616b2d1-bddc-327a-9b49-d43859be2522",
                                                "text": "Ay, lord, she will become thy bed, I warrant,\nAnd bring thee forth brave brood."
                                            },
                                            {
                                                "example_id": "a093163f-e38b-49c0-8d59-0bc13b9593c3",
                                                "sense_id": "f616b2d1-bddc-327a-9b49-d43859be2522",
                                                "text": "1892, Ambrose Bierce, “The Applicant,” in The Collected Works of Ambrose Bierce, Volume II: In the Midst of Life (Tales of Soldiers and Civilians), New York: Gordian Press, 1966,\nHe was hatted, booted, overcoated, and umbrellaed, as became a person who was about to expose himself to the night and the storm on an errand of charity […]"
                                            },
                                            {
                                                "example_id": "c1fcc751-c931-41e8-8aae-77f63800797b",
                                                "sense_id": "f616b2d1-bddc-327a-9b49-d43859be2522",
                                                "text": "His ordination[…]enabled him to be independent of his parents, and to afford a manner of living which became his rank rather than his calling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69b26dc6-a16f-3c95-bfe6-7fb2975b814b",
                                        "entry_id": "3640dad8-2991-32b9-90d1-596b035ecafd",
                                        "glosses": [
                                            "Of an adornment, piece of clothing etc.: to look attractive on (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92b860aa-b644-4735-8f62-0f098f35276b",
                                                "sense_id": "69b26dc6-a16f-3c95-bfe6-7fb2975b814b",
                                                "text": "That dress really becomes you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0622d36-35c6-328c-a27b-a0a3ff1e88e4",
                                        "entry_id": "3640dad8-2991-32b9-90d1-596b035ecafd",
                                        "glosses": [
                                            "To arrive, come (to a place)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
