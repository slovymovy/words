                    {
                        "translation_id": "02c93689-bf8f-4b81-acaf-417b74a428e0",
                        "source_entry_id": "49521c05-1eeb-3212-addb-2cb766926435",
                        "target_lang_word": "вездесущий",
                        "target_lang_code": "ru",
