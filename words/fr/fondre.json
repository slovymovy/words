            "pos": "verb",
            "senses": [
                {
                    "sense_id": "765ebc70-91d4-395c-b04d-c8ff60f313dc",
                    "sense_definition": "Passer ou faire passer de l'état solide à l'état liquide sous l'effet de la chaleur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "changement_d_etat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La neige commence à <w>fondre</w> dès les premiers rayons du soleil printanier."
                        },
                        {
                            "text": "Il faut faire <w>fondre</w> le chocolat doucement au bain-marie."
                        }
                    ],
                    "synonyms": [
                        "liquéfier"
                    ],
                    "antonyms": [
                        "congeler",
                        "solidifier"
                    ],
                    "common_phrases": [
                        "fondre au soleil",
                        "faire fondre le beurre"
                    ]
                },
                {
                    "sense_id": "516de55f-7aec-3a72-b836-e14df40e04a5",
                    "sense_definition": "Diminuer rapidement au point de disparaître, en parlant de réserves, de biens ou de temps.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "diminution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toutes ses économies ont <w>fondu</w> en quelques mois après ces travaux imprévus."
                        },
                        {
                            "text": "Avec la hausse des prix, notre budget alimentaire <w>fond</w> à vue d'œil."
                        }
                    ],
                    "common_phrases": [
                        "fondre comme neige au soleil"
                    ]
                },
                {
                    "sense_id": "2ce743ce-cca8-3375-8d10-af8cf880e737",
                    "sense_definition": "S'attendrir vivement sous l'effet d'une forte émotion, d'un sentiment ou de la tendresse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le regard de ce petit chiot suffit à faire <w>fondre</w> toute la famille."
                        },
                        {
                            "text": "Le vieux grincheux a fini par <w>fondre</w> devant le sourire de sa petite-fille."
                        }
                    ],
                    "common_phrases": [
                        "faire fondre en larmes"
                    ]
                },
                {
                    "sense_id": "592967bb-5b4a-3eb7-b70e-c50fec85b8c5",
                    "sense_definition": "Se mélanger intimement à un environnement au point de ne plus pouvoir être distingué.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "integration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet animal sait parfaitement se <w>fondre</w> dans le décor pour échapper aux prédateurs."
                        },
                        {
                            "text": "Le visiteur timide préférait se <w>fondre</w> dans la masse discrètement."
                        }
                    ],
                    "common_phrases": [
                        "se fondre dans le décor",
                        "se fondre dans la masse"
                    ]
                },
                {
                    "sense_id": "05d2e0a8-d25f-3d81-a5ee-559fbc24ac65",
                    "sense_definition": "Mouler ou fabriquer des objets métalliques en coulant du métal liquéfié.",
