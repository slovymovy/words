                    },
                    {
                        "translation_id": "d84427f0-c3d3-4c3c-b2f4-9944d203aced",
                        "source_entry_id": "82a7b19f-b645-3204-b92f-252965232ee9",
                        "source_sense_id": "fe088e67-9694-33f3-bcef-90a1463c6254",
                        "target_lang_word": "Bogenlampe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bogenlampe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95891d3b-9c10-3c6b-aa6c-031fe9ab2687",
                                        "entry_id": "91e1f407-bfe6-315d-b634-ea69a5dbcb54",
                                        "glosses": [
                                            "Lampe, deren Helligkeit durch einen Lichtbogen erzeugt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f471b3ed-e9e2-4e3c-aa01-d4f502dbcffa",
                                                "sense_id": "95891d3b-9c10-3c6b-aa6c-031fe9ab2687",
                                                "text": "„Draußen leuchtete die Bogenlampe durch das kahle Astwerk eines Baums.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da9dc59f-74f4-32f3-af7b-ec5652b149f2",
                                        "entry_id": "91e1f407-bfe6-315d-b634-ea69a5dbcb54",
                                        "glosses": [
                                            "Schuss oder Wurf, dessen Flugbahn in einem hohen Bogen verläuft und der häufig mit viel Effet ausgeführt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "980e3516-e5d9-4e0a-bf11-7697473cc26c",
                                                "sense_id": "da9dc59f-74f4-32f3-af7b-ec5652b149f2",
                                                "text": "„[…], im Gegenzug brachte Lex den Herbstmeister mit einer Bogenlampe aus rund 25 Metern in Führung.“"
                                            },
                                            {
                                                "example_id": "06a0814f-ebe7-48db-af02-c8fce89d4d45",
                                                "sense_id": "da9dc59f-74f4-32f3-af7b-ec5652b149f2",
                                                "text": "[…] „Nach einer Bogenlampe von Pieringer an die Latte staubte Heuer zur erneuten Führung ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "69897f43-b300-4809-999e-7df8eb9fcf52",
                        "source_entry_id": "82a7b19f-b645-3204-b92f-252965232ee9",
                        "source_sense_id": "fe088e67-9694-33f3-bcef-90a1463c6254",
                        "target_lang_word": "arc lamp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arc lamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31dcad00-fd9e-37c9-ba5e-78f7728b9762",
                                        "entry_id": "b4d7394d-9fde-300f-a926-cb2b67a67834",
                                        "glosses": [
                                            "An electric arc arranged so as to produce useful light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8e3be9c-d82a-453e-9357-4428885450e9",
                                                "sense_id": "31dcad00-fd9e-37c9-ba5e-78f7728b9762",
                                                "text": "This led him to the station; and the square in front of it, vivid with arc-lamps, noisy with the yellow trams that seemed to cross it in all directions, made him laugh aloud with joy."
                                            },
                                            {
                                                "example_id": "ec997117-3abc-4bae-9d74-3ee7317acd7d",
                                                "sense_id": "31dcad00-fd9e-37c9-ba5e-78f7728b9762",
                                                "text": "The vague and careless rain looked like threads of gossamer silver passing across the light of the arc-lamps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6f47ea9-da28-4994-99e9-0fb8e804604a",
                        "source_entry_id": "82a7b19f-b645-3204-b92f-252965232ee9",
                        "source_sense_id": "fe088e67-9694-33f3-bcef-90a1463c6254",
                        "target_lang_word": "arc light",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arc light",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2587a6e5-d9e6-3ea7-8410-20ab2a843ca8",
                                        "entry_id": "40606b77-1cc9-38e3-83bc-f2227e36f8aa",
                                        "glosses": [
                                            "A lamp that produces light by generating an electric arc across an enclosed gas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fc6a830-cc3b-4d15-ae78-1229782afd10",
                                                "sense_id": "2587a6e5-d9e6-3ea7-8410-20ab2a843ca8",
                                                "text": "In 1809 Humphry Davy had made the first arclight by attaching a charcoal rod to each terminal of a Volta battery..."
                                            },
                                            {
                                                "example_id": "7b28e887-55a1-4ec1-baa7-5cd3f1a748e2",
                                                "sense_id": "2587a6e5-d9e6-3ea7-8410-20ab2a843ca8",
                                                "text": "With one, last desperate lurch, the lorry cleared the tracks, disappearing out of the arclights, into the darkness; and then there was silence..."
                                            },
                                            {
                                                "example_id": "0032dc8f-c806-4d8d-8349-7d78768ad5f3",
                                                "sense_id": "2587a6e5-d9e6-3ea7-8410-20ab2a843ca8",
                                                "text": "All five had seen the four wooden targets, thirty feet above their heads, holding the great submarine in place, stark against the glare of the arclight..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
