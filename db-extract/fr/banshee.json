                                    {
                                        "sense_id": "83184d63-2f8c-3569-b124-84956eb27af9",
                                        "entry_id": "423c595b-50dc-34a0-b4a8-759babfe9d35",
                                        "glosses": [
                                            "weiblicher Geist aus der keltischen Sagenwelt, der den Tod eines Familienmitglieds ankündigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b84c97-5c6c-473e-8c61-a1205014d24f",
                                                "sense_id": "83184d63-2f8c-3569-b124-84956eb27af9",
                                                "text": "„Die Banshee ist eine Todesfee, die aus der keltischen Anderswelt entsandt wird, um den Lebenden den nahenden Tod zu verkünden.“"
                                            },
                                            {
                                                "example_id": "e3f3d596-613c-4495-b668-e1b8f81528ab",
                                                "sense_id": "83184d63-2f8c-3569-b124-84956eb27af9",
                                                "text": "„Es ist die Rede von der Banshee, auch bean sí im irischen Gälisch, einer Gestalt der irisch-keltischen Mythologie und Folklore.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f708976-e26c-3a9b-95fe-bc1ecd5e7423",
                                        "entry_id": "423c595b-50dc-34a0-b4a8-759babfe9d35",
                                        "glosses": [
                                            "Im weiteren Sinne auch Todesfee"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
