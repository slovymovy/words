                        ],
                        "form": "more luxurious"
                    },
                    {
                        "form_id": "19f082a7-3c09-4c5a-b7f0-048ed2375896",
                        "entry_id": "8804cba2-1a6b-34c2-bcfa-b09110d528d4",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most luxurious"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b19a9982-9c90-33dd-9714-2444162d500f",
                        "entry_id": "8804cba2-1a6b-34c2-bcfa-b09110d528d4",
                        "glosses": [
                            "Very fine in quality and comfortable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fdcf1b2-da25-463a-a276-b01dae52bf00",
                                "sense_id": "b19a9982-9c90-33dd-9714-2444162d500f",
                                "text": "a luxurious hotel suite"
                            },
                            {
                                "example_id": "847c8598-8ef3-4d6d-9d33-4c42eb69a2f0",
                                "sense_id": "b19a9982-9c90-33dd-9714-2444162d500f",
                                "text": "With her luxurious furnishings and spacious accommodation the Invicta, which is 350-ft. long and has a gross tonnage of 4,178, resembles a small liner."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d740654-464d-31a7-9f1f-05f5771637b2",
                        "entry_id": "8804cba2-1a6b-34c2-bcfa-b09110d528d4",
                        "glosses": [
                            "Enjoying the pleasures of luxury, accustomed to luxury."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3e7e5bb0-0929-4267-8e4a-c6657aa5b12b",
                                "sense_id": "7d740654-464d-31a7-9f1f-05f5771637b2",
                                "text": "Invalids, and luxurious persons, require more artificial arrangements for travelling on the camel."
                            },
                            {
                                "example_id": "0dbd8f66-e9fb-43cc-a550-adfcd08ca313",
                                "sense_id": "7d740654-464d-31a7-9f1f-05f5771637b2",
                                "text": "When one looks at the elegantly dressed people round the gaming table, who perhaps laugh at everything which impresses other people with awe, who scoff at the Church and the Bible, one could scarcely think it possible that these enlightened, pleasure-loving, luxurious men of the world, carry on in secret, cabalistic nonsense, turning over cards, fortune telling, studying the significance of signs and dreams […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c47ecaf7-22a8-4f80-8d02-f4434a4b73ba",
                        "source_entry_id": "8804cba2-1a6b-34c2-bcfa-b09110d528d4",
                        "source_sense_description": "very fine and comfortable",
                        "target_lang_word": "luxueus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luxueus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9eb75917-1faa-345d-a2c3-4714ca95dcb2",
                                        "entry_id": "31cfdc89-1920-339b-84fb-84b354ab68db",
                                        "glosses": [
                                            "zeer comfortabel en duur maar eigenlijk niet noodzakelijk en vaak ook niet zo heel praktisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3409ba7-d540-4de9-bf04-6a8e61427198",
                                                "sense_id": "9eb75917-1faa-345d-a2c3-4714ca95dcb2",
                                                "text": "Hij rijdt in een luxueuze sportauto die blijft steken op een verkeersdrempel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b2c16fc-de2a-4644-903e-011a7d6e3a7b",
                        "source_entry_id": "8804cba2-1a6b-34c2-bcfa-b09110d528d4",
                        "source_sense_description": "very fine and comfortable",
                        "target_lang_word": "luxueux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luxueux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9fbf386-2a81-338d-8fe6-b01c7dc8305a",
                                        "entry_id": "e7591ff1-3f0d-3f95-a0f8-f218224ffbd3",
                                        "glosses": [
                                            "Qui tient du luxe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb346584-bc68-40d4-b5f9-919e3a70c141",
                                                "sense_id": "a9fbf386-2a81-338d-8fe6-b01c7dc8305a",
                                                "text": "Les charpoys les plus communs et les plus durs, ou même un simple paillasson, remplacent les luxueux coussins et les matelas bien rembourrés sur lesquels les Luknois reposent ordinairement."
                                            },
                                            {
                                                "example_id": "ea86c586-6fb9-4c83-8daf-53b2b1e8bdd9",
                                                "sense_id": "a9fbf386-2a81-338d-8fe6-b01c7dc8305a",
                                                "text": "Ses airs penchés, sa ravissante et luxueuse pochette de soie, son bracelet-montre en or, le fard étalé sur ses joues le tenaient quitte de manifester son opinion."
                                            },
                                            {
                                                "example_id": "2ca2b7eb-ea71-4b95-be73-4da5bdcd73f8",
                                                "sense_id": "a9fbf386-2a81-338d-8fe6-b01c7dc8305a",
                                                "text": "Ils s’étaient retrouvés au Flamingo, un des hôtels les plus luxueux de la ville, avec une boîte de nuit au premier étage. Malko décida de remettre les pendules à l’heure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c541fc4-b430-48b2-85f1-292896bd5ba6",
                        "source_entry_id": "8804cba2-1a6b-34c2-bcfa-b09110d528d4",
