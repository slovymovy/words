                        "examples": [
                            {
                                "example_id": "6ed2de77-9a7a-4430-96da-89bfd3217ed4",
                                "sense_id": "1752abc7-7752-3617-afa7-00f534a524ad",
                                "text": "N'y avait-il pas autour d'elle, comme autour de lui, cette même atmosphère de fureur, de galopement, de voyage, cette impression même de départ qui lui donnait ensemble tant de précision, et tant de lointain ?"
                            },
                            {
                                "example_id": "699ca5bc-a480-4146-894f-1a132184c2ff",
                                "sense_id": "1752abc7-7752-3617-afa7-00f534a524ad",
                                "text": "Au galopement impétueux du gentilhomme, un petit garçon, nommé Pierre, s'était élancé curieusement sur le bord de la route."
                            },
                            {
                                "example_id": "3a5acdcd-3ccc-448d-b2aa-33c62ee89aff",
                                "sense_id": "1752abc7-7752-3617-afa7-00f534a524ad",
                                "text": "Ils ne doivent pas nous avoir vus, ils s’éloignent dans une autre direction, répondit le capitaine. Il se trompait, car au même instant un galopement de cheval résonna près d’eux. Un Apache apparut."
                            }
                        ]
                    }
