                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2fb2de5-82b0-4ddd-baa8-22ae40b6f47a",
                                                "sense_id": "2c49f0b7-8b28-371e-b904-046b2f8b4830",
                                                "text": "Sei nicht so grob zu mir!"
                                            },
                                            {
                                                "example_id": "7cb50136-cd6e-4118-9b9f-6d4fd534eb98",
                                                "sense_id": "2c49f0b7-8b28-371e-b904-046b2f8b4830",
                                                "text": "Du bist aber ganz schön grob zu deiner Schwester."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cc22f530-8b66-3806-b339-060aa6766e4a",
                                        "entry_id": "4f4348bc-7537-30e5-8e95-cb1f725e6a62",
