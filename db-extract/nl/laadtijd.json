                "senses": [
                    {
                        "sense_id": "ff4b04f6-7233-3109-be5b-68eb75acd3e4",
                        "entry_id": "8abbbf48-dc92-3205-9372-106b47b19cb1",
                        "glosses": [
                            "de tijd die nodig is om iets te laden, met name de tijd die nodig is om een oplaadbare batterij weer van stroom te voorzien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a212f703-983b-4172-92cd-7baeb9136d7e",
                                "sense_id": "ff4b04f6-7233-3109-be5b-68eb75acd3e4",
                                "text": "Voor een ander probleem, de lange laadtijd van accu's, denkt Wright al een oplossing te hebben gevonden. Het bedrijf wil werken met verwisselbare accupakketten die verpakt worden in dezelfde vrachtcontainers die nu al worden gebruikt."
                            }
                        ]
                    },
                    {
                        "sense_id": "1c444165-5335-34f3-8266-775e95d92106",
                        "entry_id": "8abbbf48-dc92-3205-9372-106b47b19cb1",
                        "glosses": [
                            "de tijd die nodig is om een computer programma in het werkgeheugen van een computer te laden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fbd6b20-b0c1-4e68-b000-ed3b1fe18256",
                                "sense_id": "1c444165-5335-34f3-8266-775e95d92106",
                                "text": "Na het voltooien van een missie keer je niet terug naar het menu waarin je een wereld en nieuwe queeste hoeft te kiezen, maar blijf je op de desbetreffende planeet. Zo worden de laadtijden, die in Destiny ontzettend lang waren, flink ingekort. Voeg daar ook nog aan toe dat de werelden in Destiny 2 een stuk levendiger aanvoelen en de visie die Bungie voor zijn paradepaardje heeft is duidelijk zichtbaar."
                            }
                        ]
                    }
