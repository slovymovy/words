                                "target_senses": [
                                    {
                                        "sense_id": "af341408-cff7-3a8d-80b8-227d9e60e86f",
                                        "entry_id": "89ad77f8-26ed-3f23-a684-ee870d9770f3",
                                        "glosses": [
                                            "The killing of a king."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "regicide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "843c8eef-1c4e-38cd-833a-af8d4ebc4d2a",
                                        "entry_id": "461162eb-c633-3bf5-a41e-4a6399c2d817",
                                        "glosses": [
                                            "One who kills a king."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb32b19a-94dc-4271-bc67-26f460ec9666",
                                                "sense_id": "843c8eef-1c4e-38cd-833a-af8d4ebc4d2a",
                                                "text": "The fact that the Yongle emperor was therefore a usurper, regicide and nepoticide (nephew-killer) made compiling the Veritable Record – or official history – of his reign a most dangerous scholarly post. The official given this ticklish task managed to survive several drafts, finally producing one that pleased his master as it omitted the dead nephew's reign altogether."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
