                "senses": [
                    {
                        "sense_id": "dc336df4-8fed-31ee-bf40-1e1fff48cd25",
                        "entry_id": "a594b770-7a74-31b1-a561-f485b4360cab",
                        "glosses": [
                            "een dunne as die je over je dagelijkse kleren heen draagt om te zorgen dat de kleren niet vuil worden en niet beschadigd worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2f8abe1-544e-4e03-8bab-1a7cc6f4c960",
                                "sense_id": "dc336df4-8fed-31ee-bf40-1e1fff48cd25",
                                "text": "De vijfde was een fabrieksarbeider, een gelige, magere jongen van een jaar of achttien in een stofjas."
                            },
                            {
                                "example_id": "8d8f01b8-f259-45b0-a151-062917734ded",
                                "sense_id": "dc336df4-8fed-31ee-bf40-1e1fff48cd25",
                                "text": "Als de koffie op is trekken we stofjassen aan. Grondig moet ik mijn handen wassen. 'Als jij vanochtend aan een komkommer hebt gezeten, kun je zomaar van alles binnenbrengen,' zegt Vermeulen."
                            },
                            {
                                "example_id": "278778d6-01ab-4ad2-8447-120d94d499f1",
                                "sense_id": "dc336df4-8fed-31ee-bf40-1e1fff48cd25",
                                "text": "Vrijdagochtend worden ongeveer 20.000 duiven gelost in Barcelona. De Barcelona-race is de koninginnenrit voor de duiven en hun eigenaars in stofjas. We gingen kijken waar het voor veel blauwgeschelpten begint: het Natural Kweekstation in Zoersel, het grootste kweekstation voor reisduiven ter wereld."
                            },
                            {
                                "example_id": "94eadece-4166-4170-8bc9-b25abd1cceba",
                                "sense_id": "dc336df4-8fed-31ee-bf40-1e1fff48cd25",
                                "text": "Volgens het OM ligt er inmiddels genoeg bewijs in het dossier. Verdachte E. ging kort na de moord naar de woning van zijn buurman. Daar zou hij gezegd hebben dat hij de fietsenmaker om het leven had gebracht. Volgens de buurman zat de man bovendien onder het bloed. Naast deze verklaring is uit onderzoek gebleken dat het dna van de verdachte op een vinger, de pet en de stofjas van het slachtoffer zat."
                            }
                        ]
                    }
                ],
