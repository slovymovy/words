                            {
                                "example_id": "9812e954-c49b-4d90-b6b5-ea9678b2c1e8",
                                "sense_id": "4c19d5dd-e902-31c0-82a2-a75bc2ca700d",
                                "text": "Ongeveer 2300 Amsterdamse kinderen zijn zó dik dat het hun gezondheid zeer ernstig schaadt. Er wordt voor deze groep naarstig gezocht naar een passende behandeling. Suikerziekte, gewrichtsaandoeningen, hoge bloeddruk, hart- en vaatziekten, sociale en emotionele problemen."
                            },
                            {
                                "example_id": "0972ca5e-9aa5-4525-be26-62f948366361",
                                "sense_id": "4c19d5dd-e902-31c0-82a2-a75bc2ca700d",
                                "text": "De eerste arbeiders in de zware industrie in de tweede helft van de 19e eeuw leden aan botvergroeiingen, gewrichtsaandoeningen door overbelasting, infectieziekten en fracturen."
                            }
                        ]
