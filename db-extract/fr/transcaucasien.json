                "senses": [
                    {
                        "sense_id": "ade68216-598b-31f4-9fd8-7abfb1f5ce3d",
                        "entry_id": "43c00bb9-0dd0-3295-9660-755240beefc5",
                        "glosses": [
                            "Relatif à la Transcaucasie et à ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7cb823d-f062-4749-9de9-5c4631b06a19",
                                "sense_id": "ade68216-598b-31f4-9fd8-7abfb1f5ce3d",
                                "text": "J’étais studieusement préparé, pourtant, largement approvisionné de documents géographiques et ethnologiques, relatifs à la région transcaucasienne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31852527-a676-4c04-9b64-4913108bcb24",
                        "source_entry_id": "43c00bb9-0dd0-3295-9660-755240beefc5",
                        "source_sense_id": "ade68216-598b-31f4-9fd8-7abfb1f5ce3d",
                        "target_lang_word": "закавказский",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "закавказский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "262b2ab5-22b7-37d6-a926-c3508be5d328",
                                        "entry_id": "c7d9bd24-8981-3538-b194-7fe117c605d3",
                                        "glosses": [
                                            "геогр. связанный, соотносящийся с Закавказьем; расположенный к югу от Главного хребта Большого Кавказа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0deae73-1e95-4395-890b-ca400636c9cd",
                                                "sense_id": "262b2ab5-22b7-37d6-a926-c3508be5d328",
                                                "text": "Житель закавказский не имел времени думать об улучшении своего хозяйства; дом его, домашняя утварь, упряжь, арба, скот и почти всё недвижимое имущество ежеминутно могли быть потребованы для нужд общественных, при движении войска и пр."
                                            },
                                            {
                                                "example_id": "b976e328-a0a2-403c-977d-8037db292992",
                                                "sense_id": "262b2ab5-22b7-37d6-a926-c3508be5d328",
                                                "text": "Мелкие закавказские христианские царства еще со времен Грозного и Годунова молили о русской помощи и предлагали признать русское подданство."
                                            },
                                            {
                                                "example_id": "f5e3b662-b64a-43c7-8e25-0a1f9bb2f5e7",
                                                "sense_id": "262b2ab5-22b7-37d6-a926-c3508be5d328",
                                                "text": "Вспыхнувшая в Баку чумная эпидемия, вероятно, многих остановит от поездок на кавказские и закавказские курорты, а при таких условиях вполне вероятен наплыв публики на ближайшие курорты в центре России."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af120e42-bc3b-39de-9a71-c4423b4ef0e7",
                                        "entry_id": "c7d9bd24-8981-3538-b194-7fe117c605d3",
                                        "glosses": [
                                            "характерный для Закавказья"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c936d5d-6755-4bf5-b563-772ce30ad52a",
                                                "sense_id": "af120e42-bc3b-39de-9a71-c4423b4ef0e7",
                                                "text": "Он казался лет пятидесяти; смуглый цвет лица его показывал, что оно давно знакомо с закавказским солнцем, и преждевременно поседевшие усы не соответствовали его твёрдой походке и бодрому виду."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
