                        "examples": [
                            {
                                "example_id": "6ac5681c-f98a-4b2e-ba50-25aa9fb91e00",
                                "sense_id": "27ea8290-9239-33c3-98d7-ee1d6ea002aa",
                                "text": "Weniger als.",
                                "translation": "Moins que."
                            },
                            {
                                "example_id": "3e4e316d-a5de-4193-84aa-f77c48004d2e",
                                "sense_id": "27ea8290-9239-33c3-98d7-ee1d6ea002aa",
                                "text": "Immer weniger.",
                                "translation": "De moins en moins."
                            },
                            {
                                "example_id": "dcf8e6ef-2240-488e-9dfd-704da336678a",
                                "sense_id": "27ea8290-9239-33c3-98d7-ee1d6ea002aa",
                                "text": "wenig werden.",
                                "translation": "Diminuer."
                            },
                            {
                                "example_id": "bc1c56b0-f69d-40cb-b0ea-c382fdad1896",
                                "sense_id": "27ea8290-9239-33c3-98d7-ee1d6ea002aa",
                                "text": "10 wenig 3 ist 7.",
                                "translation": "10 moins 3 font 7."
                            },
                            {
                                "example_id": "ec6fd8fd-e1cc-4a64-980e-aa957a53ae52",
                                "sense_id": "27ea8290-9239-33c3-98d7-ee1d6ea002aa",
                                "text": "Nicht mehr und nicht weniger.",
                                "translation": "Ni plus ni moins"
                            },
                            {
                                "example_id": "db39088f-6b61-4db8-8991-11724049b28a",
                                "sense_id": "27ea8290-9239-33c3-98d7-ee1d6ea002aa",
                                "text": "Im Winter bekommen wir weniger Sonne ab, essen weniger vitaminreiches Obst und Gemüse und bewegen uns deutlich seltener an der frischen Luft als im Sommer.",
                                "translation": "En hiver, nous recevons moins de soleil, nous mangeons moins de fruits et de légumes riches en vitamines et nous faisons nettement moins d'exercice en plein air qu’en été."
                            },
                            {
                                "example_id": "fb4f19fc-636e-4a8b-a7f2-1cc130b15a91",
                                "sense_id": "27ea8290-9239-33c3-98d7-ee1d6ea002aa",
                                "text": "Zäpfchen können viel weniger Medikament enthalten als schluckbare Pillen und wirken trotzdem schneller.",
                                "translation": "Par rapport à une gélule ou un comprimé, un suppositoire peut être plus faiblement dosé en substance active et agir pourtant plus rapidement."
                            }
                        ]
                    }
                ],
