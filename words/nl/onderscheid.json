                    "sense_definition": "Tweede persoon enkelvoud tegenwoordige tijd van <w>onderscheiden</w> (bij inversie).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>onderscheid</w> je deze twee gevallen niet van elkaar?",
                            "target_lang_translations": {
                                "en": "Why do you not <w>distinguish</w> these two cases from each other?",
                                "ru": "Почему ты не <w>отличаешь</w> эти два случая друг от друга?",
                                "fr": "Pourquoi ne <w>distingues-tu</w> pas ces deux cas l'un de l'autre ?"
                            }
                        },
                        {
                            "text": "<w>Onderscheid</w> je de subtiele verschillen in deze twee afbeeldingen?",
                            "target_lang_translations": {
                                "en": "Do you <w>distinguish</w> the subtle differences in these two images?",
                                "ru": "Ты <w>различаешь</w> тонкие различия на этих двух изображениях?",
                                "fr": "<w>Distingues-tu</w> les différences subtiles entre ces deux images ?"
                            }
