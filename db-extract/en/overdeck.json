                        "examples": [
                            {
                                "example_id": "e759162d-e150-40c2-84b2-42413db5657f",
                                "sense_id": "190e80a7-1ff5-36c8-be7e-2c488fad02c7",
                                "text": "[…] but one great hindrance in this my design, is, that our clerk, who was once a gardener, has this Christmas so overdecked the church with greens, that he has quite spoiled my prospect […]"
                            },
                            {
                                "example_id": "d278f645-10bf-4ab2-8f81-0b801b5ed3c8",
                                "sense_id": "190e80a7-1ff5-36c8-be7e-2c488fad02c7",
                                "text": "She was neither overdressed nor overdecked in jewels, nor over made-up as some of her peers were; nor was she overboisterous."
                            }
                        ]
                    }
