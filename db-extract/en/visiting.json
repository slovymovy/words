                "senses": [
                    {
                        "sense_id": "20d0cb3d-2a5b-3dc5-a309-d00d559c509c",
                        "entry_id": "a79c0059-f46b-3e92-99c4-0355166e0e16",
                        "glosses": [
                            "The act of someone or something that visits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "897ea1c9-b817-4ccf-8414-40ff18826624",
                                "sense_id": "20d0cb3d-2a5b-3dc5-a309-d00d559c509c",
                                "text": "Come, you spirits […] make thick my blood, / Stop up th' access and passage to remorse / That no compunctious visitings of nature / Shake my fell purpose[…]"
                            },
                            {
                                "example_id": "631a4449-25f0-4b6a-9387-8161e3a80132",
                                "sense_id": "20d0cb3d-2a5b-3dc5-a309-d00d559c509c",
                                "text": "I marvel at none of the wild beliefs in the Hartz mountains: fire is the element of the spiritual, and who can tell what strange visitings there may be during the midnight hours that the charcoal-burner sits watching the fitful and subtle mystery of flame?"
                            },
                            {
                                "example_id": "84057aeb-d3d0-4ae6-8997-9f40868b5f05",
                                "sense_id": "20d0cb3d-2a5b-3dc5-a309-d00d559c509c",
                                "text": "Instead, he found the Sabbath in North Carolina \"generally disregarded, or distinguished by the convivial visitings of the white inhabitants, and the noisy diversions of the negroes.\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
