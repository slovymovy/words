                ],
                "senses": [
                    {
                        "sense_id": "6cc9681c-b624-3357-a203-e6e12747b92d",
                        "entry_id": "b649bd31-b157-3446-b46c-3baa0021a2b9",
                        "glosses": [
                            "männliche Person jüngeren Alters, die in einem Stall, meist in einem Gestüt, Arbeiten verrichtet"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "21bf1376-3723-4506-bdcb-7299ff423973",
                                "sense_id": "6cc9681c-b624-3357-a203-e6e12747b92d",
                                "text": "„Der Stallknecht zog die Augenbrauen hoch, als er den Befehl empfing, den Ponywagen anzuspannen, und er hielt sie während der ganzen Vorbereitung hochgezogen.“"
                            },
                            {
                                "example_id": "a047b9a2-ce11-4e32-978a-7499296037e9",
                                "sense_id": "6cc9681c-b624-3357-a203-e6e12747b92d",
                                "text": "„Andernfalls hätte man ihn für einen Stallknecht gehalten.“"
                            },
                            {
                                "example_id": "546aeb3d-5b85-4282-b4bd-ceddf4bf66d2",
                                "sense_id": "6cc9681c-b624-3357-a203-e6e12747b92d",
                                "text": "„Sophies sonnenverbrannter Nacken und ihre rissigen Hände, mit denen sie den Schwamm ausdrückte, hatten mich plötzlich an den jungen Stallknecht Karl erinnert, der in unserer Kindheit unsere Ponys striegelte.“"
                            },
                            {
                                "example_id": "4460d4eb-e6c7-4517-8824-55110fe0afdb",
                                "sense_id": "6cc9681c-b624-3357-a203-e6e12747b92d",
                                "text": "„Ein Stallknecht kam, um aus einer alten Kiste Hafer zu nehmen; dabei ließ er den Deckel mit solcher Wucht wieder zufallen, daß ein Stück Holz absprang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
