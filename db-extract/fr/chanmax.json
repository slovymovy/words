                        "translation_id": "ccc3e421-7dd7-449f-828e-6fad87771f28",
                        "source_entry_id": "ab12b24b-0e63-33dc-9f2f-bbf7d078b9d5",
                        "source_sense_id": "8593cd46-d02d-3915-9590-e5296804bb72",
