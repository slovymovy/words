                    "sense_id": "b2f0206a-819d-3656-8bc9-2c44d72b46fd",
                    "sense_definition": "Een plant met een opvallende felrode bloem die vaak in het wild groeit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bloemen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de zomer zie je vaak een rode <w>klaproos</w> langs de kant van de weg.",
                            "target_lang_translations": {
                                "en": "In the summer, you often see a red <w>poppy</w> along the side of the road."
                            }
                        },
                        {
                            "text": "De rode <w>klaproos</w> bloeit prachtig in het midden van het korenveld.",
                            "target_lang_translations": {
                                "en": "The red <w>poppy</w> blooms beautifully in the middle of the cornfield."
                            }
                        }
                    ],
                    "synonyms": [
                        "gewone klaproos",
                        "papaver"
                    ],
                    "common_phrases": [
                        "rode klaproos",
                        "bloeiende klaproos"
                    ],
                    "target_lang_definitions": {
                        "en": "A plant with a striking bright red flower that often grows in the wild."
                    },
                    "translations": {
                        "en": [
                            {
