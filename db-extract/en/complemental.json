                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6af3b6d9-9f62-3bed-95c5-80ff05660a2c",
                        "entry_id": "5f61525b-96c6-34f9-bcdd-06e0f5a71e92",
                        "glosses": [
                            "Alternative form of complimental (“complimentary”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "24aad9ca-94b7-46e3-920c-8462f8d13334",
                                "sense_id": "6af3b6d9-9f62-3bed-95c5-80ff05660a2c",
                                "text": "I vvill make a complementall aſſault vpon him for my buſineſſe ſeeth's."
                            },
                            {
                                "example_id": "f5d16c3f-6c66-4ccc-ba56-f6db027bfd90",
                                "sense_id": "6af3b6d9-9f62-3bed-95c5-80ff05660a2c",
                                "text": "I have no skill in ceremonious letters which have no other ſubſtance, but a faire contexture of complementall phraſes and curteous wordes."
                            },
                            {
                                "example_id": "d51759d6-d1cc-4426-9b85-73b4a781f567",
                                "sense_id": "6af3b6d9-9f62-3bed-95c5-80ff05660a2c",
                                "text": "For if the Saxon, (our mother tongue) did complaine; as iuſtly (I doubt) in this point may the Daughter: Languages, for the moſt part in tearmes of Art and Erudition, retayning their originall pouertie, and rather growing rich and abundant, in complementall phraſes and ſuch froth."
                            }
                        ]
                    }
