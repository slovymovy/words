                "senses": [
                    {
                        "sense_id": "ba35c5d7-9d71-3ac8-a763-85b9fb365035",
                        "entry_id": "cb27fb69-c6f4-3b3c-a2a2-7a1f534dbe62",
                        "glosses": [
                            "Veröffentlichung in Form eines Buches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddc8c28a-184c-487f-9655-de322a8ecffe",
                                "sense_id": "ba35c5d7-9d71-3ac8-a763-85b9fb365035",
                                "text": "„Und da zeigt es sich, dass in der Tat diese unmittelbar beim Erzähltwerden niedergeschriebenen Märchen Merkmale von Sprechsprache und von Altertümlichkeit zeigen, die schon in der ersten Buchausgabe getilgt sind.“"
                            },
                            {
                                "example_id": "fab5ddc6-266d-4bc8-9038-7eb36b14a0b4",
                                "sense_id": "ba35c5d7-9d71-3ac8-a763-85b9fb365035",
                                "text": "„Die Fassung der Buchausgabe vollendet er in den ersten Monaten, in denen nun auch er Emigrant ist.“"
                            },
                            {
                                "example_id": "20fe8940-56c9-4102-ab39-3b4a1cabb6ee",
                                "sense_id": "ba35c5d7-9d71-3ac8-a763-85b9fb365035",
                                "text": "„Ab 1791 folgt in Göschens »Historischem Calender für Damen« die »Geschichte des Dreißigjährigen Krieges«; für deren dritte Lieferung verfasst Wieland eine Vorrede, sie wird dann der Buchausgabe vorangestellt.“"
                            },
                            {
                                "example_id": "c3a77bfd-7ed4-4a8a-b027-37be00c422fb",
                                "sense_id": "ba35c5d7-9d71-3ac8-a763-85b9fb365035",
                                "text": "„In der Buchausgabe wird dieser erste Teil 516 Seiten umfassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
