                "senses": [
                    {
                        "sense_id": "ef4f6e95-4008-31fb-bc88-26e658a2f143",
                        "entry_id": "47024626-a8d5-3874-88aa-244411e68d04",
                        "glosses": [
                            "südwestlicher Teil des Pazifiks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd631d7-b60c-4481-8edd-ac70fad34c26",
                                "sense_id": "ef4f6e95-4008-31fb-bc88-26e658a2f143",
                                "text": "„US-amerikanische Truppen landen auf den Admiralitätsinseln im Südwestpazifik.“"
                            },
                            {
                                "example_id": "829f47a4-9f78-4247-acac-07143940c3a7",
                                "sense_id": "ef4f6e95-4008-31fb-bc88-26e658a2f143",
                                "text": "„Angesichts der akuten Bedrohung des australischen Festlandes infolge des japanischen Vormarsches im Südwestpazifik verhängt die australische Regierung den Ausnahmezustand über den Norden des Kontinents.“"
                            },
                            {
                                "example_id": "c58a58f7-b42c-4f4f-b376-f947410ac484",
                                "sense_id": "ef4f6e95-4008-31fb-bc88-26e658a2f143",
                                "text": "„Vor der Küste des Inselstaates Vanuatu im Südwestpazifik haben australische Wissenschaftler in beinahe zweitausend Meter Tiefe neu gebildete heiße Quellen entdeckt.“"
                            },
                            {
                                "example_id": "8ebd1702-3b68-4864-95b1-f03095fcbdd7",
                                "sense_id": "ef4f6e95-4008-31fb-bc88-26e658a2f143",
                                "text": "„Eine Gewitterwolke, die am 29. Dezember 2018 über dem Südwestpazifik aufstieg, hält den neuen Rekord als kälteste jemals gemessene Sturmwolke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
