                                "target_senses": [
                                    {
                                        "sense_id": "a0e8938b-2f4f-3cd3-a9fb-4602650d9ae0",
                                        "entry_id": "42f3879d-de80-3a23-9922-dfd46b431b36",
                                        "glosses": [
                                            "An arched masonry structure supporting and forming a ceiling, whether freestanding or forming part of a larger building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47496e40-f297-4a43-8668-f1d8d9a5fcc4",
                                                "sense_id": "a0e8938b-2f4f-3cd3-a9fb-4602650d9ae0",
                                                "text": "The decoration of the vault of Sainte-Chapelle was much brighter before its 19th-century restoration."
                                            },
                                            {
                                                "example_id": "2571f9a5-984e-4705-8a89-3e2973fb75ea",
                                                "sense_id": "a0e8938b-2f4f-3cd3-a9fb-4602650d9ae0",
                                                "text": "the long-drawn aisle and fretted vault"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ac59237-89d2-38c5-96d4-8a15a323c128",
                                        "entry_id": "42f3879d-de80-3a23-9922-dfd46b431b36",
                                        "glosses": [
                                            "Any arched ceiling or roof."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e99c6cb-a0c4-3fc3-9a61-cc39ce289ea0",
                                        "entry_id": "42f3879d-de80-3a23-9922-dfd46b431b36",
                                        "glosses": [
                                            "Anything resembling such a downward-facing concave structure, particularly the sky and caves."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3675cfa1-afb0-4629-ab86-a020b5b32f2a",
                                                "sense_id": "2e99c6cb-a0c4-3fc3-9a61-cc39ce289ea0",
                                                "text": "The stalactites held tightly to the cave's vault."
                                            },
                                            {
                                                "example_id": "7f314988-66b7-4afe-a788-6f19bd399e3b",
                                                "sense_id": "2e99c6cb-a0c4-3fc3-9a61-cc39ce289ea0",
                                                "text": "His fiery eies are fixt vpon the earth.\nAs if he now deuiſ’d some Stratageme:\nOr meant to pierce Auernus darkſome vauts.\nTo pull the triple headed dog from hell."
                                            },
                                            {
                                                "example_id": "1d13f544-2c01-47f4-b661-4465a3457a7d",
                                                "sense_id": "2e99c6cb-a0c4-3fc3-9a61-cc39ce289ea0",
                                                "text": "Had I your tongues and eyes, Il’d vſe them so,\nThat Heauens vault ſhould crack: ſhe’s gone for euer."
                                            },
                                            {
                                                "example_id": "65f72950-d357-4a42-afd6-db067e9d06fb",
                                                "sense_id": "2e99c6cb-a0c4-3fc3-9a61-cc39ce289ea0",
                                                "text": "The ſilent vaults of Death, vnknowne to Light;\nAnd Hell it ſelfe, lye naked to his ſight."
                                            },
                                            {
                                                "example_id": "2d08a2f5-fccd-4108-823c-25be02f58941",
                                                "sense_id": "2e99c6cb-a0c4-3fc3-9a61-cc39ce289ea0",
                                                "text": "No bird flew in the blue vault of heaven, no man or beast moved upon the vast countryside which lay before us."
                                            },
                                            {
                                                "example_id": "620fc8d2-f585-4f0c-a148-47cd50fc030e",
                                                "sense_id": "2e99c6cb-a0c4-3fc3-9a61-cc39ce289ea0",
                                                "text": "God said, ‘Let there be a vault through the middle of the waters to divide the waters in two.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cc994bc-1e59-3e68-9340-4a8e97304ebe",
                                        "entry_id": "42f3879d-de80-3a23-9922-dfd46b431b36",
                                        "glosses": [
                                            "The space covered by an arched roof, particularly underground rooms and (Christianity, obsolete) church crypts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "436f51c7-80f2-323a-b56e-a4d4a91b571d",
                                        "entry_id": "42f3879d-de80-3a23-9922-dfd46b431b36",
                                        "glosses": [
                                            "Any cellar or underground storeroom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ffdabc9-1f06-4eea-ab7f-4e6d6b64cfa6",
                                                "sense_id": "436f51c7-80f2-323a-b56e-a4d4a91b571d",
                                                "text": "to banish rats that haunt our vault"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa189d25-b9f6-3193-98da-aba6b66f238c",
                                        "entry_id": "42f3879d-de80-3a23-9922-dfd46b431b36",
                                        "glosses": [
                                            "Any burial chamber, particularly those underground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89082a8f-9cc1-40d1-9bfb-8a606fc7c706",
                                                "sense_id": "fa189d25-b9f6-3193-98da-aba6b66f238c",
                                                "text": "Holonyms: catacomb, cuniculus"
                                            },
                                            {
                                                "example_id": "0b2d6a3e-4cec-4c12-970c-ad127460eae3",
                                                "sense_id": "fa189d25-b9f6-3193-98da-aba6b66f238c",
                                                "text": "Near-synonyms: crypt, mausoleum"
                                            },
                                            {
                                                "example_id": "ea11ede9-aff5-400f-af6e-78860268a53d",
                                                "sense_id": "fa189d25-b9f6-3193-98da-aba6b66f238c",
                                                "text": "Family members had been buried in the vault for centuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b8b2652-1d8e-32c9-bc2c-ddb480563c3f",
                                        "entry_id": "42f3879d-de80-3a23-9922-dfd46b431b36",
                                        "glosses": [
