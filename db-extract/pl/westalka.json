                                    {
                                        "sense_id": "474a135b-4ee4-35b7-bde8-2d10f0192809",
                                        "entry_id": "b0a9fda2-9754-3abe-b86d-85406cfc92a6",
                                        "glosses": [
                                            "Perteneciente o relativo a la diosa Vesta."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dbda9be1-59ae-3462-9db6-8f48d7edcef1",
                                        "entry_id": "b0a9fda2-9754-3abe-b86d-85406cfc92a6",
                                        "glosses": [
                                            "Dícese de las doncellas romanas consagradas a la diosa Vesta."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3428c25a-bf8c-4f6e-9fc7-52be2203eb41",
                                                "sense_id": "dbda9be1-59ae-3462-9db6-8f48d7edcef1",
                                                "text": "Recuerde, por ejemplo, cómo le proporcioné los materiales para su monografía referente al templo de las vestales."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b46d2fd-9ce8-4af1-93a5-737af0e65e2b",
                        "source_entry_id": "0cb33be0-8137-3f26-bfcd-8987aa7537cb",
                        "source_sense_id": "d89752c4-098f-366c-9d21-36b0d5cff746",
                        "target_lang_word": "Vestalin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vestalin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a31ed0a1-b213-3283-b685-8d5b5ab504df",
                                        "entry_id": "cff29e5c-127e-3a7a-aab7-8dd70303b1f5",
                                        "glosses": [
                                            "jungfräuliche römische Priesterin der Göttin Vesta"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "712b614a-ad68-42b3-a83a-7d9a1729b770",
                                                "sense_id": "a31ed0a1-b213-3283-b685-8d5b5ab504df",
                                                "text": "„Anders als fast alle männlichen Priester befanden sich die Vestalinnen ununterbrochen im Gottesdienst.“"
                                            },
                                            {
                                                "example_id": "dc298c83-08e3-4d07-917d-2ca31ec4fb2c",
                                                "sense_id": "a31ed0a1-b213-3283-b685-8d5b5ab504df",
                                                "text": "„Meine neue Eroberung war von vornehmer Herkunft, war schön und geistvoll; aber zu diesen tatsächlichen Vorzügen kam noch ein eingebildeter hinzu, der nur mein Glück beinahe unfaßbar machte: ich hatte mit einer Vestalin zu tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86adb7d0-f012-42fa-b66a-4d0aee02717e",
                        "source_entry_id": "0cb33be0-8137-3f26-bfcd-8987aa7537cb",
                        "source_sense_id": "d89752c4-098f-366c-9d21-36b0d5cff746",
                        "target_lang_word": "весталка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "весталка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "11f1e226-ebab-33a8-abcb-7d7a9ba6bead",
                                        "entry_id": "8adc5ec1-8274-3bf6-aa21-57f14fcb524e",
                                        "glosses": [
                                            "истор., : жрица Весты, богини домашнего очага, давшая обет целомудрия"
                                        ],
                                        "tags": [
                                            "в Древнем Риме"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fc10405-9f0e-4bd6-b961-4d610546dd11",
                                                "sense_id": "11f1e226-ebab-33a8-abcb-7d7a9ba6bead",
                                                "text": "Потом она простилась со своими подругами, и подруги её, все в белом, оплакивали её, как весталки ту неосторожную, у которой потух священный огонь…"
                                            },
                                            {
                                                "example_id": "5fd8df60-9cc4-4864-bf6b-c0be84a6a348",
                                                "sense_id": "11f1e226-ebab-33a8-abcb-7d7a9ba6bead",
                                                "text": "Она не говорила ни с кем, не поднимала покрова с лица перед мужами и была целомудренна, как весталка."
                                            },
                                            {
                                                "example_id": "7859ac25-9568-4057-a5bf-f44e6e4e1d1a",
                                                "sense_id": "11f1e226-ebab-33a8-abcb-7d7a9ba6bead",
                                                "text": "Среди её предков были легендарная дева-весталка Квинта Клавдия, которая, по преданию, силой молитвы сняла с мели и провела вверх по Тибру корабль со святынями богини Кибелы, и не менее легендарный консул Аппий Клавдий Слепой, при котором были построены первый римский водопровод, названный его именем, и дорога от Рима до Капуи ― знаменитая Аппиева дорога."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b74d5443-9202-3b95-a876-483c23503075",
                                        "entry_id": "8adc5ec1-8274-3bf6-aa21-57f14fcb524e",
                                        "glosses": [
                                            "перен., устар., книжн., целомудренная девушка, женщина; девственница"
                                        ],
                                        "tags": [
                                            "часто ирон."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba18e125-d39b-4009-bfee-c5768ad17f17",
                                                "sense_id": "b74d5443-9202-3b95-a876-483c23503075",
                                                "text": "Маруха ― Людмила, Марфа ― Мария Николаевна, весталка Дуничка, старые девы: фрейлина, Лидия."
                                            },
                                            {
                                                "example_id": "8f562413-598f-4faa-b6c3-6b4e7e11d16a",
                                                "sense_id": "b74d5443-9202-3b95-a876-483c23503075",
                                                "text": "Его теперешнюю жену нельзя узнать, что он из неё сделал в четыре месяца, а была совсем весталка."
                                            },
                                            {
                                                "example_id": "244c2528-ac28-4361-98a7-9de2d0ef69cf",
                                                "sense_id": "b74d5443-9202-3b95-a876-483c23503075",
                                                "text": "Даже весталку можно соблазнить лестью."
                                            },
                                            {
                                                "example_id": "b8302e9a-07df-47cd-a110-7045f8d786b5",
                                                "sense_id": "b74d5443-9202-3b95-a876-483c23503075",
                                                "text": "Вот потеха! Беременная весталка. И, как он сам говорит, что беременность именно и заставила его жениться."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
