                "senses": [
                    {
                        "sense_id": "b6fd36df-f0c9-3c18-adcd-1aed605f6769",
                        "entry_id": "61785852-3a98-3d97-a066-60ae4da9d274",
                        "glosses": [
                            "советск. государственный комитет по проблемам агропромышленного комплекса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6348113d-c235-4590-b352-f8f1bef0e844",
                                "sense_id": "b6fd36df-f0c9-3c18-adcd-1aed605f6769",
                                "text": "Ведущий специалист отдела по производству и переработке картофеля Госагропрома СССР В. Андреев освобожден от занимаемой должности."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e5b81cd-59a0-314a-857a-a821743f3846",
                        "entry_id": "61785852-3a98-3d97-a066-60ae4da9d274",
                        "glosses": [
                            "советск. государственный агропромышленный комплекс"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6026e03-0fa1-49dd-b11a-a4da80f48c3a",
                                "sense_id": "8e5b81cd-59a0-314a-857a-a821743f3846",
                                "text": "Надо решительно менять систему отношений сельских тружеников и госагропрома."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ffe58c7-bd57-37c3-b9f7-e04c5e809662",
                        "entry_id": "61785852-3a98-3d97-a066-60ae4da9d274",
                        "glosses": [
                            "советск. государственное агропромобъединение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48d2290-a73a-479b-910a-2f04d7d697ec",
                                "sense_id": "7ffe58c7-bd57-37c3-b9f7-e04c5e809662",
                                "text": "В каждом ведомстве, с которым пришлось иметь дело: в госагропромах страны и республики, Министерстве финансов, Госкомтруде, правлении Агропромбанка ― везде свои представления об аренде!"
                            }
                        ]
                    }
