        "fr-extract.jsonl": [
            {
                "entry_id": "8c6c03ea-e976-36a1-b1f5-93bfc855b6e8",
                "word": "indépendantiste",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "378bf3b8-e070-4529-a6cb-daaa42dc9653",
                        "entry_id": "8c6c03ea-e976-36a1-b1f5-93bfc855b6e8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "indépendantistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb55fa48-7fb0-3502-8ae5-ad7242feed7e",
                        "entry_id": "8c6c03ea-e976-36a1-b1f5-93bfc855b6e8",
                        "glosses": [
                            "Qui se rapporte à un mouvement prônant l’indépendance politique d’un territoire rattaché à un pays ou à une confédération."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93942af5-e27c-4e90-850b-37e147d78455",
                                "sense_id": "bb55fa48-7fb0-3502-8ae5-ad7242feed7e",
                                "text": "Elle a en effet mis les trois moyens d'information d’accord en commençant par occuper la radio, puis en mettant la main sur la télévision, tuant au passage une quatorzaine de Lituaniens indépendantistes et sans armes."
                            },
                            {
                                "example_id": "5c74ea4d-baf2-48ea-9d0f-1e932f634633",
                                "sense_id": "bb55fa48-7fb0-3502-8ae5-ad7242feed7e",
                                "text": "Peu avant sa mort, le président tchétchène indépendantiste avait décidé de s'adresser à l'Union européenne."
                            },
                            {
                                "example_id": "f7ece617-aa06-484a-bfc7-ff5c66df8824",
                                "sense_id": "bb55fa48-7fb0-3502-8ae5-ad7242feed7e",
                                "text": "Le communiqué de l’ETA n’implique toutefois pas « un renoncement au cessez-le-feu permanent, ni aux négociations avec le gouvernement espagnol », ont indiqué des sources proches de la mouvance indépendantiste au Pays basque."
                            }
                        ]
                    },
                    {
                        "sense_id": "8412cdfb-63ee-37cc-bb48-9e32fd8ec53c",
                        "entry_id": "8c6c03ea-e976-36a1-b1f5-93bfc855b6e8",
                        "glosses": [
                            "Qui se rapporte au mouvement prônant l’indépendance politique du Québec par rapport à la fédération canadienne."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "8c574ea7-36a7-453d-89a4-692677f3c460",
                                "sense_id": "8412cdfb-63ee-37cc-bb48-9e32fd8ec53c",
                                "text": "Malgré sa foi fédéraliste, l’humoriste et sénateur Jean Lapointe n’exclut pas la possibilité qu'il pourrait devenir un jour indépendantiste."
                            },
                            {
                                "example_id": "61094614-f07a-4373-bc67-24e4a58f9514",
                                "sense_id": "8412cdfb-63ee-37cc-bb48-9e32fd8ec53c",
                                "text": "La plupart des leaders indépendantistes et la quasi-totalité des historiens ont enveloppé sa mémoire du silence réservé à ceux qui ont fait progresser le Québec sans avoir pour autant embrassé l’idéologie nationaliste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dc4c9e2-4a7b-420e-b1fe-089ac07940df",
                        "source_entry_id": "8c6c03ea-e976-36a1-b1f5-93bfc855b6e8",
                        "target_lang_word": "indipendentista",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indipendentista",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "53bd7c09-5a29-3164-806d-83823fb51392",
                                        "entry_id": "1f41b95c-4578-377d-b724-48e101f43d07",
                                        "glosses": [
                                            "qualora vi siano possibilità economiche, istituzioni valide, continuazione di lunghi periodi lontani da guerre o battaglie, governatori o governanti riconosciuti pressoché unanimemente, è chi sostiene la formazione di uno Stato in una regione precedentemente parte di un altro più ampio"
                                        ],
                                        "tags": [
                                            "diritto"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af686fc6-ddb7-4906-9df1-33e6369651e9",
                                                "sense_id": "53bd7c09-5a29-3164-806d-83823fb51392",
                                                "text": "storicamente non è possibile negare l'esistenza di molti indipendentisti borghesi conservatori"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de21dece-82e5-3933-a0d8-bd501519f869",
                                        "entry_id": "1f41b95c-4578-377d-b724-48e101f43d07",
                                        "glosses": [
                                            "chi, talvolta con disordini e rischio di scontri con le forze di polizia, sollecita movimenti per destabilizzare un ordine costituito e per lo più pacifico, con una tendenza politica generalmente rivoluzionaria di estrema sinistra"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10aece19-bc6b-470d-b609-bd33d9ca7e44",
                                                "sense_id": "de21dece-82e5-3933-a0d8-bd501519f869",
                                                "text": "gli indipendentisti anarchici sono spesso una serissima minaccia per vari Paesi"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
