                        "glosses": [
                            "de snelheid waarmee een vloeistof of gas ergens doorheen stroomt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc108ec7-90a9-43e6-9e15-f06cb689a2fb",
                                "sense_id": "2c048854-5f0a-3568-8a73-809e51d0a057",
                                "text": "Dit proces lijkt veel op de manier waarop rivieren steendeeltjes meevoeren: de turbulentie in een snel stromende bergbeek voert slik, zand en grind mee totdat de helling van het terrein en de stroomsnelheid van de rivier afnemen en de grotere steentjes worden afgezet."
                            },
                            {
                                "example_id": "228d2e77-7bc0-46ef-b19c-c896a59f8b19",
                                "sense_id": "2c048854-5f0a-3568-8a73-809e51d0a057",
                                "text": "De tunnels werden daardoor groter (hoger en breder), waardoor de stroomsnelheid van het water afnam en zand en grind werden afgezet."
                            }
                        ]
                    }
