                    },
                    {
                        "form_id": "c0e29b27-1dbd-4361-884d-800b3a311f82",
                        "entry_id": "46f6a8b7-f101-3e6d-a386-26a4b7bf5c58",
                        "tags": [
                            "Plus courant"
                        ],
                        "form": "Landwehr"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2065f8cd-eb63-3305-84c9-1d484f2d80e5",
                        "entry_id": "46f6a8b7-f101-3e6d-a386-26a4b7bf5c58",
                        "glosses": [
                            "Ensemble des milices appelées à renforcer l’armée régulière en cas de conflit dans les États de langue allemande, notamment pendant les guerres napoléoniennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce410060-59e8-4747-b18d-1301be04a939",
                                "sense_id": "2065f8cd-eb63-3305-84c9-1d484f2d80e5",
                                "text": "Les dernières lettres de la Silésie annoncent que, depuis quelques semaines, il arrive sur les frontières occidentales de cette province une foule de cultivateurs, d’habitants des villes et autres personnes, quittant à la hâte la Bohême, où on prend les mesures les plus rigoureuses pour les forcer, soit à servir dans les troupes de ligne, soit à faire partie de la landwehr."
                            },
                            {
                                "example_id": "3e453032-18b6-4344-a184-d09279acc9df",
                                "sense_id": "2065f8cd-eb63-3305-84c9-1d484f2d80e5",
                                "text": "Refusant le rétablissement de la conscription, ils auraient néanmoins accepté que la Garde nationale jouât le rôle d’une landwehr, auxiliaire de l’armée de métier à laquelle ils voulaient revenir."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1e32249-8df0-31ec-9fef-e370790d138e",
                        "entry_id": "46f6a8b7-f101-3e6d-a386-26a4b7bf5c58",
                        "glosses": [
                            "Unité ou soldat faisant partie de la landwehr."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf043f3-5d92-4817-830f-abe90f4c4d7d",
                                "sense_id": "d1e32249-8df0-31ec-9fef-e370790d138e",
                                "text": "L’armée commune défend les territoires de la monarchie contre les ennemis du dehors et assure l’ordre à l’intérieur. Les landwehrs, en cas de guerre, soutiennent l’armée commune ; leurs chefs sont désignés par l’empereur. L’effectif du pied de guerre, d’après la nouvelle loi militaire de 1912, est de 900 000 hommes pour l’armée active et sa réserve ; 100 000 pour chacune des deux landwehrs, 500 000 pour la réserve de recrutement. Au total, 1 720 000 hommes d’active et de réserve."
                            },
                            {
                                "example_id": "3ea35701-9586-44b4-b052-c98d8938e44a",
                                "sense_id": "d1e32249-8df0-31ec-9fef-e370790d138e",
                                "text": "Sur la route de Lagarde à Ommeray, des landwehrs occupaient différents points, des hussards et des chevau-légers patrouillaient."
                            }
                        ]
                    }
