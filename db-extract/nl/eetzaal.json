                        "examples": [
                            {
                                "example_id": "034b5602-de78-4a17-8b28-429f3ac0c023",
                                "sense_id": "6f8b1a5c-529b-3214-b605-201984de5fb6",
                                "text": "Dan zien we elkaar om half een in de eetzaal."
                            },
                            {
                                "example_id": "502cc9f1-c4f5-4627-8a5f-28a5447dce09",
                                "sense_id": "6f8b1a5c-529b-3214-b605-201984de5fb6",
                                "text": "Met nat haar kom ik de kleine eetzaal binnen, waar de rest al aan de antipasti zit."
                            },
                            {
                                "example_id": "b348aae2-306b-402a-b4f7-8f68c6fbbd91",
                                "sense_id": "6f8b1a5c-529b-3214-b605-201984de5fb6",
                                "text": "Waarom niet? Ik haast me de eetzaal binnen en ga naar zuster Geneviève."
                            }
                        ]
                    }
