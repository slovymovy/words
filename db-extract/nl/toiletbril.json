                "senses": [
                    {
                        "sense_id": "36d5e80a-4fb2-3df1-9ae2-e32dfee7c6b9",
                        "entry_id": "75efb8db-ae1f-3ae5-b83d-b5b353525aee",
                        "glosses": [
                            "met scharnieren aan de toiletpot bevestigde ovale plaat met een gat erin, waar men op zit tijdens het gebruikmaken van het toilet"
                        ],
                        "tags": [
                            "huishouden"
                        ],
                        "examples": [
                            {
                                "example_id": "d81d3468-4f00-4f51-8b84-2264d71a1e6c",
                                "sense_id": "36d5e80a-4fb2-3df1-9ae2-e32dfee7c6b9",
                                "text": "Bang dat zijn overwegend Rotterdamse klandizie de Ajax-wc-brillen niet zal accepteren is Hell overigens niet. \"Ik neem aan dat ze er net zo hygiënisch mee omgaan als met een normale toiletbril.\""
                            },
                            {
                                "example_id": "cbbed857-14b0-43d3-a188-fb738100d78e",
                                "sense_id": "36d5e80a-4fb2-3df1-9ae2-e32dfee7c6b9",
                                "text": "Enterokokken zijn bacteriën die bij iedereen voorkomen in het maag-darmstelsel. Ze verspreiden zich vanuit de darmen via bijvoorbeeld ongewassen handen of de toiletbril naar de omgeving. Gezonde mensen merken er niks van. \"Maar mensen met een zwakke gezondheid, zoals heel oude mensen of jonge kinderen, kunnen er mogelijk ziek van worden\", zegt een woordvoerder."
                            }
                        ]
                    }
