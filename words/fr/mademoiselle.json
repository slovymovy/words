            "senses": [
                {
                    "sense_id": "3d1195c2-322b-3b3d-b334-ce487e3ffaaf",
                    "sense_definition": "Titre de civilité ou formule d'adresse employé pour désigner une jeune femme ou une femme célibataire.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "titre_civilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bonjour <w>mademoiselle</w>, puis-je vous aider à trouver votre chemin ?"
                        },
                        {
                            "text": "<w>Mademoiselle</w> Martin, vous pouvez entrer dans le bureau maintenant."
                        }
                    ],
                    "synonyms": [
                        "Mlle"
                    ],
                    "common_phrases": [
                        "bonjour mademoiselle"
                    ]
                },
                {
                    "sense_id": "27aa6acc-1038-3670-9f6c-7bca9c24cf11",
                    "sense_definition": "Titre donné autrefois aux femmes mariées de la bourgeoisie ou de la noblesse non titrée.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "titre_historique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce roman historique, la respectable bourgeoise est appelée <w>mademoiselle</w> par ses domestiques."
                        },
                        {
                            "text": "Au dix-septième siècle, <w>Mademoiselle</w> Molière, épouse du dramaturge, jouait dans sa troupe."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "usage historique du XIXe siècle"
                        }
                    ]
                },
                {
                    "sense_id": "930d9a8d-a9a9-311f-8c0a-9d6cc21ea72d",
                    "sense_definition": "Titre honorifique réservé sous l'Ancien Régime à la fille aînée du frère du roi ou à la première princesse du sang non mariée.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "titre_historique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La Grande <w>Mademoiselle</w> a laissé des mémoires précieux sur la vie à la cour royale."
                        },
                        {
                            "text": "Tous les courtisans s'inclinèrent avec respect au passage de <w>Mademoiselle</w> dans la galerie."
