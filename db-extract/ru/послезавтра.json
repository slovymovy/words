                                "target_senses": [
                                    {
                                        "sense_id": "6c1176c9-978f-3753-9488-f3cbe2e78047",
                                        "entry_id": "30bdfe02-8203-397b-807e-a5474289fd62",
                                        "glosses": [
                                            "Día inmediatamente posterior al de mañana."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ddb7aed-ba91-48b1-ab2a-db4c43ee2414",
                                                "sense_id": "6c1176c9-978f-3753-9488-f3cbe2e78047",
                                                "text": "—¿Y es pasado mañana el día de la boda? —preguntó el Velludo, que había quedado pensativo mientras ellos hablaban."
                                            },
                                            {
                                                "example_id": "c397bf3d-7030-4e91-b1d0-ad575d56de19",
                                                "sense_id": "6c1176c9-978f-3753-9488-f3cbe2e78047",
                                                "text": "debieron abandonar la escuela y tomar un oficio o un trabajo cualquiera para ganarse el día de hoy, dejando al azar el de mañana y el de pasado mañana."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "pasado mañana",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7d18b8ae-7a23-383a-a5f1-8d8aa9ea5ed3",
                                        "entry_id": "9581cfaa-deda-3280-b29e-747df6f7d9b2",
                                        "glosses": [
                                            "En el día de pasado mañana₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc91be8-3921-4b62-944f-72f0e6c13288",
                                                "sense_id": "7d18b8ae-7a23-383a-a5f1-8d8aa9ea5ed3",
                                                "text": "Vente pasado mañana, que no está aquí Gargullo, que se ha llevado la llave de aquello."
                                            },
                                            {
                                                "example_id": "df30f13a-d21c-4251-8273-d4d61852478b",
