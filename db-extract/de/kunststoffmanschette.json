                "senses": [
                    {
                        "sense_id": "08ad3783-f05e-35b4-b416-0a62b742d328",
                        "entry_id": "95e1091e-df4f-36c2-ad47-c549385f5915",
                        "glosses": [
                            "aus Kunststoff bestehender Dichtungsring mit Wulst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6f5e630-e25e-48dc-b737-a787d2d5ce19",
                                "sense_id": "08ad3783-f05e-35b4-b416-0a62b742d328",
                                "text": "„Abluftseitig eingebaute Kunststoffmanschetten sichern die zerbrechlichen Teile der Anlage gegen Überdruck, wenn die Abluftleitung nach der Pumpe nicht mehr durchgängig ist.“"
                            },
                            {
                                "example_id": "59a13bf6-b9f5-4e79-9852-033f1879eead",
                                "sense_id": "08ad3783-f05e-35b4-b416-0a62b742d328",
                                "text": "„Durch eine Optimierung des Steuerungs-Schaltkreises der aktiven äußeren Elektrode konnte man auch auf eine isolierende Kunststoffmanschette, die vor der Optimierung notwendig war, dauerhaft verzichten.“"
                            },
                            {
                                "example_id": "c4a45a44-6db3-42af-b524-402ee2704caf",
                                "sense_id": "08ad3783-f05e-35b4-b416-0a62b742d328",
                                "text": "„Im Inneren des Brandschutzverbinders wird die Gussleitung durch eine Kunststoffmanschette unterbrochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
