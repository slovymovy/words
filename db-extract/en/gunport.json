                                        "entry_id": "45608c7a-750a-39ef-82f9-8d85ac258c92",
                                        "glosses": [
                                            "verschließbare Öffnung in der Wand eines mit Kanonen bewaffneten Schiffs, durch die eine Kanone bei Bedarf operieren kann"
                                        ],
                                        "tags": [],
