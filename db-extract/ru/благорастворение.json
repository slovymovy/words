                "senses": [
                    {
                        "sense_id": "3fc7d47d-777a-3a5d-aa15-7b684e2d440f",
                        "entry_id": "7e1862cf-3c0f-32f7-852f-e094fcdd3d51",
                        "glosses": [
                            "церк., устар. чистота, свежесть, благоуханность воздуха (теперь шутл. только в выражении благорастворение воздухов)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b86dd63-8b07-409a-aa44-31ff3f099c2d",
                                "sense_id": "3fc7d47d-777a-3a5d-aa15-7b684e2d440f",
                                "text": "Желая воспользоваться благорастворением воздуха, поехал я верьхом за город .."
                            }
                        ]
                    },
                    {
                        "sense_id": "b217b42b-7af4-3b81-b02d-767e71ee6c7b",
                        "entry_id": "7e1862cf-3c0f-32f7-852f-e094fcdd3d51",
                        "glosses": [
                            "перен. состояние умиротворённости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7100795-6869-4f68-a990-8811ba6e62a2",
                                "sense_id": "b217b42b-7af4-3b81-b02d-767e71ee6c7b",
                                "text": "Не успел я за заставу отъехать, как вдруг во всей губернии наступило благорастворение воздухов. Полициймейстер — не скачет, квартальные — не бегут, городовые — не усердствуют."
                            }
                        ]
                    }
