{
    "word_family": [
        "chatter",
        "chatterer",
        "chattery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e2b3bf74-a81e-3575-a53e-bca47150297f",
                    "sense_definition": "present participle and gerund of <w>chatter</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birds were <w>chattering</w> loudly in the trees all morning.",
                            "target_lang_translations": {
                                "tr": "Kuşlar tüm sabah ağaçlarda yüksek sesle <w>cıvıldıyordu</w>."
                            }
                        },
                        {
                            "text": "My teeth were <w>chattering</w> from the cold while I waited for the bus.",
                            "target_lang_translations": {
                                "tr": "Otobüsü beklerken soğuktan dişlerim <w>takırdıyordu</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "teeth chattering"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin (kuşlar gibi) hızlı ve sürekli ses çıkarması veya soğuktan dişlerin birbirine çarpması."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "cıvıldama",
                                "target_lang_sense_clarification": "Kuşlar gibi hayvanların çıkardığı hızlı sesler için."
                            },
                            {
                                "target_lang_word": "takırdama",
                                "target_lang_sense_clarification": "Soğuktan veya korkudan dişlerin birbirine çarpması durumu için."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e181784-d1e3-3761-ad14-9476aa0f7e05",
                    "sense_definition": "A rapid, repetitive noise or sound.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>chattering</w> of the old machine made it hard to concentrate.",
                            "target_lang_translations": {
                                "tr": "Eski makinenin sürekli <w>tıkırtısı</w> konsantre olmayı zorlaştırıyordu."
                            }
                        },
                        {
                            "text": "We could hear the <w>chattering</w> of squirrels high up in the branches.",
                            "target_lang_translations": {
                                "tr": "Dalların tepesinde sincapların <w>cıvıltısını</w> duyabiliyorduk."
                            }
                        }
                    ],
                    "synonyms": [
                        "rattle",
                        "clatter"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hızlı ve tekrarlayan bir gürültü veya ses."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "tıkırtı",
                                "target_lang_sense_clarification": "Mekanik veya nesnelerin çıkardığı hızlı, tekrarlayan sesler."
                            },
                            {
                                "target_lang_word": "cıvıltı",
                                "target_lang_sense_clarification": "Sincap veya kuş gibi hayvanların çıkardığı sesler için."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3301416-eb98-3866-818a-e35a00748f67",
                    "sense_definition": "Rapid, unstable fluctuation in a signal or mechanical system before reaching a stable state.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The relay experienced <w>chattering</w> due to the unstable voltage input.",
                            "target_lang_translations": {
                                "tr": "Röle, kararsız voltaj girişi nedeniyle <w>titreşim</w> yaşadı."
                            }
                        },
                        {
                            "text": "Engineers adjusted the control loop to eliminate the <w>chattering</w> of the valve.",
                            "target_lang_translations": {
                                "tr": "Mühendisler, valfin <w>titreşimini</w> ortadan kaldırmak için kontrol döngüsünü ayarladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "oscillation",
                        "instability"
                    ],
                    "antonyms": [
                        "stability"
                    ],
                    "common_phrases": [
                        "relay chattering"
                    ],
                    "target_lang_definitions": {
                        "tr": "Mekanik bir sistemde veya sinyalde kararlı hale gelmeden önceki hızlı ve dengesiz dalgalanma."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "titreşim",
                                "target_lang_sense_clarification": "Mekanik sistemlerdeki kararsız hareketler için."
                            },
                            {
                                "target_lang_word": "dalgalanma",
                                "target_lang_sense_clarification": "Sinyal veya voltajdaki kararsızlık durumu için."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "32b355a8-01ed-3af6-b36f-c990bfa73ff8",
                    "sense_definition": "Describing something that makes a rapid, repetitive sound or movement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>chattering</w> monkeys jumped quickly from tree to tree.",
                            "target_lang_translations": {
                                "tr": "<w>Cıvıldayan</w> maymunlar ağaçtan ağaca hızla atlıyordu."
                            }
                        },
                        {
                            "text": "She tried to warm her <w>chattering</w> teeth with a hot cup of tea.",
                            "target_lang_translations": {
                                "tr": "Sıcak bir fincan çayla <w>takırdayan</w> dişlerini ısıtmaya çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "noisy"
                    ],
                    "common_phrases": [
                        "chattering teeth"
                    ],
                    "target_lang_definitions": {
                        "tr": "Hızlı ve tekrarlayan bir ses çıkaran veya hareket eden şeyleri tanımlayan sıfat."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "takırdayan",
                                "target_lang_sense_clarification": "Dişler gibi birbirine çarpan nesneler için."
                            },
                            {
                                "target_lang_word": "cıvıldayan",
                                "target_lang_sense_clarification": "Ses çıkaran canlılar için."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}