                                                "sense_id": "6d701d6a-3363-3666-98b4-c57491f28f3d",
                                                "text": "Sprechen Sie Hindi?"
                                            },
                                            {
                                                "example_id": "ccdb6a37-7c44-4739-912c-89c98e377296",
                                                "sense_id": "6d701d6a-3363-3666-98b4-c57491f28f3d",
                                                "text": "„Unter den meistgesprochenen Sprachen der Welt steht Hindi an zweiter Stelle nach Chinesisch und vor Spanisch und Englisch.“"
                                            },
                                            {
                                                "example_id": "05d4c5ed-bab8-4a25-a538-24023b706710",
                                                "sense_id": "6d701d6a-3363-3666-98b4-c57491f28f3d",
                                                "text": "„Hindi hört sich sehr seltsam an."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
