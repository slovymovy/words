                    {
                        "translation_id": "1c028e91-aaeb-471c-8d94-91ff478de007",
                        "source_entry_id": "4bd334c3-c554-3370-892c-db38f177bfa5",
                        "source_sense_id": "7b5dae20-8e92-30e8-941c-ddfe0c5dcb2c",
