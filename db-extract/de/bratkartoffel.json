                        "form": "die Bratkartoffel"
                    },
                    {
                        "form_id": "55788052-4069-4e2f-84d8-86e4ef57788c",
                        "entry_id": "dbc0982b-fd53-3e5f-a791-fc5ae68078cd",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bratkartoffeln"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9cf4713-ead3-347c-803e-2478388bba07",
                        "entry_id": "dbc0982b-fd53-3e5f-a791-fc5ae68078cd",
                        "glosses": [
                            "Kartoffelgericht aus [2], bestehend aus geschälten und gekochten Kartoffeln, die mit Zwiebeln, Bauchfleisch oder Speck in der Pfanne gebraten werden"
                        ],
                        "tags": [
                            "Pluraletantum"
                        ],
                        "examples": [
                            {
                                "example_id": "d312c5be-3679-4106-8d3b-192204ec9c3e",
                                "sense_id": "d9cf4713-ead3-347c-803e-2478388bba07",
                                "text": "Ich esse sehr gerne Bratkartoffeln."
                            },
                            {
                                "example_id": "fc245d7d-a0d6-4464-b451-857e30fd6aca",
                                "sense_id": "d9cf4713-ead3-347c-803e-2478388bba07",
                                "text": "„Die Pfanne mit den Bratkartoffeln stellte er auf den Tisch.“"
                            },
                            {
                                "example_id": "a197b061-1bb3-4f66-9477-b2620f54f305",
                                "sense_id": "d9cf4713-ead3-347c-803e-2478388bba07",
                                "text": "[…] kulinarisch hatten die Einwanderer aus Osteuropa Einfluss. So wurden viele Gerichte mit günstigen Zutaten gekocht, oft Suppen oder Eintöpfe – aber ganz gewiss immer mit Kartoffeln in sämtlichen Variationen: Bratkartoffeln – oder wie man hier sagt Bratskartoffeln –, Stampfkartoffeln, Pellkartoffeln, und, und, und."
                            },
                            {
                                "example_id": "afa02004-4bb8-4857-8524-4de03877ca9e",
                                "sense_id": "d9cf4713-ead3-347c-803e-2478388bba07",
                                "text": "Schließlich lande ich doch beim Bayerisch-Schwäbischen: Schweinsbraten mit Biersoße, dazu wahlweise Bratkartoffeln, Knödel oder Spätzle."
                            },
                            {
                                "example_id": "a797bb17-65b6-456c-8fb4-2c3585582e31",
                                "sense_id": "d9cf4713-ead3-347c-803e-2478388bba07",
                                "text": "„Es gab mittags gekochte Kartoffeln und abends dann Bratkartoffeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ccfd9efc-0d4a-3212-ae82-e68d584a15d3",
                        "entry_id": "dbc0982b-fd53-3e5f-a791-fc5ae68078cd",
                        "glosses": [
                            "ein Teil einer geschnittenen Kartoffel: eine Scheibe, ein Würfel oder Schnitzel aus einer Kartoffel"
                        ],
                        "tags": [
                            "häufig im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e8e7e486-7850-40e2-816c-56fd781218e4",
                                "sense_id": "ccfd9efc-0d4a-3212-ae82-e68d584a15d3",
                                "text": "Der Döner gehört zu Deutschland wie die Bratkartoffel."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
