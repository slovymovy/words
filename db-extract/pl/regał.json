                        ]
                    },
                    {
                        "translation_id": "1833f860-699e-4a50-aa37-727795d2da82",
                        "source_entry_id": "e3e1c08e-eaa0-34a2-857b-7d926bc3d624",
                        "source_sense_id": "fe16e076-6034-3a8c-a14c-b2f0973a1a79",
                        "target_lang_word": "Regal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "217957df-c203-30e7-aab1-80efb2bffa31",
                                        "entry_id": "2fca7583-2120-369a-9931-52dd054809e6",
                                        "glosses": [
                                            "ein offenes Gestell, an dem mehrere Bretter befestigt sind, die als Ablage dienen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85f9d3b4-b58b-4e8b-9d2d-65f7aa4692c7",
                                                "sense_id": "217957df-c203-30e7-aab1-80efb2bffa31",
                                                "text": "Meine Regale reichen für die Bücher schon lange nicht mehr aus."
                                            },
                                            {
                                                "example_id": "00ef31c1-2004-44bc-b8e9-b3879002163a",
                                                "sense_id": "217957df-c203-30e7-aab1-80efb2bffa31",
                                                "text": "„Helena achtete darauf, die Wände mit Bücherregalen zu schmücken, so wie es sich für ein kultiviertes Haus gehört, und in diesen Regalen standen neben einer Enzyklopädie, einem Nachschlagewerk zu berühmten Menschen und berühmten Orten, auch Fotoalben.“"
                                            },
                                            {
                                                "example_id": "9e1cb40f-e462-450f-8e5a-6dc1d3cd1e49",
                                                "sense_id": "217957df-c203-30e7-aab1-80efb2bffa31",
                                                "text": "„Er drückte sich an uns vorbei, ging an den Regalen vorbei und nahm sich ein Buch heraus.“"
                                            },
                                            {
                                                "example_id": "6278f093-9aba-4ea5-9fbe-48a74184466d",
                                                "sense_id": "217957df-c203-30e7-aab1-80efb2bffa31",
                                                "text": "„In meterhohen Regalen lagerte alles, was die Einwohner der Vier-Millionen-Stadt offensichtlich entbehren konnten: wandhohe Ölschinken, Schaufenster- und Schneiderpuppen, Graphoskope, ausgestopfte Tauben, viktorianische Säulen, orientalische Leuchter, ziegelrote Büsten mit dem Portrait des Kaisers, grell geschminkte Damenbüsten mit Porzellanzähnen und Glasaugen.“"
                                            },
                                            {
                                                "example_id": "d17d805f-76d1-48b4-94a6-d6b770adaf2e",
                                                "sense_id": "217957df-c203-30e7-aab1-80efb2bffa31",
                                                "text": "„Mr. Sipple keuchte laut, als er die Doppelflinte vom Regal im Wohnzimmer herunterholte.“"
                                            },
                                            {
                                                "example_id": "a4477739-dd40-4e79-8bba-2aa536b4414b",
                                                "sense_id": "217957df-c203-30e7-aab1-80efb2bffa31",
                                                "text": "„Was auf dem oberen Brett stand, alte Hutschachteln, halbzerbrochenes Porcellan und dergleichen, es stürzte alles unter den flüchtenden Füßen der Katze auf die Dielen herab; das polterte und klirrte; erstickende Staubwolken wirbelten auf, und unter Veit’s kreischendem „Hu, hu!“ flog die arme Gehetzte auf der andern Seite des Regales hinab und zur Thür hinaus.“"
                                            },
                                            {
                                                "example_id": "29fe922e-74cf-4eb1-a5d5-53e71d1616d6",
                                                "sense_id": "217957df-c203-30e7-aab1-80efb2bffa31",
                                                "text": "„Oskar erspäht eine neue Blechtrommel, die auf dem obersten Brett eines Regales liegt, möchte sie herunterziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0590d53e-96cb-37ee-a7bb-fd6f0eab0a20",
