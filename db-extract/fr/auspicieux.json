                        "sense_id": "c0683b42-2272-3290-8e65-e1a7d00f4c9c",
                        "entry_id": "55237533-a45c-38bd-a7f8-342d9e9e5925",
                        "glosses": [
                            "Favorable, de bon présage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af7e5375-8e61-4804-9123-c3a0078d1eb2",
                                "sense_id": "c0683b42-2272-3290-8e65-e1a7d00f4c9c",
                                "text": "…des brahmanes lettrés, portant le titre de sâstri, dont la fonction est de réciter les Veda et, autrefois, de fixer les dates auspicieuses pour les fêtes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce17359c-1643-4116-9dbd-14482720a534",
                        "source_entry_id": "55237533-a45c-38bd-a7f8-342d9e9e5925",
                        "source_sense_id": "c0683b42-2272-3290-8e65-e1a7d00f4c9c",
                        "target_lang_word": "auspicious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "auspicious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2bd0fac-8fe6-3ee6-aa77-78abad729352",
                                        "entry_id": "31bee653-aec0-39fc-b6b0-7f1b785538e3",
                                        "glosses": [
                                            "Of good omen; indicating future success."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0ede42d-5cf8-4eff-a7b0-999c4de3e9a1",
                                                "sense_id": "a2bd0fac-8fe6-3ee6-aa77-78abad729352",
                                                "text": "It was a boast of Napoleon, that the very weather owned the influence of his auspicious star—his triumphal entry, his procession, or his fête, were always marked by sunshine."
                                            },
                                            {
                                                "example_id": "53a9fb19-de59-4f43-8067-7c544b073b06",
                                                "sense_id": "a2bd0fac-8fe6-3ee6-aa77-78abad729352",
                                                "text": "Backed by the Salsoul Orchestra, Carol's auspicious single debut, \"More,\" was one of the very first commercially-available 12\" singles and was a smash, reaching the upper regions of the disco charts in 1976."
                                            },
                                            {
                                                "example_id": "bb4f6853-1199-4af6-b4bc-8506775b4d3f",
                                                "sense_id": "a2bd0fac-8fe6-3ee6-aa77-78abad729352",
                                                "text": "Losing nearly a third of the heavy cruisers, including Admiral Kurita's flagship, the Atago, was not an especially-auspicious start to the operation, especially with the admiral himself having to be fished out of the water by a destroyer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c08d336-08fc-3b36-a098-c01360a0386f",
                                        "entry_id": "31bee653-aec0-39fc-b6b0-7f1b785538e3",
                                        "glosses": [
                                            "Conducive to success."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb1b72c-e7fe-4392-b79d-dd2621618795",
                                                "sense_id": "9c08d336-08fc-3b36-a098-c01360a0386f",
                                                "text": "This is an auspicious day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90a57506-ca67-3603-9860-7a8d5e60ebbd",
                                        "entry_id": "31bee653-aec0-39fc-b6b0-7f1b785538e3",
                                        "glosses": [
                                            "Marked by success; prosperous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34e93bf4-11e1-4c86-af79-f9e46aa2a433",
                                                "sense_id": "90a57506-ca67-3603-9860-7a8d5e60ebbd",
                                                "text": "Therefore our ſometimes Siſter, novv our Queen, / Th’ imperiall Ioyntreſſe of this vvarlike State, / Haue vve, as ’tvvere, vvith a defeated ioy, / VVith one Auſpicious, and one Dropping eye, / VVith mirth in Funerall, and vvith Dirge in Marriage, / In equall Scale vveighing Delight and Dole / Taken to VVife […]"
                                            },
                                            {
                                                "example_id": "9dde4996-0d6c-445e-aa13-4525ab07ba71",
                                                "sense_id": "90a57506-ca67-3603-9860-7a8d5e60ebbd",
                                                "text": "Sure, ſuch a Day as this vvas never ſeen! / The Sun himſelf, on this auſpicious Day, / Shines like a Beau in a nevv Birth-Day Suit: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
