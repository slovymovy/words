                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e7d8ceb-7367-4672-9ee9-45aef9c310ef",
                                "sense_id": "070c446b-2f4b-344d-a05a-f4091da2156a",
                                "text": "„So viele Alpinpolizisten und Pistenwächter können gar nicht unterwegs sein, dass jeder Alkowedler und Pistenrowdy erwischt würde.“"
                            },
                            {
                                "example_id": "6516e808-3f3d-4e30-9da5-0946eb63fb5f",
                                "sense_id": "070c446b-2f4b-344d-a05a-f4091da2156a",
                                "text": "„Ist die Gefahr hoch, dass sich Helmträger zu sicher fühlen und zum Pistenrowdy werden?“"
                            }
                        ],
