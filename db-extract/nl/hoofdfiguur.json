                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ebd3d8be-4233-395d-afc3-992f2ca3ba20",
                        "entry_id": "2d38b572-bd58-3ab8-958c-0252d077fd97",
                        "glosses": [
                            "belangrijkste personage in een verhaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7d10718-995c-4226-8fff-71338640e082",
                                "sense_id": "ebd3d8be-4233-395d-afc3-992f2ca3ba20",
                                "text": "Hines (48) is vooral bekend van de tv-serie Curb Your Enthusiasm, van Seinfeld-bedenker Larry David. In de HBO-serie speelt ze de vrouw van de hoofdfiguur. De rol leverde haar twee Emmy-nominaties op."
                            },
                            {
                                "example_id": "bb53cfe5-b1e8-4bb3-9484-95e5f7715762",
                                "sense_id": "ebd3d8be-4233-395d-afc3-992f2ca3ba20",
                                "text": "De jonge regisseur Joeri Vos baseerde zich op een boek van de Noorse auteur Johan Harstad. Hoofdfiguur Mattias wil helemaal niet opvallen, maar is wel een talentvolle zanger. Het levert een beladen, warrig stuk op over verloren doelen en liefdes dat uitwaaiert van de Faeröer Eilanden naar Srebrenica. Het is niet de beste openingsvoorstelling uit de geschiedenis van Oerol."
                            }
                        ]
                    }
