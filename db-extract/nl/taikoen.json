                    {
                        "sense_id": "9f940cbe-6855-385f-8d59-b1992b0dee17",
                        "entry_id": "13105b0b-a48c-3b8b-84c9-112719a3bca8",
                        "glosses": [
                            "een rijk persoon die een groot deel van een bepaalde bedrijfstak in handen heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ad9fe5c-cde0-4a37-ac15-04f53dd3734e",
                                "sense_id": "9f940cbe-6855-385f-8d59-b1992b0dee17",
                                "text": "De Indische taikoen Lakshmi Mittal kocht in 2006 het staalbedrijf Arcelor en werd daarmee de eigenaar van de grootste staalproducent ter wereld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
