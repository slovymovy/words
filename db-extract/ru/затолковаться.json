                "senses": [
                    {
                        "sense_id": "32b6502a-3200-3e5c-a7f8-9c43a4cb9f57",
                        "entry_id": "0b7145a4-b5e3-3d36-8e9d-92a4edbcae67",
                        "glosses": [
                            "to be carried away by a conversation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42057e2e-5e51-4b83-8079-8cdef8e8ec8c",
                                "sense_id": "32b6502a-3200-3e5c-a7f8-9c43a4cb9f57",
                                "text": "Ба́бушка что́-то затолкова́лась с мужика́ми, а он прибежа́л в сад, сбежа́л с обры́ва вниз, продра́лся сквозь ча́щу на бе́рег, к са́мой Во́лге, и онеме́л пе́ред лежа́вшим пейза́жем.",
                                "translation": "Granny would be discussing something with the peasants, and he would run into the garden, run down the hill, and scramble through the thicket to the river bank, and right down to the Volga, and stand transfixed by the landscape spread before him.",
                                "english": "Granny would be discussing something with the peasants, and he would run into the garden, run down the hill, and scramble through the thicket to the river bank, and right down to the Volga, and stand transfixed by the landscape spread before him."
                            }
                        ]
                    }
