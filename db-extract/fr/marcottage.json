                    {
                        "translation_id": "0a6612f8-6639-4728-8a68-5784489c1ac6",
                        "source_entry_id": "7e59efbd-714e-3d01-898c-ac8a9471168b",
                        "target_lang_word": "afleggen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afleggen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6338e282-c614-3488-9ee9-294ebfca5256",
                                        "entry_id": "5922bb09-5406-3078-8793-a39fd1866965",
                                        "glosses": [
                                            "voorbereiden van de overledene(n) op de begrafenis"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a21c760-3aad-487b-9cbc-b681a9a0d3bd",
                                                "sense_id": "6338e282-c614-3488-9ee9-294ebfca5256",
                                                "text": "De kinderen hielpen mee met het afleggen van hun dode vader."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a82ad943-8ed3-3972-b586-8ddc4ee5726b",
                                        "entry_id": "5922bb09-5406-3078-8793-a39fd1866965",
                                        "glosses": [
                                            "afstand overbruggen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e35194c-8fa1-4894-9036-055632db3753",
                                                "sense_id": "a82ad943-8ed3-3972-b586-8ddc4ee5726b",
                                                "text": "Ik moest tien kilometer afleggen om thuis te komen."
                                            },
                                            {
                                                "example_id": "92a520ac-ece1-4c4d-a57e-ef016dae42af",
                                                "sense_id": "a82ad943-8ed3-3972-b586-8ddc4ee5726b",
                                                "text": "'Veel mensen leggen de route af per fiets, op de motor of in een klassieke auto.'"
                                            },
                                            {
                                                "example_id": "e107d2dd-a6d0-4c7e-b5cc-8d4c02c64b48",
                                                "sense_id": "a82ad943-8ed3-3972-b586-8ddc4ee5726b",
                                                "text": "Wat een tocht! Na zeven weken lopen had ik nog niet eens een kwart van de hele trail afgelegd, maar ik was dolblij dat ik de hete woestijn eindelijk achter me kon laten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93936d52-61f3-384c-989c-9b4f434b3a3c",
                                        "entry_id": "5922bb09-5406-3078-8793-a39fd1866965",
                                        "glosses": [
                                            "~ tegen: verliezen van"
                                        ],
                                        "tags": [
                                            "unergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b07f5f79-4e4c-413c-b626-bf454c84b82f",
                                                "sense_id": "93936d52-61f3-384c-989c-9b4f434b3a3c",
                                                "text": "Frankrijk legde het af tegen Nederland tijdens de voetbalwedstrijd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbb41536-487a-3da0-a4fd-b1d3e21e0ede",
                                        "entry_id": "5922bb09-5406-3078-8793-a39fd1866965",
                                        "glosses": [
                                            "van het lichaam doen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffc9d5bd-1d55-41f5-b830-8b5caab0bd59",
                                                "sense_id": "bbb41536-487a-3da0-a4fd-b1d3e21e0ede",
                                                "text": "Het legde zijn jas af bij het binnentreden van het warme klaslokaal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51a4ada3-8e27-3373-8206-72b2abdc8c38",
                                        "entry_id": "5922bb09-5406-3078-8793-a39fd1866965",
                                        "glosses": [
                                            "doen, volbrengen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eac735d4-00d7-4696-acd0-5795d0c53e82",
                                                "sense_id": "51a4ada3-8e27-3373-8206-72b2abdc8c38",
                                                "text": "een examen afleggen"
                                            },
                                            {
                                                "example_id": "c0c00d09-eeda-4f3a-9c84-ab7ceba6a2ca",
                                                "sense_id": "51a4ada3-8e27-3373-8206-72b2abdc8c38",
                                                "text": "Hierna zei hij dat ze maar beter voor de laatste keer hun belijdenis konden afleggen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1d786d8-0e7a-30a5-a6d8-cbd1c693d222",
                                        "entry_id": "5922bb09-5406-3078-8793-a39fd1866965",
                                        "glosses": [
                                            "bespieden, in het bijzonder met een truc erachter komen of een huisdeur gebruikt wordt zodat makkelijker kan worden ingebroken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64041cb7-552a-4b5c-9cff-1fad82ba8554",
                                                "sense_id": "e1d786d8-0e7a-30a5-a6d8-cbd1c693d222",
                                                "text": "De wijkagenten van de Hengelose Es en Wilbert & Tichelwerk hebben op hun Facebookpagina een waarschuwing geplaatst over woningen die ‘afgelegd’ worden met stokjes. Volgens de politie plaatsen inbrekers in deze vakantieperiode stokjes tegen de deur, om te zien of de bewoners thuis zijn."
                                            },
                                            {
                                                "example_id": "6a1b4ca2-0381-443f-b35b-8043f98623f6",
                                                "sense_id": "e1d786d8-0e7a-30a5-a6d8-cbd1c693d222",
                                                "text": "De inbreker plaatst een takje tegen de voordeur van een woning. In politiejargon wordt deze methode afleggen genoemd. Als het takje er na één of twee dagen nog steeds zit, is er waarschijnlijk langdurig niemand thuis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
