                    },
                    {
                        "form_id": "56849a3e-3732-4026-b056-9369c4e78d68",
                        "entry_id": "145da7c9-408d-378d-b7b8-e3b6c2d51ee0",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "ква́рцах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96c08021-d395-39e1-adf8-21dffebbd46b",
                        "entry_id": "145da7c9-408d-378d-b7b8-e3b6c2d51ee0",
                        "glosses": [
                            "породообразующий минерал, диоксид кремния"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4ef7cd4-547d-42ca-9660-63d351c2d37e",
                                "sense_id": "96c08021-d395-39e1-adf8-21dffebbd46b",
                                "text": "Кварц — один из самых рапространённых в земной коре минералов."
                            },
                            {
                                "example_id": "66d4b52a-f775-4903-986f-a7e342364a40",
                                "sense_id": "96c08021-d395-39e1-adf8-21dffebbd46b",
                                "text": "Из кварца делают химическую посуду, а из его натечных форм — агата и яшмы — камни для часов и чувствительных приборов."
                            },
                            {
                                "example_id": "7f16f1bf-25f2-4de7-8dfc-e323004367e1",
                                "sense_id": "96c08021-d395-39e1-adf8-21dffebbd46b",
                                "text": "Полупрозрачный нерегулярный хрусталь называется кварц."
                            },
                            {
                                "example_id": "56155d84-037f-4387-8ffa-7a353da30d12",
                                "sense_id": "96c08021-d395-39e1-adf8-21dffebbd46b",
                                "text": "Весь двор был завален кучками золотоносного кварца, добытого рабочими."
                            }
                        ]
                    },
                    {
                        "sense_id": "7944a548-e409-33f9-840e-1a79146e74fc",
                        "entry_id": "145da7c9-408d-378d-b7b8-e3b6c2d51ee0",
                        "glosses": [
                            "перен., , разг. то же, что кварцевый резонатор"
                        ],
                        "tags": [
                            "радиотехн."
                        ],
                        "examples": [
                            {
                                "example_id": "06f04217-cf42-41d6-94b3-d1204434d558",
                                "sense_id": "7944a548-e409-33f9-840e-1a79146e74fc",
                                "text": "Читал, что на кварц с обеих строн надо кондёры вешать, иначе плохо заводится."
                            }
                        ]
                    },
                    {
                        "sense_id": "2f909d87-96da-398d-9b1b-e0fbcee0a268",
                        "entry_id": "145da7c9-408d-378d-b7b8-e3b6c2d51ee0",
                        "glosses": [
                            "перен., , разг. то же, что кварцевая лампа"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f68e0979-b2b2-3e9a-a4b7-4b664e6f6bcb",
                        "entry_id": "145da7c9-408d-378d-b7b8-e3b6c2d51ee0",
                        "glosses": [
                            "перен., мед. то же, что кварцевание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab96794c-369e-43c9-a8b2-1dba0419bd35",
                                "sense_id": "f68e0979-b2b2-3e9a-a4b7-4b664e6f6bcb",
                                "text": "Терапевт назначил мне тубусный кварц носа и зева."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10012b12-4d32-425e-bd10-a5459f0ef952",
                        "source_entry_id": "145da7c9-408d-378d-b7b8-e3b6c2d51ee0",
                        "source_sense_description": "минерал",
                        "target_lang_word": "quartz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quartz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3412148b-c48f-3676-a627-930d5606e40a",
                                        "entry_id": "d8db71e1-f36c-3e8f-a352-058498d2bf42",
                                        "glosses": [
                                            "The most abundant mineral on the earth's surface, of chemical composition silicon dioxide, SiO₂. It occurs in a variety of forms, both crystalline and amorphous. Found in every environment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e59ddde1-d3f5-4d7a-b092-b2550b761f34",
                                                "sense_id": "3412148b-c48f-3676-a627-930d5606e40a",
                                                "text": "The telescope and collimator have each an object-glass consisting of a single lens of quartz 1½ inch diameter and a focal length of 18½ inches for the sodium yellow light, but not more than 16 inches for the highest rays measured."
                                            },
                                            {
                                                "example_id": "d047abc9-5a79-40e7-8546-aea3fb2f54b2",
                                                "sense_id": "3412148b-c48f-3676-a627-930d5606e40a",
                                                "text": "Subsequently, the old Malay brought him the present specimen in a state of torpidity, telling him he had found it in a cavity of the quartz reef."
                                            },
                                            {
                                                "example_id": "07799cd9-666e-4635-a24b-bc4340a39776",
                                                "sense_id": "3412148b-c48f-3676-a627-930d5606e40a",
                                                "text": "My meat eats me. Who waits at the gate? / Mother of quartz, your words writhe into my ear. / Renew the light, lewd whisper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8cf96da-1039-3a4d-b998-c0ef82e9b45c",
                                        "entry_id": "d8db71e1-f36c-3e8f-a352-058498d2bf42",
                                        "glosses": [
                                            "Crystal meth: methamphetamine hydrochloride."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43b038bc-f8b1-4086-85d8-35e90bca9d0b",
                        "source_entry_id": "145da7c9-408d-378d-b7b8-e3b6c2d51ee0",
                        "source_sense_description": "минерал",
                        "target_lang_word": "石英",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "石英",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "d771391d-2789-3156-84ee-01d6a47dc56c",
                                        "entry_id": "e23c6006-95a2-3ace-9a66-04b97b4eb68d",
                                        "glosses": [
                                            "由二氧化硅组成的矿物，为半透明或不透明的晶体。颜色一般为乳白色，质地坚硬"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f00fe388-bde4-4cdf-97d1-a53216c2de67",
                        "source_entry_id": "145da7c9-408d-378d-b7b8-e3b6c2d51ee0",
                        "source_sense_description": "минерал",
                        "target_lang_word": "Quarz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quarz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "125b8009-f3cf-3e5b-9d33-daea9727b95e",
                                        "entry_id": "b3d0d0f7-7457-389b-84f6-69b45d1707cf",
                                        "glosses": [
                                            "Mineral, das in reinem Zustand farblos und durchscheinend ist und aus Siliziumdioxid besteht"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53e49f34-d7eb-495f-bb40-c6ef05cfaa49",
                                                "sense_id": "125b8009-f3cf-3e5b-9d33-daea9727b95e",
                                                "text": "Quarz ist eines der häufigsten Mineralien in der Erdkruste."
                                            },
                                            {
                                                "example_id": "63f3de0b-9f65-45a8-971c-c1cefbe4f66f",
                                                "sense_id": "125b8009-f3cf-3e5b-9d33-daea9727b95e",
                                                "text": "„Es war keine geringe Arbeit, vor dem Aufkleben der Etiketten die Namen der Gesteine festzustellen; die Verschiedenheit der Farben und des Korns ließ sie Tonerde und Mergel, Granit und Gneis, Quarz und Kalkstein verwechseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5946d10c-9ae0-3f2d-9770-2345039eafd9",
                                        "entry_id": "b3d0d0f7-7457-389b-84f6-69b45d1707cf",
                                        "glosses": [
                                            "Kristall aus Quarz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2ae25b-562f-4709-ae51-cda1cfd2e5cc",
                                                "sense_id": "5946d10c-9ae0-3f2d-9770-2345039eafd9",
                                                "text": "„Reiner Quarz ist vollkommen transparent und farblos und wird, wenn er gut ausgebildete Kristalle entwickelt, als Bergkristall bezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "633c3655-289e-3a31-bee8-5a388ad9ef8e",
                                        "entry_id": "b3d0d0f7-7457-389b-84f6-69b45d1707cf",
                                        "glosses": [
                                            "Elektronisches Bauelement; ein speziell geschnittener Quarzkristall mit angebrachten Elektroden, dessen piezoelektrische Eigenschaften zur Frequenzstabilisierung elektrischer Schwingungen benutzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "312e8257-9a47-47bd-8d98-09cc4a81dd1f",
                                                "sense_id": "633c3655-289e-3a31-bee8-5a388ad9ef8e",
                                                "text": "„Die piezoelektrischen Eigenschaften des Quarzes werden bei Schwingquarzen ausgenutzt, die ähnlich einer Stimmgabel bei Erregung durch eine elektrische Spannung mit einer festen Frequenz mechanisch schwingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
