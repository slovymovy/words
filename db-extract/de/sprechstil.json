                    },
                    {
                        "translation_id": "1d03d9b7-5e6c-4b06-b844-e04e4c69fc6c",
                        "source_entry_id": "4424f014-ebcd-3bcf-ae76-7c57195550ff",
                        "source_sense_id": "6d0bec6c-a3b2-3d09-9b9c-1e5ed95ec83d",
                        "source_sense_description": "Art und Weise, sich mündlich auszudrücken",
                        "target_lang_word": "façon de parler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "façon de parler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2aff4fb-7ae8-3204-be9f-2acbdea0380a",
                                        "entry_id": "b65d8473-235b-3591-ad4c-34478d7396b0",
                                        "glosses": [
                                            "Manière dont on s’exprime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3930453-5516-4d2d-a63d-11a6b5371cbc",
                                                "sense_id": "f2aff4fb-7ae8-3204-be9f-2acbdea0380a",
                                                "text": "Vos façons de parler me font tant de plaisir que j’en oublie presque ce que j’ai à vous dire."
                                            },
                                            {
                                                "example_id": "cbe963a5-9323-4ad2-9f6b-a0f17de7befd",
                                                "sense_id": "f2aff4fb-7ae8-3204-be9f-2acbdea0380a",
                                                "text": "Sa façon de parler infantilisante me tapait sur les nerfs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c1937f2-5d71-3d46-b8ac-580f3da58c79",
                                        "entry_id": "b65d8473-235b-3591-ad4c-34478d7396b0",
                                        "glosses": [
                                            "Phrase, locution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3be176b7-81f7-480e-a95e-fea043d589e3",
                                                "sense_id": "3c1937f2-5d71-3d46-b8ac-580f3da58c79",
                                                "text": "Ce sont façons de parler obligeantes de ce pays-là."
                                            },
                                            {
                                                "example_id": "ab525c39-776b-4283-9213-c5aab57e3664",
                                                "sense_id": "3c1937f2-5d71-3d46-b8ac-580f3da58c79",
                                                "text": "Le lendemain, à l’aube, nous nous mettons en marche — en marche est ici une façon de parler — car nous nous faisons tout bourgeoisement transporter en chemin de fer jusqu’à La Neuveville, où nous redeviendrons piétons."
                                            },
                                            {
                                                "example_id": "4da5704d-a1e4-4a76-ae09-d8d30e342984",
                                                "sense_id": "3c1937f2-5d71-3d46-b8ac-580f3da58c79",
                                                "text": "— Tu connais Marc Brancion ?\n— Non.\n— Enfin, c’est une façon de parler.\nC’était une façon de parler, en effet : on connaît les héros. Autrefois, on les voyait sur la place publique, maintenant, on les voit et les entend dans les cinémas. Et bientôt, par la télévision, leur recès le plus intime sera de verre ; alors régnera une totale fraternité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb04e2d1-cd48-3cd8-b3b9-07e537f60105",
                                        "entry_id": "b65d8473-235b-3591-ad4c-34478d7396b0",
                                        "glosses": [
                                            "Parole qui ne doit pas être prise à la rigueur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64124057-dd24-43ff-8ca2-6e459bb6472b",
                                                "sense_id": "eb04e2d1-cd48-3cd8-b3b9-07e537f60105",
                                                "text": "Vous n’avez regardé cet engagement que comme une façon de parler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
