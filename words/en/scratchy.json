{
    "word_family": [
        "scratch"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0e43d2e9-9d10-3608-8941-03f10be5bb2e",
                    "sense_definition": "Causing an itchy or uncomfortable feeling on the skin, often due to rough fabric.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This wool sweater is very <w>scratchy</w> against my neck.",
                            "target_lang_translations": {
                                "ru": "Этот шерстяной свитер очень <w>колючий</w> и неприятно ощущается на шее."
                            }
                        },
                        {
                            "text": "I cannot wear this shirt because the material feels too <w>scratchy</w>.",
                            "target_lang_translations": {
                                "ru": "Я не могу носить эту рубашку, потому что материал кажется слишком <w>колючим</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "itchy",
                        "rough"
                    ],
                    "antonyms": [
                        "smooth",
                        "soft"
                    ],
                    "common_phrases": [
                        "scratchy sweater",
                        "scratchy fabric"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий зуд или неприятные ощущения на коже, часто из-за грубой ткани."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колючий",
                                "target_lang_sense_clarification": "о ткани или одежде, которая раздражает кожу"
                            },
                            {
                                "target_lang_word": "царапающий",
                                "target_lang_sense_clarification": "о материале, который неприятно трется о кожу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c013a54-8d50-3793-9ac2-6c22c7e2b9e4",
                    "sense_definition": "Having poor sound quality with static or interference.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radio signal was so <w>scratchy</w> that I could barely hear the news.",
                            "target_lang_translations": {
                                "ru": "Радиосигнал был таким <w>трещащим</w>, что я едва слышал новости."
                            }
                        },
                        {
                            "text": "We listened to a <w>scratchy</w> recording of the old telephone call.",
                            "target_lang_translations": {
                                "ru": "Мы слушали <w>запись с помехами</w> старого телефонного разговора."
                            }
                        }
                    ],
                    "synonyms": [
                        "static-filled",
                        "noisy"
                    ],
                    "antonyms": [
                        "clear"
                    ],
                    "common_phrases": [
                        "scratchy sound",
                        "scratchy recording"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий плохое качество звука с помехами или треском."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с помехами",
                                "target_lang_sense_clarification": "о звуке с шумами или искажениями"
                            },
                            {
                                "target_lang_word": "трещащий",
                                "target_lang_sense_clarification": "о звуке, сопровождающемся треском"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e83ecfe5-766d-3ae4-ac22-f9d9cf1bdf62",
                    "sense_definition": "Producing crackling noises due to damage or wear on a record.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old vinyl record sounded <w>scratchy</w> after years of use.",
                            "target_lang_translations": {
                                "ru": "Старая виниловая пластинка <w>потрескивала</w> после многих лет использования."
                            }
                        },
                        {
                            "text": "She enjoyed the <w>scratchy</w> charm of the vintage jazz album.",
                            "target_lang_translations": {
                                "ru": "Ей нравилось <w>потрескивающее</w> очарование винтажного джазового альбома."
                            }
                        }
                    ],
                    "synonyms": [
                        "crackly"
                    ],
                    "common_phrases": [
                        "scratchy record"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издающий потрескивающие звуки из-за повреждений или износа пластинки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потрескивающий",
                                "target_lang_sense_clarification": "о звуке старой виниловой пластинки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f15675d8-56f4-32cc-9d71-ec1ea49c2f27",
                    "sense_definition": "Easily annoyed or in a bad mood.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been feeling a bit <w>scratchy</w> since he missed his morning coffee.",
                            "target_lang_translations": {
                                "ru": "Он чувствует себя немного <w>раздражительным</w> с тех пор, как пропустил утренний кофе."
                            }
                        },
                        {
                            "text": "Do not get <w>scratchy</w> with me just because you had a long day.",
                            "target_lang_translations": {
                                "ru": "Не <w>ворчи</w> на меня только потому, что у тебя был тяжелый день."
                            }
                        }
                    ],
                    "synonyms": [
                        "irritable",
                        "cranky",
                        "tetchy"
                    ],
                    "antonyms": [
                        "cheerful",
                        "calm"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко раздражающийся или находящийся в плохом настроении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражительный",
                                "target_lang_sense_clarification": "о человеке, который легко выходит из себя"
                            },
                            {
                                "target_lang_word": "ворчливый",
                                "target_lang_sense_clarification": "о человеке в плохом настроении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "973b8578-fef9-3dc1-8caf-6de6e64ddb55",
                    "sense_definition": "Marked by or covered in scratches.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The table surface looked <w>scratchy</w> after the cat jumped on it.",
                            "target_lang_translations": {
                                "ru": "Поверхность стола выглядела <w>поцарапанной</w> после того, как на него запрыгнул кот."
                            }
                        },
                        {
                            "text": "He tried to polish the <w>scratchy</w> glass of his old watch.",
                            "target_lang_translations": {
                                "ru": "Он пытался отполировать <w>поцарапанное</w> стекло своих старых часов."
                            }
                        }
                    ],
                    "synonyms": [
                        "scratched"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый царапинами или имеющий следы царапин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поцарапанный",
                                "target_lang_sense_clarification": "имеющий повреждения в виде царапин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}