                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deszcz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Od samego rana z ciemnego nieba bez przerwy drobno <w>siało</w>.",
                            "target_lang_translations": {
                                "ru": "С самого утра с тёмного неба непрерывно <w>моросило</w>."
                            }
                        },
                        {
                            "text": "Za oknem chłodny deszcz <w>siał</w> na szyby przez wiele godzin.",
                            "target_lang_translations": {
                                "ru": "За окном холодный дождь <w>сеял</w> в стёкла много часов подряд."
                            }
