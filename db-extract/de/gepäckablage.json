                "senses": [
                    {
                        "sense_id": "09c6e5d1-1a09-3faf-a55c-05ee6b97e48f",
                        "entry_id": "ff9dd66b-16f0-3d36-9295-e62bb0447762",
                        "glosses": [
                            "Platz zum Abstellen von Reisetaschen oder Koffern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb805dd8-71eb-4d60-992a-56c049b6a482",
                                "sense_id": "09c6e5d1-1a09-3faf-a55c-05ee6b97e48f",
                                "text": "Die Gepäckablage sollte bewacht werden."
                            },
                            {
                                "example_id": "6f71064f-6fff-47be-8ab3-7322a1af6ab8",
                                "sense_id": "09c6e5d1-1a09-3faf-a55c-05ee6b97e48f",
                                "text": "„Der Bus hielt um Viertel vor neun in Fort Stockton, und Moss stand auf, lüpfte seine Tasche von der Gepäckablage, nahm den Aktenkoffer vom Sitz und blickte auf Carla Jean herab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "403b5b2f-7ff9-42ca-84d2-80ddc580f67d",
                        "source_entry_id": "ff9dd66b-16f0-3d36-9295-e62bb0447762",
                        "source_sense_id": "09c6e5d1-1a09-3faf-a55c-05ee6b97e48f",
                        "source_sense_description": "Platz zum Abstellen von Reisetaschen oder Koffern",
                        "target_lang_word": "luggage rack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luggage rack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a55ff814-d950-33c1-9593-e66ec3217bc1",
                                        "entry_id": "df7fd68a-23f2-3198-9f80-99e1b6e270b4",
                                        "glosses": [
                                            "A rack attached to a car or other vehicle, used to hold luggage or similar items."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "369d71cc-69b5-4416-b573-e3ff9883724d",
                                                "sense_id": "a55ff814-d950-33c1-9593-e66ec3217bc1",
                                                "text": "Third-class carriages are grossly overcrowded, with passengers lying on the luggage racks, standing between the benches, and occasionally even riding on the footboards and clinging to the outsides of the coaches for short distances."
                                            },
                                            {
                                                "example_id": "f1cc0f04-21d9-472f-b076-ded71b32cfd3",
                                                "sense_id": "a55ff814-d950-33c1-9593-e66ec3217bc1",
                                                "text": "[…] and the neat reading lamps on the underside of the luggage racks, under passenger control, are an attractive feature of the first class compartments."
                                            },
                                            {
                                                "example_id": "a05a4de1-c275-49f2-9448-aad662d1e3e5",
                                                "sense_id": "a55ff814-d950-33c1-9593-e66ec3217bc1",
                                                "text": "Above each seat was 'an ormolu luggage rack with finely chased ornamentation and panels of brass treillage'."
                                            },
                                            {
                                                "example_id": "65f8e794-0c45-49bc-a3ff-b5a2a65de011",
                                                "sense_id": "a55ff814-d950-33c1-9593-e66ec3217bc1",
                                                "text": "As do the coaches, these sleeping cars have a large luggage rack located on the lower level of the car where you enter."
                                            },
                                            {
                                                "example_id": "9e08a350-2420-4283-84c9-92f817be592c",
                                                "sense_id": "a55ff814-d950-33c1-9593-e66ec3217bc1",
                                                "text": "Many seats carry reservation labels, while the luggage racks are festooned with backpacks and suitcases."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4ca25e3-1e8f-4058-9cd1-1d21719c8b7c",
                        "source_entry_id": "ff9dd66b-16f0-3d36-9295-e62bb0447762",
