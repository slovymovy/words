{
    "word_family": [
        "abdominal",
        "abdominally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a419c164-8326-3fec-88ce-9b74d6a3157c",
                    "sense_definition": "The belly, or that part of the vertebrate body between the thorax and the pelvis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient complained of severe pain in his lower <w>abdomen</w>.",
                            "target_lang_translations": {
                                "ru": "Пациент жаловался на сильную боль внизу <w>живота</w>."
                            }
                        },
                        {
                            "text": "He felt a sharp discomfort across his <w>abdomen</w> after lifting the heavy box.",
                            "target_lang_translations": {
                                "ru": "После подъёма тяжёлой коробки он почувствовал резкий дискомфорт в <w>животе</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "belly",
                        "stomach"
                    ],
                    "common_phrases": [
                        "lower abdomen",
                        "upper abdomen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Живот, часть тела позвоночных между грудной клеткой и тазом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живот",
                                "target_lang_sense_clarification": "передняя часть тела"
                            },
                            {
                                "target_lang_word": "брюхо",
                                "target_lang_sense_clarification": "разг. или анатомическое у животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5ffdcc6-eb5f-34ed-abf6-9df2dbfda906",
                    "sense_definition": "The abdominal cavity containing the digestive organs, lined by the peritoneum.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon examined the organs inside the <w>abdomen</w> for internal bleeding.",
                            "target_lang_translations": {
                                "ru": "Хирург осмотрел органы внутри <w>брюшной полости</w> на предмет внутреннего кровотечения."
                            }
                        },
                        {
                            "text": "Fluid had accumulated in the patient's <w>abdomen</w> due to the infection.",
                            "target_lang_translations": {
                                "ru": "Из-за инфекции в <w>брюшной полости</w> пациента скопилась жидкость."
                            }
                        }
                    ],
                    "synonyms": [
                        "ventrum"
                    ],
                    "target_lang_definitions": {
                        "ru": "Брюшная полость, выстланная брюшиной и содержащая органы пищеварения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брюшная полость",
                                "target_lang_sense_clarification": "анатомическая полость тела"
                            },
                            {
                                "target_lang_word": "живот",
                                "target_lang_sense_clarification": "внутренности брюшной полости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1e5962f-e54d-34f8-9bb7-b790dcae313d",
                    "sense_definition": "The posterior section of the body behind the thorax in insects and other arthropods.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A bee has three main body sections: the head, thorax, and <w>abdomen</w>.",
                            "target_lang_translations": {
                                "ru": "Тело пчелы состоит из трёх основных отделов: головы, груди и <w>брюшка</w>."
                            }
                        },
                        {
                            "text": "The wasp carried a yellow pattern along its segmented <w>abdomen</w>.",
                            "target_lang_translations": {
                                "ru": "На членистом <w>брюшке</w> осы был жёлтый узор."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Задний отдел тела членистоногих, расположенный позади груди."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брюшко",
                                "target_lang_sense_clarification": "у насекомых и других членистоногих"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfb500c0-5ac1-33b0-bb06-40c6a9c08951",
                    "sense_definition": "The fat surrounding the belly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor noted an accumulation of thick <w>abdomen</w> around the waistline.",
                            "target_lang_translations": {
                                "ru": "Врач отметил скопление плотного <w>жира</w> вокруг талии."
                            }
                        },
                        {
                            "text": "His diet helped reduce the excess <w>abdomen</w> that had formed over years.",
                            "target_lang_translations": {
                                "ru": "Диета помогла убрать лишний <w>живот</w>, образовавшийся за долгие годы."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically to describe abdominal fat"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жировые отложения в области живота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брюшной жир",
                                "target_lang_sense_clarification": "жир в области живота"
                            },
                            {
                                "target_lang_word": "живот",
                                "target_lang_sense_clarification": "жировые отложения на животе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}