                                    {
                                        "sense_id": "7fe17a77-f757-393f-bc76-b227cae4ecb9",
                                        "entry_id": "f546386e-79c7-3f4b-bc44-3a5bc869a57e",
                                        "glosses": [
                                            "That settles something (such as an argument) definitely and conclusively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "704f4f86-def3-4959-8a44-0b825c3fcbae",
                                                "sense_id": "7fe17a77-f757-393f-bc76-b227cae4ecb9",
                                                "text": "‘Yes,’ said Dick, with such a clinching period at the end that it seemed he was never going to add another word."
                                            },
                                            {
                                                "example_id": "daf5ff6b-d348-495a-8281-efa6fc36f77c",
                                                "sense_id": "7fe17a77-f757-393f-bc76-b227cae4ecb9",
                                                "text": "There were no dreams,\nNo phantoms in her future any more:\nOne clinching revelation of what was\nOne by-flash of irrevocable chance,\nHad acridly but honestly foretold\nThe mystical fulfilment of a life\nThat might have once … But that was all gone by"
                                            },
                                            {
                                                "example_id": "07888cc9-322d-4bd9-abe2-0a07f59d02e9",
                                                "sense_id": "7fe17a77-f757-393f-bc76-b227cae4ecb9",
                                                "text": "He shocked his hearers by urging them not to fast during Ramadan, which begins Feb. 29. As a clinching argument, Bourguiba recalled that even Mohammed, when inconveniently overtaken by Ramadan on his march to Mecca, counseled his soldiers: “Break the fast, and you will be stronger to confront the enemy.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clinching",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "632787fa-3689-31f0-bdbf-80fd39c8cf11",
                                        "entry_id": "b351b15f-a902-3ac4-9917-77a81274ff2e",
                                        "glosses": [
                                            "A clinch; a passionate embrace."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cd97c56-44c6-4407-9331-142f0ac76722",
                                                "sense_id": "632787fa-3689-31f0-bdbf-80fd39c8cf11",
                                                "text": "Though there are no kissings and clinchings, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faeac6cd-cb66-3e5e-978f-7a314ed1f1a6",
                                        "entry_id": "b351b15f-a902-3ac4-9917-77a81274ff2e",
                                        "glosses": [
                                            "A making certain or finalizing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "004136f7-a9d7-49a2-82c5-ad40a7e6599b",
                                                "sense_id": "faeac6cd-cb66-3e5e-978f-7a314ed1f1a6",
                                                "text": "Only six weeks into the season, the top-ranked Bulldogs were undefeated at 60, but more important to Louisiana Tech was one of the earliest clinchings of a conference title in the annals of college football."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3d312a4-467f-3625-8eff-b25ccc8aec66",
                                        "entry_id": "b351b15f-a902-3ac4-9917-77a81274ff2e",
                                        "glosses": [
                                            "The distortion of computer tape by wrinkling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594c80f3-fecf-4aca-bea7-9a08a68aea5f",
                                                "sense_id": "a3d312a4-467f-3625-8eff-b25ccc8aec66",
                                                "text": "This “clinching” can distort the tape by causing a series of creases or folds in the surface and may produce read errors."
                                            },
                                            {
                                                "example_id": "4a2c715d-c392-4b8c-a2e2-7f9e95a17869",
                                                "sense_id": "a3d312a4-467f-3625-8eff-b25ccc8aec66",
                                                "text": "Computer magnetic tape is designed primarily for its storage capacity, speed, and capacity to be repeatedly erased and written over. […] Bad binder can cause holes in the oxide, loose particles, or clinching of tape."
                                            }
                                        ]
                                    }
                                ]
                            }
