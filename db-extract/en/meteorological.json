                    },
                    {
                        "translation_id": "23ec821e-b363-411d-86f7-bc08c7d0d15b",
                        "source_entry_id": "aee70443-00e1-3077-9cb5-bc0c1faabbfa",
                        "source_sense_id": "5451466d-6336-38f8-b92b-fc42c2bb8989",
                        "source_sense_description": "relating to meteorology",
                        "target_lang_word": "meteorologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meteorologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b04608a9-ca4e-3834-bc66-9f3111f0bfe4",
                                        "entry_id": "2beb47bb-fd0d-3486-8939-b6dbc801afe0",
                                        "glosses": [
                                            "die Wissenschaft vom Wetter (Meteorologie) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a6e213a-ba09-4e56-a810-55f67551d39c",
                                                "sense_id": "b04608a9-ca4e-3834-bc66-9f3111f0bfe4",
                                                "text": "Einfachstes meteorologisches Modell und zugleich die erste Bewährungsprobe für alle neuentwickelten Modelle zur Wettervorhersage ist die simple Übertragung des aktuellen Wetters auf die Zukunft."
                                            },
                                            {
                                                "example_id": "fee1d463-34c4-427b-b921-4904d4878268",
                                                "sense_id": "b04608a9-ca4e-3834-bc66-9f3111f0bfe4",
                                                "text": "Meteorologisch sind drei Faktoren für die Sturmflut [in 1962 in Hamburg] verantwortlich: „Die Tiden waren günstig. Dann hat der Wind ordentlich geblasen, wenngleich auch nicht exzeptionell, er hat aus der richtigen Richtung geblasen. Und dann war da auch noch ein Beitrag von dem Nordatlantik mit dabei, der durch andere Wettergeschehnisse vorher in die Nordsee gebracht wurde.“"
                                            },
                                            {
                                                "example_id": "fd779156-01d2-4bff-ad40-6bd3e4efb68b",
                                                "sense_id": "b04608a9-ca4e-3834-bc66-9f3111f0bfe4",
                                                "text": "Meteorologisch passiert es nur zwei bis drei Mal im Monat, dass eine Luftmasse vom Gardasee die Alpen herüberkraxelt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a36f6c0-f17f-3430-a0e1-d515b64119f5",
                                        "entry_id": "2beb47bb-fd0d-3486-8939-b6dbc801afe0",
                                        "glosses": [
                                            "die Atmosphäre der Erde und ihre Veränderungen (Wetter) betreffend; wettermäßig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0eedaa5b-0730-4221-a662-adb9d52bed45",
                                                "sense_id": "7a36f6c0-f17f-3430-a0e1-d515b64119f5",
                                                "text": "In diesem Jahr gab es nicht nur Hunderte Tote und massive Schäden; reihenweise wurden auch meteorologische Rekorde gebrochen. […] Je nach Weltregion werden die meteorologisch gleichen Stürme unterschiedlich genannt (siehe Sturmkunde)."
                                            },
                                            {
                                                "example_id": "01504daa-383b-48ad-89bf-bffa2f79e84c",
                                                "sense_id": "7a36f6c0-f17f-3430-a0e1-d515b64119f5",
                                                "text": "Es war in Guatemala, wo Wladimir Putin „wirklichen Schnee“ für Sotschi versprach. Das war 2007, und der russische Präsident holte mit seinem meteorologisch gewagten Versprechen die olympischen Winterspiele an die russische Schwarzmeerküste."
                                            },
                                            {
                                                "example_id": "ca06baed-0778-41fa-a052-655dee3fe458",
                                                "sense_id": "7a36f6c0-f17f-3430-a0e1-d515b64119f5",
                                                "text": "„Abendrot, Schönwetterbot – Morgenrot, schlecht Wetter droht.“ Gibt es einen meteorologischen Zusammenhang zwischen Abendrot, Morgenrot und dem Wetter?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
