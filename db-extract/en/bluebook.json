                    {
                        "sense_id": "81405257-17be-3f07-b7c7-06f1f3b8b60c",
                        "entry_id": "c01dd631-4b08-345f-b1fb-388dc347f1cd",
                        "glosses": [
                            "A blank booklet of lined paper used in the administration of examinations, so named because of its pale blue front and back covers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4380ddd5-0fef-46d1-b96d-daf9e06495ce",
                                "sense_id": "81405257-17be-3f07-b7c7-06f1f3b8b60c",
                                "text": "Bluebooks are designed to prevent cheating but sometimes they provide cover for cheaters when the student brings an extra blue book with notes, equations, dates, etc. (Wein 1)."
                            },
                            {
                                "example_id": "63fb4b9c-f017-40fd-bf26-25aaf1f7e5ad",
                                "sense_id": "81405257-17be-3f07-b7c7-06f1f3b8b60c",
                                "text": "The words you will eventually write in your exam bluebook will include the words you have learned by heart, but they will constitute only a portion of the analytical presentation you will develop."
                            },
                            {
                                "example_id": "324387aa-ffbf-4ff6-9e02-d5044dcca767",
                                "sense_id": "81405257-17be-3f07-b7c7-06f1f3b8b60c",
                                "text": "What should I bring to the exam? Are pens or bluebooks required? Is scratch paper supplied?"
                            }
                        ]
                    }
                ],
