                        "sense_id": "af55b342-0b54-3d3f-a4ff-e3ec7e988ced",
                        "entry_id": "b47e7a87-54ef-3b66-9c6d-8761857b3744",
                        "glosses": [
                            "The large animals of a given region or time, considered as a group."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1e1f601-710d-4525-8d4d-8333f72015f7",
                                "sense_id": "af55b342-0b54-3d3f-a4ff-e3ec7e988ced",
                                "text": "The extinction of the Pleistocene megafauna had ended there long before it had in Europe, and so a \"broad spectrum\" of food collecting had been going on for some time."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b1e93d3-7ebf-39ac-bb98-5233c042bf90",
                        "entry_id": "b47e7a87-54ef-3b66-9c6d-8761857b3744",
                        "glosses": [
                            "A treatise on such a group of large animals."
                        ],
                        "tags": [],
                        "examples": []
                    }
