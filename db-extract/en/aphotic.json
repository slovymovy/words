                                        "glosses": [
                                            "Se dit de la zone marine ou lacustre où l'intensité lumineuse résiduelle est nulle et la photosynthèse impossible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8bd0171-b26d-4f43-8809-002c16fa5d99",
                                                "sense_id": "f231deae-4a20-32a4-bb3b-a10afeb65952",
                                                "text": "Alors que l'industrie de la pêche se tourne désormais vers la zone aphotique de l'océan, entre 200 et 1000 mètres de profondeur, l'Homme pourrait consommer de plus en plus les mêmes poissons que l'éléphant de mer."
                                            }
                                        ]
                                    }
                                ]
