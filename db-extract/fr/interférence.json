        "fr-extract.jsonl": [
            {
                "entry_id": "40df162c-d4ee-364b-a270-a60bbe19b649",
                "word": "interférence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "828ac550-26ce-4488-8320-f331c179932d",
                        "entry_id": "40df162c-d4ee-364b-a270-a60bbe19b649",
                        "tags": [
                            "plural"
                        ],
                        "form": "interférences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2457a143-b8b7-3715-8d0d-c43df7eb528b",
                        "entry_id": "40df162c-d4ee-364b-a270-a60bbe19b649",
                        "glosses": [
                            "Phénomène dans lequel deux vibrations s’annulent en se superposant."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "96339e05-76cc-426b-9189-5f881fa226b2",
                                "sense_id": "2457a143-b8b7-3715-8d0d-c43df7eb528b",
                                "text": "Il faut noter aussi que Newton, après avoir découvert le phénomène d’interférences qu'on nomme depuis lors «les anneaux de Newton» avait tenté une fort intéressante synthèse du point de vue des ondes et de celui des corpuscules […]."
                            },
                            {
                                "example_id": "64405e24-6d46-4276-9b8e-298cf512b179",
                                "sense_id": "2457a143-b8b7-3715-8d0d-c43df7eb528b",
                                "text": "Deux vibrations mécaniques, par interférence, peuvent produire du repos. Le silence peut résulter de l’interférence de deux vibrations sonores. L’obscurité peut résulter de l’interférence de deux vibrations lumineuses."
                            }
                        ]
                    },
                    {
                        "sense_id": "07aa3b2c-a050-3810-9738-7caf59f939f5",
                        "entry_id": "40df162c-d4ee-364b-a270-a60bbe19b649",
                        "glosses": [
                            "Phénomène résultant de la superposition d’au moins deux oscillations ou ondes cohérentes de même nature et de fréquences égales ou voisines; ce phénomène se manifeste par une variation dans l’espace ou dans le temps de l’amplitude de la résultante des ondes ou oscillations superposées."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "66462c94-30b6-3f79-b17c-30ef9b243f97",
                        "entry_id": "40df162c-d4ee-364b-a270-a60bbe19b649",
                        "glosses": [
                            "Intervention d’un élément extérieur dans un problème, une situation, un processus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82635698-80fd-4e75-b3c9-861c4f7af3f9",
                                "sense_id": "66462c94-30b6-3f79-b17c-30ef9b243f97",
                                "text": "Savez-vous que j'ai, moi, des devoirs envers la France et, qu’en vertu de ces devoirs, je ne puis admettre l’interférence d’aucune puissance étrangère dans l’exercice des pouvoirs français ?"
                            },
                            {
                                "example_id": "d686f864-6fcb-42d1-91f6-6cf1b8cf9b37",
                                "sense_id": "66462c94-30b6-3f79-b17c-30ef9b243f97",
                                "text": "Pour nous, jusque là, l’interférence du religieux dans les questions féministes, c’était les courriers d’associations intégristes de lutte contre l’IVG que nous recevions dès que nous traitions du sujet !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7a8f79d-435f-4036-a6dc-095186f4fc24",
                        "source_entry_id": "40df162c-d4ee-364b-a270-a60bbe19b649",
                        "target_lang_word": "Interferenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Interferenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7492926-8e0e-3662-b976-d7c8ebc5f411",
                                        "entry_id": "9e26122b-ee45-3631-aa62-f48a288a4c56",
                                        "glosses": [
                                            "bestehender Konflikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f816819-3c06-4ac0-b9a8-058544425635",
                                                "sense_id": "f7492926-8e0e-3662-b976-d7c8ebc5f411",
                                                "text": "Wenn ich mich nicht entscheiden kann, was ich jetzt am liebsten täte, kann man von einer motivationalen Interferenz sprechen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "026127bf-dc60-3dc1-b68c-d54bdc179c24",
                                        "entry_id": "9e26122b-ee45-3631-aa62-f48a288a4c56",
                                        "glosses": [
                                            "Überlagerungserscheinung beim Zusammentreffen von Wellen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2f7690b-da15-43fc-973e-d9a9a1ec674f",
                                                "sense_id": "026127bf-dc60-3dc1-b68c-d54bdc179c24",
                                                "text": "Wenn zwei Wellen kohärent sind, ist die bei der Interferenz entstehende Welle stabil."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6101ce76-9ff6-34b3-a605-734309956503",
                                        "entry_id": "9e26122b-ee45-3631-aa62-f48a288a4c56",
                                        "glosses": [
                                            "Einfluss, den eine Sprache auf eine andere ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb521331-f91d-4626-bd74-1b597979db73",
                                                "sense_id": "6101ce76-9ff6-34b3-a605-734309956503",
                                                "text": "„Interferenzen zwischen zwei Sprachen [,] gibt es auf allen Ebenen, z.B. auch in Aussprache und Orthographie.“"
                                            },
                                            {
                                                "example_id": "86d3e082-5bf5-4c9a-9a86-dc50c47859d9",
                                                "sense_id": "6101ce76-9ff6-34b3-a605-734309956503",
                                                "text": "„In Bezug auf die sprachliche Interferenz richtet sich das Hauptinteresse auf das Problem des Zusammenspiels von strukturellen und nichtstrukturellen Faktoren, die solche Interferenz fördern oder hindern.“"
                                            },
                                            {
                                                "example_id": "9a1e0576-cbdb-4cdd-b072-d0124174bdb0",
                                                "sense_id": "6101ce76-9ff6-34b3-a605-734309956503",
                                                "text": "„Zu welcher Möglichkeit man auch immer neigen mag, Interferenzen schleichen sich allenthalben ein...“"
                                            },
                                            {
                                                "example_id": "01739cfe-e880-49bd-8ee5-4ff419f0a2e1",
                                                "sense_id": "6101ce76-9ff6-34b3-a605-734309956503",
                                                "text": "„Solche Mischformen, die während der Erwerbs zweier Sprachen auftreten, nennt man in der Spracherwerbsforschung Interferenzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ce43c6d7-2458-3b8f-aecc-f7303872efc2",
                                        "entry_id": "9e26122b-ee45-3631-aa62-f48a288a4c56",
                                        "glosses": [
                                            "falsche Analogien beim Erlernen einer neuen Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5517a5f9-e725-421e-9482-75db89533bd4",
                                                "sense_id": "ce43c6d7-2458-3b8f-aecc-f7303872efc2",
                                                "text": "„Beim Lernen fremder Sprachen wird die Interferenz mit linguistischen und lernpsychologischen Methoden untersucht.“"
                                            },
                                            {
                                                "example_id": "92ae5738-3e3b-4057-bff6-f34db84d136b",
                                                "sense_id": "ce43c6d7-2458-3b8f-aecc-f7303872efc2",
                                                "text": "„Die durch sprachliche Kontakte verschiedener Varietäten entstehenden Abweichungen (»Fehler«) werden als Interferenzen verstanden und beschrieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "502b246b-9b9b-31e7-a0df-bf9d7703ca04",
                                        "entry_id": "9e26122b-ee45-3631-aa62-f48a288a4c56",
                                        "glosses": [
                                            "Beeinflussung eines Gedächtnisinhalts durch einen anderen, zum Beispiel das Verwechseln von Begriffen, die im gleichen Kontext gelernt wurden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8514d484-7bf7-47d4-a8fd-91bcf94d7b8b",
                                                "sense_id": "502b246b-9b9b-31e7-a0df-bf9d7703ca04",
                                                "text": "Ein Deutschsprachiger, der Spanisch kann und dann versucht, Italienisch zu lernen, wird wohl unweigerlich auf Interferenzen stoßen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "3304a3d3-b3e4-3860-a995-ca5aa081dc3d",
                                        "entry_id": "9e26122b-ee45-3631-aa62-f48a288a4c56",
                                        "glosses": [
                                            "Einschränkung des Lebensraumes eines Individuums durch die Zunahme der Populationsdichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bdbd9cd-26b8-4848-9643-b6539e125c46",
                                                "sense_id": "3304a3d3-b3e4-3860-a995-ca5aa081dc3d",
                                                "text": "Wenn eine Art eine andere Art daran hindert, im gemeinsamen Lebensraum zu leben, spricht man von Interferenz."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
