                        "entry_id": "15300d15-f130-3be2-8c0d-6b8dece5c524",
                        "glosses": [
                            "To give or deliver false, fake, or misleading information to."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d6dc8e30-453b-40e6-80c4-770fcd798b56",
                                "sense_id": "abd437a6-8bac-3fc7-8181-201d489eddc7",
                                "text": "It is clear that the politician misinformed the public on the issue."
                            },
                            {
                                "example_id": "b762098f-6b88-4fca-9ec8-cb4c03b32b73",
                                "sense_id": "abd437a6-8bac-3fc7-8181-201d489eddc7",
                                "text": "Captain Renault: The waters? What waters? We're in the desert.\nRick: I was misinformed."
                            },
                            {
                                "example_id": "26104066-5069-4d44-af70-c5b785bf12bf",
                                "sense_id": "abd437a6-8bac-3fc7-8181-201d489eddc7",
                                "text": "Absences and silences can misinform readers just as effectively as more obvious devices."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f015fd85-6c81-4d0e-8ac2-e7798c8b322d",
