                ],
                "translations": [
                    {
                        "translation_id": "264c4b04-0f5e-4ec5-93bd-92d86668c2e1",
                        "source_entry_id": "fcf221d7-16ce-3a5d-bf17-984f3f89275b",
                        "source_sense_id": "4acaf5c4-1d1f-3aee-b578-b6263dd7ab00",
                        "target_lang_word": "Keramik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Keramik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74808052-81cb-3610-8711-5cb5c25834e7",
                                        "entry_id": "d1f0c4d9-855b-3a2b-a44d-244095a7ddf1",
                                        "glosses": [
                                            "mineralischer Werkstoff, aus dem unter anderem Gefäße oder Kunstgegenstände hergestellt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f37196af-fbe6-42da-909c-e58cfe69751c",
                                                "sense_id": "74808052-81cb-3610-8711-5cb5c25834e7",
                                                "text": "Keramik war einer der ersten Werkstoffe, die der Mensch für sich entdeckt hat."
                                            },
                                            {
                                                "example_id": "85a361d9-4446-4bd6-948e-632a30f220e7",
                                                "sense_id": "74808052-81cb-3610-8711-5cb5c25834e7",
                                                "text": "„Vor der Tat [hat] er zwei Messer gekauft, eines aus Metall und eines aus Keramik.“"
                                            },
                                            {
                                                "example_id": "e8b6d745-dffe-47c6-9ae8-3285b933d942",
                                                "sense_id": "74808052-81cb-3610-8711-5cb5c25834e7",
                                                "text": "[…] „die Platte [besteht] aus einer selbst entwickelten Keramik, die laut Tüftler drei Mal mehr Hitze als Stahl speichern soll.“"
                                            },
                                            {
                                                "example_id": "395bc45d-31f8-40f5-9009-ba2e823a7979",
                                                "sense_id": "74808052-81cb-3610-8711-5cb5c25834e7",
                                                "text": "„Knieprothesen bestehen komplett aus Chrom-Kobalt, da Titan oder Keramik für die Belastung im Knie nicht stabil genug wären.“"
                                            },
                                            {
                                                "example_id": "d3998669-c1bb-40cb-8fb3-371d2678a1bb",
                                                "sense_id": "74808052-81cb-3610-8711-5cb5c25834e7",
                                                "text": "[Schweizer Käsefondue:] „Zur Zubereitung benötigt man einen Topf aus Keramik oder Gusseisen und ein Rechaud.“"
                                            },
                                            {
                                                "example_id": "a9777b71-91ab-4839-b2d2-068234dfd010",
                                                "sense_id": "74808052-81cb-3610-8711-5cb5c25834e7",
                                                "text": "„In den Brennöfen wurde hauptsächlich Keramik hergestellt — auch das berühmte Wedgwood.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "65b19229-4f2a-3cb5-9ee6-6c883eff0a0e",
                                        "entry_id": "d1f0c4d9-855b-3a2b-a44d-244095a7ddf1",
                                        "glosses": [
                                            "aus einem keramischen Werkstoff hergestellte Produkte"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0dcf94-2771-479e-9cb2-fa8586771c56",
                                                "sense_id": "65b19229-4f2a-3cb5-9ee6-6c883eff0a0e",
                                                "text": "Im Museum wird derzeit Bunzlauer Keramik ausgestellt."
                                            },
                                            {
                                                "example_id": "90170bae-b200-4949-bbb8-6de533d61e71",
                                                "sense_id": "65b19229-4f2a-3cb5-9ee6-6c883eff0a0e",
                                                "text": "„In Grottaglie wird seit dem 16. Jahrhundert Keramik hergestellt.“"
                                            },
                                            {
                                                "example_id": "fe10d0e7-25ff-46a1-9ba6-43dcfd05a4eb",
                                                "sense_id": "65b19229-4f2a-3cb5-9ee6-6c883eff0a0e",
                                                "text": "„Mykenische Waffen, Schmuck und Keramik sind dagegen weniger ausdrucksvoll, stilistisch einfacher und von geringerer Farbqualität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3942fe40-1c05-339f-853e-3483095695d3",
                                        "entry_id": "d1f0c4d9-855b-3a2b-a44d-244095a7ddf1",
                                        "glosses": [
                                            "(einzelner) aus keramischem Werkstoff hergestellter Gegenstand, der künstlerisch oder kunsthandwerklich ausgearbeitet wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d962613-cea1-452d-8394-2abe98b15ace",
                                                "sense_id": "3942fe40-1c05-339f-853e-3483095695d3",
                                                "text": "Die Archäologen haben bei der Ausgrabung neben metallischen Schmuckgegenständen und Waffen auch Textilreste und allerlei Keramiken gefunden."
                                            },
                                            {
                                                "example_id": "bc7c4453-aaa6-4fb9-910b-303044807d3d",
                                                "sense_id": "3942fe40-1c05-339f-853e-3483095695d3",
                                                "text": "Die Venus von Dolní Věstonice ist eine der ältesten Keramiken."
                                            },
                                            {
                                                "example_id": "6a085807-ae28-48d9-88fd-cc86df091545",
                                                "sense_id": "3942fe40-1c05-339f-853e-3483095695d3",
                                                "text": "„Der tatsächliche Wert der Kunstsammlung des verstorbenen Picasso konnte am Ende nur geschätzt werden. \"Wir haben alles geordnet: zuerst die Gemälde, dann die Zeichnungen, […] dann die Keramiken und am Schluss die Skulpturen\", erzählt Bellet.“"
                                            },
                                            {
                                                "example_id": "476a9915-178c-40df-91e9-0d88a62d88ce",
                                                "sense_id": "3942fe40-1c05-339f-853e-3483095695d3",
                                                "text": "„Marescot besichtigte nun ihre Keramiken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "244cc5de-1d15-30e4-83c4-b49c12d07f29",
                                        "entry_id": "d1f0c4d9-855b-3a2b-a44d-244095a7ddf1",
                                        "glosses": [
                                            "Technik der Verarbeitung von keramischen Werkstoffen und Herstellung von keramischen Produkten als Handwerk oder Kunstform"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da4288a6-bc12-4d74-a106-1d2d9b676fee",
                                                "sense_id": "244cc5de-1d15-30e4-83c4-b49c12d07f29",
                                                "text": "[Margarete Heymann-Loebenstein:] „Ihr Name steht für avantgardistische Keramik und unternehmerisches Talent.“"
                                            },
                                            {
                                                "example_id": "8cfeb079-6b13-49b7-ad69-b758d23497c0",
                                                "sense_id": "244cc5de-1d15-30e4-83c4-b49c12d07f29",
                                                "text": "Die Künstlerin hat sich auf die klassische Keramik spezialisiert."
                                            },
                                            {
                                                "example_id": "e0beafb0-e583-40ba-9bee-459d08744e0a",
                                                "sense_id": "244cc5de-1d15-30e4-83c4-b49c12d07f29",
                                                "text": "Hugo ließ sich in der Keramik ausbilden."
                                            },
                                            {
                                                "example_id": "3fe1d523-15ed-467a-8485-8d8aa8e34439",
                                                "sense_id": "244cc5de-1d15-30e4-83c4-b49c12d07f29",
                                                "text": "„Maqsoodi, 63 Jahre alt, ist Künstlerin. Lange arbeitete sie mit Keramik, nun in Glas.“"
                                            },
                                            {
                                                "example_id": "1d77e113-6590-48e3-9d99-5b1da500c495",
                                                "sense_id": "244cc5de-1d15-30e4-83c4-b49c12d07f29",
                                                "text": "„Ihr künstlerischer Leiter Hans Molzberger, der an der Houston Baptist University Skulptur und Keramik lehrt, ist jetzt schon restlos begeistert von seinen Schülern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a5ae7b79-6aef-3c91-a14b-697c6705cc8b",
                                        "entry_id": "d1f0c4d9-855b-3a2b-a44d-244095a7ddf1",
                                        "glosses": [
                                            "Herstellung keramischer Produkte als Industriezweig"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93660507-fdaf-423a-9348-50471cd72b84",
                                                "sense_id": "a5ae7b79-6aef-3c91-a14b-697c6705cc8b",
                                                "text": "„Die Gewerkschaft deckt Berufe in den Branchen Bergbau, Chemie, Gas, Glas, Kautschuk, Keramik, Kunststoffe, Leder, Mineralöl, Papier, Pharma, Sanierung/Entsorgung, Steinkohle und Wasserwirtschaft ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
