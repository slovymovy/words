                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dolphinarium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f38ecbe-1f6b-3102-ac8f-bb10ba0d947f",
                                        "entry_id": "9d59b3df-f4d4-3e41-aa65-1a0703f8f85c",
                                        "glosses": [
                                            "An aquarium that houses dolphins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f7fa6bf-ecdd-4093-abe7-d02d93ba03ed",
                                                "sense_id": "1f38ecbe-1f6b-3102-ac8f-bb10ba0d947f",
                                                "text": "Within these dolphinaria there is a fluctuating population of approximately 57 dolphins."
                                            },
                                            {
                                                "example_id": "2c551996-a4ab-461e-ae29-b7e09632115d",
                                                "sense_id": "1f38ecbe-1f6b-3102-ac8f-bb10ba0d947f",
                                                "text": "The dolphinarium's scientific research results added to its international reputation and resulted in a 1992 award by the International Marine Animal Trainers Association (IMATA)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7d1fd89-94b3-421d-bd97-6089f3beab8b",
                        "source_entry_id": "535a23d5-b97b-33d3-bdcb-27f8301dec43",
                        "source_sense_id": "ebf9498b-f90d-3f4e-b7bf-dbcb9644aabd",
                        "target_lang_word": "delphinarium",
