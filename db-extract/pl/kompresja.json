                    {
                        "sense_id": "d007e0d5-ad9f-3d85-869b-99dd8cf8d2d1",
                        "entry_id": "f7d86ba6-0df8-3a54-b5ec-048f87f52909",
                        "glosses": [
                            "zagęszczenie, sprężenie czegoś, zmniejszenie, redukcja zajmowanej przez coś przestrzeni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "052a5087-497a-4fb1-9360-eeb0d2d03ac6",
                                "sense_id": "d007e0d5-ad9f-3d85-869b-99dd8cf8d2d1",
                                "text": "Kompresja gazów jest jedną z metod skraplania."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1d1982a0-11d8-3695-9765-37f32c8683c0",
                        "entry_id": "f7d86ba6-0df8-3a54-b5ec-048f87f52909",
                        "glosses": [
                            "operacja zakodowania danych w taki sposób aby zajmowały mniej bajtów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "134b84a0-a2fb-45ef-a2b4-d1fba79ea91d",
                                "sense_id": "1d1982a0-11d8-3695-9765-37f32c8683c0",
                                "text": "Kompresja stratna obrazu daje mniejsze pliki, ale kosztem jakości."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "af5d1789-cea9-35d2-b275-333a49bf2a3a",
                        "entry_id": "f7d86ba6-0df8-3a54-b5ec-048f87f52909",
                        "glosses": [
                            "wielkość ciśnienia sprężania silnika"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "198f434b-019d-4c2e-a19a-3140990995b9",
                                "sense_id": "af5d1789-cea9-35d2-b275-333a49bf2a3a",
                                "text": "Jeżeli kompresja jest w normie i zużywa niewiele oleju, to uszczelniacze możesz spróbować wymienić sam"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
