                        "examples": [
                            {
                                "example_id": "f07b3fc4-9189-4b4c-b523-86da43b55464",
                                "sense_id": "34fafd0e-ac37-3e25-b5a7-03f3d7f98fd5",
                                "text": "Maar juist die onherkenbaarheid is het punt. Omdat de jongens anoniem zijn, zien we alleen een algemeen daderprofiel: jonge jochies met capuchontruien."
                            },
                            {
                                "example_id": "8b9f4271-b41a-47d3-8d3d-f68b7991d1fd",
                                "sense_id": "34fafd0e-ac37-3e25-b5a7-03f3d7f98fd5",
                                "text": "Welke Zweden konden beschreven worden met hetzelfde daderprofiel en dezelfde achtergrond als de Appels en hoe zou je zulke mogelijke daders op kunnen sporen? Waren er inbraken in wapendepots voorgekomen in Zweden met zeg maar de specifieke geur van terrorisme? Ontegenzeggelijk spannende vragen."
                            }
                        ]
