                        "glosses": [
                            "Chêne à larges feuilles, dit aussi chêne-rouvre ou roure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb03490-8849-4a26-9097-38c4e4cd6791",
                                "sense_id": "acc00beb-05ff-3c77-8117-d93fc98bc17e",
                                "text": "La variété β est très-commune dans les forêts ; on la nomme durelin, chêne à larges feuilles ; elle a les glands presque sessiles, les feuilles glabres, larges ,à lobes peu profonds et arrondis."
                            },
                            {
                                "example_id": "9cb6723d-19f5-4547-b640-0ceb9aeb574c",
                                "sense_id": "acc00beb-05ff-3c77-8117-d93fc98bc17e",
                                "text": "Le chêne roure à longues feuilles, vulgairement le durelin , ou chêne mâle , ou chêne bâtard (Quercus robur plalyphylla , Lam)."
                            }
                        ]
                    }
