    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7d77a986-2dab-3517-b92b-fd1a3d4af3d4",
                    "sense_definition": "Brief, clear, and expressed using few words.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should always aim to provide a <w>succinct</w> explanation to the clients.",
                            "target_lang_translations": {
                                "ru": "Вам всегда следует стремиться давать клиентам <w>краткое</w> объяснение."
                            }
                        },
                        {
                            "text": "She gave a <w>succinct</w> answer that answered all our questions without wasting time.",
                            "target_lang_translations": {
                                "ru": "Она дала <w>лаконичный</w> ответ, который ответил на все наши вопросы, не теряя времени."
                            }
                        }
                    ],
                    "synonyms": [
                        "concise",
                        "brief",
                        "terse"
                    ],
                    "common_phrases": [
                        "succinct answer",
                        "succinct summary",
                        "succinct statement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткий, четкий и выраженный несколькими словами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лаконичный",
                                "target_lang_sense_clarification": "о речи или стиле"
                            },
                            {
                                "target_lang_word": "краткий",
                                "target_lang_sense_clarification": "недолгий, содержательный"
                            },
                            {
                                "target_lang_word": "сжатый",
                                "target_lang_sense_clarification": "изложенный концентрированно"
                            },
                            {
                                "target_lang_word": "ёмкий",
                                "target_lang_sense_clarification": "содержащий много смысла при малом объеме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daa822a1-e6e9-369e-979f-c73654b4dfd9",
                    "sense_definition": "Compressed or using an amount of space close to the mathematical minimum, especially in data structures.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>succinct</w> data structure allows efficient storage without decompression.",
                            "target_lang_translations": {
                                "ru": "<w>Лаконичная</w> структура данных позволяет эффективно хранить информацию без распаковки."
                            }
                        },
                        {
                            "text": "The computer scientist designed a <w>succinct</w> representation of the large tree.",
                            "target_lang_translations": {
                                "ru": "Ученый-информатик разработал <w>сжатое</w> представление большого дерева."
                            }
                        }
                    ],
                    "synonyms": [
                        "tight"
                    ],
                    "common_phrases": [
                        "succinct data structure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сжатый или занимающий объем памяти, близкий к математическому минимуму (в структурах данных)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лаконичный",
                                "target_lang_sense_clarification": "компактный в информационном смысле"
                            },
                            {
                                "target_lang_word": "сжатый",
                                "target_lang_sense_clarification": "оптимизированный по объему"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9aa9f689-f0d9-3522-99d9-de0ef303a475",
                    "sense_definition": "Girded or bound tightly around the body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler wore a <w>succinct</w> garment to move easily through the thick brush.",
                            "target_lang_translations": {
                                "ru": "Путешественник носил <w>подпоясанную</w> одежду, чтобы легко передвигаться через густой кустарник."
                            }
                        },
                        {
                            "text": "Her <w>succinct</w> belt held the heavy tunic closely in place.",
                            "target_lang_translations": {
                                "ru": "Её <w>тугой</w> пояс плотно удерживал тяжелую тунику на месте."
                            }
                        }
                    ],
                    "synonyms": [
                        "taut",
                        "tight"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно опоясанный или подпоясанный вокруг тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подпоясанный",
                                "target_lang_sense_clarification": "одежда, плотно прилегающая с помощью пояса"
                            },
                            {
                                "target_lang_word": "приподнятый",
                                "target_lang_sense_clarification": "утянутый или подтянутый ремнем"
                            }
                        ]
                    }
                }
            ]
        }
    ]
