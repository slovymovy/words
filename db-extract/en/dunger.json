                        "glosses": [
                            "A person employed to spread or transport dung."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "69b25ba3-4e79-40f8-a062-b77d6f8b9468",
                                "sense_id": "f5cdcd78-9a25-33bf-8fe2-a22448412226",
                                "text": "But I will bring over you Dungers with great Dung-Forks, who shall dung thee from off the earth, with thy great heap, as an abominable sin-dunghill."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4cf6187-33cf-37aa-bc40-f9707ad94da7",
