    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aad910cb-8aa7-3271-beb8-12557e6109ea",
                    "sense_definition": "Uczucie wielkiego zadowolenia, wesołości i satysfakcji, często objawiające się uśmiechem.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci skakały z <w>radości</w>, gdy zobaczyły prezenty pod choinką.",
                            "target_lang_translations": {
                                "ru": "Дети прыгали от <w>радости</w>, когда увидели подарки под ёлкой.",
                                "en": "The children jumped for <w>joy</w> when they saw the presents under the Christmas tree."
                            }
                        },
                        {
                            "text": "Jej twarz promieniała <w>radością</w> na wieść o sukcesie syna.",
                            "target_lang_translations": {
                                "ru": "Её лицо сияло <w>радостью</w> при известии об успехе сына.",
                                "en": "Her face beamed with <w>joy</w> at the news of her son's success."
                            }
                        }
                    ],
                    "synonyms": [
                        "wesołość",
                        "szczęście",
                        "rozradowanie",
                        "uciecha",
                        "zadowolenie"
                    ],
                    "antonyms": [
                        "smutek"
                    ],
                    "common_phrases": [
                        "skakać z radości",
                        "sprawiać radość",
                        "łzy radości",
                        "wybuch radości",
                        "okrzyk radości"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство большого удовольствия, внутреннего удовлетворения и веселья, часто сопровождающееся улыбкой.",
                        "en": "A feeling of great happiness, cheerfulness, and satisfaction, often shown by smiling."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радость",
                                "target_lang_sense_clarification": "чувство"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "joy",
                                "target_lang_sense_clarification": "feeling of happiness"
                            },
                            {
                                "target_lang_word": "delight",
                                "target_lang_sense_clarification": "great pleasure"
                            },
                            {
                                "target_lang_word": "gladness",
                                "target_lang_sense_clarification": "happiness or cheerfulness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "697efabe-309e-3c45-aeb6-96080d0250b0",
                    "sense_definition": "Osoba, rzecz lub zdarzenie będące źródłem zadowolenia i szczęścia.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wnuki są dla niej największą <w>radością</w> i sensem życia.",
                            "target_lang_translations": {
                                "ru": "Внуки для неё — самая большая <w>радость</w> и смысл жизни.",
                                "en": "Her grandchildren are her greatest <w>joy</w> and the meaning of her life."
                            }
                        },
                        {
                            "text": "Ten mały ogródek to moja jedyna <w>radość</w> na emeryturze.",
                            "target_lang_translations": {
                                "ru": "Этот маленький садик — моя единственная <w>радость</w> на пенсии.",
                                "en": "This little garden is my only <w>joy</w> in retirement."
                            }
                        }
                    ],
                    "synonyms": [
                        "szczęście",
                        "uciecha"
                    ],
                    "common_phrases": [
                        "być czyjąś radością"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, предмет или событие, являющиеся источником счастья и удовольствия.",
                        "en": "A person, thing, or event that is a source of happiness and satisfaction."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радость",
                                "target_lang_sense_clarification": "источник счастья"
                            },
                            {
                                "target_lang_word": "отрада",
                                "target_lang_sense_clarification": "утешение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "joy",
                                "target_lang_sense_clarification": "source of happiness"
                            },
                            {
                                "target_lang_word": "delight",
                                "target_lang_sense_clarification": "source of pleasure"
                            }
                        ]
                    }
                }
            ]
