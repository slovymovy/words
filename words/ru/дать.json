{
    "word_family": [
        "давать",
        "дача",
        "дарение",
        "даритель",
        "даровой",
        "дательный"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0aecb356-58a8-3e89-a2d4-b862a6ba6076",
                    "sense_definition": "переместить что-либо в руки или распоряжение кого-либо",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transfer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожалуйста, <w>дай</w> мне эту книгу.",
                            "target_lang_translations": {
                                "pl": "Proszę, <w>daj</w> mi tę książkę."
                            }
                        },
                        {
                            "text": "Он <w>дал</w> ей ключи от квартиры.",
                            "target_lang_translations": {
                                "pl": "On <w>dał</w> jej klucze do mieszkania."
                            }
                        }
                    ],
                    "synonyms": [
                        "предоставить"
                    ],
                    "antonyms": [
                        "взять",
                        "получить"
                    ],
                    "common_phrases": [
                        "дать руку",
                        "дать денег"
                    ],
                    "target_lang_definitions": {
                        "pl": "wręczyć, przekazać coś do rąk lub do dyspozycji kogoś"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dać",
                                "target_lang_sense_clarification": "przekazać, wręczyć coś komuś"
                            },
                            {
                                "target_lang_word": "podać",
                                "target_lang_sense_clarification": "podać coś do ręki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e7773c6-ecf8-3317-9736-936bdaf17639",
                    "sense_definition": "разрешать, не препятствовать совершению действия",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мама не <w>дала</w> мне пойти гулять вечером.",
                            "target_lang_translations": {
                                "pl": "Mama nie <w>pozwoliła</w> mi pójść na spacer wieczorem."
                            }
                        },
                        {
                            "text": "Шум не <w>дал</w> ему спокойно уснуть.",
                            "target_lang_translations": {
                                "pl": "Hałas nie <w>dał</w> mu spokojnie zasnąć."
                            }
                        }
                    ],
                    "synonyms": [
                        "позволить",
                        "разрешить"
                    ],
                    "common_phrases": [
                        "дать возможность",
                        "дать закончить"
                    ],
                    "target_lang_definitions": {
                        "pl": "pozwolić, umożliwić zrobienie czegoś, nie stawiać przeszkód"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dać",
                                "target_lang_sense_clarification": "pozwolić, umożliwić (np. dać pospać)"
                            },
                            {
                                "target_lang_word": "pozwolić",
                                "target_lang_sense_clarification": "zezwolić na coś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca5dc069-fb67-319f-a892-4214546570c6",
                    "sense_definition": "оценить чей-либо возраст по внешнему виду",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "estimation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На вид ему можно <w>дать</w> не больше тридцати лет.",
                            "target_lang_translations": {
                                "pl": "Z wyglądu można mu <w>dać</w> nie więcej niż trzydzieści lat."
                            }
                        },
                        {
                            "text": "Сколько лет ты <w>дашь</w> этой женщине?",
                            "target_lang_translations": {
                                "pl": "Ile lat <w>dałbyś</w> tej kobiecie?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "ocenić czyjś wiek na podstawie wyglądu"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dać",
                                "target_lang_sense_clarification": "ocenić wiek na tyle lat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b47fe24b-8169-38c4-ac6b-6346922141cd",
                    "sense_definition": "ударить, нанести физический удар",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хулиган хотел <w>дать</w> ему по лицу.",
                            "target_lang_translations": {
                                "pl": "Chuligan chciał mu <w>dać</w> w twarz."
                            }
                        },
                        {
                            "text": "Если ещё раз толкнёшь меня, я тебе так <w>дам</w>, что мало не покажется.",
                            "target_lang_translations": {
                                "pl": "Jeśli jeszcze raz mnie popchniesz, tak ci <w>dam</w>, że popamiętasz."
                            }
                        }
                    ],
                    "synonyms": [
                        "ударить"
                    ],
                    "common_phrases": [
                        "дать по морде",
                        "дать подзатыльник"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "uderzyć kogoś, wymierzyć cios"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dać",
                                "target_lang_sense_clarification": "uderzyć, wymierzyć cios (potocznie)"
                            },
                            {
                                "target_lang_word": "przywalić",
                                "target_lang_sense_clarification": "mocno uderzyć (potocznie)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35961254-0763-3ef1-939d-c2752a8dc305",
                    "sense_definition": "согласиться на половой акт",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sex",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она не <w>дала</w> ему на первом свидании.",
                            "target_lang_translations": {
                                "pl": "Nie <w>dała</w> mu na pierwszej randce."
                            }
                        },
                        {
                            "text": "Он хвастался, что она ему <w>дала</w>.",
                            "target_lang_translations": {
                                "pl": "Chwalił się, że mu <w>dała</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "вульгарный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "zgodzić się na odbycie stosunku seksualnego (wulgarnie/potocznie)"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "dać",
                                "target_lang_sense_clarification": "zgodzić się na seks (potocznie/wulgarnie)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
