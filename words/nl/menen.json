                    "common_phrases": [
                        "ik meen dat",
                        "menen te weten"
                    ],
                    "target_lang_definitions": {
                        "en": "To think; to hold an opinion or suppose that something is the case.",
                        "ru": "Думать; придерживаться мнения или предполагать, что это так.",
                        "pl": "Myśleć; mieć opinię lub przypuszczać, że coś jest prawdą.",
                        "de": "Denken; eine Meinung haben oder vermuten, dass etwas der Fall ist.",
                        "fr": "Penser ; avoir une opinion ou supposer que quelque chose est vrai.",
