                "entry_id": "cf0514f7-0724-3778-bc1e-582d91f632f3",
                "word": "neurosis",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6f422e5d-b88b-4841-8777-65e91d8f70e2",
                        "entry_id": "cf0514f7-0724-3778-bc1e-582d91f632f3",
                        "tags": [
