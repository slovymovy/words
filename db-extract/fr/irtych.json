                        "sense_id": "8cb7ced9-377b-3073-951f-46000ed453a7",
                        "entry_id": "9f5cc28f-f670-3c23-9022-1029bb4c3e6f",
                        "glosses": [
                            "Affluent de l’Ob qui prend sa source dans l’Altaï, en Chine, traverse le Kazakhstan et la Sibérie dans la majeure partie de son cours."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "3ed39c34-7988-40e6-b89e-b7e99fdc8c81",
                                "sense_id": "8cb7ced9-377b-3073-951f-46000ed453a7",
                                "text": "Le bassin de l’Irtych, d'une superficie de 1 673 470 km2, couvre une grande partie de la Sibérie occidentale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8edb909-10d8-48f3-abb4-c75654c9ac9b",
                        "source_entry_id": "9f5cc28f-f670-3c23-9022-1029bb4c3e6f",
                        "source_sense_id": "8cb7ced9-377b-3073-951f-46000ed453a7",
                        "target_lang_word": "Irtysh",
