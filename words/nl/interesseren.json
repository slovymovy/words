    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9b14a534-9357-3672-a32c-5a72b9749747",
                    "sense_definition": "Iemands aandacht trekken of nieuwsgierigheid opwekken; boeien.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "attract_attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat onderwerp <interesseert> mij eigenlijk helemaal niet.",
                            "target_lang_translations": {
                                "ru": "Эта тема меня, честно говоря, совсем не <интересует>.",
                                "en": "That subject doesn't actually <interest> me at all."
                            }
                        },
                        {
                            "text": "Het zal je vast <interesseren> om te horen wat er gisteren is gebeurd.",
                            "target_lang_translations": {
                                "ru": "Тебя наверняка <заинтересует> узнать, что произошло вчера.",
                                "en": "It will surely <interest> you to hear what happened yesterday."
                            }
                        }
                    ],
                    "synonyms": [
                        "boeien",
                        "aanspreken"
                    ],
                    "antonyms": [
                        "vervelen"
                    ],
                    "common_phrases": [
                        "het interesseert me niets",
                        "dat zal je interesseren"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекать чье-то внимание или вызывать любопытство; увлекать.",
                        "en": "To attract someone's attention or arouse curiosity; to fascinate."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интересовать",
                                "target_lang_sense_clarification": "вызывать интерес"
                            },
                            {
                                "target_lang_word": "заинтересовывать",
                                "target_lang_sense_clarification": "пробуждать любопытство"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "interest",
                                "target_lang_sense_clarification": "to engage someone's attention"
                            },
                            {
                                "target_lang_word": "fascinate",
                                "target_lang_sense_clarification": "to attract strongly"
                            },
                            {
                                "target_lang_word": "appeal to",
                                "target_lang_sense_clarification": "to be attractive or interesting to"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9e66d77-d45e-36d5-bd48-5018cb6c76d5",
                    "sense_definition": "(wederkerend) Belangstelling tonen voor of aandacht besteden aan een bepaald onderwerp.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "show_interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <interesseer> me erg voor computers en nieuwe technologie.",
                            "target_lang_translations": {
                                "ru": "Я очень <интересуюсь> компьютерами и новыми технологиями.",
                                "en": "I <am> very <interested> in computers and new technology."
                            }
                        },
                        {
                            "text": "Zij <interesseren> zich totaal niet voor voetbal of andere sporten.",
                            "target_lang_translations": {
                                "ru": "Они совершенно не <интересуются> футболом или другими видами спорта.",
                                "en": "They <are> not <interested> in football or other sports at all."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich interesseren voor",
                        "zich nergens voor interesseren"
                    ],
                    "target_lang_definitions": {
                        "ru": "(возвратный глагол) Проявлять интерес к чему-либо или уделять внимание определенной теме.",
                        "en": "(reflexive) To show interest in or pay attention to a particular subject."
                    },
                    "translations": {
                        "ru": [
