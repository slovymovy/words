                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0fc7929b-78e4-3581-a4cb-290d541115af",
                        "entry_id": "52f7719f-6073-3294-a2f6-8d77dfd62770",
                        "glosses": [
                            "kulinarisch: aus [1] gefertigte Speichen/Gerichte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa614d71-10e3-4fd8-ba9d-c97aab14f5b4",
                                "sense_id": "0fc7929b-78e4-3581-a4cb-290d541115af",
                                "text": "„Dopingproben sollen positiv ausfallen können, wenn Athleten Rindersteaks oder Hähnchenschenkel von Tieren essen, denen Hormone gespritzt wurden.“"
                            },
                            {
                                "example_id": "2d33ba9f-f145-40b1-bb3f-7f462ebfd749",
                                "sense_id": "0fc7929b-78e4-3581-a4cb-290d541115af",
                                "text": "„Sie tanzte Richtung Tisch, um sich einen kross gebratenen Hähnchenschenkel zu holen, und hoffte, Ama dabei nicht über den Weg zu laufen.“"
                            },
                            {
                                "example_id": "875b8e9c-3baa-417c-9767-d5283b2cf7f9",
                                "sense_id": "0fc7929b-78e4-3581-a4cb-290d541115af",
                                "text": "„Die Hähnchenschenkel hingegen rührte Tom nicht an.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
