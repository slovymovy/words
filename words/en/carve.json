{
    "word_family": [
        "carver",
        "carving",
        "woodcarving"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e4bd01d5-d224-38c7-8b72-dbf4a02cb874",
                    "sense_definition": "To cut cooked meat into slices or pieces in order to serve it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cutting_and_shaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is traditional for the head of the family to <w>carve</w> the turkey on Thanksgiving.",
                            "target_lang_translations": {
                                "ru": "По традиции глава семьи должен <w>разрезать</w> индейку на День благодарения."
                            }
                        },
                        {
                            "text": "You <w>carve</w> the roast and I will serve the vegetables to our guests.",
                            "target_lang_translations": {
                                "ru": "Ты <w>нарежешь</w> жаркое, а я подам овощи нашим гостям."
                            }
                        }
                    ],
                    "synonyms": [
                        "slice",
                        "cut"
                    ],
                    "common_phrases": [
                        "carve the roast",
                        "carve the turkey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарезать приготовленное мясо ломтиками или кусочками для подачи на стол."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрезать",
                                "target_lang_sense_clarification": "мясо на куски"
                            },
                            {
                                "target_lang_word": "нарезать",
                                "target_lang_sense_clarification": "ломтиками"
                            },
                            {
                                "target_lang_word": "разделывать",
                                "target_lang_sense_clarification": "тушу или жаркое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5d3f425-2c64-32cf-9efc-6dc7157e05bf",
                    "sense_definition": "To create an object or design by cutting into a hard material like wood or stone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cutting_and_shaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist decided to <w>carve</w> a statue out of a single block of marble.",
                            "target_lang_translations": {
                                "ru": "Художник решил <w>высечь</w> статую из цельного куска мрамора."
                            }
                        },
                        {
                            "text": "He used a small knife to <w>carve</w> a name into the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Он использовал маленький ножик, чтобы <w>вырезать</w> имя на старом дубе."
                            }
                        }
                    ],
                    "synonyms": [
                        "sculpt",
                        "chisel",
                        "engrave",
                        "cut",
                        "whittle"
                    ],
                    "common_phrases": [
                        "carve a statue",
                        "carve into wood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать предмет или узор, вырезая его на твердом материале, таком как дерево или камень."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырезать",
                                "target_lang_sense_clarification": "из дерева или камня"
                            },
                            {
                                "target_lang_word": "высекать",
                                "target_lang_sense_clarification": "из камня или мрамора"
                            },
                            {
                                "target_lang_word": "гравировать",
                                "target_lang_sense_clarification": "наносить надпись"
                            },
                            {
                                "target_lang_word": "ваять",
                                "target_lang_sense_clarification": "создавать скульптуру"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f01ea6b7-46ec-3435-b3e9-764b695db451",
                    "sense_definition": "To create or obtain something through effort or by cutting away from a larger whole.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to <w>carve</w> out a successful career in the competitive fashion industry.",
                            "target_lang_translations": {
                                "ru": "Ей удалось <w>построить</w> успешную карьеру в конкурентной индустрии моды."
                            }
                        },
                        {
                            "text": "The river will <w>carve</w> a path through the valley over thousands of years.",
                            "target_lang_translations": {
                                "ru": "За тысячи лет река <w>проложит</w> себе путь через долину."
                            }
                        }
                    ],
                    "synonyms": [
                        "create",
                        "fashion"
                    ],
                    "common_phrases": [
                        "carve out a career",
                        "carve a path"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать или добиваться чего-либо упорным трудом или путем отделения от большего целого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прокладывать",
                                "target_lang_sense_clarification": "путь или дорогу"
                            },
                            {
                                "target_lang_word": "выстраивать",
                                "target_lang_sense_clarification": "карьеру"
                            },
                            {
                                "target_lang_word": "завоевывать",
                                "target_lang_sense_clarification": "положение в обществе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9252d2c-cc69-309c-9a28-4a373fbe5c14",
                    "sense_definition": "To make smooth, sharp turns in skiing or snowboarding using the edges of the equipment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professional snowboarder began to <w>carve</w> through the fresh powder with incredible precision.",
                            "target_lang_translations": {
                                "ru": "Профессиональный сноубордист начал <w>резать</w> свежий снег с невероятной точностью."
                            }
                        },
                        {
                            "text": "To <w>carve</w> properly, you must shift your weight and use the edges of your skis.",
                            "target_lang_translations": {
                                "ru": "Чтобы правильно <w>закладывать повороты</w>, нужно переносить вес и использовать канты лыж."
                            }
                        }
                    ],
                    "common_phrases": [
                        "carve through snow",
                        "carve a turn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать плавные, резкие повороты на лыжах или сноуборде, используя канты снаряжения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резать",
                                "target_lang_sense_clarification": "выполнять резаные повороты"
                            },
                            {
                                "target_lang_word": "карвить",
                                "target_lang_sense_clarification": "спортивный сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1108f64e-b112-3ad7-a268-867b82287525",
                    "sense_definition": "To plan, design, or contrive a specific outcome or fashion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "planning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the night awake, <w>carving</w> the fashion of a new doublet for the festival.",
                            "target_lang_translations": {
                                "ru": "Он провел ночь без сна, <w>выдумывая</w> фасон нового колета для фестиваля."
                            }
                        },
                        {
                            "text": "The architect sought to <w>carve</w> a new style of living through his innovative designs.",
                            "target_lang_translations": {
                                "ru": "Архитектор стремился <w>создать</w> новый стиль жизни с помощью своих инновационных проектов."
                            }
                        }
                    ],
                    "synonyms": [
                        "design",
                        "contrive"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of planning or designing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Планировать, проектировать или придумывать определенный результат или фасон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замышлять",
                                "target_lang_sense_clarification": "планировать"
                            },
                            {
                                "target_lang_word": "проектировать",
                                "target_lang_sense_clarification": "создавать дизайн"
                            },
                            {
                                "target_lang_word": "выкраивать",
                                "target_lang_sense_clarification": "фасон одежды"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29d4422e-fabd-3515-8432-88abb1ba1cd8",
                    "sense_definition": "The act or process of cutting or shaping something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cutting_and_shaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef gave the turkey a careful <w>carve</w> before placing it on the platter.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар аккуратно <w>нарезал</w> индейку, прежде чем выложить её на блюдо."
                            }
                        },
                        {
                            "text": "With one swift <w>carve</w>, the sculptor removed the excess clay from the base.",
                            "target_lang_translations": {
                                "ru": "Одним быстрым <w>движением</w> скульптор удалил лишнюю глину с основания."
                            }
                        }
                    ],
                    "synonyms": [
                        "cut",
                        "slice"
                    ],
                    "common_phrases": [
                        "careful carve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или процесс разрезания или придания формы чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарезка",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "резьба",
                                "target_lang_sense_clarification": "художественная"
                            },
                            {
                                "target_lang_word": "надрез",
                                "target_lang_sense_clarification": "единичное действие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4cc9dea-13fb-3ed7-8997-7b467582ec01",
                    "sense_definition": "An old unit of land area, also known as a <w>carucate</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical records show that he held a moiety of the village for half a <w>carve</w> of land.",
                            "target_lang_translations": {
                                "ru": "Исторические записи показывают, что он владел половиной деревни за пол-<w>карукаты</w> земли."
                            }
                        },
                        {
                            "text": "The estate consisted of one <w>carve</w> of arable land and several smaller quarters.",
                            "target_lang_translations": {
                                "ru": "Поместье состояло из одной <w>карукаты</w> пахотной земли и нескольких меньших участков."
                            }
                        }
                    ],
                    "synonyms": [
                        "carucate"
                    ],
                    "common_phrases": [
                        "carve of land"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical unit of measurement"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старинная единица земельной площади, также известная как каруката."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каруката",
                                "target_lang_sense_clarification": "мера земли"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}