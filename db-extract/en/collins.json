                    {
                        "sense_id": "442dc6ed-392b-381e-b4a9-07078136355b",
                        "entry_id": "cd28b833-12ef-3912-89cf-dd9a58b66d11",
                        "glosses": [
                            "An English surname originating as a patronymic from the given name Colin."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ee8ae56e-8de6-4428-9c44-e1c8e58f61e5",
                                "sense_id": "442dc6ed-392b-381e-b4a9-07078136355b",
                                "text": "\"But your own name too sounds funny,\" Tampio said. \"Your names are repeated. Only you have spelt one wrongly. How could you call yourself Colin Collins? Here in Cameroon, we only know about Collins.\""
                            },
                            {
                                "example_id": "8e0d7d02-f617-46db-8958-a2efa02bfca1",
                                "sense_id": "442dc6ed-392b-381e-b4a9-07078136355b",
                                "text": "Collins and the Trump campaign on Wednesday celebrated the recount decision from the Georgia secretary of state as a victory for “integrity” and “transparency.”"
                            },
                            {
                                "example_id": "512049f0-19a4-4aa2-ae91-9c34501f86fe",
                                "sense_id": "442dc6ed-392b-381e-b4a9-07078136355b",
                                "text": "The Collinses — parents of four children — present themselves as rationalists, techies trying to solve the looming depopulation crisis by any means necessary. (Simone was pregnant with the fourth child during the conference. That baby, Industry Americus Collins, was born in April.)"
                            }
                        ]
                    },
