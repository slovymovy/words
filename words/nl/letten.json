                                "target_lang_word": "prevent",
                                "target_lang_sense_clarification": "to keep from happening"
                            },
                            {
                                "target_lang_word": "hinder",
                                "target_lang_sense_clarification": "to create difficulties for"
                            }
                        ]
                    }
                },
                {
