                "senses": [
                    {
                        "sense_id": "a037d2f7-b94b-3dcc-8efe-d27252ea3738",
                        "entry_id": "5736cbc8-5379-3920-8d17-5bb8f5f68274",
                        "glosses": [
                            "Person, die ein Volontariat als Berufsvorbereitung absolviert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f52252e-f9f5-4fcf-8f5a-e6e3da4e18aa",
                                "sense_id": "a037d2f7-b94b-3dcc-8efe-d27252ea3738",
                                "text": "Er arbeitete als Volontär in einer karitativen Einrichtung."
                            },
                            {
                                "example_id": "9aa92f69-701b-48b7-957a-432723c6e95a",
                                "sense_id": "a037d2f7-b94b-3dcc-8efe-d27252ea3738",
                                "text": "„Der Volontär stand auf, schwankte durchs Gastzimmer der Hintertür zu und verschwand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f1aa036-5f7e-4c8d-badd-eae871acc0c0",
                        "source_entry_id": "5736cbc8-5379-3920-8d17-5bb8f5f68274",
                        "source_sense_id": "a037d2f7-b94b-3dcc-8efe-d27252ea3738",
                        "source_sense_description": "Person, die ein Volontariat als Berufsvorbereitung absolviert",
                        "target_lang_word": "volunteer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volunteer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "117fa0bd-bbf1-3dd5-9b8a-9ad72e68abb2",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "One who enters into, or offers themselves for, any service of their own free will, especially when done without pay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2c8e9c7-6592-4364-8aec-e2caa7d68e8e",
                                                "sense_id": "117fa0bd-bbf1-3dd5-9b8a-9ad72e68abb2",
                                                "text": "The volunteers at the nature reserve meet up ever other Sunday to help its upkeep."
                                            },
                                            {
                                                "example_id": "971daf69-1465-4881-8149-de214d9f6e98",
                                                "sense_id": "117fa0bd-bbf1-3dd5-9b8a-9ad72e68abb2",
                                                "text": "The largest age group for volunteers was 35-44, the CNCS survey said, and volunteers were most likely to be parents with children under 18. The typical volunteer may live in Utah, which ranked first in the percentage of people who said they volunteered among all 50 states and Washington, DC."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38ac4b41-903c-3822-b1eb-9a9e5bcf42ac",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "One who enters into military service voluntarily (but who, when in service, is subject to discipline and regulations like other soldiers), as opposed to a conscript."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e22ba4e-6bc0-3c6e-a575-008bf96d5330",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "A voluntary member of the organized militia of a country, as distinguished from a regular or member of the standing army."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "846ff25a-7fc4-4e65-818e-7accadd7a9fe",
                                                "sense_id": "7e22ba4e-6bc0-3c6e-a575-008bf96d5330",
                                                "text": "That summer and fall the Army organized twenty-five regiments of volunteers, including two black regiments, which would have all-black captains and lieutenants. All officers were to be selected from regulars and volunteers who had distinguished themselves[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64e4831d-46f2-3884-8284-884730b9d549",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "A person who acts out of their own will without a legal obligation, such as a donor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4397e770-550c-3958-be77-27fed251fc77",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "A plant that grows spontaneously, without being cultivated on purpose; see volunteer plant in Wikipedia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b29511e6-d3d9-33cf-a52c-212d369d3aee",
                                        "entry_id": "b7b31d22-5914-3c06-8f6c-3ae93f71e4bd",
                                        "glosses": [
                                            "A native or resident of the American state of Tennessee."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
