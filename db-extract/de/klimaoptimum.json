                ],
                "senses": [
                    {
                        "sense_id": "09ccfd03-8cfa-3ae7-a29b-2915c232324b",
                        "entry_id": "fb3f37da-0bb7-3399-a7be-36defca882ab",
                        "glosses": [
                            "klimatisch relativ warme Periode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21e23ac1-c4ed-49f8-a62d-2c34fcf22269",
                                "sense_id": "09ccfd03-8cfa-3ae7-a29b-2915c232324b",
                                "text": "„Klimatisch fiel diese maritime Phase mit dem letzten globalen sogenannten ‚Klimaoptimum‘ zusammen.“"
                            },
                            {
                                "example_id": "652336f3-fc4b-440f-b1f9-efa1b84086f5",
                                "sense_id": "09ccfd03-8cfa-3ae7-a29b-2915c232324b",
                                "text": "„Er weist indirekt auf das Klimaoptimum während der Römischen Kaiserzeit hin; denn auf den Steindenkmälern wären die Germanen immer leicht bekleidet.“"
                            },
                            {
                                "example_id": "037d12e3-5c73-4231-90ab-0cace3ff904e",
                                "sense_id": "09ccfd03-8cfa-3ae7-a29b-2915c232324b",
                                "text": "„Im Klimaoptimum erblühte die Landwirtschaft, und Hungersnöte in Europa wurden selten.“"
                            },
                            {
                                "example_id": "d5135bfb-4d61-4926-8581-409c09487b15",
                                "sense_id": "09ccfd03-8cfa-3ae7-a29b-2915c232324b",
                                "text": "„Den Weinbau begünstigte auch das mittelalterliche Klimaoptimum, in dem es ein paar Grad wärmer war als heute.“"
                            },
                            {
                                "example_id": "e0f20b43-f206-4ead-8367-d7048e256eb8",
                                "sense_id": "09ccfd03-8cfa-3ae7-a29b-2915c232324b",
                                "text": "„Nach dem mittelalterlichen Klimaoptimum sanken die Temperaturen vor allem in den Winter- und Frühjahrsmonaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
