                        "entry_id": "1a8b63b1-8c9c-31a3-8941-4f5f3d3c0554",
                        "glosses": [
                            "keine (schädlichen) Abgase erzeugend, enthaltend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c172b7-3317-4bf1-a59e-55833eacfdc4",
                                "sense_id": "7312fa72-a0a8-37f6-b187-d6c99cb8041e",
                                "text": "„Nach seiner Meinung würde es aber noch bis 2025 dauern, bis das Auto völlig abgasfrei rollt.“"
                            },
                            {
                                "example_id": "c8cfe556-be01-46cc-8be2-900b85e41107",
                                "sense_id": "7312fa72-a0a8-37f6-b187-d6c99cb8041e",
                                "text": "„Eine weitere Alternative zum eigenen Auto sind Fahrten mit dem elektrisch betriebenen Sunnybus, der einzelne Täler fast lautlos und abgasfrei erschließt.“"
                            },
                            {
                                "example_id": "0be5c369-05f0-4b42-ae03-a1800281333b",
                                "sense_id": "7312fa72-a0a8-37f6-b187-d6c99cb8041e",
                                "text": "„Als weiterer Vorteil von Elektroautos kommt hinzu, dass diese in ihrer unmittelbaren Umgebung abgasfrei sind.“"
                            },
                            {
                                "example_id": "bb07c7b0-2400-4898-af6b-d05d478abf13",
                                "sense_id": "7312fa72-a0a8-37f6-b187-d6c99cb8041e",
                                "text": "„Wer nicht selbst in die Pedale treten möchte, kann sich abgasfrei durch die Stadt radeln lassen: Velotaxis machen's möglich.“"
                            },
                            {
                                "example_id": "dc9c2d0d-166c-46ca-8552-1deaf441b9f3",
                                "sense_id": "7312fa72-a0a8-37f6-b187-d6c99cb8041e",
                                "text": "„Und auch in abgasfreien Autos stecken Rohstoffe, bei deren Abbau und Verarbeitung Emissionen entstehen und Menschen leiden.“"
                            },
                            {
                                "example_id": "457034c5-a3d5-4fc0-85ae-ba5ebdcb4957",
                                "sense_id": "7312fa72-a0a8-37f6-b187-d6c99cb8041e",
                                "text": "„Mobilität wird über Sonnenenergie durch E-Mobile, Schwebebahnen und abgasfreie Antriebswerke wie Wasserstoffmotoren gewährleistet sein.“"
                            },
                            {
                                "example_id": "1be1055e-c684-4da1-b896-b9fd6418fde8",
                                "sense_id": "7312fa72-a0a8-37f6-b187-d6c99cb8041e",
                                "text": "„Das beginnt beim Fahrverbot für Dieselfahrzeuge in Oslo und geht hin bis zum erklärten Ziel, bis 2025 nur noch abgasfreie Neuwagen zuzulassen.“"
                            },
                            {
                                "example_id": "3af7e15c-a2d0-4a32-be63-52e18401084e",
                                "sense_id": "7312fa72-a0a8-37f6-b187-d6c99cb8041e",
                                "text": "„Lastenräder stellen besonders im städtischen Raum eine schnelle, kostengünstige, leise und vor allem abgasfreie Transportlösung dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
