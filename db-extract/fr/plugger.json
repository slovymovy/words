                ],
                "senses": [
                    {
                        "sense_id": "cbb413a1-b510-3829-9dda-77b818010242",
                        "entry_id": "86b5116d-a476-3971-925d-b7cc54749d0e",
                        "glosses": [
                            "Brancher, connecter."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "8ff8102c-d78c-4bb2-b43b-e7d60a939c03",
                                "sense_id": "cbb413a1-b510-3829-9dda-77b818010242",
                                "text": "Comment se plugger quand on est \"cocktail\"."
                            },
                            {
                                "example_id": "8dd1cd58-a8ba-4423-b990-2887602fb587",
                                "sense_id": "cbb413a1-b510-3829-9dda-77b818010242",
                                "text": "Un port USB à plugger les yeux fermés."
                            },
                            {
                                "example_id": "d6eb17b2-8e2e-4e05-b764-11b14ae77a10",
                                "sense_id": "cbb413a1-b510-3829-9dda-77b818010242",
                                "text": "Pour réaliser son mini album photo, il suffit de plugger sa carte mémoire directement sur la borne de la machine, utiliser une clé USB ou encore transférer les images directement à partir d’un téléphone portable grâce au périphérique Bluetooth."
                            },
                            {
                                "example_id": "1b6afe74-0dc9-486e-a4db-a1093269c06c",
                                "sense_id": "cbb413a1-b510-3829-9dda-77b818010242",
                                "text": "Cet ordinateur portable dispose d’un dock qui permet de plugger le Motorola Atrix."
                            },
                            {
                                "example_id": "4afb6ce0-653b-42c9-9347-b624887f7f22",
                                "sense_id": "cbb413a1-b510-3829-9dda-77b818010242",
                                "text": "Un dispositif permet même de plugger son iPad derrière les dossiers des deux sièges avant."
                            },
                            {
                                "example_id": "3bd960f6-5927-4d24-974b-6894b55130bb",
                                "sense_id": "cbb413a1-b510-3829-9dda-77b818010242",
                                "text": "Les usagers « plus classiques » apprécieront quant à eux la possibilité de plugger le SkullCandy à un lecteur MP3, type Ipod, grâce au cordon jack fourni en sus"
                            },
                            {
                                "example_id": "e0e51784-da4d-4f65-a11c-6596d1ce0099",
                                "sense_id": "cbb413a1-b510-3829-9dda-77b818010242",
                                "text": "Existe aussi dans une version ghettoblaster blanc (iBoom), sorte de hideux magnéto avec, à la place du lecteur cassette, un endroit où plugger son baladeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "dca72180-f47e-3768-bbfc-73a301cb03fc",
                        "entry_id": "86b5116d-a476-3971-925d-b7cc54749d0e",
                        "glosses": [
                            "Placer."
                        ],
                        "tags": [
                            "Anglicism",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "654753c0-41e3-47cd-bc10-7d9879beda1a",
                                "sense_id": "dca72180-f47e-3768-bbfc-73a301cb03fc",
                                "text": "Plugger des mots"
                            }
                        ]
                    },
                    {
                        "sense_id": "aaf84dd1-fef0-3a44-b7ce-fa7ec5abd160",
                        "entry_id": "86b5116d-a476-3971-925d-b7cc54749d0e",
                        "glosses": [
                            "Insérer une drogue dans l’anus."
                        ],
                        "tags": [
                            "Drogue"
                        ],
                        "examples": [
                            {
                                "example_id": "84464c07-019c-41a6-80a6-3547ecfbb542",
                                "sense_id": "aaf84dd1-fef0-3a44-b7ce-fa7ec5abd160",
                                "text": "L’Observatoire français des drogues et des toxicomanies (OFDT), relève ces dernières années « une diversification des formes proposées » de 3-MMC : « auparavant poudre, puis cristal et désormais comprimés ». Elle peut ainsi être « ingérée, le plus souvent sous forme de parachute (dans une boulette de papier à cigarette), diluées dans une boisson, sniffée, injectée ou pluggée (insérée dans l’anus à l’aide d’une seringue sans aiguille) », détaille Drogues Info Service."
                            }
                        ]
                    }
