                ],
                "senses": [
                    {
                        "sense_id": "a7635889-3a50-3bad-97ca-2983579d1e6b",
                        "entry_id": "f531172e-961a-3c23-b158-a33fe77d7d1c",
                        "glosses": [
                            "iemand die tijdelijk naar een ander land komt om daar arbeid te verrichten"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "34f1528d-4405-4e2b-98d5-1b85c3e5d2f0",
                                "sense_id": "a7635889-3a50-3bad-97ca-2983579d1e6b",
                                "text": "De vader van Ahmed Marcouch werkte als gastarbeider in Nederland."
                            },
                            {
                                "example_id": "65c6165f-d45a-4a1c-a7e2-af27a565f61c",
                                "sense_id": "a7635889-3a50-3bad-97ca-2983579d1e6b",
                                "text": "Dit zijn de woorden van de 27-jarige Spaanse gastarbeider José Luis Lorenzo. In Hattingen werkt hij als lorry-bestuurdcr in een fabriek van machines in Sprockhövel by Hattingen in het Roergebied."
                            }
                        ]
                    },
                    {
                        "sense_id": "04d6b3aa-994e-3a40-8b3a-8120b39ed882",
                        "entry_id": "f531172e-961a-3c23-b158-a33fe77d7d1c",
                        "glosses": [
                            "dwangarbeider, die in arbeidskampen in Nazi-Duitsland tewerk werd gesteld."
                        ],
                        "tags": [
                            "euphemistic"
                        ],
                        "examples": [
                            {
                                "example_id": "41312ed4-8a63-4012-849b-28f5a25ea3e6",
                                "sense_id": "04d6b3aa-994e-3a40-8b3a-8120b39ed882",
                                "text": "Weliswaar had men reeds een groot aantal vreemde werkkrachten in dienst, doch dat waren in hoofdzaak krijgsgevangenen en Polen, die niet met den West-Europeeschen arbeider werden gelijkgesteld. Bij den werker uit het Westen ging men van het standpunt uit, dat hij gast-arbeider was. Iemand dus, die werd uitgenoodigd en vrijwillig kwam. Daarom wilde men hem de grootst mogelijke vrijheid verleenen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49138604-7555-47cc-b33a-a042894717a1",
                        "source_entry_id": "f531172e-961a-3c23-b158-a33fe77d7d1c",
                        "source_sense_id": "a7635889-3a50-3bad-97ca-2983579d1e6b",
                        "source_sense_description": "iemand die tijdeljk naar een ander land komt om daar arbeid te verrichten",
                        "target_lang_word": "Gastarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gastarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                        "entry_id": "8eea73dd-4bb3-393e-b5fb-b4f5588be12c",
                                        "glosses": [
                                            "Person, die legal (für eine begrenzte Zeit) in einem für ihn fremden Land arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b2a2cf4-d5f3-4d5f-9797-569e71fa8f1c",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "Nach dem Ende der DDR mussten die Gastarbeiter aus Vietnam und Mosambik in ihre Heimatländer zurückkehren."
                                            },
                                            {
                                                "example_id": "4a85f8ab-bdfd-4b7e-8ce2-1be97a289f36",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "„Die Gastarbeiter der 1960er Jahre kamen alle freiwillig ins Land.“"
                                            },
                                            {
                                                "example_id": "e75ee8b0-2ea4-4644-8bae-c82b60500931",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "„Noch der letzte Gstarbeiter aus Apulien oder Kastilien konnte Pass und Arbeitserlaubnis vorweisen.“"
                                            },
                                            {
                                                "example_id": "475a095b-4a08-41f1-8769-352ba7451af9",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "„In den ewig hellen Sommermonaten müssen mittlerweile Gastarbeiter aus der ganzen Welt aushelfen, um die Touristenströme zu bewältigen.“"
                                            },
                                            {
                                                "example_id": "03ac4373-4231-4e48-b7fd-403298da71de",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "„Die Deutschen in den Sechzigerjahren des 20. Jahrhunderts hätten sie als Gastarbeiter bezeichnet.“"
                                            },
                                            {
                                                "example_id": "62e84297-a270-422e-a810-aef31e191ec0",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "„In den Fünfzigerjahren des vergangenen Jahrhunderts begann die Bundesrepublik Deutschland, im großen Stil sogenannte Gastarbeiter anzuwerben.“"
                                            },
                                            {
                                                "example_id": "fa5dc07d-0a45-472f-a076-5df1740cc8f5",
                                                "sense_id": "780fe16f-15a1-3886-ae4b-6daafda3f36e",
                                                "text": "„Seine Großeltern kamen als Gastarbeiter in den 1970ern nach Kreuzberg und Deutschland wurde zu ihrer neuen Heimat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
