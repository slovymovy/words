                ],
                "senses": [
                    {
                        "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                        "entry_id": "4f2671f5-97d7-34bb-8e55-e9941f8e5db7",
                        "glosses": [
                            "spezialisierte Zelle in der Nase, die dafür verantwortlich ist, Gerüche zu erkennen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba8ac63a-db73-48ac-8406-2edae8bb3465",
                                "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                                "text": "„6 Millionen Riechzellen befinden sich ungefähr in unserer Nase. Zum Vergleich: Ein Hund kommt auf rund 220 Millionen Riechzellen.“"
                            },
                            {
                                "example_id": "2518f0c1-62ef-42ff-b156-8a46fc00ab9f",
                                "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                                "text": "„Das Riechepithel, oder die Riechschleimhaut, besteht aus über zehn Millionen Riechzellen. Jede Riechzelle endet in sechs bis zehn Fortsätzen, den Riechhärchen, die die Geruchsrezeptoren tragen. “"
                            },
                            {
                                "example_id": "45e6d033-2458-44e5-bb8a-9575c2a6a779",
                                "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                                "text": "Das Riechepithel mit den Riechzellen hat beim Menschen nur eine Größe von ungefähr 2 cm². Bei Ratten und Hunden ist es viel größer."
                            },
                            {
                                "example_id": "33b1439d-a9b6-4138-9d28-35214be03ea9",
                                "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                                "text": "„Der Europäische Aal kann mit etwas einer Milliarde Riechzellen einen Tropfen Parfum in der dreifachen Menge Wassers des Bodensees aufspüren.“"
                            },
                            {
                                "example_id": "d9c49995-48e0-4454-8c02-cbf09eb8cff1",
                                "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                                "text": "[Rehe:] „Auf dem etwa 90 Quadratzentimeter umfassenden Riechepithel befinden sich rund 320 Millionen Riechzellen.“"
                            },
                            {
                                "example_id": "c5834698-d35a-410f-b68d-547afe8abb88",
                                "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                                "text": "Die Anzahl der Riechzellen nimmt im Laufe unseres Lebens ab."
                            },
                            {
                                "example_id": "82594413-6cdd-422d-a6ed-33f94dcf8d67",
                                "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                                "text": "„Hat das Coronavirus Sars-CoV-2 Riechzellen zerstört, finden einige Duftmoleküle keinen passenden Rezeptor mehr.“"
                            },
                            {
                                "example_id": "b50e0271-e247-4303-81fb-4b0a385f825e",
                                "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                                "text": "„Nur eine feuchte Nasenschleimhaut kann die Geruchsmoleküle - die mikroskopisch kleinen Teilchen einer riechenden Substanz - dorthin transportieren, wo sie wahrgenommen werden: an die Riechzellen.“"
                            },
                            {
                                "example_id": "af3d673a-9373-4e8d-b856-ba38014b2bd7",
                                "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                                "text": "„Bekannt ist, dass Raucher ein signifikant schlechteres Riechvermögen haben, weil Tabakrauchtoxine die Riechzellen schädigen.“"
                            },
                            {
                                "example_id": "6aad2b61-fabc-47bf-ad2a-3cf4397ea8b3",
                                "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                                "text": "„Die Riechzellen in der Riechschleimhaut sind hochgradig spezialisierte Duftsensoren: Sie ragen mit ihren Fortsätzen antennenartig in die Nasenhöhle und können dort Tausende verschiedener Geruchsmoleküle identifizieren und unterscheiden.“"
                            },
                            {
                                "example_id": "785e7cb8-2320-4818-a3f3-1ff26c3eb989",
                                "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                                "text": "„Der Hund kann in kurzen Atemzügen bis zu 300 Mal in der Minute atmen, so dass die Riechzellen ständig mit neuen Geruchspartikeln versorgt werden.“"
                            },
                            {
                                "example_id": "0f312560-10b2-4a69-8aaa-4eaf262b4a88",
                                "sense_id": "af67676f-b9b9-397e-b32c-51fe37de3f71",
                                "text": "„Wie gut ein Lebewesen riechen kann, hängt von der Sensitivität der Geruchsrezeptoren und der Anzahl der Riechzellen ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
