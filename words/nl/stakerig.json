    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "86241991-8b5a-3c32-8d47-2d87578b2455",
                    "sense_definition": "Op een onhandige, houterige of onelegante manier bewegend of overkomend.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "onhandig_gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jongen maakte een paar <w>stakerige</w> bewegingen op de dansvloer.",
                            "target_lang_translations": {
                                "en": "The boy made a few <w>awkward</w> moves on the dance floor."
                            }
                        },
                        {
                            "text": "Zijn <w>stakerige</w> manier van lopen verraadde zijn zenuwen.",
                            "target_lang_translations": {
                                "en": "His <w>stiff</w> way of walking betrayed his nervousness."
                            }
                        }
                    ],
                    "synonyms": [
                        "houterig",
                        "onhandig",
                        "onbeholpen",
                        "stijf",
                        "stram",
                        "stokkerig"
                    ],
                    "antonyms": [
                        "elegant",
                        "soepel",
                        "vloeiend"
                    ],
                    "common_phrases": [
                        "stakerige bewegingen",
                        "stakerige manier"
                    ],
                    "target_lang_definitions": {
                        "en": "Moving or appearing in an awkward, stiff, or inelegant manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stiff",
                                "target_lang_sense_clarification": "lacking ease or grace in movement"
                            },
                            {
                                "target_lang_word": "wooden",
                                "target_lang_sense_clarification": "stiff and awkward"
                            },
                            {
                                "target_lang_word": "awkward",
                                "target_lang_sense_clarification": "clumsy or uncoordinated in movement"
                            },
                            {
                                "target_lang_word": "gawky",
                                "target_lang_sense_clarification": "nervously awkward and ungainly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "580f7208-b96d-3da0-866a-dd5aa8db2854",
                    "sense_definition": "Voorzien van of lijkend op veel smalle, dunne uitsteeksels of takken.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "uiterlijk_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de winter steken de <w>stakerige</w> takken van de bomen scherp af tegen de grijze lucht.",
                            "target_lang_translations": {
                                "en": "In winter, the <w>spidery</w> branches of the trees stand out sharply against the grey sky."
                            }
                        },
                        {
                            "text": "De fabriek had een <w>stakerige</w> skyline met tientallen dunne pijpen.",
                            "target_lang_translations": {
                                "en": "The factory had a <w>spiky</w> skyline with dozens of thin pipes."
                            }
                        }
                    ],
                    "synonyms": [
                        "stokkerig"
                    ],
                    "common_phrases": [
                        "stakerige takken",
                        "stakerige skyline"
                    ],
                    "target_lang_definitions": {
                        "en": "Having or resembling many narrow, thin protrusions or branches."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spidery",
                                "target_lang_sense_clarification": "thin and angular, like spider legs"
                            },
                            {
                                "target_lang_word": "scrawny",
                                "target_lang_sense_clarification": "thin and bony or bare"
                            },
                            {
                                "target_lang_word": "spiky",
                                "target_lang_sense_clarification": "having sharp, thin points"
                            },
                            {
                                "target_lang_word": "skeletal",
                                "target_lang_sense_clarification": "resembling a bare framework or skeleton"
                            }
                        ]
                    }
                }
            ]
        }
    ]
