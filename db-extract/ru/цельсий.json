                ],
                "senses": [
                    {
                        "sense_id": "c22f42e4-a060-3032-82a8-514e37e3baae",
                        "entry_id": "bced301d-6285-3279-bcb3-f9a266ad9c0d",
                        "glosses": [
                            "Celsius (surname)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92951c38-a44d-4e1a-8bcc-41dfb9f53b05",
                                "sense_id": "c22f42e4-a060-3032-82a8-514e37e3baae",
                                "text": "Цельсий, Андерс (1701—1744) — шве́дский астроно́м, гео́лог и метеоро́лог, в честь кото́рого на́звана(/назва́на) шкала́ измере́ния температу́ры; племя́нник Улофа Цельсия.",
                                "translation": "Anders Celsius (1701-1744) was a Swedish astronomer, geologist and meteorologist, after whom the temperature measurement scale is named; Olof Celsius's nephew.",
                                "english": "Anders Celsius (1701-1744) was a Swedish astronomer, geologist and meteorologist, after whom the temperature measurement scale is named; Olof Celsius's nephew."
                            }
                        ]
                    },
                    {
                        "sense_id": "659dafc3-29f9-31f3-8a5a-847085c08738",
                        "entry_id": "bced301d-6285-3279-bcb3-f9a266ad9c0d",
                        "glosses": [
                            "Celsius, centigrade (temperature unit)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7ff9046-6979-4812-9a6a-8bd530ff5652",
                                "sense_id": "659dafc3-29f9-31f3-8a5a-847085c08738",
                                "text": "Температу́ра коле́блется ме́жду 20 и 40 гра́дусами по Цельсию в зави́симости от ме́ста.",
                                "translation": "Temperatures range between 20 and 40 degrees Celsius depending on location.",
                                "english": "Temperatures range between 20 and 40 degrees Celsius depending on location."
                            },
                            {
                                "example_id": "4da93a7d-bbee-405c-a394-096eafb34531",
                                "sense_id": "659dafc3-29f9-31f3-8a5a-847085c08738",
                                "text": "В 12 ч. 40 м. температу́ра в одно́й из ка́мер составля́ла 32 гра́дуса Цельсия при вла́жности во́здуха 74%.",
                                "translation": "At 12:40 the temperature was 32 degrees centigrade in one of the cells with a humidity factor of 74.",
                                "english": "At 12:40 the temperature was 32 degrees centigrade in one of the cells with a humidity factor of 74."
                            }
                        ]
                    }
                ],
                "translations": [],
