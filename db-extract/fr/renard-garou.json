                                        "sense_id": "ed380213-e4ad-3b2b-a415-16b0c6fa6f4b",
                                        "entry_id": "2c1d21bd-7033-3adf-8856-f1208dc960bd",
                                        "glosses": [
                                            "A person who transforms into a fox or foxlike form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "177c6d39-b844-40c2-b966-c92102a689b8",
                                                "sense_id": "ed380213-e4ad-3b2b-a415-16b0c6fa6f4b",
                                                "text": "Lycanthropy also was common, in early times at least, and belief in werewolves and werefoxes existed among all tribe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76d338c7-74da-48d5-96bc-530ef4251a4d",
                        "source_entry_id": "e1a621f1-25c0-3cac-ad2e-66a699328fb9",
                        "source_sense_id": "1d607c02-f4bb-3fbe-b3ee-5ce58fedc10b",
