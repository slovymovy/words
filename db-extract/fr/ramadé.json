                "senses": [
                    {
                        "sense_id": "b05f7af9-79bc-3a2b-91a2-67e721e6813b",
                        "entry_id": "55e541dc-7c41-3884-b7eb-3dc8eae39ebc",
                        "glosses": [
                            "Qualifie le chemin pastoral pris par le bétail transhumant."
                        ],
                        "tags": [
                            "Pyrénées"
                        ],
                        "examples": [
                            {
                                "example_id": "0b21ef9a-8435-47ea-945e-319839abdf37",
                                "sense_id": "b05f7af9-79bc-3a2b-91a2-67e721e6813b",
                                "text": "Les moutons transhumants portent, attachés leur laine, de nombreuses graines de la plaine vers la montagne et surtout de la montagne vers la plaine ; on peut suivre alors le long des chemins « ramadés » une flore spéciale jalonnant leurs déplacements."
                            },
                            {
                                "example_id": "c52402a5-fdcd-46e9-a7b6-033801e9ee95",
                                "sense_id": "b05f7af9-79bc-3a2b-91a2-67e721e6813b",
                                "text": "Le 20 avril 1856, la commission municipale remit enfin son « mémoire ». Elle constatait que, sur une partie des terrains usurpés, « se trouvent les chemins Ramadés [camí ramader, chemin pastoral] venant de la montagne que les usurpateurs se sont plus à fermer »."
                            }
                        ]
                    }
