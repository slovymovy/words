{
    "word_family": [
        "reinforce",
        "reinforcement",
        "reinforcer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "81b76c31-0461-3437-9cc8-98e36c0d9f1a",
                    "sense_definition": "Serving to strengthen or support something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strengthening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reinforcing</w> steel bars are essential for the stability of the concrete bridge.",
                            "target_lang_translations": {
                                "zh": "<w>加固</w>钢筋对于混凝土桥梁的稳定性至关重要。"
                            }
                        },
                        {
                            "text": "Engineers added <w>reinforcing</w> beams to the structure to prevent it from collapsing.",
                            "target_lang_translations": {
                                "zh": "工程师在结构中增加了<w>加固</w>梁，以防止其倒塌。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strengthening",
                        "supporting",
                        "fortifying"
                    ],
                    "antonyms": [
                        "weakening"
                    ],
                    "common_phrases": [
                        "reinforcing beam",
                        "reinforcing bar"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于加强或支撑某物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加固的",
                                "target_lang_sense_clarification": "形容结构或材料经过强化以提高稳定性。"
                            },
                            {
                                "target_lang_word": "增强的",
                                "target_lang_sense_clarification": "指在功能或强度上得到提升的。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "600d9187-4aa2-3e51-9b2b-fe324b16b22f",
                    "sense_definition": "The act or process of strengthening or supporting something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strengthening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reinforcing</w> of the old wall was necessary to keep the building safe.",
                            "target_lang_translations": {
                                "zh": "对旧墙进行<w>加固</w>对于保障建筑安全是必要的。"
                            }
                        },
                        {
                            "text": "Proper <w>reinforcing</w> of the foundation ensures the house can withstand heavy storms.",
                            "target_lang_translations": {
                                "zh": "对地基进行适当的<w>加固</w>能确保房屋抵御强风暴。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strengthening",
                        "support",
                        "fortification"
                    ],
                    "target_lang_definitions": {
                        "zh": "加强或支撑某事物的行为或过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加固",
                                "target_lang_sense_clarification": "指对建筑物或结构进行强化处理。"
                            },
                            {
                                "target_lang_word": "增强",
                                "target_lang_sense_clarification": "指提升某事物的强度或效力。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ceedf6c-b708-3453-ade0-6324464afd6e",
                    "sense_definition": "Present participle and gerund of <w>reinforce</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "strengthening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are <w>reinforcing</w> the fence to keep the animals inside the field.",
                            "target_lang_translations": {
                                "zh": "他们正在<w>加固</w>围栏，以防动物跑出场地。"
                            }
                        },
                        {
                            "text": "By <w>reinforcing</w> his argument with facts, he convinced the entire committee.",
                            "target_lang_translations": {
                                "zh": "他通过用事实<w>加强</w>自己的论点，说服了整个委员会。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb reinforce."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 reinforce 的现在分词和动名词形式，意为加强、巩固。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "加强",
                                "target_lang_sense_clarification": "使力量、强度或效力变得更强。"
                            },
                            {
                                "target_lang_word": "巩固",
                                "target_lang_sense_clarification": "使基础或地位更加稳固。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}