        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "57bc0a7e-d13c-3b8a-868c-8d0a3870dce4",
                "word": "shipwright",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bfe31ea3-e44f-4823-8b7e-4ac0ccad5dd3",
                        "entry_id": "57bc0a7e-d13c-3b8a-868c-8d0a3870dce4",
                        "tags": [
                            "plural"
                        ],
                        "form": "shipwrights"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d36a6ed1-dc73-34f2-9347-7c9ff6ee64eb",
                        "entry_id": "57bc0a7e-d13c-3b8a-868c-8d0a3870dce4",
                        "glosses": [
                            "A person who designs, builds and repairs ships, especially wooden ones."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cfb80dd-c385-475a-b3d9-af818f43eccb",
                                "sense_id": "d36a6ed1-dc73-34f2-9347-7c9ff6ee64eb",
                                "text": "A shipwright is one who builds or repairs ships using whatever materials are available including, but not limited to wood, metal, plastic, and concrete. / A master shipwright is one who has learned to use his skills with precision and is capable of teaching them to others. His knowledge includes mathematics, mechanics, and the use of tool; they also include the application of imagination, ingenuity, creativity, and vision of what can be."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba56a57f-c165-4ddb-a8c4-d526098e5776",
                        "source_entry_id": "57bc0a7e-d13c-3b8a-868c-8d0a3870dce4",
                        "source_sense_id": "d36a6ed1-dc73-34f2-9347-7c9ff6ee64eb",
                        "source_sense_description": "person",
                        "target_lang_word": "scheepsbouwer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scheepsbouwer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d522d0aa-c6d9-3750-9ead-ddcf79320fd6",
                                        "entry_id": "fa03433e-8dd6-328c-979d-963847e2fc51",
                                        "glosses": [
                                            "persoon die schepen ontwerpt en bouwt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ee4a1b-ae21-4a7b-b5db-16c396157281",
                                                "sense_id": "d522d0aa-c6d9-3750-9ead-ddcf79320fd6",
                                                "text": "Die Lech Walesa, die scheepsbouwer uit Gdansk, was beslist geen vijand van de staat; hij was een logisch voortbrengsel van de staat, en hoewel hij discipline nodig had om in de pas te blijven lopen, waren zijn dimensies en kwaliteiten bekend."
                                            },
                                            {
                                                "example_id": "809b60ff-d067-4032-bc99-d7ee8e19d101",
                                                "sense_id": "d522d0aa-c6d9-3750-9ead-ddcf79320fd6",
                                                "text": "De scheepsbouwer meende dat hij tijd genoeg had om een tweede jacht op stapel te zetten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc1258d4-1534-3f6f-9826-792f0f948baf",
                                        "entry_id": "fa03433e-8dd6-328c-979d-963847e2fc51",
                                        "glosses": [
                                            "bedrijf dat schepen bouwt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fe91a37-27e9-4fbb-a55c-36fc3b3a2705",
                                                "sense_id": "fc1258d4-1534-3f6f-9826-792f0f948baf",
                                                "text": "\"De vraag is hoeveel werk bij Nederlandse bedrijven zal belanden\", zegt Wouter Kruijt, marine-expert en oud-directeur van scheepsbouwer IHC. \"Daar heb ik mijn twijfels over.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4644729e-05d1-45cd-a050-a5c0abd3f755",
                        "source_entry_id": "57bc0a7e-d13c-3b8a-868c-8d0a3870dce4",
                        "source_sense_id": "d36a6ed1-dc73-34f2-9347-7c9ff6ee64eb",
                        "source_sense_description": "person",
                        "target_lang_word": "Schiffsbauer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schiffsbauer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a12d7710-ffc5-30c1-afbf-fec3da9a999d",
                                        "entry_id": "d9b035ca-fd57-3bba-a38f-0809ade61ce9",
                                        "glosses": [
                                            "jemand, der ein Schiff/Schiffe baut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd897fea-b2b4-4192-8aad-1262c2815db5",
                                                "sense_id": "a12d7710-ffc5-30c1-afbf-fec3da9a999d",
                                                "text": "„Nachdem alle Details der Konstruktion sorgfältig berechnet und aufgezeichnet waren, begannen die Schiffsbauer, die falschen Rippen am Kiel zu befestigen.“"
                                            }
