{
    "word_family": [
        "methamphetamine"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cdafc502-8707-3a37-aa66-7a54db6aa438",
                    "sense_definition": "A powerful and highly addictive stimulant drug, specifically methamphetamine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police launched a major operation to stop the distribution of <w>meth</w> in the city.",
                            "target_lang_translations": {
                                "zh": "警方开展了一次大规模行动，打击<w>冰毒</w>在本市的贩运。"
                            }
                        },
                        {
                            "text": "He struggled for years to overcome his addiction to <w>meth</w>.",
                            "target_lang_translations": {
                                "zh": "多年来，他一直在努力戒掉对<w>冰毒</w>的毒瘾。"
                            }
                        }
                    ],
                    "synonyms": [
                        "methamphetamine"
                    ],
                    "common_phrases": [
                        "meth addiction",
                        "meth lab"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal term for a controlled substance."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种效力很强且极易成瘾的兴奋剂毒品，特指甲基苯丙胺。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "冰毒",
                                "target_lang_sense_clarification": "俚语，指甲基苯丙胺这种强效兴奋剂毒品"
                            },
                            {
                                "target_lang_word": "甲基苯丙胺",
                                "target_lang_sense_clarification": "较正式的说法，指甲基苯丙胺"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0489605-3d05-3f0f-ba49-8437d3334c68",
                    "sense_definition": "Marijuana or cannabis.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people use the term <w>meth</w> incorrectly to refer to cannabis products.",
                            "target_lang_translations": {
                                "zh": "有些人会误用这个词来指<w>大麻</w>制品。"
                            }
                        },
                        {
                            "text": "The slang usage of <w>meth</w> to mean marijuana is highly regional and uncommon.",
                            "target_lang_translations": {
                                "zh": "把<w>大麻</w>叫作这个词的俚语用法地域性很强，而且并不常见。"
                            }
                        }
                    ],
                    "synonyms": [
                        "marijuana",
                        "cannabis"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Non-standard or regional usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "大麻；大麻类制品。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大麻",
                                "target_lang_sense_clarification": "非标准、地区性用法，指大麻"
                            },
                            {
                                "target_lang_word": "大麻制品",
                                "target_lang_sense_clarification": "较正式说法，指大麻及其制品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5326944c-e5a8-3ab0-b91b-d269efd8893a",
                    "sense_definition": "Methadone, a synthetic opioid used in medical treatment.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clinic provides <w>meth</w> as part of a supervised recovery program.",
                            "target_lang_translations": {
                                "zh": "这家诊所提供<w>美沙酮</w>，作为受监督康复项目的一部分。"
                            }
                        },
                        {
                            "text": "Patients are monitored closely while they are prescribed <w>meth</w> for pain management.",
                            "target_lang_translations": {
                                "zh": "患者因镇痛而被处方<w>美沙酮</w>时，会受到密切监测。"
                            }
                        }
                    ],
                    "synonyms": [
                        "methadone"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal abbreviation for methadone."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "美沙酮，一种用于医疗治疗的合成阿片类药物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "美沙酮",
                                "target_lang_sense_clarification": "俚语缩略，指用于医疗治疗的合成阿片类药物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7e6633a-95d5-3ffa-bfa4-31b36da191ee",
                    "sense_definition": "A traditional spiced mead drink.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "drinks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Historical accounts describe the consumption of <w>meth</w> during festive gatherings in ancient times.",
                            "target_lang_translations": {
                                "zh": "历史记载提到，人们在古代节庆聚会中会饮用<w>香料蜜酒</w>。"
                            }
                        },
                        {
                            "text": "The recipe for this traditional <w>meth</w> includes honey and various aromatic spices.",
                            "target_lang_translations": {
                                "zh": "这种传统<w>香料蜜酒</w>的配方包括蜂蜜和各种芳香香料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mead"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a historical beverage."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种传统的加香料蜂蜜酒。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "香料蜜酒",
                                "target_lang_sense_clarification": "古语，指传统的加香料蜂蜜酒"
                            },
                            {
                                "target_lang_word": "蜜酒",
                                "target_lang_sense_clarification": "更宽泛地指蜜酒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e7d2f2f-9067-33ea-959b-11a9aa24fee9",
                    "sense_definition": "A homeless person or wanderer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The term <w>meth</w> was once used in older literature to describe a vagrant.",
                            "target_lang_translations": {
                                "zh": "这个词曾在较早的文学作品中用来指<w>流浪汉</w>。"
                            }
                        },
                        {
                            "text": "He was treated like a <w>meth</w> by the wealthy residents of the town.",
                            "target_lang_translations": {
                                "zh": "镇上的富人把他当成一个<w>流浪汉</w>来对待。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tramp",
                        "vagrant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Outdated term for a homeless person."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "无家可归的人；流浪者。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "流浪汉",
                                "target_lang_sense_clarification": "古语，指无家可归者或四处漂泊的人"
                            },
                            {
                                "target_lang_word": "流浪者",
                                "target_lang_sense_clarification": "书面、较中性的对应词"
                            },
                            {
                                "target_lang_word": "游民",
                                "target_lang_sense_clarification": "强调无固定住所、四处游荡"
                            }
                        ]
                    }
                }
            ]
        }
    ]
