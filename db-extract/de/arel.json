                "senses": [
                    {
                        "sense_id": "6bbad0cb-200c-3b89-9142-9d5519e4e8ec",
                        "entry_id": "5d5f8cde-aab1-362e-854e-d2af3c803fa0",
                        "glosses": [
                            "Hauptort der belgischen Provinz Luxemburg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af88f632-a533-4b49-885e-9fe7f5d8f36c",
                                "sense_id": "6bbad0cb-200c-3b89-9142-9d5519e4e8ec",
                                "text": "„Der deutschsprechende Teil des auf dem Wiener Kongreß entstandenen Großherzogtums Luxemburg blieb bei der Teilung von 1839 dem König der Niederlande und dem Deutschen Bund unterstellt, nur ein Stück im Nordwesten mit Arlon (Arel) als Hauptstadt wurde belgische Provinz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19aead3a-c89c-4d15-b0bb-a802ed49f11f",
                        "source_entry_id": "5d5f8cde-aab1-362e-854e-d2af3c803fa0",
                        "source_sense_id": "6bbad0cb-200c-3b89-9142-9d5519e4e8ec",
                        "source_sense_description": "Hauptort der Provinz Luxemburg",
                        "target_lang_word": "Arlon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arlon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a6c611f3-9333-3428-a2c4-56ec2780378a",
                                        "entry_id": "f3b4f768-0ddc-3ca5-8190-3c3c056313ec",
                                        "glosses": [
                                            "Commune de la province de Luxembourg de la région wallonne de Belgique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aecabfab-8718-4baa-a180-c8ec68705bc5",
                                                "sense_id": "a6c611f3-9333-3428-a2c4-56ec2780378a",
                                                "text": "De 1557 à 1587, Materne Cholinus, d’Arlon, fait rouler ses presses à Cologne ; il devient membre du Sénat de la ville et acquiert une grande fortune."
                                            },
                                            {
                                                "example_id": "704bb0e6-210d-4cca-8bc0-9637482e9b75",
                                                "sense_id": "a6c611f3-9333-3428-a2c4-56ec2780378a",
                                                "text": "Plus tard, nommé évêque de Tours, Martin eut à traverser nos régions, c’était en l’année 385 ; de Tours, il se rendait à Trêves à la cour de l’Empereur Maxime pour demander la grâce de Priscillianistes condamnés à mort, il prit naturellement la voie de Reims à Trêves passant par Ville-sur-Retourne, Pont-à-Bar, Tannay, Mouzon, Yvois, Arlon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
