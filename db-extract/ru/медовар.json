                    },
                    {
                        "translation_id": "35d5bec3-220d-4978-b7a8-686a4b51f055",
                        "source_entry_id": "780e867c-f051-3d06-b289-47568eda79c5",
                        "source_sense_id": "9648b408-1c13-34bd-953b-822897500863",
