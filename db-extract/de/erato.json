                        "entry_id": "e1ea6845-ef55-32ae-95ff-e05ac89a382a",
                        "glosses": [
                            "eine der neun Musen, die als Göttinnen der Künste und Wissenschaften agieren. Alle neun Musen sind Töchter des Zeus und der Mnemosyne. Die Musen gelten als Beschützerinnen und Förderinnen des geistigen Lebens. Erato ist die Muse der Liebesdichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b23fa26-6443-42e3-abfa-4744e2436305",
                                "sense_id": "df1a3572-a2c7-3109-9cea-2540539fd365",
                                "text": "Erato wird gerne mit einer Harfe, Lyra oder Laute dargestellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
