{
    "word_family": [
        "broadcast",
        "broadcasting",
        "rebroadcast",
        "telecast"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "88666df2-d57b-3fea-9175-c0e67f3e3798",
                    "sense_definition": "A person who presents or hosts programs on radio or television, such as news or documentaries.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "media_professionals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous <w>broadcaster</w> interviewed the prime minister on the evening news.",
                            "target_lang_translations": {
                                "ru": "Знаменитый <w>ведущий</w> взял интервью у премьер-министра в вечерних новостях."
                            }
                        },
                        {
                            "text": "She started her career as a local radio <w>broadcaster</w> before moving to national television.",
                            "target_lang_translations": {
                                "ru": "Она начала свою карьеру как <w>диктор</w> на местном радио, прежде чем перейти на национальное телевидение."
                            }
                        }
                    ],
                    "synonyms": [
                        "presenter",
                        "announcer",
                        "host"
                    ],
                    "common_phrases": [
                        "radio broadcaster",
                        "television broadcaster",
                        "veteran broadcaster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведет программы на радио или телевидении, например, новости или документальные фильмы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ведущий",
                                "target_lang_sense_clarification": "теле- или радиопрограмм"
                            },
                            {
                                "target_lang_word": "диктор",
                                "target_lang_sense_clarification": "читающий текст в эфире"
                            },
                            {
                                "target_lang_word": "тележурналист",
                                "target_lang_sense_clarification": "работающий в кадре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42787bff-6d9d-350d-bb25-4557537c9a48",
                    "sense_definition": "An organization or station that transmits programs via radio, television, or the internet.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "media_organizations",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The national <w>broadcaster</w> announced a new series of educational programs for children.",
                            "target_lang_translations": {
                                "ru": "Национальный <w>вещатель</w> анонсировал новую серию образовательных программ для детей."
                            }
                        },
                        {
                            "text": "Robert Lee was scheduled to cover a University of Virginia game in the city for the <w>broadcaster</w> on 2 September.",
                            "target_lang_translations": {
                                "ru": "Роберт Ли должен был освещать игру Университета Вирджинии в городе для <w>телеканала</w> 2 сентября."
                            }
                        }
                    ],
                    "synonyms": [
                        "station",
                        "network",
                        "channel"
                    ],
                    "common_phrases": [
                        "public broadcaster",
                        "commercial broadcaster",
                        "national broadcaster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организация или станция, осуществляющая вещание программ через радио, телевидение или интернет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вещатель",
                                "target_lang_sense_clarification": "организация, осуществляющая трансляцию"
                            },
                            {
                                "target_lang_word": "телеканал",
                                "target_lang_sense_clarification": "телевизионная станция"
                            },
                            {
                                "target_lang_word": "радиостанция",
                                "target_lang_sense_clarification": "радиовещательная компания"
                            },
                            {
                                "target_lang_word": "телекомпания",
                                "target_lang_sense_clarification": "организация, производящая и вещающая контент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c17d84f6-ccd2-38c9-b749-279fcd5d2a0b",
                    "sense_definition": "A piece of electronic equipment used to transmit audio, video, or data signals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transmission_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician repaired the digital <w>broadcaster</w> to restore the signal to the remote village.",
                            "target_lang_translations": {
                                "ru": "Техник отремонтировал цифровой <w>передатчик</w>, чтобы восстановить сигнал в отдаленной деревне."
                            }
                        },
                        {
                            "text": "They installed a new wireless <w>broadcaster</w> to improve the network coverage across the campus.",
                            "target_lang_translations": {
                                "ru": "Они установили новый беспроводной <w>транслятор</w>, чтобы улучшить покрытие сети на территории кампуса."
                            }
                        }
                    ],
                    "synonyms": [
                        "transmitter"
                    ],
                    "common_phrases": [
                        "digital broadcaster",
                        "signal broadcaster"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Электронное оборудование, используемое для передачи аудио-, видео- или информационных сигналов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передатчик",
                                "target_lang_sense_clarification": "устройство для трансляции сигнала"
                            },
                            {
                                "target_lang_word": "транслятор",
                                "target_lang_sense_clarification": "техническое средство вещания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c175b542-c94e-3ed0-80dc-3c4194022471",
                    "sense_definition": "A machine or person used to scatter seeds or fertilizer over a wide area.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer used a mechanical <w>broadcaster</w> to distribute the seeds evenly across the field.",
                            "target_lang_translations": {
                                "ru": "Фермер использовал механический <w>разбрасыватель</w>, чтобы равномерно распределить семена по полю."
                            }
                        },
                        {
                            "text": "A manual <w>broadcaster</w> is still used in some small gardens to spread fertilizer.",
                            "target_lang_translations": {
                                "ru": "В некоторых небольших садах для распределения удобрений до сих пор используется ручная <w>сеялка</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "seeder",
                        "spreader"
                    ],
                    "antonyms": [
                        "driller"
                    ],
                    "common_phrases": [
                        "seed broadcaster",
                        "fertilizer broadcaster"
                    ],
                    "target_lang_definitions": {
                        "ru": "Машина или человек, используемые для разбрасывания семян или удобрений на большой площади."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбрасыватель",
                                "target_lang_sense_clarification": "сельскохозяйственная техника для семян или удобрений"
                            },
                            {
                                "target_lang_word": "сеялка",
                                "target_lang_sense_clarification": "машина для разбрасывания семян"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}