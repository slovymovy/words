                "senses": [
                    {
                        "sense_id": "5f73b53b-62dc-3496-86d6-bf0a59ce8c5a",
                        "entry_id": "c946b8d9-df49-3013-97c0-c8d6502be611",
                        "glosses": [
                            "Lait caillé."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "aa0e6f7a-02fc-44d4-a2d3-d53856d1bec9",
                                "sense_id": "5f73b53b-62dc-3496-86d6-bf0a59ce8c5a",
                                "text": "L’Union européenne a accordé officiellement à la Mattentaart (tarte au maton) de Grammont, en Flandre orientale le statut de \"produit européen du terroir\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "db3c9de7-8106-3722-ad75-e8376206138c",
                        "entry_id": "c946b8d9-df49-3013-97c0-c8d6502be611",
                        "glosses": [
                            "Petite masse agglomérée de certaines matières, qui se forme par accident lors de la fabrication."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "7a7317fd-6824-4339-abe3-f30d6093a7ae",
                                "sense_id": "db3c9de7-8106-3722-ad75-e8376206138c",
                                "text": "Un maton de pâte à papier."
                            },
                            {
                                "example_id": "03c1a1d3-59f0-4740-a897-63d7fc56d608",
                                "sense_id": "db3c9de7-8106-3722-ad75-e8376206138c",
                                "text": "Un maton de laine s’est formé lors du cardage."
                            }
                        ]
                    }
                ],
