                },
                {
                    "sense_id": "c04daf3c-e07a-3037-90ef-5d59150713f2",
                    "sense_definition": "Approbation et acceptation officielle d'un texte, d'un projet ou d'une proposition par un vote.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique_droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les députés ont célébré l'<w>adoption</w> de la nouvelle loi après des débats intenses à l'Assemblée."
                        },
                        {
                            "text": "L'<w>adoption</w> de ce traité international exige le consentement formel de tous les pays signataires."
