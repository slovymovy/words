                        "glosses": [
                            "Personne qui adopte quelqu’un légalement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "072f3ae3-38ae-4a9e-a5b0-be518f17e907",
                                "sense_id": "142c8fbe-e940-3edb-9f2b-23798c1b6609",
                                "text": "Si l’adoptant est une femme mariée, le tribunal peut, dans le jugement d’adoption, décider, du consentement du mari de l’adoptante, que le nom de ce dernier sera conféré à l’adopté dans les conditions prévues aux précédents alinéas du présent article ; si le mari est décédé ou dans l’impossibilité de manifester sa volonté, le tribunal apprécie souverainement, les héritiers du mari ou ses successibles les plus proches dans l’ordre légal dûment consultés."
                            }
                        ]
                    }
