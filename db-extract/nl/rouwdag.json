                        "examples": [
                            {
                                "example_id": "6a6565e5-2f2d-410b-83fe-f101fde93ac9",
                                "sense_id": "4553cee9-9b77-32b7-8bf1-9eb9afe77384",
                                "text": "Kirahure is de opvolger van de legendarische Titus, hoofdrolspeler in ’Gorilla’s in the Mist’. De bioscoopfilm gaat over het leven van de Amerikaanse primatoloog Dian Fossey en haar bijzondere band met Titus. Titus stierf in 2009 een natuurlijke dood op 34-jarige leeftijd, wat nog net geen nationale rouwdag opleverde."
                            },
                            {
                                "example_id": "874faa7f-77cf-4d35-97bf-144ab4a0326e",
                                "sense_id": "4553cee9-9b77-32b7-8bf1-9eb9afe77384",
                                "text": "Zondag is Tisja Beav, de traditionele rouwdag van het jodendom. Tienduizenden joden worden verwacht op de voor hen heilige Tempelberg, waar ook de al-Aqsamoskee is gevestigd."
                            }
                        ]
                    }
