                                "target_senses": [
                                    {
                                        "sense_id": "85cad2c2-d981-327c-b03b-b55650b3cb30",
                                        "entry_id": "78239192-7367-3633-af04-ac5fa1d64fee",
                                        "glosses": [
                                            "The back part of the head or skull."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c6ee850-b470-48cc-9cdd-b24dc1320d22",
                                                "sense_id": "85cad2c2-d981-327c-b03b-b55650b3cb30",
                                                "text": "And then came Turbor, who sat quietly and unemotionally through the fifteen minute process, and Munn, who jerked at the first touch of the electrodes, and then spent the session rolling his eyes as though he wished he could turn them backwards and watch through a hole in his occiput."
                                            },
                                            {
                                                "example_id": "c8573fa5-d5c4-4aec-a8fb-9b450269ce19",
                                                "sense_id": "85cad2c2-d981-327c-b03b-b55650b3cb30",
                                                "text": "He wore a large white cotton Nubian shirt, trimmed with red pompons, and shaved his head, except for one lock at the occiput ‘by which Mohammed lifts you up on Judgement Day’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eba58101-d6c8-4a7c-a88c-fd0d453a6ec3",
