                "senses": [
                    {
                        "sense_id": "785fe88a-c84e-316f-ba7d-a2e4b95eee4a",
                        "entry_id": "a0753a3b-92e0-3db7-b7d3-609ae513fe17",
                        "glosses": [
                            "Kapelle, die Karl I., Kaiser von Österreich - König Karl IV. von Ungarn oder \\\"Karl dem Großen\\\" geweiht wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5245ad96-6edc-4ca9-b771-3cb28ca3ca06",
                                "sense_id": "785fe88a-c84e-316f-ba7d-a2e4b95eee4a",
                                "text": "„Am bekanntesten ist die „Karlskapelle“ in Übach-Palenberg, die kürzlich aufwändig restauriert wurde. Sie stammt aus dem 12. Jahrhundert und ist dem Apostel Petrus gewidmet, geht aber wahrscheinlich auf einen Holzbau zurück, der in der Zeit Karls des Großen errichtet wurde, vermutlich als Jagdkapelle. “"
                            },
                            {
                                "example_id": "f181a1cd-0834-455a-aad2-6e28c7a92d4c",
                                "sense_id": "785fe88a-c84e-316f-ba7d-a2e4b95eee4a",
                                "text": "„Die Karlskapelle hat ihren Standort in der Stadt Erkelenz, im Kreis Heinsberg. Die Karlskapelle wurde zur Ehren Kaiser Karl des Großen errichtet.“"
                            },
                            {
                                "example_id": "3ef537d9-d182-440b-8c57-89e34b96252d",
                                "sense_id": "785fe88a-c84e-316f-ba7d-a2e4b95eee4a",
                                "text": "„Besonders stolz sind wir auf die Schaffung dieser Karlskapelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
