                        "glosses": [
                            "Regel (der Grammatik einer Sprache), nach der ein Wort aus in der Sprache vorhandenen Wörtern oder Wortteilen neu gebildet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a128aa1d-c0dd-427a-bd8c-9c615a7847e2",
                                "sense_id": "9b4b3806-bdf7-338d-9a44-204a73e8b67b",
                                "text": "„Solche Wortbildungsregeln finden sich in allen Sprachen, das Ergebnis ist aber wiederum ein Wort und daher ein Teil der Lexik.“"
                            },
                            {
                                "example_id": "b51bad83-9455-4288-984b-608e853d917a",
                                "sense_id": "9b4b3806-bdf7-338d-9a44-204a73e8b67b",
                                "text": "„Bei der Komposition sind die Wortbildungsregeln der deutschen Grammatik zu beachten.“"
                            }
                        ],
