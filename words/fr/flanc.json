{
    "word_family": [
        "flanquer",
        "flanquement"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eaa155d1-5328-336e-916d-3b8c63c38ea4",
                    "sense_definition": "Partie latérale du corps de l'être humain ou de l'animal, située entre les côtes et la hanche.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cavalier a légèrement pressé les <w>flancs</w> de son cheval pour l'encourager à galoper."
                        },
                        {
                            "text": "L'athlète a ressenti une douleur aiguë au <w>flanc</w> droit pendant son entraînement matinal."
                        }
                    ],
                    "common_phrases": [
                        "flanc droit",
                        "flanc gauche",
                        "presser les flancs"
                    ]
                },
                {
                    "sense_id": "71686bfd-9971-3c46-8ca1-c70a6349c798",
                    "sense_definition": "Pente ou versant latéral d'une montagne, d'une colline ou d'une élévation de terrain.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "topographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un petit village de bergers s'est installé à <w>flanc</w> de montagne depuis des siècles."
                        },
                        {
                            "text": "Les randonneurs avancent avec prudence sur le <w>flanc</w> escarpé de cette haute colline."
                        }
                    ],
                    "common_phrases": [
                        "à flanc de montagne",
                        "à flanc de coteau",
                        "flanc de colline"
                    ]
                },
                {
                    "sense_id": "347528d8-0673-38e0-8ed9-f8485e5431ce",
                    "sense_definition": "Partie latérale d'un objet, d'un bâtiment ou d'une troupe militaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le navire de croisière a été endommagé sur son <w>flanc</w> lors de la manœuvre au port."
                        },
                        {
                            "text": "Le général a ordonné une manœuvre rapide pour protéger le <w>flanc</w> exposé de l'armée."
                        }
                    ],
                    "synonyms": [
                        "côté"
                    ],
                    "common_phrases": [
                        "attaque de flanc",
                        "prêter le flanc"
                    ]
                }
            ]
        }
    ]
}