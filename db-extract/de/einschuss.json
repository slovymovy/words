                            {
                                "example_id": "e9aeec6d-a590-4b3c-a646-c9646686d72a",
                                "sense_id": "515f99a4-7d32-3bee-8e63-1d50549b1358",
                                "text": "Man erkennt noch die Einschüsse aus dem Zweiten Weltkrieg."
                            },
                            {
                                "example_id": "7d413be4-240b-4c83-9007-8c1b93fc14c8",
                                "sense_id": "515f99a4-7d32-3bee-8e63-1d50549b1358",
                                "text": "„Er hatte einen kleinen Einschuss links unter dem Schlüsselbein.“"
                            }
                        ],
