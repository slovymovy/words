                        "entry_id": "b2aa1cff-c4fe-3cf3-9441-46cc281d9ea3",
                        "glosses": [
                            "in Nederlands-Indië: halfbloed van gemengde Europese en inheemse afstamming"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "1f0d4d31-206c-46fd-bdb2-01e23617cbcb",
                                "sense_id": "be50d408-0d36-315e-b465-d3f5194b7736",
                                "text": "Reeds vroeger was de vereeniging Insulinde opgericht, waar geen kracht van uitging: men schaamde zich er nog voor indo te zijn of ‘sinjo’, ‘blauwe’ of ‘liplap’ zooals de beschaafde volbloed hem betitelde."
                            }
                        ]
                    },
                    {
                        "sense_id": "e37d4607-392f-3033-b46e-4ab31e93b5c4",
                        "entry_id": "b2aa1cff-c4fe-3cf3-9441-46cc281d9ea3",
                        "glosses": [
                            "schrijfwijze voor Indo, Nederlander van Indonesische afkomst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b7b2cb6-eee0-4c1e-ac94-e8fba5720471",
                                "sense_id": "e37d4607-392f-3033-b46e-4ab31e93b5c4",
                                "text": "Bovendien signaleert Van Leeuwen zelf in haar stuk dat Frits Bolkestein eveneens een indo was."
                            }
                        ]
                    }
