                        "examples": [
                            {
                                "example_id": "a5cc8c08-06c3-4bcd-b70c-4db30519bff3",
                                "sense_id": "7e810fc9-1699-3ce1-801d-2b7789d3850b",
                                "text": "Voor zover bekend heeft dat tot nu toe niet tot grote problemen geleid. Er is een geluk bij een ongeluk: iedereen kan nu gratis parkeren. Ook pleziervaartuigen hebben last van de stroomuitval omdat alle bruggen en een sluis in de stad niet meer werken. De beroepsvaart heeft volgens Rijkswaterstaat geen last omdat die een andere route volgt. De binnenvaartschepen gebruiken de Beatrixsluis die nog wel werkt. Verder blijft het zwembad van Nieuwegein gesloten."
                            },
                            {
                                "example_id": "dd9578a2-63a0-4dff-83d4-7c266981a03c",
                                "sense_id": "7e810fc9-1699-3ce1-801d-2b7789d3850b",
                                "text": "Het verbod geldt niet voor de grotere vaarwegen in Friesland, omdat dit belangrijke verbindingen zijn voor de beroepsvaart."
                            }
                        ]
                    }
