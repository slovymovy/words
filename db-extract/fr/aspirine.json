                                        "glosses": [
                                            "schmerzstillender Wirkstoff, Summenformel C₉H₈O₄"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad097471-6d0b-44a6-a53a-9f7c10e1ffab",
                                                "sense_id": "eca5da7c-0d36-3ac1-ab45-c7a8003914a2",
                                                "text": "Die Acetylsalicylsäure reagiert mit Alkoholen zu Estern."
                                            },
                                            {
                                                "example_id": "b0673934-e1b0-4437-bb22-3173963c3c58",
                                                "sense_id": "eca5da7c-0d36-3ac1-ab45-c7a8003914a2",
                                                "text": "Acetylsalicylsäure ist der Wirkstoff von Aspirin und einiger anderer Schmerzmittel. Er kommt in der Weidenrinde vor."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
