                "senses": [
                    {
                        "sense_id": "dae4a4fa-525a-3527-b232-07487fa53b07",
                        "entry_id": "3ac899af-dc5c-302d-b485-212af23e5b72",
                        "glosses": [
                            "A chigoe (Tunga penetrans), a kind of flea found in tropical climates."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2d608887-69ea-384c-91a5-00a1cc74cfeb",
                        "entry_id": "3ac899af-dc5c-302d-b485-212af23e5b72",
                        "glosses": [
                            "A harvest mite (Trombiculidae spp.), a very small, red mite endemic to the Midwestern and Southeastern US, the infestation of which causes intense itching."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa9da583-a0a8-478a-b869-0c9b868ec9bc",
                                "sense_id": "2d608887-69ea-384c-91a5-00a1cc74cfeb",
                                "text": "Dr. Lareau, an emergency medicine physician at Carilion Franklin Memorial Hospital in Virginia, had seen these marks once or twice before on patients. She knew what had caused them. They were from chiggers, a species of tiny, reddish-brown mites able to leave bites that remain itchy for days or weeks."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d59910a-470d-4b3c-998c-b35d0efc504b",
                        "source_entry_id": "3ac899af-dc5c-302d-b485-212af23e5b72",
                        "source_sense_description": "chigoe flea",
                        "target_lang_word": "blecha písečná",
