{
    "word_family": [
        "пропадать",
        "пропажа",
        "пропащий"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4a43ceb-dda5-34e5-ae46-1cee51ed0939",
                    "sense_definition": "Перестать быть видимым, исчезнуть или потеряться; перестать появляться где-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "disappear_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой кошелек <w>пропал</w> из сумки, когда я ехал в автобусе.",
                            "target_lang_translations": {
                                "en": "My wallet <w>disappeared</w> from my bag while I was riding the bus.",
                                "tr": "Otobüsteyken cüzdanım çantamdan <w>kayboldu</w>."
                            }
                        },
                        {
                            "text": "Куда ты <w>пропал</w> на целую неделю, мы тебя везде искали?",
                            "target_lang_translations": {
                                "en": "Where did you <w>disappear</w> to for a whole week? We were looking for you everywhere.",
                                "tr": "Bütün bir hafta boyunca nereye <w>kayboldun</w>, her yerde seni aradık?"
                            }
                        },
                        {
                            "text": "Корабль <w>пропал</w> из виду в густом тумане.",
                            "target_lang_translations": {
                                "en": "The ship <w>disappeared</w> from view in the thick fog.",
                                "tr": "Gemi yoğun siste gözden <w>kayboldu</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "исчезнуть",
                        "потеряться",
                        "затеряться",
                        "скрыться"
                    ],
                    "common_phrases": [
                        "пропасть без вести",
                        "пропасть из виду",
                        "куда ты пропал"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop being visible, vanish, or become lost; to stop appearing somewhere.",
                        "tr": "Görünmez olmak, kaybolmak veya yitmek; bir yerde görünmez hale gelmek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disappear",
                                "target_lang_sense_clarification": "to cease to be visible"
                            },
                            {
                                "target_lang_word": "vanish",
                                "target_lang_sense_clarification": "to disappear suddenly and completely"
                            },
                            {
                                "target_lang_word": "go missing",
                                "target_lang_sense_clarification": "to become lost (of objects or people)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kaybolmak",
                                "target_lang_sense_clarification": "gözden yitmek veya bulunamamak"
                            },
                            {
                                "target_lang_word": "yok olmak",
                                "target_lang_sense_clarification": "ortadan kalkmak, görünmez olmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09661020-f055-3aa9-bb64-102b166bbcc4",
                    "sense_definition": "Остаться неиспользованным, пройти бесполезно или безрезультатно (о времени, труде, билетах).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wasted_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Если мы не пойдем в театр сегодня, билеты просто <w>пропадут</w>.",
                            "target_lang_translations": {
                                "en": "If we don't go to the theater today, the tickets will simply <w>go to waste</w>.",
                                "tr": "Bugün tiyatroya gitmezsek biletler resmen <w>yanacak</w>."
                            }
                        },
                        {
                            "text": "Весь мой тяжелый труд <w>пропал</w> даром из-за одной ошибки.",
                            "target_lang_translations": {
                                "en": "All my hard work <w>went to waste</w> because of a single mistake.",
                                "tr": "Tek bir hata yüzünden bütün o ağır emeğim <w>boşa gitti</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "утратиться"
                    ],
                    "common_phrases": [
                        "пропасть даром",
                        "день пропал",
                        "билет пропал"
                    ],
                    "target_lang_definitions": {
                        "en": "To remain unused or to be spent uselessly; to go to waste (regarding time, effort, or tickets).",
                        "tr": "Kullanılmadan kalmak, boşuna gitmek veya sonuçsuz kalmak (zaman, emek veya biletler için)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go to waste",
                                "target_lang_sense_clarification": "to be unused or expended without result"
                            },
                            {
                                "target_lang_word": "be wasted",
                                "target_lang_sense_clarification": "to be used ineffectively"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "boşa gitmek",
                                "target_lang_sense_clarification": "emek veya zamanın ziyan olması"
                            },
                            {
                                "target_lang_word": "yanmak",
                                "target_lang_sense_clarification": "bilet vb. şeylerin süresinin geçip geçersiz olması"
                            },
                            {
                                "target_lang_word": "ziyan olmak",
                                "target_lang_sense_clarification": "israf olmak, faydasız kalmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55f60382-9626-3043-8e26-0400136f8fb7",
                    "sense_definition": "Погибнуть, умереть или попасть в безнадежное, безвыходное положение.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perish_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Если они узнают правду о том, что случилось, я <w>пропал</w>.",
                            "target_lang_translations": {
                                "en": "If they find out the truth about what happened, I'm <w>done for</w>.",
                                "tr": "Olanlarla ilgili gerçeği öğrenirlerse ben <w>mahvoldum</w>."
                            }
                        },
                        {
                            "text": "Без воды и солнечного света эти цветы быстро <w>пропадут</w>.",
                            "target_lang_translations": {
                                "en": "Without water and sunlight, these flowers will quickly <w>perish</w>.",
                                "tr": "Su ve güneş ışığı olmadan bu çiçekler çabucak <w>solup gidecek</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "погибнуть",
                        "умереть"
                    ],
                    "common_phrases": [
                        "пиши пропало",
                        "мы пропали",
                        "совсем пропал"
                    ],
                    "target_lang_definitions": {
                        "en": "To die, perish, or find oneself in a hopeless, desperate situation.",
                        "tr": "Ölmek, mahvolmak veya çaresiz, çıkmaz bir duruma düşmek."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be done for",
                                "target_lang_sense_clarification": "to be in a hopeless situation or doomed (idiomatic)"
                            },
                            {
                                "target_lang_word": "perish",
                                "target_lang_sense_clarification": "to die or be destroyed (formal/literary)"
                            },
                            {
                                "target_lang_word": "be doomed",
                                "target_lang_sense_clarification": "certain to fail or suffer"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mahvolmak",
                                "target_lang_sense_clarification": "kötü duruma düşmek, bitmek"
                            },
                            {
                                "target_lang_word": "ölmek",
                                "target_lang_sense_clarification": "yaşamı son bulmak (bitkiler vb. için)"
                            },
                            {
                                "target_lang_word": "gitmek",
                                "target_lang_sense_clarification": "mecazi olarak elden çıkmak, yok olmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfc371fa-fbae-39fc-89fd-4144cba1a065",
                    "sense_definition": "Испортиться, стать негодным для употребления (о продуктах питания).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spoil_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поставь суп в холодильник, иначе он <w>пропадет</w> к утру.",
                            "target_lang_translations": {
                                "en": "Put the soup in the fridge, otherwise it will <w>go bad</w> by morning.",
                                "tr": "Çorbayı buzdolabına koy, yoksa sabaha kadar <w>bozulur</w>."
                            }
                        },
                        {
                            "text": "В такую жару мясо на столе <w>пропало</w> очень быстро.",
                            "target_lang_translations": {
                                "en": "In such heat, the meat on the table <w>spoiled</w> very quickly.",
                                "tr": "Bu sıcakta masanın üzerindeki et çok çabuk <w>bozuldu</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "молоко пропало"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in spoken language regarding food"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To go bad or become unfit for consumption (referring to food).",
                        "tr": "Bozulmak, yenmeyecek veya kullanılamayacak duruma gelmek (yiyecekler için)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "go bad",
                                "target_lang_sense_clarification": "to spoil (of food)"
                            },
                            {
                                "target_lang_word": "spoil",
                                "target_lang_sense_clarification": "to become unfit for eating"
                            },
                            {
                                "target_lang_word": "go off",
                                "target_lang_sense_clarification": "to start decaying (British/Colloquial)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bozulmak",
                                "target_lang_sense_clarification": "yiyeceklerin ekşimesi veya çürümesi"
                            },
                            {
                                "target_lang_word": "kokmak",
                                "target_lang_sense_clarification": "bozulup kötü koku yaymak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c7e27ddc-8b23-3a5a-84a3-98d5f75c7dc6",
                    "sense_definition": "Очень глубокий обрыв, крутая яма; бездна.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abyss_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туристы осторожно подошли к самому краю глубокой <w>пропасти</w>.",
                            "target_lang_translations": {
                                "en": "The tourists cautiously approached the very edge of the deep <w>precipice</w>.",
                                "tr": "Turistler derin <w>uçurumun</w> tam kenarına dikkatlice yaklaştılar."
                            }
                        },
                        {
                            "text": "Камень сорвался с утеса и упал в темную <w>пропасть</w>.",
                            "target_lang_translations": {
                                "en": "A stone broke off the cliff and fell into the dark <w>abyss</w>.",
                                "tr": "Kaya uçurumdan koptu ve karanlık <w>boşluğa</w> düştü."
                            }
                        }
                    ],
                    "synonyms": [
                        "бездна"
                    ],
                    "common_phrases": [
                        "на краю пропасти",
                        "глубокая пропасть",
                        "падать в пропасть"
                    ],
                    "target_lang_definitions": {
                        "en": "A very deep hole or drop; an abyss or precipice.",
                        "tr": "Çok derin uçurum, dik çukur; dipsiz derinlik."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abyss",
                                "target_lang_sense_clarification": "a deep or bottomless chasm"
                            },
                            {
                                "target_lang_word": "precipice",
                                "target_lang_sense_clarification": "a very steep rock face or cliff"
                            },
                            {
                                "target_lang_word": "chasm",
                                "target_lang_sense_clarification": "a deep fissure in the earth"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uçurum",
                                "target_lang_sense_clarification": "dik ve derin yamaç"
                            },
                            {
                                "target_lang_word": "girdap",
                                "target_lang_sense_clarification": "derin boşluk, dipsiz kuyu anlamında"
                            },
                            {
                                "target_lang_word": "abiz",
                                "target_lang_sense_clarification": "dipsiz derinlik, uçurum"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63db28ed-6ab4-3e0f-9783-d74f41220de5",
                    "sense_definition": "Огромное различие, полное расхождение во мнениях или образе жизни.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gap_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Между богатыми и бедными в этой стране лежит огромная <w>пропасть</w>.",
                            "target_lang_translations": {
                                "en": "There is a huge <w>gulf</w> between the rich and the poor in this country.",
                                "tr": "Bu ülkede zenginler ve fakirler arasında büyük bir <w>uçurum</w> var."
                            }
                        },
                        {
                            "text": "Мы поняли, что между нами образовалась непреодолимая <w>пропасть</w>.",
                            "target_lang_translations": {
                                "en": "We realized that an insurmountable <w>chasm</w> had formed between us.",
                                "tr": "Aramızda aşılamaz bir <w>uçurum</w> oluştuğunu anladık."
                            }
                        }
                    ],
                    "synonyms": [
                        "бездна"
                    ],
                    "common_phrases": [
                        "между нами пропасть"
                    ],
                    "target_lang_definitions": {
                        "en": "A huge difference or complete divergence in opinions or lifestyle.",
                        "tr": "Görüşlerde veya yaşam tarzında büyük fark, tam bir ayrılık."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gulf",
                                "target_lang_sense_clarification": "a large difference between two people or groups"
                            },
                            {
                                "target_lang_word": "chasm",
                                "target_lang_sense_clarification": "a profound difference in opinion or feeling"
                            },
                            {
                                "target_lang_word": "gap",
                                "target_lang_sense_clarification": "a difference or disparity"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uçurum",
                                "target_lang_sense_clarification": "iki durum veya insan arasındaki büyük fark"
                            },
                            {
                                "target_lang_word": "mesafe",
                                "target_lang_sense_clarification": "görüş veya anlayış farkı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfc7aaec-4ee0-3677-96e3-475b156a407a",
                    "sense_definition": "Очень большое количество чего-либо; множество.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lots_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня сегодня <w>пропасть</w> дел, я ничего не успеваю.",
                            "target_lang_translations": {
                                "en": "I have a <w>heap</w> of things to do today; I can't keep up with anything.",
                                "tr": "Bugün <w>dünya kadar</w> işim var, hiçbir şeye yetişemiyorum."
                            }
                        },
                        {
                            "text": "На городской площади собралась целая <w>пропасть</w> народу.",
                            "target_lang_translations": {
                                "en": "A whole <w>crowd</w> of people gathered in the town square.",
                                "tr": "Şehir meydanında <w>yığınla</w> insan toplandı."
                            }
                        }
                    ],
                    "synonyms": [
                        "бездна"
                    ],
                    "common_phrases": [
                        "пропасть дел",
                        "пропасть времени"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "expressive exaggeration"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A very large quantity of something; a multitude.",
                        "tr": "Bir şeyden çok büyük miktarda bulunması; yığınla, pek çok."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "heap",
                                "target_lang_sense_clarification": "a large amount (colloquial)"
                            },
                            {
                                "target_lang_word": "ton",
                                "target_lang_sense_clarification": "a great quantity (colloquial)"
                            },
                            {
                                "target_lang_word": "lot",
                                "target_lang_sense_clarification": "a large number or amount"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dünya kadar",
                                "target_lang_sense_clarification": "çok fazla miktarda (deyim)"
                            },
                            {
                                "target_lang_word": "yığınla",
                                "target_lang_sense_clarification": "pek çok, aşırı miktarda"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c7a746ca-3558-3f54-b138-7b36db74f84d",
                    "sense_definition": "Географическое название (река или населенный пункт в России).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Река <w>Пропасть</w> протекает по территории Республики Карелия.",
                            "target_lang_translations": {
                                "en": "The River <w>Propast</w> flows through the territory of the Republic of Karelia.",
                                "tr": "<w>Propast</w> Nehri, Karelya Cumhuriyeti topraklarından geçmektedir."
                            }
                        },
                        {
                            "text": "Небольшая деревня <w>Пропасть</w> находится в Ярославской области.",
                            "target_lang_translations": {
                                "en": "The small village of <w>Propast</w> is located in the Yaroslavl region.",
                                "tr": "Küçük <w>Propast</w> köyü Yaroslavl Oblastı'nda yer almaktadır."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A geographic name (a river or settlement in Russia).",
                        "tr": "Coğrafi isim (Rusya'da bir nehir veya yerleşim yeri)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Propast",
                                "target_lang_sense_clarification": "place name"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Propast",
                                "target_lang_sense_clarification": "yer adı"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}