                "senses": [
                    {
                        "sense_id": "3c0c1247-0487-3d51-b9e5-11d93c34ac6c",
                        "entry_id": "bbf5ab7d-b1ba-3fc6-b59f-0d62112dd6c0",
                        "glosses": [
                            "in großen Teilen Afrikas verbreitete Sprachfamilie, die aus etwa 1.400 Sprachen besteht – keine andere Sprachfamilie hat mehr"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "f072352b-f958-4b07-9ae2-e9575a5725d6",
                                "sense_id": "3c0c1247-0487-3d51-b9e5-11d93c34ac6c",
                                "text": "„Die Niger-Kongo-Sprachen grenzen im Nordwesten und äußersten Nordosten an afroasiatische, im zentralen und östlichen Sudangebiet an nilosaharanische Sprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7a474ff7-5a12-39fb-b390-2270cb497570",
                        "entry_id": "bbf5ab7d-b1ba-3fc6-b59f-0d62112dd6c0",
                        "glosses": [
                            "Sprache, die Vertreter dieser Sprachfamilie ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a53a78b9-6479-4f7a-8a49-f5c377b2d02d",
                                "sense_id": "7a474ff7-5a12-39fb-b390-2270cb497570",
                                "text": "„Die Niger-Kongo-Sprache mit den meisten Sprechern ist das Swahili, das als Verkehrssprache von 30 bis 40 Mio. Menschen in Ostafrika gesprochen wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
