                "senses": [
                    {
                        "sense_id": "84d1fb37-1068-392e-a2a6-96bc63c2bf01",
                        "entry_id": "35c68aef-b795-3c89-a42d-f5f205d32b3c",
                        "glosses": [
                            "Situation, die sich unerwartet als günstig/vorteilhaft erweist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e4d6ff-7a77-47a8-89ea-7abdfff096d2",
                                "sense_id": "84d1fb37-1068-392e-a2a6-96bc63c2bf01",
                                "text": "„Nur der Glücksumstand, daß die Rakete in tiefe See abstürzte, hat ihn vor dem Schicksal der anderen bewahrt.“"
                            },
                            {
                                "example_id": "b0ad3970-b22d-45b4-8ab4-7caab34e8915",
                                "sense_id": "84d1fb37-1068-392e-a2a6-96bc63c2bf01",
                                "text": "„Von kaum geringerem Interesse sind zwei Grabsteine, die den außergewöhnlichen Grad ihrer Wohlerhaltenheit einem ähnlichen Glücksumstande verdanken.“"
                            },
                            {
                                "example_id": "7aca963e-9b3c-4e35-8c90-55a954c7555b",
                                "sense_id": "84d1fb37-1068-392e-a2a6-96bc63c2bf01",
                                "text": "„Zudem entwirft Wieland seinen Tifan als eine von den menschlichen Anlagen her ebenso wie von seinem Herkommen und den Glücksumständen seines Lebenswegs so unwahrscheinliche Gestalt, dass man zuweilen versucht ist, Satire zu vermuten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
