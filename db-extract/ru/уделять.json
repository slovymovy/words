                            {
                                "example_id": "4e0fc7f5-b334-4c0b-be90-5cdaeab4de84",
                                "sense_id": "d27e3b48-5b75-3162-b042-fb06e8c10d49",
                                "text": "Она́ уделя́ет вре́мя спо́рту.",
                                "translation": "She finds time for sports.",
