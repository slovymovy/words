                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b44865b-d591-4cf2-b7d2-c0bea6f09050",
                        "source_entry_id": "6a601d3d-109b-372a-9cd6-af7b01da6208",
                        "source_sense_id": "8459871e-839b-3fd9-91c0-a96b1256b05b",
                        "target_lang_word": "неадекватный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неадекватный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd37948-c716-395d-a07d-79ea7bfbf2ec",
                                        "entry_id": "51fc20c3-fe11-3796-8a3b-e26e5f5ef1a0",
                                        "glosses": [
                                            "не соответствующий чему-либо, неподходящий для чего-либо"
                                        ],
                                        "tags": [
                                            "обычно с дат. п."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b9906d-6e6f-4faf-8058-3f54f6212104",
                                                "sense_id": "8bd37948-c716-395d-a07d-79ea7bfbf2ec",
                                                "text": "Состоявшийся в Москве конгресс оппозиционных сил выявил с очевидностью две вещи: запрос на оппозицию в обществе созрел, но предполагаемый состав ее лидеров насущной задаче неадекватен…"
                                            },
                                            {
                                                "example_id": "1ca5003f-0460-421f-aae6-fa665953412a",
                                                "sense_id": "8bd37948-c716-395d-a07d-79ea7bfbf2ec",
                                                "text": "Вторая проблема — стиль управления, неадекватный рыночным условиям."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ecdf066-8b39-335e-ad4b-f29109a0d37e",
                                        "entry_id": "51fc20c3-fe11-3796-8a3b-e26e5f5ef1a0",
                                        "glosses": [
                                            "мед. невменяемый, ведущий себя несоответствующим ситуации образом, имеющий психические отклонения; также проявляющий признаки таких отклонений"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d33fc498-eab1-48b1-badd-401e045d9c4c",
                                                "sense_id": "8ecdf066-8b39-335e-ad4b-f29109a0d37e",
                                                "text": "Секретари всегда просматривают такие письма и никогда не кладут их боссу на стол, потому что пишут их неадекватные люди."
                                            },
                                            {
                                                "example_id": "5e093973-da56-4aee-b0a0-85f35cc6e143",
                                                "sense_id": "8ecdf066-8b39-335e-ad4b-f29109a0d37e",
                                                "text": "Он слишком э… неадекватен, даже опасен, поэтому лежит в отдельной палате и все время заперт."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
