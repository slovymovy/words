                                "target_senses": [
                                    {
                                        "sense_id": "58e76bf7-c22e-3d57-a67d-bda5ba2c9b65",
                                        "entry_id": "e99b8e27-02ea-3682-9d6d-1c53ba9a3401",
                                        "glosses": [
                                            "allgemeine Bezeichnung für Knochenleiden oder Knochenkrankheiten (besonders Stoffwechselkrankheiten der Knochen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74ad457a-e707-4b57-88fa-5d0a92836936",
                                                "sense_id": "58e76bf7-c22e-3d57-a67d-bda5ba2c9b65",
                                                "text": "„Er [der Bauchtanz] ist beispielsweise eingesetzt worden als Therapie von Osteopathie, auf ihn wird auch in der Bioenergetik oder als Variante zu Aerobic in Gymnastikzirkeln zurückgegriffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e0393aeb-1e71-3620-a192-cb2c0ebcfd4f",
                                        "entry_id": "e99b8e27-02ea-3682-9d6d-1c53ba9a3401",
                                        "glosses": [
                                            "ganzheitliches, manuelles Diagnose- und Behandlungskonzept der alternativen Medizin bei Störungen und Bewegungseinschränkungen der Faszien und Gelenke"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31e8a4f0-966f-4ca4-aeec-ddfcf912ac0c",
                                                "sense_id": "e0393aeb-1e71-3620-a192-cb2c0ebcfd4f",
                                                "text": "„Seit zwei, drei Jahren sind auch bei Tieren physikalische Behandlungsmethoden wie Osteopathie, Chiropraktik oder Physiotherapie auf dem Vormarsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
