                "senses": [
                    {
                        "sense_id": "d605b115-eeb3-3caf-826a-02010aefee93",
                        "entry_id": "0544ad9d-744b-3c36-9597-74843cbf6063",
                        "glosses": [
                            "Zustand, ganz hinten/am Ende einer Reihe zu sein; Position am Satzende"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "83b4b0d3-0202-4227-bf90-f5838e32f7a3",
                                "sense_id": "d605b115-eeb3-3caf-826a-02010aefee93",
                                "text": "„Subjunktoren wie bevor und Postponierer wie sodass regieren ihr internes Konnekt, indem sie in diesem Letztstellung des finiten Verbs bewirken oder fordern, wenn dieses ein Satz ist.“"
                            },
                            {
                                "example_id": "e9af605d-5d9a-4932-8afc-c2b798bc3094",
                                "sense_id": "d605b115-eeb3-3caf-826a-02010aefee93",
                                "text": "„Das Prädikat kann an drei Stellen im Satz stehen: in Zweitstellung, Erststellung oder Letztstellung.“"
                            },
                            {
                                "example_id": "03eb42ab-6eb4-438b-aea0-9efd2b71269c",
                                "sense_id": "d605b115-eeb3-3caf-826a-02010aefee93",
                                "text": "„Die Letztstellung des Prädikats findet sich in einer anderen Indianersprache, dem Capanahua wieder: […]“"
                            },
                            {
                                "example_id": "32384505-999f-4ebc-b09c-3bb39bfc92d4",
                                "sense_id": "d605b115-eeb3-3caf-826a-02010aefee93",
                                "text": "(Erwähnung am Schluss:) „Eine der wahnsinnigen Selbstrepräsentationen, deren Letztstellung sie als Pointe der Aufzählung ausgibt, läßt […] den […] Leser aufmerken.“"
                            },
                            {
                                "example_id": "4c68aa57-9af5-4a4a-b946-ebb1e544888a",
                                "sense_id": "d605b115-eeb3-3caf-826a-02010aefee93",
                                "text": "(Reihenfolge von Lauten in einer Silbe:) „In erster und zweiter Position im Einsatz sowie in Letztstellung in der Coda finden sich im Deutschen typischerweise Plosive; […]“ (Coda: Silbenende)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
