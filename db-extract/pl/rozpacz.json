                "translations": [
                    {
                        "translation_id": "cc7ba01a-47b9-47b3-93b1-456c46347c43",
                        "source_entry_id": "4ca0fa3e-c424-3408-9d37-bffc57f1ca4d",
                        "source_sense_id": "44c4905a-971c-35fe-a080-42cf581fdedd",
                        "target_lang_word": "despair",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25f4b7ae-8550-3429-8e42-75fdf2ca2bcd",
                                        "entry_id": "9436cc78-29ef-32ce-b4f8-18d571c3c0a5",
                                        "glosses": [
                                            "To give up as beyond hope or expectation; to despair of."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51afdf30-97d6-4137-8380-0b2d2dea4357",
                                                "sense_id": "25f4b7ae-8550-3429-8e42-75fdf2ca2bcd",
                                                "text": "I would not despair the greatest design that could be attempted."
                                            },
                                            {
                                                "example_id": "49939a1b-1fae-4bae-880f-4d7d0af508cb",
                                                "sense_id": "25f4b7ae-8550-3429-8e42-75fdf2ca2bcd",
                                                "text": "I sometimes despair of getting anything quite simple and honest done in this world by the help of men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08fb5e4d-ba1c-3801-94ce-28d420660fe6",
                                        "entry_id": "9436cc78-29ef-32ce-b4f8-18d571c3c0a5",
                                        "glosses": [
                                            "To cause to despair."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950245e3-f7d0-48f7-b33c-020fd385aca2",
                                                "sense_id": "08fb5e4d-ba1c-3801-94ce-28d420660fe6",
                                                "text": "Thinking of what I was despairing about despaired me further"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cae7f4b-cb1a-38ec-9622-d5f5dd278a9e",
                                        "entry_id": "9436cc78-29ef-32ce-b4f8-18d571c3c0a5",
                                        "glosses": [
                                            "To be hopeless; to have no hope; to give up all hope or expectation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3100cd31-6fa6-49cc-af8a-91155d041ebb",
                                                "sense_id": "6cae7f4b-cb1a-38ec-9622-d5f5dd278a9e",
                                                "text": "We despaired even of life."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "despair",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e76e1fa8-f3ef-3310-b86c-a9dbfa3cc4b0",
                                        "entry_id": "6e8ea2ce-9810-3a66-8019-5bc7d35f0685",
                                        "glosses": [
                                            "Loss of hope; utter hopelessness; complete despondency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "636d1514-3ff1-454e-bdd7-c033633bfdcb",
                                                "sense_id": "e76e1fa8-f3ef-3310-b86c-a9dbfa3cc4b0",
                                                "text": "He turned around in despair, aware that he was not going to survive."
                                            },
                                            {
                                                "example_id": "e34a8bbe-2b4e-41a2-858b-b86938be0479",
                                                "sense_id": "e76e1fa8-f3ef-3310-b86c-a9dbfa3cc4b0",
                                                "text": "My daughter's behavior drives me to despair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "826ced7e-862a-3d03-932b-850d880a8455",
                                        "entry_id": "6e8ea2ce-9810-3a66-8019-5bc7d35f0685",
                                        "glosses": [
                                            "That which causes despair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1938d09c-56cf-3757-b6fb-71035b65ee79",
                                        "entry_id": "6e8ea2ce-9810-3a66-8019-5bc7d35f0685",
                                        "glosses": [
                                            "That which is despaired of."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
