                                        "entry_id": "d87e3560-3031-3f50-a992-9426a85627fb",
                                        "glosses": [
                                            "The mixing or blending of race in marriage or breeding, interracial marriage."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "984e0320-1a9c-4a41-a702-2c91094da685",
                                                "sense_id": "0cf0f90c-c33e-38e8-87f4-59cdeed59e03",
                                                "text": "Anissimov took to posting paranoid white supremacist rants on Twitter. Why, he asked, do “blacks get your own continent”? “European whites are being replaced and destroyed by ‘diversity,’” he cried. He denounced miscegenation and declared that women should be confined to the home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6854433f-a7d8-3c00-be69-d89756ce571b",
                                        "entry_id": "d87e3560-3031-3f50-a992-9426a85627fb",
                                        "glosses": [
                                            "A mixing or blending, especially one which is considered to be inappropriate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d92589c-1d8c-4970-9438-3b5f1ad45c05",
                                                "sense_id": "6854433f-a7d8-3c00-be69-d89756ce571b",
                                                "text": "as is clear in the works of Nathaniel Hawthorne, it has a horror of any spiritual miscegenation between the human and the natural."
                                            },
                                            {
                                                "example_id": "490306d8-a8b5-4eae-af63-9f39f07fbdbd",
                                                "sense_id": "6854433f-a7d8-3c00-be69-d89756ce571b",
                                                "text": "... if a miscegenation of Latin and Sanskrit may be permitted."
                                            },
                                            {
                                                "example_id": "d1d8a0f9-eb0c-411c-bc28-249e5d27add4",
                                                "sense_id": "6854433f-a7d8-3c00-be69-d89756ce571b",
                                                "text": "...'true English' before it was bastardised in its miscegenation with the Norman French."
                                            }
