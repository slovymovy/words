                ],
                "senses": [
                    {
                        "sense_id": "ef356f69-a499-309e-a07e-e5d4850c3380",
                        "entry_id": "03b370bc-4114-3ebd-bec8-8c3fe47ae3e0",
                        "glosses": [
                            "Faire de la littérature."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d068d3d-01b9-4761-8944-c8a313651093",
                                "sense_id": "ef356f69-a499-309e-a07e-e5d4850c3380",
                                "text": "On en a tellement lu (et entendu) de publicitaires qui voulaient littératurer plus haut que leur cash-flow que cet opuscule, par sa rigueur même, sera agréable à chacun."
                            }
                        ]
                    },
                    {
                        "sense_id": "323552b7-29d1-3983-a0c6-e4ffa16ece98",
                        "entry_id": "03b370bc-4114-3ebd-bec8-8c3fe47ae3e0",
                        "glosses": [
                            "Mettre sous une forme littéraire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60545d4e-f773-4ae7-b572-0206ec196335",
                                "sense_id": "323552b7-29d1-3983-a0c6-e4ffa16ece98",
                                "text": "Eh bien, dit Étienne avec bienveillance, faut supprimer cet épisode, le raturer — Le littératurer, ajouta Saturnin."
                            },
                            {
                                "example_id": "83158193-93d0-49da-a750-73ee638fb694",
                                "sense_id": "323552b7-29d1-3983-a0c6-e4ffa16ece98",
                                "text": "Dans la plupart des cas, toutefois, on dirait qu’il écrit réellement au courant de la plume, sans raturer —sans littératurer…"
                            }
                        ]
                    }
                ],
