                                    {
                                        "sense_id": "f5beda47-f61d-309d-8820-12f01bd9a40c",
                                        "entry_id": "c8f607c8-fa1d-34fa-a532-058207f533cd",
                                        "glosses": [
                                            "Prone to yawning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a8231be-eaa5-4567-bc0c-ab53f9d0ca9a",
                                                "sense_id": "f5beda47-f61d-309d-8820-12f01bd9a40c",
                                                "text": "Waking up in the small room, you feel dull, stupid, gloomy, oppressed, yawny, lax, and all unstrung in body and mind..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdd7c23b-d06b-31a3-89fd-153d007516f2",
                                        "entry_id": "c8f607c8-fa1d-34fa-a532-058207f533cd",
                                        "glosses": [
                                            "Sounding like a yawn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96678d2d-6913-4f7b-820e-eec06c6ab8ee",
                                                "sense_id": "bdd7c23b-d06b-31a3-89fd-153d007516f2",
                                                "text": "I drew the deepest, yawniest breath I could fake and swiftly lifted my right arm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2fd6308-98e3-32ae-975a-1ae21f21b134",
                                        "entry_id": "c8f607c8-fa1d-34fa-a532-058207f533cd",
                                        "glosses": [
                                            "Boring, uninteresting, causing yawns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
