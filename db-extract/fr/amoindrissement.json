                ],
                "senses": [
                    {
                        "sense_id": "27863bac-01a0-3ee0-872d-d3f8e9b13fc8",
                        "entry_id": "2b4e7456-9170-337b-85ea-996efd02f0b3",
                        "glosses": [
                            "État de ce qui s'amoindrit ou de ce qui est amoindri."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1037808-793f-40d3-b187-a3a62cfdfd84",
                                "sense_id": "27863bac-01a0-3ee0-872d-d3f8e9b13fc8",
                                "text": "Ce fut ainsi que commença l’amoindrissement de la maison de la belle madame Hulot, et, disons-le, son abandon solennellement promis à madame Marneffe."
                            },
                            {
                                "example_id": "41c28f12-0d00-4c32-9c7c-cd7f116b34b8",
                                "sense_id": "27863bac-01a0-3ee0-872d-d3f8e9b13fc8",
                                "text": "Puis, après une demi-heure d'un incomparable éclat, sans qu'il se fût resserré ni concentré, sans un amoindrissement même partiel de sa lumière, le splendide météore s'éteignit soudain, …"
                            },
                            {
                                "example_id": "2000037d-436a-469e-961d-0cc64c08a7f3",
                                "sense_id": "27863bac-01a0-3ee0-872d-d3f8e9b13fc8",
                                "text": "Quelles causes générales ont produit cet amoindrissement des bourgades et des villages du Gard ?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
