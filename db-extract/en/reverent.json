                "senses": [
                    {
                        "sense_id": "1f25f655-9e3e-3017-80f6-6e547efcbd07",
                        "entry_id": "a1a0e512-a35c-3c6a-b222-65d79870f487",
                        "glosses": [
                            "Showing or characterized by great respect or reverence; respectful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df774a0d-dd4c-4e02-9aa4-1b13bbbffb68",
                                "sense_id": "1f25f655-9e3e-3017-80f6-6e547efcbd07",
                                "text": "Hackett was a vain, wealthy, violent gentleman, who held his blood and family in high esteem, and believed that a reverent respect was due to his great riches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1999e144-e6eb-4f1b-9912-5d1bb53c3e44",
                        "source_entry_id": "a1a0e512-a35c-3c6a-b222-65d79870f487",
                        "source_sense_id": "1f25f655-9e3e-3017-80f6-6e547efcbd07",
                        "source_sense_description": "showing respect or reverence; respectful",
                        "target_lang_word": "uctivý",
