                ],
                "senses": [
                    {
                        "sense_id": "5ae22866-a6b2-3cea-be02-175b57fa89f2",
                        "entry_id": "01a988e8-3041-3536-a8a8-cda0aa2c4819",
                        "glosses": [
                            "Relatif aux paupières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "555cf056-55d6-462f-bb96-65c7687d0b3b",
                                "sense_id": "5ae22866-a6b2-3cea-be02-175b57fa89f2",
                                "text": "Ce qui se rapproche le plus, peut-être, des mirages hypnagogiques auxquels je pense, c’est la tache de couleur, le coup de poignard d’une image persistante, dont la lampe, que l’on vient juste d’éteindre, blesse la nuit palpébrale."
                            },
                            {
                                "example_id": "673ee459-597f-4a08-a8cb-59305c475348",
                                "sense_id": "5ae22866-a6b2-3cea-be02-175b57fa89f2",
                                "text": "Quelques traits de mascaras, plus prononcés que ces derniers temps, relèvent ses cils et prolongent vers l’extérieur, en un trait fin, les commissures palpébrales."
                            },
                            {
                                "example_id": "a0335b68-d304-4ac6-812e-3b5ed1f32bfe",
                                "sense_id": "5ae22866-a6b2-3cea-be02-175b57fa89f2",
                                "text": "Muscle palpébral."
                            },
                            {
                                "example_id": "e2b17118-05b6-4ae3-aef6-aafba04c3e77",
                                "sense_id": "5ae22866-a6b2-3cea-be02-175b57fa89f2",
                                "text": "Ligaments palpébraux."
                            }
                        ]
                    }
