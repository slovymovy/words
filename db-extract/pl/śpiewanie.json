                    {
                        "translation_id": "6fd3207f-a420-43ac-9105-14bf43b46804",
                        "source_entry_id": "868c330a-f6d4-3d9e-9c0e-5783d70aa4f8",
                        "source_sense_id": "2cd6e592-5803-3313-ae1a-466e3039e493",
                        "target_lang_word": "唱歌",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "唱歌",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "36857050-8dd3-3db4-94ac-e7ee6c8e124f",
                                        "entry_id": "89339a8f-ba71-3b5b-b549-40ebe3156e9c",
                                        "glosses": [
                                            "吟唱歌曲"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df84e3b0-02cf-4324-8467-afcf10e0b9cc",
                                                "sense_id": "36857050-8dd3-3db4-94ac-e7ee6c8e124f",
                                                "text": "迎來挾琴易，送別唱歌難。"
                                            },
                                            {
                                                "example_id": "98d08d80-0573-4636-929d-85b98d9aa29c",
                                                "sense_id": "36857050-8dd3-3db4-94ac-e7ee6c8e124f",
                                                "text": "迎来挟琴易，送别唱歌难。"
                                            },
                                            {
                                                "example_id": "08e4b0a0-eec1-458c-b02a-3119367d409b",
                                                "sense_id": "36857050-8dd3-3db4-94ac-e7ee6c8e124f",
                                                "text": "輕舟小楫唱歌去，水遠山長愁殺人。"
                                            },
                                            {
                                                "example_id": "a00a442b-f1d0-410a-ace0-9506f2f6e03e",
                                                "sense_id": "36857050-8dd3-3db4-94ac-e7ee6c8e124f",
                                                "text": "轻舟小楫唱歌去，水远山长愁杀人。"
                                            },
                                            {
                                                "example_id": "065d1a9f-d94d-44e9-8721-fcc0b0cbc4d6",
                                                "sense_id": "36857050-8dd3-3db4-94ac-e7ee6c8e124f",
                                                "text": "主人張筵揮羽觴，吳姬唱歌聲抑揚。"
                                            },
                                            {
                                                "example_id": "f63378b9-06a6-4dfb-8d31-b81b76a660bd",
                                                "sense_id": "36857050-8dd3-3db4-94ac-e7ee6c8e124f",
                                                "text": "主人张筵挥羽觞，吴姬唱歌声抑扬。"
                                            },
                                            {
                                                "example_id": "a8527339-ca34-438a-93ef-859df1e0db6b",
                                                "sense_id": "36857050-8dd3-3db4-94ac-e7ee6c8e124f",
                                                "text": "袁先生總愛拿人家開心，我哪裏配說唱歌？"
                                            },
                                            {
                                                "example_id": "2ee4b1fe-204b-4a78-b089-a50a70a29850",
                                                "sense_id": "36857050-8dd3-3db4-94ac-e7ee6c8e124f",
                                                "text": "袁先生总爱拿人家开心，我哪里配说唱歌？"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2e6d14f-fdf2-357c-b70e-09dbfa4c9777",
                                        "entry_id": "89339a8f-ba71-3b5b-b549-40ebe3156e9c",
