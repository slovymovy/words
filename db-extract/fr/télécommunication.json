            {
                "entry_id": "9cf93d0d-d207-3654-9297-24553cfb492b",
                "word": "télécommunication",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1a4a8ad2-fe25-483e-81f5-5c2d6f7f967b",
                        "entry_id": "9cf93d0d-d207-3654-9297-24553cfb492b",
                        "tags": [
