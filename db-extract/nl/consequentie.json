                        ],
                        "form": "consequentietjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d4c887c4-289f-3fd5-80a7-d507ff56e196",
                        "entry_id": "a50f7d9a-a1a3-39dc-9163-24c1e34eb729",
                        "glosses": [
                            "een noodzakelijk gevolg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5503e488-9758-4b77-8525-cc2439274bd6",
                                "sense_id": "d4c887c4-289f-3fd5-80a7-d507ff56e196",
                                "text": "Meer belasting betalen is een consequentie van meer verdienen."
                            },
                            {
                                "example_id": "8cb65e17-90ea-431c-8ab7-85edcc1db995",
                                "sense_id": "d4c887c4-289f-3fd5-80a7-d507ff56e196",
                                "text": "Als ze tot het laatste besloot, waar ze wel degelijk naar neigde, dan had dit ongetwijfeld consequenties."
                            },
                            {
                                "example_id": "8aef8e8d-af7c-45a5-8725-e461b0e7a35f",
                                "sense_id": "d4c887c4-289f-3fd5-80a7-d507ff56e196",
                                "text": "De 'oorlogstaal' van onder anderen de Franse president Hollande en premier Rutte na de aanslagen betekent dan ook geen kantelpunt, denkt Van Ginneken. \"Hoewel we allemaal voelen dat het zo niet verder kan, is het nog maar de vraag of zo'n uitspraak consequenties heeft. Er zullen niet meteen militairen worden gestuurd. Dat rijpingsproces van zo'n beslissing zal heel lang in beslag nemen. We moeten nog maar zien hoe dat gaat.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a6a05c5-57c0-4c59-835a-649ae8077349",
                        "source_entry_id": "a50f7d9a-a1a3-39dc-9163-24c1e34eb729",
                        "source_sense_id": "d4c887c4-289f-3fd5-80a7-d507ff56e196",
                        "source_sense_description": "een noodzakelijk gevolg",
                        "target_lang_word": "Konsequenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konsequenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ccdac0e1-efb7-3529-876c-b4737638416d",
                                        "entry_id": "880454a6-756e-3f92-809f-92105a320ae2",
                                        "glosses": [
                                            "Auswirkung einer Handlung, Folge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b53b875b-fbb1-45c1-97f8-3655314b1f8b",
                                                "sense_id": "ccdac0e1-efb7-3529-876c-b4737638416d",
                                                "text": "Wer raucht, muss sich der Konsequenzen bewusst sein."
                                            },
                                            {
                                                "example_id": "d80762a8-b089-4dfe-96bf-cae814508dd2",
                                                "sense_id": "ccdac0e1-efb7-3529-876c-b4737638416d",
                                                "text": "Er war bereit, die Konsequenzen zu tragen."
                                            },
                                            {
                                                "example_id": "17ae9871-9e02-47ca-a61d-2c374919f276",
                                                "sense_id": "ccdac0e1-efb7-3529-876c-b4737638416d",
                                                "text": "Es war eine ruppige Auseinandersetzung, mit der Konsequenz, dass er noch am selben Tag kündigte."
                                            },
                                            {
                                                "example_id": "d38d3ef6-d1a4-447e-b094-27105dad1981",
                                                "sense_id": "ccdac0e1-efb7-3529-876c-b4737638416d",
                                                "text": "Das wird noch Konsequenzen haben!"
                                            },
                                            {
                                                "example_id": "6c001b60-9695-4840-b36e-06080cfaf2e2",
                                                "sense_id": "ccdac0e1-efb7-3529-876c-b4737638416d",
                                                "text": "„Du hast kein Recht auf die Konsequenzen deines Tuns.“"
                                            },
                                            {
                                                "example_id": "f132059e-b761-48f9-b78c-6b5e26770de5",
                                                "sense_id": "ccdac0e1-efb7-3529-876c-b4737638416d",
                                                "text": "„Nel kommt nochmals auf seine Hauptthese zu sprechen: \"Seine Intention war, einen Menschen zu töten\", so der Staatsanwalt - unabhängig davon, ob er Reeva dort glaubte oder einen Einbrecher. \"Dass es keine Konsequenzen für ihn geben soll, darf nicht sein\", so Nel.“"
                                            },
                                            {
                                                "example_id": "051ada2c-f10e-466c-88a3-b2566b4ee4f4",
                                                "sense_id": "ccdac0e1-efb7-3529-876c-b4737638416d",
                                                "text": "„Die mögliche Konsequenz sind falsche Schlüsse mit unter Umständen fatalen Folgen, wenn zum Beispiel medizinische Entscheidungen oder Gerichtsurteile auf diesem Denkfehler beruhen.“"
                                            },
                                            {
                                                "example_id": "019a1c80-b3b4-4e94-8e74-cc7f64b65164",
                                                "sense_id": "ccdac0e1-efb7-3529-876c-b4737638416d",
                                                "text": "„Niemand muss für das Scheitern der Bildungspolitik Konsequenzen ziehen, schon gar nicht die Landesbildungsministerinnen und -minister. Kein Rücktritt, keine Entschuldigung, nichts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "60e0f5d3-b60f-3870-9893-343501c1ecbb",
                                        "entry_id": "880454a6-756e-3f92-809f-92105a320ae2",
                                        "glosses": [
                                            "Beharrlichkeit, Zielstrebigkeit, Ausdauer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb0bd0de-d7ff-4a99-a3df-057a3c217497",
                                                "sense_id": "60e0f5d3-b60f-3870-9893-343501c1ecbb",
                                                "text": "Er hält an seiner Idee mit äußerster Konsequenz fest."
                                            },
                                            {
                                                "example_id": "f2fd6333-276c-4412-b8a1-372d733dc077",
                                                "sense_id": "60e0f5d3-b60f-3870-9893-343501c1ecbb",
                                                "text": "„Merkwürdigerweise hatte ich den alten Derkum nie fanatisch gefunden, aber vielleicht hatte mein Vater Fanatismus und Konsequenz miteinander verwechselt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "669f2fe0-582a-4558-9394-d9f7ef100685",
                        "source_entry_id": "a50f7d9a-a1a3-39dc-9163-24c1e34eb729",
                        "source_sense_id": "d4c887c4-289f-3fd5-80a7-d507ff56e196",
                        "source_sense_description": "een noodzakelijk gevolg",
                        "target_lang_word": "consequence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consequence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a17dfe81-02c6-3ddd-b8e8-2bc8796a081d",
                                        "entry_id": "20b01fbb-b042-3cc9-b849-a88a48177ff3",
                                        "glosses": [
                                            "An effect; something that follows a cause as a result."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5fb8c39-db48-401f-a0ff-a423338183a8",
                                                "sense_id": "a17dfe81-02c6-3ddd-b8e8-2bc8796a081d",
                                                "text": "The lobule margins, furthermore, are arched away from the lobe, with the consequence that (when fully inflated) the abaxial leaf surface forms the interior lining of the lobule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91db45a7-10d8-34d6-9381-8b9259c8a44d",
                                        "entry_id": "20b01fbb-b042-3cc9-b849-a88a48177ff3",
                                        "glosses": [
                                            "An effect; something that follows a cause as a result.",
                                            "An unwanted or unpleasant effect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "506a310f-be30-466d-a1d5-34059ea52afe",
                                                "sense_id": "91db45a7-10d8-34d6-9381-8b9259c8a44d",
                                                "text": "I'm warning you. If you don't get me the report on time, there will be consequences."
                                            },
                                            {
                                                "example_id": "76d9ca32-38db-4566-8195-c7266e89b444",
                                                "sense_id": "91db45a7-10d8-34d6-9381-8b9259c8a44d",
                                                "text": "Nevertheless, it is clear that the global energy demand for air-conditioning will grow substantially as nations become more affluent, with the consequences of climate change potentially accelerating the demand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "519708f4-8deb-3b8c-8e55-2d99b2a931dd",
                                        "entry_id": "20b01fbb-b042-3cc9-b849-a88a48177ff3",
                                        "glosses": [
                                            "consecution; chain of causes and effects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1918d6b-ada2-3e88-8b15-3332f2142503",
                                        "entry_id": "20b01fbb-b042-3cc9-b849-a88a48177ff3",
                                        "glosses": [
                                            "conclusion, deduction or inference; the thing concluded."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea668696-fe1f-3524-906c-b3d534d0b414",
                                        "entry_id": "20b01fbb-b042-3cc9-b849-a88a48177ff3",
                                        "glosses": [
                                            "Importance, influence, or significance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df9c74c9-aa6c-47ab-8dfe-590e487dd825",
                                                "sense_id": "ea668696-fe1f-3524-906c-b3d534d0b414",
                                                "text": "My opinions are of no consequence whatsoever to my parents."
                                            },
                                            {
                                                "example_id": "d6dafb73-ecda-463a-947f-2a1024494cdc",
                                                "sense_id": "ea668696-fe1f-3524-906c-b3d534d0b414",
                                                "text": "Thus young Pen, the only son of an estated country gentleman, with a good allowance, and a gentlemanlike bearing and person, looked to be a lad of much more consequence than he was really; and was held by the Oxbridge authorities, tradesmen, and undergraduates, as quite a young buck and member of the aristocracy."
                                            },
                                            {
                                                "example_id": "41822b09-e5f9-4502-aa76-6f1b7de6cca4",
                                                "sense_id": "ea668696-fe1f-3524-906c-b3d534d0b414",
                                                "text": "Rooney's United team-mate Chris Smalling was given his debut at right-back and was able to adjust to the international stage in relatively relaxed fashion as Bulgaria barely posed a threat of any consequence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consequence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21909833-2fa7-3f5f-b77b-0829c68a333f",
                                        "entry_id": "194fe427-b333-3bfa-b203-4c3c05f3d78b",
                                        "glosses": [
                                            "To threaten or punish (a child, etc.) with specific consequences for misbehaviour."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1b13dee-e370-4d52-8fab-1e6a1e23d697",
                                                "sense_id": "21909833-2fa7-3f5f-b77b-0829c68a333f",
                                                "text": "The goal of consequencing is to teach the child a lesson that leads to positive choices and behaviors. The goal of punishment is to inflict pain and seek revenge. Angry parenting is punitive and ineffectual."
                                            },
                                            {
                                                "example_id": "4f571f13-04f0-4e47-981d-5af40e8278dc",
                                                "sense_id": "21909833-2fa7-3f5f-b77b-0829c68a333f",
                                                "text": "These behaviours are not acceptable within a classroom setting and often result in the child being consequenced or removed from class."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac8f2ba2-aeef-44c7-9ebe-deb1170e5c86",
                        "source_entry_id": "a50f7d9a-a1a3-39dc-9163-24c1e34eb729",
                        "source_sense_id": "d4c887c4-289f-3fd5-80a7-d507ff56e196",
                        "source_sense_description": "een noodzakelijk gevolg",
                        "target_lang_word": "conséquence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conséquence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57c05ba7-3f1f-309e-93e7-613b8f977988",
                                        "entry_id": "7514ee22-42f1-3635-a0ce-c7fc3ca9065f",
                                        "glosses": [
                                            "Suite qu’une action ou un évènement peut avoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c8261a6-a79c-4360-b82f-3b5590ab93be",
                                                "sense_id": "57c05ba7-3f1f-309e-93e7-613b8f977988",
                                                "text": "Dieu se rit des hommes qui se plaignent des conséquences alors qu’ils en chérissent les causes."
                                            },
                                            {
                                                "example_id": "4d6fff09-55d8-40b2-8ba4-cb6b14b5429e",
                                                "sense_id": "57c05ba7-3f1f-309e-93e7-613b8f977988",
                                                "text": "Les efforts inaccoutumés et excessifs imposés par Alphonse ne pouvaient rester sans conséquence, et le résultat ne s’est pas fait attendre, sous la forme de douleurs lancinantes qui ne me quittent plus."
                                            },
                                            {
                                                "example_id": "a2a5a462-18cf-472a-80bd-cbb78913b57e",
                                                "sense_id": "57c05ba7-3f1f-309e-93e7-613b8f977988",
                                                "text": "Entre un mauvais et un bon Économiste, voici toute la différence : l’un s’en tient à l’effet visible ; l’autre tient compte et de l’effet qu’on voit et de ceux qu’il faut prévoir.\nMais cette différence est énorme, car il arrive presque toujours que, lorsque la conséquence immédiate est favorable, les conséquences ultérieures sont funestes, et vice versa."
                                            },
                                            {
                                                "example_id": "c09f338f-ef45-4e94-af44-bfc8dea333e8",
                                                "sense_id": "57c05ba7-3f1f-309e-93e7-613b8f977988",
                                                "text": "La masse croit qu'elle souffre parce qu'elle subit une inique conséquence d'un passé qui était plein de violences, d'ignorance et de méchanceté ; […]."
                                            },
                                            {
                                                "example_id": "e1ad5e3d-cce0-466d-93af-908b6e107426",
                                                "sense_id": "57c05ba7-3f1f-309e-93e7-613b8f977988",
                                                "text": "Les difficultés, les mécomptes, les conséquences de la guerre et de la révolution même se font sentir de plus en plus vivement."
                                            },
                                            {
                                                "example_id": "09d2c749-02fa-4491-afa2-51a787241c05",
                                                "sense_id": "57c05ba7-3f1f-309e-93e7-613b8f977988",
                                                "text": "Tout ce qui a été dit, […], sur les conséquences funestes des lois successorales imposées par le code Napoléon s'applique exactement à cette autre portion du pays gascon […]."
                                            },
                                            {
                                                "example_id": "c8be2f32-3d07-4843-a40b-c9df94782e9f",
                                                "sense_id": "57c05ba7-3f1f-309e-93e7-613b8f977988",
                                                "text": "Des prêtres prêchaient que les malheurs du pays étaient la conséquence des hérésies et de la négligence des devoirs religieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "004379c6-cbaa-3a06-a4ff-9bf25f549356",
                                        "entry_id": "7514ee22-42f1-3635-a0ce-c7fc3ca9065f",
                                        "glosses": [
                                            "Qualité d'une personne qui dans sa conduite se montre conséquente, manifeste un esprit de suite."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba221584-d41e-36f7-9fbb-0e0f27543d6d",
                                        "entry_id": "7514ee22-42f1-3635-a0ce-c7fc3ca9065f",
                                        "glosses": [
                                            "Importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9a0c4c5-1028-4e05-a170-a090c9257113",
                                                "sense_id": "ba221584-d41e-36f7-9fbb-0e0f27543d6d",
                                                "text": "Un homme de peu de conséquence. - Une affaire de nulle conséquence. - Cela n’est d’aucune conséquence, est sans conséquence."
                                            },
                                            {
                                                "example_id": "ea1ffb90-48b5-4af1-85e6-89e7f379c0d3",
                                                "sense_id": "ba221584-d41e-36f7-9fbb-0e0f27543d6d",
                                                "text": "J’ai des choses de la dernière conséquence à lui dire."
                                            },
                                            {
                                                "example_id": "afab62d9-e176-44c0-a530-7b872d818ea4",
                                                "sense_id": "ba221584-d41e-36f7-9fbb-0e0f27543d6d",
                                                "text": "Je ne sais à quoi tient que je ne vous fasse donner les étrivières pour votre imbécillité et couardise ; mon chirurgien va vous visiter, et me dira si les horions dont vous vous prétendez navrés sont de conséquence, sinon je vous ferai écorcher vifs comme anguilles de Melun."
                                            },
                                            {
                                                "example_id": "9dd16ffc-f878-41b2-b10b-e3ca9fe80b32",
                                                "sense_id": "ba221584-d41e-36f7-9fbb-0e0f27543d6d",
                                                "text": "Pauvres rois, pharaons ! Pauvre Napoléon !\nPauvres grands disparus gisant au Panthéon !\n Pauvres cendres de conséquence !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37196f0d-3ece-30f4-a4a2-bd75358aa829",
                                        "entry_id": "7514ee22-42f1-3635-a0ce-c7fc3ca9065f",
                                        "glosses": [
                                            "Conclusion tirée d’une ou plusieurs propositions et, en général, ce qui dérive, ce que l’on déduit d’un principe, d’un fait, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c34147c1-3298-4361-b1a2-d01825f45130",
                                                "sense_id": "37196f0d-3ece-30f4-a4a2-bd75358aa829",
                                                "text": "Tirer une conséquence. - La conséquence est fausse. - Suivre toutes les conséquences d’un principe, en admettre toutes les conséquences. - Les conséquences qui découlent, qui résultent d’un principe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
