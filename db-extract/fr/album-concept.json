                                "target_senses": [
                                    {
                                        "sense_id": "ab322dbf-ee9b-347a-9735-11ecf469f19a",
                                        "entry_id": "f0576d16-98da-3bdc-929a-a75c5485f64b",
                                        "glosses": [
                                            "lp of cd gemaakt op basis van één thema"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5e3bfc-ebaa-4d29-b8c5-47c7fe1661a0",
                                                "sense_id": "ab322dbf-ee9b-347a-9735-11ecf469f19a",
                                                "text": "Zo ontstaat ook het conceptalbum, waarop een bepaald thema, tekstueel of compositorisch wordt uitgewerkt, met vaak afwisselend korte en langere nummers. Voorbeelden daarvan zijn Sgt. Pepper's Lonely Hearts Club Band van The Beatles, The Rise and Fall of Ziggy Stardust van David Bowie en Wish You Were Here (over voormalig bandlid Syd Barrett) van Pink Floyd. Sommige nummers duren een hele lp-kant en hebben minutenlange intro's, zoals Shine on You Crazy Diamond."
                                            },
                                            {
                                                "example_id": "681190ed-3b6b-468a-8d4f-7bd8184519ae",
                                                "sense_id": "ab322dbf-ee9b-347a-9735-11ecf469f19a",
                                                "text": "Kraftwerk komt spoedig weer terug naar Nederland. Op vrijdagavond 3 juli, daags voor de Grand Départ van de Tour de France, geven ze in TivoliVredenburg een extra concert. Het wordt de integrale uitvoering van het conceptalbum Tour de France uit 2003."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
