                    },
                    {
                        "sense_id": "1297ae3c-197a-341c-a90c-5370436285ef",
                        "entry_id": "b62f0bf8-f7c8-3bcb-bb3c-a3a5f919bfa7",
                        "glosses": [
                            "Russia."
                        ],
                        "tags": [
                            "derogatory",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "27bdde3f-0530-4c4a-b317-6df57a65938c",
                                "sense_id": "1297ae3c-197a-341c-a90c-5370436285ef",
                                "text": "В таком случае Мордор прекратит своё существование.",
                                "translation": "In that case, Russia will stop existing.",
                                "english": "In that case, Russia will stop existing."
                            },
                            {
                                "example_id": "c2241d30-571b-44ba-b509-dee8fa26b3cb",
                                "sense_id": "1297ae3c-197a-341c-a90c-5370436285ef",
                                "text": "Ну так Мордор же.",
                                "translation": "Well, it's Russia.",
                                "english": "Well, it's Russia."
                            },
                            {
                                "example_id": "818ce7db-be6e-4908-8a6b-9849816b3409",
                                "sense_id": "1297ae3c-197a-341c-a90c-5370436285ef",
                                "text": "Не будет никакого воздействия, весь мир просто изолирует путинскую Россию и всё. Мордор он и есть Мордор, что с него взять.",
                                "translation": "There won't be any meddling, the world will just isolate Putin's Russia, and that's it. Mordor is Mordor, nothing more.",
                                "english": "There won't be any meddling, the world will just isolate Putin's Russia, and that's it. Mordor is Mordor, nothing more."
                            }
                        ]
                    }
                ],
