                    {
                        "sense_id": "8bdb82c0-d0a1-33c0-8ae6-cd170db51e9e",
                        "entry_id": "77c21cc5-68b8-3aed-9501-ce27765102dc",
                        "glosses": [
                            "Nom donné à plusieurs espèces de poissons de la famille des diretmidés, hôtes des eaux océaniques profondes, voire abyssales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7642ff3-83fa-4447-a15e-4e8915f7a5dc",
                                "sense_id": "8bdb82c0-d0a1-33c0-8ae6-cd170db51e9e",
                                "text": "Passons maintenant à ladite dirette, dont le nom scientifique est Diretmichthys parini, une appellation venue du grec, ainsi que nous le trouvons expliqué sur divers sites, avec la décomposition du terme : di signifie deux, eretmos signifie rame, ou aviron, et ichthys, poisson."
                            },
                            {
                                "example_id": "245c897e-7996-4755-8b83-857a255dd2bb",
                                "sense_id": "8bdb82c0-d0a1-33c0-8ae6-cd170db51e9e",
                                "text": "Alors que l’humain ne possède qu’un seul exemplaire de rhodopsine, la dirette en possède 38 ! En outre, les pigments de la dirette sont particulièrement sensibles à la lumière bleue et verte."
                            }
                        ]
                    }
