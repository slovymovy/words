                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hitting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Awanturnik podszedł do niego bez słowa i nagle <w>zasunął</w> mu w twarz.",
                            "target_lang_translations": {
