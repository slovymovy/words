                                "example_id": "80b48945-8a02-4e39-a8a6-54f9cc7289e8",
                                "sense_id": "9f7677fc-b091-3c2f-a614-baf18b56f61b",
                                "text": "Dili ist die Hauptstadt von Timor-Leste."
