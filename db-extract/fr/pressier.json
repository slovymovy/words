                "senses": [
                    {
                        "sense_id": "b4aaec96-c093-3672-a6c5-70b84962cac6",
                        "entry_id": "ced1bde1-1de6-3abc-9a44-ba99a06e536a",
                        "glosses": [
                            "Ouvrier imprimeur qui travaille à la presse à bras."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7a6ac1cc-72a2-4e89-b505-d383f88aa706",
                                "sense_id": "b4aaec96-c093-3672-a6c5-70b84962cac6",
                                "text": "Le papier d’un blanc neigeux me fait horreur, mon ami, et il n’est rien que je ne lui préfère, si ce n’est ce qu’il devient quand il a reçu, sous le coup de barre d’un bourreau de pressier, l’empreinte déplorable des rêveries et des sottises de ce siècle de fer."
                            },
                            {
                                "example_id": "ec35629d-00e6-4873-a9f4-13aa118f58fe",
                                "sense_id": "b4aaec96-c093-3672-a6c5-70b84962cac6",
                                "text": "L’imprimerie arriérée y employait encore les balles en cuir frottées d’encre, avec lesquelles l’un des pressiers tamponnait les caractères."
                            },
                            {
                                "example_id": "63f75cee-2ede-4851-8f5c-08cc82cf32fb",
                                "sense_id": "b4aaec96-c093-3672-a6c5-70b84962cac6",
                                "text": "Six employés, imprimeurs et apprentis compositeurs et pressiers, relieurs, manutentionnaires, travaillent dans l’établissement."
                            }
                        ]
                    }
                ],
