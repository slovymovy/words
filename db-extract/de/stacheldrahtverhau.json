                "senses": [
                    {
                        "sense_id": "f61e05ea-a688-3b03-8802-28f1c99885d8",
                        "entry_id": "dd096f86-2fb7-3293-9b4d-ba815558112b",
                        "glosses": [
                            "Verhau aus Stacheldraht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0cf0dad-c9b5-4dc7-ab5a-7b548161baae",
                                "sense_id": "f61e05ea-a688-3b03-8802-28f1c99885d8",
                                "text": "„In Ghuwayr wurden 40 Männer von ihren Familien getrennt und mussten anderthalb Jahre hinter Stacheldrahtverhauen schmachten.“"
                            },
                            {
                                "example_id": "3f07210d-5fae-4452-b48c-a86a903268b0",
                                "sense_id": "f61e05ea-a688-3b03-8802-28f1c99885d8",
                                "text": "„Und so wurde nach de la Reys Anweisungen vor und beiderseits einer Anhöhe namens Magersfonteinkop eine neuartige Verteidigungsstellung angelegt. Sie war etwa acht Kilometer lang, hatte die Form eines gestreckten Halbmonds und bestand aus einer Reihe von Schützengräben, vor denen Stacheldrahtverhaue errichtet wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
