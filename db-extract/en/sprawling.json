                    {
                        "sense_id": "8d46424e-126e-3fa7-86d1-622b44c01517",
                        "entry_id": "1a8ed4e0-33f9-3941-9ab2-922f7c21b9cf",
                        "glosses": [
                            "Expansive; extensive"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8094f75b-df25-4717-8bc4-d53018fd8832",
                                "sense_id": "8d46424e-126e-3fa7-86d1-622b44c01517",
                                "text": "a sprawling cityscape"
                            },
                            {
                                "example_id": "1096a3ca-b7c7-4af3-9e6e-763a24fab4c8",
                                "sense_id": "8d46424e-126e-3fa7-86d1-622b44c01517",
                                "text": "We looked over Hoihow, a dirty sprawling city of 250,000 people, many of them living in old two-story buildings made of mud and white plaster, across the narrow Hainan Strait to the Liuchow Peninsula on the mainland."
                            },
                            {
                                "example_id": "cda7aec8-52ba-4b28-839b-a62c81021033",
                                "sense_id": "8d46424e-126e-3fa7-86d1-622b44c01517",
                                "text": "It's close to the sprawling University of Birmingham campus and the ever-growing Queen Elizabeth Hospital site, which also includes a large medical school."
                            },
                            {
                                "example_id": "cdf9f49e-001c-4377-9b86-8e0f2ad8e6c9",
                                "sense_id": "8d46424e-126e-3fa7-86d1-622b44c01517",
                                "text": "Donald Trump has decided instead that the NEH’s funds would be better spent on his own dream project: a sprawling sculpture garden with 250 likenesses of people he deems “American heroes.”"
                            }
                        ]
                    }
                ],
