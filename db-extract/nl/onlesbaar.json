                                        "sense_id": "37e14794-1347-38a9-886e-8a79412796a4",
                                        "entry_id": "c1cd2c02-cd55-3fc1-9611-0551593c924a",
                                        "glosses": [
                                            "Not satiable; incapable of being satisfied or appeased; very greedy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d86ab653-52a0-4f07-89f0-8788fee57866",
                                                "sense_id": "37e14794-1347-38a9-886e-8a79412796a4",
                                                "text": "Hugo, in a fine frenzy, threatens to depose the Sacristan, to do this and do that; but, in the mean while, how to quiet your insatiable Jew? Hugo, for this couple of hundreds, grants the Jew his bond for four hundred payable at the end of four years. (...) Neither yet is this insatiable Jew satisfied or settled with: he had papers against us of 'small debts fourteen years old;' his modest claim amounts finally to 'Twelve hundred pounds besides interest'"
                                            },
                                            {
                                                "example_id": "f60f621a-fbc1-4f35-b607-115eac9e5ca6",
                                                "sense_id": "37e14794-1347-38a9-886e-8a79412796a4",
                                                "text": "Such an appointment would realize my fondest dreams. But no, at any sacrifice, I must set bounds to my insatiable ambition!"
                                            }
                                        ]
                                    }
                                ]
                            },
