                "senses": [
                    {
                        "sense_id": "9bb6b883-587b-3da6-8f92-2960eee3cc3b",
                        "entry_id": "4b5c25cc-1c74-3074-9c71-d37a6532dd33",
                        "glosses": [
                            "vom Gegner nicht erwarteter Angriff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df00b57-5258-45ae-929a-40ecf3837fa7",
                                "sense_id": "9bb6b883-587b-3da6-8f92-2960eee3cc3b",
                                "text": "„Doch ihre Hoffnung, die Stadt durch einen Überraschungsangriff nehmen zu können, ist vergebens - und eine Belagerung scheint angesichts der gewaltigen Mauern Konstantinopels aussichtslos.“"
                            },
                            {
                                "example_id": "04e4e245-0db5-4d6e-a999-5125b970381c",
                                "sense_id": "9bb6b883-587b-3da6-8f92-2960eee3cc3b",
                                "text": "„Von unserem Schiff aus zählten wir bei Tagesanbruch mehr als vierzig Kriegsschiffe, die nachts in der schmalen Meerenge kreuzten, um einen Überraschungsangriff zu verhindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
