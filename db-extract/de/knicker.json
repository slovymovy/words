                "senses": [
                    {
                        "sense_id": "a89bea49-dcce-3bfa-95e2-c4a40fe83565",
                        "entry_id": "27203722-2d83-3f4c-bfc0-5f6a8a53c61e",
                        "glosses": [
                            "niggard, skinflint"
                        ],
                        "tags": [
                            "colloquial",
