                ],
                "senses": [
                    {
                        "sense_id": "61fcd1f9-32e7-35c4-9983-68bd8e27cd28",
                        "entry_id": "849fb234-fc2d-3f12-84bc-3a96d3b9da56",
                        "glosses": [
                            "ozdobna tkanina, naśladująca malowidło, stosowana do ozdoby ścian"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0092b9fe-1c5b-4206-ba7a-64aaa36b8237",
                                "sense_id": "61fcd1f9-32e7-35c4-9983-68bd8e27cd28",
                                "text": "Na wystawie zaprezentowano gobeliny z watykańskiej kolekcji."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5383ccb6-aa76-4299-b55e-dd8ac9b49e49",
                        "source_entry_id": "849fb234-fc2d-3f12-84bc-3a96d3b9da56",
                        "source_sense_id": "61fcd1f9-32e7-35c4-9983-68bd8e27cd28",
                        "target_lang_word": "tapestry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tapestry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ac570c5-d9d8-3b43-b9c0-ce33409e9f2d",
                                        "entry_id": "0c091ab8-47a4-3649-bfd6-7adcd99cab86",
                                        "glosses": [
                                            "A heavy woven cloth, often with decorative pictorial designs, normally hung on walls."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2f8e402-17cd-4752-917b-fa37e71a0b4e",
                                                "sense_id": "7ac570c5-d9d8-3b43-b9c0-ce33409e9f2d",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75de2674-b082-39b6-8b9f-58bc21ef1bd0",
                                        "entry_id": "0c091ab8-47a4-3649-bfd6-7adcd99cab86",
                                        "glosses": [
                                            "Anything with variegated or complex details."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03a1811e-6ed5-4cea-85e6-b822ebe44500",
                                                "sense_id": "75de2674-b082-39b6-8b9f-58bc21ef1bd0",
                                                "text": "European adventurers found themselves within a watery world, a tapestry of streams, channels, wetlands, lakes and lush riparian meadows enriched by floodwaters from the Mississippi River."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tapestry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5635b707-9ce7-3156-b094-ffcae8107f0b",
                                        "entry_id": "372ba6a4-f63e-3db1-8e6f-bd58b6af271e",
                                        "glosses": [
                                            "To decorate with tapestry, or as if with a tapestry."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9564d2f-34e9-4ba2-9dd0-460f3974aecc",
                                                "sense_id": "5635b707-9ce7-3156-b094-ffcae8107f0b",
                                                "text": "We had run above twenty miles when the sun set, carpeting the sea, and tapestrying the sky with a rare unison of delicate green and golden hues […]"
                                            },
                                            {
                                                "example_id": "1906b962-bdc2-48a4-be4e-49f3828df31f",
                                                "sense_id": "5635b707-9ce7-3156-b094-ffcae8107f0b",
                                                "text": "The banqueting-hall, all open to the sky, and with thick curtains of ivy tapestrying the walls, and grass and weeds growing on the arches that overpass it, is indescribably beautiful."
                                            },
                                            {
                                                "example_id": "6ffc314c-1242-4cef-9477-62a1c2a23da0",
                                                "sense_id": "5635b707-9ce7-3156-b094-ffcae8107f0b",
                                                "text": "I present Bosnavina to its Duchess, I kiss the hem of her Majesty's robe and will tapestry her Palace with conquered flags."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ea74657-d295-4738-837d-09cf6e8ebe5c",
                        "source_entry_id": "849fb234-fc2d-3f12-84bc-3a96d3b9da56",
                        "source_sense_id": "61fcd1f9-32e7-35c4-9983-68bd8e27cd28",
                        "target_lang_word": "Gobelin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gobelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                        "entry_id": "fd2041c1-190a-3916-9474-bf95c23ba600",
                                        "glosses": [
                                            "Wandteppich mit kunstvollen Stickereien, die Muster oder Bildszenen darstellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34566f36-587b-40c4-9acc-afe1a9ce91d6",
                                                "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                                "text": "„An einer Wand hängt ein großes Landschaftsgemälde, an einer anderen ein Gobelin.“"
                                            },
                                            {
                                                "example_id": "7da0a768-4691-4696-bef1-412eb28c669e",
                                                "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                                "text": "„Ruge hatte sich vorn in den Sessel mit der hohen Lehne gesetzt, dessen gestickte Polster an Gobelins erinnerten.“"
                                            },
                                            {
                                                "example_id": "1ed4a375-2932-44f9-ace9-e4cab7a471a1",
                                                "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                                "text": "„Die Burgunder eilen die Ehrentreppe hinauf, vorbei an den Marmorlöwen auf den Absätzen, vorbei an den Gobelins, die die Wände schmücken.“"
                                            },
                                            {
                                                "example_id": "26dad7a4-254a-42cc-89da-fed06e4e2017",
                                                "sense_id": "7a410780-ec25-3a9e-b9b4-da86def587af",
                                                "text": "„Nahrung zu requirieren sei reine Notdurft, sagte er, bei Bildern und Gobelins fange die Räuberei an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
