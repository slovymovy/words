                    }
                ],
                "senses": [
                    {
                        "sense_id": "b67479c0-c6fb-3b52-a235-89c921e568bb",
                        "entry_id": "87de24bb-42df-3e15-b487-03ad968cfd86",
                        "glosses": [
                            "Hormone produite par l’hypophyse, qui intervient en particulier dans la lactation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8290d87b-95dc-4b08-8293-cc6382a0f02e",
                                "sense_id": "b67479c0-c6fb-3b52-a235-89c921e568bb",
                                "text": "La prolactine joue un rôle essentiel dans la lactogenèse, chez toutes les espèces."
                            },
                            {
                                "example_id": "039ff3d1-3e16-4b79-96e2-ae3e4beec25c",
                                "sense_id": "b67479c0-c6fb-3b52-a235-89c921e568bb",
                                "text": "Au fur et à mesure de la grossesse, le taux de prolactine augmente pour être maximal en fin de gestation."
                            },
                            {
                                "example_id": "7cb06705-53ec-4b99-b98a-49a56f3ff606",
                                "sense_id": "b67479c0-c6fb-3b52-a235-89c921e568bb",
                                "text": "La prolactine est une hormone sécrétée par l'hypophyse, une glande endocrine située à la base du cerveau. Elle est normalement présente en faible quantité chez les hommes et chez les femmes en-dehors de la grossesse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6bb7261-67b7-4130-b2c2-f60a80d03e0e",
                        "source_entry_id": "87de24bb-42df-3e15-b487-03ad968cfd86",
                        "source_sense_id": "b67479c0-c6fb-3b52-a235-89c921e568bb",
