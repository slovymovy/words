                                        "examples": [
                                            {
                                                "example_id": "292297f6-3e59-48a7-96d6-73977f70446f",
                                                "sense_id": "5a3933ec-74c8-336b-8a62-37631ab4ef06",
                                                "text": "Si l’employé décélère le vendredi mais revient le lundi avec la niaque, c’est OK."
                                            }
