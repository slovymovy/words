                                "target_word": "Schnellstraße",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1b35ada-ca99-3b60-8093-cd7060160424",
                                        "entry_id": "a0feb7fd-d57d-3087-831c-b1b935cb1793",
                                        "glosses": [
                                            "asphaltierte Verbindung, auf welcher im Schnitt zügiger als normalerweise gefahren werden darf"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29e066da-4f98-4284-903f-627933e290df",
                                                "sense_id": "a1b35ada-ca99-3b60-8093-cd7060160424",
                                                "text": "Er testete seinen Neuwagen auf der Schnellstraße."
                                            },
                                            {
                                                "example_id": "71b94b0d-167a-479d-a27e-6bf9e3d0e87f",
                                                "sense_id": "a1b35ada-ca99-3b60-8093-cd7060160424",
                                                "text": "„Wenn wir die Schnellstraßen einmal quer durch das ganze Land haben werden, wie es früher oder später der Fall sein wird und sein muß, dann wird man von New York nach Kalifornien fahren können, ohne auch nur das geringste zu sehen.“"
                                            },
                                            {
                                                "example_id": "d9aa87dd-8e72-47be-a115-9d6f60cb6dfc",
                                                "sense_id": "a1b35ada-ca99-3b60-8093-cd7060160424",
                                                "text": "„Die Schnellstraße war gut geteert, und noch am selben Tag erreichte ich die Schwarzmeerstadt Odessa.“"
                                            },
                                            {
                                                "example_id": "7a0f8255-48b8-417a-b154-7b7a1354e14a",
                                                "sense_id": "a1b35ada-ca99-3b60-8093-cd7060160424",
                                                "text": "„Das Auto hatte einen Autopiloten, und sobald wir auf der Schnellstraße waren, konnte mein Bruder die Hände vom Lenkrad nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef56c668-1397-4c3f-8f5d-5cf8b0372485",
                        "source_entry_id": "f6a8f12b-e7d7-31aa-9e3f-c64b0aa03dae",
                        "source_sense_id": "4e4990f7-5f2e-3113-b8e2-934313d9e0bb",
                        "source_sense_description": "Fernverkehrsstraße, Schnellstraße, Autobahn",
                        "target_lang_word": "Autobahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autobahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                        "entry_id": "ec60252a-62ab-3c30-a453-dd67a390057d",
                                        "glosses": [
                                            "kreuzungsfrei gebaute, richtungsgetrennte Schnellstraße mit mindestens zwei Fahrspuren je Fahrtrichtung"
                                        ],
                                        "tags": [
                                            "Verkehrstechnik",
                                            "Verkehrswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "700c9e0f-78b5-4275-b91d-7cb79fa8255f",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "Die A 45 ist eine Autobahn von Norden nach Süden."
                                            },
                                            {
                                                "example_id": "6525e309-dfb4-4340-b001-4a8e84cc13b7",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "Nehmen Sie die Autobahn bis Freiburg."
                                            },
                                            {
                                                "example_id": "bb56481f-4736-444a-8d7f-18271db63a18",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "Aufgrund eines Verkehrsunfalls war gestern die Autobahn nach Berlin gesperrt."
                                            },
                                            {
                                                "example_id": "e9f04a6f-a298-4e08-97b8-55d6dd8b5ed5",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "In vielen Ländern wird für die Nutzung der Autobahn eine Maut erhoben."
                                            },
                                            {
                                                "example_id": "2cc8211b-f2e2-479b-a2c3-6d5410647b43",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "Besonders zu Beginn der Schulferien steht man auf der Autobahn häufig im Stau."
                                            },
                                            {
                                                "example_id": "01a7aea0-31b7-48f1-bd38-25c2a3ed74ea",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "„Die Autobahn schlägt eine Schneise durch einen Kiefernwald.“"
                                            },
                                            {
                                                "example_id": "8fcdb60e-cee5-4c19-a697-bb5d5bde6b9e",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "„Er las ihr vor, bis sie die Autobahn erreichten, deren heller Strich sich wie eine Neonröhre durch die Landschaft zog.“"
                                            },
                                            {
                                                "example_id": "9df82b3b-8274-4441-9f2d-f54c37c11b12",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "„Bevor ich die Autobahn sah, hörte ich sie.“"
                                            },
                                            {
                                                "example_id": "455dec8b-468b-4f1d-ab79-9bcb9a38b786",
                                                "sense_id": "e0cb0e1f-b87d-315e-b148-884b65d624c6",
                                                "text": "„Das Gerücht, dass die Erfindung der deutschen Autobahn auf Adolf Hitler zurückgeht, ist übrigens falsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
