                        "examples": [
                            {
                                "example_id": "39c9aad2-a733-4636-8933-73b21e0afe7e",
                                "sense_id": "4bc49508-60f7-34c7-8eeb-522e54c29ecf",
                                "text": "If we could but remember that, there would be no fear of our being ungodly, irreligious, undevout."
                            },
                            {
                                "example_id": "2dac4199-7f89-4c71-b999-95f65a739061",
                                "sense_id": "4bc49508-60f7-34c7-8eeb-522e54c29ecf",
                                "text": "Larry was undevout, careless, thinking little of spiritual things, so little, that he had scarcely troubled himself either to question or to accept what he had been taught, but he was quick to respond to emotion of any kind; now he listened, with an unaccustomed reverence, to Barty's voice, brokenly whispering the prayers of his Church."
                            }
                        ]
