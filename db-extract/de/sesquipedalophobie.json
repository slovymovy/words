                                    {
                                        "sense_id": "cd23c85f-d903-3c5f-a5e8-7be62e8f171c",
                                        "entry_id": "300f9a04-7a35-334a-bf37-e5b236a16d0e",
                                        "glosses": [
                                            "Fear of long words."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db941026-38ee-416c-8fff-6ad7bff9d002",
                                                "sense_id": "cd23c85f-d903-3c5f-a5e8-7be62e8f171c",
                                                "text": "But sesquipedalophobia ('hatred or fear of big words,' aptly enough) has prevailed, even among men of learning."
                                            },
                                            {
                                                "example_id": "f8cd6cc9-e90b-4692-8c4f-4f8d3787e134",
                                                "sense_id": "cd23c85f-d903-3c5f-a5e8-7be62e8f171c",
                                                "text": "That hasn't helped my sesquipedalophobia one bit..."
                                            },
                                            {
                                                "example_id": "34146f0a-07b5-46de-ab8a-4c38f947ce6e",
                                                "sense_id": "cd23c85f-d903-3c5f-a5e8-7be62e8f171c",
                                                "text": "Ayesha was like a walking dictionary of phobias. She believed that I had sesquipedalophobia – the fear of long words."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
