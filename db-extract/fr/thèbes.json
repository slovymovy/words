                "forms": [],
                "senses": [
                    {
                        "sense_id": "b666647b-94d5-34ee-84f2-9955c7adb216",
                        "entry_id": "d6f7a27a-99dc-32a3-bb55-01e62eb82c76",
                        "glosses": [
                            "Ville de Grèce, dans la région de Béotie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0dcff00-9e16-4433-b752-af108f4a0b63",
                                "sense_id": "b666647b-94d5-34ee-84f2-9955c7adb216",
                                "text": "Suivant les positions qu'ils adoptent à l'égard de l'évolution politique de Thèbes et des cités béotiennes, les commentateurs de Ps-Xénophon interprètent son allusion à l'intervention athénienne en Béotie de façons très différentes."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8852c63-e2de-3513-9043-bef5b1aa86fe",
                        "entry_id": "d6f7a27a-99dc-32a3-bb55-01e62eb82c76",
                        "glosses": [
                            "Ville de l’Égypte antique, du quatrième nome de Haute-Égypte (appelée aujourd'hui Louxor)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e326f0a-5ebb-4b11-9b19-63e136c079db",
                                "sense_id": "d8852c63-e2de-3513-9043-bef5b1aa86fe",
                                "text": "Il a été commandé par Ahmosis, le roi de Thèbes, pour le temple du dieu Amon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0a5a4c1-6480-4fc1-90c6-5fcf59e42007",
                        "source_entry_id": "d6f7a27a-99dc-32a3-bb55-01e62eb82c76",
                        "source_sense_id": "b666647b-94d5-34ee-84f2-9955c7adb216",
                        "source_sense_description": "En Grèce",
                        "target_lang_word": "Theben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4db329d9-1bd3-36ad-b59e-ff8bc8f9cadc",
                                        "entry_id": "d98317d0-00eb-32e5-a71d-3ac8b67b84b9",
                                        "glosses": [
                                            "größte Stadt in der griechischen Landschaft Böotien"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07ea5a03-73c7-4f20-bebf-c0db54be7868",
                                                "sense_id": "4db329d9-1bd3-36ad-b59e-ff8bc8f9cadc",
                                                "text": "„In Theben regierte eine konservative Aristokratie, während sich Athen als Motor des demokratischen Fortschritts sah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "12952d6b-408b-304e-8047-1c9c030a07b0",
                                        "entry_id": "d98317d0-00eb-32e5-a71d-3ac8b67b84b9",
                                        "glosses": [
                                            "altägyptische Stadt in Oberägypten"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c36efb5c-3bf7-45a5-8db5-dc9698c691b0",
                                                "sense_id": "12952d6b-408b-304e-8047-1c9c030a07b0",
                                                "text": "„Derzeit befindet sich in England ein Mumienschrein aus Theben in Privatbesitz.“"
                                            },
                                            {
                                                "example_id": "c88a67b1-1f12-4133-bae3-a996c25a56bb",
                                                "sense_id": "12952d6b-408b-304e-8047-1c9c030a07b0",
                                                "text": "„Eine völlig andere Version des Ursprungs von Volk und Herrscher vertritt Chief Oronsaye. Danach habe der Herrscher von Theben nach schweren Angriffen der Perser und anderer Völker auf Ägypten sein Land mit einer großen Zahl von Anhängern verlassen und sich zunächst im Sudan und dann, im 6. Jahrhundert nach Christus, im späteren Benin niedergelassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c3795326-5b16-395b-9f40-fc73f01e4e90",
                                        "entry_id": "d98317d0-00eb-32e5-a71d-3ac8b67b84b9",
                                        "glosses": [
                                            "deutscher Name von Devín, heute Stadtteil von Pressburg/Bratislava"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
