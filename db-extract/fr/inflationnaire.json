                "senses": [
                    {
                        "sense_id": "08a75689-6de5-39da-8dab-458f0dbed23c",
                        "entry_id": "7dfcf6d0-ef2a-3a52-8e2c-e3de989e38b9",
                        "glosses": [
                            "Relatif à l’inflation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf8e88d-e02d-4fbd-a462-1add0503fd20",
                                "sense_id": "08a75689-6de5-39da-8dab-458f0dbed23c",
                                "text": "Alors c’est la baisse, à moins que des circonstances externes très puissantes ne viennent stabiliser les prix à ce haut niveau ou ne redirigent le cycle inflationnaire lui-même vers de nouveaux sommets."
                            }
                        ]
                    },
                    {
                        "sense_id": "9805693c-652e-31a3-aafd-43005380fa19",
                        "entry_id": "7dfcf6d0-ef2a-3a52-8e2c-e3de989e38b9",
                        "glosses": [
                            "Relatif à l’expansion à taux croissant de l’univers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f87bd9d0-3070-49d6-9f83-2026acb7d632",
                                "sense_id": "9805693c-652e-31a3-aafd-43005380fa19",
                                "text": "Des surdensités qui existaient alors localement et qui ont été emportées par l’accélération de l’expansion de l’espace, causée par l’ère inflationnaire, au-delà de cet horizon peuvent produire une attraction dans une direction donnée d’une partie de la matière de l’Univers observable."
                            }
                        ]
                    }
                ],
