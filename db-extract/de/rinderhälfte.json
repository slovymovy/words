                    {
                        "sense_id": "4620ef3f-d81b-3a41-9fe8-81bc3ca25e1d",
                        "entry_id": "f3fb52c4-36cc-31d6-9149-34d816f69fac",
                        "glosses": [
                            "eine der beiden Hälften eines bei der Schlachtung (sagittal) halbierten Hausrinds"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc80016-0a54-4611-823e-f82a0831d2f9",
                                "sense_id": "4620ef3f-d81b-3a41-9fe8-81bc3ca25e1d",
                                "text": "„Nach Anmeldung wird geschlachtet, meist teilen sich mehrere Kunden eine Rinderhälfte, die dann nach Wunsch passend für die heimische Tiefkühltruhe zerlegt wird.“"
                            },
                            {
                                "example_id": "be1334fa-15a6-410d-978a-149f287d3b4b",
                                "sense_id": "4620ef3f-d81b-3a41-9fe8-81bc3ca25e1d",
                                "text": "„Rinderhälften am Arbeitsplatz dienen den bloßen Fäusten des jungen Schlachters als Sandsack.“"
                            }
                        ],
