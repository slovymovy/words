                "senses": [
                    {
                        "sense_id": "b14a623a-a3e3-345b-8209-4dedb9f7642f",
                        "entry_id": "112d9a6e-0b9b-3301-a610-44eb521b241f",
                        "glosses": [
                            "regeling van de vertrek- en aankomsttijden van openbaar vervoer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44ea3ba1-3cc8-40f9-aaf6-6f772de59414",
                                "sense_id": "b14a623a-a3e3-345b-8209-4dedb9f7642f",
                                "text": "De eerder aangekondigde marktverkenning naar alternatieve vervoerders op de hsl wordt dit najaar uitgevoerd door een onafhankelijk onderzoeksbureau. Als er voldoende vraag naar is en het kan rendabel, dan vraagt het kabinet aan NS om dit ‘aanvullende vervoersaanbod’ uit te voeren. NS behoudt in dat geval de concessie, maar schakelt een andere partij in als onderaannemer. Dat kan echter pas vanaf de dienstregeling van 2019, want die van 2018 staat eind dit jaar al goeddeels vast."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac6dba5b-fbb5-37b6-ad32-ebb71e651f7a",
                        "entry_id": "112d9a6e-0b9b-3301-a610-44eb521b241f",
                        "glosses": [
                            "boekje of ander medium waarin de vertrek- een aankomsttijden van het openbaar vervoer staan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1d25408-b872-49fe-b08a-0573b6967347",
                                "sense_id": "ac6dba5b-fbb5-37b6-ad32-ebb71e651f7a",
                                "text": "De tweede pijler is het realistische decor van Christian Schmidt: een roterend sprookjesbos waar het goed minnekozen, verstoppen en besluipen is, en waar Leporello zijn catalogusaria zingt bij de dienstregeling in een bushokje: Kijk mevrouw, in ieder stadje een ander schatje!"
                            }
                        ]
                    },
                    {
                        "sense_id": "b99a05f1-e1d7-3071-b8cd-661aa2fe1a60",
                        "entry_id": "112d9a6e-0b9b-3301-a610-44eb521b241f",
                        "glosses": [
                            "regeling van de werkzaamheden in een dienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e853fc28-8112-409b-bb3e-36c72803f7b3",
                                "sense_id": "b99a05f1-e1d7-3071-b8cd-661aa2fe1a60",
                                "text": "In die dienstregeling zitten veel te lange diensten, vinden chauffeurs. De lange diensten zouden gecompenseerd worden met een pauze aan het einde van de dienst, maar daar gaan de chauffeurs niet mee akkoord. Ze willen liever een pauze halverwege hun dienst."
                            }
                        ]
                    }
                ],
