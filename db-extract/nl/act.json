                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "act",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1fbe4ba-636c-3e37-a6db-f9ecd51a74a5",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "Something done, a deed."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ecbbec9-2566-4191-be00-07785e82dc2f",
                                                "sense_id": "f1fbe4ba-636c-3e37-a6db-f9ecd51a74a5",
                                                "text": "an act of goodwill"
                                            },
                                            {
                                                "example_id": "ab05d52c-02f5-46e2-95b8-a63f39d3252a",
                                                "sense_id": "f1fbe4ba-636c-3e37-a6db-f9ecd51a74a5",
                                                "text": "That best portion of a good man's life, / His little, nameless, unremembered acts / Of kindness and of love."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c208ce11-46a1-3cb2-9b77-09989723251d",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "Actuality."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "516b1f6c-f237-45ac-9738-33a7d9239d91",
                                                "sense_id": "c208ce11-46a1-3cb2-9b77-09989723251d",
                                                "text": "The seeds of plants are not at first in act, but in possibility, what they afterward grow to be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7794609-7ca2-3fcc-8817-f892bcb9a86e",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "Something done once and for all, as distinguished from a work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "810a5919-cf17-3704-9c35-cd64fd7329a4",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "A product of a legislative body, a statute."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1040ccd5-a245-4a05-9d1c-1b5fee404833",
                                                "sense_id": "810a5919-cf17-3704-9c35-cd64fd7329a4",
                                                "text": "But was it responsible governance to pass the Longitude Act without other efforts to protect British seamen? Or might it have been subterfuge—a disingenuous attempt to shift attention away from the realities of their life at sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50c31ed1-388a-3610-a462-8e1ced53793b",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "(In the United States) A legislative proposal, a bill that has not yet become law."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58b5415d-fe67-4708-a697-4ac6c1939d3d",
                                                "sense_id": "50c31ed1-388a-3610-a462-8e1ced53793b",
                                                "text": "Under current law, employers can drag out the union election process... Under the PRO Act, workers and the NLRB set union election procedures. The employer is not involved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "862e8e43-0104-3280-92c5-e52a1559efbb",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "The process of doing something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e8b6bbd-3e58-4fb6-b6c8-4d5888518373",
                                                "sense_id": "862e8e43-0104-3280-92c5-e52a1559efbb",
                                                "text": "He was caught in the act of stealing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c769670d-b715-3c99-b583-c8f0950d85f0",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "A formal or official record of something done."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10c26acb-2c1e-39b7-a641-0df447b8f8f5",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "A division of a theatrical performance."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "346f22f0-9464-4e05-8d0c-dcf1d8cdfd1b",
                                                "sense_id": "10c26acb-2c1e-39b7-a641-0df447b8f8f5",
                                                "text": "“H'm !” he said, “so, so—it is a tragedy in a prologue and three acts. I am going down this afternoon to see the curtain fall for the third time on what […] will prove a good burlesque ; but it all began dramatically enough. It was last Saturday […] that two boys, playing in the little spinney just outside Wembley Park Station, came across three large parcels done up in American cloth. […]”"
                                            },
                                            {
                                                "example_id": "775e4ce0-9433-4f30-be6a-60392ec108ee",
                                                "sense_id": "10c26acb-2c1e-39b7-a641-0df447b8f8f5",
                                                "text": "The pivotal moment in the play was in the first scene of the second act."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e85adfe-5393-30d3-b75f-9e47d2d1469c",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "A performer or performers in a show."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6992e02b-aa1d-4915-b358-49090200c1b7",
                                                "sense_id": "5e85adfe-5393-30d3-b75f-9e47d2d1469c",
                                                "text": "Which act did you prefer? The soloist or the band?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fba1073-1979-3b5d-a0d0-5bc8392bda08",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "Any organized activity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1f46d50-221f-4d93-b977-cfd8cce7dff3",
                                                "sense_id": "9fba1073-1979-3b5d-a0d0-5bc8392bda08",
                                                "text": "The minute you let it be known you're planning a sales campaign everybody wants to get into the act."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "914e3f2e-6a62-3d1f-b230-979b10690227",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "A display of behaviour."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41661d14-c389-3c7c-95fc-5dc51ceb7e3f",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "A display of behaviour.",
                                            "A display of behaviour meant to deceive."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43e61a09-9abe-4705-b1c7-09b0db7124cd",
                                                "sense_id": "41661d14-c389-3c7c-95fc-5dc51ceb7e3f",
                                                "text": "to put on an act"
                                            },
                                            {
                                                "example_id": "18f57429-9881-4c4d-a216-6932368db552",
                                                "sense_id": "41661d14-c389-3c7c-95fc-5dc51ceb7e3f",
                                                "text": "He said, \"I'm just curious, is this for real or just an act? / Can't tell if you love or hate me, never met someone like that\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9379f6c9-8154-35d3-b5ae-143009b424ac",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "A thesis maintained in public, in some English universities, by a candidate for a degree, or to show the proficiency of a student."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4346854-4512-3413-88e2-ee331fa52c66",
                                        "entry_id": "27566c4e-ae05-3cb2-a29e-5ec3b217de11",
                                        "glosses": [
                                            "Ellipsis of act of parliament."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "act",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55398947-9273-34a6-bb30-ab6603f6df7f",
                                        "entry_id": "607ea40d-2138-375a-8fd8-3429ec4ca37b",
                                        "glosses": [
                                            "To do something."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f80ad62-4d58-4c35-b646-cfb7326823fe",
                                                "sense_id": "55398947-9273-34a6-bb30-ab6603f6df7f",
                                                "text": "If you don’t act soon, you will be in trouble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2f2c09c-ec2d-3c35-acad-c01ae6895659",
                                        "entry_id": "607ea40d-2138-375a-8fd8-3429ec4ca37b",
                                        "glosses": [
                                            "To do (something); to perform."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7059f1d7-a3a6-449a-9c9a-06fddc316168",
                                                "sense_id": "a2f2c09c-ec2d-3c35-acad-c01ae6895659",
                                                "text": "that we act our temporal affairs with a deſire no greater than our neceſſity"
                                            },
                                            {
                                                "example_id": "9ac9e1d5-5e05-4ad5-b599-25db95fda19b",
                                                "sense_id": "a2f2c09c-ec2d-3c35-acad-c01ae6895659",
                                                "text": "Industry doth beget by producing good habits, and facility of acting things expedient for us to do."
                                            },
                                            {
                                                "example_id": "3caf1f99-4433-4ccd-b7cc-289ab7f9ec74",
                                                "sense_id": "a2f2c09c-ec2d-3c35-acad-c01ae6895659",
                                                "text": "Uplifted hands that at convenient times / Could act extortion and the worst of crimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07efe776-df50-3ee0-9dd4-d0455a1a16af",
                                        "entry_id": "607ea40d-2138-375a-8fd8-3429ec4ca37b",
                                        "glosses": [
                                            "To perform a theatrical role."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "670fcec8-f1ca-41b7-b4d1-8a5176dd7e38",
                                                "sense_id": "07efe776-df50-3ee0-9dd4-d0455a1a16af",
                                                "text": "I started acting at the age of eleven in my local theatre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3ed34db-31b3-38db-9169-c66eb0f81deb",
                                        "entry_id": "607ea40d-2138-375a-8fd8-3429ec4ca37b",
                                        "glosses": [
                                            "Of a play: to be acted out (well or badly)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9af261f-916e-4b5d-802e-9a74c1aee84e",
                                                "sense_id": "b3ed34db-31b3-38db-9169-c66eb0f81deb",
                                                "text": "But whatever types he assumes, the need to have a good play which acts delightfully well before the audience, and to their delectation, is the dominant thrust. If the play acts well, the director gets the credits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90403fa6-a3a1-3a57-88c9-2a1d5e3cc4a7",
                                        "entry_id": "607ea40d-2138-375a-8fd8-3429ec4ca37b",
                                        "glosses": [
                                            "To behave in a certain manner for an indefinite length of time."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4735b4cc-4427-4b8c-b1a8-63cee6724786",
                                                "sense_id": "90403fa6-a3a1-3a57-88c9-2a1d5e3cc4a7",
                                                "text": "A dog which acts aggressively is likely to bite."
                                            },
                                            {
                                                "example_id": "e2ecd4db-0981-4f8f-ba2f-450de1ca61c7",
                                                "sense_id": "90403fa6-a3a1-3a57-88c9-2a1d5e3cc4a7",
                                                "text": "I believe that Bill’s stuck-up because of the way that he acts."
                                            },
                                            {
                                                "example_id": "8235ae0c-5c57-48fc-b304-22f9f6c8a418",
                                                "sense_id": "90403fa6-a3a1-3a57-88c9-2a1d5e3cc4a7",
                                                "text": "He’s acting strangely—I think there’s something wrong with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49ee1d84-f1e1-3105-be91-cac1c3bf0658",
                                        "entry_id": "607ea40d-2138-375a-8fd8-3429ec4ca37b",
                                        "glosses": [
                                            "To convey an appearance of being."
                                        ],
                                        "tags": [
                                            "copulative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f21272f2-ed17-4c72-9e3b-434da90f7a0d",
                                                "sense_id": "49ee1d84-f1e1-3105-be91-cac1c3bf0658",
                                                "text": "He acted unconcerned so the others wouldn’t worry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a56a33b-9225-335b-9e99-4208ea9040ef",
                                        "entry_id": "607ea40d-2138-375a-8fd8-3429ec4ca37b",
                                        "glosses": [
                                            "To do something that causes a change binding on the doer."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f9fc9db-fd2f-4815-a4c2-9629149c63f0",
                                                "sense_id": "3a56a33b-9225-335b-9e99-4208ea9040ef",
                                                "text": "act on behalf of John"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "908a7363-05e7-3770-bb12-16684ef1c4ef",
                                        "entry_id": "607ea40d-2138-375a-8fd8-3429ec4ca37b",
                                        "glosses": [
                                            "To have an effect (on)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efba21b0-c7a7-4c97-94a9-2262a92d7f27",
                                                "sense_id": "908a7363-05e7-3770-bb12-16684ef1c4ef",
                                                "text": "High-pressure oxygen acts on the central nervous system and may cause convulsions or death."
                                            },
                                            {
                                                "example_id": "43fe54e8-57a2-4eee-8577-a8e98261dcf5",
                                                "sense_id": "908a7363-05e7-3770-bb12-16684ef1c4ef",
                                                "text": "Gravitational force acts on heavy bodies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a401dfcf-1be9-3e7a-a75f-d265ae60edd2",
                                        "entry_id": "607ea40d-2138-375a-8fd8-3429ec4ca37b",
                                        "glosses": [
                                            "To play (a role)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ccd09be-81d3-4c9e-9c3d-554410d75a76",
                                                "sense_id": "a401dfcf-1be9-3e7a-a75f-d265ae60edd2",
                                                "text": "He’s been acting Shakespearean leads since he was twelve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc89afd-0fdc-3cac-874e-99d5508fc49e",
                                        "entry_id": "607ea40d-2138-375a-8fd8-3429ec4ca37b",
                                        "glosses": [
                                            "To feign."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55a19f62-fef3-4074-8697-9a797f16090b",
                                                "sense_id": "4cc89afd-0fdc-3cac-874e-99d5508fc49e",
                                                "text": "He acted the angry parent, but was secretly amused."
                                            },
                                            {
                                                "example_id": "71ce55ab-d7df-4934-bb16-f2ce8b7fa5cc",
                                                "sense_id": "4cc89afd-0fdc-3cac-874e-99d5508fc49e",
                                                "text": "With acted fear the villain thus pursued."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3edab9f6-56c3-3bcb-a8be-d3f9d1ac2f10",
                                        "entry_id": "607ea40d-2138-375a-8fd8-3429ec4ca37b",
                                        "glosses": [
                                            "To carry out work as a legal representative in relation to a particular legal matter."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5ceea1e-a6c2-4a58-a236-a4edb6fb2512",
                                                "sense_id": "3edab9f6-56c3-3bcb-a8be-d3f9d1ac2f10",
                                                "text": "A lawyer cannot act until they have been formally instructed by their client."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ec81cbb-121a-308f-9d3d-4d702d60abd9",
                                        "entry_id": "607ea40d-2138-375a-8fd8-3429ec4ca37b",
                                        "glosses": [
                                            "To possess an action onto (some other structure). Examples include the group action of a group on a set, the action of a ring on a module by scalar multiplication, and the action of a group or algebra on a vector space via a representation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c48413a6-6376-4c94-9c42-7b9ac6d74bca",
                                                "sense_id": "7ec81cbb-121a-308f-9d3d-4d702d60abd9",
                                                "text": "This group acts on the circle, so it can't be left-orderable!"
                                            }
                                        ]
