                                            {
                                                "example_id": "c8fc9ea0-3dba-4225-8457-1d4a0ac4c4d3",
                                                "sense_id": "720b4b19-1161-3ad3-bad2-3604a70f7c52",
                                                "text": "Vytal stattet verschließbare Plastikschüsseln mit QR-Codes aus, die dann via App im Restaurant ausgeliehen oder zurückgegeben werden können."
                                            },
                                            {
                                                "example_id": "365e3870-0486-40ee-993c-e48ae83f0e62",
                                                "sense_id": "720b4b19-1161-3ad3-bad2-3604a70f7c52",
                                                "text": "Mit den verschließbaren Ventilen kann das Becken oder die Wanne verschlossen werden."
                                            },
                                            {
                                                "example_id": "488cd359-14bc-4e97-8dd1-698fc38fbf73",
                                                "sense_id": "720b4b19-1161-3ad3-bad2-3604a70f7c52",
                                                "text": "In diesem Jahr erhält die Yacht Reina ein neues komplett verschließbares Zelt über dem Achterdeck."
                                            },
                                            {
                                                "example_id": "25ff1713-f37a-4d25-bb1f-bb012bbb80b0",
                                                "sense_id": "720b4b19-1161-3ad3-bad2-3604a70f7c52",
                                                "text": "In dem engen Gelaß, das nur durch ein handgroßes, von außen verschließbares Loch Licht und Luft erhielt, fand ich einen Mann mit leicht angegrautem Haar, dessen Gesicht einen energischen Zug eisernen Willens trug."
                                            },
                                            {
                                                "example_id": "c3343a2b-f98a-4660-bc38-7f6676e074e4",
                                                "sense_id": "720b4b19-1161-3ad3-bad2-3604a70f7c52",
                                                "text": "Beeren in ein gut verschließbares Einmachglas geben und mit 300 ml Weißweinessig übergießen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
