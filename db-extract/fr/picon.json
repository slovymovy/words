                        "glosses": [
                            "Marque d’un apéritif liquoreux et amer, le plus souvent associé à la bière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a03389d9-085b-443c-90bc-b62aa07fd1ae",
                                "sense_id": "22c9ea04-3573-3b18-a1f4-9031dbf1dbd8",
                                "text": "Le silence retomba dans le café. Près d’eux, un vieillard très maigre, en pardessus gris, s’assoupissait devant son Picon bière."
                            }
                        ]
                    }
