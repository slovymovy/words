                "entry_id": "c1bd5b2c-e8bf-3523-addf-465bb11758f1",
                "word": "konak",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "02ac24ad-770a-4586-8162-b554f4569224",
                        "entry_id": "c1bd5b2c-e8bf-3523-addf-465bb11758f1",
                        "tags": [
                            "plural"
                        ],
                        "form": "konaks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cc845322-8a94-3a27-ae32-60a1b49b3e0c",
                        "entry_id": "c1bd5b2c-e8bf-3523-addf-465bb11758f1",
                        "glosses": [
                            "résidence ou palais construit par un riche particulier ou un membre de l’aristocratie dans l’ancienne empire ottoman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2333709d-e343-478b-91d0-cd8dc87f3bf2",
                                "sense_id": "cc845322-8a94-3a27-ae32-60a1b49b3e0c",
                                "text": "En général, on monte dans les konaks par un escalier en pierre placé en dehors de la maison et ne comptant que quelques marches."
                            },
                            {
                                "example_id": "cd981c79-5bee-4d91-8f8f-bdd11ab024e5",
                                "sense_id": "cc845322-8a94-3a27-ae32-60a1b49b3e0c",
                                "text": "Le nouveau konak fut construit près de l’école secondaire à l’Est de la ville, sur le site d’un ancien tekke mevlevi."
                            },
                            {
                                "example_id": "02af9814-e0da-4dcb-a54a-4aedfd8e8fbe",
                                "sense_id": "cc845322-8a94-3a27-ae32-60a1b49b3e0c",
                                "text": "Sorti de La Chronique de Travnik d’Ivo Andric, le consul Daville traverse à cheval la foule des musulmans et des chrétiens, pour aller au konak présenter ses hommages au vizir Ibrahim Pacha de retour de son expédition fructueuse en têtes coupées contre Djordje le Noir, chef des Serbes indomptés, ou pour rendre une dernière visite à son ami Solomon Atidjas qui lui dit que, pour lui et les siens, jamais ne s’éteindra l’espoir d’un monde meilleur."
                            },
                            {
                                "example_id": "6562aaa2-085f-4040-bf7c-edd5b13ebb02",
                                "sense_id": "cc845322-8a94-3a27-ae32-60a1b49b3e0c",
                                "text": "Ces konak sont d’anciennes résidences de marchands ottomans construites aux XVIIIᵉ et XIXᵉ siècles. Plusieurs d’entre elles ont été converties en hôtels-boutiques ou en restaurants élégants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a803f39a-7727-44b1-b54d-da58150bbd86",
                        "source_entry_id": "c1bd5b2c-e8bf-3523-addf-465bb11758f1",
                        "source_sense_id": "cc845322-8a94-3a27-ae32-60a1b49b3e0c",
