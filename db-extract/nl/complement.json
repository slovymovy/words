                                    },
                                    {
                                        "sense_id": "3b852bfb-4505-3f03-84bd-032611bbc6ef",
                                        "entry_id": "15f5041e-f002-3c1b-9467-e6e2378a8f6b",
                                        "glosses": [
                                            "A nucleotide sequence in which each base is replaced by the complementary base of the given sequence: adenine (A) by thymine (T) or uracil (U), cytosine (C) by guanine (G), and vice versa."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b8265ff-8fda-46e8-b9c5-f9997841252b",
                                                "sense_id": "3b852bfb-4505-3f03-84bd-032611bbc6ef",
                                                "text": "A DNA molecule is formed from two strands, each of which is the complement of the other."
