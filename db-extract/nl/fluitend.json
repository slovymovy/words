        "nl-extract.jsonl": [
            {
                "entry_id": "781bc76c-d686-326e-a921-f3f343b7693f",
                "word": "fluitend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "09684410-d0c3-3d6e-a1a6-ee2a7a109853",
                        "entry_id": "781bc76c-d686-326e-a921-f3f343b7693f",
                        "glosses": [
                            "van een geluid dat het lijkt op het geluid van een fluit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "017b0d2d-9a23-403d-8091-b53a12df9a58",
                                "sense_id": "09684410-d0c3-3d6e-a1a6-ee2a7a109853",
                                "text": "Een paar minuten later rent Albert licht gebogen, zijn hoofd tussen zijn schouders, met logge passen door een landschap als het einde van de wereld, verdwenen onder de granaten en fluitende kogels, terwijl hij zijn wapen krachtig tegen zich aan drukt."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3d831da-837f-359d-977c-850ea3c78715",
                        "entry_id": "781bc76c-d686-326e-a921-f3f343b7693f",
                        "glosses": [
                            "zo gemakkelijk dat je vrolijk kunt blijven"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2efff054-4369-47d6-af9a-395ecc189264",
                                "sense_id": "c3d831da-837f-359d-977c-850ea3c78715",
                                "text": "Ze hadden allebei niet de snelheidsduivel moeten uithangen, maar Denise wordt daar wel veel harder voor gestraft. Oscar kan de boete fluitend ophoesten, terwijl Denise er flink door in de financiële sores kan komen."
                            },
                            {
                                "example_id": "586dfc6b-7a4f-43ce-bc1c-ab8fab9b09db",
                                "sense_id": "c3d831da-837f-359d-977c-850ea3c78715",
                                "text": "En dan, na een lange dag pauzeren, weddenschappen afsluiten, dansen, mediteren, huilen, slapen en reflecteren, is het tijd om fluitend naar huis te gaan. Helemaal vrij, want je hebt zowaar nog goed gewerkt ook."
                            }
                        ]
                    }
                ],
