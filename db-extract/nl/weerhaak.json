                                                "sense_id": "4542b0b0-d14f-34ff-bf8f-4f01294e3ba8",
                                                "text": "The defensive armor with the horses of the ancient knights ... These are frequently, though improperly, stiled barbs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "barb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4bd3bec-374c-3115-b61a-ccc70ce73a5f",
                                        "entry_id": "a203aae5-43ce-324b-a847-172cbe635f55",
                                        "glosses": [
                                            "To cover a horse in armor."
                                        ],
