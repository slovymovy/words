                "senses": [
                    {
                        "sense_id": "72a6e53f-b6c2-35a3-b24f-97f4b41a8f35",
                        "entry_id": "c084235b-af78-35fc-b14e-1990ff80bd8e",
                        "glosses": [
                            "grafische Darstellung des Zusammenhangs zwischen der körperlichen Belastung und der Laktatkonzentration im Blut; Kurve, die zeigt, wie der Laktatwert bei zunehmender körperlichen Belastung ansteigt"
                        ],
                        "tags": [
                            "Sportmedizin",
                            "Leistungsdiagnostik"
                        ],
                        "examples": [
                            {
                                "example_id": "15307b4b-6e79-4aed-8664-8588dc1059ca",
                                "sense_id": "72a6e53f-b6c2-35a3-b24f-97f4b41a8f35",
                                "text": "„Auf der ersten Seite wird die Laktatleistungskurve anschaulich dargestellt und ist Grundlage für Pascal, uns die mögliche Trainingsauswirkungen – wenn wir denn trainieren – zu zeigen.“"
                            },
                            {
                                "example_id": "801d8ecd-d047-420f-a2e7-a2e665e9acf6",
                                "sense_id": "72a6e53f-b6c2-35a3-b24f-97f4b41a8f35",
                                "text": "„Laktatleistungskurven werden polynomisch oder exponentiell gefittet dargestellt.“"
                            },
                            {
                                "example_id": "4c557de3-f744-4511-8bdd-88333a0443f3",
                                "sense_id": "72a6e53f-b6c2-35a3-b24f-97f4b41a8f35",
                                "text": "„Der langfristige Vergleich der Hauptkenngrößen der Laktatleistungskurve zeigt, dass die heutigen Schwimmer zwar schneller sind, allerdings scheinen sie mit höherem energetischem Aufwand zu schwimmen.“"
                            },
                            {
                                "example_id": "6a6f5c61-6ff8-404e-b9f9-41f3db7a177c",
                                "sense_id": "72a6e53f-b6c2-35a3-b24f-97f4b41a8f35",
                                "text": "„Ziel der Laktatuntersuchung ist es, die individuelle anaerobe Schwelle festzustellen, also den Punkt, an dem die Laktatleistungskurve den Steady State verlässt.“"
                            },
                            {
                                "example_id": "506b655f-9f36-4477-b33a-8de81f18bdaf",
                                "sense_id": "72a6e53f-b6c2-35a3-b24f-97f4b41a8f35",
                                "text": "„Anhand der erhobenen Werte erstellen wir Dir deine aktuelle Laktatleistungskurve, die uns hilft deine Ausdauerleistungsfähigkeit zu beurteilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
