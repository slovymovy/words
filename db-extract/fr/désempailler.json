                "senses": [
                    {
                        "sense_id": "4a619d0e-e66a-398f-be13-7dc36679e7f6",
                        "entry_id": "7e0fc001-2b7a-337f-8c61-5239f4f36fb3",
                        "glosses": [
                            "Enlever la paille de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf48a3d7-062f-48d1-a896-5be7ce448857",
                                "sense_id": "4a619d0e-e66a-398f-be13-7dc36679e7f6",
                                "text": "J'ai d'abord désempaillé successivement et avec la plus grande précaution chacun de mes arbres, et quand j'y trouvais des pucerons, j'en brûlais de suite la paille ;"
                            },
                            {
                                "example_id": "7e1ac8fb-fbd0-47d9-867d-75e5bde90605",
                                "sense_id": "4a619d0e-e66a-398f-be13-7dc36679e7f6",
                                "text": "Diable ! je cours faire désempailler tous mes drôles."
                            },
                            {
                                "example_id": "5a4c9997-90e0-4299-bfeb-bd367e0bec39",
                                "sense_id": "4a619d0e-e66a-398f-be13-7dc36679e7f6",
                                "text": "La règle du juste milieu indispensable aux réussites sociales pèsent sur les metteurs en scène qui se risquent à le désempailler."
                            }
                        ]
                    }
