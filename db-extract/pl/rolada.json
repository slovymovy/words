                                            {
                                                "example_id": "62a65013-e25e-4568-af23-c5e59eb1bc74",
                                                "sense_id": "d175e4e0-c7b3-3084-bc4a-119a1847fb16",
                                                "text": "He leaned back in his chair, and little more than the whites of his upturned eyes were visible; and beating time upon the table with one hand, claw-wise, and with two or three queer, little thrills and roulades, which re-appeared with great precision in each verse, he delivered himself thus, in what I suspect was an old psalm tune: […]"
                                            },
                                            {
                                                "example_id": "e606c1d7-a16a-4f28-a15e-461e9bc52cab",
                                                "sense_id": "d175e4e0-c7b3-3084-bc4a-119a1847fb16",
                                                "text": "He heard only here and there the ecstatic burst of a mocking-bird's wonderful roulades."
                                            }
                                        ]
                                    },
