                "senses": [
                    {
                        "sense_id": "413a4c77-5295-3daf-9c1b-32056f43199c",
                        "entry_id": "fc3843b8-0022-3129-9e34-0be0bd34c355",
                        "glosses": [
                            "etwas unrechtmäßig fordern, sich etwas anmaßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad9c4afc-29b6-4ba5-b9a1-189601d441a4",
                                "sense_id": "413a4c77-5295-3daf-9c1b-32056f43199c",
                                "text": "\"Arrogate is a more violent action than assume, and assume than ascribe. … We arrogate distinctions, honours, and titles; we assume names, rights, privileges.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "09ad2dd0-272b-34aa-abe0-d5b4b0d5a57a",
                        "entry_id": "fc3843b8-0022-3129-9e34-0be0bd34c355",
                        "glosses": [
                            "etwas an Stelle einer anderen Person einfordern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40f9f061-2050-4114-85a4-7ee65a42e791",
                                "sense_id": "09ad2dd0-272b-34aa-abe0-d5b4b0d5a57a",
                                "text": "\"And, with Paul, I dare arrogate to myself understanding, and with confidence derogate it from you; although I willingly, and deservedly, arrogate eloquence and genius to you, and derogate it from myself.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49f6354c-8889-48bf-95a7-63e610f14d9b",
                        "source_entry_id": "fc3843b8-0022-3129-9e34-0be0bd34c355",
                        "source_sense_id": "413a4c77-5295-3daf-9c1b-32056f43199c",
                        "source_sense_description": "etwas unrechtmäßig fordern, sich etwas anmaßen",
                        "target_lang_word": "fordern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fordern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "304e4fc9-76c3-3be0-96e5-9112919e8d0e",
                                        "entry_id": "042e4313-8c1a-31ac-bc41-af2a82b49ff3",
                                        "glosses": [
                                            "etwas (von jemandem) verlangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "393e72be-244c-4eca-8bf7-de36f4e830e8",
                                                "sense_id": "304e4fc9-76c3-3be0-96e5-9112919e8d0e",
                                                "text": "Er forderte eine gerechte Bezahlung."
                                            },
                                            {
                                                "example_id": "0e8f69fe-240a-478f-b50e-fe5292a76172",
                                                "sense_id": "304e4fc9-76c3-3be0-96e5-9112919e8d0e",
                                                "text": "„Mehr Wettbewerb auf der Schiene wird zwar gefordert, aber nicht energisch durchgesetzt.“"
                                            },
                                            {
                                                "example_id": "4a22dd6c-9fff-44f7-9ef0-cf405c14d785",
                                                "sense_id": "304e4fc9-76c3-3be0-96e5-9112919e8d0e",
                                                "text": "„Der Techunternehmer fordert die Abschaffung der Verbraucherschutzbehörde im Finanzsektor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6c11fd7f-828a-30e3-89db-a5b958131538",
                                        "entry_id": "042e4313-8c1a-31ac-bc41-af2a82b49ff3",
                                        "glosses": [
                                            "zu einem Kampf herausfordern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b171616a-49cc-411f-95e8-b8f7e641b625",
                                                "sense_id": "6c11fd7f-828a-30e3-89db-a5b958131538",
                                                "text": "„Es war bei JFG. ein Hauptmann Grotticken, derselbe wollte sonst alle Leute fressen; wird mit einem Niederländer auf den Abend uneinig, daß sie einander fordern. Ich brachte sie aber von einander bis auf den Morgen. Des Morgens kommt der Niederländer und fordert den Grotticken. Nun hatte er einen hölzernen Schenkel, den gurt'te er im Bette abe und sprach mit dem Niederländer, wie er nun vermeinet, daß er ihn erreichen kann, nimmt er den hölzernen Schenkel, schlägt den Niederländer vor den Hals, daß er neben dem Bette niedersank. Er raffet sich ja wieder auf und lief davon. Also hatte das Geraufe ein Ende, wollt ihn darnach nicht mehr fordern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02a274e4-8436-4e06-887c-53ed44bcd774",
                        "source_entry_id": "fc3843b8-0022-3129-9e34-0be0bd34c355",
                        "source_sense_id": "413a4c77-5295-3daf-9c1b-32056f43199c",
