                                "example_id": "1eb516b2-8270-415c-9d34-d3a183e2ceb9",
                                "sense_id": "c208d951-6e0b-38d0-93bb-f9e57238dc8d",
                                "text": "„Frau steht keine am Start, erst später im Rennen wird eine Staffelläuferin auftauchen.“"
                            },
                            {
                                "example_id": "b0960879-a949-4ecc-abea-3286deca8165",
                                "sense_id": "c208d951-6e0b-38d0-93bb-f9e57238dc8d",
                                "text": "„Couragiert verringerte Gössner dann den Rückstand, den ihr Sachenbacher-Stehle als zweite Staffelläuferin als Bürde mit auf den Weg gegeben hatte.“"
                            }
