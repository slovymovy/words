                                "example_id": "81b00bcd-7efa-4440-b118-d6a48693e6a9",
                                "sense_id": "fc132088-6811-3d4b-8be0-a993704758a4",
                                "text": "De marine heeft meerdere moderne vliegdekschepen die wereldwijd worden ingezet.",
                                "translation": "The navy has several modern aircraft carriers that are deployed worldwide.",
                                "english": "The navy has several modern aircraft carriers that are deployed worldwide."
