                    "semantic_group_id": "nautical_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailors worked together to adjust the <w>jeer</w> before the storm arrived.",
                            "target_lang_translations": {
                                "ru": "Матросы вместе работали над настройкой <w>гарделя</w> до начала шторма.",
                                "nl": "De matrozen werkten samen om de <w>draaireep</w> bij te stellen voordat de storm losbarstte."
                            }
