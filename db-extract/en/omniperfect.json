    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "d7c1de79-1da3-3788-9917-9a36b0717090",
                "word": "omniperfect",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d2f8245-2a16-3f5e-9d99-efa8360865d1",
                        "entry_id": "d7c1de79-1da3-3788-9917-9a36b0717090",
                        "glosses": [
                            "Truly perfect in every way."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "11fa7c44-9d3d-4f02-aa6c-75699c0be496",
                                "sense_id": "2d2f8245-2a16-3f5e-9d99-efa8360865d1",
                                "text": "God is omnipotent, omnipresent, omniperfect Spirit; too pure to love impurity, too good to love iniquity, too perfect to love imperfection."
                            },
                            {
                                "example_id": "cf297542-414a-413e-84f7-91f404f5c6bb",
                                "sense_id": "2d2f8245-2a16-3f5e-9d99-efa8360865d1",
                                "text": "The world hath a governor set over it, that Word of the Lord of all which was the maker of it; this is the first power after him- self, uncreated, infinite, looking out from him, and ruling over all things that were made by him; this is the perfect and genuine Son of the first omniperfect Being."
                            },
                            {
                                "example_id": "96032f55-589c-4295-a923-1a61c465f654",
                                "sense_id": "2d2f8245-2a16-3f5e-9d99-efa8360865d1",
                                "text": "On the one hand, we know that there is a necessary being; on the other, we postulate the existence of an omniperfect being as the only possible account of the \"objective possibility\" of things."
                            },
                            {
                                "example_id": "4be140e7-2128-4317-b2f7-e0cb3afa21d3",
                                "sense_id": "2d2f8245-2a16-3f5e-9d99-efa8360865d1",
                                "text": "\"What you call dark and light, feminine and masculine, left and right, yin and yang, good and bad, all of it. For you are, indeed, all one. Aspects of all that is...omnipresent, omniperfect. All truth is held in paradox so that you may know who you are. Ye are gods.\""
                            },
                            {
                                "example_id": "4a8cbc0f-c09e-40df-b806-df8254298ee2",
                                "sense_id": "2d2f8245-2a16-3f5e-9d99-efa8360865d1",
                                "text": "Anselm seeks to describe the nature of an omniperfect being, to prove its existence and to describe its attributes understood as perfections."
                            }
                        ]
                    }
                ],
