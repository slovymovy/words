                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thèmes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b87c0dff-d3ab-348e-b026-81b997202005",
                                        "entry_id": "7758fbfa-1c71-39e2-ba4e-3526aef185a2",
                                        "glosses": [
                                            "Pluriel de thème."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4161c07-ec1f-4f9e-b9e5-18a35b47e7df",
                                                "sense_id": "b87c0dff-d3ab-348e-b026-81b997202005",
                                                "text": "Dans le hall d’entrée du cinéma, Anna avait installé des grands panneaux d’affichage avec l’horaire des séances de cinéma, les thèmes des débats à venir, une foule de slogans qui s’entredévoraient et des messages à caractère informatif : « Comment réaliser un cocktail Molotov : une bouteille remplie de 2/3 d’essence, de savon en poudre, et un chiffon imbibé d’essence enfoncé dans le goulot. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
