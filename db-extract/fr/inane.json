                        "examples": [
                            {
                                "example_id": "2c250178-b848-4e76-a91c-dd5b63566c62",
                                "sense_id": "4ecd72e2-56f5-3df3-b577-b0bcc8a4000c",
                                "text": "Atteste l’inane d’Œuvrer !\nDis-en l’amer et le stupide :\nCueille ta bouche, Aganippide !\nEt la jette à l’Oubli sacré."
                            },
                            {
                                "example_id": "7f457578-8aa3-4c9e-bfca-b3b8cd5d3fce",
                                "sense_id": "4ecd72e2-56f5-3df3-b577-b0bcc8a4000c",
                                "text": "D’amour et te garder ? non l’Art malade\nVeut s’ignorer au songe féminin —\nIntime chanson secrète ballade\nL’inane d’aimer scande le refrain."
                            }
                        ]
                    }
