                        "examples": [
                            {
                                "example_id": "123731c7-8124-4d58-9364-0e7e7d008633",
                                "sense_id": "c053d117-cd3d-3bd8-9e97-733032e6649e",
                                "text": "Da trat der Bösewicht herein, und sprach „wo ist Herz und Zunge von dem Knaben?“ das Mädchen reichte ihm den Teller, aber der Königssohn warf die Decke ab, und sprach „du alter Sünder, warum hast du mich tödten wollen? nun will ich dir dein Urtheil sprechen. Du sollst ein Pudelhund werden, und eine goldene Kette um den Hals haben, und sollst glühende Kohlen fressen, daß dir die Lohe zum Hals heraus schlägt.“"
                            }
                        ]
                    }
