                "senses": [
                    {
                        "sense_id": "9a2ea27d-d587-3c9f-be7c-79198b7b4f3c",
                        "entry_id": "ad511aab-5854-3ead-8886-c73e29cea6fd",
                        "glosses": [
                            "Atmung, bei der sich beim Luftholen die Schultern anheben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21c430ad-de83-4e3a-9000-e7a8c218297d",
                                "sense_id": "9a2ea27d-d587-3c9f-be7c-79198b7b4f3c",
                                "text": "„Die Schulteratmung ist die ungünstigste Form, da sie sehr schnell zu Verspannungen in diesem Bereich führt.“"
                            },
                            {
                                "example_id": "1d89e513-c900-4a53-be45-beb397539416",
                                "sense_id": "9a2ea27d-d587-3c9f-be7c-79198b7b4f3c",
                                "text": "„Bei der Schulteratmung bewegen sich in der Einatmungsphase die Schultern in Richtung der Ohren.“"
                            },
                            {
                                "example_id": "79b01564-9660-4134-bbe8-56983a819836",
                                "sense_id": "9a2ea27d-d587-3c9f-be7c-79198b7b4f3c",
                                "text": "„Durch Förderung der Schulteratmung kann die bewußte Atmung hierhin geleitet werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
