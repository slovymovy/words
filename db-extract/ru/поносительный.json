                                        "glosses": [
                                            "The act of committing an offence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da365a4-ce7b-4862-a210-bc4f7ecfb9cf",
                                                "sense_id": "c4fa3c13-2b13-3e53-82e3-d5b936d5fee8",
                                                "text": "There are, besides, other corporations and individuals more or less connected in the activities of the other defendants, that are alleged to be instruments or accomplices in their activities and offendings[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "offending",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d8fbc01-d3c8-3d4b-8b72-a0da912d2ca4",
                                        "entry_id": "f8eee9da-690f-3dff-8b26-0ed36040c386",
                                        "glosses": [
                                            "Responsible; to be blamed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbef3232-5eae-440e-9e06-5968642de443",
                                                "sense_id": "3d8fbc01-d3c8-3d4b-8b72-a0da912d2ca4",
                                                "text": "Something in the fridge smelled terrible. The offending article was soon identified and removed."
                                            },
                                            {
                                                "example_id": "d64b8a96-b2e8-4529-9385-bbcc459102d9",
                                                "sense_id": "3d8fbc01-d3c8-3d4b-8b72-a0da912d2ca4",
                                                "text": "According to Netsafe, scammers send out a bunch of emails, hoping to snag a few gullible people, but simply deleting the offending email won’t do anything to impede the con."
                                            }
                                        ]
                                    }
                                ]
                            }
