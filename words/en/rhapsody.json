    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4eca1f65-7988-3f03-969e-f70d59278f09",
                    "sense_definition": "An exaggeratedly enthusiastic or exalted expression of feeling in speech or writing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet went into a <w>rhapsody</w> about the beauty of the morning sun."
                        },
                        {
                            "text": "She delivered a <w>rhapsody</w> of praise for her mentor during the ceremony."
                        }
                    ],
                    "synonyms": [
                        "outburst",
                        "tirade"
                    ]
                },
                {
                    "sense_id": "b579ffd1-83d9-3557-894f-ca50bd5e3be0",
                    "sense_definition": "An instrumental musical composition of irregular form, often incorporating improvisation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pianist performed a famous <w>rhapsody</w> by Liszt at the concert."
                        },
                        {
                            "text": "The orchestra played a complex <w>rhapsody</w> that featured many sudden tempo changes."
                        }
                    ]
                },
                {
                    "sense_id": "e16a1c73-c302-32ad-9d66-b75eec2a7363",
                    "sense_definition": "A random or confused collection of stories, words, or miscellaneous items.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His speech was just a <w>rhapsody</w> of disconnected thoughts and random facts."
                        },
                        {
                            "text": "The book is a <w>rhapsody</w> of old letters and forgotten diary entries."
                        }
                    ],
                    "synonyms": [
                        "medley",
                        "miscellany",
                        "jumble"
                    ]
                },
                {
                    "sense_id": "3a58567a-e873-33d2-8af8-17057766a5c1",
                    "sense_definition": "An epic poem, or part of one, suitable for uninterrupted recitation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient bard recited a <w>rhapsody</w> from the great epic cycle."
                        },
                        {
                            "text": "Scholars studied the <w>rhapsody</w> to understand the oral traditions of the time."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to the classical Greek context of epic recitation."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "087591e0-d94d-3e83-8d64-10bb8e47b198",
                    "sense_definition": "To speak with exaggerated or rapturous enthusiasm.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would often <w>rhapsody</w> about the wonders of his travels abroad."
                        },
                        {
                            "text": "Critics continue to <w>rhapsody</w> over the director's latest cinematic masterpiece."
                        }
                    ],
                    "synonyms": [
                        "rave"
                    ],
                    "common_phrases": [
                        "rhapsody about"
                    ]
                }
