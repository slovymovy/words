                },
                {
                    "sense_id": "348450e3-9e9b-39c7-924d-31de06037049",
                    "sense_definition": "De eigenschap of het karakter van nieuw of onbekend te zijn.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de <w>nieuwigheid</w> van zijn nieuwe telefoon er eenmaal af was, gebruikte hij hem minder. ",
                            "target_lang_translations": {
                                "fr": "Une fois que l'effet de <w>nouveauté</w> de son nouveau téléphone est passé, il l'a moins utilisé."
                            }
                        },
                        {
                            "text": "In het begin was het werk erg spannend, maar de <w>nieuwigheid</w> ging er snel af. ",
                            "target_lang_translations": {
                                "fr": "Au début, le travail était très passionnant, mais la <w>nouveauté</w> s'est vite dissipée."
                            }
                        }
                    ],
                    "common_phrases": [
