                                    {
                                        "sense_id": "002c051f-9022-3252-88d4-23f230b949b6",
                                        "entry_id": "9334d82e-0730-335e-8ae4-c84df390422f",
                                        "glosses": [
                                            "zwei Dinge betrachten und dabei auf den Kontrast/Unterschied achten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ccc5f6a-e390-406b-8924-157f769a5f4b",
                                                "sense_id": "002c051f-9022-3252-88d4-23f230b949b6",
                                                "text": "Vielleicht könnten Sie einmal die beiden Optionen einander vergleichend gegenüberstellen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9302c16d-eb51-3d5f-897d-9640974a7130",
                                        "entry_id": "9334d82e-0730-335e-8ae4-c84df390422f",
                                        "glosses": [
                                            "zwei Personen zusammenbringen, von denen anschließend mindestens eine eine Aussage treffen soll"
                                        ],
                                        "tags": [
                                            "oft im Rahmen einer polizeilichen Untersuchung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37868a55-c9b3-4efb-bee8-2abb54e63b0d",
                                                "sense_id": "9302c16d-eb51-3d5f-897d-9640974a7130",
                                                "text": "Wenn wir Sie einigen Frauen gegenüberstellen würden, glauben Sie, dass Sie die Handtaschenräuberin wiedererkennen würden?"
                                            },
                                            {
                                                "example_id": "cf6e9ac9-a135-465c-86a6-3d865bda1b3c",
                                                "sense_id": "9302c16d-eb51-3d5f-897d-9640974a7130",
                                                "text": "Jetzt holen Sie mal die beiden Streithähne herein. Wir wollen sie einmal einander gegenüberstellen."
