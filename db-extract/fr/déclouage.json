                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57a7c5f5-e23d-4a5a-b9f0-78b3f282d6e6",
                                "sense_id": "5132b80f-7a89-3d41-9b5f-05762410b9e1",
                                "text": "Chez Marie Dormoy, à deux heures moins le quart, pour rester chez elle pendant le déclouage des tapis, elle obligée d'être à deux heures à la Bibliothèque."
                            }
                        ]
                    },
                    {
                        "sense_id": "05dd34a5-e620-3be5-a407-beeed54fa0af",
                        "entry_id": "e64e8c9a-5d3e-3a85-b71b-0237fba32bcd",
                        "glosses": [
