                "senses": [
                    {
                        "sense_id": "100fa68e-bf67-318c-93cc-2c3866334ced",
                        "entry_id": "a393ef1b-2f37-346f-a120-4775302f8301",
                        "glosses": [
                            "Habitant d'une île."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf116a9-ea76-4961-885b-930de8fdc100",
                                "sense_id": "100fa68e-bf67-318c-93cc-2c3866334ced",
                                "text": "Les Féringiens qui défendent la pratique reprochent aux médias et ONG étrangers de ne pas respecter leur culture d’îliens, où la pêche et les traditions occupent une place centrale."
                            }
                        ]
                    },
                    {
                        "sense_id": "c03abb1d-6542-3b59-907d-85bdc63bde22",
                        "entry_id": "a393ef1b-2f37-346f-a120-4775302f8301",
                        "glosses": [
                            "Habitant d'une île bretonne."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "dfe6926b-81af-40b3-9acd-aee3025004c9",
                                "sense_id": "c03abb1d-6542-3b59-907d-85bdc63bde22",
                                "text": "Dire que le Corse est un îlien n’est pas un truisme."
                            },
                            {
                                "example_id": "7c73f06d-c0e7-4894-9bbf-c5d1b6a0ca6e",
                                "sense_id": "c03abb1d-6542-3b59-907d-85bdc63bde22",
                                "text": "Seuls des groupes d’îliens, qui en ont vu d’autres, continuent tranquillement de siroter leur shôchû, cet alcool de patate douce."
                            },
                            {
                                "example_id": "02801f09-bf6c-44ee-9b72-032293838c68",
                                "sense_id": "c03abb1d-6542-3b59-907d-85bdc63bde22",
                                "text": "Les îliens sont aussi très accueillants."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7cc9479-4441-372e-89c1-f4b5cf692b3c",
                        "entry_id": "a393ef1b-2f37-346f-a120-4775302f8301",
                        "glosses": [
                            "Personne originaire de Belle-Isle-en-Mer, en Bretagne."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "5299ff7e-4bb7-486d-b7f1-d72bb4e34b78",
                                "sense_id": "c7cc9479-4441-372e-89c1-f4b5cf692b3c",
                                "text": "Lui s’appelle Perig. Il a 15 ans et il est né à Sauzon. […] De nous tous, c'est le seul îlien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08b7be25-e627-4e56-a80f-80928bbb49e7",
                        "source_entry_id": "a393ef1b-2f37-346f-a120-4775302f8301",
                        "target_lang_word": "islander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "islander",
