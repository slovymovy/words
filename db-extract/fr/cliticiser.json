                        "glosses": [
                            "Donner un caractère clitique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0a1c2a2-6bb7-4732-8ca0-639ddc6634fc",
                                "sense_id": "e57d4893-73b0-39e6-8115-d69e915a657b",
                                "text": "Selon Quirk et al., (1985, 123) il existe une tendance à cliticiser non pas le mot phonologique /haev/ mais l’auxiliaire have."
                            },
                            {
                                "example_id": "1470a80a-24b8-461f-9230-3758fef2ce66",
                                "sense_id": "e57d4893-73b0-39e6-8115-d69e915a657b",
                                "text": "Nous posons ici l’hypothèse qu’un signe à contenu lexical peut seulement se cliticiser sur un constituant qui le suit."
                            }
                        ]
                    }
