                                    {
                                        "sense_id": "ad350fff-73ac-34de-b903-10cf2cf494e7",
                                        "entry_id": "e79431c9-abc4-3013-92a6-c297dd89f78d",
                                        "glosses": [
                                            "archipelag położony na Oceanie Atlantyckim u wybrzeży Maroka i Sahary Zachodniej"
                                        ],
                                        "tags": [],
