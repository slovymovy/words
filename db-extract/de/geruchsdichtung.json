                "senses": [
                    {
                        "sense_id": "c990d24a-2380-37b5-ae31-b02638109bd6",
                        "entry_id": "e03b9449-0a36-3e52-8c1f-07da103b0d2d",
                        "glosses": [
                            "(Maschinen-)Element zum Abdichten gegen Geruchsaustritt; Material zum Abdichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62dc8aad-1972-439e-a0f7-c0df31b8e3b1",
                                "sense_id": "c990d24a-2380-37b5-ae31-b02638109bd6",
                                "text": "Eine Mülltonne hat zwar einen Deckel, der den Inhalt vor Regen schützt, jedoch fehlt diesem eine vernünftige Geruchsdichtung."
                            },
                            {
                                "example_id": "6aa6071d-5bef-4890-b451-29ddb845aa85",
                                "sense_id": "c990d24a-2380-37b5-ae31-b02638109bd6",
                                "text": "Der Siphon unter dem Waschbecken, ist eine Geruchsdichtung, damit der Gestank aus der Kanalisation nicht im Haus zu riechen ist."
                            },
                            {
                                "example_id": "35a445d1-2faf-4d09-a8f5-4a0a64d58378",
                                "sense_id": "c990d24a-2380-37b5-ae31-b02638109bd6",
                                "text": "Es ist die Aufgabe der Geruchsdichtungen, geschlossene Systeme und Kreisläufe, ohne Geruchsemissionen, herzustellen und aufrecht zu erhalten."
                            },
                            {
                                "example_id": "ce72f76c-9d2a-4971-93a4-e93c81b64e99",
                                "sense_id": "c990d24a-2380-37b5-ae31-b02638109bd6",
                                "text": "„Die Fettabscheider sind mit Geruchsdichtung, Deckel mit Klammerverschlüssen und Zu-/Ablaufstutzen DN50 ausgestattet.“"
                            },
                            {
                                "example_id": "0128d60e-30e9-4d42-a29f-5966426f0e89",
                                "sense_id": "c990d24a-2380-37b5-ae31-b02638109bd6",
                                "text": "Gerade im Fettabscheider kommt der Geruchsdichtung eine große Bedeutung bei, damit das ranzige Fett nicht zu Geruchsbelästigungen führt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
