                        "glosses": [
                            "Glimmering; shimmery."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c3eb359-f460-44a0-8cb7-9fcb4486ee42",
                                "sense_id": "1b60535d-0f28-3f96-84c4-320e021c5f57",
                                "text": "Given enough cold rain, a gray dusk that is fast glooming into black night, a pair of wet shoes, a skipped luncheon, a longing for people who are under the sod and a home that is only a memory, and the vaguest, glimmeriest bit of auld lang syne becomes in a twinkling a rampant friendship."
                            },
                            {
                                "example_id": "202a0320-d82c-4c1f-a099-d9b37fdd3672",
                                "sense_id": "1b60535d-0f28-3f96-84c4-320e021c5f57",
                                "text": "Silver-faced ribbons / A silver and rose one—or silver and orchid—or silver and blue! They are the loveliest, softest, glimmeriest things—and so rich, too."
                            },
                            {
                                "example_id": "7ec56f56-0e2b-4307-8778-3096427d0051",
                                "sense_id": "1b60535d-0f28-3f96-84c4-320e021c5f57",
                                "text": "MARIAH CAREY CAN GLIMMER UNTIL SHE DROPS. WE DON’T CARE. RON PROUSE SHOWS YOU HOW TO OUT-GLOW THE GLIMMERIEST, IF YOU’RE PREPARED TO GLOW, GLIMMER AND JUST GENERALLY ANNOY YOUR NEIGHBOURS. GO THE GLOWCOMOTIVE!"
                            },
                            {
                                "example_id": "663fe8ff-8216-4c01-b257-bc9a89c0ead9",
                                "sense_id": "1b60535d-0f28-3f96-84c4-320e021c5f57",
                                "text": "Light, fresh and evanescent, they are suffused with the glimmery yellowness of East End light; it’s not quite yellow or white, but a color somewhere in between."
                            }
                        ]
                    }
