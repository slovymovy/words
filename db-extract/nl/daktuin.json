                "senses": [
                    {
                        "sense_id": "b24f5033-666b-37b7-a35c-b99d0a5d9f03",
                        "entry_id": "c879ac66-55e6-3c36-9522-f3fdd6889b5b",
                        "glosses": [
                            "tuin aangelegd op het platte deel van een dak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afbdf6bc-748e-4d0f-b27a-93014e13e9aa",
                                "sense_id": "b24f5033-666b-37b7-a35c-b99d0a5d9f03",
                                "text": "Maandag begint het hoveniersbedrijf Troost uit Rijssen in opdracht van ZorgAccent met de aanleg van de daktuin, om zo de bewoners een prettiger uitzicht te geven. Bijkomend voordeel is dat de daktuin zeer duurzaam is. Zo houdt de daktuin regenwater vast en helpt ze, dankzij de isolerende werking, veel energie te besparen."
                            },
                            {
                                "example_id": "85f41fd4-c6a2-409f-896c-658c56f13462",
                                "sense_id": "b24f5033-666b-37b7-a35c-b99d0a5d9f03",
                                "text": "Er stroomt water in de parkeergarage aan De Hagen in Rijssen. Op diverse plekken zijn soms lekkages zichtbaar, onder meer onder het Europaplein, de toegang vanaf De Hagen en de toegang naar de fietskelder en daktuin aan de Rozengaarde."
                            },
                            {
                                "example_id": "c21a211a-b828-40be-bdd1-6ca1c70319e9",
                                "sense_id": "b24f5033-666b-37b7-a35c-b99d0a5d9f03",
                                "text": "De schets toont een daktuin op negen meter hoogte. ,,Tuinen zijn een belangrijk onderdeel van paleizen over de hele wereld, de paleistuin van Symbolica is mede geïnspireerd op tuinen van andere grote paleizen”, aldus Olaf Vugts, directeur Imagineering."
                            }
                        ]
                    }
