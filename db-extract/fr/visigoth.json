                        "sense_id": "05ad66da-246f-3758-8e20-5e0de2d73ac5",
                        "entry_id": "2f873da6-18fa-36bc-990c-3cd8828fb7ec",
                        "glosses": [
                            "Relatif aux Wisigoths."
