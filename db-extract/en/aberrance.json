                        "entry_id": "73a4ffa3-d5eb-3130-9b53-f992e51410ea",
                        "glosses": [
                            "State of being aberrant; a wandering from the right way; deviation from truth, rectitude."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "eca1234a-eb85-445b-8466-5b72d208824e",
                                "sense_id": "d6bb11c0-41b0-34c3-a90a-5807ea9d2654",
                                "text": "Like Miller, George Lionel married briefly and unsuccessfully, and during the McCarthy era was blacklisted for political aberrance."
                            }
                        ]
                    }
                ],
