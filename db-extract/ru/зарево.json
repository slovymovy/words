                                    {
                                        "sense_id": "2cc962f8-aab1-36a7-91b5-b2681ad73e5e",
                                        "entry_id": "7d2edb10-a093-3067-9d93-0244b8d87973",
                                        "glosses": [
                                            "The light given off by a glowing object."
                                        ],
                                        "tags": [
                                            "countable",
