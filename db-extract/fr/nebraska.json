                                "target_senses": [
                                    {
                                        "sense_id": "11b6813c-f7db-3170-9b32-632fb5e155b3",
                                        "entry_id": "d90ca356-dc04-3ca7-a86e-dda67ba32861",
                                        "glosses": [
                                            "Bundesstaat im mittleren Westen der USA"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "542de934-bb7b-422c-8b26-0350e01cca12",
                                                "sense_id": "11b6813c-f7db-3170-9b32-632fb5e155b3",
                                                "text": "„Die Bewohner von Nebraska haben mit moderner Landwirtschaft die Prärieebenen in ein Land voll Ranches und Farmen verwandelt.“"
                                            },
                                            {
                                                "example_id": "2b987159-0874-4a34-be7b-dea95d35112c",
                                                "sense_id": "11b6813c-f7db-3170-9b32-632fb5e155b3",
                                                "text": "„Oberst ist jung, fotogen und kommt aus den Weiten der amerikanischen Provinz Nebraska, wo das Leben echt und das Abenteuer noch möglich ist. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6b145cc-087e-4649-a787-184907eea725",
                        "source_entry_id": "01940b0c-b612-387d-a89f-123509d6a322",
