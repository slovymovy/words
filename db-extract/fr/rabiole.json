                    {
                        "sense_id": "fe3f4e91-be51-3846-b974-7be8e3fe9741",
                        "entry_id": "c0f67b7b-a037-3723-9a74-970007e61cdf",
                        "glosses": [
                            ", Navet à chair blanche et à racine ronde et aplatie."
                        ],
                        "tags": [
                            "Québec",
                            "Missouri"
                        ],
                        "examples": [
                            {
                                "example_id": "545eca91-ebb1-42eb-8d1d-c78322612d2f",
                                "sense_id": "fe3f4e91-be51-3846-b974-7be8e3fe9741",
                                "text": "La « rabiole », dérivée du languedocien, serait plutôt un chou-navet."
                            },
                            {
                                "example_id": "82f1587a-904a-4272-8b90-f33c817ef8e9",
                                "sense_id": "fe3f4e91-be51-3846-b974-7be8e3fe9741",
                                "text": "Les trois belles tranches de magret très maigres, parfaitement rôties et d’une surprenante tendreté sont accompagnées de rabioles et de champignons maïtake."
                            },
                            {
                                "example_id": "c9243ac6-1788-4a2b-bdb9-e2016bac6642",
                                "sense_id": "fe3f4e91-be51-3846-b974-7be8e3fe9741",
                                "text": "Laisser refroidir et verser le liquide sur les betteraves et les rabioles, dans deux contenants distincts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce97f3a1-f350-42c3-be8e-e1f062fc75d4",
                        "source_entry_id": "c0f67b7b-a037-3723-9a74-970007e61cdf",
                        "source_sense_id": "fe3f4e91-be51-3846-b974-7be8e3fe9741",
