                ],
                "senses": [
                    {
                        "sense_id": "1c536966-5f0d-30ea-b222-b91013bd74d6",
                        "entry_id": "737777fd-3bc0-3ef6-90e8-0043429d96ad",
                        "glosses": [
                            "freie Aussicht nach allen Seiten (360°; oft von der Spitze eines Gebäudes oder Bergs)"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "6964216b-8e6f-4d4c-8123-dec94235e14a",
                                "sense_id": "1c536966-5f0d-30ea-b222-b91013bd74d6",
                                "text": "„Der Aussichtsturm auf dem Prinzenkopf bietet ein Rundumblick auf die Ortsteile von Zell und auf Pünderich, Bullay und die Marienburg.“"
                            },
                            {
                                "example_id": "e21dfc9d-a986-48cb-a83c-05c9f6869b37",
                                "sense_id": "1c536966-5f0d-30ea-b222-b91013bd74d6",
                                "text": "„Alt-Eberstein. Die Ruine nahe Baden-Baden ist für Besucher während der Öffnungszeiten des Restaurants geöffnet und bietet einen Rundumblick über das Murgtal und die dunklen Wälder des Nordschwarzwaldes.“"
                            },
                            {
                                "example_id": "9dfa7fd2-c5aa-4b19-b949-b810b4c7eee7",
                                "sense_id": "1c536966-5f0d-30ea-b222-b91013bd74d6",
                                "text": "[Bayernturm:] „Bei entsprechendem Wetter bietet er einen umfassenden Rundumblick über die Haßberge und das Grabfeld bis zur Rhön, zum Heldburger Land und den Gleichbergen, zum Thüringer Wald und zum Fichtelgebirge.“"
                            },
                            {
                                "example_id": "59ea76f2-b06b-43a1-b687-cd36317e3340",
                                "sense_id": "1c536966-5f0d-30ea-b222-b91013bd74d6",
                                "text": "„Von hier hat man einen guten Rundumblick.“"
                            },
                            {
                                "example_id": "eeb0570d-9c8b-41fb-a3dc-577dad65090c",
                                "sense_id": "1c536966-5f0d-30ea-b222-b91013bd74d6",
                                "text": "„Von der Plattform auf dem Turm eröffnet sich ein schöner Rundumblick über die Landschaft.“"
                            },
                            {
                                "example_id": "e78e70cb-f2cd-459d-b4de-60b54f33319c",
                                "sense_id": "1c536966-5f0d-30ea-b222-b91013bd74d6",
                                "text": "„Das Gipfelkreuz ist von einer Holzbank umrahmt und bietet einen spektakulären Rundumblick auf Voralpenrand, Spitzingsee, Simsee und Chiemsee und die Hauptalpenkette.“"
                            },
                            {
                                "example_id": "ea0005ef-6ec0-409d-a244-d9f3b81acc89",
                                "sense_id": "1c536966-5f0d-30ea-b222-b91013bd74d6",
                                "text": "[Schloss Karlsruhe:] „Um 1900 führte der Schlosskastellan durch das Innere, auch konnten der Schlossturm, genannt „Bleiturm“, der von seiner etwa 42 m hohen Aussichtsplattform einen Rundumblick über Karlsruhe bis hin zum Schwarzwald und zu den Pfälzer Bergen bot, und der Marstall im Ostflügel besucht werden.“"
                            },
                            {
                                "example_id": "69c94a83-450e-4daa-84d7-2a27561fca7d",
                                "sense_id": "1c536966-5f0d-30ea-b222-b91013bd74d6",
                                "text": "„Ein \"Must-see\" ist die Aussichtsplattform des 360 Chicago Observation Deck (ehemals John Hancock Center). Sie bietet einen herrlichen Rundumblick über Chicagos Skyline.“"
                            },
                            {
                                "example_id": "8d7f94a2-d160-45a6-8ea7-07bb002bb7eb",
                                "sense_id": "1c536966-5f0d-30ea-b222-b91013bd74d6",
                                "text": "„Auf der abwechslungsreichen Tour im Berchtesgadener Land erwartet die Wanderer neben atemberaubenden Rundumblicken eine Wallfahrtskirche und eine Burgruine sowie eine wunderschön gelegene Einkehrmöglichkeit direkt am Thumsee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
