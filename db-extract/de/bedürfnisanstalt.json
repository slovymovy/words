                "senses": [
                    {
                        "sense_id": "42f96046-985c-3e73-aa05-12fee73d7c87",
                        "entry_id": "7ec4ca0e-db0a-3f60-9676-13d8a29e6ef4",
                        "glosses": [
                            "öffentliche Toilette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f0037e-035e-4f46-ba5f-579c958cb0fe",
                                "sense_id": "42f96046-985c-3e73-aa05-12fee73d7c87",
                                "text": "Bereits in der Antike gab es allgemein zugängliche Bedürfnisanstalten."
                            },
                            {
                                "example_id": "04cd03d1-df51-4679-b265-1fe42b2ee52b",
                                "sense_id": "42f96046-985c-3e73-aa05-12fee73d7c87",
                                "text": "„Dass der Streit zwischen Transaktivisten und traditionellen Frauenrechtlerinnen um die politisch korrekte Kennzeichnung von Bedürfnisanstalten in Frankfurt nun sogar in Gewalttätigkeit mündete, macht es nicht leichter, das Thema ernst zu nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
