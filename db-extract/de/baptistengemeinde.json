                        "examples": [
                            {
                                "example_id": "5e261c70-f72a-4460-ba88-bda4dfd16c66",
                                "sense_id": "1b9c24d1-b03a-3589-9709-f80ac3555729",
                                "text": "Das gemeinsame Leben in einer Baptistengemeinde ist für Baptisten sehr wichtig."
                            },
                            {
                                "example_id": "9ef1bcd6-c11e-4030-9c0d-fa5804186743",
                                "sense_id": "1b9c24d1-b03a-3589-9709-f80ac3555729",
                                "text": "In Baptistengemeinden werden keine Babys getauft, da sie sich jede Person aus freiem Willen zur Taufe entscheiden soll."
                            }
                        ],
