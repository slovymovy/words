                "senses": [
                    {
                        "sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
                        "entry_id": "ba25722e-4f73-365a-b0d8-55701722031c",
                        "glosses": [
                            "Altarraum in einer Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90d469fa-b465-4671-ad8a-581f5343de98",
                                "sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
                                "text": "[…] „der Kölner Dom steht so dicht neben dem Hauptbahnhof, dass man im Chorraum die Durchsagen an den Bahnsteigen hören kann.“"
                            },
                            {
                                "example_id": "9c34f511-d444-4d08-9752-fa5c5477d642",
                                "sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
                                "text": "„Im Chorraum mit seinen 9 Glasfenstern schwebt - an Drahtseilen befestigt- überlebensgroß ein segnender Christus am Kreuz.“"
                            },
                            {
                                "example_id": "f9193527-7a25-42cc-8ac7-9b1e2d2ca2c7",
                                "sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
                                "text": "„Ein Fresko aus dem 13. Jahrhundert im Chorraum der Kirche zeigt den Heiligen Martin, wie er seinen Mantel mit einem Bettler teilt.“"
                            },
                            {
                                "example_id": "02a2d882-58f6-4d66-8c30-68d85114af70",
                                "sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
                                "text": "„Im Chorraum der heutigen, im Jahre 1934 geweihten Kirche befindet sich ein Mosaikbild, das die Kirche prägt und das den gekreuzigten Christus als König und Hohepriester mit Maria und Johannes darstellt. Es besteht aus vier Millionen Steinchen.“"
                            },
                            {
                                "example_id": "45f8cf75-9daf-4620-ad09-2f0c2a4f6397",
                                "sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
                                "text": "„Wer Beton liebt, kommt im Innenraum der evangelischen Lutherkirche voll auf seine Kosten. Altar, Kanzel und Taufstein sind aus einfachem Beton gegossen, gleichfalls auch der Boden im Chorraum.“"
                            },
                            {
                                "example_id": "3797f398-18ef-4be8-a22b-22fdd3704f35",
                                "sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
                                "text": "„Unmittelbar nach dem Besuch von Papst Franziskus auf dem Zionsberg legten Unbekannte mit Hilfe eines angezündeten Buchs Feuer im Chorraum.“"
                            },
                            {
                                "example_id": "c9b0d945-6b23-46a0-9e09-aa077628ab9b",
                                "sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
                                "text": "[St. Martinus-Kirche/Hagen/Teutoburger Wald:] „Im Inneren sind die Bankgruppen fächerförmig dem Chorraum zugeordnet. Es gibt rund 1000 Sitzplätze.“"
                            },
                            {
                                "example_id": "b3c8d5f8-4670-49e9-8b0b-84502a11cd1f",
                                "sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
                                "text": "„Der neugotische Hallenbau ist hell und schlicht, der durch den Triumphbogen vom Kirchenschiff getrennte Chorraum erstrahlt durch fünf gotische Spitzbogenfenster.“"
                            },
                            {
                                "example_id": "1aad5400-a020-4a6d-939a-9bcc412e397a",
                                "sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
                                "text": "[Evangelisch-lutherische Dorfkirche Glaubitz:] „Turm, Kirchenschiff und Chorraum wurden seit den neunziger Jahren komplett saniert.“"
                            },
                            {
                                "example_id": "5e0af712-c5fb-4e36-841a-ac1a34a15f0f",
                                "sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
                                "text": "„Das Kreuz blieb. Und die Welt staunte, zeigte sich gerührt, sprach von einem Wunder. Als die Feuerwehrleute in die so schrecklich brennende Kathedrale Notre-Dame vorrückten, bot sich ihnen und der Kamera durch das verwüstete Kirchenschiff der Blick weit bis in den Chorraum, bis auf das im Dunkel fast leuchtende Kreuz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0752c56-fa3a-4a93-8632-e1c90a74a0cf",
                        "source_entry_id": "ba25722e-4f73-365a-b0d8-55701722031c",
                        "source_sense_id": "5772b3cb-8215-3b7c-8093-0a2483a0b3af",
