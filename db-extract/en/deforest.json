                                "target_senses": [
                                    {
                                        "sense_id": "30d698b2-6e0b-3922-8cf8-cafe4ac57aac",
                                        "entry_id": "277a5243-067c-3e9e-8a5f-e591e25ddc66",
                                        "glosses": [
                                            "Détruire de la forêt."
