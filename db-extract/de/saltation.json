                    },
                    {
                        "translation_id": "1fbf1dcb-8b34-4fce-b6ea-e18ed1f477a7",
                        "source_entry_id": "f8b30502-6a1b-33c4-b8e8-6c8a21dff471",
                        "source_sense_id": "eaf533f9-7ddf-3ecb-a787-592f3584cb22",
                        "source_sense_description": "Geomorphologie, Strömungsmechanik: parabelförmiger Transport von Sandkörnern",
                        "target_lang_word": "saltation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saltation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55a6582e-5f6b-377c-85cf-c57a59940fe5",
                                        "entry_id": "e94f6b6b-48e7-3850-a11b-c472241a12b9",
                                        "glosses": [
                                            "Art des mouvements réglés, qui comprenait la danse, la pantomime, l’action théâtrale et l’action oratoire."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4879715-a6d0-4fc1-b7b0-a7e8558e10ac",
                                                "sense_id": "55a6582e-5f6b-377c-85cf-c57a59940fe5",
                                                "text": "Mais si le poëte blâme ce moyen, qui n’a rien d’ailleurs de blessant, que dirait-il du tapage par des semelles de fer, partie essentielle de la saltation antique, aussi désagréable à voir qu’odieux à entendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7d5b9e9-6604-3018-8258-b07f94c878fd",
                                        "entry_id": "e94f6b6b-48e7-3850-a11b-c472241a12b9",
                                        "glosses": [
                                            "Danse, pas réglés."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8954f685-8c77-4677-b2ab-d55039686eeb",
                                                "sense_id": "d7d5b9e9-6604-3018-8258-b07f94c878fd",
                                                "text": "Nus, le corps blanchi de cendre et de manioc, … ils avançaient en dansant. Ils rythmaient leurs saltations de paroles gutturales, nasillardes ou chuintantes, que l’on ne comprenait pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ba0557e-b6e1-3b79-bdc4-c844462cfafc",
                                        "entry_id": "e94f6b6b-48e7-3850-a11b-c472241a12b9",
                                        "glosses": [
                                            "Mode de déplacement par sauts des particules grossières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd008da5-f3a3-4feb-8fb1-d03cb0fab75f",
                                                "sense_id": "8ba0557e-b6e1-3b79-bdc4-c844462cfafc",
                                                "text": "Le mouvement initial des particules du sol est une série de sauts. Le diamètre des particules en saltation est compris entre 0,5 et 1,1 mm."
                                            }
                                        ]
                                    },
                                    {
