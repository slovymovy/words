                        "examples": [
                            {
                                "example_id": "4d464014-2753-42aa-a94d-0fad112ced2c",
                                "sense_id": "b5e7a886-fbaa-31e3-b0c2-1a6bd5e26454",
                                "text": "Tout le monde en ce pays a eu des rhumatismes ou des fluxions sur la poitrine…. il y a six semaines que la Marbeuf en est périlleusement malade,"
                            },
                            {
                                "example_id": "03a7b28f-dfb6-4554-af67-bac1a20c06a9",
                                "sense_id": "b5e7a886-fbaa-31e3-b0c2-1a6bd5e26454",
                                "text": "Il n’y avait plus ni pain ni farine à l’armée de Flandre ; il fallut céder honteusement et périlleusement à la nécessité,"
                            }
                        ]
                    }
                ],
                "translations": [
