{
    "word_family": [
        "obtainable",
        "unobtainable",
        "obtainer",
        "obtainment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c8a6f1a0-fcf6-3d1e-ade2-44692e996b54",
                    "sense_definition": "To get or acquire something, especially through effort or a formal process.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "acquisition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Applicants must <w>obtain</w> a permit before starting any construction on the site.",
                            "target_lang_translations": {
                                "ru": "Заявители должны <w>получить</w> разрешение перед началом любого строительства на участке.",
                                "pl": "Wnioskodawcy muszą <w>uzyskać</w> pozwolenie przed rozpoczęciem jakiejkolwiek budowy na terenie obiektu."
                            }
                        },
                        {
                            "text": "It is often difficult to <w>obtain</w> permission to enter the restricted research facility.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>добиться</w> разрешения на вход в закрытый научно-исследовательский центр.",
                                "pl": "Często trudno jest <w>otrzymać</w> pozwolenie na wejście do zastrzeżonego obiektu badawczego."
                            }
                        }
                    ],
                    "synonyms": [
                        "get",
                        "gain",
                        "acquire",
                        "attain",
                        "procure"
                    ],
                    "antonyms": [
                        "lose",
                        "forfeit",
                        "relinquish"
                    ],
                    "common_phrases": [
                        "obtain permission",
                        "obtain information",
                        "difficult to obtain",
                        "obtain accurate data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Получать или приобретать что-либо, особенно в результате усилий или официального процесса.",
                        "pl": "Otrzymać lub nabyć coś, szczególnie poprzez wysiłek lub formalny proces."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получать",
                                "target_lang_sense_clarification": "наиболее общее значение"
                            },
                            {
                                "target_lang_word": "добывать",
                                "target_lang_sense_clarification": "с трудом или в результате поиска"
                            },
                            {
                                "target_lang_word": "приобретать",
                                "target_lang_sense_clarification": "становиться обладателем"
                            },
                            {
                                "target_lang_word": "доставать",
                                "target_lang_sense_clarification": "разг., находить что-то дефицитное"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "uzyskać",
                                "target_lang_sense_clarification": "poprzez starania lub formalny proces"
                            },
                            {
                                "target_lang_word": "otrzymać",
                                "target_lang_sense_clarification": "stać się odbiorcą czegoś"
                            },
                            {
                                "target_lang_word": "nabyć",
                                "target_lang_sense_clarification": "wejść w posiadanie czegoś"
                            },
                            {
                                "target_lang_word": "zdobyć",
                                "target_lang_sense_clarification": "poprzez wysiłek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a68da25-106b-3912-9125-b2a64ae4d5a1",
                    "sense_definition": "To be established, accepted, or in use; to exist or be the case in a particular situation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The same rules <w>obtain</w> in this department as in all other branches of the company.",
                            "target_lang_translations": {
                                "ru": "В этом отделе <w>действуют</w> те же правила, что и во всех остальных филиалах компании.",
                                "pl": "W tym dziale <w>obowiązują</w> te same zasady, co we wszystkich innych oddziałach firmy."
                            }
                        },
                        {
                            "text": "We must consider the conditions that <w>obtain</w> in the local market before investing.",
                            "target_lang_translations": {
                                "ru": "Мы должны учитывать условия, которые <w>существуют</w> на местном рынке, прежде чем инвестировать.",
                                "pl": "Przed zainwestowaniem musimy rozważyć warunki, które <w>panują</w> na lokalnym rynku."
                            }
                        }
                    ],
                    "common_phrases": [
                        "conditions which obtain",
                        "no longer obtains"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть установленным, принятым или используемым; существовать или иметь место в определенной ситуации.",
                        "pl": "Być ustanowionym, zaakceptowanym lub w użyciu; istnieć lub mieć miejsce w danej sytuacji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "существовать",
                                "target_lang_sense_clarification": "о правилах или условиях"
                            },
                            {
                                "target_lang_word": "действовать",
                                "target_lang_sense_clarification": "быть в силе"
                            },
                            {
                                "target_lang_word": "иметь место",
                                "target_lang_sense_clarification": "происходить или быть актуальным"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obowiązywać",
                                "target_lang_sense_clarification": "o zasadach lub regułach"
                            },
                            {
                                "target_lang_word": "panować",
                                "target_lang_sense_clarification": "o warunkach lub zwyczajach"
                            },
                            {
                                "target_lang_word": "istnieć",
                                "target_lang_sense_clarification": "występować w danej sytuacji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b05fffa-fc4a-3fa6-b6c4-e49073940088",
                    "sense_definition": "To succeed in making something happen or ensuring a specific state of affairs is reached.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "achievement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer <w>obtained</w> that his client be released on bail pending the trial.",
                            "target_lang_translations": {
                                "ru": "Адвокат <w>добился</w> того, чтобы его клиента освободили под залог до начала судебного процесса.",
                                "pl": "Prawnik <w>wywalczył</w>, aby jego klient został zwolniony za kaucją do czasu rozprawy."
                            }
                        },
                        {
                            "text": "Through careful negotiation, they <w>obtained</w> that the treaty be signed by both parties.",
                            "target_lang_translations": {
                                "ru": "Путем тщательных переговоров они <w>достигли</w> того, чтобы договор был подписан обеими сторонами.",
                                "pl": "Dzięki starannym negocjacjom <w>doprowadzili do</w> podpisania traktatu przez obie strony."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used with a 'that' clause"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добиться того, чтобы что-то произошло, или обеспечить достижение определенного положения дел.",
                        "pl": "Skutecznie doprowadzić do czegoś lub zapewnić osiągnięcie określonego stanu rzeczy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добиваться",
                                "target_lang_sense_clarification": "успешно настаивать на чем-либо"
                            },
                            {
                                "target_lang_word": "достигать",
                                "target_lang_sense_clarification": "обеспечивать результат"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wywalczyć",
                                "target_lang_sense_clarification": "skutecznie doprowadzić do czegoś"
                            },
                            {
                                "target_lang_word": "uzyskać",
                                "target_lang_sense_clarification": "zapewnić określony wynik"
                            },
                            {
                                "target_lang_word": "doprowadzić do",
                                "target_lang_sense_clarification": "sprawić, by coś się stało"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}