                ],
                "senses": [
                    {
                        "sense_id": "fa6f23ab-97f5-3bf1-8f77-a72d60ad2ccc",
                        "entry_id": "92a74472-b8cb-3a0e-8def-3e7f0336c5e6",
                        "glosses": [
                            "Raum, der sowohl zum Kochen als auch für längeren Aufenthalt genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9126a30-2691-460a-ac01-a59e10a1479f",
                                "sense_id": "fa6f23ab-97f5-3bf1-8f77-a72d60ad2ccc",
                                "text": "„An einem Abend Ende Januar versammeln sich in einer Wohnküche die Siedler von Nativ Ha'avot.“"
                            },
                            {
                                "example_id": "86bef14f-ddef-49d9-bea3-f7507de99241",
                                "sense_id": "fa6f23ab-97f5-3bf1-8f77-a72d60ad2ccc",
                                "text": "„Am nächsten Morgen kam Roope im Sportdress durch die Wohnküche.“"
                            },
                            {
                                "example_id": "610c6eb1-82b9-43c1-a14c-04fcbfbc549b",
                                "sense_id": "fa6f23ab-97f5-3bf1-8f77-a72d60ad2ccc",
                                "text": "„Das Vorzelt scheint die Funktion einer Wohnküche zu erfüllen.“"
                            },
                            {
                                "example_id": "b81a9679-6ecf-475f-8058-8b772c71ab32",
                                "sense_id": "fa6f23ab-97f5-3bf1-8f77-a72d60ad2ccc",
                                "text": "„Es hatte drei Zimmer, eine Wohnküche und ein hölzernes Klohäuschen neben dem Hühnerstall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
