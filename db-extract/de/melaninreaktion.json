                "senses": [
                    {
                        "sense_id": "1572624b-5a5c-36e1-8328-b6f61fd43ca8",
                        "entry_id": "f8541686-4ea1-3ff7-a0aa-8828a077503a",
                        "glosses": [
                            "Reaktion im Zusammenhang mit dem Pigment Melanin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61372447-a659-472e-8242-c87570836862",
                                "sense_id": "1572624b-5a5c-36e1-8328-b6f61fd43ca8",
                                "text": "„Alle diese Pigmente geben typische Melaninreaktion, nirgends fiel die Reaktion für Eisenpigment positiv aus.“"
                            },
                            {
                                "example_id": "c9291e37-11a6-46c5-b562-bf477b9876e4",
                                "sense_id": "1572624b-5a5c-36e1-8328-b6f61fd43ca8",
                                "text": "„Im Harn der Kranken mit malignem Melanom ist diese Schwarzfärbung auf die Zwischenprodukte des Tyrosinstoffwechsels bei der Melaninreaktion zurückzuführen, welche bei der Berührung mit der freien Luft sich spontan zu Melanin oxydieren.“"
                            },
                            {
                                "example_id": "84efc064-9ee8-4f2b-937c-6f7db80f0d27",
                                "sense_id": "1572624b-5a5c-36e1-8328-b6f61fd43ca8",
                                "text": "„Eine der empfindlichsten Methoden für eine ICSH-Bestimmung soll jedoch die Melaninreaktion am Federkleid des afrikanischen Weber-Finken sein […].“"
                            },
                            {
                                "example_id": "a337a546-765d-4461-9acd-5efa57a7cb90",
                                "sense_id": "1572624b-5a5c-36e1-8328-b6f61fd43ca8",
                                "text": "„Das Auftreten einer Melaninreaktion im Harn nach Bestrahlung eines unklaren Lungenprozesses klärt diesen eindeutig als Metastasen eines Melanosarkoms.“"
                            },
                            {
                                "example_id": "189b51c2-75e3-41b8-b4f3-cd0a682ebcf9",
                                "sense_id": "1572624b-5a5c-36e1-8328-b6f61fd43ca8",
                                "text": "„Bei Sonnenbrand zeigt der Harn eine Melaninreaktion: er dunkelt beim Stehen nach und färbt sich mit Schwefelsäure und Eisenchlorid dunkel.“"
                            },
                            {
                                "example_id": "f01d5c87-2f13-410d-b3e8-3da650bbf45a",
                                "sense_id": "1572624b-5a5c-36e1-8328-b6f61fd43ca8",
                                "text": "„Diese Autoren konnten nämlich zeigen , daß die Melaninreaktionen sowohl durch Adrenalin als durch Tyrosin und Tryptophan zu erhalten sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
