                "senses": [
                    {
                        "sense_id": "f86617f8-898b-3e31-9af8-5ff0a2e632c2",
                        "entry_id": "667b609d-e111-35ae-9efb-78d73a547a6e",
                        "glosses": [
                            "om een beetje te lachen, grappig, niet ernstig, leuk, opgewekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed1c8d24-a2ba-4ad6-990e-6be9b7af2303",
                                "sense_id": "f86617f8-898b-3e31-9af8-5ff0a2e632c2",
                                "text": "- (…) zo verluchtte hij zijn vertoog op diverse plaatsen met als olijk bedoelde plaatjes (…)"
                            },
                            {
                                "example_id": "c8df3f18-906e-4c5f-9e9d-375da2d4ae94",
                                "sense_id": "f86617f8-898b-3e31-9af8-5ff0a2e632c2",
                                "text": "- Mijn dochters hebben alle boeken over de olijke tweeling gelezen."
                            }
                        ]
                    },
                    {
                        "sense_id": "255a8222-d948-3f5c-a629-c1abafbc934c",
                        "entry_id": "667b609d-e111-35ae-9efb-78d73a547a6e",
                        "glosses": [
                            "eigenlijk niet zoals het hoort, ondeugend, guitig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47991dc5-d743-4790-8695-41684e1a5e8d",
                                "sense_id": "255a8222-d948-3f5c-a629-c1abafbc934c",
                                "text": "- Zoals het olijk in het nationale rapport staat vermeld: ‘Fraude is het ongewenste restproduct van een beleid.’"
                            }
                        ]
                    }
