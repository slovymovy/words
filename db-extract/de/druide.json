                                                "example_id": "d67e2e7a-5890-4bfa-8f17-eb478245f597",
                                                "sense_id": "162f983d-a5e4-32bf-9388-f38d6626277f",
                                                "text": "A turba ulula, o druida canta, enchendo os ares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ccf6678-23ef-4569-b236-692669d07618",
                        "source_entry_id": "d3f047c4-cb62-3bbb-ae30-0605bae939c5",
                        "source_sense_id": "8a9c75d5-f0e5-3817-bda9-644b05497474",
                        "source_sense_description": "keltischer Priester",
                        "target_lang_word": "друид",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "друид",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "194dbfb9-5b3e-33ee-a62f-202fcb73d06a",
                                        "entry_id": "754d8261-7c78-39a3-a7e0-1a7a93824d4d",
                                        "glosses": [
                                            "истор. у кельтских народов в древности — священнослужитель, представитель касты жрецов или поэтов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12274bca-0e2c-403f-962a-faf10b757577",
                                                "sense_id": "194dbfb9-5b3e-33ee-a62f-202fcb73d06a",
                                                "text": "Я думаю, что заповеданные леса друидов, их священные дубравы, не могли быть ни таинственнее, ни мрачнее этой рощи."
                                            },
                                            {
                                                "example_id": "cfbf0100-07d5-4298-b21d-4c4cdccc33fe",
                                                "sense_id": "194dbfb9-5b3e-33ee-a62f-202fcb73d06a",
                                                "text": "Друиды ― так галлы называли своих кудесников ― считали, что нет ничего священнее омелы, особенно если она произрастает на дубе."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
