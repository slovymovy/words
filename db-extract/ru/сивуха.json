                    {
                        "translation_id": "8bd87d79-bce2-4c1f-a853-6c9ac9d5a7dd",
                        "source_entry_id": "f0f3ef0f-845f-3592-8803-e9b93cf71b58",
                        "source_sense_id": "31ecefc0-c959-3b4b-96d9-a09289edd698",
