                                                "sense_id": "d2061e1d-68ce-3008-b47f-ac8afe898d44",
                                                "text": "Ce livre est épuisé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e381eb19-b93e-3856-983a-eaad0bda465c",
