                        "glosses": [
                            "Arséniosulfure naturel de cobalt et de fer, utilisé comme minerai de cobalt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed7f0526-9c93-4280-b184-571c2daf9dac",
                                "sense_id": "48035cf1-3ead-3a50-9740-991c16f1d9a1",
                                "text": "La danaïte a été trouvée pour la première fois au début du XIXᵉ siècle en Franconie. C’est un minerai gris et brillant de densité relative 6,214."
                            },
                            {
                                "example_id": "2afe31dc-e69c-4f61-8dda-159c3d5e14f5",
                                "sense_id": "48035cf1-3ead-3a50-9740-991c16f1d9a1",
                                "text": "La densité de la variété positive de la danaïte de Franconia surpasse celle de la variété négative de Suède."
                            }
                        ]
                    }
                ],
