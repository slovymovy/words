                        "entry_id": "abb327d0-ba9d-3f28-a456-fe8e3fcb28d8",
                        "glosses": [
                            "ein wettergeschütztes, meist hölzernes Bauwerk, in dem Bienen in mehreren Bienenstöcken gehalten werden"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "28b19265-c91b-414b-8571-43705f7a6b03",
                                "sense_id": "f44b460c-be22-339c-87c9-ae35681392c0",
                                "text": "Diese von ihm Apiarium genannte Bienenwohnung ermöglicht gefahrlos einen Blick direkt in den Bienenstock."
                            },
                            {
                                "example_id": "80201d8e-f73b-466b-9273-3ea47a0e9060",
                                "sense_id": "f44b460c-be22-339c-87c9-ae35681392c0",
                                "text": "Kapitän Perrine in Chicago faßte … die originelle Idee, ein schwimmendes, aus 800 Bienenstöcken bestehendes Apiarium herzustellen, …"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
