                        "entry_id": "6c76efe7-42e1-3942-abfb-5b9fbc780822",
                        "glosses": [
                            "Synonym of haruspicy: the study and divination by use of animal entrails, usually the victims of sacrifice."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3dee5e23-089f-4f83-afb4-414a4f9e5d9e",
                                "sense_id": "0091e1e7-7e96-3e06-8471-a8acee66f0f2",
                                "text": "They became experts in what is called extispicy, or the readings of organs of sacrificed animals."
                            },
                            {
                                "example_id": "fd7d48cc-6ed4-44cb-a3e8-bbbe89bb996d",
                                "sense_id": "0091e1e7-7e96-3e06-8471-a8acee66f0f2",
                                "text": "... to avoid wasting the enormous amounts of carcasses that in Mari, as elsewhere in Mesopotamia, were the products of the frequent killing of animals, almost exclusively sheep, for extispicy and omen taking."
                            }
                        ]
                    },
                    {
                        "sense_id": "12a40a87-ef96-3f18-b3ab-78318e1f79ab",
                        "entry_id": "6c76efe7-42e1-3942-abfb-5b9fbc780822",
                        "glosses": [
                            "A specific instance of such divination."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "0dde4797-1bb1-42bd-8420-d6ce91ff68f0",
                                "sense_id": "12a40a87-ef96-3f18-b3ab-78318e1f79ab",
                                "text": "This image has been interpreted as the performance of “an extispicy on an animal whose flesh the king will later eat.\""
                            }
                        ]
                    }
