        "fr-extract.jsonl": [
            {
                "entry_id": "181e9ab6-7ce6-3e20-98d0-ad4e821fb835",
                "word": "cigarillo",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "068e32c3-8ca6-44b3-a606-5a73fe37dd32",
                        "entry_id": "181e9ab6-7ce6-3e20-98d0-ad4e821fb835",
                        "tags": [
                            "plural"
                        ],
                        "form": "cigarillos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5fbd45da-f4a1-3d12-a02c-7a10348ded22",
                        "entry_id": "181e9ab6-7ce6-3e20-98d0-ad4e821fb835",
                        "glosses": [
                            "Petit cigare d’une taille proche de celle de la cigarette, cigarette où le papier est remplacé par une feuille de tabac."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96709026-86ce-4c47-a359-7779a8d355a1",
                                "sense_id": "5fbd45da-f4a1-3d12-a02c-7a10348ded22",
                                "text": "Le brun à tête de bélier alluma un cigarillo dont il tirait des bouffées nerveuses. Il se tourna vers nous.\n— Excusez-moi… Le bébé…\nIl nous désignait en souriant le cigarillo qu’il écrasa dans le cendrier.\n— La fumée, c’est mauvais pour les bébés, nous dit-il."
                            },
                            {
                                "example_id": "8478b2a6-153b-4541-b81c-f6e3b5b725b1",
                                "sense_id": "5fbd45da-f4a1-3d12-a02c-7a10348ded22",
                                "text": "L'amertume un rien vénéneuse du cigarillo est une chose à lui."
                            },
                            {
                                "example_id": "cb5aab6c-47e9-437e-b411-f9a7f69acebf",
                                "sense_id": "5fbd45da-f4a1-3d12-a02c-7a10348ded22",
                                "text": "Le cigarillo, c’est la vraie solitude, une façon sournoise de se montrer bougon dans le plaisir."
                            },
                            {
                                "example_id": "4600646c-3361-4da3-8f66-b5b7802f0d6d",
                                "sense_id": "5fbd45da-f4a1-3d12-a02c-7a10348ded22",
                                "text": "L’entourage trouve l’odeur infecte, et l’on pense de même quand quelqu’un fume le cigare ou le cigarillo devant soi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "123ad765-1f37-43fe-ba87-b06f276c1a08",
                        "source_entry_id": "181e9ab6-7ce6-3e20-98d0-ad4e821fb835",
                        "source_sense_id": "5fbd45da-f4a1-3d12-a02c-7a10348ded22",
                        "target_lang_word": "Zigarillo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zigarillo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd6ae01e-0092-36ed-ac33-21b3bf58f34b",
                                        "entry_id": "754d537e-40c5-383d-89b1-182c1448eba1",
                                        "glosses": [
                                            "kurze, dünne Zigarre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85fb539a-a49b-4b77-b392-f99420e7a8da",
                                                "sense_id": "dd6ae01e-0092-36ed-ac33-21b3bf58f34b",
                                                "text": "Peter raucht einen Zigarillo."
                                            },
                                            {
                                                "example_id": "a401164b-0de8-498c-a569-43c4027ffc62",
                                                "sense_id": "dd6ae01e-0092-36ed-ac33-21b3bf58f34b",
                                                "text": "„Ich setzte mich neben ihn und zündete mir eines seiner Zigarillos an.“"
                                            },
                                            {
                                                "example_id": "29385d7e-1e0f-479c-9823-eb4f74313e57",
                                                "sense_id": "dd6ae01e-0092-36ed-ac33-21b3bf58f34b",
                                                "text": "„Er zündete sich einen Zigarillo an.“"
                                            },
                                            {
                                                "example_id": "1525af54-d65d-4e7c-8047-e5ab08bd8d31",
                                                "sense_id": "dd6ae01e-0092-36ed-ac33-21b3bf58f34b",
                                                "text": "„Ein hagerer Mann, der sich als Eduard Pfeiffer vorgestellt hatte und dessen Anzug zwei Nummern zu groß war, zog an seinem Zigarillo und blätterte ungeduldig in Papieren, die auf einem Klemmbrett befestigt waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
