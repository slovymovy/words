                "senses": [
                    {
                        "sense_id": "e441a1cb-b4b2-37aa-a704-b253e539c0e8",
                        "entry_id": "a753dd09-5853-3eb3-a9df-c2f232497849",
                        "glosses": [
                            "auf lemmatisiertes Geschriebenes begrenzter Bereich"
                        ],
                        "tags": [
                            "Spezialausdruck im Wiktionary .de"
                        ],
                        "examples": [
                            {
                                "example_id": "00809631-245b-408c-975f-66a593d22bc8",
                                "sense_id": "e441a1cb-b4b2-37aa-a704-b253e539c0e8",
                                "text": "„Stimmberechtigt sind nur angemeldete Benutzer, die seit mindestens einem Monat angemeldet sind; die mindestens 150 Änderungen im Eintragsnamensraum haben.“"
                            },
                            {
                                "example_id": "74680ff3-a4f4-45c9-a767-07e9b37743aa",
                                "sense_id": "e441a1cb-b4b2-37aa-a704-b253e539c0e8",
                                "text": "„Durch die Verschiebung der Flexionsseiten aus dem Eintragsnamensraum in den neuen Namensraum Flexion wurde der Seitenzähler Mitte Januar 2015 wieder unter die Anzahl von 390.000 zurückgesetzt, weshalb die Meilensteine 390.000 und 395.000 doppelt gelistet sind.“"
                            },
                            {
                                "example_id": "01f85198-583d-49be-888c-dcb451e7501b",
                                "sense_id": "e441a1cb-b4b2-37aa-a704-b253e539c0e8",
                                "text": "„Durch Übernahme von frei verfügbaren Wörterlisten in unseren Eintragsnamensraum würde man bei der Suche nach einem Wort wenigstens schon mal einen Hinweis auf eine Übersetzung in eine oder mehrere Sprachen finden.“"
                            },
                            {
                                "example_id": "482de060-b460-41d0-b4c4-72c27b2f5e25",
                                "sense_id": "e441a1cb-b4b2-37aa-a704-b253e539c0e8",
                                "text": "„Mindestens 50 verschiedene Seiten im Eintragsnamensraum wurden bearbeitet.“"
                            },
                            {
                                "example_id": "bd186aec-c31d-4039-a3f6-7dd1f8565ec3",
                                "sense_id": "e441a1cb-b4b2-37aa-a704-b253e539c0e8",
                                "text": "„Die Kategorisierung erfolgt nur dann, wenn diese Vorlage im Eintragsnamensraum eingebunden wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
