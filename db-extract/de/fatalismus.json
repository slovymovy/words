                    {
                        "form_id": "015c3516-243a-45d4-af47-f06d011e3eb5",
                        "entry_id": "2170b7b8-a50c-3c54-9c80-8eb5e1929d14",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Fatalismus"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0615e786-95b0-3c86-b236-d8989c62b2e4",
                        "entry_id": "2170b7b8-a50c-3c54-9c80-8eb5e1929d14",
                        "glosses": [
                            "Weltanschauung, die alle Geschehnisse dem Schicksal zuordnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b239ee4-f611-421a-9752-6b2479479630",
                                "sense_id": "0615e786-95b0-3c86-b236-d8989c62b2e4",
                                "text": "„Und er verwirft den Fatalismus, weil er ein freier Mensch und nicht ein Teil einer, wenn auch Himmel und Erde umfassenden Maschinerie sein will.“"
                            },
                            {
                                "example_id": "df416ea8-10d3-40f2-908d-7a872ed3d424",
                                "sense_id": "0615e786-95b0-3c86-b236-d8989c62b2e4",
                                "text": "„Der Fatalismus hat seine Heimat im Morgenlande.“"
                            },
                            {
                                "example_id": "2b646a3b-037f-4f05-967f-8f0f025bfe1b",
                                "sense_id": "0615e786-95b0-3c86-b236-d8989c62b2e4",
                                "text": "„Es erschien mir als nonchalantes Achselzucken, als eine mögliche operettenhafte Antwort auf das Unabänderliche, ein heiterer Fatalismus.“"
                            },
                            {
                                "example_id": "427ce763-c194-40fa-9dd1-ab35e412d1f0",
                                "sense_id": "0615e786-95b0-3c86-b236-d8989c62b2e4",
                                "text": "„Der Fatalismus ist ihm am Ende über den Kopf gewachsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7aa78aff-56bb-4bdf-ad83-f695e327c74b",
                        "source_entry_id": "2170b7b8-a50c-3c54-9c80-8eb5e1929d14",
