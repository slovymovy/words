{
    "word_family": [
        "hideously",
        "hideousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4676585a-39df-3656-8644-cc26cdb26876",
                    "sense_definition": "Extremely or shockingly ugly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ugly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry to say that your new dress looks truly <w>hideous</w>.",
                            "target_lang_translations": {
                                "pl": "Przykro mi to mówić, ale twoja nowa sukienka wygląda naprawdę <w>ohydnie</w>."
                            }
                        },
                        {
                            "text": "The old building was a <w>hideous</w> sight in the middle of the beautiful park.",
                            "target_lang_translations": {
                                "pl": "Stary budynek był <w>ohydnym</w> widokiem pośrodku pięknego parku."
                            }
                        }
                    ],
                    "synonyms": [
                        "grotesque"
                    ],
                    "common_phrases": [
                        "hideous sight",
                        "hideous dress"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ekstremalnie lub szokująco brzydki."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ohydny",
                                "target_lang_sense_clarification": "budzący wstręt, bardzo brzydki"
                            },
                            {
                                "target_lang_word": "obrzydliwy",
                                "target_lang_sense_clarification": "budzący odrazę, bardzo nieprzyjemny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f555826-962a-3fa2-8cf5-94ae61d81bf5",
                    "sense_definition": "Having a very unpleasant or frightening sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unpleasant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monster let out a <w>hideous</w> roar that echoed through the dark forest.",
                            "target_lang_translations": {
                                "pl": "Potwór wydał z siebie <w>przeraźliwy</w> ryk, który odbił się echem w ciemnym lesie."
                            }
                        },
                        {
                            "text": "We heard a <w>hideous</w> noise coming from the engine before it finally stopped.",
                            "target_lang_translations": {
                                "pl": "Usłyszeliśmy <w>straszny</w> hałas dochodzący z silnika, zanim ostatecznie zgasł."
                            }
                        }
                    ],
                    "synonyms": [
                        "frightful",
                        "terrible"
                    ],
                    "common_phrases": [
                        "hideous roar",
                        "hideous noise"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wydający bardzo nieprzyjemny lub przerażający dźwięk."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przeraźliwy",
                                "target_lang_sense_clarification": "o dźwięku budzącym lęk"
                            },
                            {
                                "target_lang_word": "straszny",
                                "target_lang_sense_clarification": "o dźwięku wywołującym niepokój"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a3dff741-3a3d-3955-a5d6-9c0c4c8f2de9",
                    "sense_definition": "Hateful or shocking in nature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unpleasant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news of the crime was truly <w>hideous</w> to everyone in the community.",
                            "target_lang_translations": {
                                "pl": "Wiadomość o zbrodni była naprawdę <w>wstrząsająca</w> dla wszystkich w społeczności."
                            }
                        },
                        {
                            "text": "He had a <w>hideous</w> secret that he kept hidden for many years.",
                            "target_lang_translations": {
                                "pl": "Miał <w>okropny</w> sekret, który ukrywał przez wiele lat."
                            }
                        }
                    ],
                    "synonyms": [
                        "dreadful",
                        "horrid"
                    ],
                    "common_phrases": [
                        "hideous secret",
                        "hideous crime"
                    ],
                    "target_lang_definitions": {
                        "pl": "Odrażający lub szokujący w swojej naturze."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "straszny",
                                "target_lang_sense_clarification": "budzący grozę lub wstręt"
                            },
                            {
                                "target_lang_word": "okropny",
                                "target_lang_sense_clarification": "bardzo zły, wstrząsający"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "417c779e-d782-3eb1-9e5a-0fb4a719be05",
                    "sense_definition": "Morally offensive or detestable.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "unpleasant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator committed a <w>hideous</w> act against his own people.",
                            "target_lang_translations": {
                                "pl": "Dyktator dopuścił się <w>podłego</w> czynu wobec własnego narodu."
                            }
                        },
                        {
                            "text": "It was a <w>hideous</w> betrayal of trust that destroyed their long friendship.",
                            "target_lang_translations": {
                                "pl": "To była <w>wstrętna</w> zdrada zaufania, która zniszczyła ich długoletnią przyjaźń."
                            }
                        }
                    ],
                    "synonyms": [
                        "ghastly",
                        "grim",
                        "grisly"
                    ],
                    "common_phrases": [
                        "hideous act",
                        "hideous betrayal"
                    ],
                    "target_lang_definitions": {
                        "pl": "Moralnie obraźliwy lub odrażający."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "podły",
                                "target_lang_sense_clarification": "moralnie naganny, nikczemny"
                            },
                            {
                                "target_lang_word": "wstrętny",
                                "target_lang_sense_clarification": "budzący głęboką odrazę moralną"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}