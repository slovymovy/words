                ],
                "senses": [
                    {
                        "sense_id": "805f631e-e81e-30d7-84e7-870f779d7cd6",
                        "entry_id": "c6f6b5a6-7c20-3038-bfb8-af05c9a02d70",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00077222-f74b-4b52-a7e6-e8a0be98909d",
                                "sense_id": "805f631e-e81e-30d7-84e7-870f779d7cd6",
                                "text": "Frau Scheidle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9d3d6148-f008-4397-9ebd-5e2324d9d718",
                                "sense_id": "805f631e-e81e-30d7-84e7-870f779d7cd6",
                                "text": "Herr Scheidle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "5c254b29-4845-4a6f-8820-e3f5a1272489",
                                "sense_id": "805f631e-e81e-30d7-84e7-870f779d7cd6",
                                "text": "Die Scheidles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "19bd3d82-e092-4087-b589-0bbb2bf35ca3",
                                "sense_id": "805f631e-e81e-30d7-84e7-870f779d7cd6",
                                "text": "Der Scheidle trägt nie die Pullover, die die Scheidle ihm strickt."
                            },
                            {
                                "example_id": "02b5ed0c-29f4-401a-99fc-9af8f3d6a77c",
                                "sense_id": "805f631e-e81e-30d7-84e7-870f779d7cd6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scheidle kommt, geht der Herr Scheidle.“"
                            },
                            {
                                "example_id": "d1ac1bbf-c31f-4d24-b048-52939bb9d2c6",
                                "sense_id": "805f631e-e81e-30d7-84e7-870f779d7cd6",
                                "text": "Scheidle kommt und geht."
                            },
                            {
                                "example_id": "be94d63c-fd38-4e81-9bb6-a23c5ec6a2d3",
                                "sense_id": "805f631e-e81e-30d7-84e7-870f779d7cd6",
                                "text": "Scheidles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
