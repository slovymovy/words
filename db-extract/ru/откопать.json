                "senses": [
                    {
                        "sense_id": "d5750c56-7e6d-33ca-a67a-13f935500d07",
                        "entry_id": "8788e758-1680-371d-8c9c-3c1e5f9ee9e5",
                        "glosses": [
                            "копая, извлечь что-либо засыпанное землёй, снегом и т. п. или зарытое в землю, освободить кого-либо засыпанного землёй и т. п.; отрыть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10b596b8-fa47-46f5-8e37-21d440c334d9",
                                "sense_id": "d5750c56-7e6d-33ca-a67a-13f935500d07",
                                "text": "Через пару часов они откопали скелет, мучнистый и белый, словно на чёрную землю кто-то насыпал из кулака соль, нарисовал позвоночник, рёбра, ноги."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5ef4c05-5b1f-3728-b9a3-5fc943a378c1",
                        "entry_id": "8788e758-1680-371d-8c9c-3c1e5f9ee9e5",
                        "glosses": [
                            "перен., разг. найти, разыскать, извлечь откуда-либо что-либо забытое, малоизвестное и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1160cd16-37b8-481a-8898-d46ee831ef2a",
                        "source_entry_id": "8788e758-1680-371d-8c9c-3c1e5f9ee9e5",
                        "source_sense_description": "копая, извлечь что-либо засыпанное, зарытое",
                        "target_lang_word": "dig up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dig up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4579cf42-70c3-3fe3-81d2-ccb96cb718ce",
                                        "entry_id": "f68acdf0-5230-36a2-9e22-f71ac7920f7e",
                                        "glosses": [
                                            "to excavate something"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3444a54-4ccd-4714-8b09-bb5b6635d173",
                                                "sense_id": "4579cf42-70c3-3fe3-81d2-ccb96cb718ce",
                                                "text": "The work involved a complete rewiring of the system, while the addition of four higher-capacity Mechan jacks and the increased length of the new train meant the entire floor (the length of four train carriages) had to be dug up, levelled and strengthened to meet tolerance requirements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "841e138e-d54c-3bfd-8199-317c75680861",
                                        "entry_id": "f68acdf0-5230-36a2-9e22-f71ac7920f7e",
                                        "glosses": [
                                            "to discover something by digging; to unearth"
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34a43c89-b983-4096-a2e5-7e04c1d310d3",
                                                "sense_id": "841e138e-d54c-3bfd-8199-317c75680861",
                                                "text": "dig some gossip up on him."
                                            },
                                            {
                                                "example_id": "4b3f409d-0555-460a-9b88-85199be5d841",
                                                "sense_id": "841e138e-d54c-3bfd-8199-317c75680861",
                                                "text": "dig up information"
                                            },
                                            {
                                                "example_id": "d15bc844-d7e2-41ed-bdc7-91fececfe5c1",
                                                "sense_id": "841e138e-d54c-3bfd-8199-317c75680861",
                                                "text": "dig up proof"
                                            },
                                            {
                                                "example_id": "c3700f17-a855-4c5d-a59c-0a18cbde34c2",
                                                "sense_id": "841e138e-d54c-3bfd-8199-317c75680861",
                                                "text": "dig up some scandalous stories"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64c4cff1-29eb-3a04-a89b-c175e9d1f1eb",
                                        "entry_id": "f68acdf0-5230-36a2-9e22-f71ac7920f7e",
                                        "glosses": [
                                            "To find a supply of (something); to pay up."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7aa2eba-45e6-4c9d-9b1c-41409c9b5e9d",
                                                "sense_id": "64c4cff1-29eb-3a04-a89b-c175e9d1f1eb",
                                                "text": "You'll have to dig up eight grand to pay for this."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a98b268-f61a-474c-b52e-f91ccf49f231",
                        "source_entry_id": "8788e758-1680-371d-8c9c-3c1e5f9ee9e5",
                        "source_sense_description": "копая, извлечь что-либо засыпанное, зарытое",
                        "target_lang_word": "déterrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déterrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e899a4-78f5-3bbe-a57a-32da2937c3ca",
                                        "entry_id": "01088813-b9e4-3179-b400-78cd10469f80",
                                        "glosses": [
                                            "Retirer de terre ce qui s’y trouvait caché, enfoui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f45497fd-fecd-4ae6-a342-2648f486bbfe",
                                                "sense_id": "d5e899a4-78f5-3bbe-a57a-32da2937c3ca",
                                                "text": "Déterrer un trésor. - Déterrer une statue antique."
                                            },
                                            {
                                                "example_id": "f8053269-1b74-42c3-8734-05256ab60388",
                                                "sense_id": "d5e899a4-78f5-3bbe-a57a-32da2937c3ca",
                                                "text": "[…], le chien s’était mis à rôder dans les environs, fouillant avidement les tas d’ordures, sans doute pour y déterrer un os ou quelque régal de ce genre."
                                            }
                                        ]
                                    },
                                    {
