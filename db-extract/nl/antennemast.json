                                            {
                                                "example_id": "59e88997-80dc-40f0-a849-c762dfa02336",
                                                "sense_id": "9368cae7-5ad6-3f76-a594-c176ffa749cf",
                                                "text": "Durch den heftigen Sturm wurde ein Antennenmast umgerissen."
                                            },
                                            {
                                                "example_id": "1f6a4fdf-1e8b-433b-9954-3b51bb73968b",
                                                "sense_id": "9368cae7-5ad6-3f76-a594-c176ffa749cf",
                                                "text": "„Der Antennenmast ist über einen Erdungsleiter blitzstromtragfähig mit der Erde zu verbinden.“"
                                            }
                                        ],
