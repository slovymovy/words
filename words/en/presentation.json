{
    "word_family": [
        "present",
        "presenter",
        "presentable",
        "presentational",
        "represent",
        "representation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1f5d432-c009-32ee-8a04-1ce6fb19bb9c",
                    "sense_definition": "A talk or speech given to an audience to explain an idea, project, or piece of work.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had to give a <w>presentation</w> about her research to the entire class.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось выступить с <w>презентацией</w> своего исследования перед всем классом."
                            }
                        },
                        {
                            "text": "The manager asked me to prepare a short <w>presentation</w> for the meeting.",
                            "target_lang_translations": {
                                "ru": "Менеджер попросил меня подготовить короткий <w>доклад</w> для собрания."
                            }
                        }
                    ],
                    "synonyms": [
                        "talk",
                        "lecture",
                        "speech",
                        "address"
                    ],
                    "common_phrases": [
                        "give a presentation",
                        "make a presentation",
                        "oral presentation",
                        "business presentation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выступление или речь перед аудиторией для разъяснения идеи, проекта или работы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "презентация",
                                "target_lang_sense_clarification": "публичное выступление"
                            },
                            {
                                "target_lang_word": "доклад",
                                "target_lang_sense_clarification": "официальное сообщение"
                            },
                            {
                                "target_lang_word": "выступление",
                                "target_lang_sense_clarification": "речь перед публикой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "447e1ae0-9592-3203-bccc-584aa90b83bc",
                    "sense_definition": "A digital slideshow or document created using software to support a talk.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I spent all night working on the PowerPoint <w>presentation</w> for tomorrow.",
                            "target_lang_translations": {
                                "ru": "Я всю ночь работал над <w>презентацией</w> в PowerPoint на завтра."
                            }
                        },
                        {
                            "text": "Please save your <w>presentation</w> on a USB drive before the seminar starts.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, сохраните свою <w>презентацию</w> на флешку до начала семинара."
                            }
                        }
                    ],
                    "synonyms": [
                        "slideshow"
                    ],
                    "common_phrases": [
                        "multimedia presentation",
                        "presentation software",
                        "slide presentation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цифровое слайд-шоу или документ, созданный с помощью программного обеспечения для сопровождения выступления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "презентация",
                                "target_lang_sense_clarification": "электронный документ или файл"
                            },
                            {
                                "target_lang_word": "слайд-шоу",
                                "target_lang_sense_clarification": "последовательность изображений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85814e06-bcd3-33e3-a063-425a1096eb1d",
                    "sense_definition": "The way in which something is shown, offered, or arranged for people to see.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>presentation</w> of the food at this restaurant is absolutely beautiful.",
                            "target_lang_translations": {
                                "ru": "<w>Подача</w> блюд в этом ресторане просто великолепна."
                            }
                        },
                        {
                            "text": "Good <w>presentation</w> is essential when you are trying to sell a house.",
                            "target_lang_translations": {
                                "ru": "Хорошее <w>оформление</w> крайне важно, когда вы пытаетесь продать дом."
                            }
                        }
                    ],
                    "synonyms": [
                        "appearance",
                        "arrangement",
                        "display",
                        "layout"
                    ],
                    "common_phrases": [
                        "visual presentation",
                        "food presentation",
                        "professional presentation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, которым что-либо показывают, предлагают или оформляют для обозрения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оформление",
                                "target_lang_sense_clarification": "внешний вид или дизайн"
                            },
                            {
                                "target_lang_word": "подача",
                                "target_lang_sense_clarification": "способ представления, например, блюда"
                            },
                            {
                                "target_lang_word": "презентация",
                                "target_lang_sense_clarification": "внешний вид товара или объекта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38153f18-a01c-3507-85ec-39428d20e84c",
                    "sense_definition": "A formal ceremony or occasion where an award or gift is given to someone.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ceremony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The annual awards <w>presentation</w> will take place in the main hall tonight.",
                            "target_lang_translations": {
                                "ru": "Ежегодное <w>вручение</w> наград состоится сегодня вечером в главном зале."
                            }
                        },
                        {
                            "text": "He was invited to the palace for the <w>presentation</w> of his medal.",
                            "target_lang_translations": {
                                "ru": "Его пригласили во дворец на <w>вручение</w> медали."
                            }
                        }
                    ],
                    "synonyms": [
                        "ceremony",
                        "bestowal",
                        "handover"
                    ],
                    "common_phrases": [
                        "awards presentation",
                        "presentation ceremony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная церемония или мероприятие, на котором вручается награда или подарок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вручение",
                                "target_lang_sense_clarification": "церемония передачи награды"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "официальное выдвижение или показ"
                            },
                            {
                                "target_lang_word": "церемония",
                                "target_lang_sense_clarification": "торжественное мероприятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb93aaee-6b5c-36aa-9df9-4f4622efe2d9",
                    "sense_definition": "The symptoms and signs that a patient shows when first seen by a doctor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clinical <w>presentation</w> of the disease can vary greatly between patients.",
                            "target_lang_translations": {
                                "ru": "Клиническая <w>картина</w> заболевания может сильно различаться у разных пациентов."
                            }
                        },
                        {
                            "text": "The <w>presentation</w> of the male in the emergency room included a slight fever.",
                            "target_lang_translations": {
                                "ru": "Клинические <w>проявления</w> у мужчины в отделении скорой помощи включали небольшую лихорадку."
                            }
                        }
                    ],
                    "synonyms": [
                        "manifestation"
                    ],
                    "common_phrases": [
                        "clinical presentation",
                        "initial presentation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical medical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Симптомы и признаки, которые проявляются у пациента при первом осмотре врачом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клиническая картина",
                                "target_lang_sense_clarification": "совокупность проявлений болезни"
                            },
                            {
                                "target_lang_word": "проявление",
                                "target_lang_sense_clarification": "манифестация симптомов"
                            },
                            {
                                "target_lang_word": "презентация",
                                "target_lang_sense_clarification": "медицинский термин для описания случая"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc0d001b-0f5c-35f8-83b6-083c2b30219e",
                    "sense_definition": "The position of a baby in the womb just before birth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A breech <w>presentation</w> means the baby is positioned feet-first instead of head-first.",
                            "target_lang_translations": {
                                "ru": "Тазовое <w>предлежание</w> означает, что ребенок расположен ножками, а не головкой вперед."
                            }
                        },
                        {
                            "text": "The doctor checked the <w>presentation</w> of the fetus during the ultrasound.",
                            "target_lang_translations": {
                                "ru": "Врач проверил <w>предлежание</w> плода во время УЗИ."
                            }
                        }
                    ],
                    "common_phrases": [
                        "breech presentation",
                        "cephalic presentation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Положение ребенка в матке непосредственно перед родами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предлежание",
                                "target_lang_sense_clarification": "положение плода в матке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}