                    {
                        "translation_id": "362009ca-4b6a-442c-a15f-0d0942fbbcc1",
                        "source_entry_id": "a3e1b97c-0200-397a-801c-7d7a6bad2ecd",
                        "source_sense_id": "b4ac6500-d128-3786-afd1-d3c428a60cbe",
                        "source_sense_description": "beweglicher Schutzschirm gegen Kälte, Zugluft, als Sichtschutz und dergleichen",
                        "target_lang_word": "paravent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paravent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec37453e-7982-3a92-adfc-c9eb0df1751d",
                                        "entry_id": "8846954a-db62-3d4a-8d18-5e06384ad7ef",
                                        "glosses": [
                                            "Meuble composé de plusieurs panneaux qui s’étendent et, en général, se plient l’un sur l’autre, et dont on se sert pour se garantir de l’air ou pour dissimuler quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f98c0e89-68ac-498d-bd17-5fd38d811372",
                                                "sense_id": "ec37453e-7982-3a92-adfc-c9eb0df1751d",
                                                "text": "Paravent à quatre feuilles, à six feuilles. — Châssis de paravent."
                                            },
                                            {
                                                "example_id": "66c5cbd7-3371-4aeb-94fa-e554bc47b3ba",
                                                "sense_id": "ec37453e-7982-3a92-adfc-c9eb0df1751d",
                                                "text": "Paravent chinois. — Paravent d’étoffe, de tapisserie, de papier."
                                            },
                                            {
                                                "example_id": "1972e0f9-9d62-402b-8dbb-675135c1607f",
                                                "sense_id": "ec37453e-7982-3a92-adfc-c9eb0df1751d",
                                                "text": "Elle remarqua qu’il avait pris soin de cacher le lit derrière un de ces paravents à feuillets gaiement historiés."
                                            },
                                            {
                                                "example_id": "3692aea6-c51b-4854-a1d0-027e8a1d83d9",
                                                "sense_id": "ec37453e-7982-3a92-adfc-c9eb0df1751d",
                                                "text": "Dans les salles communes, quand approche la dernière heure, on entoure d’un paravent le lit du moribond ; il a vu ce paravent autour d’autres lits qui le lendemain étaient vides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5aa08d80-6c27-34ce-92dc-a9e57df46e59",
                                        "entry_id": "8846954a-db62-3d4a-8d18-5e06384ad7ef",
                                        "glosses": [
                                            "Panneau de bois servant de protection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59734416-8867-4522-8130-9f973e709dde",
                                                "sense_id": "5aa08d80-6c27-34ce-92dc-a9e57df46e59",
                                                "text": "La place des Taureaux de Cadix n’a pas de tablas continues. D’espace en espace sont disposées des espèces de paravents de bois derrière lesquels se retirent les toreros trop vivement poursuivis. Cette disposition nous paraît offrir moins de sûreté."
                                            },
                                            {
                                                "example_id": "7ec16f6a-9160-452b-8bd6-609124e7e828",
                                                "sense_id": "5aa08d80-6c27-34ce-92dc-a9e57df46e59",
                                                "text": "Ouvertures pour lancer des traits d’arbalète, fentes de mâchicoulis pour écraser l’ennemi avec des moellons, percées pour verser le plomb fondu et l’huile bouillante, escaliers trompeurs et sans issue pour engager l’ennemi dans une sorte de puits où pêle-mêle on l’accablera de traits, salles rondes de ralliement et de corps de garde, encoches dans la pierre pour insérer les paravents de bois qui garantissent les archers : l’amas des pierres et la complication des inventions militaires sont étonnants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cc6f421-eb5f-3efc-8f57-fd697dacf22c",
                                        "entry_id": "8846954a-db62-3d4a-8d18-5e06384ad7ef",
                                        "glosses": [
                                            "Ce qui protège, soit que l’on s’abrite derrière son autorité ou son influence, soit que l’on s’arrange pour faire tomber sur lui les reproches, les ennuis qu’on devrait supporter soi-même."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7db364cd-dd4a-40e4-b23f-9c95c6085fc3",
                                                "sense_id": "6cc6f421-eb5f-3efc-8f57-fd697dacf22c",
                                                "text": "Sa folie, je le crains, crèvera le paravent que je mettais entre le monde et nous…"
                                            },
                                            {
                                                "example_id": "77193ee5-f360-4f1c-ae93-1d99811c4039",
                                                "sense_id": "6cc6f421-eb5f-3efc-8f57-fd697dacf22c",
                                                "text": "Michel a vite persuadé la jeune femme de passer en sa compagnie une quinzaine dans le Midi, non loin d’une tante qui lui sert de paravent du côté des siens."
                                            },
                                            {
                                                "example_id": "78b51df2-9389-4480-963a-58306ac94f3c",
                                                "sense_id": "6cc6f421-eb5f-3efc-8f57-fd697dacf22c",
                                                "text": "En réalité, le sénat s’était moins inquiété des débordements sexuels des sectateurs que d’une vaste conjuration contre la domination de Rome sur l’Italie et à laquelle la secte bachique aurait servi de paravent."
                                            },
                                            {
                                                "example_id": "f92508d2-e71b-4876-aa41-9477907a3d36",
                                                "sense_id": "6cc6f421-eb5f-3efc-8f57-fd697dacf22c",
                                                "text": "Le ministère invoque une raison légitime, mais qui peut se transformer trop facilement en paravent commode : la protection des « renseignements commerciaux de nature confidentielle »."
                                            },
                                            {
                                                "example_id": "1c09a0a4-2537-4715-8458-26afa2773f46",
                                                "sense_id": "6cc6f421-eb5f-3efc-8f57-fd697dacf22c",
                                                "text": "Se servir de quelqu’un comme paravent."
                                            },
                                            {
                                                "example_id": "2488a840-194d-4347-968f-7303277fd04d",
                                                "sense_id": "6cc6f421-eb5f-3efc-8f57-fd697dacf22c",
                                                "text": "Chez les réactionnaires, l’écologie sert de paravent pour faire avancer leurs idées de toujours, à savoir la fermeture des frontières, le refus du métissage ou l’interdiction de l’avortement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbeeef69-1754-3982-8dd4-98f4b90fef2f",
                                        "entry_id": "8846954a-db62-3d4a-8d18-5e06384ad7ef",
                                        "glosses": [
                                            "Dans un amour illicite, personne sur qui on fait erronément porter les soupçons dans le but de mieux dissimuler la relation véritable. Syn. : chandelier."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
