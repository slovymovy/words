            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "20078247-e561-388d-ae57-2ce8dd787f7e",
                    "sense_definition": "Pronom personnel sujet ou tonique de la deuxième personne du pluriel, désignant un groupe de personnes à qui l'on s'adresse.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "pluriel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Est-ce que <w>vous</w> voulez venir avec nous au cinéma ce soir ?"
                        },
                        {
                            "text": "<w>Vous</w> êtes tous invités à la réunion de demain."
                        }
                    ],
                    "antonyms": [
                        "nous"
                    ],
                    "common_phrases": [
                        "vous deux",
                        "vous tous",
                        "entre vous"
                    ]
                },
                {
                    "sense_id": "17e4de50-3f45-31ac-afdd-fd57f1aafda4",
                    "sense_definition": "Pronom personnel de politesse utilisé pour s'adresser avec respect ou déférence à une seule personne.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Madame, <w>vous</w> avez oublié votre écharpe sur la chaise."
                        },
                        {
                            "text": "Est-ce que <w>vous</w> pouvez m'indiquer le chemin de la gare ?"
                        }
                    ],
                    "antonyms": [
                        "tu"
                    ],
                    "common_phrases": [
                        "chez vous",
                        "selon vous",
                        "pour vous"
                    ]
                },
                {
                    "sense_id": "5d5f1973-83f5-35b2-b09d-c559df366db3",
                    "sense_definition": "Pronom personnel complément d'objet direct ou indirect, ou réfléchi, de la deuxième personne du pluriel ou de politesse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "complement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur <w>vous</w> expliquera la leçon demain matin."
                        },
                        {
                            "text": "Mes amis, je <w>vous</w> attends devant le restaurant."
                        }
                    ],
                    "common_phrases": [
                        "je vous remercie",
                        "pour vous dire"
                    ]
                },
                {
                    "sense_id": "bc0ea150-5b38-3d77-8eca-8319b66d746a",
                    "sense_definition": "Pronom personnel employé avec une valeur indéfinie pour désigner les gens en général, quiconque ou une situation universelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "indefini",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand <w>vous</w> visitez un nouveau pays, il faut respecter les coutumes locales."
                        },
                        {
                            "text": "Dans cette situation difficile, <w>vous</w> ne savez jamais comment réagir."
                        }
                    ],
                    "synonyms": [
                        "on"
                    ]
                },
                {
                    "sense_id": "6250784b-ea7b-3d87-876c-a75d3e35b62d",
                    "sense_definition": "Pronom explétif ou datif d'intérêt employé pour rendre le discours plus vivant et solliciter l'attention de l'auditeur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "expletif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En deux minutes, il <w>vous</w> a réparé la machine sans aucune difficulté."
                        },
                        {
                            "text": "Cet enfant <w>vous</w> a une de ces énergies dès le matin !"
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "langage expressif et familier"
                        }
                    ]
                }
            ]
        }
