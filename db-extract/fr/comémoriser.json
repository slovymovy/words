                "senses": [
                    {
                        "sense_id": "8195f0bb-f8ba-38dd-ac26-8489de8e7c51",
                        "entry_id": "950f990e-b151-34b9-b1e7-998cd13d11fb",
                        "glosses": [
                            "Mémoriser ensemble, en même temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57b84c1a-752e-4b99-9a32-581c3a2065a2",
                                "sense_id": "8195f0bb-f8ba-38dd-ac26-8489de8e7c51",
                                "text": "En tant que signe séparé, le mot désigne autant ce qui apparaît présentement que sa profondeur toujours comémorisée."
                            },
                            {
                                "example_id": "a39f56b1-a662-4465-ae7d-0bf27dd3e9cd",
                                "sense_id": "8195f0bb-f8ba-38dd-ac26-8489de8e7c51",
                                "text": "Il ne peut y avoir organisation ni communication sans mémoire, car “organiser et communiquer c’est comémoriser”."
                            }
                        ]
                    }
