                        "examples": [
                            {
                                "example_id": "372f643c-75c6-40e3-9223-4589c44f159c",
                                "sense_id": "909bc945-dce2-3adb-817f-e2bd5d8fb7b3",
                                "text": "Wie ihre Schwester war sie als Methodistin aufgewachsen, hatte selbst jedoch seit Jahren keine Kirche mehr betreten."
                            },
                            {
                                "example_id": "c341527f-f7be-4466-ad60-5db63e3c7639",
                                "sense_id": "909bc945-dce2-3adb-817f-e2bd5d8fb7b3",
                                "text": "Als Methodistin galt für sie die strengere, methodischere Lebensführung nach biblischen Grundsätzen."
                            }
