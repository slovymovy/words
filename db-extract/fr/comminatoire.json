                                            {
                                                "example_id": "d70246bd-443d-49ec-841f-95a2f91167be",
                                                "sense_id": "5f5057d6-4596-3fce-92d6-cbe1e4e90c9b",
                                                "text": "Door de met politie-ingrijpen dreigende brieven liep de spanning verder op."
                                            },
                                            {
                                                "example_id": "3b6f925f-cd49-41e0-9b30-9024b14e4757",
                                                "sense_id": "5f5057d6-4596-3fce-92d6-cbe1e4e90c9b",
                                                "text": "Dreigend met een groot mes liep hij op mij af."
                                            },
                                            {
                                                "example_id": "40b2cc3b-19e7-42a5-bc90-522eb4795cc6",
                                                "sense_id": "5f5057d6-4596-3fce-92d6-cbe1e4e90c9b",
                                                "text": "Een volgende metershoge muur van water raasde alweer dreigend op hen af, donkerder dan de hen omringende nacht."
                                            },
                                            {
                                                "example_id": "4bfe1b8e-8d66-47b7-8f7d-5845a7fe87cd",
                                                "sense_id": "5f5057d6-4596-3fce-92d6-cbe1e4e90c9b",
                                                "text": "Maren torent krijtwit en dreigend boven haar uit en draait haar als een lappenpop naar zich toe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dreigend",
