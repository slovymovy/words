                    "sense_id": "12309cea-af5c-3cdb-80a6-f892b991134b",
                    "sense_definition": "Rumpled, tousled or untidy.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He walked into the room with <w>mussed</w> hair after sleeping on the train.",
                            "target_lang_translations": {
                                "cs": "Vstoupil do místnosti s <w>rozcuchanými</w> vlasy poté, co spal ve vlaku."
                            }
                        },
                        {
                            "text": "Her clothes were <w>mussed</w> from sitting in the cramped seat for hours.",
                            "target_lang_translations": {
                                "cs": "Její oblečení bylo <w>pomačkané</w> z toho, jak celé hodiny seděla ve stísněném sedadle."
                            }
                        }
                    ],
                    "synonyms": [
