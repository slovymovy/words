{
    "word_family": [
        "radiation",
        "radiator",
        "radial",
        "radiance",
        "radiant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20d871be-75d4-38fc-966e-c9de3b4305f1",
                    "sense_definition": "To extend or spread out from a central point.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spread",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many roads <w>radiate</w> from the city center like spokes on a wheel.",
                            "target_lang_translations": {
                                "nl": "Veel wegen <w>stralen uit</w> vanuit het stadscentrum als spaken van een wiel."
                            }
                        },
                        {
                            "text": "The hiking trails <w>radiate</w> from the main visitor center into the forest.",
                            "target_lang_translations": {
                                "nl": "De wandelpaden <w>stralen uit</w> vanaf het centrale bezoekerscentrum het bos in."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Zich vanuit een centraal punt uitbreiden of verspreiden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitstralen",
                                "target_lang_sense_clarification": "zich vanuit een middelpunt verspreiden"
                            },
                            {
                                "target_lang_word": "zich vertakken",
                                "target_lang_sense_clarification": "zich in verschillende richtingen uitbreiden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2adb681a-8d34-36f4-9214-5957adcfca87",
                    "sense_definition": "To emit energy in the form of rays or waves.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fireplace <w>radiates</w> warmth throughout the entire living room.",
                            "target_lang_translations": {
                                "nl": "De open haard <w>straalt</w> warmte <w>uit</w> door de hele woonkamer."
                            }
                        },
                        {
                            "text": "The sun <w>radiates</w> light and heat toward the earth.",
                            "target_lang_translations": {
                                "nl": "De zon <w>straalt</w> licht en warmte <w>uit</w> naar de aarde."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Energie uitzenden in de vorm van stralen of golven."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitstralen",
                                "target_lang_sense_clarification": "warmte, licht of energie afgeven"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a941b9c2-cf2f-3b4a-a2aa-e06c31a22573",
                    "sense_definition": "To show a strong emotion or quality clearly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "show",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>radiates</w> confidence whenever she walks into a room.",
                            "target_lang_translations": {
                                "nl": "Zij <w>straalt</w> zelfvertrouwen <w>uit</w> wanneer ze een kamer binnenkomt."
                            }
                        },
                        {
                            "text": "The bride <w>radiated</w> happiness on her wedding day.",
                            "target_lang_translations": {
                                "nl": "De bruid <w>straalde</w> geluk <w>uit</w> op haar trouwdag."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een sterke emotie of kwaliteit duidelijk laten zien."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "uitstralen",
                                "target_lang_sense_clarification": "een bepaalde eigenschap of emotie laten merken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2151422-5f5f-384a-ad34-cfd3264c9e7c",
                    "sense_definition": "To expose something to radiation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists <w>radiate</w> certain food products to kill harmful bacteria.",
                            "target_lang_translations": {
                                "nl": "Wetenschappers <w>bestralen</w> bepaalde voedingsmiddelen om schadelijke bacteriën te doden."
                            }
                        },
                        {
                            "text": "The medical team had to <w>radiate</w> the tumor to stop its growth.",
                            "target_lang_translations": {
                                "nl": "Het medische team moest de tumor <w>bestralen</w> om de groei ervan te stoppen."
                            }
                        }
                    ],
                    "synonyms": [
                        "irradiate"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets blootstellen aan straling."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bestralen",
                                "target_lang_sense_clarification": "blootstellen aan straling voor medische of wetenschappelijke doeleinden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ab139190-2d53-3a2e-b34b-815642bd21fa",
                    "sense_definition": "Having parts that spread out from a central point.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flower has a <w>radiate</w> pattern of petals.",
                            "target_lang_translations": {
                                "nl": "De bloem heeft een <w>straalsgewijs</w> patroon van bloemblaadjes."
                            }
                        },
                        {
                            "text": "The artist drew a <w>radiate</w> design on the paper.",
                            "target_lang_translations": {
                                "nl": "De kunstenaar tekende een <w>radiaal</w> ontwerp op het papier."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Met delen die zich vanuit een centraal punt verspreiden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "straalsgewijs",
                                "target_lang_sense_clarification": "in de vorm van stralen vanuit een middelpunt"
                            },
                            {
                                "target_lang_word": "radiaal",
                                "target_lang_sense_clarification": "geordend rondom een middelpunt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}