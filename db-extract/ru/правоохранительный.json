                                                "example_id": "8ab1816f-f326-45fc-8345-fc5416585999",
                                                "sense_id": "1d763a95-d508-3253-9fe2-abedea10eb8c",
                                                "text": "Another news report of law enforcement being corrupted–when does this end?"
