                "entry_id": "30320e5c-1fcb-3b5f-8e8e-95b5351f3bc5",
                "word": "bestest",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2a16c28b-9830-3245-9216-62776559bf00",
                        "entry_id": "30320e5c-1fcb-3b5f-8e8e-95b5351f3bc5",
                        "glosses": [
                            "best; the best of the best"
                        ],
                        "tags": [
                            "childish",
                            "humorous",
                            "informal",
                            "nonstandard"
                        ],
                        "examples": [
                            {
                                "example_id": "ef5535a2-57fc-4339-b8ee-72195fb945e9",
                                "sense_id": "2a16c28b-9830-3245-9216-62776559bf00",
                                "text": "It was the bestest teddy I ever had."
                            },
                            {
                                "example_id": "283fe61f-4feb-407f-a25b-32abb7bda1c2",
                                "sense_id": "2a16c28b-9830-3245-9216-62776559bf00",
                                "text": "You're my bestest friend in the whole world!"
                            },
                            {
                                "example_id": "b4e56e02-8f0b-4287-97c6-b59d15d929c6",
                                "sense_id": "2a16c28b-9830-3245-9216-62776559bf00",
                                "text": "\"Know that there have elapsed of this our day, which be Friday, and this Friday be the tenth of the month Safar in the six hundred and fifty-third year since the Hegira or Flight of the Apostle (on whom be the bestest of blessings and peace!)[.]"
                            },
                            {
                                "example_id": "3b5e64a7-f61e-4141-8319-b7b567302e13",
                                "sense_id": "2a16c28b-9830-3245-9216-62776559bf00",
                                "text": "Crickey, I'm about sprung. Tarnally dog gone my shins if this beent the bestest puttiest longbreak yet."
                            },
                            {
                                "example_id": "0b05a815-8863-4045-b23c-dd39e92701e5",
                                "sense_id": "2a16c28b-9830-3245-9216-62776559bf00",
                                "text": "I'm a Flavor Unit MC / And that means I'm one of the roughest, def-est, toughest, best-est"
                            },
                            {
                                "example_id": "0bc8841e-85f7-46cd-9bfc-fe92beed376c",
                                "sense_id": "2a16c28b-9830-3245-9216-62776559bf00",
                                "text": "I'm in his favorite sundress, watching me get undressed / Take that body downtown / I say, \"You da bestest,\" lean in for a big kiss"
                            },
                            {
                                "example_id": "2b35171f-8605-4280-9851-a28d049e1f7c",
                                "sense_id": "2a16c28b-9830-3245-9216-62776559bf00",
                                "text": "It had been the very bestest of bigly weekends. Two rounds of golf at his very own course in Turnberry."
                            }
                        ]
                    }
                ],
