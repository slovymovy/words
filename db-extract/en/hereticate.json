                        "sense_id": "b9c85917-3660-3287-9d87-3c48e80d7989",
                        "entry_id": "d1e6c5c2-18c9-315c-94e8-44b7ca1ab153",
                        "glosses": [
                            "To denounce as heresy or a heretic."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a590a3c6-3529-4e18-8204-9f7761c68d11",
                                "sense_id": "b9c85917-3660-3287-9d87-3c48e80d7989",
                                "text": "And let no one be minded, on the score of my neoterism, to hereticate me."
                            },
                            {
                                "example_id": "4d258932-182e-4ad5-a63a-94e7b72a29d8",
                                "sense_id": "b9c85917-3660-3287-9d87-3c48e80d7989",
                                "text": "If that great Chancellor of Paris were now alive, he would freely teach his Sorbonne, as he once did, that it is not in the Pope's power, that I may use his own word, to hereticate any proposition."
                            }
                        ]
                    }
