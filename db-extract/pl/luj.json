                    }
                ],
                "senses": [
                    {
                        "sense_id": "e254b0ed-4a1d-381b-9f2b-ab803fa96fe0",
                        "entry_id": "14a35498-d6c8-3d07-b9a6-266add6c55ec",
                        "glosses": [
                            "niechlujny, mocno zaniedbany mężczyzna budzący wstręt swoim wyglądem"
                        ],
                        "tags": [
                            "colloquial",
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "cd6cb76d-6e3b-406e-b528-d93033e7a8dc",
                                "sense_id": "e254b0ed-4a1d-381b-9f2b-ab803fa96fe0",
                                "text": "Na ławce leżał luj, a obok w wózku stał cały jego dobytek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "bc6ec887-c7b8-33bc-a325-a57b58272d77",
                        "entry_id": "14a35498-d6c8-3d07-b9a6-266add6c55ec",
                        "glosses": [
                            "chuligan, drobny przestępca, gw. (Poznań) łobuz, żul"
                        ],
                        "tags": [
                            "colloquial",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "0b445b20-8875-4a4b-ba1c-73021cf614d4",
                                "sense_id": "bc6ec887-c7b8-33bc-a325-a57b58272d77",
                                "text": "Boję się puszczać Bartka samego na plac zabaw, bo tam się kręcą jacyś luje."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "6cdee007-0932-3571-8e0a-3ce81dbf40d8",
                        "entry_id": "14a35498-d6c8-3d07-b9a6-266add6c55ec",
                        "glosses": [
                            "heteroseksualny mężczyzna będący obiektem pożądania homoseksualisty, często również zgadzający się na współżycie"
                        ],
                        "tags": [
                            "scornfully",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d9b99af5-d53d-4f55-b812-834f51b06c9a",
                                "sense_id": "6cdee007-0932-3571-8e0a-3ce81dbf40d8",
                                "text": "Studencik czytał mnie i znał mój stosunek do lujów, wiedział, że zawsze z nimi znajdę wspólny język, podobnie jak ze złodziejami i mafiosami, policjantami i tirowcami…"
                            },
                            {
                                "example_id": "35c17ddf-1c78-4402-ac95-0a0c2f0ebf8b",
                                "sense_id": "6cdee007-0932-3571-8e0a-3ce81dbf40d8",
                                "text": "Jeden policjant to był taki zajebisty luj, że wszystko przestało się dla mnie liczyć"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [],
                "word_linkages": [
