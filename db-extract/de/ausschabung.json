                "senses": [
                    {
                        "sense_id": "29706bc3-8d74-31d6-b28f-e25a1627280d",
                        "entry_id": "afc07f69-76d8-3c6e-95f6-76c00ee6fe9f",
                        "glosses": [
                            "operative Entfernung von Gewebe durch Abkratzen, Abschürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d1dcbf2-e72c-4783-88e1-d23f729c8fcc",
                                "sense_id": "29706bc3-8d74-31d6-b28f-e25a1627280d",
                                "text": "„Um Entzündungen und andere Komplikationen vermeiden, muss dann in der Regel eine Ausschabung vorgenommen werden.“"
                            },
                            {
                                "example_id": "d1254b9a-6687-49c6-8051-6ca89e486a40",
                                "sense_id": "29706bc3-8d74-31d6-b28f-e25a1627280d",
                                "text": "„Jetzt ist Schluss mit der Heilpraktikerei, da müssen Sie eine Ausschabung machen.“"
                            },
                            {
                                "example_id": "f91aeab5-ed39-465c-afbe-ac19789f9da9",
                                "sense_id": "29706bc3-8d74-31d6-b28f-e25a1627280d",
                                "text": "„Um Entzündungen und andere Komplikationen zu vermeiden, muss dann in der Regel eine Ausschabung vorgenommen werden.“"
                            },
                            {
                                "example_id": "7d85abfd-6aae-4f95-849c-d0f39eb43124",
                                "sense_id": "29706bc3-8d74-31d6-b28f-e25a1627280d",
                                "text": "„Das ist sicherlich ein Grund, warum Frauen sich für die Ausschabung entscheiden, statt abzuwarten.“"
                            },
                            {
                                "example_id": "f33ca9bc-b5c8-4e37-b861-a5dfe5993516",
                                "sense_id": "29706bc3-8d74-31d6-b28f-e25a1627280d",
                                "text": "„Die Ausschabung verlief völlig normal, und der Blutverlust war nur wenig höher als bei jeder anderen Fehlgeburt, die er schon erlebt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
