                    },
                    {
                        "sense_id": "53403d7a-47d7-39e2-9cab-d277805db3b5",
                        "entry_id": "b8faf38c-23ae-34b3-a108-acc3f52ee80c",
                        "glosses": [
                            "Lacking guidance or direction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7f4f70d-9937-42a7-9066-4586898aaa00",
                                "sense_id": "53403d7a-47d7-39e2-9cab-d277805db3b5",
                                "text": "Their deaths were sobering not merely because of the searingly unbearable wrench of losing those two wonderful people, but because it left me exposed as rudderless."
                            },
                            {
                                "example_id": "4ffd6909-6476-4363-a303-0d7abd26c738",
                                "sense_id": "53403d7a-47d7-39e2-9cab-d277805db3b5",
                                "text": "As Christian Wolmar said in RAIL 990, our railway is \"leaderless and rudderless\", and drifting inexorably towards the rocks of total chaos."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98911b58-840c-413a-86bb-753cd9c4f8c1",
                        "source_entry_id": "b8faf38c-23ae-34b3-a108-acc3f52ee80c",
                        "source_sense_description": "without a rudder, unsteerable, without guidance",
                        "target_lang_word": "roekeloos",
