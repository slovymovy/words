                    {
                        "sense_id": "083d980c-ee04-3deb-8dfe-0d2d85b742b9",
                        "entry_id": "b04a008c-54b0-3d05-9325-885a891b1db0",
                        "glosses": [
                            "kooktoestel, een combinatie kookplaat en oven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9774f35-bf53-415a-a583-d66fb590386c",
                                "sense_id": "083d980c-ee04-3deb-8dfe-0d2d85b742b9",
                                "text": "Bij die laatste schotel trek ik waarschijnlijk een bedenkelijk gezicht, want Yannis kijkt me quasi-ontstemd aan en troont me prompt mee naar het grote fornuis in zijn keuken."
                            },
                            {
                                "example_id": "86221417-6408-4de1-aeb5-e272a8f72b82",
                                "sense_id": "083d980c-ee04-3deb-8dfe-0d2d85b742b9",
                                "text": "Mama toverde een stralende glimlach op haar gezicht die heel vreemd overkwam in deze situatie, stelde ons voor als de nieuwe buren die er net in waren getrokken en vertelde dat het fornuis het niet meer deed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2c2abde-5146-471e-94c3-37b691f7aabc",
                        "source_entry_id": "b04a008c-54b0-3d05-9325-885a891b1db0",
                        "source_sense_id": "083d980c-ee04-3deb-8dfe-0d2d85b742b9",
