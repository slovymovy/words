                    {
                        "sense_id": "3caf06c5-a41b-3284-a126-cad8df1d3b6d",
                        "entry_id": "5f214b5a-d1e3-3ddb-90ef-f9fe0efc9ff8",
                        "glosses": [
                            "To spread over in a crossing pattern."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "28e79c68-143d-4b9b-b0bb-7779b6bbe85e",
                                "sense_id": "3caf06c5-a41b-3284-a126-cad8df1d3b6d",
                                "text": "Yet there they lie, all the highways and paths and trails, running out from before our very feet to overlace the earth, to carry us whither we will, with all their old allurement […]"
                            },
                            {
                                "example_id": "794ced26-d12c-41ad-a6cf-79a3d70fe9af",
                                "sense_id": "3caf06c5-a41b-3284-a126-cad8df1d3b6d",
                                "text": "Attendants to the bride, as of yet unidentified, were resplendently bedecked in a purple chiffon overlacing a delightful sheath of sheer orange burlap and satin that effectively accentuated the lovely pink tennis shoes."
                            }
                        ]
                    },
                    {
                        "sense_id": "8aefbbef-cc67-3e08-8b94-aa1be6fa6886",
                        "entry_id": "5f214b5a-d1e3-3ddb-90ef-f9fe0efc9ff8",
                        "glosses": [
                            "To lace excessively."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d366d4dd-72b9-48d0-8f28-668f5ae0517e",
                                "sense_id": "8aefbbef-cc67-3e08-8b94-aa1be6fa6886",
                                "text": "Do not leave sections to become travel stained. Do not overlace, the judge will think you are hiding something."
                            }
                        ]
