                ],
                "translations": [
                    {
                        "translation_id": "127d56ff-3a92-4990-afce-5cb706d68ef6",
                        "source_entry_id": "8f07fed7-a800-3116-90e0-4318e543ad6c",
                        "source_sense_id": "6fb0c846-5e65-36dd-b44a-0d4118cb96a0",
                        "target_lang_word": "refroidir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refroidir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9089d8f3-52ac-3395-8187-1895c42327bd",
                                        "entry_id": "801fc929-cd74-3d75-a688-06ec93c4a524",
                                        "glosses": [
                                            "Rendre froid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f4730a-9dad-4738-9d6c-9f0eddac49cb",
                                                "sense_id": "9089d8f3-52ac-3395-8187-1895c42327bd",
                                                "text": "Le blé pulvérisé entre les meules, ou la boulange, s’échauffe sous l’action des meules, et il est essentiel de le refroidir le plus rapidement possible."
                                            },
                                            {
                                                "example_id": "2504385f-2e9f-4808-8d12-f811c6811ec4",
                                                "sense_id": "9089d8f3-52ac-3395-8187-1895c42327bd",
                                                "text": "Le vent, la pluie a refroidi l’air."
                                            },
                                            {
                                                "example_id": "11acbb61-cbbe-4062-b41b-df238f784054",
                                                "sense_id": "9089d8f3-52ac-3395-8187-1895c42327bd",
                                                "text": "Les climatiseurs réchauffent la planète. Ils réchauffent aussi l'environnement proche, de par leur système même de refroidissement. Pour refroidir l'intérieur des pièces, ils recrachent de l'air chaud (et parfois l'humidité) à l'extérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf35e23b-0552-3cc7-aa85-80d8c78eee77",
                                        "entry_id": "801fc929-cd74-3d75-a688-06ec93c4a524",
                                        "glosses": [
                                            "Prendre froid."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75667975-97be-40b7-8f85-d0f9bb730c3d",
                                                "sense_id": "bf35e23b-0552-3cc7-aa85-80d8c78eee77",
                                                "text": "Il s’est refroidi en sortant du théâtre."
                                            },
                                            {
                                                "example_id": "49864eb8-08f7-4d30-a0db-8573d3173480",
                                                "sense_id": "bf35e23b-0552-3cc7-aa85-80d8c78eee77",
                                                "text": "Je me suis refroidi à rester trop longtemps dans le jardin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faca60c2-e1d1-3405-9a40-628bc033f554",
                                        "entry_id": "801fc929-cd74-3d75-a688-06ec93c4a524",
                                        "glosses": [
                                            "Diminuer l’ardeur, l’activité, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05a1832d-3da6-46be-8c87-df540f1e1ead",
                                                "sense_id": "faca60c2-e1d1-3405-9a40-628bc033f554",
                                                "text": "Il avait bien de l’ardeur pour cette affaire, mais ce qui est arrivé l’a beaucoup refroidi."
                                            },
                                            {
                                                "example_id": "9f4cc1a6-86bb-4efe-8c78-86e8c532d890",
                                                "sense_id": "faca60c2-e1d1-3405-9a40-628bc033f554",
                                                "text": "La vieillesse refroidit les passions."
                                            },
                                            {
                                                "example_id": "aad57a37-078d-4c2d-9813-2da90ad395fa",
                                                "sense_id": "faca60c2-e1d1-3405-9a40-628bc033f554",
                                                "text": "Il faut laisser refroidir sa colère."
                                            },
                                            {
                                                "example_id": "35975661-80b0-4f7d-bba8-c9d1eb42d32e",
                                                "sense_id": "faca60c2-e1d1-3405-9a40-628bc033f554",
                                                "text": "Il commença à se refroidir sur la proposition qu’on lui faisait."
                                            },
                                            {
                                                "example_id": "1933a454-38fd-4254-8e76-03c3ba218a23",
                                                "sense_id": "faca60c2-e1d1-3405-9a40-628bc033f554",
                                                "text": "Le Lambert en question ne laissa pas refroidir la conversation : — Alors, Beauharnais, qu’il me fait, c’est comme ça qu’on s’amuse à cambrioler les villas du Havre  ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90461d3b-5d7b-39a9-87b4-94b420b7066e",
                                        "entry_id": "801fc929-cd74-3d75-a688-06ec93c4a524",
                                        "glosses": [
                                            "Tuer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be33ab85-0235-4aa7-9505-946d6710d308",
                                                "sense_id": "90461d3b-5d7b-39a9-87b4-94b420b7066e",
                                                "text": "Ainsi « s’faire refroidir », qu’on servait à l’époque, ça s’emploie plus. Maintenant on dit : « ratatiner ». Vous voyez le mec par terre, qui s’rétrécit."
                                            },
                                            {
                                                "example_id": "3d55befb-cf45-480d-9a31-ab3623a9006b",
                                                "sense_id": "90461d3b-5d7b-39a9-87b4-94b420b7066e",
                                                "text": "C’est lui qui a refroidi le frère. Vous trouverez bien un moyen de le poisser sans parler de la môme."
                                            },
                                            {
                                                "example_id": "2702c8cd-ace4-4ce7-af6e-62fbeeaeaee0",
                                                "sense_id": "90461d3b-5d7b-39a9-87b4-94b420b7066e",
                                                "text": "— J’viens d’décarrer, Dussèche. J'ai tiré dix berges pour avoir refroidi ma belledoche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b41f654-1737-348f-8c22-3f5cd6c3ff66",
                                        "entry_id": "801fc929-cd74-3d75-a688-06ec93c4a524",
                                        "glosses": [
                                            "Devenir froid."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74cdc29a-2ec1-4e41-b22f-ac62dd9b7b77",
                                                "sense_id": "4b41f654-1737-348f-8c22-3f5cd6c3ff66",
                                                "text": "Il fit oui-oui, de la tête, revint au lit, se pencha : le cadavre refroidissait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
