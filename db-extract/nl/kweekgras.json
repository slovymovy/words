                    {
                        "sense_id": "1b333a29-3188-3a93-b45b-32ad6d0c95b1",
                        "entry_id": "d432b8d6-35e9-3307-9536-821a5027585d",
                        "glosses": [
                            "Elytrigia een geslacht uit de grassenfamilie (Poaceae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec0ba624-36e5-4526-b4a7-bc7f1f137a35",
                                "sense_id": "1b333a29-3188-3a93-b45b-32ad6d0c95b1",
                                "text": "«Ja, ik moet het mij duidelijk zien te maken en het doordenken», dacht hij, terwijl hij strak naar het welige gras keek dat vlak voor hem stond en de bewegingen volgde van een groen kevertje, dat langs een halm van het kweekgras naar boven klom en hierbij werd gehinderd door een blad van een wol bal."
                            },
                            {
                                "example_id": "5be9dd00-dc11-4eaa-a330-de47f2d96019",
                                "sense_id": "1b333a29-3188-3a93-b45b-32ad6d0c95b1",
                                "text": "Glyfosaat is een relatief goedkope en bijzonder effectieve onkruidverdelger. Zelfs het hardnekkigste onkruid legt het loodje. Volgens boeren is het uitermate effectief tegen kweekgras en hoefblad, vervelende wortel-onkruiden."
                            }
                        ]
                    }
