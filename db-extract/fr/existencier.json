                "senses": [
                    {
                        "sense_id": "6a137798-88a5-3ac7-aee0-03a883c51ab9",
                        "entry_id": "ab1e8de9-1253-3266-8106-4cd76ab38f25",
                        "glosses": [
                            "Donner une existence à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87cb629c-8f89-490e-b984-bc7a76dd66f5",
                                "sense_id": "6a137798-88a5-3ac7-aee0-03a883c51ab9",
                                "text": "Muhammad est la forme de la miséricorde que Dieu S’est prescrite dans l’éternité sans commencement pour existencier les êtres."
                            },
                            {
                                "example_id": "8045c5d9-6858-46bf-b199-3544e960889d",
                                "sense_id": "6a137798-88a5-3ac7-aee0-03a883c51ab9",
                                "text": "Car existencier c’est donner l’existence, nécessiter c’est donner la nécessité."
                            },
                            {
                                "example_id": "6ea92348-9034-40aa-8207-510816b14bd4",
                                "sense_id": "6a137798-88a5-3ac7-aee0-03a883c51ab9",
                                "text": "Il est plus agréable de copuler derrière les « est », de brûler des essences, d’observer des accidents, de collectionner des attributs, d’étantiser des hic et nunc, d’existencier des états d’âme, de sémantiser des phonèmes…"
                            }
                        ]
                    }
