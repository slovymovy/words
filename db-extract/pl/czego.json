                                        ],
                                        "examples": [
                                            {
                                                "example_id": "430e7624-6ba4-4981-bfcf-964d16823170",
                                                "sense_id": "9c373c00-9934-30cc-88ed-5b940fe95d4d",
                                                "text": "Ich habe verschlafen, weshalb ich meinen Zug verpasst habe."
                                            },
                                            {
                                                "example_id": "3b2273f6-773a-46d6-90d5-641e382830a0",
                                                "sense_id": "9c373c00-9934-30cc-88ed-5b940fe95d4d",
                                                "text": "Er schrie sie an, weshalb sie das Zimmer verließ."
                                            }
