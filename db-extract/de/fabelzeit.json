                ],
                "senses": [
                    {
                        "sense_id": "5b5a6c44-e657-3183-9c07-3913c3e61ec7",
                        "entry_id": "4151e993-594d-322d-86b6-b028f9936017",
                        "glosses": [
                            "längst vergangene (und sagenhaft anmutende) Zeit"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5116fa95-e8ee-4ca5-9a71-ebc639cfbe73",
                                "sense_id": "5b5a6c44-e657-3183-9c07-3913c3e61ec7",
                                "text": "„Der Ursprung der Stadt verliert sich in die Fabelzeit; das erfreuliche Lokal mag früh genug Anbauende hierher gelockt haben.“"
                            },
                            {
                                "example_id": "8319ba9b-068f-4587-8b3c-80da1432c785",
                                "sense_id": "5b5a6c44-e657-3183-9c07-3913c3e61ec7",
                                "text": "„Ach! all die Recken der Fabelzeit",
                                "translation": "Sind gegen ihn nur ein’ Kleinigkeit“"
                            },
                            {
                                "example_id": "31f1796e-69cc-4c17-81e9-c35c384352b8",
                                "sense_id": "5b5a6c44-e657-3183-9c07-3913c3e61ec7",
                                "text": "„Ich wiederholte, ordnete und ergänzte alle nur zu diesem Zwecke dienliche Erkenntnis; neben allen Modernen, welche diese Sage außer dem meist vortrefflichen Musäus mit schlechtem Glücke bearbeitet, las ich auch noch den belebten Kosmas, der, ich weiß nicht, ob in aller Unschuld oder in heiterer gelehrter Ironie, diese böhmische Fabelzeit mit auf seine Weise eleganter Latinität behandelt.“"
                            },
                            {
                                "example_id": "14bb4256-73d3-4648-b0b3-dfa6f521f769",
                                "sense_id": "5b5a6c44-e657-3183-9c07-3913c3e61ec7",
                                "text": "„‚Ach, es iſt der Sitz der Liebe,",
                                "translation": "Aus den alten Fabelzeiten.‘“"
                            },
                            {
                                "example_id": "b0b932cc-f027-4331-97d2-4d628f12e658",
                                "sense_id": "5b5a6c44-e657-3183-9c07-3913c3e61ec7",
                                "text": "„Weil einſt vielleicht in grauer Fabelzeit",
                                "translation": "Dein heilig, Gnade ſtroͤmend Antlitz wendet.“"
                            },
                            {
                                "example_id": "93d0d34a-f60b-446d-a1c8-6b0c4ea7ec9d",
                                "sense_id": "5b5a6c44-e657-3183-9c07-3913c3e61ec7",
                                "text": "„In jenem Hauſe, das noch mit weitläufigen Treppen und Gängen verſehen war, fiel ihm ſeit einiger Zeit bei Ausgang und Rückkehr eine Dienſtmagd auf von ſo herrlichem Wuchs und Gang, daß das ärmliche, obgleich ſaubere Kleid das Gewand eines Königskindes aus alter Fabelzeit zu ſein ſchien.“"
                            },
                            {
                                "example_id": "72fd15f9-c4ed-4180-8c1f-ff5ede204a4b",
                                "sense_id": "5b5a6c44-e657-3183-9c07-3913c3e61ec7",
                                "text": "„Auch in das engste Leben der Einzelnen greifen, störend oder fördernd, die Heroen ein, wie einst in der Fabelzeit die Götter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
