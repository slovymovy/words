                        "examples": [
                            {
                                "example_id": "e17770cb-90dc-4e78-a167-c8a1978d51f0",
                                "sense_id": "5b224743-de10-3140-920a-4be5279d9cbb",
                                "text": "Je baisai la main ornée que Clothilde me tendit et gratifiai Louis-Pierre d’un vigoureux shake-hand."
                            },
                            {
                                "example_id": "eb35071b-78c1-4340-a54d-58f74e3955e0",
                                "sense_id": "5b224743-de10-3140-920a-4be5279d9cbb",
                                "text": "Mais le prince l'arrêta net d'un vigoureux shake-hand."
                            },
                            {
                                "example_id": "b73c3b66-db61-4865-9f88-1b17544253ef",
                                "sense_id": "5b224743-de10-3140-920a-4be5279d9cbb",
                                "text": "Télémaque, sur l'ordre de Mary, apporta tout ce qu'il put trouver de vin de Champagne et de petits gâteaux, et Montaret fut enfin remis a terre, après quoi ce furent des shake-hands à n'en plus finir."
                            }
                        ]
                    }
