                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f01f5ae-47ed-4138-8229-3b0ff6ae98b2",
                                "sense_id": "d531ef18-c6bc-3d62-916a-74d6aea97489",
                                "text": "Mes parents parlaient le gbaya, m’a-t-il dit. Je suis né dans l’ouest du pays. Mon père, qui était commerçant, connaissait le sango."
                            },
                            {
                                "example_id": "55817644-bb5c-499c-a8e2-4d40e7dcdd06",
                                "sense_id": "d531ef18-c6bc-3d62-916a-74d6aea97489",
                                "text": "Les autres populations de l’Adamaoua et de ses alentours parlent des langues adamaoua-oubanguiennes telles que le gbaya et le mboum, également présentes en République centrafricaine."
                            }
                        ]
