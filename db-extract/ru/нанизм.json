                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nanismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48a94da3-7968-3636-b5c6-ff916856e4d9",
                                        "entry_id": "5b4cc8e3-d990-37d3-8650-5186f6a01461",
                                        "glosses": [
                                            "anormales, deutlich vermindertes Längenwachstum bei Mensch und Tier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8f09b61-bfed-48bd-bd76-83cebcc2bd5a",
                                                "sense_id": "48a94da3-7968-3636-b5c6-ff916856e4d9",
                                                "text": "„Wir kommen nun zur letzten Kategorie der Defekte, zum Nanismus oder den Zwergbildungen. Es handelt sich hier um die Nichterreichung der normalen Größe eines Tieres in dem Alter, wo diese erreicht werden sollte, ohne daß besondere andere Mißbildungen an dem Körper auftreten müßten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3cf7fa44-8809-3e9c-85bb-5eabec81b855",
                                        "entry_id": "5b4cc8e3-d990-37d3-8650-5186f6a01461",
                                        "glosses": [
                                            "die Verzwergung bzw. der Zwergwuchs als evolutionäre Anpassung von Arten oder Rassen einer Art"
                                        ],
                                        "tags": [
                                            "Evolutionsbiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f053de2-e5c2-4fe2-989a-1e44e9c25a5d",
                                                "sense_id": "3cf7fa44-8809-3e9c-85bb-5eabec81b855",
                                                "text": "„Die P. äußern sich in Mißbildungen, Wucherungen, Überwallungen, Vergrünungen, Krauswerden, Verwelken, Vertrocknen der Blätter, Verfaulen der Wurzeln, Vergeilung, krankhaftem Zwergwuchs (Nanismus), Absterben der ganzen Pflanze u.a.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
