                    {
                        "sense_id": "4494aa39-5a40-312d-b2eb-45d7b48ca858",
                        "entry_id": "14373aad-2bbe-3971-a7c9-102231382a19",
                        "glosses": [
                            "jener Spieler, der bei einem Stich die letzte Karte ausspielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2817cb0b-0e77-415d-bc4a-c1d798d83da8",
                                "sense_id": "4494aa39-5a40-312d-b2eb-45d7b48ca858",
                                "text": "„Wenn sie reizen möchte, muss Hinterhand im vorliegenden Fall das Reizen mit »20« beginnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eff24db4-0db6-30ae-81ce-904e444201a2",
                        "entry_id": "14373aad-2bbe-3971-a7c9-102231382a19",
                        "glosses": [
                            "hinterer Körperteil des Pferdes oder Hundes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52823fca-d62b-44cb-b72b-cb3a1a0dd747",
                                "sense_id": "eff24db4-0db6-30ae-81ce-904e444201a2",
                                "text": "„Die optimale Winkelung der Hinterhand wird durch den Winkel des Beckens mit der Horizontalen und den Winkeln, die das Kniegelenk und das Sprunggelenk bilden, definiert.“"
                            },
                            {
                                "example_id": "8ba46e77-406a-41e9-a35e-70bf6e801223",
                                "sense_id": "eff24db4-0db6-30ae-81ce-904e444201a2",
                                "text": "„Auf die Hinterhand gelehnt, gleitend, trugen die Pferde ihre Reiter talab.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
