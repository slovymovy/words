                        "source_entry_id": "888079eb-818a-3f60-b977-5e743505d8ce",
                        "source_sense_id": "8a2fcc9e-ea55-3877-9b1e-d42d8121019c",
                        "source_sense_description": "van iets dat het niet overeenkomt met het klassieke beeld wat sommige mensen over vrouwen hebben of hadden",
