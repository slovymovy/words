                        "entry_id": "4ce3ca8a-45b0-345d-b272-d2f6fd915fde",
                        "glosses": [
                            "A game in which each player acts out a word or phrase, usually based on puns of each syllable and without speaking, for the others to guess."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7a2750d5-b3cd-4e86-834b-c54db6c9a919",
                                "sense_id": "4e07d3f4-318d-3968-badf-4bcaf08f8698",
                                "text": "[…] it looked like a house where they played charades, where there would be long streamers of evergreen and dozens of wreaths of holly at Christmas-time, where there were tearful, happy weddings and great throwings of rice after little brides […]"
                            }
                        ]
                    }
