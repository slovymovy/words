                },
                {
                    "sense_id": "6eb8f91f-38a0-34a3-8c5f-6adc83d5fecb",
                    "sense_definition": "Used to emphasize that something is complete, total, or extreme.",
                    "learner_level": "C2",
                    "frequency": "Middle",
                    "semantic_group_id": "extreme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was an <w>abject</w> failure because no one followed the instructions properly.",
                            "target_lang_translations": {
                                "ru": "Проект обернулся <w>полным</w> провалом, потому что никто должным образом не следовал инструкциям."
                            }
                        },
                        {
                            "text": "The children were in <w>abject</w> terror when the storm suddenly knocked out all the lights.",
                            "target_lang_translations": {
                                "ru": "Дети пришли в <w>панический</w> ужас, когда буря внезапно вырубила всё электричество."
                            }
                        }
                    ],
                    "synonyms": [
                        "utter",
                        "complete",
                        "total"
                    ],
                    "common_phrases": [
                        "abject failure",
                        "abject terror",
                        "abject nonsense"
                    ],
                    "target_lang_definitions": {
