                        "examples": [
                            {
                                "example_id": "3e6577ba-4b1b-4950-bb3a-e3c48fdf7d07",
                                "sense_id": "49e65fea-2a3d-34ef-8b6a-2bac2bcf0156",
                                "text": "Le métiveur (le moissonneur), sous le soleil de juillet qui lui tombe d’aplomb sur les reins, a des rêves plus hardis et comme chauffés par la grande lumière de midi."
                            },
                            {
                                "example_id": "0d5dc410-b636-4fe5-aeab-8ffebb183e7b",
                                "sense_id": "49e65fea-2a3d-34ef-8b6a-2bac2bcf0156",
                                "text": "Il y avait dans la Maison une grange pour battre le blé, un métiveur, un relieur de tonneaux, huit chevaux et les charrettes, plus un bidet pour l’homme d’affaires, sept vaches et 24 porcs."
                            }
                        ]
                    }
