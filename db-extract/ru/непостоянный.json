                                        "examples": [
                                            {
                                                "example_id": "7dd5941d-8e31-4825-ba5d-32b1a459e4ff",
                                                "sense_id": "71632446-ae3a-3eeb-97d2-5f27b27f5574",
                                                "text": "O Fortune, Fortune, all men call thee fickle, / If thou art fickle, what doſt thou with him / That is renown'd for faith? be fickle Fortune: / For then I hope thou wilt not keepe him long, / But ſend him backe."
                                            },
                                            {
                                                "example_id": "2e2e51c9-8a0a-4e4f-8aa2-eac52c2d75ef",
                                                "sense_id": "71632446-ae3a-3eeb-97d2-5f27b27f5574",
                                                "text": "Still onward winds the dreary way;\n⁠I with it; for I long to prove\n⁠No lapse of moons can canker Love,\nWhatever fickle tongues may say."
                                            },
                                            {
                                                "example_id": "2794d9f0-aff5-45fe-a567-a75ae92e0574",
                                                "sense_id": "71632446-ae3a-3eeb-97d2-5f27b27f5574",
                                                "text": "As night has such a local ring / And love and rock are fickle things"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd66bf55-277d-3fd0-9295-60db8b025292",
                                        "entry_id": "375f83dc-9db8-31b0-a7a2-65b85e66ebc2",
