                                    },
                                    {
                                        "sense_id": "0ac738be-16f7-336e-adf9-201422445330",
                                        "entry_id": "dbe818eb-4800-30f3-ac0e-6942f748768d",
                                        "glosses": [
                                            "Vibration."
