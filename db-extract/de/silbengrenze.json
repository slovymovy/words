                "senses": [
                    {
                        "sense_id": "8c596cad-b377-3394-b866-5cc76e25bb54",
                        "entry_id": "94365a6f-f13a-338f-9e07-4268ce336d72",
                        "glosses": [
                            "Linguistik, speziell Phonetik: Anfang und/oder Ende einer Silbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9faba02f-b89b-4f03-826e-5d7690098356",
                                "sense_id": "8c596cad-b377-3394-b866-5cc76e25bb54",
                                "text": "„Schwierigkeiten bestehen insbesondere bei der Festlegung der Silbengrenzen und der Bestimmung wortübergreifender Silbenbildung.“"
                            },
                            {
                                "example_id": "53fa95b6-eaeb-4245-8650-e592f18b38cc",
                                "sense_id": "8c596cad-b377-3394-b866-5cc76e25bb54",
                                "text": "„Silbengrenzen sind nicht durch spezielle lautliche Mittel markiert, sondern sie ergeben sich aus der Struktur der benachbarten Silben.“"
                            },
                            {
                                "example_id": "3d62f03a-101d-4486-8276-6ab440617ebf",
                                "sense_id": "8c596cad-b377-3394-b866-5cc76e25bb54",
                                "text": "„Zur Bestimmung der Silbenlängen werden die Silbengrenzen im Text markiert.“"
                            },
                            {
                                "example_id": "a7276d1a-b2b8-4be2-bdfd-774ec0fcceef",
                                "sense_id": "8c596cad-b377-3394-b866-5cc76e25bb54",
                                "text": "„Es ist jedoch zu beobachten, dass nicht immer die eigentliche Aussprache der Silbe Schwierigkeiten bereitet, sondern vor allem das Überwinden der Silbengrenzen (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
