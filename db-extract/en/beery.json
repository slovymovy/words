                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aebec401-1fe6-4851-97fe-bdb1768ad7b0",
                        "source_entry_id": "b284e2f9-bfec-3b26-a734-84a4a7755695",
                        "source_sense_description": "smelling or tasting of beer",
                        "target_lang_word": "načichlý pivem",
