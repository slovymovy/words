                "senses": [
                    {
                        "sense_id": "32695aac-7cf5-3da7-a31e-4b2ddc0fd14e",
                        "entry_id": "90a44ba4-003e-3b8e-a7b5-55ae6e9515de",
                        "glosses": [
                            "Einzelglied einer Knoblauchknolle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcc9cba7-b574-4a59-819a-d3338ad081b1",
                                "sense_id": "32695aac-7cf5-3da7-a31e-4b2ddc0fd14e",
                                "text": "Da ich gelegentlich gerne 3 bis 4 Knoblauchzehen und eine halbe Zwiebel für meine Gesundheit esse, bin ich zwar gesund, aber eine Weile einsam."
                            },
                            {
                                "example_id": "0016bc14-70b8-4b1a-9c43-048927fdb6e1",
                                "sense_id": "32695aac-7cf5-3da7-a31e-4b2ddc0fd14e",
                                "text": "Zum Gericht müssen zwei Knoblauchzehen kleingehackt werden."
                            },
                            {
                                "example_id": "032f66e2-0150-4d1a-95ab-8848100037ee",
                                "sense_id": "32695aac-7cf5-3da7-a31e-4b2ddc0fd14e",
                                "text": "„Dann schnitten sie mehrere Knoblauchzehen in kleine Scheiben und brieten sie goldgelb an.“"
                            },
                            {
                                "example_id": "ec2d341a-db2e-49f2-85a0-974479b177c3",
                                "sense_id": "32695aac-7cf5-3da7-a31e-4b2ddc0fd14e",
                                "text": "„An diesem Tag im neuen Jahr hatte er Knoblauchzehen in das Fleisch gesteckt und den Braten mit einer Mischung aus geriebener Zitronenschale, Thymian, Rosmarin und Oregano bestrichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
