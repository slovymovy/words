                "entry_id": "6e60da98-6450-327f-8f95-a7516a781030",
                "word": "buigtang",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "95987850-2b05-49a0-b6b1-fe81887d79ba",
                        "entry_id": "6e60da98-6450-327f-8f95-a7516a781030",
