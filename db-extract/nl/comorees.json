                    {
                        "translation_id": "9a31aa67-68a7-4745-900b-57df23e681bd",
                        "source_entry_id": "23a6d5ef-4d3e-31ee-90da-08021d048638",
                        "source_sense_id": "def3812e-572c-30aa-b01d-826cfb9abeb4",
