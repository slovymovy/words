                "senses": [
                    {
                        "sense_id": "5252a759-c1e7-3347-b2d9-34a10dc26b15",
                        "entry_id": "685ade32-534d-395b-b1b4-b9583407e3b6",
                        "glosses": [
                            "na een tijdelijke teruggang weer goed gaan presteren"
                        ],
                        "tags": [
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "1f138a4d-81aa-435b-b301-cf4b22f93b62",
                                "sense_id": "5252a759-c1e7-3347-b2d9-34a10dc26b15",
                                "text": "Het Nederlandse elftal wist zich na een aantal nederlangen goed te herpakken."
                            },
                            {
                                "example_id": "2305311d-08ba-487e-8a3b-5c6701f1a150",
                                "sense_id": "5252a759-c1e7-3347-b2d9-34a10dc26b15",
                                "text": "Ze zag eruit alsof ze een klap om haar oren had gekregen en ik had er meteen enorm veel spijt van. Maar als de Lauritzen die ze was herpakte ze zich snel en herhaalde de truc van het aansteken van een sigaret."
                            }
                        ]
                    }
