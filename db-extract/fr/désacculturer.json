                "senses": [
                    {
                        "sense_id": "8558c635-38e0-38c4-9df3-55402c1492e0",
                        "entry_id": "c9f4d106-2775-3469-944b-407b9505b1ae",
                        "glosses": [
                            "Faire en sorte que quelqu’un ne soit plus acculturé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b642ac82-3e5b-4a76-a182-cf2528e9189b",
                                "sense_id": "8558c635-38e0-38c4-9df3-55402c1492e0",
                                "text": "'La première explication, c’est que nous (la théologie, la pastorale, l’Eglise) avons désacculturé ces agents de pastorale. — (Projet de société et lectures chrétiennes, actes du congrès 1996 de la Société canadienne de théologie, sous la direction de Camil Ménard et Florent Villeneuve)"
                            },
                            {
                                "example_id": "bf205599-b83b-47c3-a67f-984607402233",
                                "sense_id": "8558c635-38e0-38c4-9df3-55402c1492e0",
                                "text": "'Elle se désacculture, adhère à l’irruption jaillissante que l’Occident a refoulé pour exister. — (Serge Valdinoci, La science première : une pensée pour le présent et l’avenir, 1997, page 26)"
                            }
                        ]
                    }
