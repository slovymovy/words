                },
                {
                    "sense_id": "d374a70c-6542-3b92-94f2-170179d9134a",
                    "sense_definition": "jednostka gospodarcza zajmująca się produkcją, sprzedażą lub świadczeniem usług",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój wujek od wielu lat prowadzi mały <w>zakład</w> stolarski.",
                            "target_lang_translations": {
                                "ru": "Мой дядя уже много лет держит небольшую столярную <w>мастерскую</w>."
                            }
                        },
                        {
                            "text": "Nowy <w>zakład</w> produkcyjny zatrudni ponad dwustu wykwalifikowanych pracowników.",
                            "target_lang_translations": {
                                "ru": "Новый производственный <w>завод</w> трудоустроит более двухсот квалифицированных рабочих."
                            }
