    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c5a7beb4-d237-3f5a-bc41-891c31e0a0ef",
                "word": "clouted",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a23db117-0f71-40de-b7d0-b1eef98b9b29",
                        "entry_id": "c5a7beb4-d237-3f5a-bc41-891c31e0a0ef",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more clouted"
                    },
                    {
                        "form_id": "ab7605cc-e736-490e-bf4e-5d516f412173",
                        "entry_id": "c5a7beb4-d237-3f5a-bc41-891c31e0a0ef",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most clouted"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c030c609-8cbf-31b9-9cf6-86c23328db15",
                        "entry_id": "c5a7beb4-d237-3f5a-bc41-891c31e0a0ef",
                        "glosses": [
                            "Clotted; coagulated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a2799a9-d895-409b-958f-b82e3e53a039",
                                "sense_id": "c030c609-8cbf-31b9-9cf6-86c23328db15",
                                "text": "I've seen her skim the clouted cream, And press from spongy curds the milky stream."
                            },
                            {
                                "example_id": "1ab0e467-a884-4466-b2f8-66490de52975",
                                "sense_id": "c030c609-8cbf-31b9-9cf6-86c23328db15",
                                "text": "If the praise of Herefordshire cider, and Oxford ale, deserve to be sung in Miltonic verse, the Clouted Cream of Cornwall puts in still more substantial claims to the notice of the lofty muse. Devonshire had regaled us with this delicious article, before we reached Cornwall, but as we had tasted the clouted cream of the latter, accompanied by the excellent coffee which we found at every inn throughout the county, we acknowledge it was only here that this production could be had in perfection."
                            },
                            {
                                "example_id": "31245f5b-d2cc-4d45-8f7f-38aeb3fd8672",
                                "sense_id": "c030c609-8cbf-31b9-9cf6-86c23328db15",
                                "text": "So there are two or three little matters which seem to connect Tyre and its neighbourhood with the clouted cream of Devonshire."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed16be26-5fc4-31c9-954e-8ceef0949393",
                        "entry_id": "c5a7beb4-d237-3f5a-bc41-891c31e0a0ef",
                        "glosses": [
                            "Patched; roughly mended."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5d606ad-0ded-4e16-9542-75eae091852d",
                                "sense_id": "ed16be26-5fc4-31c9-954e-8ceef0949393",
                                "text": "I thought he slept, and put My clouted brogues from off my feet, whose rudeness Answer'd my steps too loud."
                            },
                            {
                                "example_id": "7e54a8cb-a391-4a91-97e5-bffd9988c00c",
                                "sense_id": "ed16be26-5fc4-31c9-954e-8ceef0949393",
                                "text": "His gown was greasier, and his cloke was meaner; His shoes were still more clouted, nor were cleaner."
                            },
                            {
                                "example_id": "9c493360-a5e4-429e-9dd9-0c0bc6a0ca27",
                                "sense_id": "ed16be26-5fc4-31c9-954e-8ceef0949393",
                                "text": "A clouted cloak about him was, That held him frae the cauld; The thinnest bit of it, I guess, Was more than twenty fauld."
                            },
                            {
                                "example_id": "8b38c7a9-9ae2-496b-8713-046e0e26834e",
                                "sense_id": "ed16be26-5fc4-31c9-954e-8ceef0949393",
                                "text": "As it is our bones have been so basted, that we shall never like to look at either a clouted cloak or a pikestaff as long as we live."
                            },
                            {
                                "example_id": "93b4536f-f566-406b-919e-a45a2f7b5c17",
                                "sense_id": "ed16be26-5fc4-31c9-954e-8ceef0949393",
                                "text": "Before him lay the fragments of a small wooden tray, and a torn old red cotton handkerchief wrapt round a pair of very clouted shoes."
                            },
                            {
                                "example_id": "9851b989-12d5-4a63-a906-fba6440aca72",
                                "sense_id": "ed16be26-5fc4-31c9-954e-8ceef0949393",
                                "text": "You are greatly struck with the whiteness of the man's underclothing: to judge by his external appearance you would say that, under that somewhat soiled striped frock you would fairly expect to find raiment, to say the least not any cleaner, and probably more clouted. But not so."
                            }
                        ]
                    },
                    {
                        "sense_id": "d883937f-a5a1-382d-bcac-aa9283032ecc",
                        "entry_id": "c5a7beb4-d237-3f5a-bc41-891c31e0a0ef",
                        "glosses": [
                            "Bandaged."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d9eabc9-793c-4c5b-b733-84e89f93f1bc",
                                "sense_id": "d883937f-a5a1-382d-bcac-aa9283032ecc",
                                "text": "The while, thilk same unhappy ewe (Whose clouted leg her hurt doth show) Fell headlong into a dell And there unjointed both her bones."
                            },
                            {
                                "example_id": "5a1f3de0-7dd5-48c9-b2d2-43330a4def19",
                                "sense_id": "d883937f-a5a1-382d-bcac-aa9283032ecc",
                                "text": "I bade good by to boots, and limped for months upon sloughing and clouted feet, but was happy, nevertheless."
                            }
                        ]
                    },
                    {
                        "sense_id": "7971f843-10f8-30c5-b5d0-f1eb6171ce48",
                        "entry_id": "c5a7beb4-d237-3f5a-bc41-891c31e0a0ef",
                        "glosses": [
                            "Hobnailed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db3c0673-301b-4175-99e1-72652a6bfe62",
                                "sense_id": "7971f843-10f8-30c5-b5d0-f1eb6171ce48",
                                "text": "The vast majority of people in the east go bare-footed, and those who wear shoes certainly do not wear them clouted. During a residence of several years in India, I never saw a clouted shoe ."
                            },
                            {
                                "example_id": "9617ed36-5031-4183-94cb-93adae260d40",
                                "sense_id": "7971f843-10f8-30c5-b5d0-f1eb6171ce48",
                                "text": "A peasant who lived in a distant hamlet, and was quite a stranger in Freiburg and its vicinity, was ordered to go to that city, to a certain painter there, and give him an order to make a picture of a clouted shoe; but the man, not relishing the commission, delivered his message with so much blundering and trepidation as to excite the suspicions of the painter, who went straight to the town-hall, and told the story to the council."
                            },
                            {
                                "example_id": "01795084-eda4-47bb-aa5c-e6320889297b",
                                "sense_id": "7971f843-10f8-30c5-b5d0-f1eb6171ce48",
                                "text": "Truth lies before us; it is in the highway path, and the ploughman treads on it with clouted shoes ."
                            },
                            {
                                "example_id": "ae75d87f-5599-4502-ba1f-90495471a6ca",
                                "sense_id": "7971f843-10f8-30c5-b5d0-f1eb6171ce48",
                                "text": "Sad it seems in God's rich and redundant earth that men should have to revolt who wanted so little; and when this order was extinguished—for it was soon extinguished—in a year or two rose a new league; and as the knightly order was permitted to wear boots, and peasants were only allowed to wear rough shoes, or, as they were called, \"clouted shoon,\" the league was called \"The Order of the Clouted Shoon,\" or the \"Bund Shuh;\" and they had a banner on which was painted, on a ground half white and half blue, a clouted shoe, at the foot of the Saviour on the cross, with the inscription, \" Nothing but the justice of God.\" ."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7e700a8-0fbc-33c1-9def-8ce1aa5fcb95",
                        "entry_id": "c5a7beb4-d237-3f5a-bc41-891c31e0a0ef",
                        "glosses": [
                            "Beaten, pounded, or subjected to rough treatment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0422f983-bb15-462f-8262-cc741c1f858c",
                                "sense_id": "d7e700a8-0fbc-33c1-9def-8ce1aa5fcb95",
                                "text": "'For what reason,' we may imagine it to exclaim, 'am I left here in inglorious solitude, wedged in coarse marle, or kicked out of the way by every clouted peasant that crosses this path to pursue his daily labour , when many other flints , by no means so comely as myself , are selected by the partial hand of man to raise the cottage wall , or emit the generous spark?"
                            },
                            {
                                "example_id": "150f851f-103a-466e-9842-32d1b725e6e0",
                                "sense_id": "d7e700a8-0fbc-33c1-9def-8ce1aa5fcb95",
                                "text": "But the others, who are in the path of the wind, they are clouted and pushed and beaten, blinded and deafened by the cyclone."
                            },
                            {
                                "example_id": "da9aeead-1568-444e-84e9-0ab52a5157f4",
                                "sense_id": "d7e700a8-0fbc-33c1-9def-8ce1aa5fcb95",
                                "text": "First came the men, dressed in close-fitting pantaloons of clouted cloth or buckskin, with a wide, fancy fringe along each leg, a pair of moccasins, ornamented with beads, on the feet, and a dirty white blanket drawn over the shoulders."
                            }
                        ]
                    },
                    {
                        "sense_id": "47121ad4-5ed7-3aaa-8982-0e10d7accb08",
                        "entry_id": "c5a7beb4-d237-3f5a-bc41-891c31e0a0ef",
                        "glosses": [
                            "Rough and uneven."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90c91ab4-9a55-4127-a7f1-af8dba5ee2ca",
                                "sense_id": "47121ad4-5ed7-3aaa-8982-0e10d7accb08",
                                "text": "Fortunately it was covered with light scrub: otherwise I should never have got to the top, for the frozen and clouted soil was so slippery that one slid back at every step."
                            },
                            {
                                "example_id": "621d8749-df88-4589-8b1c-e4a45c4d8729",
                                "sense_id": "47121ad4-5ed7-3aaa-8982-0e10d7accb08",
                                "text": "Looking up, however, he was disappointed how much white, snow-clouted sky he could see through the rotten boards that were once a bridge."
                            },
                            {
                                "example_id": "d99de7af-40d5-4c97-8cfd-0f859b97cae4",
                                "sense_id": "47121ad4-5ed7-3aaa-8982-0e10d7accb08",
                                "text": "In more clouted environments as it is the case in urban settings, gaze orientation is directed towards the ground in order to detect possible obstacles (Van Cauwenberg et al., 2016)."
                            }
                        ]
                    }
                ],
