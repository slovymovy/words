                    {
                        "sense_id": "5bf4c09f-dd48-3b86-a07e-f2d1d74a7b27",
                        "entry_id": "6682c98c-fd15-3ea4-ba61-bbbee7f5b4ba",
                        "glosses": [
                            "tłumiony śmiech o wysokim tonie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f6031c6-e059-44c0-965b-9621a444e375",
                                "sense_id": "5bf4c09f-dd48-3b86-a07e-f2d1d74a7b27",
                                "text": "Na sali zapanowała grobowa cisza, tylko z kąta dobiegał czyjś głupawy chichot."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f5839d6-a1cd-45db-b325-826bd3ac5f5d",
                        "source_entry_id": "6682c98c-fd15-3ea4-ba61-bbbee7f5b4ba",
                        "source_sense_id": "5bf4c09f-dd48-3b86-a07e-f2d1d74a7b27",
                        "target_lang_word": "giggle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "giggle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef5d3995-43d5-3168-9c57-cb3aaaa4fa8a",
                                        "entry_id": "a98dab14-9e2d-3d02-ba9a-7a7017a1d3f1",
                                        "glosses": [
                                            "To laugh gently in a playful, nervous, or affected manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "121b19a6-ed3c-4c49-aa04-cc5bdbe30b2b",
                                                "sense_id": "ef5d3995-43d5-3168-9c57-cb3aaaa4fa8a",
                                                "text": "The jokes had them giggling like little girls all evening."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "giggle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6effc39b-57b2-3c58-b97a-572a6b7b466f",
                                        "entry_id": "0f879c24-89c8-3163-94ed-7eb68248716a",
                                        "glosses": [
                                            "A high-pitched, silly laugh."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97bbbf0e-ed0a-4dd3-8636-7c5c03113f0e",
                                                "sense_id": "6effc39b-57b2-3c58-b97a-572a6b7b466f",
                                                "text": "My audience to this not-too-easy operation was a small group of Scottish school lasses, who seemed (perhaps naturally) to find the proceedings somewhat mysterious, but at any rate amusing. I wished they would go away, but they didn't, so I had to get on with the job to the accompaniment of a background of giggles!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba83ecc1-0a7a-3c18-a442-45e2d77d5efb",
                                        "entry_id": "0f879c24-89c8-3163-94ed-7eb68248716a",
                                        "glosses": [
                                            "Fun; an amusing episode."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f207ab5-813f-4b74-bd31-5ec63b0d6c64",
                                                "sense_id": "ba83ecc1-0a7a-3c18-a442-45e2d77d5efb",
                                                "text": "We put itching powder down his shirt for giggles."
                                            },
                                            {
                                                "example_id": "b9cc0e8c-2fd8-4463-8607-a6d07c6bb57e",
                                                "sense_id": "ba83ecc1-0a7a-3c18-a442-45e2d77d5efb",
                                                "text": "The women thought it would be quite a giggle to have a strippergram at the bride's hen party."
                                            },
                                            {
                                                "example_id": "d62951c2-09fb-408d-b665-b50170f86042",
                                                "sense_id": "ba83ecc1-0a7a-3c18-a442-45e2d77d5efb",
                                                "text": "For my first English breakfast I had kippers and pink champagne - what a combination, still it was a bit of a giggle and I know I've really arrived."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
