                "senses": [
                    {
                        "sense_id": "2a48d7a8-91cc-3884-9911-7314c10c9632",
                        "entry_id": "76a8dffd-3e9f-39e9-878f-aacadf91486c",
                        "glosses": [
                            "bei Vulkanausbrüchen rasch talwärts fließende Schlammlawine aus vulkanischer Asche und Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5b4ae44-7f11-42cd-8c82-b9486b0b235c",
                                "sense_id": "2a48d7a8-91cc-3884-9911-7314c10c9632",
                                "text": "„Diese ‚Lahare‘ lösen oft viel größere Katastrophen als die eigentliche Eruption aus.“"
                            },
                            {
                                "example_id": "bd5d9f24-4304-4545-a950-904a106b4641",
                                "sense_id": "2a48d7a8-91cc-3884-9911-7314c10c9632",
                                "text": "An den Zimmertüren sind vorsorglich \"volcanic eruption warnings\" angeschlagen: Wenn das glutheiße Gebräu aus den Höllentiefen sich den Weg zur Oberfläche bahnt, sich dort mit Schnee und Eis vermischt und als \"Lahar\"-Vulkanschlamm die Hänge hinunterdonnert, dann haben die Skifahrer auf der Piste acht Minuten und die Bewohner des nahen Dorfes 15 Minuten Zeit, die Beine in die Hand zu nehmen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42dff376-c077-47f6-817b-3995813bafeb",
                        "source_entry_id": "76a8dffd-3e9f-39e9-878f-aacadf91486c",
                        "source_sense_id": "2a48d7a8-91cc-3884-9911-7314c10c9632",
                        "source_sense_description": "Schlammlawine aus vulkanischer Asche und Wasser",
                        "target_lang_word": "lahar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lahar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a10e235d-b506-3375-87cd-c54e5eaebaa1",
                                        "entry_id": "e5159513-ed25-3d5e-b197-9eb409129919",
                                        "glosses": [
                                            "A volcanic mudflow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4becfdf5-8129-4aaf-b8dd-83b96833b6fa",
                                                "sense_id": "a10e235d-b506-3375-87cd-c54e5eaebaa1",
                                                "text": "Such a highly destructive mud-flow (termed a lahar) eventually stops as a pile of debris of all shapes and sizes, as mixed up as a glacial moraine; the two deposits have often been confused."
                                            },
                                            {
                                                "example_id": "e164502d-ff71-4267-bd97-dabbed9ff171",
                                                "sense_id": "a10e235d-b506-3375-87cd-c54e5eaebaa1",
                                                "text": "Pyroclastic flows are often difficult to distinguish in outcrops from a similar type of fragmental debris flow known as lahars. Both are characteristically unstratified and unsorted. A deposit containing blocks of varied compositions with rounded shapes is more likely to have been formed by a lahar than by a glowing avalanche."
                                            },
                                            {
                                                "example_id": "8aa4830f-b208-4d14-9940-ef3296d08b4a",
                                                "sense_id": "a10e235d-b506-3375-87cd-c54e5eaebaa1",
                                                "text": "A regime of persistent lahar activity results when eruptive activity continually supplies unconsolidated volcanic material for remobilization."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efbae054-6f67-45f9-8fd1-8ea4e1fda937",
                        "source_entry_id": "76a8dffd-3e9f-39e9-878f-aacadf91486c",
                        "source_sense_id": "2a48d7a8-91cc-3884-9911-7314c10c9632",
                        "source_sense_description": "Schlammlawine aus vulkanischer Asche und Wasser",
                        "target_lang_word": "lahar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lahar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f3d15d0-5d40-3c8b-ae91-fdf20805fde8",
                                        "entry_id": "7857570f-1ffe-35d1-b5f3-67319db185b1",
                                        "glosses": [
                                            "Coulée de boue d’origine volcanique, qui détruit tout sur son passage. Elle est principalement constituée de cendre et d’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3caf7ad-bc40-44f8-afa5-c62d53195d31",
                                                "sense_id": "8f3d15d0-5d40-3c8b-ae91-fdf20805fde8",
                                                "text": "Les 23 000 morts d’Armero (Colombie, 1985) sont imputables au lahar déclenché par la fonte des neiges du Nevado del Ruiz, à cause du déferlement de projections à haute température expulsées par une éruption pourtant bien modeste (0,05 km³)."
                                            },
                                            {
                                                "example_id": "58822f94-2c9f-4f3f-a378-1737e6bf6e5a",
                                                "sense_id": "8f3d15d0-5d40-3c8b-ae91-fdf20805fde8",
                                                "text": "lahar dans la bibliothèque Wikisource"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
