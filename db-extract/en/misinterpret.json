                "senses": [
                    {
                        "sense_id": "df997904-340e-3131-a9e1-f521dfce521f",
                        "entry_id": "dba1273d-4214-39f1-bef5-e39cfd9fec20",
                        "glosses": [
                            "To make an incorrect interpretation; to misunderstand."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4948f5e3-ae44-4369-952c-4452e3868178",
                                "sense_id": "df997904-340e-3131-a9e1-f521dfce521f",
                                "text": "For Ralph, any encouragement is too much. When Lisa gives Ralph a valentine bearing that locomotive pun that so affected The Simpsons’ showrunner, Ralph misinterprets the gesture as a genuine display of romantic interest rather than a gesture of pity from a thoughtful young geek to a friendless goober."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd0d0f13-55ff-4fcd-a99b-064ed364814b",
                        "source_entry_id": "dba1273d-4214-39f1-bef5-e39cfd9fec20",
                        "source_sense_id": "df997904-340e-3131-a9e1-f521dfce521f",
                        "source_sense_description": "to interpret wrongly",
                        "target_lang_word": "mésinterpréter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mésinterpréter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "964b772e-9dc1-3309-ab7e-fe593b7c4224",
                                        "entry_id": "bd496f08-70e7-3259-bcdf-aefbc619cb30",
                                        "glosses": [
                                            "Interpréter mal, à faux, d’une manière défavorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9688f9d3-4eff-4fda-992d-cbf3f2a113d3",
                                                "sense_id": "964b772e-9dc1-3309-ab7e-fe593b7c4224",
                                                "text": "Je ne suis pas si prompt que vous à mésinterpréter les motifs de mes amis."
                                            },
                                            {
                                                "example_id": "53466cc2-af52-42d7-98f1-a7bc61a31082",
                                                "sense_id": "964b772e-9dc1-3309-ab7e-fe593b7c4224",
                                                "text": "On mésinterpréta la familiarité dont il usait avec ses jeunes élèves."
                                            },
                                            {
                                                "example_id": "e115afd0-30a0-4a68-8115-20a159e81e62",
                                                "sense_id": "964b772e-9dc1-3309-ab7e-fe593b7c4224",
                                                "text": "S’ensuit alors un interrogatoire (la juge parle de « conversation », contrevérité alors que tout est à charge et que la parole des prévenus est systématiquement déformée, mésinterprétée et/ou ridiculisée) durant lequel le grotesque et l’absurde rivalisent avec l’indécence et l’abjection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edc73f05-026a-4e9b-be6f-5a4dd043f37b",
                        "source_entry_id": "dba1273d-4214-39f1-bef5-e39cfd9fec20",
                        "source_sense_id": "df997904-340e-3131-a9e1-f521dfce521f",
