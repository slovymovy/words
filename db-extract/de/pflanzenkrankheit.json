                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f290c82d-b48e-4dd9-84d1-2956b3cccdb4",
                                                "sense_id": "05286a65-eb66-36f8-94cd-19123c309664",
                                                "text": "La phytopathologie chinoise, décrite notamment par Marco Polo, apparaît comme faisant partie intégrante des pratiques agricoles."
                                            },
                                            {
                                                "example_id": "458eb463-cba5-4fb2-ad41-5d521b8a1a66",
                                                "sense_id": "05286a65-eb66-36f8-94cd-19123c309664",
                                                "text": "Le travail de Nathalie Jas touche à l’histoire des empoisonnements en milieu professionnel et à domicile, ainsi qu’à l’histoire de la phytopharmacie et de la phytopathologie."
                                            }
                                        ]
                                    },
