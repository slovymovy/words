                ],
                "senses": [
                    {
                        "sense_id": "106dea0d-201a-3661-8e22-ab0399432e36",
                        "entry_id": "8e21653e-5b68-3dfc-bc45-d1dfd5607c2d",
                        "glosses": [
                            "Faire perdre son caractère centré sur l’être humain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae979992-f7fc-4ce1-a97d-52b1c241f2e7",
                                "sense_id": "106dea0d-201a-3661-8e22-ab0399432e36",
                                "text": "Le judaïsme – sur lequel surenchérit l’islam autant qu’il est déprécié par le christianisme – aurait son mot à dire sur ce point et l’essence ultime du divin, à dés-anthropocentrer."
                            },
                            {
                                "example_id": "e3f868c5-b037-4097-ae34-80071a6d22ee",
                                "sense_id": "106dea0d-201a-3661-8e22-ab0399432e36",
                                "text": "Un événement ne fait sens qu’au croisement de ces multiples approches, son rayonnement s’inscrit dans la chaîne des éternels retours, pour peu qu’on prenne le risque de se dés-anthropocentrer."
                            }
                        ]
                    }
                ],
