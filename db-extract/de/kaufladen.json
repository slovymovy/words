                ],
                "senses": [
                    {
                        "sense_id": "c4311216-5568-329a-92a7-d81595ff5de8",
                        "entry_id": "9196370c-9288-3b06-b11f-51e36bbe5537",
                        "glosses": [
                            "veraltend: kleines Einzelhandelsgeschäft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f5e9d9-1774-40e2-9b2b-0992312f3292",
                                "sense_id": "c4311216-5568-329a-92a7-d81595ff5de8",
                                "text": "„Ohne Auto stehe man doch ziemlich auf dem Schlauch, sagte Mama am Telefon zu Oma Jever, und es sei allerhöchste Eisenbahn, daß auf dem Mallendarer Berg ein Kaufladen aufmache.“"
                            },
                            {
                                "example_id": "c5155767-81da-4b10-8ff4-c51ec1aac7f8",
                                "sense_id": "c4311216-5568-329a-92a7-d81595ff5de8",
                                "text": "„Mit seinen Galerien und Arkaden umfaßte er alles, Theater, Spielhöllen, Kaufläden, Cafés, Speisehäuser und Vergnügungsstätten.“"
                            },
                            {
                                "example_id": "0566ab84-97e5-4ef6-81e9-6d36c34d186c",
                                "sense_id": "c4311216-5568-329a-92a7-d81595ff5de8",
                                "text": "„Man betrat ihn durch die Seitentür eines Kaufladens, und der Mann, der diese öffnete, stemmte vorerst noch seinen Fuß gegen sie und sah sich vorsichtig um.“"
                            },
                            {
                                "example_id": "42c7afe9-25e1-492f-a38f-029c157907ed",
                                "sense_id": "c4311216-5568-329a-92a7-d81595ff5de8",
                                "text": "„Als Gísli mit dreißig Fischen und neuen Entnahmen aus dem Kaufladen von Arnarstapi heimkommt, weiß die gesamte Gegend, dass der Landpostbote auf Geheiß von Séra Pétur Jónsson einen gewaltigen Umweg machen musste, um Guđriđur einen Brief auszuhändigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5282a4ee-af0d-33dd-b63d-853e58159fb3",
                        "entry_id": "9196370c-9288-3b06-b11f-51e36bbe5537",
                        "glosses": [
                            "Einzelhandelsgeschäft als Kinderspielzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f2aab56-5ff8-46d6-93c8-0180f4028fb4",
                                "sense_id": "5282a4ee-af0d-33dd-b63d-853e58159fb3",
                                "text": "„Einen Kaufladen gab es sogar auf Lummerland, wo nur vier Leute wohnten: Lukas der Lokomotivführer, König Alfons der Viertel-vor-Zwölfte, Frau Waas und Herr Ärmel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
