            "senses": [
                {
                    "sense_id": "0b53b283-f1db-36bf-99d6-484315c629aa",
                    "sense_definition": "Magistrat qui représente le ministère public et veille à l'application de la loi au nom de la société.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>procureur</w> a demandé une peine exemplaire contre l'accusé à la fin de son réquisitoire."
                        },
                        {
                            "text": "Les enquêteurs ont immédiatement transmis leur rapport au <w>procureur</w> de la République."
                        }
                    ],
                    "synonyms": [
                        "représentant du ministère public",
                        "procureur de la République"
                    ],
                    "common_phrases": [
                        "procureur de la République"
                    ]
                },
                {
                    "sense_id": "a868c1b9-3011-3a30-944d-fb2eb22b817b",
                    "sense_definition": "Personne habilitée par mandat à agir au nom et pour le compte d'une autre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mandat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne pouvant assister à l'assemblée, il a désigné un <w>procureur</w> pour voter à sa place."
