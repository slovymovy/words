                                            {
                                                "example_id": "a656a7d2-0f49-4d68-8501-0233e375f95a",
                                                "sense_id": "88f88c16-4a7a-3d65-9557-9543ced3e268",
                                                "text": "Onanie ist oft der erste Schritt zu einem erfüllten Liebesleben."
                                            },
                                            {
                                                "example_id": "304838b8-e992-4e47-bf43-bd836977ea91",
                                                "sense_id": "88f88c16-4a7a-3d65-9557-9543ced3e268",
                                                "text": "„Luther erinnert unermüdlich an das, was Paulus über das sündige Fleisch des Menschen lehrt. Der eheliche Verkehr ist für ihn nur das kleinere Übel: Besser als \"die stumme Sünde\" der Onanie, gesünder als das Herumhuren in Bordellen und anständiger als die \"Wollüsterey\" in fremden Ehebetten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b9b7c4c-5eac-4faa-acc2-a844c6e095ae",
