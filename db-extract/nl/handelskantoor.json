                        "examples": [
                            {
                                "example_id": "ed9fb31e-a29b-410f-9bd7-6f1bb6d2716f",
                                "sense_id": "e628aa06-501b-371f-b26d-b93363c7e214",
                                "text": "In Yangon in Myanmar komt een volwaardige ambassade in plaats van de huidige economische missie. Ook het handelskantoor 'met laptop-diplomaat' in Abidjan in Ivoorkust wordt een ambassade."
                            },
                            {
                                "example_id": "fff44cc2-417c-4a89-8e5a-df8a1b7735e1",
                                "sense_id": "e628aa06-501b-371f-b26d-b93363c7e214",
                                "text": "BTCGreece is het enige handelskantoor in Griekenland waar je bitcoins kunt kopen. Samen met Cubits, het Europese platform om bitcoins te kopen en verkopen, kwamen ze met het idee van de duizend bitcoinpinautomaten."
                            },
                            {
                                "example_id": "c281c812-5dc3-46dd-a0bf-7f9ce3bde397",
                                "sense_id": "e628aa06-501b-371f-b26d-b93363c7e214",
                                "text": "De Europese Commissie legt internationale banken een recordboete op van 1,7 miljard euro. Het gaat om zeven banken en een handelskantoor. Ze hebben verschillende rentetarieven gemanipuleerd, waaronder de Libor- en de Euribor-rente. Verder hebben ze onderling geheime en gevoelige informatie gedeeld die ze volgens de wet niet mogen delen."
                            }
                        ]
                    }
