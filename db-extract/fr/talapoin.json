                        "entry_id": "808cc973-cde0-38c1-9751-4657236ee4a5",
                        "glosses": [
                            "Moine ou prêtre bouddhiste de Thaïlande ou de Birmanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2188d971-2a41-4fbf-b0a1-89f3ab513939",
                                "sense_id": "8a8079d9-23b7-39a7-8a96-506a502b8efd",
                                "text": "Un groupe de chamans chinois, et de talapoins de Siam."
                            },
                            {
                                "example_id": "43c94490-cbc4-45f2-9c16-dc158b262888",
                                "sense_id": "8a8079d9-23b7-39a7-8a96-506a502b8efd",
                                "text": "Ces pays où les fakirs, les bonzes, les santons, les caloyers, les marabouts, les talapoins et les derviches pullulent jusqu’au fourmillement vermineux."
                            },
                            {
                                "example_id": "ecf028fa-f2f3-4278-8ab1-b2f0679d392f",
                                "sense_id": "8a8079d9-23b7-39a7-8a96-506a502b8efd",
                                "text": "« En talapoins, chère amie ! On les habillera en ta-la-poins! »"
                            }
                        ]
                    }
                ],
