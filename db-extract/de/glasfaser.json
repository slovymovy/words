                    {
                        "translation_id": "82857f1e-8cf2-4109-8c12-784f1765019c",
                        "source_entry_id": "e0f14eef-533d-33dc-9c37-a4e773dd2648",
                        "source_sense_id": "83ae42d0-6b6a-321d-9743-6fa8b44f5df7",
                        "source_sense_description": "lange, dünne Faser, hergestellt aus Glas",
                        "target_lang_word": "fibre de verre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fibre de verre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32a89cf0-5a93-38fe-ac84-399bf5a02d96",
                                        "entry_id": "ea41e97a-995d-3064-a925-ad9c42112fcb",
                                        "glosses": [
                                            "Filaments de verre produits grâce à une filière, rassemblés en fil ou en ruban de fibres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d64f64e5-c5d9-4e09-8924-b2f2263a6af4",
                                                "sense_id": "32a89cf0-5a93-38fe-ac84-399bf5a02d96",
                                                "text": "La fibre de verre représente un cas quasi unique d’élasticité linéaire caractérisé par un allongement à la rupture aussi important. Ce comportement mécanique exceptionnel est induit par le taux d’étirage extrêmement élevé de la fibre de verre à la sortie de la filière qui oriente les chaînes de silicates parallèlement à la fibre et aussi à l’ensimage qui protège la surface."
                                            },
                                            {
                                                "example_id": "c37bc3f6-ed9f-462c-8427-9abb1605c7ea",
                                                "sense_id": "32a89cf0-5a93-38fe-ac84-399bf5a02d96",
                                                "text": "Dans les matériaux composites, les fibres de verre sont généralement associées à des polymères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d219d57-293d-375f-9e36-87427d3fa16b",
                                        "entry_id": "ea41e97a-995d-3064-a925-ad9c42112fcb",
                                        "glosses": [
                                            "Matériau composite armé ou renforcé avec des fibres de verre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abdca1b9-03a0-4ed6-a208-6b676de07464",
                                                "sense_id": "7d219d57-293d-375f-9e36-87427d3fa16b",
                                                "text": "La plupart du temps, les professionnels et les bricoleurs parlant de fibre de verre se réfèrent en réalité à du plastique renforcé à la fibre de verre."
                                            },
                                            {
                                                "example_id": "2d004fc5-7586-4b63-99fa-09c5cbf7363d",
                                                "sense_id": "7d219d57-293d-375f-9e36-87427d3fa16b",
                                                "text": "Aujourd’hui, un grand nombre d’objets sont fabriqués en fibre de verre ou en fibre de carbone pour les plus résistants. Pièces de carrosseries pour nos autos, carénages de motos, des réservoirs d’eau ou de carburant, la liste est longue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
