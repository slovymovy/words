                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certains commentateurs malveillants ont cherché à <w>défigurer</w> ses propos lors de l'interview."
                        },
                        {
                            "text": "Cette mauvaise adaptation théâtrale a complètement <w>défiguré</w> l'œuvre originale du célèbre auteur."
