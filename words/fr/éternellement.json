{
    "word_family": [
        "éternel",
        "éterniser",
        "éternité"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8a6db67d-f671-321b-a9b7-5bdc324d36c5",
                    "sense_definition": "Sans fin, pour toujours, pendant une durée infinie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "duree_infinie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous espérons que notre amitié va durer <w>éternellement</w> malgré la distance."
                        },
                        {
                            "text": "Le souvenir de cette belle journée restera <w>éternellement</w> gravé dans ma mémoire."
                        }
                    ],
                    "synonyms": [
                        "à jamais",
                        "pour toujours"
                    ],
                    "antonyms": [
                        "temporairement",
                        "provisoirement"
                    ],
                    "common_phrases": [
                        "durer éternellement"
                    ]
                },
                {
                    "sense_id": "54ffd438-4dd6-3fc7-a103-f3ad0beec361",
                    "sense_definition": "Sans cesse, continuellement et de façon répétée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repetition_continue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle se plaint <w>éternellement</w> du bruit des voisins, quoi qu'on fasse pour elle."
                        },
                        {
                            "text": "Il répète <w>éternellement</w> les mêmes erreurs sans jamais écouter les conseils."
                        }
                    ],
                    "common_phrases": [
                        "attendre éternellement",
                        "répéter éternellement"
                    ]
                },
                {
                    "sense_id": "d2384002-2662-3f14-940e-31c016fda34a",
                    "sense_definition": "D'une manière éternelle, hors de toute dimension temporelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "temporalite_absolue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les théologiens affirment que l'âme divine existe <w>éternellement</w> au-delà du monde matériel."
                        },
                        {
                            "text": "Dans cette doctrine philosophique, les vérités fondamentales subsistent <w>éternellement</w>."
                        }
                    ],
                    "common_phrases": [
                        "exister éternellement"
                    ]
                }
            ]
        }
    ]
}