                                        "sense_id": "f17978f6-2eea-37a9-b330-30ba22e0095b",
                                        "entry_id": "45e94d26-4761-3a1a-a2d5-268a871be185",
                                        "glosses": [
                                            "A color which is close to an equal mixture of red and blue which is an additive secondary color but a subtractive primary color evoked by the combination of red and blue light."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9d7126a-2e2e-43b8-bf0e-36a7f55a0387",
                                                "sense_id": "f17978f6-2eea-37a9-b330-30ba22e0095b",
                                                "text": "Mrs Dibble's face blazed with a magenta uprush of blood at that ultimatum and she screamed, \"You dare try to do me out of my gin too! You dare!\""
                                            }
                                        ]
                                    }
                                ]
                            },
