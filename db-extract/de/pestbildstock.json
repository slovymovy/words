                "senses": [
                    {
                        "sense_id": "a632480c-7d63-31e4-a0cf-08a3e4c614f0",
                        "entry_id": "b0d472eb-d5cb-35f6-9a0b-358d7ac14de5",
                        "glosses": [
                            "im Freien auf einem Pfeiler oder Sockel angebrachtes Heiligenbild oder Heiligenfigur zur Erinnerung an die Pest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b24fdfeb-7605-4638-9abb-080dc3b9a2d1",
                                "sense_id": "a632480c-7d63-31e4-a0cf-08a3e4c614f0",
                                "text": "„Der Pestbildstock von Gniebing wurde aufgrund des Umfahrungstunnels nicht nur versetzt, sondern auch von der Künstlerin Roswitha Dautermann mit Malereien, Keramik- und Glasobjekten neu gestaltet.“"
                            },
                            {
                                "example_id": "633effc0-c34f-477a-b064-7da4e275ec29",
                                "sense_id": "a632480c-7d63-31e4-a0cf-08a3e4c614f0",
                                "text": "„Von den Ortsbürgern wird das Denkmal heute als Pestbildstock angesehen, errichtet als eine Bittstiftung für die Heilige und für alle Vorübergehenden als Mahnung an den Tod gedacht.“"
                            },
                            {
                                "example_id": "fa1d2314-b1d8-4b99-816a-e248327450ff",
                                "sense_id": "a632480c-7d63-31e4-a0cf-08a3e4c614f0",
                                "text": "„Der liebevoll gepflegte Pestbildstock mit gut erhaltener Bemalung (mit 1460 datiert) bereichert die Kulturlandschaft der Gegend.“"
                            },
                            {
                                "example_id": "62a6a23c-9a03-434b-b80a-378cad615200",
                                "sense_id": "a632480c-7d63-31e4-a0cf-08a3e4c614f0",
                                "text": "„In Keilberg ist der sogenannte Pestbildstock aus dem Jahre 1625 noch erhalten […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
