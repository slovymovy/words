                        "examples": [
                            {
                                "example_id": "97fe8f50-f620-42ac-9628-2d8be182a067",
                                "sense_id": "4c14b1bd-ae80-3e21-b73d-e73f222f0b03",
                                "text": "Les jours de la nouvelle épouse se mirent à couler, uniformes, pareils aux humbles flots ternis qui se succèdent et se confondent dans le lit morne du canal."
                            }
                        ]
                    },
                    {
                        "sense_id": "8129fbbe-3421-340d-9106-56807983aef6",
                        "entry_id": "1a6369c2-1b63-3415-ae12-e2dd07706c8e",
                        "glosses": [
                            "Touches les plus claires d’un tableau."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "080df6d9-ebed-4b6c-90b6-b88439ff9a31",
                                "sense_id": "8129fbbe-3421-340d-9106-56807983aef6",
                                "text": "Savoir bien mêler les jours et les ombres."
                            },
                            {
                                "example_id": "72b0e36a-c7cf-46c6-bd9b-77c589853686",
                                "sense_id": "8129fbbe-3421-340d-9106-56807983aef6",
                                "text": "Observez bien les jours et les ombres."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c31d2d5-d67a-3cc7-af6a-ddcd25e51ba4",
                        "entry_id": "1a6369c2-1b63-3415-ae12-e2dd07706c8e",
                        "glosses": [
                            "Une certaine durée, une certaine époque, par rapport à ce qui s’y passe, aux événements qui la remplissent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97384d2d-4a1a-447c-b74f-2050e7a751cf",
                                "sense_id": "6c31d2d5-d67a-3cc7-af6a-ddcd25e51ba4",
                                "text": "Aux premiers jours du monde."
                            },
                            {
                                "example_id": "3ec16206-81a3-458c-8ebc-b1bbccac8f45",
                                "sense_id": "6c31d2d5-d67a-3cc7-af6a-ddcd25e51ba4",
                                "text": "Elle a connu des jours meilleurs."
                            },
                            {
                                "example_id": "27b04828-53db-4a35-a75a-d2094e5dfae8",
                                "sense_id": "6c31d2d5-d67a-3cc7-af6a-ddcd25e51ba4",
                                "text": "Les jours de notre enfance."
                            }
                        ]
                    },
                    {
                        "sense_id": "be416283-20f6-3361-bb39-a801c1d429d4",
                        "entry_id": "1a6369c2-1b63-3415-ae12-e2dd07706c8e",
                        "glosses": [
                            "La vie de quelqu'un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4b35015-5ac4-4d28-a248-0d79ce1bea81",
                                "sense_id": "be416283-20f6-3361-bb39-a801c1d429d4",
                                "text": "Quand il sera sur ses vieux jours."
                            },
                            {
                                "example_id": "05c29021-0a49-4a49-9896-0ff1bd534ee2",
                                "sense_id": "be416283-20f6-3361-bb39-a801c1d429d4",
                                "text": "Je tremblais pour vos jours."
                            },
                            {
                                "example_id": "f819ea0a-3eb7-449e-8b0f-6f5737b3f236",
                                "sense_id": "be416283-20f6-3361-bb39-a801c1d429d4",
                                "text": "Ah ! cher Henry, que vous ai-je fait pour prendre ce soin de mes jours ?"
                            }
                        ]
                    }
