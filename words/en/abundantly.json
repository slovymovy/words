{
    "word_family": [
        "abundant",
        "abundance"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d5a72d95-590f-3298-ac29-b45e00ebb098",
                    "sense_definition": "In a large quantity or to a great degree.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was <w>abundantly</w> supplied with fresh vegetables throughout the summer season.",
                            "target_lang_translations": {
                                "pl": "Ogród był <w>obficie</w> zaopatrzony w świeże warzywa przez cały sezon letni.",
                                "zh": "整个夏季，花园里都<w>充足地</w>供应着新鲜蔬菜。"
                            }
                        },
                        {
                            "text": "It is <w>abundantly</w> clear that the project will require more funding to succeed.",
                            "target_lang_translations": {
                                "pl": "Jest <w>całkowicie</w> jasne, że projekt będzie wymagał więcej funduszy, aby odnieść sukces.",
                                "zh": "这个项目要想成功，<w>十分</w>明显需要更多的资金。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fully",
                        "amply",
                        "plentifully"
                    ],
                    "common_phrases": [
                        "abundantly clear",
                        "abundantly supplied"
                    ],
                    "target_lang_definitions": {
                        "pl": "W dużej ilości lub w znacznym stopniu.",
                        "zh": "指数量很大或程度很深。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "obficie",
                                "target_lang_sense_clarification": "w dużej ilości, w sposób hojny"
                            },
                            {
                                "target_lang_word": "pod dostatkiem",
                                "target_lang_sense_clarification": "wystarczająco dużo, w dużej ilości"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "充足地",
                                "target_lang_sense_clarification": "指数量丰富，供应充足"
                            },
                            {
                                "target_lang_word": "大量地",
                                "target_lang_sense_clarification": "指数量很多"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acbf7f84-7531-3e99-a2ed-6b2319f59ed9",
                    "sense_definition": "To an extreme or very high degree.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The evidence made it <w>abundantly</w> obvious that the plan was doomed from the start.",
                            "target_lang_translations": {
                                "pl": "Dowody sprawiły, że stało się <w>zupełnie</w> oczywiste, iż plan był skazany na porażkę od samego początku.",
                                "zh": "证据使人<w>完全</w>明白，这个计划从一开始就注定要失败。"
                            }
                        },
                        {
                            "text": "He was <w>abundantly</w> aware of the risks involved in his decision.",
                            "target_lang_translations": {
                                "pl": "Był <w>doskonale</w> świadomy ryzyka związanego ze swoją decyzją.",
                                "zh": "他<w>十分</w>清楚自己决定中所涉及的风险。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "abundantly obvious",
                        "abundantly aware"
                    ],
                    "target_lang_definitions": {
                        "pl": "W bardzo wysokim stopniu, całkowicie lub w sposób oczywisty.",
                        "zh": "指程度极高，或非常明显、确凿。"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "całkowicie",
                                "target_lang_sense_clarification": "w pełni, zupełnie"
                            },
                            {
                                "target_lang_word": "zupełnie",
                                "target_lang_sense_clarification": "w sposób oczywisty, bez wątpliwości"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "十分",
                                "target_lang_sense_clarification": "程度副词，表示程度极高"
                            },
                            {
                                "target_lang_word": "完全",
                                "target_lang_sense_clarification": "表示程度彻底，毫无疑问"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}