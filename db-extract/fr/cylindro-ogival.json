                "senses": [
                    {
                        "sense_id": "bab47a2c-b3b7-3c44-9a19-934e6ad9ec36",
                        "entry_id": "db453ed3-0e13-357f-b3e9-8c8d1b6a0e13",
                        "glosses": [
                            "Qualifie la forme des projectiles, balles ou obus, tirés par une arme à canon rayé."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": [
                            {
                                "example_id": "a36305be-ac25-4b04-9359-1f480ecf8280",
                                "sense_id": "bab47a2c-b3b7-3c44-9a19-934e6ad9ec36",
                                "text": "La supériorité de justesse de l’obus cylindro-ogival ayant deux calibres de longueur, sur le projectile cylindro-conique, est de plus en plus prononcée à mesure que la distance augmente."
                            },
                            {
                                "example_id": "96d00091-2376-431c-86e3-c1deb5eed250",
                                "sense_id": "bab47a2c-b3b7-3c44-9a19-934e6ad9ec36",
                                "text": "La boule était à peine à trente mètres, que, pan ! elle éclatait, en dix morceaux, fracassée par le lingot cylindro-ogival."
                            },
                            {
                                "example_id": "e3a69878-1f76-49f1-a67c-6a462846ab66",
                                "sense_id": "bab47a2c-b3b7-3c44-9a19-934e6ad9ec36",
                                "text": "Au boulet métallique, mal stabilisé sur sa trajectoire, succède l’obus cylindro-ogival, ancêtre direct de celui que nous connaissons."
                            }
                        ]
                    }
                ],
