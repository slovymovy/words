                "senses": [
                    {
                        "sense_id": "bf65bb39-f1cc-35bf-a30f-2ca6e3b05d65",
                        "entry_id": "962ed5f1-9025-3a7a-b56b-0e199e2ef243",
                        "glosses": [
                            "Personnellement, en nommant par son nom la personne dont il s’agit. Ce terme est employé surtout lorsque, après avoir parlé de plusieurs personnes ou de plusieurs choses en général, on vient à en désigner particulièrement une ou plusieurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b3a3bde-7a8a-4f72-a8fe-aebdf76ea7ed",
                                "sense_id": "bf65bb39-f1cc-35bf-a30f-2ca6e3b05d65",
                                "text": "On accuse plusieurs personnes, et nommément tels et tels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db81e511-5a4d-4592-b6b5-fd464b921ce0",
                        "source_entry_id": "962ed5f1-9025-3a7a-b56b-0e199e2ef243",
                        "source_sense_id": "bf65bb39-f1cc-35bf-a30f-2ca6e3b05d65",
                        "target_lang_word": "namely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "namely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59aa2429-8112-38cd-abe0-bfc4e1a76ba2",
                                        "entry_id": "b55cbb72-25fd-30df-bd05-5e16d01dece0",
                                        "glosses": [
                                            "Specifically; that is to say."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88ff4b06-e13c-4e36-a2f7-f4f9df423511",
                                                "sense_id": "59aa2429-8112-38cd-abe0-bfc4e1a76ba2",
                                                "text": "Some of the students — namely Paul, Alice and Jake — seem to have trouble with geometry."
                                            },
                                            {
                                                "example_id": "9daca0a9-68f9-43bb-8c35-8b6078b59fd4",
                                                "sense_id": "59aa2429-8112-38cd-abe0-bfc4e1a76ba2",
                                                "text": "There are three ways to do it, namely the right way, the wrong way and the Army way."
                                            },
                                            {
                                                "example_id": "cb702b38-eb90-4230-b87f-6dc92dc4dec1",
                                                "sense_id": "59aa2429-8112-38cd-abe0-bfc4e1a76ba2",
                                                "text": "“The story of this adoption is, of course, the pivot round which all the circumstances of the mysterious tragedy revolved. Mrs. Yule had an only son, namely, William, to whom she was passionately attached ; but, like many a fond mother, she had the desire of mapping out that son's future entirely according to her own ideas.[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1051f77a-d4e3-3579-8f54-4237fb34779c",
                                        "entry_id": "b55cbb72-25fd-30df-bd05-5e16d01dece0",
                                        "glosses": [
                                            "Especially, above all."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95823bf1-8353-45dd-b250-8ebef2f89d6f",
                                                "sense_id": "1051f77a-d4e3-3579-8f54-4237fb34779c",
                                                "text": "THus was sir Tramtryst longe there wel cherysshed / with the kynge and the quene / and namely with la beale Isoud / So vpon a daye / the quene and la beale Isoud made a bayne for syre Tramtryst / And whan he was in his bayne / the quene and Isoud her doughter romed vp & doune in the chamber"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "namely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "181720d5-4045-3be6-a69b-4ba37d3381e1",
                                        "entry_id": "8d980857-0711-3064-88fc-74acc4081e0f",
                                        "glosses": [
                                            "Notable, distinguished; famous, renowned; well-known."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d479afe1-4b49-4f78-a25a-b335d263de36",
                                                "sense_id": "181720d5-4045-3be6-a69b-4ba37d3381e1",
                                                "text": "[…] and certainly there was no namelier king in Scotland for building churches and developing the communities of the land into free towns or burghs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
