                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bak",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "82a388bb-1271-3e7a-b3ab-4f31b513a2f7",
                                        "entry_id": "7daf8020-e9ec-3615-b06e-8c85aade0a47",
                                        "glosses": [
                                            "zbiornik na paliwo w samochodzie, motocyklu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5e5918d-2b86-4857-b5ad-ae0e7496aba0",
                                                "sense_id": "82a388bb-1271-3e7a-b3ab-4f31b513a2f7",
                                                "text": "Zostało mi niewiele w baku, więc zatankowałem do pełna."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "5b879f74-1c88-395d-bd4d-706ba8e275c8",
                                        "entry_id": "7daf8020-e9ec-3615-b06e-8c85aade0a47",
                                        "glosses": [
                                            "zawartość baku (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7dd76bcc-c81e-4029-a5bd-e755258e99eb",
                                                "sense_id": "5b879f74-1c88-395d-bd4d-706ba8e275c8",
                                                "text": "Na wyjazd w Bieszczady zużyłem dwa baki i nic już nie zostało w zbiorniku."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "3753aee1-a084-3d45-8706-6387c311848e",
                                        "entry_id": "7daf8020-e9ec-3615-b06e-8c85aade0a47",
                                        "glosses": [
                                            "zarost na policzkach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "750f165f-6175-4cd1-81ec-504ca79c2e50",
                                                "sense_id": "3753aee1-a084-3d45-8706-6387c311848e",
                                                "text": "Mały wąsik pod kulfoniastym nosem poruszył się na boki, a ręka poprawiła błyskawicznie monokl i wygładziła siwiejące baki. Szczupaczyńska dostrzegła, że łysinę zasłaniała pożyczka, finezyjna wprawdzie, lecz dalece niewystarczająca."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "43ec7c60-faaf-3a19-9f68-d9c8b551bd26",
                                        "entry_id": "7daf8020-e9ec-3615-b06e-8c85aade0a47",
                                        "glosses": [
                                            "skrajna część pokładu położona najbliżej dziobu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "019bb50f-5d3d-45f8-81b8-473a044090d6",
                                                "sense_id": "43ec7c60-faaf-3a19-9f68-d9c8b551bd26",
                                                "text": "W bakiście pod bakiem trzymam kotwicę."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "4d9f01fa-6b6f-3f66-ac22-a0c3286ff583",
