                        "glosses": [
                            "Gerät, mit dem man bestimmen kann, in welcher Höhe man sich befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbf4f4b1-3210-48b6-9555-853f02b9c28a",
                                "sense_id": "14333a83-d0e2-3452-a54d-b64c73117bf6",
                                "text": "„Wir kommen nun zum höchsten Punkt unserer Reise, mein Höhenmesser zeigt fast dreitausend Meter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a6fdadb-f3e2-4d08-92e7-39dd8ca8f8fe",
                        "source_entry_id": "1556b6d6-97a3-3275-9f90-02f61c162f3b",
                        "source_sense_id": "14333a83-d0e2-3452-a54d-b64c73117bf6",
                        "source_sense_description": "Gerät, mit dem man bestimmen kann, in welcher Höhe man sich befindet",
                        "target_lang_word": "altimeter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altimeter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29055d43-31fc-3956-bbae-7f4896b490eb",
                                        "entry_id": "815a07f4-b986-33fa-9526-ca75eb0363b2",
                                        "glosses": [
                                            "An apparatus for measuring altitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d88e9ed9-294b-43cf-a55e-d49613bbe009",
                                                "sense_id": "29055d43-31fc-3956-bbae-7f4896b490eb",
                                                "text": "For that reason, if you do any mountain climbing, allow a generous margin of error of extra altitude—not only for possible altimeter error, but also for downdrafts that are particularly prevalent if high winds are encountered."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
