                    {
                        "translation_id": "1c0de211-2a2e-4cf3-881b-aee0c3eb0296",
                        "source_entry_id": "bb94a706-f10e-369d-8167-8c826c8eb8bc",
                        "source_sense_id": "c69f9d48-4b98-35bf-9f43-96734ed3add3",
                        "target_lang_word": "Stiefvater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stiefvater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                        "entry_id": "69b5ee0d-3122-3224-b605-88f1d9e34246",
                                        "glosses": [
                                            "der nach einer Wiederverheiratung der Mutter (infolge von Tod oder Scheidung) neue Ehemann der Mutter, der mit seinem Stiefkind (Stieftochter, Stiefsohn) nicht leiblich verwandt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beb013db-d4c2-48bc-878c-5ca990980073",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "Ich verstehe mich mit meinem Stiefvater sehr gut."
                                            },
                                            {
                                                "example_id": "b45e97df-a572-4b9e-83e0-a6e9b8ad7f5c",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "„Der Stiefvater wusste, dass der Oberst ein Theaterliebhaber war und hatte ihm von dem Theaterinteresse seines Stiefsohnes erzählt.“"
                                            },
                                            {
                                                "example_id": "a85c7a71-419d-41d2-a37d-f0b6a5997424",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "„Damals bekam Lea fast gleichzeitig mit einer Adoptivschwester auch einen Stiefvater.“"
                                            },
                                            {
                                                "example_id": "6a13b6a1-cf1d-402c-a5a8-24e184bf7338",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "„Dass sein Stiefvater Ingvald sich noch mehr über seine Besuche freute und sie als Ritterschlag wertete, ahnte der Junge nicht.“"
                                            },
                                            {
                                                "example_id": "dc389e1b-1fc2-4a43-82a7-fb9a943bf339",
                                                "sense_id": "a024be4a-6834-3c51-97ea-22f9ce4dfeed",
                                                "text": "„Der Stiefvater zuckt die Achseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
