                        "entry_id": "1ed3890c-b608-33c1-bdd6-5bb5ffc6fd79",
                        "glosses": [
                            "eine Gattung europäischer Orchideenarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c90e84fb-1615-4b9b-8cc4-9095c340646d",
                                "sense_id": "f4adeedb-2abe-3239-85b9-4dd23da0fb78",
                                "text": "„Auffallend bei den Ragwurzen sind die sehr farbenprächtigen und außergewöhnlich geformten Blüten, wobei die Lippen oft Insekten ähneln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20cb5ce1-436a-4b6a-bf75-0816e83b8954",
                        "source_entry_id": "1ed3890c-b608-33c1-bdd6-5bb5ffc6fd79",
                        "source_sense_id": "f4adeedb-2abe-3239-85b9-4dd23da0fb78",
