    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f04492ae-a7bc-33c5-b108-53254f6fa46b",
                    "sense_definition": "Anhaltender Anstieg des allgemeinen Preisniveaus in einer Wirtschaft und der damit einhergehende Verlust der Kaufkraft des Geldes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wirtschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wegen der hohen <w>Inflation</w> können sich viele Menschen das tägliche Leben kaum noch leisten."
                        },
                        {
                            "text": "Die Zentralbank versucht mit allen Mitteln, die steigende <w>Inflation</w> wirksam zu bremsen."
                        }
                    ],
                    "synonyms": [
                        "Preissteigerung",
                        "Teuerung",
                        "Preisauftrieb",
                        "Währungsinflation"
                    ],
                    "antonyms": [
                        "Deflation"
                    ],
                    "common_phrases": [
                        "steigende Inflation",
                        "hohe Inflation",
                        "galoppierende Inflation"
                    ]
                },
                {
                    "sense_id": "886b2fc6-0229-3fbf-8d16-5ce2d0d7a2c6",
                    "sense_definition": "Geschichtlicher Zeitabschnitt oder Phase, in der eine besonders starke Geldentwertung stattfindet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wirtschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Familien verloren während der großen <w>Inflation</w> im Jahr 1923 all ihre Ersparnisse."
                        },
                        {
                            "text": "Die wirtschaftliche Krise nach dem Krieg führte zu einer schweren <w>Inflation</w> im ganzen Land."
                        }
                    ],
                    "synonyms": [
                        "Inflationszeit",
                        "Inflationsphase"
                    ],
                    "common_phrases": [
                        "während der Inflation"
                    ]
                },
                {
                    "sense_id": "894b1376-405f-383d-8637-687cf5c61d2d",
                    "sense_definition": "Starkes, oft übermäßiges oder unerwünschtes Anwachsen der Häufigkeit von etwas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In den letzten Jahren beobachten Experten eine regelrechte <w>Inflation</w> von neuen Modewörtern in den Medien."
                        },
                        {
                            "text": "Die ständige <w>Inflation</w> akademischer Titel führt dazu, dass einzelne Abschlüsse an Wert verlieren."
                        }
                    ],
                    "common_phrases": [
                        "Inflation von Begriffen"
                    ]
                },
                {
                    "sense_id": "6bdabdbe-635f-3d40-bd4f-eb01a47ed7b4",
                    "sense_definition": "Phase extrem schneller Ausdehnung des Universums unmittelbar nach dem Urknall.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Physiker untersuchen noch immer die genauen Vorgänge während der kosmischen <w>Inflation</w> nach dem Urknall."
                        },
                        {
                            "text": "Kurz nach der Entstehung des Weltalls kam es zu einer extrem schnellen <w>Inflation</w> des Raumes."
                        }
                    ],
                    "common_phrases": [
                        "kosmische Inflation"
                    ]
                }
            ]
        }
    ]
