                            "plural"
                        ],
                        "form": "die Landgrafen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d45bb40c-9437-322c-89a7-cbdda3dc493c",
                        "entry_id": "89f73bc9-bb9d-38b5-a072-ebaae8200457",
                        "glosses": [
                            "Adelstitel, der im Rang höher als der eines Grafen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63a6b201-018c-4c40-8647-63c2fb52c3a1",
                                "sense_id": "d45bb40c-9437-322c-89a7-cbdda3dc493c",
                                "text": "„Dem entsprechend nannte sich H. [Heinrich I.] in seinen Urkunden nicht mehr von Thüringen, behielt jedoch den Titel Landgraf von seiner mütterlichen Abkunft her bei und verband damit den eines Herrn des Landes Hessen.“"
                            },
                            {
                                "example_id": "9513d95d-cd28-4647-aa0d-565b824acd8c",
                                "sense_id": "d45bb40c-9437-322c-89a7-cbdda3dc493c",
                                "text": "„Schon in jungen Jahren musste der Sohn des Landgrafen Philipp I. von Hessen die Regierungsgeschäfte mit übernehmen, als sein Vater plötzlich in Gefangenschaft geriet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fea96bcb-c9b6-3a11-9fa2-a8df743e9365",
                        "entry_id": "89f73bc9-bb9d-38b5-a072-ebaae8200457",
                        "glosses": [
                            "Träger des Adelstitels [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa93c70-36bf-48c6-9a42-7b692ecf600e",
                                "sense_id": "fea96bcb-c9b6-3a11-9fa2-a8df743e9365",
                                "text": "„Kassel, bereits im 10. Jahrhundert erwähnt, wurde im 13. Jahrhundert durch die Landgrafen von Thüringen zur Stadt erklärt und 1277 Residenzstadt der Landgrafen von Hessen (seit 1567 von Hessen-Kassel).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
