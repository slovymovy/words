                        "glosses": [
                            "met meewerkend voorwerp wat volgens de zeden en normen zo zou moeten zijn"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b08b01cb-d185-4255-b31c-cb9a3465cfbc",
                                "sense_id": "64604621-abd9-3157-8bc7-3210f186f3e7",
