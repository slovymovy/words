                        "glosses": [
                            "Mangel an Arbeitskräften; Arbeitskräfte sind nicht in ausreichender Menge verfügbar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7b1edf0-53ac-436c-86c0-212825450741",
                                "sense_id": "009873be-9bf8-3814-9d3f-8f9bc9a4b6cc",
                                "text": "Die Produktion konnte wegen des herrschenden Arbeitskräftemangels nicht ausgeweitet werden."
                            },
                            {
                                "example_id": "e5c208ef-2480-40dd-b652-2d8b89d65b9b",
                                "sense_id": "009873be-9bf8-3814-9d3f-8f9bc9a4b6cc",
                                "text": "„Hier herrscht Arbeitskräftemangel, denn die Menschen, die dort leben, vermieten lieber Omas Häuschen als Ferienwohnung im Sommer und holen sich Hartz IV im Winter, statt für wenig Geld rund ums Jahr arbeiten zu gehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
