                ],
                "senses": [
                    {
                        "sense_id": "3e742a14-076e-3b96-a759-f31da9dc06ef",
                        "entry_id": "0bfb41f6-3ffc-32d2-8f70-750c8953b893",
                        "glosses": [
                            "Demi-pique dont les officiers subalternes d’infanterie étaient armés."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "26f5f167-87aa-4720-aedb-20ef7e82847a",
                                "sense_id": "3e742a14-076e-3b96-a759-f31da9dc06ef",
                                "text": "Lorsque le Roi passe à la tête de l'infanterie qui est en bataille, les officiers sont répartis dans tout le front du bataillon, tenant l'esponton de la main droite à côté d'eux, la main à hauteur de l'oeil."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e454d31-3b05-3ab1-88a1-fb6e2d0102a5",
                        "entry_id": "0bfb41f6-3ffc-32d2-8f70-750c8953b893",
                        "glosses": [
                            "Arme d'abordage des marins."
                        ],
                        "tags": [
                            "Armement"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3f921aa1-61a2-387f-a0db-e3072b791671",
                        "entry_id": "0bfb41f6-3ffc-32d2-8f70-750c8953b893",
                        "glosses": [
                            "Partie inférieure arrondie en fuseau et couronnée d'un cordon, d'un barreau de grille."
                        ],
                        "tags": [
                            "Serrurerie"
                        ],
                        "examples": [
                            {
                                "example_id": "50c8e277-ba83-48d4-9f0b-0ac90a796b6e",
                                "sense_id": "3f921aa1-61a2-387f-a0db-e3072b791671",
                                "text": "On appelle Grilles à Esponton celles auxquelles l'extrémité des barres, au lieu d'être en pointe ou en flamme ondoyante, est terminée par des fers de piques."
                            }
                        ]
                    }
                ],
