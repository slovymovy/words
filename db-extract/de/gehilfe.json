                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a9f02bb-abd0-4660-9c2e-f96c83026948",
                                                "sense_id": "2b4ed43f-720d-3f4f-86d0-6a55e3cf4ba3",
                                                "text": "Genius and learning […] are mutually and greatly assistant to each other."
                                            },
                                            {
                                                "example_id": "ddf0f04c-1841-4efd-827b-7a722e446c28",
                                                "sense_id": "2b4ed43f-720d-3f4f-86d0-6a55e3cf4ba3",
                                                "text": "The person principally assistant on this occasion, indeed the only one who did any service, or seemed likely to do any, was the landlady […]"
                                            }
                                        ]
                                    }
                                ]
                            },
