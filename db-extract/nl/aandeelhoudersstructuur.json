                        "examples": [
                            {
                                "example_id": "63df8014-011a-4a66-84d9-4201a4aaec8e",
                                "sense_id": "916a726c-0700-3805-ae21-83bd46fdd742",
                                "text": "Het vertrek van Aabar uit Daimler was al enige tijd verwacht. De Duitse autofabrikant liet weten de aandelenverkoop te respecteren en tevreden te zijn met de huidige aandeelhoudersstructuur."
                            },
                            {
                                "example_id": "193cae0d-dd57-41d5-9248-1df5eb949e4f",
                                "sense_id": "916a726c-0700-3805-ae21-83bd46fdd742",
                                "text": "Bij een overname moet de raad van bestuur, waaronder topman Feike Sijbesma, steun geven vanwege de aandeelhoudersstructuur van DSM. Het concern heeft een stichting die een beschermingswal op kan werpen bij een ongewenste poging."
                            },
                            {
                                "example_id": "6a2dc01a-c268-421e-ad93-eda9e8722292",
                                "sense_id": "916a726c-0700-3805-ae21-83bd46fdd742",
                                "text": "De ACM benadrukt dat er de laatste tijd al wel de nodige wijzigingen zijn doorgevoerd. Zo is de aandeelhoudersstructuur van TLS gewijzigd en zijn er nieuwe ondernemingen ontstaan die gebruik maken van de OV-chipkaart voor het aanbieden van mobiliteitsdiensten."
                            }
