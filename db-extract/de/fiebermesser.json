                        "entry_id": "35ee4268-5e02-3e7b-8b1f-ad2cfd411a0e",
                        "glosses": [
                            "Thermometer, mit dem die Körpertemperatur gemessen werden kann"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3a180351-9b8b-48f4-b1eb-2f24ce249913",
                                "sense_id": "0f346564-5f1b-3f57-b6cc-adec9ce7c1ae",
                                "text": "„Quecksilberthermometer aus Glas dürfen dagegen in Österreich seit 2006 nicht mehr verkauft werden. Denn zerbricht ein solcher Fiebermesser, kann das darin eingeschlossene Quecksilber entweichen und Vergiftungen auslösen.“"
                            },
                            {
                                "example_id": "9ee165ae-e5ac-4066-b711-ad66b2c94267",
                                "sense_id": "0f346564-5f1b-3f57-b6cc-adec9ce7c1ae",
                                "text": "„Fiebermesser und andere Thermometer mit Quecksilber sind gefährlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
