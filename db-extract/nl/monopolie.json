                ],
                "translations": [
                    {
                        "translation_id": "79c5fa5f-1ab4-427c-9c77-cc3fff091418",
                        "source_entry_id": "d8a2a03e-c4d6-3456-8b85-2756fef12796",
                        "source_sense_id": "798fa157-cb11-3831-b1b1-7ef6b7729ef5",
                        "source_sense_description": "het geheel beheersen van een markt door een enkele leverancier",
                        "target_lang_word": "Monopol",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monopol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef9f9b60-3ebc-302d-ae39-4d4c32472b2a",
                                        "entry_id": "b48a2155-5f81-3914-87a9-bd883350eace",
                                        "glosses": [
                                            "Marktform, in der es nur einen Anbieter gibt, um die Nachfrage zu befriedigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d012eac6-cba8-4c87-96ba-a0de7ae3adf7",
                                                "sense_id": "ef9f9b60-3ebc-302d-ae39-4d4c32472b2a",
                                                "text": "„Der grösste Schweizer Telekommunkationsanbieter, die vormals staatliche Swisscom, ist verpflichtet worden, ihr Monopol bei den Hausanschlüssen teilweise aufzugeben. Die letzte Meile soll damit schrittweise entbündelt werden.“ [Anmerkung: 'grösste' ist schweizer Rechtschreibung, die deutsche Rechtschreibung lautet 'größte']"
                                            },
                                            {
                                                "example_id": "ef6ca011-6d85-4a48-93e6-e3b2ae8963dd",
                                                "sense_id": "ef9f9b60-3ebc-302d-ae39-4d4c32472b2a",
                                                "text": "„Das brasilianische Monopol kollabiert.“"
                                            },
                                            {
                                                "example_id": "330b657c-7d53-4f58-b1a0-f159cdfdfd07",
                                                "sense_id": "ef9f9b60-3ebc-302d-ae39-4d4c32472b2a",
                                                "text": "„Er hat das Monopol auf Elfenbein sowie im Sklaven- und Pfefferhandel.“"
                                            },
                                            {
                                                "example_id": "6b5eaf32-106d-4d15-9e36-76c63333e14b",
                                                "sense_id": "ef9f9b60-3ebc-302d-ae39-4d4c32472b2a",
                                                "text": "„Die Hudson's Bay Company war 1670 gegründet worden und hatte seitdem das Monopol für den Pelzhandel im Norden des amerikanischen Kontinents bis hinauf in die Arktis.“"
                                            },
                                            {
                                                "example_id": "9af18dbc-9c92-470e-ba6c-dfe9ac23174d",
                                                "sense_id": "ef9f9b60-3ebc-302d-ae39-4d4c32472b2a",
                                                "text": "„Hier arbeitet ein mächtiges Unternehmen [Google] systematisch daran, eines seiner erfolgreichsten Produkte [Chrome] in ein weiteres Monopol zu verwandeln.“"
                                            },
                                            {
                                                "example_id": "a1790e6f-36b5-4605-bc14-a8827d74595e",
                                                "sense_id": "ef9f9b60-3ebc-302d-ae39-4d4c32472b2a",
                                                "text": "„Googles Monopol beim Appstore stört [die EU-Kommission] offenbar nicht.“"
                                            },
                                            {
                                                "example_id": "56c9c723-7d5c-45be-a5b3-2ffe5022a59a",
                                                "sense_id": "ef9f9b60-3ebc-302d-ae39-4d4c32472b2a",
                                                "text": "„Unter den freien Mobilsystemen hat Android [von Google] beinahe ein Monopol. Während mehrere Alternativen existieren, konnte keine davon nennenswerte Anteile erreichen.“"
                                            },
                                            {
                                                "example_id": "ad114ac8-f3ca-452f-836f-86963dc008d8",
                                                "sense_id": "ef9f9b60-3ebc-302d-ae39-4d4c32472b2a",
                                                "text": "„Die US-Wettbewerbsbehörde FTC hatte bis 2010 Vorwürfe untersucht, wonach Intel über ein ganzes Jahrzehnt hinweg seine marktbeherrschende Stellung missbraucht, den Wettbewerb erstickt und sein Monopol gestärkt haben soll.“"
                                            },
                                            {
                                                "example_id": "a2346e92-c2c1-478a-8acd-357cf72ddab5",
                                                "sense_id": "ef9f9b60-3ebc-302d-ae39-4d4c32472b2a",
                                                "text": "„»In dem Fall vor diesem Gericht geht es um die Tatsache, dass Qualcomm sein Monopol genutzt hat, um ungerechte Preise durchzusetzen, den Wettbewerb zu ersticken. Mit diesem Monopol wurden Vertragsbedingungen selbst bei einigen der größten und mächtigsten Unternehmen der Welt durchgedrückt, denen rational handelnde Unternehmen in einer Million Jahren niemals zustimmen würden«, sagte Cordell.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9132d21-d37a-3cd0-ae10-9f0fd093d7d9",
                                        "entry_id": "b48a2155-5f81-3914-87a9-bd883350eace",
                                        "glosses": [
                                            "Alleinstellung hinsichtlich einer bestimmten Leistung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3bb3c7b-6755-4d64-b6bf-27306ed985ef",
                                                "sense_id": "b9132d21-d37a-3cd0-ae10-9f0fd093d7d9",
                                                "text": "„Thomasius wandte sich dabei gegen den herkömmlichen Lehrbetrieb der Universitäten, gegen das Monopol des Lateinischen, gegen die ›scholastische‹ Methode und metaphysische Spekulation in der Wissenschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Monopol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f93ebf11-fb07-3534-9683-12a7185e349c",
                                        "entry_id": "b57a2938-d48e-3935-9f3a-240b9160dfc9",
                                        "glosses": [
                                            "einzelner Pol, der entweder positiv oder negativ geladen ist und keinen Gegenpol besitzt"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09fc0622-8887-49a3-9c8f-896bb902e523",
                                                "sense_id": "f93ebf11-fb07-3534-9683-12a7185e349c",
                                                "text": "„Der englische Physiker P. Dirac (1902—1984) fand jedoch heraus, daß man bei Existenz eines magnetischen Monopols die Quantisierung der elektrischen Ladung gut verstehen könnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6373c82f-d560-4497-aceb-ff95404c8b88",
                        "source_entry_id": "d8a2a03e-c4d6-3456-8b85-2756fef12796",
                        "source_sense_id": "798fa157-cb11-3831-b1b1-7ef6b7729ef5",
                        "source_sense_description": "het geheel beheersen van een markt door een enkele leverancier",
                        "target_lang_word": "monopoly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monopoly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f879f33-a938-3a24-ae2a-b40deac533ed",
                                        "entry_id": "c3e23315-309e-3b1e-bf7a-815101ece34c",
                                        "glosses": [
                                            "A situation, by legal privilege or other agreement, in which solely one party (company, cartel etc.) exclusively provides a particular product or service, dominating that market and generally exerting powerful control over it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9cb4c0a-9f3d-426f-9795-cbc70891d3b4",
                                                "sense_id": "2f879f33-a938-3a24-ae2a-b40deac533ed",
                                                "text": "The sale of the leaves and roots was a Government monopoly, and from it the Kings of Kôr derived a large proportion of their private revenue."
                                            },
                                            {
                                                "example_id": "ab2d8c7d-3767-4ccc-aa41-100b64264afa",
                                                "sense_id": "2f879f33-a938-3a24-ae2a-b40deac533ed",
                                                "text": "In 1918 a Chinese company was given a monopoly to run a service between Victoria and the districts of Mong Kok and Sham Shui Po. Five years later this monopoly was transferred to the Hong Kong and Yaumati Ferry Company, together with the right to run a service to Yau Ma Tei."
                                            },
                                            {
                                                "example_id": "893823b3-60fa-45d3-8441-9b486f0216d6",
                                                "sense_id": "2f879f33-a938-3a24-ae2a-b40deac533ed",
                                                "text": "It has jailed environmental activists and is planning to limit the power of judicial oversight by handing a state-approved body a monopoly over bringing environmental lawsuits."
                                            },
                                            {
                                                "example_id": "165d1f0f-d9f7-4e13-99ed-b4b76370c66a",
                                                "sense_id": "2f879f33-a938-3a24-ae2a-b40deac533ed",
                                                "text": "Exactly! You can’t reduce the competition when nobody is competing! You could not be describing a monopoly more clearly if you were wearing a metal top hat while driving a metal car after winning second prize in a beauty contest!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8da2a766-977d-3cb0-a854-8e55eb32f23d",
                                        "entry_id": "c3e23315-309e-3b1e-bf7a-815101ece34c",
                                        "glosses": [
                                            "An exclusive control over the trade or production of a commodity or service through exclusive possession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b557523-c769-4ca8-b15a-6147af5bb34e",
                                                "sense_id": "8da2a766-977d-3cb0-a854-8e55eb32f23d",
                                                "text": "A land monopoly renders its holder(s) nearly almighty in an agricultural society."
                                            },
                                            {
                                                "example_id": "9433aa29-b8b1-4e22-b63b-607f8b7e6851",
                                                "sense_id": "8da2a766-977d-3cb0-a854-8e55eb32f23d",
                                                "text": "Монополисти́ческое облада́ние важне́йшими исто́чниками сыры́х материа́лов стра́шно увели́чило власть кру́пного капита́ла и обостри́ло противоре́чие ме́жду картелли́рованной и некартелли́рованной промы́шленностью.",
                                                "translation": "Vladimir Lenin",
                                                "english": "Vladimir Lenin"
                                            },
                                            {
                                                "example_id": "5617589b-6f3c-4fd5-9de7-4faf01d89803",
                                                "sense_id": "8da2a766-977d-3cb0-a854-8e55eb32f23d",
                                                "text": "My great grandfather had the monopoly of eggs in all of China and my grandmother was super rich living in a mansion when the cultural revolution happened and communism took everything away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8967d7f4-65f6-3358-9e81-93f860da2901",
                                        "entry_id": "c3e23315-309e-3b1e-bf7a-815101ece34c",
                                        "glosses": [
                                            "The privilege granting the exclusive right to exert such control."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d9b8595-5105-4719-b428-44d5bcc4ab6a",
                                                "sense_id": "8967d7f4-65f6-3358-9e81-93f860da2901",
                                                "text": "Granting monopolies in concession constitutes a market-conform alternative to taxation for the state, while the crown sometimes bestowed a monopoly as an outrageous gift."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "668efdd2-11d7-33a5-ae04-d374065213aa",
                                        "entry_id": "c3e23315-309e-3b1e-bf7a-815101ece34c",
                                        "glosses": [
                                            "The market thus controlled."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "baf6625a-2d16-3d52-b4e8-701962c8e298",
                                        "entry_id": "c3e23315-309e-3b1e-bf7a-815101ece34c",
                                        "glosses": [
                                            "The holder (person, company or other) of such market domination in one of the above manners."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f76ac50b-c055-41d4-832e-e38dddfa8b10",
                        "source_entry_id": "d8a2a03e-c4d6-3456-8b85-2756fef12796",
                        "source_sense_id": "798fa157-cb11-3831-b1b1-7ef6b7729ef5",
                        "source_sense_description": "het geheel beheersen van een markt door een enkele leverancier",
                        "target_lang_word": "monopole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monopole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "623500c5-e304-3676-8dd2-96395aae0748",
                                        "entry_id": "396d40c5-ce35-3481-a73a-7091a4e39e1c",
                                        "glosses": [
                                            "Trafic exclusif, fait en vertu d’un privilège."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97831a80-9b92-4a75-bb5d-cd118683646c",
                                                "sense_id": "623500c5-e304-3676-8dd2-96395aae0748",
                                                "text": "C’est dire que nos banques devraient cesser de vivre sous l’empire d’un monopole aussi absolu qu’injuste et funeste."
                                            },
                                            {
                                                "example_id": "41db88dd-3347-4c5f-831c-128a43aff063",
                                                "sense_id": "623500c5-e304-3676-8dd2-96395aae0748",
                                                "text": "Gênés par le monopole des agents de change, les coulissiers de la Bourse sont aussi des prolétaires financiers, et parmi eux de rencontre plus d’un socialiste admirateur de Jaurès."
                                            },
                                            {
                                                "example_id": "9bfff0c6-4c72-4212-8b06-b8b54194b802",
                                                "sense_id": "623500c5-e304-3676-8dd2-96395aae0748",
                                                "text": "Ces différentes laines, comme le poil de chameau, sont filées à Bradford qui a le monopole de ce travail."
                                            },
                                            {
                                                "example_id": "0273e6a5-686d-45dc-8315-ae4fc2206161",
                                                "sense_id": "623500c5-e304-3676-8dd2-96395aae0748",
                                                "text": "À l’abri du monopole et de la paix qui en résultait, les Groenlandais se multiplièrent et aujourd’hui, deux cents ans après l’arrivée de Hans Egede, ils sont au nombre de 15.000 […]"
                                            },
                                            {
                                                "example_id": "e4837ed3-8d98-4999-98b8-36f0c77ae9ce",
                                                "sense_id": "623500c5-e304-3676-8dd2-96395aae0748",
                                                "text": "À Arles, l’archevêque, qui avait le monopole de l’exploitation de la graine d’écarlate, avec laquelle on fabriquait le teinture rouge, ne traitait, pour la vente de ses récoltes, qu’avec les juifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5551886-b229-3bf7-bce4-898814591c2b",
                                        "entry_id": "396d40c5-ce35-3481-a73a-7091a4e39e1c",
                                        "glosses": [
                                            "Trafic d’un marchand ou de plusieurs marchands réunis, qui, par de larges achats, se rendent maîtres du commerce d’une marchandise."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70c6e207-5075-4379-b7d2-9b82b6424f3c",
                                                "sense_id": "b5551886-b229-3bf7-bce4-898814591c2b",
                                                "text": "Je ne leur ôte aucun profit honnête, aucune propriété légitime ; je ne leur ôte que le droit d’attenter à celle d’autrui ; je ne détruis point le commerce, mais le brigandage du monopole ; je ne les condamne qu’à la peine de laisser vivre leurs semblables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9923c9e-36ba-33d1-9d84-d70c6c197680",
                                        "entry_id": "396d40c5-ce35-3481-a73a-7091a4e39e1c",
                                        "glosses": [
                                            "Exclusivité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d32a2d9d-1bb6-4b94-ae58-57cc378e1a45",
                                                "sense_id": "f9923c9e-36ba-33d1-9d84-d70c6c197680",
                                                "text": "On aurait pu croire que le rabbinat du Nord-Est dénué de toute culture générale, détenait le monopole de l’étroitesse d’esprit."
                                            },
                                            {
                                                "example_id": "555ceff1-cfbb-401f-9b93-67d2290eddb0",
                                                "sense_id": "f9923c9e-36ba-33d1-9d84-d70c6c197680",
                                                "text": "A cette époque, aux États Unis, les Blancs qui militent aux côtés des Noirs contre les discriminations raciales, sont progressivement exclus de toute alliance de long terme avec les Noirs. La lutte contre le racisme devient un monopole Noir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "monopole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8675536d-f0d7-33d3-80c1-dfb8dc173e70",
                                        "entry_id": "63565d97-f787-3e44-9fe0-8dc7f5c94deb",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de monopoler."
                                        ],
