                "forms": [
                    {
                        "form_id": "a66214d9-c12e-4630-a575-4e5ab194825f",
                        "entry_id": "8ba3501b-c815-3c81-8b92-5e5fd422af97",
                        "tags": [
                            "plural"
                        ],
                        "form": "licous"
                    },
                    {
                        "form_id": "607b59f5-77ef-4e9d-b506-0974d0e503a2",
                        "entry_id": "8ba3501b-c815-3c81-8b92-5e5fd422af97",
                        "tags": [],
                        "form": "licol"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "08e4bcd2-cda6-3ab1-a7f7-0cb10baadce3",
                        "entry_id": "8ba3501b-c815-3c81-8b92-5e5fd422af97",
                        "glosses": [
                            "Lien de cuir, de corde ou de crin, qu’on met autour de la tête des chevaux, des mulets et d’autres bêtes de somme, pour les attacher au moyen d’une ou deux longes au râtelier, à l’auge, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2940cf0-7292-45fa-a2f8-4cdd689b1b05",
                                "sense_id": "08e4bcd2-cda6-3ab1-a7f7-0cb10baadce3",
                                "text": "Le licou de ce cheval est cassé, mettez une longe à ce licou."
                            },
                            {
                                "example_id": "1a887936-da5f-4db4-a6bd-cfc88b9ade5a",
                                "sense_id": "08e4bcd2-cda6-3ab1-a7f7-0cb10baadce3",
                                "text": "Marie-toi, va ! Le plus mauvais mariage est meilleur que le plus doux de ces licous !"
                            },
                            {
                                "example_id": "9224d269-d38d-4582-b60e-5e3c3c557a54",
                                "sense_id": "08e4bcd2-cda6-3ab1-a7f7-0cb10baadce3",
                                "text": "Ces diaboliques bêtes sortaient de l’écurie debout sur leurs pieds de derrière, et ce n’était qu’au moyen d’une grappe de postillons suspendus à leur licou qu’on parvenait à les réduire à l’état de quadrupède."
                            },
                            {
                                "example_id": "75966321-5393-4b24-831e-3b677c19c79b",
                                "sense_id": "08e4bcd2-cda6-3ab1-a7f7-0cb10baadce3",
                                "text": "Il se mit donc à pied et prit par le licou la rosse engourdie qu’il traînait ainsi dans les montées et retenait dans les descentes."
                            },
                            {
                                "example_id": "22754e06-b1a9-423c-b004-168357b4960f",
                                "sense_id": "08e4bcd2-cda6-3ab1-a7f7-0cb10baadce3",
                                "text": "C’est une entreprise difficile, pour un homme seul, que de transformer en licou le lasso même qui tient un cheval à demi sauvage de quatre ou cinq ans."
                            },
                            {
                                "example_id": "c6a0a54c-73c4-48cb-819d-91771d1fed5a",
                                "sense_id": "08e4bcd2-cda6-3ab1-a7f7-0cb10baadce3",
                                "text": "L’enfant tenta de remettre le licou à sa place, et n'y parvint pas, car le chevreau tirait toujours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4650b29-5a27-4a64-8702-06b25e693b56",
                        "source_entry_id": "8ba3501b-c815-3c81-8b92-5e5fd422af97",
                        "source_sense_id": "08e4bcd2-cda6-3ab1-a7f7-0cb10baadce3",
                        "target_lang_word": "Halfter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halfter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d096743d-c681-3fde-babc-aba6d407157d",
                                        "entry_id": "0f04404e-1125-39eb-b2ff-abd57077efe2",
                                        "glosses": [
                                            "(anfänglich nur am Sattel inzwischen auch am Gürtel) getragene Tasche für eine Pistole"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5058ebe8-e405-4590-8b3a-837a01dcb2aa",
                                                "sense_id": "d096743d-c681-3fde-babc-aba6d407157d",
                                                "text": "Der Wächter zog blitzschnell die Pistole aus dem Halfter."
                                            },
                                            {
                                                "example_id": "a13119d3-3c50-4a01-ab81-f243b64a0c6f",
                                                "sense_id": "d096743d-c681-3fde-babc-aba6d407157d",
                                                "text": "Trentowski fasste sich schnell und fiel dem Schimmel Maria Kasimiras in die Zügel, sie aber zog nicht minder rasch ihre Pistole aus dem Halfter und schoss sein Pferd nieder."
                                            },
                                            {
                                                "example_id": "e74ca47e-3fa1-41ab-81ae-4e1bcb5042b2",
                                                "sense_id": "d096743d-c681-3fde-babc-aba6d407157d",
                                                "text": "Er streichelt die russische Pistole, die in einem Halfter an seiner schusssicheren Weste befestigt ist, schiebt ein Hosenbein bis über das Knie und zeigt eine Narbe, die vom Schienbein bis zum Knöchel verläuft."
                                            },
                                            {
                                                "example_id": "025f3f43-1cdd-4c0e-b340-5902328c36b0",
                                                "sense_id": "d096743d-c681-3fde-babc-aba6d407157d",
                                                "text": "„Er nahm die Pistole aus dem Halfter und schoss dem Ulanen ein Loch in den Kopf.“"
                                            },
                                            {
                                                "example_id": "33246a54-0570-4b2a-aef1-502577ff6290",
                                                "sense_id": "d096743d-c681-3fde-babc-aba6d407157d",
                                                "text": "„Das Hemd stand ihm am Hals offen, und durch das Schulterstück auf der linken Seite war der Halfter von einem schwarzen Sam-Browne-Koppel gezogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Halfter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74d5e5e8-7eff-3aac-8475-f49e87b261a8",
                                        "entry_id": "dd5175aa-81b6-3cdd-80d6-bcb642b1e80b",
                                        "glosses": [
                                            "trensenloses Zaum mit Riemen zur Führung und Anbindung vom Pferd, Rind oder anderen Reittieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e9a19d-885d-4ba8-b461-1f360541b662",
                                                "sense_id": "74d5e5e8-7eff-3aac-8475-f49e87b261a8",
                                                "text": "Dem Pferd hatte man ein Halfter angelegt."
                                            },
                                            {
                                                "example_id": "abda6c19-7d46-4a04-883f-cb1a89c10464",
                                                "sense_id": "74d5e5e8-7eff-3aac-8475-f49e87b261a8",
                                                "text": "Plötzlich schnaubte das angebundene Pferd heftig und suchte das Halfter zu zerreißen, indem es im Galopp einen weiten Halbkreis beschrieb; die vom Halfter zerbrochenen Zweige krachten laut."
                                            },
                                            {
                                                "example_id": "670995f2-14f4-4b96-824d-f4403a7e4a3a",
                                                "sense_id": "74d5e5e8-7eff-3aac-8475-f49e87b261a8",
                                                "text": "[…]; der Reichgekleidete glitt anmutig zur Erde, ohne sein Kamel niedergehen zu lassen, warf seinem Begleiter den Halfter zu und sagte nachlässig: »Tränke sie, ich gehe derweil mich ausruhen.«"
                                            },
                                            {
                                                "example_id": "b11237c5-5ae9-486b-bf23-242a2f49cfa8",
                                                "sense_id": "74d5e5e8-7eff-3aac-8475-f49e87b261a8",
                                                "text": "„Am Halfter führt er ein zweites Pferd.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
