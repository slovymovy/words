                    {
                        "sense_id": "e015886f-d3fb-3ddb-a46c-4c89b9dcc623",
                        "entry_id": "20cf54c5-85cc-3ced-b22c-1ca2314dd45a",
                        "glosses": [
                            "Se dit d’une personne ayant une extraction noble, des origines nobles."
                        ],
                        "tags": [
                            "Absolument"
                        ],
                        "examples": [
                            {
                                "example_id": "15df79d5-fdb9-4486-a93d-fbd6a94d455c",
                                "sense_id": "e015886f-d3fb-3ddb-a46c-4c89b9dcc623",
                                "text": "Il n’est pas né."
                            },
                            {
                                "example_id": "3f5ee4e9-4754-4c78-b1c3-27ae05eb31f0",
                                "sense_id": "e015886f-d3fb-3ddb-a46c-4c89b9dcc623",
                                "text": "— Je donnerais bien la pièce d’or, disait une des figures singulières qui entouraient le docteur (Lucien apprit, en sortant, que c’était madame la marquise de Marcilly) ; mais ce M. Cochin, après tout, n’est pas né (n’est pas noble)."
                            },
                            {
                                "example_id": "ef56530d-5dd6-4c48-9662-c68b0dc870c6",
                                "sense_id": "e015886f-d3fb-3ddb-a46c-4c89b9dcc623",
                                "text": "C’est un jeune homme, un homme bien né."
                            }
                        ]
                    },
                    {
                        "sense_id": "61309919-aff1-338f-acb9-851bfa7d0465",
                        "entry_id": "20cf54c5-85cc-3ced-b22c-1ca2314dd45a",
                        "glosses": [
                            "Qui a de bonnes inclinations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a9dd6ec-034a-40f0-b550-eeec0abdfe3d",
                                "sense_id": "61309919-aff1-338f-acb9-851bfa7d0465",
                                "text": "Un enfant, une fille bien né."
                            }
                        ]
                    }
