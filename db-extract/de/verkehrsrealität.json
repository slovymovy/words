                "senses": [
                    {
                        "sense_id": "341539bf-eb50-38f2-95e7-73239abd1b87",
                        "entry_id": "00d8b794-5c75-3f40-9311-09189acd8a94",
                        "glosses": [
                            "faktische Gegebenheit des Verkehrslebens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81761eeb-80cc-4b4a-8d5d-acbab72400e4",
                                "sense_id": "341539bf-eb50-38f2-95e7-73239abd1b87",
                                "text": "„Die Verkehrsrealität zeigt, daß diese Aufgabe noch nicht zufriedenstellend gelöst worden ist.“"
                            },
                            {
                                "example_id": "b0827bd6-d8f5-41f5-a3b2-4235ad204d66",
                                "sense_id": "341539bf-eb50-38f2-95e7-73239abd1b87",
                                "text": "„Bereits im freien Spiel verwandelt das Kind die ihm fassbare Verkehrsrealität zu einer Spielrealität, sodass es in ihr denken, empfinden, handeln kann.“"
                            },
                            {
                                "example_id": "fdbd1ebf-e43e-4e57-b614-4003a5f959e2",
                                "sense_id": "341539bf-eb50-38f2-95e7-73239abd1b87",
                                "text": "„Mobilitätsbedürfnis und Verkehrsrealität entwickeln sich zu einem Gegensatz.“"
                            },
                            {
                                "example_id": "7ceed74f-d1df-49b2-bd3f-a1510e8266cb",
                                "sense_id": "341539bf-eb50-38f2-95e7-73239abd1b87",
                                "text": "„Die Schilder werden zuweilen mit wenig Sinn für Verkehrsrealität am grünen Tisch eingesetzt, und die beweglichen unter ihnen wurden Straßenbaufirmen zugeteilt, die sie oft von ausländischen Hilfsarbeitern aufstellen ließen.“"
                            },
                            {
                                "example_id": "c852e60a-7d75-4bcd-9564-236a2e3d7943",
                                "sense_id": "341539bf-eb50-38f2-95e7-73239abd1b87",
                                "text": "„Diese Szene, in ein paar Sekunden aus einem vorbeifahrenden Taxi heraus beobachtet, kennzeichnet einen Aspekt amerikanischer Verkehrsrealität, wie er in den letzten Jahren immer deutlicher wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
