                        "sense_id": "44a8ddf2-0624-383c-aee2-f1694aa667f6",
                        "entry_id": "7993590d-0bab-31d7-9652-2de97464e6cb",
                        "glosses": [
                            "to be unwilling to oblige; to disappoint, to inconvenience, not to cooperate."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "7e5673ea-d730-41cb-aefd-7316c63027c3",
                                "sense_id": "44a8ddf2-0624-383c-aee2-f1694aa667f6",
                                "text": "Sorry to disoblige everybody; I know you were depending on me to bring a good weather forecast for our fête, but it is going to rain."
                            },
                            {
                                "example_id": "89decd61-4402-4a9c-b93d-4b816dbea095",
                                "sense_id": "44a8ddf2-0624-383c-aee2-f1694aa667f6",
                                "text": "But Miss Frances married, in the common phrase, to disoblige her family, and by fixing on a Lieutenant of Marines, without education, fortune, or connexions, did it very thoroughly."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd2c6132-2425-3bec-a088-c2105c070e9f",
                        "entry_id": "7993590d-0bab-31d7-9652-2de97464e6cb",
                        "glosses": [
                            "To offend by an act of unkindness or incivility."
