                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben besloten om <w>alsnog</w> op vakantie te gaan.",
                            "target_lang_translations": {
                                "en": "We decided to go on vacation <w>after all</w>.",
                                "ru": "Мы решили <w>всё-таки</w> поехать в отпуск.",
                                "fr": "Nous avons décidé de partir <w>quand même</w> en vacances."
