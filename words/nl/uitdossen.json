            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5eec5242-cb73-333d-852d-3de06593e64f",
                    "sense_definition": "zich op opvallende, feestelijke of vreemde wijze kleden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verkleden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>dosten</w> zich met carnaval <w>uit</w> met veel veren en glitter.",
                            "target_lang_translations": {
                                "en": "During carnival, they <w>dressed up</w> with lots of feathers and glitter."
                            }
                        },
                        {
                            "text": "Voor het themafeest wilde hij zich als piraat <w>uitdossen</w>.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>dress up</w> as a pirate for the theme party."
                            }
                        }
                    ],
                    "synonyms": [
                        "verkleden",
                        "opsmukken",
                        "toetakelen"
                    ],
                    "common_phrases": [
                        "zich feestelijk uitdossen",
                        "zich als piraat uitdossen"
                    ],
                    "target_lang_definitions": {
                        "en": "To dress oneself in a striking, festive, or unusual manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dress up",
                                "target_lang_sense_clarification": "to wear special, fancy, or costume clothing"
                            },
                            {
                                "target_lang_word": "get dressed up",
                                "target_lang_sense_clarification": "to put on striking or festive clothes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92aa5f49-eabd-34fe-9a50-04cf880e2d72",
                    "sense_definition": "iemand of iets opvallend of overdreven versieren of kleden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "versieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De trotse ouders <w>dosten</w> hun kinderen prachtig <w>uit</w> voor de optocht.",
                            "target_lang_translations": {
                                "en": "The proud parents <w>dressed</w> their children <w>up</w> beautifully for the parade."
                            }
                        },
                        {
                            "text": "Ze hebben de etalage helemaal met kerstversiering <w>uitgedost</w>.",
                            "target_lang_translations": {
                                "en": "They have completely <w>decked out</w> the shop window with Christmas decorations."
                            }
                        }
                    ],
                    "synonyms": [
                        "versieren",
                        "toorneren",
                        "uitdossen"
                    ],
                    "common_phrases": [
                        "met pracht en praal uitdossen"
                    ],
                    "target_lang_definitions": {
                        "en": "To decorate or dress someone or something in a striking or exaggerated way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dress up",
                                "target_lang_sense_clarification": "to dress someone else in a costume or fancy clothes"
                            },
                            {
                                "target_lang_word": "deck out",
                                "target_lang_sense_clarification": "to decorate or dress someone or something elaborately"
                            },
                            {
                                "target_lang_word": "getup",
                                "target_lang_sense_clarification": "to dress up or decorate in an eye-catching way"
                            }
                        ]
                    }
                }
            ]
