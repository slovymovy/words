                },
                {
                    "sense_id": "efa3507e-5277-3448-8ca6-ce636e8b0b7f",
                    "sense_definition": "The act of quickly scanning or reading through something briefly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A quick <w>perusal</w> of the newspaper headlines gave him a general idea of the news.",
                            "target_lang_translations": {
                                "ru": "Быстрый <w>просмотр</w> газетных заголовков дал ему общее представление о новостях."
                            }
                        },
                        {
                            "text": "She gave the report a casual <w>perusal</w> before heading into the meeting.",
                            "target_lang_translations": {
                                "ru": "Она бегло <w>просмотрела</w> отчёт перед тем, как идти на совещание."
                            }
                        }
