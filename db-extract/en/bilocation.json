                                "example_id": "9db47e62-7c18-4ec2-b618-3a3537a25e5f",
                                "sense_id": "8d89b51d-d8f4-3dea-a3c7-2ce17a5bdabf",
                                "text": "Throyle explained about the mysterious shamanic power known as bilocation, which enables those with the gift literally to be in two or more places, often widely separated, at the same time."
                            }
                        ]
                    }
