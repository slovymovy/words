                "senses": [
                    {
                        "sense_id": "79c0b65c-d410-3f64-9867-0111e41bc8cb",
                        "entry_id": "81ca5c0a-a7fc-393b-b5f3-cc2ab724f982",
                        "glosses": [
                            "Schriftstück zur Befragung eines Beklagten oder Zeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97ad4386-853b-4c80-a9da-9779db919700",
                                "sense_id": "79c0b65c-d410-3f64-9867-0111e41bc8cb",
                                "text": "„Sofern Sie die Verteidigung durch eine Rechtsanwältin oder einen Rechtsanwalt mitgeteilt haben, erhält diese Person das Anhörungsschreiben zur Kenntnisnahme zugesandt.“"
                            },
                            {
                                "example_id": "105d5025-48d8-40a3-ab93-ce38c5911524",
                                "sense_id": "79c0b65c-d410-3f64-9867-0111e41bc8cb",
                                "text": "„In den Anhörungsschreiben, die von der Bußgeldstelle kommen, wird ihnen dann vorgeworfen, dass sie die Verkehrssicherheit massiv beeinträchtigen und andere Menschen gefährden würden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
