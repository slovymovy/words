                        "translation_id": "a4446a76-823f-46f1-8c4d-b2756bafa6a8",
                        "source_entry_id": "58979835-751d-3795-a93b-328d22c9f82d",
                        "source_sense_id": "965c9ca6-e01f-3842-8130-795c056cf09f",
                        "source_sense_description": "Technik, meist Raumfahrt: Ablations-",
                        "target_lang_word": "Ablation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ablation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "730add39-a9f5-3044-975c-511606c4ce0e",
                                        "entry_id": "1b445400-89dc-3c45-8cea-ff598c818994",
                                        "glosses": [
                                            "krankhafter Ablösungsprozess eines Organs oder Organteiles aus seinem Gesamtverbund"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b248af2-a292-4b7b-8bcb-7095dd2ac206",
                                                "sense_id": "730add39-a9f5-3044-975c-511606c4ce0e",
                                                "text": "Es handelte sich um eine Ablation der Netzhaut."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "284ffe7e-7dbe-32ff-b99b-ff38c03c3030",
                                        "entry_id": "1b445400-89dc-3c45-8cea-ff598c818994",
                                        "glosses": [
                                            "Entfernung von Organen oder Körpergeweben aufgrund einer medizinischen Indikation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81c1fac2-e74e-4d57-84a0-7cc2e8d73010",
                                                "sense_id": "284ffe7e-7dbe-32ff-b99b-ff38c03c3030",
                                                "text": "Von Ablation wird auch in der Tumor-Therapie gesprochen, wenn Tumorgewebe beispielsweise durch Hitze zerstört wird."
                                            },
                                            {
                                                "example_id": "f9506b86-22bb-4414-8436-d777c67d7c30",
                                                "sense_id": "284ffe7e-7dbe-32ff-b99b-ff38c03c3030",
                                                "text": "„Nach einer Beurteilung von vier verschiedenen Lasersystemen während umfangreicher In-vitro-Studien an Lämmerwirbelsäulen erwies sich der Ho:YAG-Laser aufgrund seiner Wellenlänge als am besten geeignet für die präzise Ablation des Epiphysengewebes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e9a131c6-0465-3410-9748-59158564f497",
                                        "entry_id": "1b445400-89dc-3c45-8cea-ff598c818994",
                                        "glosses": [
                                            "Abschmelzung von Schnee und Eis, insbesondere bei Gletschern, die durch Sonneneinstrahlung, Wind und Regen verursacht wird"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c9b11ea-21f3-45ee-9651-272203bcfaae",
                                                "sense_id": "e9a131c6-0465-3410-9748-59158564f497",
                                                "text": "„Zur Ablation zählt neben der durch regional unterschiedlich wirksame Ablationsfaktoren (Energiebilanz der Gletscheroberfläche) Abschmelzung (Ablation) in engerem Sinne auch Massenverlust durch Winddrift oder Lawinen und Kalbung (an polaren Eisschilden dominierender Faktor).“"
                                            },
                                            {
                                                "example_id": "d4a13b44-304a-4607-83aa-873860da401a",
                                                "sense_id": "e9a131c6-0465-3410-9748-59158564f497",
                                                "text": "„Für den 5. Mai von 9 bis 16 Uhr ergibt sich daraus eine freie Ablation von mehr als 46 mm Wasserschichtdicke oder bei einer angenommenen Schneedichte von 0,5 g cm - eine Abtragung von 1 cm der Schneedecke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "35ebc486-d9f3-3fd0-a1b9-9c59ed8106ed",
                                        "entry_id": "1b445400-89dc-3c45-8cea-ff598c818994",
                                        "glosses": [
                                            "Abtragung des Bodens, die durch Wind und Wasser verursacht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ddc4e1d-8311-4810-9f42-1baa0a81714f",
                                                "sense_id": "35ebc486-d9f3-3fd0-a1b9-9c59ed8106ed",
                                                "text": "„Nicht berücksichtigt bleibt dabei, daß im wissenschaftlichen deutschen Sprachgebrauch zwischen linienhafter Abtragung durch das Wasser (Erosion), flächenhafter Abtragung durch Schwerkraft und Wasser (Denudation) und durch Wind (Ablation) unterschieden wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4c1deaa9-e9e4-3a8f-8e38-ca507c252b31",
                                        "entry_id": "1b445400-89dc-3c45-8cea-ff598c818994",
                                        "glosses": [
                                            "Abtragung von Material, die durch hohe Hitzeeinwirkung verursacht wird"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c5af0e1-f7a5-4ee3-a403-607baa4fff62",
                                                "sense_id": "4c1deaa9-e9e4-3a8f-8e38-ca507c252b31",
                                                "text": "„Nach einer Beurteilung von vier verschiedenen Lasersystemen während umfangreicher In-vitro-Studien an Lämmerwirbelsäulen erwies sich der Ho:YAG-Laser aufgrund seiner Wellenlänge als am besten geeignet für die präzise Ablation des Epiphysengewebes.“"
                                            }
