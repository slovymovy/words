                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b2d7dc8-c98b-423e-8865-f9768a056454",
                        "source_entry_id": "5f791deb-fbf7-3c32-98e0-d4518a731b2a",
                        "source_sense_id": "cfa326d2-6b6b-3ce9-8728-a092859537ac",
                        "target_lang_word": "нейтрино",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нейтрино",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3fa4b3a9-6ea8-36d0-831d-33512ed94bb2",
                                        "entry_id": "34c38c64-3c2a-32bc-a167-bffa97ef8b25",
                                        "glosses": [
                                            "физ. электрически нейтральная стабильная элементарная частица со спином ½ и массой покоя много меньше массы электрона, участвующая только в слабых и в гравитационных воздействиях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30e050e4-e2b3-432f-9f44-db902840ba80",
                                                "sense_id": "3fa4b3a9-6ea8-36d0-831d-33512ed94bb2",
                                                "text": "Нобелевскими лауреатами по физике в этом году стали японец Такааки Кадзита и канадец Артур Макдональд, открывшие осцилляции нейтрино и тем самым подтвердившие наличие у этих частиц массы покоя."
                                            },
                                            {
                                                "example_id": "2ac384b4-1232-4e60-8720-2f5d684f23bc",
                                                "sense_id": "3fa4b3a9-6ea8-36d0-831d-33512ed94bb2",
                                                "text": "Я быстрое нейтрино, я лечу сквозь толщу и пустоту, и ничто не мешает мне прилететь к тебе на этом гравилете…"
                                            },
                                            {
                                                "example_id": "38161d77-857e-4a9a-b080-37a8c356526b",
                                                "sense_id": "3fa4b3a9-6ea8-36d0-831d-33512ed94bb2",
                                                "text": "Ведь физики говорят, что, кроме протона, есть еще позитрон, нейтрон, нейтрино, электрон…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
