                "senses": [
                    {
                        "sense_id": "05082678-5410-36ad-8132-f2414ebc15fa",
                        "entry_id": "7e11e50d-127e-3737-8c3a-18f4ad19912f",
                        "glosses": [
                            "Gerät, mit dem die Geschwindigkeit eines Fahrzeugs gemessen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df4d4aac-2279-42e4-8506-bd8a29c8e19d",
                                "sense_id": "05082678-5410-36ad-8132-f2414ebc15fa",
                                "text": "„Die Anzeige auf meinem Tacho zeigte fast viertausend Kilometer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10f947a8-9f29-4f9d-a899-09abe2f7dcf4",
                        "source_entry_id": "7e11e50d-127e-3737-8c3a-18f4ad19912f",
                        "source_sense_id": "05082678-5410-36ad-8132-f2414ebc15fa",
                        "source_sense_description": "Gerät, mit dem die Geschwindigkeit eines Fahrzeugs gemessen werden kann",
                        "target_lang_word": "speedo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speedo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bca8aa7-e613-3889-b945-1ca72691abc8",
                                        "entry_id": "419b8633-bc26-342c-bb78-672bc0056f06",
                                        "glosses": [
                                            "A speedometer, particularly one in a race car or other automobile."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ae4250f-5b99-4b56-b3c0-513a64d7c702",
                                                "sense_id": "9bca8aa7-e613-3889-b945-1ca72691abc8",
                                                "text": "You don′t need to change dashboards since the switches and instruments are suited to the V8, although the speedo and tachometer will require modification to adjust them to your V8′s gearing and cylinders."
                                            },
                                            {
                                                "example_id": "7327f71e-8b88-4cbe-8c36-df2fd16fe1d6",
                                                "sense_id": "9bca8aa7-e613-3889-b945-1ca72691abc8",
                                                "text": "One further advantage of the ‘J’ type overdrive units is that the speedo drive gear on the rear drive shaft of the gearbox can be changed, thereby adjusting the speedo-drive ratio to suit the TR′s 15in wheels."
                                            },
                                            {
                                                "example_id": "9f28fae8-793d-4f0d-949e-bca1d27b8c92",
                                                "sense_id": "9bca8aa7-e613-3889-b945-1ca72691abc8",
                                                "text": "The main instruments are in the centre of the dash, finished in silver (grey on the GP); consisting of a circular speedo with petrol and temperature gauges on either side."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "speedo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ca60064-3a86-318e-9c29-6e39cbe71ad1",
                                        "entry_id": "cdb992ee-19e3-3607-b310-708d4a8038bc",
                                        "glosses": [
                                            "Alternative letter-case form of Speedo."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "150f674d-a673-4064-a1d7-e94318ef0333",
                        "source_entry_id": "7e11e50d-127e-3737-8c3a-18f4ad19912f",
                        "source_sense_id": "05082678-5410-36ad-8132-f2414ebc15fa",
                        "source_sense_description": "Gerät, mit dem die Geschwindigkeit eines Fahrzeugs gemessen werden kann",
                        "target_lang_word": "tachymètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tachymètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "029d8488-2a16-3ad4-ad1d-41d96f785d66",
                                        "entry_id": "f362eaea-1ef3-355b-9e2a-e6ce245d0bde",
                                        "glosses": [
                                            "Appareil de mesure indiquant en continu la vitesse angulaire d’une machine tournante, par exemple l’arbre de sortie d’un moteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2052103b-20ee-4759-94a5-f3912fb32279",
                                                "sense_id": "029d8488-2a16-3ad4-ad1d-41d96f785d66",
                                                "text": "Un compte-tours moteur est une sorte de tachymètre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d706fb3b-f4e8-3254-a888-551214f91c06",
                                        "entry_id": "f362eaea-1ef3-355b-9e2a-e6ce245d0bde",
                                        "glosses": [
                                            "Instrument servant à mesurer la vitesse."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d403e1f7-0fc6-4c10-bb24-992325dfa8a1",
                                                "sense_id": "d706fb3b-f4e8-3254-a888-551214f91c06",
                                                "text": "Il a l’œil constamment rivé sur le tachymètre."
                                            },
                                            {
                                                "example_id": "5dde99d1-f19e-4763-8535-3a3e406f57ec",
                                                "sense_id": "d706fb3b-f4e8-3254-a888-551214f91c06",
                                                "text": "Le conducteur jeta un coup d’œil sur son tachymètre, où l’aiguille blanche se déplaçait en éventail, de gauche à droite, sur les chiffres verts marquant les vitesses de 20 en 20 km/h."
                                            }
                                        ]
                                    }
                                ]
                            }
