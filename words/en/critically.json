{
    "word_family": [
        "critic",
        "critical",
        "criticism",
        "critique",
        "criticize"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a802693a-2623-3009-a347-201f9e422341",
                    "sense_definition": "In a way that involves careful analysis and judgment, often to find faults or evaluate quality.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Students are encouraged to think <w>critically</w> about the information they find online.",
                            "target_lang_translations": {
                                "ru": "Студентов призывают мыслить <w>критически</w> по поводу информации, которую они находят в интернете.",
                                "zh": "我们鼓励学生<w>批判性地</w>思考他们在网上找到的信息。"
                            }
                        },
                        {
                            "text": "She looked <w>critically</w> at the painting, trying to decide if it was genuine.",
                            "target_lang_translations": {
                                "ru": "Она <w>критично</w> посмотрела на картину, пытаясь решить, подлинная ли она.",
                                "zh": "她<w>挑剔地</w>审视着那幅画，试图判断它是否是真迹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "analytically",
                        "evaluatively"
                    ],
                    "antonyms": [
                        "uncritically"
                    ],
                    "common_phrases": [
                        "think critically",
                        "examine critically",
                        "look critically"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образом, предполагающим тщательный анализ и суждение, часто для выявления недостатков или оценки качества.",
                        "zh": "以一种涉及仔细分析和判断的方式，通常是为了发现缺点或评估质量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критически",
                                "target_lang_sense_clarification": "аналитически"
                            },
                            {
                                "target_lang_word": "критично",
                                "target_lang_sense_clarification": "оценивающе, придирчиво"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批判性地",
                                "target_lang_sense_clarification": "以分析和评价的态度"
                            },
                            {
                                "target_lang_word": "挑剔地",
                                "target_lang_sense_clarification": "以审视或找茬的态度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78d1186d-76a7-35b2-ae94-557a0e979c92",
                    "sense_definition": "To a very serious, dangerous, or life-threatening degree.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "severity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver was <w>critically</w> injured in the car accident.",
                            "target_lang_translations": {
                                "ru": "Водитель был <w>тяжело</w> ранен в автомобильной аварии.",
                                "zh": "司机在车祸中<w>严重</w>受伤。"
                            }
                        },
                        {
                            "text": "Many animals are <w>critically</w> endangered due to the loss of their habitat.",
                            "target_lang_translations": {
                                "ru": "Многие животные находятся под <w>критической</w> угрозой исчезновения из-за потери среды обитания.",
                                "zh": "由于栖息地丧失，许多动物正处于<w>极度</w>濒危的状态。"
                            }
                        }
                    ],
                    "synonyms": [
                        "severely",
                        "gravely",
                        "dangerously",
                        "seriously"
                    ],
                    "common_phrases": [
                        "critically ill",
                        "critically injured",
                        "critically endangered"
                    ],
                    "target_lang_definitions": {
                        "ru": "В очень серьезной, опасной или угрожающей жизни степени.",
                        "zh": "达到非常严重、危险或危及生命的程度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критически",
                                "target_lang_sense_clarification": "крайне, опасно"
                            },
                            {
                                "target_lang_word": "тяжело",
                                "target_lang_sense_clarification": "о травмах или болезнях"
                            },
                            {
                                "target_lang_word": "смертельно",
                                "target_lang_sense_clarification": "угрожающе жизни"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严重地",
                                "target_lang_sense_clarification": "指伤势或程度严重"
                            },
                            {
                                "target_lang_word": "极度地",
                                "target_lang_sense_clarification": "指程度达到临界点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0487928d-be2a-330c-a9b8-1f0de993fadd",
                    "sense_definition": "In a way that is absolutely necessary or has a decisive effect on the outcome.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>critically</w> important that we finish this project on time.",
                            "target_lang_translations": {
                                "ru": "<w>Критически</w> важно, чтобы мы закончили этот проект вовремя.",
                                "zh": "我们按时完成这个项目<w>至关重要</w>。"
                            }
                        },
                        {
                            "text": "The success of the mission depends <w>critically</w> on the weather conditions.",
                            "target_lang_translations": {
                                "ru": "Успех миссии <w>критически</w> зависит от погодных условий.",
                                "zh": "任务的成功<w>关键</w>取决于天气状况。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crucially",
                        "vitally",
                        "decisively"
                    ],
                    "common_phrases": [
                        "critically important",
                        "critically needed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образом, который абсолютно необходим или имеет решающее влияние на результат.",
                        "zh": "以绝对必要或对结果有决定性影响的方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критически",
                                "target_lang_sense_clarification": "решающим образом"
                            },
                            {
                                "target_lang_word": "жизненно",
                                "target_lang_sense_clarification": "необходимо"
                            },
                            {
                                "target_lang_word": "чрезвычайно",
                                "target_lang_sense_clarification": "очень важно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "至关重要地",
                                "target_lang_sense_clarification": "指极其重要"
                            },
                            {
                                "target_lang_word": "关键地",
                                "target_lang_sense_clarification": "指对结果有决定性作用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8474527e-eb0d-3f56-a69f-f904a25302a9",
                    "sense_definition": "According to the opinions of professional reviewers or critics.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "review",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film was <w>critically</w> acclaimed but did not sell many tickets.",
                            "target_lang_translations": {
                                "ru": "Фильм был высоко оценен <w>критиками</w>, но билетов было продано немного.",
                                "zh": "这部电影获得了<w>评论界</w>的好评，但票房并不理想。"
                            }
                        },
                        {
                            "text": "He wrote a <w>critically</w> successful novel that won several awards.",
                            "target_lang_translations": {
                                "ru": "Он написал успешный у <w>критиков</w> роман, который получил несколько наград.",
                                "zh": "他写了一部在<w>评论界</w>大获成功并赢得了多个奖项的小说。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "critically acclaimed",
                        "critically successful",
                        "critically panned"
                    ],
                    "target_lang_definitions": {
                        "ru": "Согласно мнению профессиональных рецензентов или критиков.",
                        "zh": "根据专业评论家或批评家的意见。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "критиками",
                                "target_lang_sense_clarification": "со стороны критиков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "评论界",
                                "target_lang_sense_clarification": "指来自评论家的评价"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}