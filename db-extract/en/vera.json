                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "36943edb-6657-3edd-acef-77e72cd91ed0",
                        "entry_id": "bb0af9e9-2ac8-37ec-ba70-d882cf582178",
                        "glosses": [
                            "A female given name from Russian."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a073eab-337c-4329-9d6b-c9e87fa056d5",
                                "sense_id": "36943edb-6657-3edd-acef-77e72cd91ed0",
                                "text": "Good night, my Vera. Mind, I shall always call you Vera. It sounds so Russian and nice, and is much prettier than Vere."
                            },
                            {
                                "example_id": "144a6a3f-e143-421e-acb0-1758fb2c9e12",
                                "sense_id": "36943edb-6657-3edd-acef-77e72cd91ed0",
                                "text": "I killed Vera Cross - - - .I had known her for about three months, and never ceased to wonder if her parents, when they gave her a name, had been totally illiterate or wilfully blasphemous."
                            },
                            {
                                "example_id": "d82098de-1f0a-417e-a62e-3427c3b1cf6a",
                                "sense_id": "36943edb-6657-3edd-acef-77e72cd91ed0",
                                "text": "Pioneering American astronomer Vera Rubin once mentored fellow aspiring female astronomers and advocated for women in science. It’s fitting that the first national US observatory named for a female astronomer is in her honor."
                            }
                        ]
                    }
                ],
