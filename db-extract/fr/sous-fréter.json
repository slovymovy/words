                "senses": [
                    {
                        "sense_id": "de538a57-3050-3d34-b818-1ade49b652dd",
                        "entry_id": "98906d4f-2bbf-3848-bec2-ca3339575836",
                        "glosses": [
                            "Fréter à un autre le bâtiment qu'on avait affrété pour soi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4efbed2b-2239-42fc-8080-7d65c09d90eb",
                                "sense_id": "de538a57-3050-3d34-b818-1ade49b652dd",
                                "text": "Faisons défense à tous courtiers et autres de sous-fréter les navires à plus haut prix que celui porté par le premier contrat. Ordonn. août 1681"
                            },
                            {
                                "example_id": "a6ef938b-9bcc-4367-9e3b-a2c7305281fd",
                                "sense_id": "de538a57-3050-3d34-b818-1ade49b652dd",
                                "text": "Il n est d ailleurs pas nécessaire de refréter le navire au véritable propriétaire ; il suffit de le sous-fréter à temps ou au voyage à une personne originaire d un pays qui ne sera ni le lieu de départ ni celui de destination des voyages effectués."
                            }
                        ]
                    }
