                ],
                "senses": [
                    {
                        "sense_id": "a036a09c-b5fa-3355-b099-9f93efdb51bc",
                        "entry_id": "87ad24bd-a01b-3f5f-afa7-d24197d085c7",
                        "glosses": [
                            "Alternative letter-case form of Monophysite."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e163a7f2-c183-4ee1-8e55-05817fe27f19",
                                "sense_id": "a036a09c-b5fa-3355-b099-9f93efdb51bc",
                                "text": "Christianity had already established itself in Arabia. In Yemen, the city of Nagrân had become the seat of a Christian bishopric, and some of the more important tribes, like Kindeh and Ghassân, had embraced Christianity, which was also the religion of most of the Arabs of Syria.\nBut it had not penetrated deeply into their hearts, and its miracles, its doctrine of the Trinity, and the subtle disputes of monophysites and monothelites were absolutely incomprehensible to them."
                            }
                        ]
                    }
