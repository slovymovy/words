                        "examples": [
                            {
                                "example_id": "a1937e3e-33f2-4dd3-9cee-e92d803c733e",
                                "sense_id": "23a2111d-bb42-3406-8245-098fdcedd642",
                                "text": "„Das Ansinnen, wie der Allmächtige von oben auf die Welt zu blicken, ist schiere Hybris und kommt - wie übrigens auch die Neugierde um ihrer selbst willen - fast einer Todsünde gleich.“"
                            },
                            {
                                "example_id": "f12e77bb-e1c6-4463-87ea-a05a10ebac99",
                                "sense_id": "23a2111d-bb42-3406-8245-098fdcedd642",
                                "text": "„Es war lange her, dass Ari den Glauben an einen Allmächtigen aufgegeben hatte, nachdem er so jung seine Eltern verloren hatte, und auch das Theologiestudium hatte ihn den höheren Mächten nicht nähergebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
