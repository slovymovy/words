                    {
                        "sense_id": "76179e37-187a-3f1e-acfb-eae59eafa031",
                        "entry_id": "697815c5-5b51-3fd0-b27f-bf310ef79709",
                        "glosses": [
                            "Qualifie un matériau en feuillets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82ba40e0-311b-4341-9c28-49ee9db0cd85",
                                "sense_id": "76179e37-187a-3f1e-acfb-eae59eafa031",
                                "text": "L’abondance fréquente du mica donne à la roche une texture feuilletée et la rend plus délitable."
                            }
                        ]
                    },
                    {
                        "sense_id": "14ccaee0-0c77-33ea-9802-783f347acc4b",
                        "entry_id": "697815c5-5b51-3fd0-b27f-bf310ef79709",
                        "glosses": [
                            "Qualifie une pâtisserie dont la pâte se présente comme par feuillets."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "9b448666-82df-4a85-a986-58fb2fc92a28",
                                "sense_id": "14ccaee0-0c77-33ea-9802-783f347acc4b",
                                "text": "De la pâte feuilletée."
                            },
                            {
                                "example_id": "c79d7a87-654b-45b0-82d4-8f50fd36a060",
                                "sense_id": "14ccaee0-0c77-33ea-9802-783f347acc4b",
                                "text": "Un gâteau feuilleté."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47d8ae1e-2b80-4637-8af7-67a7cee921cd",
                        "source_entry_id": "697815c5-5b51-3fd0-b27f-bf310ef79709",
                        "target_lang_word": "vielschichtig",
