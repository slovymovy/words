                ],
                "senses": [
                    {
                        "sense_id": "d6db2b85-d393-3a31-ac46-cd6acdabaf8b",
                        "entry_id": "023178cc-bd04-37b8-ac37-fb2476631a2d",
                        "glosses": [
                            "Agiter dans l'eau, comme du linge qu’on rince."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "712d46d6-56e0-47cb-816a-3cc1b3d0be00",
                                "sense_id": "d6db2b85-d393-3a31-ac46-cd6acdabaf8b",
                                "text": "Pour cela, aussitôt que les feutres sortent de la chaudière, on les porte à la rivière où on les sansouille et on les tord jusqu'à ce que l'eau en sorte claire."
                            },
                            {
                                "example_id": "9a6e6a2f-89fc-4384-aa65-c132eacbc22d",
                                "sense_id": "d6db2b85-d393-3a31-ac46-cd6acdabaf8b",
                                "text": "Le bateau était à fond de bois incliné au rebours du fil de l'eau, de façon que, dans la partie d'aval, les innocents pouvaient se sansouiller sans danger."
                            }
                        ]
                    }
                ],
