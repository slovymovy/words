        "fr-extract.jsonl": [
            {
                "entry_id": "e8953cc6-fed3-3aa7-8517-5f572416aa32",
                "word": "Marioupol",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ce5fd12-a5a1-3a94-ad83-283f2f4f44c8",
                        "entry_id": "e8953cc6-fed3-3aa7-8517-5f572416aa32",
                        "glosses": [
                            "Ville d’Ukraine, dans l’oblast de Donetsk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "313f1eaa-13a7-4a30-bdce-e07d04477c6e",
                                "sense_id": "5ce5fd12-a5a1-3a94-ad83-283f2f4f44c8",
                                "text": "« Nous avons confiance dans la défense de notre ville, explique Olga Novikova, directrice du festival de cinéma de Marioupol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8583a2e-c1ed-4e07-88e3-3b6679799033",
                        "source_entry_id": "e8953cc6-fed3-3aa7-8517-5f572416aa32",
                        "source_sense_id": "5ce5fd12-a5a1-3a94-ad83-283f2f4f44c8",
                        "target_lang_word": "Mariupol",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mariupol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9773de9b-514b-355f-a003-8df2248777dd",
                                        "entry_id": "2cb6c037-d331-36ae-9789-f9fe8e1ee1db",
                                        "glosses": [
                                            "Großstadt am Asowschem Meer in der ukrainischen Oblast Donezk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02d4230a-cfb3-44d7-9212-2d0f3b748891",
                                                "sense_id": "9773de9b-514b-355f-a003-8df2248777dd",
                                                "text": "Sein Bruder lebt in Mariupol."
                                            },
                                            {
                                                "example_id": "ebbf58fb-a687-4340-8618-d8567501cbe5",
                                                "sense_id": "9773de9b-514b-355f-a003-8df2248777dd",
                                                "text": "„Doch auch wenn die Menschen in den städtischen Betrieben weniger gequält wurden und die Stadt sich ‚mit Scham‘ – so OB Ude – ihrer Vergangenheit stellt, auf eine gerechte Entschädigung warten auch die ehemaligen Zwangsarbeiter der Stadt München bisher vergebens. 600 Mark haben Jewgenija Grigorjewa und ihre Schwester aus einem Fond erhalten, mit dem die Bundesregierung besonders bedürftigen Opfern hilft. Bei einer Monatsrente von umgerechnet fünfzig Mark ist das allenfalls ein Zeichen guten Willens. Ein Kilo Fleisch kostet in Mariupol, der Heimatstadt der beiden alten Damen, etwa acht Mark.“"
                                            },
                                            {
                                                "example_id": "742efbb0-b82a-4b6d-bcd0-eb9446e7adef",
                                                "sense_id": "9773de9b-514b-355f-a003-8df2248777dd",
                                                "text": "«In der Hafenstadt Mariupol südlich von Donezk stürmten pro-russische Demonstranten die Staatsanwaltschaft, nachdem der selbsternannte, separatistische Bürgermeister am Samstag festgenommen und nach Kiew zu einem Verhör abtransportiert worden war.»"
                                            },
                                            {
                                                "example_id": "c1883694-ed92-4691-870a-ceeee28c9b35",
                                                "sense_id": "9773de9b-514b-355f-a003-8df2248777dd",
                                                "text": "„Vor dem Zweiten Weltkrieg war Mariupol eine ukrainische Stadt. Danach siedelten sich Menschen aus der ganzen Sowjetunion hier an.“"
                                            },
                                            {
                                                "example_id": "98a34594-9c4b-4c2f-9c3f-5c73e7414b85",
                                                "sense_id": "9773de9b-514b-355f-a003-8df2248777dd",
                                                "text": "„Die Hafenstadt Mariupol ist mit 460.000 Einwohnern nach Donezk die zweitgrößte Stadt im Gebiet Donezk.“"
                                            },
                                            {
                                                "example_id": "b16e4563-fc36-4e33-bbbf-4a9abbe0ab83",
                                                "sense_id": "9773de9b-514b-355f-a003-8df2248777dd",
                                                "text": "„Mariupol, das vierzig Jahre lang Shdanow hieß und erst nach dem Zerfall der Sowjetunion wieder seinen alten Namen erhielt, blieb ein innerer Ort für mich, den ich niemals dem Licht der Wirklichkeit aussetzte.“"
                                            },
                                            {
                                                "example_id": "f54d43cd-c9b2-4bca-b83f-5e5fe646db45",
                                                "sense_id": "9773de9b-514b-355f-a003-8df2248777dd",
                                                "text": "«Die letzten Wochen haben gezeigt, dass der umstrittene Brückenbau noch viel weitreichendere Konsequenzen hat als befürchtet: Klar war, dass der Kreml damit den politischen Anspruch auf die Halbinsel zementiert und die Strasse von Kertsch nur noch unter dem 35 Meter hohen Mittelstück der Brücke passierbar ist, was die Durchfahrt grosser Schiffe zu den ukrainischen Häfen Mariupol und Berdjansk verhindert.»"
                                            },
                                            {
                                                "example_id": "421e59ce-beae-494c-ab05-6000df2c260b",
                                                "sense_id": "9773de9b-514b-355f-a003-8df2248777dd",
                                                "text": "«Aufstrebende Städte wie Mariupol, Tschernihiw oder Lyman sind heute wenig mehr als Trümmerfelder.»"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "724697f8-5f20-4893-bc45-5976c9e19282",
                        "source_entry_id": "e8953cc6-fed3-3aa7-8517-5f572416aa32",
                        "source_sense_id": "5ce5fd12-a5a1-3a94-ad83-283f2f4f44c8",
                        "target_lang_word": "Mariupol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mariupol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca4f4ce6-f203-3892-9701-0d8a2f7d93d9",
                                        "entry_id": "389cf631-bd0b-3637-8135-c83676a4a966",
                                        "glosses": [
                                            "A city in Mariupol Raion, Donetsk Oblast, in eastern Ukraine, on the shore of the Sea of Azov, of the Black Sea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0955aa59-52e2-460d-b2a8-852321272872",
                                                "sense_id": "ca4f4ce6-f203-3892-9701-0d8a2f7d93d9",
                                                "text": "The empreſs defrayed the expences of their tranſport from the Krim, and aſſigned to them a conſiderable tract of country bordering on the Solonoya and the ſea of Azof : the merchants, however, and the trading part of the colony were ſent to the newly-erected towns of Ekatarinoſlaf and Mariupol."
                                            },
                                            {
                                                "example_id": "9fe7cb3d-7f7a-4510-a674-5996f90050e3",
                                                "sense_id": "ca4f4ce6-f203-3892-9701-0d8a2f7d93d9",
                                                "text": "The importance of their capture was obstructed, however, by the greater stakes of Rostov and Kharkov. The fall of either would be a major German catastrophe.\nAn even graver danger threatened the Germans as troops seventy miles north of Mariupol, 100 miles west of Rostov on the Sea of Azov, drove south toward the tide water, threatening to envelop 500,000 German troops in Rostov and the Donets."
                                            },
                                            {
                                                "example_id": "4c3d80b2-d85a-4e72-ac9e-e519f6a99f4d",
                                                "sense_id": "ca4f4ce6-f203-3892-9701-0d8a2f7d93d9",
                                                "text": "No incidents during passage across the Sea of Azov. At 1800 the formation continued passage to Mariupol as scheduled."
                                            },
                                            {
                                                "example_id": "f0da89b1-c738-456b-b8f6-496fb9346dc8",
                                                "sense_id": "ca4f4ce6-f203-3892-9701-0d8a2f7d93d9",
                                                "text": "In Mariupolʹ social forces were emboldened by success in their first battle—a campaign to undo the naming of the city for one of Stalin’s associates, Andrei Zhdanov."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2cd54d6-e804-3dd6-a0de-2fd22fa86a82",
                                        "entry_id": "389cf631-bd0b-3637-8135-c83676a4a966",
                                        "glosses": [
                                            "A raion of Donetsk Oblast, Donbas, in southeastern Ukraine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
