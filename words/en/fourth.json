                {
                    "sense_id": "c45d207c-0ab8-3b11-973c-6c6901957812",
                    "sense_definition": "A musical interval which spans four degrees of the diatonic scale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The melody moves from the root note up to a perfect <w>fourth</w>.",
                            "target_lang_translations": {
                                "ru": "Мелодия движется от основной ноты вверх к чистой <w>кварте</w>."
                            }
                        },
                        {
                            "text": "He practiced singing a perfect <w>fourth</w> to improve his ear training.",
                            "target_lang_translations": {
                                "ru": "Он тренировался петь чистую <w>кварту</w>, чтобы развить музыкальный слух."
                            }
