                        "sense_id": "e9a609bd-7033-33d6-b1e8-89c77d6de459",
                        "entry_id": "11e7d193-5432-3780-accf-18a88d081f6e",
                        "glosses": [
                            "Gebiet, in dem mehr als anderswo mit Erdbeben zu rechnen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e0fafd1-bc20-4d10-a8d5-32f259f80b8a",
                                "sense_id": "e9a609bd-7033-33d6-b1e8-89c77d6de459",
                                "text": "„Sie begann damit, daß eine mexikanische Hellseherin den siebenjährigen Michael vor unterirdischen Kräften warnte und ihn eindringlich ermahnte, Erdbebengebiete zu meiden, sonst würde er sein Leben aufs Spiel setzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "61d2dc0b-e15e-3b94-a60b-be9b381de8d4",
                        "entry_id": "11e7d193-5432-3780-accf-18a88d081f6e",
                        "glosses": [
                            "Gebiet, in dem sich ein Erdbeben ereignet hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1994046-78f6-402b-ade1-3457f81fc643",
                                "sense_id": "61d2dc0b-e15e-3b94-a60b-be9b381de8d4",
                                "text": "„Unterdessen ist im Erdbebengebiet in der südöstlichen Türkei und im Norden Syriens die Zahl der bestätigten Toten mittlerweile auf mehr als 20.000 gestiegen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
