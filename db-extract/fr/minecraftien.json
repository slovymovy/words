                    },
                    {
                        "translation_id": "601a927d-9912-493a-9b0a-7400d95ee119",
                        "source_entry_id": "0bb3f68e-bb06-341c-aa74-901d71efdcaa",
                        "source_sense_id": "4843b9b3-4612-3140-9173-4d74795a36f3",
                        "target_lang_word": "Minecraftian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Minecraftian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4854d6e-38ad-3b02-86c1-fa0d8a12473f",
                                        "entry_id": "b208a0e8-27b7-3b9b-8bc7-3817cd9c2ff0",
                                        "glosses": [
                                            "Of, pertaining to, or characteristic of Minecraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdf6ff06-0698-443a-a709-f3de7ab0b410",
                                                "sense_id": "f4854d6e-38ad-3b02-86c1-fa0d8a12473f",
                                                "text": "It’s time to go deeper into Minecraft, to not just learn how to be great at playing Minecraft, but to dive into every crevice of Minecraftian knowledge that there is in the world."
                                            },
                                            {
                                                "example_id": "b5882a47-b248-452a-a00a-8ea49e5e54b0",
                                                "sense_id": "f4854d6e-38ad-3b02-86c1-fa0d8a12473f",
                                                "text": "A Note to Parents (…and grandparents, aunts and uncles, teachers, and all other Minecraftian grown-ups)"
                                            },
                                            {
                                                "example_id": "2a150095-3df0-425a-a0bd-39b11f744a70",
                                                "sense_id": "f4854d6e-38ad-3b02-86c1-fa0d8a12473f",
                                                "text": "Cracked and CollegeHumor have taken its pop cultural musings and made them into a Minecraftian mini-world from which there’s no escape."
                                            },
                                            {
                                                "example_id": "b29b7ad4-4b38-40d5-bfe0-c88885efd198",
                                                "sense_id": "f4854d6e-38ad-3b02-86c1-fa0d8a12473f",
                                                "text": "Much, perhaps most, Minecraft fiction follows the robinsonade template, emphasizing the day-to-day life of a character, including nonhuman characters, striving to survive and thrive in a recognizably Minecraftian world by utilizing its resources."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Minecraftian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bf42942-a95f-3620-8741-097d156ef333",
                                        "entry_id": "dd835ffd-3b64-3d70-873d-c0e026424382",
                                        "glosses": [
                                            "A person who plays the game Minecraft; a Minecrafter."
