                        "glosses": [
                            "To use caution, pay attention to (used both with and without of)."
                        ],
                        "tags": [
                            "ambitransitive",
                            "defective"
                        ],
                        "examples": [
                            {
                                "example_id": "bf9d2ffe-bba8-4aba-b402-c89c4fab020f",
                                "sense_id": "82fdcad6-4532-36d2-9649-c7ec3c215394",
                                "text": "Behold, I send an Angel before thee[…]. Beware of him, and obey his voice."
                            },
                            {
                                "example_id": "6d9d957b-833f-4a4f-a0e3-4466314281ca",
                                "sense_id": "82fdcad6-4532-36d2-9649-c7ec3c215394",
                                "text": "Beware the Ides of March."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93f6c017-b6cd-4596-a1fe-dc853d2af64d",
