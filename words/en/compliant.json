                },
                {
                    "sense_id": "b8dcd3e3-bf81-37ef-acb8-f041ce651621",
                    "sense_definition": "Willing to do what other people want or to follow orders without protest.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect remained <w>compliant</w> during the arrest and followed all police instructions.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый оставался <w>послушным</w> во время ареста и следовал всем указаниям полиции."
                            }
                        },
                        {
                            "text": "She was a <w>compliant</w> child who rarely questioned her parents' authority.",
                            "target_lang_translations": {
                                "ru": "Она была <w>послушным</w> ребенком и редко подвергала сомнению авторитет родителей."
                            }
                        }
                    ],
                    "synonyms": [
                        "yielding",
                        "pliant",
                        "supple"
                    ],
                    "common_phrases": [
                        "compliant behavior",
                        "perfectly compliant"
                    ],
                    "target_lang_definitions": {
