                    {
                        "sense_id": "497cd3ec-508c-3c08-a1c6-27dc5cecf367",
                        "entry_id": "1eba485e-f912-34e8-9038-d4547745d9d4",
                        "glosses": [
                            "een man die graag in de buitenlucht is in plaats van altijd binnen te zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "208ccd46-ed10-49e7-b90f-240400fa805a",
                                "sense_id": "497cd3ec-508c-3c08-a1c6-27dc5cecf367",
                                "text": "Wat betreft het karakter gaat de bezoekster van onze site vooral voor het type ’ruwe bolster, blanke pit’, 30,4 procent verkiest de stoere buitenman en het strenge doch rechtvaardige type staat op een gedeelde derde plaats met de geheimzinnige en getroebleerde man (beide 12,5%)."
                            },
                            {
                                "example_id": "2d2a5291-9737-4fbe-be29-06b84d0a2081",
                                "sense_id": "497cd3ec-508c-3c08-a1c6-27dc5cecf367",
                                "text": "Maar de 'verzorgenden' van de afdeling zagen dat deze echte buitenman diep ongelukkig wordt van een stoel. En dus spannen ze zich allemaal in om te zorgen dat meneer Drost, die vergeetachtig is, altijd een rollator voor zich heeft als hij aan de wandel gaat."
                            },
                            {
                                "example_id": "a55a138d-1a7c-4c0f-9b71-4243388fd9b8",
                                "sense_id": "497cd3ec-508c-3c08-a1c6-27dc5cecf367",
                                "text": "Vladimir Poetin koestert zijn imago van avontuurlijke buitenman en de zomer is de ideale tijd voor een actief recreërende president op de Russische staatstelevisie."
                            }
                        ]
