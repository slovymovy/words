                    {
                        "translation_id": "6c6b6e79-55a1-443b-9a31-d81cf670abeb",
                        "source_entry_id": "f972d2b4-f779-3580-828f-cc6e4293a386",
                        "source_sense_description": "gentle",
                        "target_lang_word": "weichherzig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weichherzig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ed371af-ff9e-34f0-a3ea-d44d1433a75c",
                                        "entry_id": "a9c833a5-b090-328b-bf3e-078f9200851b",
                                        "glosses": [
                                            "sich auf das Leid/Unglück anderer einlassend: voller Mitgefühl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd5e9640-6d01-4304-b176-28163c1e0c64",
                                                "sense_id": "1ed371af-ff9e-34f0-a3ea-d44d1433a75c",
                                                "text": "„Lydia […] klopft wieder bei Amélie an. Tatsächlich findet sie bei der weichherzigen Freundin Unterschlupf.“"
                                            },
                                            {
                                                "example_id": "3cea33ac-5615-41bc-9f86-fe61d9cefabc",
                                                "sense_id": "1ed371af-ff9e-34f0-a3ea-d44d1433a75c",
                                                "text": "„[Der Schriftsteller Theodor Storm] war ein höchst weichherziger Ehemann und Familienvater.“"
                                            },
                                            {
                                                "example_id": "d263ef79-f17f-4670-8f7c-f1478ffb89e5",
                                                "sense_id": "1ed371af-ff9e-34f0-a3ea-d44d1433a75c",
                                                "text": "„Der Sänger und Showmaster Vico Torriani hat die softe Seite dieses Images [der Rätoromanen] in die Welt getragen, die des weichherzigen Gemütsmenschen.“"
                                            },
                                            {
                                                "example_id": "6d838f1b-5a85-4533-8e8b-99ec3c90f9fa",
                                                "sense_id": "1ed371af-ff9e-34f0-a3ea-d44d1433a75c",
                                                "text": "[Der Präsident der Russischen Föderation, Wladimir Putin:] „»Sie [die Eltern] empfanden keinen Hass gegenüber dem Feind [den Deutschen]. Ich kann das, ehrlich gesagt, bis heute nicht ganz begreifen. Meine Mutter war überhaupt ein sehr weichherziger, gütiger Mensch … Sie sagte: ‚Wie soll man diese Soldaten hassen?‘ […]«“"
                                            },
                                            {
                                                "example_id": "e35bfbcc-125d-4418-8a36-696684b09494",
                                                "sense_id": "1ed371af-ff9e-34f0-a3ea-d44d1433a75c",
                                                "text": "[USA:] „Die Demokraten werden als die Partei der weichherzigen Verschwender beschimpft und die Republikaner als herzlose, von Großunternehmen gesteuerte Machtpolitiker.“"
                                            },
                                            {
                                                "example_id": "396186fd-80d3-4695-a295-57ebf35f576a",
                                                "sense_id": "1ed371af-ff9e-34f0-a3ea-d44d1433a75c",
                                                "text": "„»Wohlan,« sagte Romney, »es kann sich alles arrangieren. Sie werden Graham reich und mich berühmt machen. Später werden Sie in Ihren weichherzigen Augenblicken überlegen, ob Sie nicht gleichzeitig mein Glück machen können. […]«“"
                                            },
                                            {
                                                "example_id": "3d9bf889-e04e-4c3b-86ac-905192c39c2e",
                                                "sense_id": "1ed371af-ff9e-34f0-a3ea-d44d1433a75c",
                                                "text": "Selbst dies Gefühl des Mitleids und der weichherzigen Teilnehmung, wenn es vor der Überlegung, was Pflicht sei, vorhergeht und Bestimmungsgrund wird, ist wohldenkenden Personen selbst lästig, bringt ihre überlegten Maximen in Verwirrung, und bewirkt den Wunsch, ihrer entledigt und allein der gesetzgebenden Vernunft unterworfen zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
