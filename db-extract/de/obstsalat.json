                ],
                "senses": [
                    {
                        "sense_id": "8298e79b-3dbc-3c8c-b1c3-c89b58780c53",
                        "entry_id": "82c24fd0-547f-39a3-8980-83cbb6c5febb",
                        "glosses": [
                            "aus verschiedenen Obstsorten durch Mischung hergestellte Speise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ba9bdab-effb-485a-b99f-a9a965fb703f",
                                "sense_id": "8298e79b-3dbc-3c8c-b1c3-c89b58780c53",
                                "text": "„[…] Neben ihrem Schreibtisch steht ein Strauß mit blassrosa Pfingstrosen. Eine Dame im Bleistiftrock bringt ein Schälchen Obstsalat, akkurat gestapelt.“"
                            },
                            {
                                "example_id": "184b6038-0ba6-4b18-b63b-356e39cd49d0",
                                "sense_id": "8298e79b-3dbc-3c8c-b1c3-c89b58780c53",
                                "text": "„Die scharfe Säure der Limette eignet sich oft besser als die der milderen Zitrone dazu, Aromen zu kontrastieren und so erst herauszuarbeiten. Im Obstsalat kann das Wunder wirken. Und wer eine sahnige Mango mit wenigen Spritzern Limettensaft beträufelt, merkt erst, was sich aus der Tropenfrucht geschmacklich herausholen lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
