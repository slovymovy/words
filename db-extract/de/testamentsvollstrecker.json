                "senses": [
                    {
                        "sense_id": "a40e666e-8706-3507-932a-031ff64839f5",
                        "entry_id": "572d3c6b-4a8f-3402-a98c-38c3df98e465",
                        "glosses": [
                            "die (in der Regel vom Erblasser) ernannte Person, die die letztwilligen Verfügungen des Erblassers zur Ausführung zu bringen hat"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "70759469-1021-4fa3-afe6-2066221060a5",
                                "sense_id": "a40e666e-8706-3507-932a-031ff64839f5",
                                "text": "Der Schwerpunkt der Tätigkeit eines Testamentsvollstreckers liegt auf der Besorgung wirtschaftlicher Belange und damit nicht im Bereich der Rechtsberatung."
                            },
                            {
                                "example_id": "638e3e1a-dc0f-4906-8e43-31eb292adeea",
                                "sense_id": "a40e666e-8706-3507-932a-031ff64839f5",
                                "text": "„Der andere Sohn, Monsieur Alexandre, erklärte seine Absicht, alles vor Gericht zu regeln und wenn möglich sogar das Testament anzufechten, forderte zunächst Versiegelung, Bestandsaufnahme, Ernennung eines Testamentsvollstreckers und so weiter!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01ebd1a3-3dc3-4219-ac06-9a0f865a30e2",
                        "source_entry_id": "572d3c6b-4a8f-3402-a98c-38c3df98e465",
                        "source_sense_id": "a40e666e-8706-3507-932a-031ff64839f5",
                        "target_lang_word": "executor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "executor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c28969a-5e0f-360a-8a41-e9b495da5655",
                                        "entry_id": "498bd9e9-0728-37ca-9757-e36072bb9a95",
                                        "glosses": [
                                            "A person who carries out some task."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0c47680-9fdc-300f-a6c2-a31d0ef3b3d4",
                                        "entry_id": "498bd9e9-0728-37ca-9757-e36072bb9a95",
                                        "glosses": [
                                            "A component of a system that executes or runs something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "513fc8aa-46cb-4cfd-adf3-27106ebb2b7f",
                                                "sense_id": "e0c47680-9fdc-300f-a6c2-a31d0ef3b3d4",
                                                "text": "When searching for a solution is unnecessary, then the program executor \"doesn't care\" which solution is generated nor how it is obtained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b61db42d-aaf2-31a4-a31e-905a1b9a1c99",
                                        "entry_id": "498bd9e9-0728-37ca-9757-e36072bb9a95",
                                        "glosses": [
                                            "Someone appointed by a testator to administer their estate in accordance with their will; an administrator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d523607-e13a-4766-be31-71659e8c9442",
                                                "sense_id": "b61db42d-aaf2-31a4-a31e-905a1b9a1c99",
                                                "text": "literary executor"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e959a3e-beeb-3c08-95e1-00e973d5db7c",
                                        "entry_id": "498bd9e9-0728-37ca-9757-e36072bb9a95",
                                        "glosses": [
                                            "An executioner."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b76106c-bd5b-46be-8b4b-9438f746c797",
                                                "sense_id": "7e959a3e-beeb-3c08-95e1-00e973d5db7c",
                                                "text": "The sad-eyed justice, with his surly hum, / Delivering o'er to executors pale / The lazy yawning drone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40351445-2ead-4d3d-8d47-393308b20e54",
                        "source_entry_id": "572d3c6b-4a8f-3402-a98c-38c3df98e465",
                        "source_sense_id": "a40e666e-8706-3507-932a-031ff64839f5",
                        "target_lang_word": "administrator of a will",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1eb2553f-f373-4af8-9227-971b216354f1",
                        "source_entry_id": "572d3c6b-4a8f-3402-a98c-38c3df98e465",
                        "source_sense_id": "a40e666e-8706-3507-932a-031ff64839f5",
                        "target_lang_word": "exécuteur testamentaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exécuteur testamentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2485743d-1321-3a68-bdd6-4f37a7361296",
                                        "entry_id": "4ae1713e-5da0-34c1-9ef1-2132c4f0f052",
                                        "glosses": [
                                            "Personne désignée par le testateur pour assurer l’exécution de ses dernières volontés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e704ae7-6920-4204-851a-f8848467679f",
                                                "sense_id": "2485743d-1321-3a68-bdd6-4f37a7361296",
                                                "text": "Le notaire, cependant, s’était écrié tout de suite qu’il existait un testament, déposé chez lui. Il convoqua sans tarder le docteur, pour le surlendemain, dans le but de lui en faire la communication officielle ; car il crut pouvoir lui dire que l’oncle l’avait choisi comme exécuteur testamentaire."
                                            },
                                            {
                                                "example_id": "7274a7d5-cea0-4361-a51a-c1060278575f",
                                                "sense_id": "2485743d-1321-3a68-bdd6-4f37a7361296",
                                                "text": "Je mis à profit le premier jour de pluie pour faire virer, de mon compte en banque, où elles se trouvaient encore, les sommes dont j’étais l’exécuteur testamentaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "467f040d-22a3-443b-b04e-389c3fb1c092",
                        "source_entry_id": "572d3c6b-4a8f-3402-a98c-38c3df98e465",
                        "source_sense_id": "a40e666e-8706-3507-932a-031ff64839f5",
