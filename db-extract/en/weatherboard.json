                                        "entry_id": "df3565eb-69c6-3771-a64b-0abfac5d6995",
                                        "glosses": [
                                            "eine Hülle (Schale) bauen, in die dann zum Beispiel Beton gegossen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b742d66-bbf3-45c3-a0d3-263e1ff39f77",
                                                "sense_id": "9bdcc87c-d61d-35af-803c-6ab783c5620b",
                                                "text": "Erst wollen wir die Kellertreppe verschalen und dann die Wände hochmauern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2661792c-f1ee-3ebe-9db3-81b9f804a3a9",
                                        "entry_id": "df3565eb-69c6-3771-a64b-0abfac5d6995",
                                        "glosses": [
                                            "etwas von innen auskleiden oder von außen umhüllen, so dass eine schützende Schale entsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21a993a8-6aef-4f8b-ab03-7b75aca91c9e",
                                                "sense_id": "2661792c-f1ee-3ebe-9db3-81b9f804a3a9",
                                                "text": "„Im selben Jahr sind Kirche und Langhaus eingerüstet, um die Fenster zu verschalen und die Gesimse zu ziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b45aaee8-585b-39db-b43f-0264c802c2ec",
                                        "entry_id": "df3565eb-69c6-3771-a64b-0abfac5d6995",
                                        "glosses": [
                                            "an Geschmack und Spritzigkeit verlieren, schal werden"
                                        ],
                                        "tags": [
                                            "Getränke"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67aaa9b3-c6a8-417d-846a-51b870601e37",
                                                "sense_id": "b45aaee8-585b-39db-b43f-0264c802c2ec",
                                                "text": "„Eine davon war angebrochen, aus dem Flaschenhals ragte ein Silberlöffel. Ann Kathrin lächelte. So hatte ihr Vater auch immer versucht, angebrochenen Sekt am Verschalen zu hindern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
