                            {
                                "example_id": "ff170d0a-8155-433a-8dbf-a8aed548772f",
                                "sense_id": "c5a17693-0741-3e1b-9d63-13d65142c3f0",
                                "text": "Er war schon auf dem Weg ins Büro, aber da habe ich ihn doch gerade noch am Schlafittchen erwischt."
                            },
