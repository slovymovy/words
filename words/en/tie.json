                },
                {
                    "sense_id": "9975405d-2128-383b-a8bb-6df1b7047ed1",
                    "sense_definition": "A strong emotional or social connection between people, families, or groups.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ties</w> of friendship are often stronger than those of blood.",
                            "target_lang_translations": {
                                "ru": "<w>Узы</w> дружбы часто крепче кровных уз."
                            }
                        },
                        {
                            "text": "He decided to move back to his hometown to be closer to family <w>ties</w>.",
                            "target_lang_translations": {
                                "ru": "Он решил вернуться в родной город, чтобы быть ближе к семейным <w>связям</w>."
