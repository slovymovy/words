                        "glosses": [
                            "für die Durchführung eines Wahlkampfes vorgesehene finanzielle Mittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e602cef2-7a51-4dfc-bd5b-2fa3f8acc3f6",
                                "sense_id": "054e58ef-ddf7-3d1e-8913-9c16ac52e773",
                                "text": "„Die Wiener Grünen sollten in die Verlegenheit einer Überschreitung nicht kommen. Deren Wahlkampfbudget beträgt hingegen nur 2,7 Millionen Euro, erklärte eine Sprecherin.“"
                            },
                            {
                                "example_id": "0f41b3c4-8582-41f4-ad70-4722c8d98bc2",
                                "sense_id": "054e58ef-ddf7-3d1e-8913-9c16ac52e773",
                                "text": "„Der Parteisprecher betonte, auch die bisherige Finanzplanung der Partei beinhalte ein Wahlkampfbudget.“"
                            }
                        ],
