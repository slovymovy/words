                                        "glosses": [
                                            "Qui est relatif à la photographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cba80291-a745-472e-9cc6-cbd00e6ebb7f",
                                                "sense_id": "3a2b2e0a-317b-39b0-8072-f4769ed033bc",
                                                "text": "Ce n'est qu'en 1930 que son assistant, Clyde Tombough, a trouvé, après une recherche exhaustive parmi des milliers de plaques photographiques, une nouvelle planète."
                                            },
                                            {
                                                "example_id": "a9402f2a-187d-4aa4-a9e9-cc72107dfa41",
                                                "sense_id": "3a2b2e0a-317b-39b0-8072-f4769ed033bc",
                                                "text": "Un (ou une) « selfie », mot emprunté à l’anglais, est un autoportrait photographique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16baf197-e6ee-3a37-bbc9-8e9f3cb1c1a3",
                                        "entry_id": "9fbc1d68-3794-30d2-8622-73faae63b979",
                                        "glosses": [
                                            "Précis comme une photographie."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40d6d67e-c6db-477c-8607-e4be17264d5e",
                                                "sense_id": "16baf197-e6ee-3a37-bbc9-8e9f3cb1c1a3",
                                                "text": "Ma mémoire conserve encore avec une netteté photographique l’image de la chaire et du cahier de classe sur lequel nous ne cessions de loucher parce que nos notes y étaient consignées ; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
