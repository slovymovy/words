                        "examples": [
                            {
                                "example_id": "4ed0740b-fa0d-4474-8604-6ffd5ebda5cd",
                                "sense_id": "b4da96c3-b727-3003-9cbe-b71500756887",
                                "text": "De EU-ministers willen de ondergraving van de rechtsnormen in Turkije grondig laten evalueren door de Raad van Europa. De Turkse minister zei de rechtsstaat belangrijk te vinden, maar benadrukte dat de strijd tegen terrorisme nu voorrang heeft. Aanpassing van de terrorismewetgeving, een voorwaarde voor visumvrij reizen naar de EU, is pas ,,in de toekomst’’ een optie, besloot Celik."
                            },
                            {
                                "example_id": "640bc2c4-2aaa-44d5-9ed7-aea35de99457",
                                "sense_id": "b4da96c3-b727-3003-9cbe-b71500756887",
                                "text": "Niet een van de gevangenen die worden opgehangen in de Saydnaya-gevangenis ontvangt deze gruwelijke straf na iets wat ook maar in de verste verte lijkt op een eerlijk proces, stelt Amnesty. „Een zogenaamde militaire rechtbank veroordeelt een gevangene in een procedure die spot met alle rechtsnormen en niet meer dan twee minuten in beslag neemt.”"
                            },
                            {
                                "example_id": "f63b827e-719b-4bf1-89f2-6a813b4a2162",
                                "sense_id": "b4da96c3-b727-3003-9cbe-b71500756887",
                                "text": "Daarnaast is de SPD bij monde van haar binnenlandwoordvoerder tegen vervaging van de grens tussen vrede en oorlog, situaties waarin verschillende rechtsnormen gelden."
                            }
                        ]
                    }
