                        ],
                        "form": "more artificially"
                    },
                    {
                        "form_id": "2f69451e-ae99-4748-9d51-7e2ef0f52759",
                        "entry_id": "c2075a85-fe60-31b3-a299-480dab89acd0",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most artificially"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "955ccda6-37fb-3753-a9e9-d94cbccb788d",
                        "entry_id": "c2075a85-fe60-31b3-a299-480dab89acd0",
                        "glosses": [
                            "In an artificial manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53d479bb-360a-435c-9c11-94779ad35fc4",
                                "sense_id": "955ccda6-37fb-3753-a9e9-d94cbccb788d",
                                "text": "The actor spoke his lines artificially, with too much intonation."
                            },
                            {
                                "example_id": "1510c092-ad47-46bd-82c5-309a433bd296",
                                "sense_id": "955ccda6-37fb-3753-a9e9-d94cbccb788d",
                                "text": "These albuminous substances, whether found as normal products or created artificially in the blood, are distinguished as antitoxins, protective proteïds, vaccines, or alexines; physiologically they have been divided into sozines, those found in animals naturally immune, and phylaxines, those found in animals which by subcutaneous injections have artificially been made immune."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd6a33ca-0ddc-38e3-8ae5-ba06fdff7a1c",
                        "entry_id": "c2075a85-fe60-31b3-a299-480dab89acd0",
                        "glosses": [
                            "By or because of human effort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee12adb1-f8cf-499e-99c6-4c68361516dd",
                                "sense_id": "bd6a33ca-0ddc-38e3-8ae5-ba06fdff7a1c",
                                "text": "The chocolate was flavoured artificially."
                            },
                            {
                                "example_id": "1cd24b39-c167-4924-9d9e-4c7402abacc0",
                                "sense_id": "bd6a33ca-0ddc-38e3-8ae5-ba06fdff7a1c",
                                "text": "This lake had been artificially made by the damming up of the stream that had previously wasted itself unornamentally, […]"
                            },
                            {
                                "example_id": "69b69e73-3436-4094-a80a-d66a3316e1b3",
                                "sense_id": "bd6a33ca-0ddc-38e3-8ae5-ba06fdff7a1c",
                                "text": "Images taken from an electron microscope reveal the way the gold atoms have formed into a highly organised lattice. Other images show gold nanoseaweed that has been artificially coloured."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae043a1f-5340-4190-bdf2-81b30eeaaf0f",
                        "source_entry_id": "c2075a85-fe60-31b3-a299-480dab89acd0",
                        "source_sense_description": "in an artificial manner",
                        "target_lang_word": "uměle",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uměle",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "cbfe0b8f-bb4f-3229-948d-c9577525f200",
                                        "entry_id": "36323b28-bccf-379b-95f3-eb756a46cfc6",
                                        "glosses": [
                                            "způsobem, který není obvyklý v přírodě"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcd39fac-2736-4592-be9c-a922e7dc7298",
                                                "sense_id": "cbfe0b8f-bb4f-3229-948d-c9577525f200",
                                                "text": "Tento druh papoušků je potřeba odchovávat uměle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f14cba9-6b94-4498-a15e-6917420315db",
                        "source_entry_id": "c2075a85-fe60-31b3-a299-480dab89acd0",
                        "source_sense_description": "in an artificial manner",
                        "target_lang_word": "artificiellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "artificiellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78e88d6a-aab6-32c6-b3a8-93ebc7c5e945",
                                        "entry_id": "c329308d-2a63-39fd-afd9-a764c64a6288",
                                        "glosses": [
                                            "D’une manière artificielle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f67926f-5981-4f0f-9072-f807f151c4ef",
                                                "sense_id": "78e88d6a-aab6-32c6-b3a8-93ebc7c5e945",
                                                "text": "Les petits districts très différents qui se trouvent soudés artificiellement dans le Tarn-et-Garonne retrouveront leur vitalité quand, échappés à un compartimentage mal conçu, ils seront de nouveau mêlés aux vastes divisions provinciales commandées par la nature des choses."
                                            },
                                            {
                                                "example_id": "c0f76b0c-5898-440a-b928-0b27fbaa6afd",
                                                "sense_id": "78e88d6a-aab6-32c6-b3a8-93ebc7c5e945",
                                                "text": "La haine des peuples est si peu forte que, lorsque la guerre est là, il faut la créer artificiellement par le mensonge."
                                            },
                                            {
                                                "example_id": "d5c0bb57-a62a-4476-b3f0-ff291b47087d",
                                                "sense_id": "78e88d6a-aab6-32c6-b3a8-93ebc7c5e945",
                                                "text": "De même le chasseur, quand il intervint pour guider les migrations naturelles des troupeaux, qu’il se contentait au début de suivre, devint un pasteur ; puis éleveur, quand il fit venir artificiellement, « agriculturalement », une partie du fourrage."
                                            },
                                            {
                                                "example_id": "53e104cd-9c10-4716-b589-b0cf8e07b268",
                                                "sense_id": "78e88d6a-aab6-32c6-b3a8-93ebc7c5e945",
                                                "text": "Si vous me parlez que ça se mange alors c'est sans doute l'histoire des baby-bœufs dont on a beaucoup parlé récemment, ces pauvres bêtes que l'on engraissait artificiellement rien que pour la boucherie."
                                            },
                                            {
                                                "example_id": "1266ca54-ac63-4c13-807e-447a8024abe5",
                                                "sense_id": "78e88d6a-aab6-32c6-b3a8-93ebc7c5e945",
                                                "text": "En effet, 85 % d’entre elles sont irriguées artificiellement, selon les chiffres du Comité national interprofessionnel de la pomme de terre (CNIPT), et ont donc été relativement épargnées par cet été horribilis."
                                            },
                                            {
                                                "example_id": "0ab693c9-f68b-4908-a5db-274616d1990e",
                                                "sense_id": "78e88d6a-aab6-32c6-b3a8-93ebc7c5e945",
                                                "text": "Gloussements, pouffements, puis les rires finissent par éclater. Forcés, produits artificiellement, ils n'en sont pas moins communicatifs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a01bb6d-b4d4-4485-a9af-a9c732d0947f",
                        "source_entry_id": "c2075a85-fe60-31b3-a299-480dab89acd0",
                        "source_sense_description": "in an artificial manner",
                        "target_lang_word": "künstlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "künstlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2c8b9d4-0c6d-3b43-b4a4-181a027c2cf0",
                                        "entry_id": "a3fde6ca-a5c9-30df-b2ab-59abe5154b9c",
                                        "glosses": [
                                            "nicht natürlich, sondern technisch nach Vorbildern aus der Natur nachgebildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "198ed5a5-280a-42d8-9c96-ad92d3e61a8b",
                                                "sense_id": "d2c8b9d4-0c6d-3b43-b4a4-181a027c2cf0",
                                                "text": "Ihm wurde ein künstliches Kniegelenk eingebaut."
                                            },
                                            {
                                                "example_id": "0f4df655-a229-4d79-bd85-d1d04ec7c9af",
                                                "sense_id": "d2c8b9d4-0c6d-3b43-b4a4-181a027c2cf0",
                                                "text": "Das künstliche Licht machte die Nacht zum Tag und veränderte die Lebensverhältnisse des Menschen entscheidend."
                                            },
                                            {
                                                "example_id": "647dc749-ecb0-446c-832c-2b295f4b38a9",
                                                "sense_id": "d2c8b9d4-0c6d-3b43-b4a4-181a027c2cf0",
                                                "text": "„Freunde und Profis des Klettersports haben eine neue Möglichkeit, in Berlin an künstlichen Felswänden zu trainieren.“"
                                            },
                                            {
                                                "example_id": "89cb9962-a1d2-4d30-9c37-47d9cb657497",
                                                "sense_id": "d2c8b9d4-0c6d-3b43-b4a4-181a027c2cf0",
                                                "text": "Ein künstlicher Bach belebt den Garten."
                                            },
                                            {
                                                "example_id": "251e6b15-eb88-4f9c-b4bf-06b6031e4daa",
                                                "sense_id": "d2c8b9d4-0c6d-3b43-b4a4-181a027c2cf0",
                                                "text": "Manche Wissenschaftler träumen von der künstlichen Intelligenz und ihrer Realisierung in kleinen Hausrobotern, die uns voller Umsicht alle lästigen Arbeiten abnehmen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3731edb3-4b5b-32cd-8d16-74dbcacdb89c",
                                        "entry_id": "a3fde6ca-a5c9-30df-b2ab-59abe5154b9c",
                                        "glosses": [
                                            "nicht auf natürliche Art und Weise ablaufend, aber natürliche Prozesse imitierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09f5396b-bb16-46f7-b9c0-f1863e859af8",
                                                "sense_id": "3731edb3-4b5b-32cd-8d16-74dbcacdb89c",
                                                "text": "In England begann man in Bourn Hall mit der künstlichen Befruchtung von Eizellen."
                                            },
                                            {
                                                "example_id": "865f1f75-caf2-4ae7-9d63-4f4b8df9d823",
                                                "sense_id": "3731edb3-4b5b-32cd-8d16-74dbcacdb89c",
                                                "text": "Im Gegensatz zur natürlichen sprechen wir hier von der künstlichen Synthese."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c8a74457-9f6d-3651-85e5-01d50a1e8bbf",
                                        "entry_id": "a3fde6ca-a5c9-30df-b2ab-59abe5154b9c",
                                        "glosses": [
                                            "gekünstelt, unnatürlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ab228d3-0af2-4592-b93b-179af960987d",
                                                "sense_id": "c8a74457-9f6d-3651-85e5-01d50a1e8bbf",
                                                "text": "Sie antwortete mit einem künstlichen Lachen."
                                            },
                                            {
                                                "example_id": "e5b3bee7-61f1-48cd-a37f-1c91e8ff1fbd",
                                                "sense_id": "c8a74457-9f6d-3651-85e5-01d50a1e8bbf",
                                                "text": "Wolfgang regt sich bei dem Thema immer gleich so künstlich auf, dabei hat er doch eigentlich gar keine Probleme damit, oder?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "76acbc73-a08c-3680-b218-6dad8e68d2e2",
                                        "entry_id": "a3fde6ca-a5c9-30df-b2ab-59abe5154b9c",
                                        "glosses": [
                                            "eine Kunst beziehungsweise ein Kunstwerk darstellend"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac357d9d-512a-4ebb-b2be-f79de1a9487a",
                                                "sense_id": "76acbc73-a08c-3680-b218-6dad8e68d2e2",
                                                "text": "„Er zerrt voll roher Lust und Tücke / Der Tante künstliches Gestricke“"
                                            },
                                            {
                                                "example_id": "0a053a7d-5285-43cd-b767-580b509a5f48",
                                                "sense_id": "76acbc73-a08c-3680-b218-6dad8e68d2e2",
                                                "text": "Würcken, ist eine künstliche Arbeit des Frauenzimmers, da auf einem Würckstuhle, mit Wolle oder Seide von allerhand Farben, Blumen, Früchte und andere Dinge, nach dem Leben abgebildet, und durch ein zartes Gewebe zierlich herausgebracht werden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
