                    {
                        "translation_id": "e1bb17ee-2551-4bc0-80c4-0d4f80bc2635",
                        "source_entry_id": "63756ce1-e9a9-3f5f-abe3-a01c96a9861e",
                        "source_sense_id": "8ce11a28-7f98-3984-a4f7-19a1522fb278",
                        "target_lang_word": "glande pinéale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glande pinéale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1d812e2-9954-3e8a-b22d-2fcb69e934a9",
                                        "entry_id": "3d9ee467-933f-3ed3-8976-5373ee21b519",
                                        "glosses": [
                                            "Une petite glande endocrine de l’épithalamus du cerveau des vertébrés qui sécrète la mélatonine, et joue par son intermédiaire un rôle central dans la régulation du rythme biologique (jour et nuit, saison, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd03eca6-84f3-4973-8d61-c6c5f82777d0",
                                                "sense_id": "a1d812e2-9954-3e8a-b22d-2fcb69e934a9",
                                                "text": "Nos corps sont si semblables qu’un seul chromosome provoque la trisomie 21, qu’une toute petite atrophie de la glande pinéale ouvre la porte à la cruauté et à la violence extrême, qu’un mince dérèglement du niveau de la sérotonine provoque des hallucinations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
