                    },
                    {
                        "form_id": "45dee52a-036e-4cd5-9e82-778f0b5cc914",
                        "entry_id": "5e77acb5-64ec-3604-af34-cfc2a1deb85e",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "tragedietjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9af7b34-58c5-3918-baaa-3bed44243f0b",
                        "entry_id": "5e77acb5-64ec-3604-af34-cfc2a1deb85e",
                        "glosses": [
                            "een toneelspel dat handelt over een bedroevende gebeurtenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "389677d5-8aa3-4352-9fd0-bf75ed30dd45",
                                "sense_id": "d9af7b34-58c5-3918-baaa-3bed44243f0b",
                                "text": "Een tragedie begint altijd met een proloog."
                            },
                            {
                                "example_id": "944afade-2310-4ba7-aea3-70ffe0c3ae31",
                                "sense_id": "d9af7b34-58c5-3918-baaa-3bed44243f0b",
                                "text": "Wanneer de geschiedenis zich herhaalt is dat of in de vorm van een tragedie of in de vorm van een klucht."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b5c0e16-9b8f-3a88-bf9b-00ce962f96a3",
                        "entry_id": "5e77acb5-64ec-3604-af34-cfc2a1deb85e",
                        "glosses": [
                            "gebeurtenis met een droevige of rampzalige afloop"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6ff05574-613f-42e7-85d4-6b2f89716dde",
                                "sense_id": "4b5c0e16-9b8f-3a88-bf9b-00ce962f96a3",
                                "text": "De overstromingen in Pakistan zijn vooral een menselijke tragedie voor miljoenen mannen en vrouwen."
                            },
                            {
                                "example_id": "85f68171-f0ae-4416-b7f7-125424884aaf",
                                "sense_id": "4b5c0e16-9b8f-3a88-bf9b-00ce962f96a3",
                                "text": "Met de dood van één van de klimmers mondde de expeditie uit in een tragedie."
                            },
                            {
                                "example_id": "d7dd3d28-e72e-4eb5-9b34-83640020d7d6",
                                "sense_id": "4b5c0e16-9b8f-3a88-bf9b-00ce962f96a3",
                                "text": "Voor Weppner is die toekomst al aangebroken. Hij kijkt naar de puinhopen in de straten en zegt: \"Het gaat hier om de slachtoffers, dat is de echte tragedie. Die gaan hierdoor failliet of worden hun huis uitgezet. Het is een drama. \""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee21473d-7fb7-44b5-9759-3104759841cd",
                        "source_entry_id": "5e77acb5-64ec-3604-af34-cfc2a1deb85e",
                        "source_sense_id": "d9af7b34-58c5-3918-baaa-3bed44243f0b",
                        "source_sense_description": "een toneelspel dat handelt over een bedroevende gebeurtenis",
                        "target_lang_word": "Tragödie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tragödie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbfa67d7-5432-3a78-a97d-d380a42ab431",
                                        "entry_id": "ad2618b5-82b9-3d47-b668-4dd3a8108a66",
                                        "glosses": [
                                            "dramatische Gattung; Drama, in dem es um Schicksal, Unglück und tragische Katastrophen geht, und das meistens ein negatives Ende hat"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bfdc658-814f-4416-8835-8241f41543db",
                                                "sense_id": "bbfa67d7-5432-3a78-a97d-d380a42ab431",
                                                "text": "Goethes „Faust“ ist eine Tragödie."
                                            },
                                            {
                                                "example_id": "a379408f-845d-483e-9325-9c7969ff76c9",
                                                "sense_id": "bbfa67d7-5432-3a78-a97d-d380a42ab431",
                                                "text": "„Zudem gibt es bei Euripides die für die griechische Tragödie obligaten Chorszenen.“"
                                            },
                                            {
                                                "example_id": "f8cc2397-bab3-4167-8c7a-80c636c6e9d3",
                                                "sense_id": "bbfa67d7-5432-3a78-a97d-d380a42ab431",
                                                "text": "„Was ihnen an der Tragödie gefiel, war das Pathos, die Reden über die Politik und den Verfall der Sitten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a029a4d-ee0b-3dbf-97e1-5ee5ee91c7a4",
                                        "entry_id": "ad2618b5-82b9-3d47-b668-4dd3a8108a66",
                                        "glosses": [
                                            "als katastrophal empfundenes Ereignis"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d989af10-1d65-4b85-9b60-ea5a9286d656",
                                                "sense_id": "7a029a4d-ee0b-3dbf-97e1-5ee5ee91c7a4",
                                                "text": "Das Geiseldrama war eine Tragödie."
                                            },
                                            {
                                                "example_id": "821b3e4b-fb72-4d61-ae20-f06241790b49",
                                                "sense_id": "7a029a4d-ee0b-3dbf-97e1-5ee5ee91c7a4",
                                                "text": "„Fast genau 30 Jahre nach der Tragödie läuft Ried durch eine Rokokokirche nicht weit vom Unglückssee.“"
                                            },
                                            {
                                                "example_id": "c3b4ad62-f5b2-4236-9dc7-5f2da3c3ecd0",
                                                "sense_id": "7a029a4d-ee0b-3dbf-97e1-5ee5ee91c7a4",
                                                "text": "„In der Kirche hatte der Bürgermeister über die unfassbare Tragödie gesprochen, die unser Dorf heimgesucht hatte, und über den unmenschlichen Verlust, den sie verursacht hatte, einer der schlimmsten Erdrutsche in der Geschichte Norwegens, hatte er gesagt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff24ab3f-122c-4de0-9d9a-0fdc31f46dab",
                        "source_entry_id": "5e77acb5-64ec-3604-af34-cfc2a1deb85e",
                        "source_sense_id": "d9af7b34-58c5-3918-baaa-3bed44243f0b",
                        "source_sense_description": "een toneelspel dat handelt over een bedroevende gebeurtenis",
                        "target_lang_word": "tragedy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tragedy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d63a0dd6-01a0-36c2-bdf2-67c5034521f8",
                                        "entry_id": "73f17e95-abfb-35b9-9fe9-731ecc1e693c",
                                        "glosses": [
                                            "A drama or similar work, in which the main character is brought to ruin or otherwise suffers the extreme consequences of some tragic flaw or weakness of character."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b69df3ef-fed0-37dc-abfd-7df7a91fe382",
                                        "entry_id": "73f17e95-abfb-35b9-9fe9-731ecc1e693c",
                                        "glosses": [
                                            "The genre of such works, and the art of producing them."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a4afa41-730f-3a2e-bc57-968ff9c1d424",
                                        "entry_id": "73f17e95-abfb-35b9-9fe9-731ecc1e693c",
                                        "glosses": [
                                            "A disastrous event, especially one involving great loss of life or injury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ba4c6f5-3c43-4952-941c-b0aedde02d4e",
                                                "sense_id": "7a4afa41-730f-3a2e-bc57-968ff9c1d424",
                                                "text": "“The story of this adoption is, of course, the pivot round which all the circumstances of the mysterious tragedy revolved. Mrs. Yule had an only son, namely, William, to whom she was passionately attached; but, like many a fond mother, she had the desire of mapping out that son's future entirely according to her own ideas.[…]”"
                                            },
                                            {
                                                "example_id": "cad234cd-d336-455f-8101-7700c2c09ce7",
                                                "sense_id": "7a4afa41-730f-3a2e-bc57-968ff9c1d424",
                                                "text": "[…] last month's flooding in the Buffalo Creek Valley […]. The tragedy took more than one hundred lives[…]"
                                            },
                                            {
                                                "example_id": "60e44686-14e5-4c9d-a3ac-283c31f57f5c",
                                                "sense_id": "7a4afa41-730f-3a2e-bc57-968ff9c1d424",
                                                "text": "After the terrible tragedy of the Triangle Shirtwaist Fire in 1911, which killed 146 New York garment workers, proper fire drilling was considered a necessity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07df3c41-1daa-47d5-abcb-c1e6d16ffc8d",
                        "source_entry_id": "5e77acb5-64ec-3604-af34-cfc2a1deb85e",
                        "source_sense_id": "d9af7b34-58c5-3918-baaa-3bed44243f0b",
                        "source_sense_description": "een toneelspel dat handelt over een bedroevende gebeurtenis",
                        "target_lang_word": "tragedia",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tragedia",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7019dc49-9871-3d94-9fa6-204b2ca4f4af",
                                        "entry_id": "5627e662-602f-31aa-a72f-1c549141ac1b",
                                        "glosses": [
                                            "Tipo de drama (obra de teatro) en que el personaje principal sufre las consecuencias funestas de un sino o destino adverso, o se debe enfrentar a una decisión fatal de los dioses. Se practicaba en la antigua Grecia con ayuda de un coro y desarrollaba temas de la antigua épica con propósito de catarsis (purificación del ánimo a través de la expresión de sentimientos intensos), especialmente de dolor u horror y compasión."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df11b8c4-4860-427a-bfc1-c1cb7641b68f",
                                                "sense_id": "7019dc49-9871-3d94-9fa6-204b2ca4f4af",
                                                "text": "Los Persas de Esquilo es una tragedia basada en la victoria de los griegos en la batalla de Salamina"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "075a12f9-e56f-3f8f-86f8-ab460d045724",
                                        "entry_id": "5627e662-602f-31aa-a72f-1c549141ac1b",
                                        "glosses": [
                                            "Género o estilo de este tipo de obras₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1ee0a2f-7010-437b-83bd-df90aac68e6f",
                                                "sense_id": "075a12f9-e56f-3f8f-86f8-ab460d045724",
                                                "text": "Las Troyanas, de Eurípides, es una tragedia que relata la desventura y el sufrimiento de las mujeres de los vencidos en la guerra de Troya"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3656ac6f-b029-3aaa-83cc-141378bc4e42",
                                        "entry_id": "5627e662-602f-31aa-a72f-1c549141ac1b",
                                        "glosses": [
                                            "Suceso o situación que produce gran sufrimiento, siendo generalmente de consecuencias irreparables."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ddb3a06-c418-4f7b-8f22-91fedcd293e3",
                                                "sense_id": "3656ac6f-b029-3aaa-83cc-141378bc4e42",
                                                "text": "Su muerte en ese accidente resultó una verdadera tragedia para la familia"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
