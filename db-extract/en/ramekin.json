                        "entry_id": "a142efa4-6264-33ac-a80b-7a8303597d64",
                        "glosses": [
                            "A small glass or earthenware dish, often white and circular, in which food is baked and served."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0364b42-1f26-41b8-87ef-83e0dbbf2846",
                                "sense_id": "3d7b0dce-9961-37e3-9031-12c47aacd6a8",
                                "text": "The starters have arrived, two triangles of buttered brown bread and a neat little ramekin of crab buried under a haystack of cress, which Smith promptly relocates so that she can sprinkle it over each mouthful."
                            },
                            {
                                "example_id": "ab562798-3f10-4c7c-a850-2b3997a74b15",
                                "sense_id": "3d7b0dce-9961-37e3-9031-12c47aacd6a8",
                                "text": "Setting the soufflés before us, the waitress warns that the ramekins are hot."
                            }
                        ]
                    },
                    {
                        "sense_id": "322c1464-8a36-3ca1-9269-23b2eb904c32",
                        "entry_id": "a142efa4-6264-33ac-a80b-7a8303597d64",
                        "glosses": [
