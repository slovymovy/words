                        "sense_id": "90298228-35d2-3e58-a40a-678d265126a3",
                        "entry_id": "520fa8ae-6a55-306b-96df-d9fc1aafdc37",
                        "glosses": [
                            "Personne qui a une attirance pour les fesses humaines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d461b9dc-a44e-4fc6-90bb-969ac59e1734",
                                "sense_id": "90298228-35d2-3e58-a40a-678d265126a3",
                                "text": "Ce qui risque de vous paraître encore plus surprenant, bredouilla le pygophile, c’est qu’au fil des années je suis devenu beaucoup plus amateur de grosses fesses."
                            },
                            {
                                "example_id": "b35e2da2-ca1e-496e-b5ce-1b437a7953a8",
                                "sense_id": "90298228-35d2-3e58-a40a-678d265126a3",
                                "text": "Heureusement il nous reste, à nous pygophiles différentialistes et distingués (car non, tout cul n’en vaut pas un autre), les albums de Robert Crumb, les exclamations extatiques de Jean-Pierre Marielle devant le postérieur de Jeanne Goupil ou les films de Tinto Brass."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b13d1c6-1c58-4031-b1b1-a6f653dc5c5d",
                        "source_entry_id": "520fa8ae-6a55-306b-96df-d9fc1aafdc37",
                        "source_sense_id": "90298228-35d2-3e58-a40a-678d265126a3",
