                "senses": [
                    {
                        "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                        "entry_id": "f483e4de-071d-304e-a5d7-5ae1333b0f4d",
                        "glosses": [
                            "Sprache der Zigeuner (= Roma bzw. Sinti und Roma)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72f31c47-5dfc-4bdd-a0f0-c062850dbe4b",
                                "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                "text": "Die Zigeunersprache gehört zum indo-iranischen Zweig der indogermanischen Sprachen."
                            },
                            {
                                "example_id": "297f6be9-3a89-4dc8-851a-3a0e662c9225",
                                "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                "text": "„Und seit dem ersten Drittel des fünfzehnten Jahrhunderts hat das Rotwelsch auch vieles aus der Zigeunersprache empfangen.“"
                            },
                            {
                                "example_id": "c7cc20fd-8b03-40ac-bbd9-08adb1b24049",
                                "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                "text": "„Alle genannten Sprachen gehören dem indogermanischen Stamm an, ebenso die in Dialekte aufgespaltene, weit außerhalb Indiens bis nach Europa hin gesprochene Zigeunersprache.“"
                            },
                            {
                                "example_id": "2e7ab4da-ed1a-4c29-82ac-8a1bcae04679",
                                "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                "text": "„Bei dem dreitägigen Verhör in Stuttgart erklärten alle, sie würden derselben Familie angehören, von Zigeunern abstammen und die Zigeunersprache sprechen: also ein deutlicher Beweis, daß sie sich selbst als Mitglieder einer ethnischen Gruppe betrachteten.“"
                            },
                            {
                                "example_id": "794b3e13-849f-4a9f-9db4-5ec31709bb7f",
                                "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                "text": "„Einen Teil seiner Wörter verdankt das Rotwelsch deutschen Dialekten; ein anderer, großer Teil geht aber auf das Jiddische und die Zigeunersprache zurück.“"
                            },
                            {
                                "example_id": "ccbfae96-3e51-4b7f-b5ca-5ece2d35c21a",
                                "sense_id": "6a47acc6-e12c-3dcb-b79f-d5e37afab842",
                                "text": "„Es erscheint ganz logisch, daß in die Geheimsprachen der Räuber und Vaganten hebräische, jiddische Begriffe und Begriffe der Zigeunersprache Eingang gefunden haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
