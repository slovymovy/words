                                "sense_id": "d3239ae4-1cc7-3f74-b180-1a481b4ea1b4",
                                "text": "Sami Bouajila."
                            },
                            {
                                "example_id": "6bb3e699-75b4-48d1-85a3-5cae3c584df6",
                                "sense_id": "d3239ae4-1cc7-3f74-b180-1a481b4ea1b4",
                                "text": "Cette chronique familiale évoque ses proches et notamment son frère cadet, incarné par Sami Bouajila, qui change de comportement après avoir été victime d’une commotion cérébrale."
                            },
                            {
                                "example_id": "bb9e798c-8ea4-41a5-8ae8-e7bcdd2908e3",
                                "sense_id": "d3239ae4-1cc7-3f74-b180-1a481b4ea1b4",
                                "text": "Sami, 19 ans, en terminale, veut devenir éducateur spécialisé."
                            },
                            {
                                "example_id": "526f241c-c0dd-416a-af93-6c5c2a4b7f01",
                                "sense_id": "d3239ae4-1cc7-3f74-b180-1a481b4ea1b4",
                                "text": "Le photographe amateur Sami Al Hinai a pu capturer l’une de ces épreuves."
                            }
                        ]
                    }
