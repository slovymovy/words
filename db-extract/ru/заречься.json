                "senses": [
                    {
                        "sense_id": "6c11169f-6791-3e84-8df2-63f5659b7eca",
                        "entry_id": "9fd33aa9-8d2e-3ac1-9fd2-ade59a67bcb2",
                        "glosses": [
                            "дать зарок, обещание не делать чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21dc8314-b944-49d3-83e6-8fc5c3d63379",
                                "sense_id": "6c11169f-6791-3e84-8df2-63f5659b7eca",
                                "text": "Ты зарекся говорить по-французски, бредишь всем русским ― и ходишь еще во фраке."
                            },
                            {
                                "example_id": "99f38723-66c3-48a8-ac56-f11a33d1a52e",
                                "sense_id": "6c11169f-6791-3e84-8df2-63f5659b7eca",
                                "text": "Никита не был пьян в этот день потому, что он был пьяница, и теперь, с заговен, во время которых он пропил с себя поддёвку и кожаные сапоги, он зарёкся пить и не пил второй месяц."
                            }
                        ]
                    }
