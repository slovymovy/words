                ],
                "senses": [
                    {
                        "sense_id": "398f478a-690f-3095-b74e-cc43c60fd266",
                        "entry_id": "3123b53a-2b63-38f3-beff-461cf49567aa",
                        "glosses": [
                            "Umstand, unter dem gearbeitet wird"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "0c9486b4-8e31-4638-ade1-b0e858c8aeb4",
                                "sense_id": "398f478a-690f-3095-b74e-cc43c60fd266",
                                "text": "„Die Arbeitsbedingungen des akademischen Mittelbaus verschlechtern sich zusehends. So haben mittlerweile 85 Prozent der wissenschaftlichen Mitarbeiter an der Universität Hamburg befristete Verträge.“"
                            },
                            {
                                "example_id": "57b66f3f-9204-483b-a3b0-a04b787b7bec",
                                "sense_id": "398f478a-690f-3095-b74e-cc43c60fd266",
                                "text": "„Rund 80 Prozent der weltweiten Silberförderung zwischen 1500 und 1800 fand in den Bergwerken der spanischen Kolonien statt - unter brutalen Arbeitsbedingungen für Einheimische und Sklaven.“"
                            },
                            {
                                "example_id": "70ee739e-02c7-4849-9575-9442298adada",
                                "sense_id": "398f478a-690f-3095-b74e-cc43c60fd266",
                                "text": "„Die Arbeitsbedingungen in den Salpetergruben waren schrecklich, die Angestellten mussten pro Tag 16 Stunden arbeiten und erhielten dafür einen Lohn, der gerade mal dem Existenzminimum entsprach.“"
                            },
                            {
                                "example_id": "36858189-8e17-4429-9688-dc977a89ac8b",
                                "sense_id": "398f478a-690f-3095-b74e-cc43c60fd266",
                                "text": "„Daneben traf Cornwallis auch Vorkehrungen für die Verbesserung der Arbeitsbedingungen der Bürokratie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a61cd0bd-75ec-4abf-8048-b07198d7ccdf",
                        "source_entry_id": "3123b53a-2b63-38f3-beff-461cf49567aa",
                        "source_sense_id": "398f478a-690f-3095-b74e-cc43c60fd266",
