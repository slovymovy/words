{
    "word_family": [
        "sleep",
        "sleepy",
        "sleeper",
        "sleepiness",
        "over sleeper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b30e94ca-a898-3728-9e0a-ad5168646da5",
                    "sense_definition": "To sleep past the intended time, often resulting in being late.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I regularly <w>oversleep</w> on Monday mornings when my alarm does not go off. ",
                            "target_lang_translations": {
                                "ru": "Я регулярно <w>просыпаю</w> по понедельникам, когда не срабатывает будильник."
                            }
                        },
                        {
                            "text": "She was worried she would <w>oversleep</w> and miss her morning exam.",
                            "target_lang_translations": {
                                "ru": "Она переживала, что <w>проспит</w> и пропустит утренний экзамен."
                            }
                        }
                    ],
                    "antonyms": [
                        "undersleep"
                    ],
                    "common_phrases": [
                        "tend to oversleep",
                        "prone to oversleep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спать дольше намеченного времени, что часто приводит к опозданию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проспать",
                                "target_lang_sense_clarification": "совершенный вид"
                            },
                            {
                                "target_lang_word": "просыпать",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "заспаться",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "254a460b-5673-39f0-9b1a-1d0a7eae146f",
                    "sense_definition": "To sleep past a specific time or to sleep through a planned event.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He accidentally <w>overslept</w> his usual hour of rising and had to rush to work.",
                            "target_lang_translations": {
                                "ru": "Он случайно <w>проспал</w> свой обычный час подъёма, и ему пришлось бежать на работу."
                            }
                        },
                        {
                            "text": "If you <w>oversleep</w> the alarm again, you will miss the morning flight.",
                            "target_lang_translations": {
                                "ru": "Если ты снова <w>проспишь</w> будильник, то опоздаешь на утренний рейс."
                            }
                        }
                    ],
                    "common_phrases": [
                        "oversleep the alarm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проспать дольше определенного времени или проспать запланированное событие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проспать",
                                "target_lang_sense_clarification": "что-либо (например, будильник, работу)"
                            },
                            {
                                "target_lang_word": "просыпать",
                                "target_lang_sense_clarification": "что-либо (регулярно)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}