                    {
                        "translation_id": "ac04ce5e-d79b-4b9e-9e80-f80e9b24c1a2",
                        "source_entry_id": "4288a78b-17be-31fd-aea4-2029bdf941d5",
                        "source_sense_id": "34baf17d-ed4f-3ac2-85ac-d5356f5885e2",
                        "source_sense_description": "iemand die voor zijn beroep de zee bevaart",
                        "target_lang_word": "navigator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "navigator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bdb9a77-6e54-3081-96e5-22a77a6b63f6",
                                        "entry_id": "ac5f6dab-8ad3-3b02-b3c9-51ef5817d4aa",
                                        "glosses": [
                                            "A person who navigates, especially an officer with that responsibility on a ship or an aircrew member with that responsibility on an aircraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6383df79-daed-4112-81d5-7fb3d9fc5e7e",
                                                "sense_id": "2bdb9a77-6e54-3081-96e5-22a77a6b63f6",
                                                "text": "The increases kept many navigator groups, which help people pick policies, very busy.\nAt the United Way of Metropolitan Dallas, 34 navigators helped up to 120 residents select plans each week during this open enrollment season, which ran from November 1 through January 16, said Daniel Bouton, vice president for health and wellness at the nonprofit group."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a0f1006-a607-3b31-81b0-3e8362116cf6",
                                        "entry_id": "ac5f6dab-8ad3-3b02-b3c9-51ef5817d4aa",
                                        "glosses": [
                                            "A sea explorer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8bd6e03-8a61-40ed-9202-76a35471c4fd",
                                                "sense_id": "3a0f1006-a607-3b31-81b0-3e8362116cf6",
                                                "text": "He felt having a Micronesian navigator meant he needed a pureblooded Polynesian, preferably a Hawaiian, as captain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3fa7e77-fde8-3e85-9cd2-70b3ce3cc05a",
                                        "entry_id": "ac5f6dab-8ad3-3b02-b3c9-51ef5817d4aa",
                                        "glosses": [
                                            "A device that navigates an aircraft, automobile or missile."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1dc6eb25-763e-318d-a50a-9db7594c691f",
                                        "entry_id": "ac5f6dab-8ad3-3b02-b3c9-51ef5817d4aa",
                                        "glosses": [
                                            "A user interface that allows navigating through a structure of any kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "011b5be1-ef17-4090-bd75-994094fce87a",
                                                "sense_id": "1dc6eb25-763e-318d-a50a-9db7594c691f",
                                                "text": "Although the window looks like a view of files and folders on disk, the “folders” that appear here are called groups; they don't exist on disk. They appear in the navigator because it's convenient to group related files together […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "077f2ea9-a75a-3691-a697-d98d08387677",
                                        "entry_id": "ac5f6dab-8ad3-3b02-b3c9-51ef5817d4aa",
                                        "glosses": [
                                            "A labourer on an engineering project such as a canal; a navvy."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1274161b-a132-4519-bebe-f51c0424e360",
                        "source_entry_id": "4288a78b-17be-31fd-aea4-2029bdf941d5",
                        "source_sense_id": "34baf17d-ed4f-3ac2-85ac-d5356f5885e2",
                        "source_sense_description": "iemand die voor zijn beroep de zee bevaart",
                        "target_lang_word": "marin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                        "entry_id": "a196e9f3-d26f-37d2-85bc-99c3b1987f0d",
                                        "glosses": [
                                            "Qui appartient à la mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9a01e26-f91f-46bd-b437-62fe317ef403",
                                                "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                                "text": "Si tout le tableau donnait cette impression des ports où la mer entre dans la terre, où la terre est déjà marine et la population amphibie, la force de l'élément marin éclatait partout ; […]"
                                            },
                                            {
                                                "example_id": "b2047151-4e12-4190-9c17-58978e60067e",
                                                "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                                "text": "Enfin, comme à dessein de le rendre plus complexe, des odeurs de caroube, de denrées coloniales, de goudron, d'air marin arrivaient puissamment du port et se mêlaient à celles qui montaient des pavés et des caves."
                                            },
                                            {
                                                "example_id": "539e67e9-9bd8-4839-93e9-0fd8efdf4f31",
                                                "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                                "text": "Il plongea ensuite entre ses cuisses, là où la matrice avait le goût salé des embruns marins."
                                            },
                                            {
                                                "example_id": "3c96012e-4100-4daa-b3cf-1a6eb1a5de12",
                                                "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                                "text": "Veau, loup, cheval marin."
                                            },
                                            {
                                                "example_id": "a3c6bc61-a7ca-4e71-95f0-4d5f1cc7863f",
                                                "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                                "text": "Terrains marins : Couches du sol qui ont été formées par des alluvions de la mer."
                                            },
                                            {
                                                "example_id": "0e09f7b2-88c9-4af7-9d74-2bdad4c249ea",
                                                "sense_id": "907719ba-0c56-3f75-9ae5-eb76217e3039",
                                                "text": "Les dieux marins : les dieux de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bceea43-a9a7-305b-bc64-229ba80f970c",
                                        "entry_id": "a196e9f3-d26f-37d2-85bc-99c3b1987f0d",
                                        "glosses": [
                                            "Qui est spécialement destiné à la marine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d33cc86-b48f-4a7c-ae8f-e9829d2c26b9",
                                                "sense_id": "2bceea43-a9a7-305b-bc64-229ba80f970c",
                                                "text": "Carte, aiguille marine."
                                            },
                                            {
                                                "example_id": "53982699-a369-436a-a72b-3f22b58f5a73",
                                                "sense_id": "2bceea43-a9a7-305b-bc64-229ba80f970c",
                                                "text": "Lieue marine : Lieue d’un vingtième de degré de latitude et qui vaut environ 5 555 mètres."
                                            },
                                            {
                                                "example_id": "1b4cf139-2276-4db7-87e5-3e7c7e93498e",
                                                "sense_id": "2bceea43-a9a7-305b-bc64-229ba80f970c",
                                                "text": "Trompette marine : → voir trompette"
                                            },
                                            {
                                                "example_id": "780190ed-e278-411a-8383-2efdc0a35069",
                                                "sense_id": "2bceea43-a9a7-305b-bc64-229ba80f970c",
                                                "text": "Avoir le pied marin : Savoir marcher sans difficulté à bord d’un vaisseau agité par le mouvement de la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08c94746-60f2-3785-a8db-a7ced9f67a5a",
                                        "entry_id": "a196e9f3-d26f-37d2-85bc-99c3b1987f0d",
                                        "glosses": [
                                            "Qui évoque un marin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387ed456-bab8-4992-a7c9-f2a2b45d7a77",
                                                "sense_id": "08c94746-60f2-3785-a8db-a7ced9f67a5a",
                                                "text": "Un jardinier persan vint à ma rencontre, pour me conduire au bureau du pasteur, un grand homme barbu et roux aux allures marines, à la poignée ferme et hospitalière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b03937b-1577-3422-a3fe-a55912a578e4",
                                        "entry_id": "a11dbdcd-03e7-3267-ac5b-0ec86978f550",
                                        "glosses": [
                                            "Celui qui est habile dans l’art de la navigation sur mer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7471b140-8903-37ef-bb88-3ad65ecd593e",
                                        "entry_id": "a11dbdcd-03e7-3267-ac5b-0ec86978f550",
                                        "glosses": [
                                            "Celui qui sert à bord d’un bâtiment de l’État ou de la marine marchande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35df0b11-b095-40c8-8cda-242e833a9585",
                                                "sense_id": "7471b140-8903-37ef-bb88-3ad65ecd593e",
                                                "text": "Les marins, vois-tu, ne ressemblent pas au reste du monde. J’en ai vu qui, au début de leur engagement, avaient entre les mains des sommes assez fortes. Ils imaginaient un divertissement singulier. Ils faisaient chauffer les écus dans un poêlon, puis les jetaient dans la rue, riant aux éclats des efforts de la canaille pour s’en saisir. C’était une façon de marquer qu’on ne se fait pas tuer pour des pièces de six francs, et que le courage et le devoir ne se payent pas."
                                            },
                                            {
                                                "example_id": "986e90f1-ae16-4f7e-981f-00f5dec20096",
                                                "sense_id": "7471b140-8903-37ef-bb88-3ad65ecd593e",
                                                "text": "Jean Donnard allait répondre, quand les sept marins et le mousse, qui formaient le reste de son équipage, apparurent sur la cale, portant leurs capotes de toile cirée et leurs paniers d’osier."
                                            },
                                            {
                                                "example_id": "a2291ae4-e3a4-434d-b454-d95305092c6d",
                                                "sense_id": "7471b140-8903-37ef-bb88-3ad65ecd593e",
                                                "text": "[…] et, quand il y pousserait de la graine d'épinard, un marin qui se respecte ne se résignera jamais à endosser la capote d'un fantassin..."
                                            },
                                            {
                                                "example_id": "e88522e1-c75c-4e57-9eba-75ac6fca80f2",
                                                "sense_id": "7471b140-8903-37ef-bb88-3ad65ecd593e",
                                                "text": "Le 4 octobre 1911, le Premier ministre Giolitti donne le coup d’envoi au départ d'un corps expéditionnaire. Il va vite atteindre les 100 000 hommes, marins et bersagliers, transportés par des centaines de navires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa15a284-28de-3818-96e8-02df16ca2000",
                                        "entry_id": "a11dbdcd-03e7-3267-ac5b-0ec86978f550",
                                        "glosses": [
                                            "Vent tiède, accompagné de pluie, soufflant du sud sur les côtes du golfe du Lion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "marin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af0eb9fc-2d9a-37d4-8a32-d27f9d81cce3",
                                        "entry_id": "e8fb406e-cd3c-39c3-ba0f-5c9e36ccdbd2",
                                        "glosses": [
                                            "Nom des déblais lors de la foration d’un tunnel."
                                        ],
                                        "tags": [
                                            "Génie civil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53ddeeb8-f88f-44ca-ab0f-688b49f2f188",
                                                "sense_id": "af0eb9fc-2d9a-37d4-8a32-d27f9d81cce3",
                                                "text": "Le tunnelier laisse derrière lui une quantité importante de marin qu’il faut évacuer très rapidement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "851639c0-eb31-343b-bfe9-f5f2d19b2f27",
                                        "entry_id": "e8fb406e-cd3c-39c3-ba0f-5c9e36ccdbd2",
                                        "glosses": [
                                            "Matériau de remplissage servant à la constitution de l’aire sous un parquet sur lambourdes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8cbeb97-b660-4da3-a99a-0559a3ebd28f",
                                                "sense_id": "851639c0-eb31-343b-bfe9-f5f2d19b2f27",
                                                "text": "Sur la partie supérieure, un lattis est utilisé puis recouvert d’une aire faîte de chaux et de plâtre, que l’on nomme également le marin. Sur cette aire, on forme ensuite des augets en plâtre qui servent à placer à niveau bien horizontal des lambourdes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e16822dd-4176-48c0-8521-ed48ad5092ee",
                        "source_entry_id": "4288a78b-17be-31fd-aea4-2029bdf941d5",
                        "source_sense_id": "34baf17d-ed4f-3ac2-85ac-d5356f5885e2",
                        "source_sense_description": "iemand die voor zijn beroep de zee bevaart",
                        "target_lang_word": "navigateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "navigateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3bfafd55-768d-3349-99cd-010ba124433f",
                                        "entry_id": "887940dc-4159-3762-9ca4-709b62853298",
                                        "glosses": [
                                            "Celui qui a fait sur mer des voyages de long cours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7ea6536-8408-4385-ba41-e3957ddbde7f",
                                                "sense_id": "3bfafd55-768d-3349-99cd-010ba124433f",
                                                "text": "Ainsi, les Bellilois, à l’encontre des autres insulaires morbihannais, sont moins des pêcheurs que des navigateurs."
                                            },
                                            {
                                                "example_id": "46ffd9dd-b82a-4c73-b6ae-2889bc4d4faa",
                                                "sense_id": "3bfafd55-768d-3349-99cd-010ba124433f",
                                                "text": "Marcher au grand air frais fut pour lui une sensation délicieuse, comme la promenade à terre pour le navigateur qui longtemps a été à la mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b61b30fc-6029-3bf4-9d63-b7547196f71c",
                                        "entry_id": "887940dc-4159-3762-9ca4-709b62853298",
                                        "glosses": [
                                            "Marin, homme apte à conduire un vaisseau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e2f0fe3-2a54-4aae-9369-9fd42238da19",
                                                "sense_id": "b61b30fc-6029-3bf4-9d63-b7547196f71c",
                                                "text": "Quant aux autres navigateurs recherchés, il s'agit principalement de marins d’eau douce qui pratiquent sur la Vire et les autres rivières de cette zone - la Taute, la Douve - le transport de la tangue, prélevée dans cette zone vaseuse d'estuaires formant la baie des Veys, et qui, chargée en bordure des rivages, est acheminée par péniches vers l'intérieur où elle est utilisée comme engrais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caec3335-58a3-3173-8361-9ec88967688d",
                                        "entry_id": "887940dc-4159-3762-9ca4-709b62853298",
                                        "glosses": [
                                            "Celui qui est chargé de la conduite d’un avion, d’un aérostat."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fe8b018-b239-4423-8916-d8881622e36d",
                                                "sense_id": "caec3335-58a3-3173-8361-9ec88967688d",
                                                "text": "L'installation de bord était sensiblement la même, avec cette différence, toutefois,[…] que de nouveaux instruments de contrôle de vol étaient installés dans l'habitacle du pilote et dans celui du navigateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "navigateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d169b14-9464-30f0-b9ec-fa60aaf7b4e4",
                                        "entry_id": "a7469564-2082-3587-aba2-8d64c568ca3f",
                                        "glosses": [
                                            "Logiciel utilisé pour surfer sur internet en utilisant le protocole HTTP, capable du rendu adéquat de pages rédigées avec le langage HTML et du suivi des liens hypertexte."
