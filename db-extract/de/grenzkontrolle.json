                ],
                "senses": [
                    {
                        "sense_id": "5754654f-f0b0-3ac9-ad00-5c56ee3d3d7c",
                        "entry_id": "965fdb0c-b912-3537-99c6-22f38bb9eeb2",
                        "glosses": [
                            "Überprüfung von Identitäten und eingeführten Gegenständen bei der Überschreitung von Grenzen zwischen Regionen oder Staaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa9053fd-d38e-4c41-9571-50b31167dcd2",
                                "sense_id": "5754654f-f0b0-3ac9-ad00-5c56ee3d3d7c",
                                "text": "„Als Reaktion auf die Flüchtlingskrise will die Bundesregierung nach Informationen von SPIEGEL ONLINE wieder Grenzkontrollen einführen und somit das Schengener Abkommen vorübergehend außer Kraft setzen.“"
                            },
                            {
                                "example_id": "a34fe74a-6b88-488d-aba5-f15feab7c709",
                                "sense_id": "5754654f-f0b0-3ac9-ad00-5c56ee3d3d7c",
                                "text": "„Seit dem Wegfall der Grenzkontrollen ist die Kriminalität durch international operierende Banden, die von Einbrüchen über Taschendiebstähle bis hin zu Überfällen alles Mögliche durchziehen, sprunghaft gestiegen.“"
                            },
                            {
                                "example_id": "cc9e8e1a-6a2f-413f-bd53-adfff5ac56a5",
                                "sense_id": "5754654f-f0b0-3ac9-ad00-5c56ee3d3d7c",
                                "text": "„Die Grenzkontrolle fiel ihm ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f0ecdd5c-cabd-3a66-896b-a4d2a61b0518",
                        "entry_id": "965fdb0c-b912-3537-99c6-22f38bb9eeb2",
                        "glosses": [
                            "Person beziehungsweise Institution, die [1] durchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "278bc4be-30a2-46ef-85e4-501b8bf9c8a0",
                                "sense_id": "f0ecdd5c-cabd-3a66-896b-a4d2a61b0518",
                                "text": "Die Grenzkontrolle winkte uns durch, ohne das Auto zu durchsuchen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
