                "senses": [
                    {
                        "sense_id": "68ba7509-1809-3d7f-bf1a-7a3ea07733d7",
                        "entry_id": "f3eb1843-b83d-3036-87e5-a57780da1f7c",
                        "glosses": [
                            "große Menge an (wehenden) Fahnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f50bd274-c69d-431b-bf5f-6d72f5c92267",
                                "sense_id": "68ba7509-1809-3d7f-bf1a-7a3ea07733d7",
                                "text": "„Die Fahnenmeere der NS-Zeit sind noch bitter im Gedächtnis.“"
                            },
                            {
                                "example_id": "19371ceb-7765-4a5a-8db1-52285c9dc891",
                                "sense_id": "68ba7509-1809-3d7f-bf1a-7a3ea07733d7",
                                "text": "„Die Fans sollen die Alte Försterei in ein Fahnenmeer verwandeln, teilte Union am Dienstag auf seiner Webseite mit.“"
                            },
                            {
                                "example_id": "dd3cb630-ad2a-4f09-a8dd-462f7c99897b",
                                "sense_id": "68ba7509-1809-3d7f-bf1a-7a3ea07733d7",
                                "text": "„Binnen Minuten gleicht der Marienplatz einem Fahnenmeer in schwarz-rot-gold, ergänzt durch einige Farbtupfer mit dem türkischen Halbmond.“"
                            },
                            {
                                "example_id": "92920a49-440b-48f5-82b7-fb92bbc4b5a2",
                                "sense_id": "68ba7509-1809-3d7f-bf1a-7a3ea07733d7",
                                "text": "„Der Kiewer Unabhängigkeitsplatz (Maidan) hat sich in ein oranges Fahnenmeer verwandelt.“"
                            },
                            {
                                "example_id": "26d543b4-0127-4b90-bb65-57a22437d87d",
                                "sense_id": "68ba7509-1809-3d7f-bf1a-7a3ea07733d7",
                                "text": "„Sekt floss, es wurde gefeiert, ein rot-weiß-rotes Fahnenmeer war das prägende Bild im Zielbereich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
