                    {
                        "sense_id": "c1c07e34-206a-31ff-980c-3178c505660d",
                        "entry_id": "67818ab4-ef35-3683-be89-73c7ee5a3a94",
                        "glosses": [
                            "Épice obtenue par broyage du fruit de ce piment doux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6caedf9-1a34-49ae-99de-d0771c325ead",
                                "sense_id": "c1c07e34-206a-31ff-980c-3178c505660d",
                                "text": "Les Turcs l’introduisirent dans tout les Balkans à partir des années 1520 : il en restera le paprika hongrois, poudre de piment, épice nationale de ce pays où elle sert notamment à aromatiser le goulasch."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5aaa50c4-f6a5-49c4-971d-554c30bb2823",
                        "source_entry_id": "67818ab4-ef35-3683-be89-73c7ee5a3a94",
                        "source_sense_description": "épice",
                        "target_lang_word": "Paprika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paprika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71a3f348-d6a8-3dcd-ae0c-a2fab9b5471c",
                                        "entry_id": "4297fed9-2bb9-3ccc-9013-20ee32bf2b2d",
                                        "glosses": [
                                            "Gemüsepflanze mit hohlen Früchten, die grün, gelb oder rot sind"
                                        ],
                                        "tags": [
                                            "nur Maskulinum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b82815b1-4e32-44c5-84c5-a7a62cb4930a",
                                                "sense_id": "71a3f348-d6a8-3dcd-ae0c-a2fab9b5471c",
                                                "text": "Die Paprikas gehören zu den Nachtschattengewächsen."
                                            },
                                            {
                                                "example_id": "6371a442-ce9d-493d-981d-32d06d6ce12d",
                                                "sense_id": "71a3f348-d6a8-3dcd-ae0c-a2fab9b5471c",
                                                "text": "„Vor den Häusern reihten sich gut gepflegte Beete mit Tomaten, Paprika, Gurken und Salat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1987870d-a289-30a7-9249-478e4fca32b2",
                                        "entry_id": "4297fed9-2bb9-3ccc-9013-20ee32bf2b2d",
                                        "glosses": [
                                            "nur Maskulinum, : Gewürz in Pulverform, das scharf oder mild ist"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bfa731a-7437-4ca7-9395-3797813439c0",
                                                "sense_id": "1987870d-a289-30a7-9249-478e4fca32b2",
                                                "text": "Die Suppe wird am Ende der Kochzeit mit viel Paprika abgeschmeckt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4a376e44-01f2-32fa-8854-a004765df738",
                                        "entry_id": "4297fed9-2bb9-3ccc-9013-20ee32bf2b2d",
                                        "glosses": [
                                            "kurz für Paprikaschote"
                                        ],
                                        "tags": [
                                            "Maskulinum oder Femininum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0509f63-de2f-4f32-86ce-c345f7d04157",
                                                "sense_id": "4a376e44-01f2-32fa-8854-a004765df738",
                                                "text": "In Ungarn gilt Paprika als Nationalgemüse."
                                            },
                                            {
                                                "example_id": "d3cc5ec9-38cb-40cf-ac1e-74d30095f2a7",
                                                "sense_id": "4a376e44-01f2-32fa-8854-a004765df738",
                                                "text": "Gib mir bitte eine rote Paprika und drei Tomaten."
                                            },
                                            {
                                                "example_id": "016fa770-4c93-4b49-aa64-4bcc27f245bc",
                                                "sense_id": "4a376e44-01f2-32fa-8854-a004765df738",
                                                "text": "Der gelbe Paprika ist viel süßer als der grüne."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
