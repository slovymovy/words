                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9efd4c5b-6f2b-4ada-9690-99496e02f92a",
                                "sense_id": "85f05bdd-a7ec-33f6-839f-76bd20b4c013",
                                "text": "Yes, very clinging; my cousin has a delightful figure, and can stand it."
                            },
                            {
                                "example_id": "5d22a1d8-db82-4648-b1df-b2b4a05af970",
                                "sense_id": "85f05bdd-a7ec-33f6-839f-76bd20b4c013",
                                "text": "He became more clinging, more mischievous and more difficult."
                            },
                            {
                                "example_id": "bfeb5a05-1277-464e-857d-0386ea693892",
                                "sense_id": "85f05bdd-a7ec-33f6-839f-76bd20b4c013",
                                "text": "It is a greyish white, high melting metal, very clinging, not very ductile and with difficulty malleable."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
