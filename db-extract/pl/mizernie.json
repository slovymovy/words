                "translations": [
                    {
                        "translation_id": "14d5c11b-e1a0-4e52-ac42-d14c87aab3b8",
                        "source_entry_id": "5814a01b-8c9b-3df2-92e2-e4acf8b022b9",
                        "source_sense_id": "337cc8c5-a850-3cfd-8b27-fafffa35bc01",
                        "target_lang_word": "haggardly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haggardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6256651b-bf89-3e73-b2be-9e34ba30ea7c",
                                        "entry_id": "be552213-9fc3-371c-bc62-e5e1fa034d36",
                                        "glosses": [
                                            "Synonym of haggard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d175f68-f5f3-4add-85a4-a084b06ac763",
                                                "sense_id": "6256651b-bf89-3e73-b2be-9e34ba30ea7c",
                                                "text": "[T]he higheſt flying Hawke, pꝛooueth often haggardly, and the beſt condicions ly not alwayes vnder bꝛaue apparel: […]"
                                            },
                                            {
                                                "example_id": "5dac99c5-5d84-41b5-af20-235185d8d537",
                                                "sense_id": "6256651b-bf89-3e73-b2be-9e34ba30ea7c",
                                                "text": "[H]e is low of Stature, his Hair almoſt white, roving Eyes, high Eagle nos’d, ſhort Neck, ſhrub ſhoulder’d, haggardly, froward, and unſociable in his Diſcourſes."
                                            },
                                            {
                                                "example_id": "7b1dbfb0-8a90-4a72-9ab2-54b8ec16b037",
                                                "sense_id": "6256651b-bf89-3e73-b2be-9e34ba30ea7c",
                                                "text": "The father was firſt brought forward, diſhevelled, haggardly, and wretched."
                                            },
                                            {
                                                "example_id": "740ab0f7-704e-4e51-be98-49e644532d36",
                                                "sense_id": "6256651b-bf89-3e73-b2be-9e34ba30ea7c",
                                                "text": "And lo! the great monarch, in shame of the haggardly beldam, / Shuts on the world that he loves his bright-glittering eyelids, / And blushes with crimson to think of the dastardly insult."
                                            },
                                            {
                                                "example_id": "23e33a10-af88-4a36-b808-8453ef6a8bc6",
                                                "sense_id": "6256651b-bf89-3e73-b2be-9e34ba30ea7c",
                                                "text": "Schreiner, a haggardly young man with messy hair and facial scruff who looked like he hadn’t slept, sat hunched over as Topp spoke."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "haggardly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ef80d17-6868-3274-8d1b-282f5ce9dcb1",
                                        "entry_id": "0c8a3f16-70a6-3141-b2c4-6ccdb8774484",
                                        "glosses": [
                                            "In a haggard manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b78385e-2298-456f-a604-f204820843b2",
                                                "sense_id": "7ef80d17-6868-3274-8d1b-282f5ce9dcb1",
                                                "text": "How Haggardly ſo e're ſhe looks at home."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
