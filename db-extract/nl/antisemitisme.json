        "de-extract.jsonl": [
            {
                "entry_id": "3b381ebb-f276-367d-a42f-096a00539540",
                "word": "antisemitisme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "48a89bac-ad2d-4fcf-95f0-6d72d9604771",
                        "entry_id": "3b381ebb-f276-367d-a42f-096a00539540",
                        "tags": [
                            "neuter"
                        ],
                        "form": "het antisemitisme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d24d8dd-013d-3d39-a266-25b9ccc4db6a",
                        "entry_id": "3b381ebb-f276-367d-a42f-096a00539540",
                        "glosses": [
                            "Antisemitismus, Judenhass"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52c38c97-fa96-4e2e-a756-0d8fed89d5a8",
                        "source_entry_id": "3b381ebb-f276-367d-a42f-096a00539540",
                        "source_sense_id": "0d24d8dd-013d-3d39-a266-25b9ccc4db6a",
                        "source_sense_description": "Politik, Religion: Antisemitismus, Judenhass",
                        "target_lang_word": "Antisemitismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antisemitismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                        "entry_id": "9abf1251-02f3-3022-b5f5-798188914a7d",
                                        "glosses": [
                                            "pauschale Ablehnung von Juden, Feindseligkeit gegenüber Juden (aus rassischen und politischen, aber auch aus religiösen und sozialen Gründen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a26e09a-7fa8-4eba-818b-2fcf597799b3",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Die Behauptung, ein Jude könne kein Faschist sein, ist reiner Antisemitismus! Oder Philosemitismus. Philosemitismus und Antisemitismus sind ja nicht so weit voneinander entfernt.“"
                                            },
                                            {
                                                "example_id": "e54f9b6b-0a9f-42c0-8fa1-6c81dcddb7c6",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„In der Verkleidung des Antiſemitismus, dieſes bequemen Vorwandes zur Bekundung von Leidenſchaften, die ſich unter ihrem eigentlichen Namen nicht ſehen laſſen dürften, tritt bei den Armen und Unwiſſenden der Haß gegen die Beſitzenden, bei den Nutznießern mittelalterlicher Vorrechte, alſo bei den ſogenannten privilegirten Klaſſen, die Furcht vor begabteren Mitbewerbern um Einfluß und Macht, bei der verworren idealiſtiſchen Jugend eine übertriebene und unberechtigte Form des Patriotismus, nämlich die unerfüllbare Forderung nicht blos politiſcher Einheit des deutſchen Vaterlandes, ſondern auch ethniſcher Einheit des deutſchen Volks zu Tage.“"
                                            },
                                            {
                                                "example_id": "2fc80457-391c-465b-990b-5b1b77354997",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Unser heutiger Antisemitismus darf nicht mit dem religiösen Judenhasse früherer Zeiten verwechselt werden, wenn der Judenhass auch in einzelnen Ländern noch jetzt eine confessionelle Färbung hat. Der grosse Zug der judenfeindlichen Bewegung ist heute ein anderer. In den Hauptländern des Antisemitismus ist dieser eine Folge der Juden-Emancipation.“"
                                            },
                                            {
                                                "example_id": "7cd471f7-58fc-48b3-b896-37d9092c002a",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Der Antisemitismus als Volksbewegung war stets, was seine Anstifter den Sozialdemokraten vorzuwerfen liebten: Gleichmacherei.“"
                                            },
                                            {
                                                "example_id": "6c3d0947-6521-42a8-8be2-b51b29aa4a69",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Der neutestamentliche Satz: ‚Wer nicht für mich ist, ist wider mich‘ war von jeher dem Antisemitismus aus dem Herzen gesprochen.“"
                                            },
                                            {
                                                "example_id": "002ccea4-0f75-4f9a-9d12-cc4ce1fefd23",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Paranoia, der Verfolgungswahn, der die anderen verfolgt, auf die er projiziert, was er selber möchte, steckt an. Von kollektiven Wahnvorstellungen wie dem Antisemitismus wird die Pathologie des Einzelnen, der psychisch der Welt nicht mehr gewachsen sich zeigt und auf ein scheinhaftes inneres Königreich zurückgeworfen ist, bestätigt.“"
                                            },
                                            {
                                                "example_id": "09b00a67-fc8e-43ae-a22a-3175b70b2779",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Man sollte glauben, daß nach dem schmählichen Zusammenbruch des europäischen Faschismus das Hauptmittel seiner demagogischen Propaganda, nämlich der Antisemitismus, bei aller Welt in Verruf geraten und als Denkungsweise unmöglich gewesen sein müßte.“"
                                            },
                                            {
                                                "example_id": "6419244c-ee92-4dc7-8d9d-e65e4bd2c7ac",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Jene Leute, die einst den Mut aufbrachten, mit ihrem Leben einzustehen für die Rettung des Lebens anderer, haben heute, alt und müde geworden, nicht mehr die Kraft, sich zu ihrer noblen Tat von einst zu bekennen; sie fürchten die latenten Antisemitismen ihrer Umwelt, sie wollen lieber unerkannt bleiben; diese Tatsache muß uns erschrecken.“"
                                            },
                                            {
                                                "example_id": "ccc9a294-c717-4d94-8a6a-0066ff441d9f",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Und weil seit dem Mittelalter lange Zeit nur Juden solche Geschäfte ausüben durften, vom Handel und vom Handwerk ferngehalten wurden, lieferte das Metier auch gängige Vorwände für Antisemitismus.“"
                                            },
                                            {
                                                "example_id": "f94b8331-47dd-4967-9301-f6e87e389c1a",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Antisemitismus ist eine bestimmte Wahrnehmung von Juden, die sich als Hass gegenüber Juden ausdrücken kann. Der Antisemitismus richtet sich in Wort oder Tat gegen jüdische oder nicht-jüdische Einzelpersonen und/oder deren Eigentum, sowie gegen jüdische Gemeindeinstitutionen oder religiöse Einrichtungen.“"
                                            },
                                            {
                                                "example_id": "f9119b7b-e14f-4521-b62b-ddbfdd3e9941",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Trotzdem (…) wurden ‚die Juden‘ von vielen bekämpft, mit religiösen und ökonomischen Argumenten und schließlich immer stärker mit dem biologisch unterfütterten Antisemitismus, der die Auslöschung der fremden ‚Rasse‘ anstrebte und großenteils verwirklichte.“"
                                            },
                                            {
                                                "example_id": "7456c303-8c33-4e64-9590-c40f0260da8e",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Besonders wichtig ist ihr der Kampf gegen den Antisemitismus.“"
                                            },
                                            {
                                                "example_id": "067566ae-1096-4f36-8f28-866f24399e5b",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Eine Angleichung, die im besondern bei den Juden durch den scharfen Antisemitismus im heutigen Rußland teils gefördert wird: denn man verbietet den Juden, hebräische oder jiddische Schulen zu errichten und ihr eigenes Schrifttum in den Originalsprachen lesen zu lernen.“"
                                            },
                                            {
                                                "example_id": "89dee95b-c7f9-42b2-ab06-002e96f98e60",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Es darf nicht länger übersehen werden, wie »normal« der Antisemitismus geworden ist und von welchen Emotionen er heute noch mobilisiert und getragen wird.“"
                                            },
                                            {
                                                "example_id": "a25429f8-4afb-4952-9754-54189eaed297",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Und wenn dieses Land, Deutschland, irgendeine Lehre aus der Geschichte ziehen muss - dann ist es, sich jedem Antisemitismus offensiv entgegenzustellen.“"
                                            },
                                            {
                                                "example_id": "f0927ff9-4e49-41d6-8958-17836fc517df",
                                                "sense_id": "3a6ad245-e7b4-3f39-8e0a-26135a616f5f",
                                                "text": "„Tatsächlich schafft es diese Redakteurin, binnen weniger Zeilen das gesamte Repertoire modern gewendeter Antisemitismen einzuspielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcc79b0d-f429-4e0e-bc1c-febfaf6992bb",
                        "source_entry_id": "3b381ebb-f276-367d-a42f-096a00539540",
                        "source_sense_id": "0d24d8dd-013d-3d39-a266-25b9ccc4db6a",
                        "source_sense_description": "Politik, Religion: Antisemitismus, Judenhass",
                        "target_lang_word": "Judenhass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Judenhass",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "caa8fef9-3927-3e3c-a417-865aebc83cb4",
                                        "entry_id": "2721426d-5657-3a6b-8040-b20b6a6859f8",
                                        "glosses": [
                                            "Hass auf Juden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b72086-e176-45b3-9d39-ee2a9f0e70d0",
                                                "sense_id": "caa8fef9-3927-3e3c-a417-865aebc83cb4",
                                                "text": "„Im Krieg hatte der Judenhass stark zugenommen.“"
                                            },
                                            {
                                                "example_id": "708328cd-b023-4ed0-a588-a9a36b2074ad",
                                                "sense_id": "caa8fef9-3927-3e3c-a417-865aebc83cb4",
                                                "text": "„Eine neue Studie zu Erscheinungsformen und ideologischen Hintergründen antisemitischer Agitation in den sozialen Netzwerken des hessischen Verfassungsschutzes zeigt das erschütternde Ausmaß des Judenhasses in der digitalen Welt und weist darauf hin, wie dringend notwendig eine offene Debatte darüber ist, was wir unter Antisemitismus verstehen und mit welchen Ansätzen ihm wirksam begegnet werden kann.“"
                                            },
                                            {
                                                "example_id": "f5ac71cf-1f12-4335-b70c-81c4f75554c1",
                                                "sense_id": "caa8fef9-3927-3e3c-a417-865aebc83cb4",
                                                "text": "„Der deutsche Antisemitismus wird zum völkermordenden Judenhass, und den größten Teil seiner Opfer findet er unter den Sprechern des Jiddischen.“"
                                            },
                                            {
                                                "example_id": "9d5efcbe-3f5e-4ff5-adca-0dbe7c122cf1",
                                                "sense_id": "caa8fef9-3927-3e3c-a417-865aebc83cb4",
                                                "text": "„Der Judenhass wurde zu einem Teil der christlichen Volksfrömmigkeit; er entlud sich in Übergriffen, Verfolgungen, Massakern und Vertreibungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
