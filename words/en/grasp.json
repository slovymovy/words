{
    "word_family": [
        "graspable",
        "grasper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5ba64c30-69f2-3a92-b150-dcb11bc23bfb",
                    "sense_definition": "To grip; to take hold, particularly with the hand.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_grip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>grasp</w> the railing just before he slipped on the wet stairs.",
                            "target_lang_translations": {
                                "ru": "Он успел <w>схватиться</w> за перила как раз перед тем, как поскользнулся на мокрой лестнице.",
                                "zh": "在湿滑的楼梯上滑倒前，他及时<w>抓住</w>了扶手。"
                            }
                        },
                        {
                            "text": "Please <w>grasp</w> the handle firmly and pull it towards you to open the door.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, крепко <w>обхватите</w> ручку и потяните её на себя, чтобы открыть дверь.",
                                "zh": "请用力<w>握住</w>把手并向你这边拉，以打开门。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grip",
                        "hold",
                        "clutch",
                        "grab",
                        "clasp",
                        "seize",
                        "clench",
                        "hang on",
                        "hold on"
                    ],
                    "antonyms": [
                        "let go",
                        "release"
                    ],
                    "common_phrases": [
                        "grasp firmly",
                        "grasp the hand",
                        "grasp the rope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Схватить; крепко держать, особенно рукой.",
                        "zh": "用手紧紧抓住或握住。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "схватить",
                                "target_lang_sense_clarification": "совершённый вид; быстро взять"
                            },
                            {
                                "target_lang_word": "хватать",
                                "target_lang_sense_clarification": "несовершённый вид"
                            },
                            {
                                "target_lang_word": "сжимать",
                                "target_lang_sense_clarification": "крепко держать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓住",
                                "target_lang_sense_clarification": "用手握住或抓取"
                            },
                            {
                                "target_lang_word": "握住",
                                "target_lang_sense_clarification": "紧紧握住"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44a650cc-dcb1-347e-a419-4d7897f96ae7",
                    "sense_definition": "To understand.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mental_understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took me a long time to <w>grasp</w> the complexity of the situation.",
                            "target_lang_translations": {
                                "ru": "Мне потребовалось много времени, чтобы <w>осознать</w> сложность ситуации.",
                                "zh": "我花了很长时间才<w>理解</w>局势的复杂性。"
                            }
                        },
                        {
                            "text": "Students often struggle to <w>grasp</w> abstract concepts without practical examples.",
                            "target_lang_translations": {
                                "ru": "Студентам часто трудно <w>усвоить</w> абстрактные понятия без практических примеров.",
                                "zh": "如果没有实际例子，学生往往很难<w>领会</w>抽象概念。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comprehend",
                        "understand",
                        "fathom"
                    ],
                    "common_phrases": [
                        "grasp the concept",
                        "grasp the meaning",
                        "grasp the importance",
                        "grasp the reality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Понимать; постигать смысл чего-либо.",
                        "zh": "理解或领会某事物的含义。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понимать",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "понять",
                                "target_lang_sense_clarification": "совершённый вид"
                            },
                            {
                                "target_lang_word": "усваивать",
                                "target_lang_sense_clarification": "впитывать информацию"
                            },
                            {
                                "target_lang_word": "схватывать",
                                "target_lang_sense_clarification": "быстро понимать (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理解",
                                "target_lang_sense_clarification": "明白事物的意义"
                            },
                            {
                                "target_lang_word": "领会",
                                "target_lang_sense_clarification": "深入理解"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d28a6a25-7b57-3039-8e3c-bbbf4fc21cab",
                    "sense_definition": "To take advantage of something, to seize, to jump at a chance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opportunity_access",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>grasp</w> every opportunity to practice speaking English with native speakers.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>хвататься</w> за любую возможность попрактиковаться в английском с носителями языка.",
                                "zh": "你应该<w>把握</w>每一次与母语者练习英语口语的机会。"
                            }
                        },
                        {
                            "text": "The company decided to <w>grasp</w> the chance to expand into international markets.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>ухватиться</w> за шанс выйти на международные рынки.",
                                "zh": "公司决定<w>利用</w>这次机会向国际市场扩张。"
                            }
                        }
                    ],
                    "synonyms": [
                        "seize",
                        "jump at the chance",
                        "take"
                    ],
                    "common_phrases": [
                        "grasp the opportunity",
                        "grasp the chance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воспользоваться преимуществом; не упустить шанс.",
                        "zh": "利用机会或优势。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухватиться",
                                "target_lang_sense_clarification": "обычно с предлогом 'за'"
                            },
                            {
                                "target_lang_word": "воспользоваться",
                                "target_lang_sense_clarification": "использовать возможность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "把握",
                                "target_lang_sense_clarification": "抓住机会"
                            },
                            {
                                "target_lang_word": "利用",
                                "target_lang_sense_clarification": "使用机会"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4401538b-ed1b-372f-8727-0224b4813fe8",
                    "sense_definition": "Grip.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_grip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child held onto the toy with a surprisingly tight <w>grasp</w>.",
                            "target_lang_translations": {
                                "ru": "Ребенок держал игрушку с удивительно крепкой <w>хваткой</w>.",
                                "zh": "孩子以一种惊人的力度<w>抓握</w>着玩具。"
                            }
                        },
                        {
                            "text": "Suddenly the heavy box slipped from my <w>grasp</w> and fell onto the floor.",
                            "target_lang_translations": {
                                "ru": "Внезапно тяжелая коробка выскользнула у меня из <w>рук</w> и упала на пол.",
                                "zh": "沉重的箱子突然从我手中滑落，掉在了地板上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grip",
                        "hold",
                        "clasp",
                        "clutch"
                    ],
                    "common_phrases": [
                        "firm grasp",
                        "tight grasp",
                        "slip from grasp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Хватка; крепкое сжатие.",
                        "zh": "紧握的动作或力度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хватка",
                                "target_lang_sense_clarification": "физическое действие"
                            },
                            {
                                "target_lang_word": "сжатие",
                                "target_lang_sense_clarification": "действие по глаголу сжимать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "握力",
                                "target_lang_sense_clarification": "手部抓握的力度"
                            },
                            {
                                "target_lang_word": "抓握",
                                "target_lang_sense_clarification": "抓紧的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a3e4ee1-e64f-3f1b-970c-3c06f6f8f3c4",
                    "sense_definition": "Understanding.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a very thorough <w>grasp</w> of the legal system in this country.",
                            "target_lang_translations": {
                                "ru": "У неё очень глубокое <w>понимание</w> правовой системы этой страны.",
                                "zh": "她对这个国家的法律体系有非常透彻的<w>理解</w>。"
                            }
                        },
                        {
                            "text": "His <w>grasp</w> of the language improved significantly after living there for a year.",
                            "target_lang_translations": {
                                "ru": "Его <w>владение</w> языком значительно улучшилось после года жизни там.",
                                "zh": "在那里住了一年后，他的语言<w>掌握</w>能力有了显著提高。"
                            }
                        }
                    ],
                    "synonyms": [
                        "understanding",
                        "comprehension"
                    ],
                    "common_phrases": [
                        "good grasp",
                        "grasp of the subject",
                        "solid grasp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Понимание; способность постигать смысл.",
                        "zh": "对某事物的理解程度或掌握能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понимание",
                                "target_lang_sense_clarification": "осознание смысла"
                            },
                            {
                                "target_lang_word": "усвоение",
                                "target_lang_sense_clarification": "процесс запоминания и понимания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理解",
                                "target_lang_sense_clarification": "对知识的认知"
                            },
                            {
                                "target_lang_word": "掌握",
                                "target_lang_sense_clarification": "熟练运用或深刻理解"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9db3e0fc-6133-3299-b080-c69528fa4846",
                    "sense_definition": "That which is accessible; that which is within one's reach or ability.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "opportunity_access",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of hard work, the championship title was finally within her <w>grasp</w>.",
                            "target_lang_translations": {
                                "ru": "После многих лет упорного труда чемпионский титул был наконец в пределах её <w>досягаемости</w>.",
                                "zh": "经过多年的努力，冠军头衔终于在她的<w>触及范围</w>之内了。"
                            }
                        },
                        {
                            "text": "The solution to the problem seemed to be just beyond his <w>grasp</w>.",
                            "target_lang_translations": {
                                "ru": "Решение проблемы, казалось, было как раз за пределами его <w>досягаемости</w>.",
                                "zh": "这个问题的解决方案似乎超出了他的<w>能力范围</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reach"
                    ],
                    "common_phrases": [
                        "within grasp",
                        "beyond grasp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Досягаемость; то, что находится в пределах возможностей.",
                        "zh": "在能力范围之内或可触及的范围内。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "досягаемость",
                                "target_lang_sense_clarification": "доступность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "触及范围",
                                "target_lang_sense_clarification": "能够达到的程度"
                            },
                            {
                                "target_lang_word": "能力范围",
                                "target_lang_sense_clarification": "能够胜任的领域"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8e6fc78b-1378-3523-a7f0-72e9647cf712",
                    "sense_definition": "Acronym of General Responsibility Assignment Software Patterns (or Principles).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "Software developers use <w>GRASP</w> patterns to assign responsibilities to classes effectively.",
                            "target_lang_translations": {
                                "ru": "Разработчики программного обеспечения используют шаблоны <w>GRASP</w> для эффективного распределения обязанностей между классами.",
                                "zh": "软件开发人员使用 <w>GRASP</w> 模式来有效地分配类职责。"
                            }
                        },
                        {
                            "text": "Understanding <w>GRASP</w> is essential for mastering object-oriented design principles.",
                            "target_lang_translations": {
                                "ru": "Понимание <w>GRASP</w> необходимо для освоения принципов объектно-ориентированного проектирования.",
                                "zh": "理解 <w>GRASP</w> 对于掌握面向对象设计原则至关重要。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "GRASP patterns",
                        "GRASP principles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акроним для шаблонов распределения обязанностей в программном обеспечении (General Responsibility Assignment Software Patterns).",
                        "zh": "软件设计中“通用职责分配软件模式”的缩写。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "GRASP",
                                "target_lang_sense_clarification": "акроним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "GRASP",
                                "target_lang_sense_clarification": "软件设计模式缩写"
                            }
                        ]
                    }
                }
            ]
        }
    ]
