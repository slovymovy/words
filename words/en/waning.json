                    ],
                    "target_lang_definitions": {
                        "ru": "Период или процесс уменьшения видимой поверхности Луны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убывание",
                                "target_lang_sense_clarification": "Луны"
                            },
                            {
                                "target_lang_word": "ущерб",
                                "target_lang_sense_clarification": "о фазе Луны"
                            }
                        ]
                    }
