                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "04bb761b-e9ac-422e-b8ab-2b5234476f88",
                        "entry_id": "ffd32481-95e4-3f96-b987-6265f8311453",
                        "tags": [
