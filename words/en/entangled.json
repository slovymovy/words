    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "835d01cc-c44f-397c-976c-c9f7aeb71153",
                    "sense_definition": "simple past and past participle of <w>entangle</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The playful kitten accidentally <w>entangled</w> itself in the ball of yarn.",
                            "target_lang_translations": {
                                "nl": "Het speelse katje raakte per ongeluk <w>verstrikt</w> in de bol wol."
                            }
                        },
                        {
                            "text": "The company's finances were deeply <w>entangled</w> in legal disputes for several years.",
                            "target_lang_translations": {
                                "nl": "De financiën van het bedrijf waren jarenlang diep <w>verwikkeld</w> in juridische geschillen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "verleden tijd en voltooid deelwoord van 'entangle' (verstrikken, in de knoop raken)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verstrikte",
                                "target_lang_sense_clarification": "verleden tijd van verstrikken"
                            },
                            {
                                "target_lang_word": "verstrikt",
                                "target_lang_sense_clarification": "voltooid deelwoord"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cf052c5c-2336-3d98-97d0-99653a9e7534",
                    "sense_definition": "Tangled, caught, or twisted together in a messy mass.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tangled_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent twenty minutes trying to separate the <w>entangled</w> wires behind his computer desk.",
                            "target_lang_translations": {
                                "nl": "Hij was twintig minuten bezig om de <w>verwarde</w> kabels achter zijn computerbureau uit elkaar te halen."
                            }
                        },
                        {
                            "text": "The frightened bird was caught in an <w>entangled</w> net of plastic and weeds.",
                            "target_lang_translations": {
                                "nl": "De geschrokken vogel zat vast in een <w>verstrengeld</w> netwerk van plastic en onkruid."
                            }
                        }
                    ],
                    "synonyms": [
                        "tangled",
                        "knotted",
                        "matted",
                        "snarled"
                    ],
                    "antonyms": [
                        "untangled",
                        "disentangled"
                    ],
                    "common_phrases": [
                        "entangled wires",
                        "entangled branches"
                    ],
                    "target_lang_definitions": {
                        "nl": "In de knoop, verstrengeld of verward in een warrige massa."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verward",
                                "target_lang_sense_clarification": "in de knoop"
                            },
                            {
                                "target_lang_word": "verstrengeld",
                                "target_lang_sense_clarification": "ineen gedraaid"
                            },
                            {
                                "target_lang_word": "in de knoop",
                                "target_lang_sense_clarification": "niet ontward"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b971768d-6504-3f51-942a-f44b8fb106a8",
                    "sense_definition": "Involved in a complicated, confusing, or compromising situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tangled_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was warned not to become <w>entangled</w> in her coworkers' personal arguments.",
                            "target_lang_translations": {
                                "nl": "Ze werd gewaarschuwd om niet <w>verstrikt te raken</w> in de persoonlijke ruzies van haar collega's."
                            }
                        },
                        {
                            "text": "The diplomat found himself <w>entangled</w> in a complex political scandal.",
                            "target_lang_translations": {
                                "nl": "De diplomaat raakte <w>verwikkeld</w> in een complex politiek schandaal."
                            }
                        }
                    ],
                    "synonyms": [
                        "involved",
                        "embroiled",
                        "implicated",
                        "enmeshed"
                    ],
                    "antonyms": [
                        "unconnected",
                        "uninvolved"
                    ],
                    "common_phrases": [
                        "become entangled",
                        "entangled in controversy"
                    ],
                    "target_lang_definitions": {
                        "nl": "Betrokken bij of meegesleept in een ingewikkelde, verwarrende of netelige situatie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verstrikt",
                                "target_lang_sense_clarification": "in een situatie of conflict"
                            },
                            {
                                "target_lang_word": "verwikkeld",
                                "target_lang_sense_clarification": "betrokken bij een geschil of schandaal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d144a330-f44d-3699-bcd9-85a15f7703b1",
                    "sense_definition": "Having quantum states that are interconnected regardless of distance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Physicists used laser light to generate a pair of <w>entangled</w> photons across the lab.",
                            "target_lang_translations": {
                                "nl": "Natuurkundigen gebruikten laserlicht om een paar <w>verstrengelde</w> fotonen in het laboratorium te genereren."
                            }
                        },
                        {
                            "text": "Measuring one member of the <w>entangled</w> particles instantly determines the state of the other.",
                            "target_lang_translations": {
                                "nl": "Het meten van een van de <w>verstrengelde</w> deeltjes bepaalt onmiddellijk de toestand van het andere."
                            }
                        }
                    ],
                    "common_phrases": [
                        "entangled particles",
                        "entangled photons",
                        "entangled states"
                    ],
                    "target_lang_definitions": {
                        "nl": "Kwantummechanisch met elkaar verbonden, ongeacht de afstand."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verstrengeld",
                                "target_lang_sense_clarification": "kwantumfysica"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}