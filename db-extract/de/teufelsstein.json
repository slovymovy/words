                "senses": [
                    {
                        "sense_id": "509a4407-908a-3b2e-b275-c46b82ded68a",
                        "entry_id": "3ebf2a9f-619a-38cc-8c27-6123b5707003",
                        "glosses": [
                            "Stein, den der Teufel warf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9712c35d-e9f7-4ac5-8669-dcffc68eaff0",
                                "sense_id": "509a4407-908a-3b2e-b275-c46b82ded68a",
                                "text": "„Der Teufelsstein ist ein Findling bei Hohenstein, einem Ortsteil von Friedland in Mecklenburg-Vorpommern.“"
                            },
                            {
                                "example_id": "1055e88d-91f9-4452-9a6f-6236f989960b",
                                "sense_id": "509a4407-908a-3b2e-b275-c46b82ded68a",
                                "text": "„Der Volksmund hat hingegen eine andere Deutung für die Herkunft des Teufelssteins.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2d5f6f0f-1339-3f6f-823a-32100cd87226",
                        "entry_id": "3ebf2a9f-619a-38cc-8c27-6123b5707003",
                        "glosses": [
                            "uralte Kultstätte, die durch das neuere Christentum tabuisiert wurde (verteufelt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b5c2be1-6666-4fed-8b94-1508554244ef",
                                "sense_id": "2d5f6f0f-1339-3f6f-823a-32100cd87226",
                                "text": "„Teufelssteine gehen der Sage nach meist auf ein Werk des Satans zurück; einige werden auch als heidnische Opferplätze gedeutet, die im Zuge der Christianisierung als Teufelssteine tabuisiert wurden“"
                            },
                            {
                                "example_id": "d457846f-fc7a-4a46-943d-e8ef0a702f54",
                                "sense_id": "2d5f6f0f-1339-3f6f-823a-32100cd87226",
                                "text": "„Der Teufelsstein ist einer der besterhaltenen Kultstätten aus keltisch-germanischer Vorzeit, ein alter Opfer- und Kultstein“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
