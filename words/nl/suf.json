                                "target_lang_word": "doze",
                                "target_lang_sense_clarification": "to sleep lightly for a short time"
                            },
                            {
                                "target_lang_word": "drowse",
                                "target_lang_sense_clarification": "to be half asleep"
                            }
                        ]
                    }
                },
                {
