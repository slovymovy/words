{
    "word_family": [
        "venir",
        "revenant",
        "venue",
        "devenir",
        "parvenir",
        "prévenir"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c2d240e-a0b5-30a2-b98b-acf467b07c92",
                    "sense_definition": "Retourner au lieu d'où l'on est parti, ou être de nouveau présent.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est parti en voyage et il <w>revient</w> demain soir chez lui."
                        },
                        {
                            "text": "Quand <w>reviendrez</w>-vous nous rendre visite à Paris ?"
                        }
                    ],
                    "synonyms": [
                        "rentrer",
                        "retourner"
                    ],
                    "antonyms": [
                        "partir",
                        "s'en aller"
                    ],
                    "common_phrases": [
                        "revenir de vacances",
                        "revenir à la maison",
                        "revenir en arrière"
                    ]
                },
                {
                    "sense_id": "08f88ad0-48e0-344a-8ca9-828eeaec69c2",
                    "sense_definition": "Être équivalent à quelque chose, avoir le même résultat ou la même signification.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "equivalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Refuser cette offre ou l'ignorer <w>revient</w> exactement au même résultat."
                        },
                        {
                            "text": "Ses explications confuses <w>reviennent</w> à dire qu'il a commis une faute."
                        }
                    ],
                    "synonyms": [
                        "équivaloir"
                    ],
                    "common_phrases": [
                        "revenir au même",
                        "revenir à dire"
                    ]
                },
                {
                    "sense_id": "13d01171-726b-3f8c-8894-12b0c1a5b589",
                    "sense_definition": "Se présenter de nouveau à l'esprit, être rappelé à la mémoire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai oublié son prénom, mais son visage me <w>revient</w> très clairement."
                        },
                        {
                            "text": "Ce détail important m'est soudain <w>revenu</w> à la mémoire pendant la réunion."
                        }
                    ],
                    "synonyms": [
                        "se rappeler"
                    ],
                    "antonyms": [
                        "s'échapper"
                    ],
                    "common_phrases": [
                        "revenir à l'esprit",
                        "revenir en mémoire"
                    ]
                },
                {
                    "sense_id": "538f72ff-2ce5-3b54-971b-5fecccfd658b",
                    "sense_definition": "Être très surpris ou stupéfait par un événement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle est incroyable, je n'en <w>reviens</w> toujours pas !"
                        },
                        {
                            "text": "Ils n'en sont pas <w>revenus</w> quand ils ont appris la vérité."
                        }
                    ],
                    "common_phrases": [
                        "ne pas en revenir"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé à la forme négative avec 'en'"
                        }
                    ]
                },
                {
                    "sense_id": "f8702dd6-bd10-3b2d-8126-92e28da47bf2",
                    "sense_definition": "Coûter une certaine somme au total en tenant compte des frais.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec toutes ces réparations, cette voiture me <w>revient</w> trop cher."
                        },
                        {
                            "text": "Préparer ses repas soi-même <w>revient</w> à moins de dix euros par jour."
                        }
                    ],
                    "synonyms": [
                        "coûter"
                    ],
                    "common_phrases": [
                        "revenir cher",
                        "revenir à un prix"
                    ]
                },
                {
                    "sense_id": "cc635eca-86dd-3ffe-9b5d-f891ccbd948e",
                    "sense_definition": "Faire dorer ou rissoler un aliment dans de la matière grasse chaude.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut d'abord faire <w>revenir</w> les oignons émincés dans un peu d'huile d'olive."
                        },
                        {
                            "text": "Après avoir fait <w>revenir</w> les morceaux de viande, ajoutez les carottes."
                        }
                    ],
                    "synonyms": [
                        "rissoler",
                        "dorer"
                    ],
                    "common_phrases": [
                        "faire revenir les oignons",
                        "faire revenir dans l'huile"
                    ]
                },
                {
                    "sense_id": "ea3a35d6-ab4c-3f85-978f-22b16b6988c8",
                    "sense_definition": "Modifier ou annuler un engagement, une opinion ou un choix antérieur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "retractation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur refuse catégoriquement de <w>revenir</w> sur sa décision."
                        },
                        {
                            "text": "Il a promis son aide et ne <w>reviendra</w> pas sur sa parole donnée."
                        }
                    ],
                    "synonyms": [
                        "se dédire",
                        "renoncer"
                    ],
                    "antonyms": [
                        "maintenir",
                        "persister"
                    ],
                    "common_phrases": [
                        "revenir sur sa décision",
                        "revenir sur sa parole"
                    ]
                },
                {
                    "sense_id": "ed07346a-ee40-3158-87aa-d47f38e8dfa0",
                    "sense_definition": "Incomber à quelqu'un, appartenir à sa charge ou à sa responsabilité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "responsabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>revient</w> au chef d'équipe de distribuer les tâches chaque matin."
                        },
                        {
                            "text": "La responsabilité d'organiser l'événement lui est finalement <w>revenue</w>."
                        }
                    ],
                    "synonyms": [
                        "incomber",
                        "appartenir"
                    ],
                    "common_phrases": [
                        "revenir de droit",
                        "revenir à quelqu'un"
                    ]
                },
                {
                    "sense_id": "f91aaaa0-5422-31c6-966e-adf818894ad0",
                    "sense_definition": "Reprendre le fil d'un discours ou d'une discussion après une parenthèse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette digression amusante, <w>revenons</w> à notre sujet initial."
                        },
                        {
                            "text": "Il <w>revient</w> constamment sur ce problème au lieu d'avancer."
                        }
                    ],
                    "synonyms": [
                        "reprendre"
                    ],
                    "common_phrases": [
                        "revenir au sujet",
                        "revenir à nos moutons"
                    ]
                },
                {
                    "sense_id": "cf19f24a-5afa-3b00-8f7e-83c68359d902",
                    "sense_definition": "Plaire ou inspirer de la sympathie à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sympathie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne lui fais pas confiance car son attitude ne me <w>revient</w> pas du tout."
                        },
                        {
                            "text": "Ce nouvel employé a un ton prétentieux qui ne <w>revient</w> à personne ici."
                        }
                    ],
                    "synonyms": [
                        "plaire"
                    ],
                    "antonyms": [
                        "déplaire"
                    ],
                    "common_phrases": [
                        "ne pas revenir"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "principalement utilisé à la forme négative"
                        }
                    ]
                }
            ]
        }
    ]
}