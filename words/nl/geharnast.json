                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ridders werden snel <w>geharnast</w> voordat de vijand de poorten bereikte.",
                            "target_lang_translations": {
                                "en": "The knights were quickly <w>armored</w> before the enemy reached the gates."
                            }
                        },
                        {
                            "text": "Nadat hij volledig was <w>geharnast</w>, kon hij zich nauwelijks nog vrij bewegen.",
                            "target_lang_translations": {
                                "en": "After he was fully <w>armored</w>, he could barely move freely."
                            }
                        }
                    ],
                    "traits": [
