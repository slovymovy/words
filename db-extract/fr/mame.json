                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "113824b7-b543-4d18-8ac1-2be5f9496843",
                        "entry_id": "618ded07-e04b-389a-ad46-8df77cfe0a8e",
