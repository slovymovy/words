                "senses": [
                    {
                        "sense_id": "058de5f4-ba91-39ac-b19b-7a9fe4e5efae",
                        "entry_id": "0d2318d0-e29d-3c29-99ec-9c20766b05ce",
                        "glosses": [
                            "een middel waarmee een lid van een vergadering een discussiepunt, dat niet al op de agenda staat, voor kan leggen aan een vergadering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa3a6a47-9252-4a56-8a82-20154a59ee54",
                                "sense_id": "058de5f4-ba91-39ac-b19b-7a9fe4e5efae",
                                "text": "In Maastricht, bij het jaarlijkse congres tijdens de WK wielrennen, heeft de UCI een motie aangenomen om \"pogingen om de pijnlijke aspecten van de wielergeschiedenis te exploiteren\" te negeren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dded64b9-2a0a-4bd2-bec3-dc26fecddcae",
                        "source_entry_id": "0d2318d0-e29d-3c29-99ec-9c20766b05ce",
                        "source_sense_id": "058de5f4-ba91-39ac-b19b-7a9fe4e5efae",
                        "target_lang_word": "motion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99903d54-8380-3449-a9c4-a5a6d350816e",
                                        "entry_id": "a255e633-e792-39c2-80d8-ca79757fad7d",
                                        "glosses": [
                                            "A state of progression from one place to another."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "401d4440-68ea-41bb-8bc4-98c1ed2ee930",
                                                "sense_id": "99903d54-8380-3449-a9c4-a5a6d350816e",
                                                "text": "Several parties of hop-pickers joined the train at the intermediate stations, and the guard performed the acrobatic feat of walking along the footboards of the coaches to examine tickets, while the train was in motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f8b6697-5c49-32c1-ab04-9e0b04539ccc",
                                        "entry_id": "a255e633-e792-39c2-80d8-ca79757fad7d",
                                        "glosses": [
                                            "A change of position with respect to time."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba343a9b-f671-4baf-999f-45747965f8d5",
                                                "sense_id": "7f8b6697-5c49-32c1-ab04-9e0b04539ccc",
                                                "text": "This is the great wheel to which the clock owes its motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1330dc8e-db51-3072-97db-92697524d822",
                                        "entry_id": "a255e633-e792-39c2-80d8-ca79757fad7d",
                                        "glosses": [
                                            "A change from one place to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "057df956-8995-4116-9d5e-d8301a057488",
                                                "sense_id": "1330dc8e-db51-3072-97db-92697524d822",
                                                "text": "Secondly, When a body is once in motion it will continue to move forever, unless something stops it. When a ball is struck on the surface of the earth, the friction of the earth and the resistance of the air soon stop its motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7f844d9-3fe2-3874-9b25-2a920ca75924",
                                        "entry_id": "a255e633-e792-39c2-80d8-ca79757fad7d",
                                        "glosses": [
                                            "A parliamentary action to propose something. A similar procedure in any official or business meeting."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db33ad22-03d1-46d7-8ba8-ec213d3bf52d",
                                                "sense_id": "a7f844d9-3fe2-3874-9b25-2a920ca75924",
                                                "text": "The motion to amend is now open for discussion."
                                            },
                                            {
                                                "example_id": "05d7ed2d-80d5-4bf2-a306-aa28612a8876",
                                                "sense_id": "a7f844d9-3fe2-3874-9b25-2a920ca75924",
                                                "text": "Yes, I agree, and thank you for your motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24886849-01ad-3c4c-8bc2-a4a458b04137",
                                        "entry_id": "a255e633-e792-39c2-80d8-ca79757fad7d",
                                        "glosses": [
                                            "An entertainment or show, especially a puppet show."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4365fe3f-9f5c-4dcb-9c53-72b3850f131b",
                                                "sense_id": "24886849-01ad-3c4c-8bc2-a4a458b04137",
                                                "text": "when God gave him reason, he gave him freedom to choose, for reason is but choosing; he had bin else a meer artificiall Adam, such an Adam as he is in the motions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30ed49c5-0d83-31b7-8331-445de9a42b48",
                                        "entry_id": "a255e633-e792-39c2-80d8-ca79757fad7d",
                                        "glosses": [
                                            "from κίνησις (kinesis); any change. Traditionally of four types: generation and corruption, alteration, augmentation and diminution, and change of place."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d5dd8a4-d70f-456a-812c-b054320d1c22",
                                                "sense_id": "30ed49c5-0d83-31b7-8331-445de9a42b48",
                                                "text": "I say, it is no uneven jot, to pass from the more faint and obscure examples of Spermatical life to the more considerable effects of general Motion in Minerals, Metalls, and sundry Meteors, whose easie and rude shapes may have no need of any Principle of Life, or Spermatical form distinct from the Rest or Motion of the particles of the Matter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c0664f6-1faf-30d6-8d32-3e1e523aeb67",
                                        "entry_id": "a255e633-e792-39c2-80d8-ca79757fad7d",
                                        "glosses": [
                                            "Movement of the mind, desires, or passions; mental act, or impulse to any action; internal activity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4366c15f-f47c-4aae-8688-4530cf8ef824",
                                                "sense_id": "4c0664f6-1faf-30d6-8d32-3e1e523aeb67",
                                                "text": "Let a good man obey every good motion rising in his heart, knowing that every such motion proceeds from God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef3de484-6229-3210-86aa-a5ee6870f001",
                                        "entry_id": "a255e633-e792-39c2-80d8-ca79757fad7d",
                                        "glosses": [
                                            "A formal request, oral or written, made to a judge or court of law to obtain an official court ruling or order for a legal action to be taken by, or on behalf of, the movant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "415825a4-43a5-3c0c-8bb9-7ab9294a9844",
                                        "entry_id": "a255e633-e792-39c2-80d8-ca79757fad7d",
                                        "glosses": [
                                            "A movement of the bowels; the product of such movement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c598d1e-9c7b-4ee2-bdf7-4d13fafa033f",
                                                "sense_id": "415825a4-43a5-3c0c-8bb9-7ab9294a9844",
                                                "text": "From that time to the present (three weeks) she has taken one pill every night, and had one comfortable motion every morning without the aid of any other aperient, and her health has much improved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "375902cb-071b-35a6-a932-3fe4b1a11e7b",
                                        "entry_id": "a255e633-e792-39c2-80d8-ca79757fad7d",
                                        "glosses": [
                                            "Change of pitch in successive sounds, whether in the same part or in groups of parts. (Conjunct motion is that by single degrees of the scale. Contrary motion is when parts move in opposite directions. Disjunct motion is motion by skips. Oblique motion is when one part is stationary while another moves. Similar or direct motion is when parts move in the same direction.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fcbe1e3-f3be-44a9-8170-896408e34265",
                                                "sense_id": "375902cb-071b-35a6-a932-3fe4b1a11e7b",
                                                "text": "The independent motions of different parts sounding together constitute counterpoint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b81702dd-4ddc-389b-85d5-6ab5b49eaf12",
                                        "entry_id": "a255e633-e792-39c2-80d8-ca79757fad7d",
                                        "glosses": [
                                            "A puppet, or puppet show."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7461866-c0e5-4028-9944-9790a8f44f1b",
                                                "sense_id": "b81702dd-4ddc-389b-85d5-6ab5b49eaf12",
                                                "text": "What motion's this? the model of Nineveh?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3b26f27-d609-3cef-8aaa-aff45d420fef",
                                        "entry_id": "a255e633-e792-39c2-80d8-ca79757fad7d",
                                        "glosses": [
                                            "A piece of moving mechanism, such as on a steam locomotive."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d11b5b5-94e9-4681-bae8-662ec29ba57f",
                                                "sense_id": "a3b26f27-d609-3cef-8aaa-aff45d420fef",
                                                "text": "[...] three 2-4-2 tank engines were secured from the Hunslet Engine Co. of Leeds. As the line began on the Quay in Bideford, the locomotives had their motion encased, as shown in the illustrations on page 414."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "motion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "458f7de3-dd67-3a56-b693-d2ecd29bfd07",
                                        "entry_id": "fa5b1c4e-d71c-30bb-9836-baef589cdf67",
                                        "glosses": [
                                            "To gesture indicating a desired movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c27db819-877f-41a9-9c41-754b9fceba9f",
                                                "sense_id": "458f7de3-dd67-3a56-b693-d2ecd29bfd07",
                                                "text": "He motioned for me to come closer."
                                            },
                                            {
                                                "example_id": "4996a640-1422-49a4-90bf-9f946d41cf65",
                                                "sense_id": "458f7de3-dd67-3a56-b693-d2ecd29bfd07",
                                                "text": "Mom motioned me over and ordered me to sit by her side."
                                            },
                                            {
                                                "example_id": "07882b62-4d42-4fcc-970a-bedb22c9eddb",
                                                "sense_id": "458f7de3-dd67-3a56-b693-d2ecd29bfd07",
                                                "text": "After spending a few paragraphs blasting Obamacare, including motioning directly at the Democrats during his sharpest condemnations, the president laid down a few markers for what he wanted to see replace the current system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b266dfde-2c23-359c-89cc-28628d1ae90f",
                                        "entry_id": "fa5b1c4e-d71c-30bb-9836-baef589cdf67",
                                        "glosses": [
                                            "To introduce a motion in parliamentary procedure."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "310b8484-8b19-33e8-b106-c8f48037c7ba",
                                        "entry_id": "fa5b1c4e-d71c-30bb-9836-baef589cdf67",
                                        "glosses": [
                                            "To make a proposal; to offer plans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1616356e-6638-4cc6-bb04-84853e3ce85f",
                                                "sense_id": "310b8484-8b19-33e8-b106-c8f48037c7ba",
                                                "text": "Here's Gloucester, a foe to citizens,\nOne that still motions war and never peace"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e14f544-9a97-4f8d-b84e-52d024f9c230",
