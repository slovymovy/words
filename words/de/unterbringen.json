                    "sense_definition": "Für Gegenstände, Termine oder Vorhaben einen geeigneten Platz oder eine zeitliche Lücke finden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "platz_zeit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich habe so viele Bücher gekauft, dass ich sie kaum noch im Regal <w>unterbringen</w> kann."
                        },
                        {
                            "text": "In meinem vollgepackten Kalender konnte ich kurzfristig keinen weiteren Termin mehr <w>unterbringen</w>."
                        }
                    ],
                    "synonyms": [
                        "verstauen",
                        "einsortieren"
                    ],
                    "common_phrases": [
