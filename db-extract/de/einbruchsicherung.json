                        "glosses": [
                            "bauliche Anlage oder technische Vorrichtung die als Prävention gegen Einbruch wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2cad337-7ca6-4b67-b71c-8d0490bd6955",
                                "sense_id": "e40b5efe-4d10-3f52-a947-a915f63ec88a",
                                "text": "„Die technischen Neuerungen in der Einbruchsicherung haben gerade im privaten Wohnbereich einen umfangreichen Wandel vollzogen.“"
                            },
                            {
                                "example_id": "b4c979f0-c629-4c05-928f-11a673eb265e",
                                "sense_id": "e40b5efe-4d10-3f52-a947-a915f63ec88a",
                                "text": "„Glücklicherweise gibt es eine zusätzliche Einbruchsicherung an der Tür des Aufbaus, mit der gleichzeitig die Tür verschlossen wird.“"
                            },
                            {
                                "example_id": "7960a2f5-47d2-46de-9f6b-48c72a4694e4",
                                "sense_id": "e40b5efe-4d10-3f52-a947-a915f63ec88a",
                                "text": "„Auch das Themenfeld Einbruchsicherung profitiert von technologischen Fortschritten.“"
                            },
                            {
                                "example_id": "2021a50c-b0f3-4871-81cb-02095432c469",
                                "sense_id": "e40b5efe-4d10-3f52-a947-a915f63ec88a",
                                "text": "„Ich habe mir die Freiheit genommen, ihr vorzuschlagen, eine vernünftige Einbruchsicherung einbauen zu lassen.“"
                            }
                        ],
