        "fr-extract.jsonl": [
            {
                "entry_id": "a2942ce1-59fa-31ce-9fcd-8f86c66bedd9",
                "word": "argutie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f33891ac-8c56-4eeb-b9e0-33876ac793b9",
                        "entry_id": "a2942ce1-59fa-31ce-9fcd-8f86c66bedd9",
                        "tags": [
                            "plural"
                        ],
                        "form": "arguties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e6ba19d-d5ab-3399-a841-bdc1e9416546",
                        "entry_id": "a2942ce1-59fa-31ce-9fcd-8f86c66bedd9",
                        "glosses": [
                            "Raisonnement subtil et vainement minutieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8757e94b-3c79-443f-baaa-7514ac4b81d6",
                                "sense_id": "1e6ba19d-d5ab-3399-a841-bdc1e9416546",
                                "text": "À quoi rêvais-je ? Ce n’était certainement pas à quelque argutie théologique ; non, c’était à cette lutte éternelle du bien et du mal, qui tiraille l’homme depuis le jour du péché."
                            },
                            {
                                "example_id": "b65e7a56-531c-4f77-8bfe-dd4515d60845",
                                "sense_id": "1e6ba19d-d5ab-3399-a841-bdc1e9416546",
                                "text": "Sans cesse, il discutait avec les maîtres et les garçons d'hôtel, avec les voituriers, avec les vendeurs de n'importe quoi, et quand il avait, à force d'arguties, obtenu un rabais quelconque, il disait à Jeanne en se frottant les mains: « Je n'aime pas être volé. »"
                            },
                            {
                                "example_id": "e3badd66-aa2d-4916-9226-aa1e0ac00d3f",
                                "sense_id": "1e6ba19d-d5ab-3399-a841-bdc1e9416546",
                                "text": "Bien qu’il discutât volontiers avec eux sur toutes les doctrines théologiques qui le sollicitaient par leurs subtilités et leurs arguties, ils ne songèrent même pas à le destiner aux Ordres."
                            },
                            {
                                "example_id": "fad7c428-7501-4e5b-8cab-9860d8a49838",
                                "sense_id": "1e6ba19d-d5ab-3399-a841-bdc1e9416546",
                                "text": "Se perdre en arguties."
                            },
                            {
                                "example_id": "4400e3c3-9699-4ea9-99c3-104133055955",
                                "sense_id": "1e6ba19d-d5ab-3399-a841-bdc1e9416546",
                                "text": "S’enfoncer dans les arguties."
                            },
                            {
                                "example_id": "e8ba903c-dea9-4db7-8249-07a7acae91a8",
                                "sense_id": "1e6ba19d-d5ab-3399-a841-bdc1e9416546",
                                "text": "Être noyé dans l’argutie."
                            },
                            {
                                "example_id": "fc5324b5-0c78-4a4c-991f-de0dd54a8396",
                                "sense_id": "1e6ba19d-d5ab-3399-a841-bdc1e9416546",
                                "text": "Arguties de mauvaise foi."
                            },
                            {
                                "example_id": "4d487aa1-f165-4ae5-9f98-ca6daeae7855",
                                "sense_id": "1e6ba19d-d5ab-3399-a841-bdc1e9416546",
                                "text": "Vaines arguties."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67302445-7481-4cc1-9110-cab1675ddfdc",
                        "source_entry_id": "a2942ce1-59fa-31ce-9fcd-8f86c66bedd9",
                        "source_sense_id": "1e6ba19d-d5ab-3399-a841-bdc1e9416546",
                        "target_lang_word": "Spitzfindigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spitzfindigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5384c57c-fb9a-338b-ada3-689d57846259",
                                        "entry_id": "5a72921e-25d9-33a2-bd58-0a4322711f65",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, sehr spitzfindig/übertrieben genau, sehr pingelig zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b82782-05a6-46fc-ac96-36162831e2ca",
                                                "sense_id": "5384c57c-fb9a-338b-ada3-689d57846259",
                                                "text": "„Mit Spitzfindigkeiten geben sie sich gar nicht erst ab.“"
                                            },
                                            {
                                                "example_id": "f9221bfb-7956-400b-b183-ece4f3218744",
                                                "sense_id": "5384c57c-fb9a-338b-ada3-689d57846259",
                                                "text": "„Nach sprachlogischen Spitzfindigkeiten und modischen Sprachtorheiten nun also auf dem Prüfstand der Kritik: unsere viel geschmähten und noch mehr benutzten Fremdwörter.“"
                                            },
                                            {
                                                "example_id": "7ea1f436-c5f3-428c-9aa0-edebb10f769e",
                                                "sense_id": "5384c57c-fb9a-338b-ada3-689d57846259",
                                                "text": "„Alle Spitzfindigkeiten waren da, um den Mann klarzustellen, dem man erlauben wollte, fortzuziehen.“"
                                            },
                                            {
                                                "example_id": "b5c631d0-39ca-4168-b60f-8ae008772666",
                                                "sense_id": "5384c57c-fb9a-338b-ada3-689d57846259",
                                                "text": "„Sie verloren sich in Spitzfindigkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "57a1f28c-78fb-3393-9333-ab1c3c126374",
                                        "entry_id": "5a72921e-25d9-33a2-bd58-0a4322711f65",
                                        "glosses": [
                                            "Äußerung, die [1] entspricht"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d40497fc-19b3-4f2e-a163-064e036d08b2",
                        "source_entry_id": "a2942ce1-59fa-31ce-9fcd-8f86c66bedd9",
                        "source_sense_id": "1e6ba19d-d5ab-3399-a841-bdc1e9416546",
