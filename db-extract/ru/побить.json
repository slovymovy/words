                        "entry_id": "eaf676de-277b-3078-8eb3-81a550756dbd",
                        "glosses": [
                            "Cotir, ravager, dévaster, briser, casser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a7fa905-3895-493a-8191-16c649b25202",
                                "sense_id": "5cf30d08-8905-325d-9f19-0f5aa4e910c0",
                                "text": "Ветром побило все яблони в саду. : À cause du vent, tous les pommiers ont été détruits dans le jardin."
                            },
                            {
                                "example_id": "321fc937-1267-4fa8-95b7-ac2c69f0f664",
                                "sense_id": "5cf30d08-8905-325d-9f19-0f5aa4e910c0",
                                "text": "морозом побило рожь : le gel a ravagé le seigle."
                            },
                            {
                                "example_id": "eea3a775-4ccf-448c-be87-e75fd60cd4b6",
                                "sense_id": "5cf30d08-8905-325d-9f19-0f5aa4e910c0",
                                "text": "Побить посуду. : Briser la vaisselle."
                            },
                            {
                                "example_id": "28f8fd7d-cd46-4bc5-a656-0d0610fe4af2",
                                "sense_id": "5cf30d08-8905-325d-9f19-0f5aa4e910c0",
                                "text": "Градом побило все стекла в окнах. : À cause de la grêle, toutes les vitres des fenêtres ont été brisées."
                            }
                        ]
