                "entry_id": "a1fa796c-9b29-39f6-a8e1-485decff8f85",
                "word": "Finistère",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f93ba7f-2a14-30e5-b95a-f3bb1292c410",
                        "entry_id": "a1fa796c-9b29-39f6-a8e1-485decff8f85",
                        "glosses": [
                            "Département de la région administrative de Bretagne, en France, qui porte le numéro 29."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d83ddce4-be70-4706-9377-f1c6f942aa2b",
                                "sense_id": "4f93ba7f-2a14-30e5-b95a-f3bb1292c410",
                                "text": "La scirpaie est répartie sur de faibles surfaces, principalement sur le littoral du Finistère, les étangs palavasiens, la Camargue ainsi que dans les régions d’étangs tels que la Dombes et la Brenne."
                            },
                            {
                                "example_id": "b043baac-08bd-4131-be49-8bbe8628eebb",
                                "sense_id": "4f93ba7f-2a14-30e5-b95a-f3bb1292c410",
                                "text": "Cette liaison sous-marine de 575 km doit relier une station de conversion irlandaise à celle de La Martyre, dans le Finistère."
                            },
                            {
                                "example_id": "6edddd33-7359-4844-95ea-9e6ccae03676",
                                "sense_id": "4f93ba7f-2a14-30e5-b95a-f3bb1292c410",
                                "text": "Ces dernières années, plusieurs projets de production de lithium se sont confrontés à de fortes oppositions locales, de la région de Loznica, en Serbie, à Tréguennec (Finistère), en passant par le Portugal."
                            },
                            {
                                "example_id": "08ea3c6b-2a38-4d56-abb8-849562356b4c",
                                "sense_id": "4f93ba7f-2a14-30e5-b95a-f3bb1292c410",
                                "text": "De passage dans le Finistère, le week-end du 15 juillet, elle en a profité pour s’offrir une escapade en fourgon sur la presqu’île de Crozon."
                            }
                        ]
                    }
                ],
