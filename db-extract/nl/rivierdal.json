                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9484997b-131e-41e7-b526-ca6ff997331f",
                                "sense_id": "ff1d5c66-e761-3847-92f3-030471f0ff8d",
                                "text": "Echte stoere jongens en meisjes fietsen natuurlijk ook de eerste 2000 kilometer tot Rome, op de kaarten van Paul Benjaminse, waarbij de route zoveel mogelijk langzaam stijgende rivierdalen volgt."
                            },
                            {
                                "example_id": "f3b70fd4-00e5-45ac-9b85-fa19154753d5",
                                "sense_id": "ff1d5c66-e761-3847-92f3-030471f0ff8d",
                                "text": "Natuurliefhebbers kunnen hier hun hart ophalen. Bij de VVV is een nieuw, Engelstalig boek verkrijgbaar met fietsroutes langs bezienswaardigheden, dorpjes, meren, uitzichtpunten en rivierdalen."
                            }
                        ]
