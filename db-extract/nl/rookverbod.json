                "senses": [
                    {
                        "sense_id": "cb767423-3327-397d-99a6-a49f0528fde8",
                        "entry_id": "a94c4315-701b-32e7-919f-87a3214aa0a4",
                        "glosses": [
                            "een verbod om te roken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d12f8e3-563f-4cd0-8cb0-b224335bd90a",
                                "sense_id": "cb767423-3327-397d-99a6-a49f0528fde8",
                                "text": "Het rookverbod is per 1 juli 2008 in de horeca ingevoerd."
                            },
                            {
                                "example_id": "f86e06e9-b654-49b7-8930-bc542b79ffdf",
                                "sense_id": "cb767423-3327-397d-99a6-a49f0528fde8",
                                "text": "Eindelijk weer eens goed nieuws voor rokers! Jarenlang is het uitwasemen van tabakswalmen verketterd. Schreeuwende boodschappen op sigarettenpakjes, rookverbod en anti-rookreclames."
                            },
                            {
                                "example_id": "ea80ee16-c1b7-474f-9f45-1908554a56e4",
                                "sense_id": "cb767423-3327-397d-99a6-a49f0528fde8",
                                "text": "Nieuw-Zeeland wil een rookverbod voor jongeren"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "340e2993-6350-4eae-96b9-a3c4274f423a",
                        "source_entry_id": "a94c4315-701b-32e7-919f-87a3214aa0a4",
                        "source_sense_id": "cb767423-3327-397d-99a6-a49f0528fde8",
                        "source_sense_description": "een verbod om te roken",
                        "target_lang_word": "Rauchverbot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rauchverbot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f90f67a-7b29-38b7-8d44-9a6dbfcd33ac",
                                        "entry_id": "a171b189-8388-3e65-8656-92f4d01dbe92",
                                        "glosses": [
                                            "Anordnung, nicht zu rauchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43207100-59ff-49cc-9ee5-489963c76599",
                                                "sense_id": "1f90f67a-7b29-38b7-8d44-9a6dbfcd33ac",
                                                "text": "In allen öffentlichen Gebäuden gilt ab sofort Rauchverbot."
                                            },
                                            {
                                                "example_id": "b7f3543f-6d87-44a3-9448-b39aba2a95cb",
                                                "sense_id": "1f90f67a-7b29-38b7-8d44-9a6dbfcd33ac",
                                                "text": "„Dass es die Oranjes mit dem Rauchverbot nicht allzu genau nahmen, machte ihm die Monarchie fast schon wieder sympathisch.“"
                                            },
                                            {
                                                "example_id": "022f804d-25bf-4dea-be45-7fb3fcd9bd8c",
                                                "sense_id": "1f90f67a-7b29-38b7-8d44-9a6dbfcd33ac",
                                                "text": "„In Polen hingegen, wo an den Bahnsteigen ein noch strengeres, nämlich absolutes Rauchverbot herrscht, tun sie, worauf sie Lust haben.“"
                                            },
                                            {
                                                "example_id": "4b504d3b-1e03-4f87-b778-49ddedcb4b81",
                                                "sense_id": "1f90f67a-7b29-38b7-8d44-9a6dbfcd33ac",
                                                "text": "„Ich finde das Rauchverbot gut.“"
                                            },
                                            {
                                                "example_id": "7c137af6-9598-49cc-a429-8621f6e17827",
                                                "sense_id": "1f90f67a-7b29-38b7-8d44-9a6dbfcd33ac",
                                                "text": "„Im Institut galt in allen Räumen strenges Rauchverbot, das allerdings von einer Person permanent missachtet wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
