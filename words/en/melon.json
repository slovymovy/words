                {
                    "sense_id": "c29aa1f4-675f-37ff-badf-0dce91a48b07",
                    "sense_definition": "The large, round or oval fruit of various plants of the gourd family, typically having a sweet fleshy interior.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought a large, juicy <w>melon</w> at the market to eat for dessert.",
                            "target_lang_translations": {
                                "ru": "Мы купили на рынке большую сочную <w>дыню</w>, чтобы съесть её на десерт."
                            }
                        },
                        {
                            "text": "She sliced the <w>melon</w> into small pieces and served them on a platter.",
                            "target_lang_translations": {
                                "ru": "Она нарезала <w>дыню</w> на маленькие кусочки и подала их на блюде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slice a melon",
                        "ripe melon",
                        "sweet melon"
                    ],
                    "target_lang_definitions": {
