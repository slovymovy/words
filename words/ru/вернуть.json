{
    "word_family": [
        "возвращать",
        "возврат",
        "возвращение",
        "повернуть",
        "развернуть",
        "свернуть",
        "отвернуть",
        "перевернуть"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ecbf37c-633c-32cb-a1a1-b29f581a4b66",
                    "sense_definition": "Отдать обратно то, что было взято, одолжено или получено ранее.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "return_restore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я обещаю <w>вернуть</w> тебе деньги на следующей неделе.",
                            "target_lang_translations": {
                                "en": "I promise to <w>return</w> the money to you next week.",
                                "zh": "我答应下周把钱<w>还</w>给你。"
                            }
                        },
                        {
                            "text": "Не забудь <w>вернуть</w> книгу в библиотеку вовремя.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>return</w> the book to the library on time.",
                                "zh": "别忘了按时把书<w>归还</w>给图书馆。"
                            }
                        }
                    ],
                    "synonyms": [
                        "отдать"
                    ],
                    "antonyms": [
                        "взять",
                        "забрать"
                    ],
                    "common_phrases": [
                        "вернуть долг",
                        "вернуть деньги",
                        "вернуть книгу",
                        "вернуть кредит"
                    ],
                    "target_lang_definitions": {
                        "en": "To give back something that was taken, borrowed, or received earlier.",
                        "zh": "归还之前借用或收到的东西。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "return",
                                "target_lang_sense_clarification": "general / formal"
                            },
                            {
                                "target_lang_word": "give back",
                                "target_lang_sense_clarification": "conversational"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "归还",
                                "target_lang_sense_clarification": "正式，用于物品"
                            },
                            {
                                "target_lang_word": "还",
                                "target_lang_sense_clarification": "口语，用于钱财或物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3876af8c-3c8e-39c5-8212-89ed129c3c04",
                    "sense_definition": "Вновь обрести, получить обратно то, что было утрачено или потеряно (здоровье, чувства, состояние).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "return_restore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему удалось <w>вернуть</w> доверие своих старых друзей.",
                            "target_lang_translations": {
                                "en": "He managed to <w>regain</w> the trust of his old friends.",
                                "zh": "他成功地<w>重获</w>了老朋友们的信任。"
                            }
                        },
                        {
                            "text": "Мы хотим <w>вернуть</w> мир и спокойствие в наш дом.",
                            "target_lang_translations": {
                                "en": "We want to <w>restore</w> peace and quiet to our home.",
                                "zh": "我们想让家里<w>恢复</w>往日的平静与安宁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "возвратить"
                    ],
                    "antonyms": [
                        "потерять",
                        "утратить"
                    ],
                    "common_phrases": [
                        "вернуть здоровье",
                        "вернуть доверие",
                        "вернуть надежду",
                        "вернуть былое"
                    ],
                    "target_lang_definitions": {
                        "en": "To get something back that was lost, such as health, feelings, or status.",
                        "zh": "重新获得或恢复失去的东西，如健康、情感或状态。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "get back",
                                "target_lang_sense_clarification": "general"
                            },
                            {
                                "target_lang_word": "regain",
                                "target_lang_sense_clarification": "formal, often used with abstract concepts like trust"
                            },
                            {
                                "target_lang_word": "restore",
                                "target_lang_sense_clarification": "to bring back a state or condition"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恢复",
                                "target_lang_sense_clarification": "用于状态、健康或秩序"
                            },
                            {
                                "target_lang_word": "重获",
                                "target_lang_sense_clarification": "用于信任、信心等抽象概念"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46d1f864-89e1-3a91-ac18-a39bd05784b8",
                    "sense_definition": "Заставить или помочь кому-либо прийти, приехать обратно.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "return_restore",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врачи сделали всё возможное, чтобы <w>вернуть</w> пациента к жизни.",
                            "target_lang_translations": {
                                "en": "The doctors did everything possible to <w>bring</w> the patient <w>back</w> to life.",
                                "zh": "医生们尽了一切努力将病人<w>带回</w>了人间。"
                            }
                        },
                        {
                            "text": "Она пыталась <w>вернуть</w> мужа в семью, но он отказался.",
                            "target_lang_translations": {
                                "en": "She tried to <w>bring</w> her husband <w>back</w> to the family, but he refused.",
                                "zh": "她试图让丈夫<w>回到</w>家庭，但他拒绝了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "возвратить"
                    ],
                    "common_phrases": [
                        "вернуть к жизни",
                        "вернуть семью",
                        "вернуть домой"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause or help someone to return to a previous state or place.",
                        "zh": "促使或帮助某人回到原来的地方或状态。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bring back",
                                "target_lang_sense_clarification": "to cause to return"
                            },
                            {
                                "target_lang_word": "return",
                                "target_lang_sense_clarification": "formal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "带回",
                                "target_lang_sense_clarification": "用于人或物"
                            },
                            {
                                "target_lang_word": "使……回到",
                                "target_lang_sense_clarification": "用于状态或位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e07e36a0-e7d6-3eee-bc0e-9789ae1a7821",
                    "sense_definition": "Сделать резкое движение, поворачивая что-либо; повернуть.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "turn_rotate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он резко <w>вернул</w> голову в сторону громкого звука.",
                            "target_lang_translations": {
                                "en": "He sharply <w>turned</w> his head towards the loud sound.",
                                "zh": "他猛地把头<w>转</w>向发出巨响的方向。"
                            }
                        },
                        {
                            "text": "Водитель <w>вернул</w> руль влево, чтобы объехать яму на дороге.",
                            "target_lang_translations": {
                                "en": "The driver <w>turned</w> the steering wheel to the left to avoid a pothole on the road.",
                                "zh": "司机向左<w>转</w>动方向盘以避开路上的坑洼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вертеть",
                        "крутить",
                        "вращать"
                    ],
                    "common_phrases": [
                        "вернуть голову",
                        "вернуть руль"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "прост."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make a sharp movement turning something; to turn.",
                        "zh": "使某物发生转动或改变方向。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn",
                                "target_lang_sense_clarification": "to change direction or orientation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "转",
                                "target_lang_sense_clarification": "改变方向或位置"
                            },
                            {
                                "target_lang_word": "扭",
                                "target_lang_sense_clarification": "指身体部位的转动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}