                "forms": [],
                "senses": [
                    {
                        "sense_id": "b5b720b3-6139-39fb-9a2f-4a495a0e216b",
                        "entry_id": "7846092e-b591-373b-beec-1eb7d4562b9e",
                        "glosses": [
                            "Région dans le sud du Viêt Nam, intégrée à l’Union indochinoise (Indochine française) entre 1887 et 1954."
                        ],
                        "tags": [
                            "dated",
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "e34e59be-c632-466b-b393-8f129186cbeb",
                                "sense_id": "b5b720b3-6139-39fb-9a2f-4a495a0e216b",
                                "text": "L’ex-empereur Bao Dai, qui réside alors à Hong-Kong, ne va cependant pas se laisser manœuvrer facilement et posera ses conditions, la première étant la restitution de la Cochinchine au Viêt-nam et une reconnaissance de principe de l’indépendance."
                            },
                            {
                                "example_id": "d0fa6aee-118e-4ba3-b123-08df48849d38",
                                "sense_id": "b5b720b3-6139-39fb-9a2f-4a495a0e216b",
                                "text": "Une première tentative de réaliser l’unité budgétaire est faite en 1873 lors de la création de l’Union indochinoise, composée de la Cochinchine, de l’Annam, du Tonkin et du Cambodge et avec à sa tête le gouverneur général de l’Indochine."
                            }
                        ]
                    },
