                                                "sense_id": "20064fc0-a00b-3ff6-a4bb-75dc53a0e133",
                                                "text": "You speedy helpers […] Appear and aid me in this enterprise."
                                            },
                                            {
                                                "example_id": "582303db-8a8f-43d4-b486-d4f32eb08cff",
                                                "sense_id": "20064fc0-a00b-3ff6-a4bb-75dc53a0e133",
                                                "text": "Smith is aided in his quest by an elfin, time-jumping alien with psychic powers played by another Coen brothers veteran, A Serious Man star Michael Stuhlbarg."
                                            }
