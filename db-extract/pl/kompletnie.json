        "pl-extract.jsonl": [
            {
                "entry_id": "cead07a6-7632-387f-93be-13d9cfe3b520",
                "word": "kompletnie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bf2c96c3-f5a0-3fe9-a504-9463040a06d2",
                        "entry_id": "cead07a6-7632-387f-93be-13d9cfe3b520",
                        "glosses": [
                            "w sposób całkowity, zupełny; bez reszty, w pełni"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aa22c52-6e1a-4886-9d94-39a89f245872",
                                "sense_id": "bf2c96c3-f5a0-3fe9-a504-9463040a06d2",
                                "text": "Jestem noga z matmy, kompletnie nic nie umiem!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eaed74c4-ffcb-437c-89d9-a64d7fce3789",
                        "source_entry_id": "cead07a6-7632-387f-93be-13d9cfe3b520",
                        "source_sense_id": "bf2c96c3-f5a0-3fe9-a504-9463040a06d2",
                        "target_lang_word": "completely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "completely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                        "entry_id": "f1f31b33-bc57-3074-ad1a-b76b388279c6",
                                        "glosses": [
                                            "In a complete manner; thoroughly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eef0e07a-86f1-4c4b-b8ea-dd67121cec32",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "Please completely fill in the box for your answer, using a number 2 pencil."
                                            },
                                            {
                                                "example_id": "bc5853fb-b049-4275-b1c1-b1490997c41b",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "I will have completely finished my degree by next July, when my thesis has been properly edited."
                                            },
                                            {
                                                "example_id": "d43b1f8e-e132-46b0-8d56-f64952f8e530",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "It should not have been omitted that previous to completely stripping the body of the leviathan, he was beheaded."
                                            },
                                            {
                                                "example_id": "c3c37d13-9a2d-47c4-a772-ceb61c44a5bd",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "She completely abandoned her Tuesdays at home, and did not return the visits of those who had called upon her."
                                            },
                                            {
                                                "example_id": "fa3892a0-d491-4f94-a747-371556908c5e",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "Lieutenant (junior grade) KERRY immediately maneuvered his craft through several strafing runs which completely silenced the enemy."
                                            },
                                            {
                                                "example_id": "17a3b433-3441-46b0-84e9-784d726ef42a",
                                                "sense_id": "3de6e491-d15d-313c-aa16-2871751012fa",
                                                "text": "“Temu is gone! What I saw today completely convinced me!” the user wrote. “Local sellers, despite obviously buying some items in advance in a bulk, don’t have all these items I was interested in.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                        "entry_id": "f1f31b33-bc57-3074-ad1a-b76b388279c6",
                                        "glosses": [
                                            "To the fullest extent or degree; totally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59585da3-49e8-4d49-8f1c-d93feb4eb04b",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "He is completely mad."
                                            },
                                            {
                                                "example_id": "3b0f2f43-1c7d-47fa-8130-7d1202d6bddd",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "I had occasion […] to make a somewhat long business trip to Chicago, and on my return […] I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting, […], and finally leading me to his buggy, turned and drove out of town. I was completely mystified at such an unusual proceeding."
                                            },
                                            {
                                                "example_id": "42630122-febf-46fe-af3e-0d94e0c8b1d7",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "Our future may lie beyond our vision, but it is not completely beyond our control."
                                            },
                                            {
                                                "example_id": "f9ba36d2-d4c2-47e3-a0f1-dd6ae8191e76",
                                                "sense_id": "9e2c6ca9-371f-3f78-8ed5-a7698df07401",
                                                "text": "1975, Helen Schucman, A Course in Miracles/Workbook for Students, Lesson 75: The light has come,\nKeep a completely open mind, washed of all past ideas and clean of every concept you have made."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae29441e-120b-4e1a-83d2-14c85ddaec3d",
                        "source_entry_id": "cead07a6-7632-387f-93be-13d9cfe3b520",
                        "source_sense_id": "bf2c96c3-f5a0-3fe9-a504-9463040a06d2",
                        "target_lang_word": "entirely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entirely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6455878-13f0-3a11-a88e-14bbd393a07d",
                                        "entry_id": "4aa3e8fd-b2f6-3cfa-b6e9-d69dd5c2960e",
                                        "glosses": [
                                            "To the full or entire extent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c636e532-47f2-4798-aa11-330afb017727",
                                                "sense_id": "a6455878-13f0-3a11-a88e-14bbd393a07d",
                                                "text": "It is entirely up to you where we go, as I’ll be happy with anywhere."
                                            },
                                            {
                                                "example_id": "89f529ab-0d96-47fa-87bd-6802568c0c9b",
                                                "sense_id": "a6455878-13f0-3a11-a88e-14bbd393a07d",
                                                "text": "The cake hadn’t entirely been eaten, so some was saved for later."
                                            },
                                            {
                                                "example_id": "5137e3cc-0891-4436-a371-693925c6df38",
                                                "sense_id": "a6455878-13f0-3a11-a88e-14bbd393a07d",
                                                "text": "[O]bſerving [...] abundance of Matter floating in the Urine like Bran, with a great Number of Recrements like Cuttings of Hair, ſome above an Inch long, which Subſtances were found in all the Water that I made in above Twelve Months; for which I could get no Remedy: I was adviſed to drink Water, which in about half a Year did intirely free me from thoſe Symptoms, [...]"
                                            },
                                            {
                                                "example_id": "650db77c-9ac8-4080-ac7f-75c443216c98",
                                                "sense_id": "a6455878-13f0-3a11-a88e-14bbd393a07d",
                                                "text": "Frommer spoke to me—mostly in English—about the challenges of creating an entirely alien language."
                                            },
                                            {
                                                "example_id": "27141017-15ce-4b27-a0b4-1192cd35b7f5",
                                                "sense_id": "a6455878-13f0-3a11-a88e-14bbd393a07d",
                                                "text": "Unlike Ali G Indahouse, Baron Cohen’s failed attempt to bring his most famous character into an entirely fictional universe, Borat found the comic tension in placing his Kazakhstani buffoon in delicate social situations, like a rodeo where he supports the “War Of Terror” a bit too zealously."
                                            },
                                            {
                                                "example_id": "f9ec32ff-97ef-4b1c-8f53-4e5da000d1d4",
                                                "sense_id": "a6455878-13f0-3a11-a88e-14bbd393a07d",
                                                "text": "As we age, the major arteries of our bodies frequently become thickened with plaque, a fatty material with an oatmeal-like consistency that builds up along the inner lining of blood vessels. The reason plaque forms isn’t entirely known, but it seems to be related to high levels of cholesterol inducing an inflammatory response, which can also attract and trap more cellular debris over time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47e1aa0b-25ad-389d-9b2d-47fd2b667994",
                                        "entry_id": "4aa3e8fd-b2f6-3cfa-b6e9-d69dd5c2960e",
                                        "glosses": [
                                            "To the exclusion of others; solely;"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1556d055-9759-4b7c-8fa4-a85683f8a85d",
                                                "sense_id": "47e1aa0b-25ad-389d-9b2d-47fd2b667994",
                                                "text": "I'm entirely to blame."
                                            },
                                            {
                                                "example_id": "7a1b465e-f1ed-4881-8198-5fb188904391",
                                                "sense_id": "47e1aa0b-25ad-389d-9b2d-47fd2b667994",
                                                "text": "This part of the park is used entirely by the workers; everyone else will have to go to the other side."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "914899b6-e426-4846-a85b-8b2ded772829",
                        "source_entry_id": "cead07a6-7632-387f-93be-13d9cfe3b520",
                        "source_sense_id": "bf2c96c3-f5a0-3fe9-a504-9463040a06d2",
                        "target_lang_word": "по́лностью",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
