                ],
                "senses": [
                    {
                        "sense_id": "e4e6ad47-f8e8-384a-82d2-83d360dcc15d",
                        "entry_id": "3a845d95-c8e4-3175-907b-2db610f82cb1",
                        "glosses": [
                            "eine meist große, aus größerer Entfernung sichtbare Uhr, die in oder an einem Kirchturm montiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9d78258-e8c9-4567-b426-3e1661eb8be8",
                                "sense_id": "e4e6ad47-f8e8-384a-82d2-83d360dcc15d",
                                "text": "„Irgendwo weiter weg bellte jetzt ein Hund und die große Kirchturmuhr schlug sechsmal.“"
                            },
                            {
                                "example_id": "845b3e2e-3d57-42fc-952e-a424c0288680",
                                "sense_id": "e4e6ad47-f8e8-384a-82d2-83d360dcc15d",
                                "text": "„Die Kirchturmuhr schlug elf.“"
                            },
                            {
                                "example_id": "c90d2280-db50-4e3f-a412-c2815e5b278a",
                                "sense_id": "e4e6ad47-f8e8-384a-82d2-83d360dcc15d",
                                "text": "„Galt das auch für die Kirchturmuhr, von der Lisa immer aufwachte?“"
                            },
                            {
                                "example_id": "14014f23-1262-4540-a44e-0c667898da80",
                                "sense_id": "e4e6ad47-f8e8-384a-82d2-83d360dcc15d",
                                "text": "„Mit gewaltigen Schlägen verkündeten die Kirchturmuhren ringsum die elfte Nachtstunde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
