                        "examples": [
                            {
                                "example_id": "85f74807-e54e-4012-8efa-149bb651b56a",
                                "sense_id": "3aa59d5c-2f3f-38a5-b2c5-0f47a57c919c",
                                "text": "„Es gibt eine Erzählung aus griechischer Urzeit, nach der zeugten Uranos und Gaia den Titan.“"
                            },
                            {
                                "example_id": "96143e57-e87f-46a3-9c59-18d7f28488e2",
                                "sense_id": "3aa59d5c-2f3f-38a5-b2c5-0f47a57c919c",
                                "text": "„Uranos, Gottvater der ersten Stunde, bringt mit Gaia die Kyklopen hervor, einäugige Riesen, die einen Aufstand gegen ihren Erzeuger planen und von ihm zur Strafe in die Unterwelt verbannt werden.“"
                            }
                        ],
