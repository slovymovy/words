                {
                    "sense_id": "dd681b08-aa30-3a6a-b316-5034a8529441",
                    "sense_definition": "met schrijfgerei ergens een cirkel omheen tekenen om een keuze aan te geven",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tekenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>omcirkel</w> mijn keuze op het enquêteformulier.",
                            "target_lang_translations": {
                                "en": "I <w>circle</w> my choice on the survey form."
                            }
                        },
                        {
                            "text": "Je moet het juiste antwoord <w>omcirkelen</w> op dit papier.",
                            "target_lang_translations": {
                                "en": "You must <w>circle</w> the correct answer on this paper."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het juiste antwoord omcirkelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to draw a circle around something with a writing instrument to indicate a choice"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "circle",
                                "target_lang_sense_clarification": "to mark a choice"
                            },
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "to draw a circle around an option"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a1dd8a1-c140-3562-9953-7ca268c7994a",
                    "sense_definition": "met schrijfgerei ergens een cirkel omheen tekenen om ergens de nadruk op te leggen of om iets aan te wijzen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tekenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn moeder <w>omcirkelt</w> altijd de spelfouten in de krant.",
                            "target_lang_translations": {
                                "en": "My mother always <w>circles</w> the spelling mistakes in the newspaper."
                            }
                        },
                        {
                            "text": "De leraar zal de belangrijkste woorden in de tekst <w>omcirkelen</w>.",
                            "target_lang_translations": {
                                "en": "The teacher will <w>circle</w> the most important words in the text."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een datum omcirkelen"
                    ],
                    "target_lang_definitions": {
                        "en": "to draw a circle around something with a writing instrument to emphasize or point it out"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "circle",
                                "target_lang_sense_clarification": "to highlight or mark something"
                            },
                            {
                                "target_lang_word": "draw a circle around",
                                "target_lang_sense_clarification": "to emphasize a specific part"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f7b5401-51f4-34bd-9a18-0056e60f2980",
                    "sense_definition": "iets of iemand fysiek insluiten waardoor onsnapping niet meer mogelijk is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "insluiten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten <w>omcirkelden</w> de troepen van de vijand.",
                            "target_lang_translations": {
                                "en": "The soldiers <w>surrounded</w> the enemy troops."
                            }
                        },
                        {
                            "text": "De politie probeerde de verdachte snel te <w>omcirkelen</w> in het park.",
                            "target_lang_translations": {
                                "en": "The police tried to quickly <w>encircle</w> the suspect in the park."
                            }
                        }
                    ],
                    "synonyms": [
                        "insluiten",
                        "omgeven",
                        "omringen",
                        "omsingelen",
                        "omsluiten"
                    ],
                    "common_phrases": [
                        "de vijand omcirkelen"
                    ],
                    "target_lang_definitions": {
