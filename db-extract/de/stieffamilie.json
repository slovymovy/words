                "senses": [
                    {
                        "sense_id": "ff7636fd-6321-3d8d-b018-d19a6601f04d",
                        "entry_id": "c04a0843-6137-3cd1-ab32-e67a3a792b51",
                        "glosses": [
                            "eine Familie, in der von unterschiedlichen Elternteilen stammende Kinder leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66421a71-7fef-4164-a74e-f8faca89a898",
                                "sense_id": "ff7636fd-6321-3d8d-b018-d19a6601f04d",
                                "text": "Im 19. Jahrhundert entstanden Stieffamilien in der Hauptsache durch Tod einzelner Familienmitglieder; im 21. Jahrhundert liegt die Hauptursache für die Bildung von Stieffamilien in der Trennung von Ehepartnern."
                            },
                            {
                                "example_id": "bb5fe511-7f41-456c-9b66-ad7e32c40043",
                                "sense_id": "ff7636fd-6321-3d8d-b018-d19a6601f04d",
                                "text": "„Bevor jedoch genauer auf die Gliederung und damit den Aufbau der Arbeit eingegangen wird, soll nun in einem ersten Schritt geklärt werden, was unter dem Begriff Stieffamilie eigentlich zu verstehen ist bzw. wer alles zu einer Stieffamilie zählt.“"
                            },
                            {
                                "example_id": "762cb128-cb25-4524-b35b-1c284fe3b284",
                                "sense_id": "ff7636fd-6321-3d8d-b018-d19a6601f04d",
                                "text": "„Betrachtet man die Angaben der Kinder und Jugendlichen aus Stieffamilien, die in einer Zusatzbefragung zum 3. Familiensurvey interviewt wurden, so zeigt sich, dass Stiefväter oft eine sehr bedeutsame Rolle im Leben der Kinder spielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b41b6e1b-23cd-45f4-968d-f4a27458ec63",
                        "source_entry_id": "c04a0843-6137-3cd1-ab32-e67a3a792b51",
                        "source_sense_id": "ff7636fd-6321-3d8d-b018-d19a6601f04d",
                        "source_sense_description": "eine Familie, in der von unterschiedlichen Elternteilen stammende Kinder leben",
                        "target_lang_word": "famille recomposée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "famille recomposée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fbd660d-3c75-36fe-b492-f0423f3068cb",
                                        "entry_id": "7892c0dd-4293-3c5c-b81b-c0b104e33292",
                                        "glosses": [
                                            "Famille constituée à la suite d’une séparation, d’un divorce ou d’un veuvage, lorsqu’un nouveau couple se forme et qu’il élève au moins un enfant né d’une union antérieure de l’un des conjoints."
                                        ],
                                        "tags": [
                                            "Sociologie de la famille"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6811e5e9-10a6-4662-8d83-2ca3fff26955",
                                                "sense_id": "6fbd660d-3c75-36fe-b492-f0423f3068cb",
                                                "text": "La famille recomposée, proposant une multiplication des liens entre les individus, interroge directement la question de la parentalité : primauté du parent biologique ou du parent domestique ?"
                                            },
                                            {
                                                "example_id": "4d50da20-b76b-4995-8957-02f9c9b75eb1",
                                                "sense_id": "6fbd660d-3c75-36fe-b492-f0423f3068cb",
                                                "text": "Cette histoire de familles recomposées n’était à mon avis qu’une dégoûtante foutaise, quand bien même il ne s’agissait pas d’une propagande pure, optimiste et postmoderne, décalée, dédiée aux CSP+ et CSP++, inaudible au-delà de la porte de Charenton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
