    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "790b8182-0fb0-3b32-9bb3-503dee0cf2bd",
                    "sense_definition": "van de lichamelijke conditie dat deze heel goed en gezond is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gezondheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een heerlijke vakantie in de bergen keerde zij terug in <w>blakende</w> gezondheid.",
                            "target_lang_translations": {
                                "en": "After a wonderful holiday in the mountains, she returned in <w>radiant</w> health."
                            }
                        },
                        {
                            "text": "De jonge atleet verkeert momenteel in een <w>blakende</w> vorm.",
                            "target_lang_translations": {
                                "en": "The young athlete is currently in <w>glowing</w> form."
                            }
                        }
                    ],
                    "synonyms": [
                        "fit",
                        "gezond",
                        "stralend"
                    ],
                    "antonyms": [
                        "kwakkelend"
                    ],
                    "common_phrases": [
                        "blakende gezondheid",
                        "blakende vorm"
                    ],
                    "target_lang_definitions": {
                        "en": "of physical condition, being very good, healthy, and radiant"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "radiant",
                                "target_lang_sense_clarification": "referring to health or appearance"
                            },
                            {
                                "target_lang_word": "glowing",
                                "target_lang_sense_clarification": "referring to health or vitality"
                            },
                            {
                                "target_lang_word": "robust",
                                "target_lang_sense_clarification": "referring to health"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3357c851-8120-3c1a-8714-acc06cf60e4b",
                    "sense_definition": "van de zon of hitte dat deze zeer fel en heet schijnt",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wandelaars zochten na uren lopen in de <w>blakende</w> zon eindelijk de schaduw op.",
                            "target_lang_translations": {
                                "en": "After hours of walking in the <w>blazing</w> sun, the hikers finally sought out the shade."
                            }
                        },
                        {
                            "text": "Zelfs in de <w>blakende</w> hitte van de woestijn bleef de gids rustig doorlopen.",
                            "target_lang_translations": {
                                "en": "Even in the <w>scorching</w> heat of the desert, the guide kept walking calmly."
                            }
                        }
                    ],
                    "synonyms": [
                        "stralend"
                    ],
                    "common_phrases": [
                        "blakende zon",
                        "blakende hitte"
                    ],
                    "target_lang_definitions": {
                        "en": "of the sun or heat, shining or burning very intensely and hotly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "blazing",
                                "target_lang_sense_clarification": "referring to sun or heat"
                            },
                            {
                                "target_lang_word": "scorching",
                                "target_lang_sense_clarification": "referring to heat or sun"
                            },
                            {
                                "target_lang_word": "burning",
                                "target_lang_sense_clarification": "referring to sun or heat"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1aab2de3-7d85-36bb-ba8d-a861e14ad2cb",
                    "sense_definition": "onvoltooid deelwoord van <w>blaken</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij liep over straat, <w>blakend</w> van zelfvertrouwen na het behalen van haar diploma.",
                            "target_lang_translations": {
                                "en": "She walked down the street, <w>beaming</w> with confidence after obtaining her diploma."
                            }
                        },
                        {
                            "text": "De oven stond roodgloeiend te <w>blaken</w> in de hoek van de oude bakkerij.",
                            "target_lang_translations": {
                                "en": "The oven stood red-hot, <w>glowing</w> in the corner of the old bakery."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blakend van"
                    ],
                    "traits": [
