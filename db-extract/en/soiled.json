                                                "example_id": "fb4d3a37-8985-422a-b49c-09f7a47dbdf9",
                                                "sense_id": "f3f46307-0fa8-3770-882c-a26c9bc18208",
                                                "text": "Cette affaire est bien sale."
                                            },
                                            {
                                                "example_id": "ad5a6428-364d-43f6-81fb-bef156e32996",
                                                "sense_id": "f3f46307-0fa8-3770-882c-a26c9bc18208",
