                        "glosses": [
                            "спец. последовательность кадров, которые задают ту или иную фазу движения рисованного персонажа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed28e061-ffda-4642-a82b-4c490c0f719b",
                                "sense_id": "a739dd66-2cef-399d-bbd7-87e67f6ae6c5",
                                "text": "У этого персонажа неудачная анимация ходьбы."
                            }
                        ]
                    },
