                        "examples": [
                            {
                                "example_id": "3e5abb2e-fcaa-4fc8-8316-85211319f600",
                                "sense_id": "0e25f02a-e7cf-3517-94dd-ca64cb0769d9",
                                "text": "Between two such unloquacious persons, dialogue was naturally slow at first, but they had a long drive before them."
                            },
                            {
                                "example_id": "2d283d5f-1a1e-4ad7-8be6-60983a2c373f",
                                "sense_id": "0e25f02a-e7cf-3517-94dd-ca64cb0769d9",
                                "text": "The Arab odd-job boy finished his watering and silently returned to the house. Like that young Hardcastle, Freddy thought. Like Hardcastle, the gardener’s boy of Freddy’s youth, who had moved back and forth, remotely attending to things, unloquacious, unsmiling, totally unwilling to conspire in Freddy’s games."
                            }
                        ]
                    }
