                        "sense_id": "834dd48c-1580-3cec-8475-743bcc30947f",
                        "entry_id": "41cdd451-28e6-3445-b673-cc6d119b2e67",
                        "glosses": [
                            "Falco peregrinus, een roofvogel en de snelst vliegende vogel ter wereld"
