        "fr-extract.jsonl": [
            {
                "entry_id": "47f9c1ea-f08c-3df9-aed3-d98d9ace7946",
                "word": "mixture",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f58c014e-b2f3-4e11-9455-579be93772b7",
                        "entry_id": "47f9c1ea-f08c-3df9-aed3-d98d9ace7946",
                        "tags": [
                            "plural"
                        ],
                        "form": "mixtures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b58ff380-2735-3e35-911a-c2abfa76d330",
                        "entry_id": "47f9c1ea-f08c-3df9-aed3-d98d9ace7946",
                        "glosses": [
                            "Mélange, homogène ou non, de plusieurs substances, plus particulièrement de substances liquides."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2866953-bca4-4334-b4c2-f34017d73a94",
                                "sense_id": "b58ff380-2735-3e35-911a-c2abfa76d330",
                                "text": "Ils changèrent de sujet en buvant un avant-dernier godet de la fameuse mixture régionale, car dans cette contrée verdoyante on ne disait jamais le dernier godet, il paraît que cela porte malheur."
                            },
                            {
                                "example_id": "b9e4aba3-b39f-470f-83ff-ed3267dfb135",
                                "sense_id": "b58ff380-2735-3e35-911a-c2abfa76d330",
                                "text": "Quel ne fut pas mon étonnement de reconnaître, après avoir goûté à cette boisson, que non seulement l'illusion était possible, mais encore que le café d'orge était vingt fois préférable aux horribles mixtures où règne la chicorée que l'on nous sert à Paris dans les établissements de second ordre."
                            },
                            {
                                "example_id": "5036ab9b-b001-4948-b6e2-e50979916744",
                                "sense_id": "b58ff380-2735-3e35-911a-c2abfa76d330",
                                "text": "Et pour conclure dans le mood bien-être, trinquons avec un verre d’une de ces mixtures aromatiques et sophistiquées élaborées sans alcool par des bartenders créatifs, les mocktails."
                            }
                        ]
                    },
                    {
                        "sense_id": "dcccd0c2-141b-3498-bf40-7b1731229f08",
                        "entry_id": "47f9c1ea-f08c-3df9-aed3-d98d9ace7946",
                        "glosses": [
                            "Mélange quelconque."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cfde6e9-3fb2-4617-8689-02a10d8d62be",
                        "source_entry_id": "47f9c1ea-f08c-3df9-aed3-d98d9ace7946",
                        "target_lang_word": "Mischung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mischung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b50909df-603e-3e9a-a328-7bc94a4b45e5",
                                        "entry_id": "2506ff77-13d5-3fa8-8a94-9fc6079a0eef",
                                        "glosses": [
                                            "Vorgang und Ergebnis des Zusammentuns/-kommens unterschiedlicher Gegenstände"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f85b107-74d5-468a-bb3c-e8f613aedb03",
                                                "sense_id": "b50909df-603e-3e9a-a328-7bc94a4b45e5",
                                                "text": "„Auf die Mischung in der Stadt kommt es an.“"
                                            },
                                            {
                                                "example_id": "7469db6c-3298-4065-a3f3-59aae69578ec",
                                                "sense_id": "b50909df-603e-3e9a-a328-7bc94a4b45e5",
                                                "text": "„Inzwischen tröpfeln aus den verschiedenen Straßen die Reisegenossen an, keine Menagerie, wie Delius sich das etwas übertrieben vorgestellt hatte, sondern eine brave Mischung von durchaus üblichen Menschen:…“"
                                            },
                                            {
                                                "example_id": "c9a0c332-ebd4-44ea-b315-348debc302dd",
                                                "sense_id": "b50909df-603e-3e9a-a328-7bc94a4b45e5",
                                                "text": "„Sie betrachtete ihn mit einer Mischung aus Bewunderung und Skepsis.“"
                                            },
                                            {
                                                "example_id": "0c7e4dab-63b4-4760-a1ed-7c8122cc38a4",
                                                "sense_id": "b50909df-603e-3e9a-a328-7bc94a4b45e5",
                                                "text": "„Ihr Hausrat war ein bunte Mischung aus diesem und jenem.“"
                                            },
                                            {
                                                "example_id": "624d6f30-b723-4194-8706-e73518149931",
                                                "sense_id": "b50909df-603e-3e9a-a328-7bc94a4b45e5",
                                                "text": "„Mit Kim kehrt ein Spieler zurück, der Mitte der Nullerjahre die Golfwelt im Sturm erobert hatte mit einer wilden Mischung aus Talent, Lässigkeit und Angriffslust.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "37a4114b-9dd5-355f-9bc0-4b2819053cec",
                                        "entry_id": "2506ff77-13d5-3fa8-8a94-9fc6079a0eef",
                                        "glosses": [
                                            "Gemisch von mindestens zwei Stoffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bb6ec4f-1635-44c0-8479-b9cf356e9f49",
                                                "sense_id": "37a4114b-9dd5-355f-9bc0-4b2819053cec",
                                                "text": "Salz gelöst in Wasser ist eine homogene Mischung / ein homogenes Gemisch."
                                            },
                                            {
                                                "example_id": "a219e6eb-0340-469e-9750-7b740a5c8070",
                                                "sense_id": "37a4114b-9dd5-355f-9bc0-4b2819053cec",
                                                "text": "„Benzin ist eine Mischung verschiedener Flüssigkeiten, eine davon ist Octan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "461005fa-ce5c-3e7a-b323-ef9502a7c970",
                                        "entry_id": "2506ff77-13d5-3fa8-8a94-9fc6079a0eef",
                                        "glosses": [
                                            "Mischung zweier oder mehrerer Farben"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "803127cd-f3c5-41e7-a6c9-91391ad40b2e",
                                                "sense_id": "461005fa-ce5c-3e7a-b323-ef9502a7c970",
                                                "text": "Die Mischung von Blau und Gelb ergibt grün."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1feec2cd-5f3e-4b76-b54b-9311251be6f1",
                        "source_entry_id": "47f9c1ea-f08c-3df9-aed3-d98d9ace7946",
                        "target_lang_word": "Mixtur",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mixtur",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b7f8ebe-b7f5-3c45-a63a-e5d6b8469db1",
                                        "entry_id": "88f13917-9665-382a-bb70-ce433bc8aab1",
                                        "glosses": [
                                            "aus verschiedenen Dingen zusammengemischte Sache"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8b41a57-3011-45ff-a4fb-22b54662580c",
                                                "sense_id": "7b7f8ebe-b7f5-3c45-a63a-e5d6b8469db1",
                                                "text": "„In einer Mixtur aus zwei unmischbaren Flüssigkeiten wie etwa Öl und Wasser vereinen sich die Tropfen einer Flüssigkeit nicht in dem Moment, in dem sie zusammenstoßen, sondern erst wenn sie sich wieder voneinander entfernen.“"
                                            },
                                            {
                                                "example_id": "77010843-170d-4756-91a8-8bbd3475eca7",
                                                "sense_id": "7b7f8ebe-b7f5-3c45-a63a-e5d6b8469db1",
                                                "text": "„Ich zog mich an, und während ich mir ein Ei kochte, trank ich eine Mixtur aus Tomatensaft und Bier.“"
                                            },
                                            {
                                                "example_id": "4824d545-35c7-4d83-b368-443b3fec0f54",
                                                "sense_id": "7b7f8ebe-b7f5-3c45-a63a-e5d6b8469db1",
                                                "text": "„Er genoss die Mixtur aus Alkohol und Melancholie.“"
                                            },
                                            {
                                                "example_id": "13d741b2-b48e-4fbf-8f8f-2973d27b9bee",
                                                "sense_id": "7b7f8ebe-b7f5-3c45-a63a-e5d6b8469db1",
                                                "text": "„Bruni, als Mitarbeiterin am MPI für biophysikalische Chemie auf diesem Gebiet praktizierender Weise firm, hat ihr eine Mixtur zusammengebraut, die es in sich hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "353e445c-7667-30b5-aa79-2a5a9c88eaf7",
                                        "entry_id": "88f13917-9665-382a-bb70-ce433bc8aab1",
                                        "glosses": [
                                            "aus verschiedenen Flüssigkeiten zusammengemischte Sache, meist Arznei"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
