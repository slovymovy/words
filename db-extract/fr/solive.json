        "fr-extract.jsonl": [
            {
                "entry_id": "3a719767-c9f0-3857-b87f-7671cfd91ad1",
                "word": "solive",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b78bc6f7-29a1-40b1-84fa-15c1ecd9fc6a",
                        "entry_id": "3a719767-c9f0-3857-b87f-7671cfd91ad1",
                        "tags": [
                            "plural"
                        ],
                        "form": "solives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e9937b97-cbad-376b-aead-5bbf1f12e9f9",
                        "entry_id": "3a719767-c9f0-3857-b87f-7671cfd91ad1",
                        "glosses": [
                            "Pièce de charpente qui sert à soutenir les planchers et qui porte sur les murs ou sur les poutres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a469e0-51d4-44ee-934b-efe10bc9f29d",
                                "sense_id": "e9937b97-cbad-376b-aead-5bbf1f12e9f9",
                                "text": "Une solive trouée avec une pierre pour pivot ferme la haie d’un champ […]"
                            },
                            {
                                "example_id": "b3edb65b-7818-422a-9f71-e3d578ab7472",
                                "sense_id": "e9937b97-cbad-376b-aead-5bbf1f12e9f9",
                                "text": "Les solives énormes du plafond étaient enjolivées de cannelures, finement ciselées."
                            },
                            {
                                "example_id": "7aeaa3f7-d957-4e98-af40-bd3640128664",
                                "sense_id": "e9937b97-cbad-376b-aead-5bbf1f12e9f9",
                                "text": "Le Sauvage lui souriait entre deux randonnées et repartait. Il retournait à ses vignes, à ses bois spongieux, s’attardait aux auberges de carrefours où tout est noir autour d’une longue chandelle : les solives, les murs enfumés, le pain de seigle et le vin dans les gobelets de fer…"
                            },
                            {
                                "example_id": "ff7cbdad-3ee9-431e-8eec-f6adba116879",
                                "sense_id": "e9937b97-cbad-376b-aead-5bbf1f12e9f9",
                                "text": "Il existe deux endroits où l’on peut couper dans les solives sans diminuer la résistance du plancher. On peut d’abord entailler la partie supérieure des solives à ses points d’appui, et ce, sur une épaisseur correspondant au tiers de la hauteur de la solive et sur une longueur égale à la moitié de sa hauteur."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b665037-c2f3-3996-b012-92e275010aec",
                        "entry_id": "3a719767-c9f0-3857-b87f-7671cfd91ad1",
                        "glosses": [
                            "Unité de mesure des bois de charpente."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2334c642-bf9f-46fb-814b-4f970670353e",
                                "sense_id": "1b665037-c2f3-3996-b012-92e275010aec",
                                "text": "Quelles que soient en effet les différentes formes des Bois, ils renferment toujours ou des solives, ou des parties de solive. Concevons donc tout simplement cette mesure comme un composé de trois pieds cubes, égaux à 5184 pouces cubes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66991c3a-edff-4f26-9a11-1753e128f28e",
                        "source_entry_id": "3a719767-c9f0-3857-b87f-7671cfd91ad1",
                        "target_lang_word": "joist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0c286a5-61ee-38fe-a943-89035d07c430",
                                        "entry_id": "51e92795-1a9d-3f66-bc8a-348b13f410a3",
                                        "glosses": [
                                            "A piece of timber or steel laid horizontally, or nearly so, to which the planks of the floor, or the laths or furring strips of a ceiling, are nailed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b99d15b7-f128-4288-8caf-ba50b01203f8",
                                                "sense_id": "d0c286a5-61ee-38fe-a943-89035d07c430",
                                                "text": "[…] a Family was infected there, in so terrible a Manner that every one of the House died; the last Person lay dead on the Floor, and as it is supposed, had laid her self all along to die just before the Fire; the Fire, it seems had fallen from its Place, being of Wood, and had taken hold of the Boards and the Joists they lay on, and burnt as far as just to the Body, but had not taken hold of the dead Body […]"
                                            },
                                            {
                                                "example_id": "08b3752e-9210-4d00-a74e-0aaddba20bba",
                                                "sense_id": "d0c286a5-61ee-38fe-a943-89035d07c430",
                                                "text": "There are generally forty-two teeth in all; in old whales, much worn down, but undecayed; nor filled after our artificial fashion. The jaw is afterwards sawn into slabs, and piled away like joists for building houses."
                                            },
                                            {
                                                "example_id": "f29675b1-37f4-4c6f-86b3-d6c0b351eb37",
                                                "sense_id": "d0c286a5-61ee-38fe-a943-89035d07c430",
                                                "text": "A formidable wooden beam, resting on four pillars, which appeared to have bent under the weight of the decrepit house, had been encrusted with as many coats of different paint as there are of rouge on an old duchess’s cheek. In the middle of this broad and fantastically carved joist there was an old painting representing a cat playing rackets."
                                            },
                                            {
                                                "example_id": "9393dd78-98f8-42f0-a5b0-f15a1f1c92a4",
                                                "sense_id": "d0c286a5-61ee-38fe-a943-89035d07c430",
                                                "text": "[…] even the carpenters who made her over for the service had not thought her worth the trouble, and had done their worst by her. The new partitions were hung to the joists by a few nails."
                                            },
                                            {
                                                "example_id": "f7b03c5e-069f-4c6e-a0db-4d313138b034",
                                                "sense_id": "d0c286a5-61ee-38fe-a943-89035d07c430",
                                                "text": "Once the floor joists were in position, the framing of the next storey could continue, with a bressummer laid along their ends."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "joist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f61ad21-a0bb-3480-a945-2411906cef7c",
                                        "entry_id": "fc991811-b1db-3ee6-9b85-974ff5f4a346",
                                        "glosses": [
                                            "To fit or furnish with joists."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b4a8bc9-54a4-4f5e-b842-63758c0cb061",
                                                "sense_id": "8f61ad21-a0bb-3480-a945-2411906cef7c",
                                                "text": "The floors are joisted with sapling tree trunks, and the flooring itself is made of bark, split and pounded flat into strips. No attempt is made either to fasten or join the strips of flooring."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
