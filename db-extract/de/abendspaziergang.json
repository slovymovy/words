                ],
                "senses": [
                    {
                        "sense_id": "43d48204-e12d-35a4-bd8b-0b37097026ea",
                        "entry_id": "3b3d2d98-3e01-3281-ab8f-bc65e01953a5",
                        "glosses": [
                            "geruhsames Gehen zur abendlichen Erholung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d349fd05-6951-431e-bc9f-e69a6ffe0e4c",
                                "sense_id": "43d48204-e12d-35a4-bd8b-0b37097026ea",
                                "text": "Er genießt seinen Abendspaziergang durch die Natur."
                            },
                            {
                                "example_id": "2758fdb4-ce1b-4c86-8bc0-4876db45dd51",
                                "sense_id": "43d48204-e12d-35a4-bd8b-0b37097026ea",
                                "text": "Während unseres ruhigen Abendspazierganges im Wald begegneten wir plötzlich einem Wolf."
                            },
                            {
                                "example_id": "520741e4-9055-4c9b-bd9d-67c222c131a5",
                                "sense_id": "43d48204-e12d-35a4-bd8b-0b37097026ea",
                                "text": "„Besuchen Sie hier das Collosseum, die älteste Distellery Schottlands und genießen Sie einen Abendspaziergang am Hafen.“"
                            },
                            {
                                "example_id": "f4a36cab-bd9e-46a9-a230-339493a62abf",
                                "sense_id": "43d48204-e12d-35a4-bd8b-0b37097026ea",
                                "text": "„An einem schönen Sommerabend Mitte der 60ger Jahre machte ich mit meiner Frau einen schönen Abendspaziergang. Er führte uns über Wiesen nahe unseres Dorfes.“"
                            },
                            {
                                "example_id": "63c9b195-7d05-4ad0-965b-bce8a5500c26",
                                "sense_id": "43d48204-e12d-35a4-bd8b-0b37097026ea",
                                "text": "„Der Rektor bestand darauf, die beste Medizin sei es, aktiv zu bleiben und aus dem Haus zu kommen, deshalb auch die Abendspaziergänge und zweimal täglich, morgens und abends, ein Bad in seinem heißen Salzwasserwhirlpool hinten im Garten, was, wie er sagte, eine der letzten Freuden seines Lebens sei.“"
                            },
                            {
                                "example_id": "09619c5a-767a-452c-b76f-753f0a4307f1",
                                "sense_id": "43d48204-e12d-35a4-bd8b-0b37097026ea",
                                "text": "„Seit dem ersten Abendspaziergange in dem Gärtchen hat er das Paar nicht gesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
