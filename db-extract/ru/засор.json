                                "example_id": "6c15c2c1-e33c-4203-96a4-7c697689bd25",
                                "sense_id": "70aa20d7-a08e-3495-8cb5-1ed0b66f5634",
                                "text": "У нас новая сантехника, и пока ничего крупного не случалось, только однажды был засор в одной из труб."
                            },
                            {
                                "example_id": "5fa1188c-1b1f-4da7-aea5-865975a69684",
                                "sense_id": "70aa20d7-a08e-3495-8cb5-1ed0b66f5634",
                                "text": "Или, может быть, засор карбюратора?"
                            }
                        ]
                    }
