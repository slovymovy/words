                        "sense_id": "d8907bf4-6cf7-3668-a843-c9800f1c6d47",
                        "entry_id": "9f27b5f6-46e8-3d6b-a887-2ab17460b804",
                        "glosses": [
                            "politischer Skandal größeren Ausmaßes und meist ein ganzes Land betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36bb6492-7823-42d6-ab9f-a5d78adeee3c",
                                "sense_id": "d8907bf4-6cf7-3668-a843-c9800f1c6d47",
                                "text": "„Das Polit-Beben könnte die Konservativen, die seit Ende 2011 im Königreich regieren, von der Macht vertreiben.“"
                            },
                            {
                                "example_id": "ba58a092-452f-48cf-937b-5386f3e7f9d5",
                                "sense_id": "d8907bf4-6cf7-3668-a843-c9800f1c6d47",
                                "text": "„Nach Brexit und Trump könnte es bald das nächste Polit-Beben geben. Im Mai stehen die Präsidentschaftswahlen in Frankreich an.“"
                            },
                            {
                                "example_id": "0ad4afe4-90cf-4b1f-8761-5c9e50cd15f4",
                                "sense_id": "d8907bf4-6cf7-3668-a843-c9800f1c6d47",
                                "text": "„Doch dann verliebte sich von Boetticher, damals 39, in eine 16-Jährige. Das Verhältnis wurde öffentlich. ‚Der Kandidat und das Mädchen – Liebesdrama in der CDU Schleswig-Holstein‘, titelte ‚Bild am Sonntag‘ Mitte August 2011 und löste ein Polit-Beben aus.“"
                            }
                        ],
