                "senses": [
                    {
                        "sense_id": "5909750f-e93b-3cea-bd09-3b7af65b1a65",
                        "entry_id": "e2d9969a-3ca8-3a56-8571-72804c4c8df4",
                        "glosses": [
                            "Bezeichnung für diejenigen Fälle von Wortbildung, bei denen Wörter, die fremdsprachige Eigenschaften aufweisen, in Wirklichkeit in der eigenen Sprache gebildet und nicht als Ganze entlehnt wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f41583b-7126-4217-96a5-3f8101322f49",
                                "sense_id": "5909750f-e93b-3cea-bd09-3b7af65b1a65",
                                "text": "„Munske, der der Frage nachgeht, ob das Deutsche eine Mischsprache sei, mißt der Lehnwortbildung größte Bedeutung bei…“"
                            },
                            {
                                "example_id": "2c0b80a1-ee3f-4907-9004-bda9b614f65a",
                                "sense_id": "5909750f-e93b-3cea-bd09-3b7af65b1a65",
                                "text": "„V. Polenz spricht von Lehnwortbildungen.“"
                            },
                            {
                                "example_id": "9b570b23-1460-4407-bb8d-8e4e7c2e08aa",
                                "sense_id": "5909750f-e93b-3cea-bd09-3b7af65b1a65",
                                "text": "„Die diachrone Unterscheidung zwischen Wortentlehnung und Lehnwortbildung bei den kombinierten Zeichen ist wie die Beschreibung der Entlehnungs- und Integrationsgeschichte der Wortbildungseinheiten eine zentrales Anliegen des Vorhabens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
