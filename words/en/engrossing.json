                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Medieval authorities strictly prohibited the <w>engrossing</w> of corn to prevent artificial scarcity.",
                            "target_lang_translations": {
                                "ru": "Средневековые власти строго запрещали <w>скупку</w> зерна, чтобы предотвратить искусственный дефицит."
                            }
