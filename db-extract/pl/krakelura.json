                                                "sense_id": "fbc9c32b-c9bd-376c-afb5-0e15bd5179f6",
                                                "text": "Είμαι πολύ κακός σε αυτό το μάθημα."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a1e8c11-f0d5-3fb1-bc0c-0fd8022b047d",
                                        "entry_id": "f7dc90a1-28d7-3951-afc4-fcb8df0d9f75",
                                        "glosses": [
                                            "δηλώνει:",
                                            "το έμμεσο αντικείμενο πολλών ρημάτων"
                                        ],
                                        "tags": [
                                            "με αιτιατική"
                                        ],
                                        "examples": [
