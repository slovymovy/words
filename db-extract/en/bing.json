                            "present"
                        ],
                        "form": "Binging"
                    },
                    {
                        "form_id": "8ca412c8-3199-4b0a-8389-361955cb45b9",
                        "entry_id": "d528cb71-cc60-3c00-b22f-c0d81541eea1",
                        "tags": [
                            "participle",
                            "past"
                        ],
                        "form": "Binged"
                    },
                    {
                        "form_id": "755ac0ca-bb14-4ef2-a87f-f15be5a0f79d",
                        "entry_id": "d528cb71-cc60-3c00-b22f-c0d81541eea1",
                        "tags": [
                            "past"
                        ],
                        "form": "Binged"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "464a3b6b-b836-3843-9937-e704013bf09e",
                        "entry_id": "d528cb71-cc60-3c00-b22f-c0d81541eea1",
                        "glosses": [
                            "To search for (something) on the Internet using the Bing search engine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7220d2d-56c5-4fd0-9e25-b027ba997be1",
                                "sense_id": "464a3b6b-b836-3843-9937-e704013bf09e",
                                "text": "Tess exited YouTube, Binged Richard Widmark, and found what she expected, given the power of that brief clip."
                            },
                            {
                                "example_id": "c6baf514-fcf3-4901-9098-8d1a51623bcb",
                                "sense_id": "464a3b6b-b836-3843-9937-e704013bf09e",
                                "text": "He must have Googled or Binged me and found out about one of Phil Logan’s early publicity stunts where he had me suited up like a Los Angeles Dodger so his photographer could take a picture of me holding a baseball bat."
                            },
                            {
                                "example_id": "cd7874a6-cdce-4944-9bf3-941c895d6852",
                                "sense_id": "464a3b6b-b836-3843-9937-e704013bf09e",
                                "text": "I Googled the company (then Binged it just to be sure), searched their job listings online, and tried to remember what job I actually applied for that generated this response."
                            },
                            {
                                "example_id": "260a4fb6-2d4f-462e-ad28-b3f9796e75cb",
                                "sense_id": "464a3b6b-b836-3843-9937-e704013bf09e",
                                "text": "So here she sat, having Googled and Binged and called former associates to try to get a bead on the education climate today."
                            },
                            {
                                "example_id": "c29a48ea-ebf9-480c-9e48-b0193512e412",
                                "sense_id": "464a3b6b-b836-3843-9937-e704013bf09e",
                                "text": "He Googled, Binged, and Yahooed sharks, shark life, shark types, shark history, shark food, and anything else shark-related."
                            },
                            {
                                "example_id": "b9c76dd8-1a57-4fa9-b0a1-dc895f58ee74",
                                "sense_id": "464a3b6b-b836-3843-9937-e704013bf09e",
                                "text": "“I’ve Googled it, Binged it, and Asked Jeeves. They all say the same thing, but I’m not convinced.”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
