                        "examples": [
                            {
                                "example_id": "64982669-dcd6-4631-bac9-41cc4edbd5b0",
                                "sense_id": "f6326719-a272-363e-b593-c0f01332fec7",
                                "text": "On peut supposer que le monde s’est auto-créé et continue à s’auto-créer à partir de son désastre originaire."
                            },
                            {
                                "example_id": "df4094a0-a965-489f-8af7-1d5c5d1eb055",
                                "sense_id": "f6326719-a272-363e-b593-c0f01332fec7",
                                "text": "Un univers isolé de mes univers, totalement indépendant qui ne cesse de s’auto-créer/s’auto-détruire (selon vos points de vue)."
                            },
                            {
                                "example_id": "73c46c94-64c5-4253-9bab-2f8e6b60db8b",
                                "sense_id": "f6326719-a272-363e-b593-c0f01332fec7",
                                "text": "Comment l’univers a-t-il pu surgir du néant et s’auto-créer comme il l'a fait ?"
                            }
                        ]
                    }
