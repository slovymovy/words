                    },
                    {
                        "translation_id": "c4727ef1-8ae5-471b-b013-6099f8e20755",
                        "source_entry_id": "ba170dea-0a0d-3cd9-96e3-b699058ee545",
                        "target_lang_word": "wyvern",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wyvern",
