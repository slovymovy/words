                                        "sense_id": "3c71c793-051d-3377-8565-9e237536c5f1",
                                        "entry_id": "2fee7892-6da8-37e9-9a74-1fbec4d9d24f",
                                        "glosses": [
                                            "Hauptspross einer nicht krautigen Pflanze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "818212db-f7db-42b8-8d48-a1664afed802",
                                                "sense_id": "3c71c793-051d-3377-8565-9e237536c5f1",
                                                "text": "Löwenzahn hat einen hohlen Stängel."
                                            },
                                            {
                                                "example_id": "911b251a-007c-4128-82c1-f42cf3771f95",
                                                "sense_id": "3c71c793-051d-3377-8565-9e237536c5f1",
                                                "text": "„Quanen haben grüne Blätter und grüne Stängel.“"
                                            },
                                            {
                                                "example_id": "fc860750-073d-464b-8d87-81b73323c93d",
                                                "sense_id": "3c71c793-051d-3377-8565-9e237536c5f1",
                                                "text": "„Der NABU Niedersachsen weist auf einen für viele Hobbygärtner und Naturfreunde unbekannten „Trick“ der Natur hin: In hohlen Stängeln überwintern Insekten, darunter winzig kleine Wildbienen, Ohrwürmer und andere Tiere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5911944e-2f4b-3e3c-8804-ce56b1dfe47c",
                                        "entry_id": "2fee7892-6da8-37e9-9a74-1fbec4d9d24f",
                                        "glosses": [
                                            "männliches Glied, Penis"
                                        ],
                                        "tags": [
                                            "impolite"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dece96c-1ec4-4347-9d80-643e8daa9e58",
                                                "sense_id": "5911944e-2f4b-3e3c-8804-ce56b1dfe47c",
                                                "text": "„Er öffnete die Hose und zeigte seinen Stängel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Stängel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fba0fdb-2415-315a-85cf-49943c2eb33f",
                                        "entry_id": "76347bc8-7a15-3e1e-af5c-df2ae5006826",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
