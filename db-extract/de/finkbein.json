                "senses": [
                    {
                        "sense_id": "13c73fe6-1dc3-36d3-8743-86860779de05",
                        "entry_id": "753243f0-718a-3864-a4c8-8d53c81c2dae",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7161aea4-b1c1-4e8a-9817-acd671150708",
                                "sense_id": "13c73fe6-1dc3-36d3-8743-86860779de05",
                                "text": "Frau Finkbein ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a3a2c26e-6664-4b22-a007-29126b2bf2bd",
                                "sense_id": "13c73fe6-1dc3-36d3-8743-86860779de05",
                                "text": "Herr Finkbein wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2159aa27-45ca-4a52-bc8d-6a200dac0033",
                                "sense_id": "13c73fe6-1dc3-36d3-8743-86860779de05",
                                "text": "Die Finkbeins fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a8e18ba0-cbbe-4d77-b60c-c7ea9fd182c8",
                                "sense_id": "13c73fe6-1dc3-36d3-8743-86860779de05",
                                "text": "Der Finkbein trägt nie die Schals, die die Finkbein ihm strickt."
                            },
                            {
                                "example_id": "e1e88183-232e-41f6-85a8-590db52143ad",
                                "sense_id": "13c73fe6-1dc3-36d3-8743-86860779de05",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Finkbein kommt, geht der Herr Finkbein.“"
                            },
                            {
                                "example_id": "d9a4b082-2cc8-4365-977a-0d66f7dd79f4",
                                "sense_id": "13c73fe6-1dc3-36d3-8743-86860779de05",
                                "text": "Finkbein kommt und geht."
                            },
                            {
                                "example_id": "056d6a8d-a667-46de-867d-ac648a581faf",
                                "sense_id": "13c73fe6-1dc3-36d3-8743-86860779de05",
                                "text": "Finkbeins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
