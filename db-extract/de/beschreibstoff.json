                "senses": [
                    {
                        "sense_id": "5e73cc95-0582-3d54-9b44-ad718996ad42",
                        "entry_id": "054f31c2-4845-3cab-8cfc-02d7b4188599",
                        "glosses": [
                            "Material, auf dem geschrieben wird/wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "612af49c-9c4d-4d0f-a048-86150d10362a",
                                "sense_id": "5e73cc95-0582-3d54-9b44-ad718996ad42",
                                "text": "„In einer Gesamtschau der Schrifttradition in den alten Zivilisationen wird deutlich, wie facettenreich die Anwendungsbereiche von Schrifttechnologie waren und wie variantenreich sich das Spektrum der Beschreibstoffe ausfächert:…“"
                            },
                            {
                                "example_id": "9e8e67a0-2c21-4611-8a1c-08ed74a2dd5a",
                                "sense_id": "5e73cc95-0582-3d54-9b44-ad718996ad42",
                                "text": "„Als Beschreibstoff werden verschiedene Materialien bezeichnet, auf denen man mit Hilfe eines Schreibgeräts und Tinte und Farbe das Geschriebene sichtbar gemacht werden kann. Beschreibstoffe werden daher auch als Schriftträger bezeichnet.“"
                            },
                            {
                                "example_id": "e3a78574-a6f3-4246-b8cd-1377196c932b",
                                "sense_id": "5e73cc95-0582-3d54-9b44-ad718996ad42",
                                "text": "„Mit der für die Menschheit entscheidenden Entwicklung der Schrift entstand der Bedarf nach Beschreibstoffen.“"
                            },
                            {
                                "example_id": "cbac5298-b702-45ba-87f7-b3101968a51f",
                                "sense_id": "5e73cc95-0582-3d54-9b44-ad718996ad42",
                                "text": "„Beschreibstoff war Seide, weniger als Gewebe denn als Fasergemenge mit Abfallteilchen und Kokons in wässriger Suspension.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
