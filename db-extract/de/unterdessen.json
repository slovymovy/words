        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "54fd7e95-0f92-3d1a-9fd5-9c87df442c85",
                "word": "unterdessen",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                        "entry_id": "54fd7e95-0f92-3d1a-9fd5-9c87df442c85",
                        "glosses": [
                            "im selben Zeitraum wie ein anderer Vorgang stattfindend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6a2e9e8-a5df-427d-8043-3ac5ee83c6f8",
                                "sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                                "text": "Ich erledigte wichtige Korrespondenz. Unterdessen verwüstete meine kleine Tochter die gesamte Wohnung."
                            },
                            {
                                "example_id": "1c863fae-86f7-4865-a1cb-e40c1381366c",
                                "sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                                "text": "„Unterdessen stand in Davos der Sonderzug für den Sarg bereit.“"
                            },
                            {
                                "example_id": "3f592b09-ab4e-440e-b24b-1410403c4373",
                                "sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                                "text": "„Ich watete durch Schneematsch und kämpfte gegen den Sturm, unterdessen überschüttete mich der Verkehr auf der Nördlichen Ringstraße mit Widerwärtigkeiten.“"
                            },
                            {
                                "example_id": "73f35aff-aab4-4df8-b556-86f6abb963d3",
                                "sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                                "text": "„Während sich unsere Kavalkade in Richtung auf die Berge in Bewegung setzte, gesellte ich mich zu Vanderbrecken und ließ mir von ihm erzählen, was sich unterdessen ereignet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "482752a0-d29f-4e3e-a2e3-1758c785d3b9",
                        "source_entry_id": "54fd7e95-0f92-3d1a-9fd5-9c87df442c85",
                        "source_sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                        "source_sense_description": "im selben Zeitraum wie ein anderer Vorgang stattfindend",
                        "target_lang_word": "meanwhile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meanwhile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41b4c4c7-19d0-3da0-b812-b679bf3ec580",
                                        "entry_id": "caab6ad0-d45e-39cc-9755-498b9ee5e510",
                                        "glosses": [
                                            "The time between two events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b2315d-7c63-4384-b5eb-77c4ded31571",
                                                "sense_id": "41b4c4c7-19d0-3da0-b812-b679bf3ec580",
                                                "text": "In the meanwhile, the surveyors carried the line three miles, which was no contemptible day's work, considering how cruelly they were entangled with briers and gallbushes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "meanwhile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30009493-26b1-34f2-bac4-6b30722359c8",
                                        "entry_id": "91607b7e-f089-385b-a7ca-363659ba3e46",
                                        "glosses": [
                                            "During the time that something is happening, often specifically in a different place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8e5e79c-ae8f-4148-b523-1c9c34e73771",
                                                "sense_id": "30009493-26b1-34f2-bac4-6b30722359c8",
                                                "text": "There was a party going on downstairs. Meanwhile, I was reading a book."
                                            },
                                            {
                                                "example_id": "e2fca7da-277f-4f41-a041-026da9b103ab",
                                                "sense_id": "30009493-26b1-34f2-bac4-6b30722359c8",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                        "entry_id": "91607b7e-f089-385b-a7ca-363659ba3e46",
                                        "glosses": [
                                            "During an intervening time; from now until a future time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b87e7889-9a76-4362-9b4e-6076a7392553",
                                                "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                                "text": "We’re going on holiday next month; meanwhile, keep working on the project."
                                            },
                                            {
                                                "example_id": "eb3d8668-3f83-46a9-837f-55f7e8b2e18d",
                                                "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                                "text": "The day may dawn when fair play, love for one's fellow men, respect for justice and freedom, will enable tormented generations to march forth triumphant from the hideous epoch in which we have to dwell. Meanwhile, never flinch, never weary, never despair."
                                            },
                                            {
                                                "example_id": "224cf66c-ad13-4898-9fc8-c656c0cb974a",
                                                "sense_id": "a65c1a26-5171-3e34-9870-1111c26940e0",
                                                "text": "“[…] I’m not ignoring you, I’m very sorry, I’ll talk to you soon. Meanwhile, get your tickets.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "915d4253-2a2f-3183-ad53-385bdabb68ce",
                                        "entry_id": "91607b7e-f089-385b-a7ca-363659ba3e46",
                                        "glosses": [
                                            "In contrast to aspects previously mentioned."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "090ed779-978e-44e0-81d8-98bcd1fa47c8",
                                                "sense_id": "915d4253-2a2f-3183-ad53-385bdabb68ce",
                                                "text": "Some songs on the album are beautiful. Meanwhile, others are quite forgettable."
                                            },
                                            {
                                                "example_id": "c4a80167-011a-4835-973a-e857e80ce02e",
                                                "sense_id": "915d4253-2a2f-3183-ad53-385bdabb68ce",
                                                "text": "When you are in the studio you don’t have anybody to feed off of, meanwhile when you are playing live you interact with people and you feel the energy in the room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43dde868-9131-4891-8e5c-7a2fac169aee",
                        "source_entry_id": "54fd7e95-0f92-3d1a-9fd5-9c87df442c85",
                        "source_sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                        "source_sense_description": "im selben Zeitraum wie ein anderer Vorgang stattfindend",
                        "target_lang_word": "in the meantime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in the meantime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40957b99-e4cd-39e0-b2f3-c3124f0c3241",
                                        "entry_id": "6f1e09ab-a9b4-36c9-a4f5-460f4faf0409",
                                        "glosses": [
                                            "meanwhile"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779d4a11-3bbd-4c10-a9d3-bf2b1bc17fb7",
                                                "sense_id": "40957b99-e4cd-39e0-b2f3-c3124f0c3241",
                                                "text": "But in the meantime Robin Hood and his band lived quietly in Sherwood Forest, without showing their faces abroad, for Robin knew that it would not be wise for him to be seen in the neighborhood of Nottingham, those in authority being very wroth with him."
                                            },
                                            {
                                                "example_id": "fb1ed1c2-10d1-4690-9706-2ce0b4a2907a",
                                                "sense_id": "40957b99-e4cd-39e0-b2f3-c3124f0c3241",
                                                "text": "\"In the meantime,\" said Norbourne, \"we have arrived at the park-gate, and have not determined whither we shall ride.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3f5812d-77d8-4261-9a2c-b02757b9505a",
                        "source_entry_id": "54fd7e95-0f92-3d1a-9fd5-9c87df442c85",
                        "source_sense_id": "eaaabbf3-f6eb-373e-8b8d-ee60a7fd3815",
                        "source_sense_description": "im selben Zeitraum wie ein anderer Vorgang stattfindend",
                        "target_lang_word": "entre-temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entre-temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9dfcced4-4525-3345-8db8-7f593f49511c",
                                        "entry_id": "defb969f-afb2-3da1-a1fe-4885fb0759e1",
                                        "glosses": [
                                            "Dans cet intervalle de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d82a733-41bd-418a-a8f5-5dabe98de4eb",
                                                "sense_id": "9dfcced4-4525-3345-8db8-7f593f49511c",
                                                "text": "Entre-temps, des émissaires à pied rapportèrent une bonne nouvelle au village. Au sud, à Isandlwana, l’armée de Cetshwayo venait d’anéantir les Britanniques. Une victoire sans appel. Une clameur envahit aussitôt le kraal, la fierté du peuple du Ciel gonflait le cœur de tous les combattants."
                                            },
                                            {
                                                "example_id": "d0074053-3f69-4d1a-a812-4ef40446fb66",
                                                "sense_id": "9dfcced4-4525-3345-8db8-7f593f49511c",
                                                "text": "Entre-temps, il arriva, il survint."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "entre-temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2f869b5-0e70-359f-959a-cd435ab46302",
                                        "entry_id": "9e20e11e-9507-3441-abe0-e48454e2a67b",
                                        "glosses": [
                                            "Intervalle de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c714bc3-96fa-4899-a4cb-49dd709b70c4",
                                                "sense_id": "a2f869b5-0e70-359f-959a-cd435ab46302",
                                                "text": "Dans l’entre-temps – et c’est le sens de ce sommet –, nous devons sans attendre renforcer nos coopérations concrètes, notamment en matière de sécurité, de connectivité, d’infrastructures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
