                                "text": "Jij las."
                            },
                            {
                                "example_id": "ae550953-58cf-453a-ad8a-afebe511e8ff",
                                "sense_id": "5e338e71-58d5-3f8d-9c6d-7a267b9a9210",
                                "text": "Hij, zij, het las."
                            },
                            {
