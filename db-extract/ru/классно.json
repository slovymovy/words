        "ru-extract.jsonl": [
            {
                "entry_id": "983432fe-bc10-3d97-8a70-5d5a34e5ee4d",
                "word": "классно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "34565e91-d514-3335-9415-6535e617c24a",
                        "entry_id": "983432fe-bc10-3d97-8a70-5d5a34e5ee4d",
                        "glosses": [
                            "мол., сленг хорошо, ладно, красиво"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1dd4777-ae80-4709-aabc-7d2fb4a257bf",
                                "sense_id": "34565e91-d514-3335-9415-6535e617c24a",
                                "text": "Мы, конечно, классно играем, но можно было найти кого получше!"
                            },
                            {
                                "example_id": "5a430271-bed5-4036-abdb-40648d643dba",
                                "sense_id": "34565e91-d514-3335-9415-6535e617c24a",
                                "text": "Ему пока семь раз не скажешь, что он классно выглядит, не успокоится."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2442a8b0-8651-438d-8d3e-1525bc69acdd",
                        "source_entry_id": "983432fe-bc10-3d97-8a70-5d5a34e5ee4d",
                        "source_sense_id": "34565e91-d514-3335-9415-6535e617c24a",
                        "target_lang_word": "awesome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "awesome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cfcf57e-2e60-37af-a41b-348679b896f0",
                                        "entry_id": "6d032a51-b9d5-35d0-b054-8c97fbee4fab",
                                        "glosses": [
                                            "Causing awe or terror; inspiring wonder or excitement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d8a4aad-7698-43a3-9139-074dd526883a",
                                                "sense_id": "2cfcf57e-2e60-37af-a41b-348679b896f0",
                                                "text": "The waterfall in the middle of the rainforest was an awesome sight."
                                            },
                                            {
                                                "example_id": "74afb2c0-4ce6-4480-99e7-ab76283f5f58",
                                                "sense_id": "2cfcf57e-2e60-37af-a41b-348679b896f0",
                                                "text": "The tsunami was awesome in its destructive power."
                                            },
                                            {
                                                "example_id": "a1bbb70a-bdb3-4523-8019-55c13b354499",
                                                "sense_id": "2cfcf57e-2e60-37af-a41b-348679b896f0",
                                                "text": "And now it appeared that there was a mysterious Queen clothed by rumour with dread and wonderful attributes, and commonly known by the impersonal, but, to my mind, rather awesome title of She."
                                            },
                                            {
                                                "example_id": "4f908d41-082a-4e23-9205-0f41b5076bfb",
                                                "sense_id": "2cfcf57e-2e60-37af-a41b-348679b896f0",
                                                "text": "I think that the most fearsome attribute of these awesome creatures is their silence and the fact that one never sees them—nothing but those baleful eyes glaring unblinkingly out of the dark void behind."
                                            },
                                            {
                                                "example_id": "68c44f28-d09d-4ed9-9618-a0a09053e4df",
                                                "sense_id": "2cfcf57e-2e60-37af-a41b-348679b896f0",
                                                "text": "Certainly it is awesome to think of a nation that brings its powers of persuasion against a woman's right to conceive."
                                            },
                                            {
                                                "example_id": "51fa88ab-479b-4df5-834f-908998a66f7f",
                                                "sense_id": "2cfcf57e-2e60-37af-a41b-348679b896f0",
                                                "text": "“Congratulations, President Trump,” Netanyahu said in a video statement immediately following the U.S. attack. “Your bold decision to target Iran's nuclear facilities with the awesome and righteous might of the United States will change history.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bbd74a6-e550-3afa-b62d-21e9070fdafd",
                                        "entry_id": "6d032a51-b9d5-35d0-b054-8c97fbee4fab",
                                        "glosses": [
                                            "Excellent, exciting, remarkable."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "Canada",
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc5747c5-f53c-4d82-b581-33061744db48",
                                                "sense_id": "2bbd74a6-e550-3afa-b62d-21e9070fdafd",
                                                "text": "That was awesome!"
                                            },
                                            {
                                                "example_id": "749f45c0-9109-47e0-b0c4-e46b327f691f",
                                                "sense_id": "2bbd74a6-e550-3afa-b62d-21e9070fdafd",
                                                "text": "Awesome, dude!"
                                            },
                                            {
                                                "example_id": "02ee0348-a6c0-433e-a3f6-e107f9bf9d9f",
                                                "sense_id": "2bbd74a6-e550-3afa-b62d-21e9070fdafd",
                                                "text": "Awesome! Totally awesome! All right, Hamilton!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "awesome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63b29e91-67cf-337e-a6a1-6c6c30607602",
                                        "entry_id": "d56502b8-6c11-321a-839d-e29e432a791d",
                                        "glosses": [
                                            "Clipping of awesomeness (“the quality, state, or essence of being awesome”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fc887c6-7266-4b08-ae21-cff28863f991",
                                                "sense_id": "63b29e91-67cf-337e-a6a1-6c6c30607602",
                                                "text": "pure awesome"
                                            },
                                            {
                                                "example_id": "9720fd11-3e42-453c-8c62-701630337cfb",
                                                "sense_id": "63b29e91-67cf-337e-a6a1-6c6c30607602",
                                                "text": "made of awesome"
                                            },
                                            {
                                                "example_id": "a83fe395-fe5b-4cf6-8986-f492c0f7d8eb",
                                                "sense_id": "63b29e91-67cf-337e-a6a1-6c6c30607602",
                                                "text": "Plus, her patent leather boots were made of awesome. They made her legs look longer and leaner."
                                            },
                                            {
                                                "example_id": "2a3bce17-577a-4499-bfe0-0af967fae5df",
                                                "sense_id": "63b29e91-67cf-337e-a6a1-6c6c30607602",
                                                "text": "Swayze, of course, is the being of pure awesome who has by now conquered all of Heaven."
                                            },
                                            {
                                                "example_id": "87b2b898-cdc7-415f-b5d5-99a504b3fac4",
                                                "sense_id": "63b29e91-67cf-337e-a6a1-6c6c30607602",
                                                "text": "“Your grandmother,” he mumbles into my hair as we cuddle on the couch, “is made of awesome.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66627fd9-cb8f-3b25-aaaa-bb79ac4ab146",
                                        "entry_id": "d56502b8-6c11-321a-839d-e29e432a791d",
                                        "glosses": [
                                            "A person who is awesome."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a43f6fb2-2c3e-4e8f-9ca8-028f74a822fd",
                                                "sense_id": "66627fd9-cb8f-3b25-aaaa-bb79ac4ab146",
                                                "text": "When an awesome is dreadful and making even the living of a common person miserable then someone from the community must stand up to resist the dreadful and check the excesses."
                                            },
                                            {
                                                "example_id": "05802221-5b5b-484a-b599-519b45c3ac52",
                                                "sense_id": "66627fd9-cb8f-3b25-aaaa-bb79ac4ab146",
                                                "text": "“Or as I like to think of it, the wusses versus the awesomes.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
