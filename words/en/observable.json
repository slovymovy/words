{
    "word_family": [
        "observe",
        "observer",
        "observation",
        "observance",
        "observant"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a1c7b8a-8833-3e0d-bf5c-85a1093b33d2",
                    "sense_definition": "Able to be seen or noticed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perceptible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The star is at the edge of the <w>observable</w> universe.",
                            "target_lang_translations": {
                                "zh": "这颗恒星位于<w>可观察</w>宇宙的边缘。"
                            }
                        },
                        {
                            "text": "Changes in the patient's condition were clearly <w>observable</w> after the treatment.",
                            "target_lang_translations": {
                                "zh": "治疗后，病人的病情变化是<w>显而易见</w>的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "noticeable",
                        "perceivable",
                        "perceptible"
                    ],
                    "common_phrases": [
                        "observable universe"
                    ],
                    "target_lang_definitions": {
                        "zh": "可以被看见或察觉到的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可观察的",
                                "target_lang_sense_clarification": "指客观上能够被观测或察觉到的事物。"
                            },
                            {
                                "target_lang_word": "显而易见的",
                                "target_lang_sense_clarification": "指容易被注意到的，强调程度明显。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18686935-64e6-3fea-bd0a-079b574857c5",
                    "sense_definition": "Deserving to be noticed; remarkable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "notable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect created an <w>observable</w> design that changed the city skyline.",
                            "target_lang_translations": {
                                "zh": "这位建筑师创造了一个<w>显著</w>的设计，改变了城市的天际线。"
                            }
                        },
                        {
                            "text": "Her <w>observable</w> talent for music was clear to everyone from a young age.",
                            "target_lang_translations": {
                                "zh": "她那<w>显著</w>的音乐天赋从小就显而易见。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eminent",
                        "noteworthy",
                        "notable"
                    ],
                    "target_lang_definitions": {
                        "zh": "值得注意的；显著的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "显著的",
                                "target_lang_sense_clarification": "指非常明显且值得关注的。"
                            },
                            {
                                "target_lang_word": "值得注意的",
                                "target_lang_sense_clarification": "指具有某种特质，引起人们的关注。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d452ef5f-de21-30e4-9440-635c16e4ea26",
                    "sense_definition": "A physical property that can be measured directly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Temperature is a common <w>observable</w> in physics experiments.",
                            "target_lang_translations": {
                                "zh": "温度是物理实验中一种常见的<w>可观测量</w>。"
                            }
                        },
                        {
                            "text": "Scientists define an <w>observable</w> as any quantity that can be measured.",
                            "target_lang_translations": {
                                "zh": "科学家将任何可以测量的量定义为<w>可观测量</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "物理学中指可以直接测量的物理量。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可观测量",
                                "target_lang_sense_clarification": "科学术语，指物理实验中可以直接测量的量。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}