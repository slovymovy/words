                    {
                        "sense_id": "a5ee1bb7-2de7-3b1f-bf79-c74e0cb7aabf",
                        "entry_id": "fade26d0-8bbd-3286-98f8-665a67a6bd4b",
                        "glosses": [
                            "Celle qui partage avec une ou plusieurs autres personnes la direction d’une entreprise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1c892e8-dcd9-4fe6-b38e-b95f4d28689a",
                                "sense_id": "a5ee1bb7-2de7-3b1f-bf79-c74e0cb7aabf",
                                "text": "Jusqu’au début des années quatre-vingt-dix, elle en est la codirectrice artistique."
                            },
                            {
                                "example_id": "b7474967-f401-4873-b9cb-a4d5b4c20ff5",
                                "sense_id": "a5ee1bb7-2de7-3b1f-bf79-c74e0cb7aabf",
                                "text": "Depuis la crise économique de 2007, le chiffre d’affaires du secteur de l’habillement baisse de 5 % par an, tous les ans, indique Pascale Hébel, codirectrice d’une société de conseil en marketing."
                            },
                            {
                                "example_id": "4829c352-a6e9-40db-8ac4-2a063732c3b1",
                                "sense_id": "a5ee1bb7-2de7-3b1f-bf79-c74e0cb7aabf",
                                "text": "« Une édition miraculeuse. Tout a marché », a commenté Sophie Mirouze, la codirectrice générale."
                            }
                        ]
                    }
