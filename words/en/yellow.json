{
    "word_family": [
        "yellowish",
        "yellowness",
        "yellowy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "922553af-05fd-3f56-b716-3944bd219ae5",
                    "sense_definition": "Of a yellow hue.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "color_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>yellow</w> laptop in his bag.",
                            "target_lang_translations": {
                                "ru": "У него в сумке был <w>жёлтый</w> ноутбук.",
                                "zh": "他的包里有一个<w>黄</w>色的笔记本电脑。"
                            }
                        },
                        {
                            "text": "The leaves turned bright <w>yellow</w> in the autumn.",
                            "target_lang_translations": {
                                "ru": "Осенью листья стали ярко-<w>жёлтыми</w>.",
                                "zh": "秋天树叶变成了明亮的<w>黄色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gold",
                        "lemon",
                        "amber"
                    ],
                    "antonyms": [
                        "nonyellow"
                    ],
                    "common_phrases": [
                        "bright yellow",
                        "pale yellow",
                        "dark yellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий жёлтый оттенок.",
                        "zh": "具有黄色的色调。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёлтый",
                                "target_lang_sense_clarification": "цвет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黄",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8b084af-9068-3f41-8bca-909254c10359",
                    "sense_definition": "Lacking courage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cowardly_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be <w>yellow</w>; go and talk to him.",
                            "target_lang_translations": {
                                "ru": "Не будь <w>трусливым</w>; иди и поговори с ним.",
                                "zh": "别那么<w>胆小</w>，去跟他谈谈。"
                            }
                        },
                        {
                            "text": "He was too <w>yellow</w> to admit his mistake to the boss.",
                            "target_lang_translations": {
                                "ru": "Он был слишком <w>труслив</w>, чтобы признать свою ошибку перед начальником.",
                                "zh": "他太<w>懦弱</w>了，不敢向老板承认错误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cowardly"
                    ],
                    "common_phrases": [
                        "yellow streak",
                        "yellow belly"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Не имеющий смелости.",
                        "zh": "缺乏勇气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трусливый",
                                "target_lang_sense_clarification": "боязливый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胆小",
                                "target_lang_sense_clarification": "形容人懦弱"
                            },
                            {
                                "target_lang_word": "懦弱",
                                "target_lang_sense_clarification": "形容性格软弱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6de2656f-425b-3064-b7d7-0f35cba682f4",
                    "sense_definition": "Characterized by sensationalism, lurid content, and doubtful accuracy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "journalism_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>yellow</w> press often exaggerates stories to sell more newspapers.",
                            "target_lang_translations": {
                                "ru": "<w>Жёлтая</w> пресса часто преувеличивает истории, чтобы продать больше газет.",
                                "zh": "<w>黄色</w>新闻媒体经常夸大事实以增加报纸销量。"
                            }
                        },
                        {
                            "text": "He refused to read the <w>yellow</w> tabloids because they lacked facts.",
                            "target_lang_translations": {
                                "ru": "Он отказывался читать <w>жёлтые</w> таблоиды, потому что в них не было фактов.",
                                "zh": "他拒绝阅读那些<w>黄色</w>小报，因为它们缺乏事实依据。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "yellow journalism",
                        "yellow press"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся сенсационностью и сомнительной точностью.",
                        "zh": "指新闻报道以耸人听闻、夸大其词或缺乏事实依据为特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёлтый",
                                "target_lang_sense_clarification": "о прессе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黄色",
                                "target_lang_sense_clarification": "指新闻媒体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "99deca5f-ee32-3675-9c4c-4ecf6501c53a",
                    "sense_definition": "The color of sunflower petals and lemons; one of the primary colors.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "color_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is the strangest <w>yellow</w>, that wall-paper!",
                            "target_lang_translations": {
                                "ru": "У этих обоев страннейший <w>жёлтый</w> цвет!",
                                "zh": "那壁纸的<w>黄色</w>真是奇怪！"
                            }
                        },
                        {
                            "text": "She decided to paint the kitchen a sunny <w>yellow</w>.",
                            "target_lang_translations": {
                                "ru": "Она решила покрасить кухню в солнечный <w>жёлтый</w>.",
                                "zh": "她决定把厨房漆成阳光般的<w>黄色</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gold",
                        "lemon",
                        "amber"
                    ],
                    "common_phrases": [
                        "shades of yellow",
                        "bright yellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цвет лепестков подсолнуха и лимонов; один из основных цветов.",
                        "zh": "向日葵花瓣或柠檬的颜色；三原色之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёлтый цвет",
                                "target_lang_sense_clarification": "существительное"
                            },
                            {
                                "target_lang_word": "желтизна",
                                "target_lang_sense_clarification": "свойство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黄色",
                                "target_lang_sense_clarification": "名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e95131dc-bc7c-3487-8892-a4641ff6b1e0",
                    "sense_definition": "The middle light in a set of three traffic lights, indicating drivers should prepare to stop.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "traffic_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should slow down when the light turns to <w>yellow</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе следует притормозить, когда свет переключится на <w>жёлтый</w>.",
                                "zh": "当信号灯变成<w>黄灯</w>时，你应该减速。"
                            }
                        },
                        {
                            "text": "He sped up to cross the intersection before the <w>yellow</w> turned red.",
                            "target_lang_translations": {
                                "ru": "Он ускорился, чтобы проехать перекрёсток, пока <w>жёлтый</w> не сменился красным.",
                                "zh": "他在<w>黄灯</w>变红灯前加速通过了十字路口。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amber"
                    ],
                    "common_phrases": [
                        "on yellow",
                        "yellow light"
                    ],
                    "target_lang_definitions": {
                        "ru": "Средний сигнал светофора, указывающий водителям приготовиться к остановке.",
                        "zh": "交通信号灯中间的灯，提示驾驶员准备停车。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёлтый свет",
                                "target_lang_sense_clarification": "сигнал светофора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黄灯",
                                "target_lang_sense_clarification": "交通信号"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e56b8415-27de-37f4-be53-6beecce8c87a",
                    "sense_definition": "A yellow card shown by a referee to a player for a foul.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soccer_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee showed him a <w>yellow</w> for the bad tackle.",
                            "target_lang_translations": {
                                "ru": "Судья показал ему <w>жёлтую</w> за грубый подкат.",
                                "zh": "裁判因为他那次恶劣的铲球向他出示了一张<w>黄牌</w>。"
                            }
                        },
                        {
                            "text": "That second <w>yellow</w> meant he was sent off the field.",
                            "target_lang_translations": {
                                "ru": "Эта вторая <w>жёлтая</w> означала, что его удалили с поля.",
                                "zh": "那第二张<w>黄牌</w>意味着他被罚下场了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get a yellow",
                        "show a yellow"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for yellow card"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жёлтая карточка, показываемая судьёй игроку за нарушение.",
                        "zh": "足球比赛中裁判对犯规球员出示的警告牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёлтая карточка",
                                "target_lang_sense_clarification": "футбол"
                            },
                            {
                                "target_lang_word": "горчичник",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黄牌",
                                "target_lang_sense_clarification": "足球术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "172449c2-59c1-3c71-9bd9-051cbb6f497f",
                    "sense_definition": "To become yellow or yellower, often due to age.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pages of the old book began to <w>yellow</w> over time.",
                            "target_lang_translations": {
                                "ru": "Страницы старой книги начали <w>желтеть</w> со временем.",
                                "zh": "随着时间的推移，那本旧书的书页开始<w>发黄</w>。"
                            }
                        },
                        {
                            "text": "White plastic often <w>yellows</w> if exposed to sunlight for too long.",
                            "target_lang_translations": {
                                "ru": "Белый пластик часто <w>желтеет</w>, если слишком долго находится на солнце.",
                                "zh": "白色塑料如果长时间暴露在阳光下，通常会<w>变黄</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "yellow with age"
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться жёлтым или более жёлтым, часто от старости.",
                        "zh": "变得发黄，通常是因为老化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "желтеть",
                                "target_lang_sense_clarification": "становиться жёлтым"
                            },
                            {
                                "target_lang_word": "пожелтеть",
                                "target_lang_sense_clarification": "стать жёлтым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发黄",
                                "target_lang_sense_clarification": "变色"
                            },
                            {
                                "target_lang_word": "变黄",
                                "target_lang_sense_clarification": "变色"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}