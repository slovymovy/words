                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f979f1bf-387c-48b6-af9a-292178d2d1e7",
                                "sense_id": "fb706aab-556b-3750-8aaf-e71242c43060",
                                "text": "Phil Collins wil tijdens zijn komende tournee toch weer zijn drumstokken gebruiken. De zanger zou al maanden in het geheim aan het oefenen zijn om in ieder geval zijn befaamde drumsolo uit In The Air Tonight te spelen. Dat schrijft The Mirror."
                            },
                            {
                                "example_id": "9ce09d6a-20bf-4d73-b6fc-e299e2a69ea2",
                                "sense_id": "fb706aab-556b-3750-8aaf-e71242c43060",
                                "text": "Toen het tijd was voor een drumsolo, grepen ook de bassist en de accordeonist naar de percussie."
                            },
                            {
                                "example_id": "0175457e-81b0-4fc5-bf11-74a4f8bbc1c9",
                                "sense_id": "fb706aab-556b-3750-8aaf-e71242c43060",
                                "text": "Hoogtepunt voor velen wordt ‘Radar Love’ en zeker de ingebouwde drumsolo van Cesar Zuiderwijk. De zaal gaat uit z’n dak. De drummer gooit z’n stokjes het publiek in."
                            }
                        ]
                    }
