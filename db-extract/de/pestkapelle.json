                "senses": [
                    {
                        "sense_id": "1da7e616-e09c-3d00-ab1d-b755d1694c55",
                        "entry_id": "0fcb61ba-4b03-3c0d-86ff-58e3b4dc8b74",
                        "glosses": [
                            "kleine Kapelle für Danksagung und Erinnerung an die Pestopfer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d00be6c-d68c-4f43-b85f-0c4b5f9a8ff3",
                                "sense_id": "1da7e616-e09c-3d00-ab1d-b755d1694c55",
                                "text": "„Sebastian und Rochus, die beiden Patrone der Waither „Pestkapelle“, wurden besonders als Helfer gegen Seuchen angerufen.“"
                            },
                            {
                                "example_id": "f5f18e24-d209-429d-8968-27933d181c63",
                                "sense_id": "1da7e616-e09c-3d00-ab1d-b755d1694c55",
                                "text": "„Aus Dankbarkeit, dass sie von der Krankheit verschont wurden, errichteten die überlebenden Bürger Minheims in den Jahren 1710 - 1718 eine „Pestkapelle“ am Ortsausgang Richtung Klausen.“"
                            },
                            {
                                "example_id": "51c345ce-da4b-4bfb-993e-d85b12cb168e",
                                "sense_id": "1da7e616-e09c-3d00-ab1d-b755d1694c55",
                                "text": "„In der Pestkapelle bei Obing steht geschrieben: \"Das durch Krieg, Hunger, Teuerung und Pest verursachte Elend ist so groß, dass keine Feder imstande ist, sie zu beschreiben.\"“"
                            },
                            {
                                "example_id": "e97eda9f-5f31-4b1e-8e12-7633baff6284",
                                "sense_id": "1da7e616-e09c-3d00-ab1d-b755d1694c55",
                                "text": "„Hoch über dem malerischen Städtchen Gargnano am Westufer des Gardasees steht die knapp 400 Jahre alte, weiß gekalkte Pestkapelle San Valentino.“"
                            },
                            {
                                "example_id": "167939eb-a497-4ef1-9594-28f92cdb8372",
                                "sense_id": "1da7e616-e09c-3d00-ab1d-b755d1694c55",
                                "text": "„Die Minheimer Pestkapelle liegt auf einer Anhöhe, die man zu Fuss über den Minheimer Weinlehrpfad erwandern kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
