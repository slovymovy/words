                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9f6402c0-a80a-368a-b9cb-ecb20153965e",
                                        "entry_id": "940d1054-b6f5-3ebd-8e71-ccfd339e636c",
                                        "glosses": [
                                            "vlakke ondergrond waarop men een papier kan klemmen waarop men kan schrijven of tekenen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f5a9f2d-a8da-445a-b362-d00e2c8be0ba",
                                                "sense_id": "9f6402c0-a80a-368a-b9cb-ecb20153965e",
                                                "text": "Een tekenbord is een gladde plank met een tekenhaak eraan. Een tekenbord kan je schuin op tafel zetten.Op een tekenbord kan je een vel papier plakken en er met het tekengereedschap technische tekeningen op maken. Tekenborden worden veel gebruikt door ontwerpers."
                                            },
                                            {
                                                "example_id": "16d1c52a-18c3-4a96-a805-40e8a3865a4d",
                                                "sense_id": "9f6402c0-a80a-368a-b9cb-ecb20153965e",
                                                "text": "Nieuw is het elektronisch tekenbord, dat Sony op de Firato introduceert. In combinatie met een televisie kan het kind daarmee tekenen en kleuren. En het resultaat is nog op de video op te nemen ook."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
