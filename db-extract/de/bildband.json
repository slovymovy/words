                ],
                "senses": [
                    {
                        "sense_id": "5462c920-ce82-317f-9b38-87bd573a0a47",
                        "entry_id": "4648667f-4856-3535-9a71-0335792b8065",
                        "glosses": [
                            "Buch, das hauptsächlich Abbildungen enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ce32c63-8ecb-42d1-a837-611a57e7a75b",
                                "sense_id": "5462c920-ce82-317f-9b38-87bd573a0a47",
                                "text": "„In der größten Buchhandlung der Färöer kann man in einem reichhaltigen Sortiment an Büchern stöbern und bekommt Reiseführer sowie Bildbände in anderen Sprachen.“"
                            },
                            {
                                "example_id": "489c5326-0d8b-48b1-ba20-f5ab47bb0a41",
                                "sense_id": "5462c920-ce82-317f-9b38-87bd573a0a47",
                                "text": "„Die Sammlung selbst umfaßt inzwischen mehr als 400 teils farbige Post- und Ansichtskarten des gesamten Eichsfeldes, von denen in diesem Bildband circa 130 auf Alt-Duderstadt bezogene Ansichtskarten veröffentlicht werden.“"
                            },
                            {
                                "example_id": "b3258243-f4ab-476c-8372-96874cfe77fa",
                                "sense_id": "5462c920-ce82-317f-9b38-87bd573a0a47",
                                "text": "„Der Bildband wurde der Renner des Jahres, wenn nicht des Jahrzehnts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
