                    "frequency": "High",
                    "semantic_group_id": "passion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune militant est un <w>ardent</w> défenseur des libertés publiques."
                        },
                        {
                            "text": "Elle lui a écrit une lettre remplie d'une <w>ardente</w> passion."
