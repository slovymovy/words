                ],
                "senses": [
                    {
                        "sense_id": "2f39d986-532f-3918-a515-1cb697a7da1f",
                        "entry_id": "77812f73-6536-3d17-a653-d6d64ec700b3",
                        "glosses": [
                            "зоол. маленький, преимущественно полевой и лесной грызун подобный мыши из подсемейства полёвковых, семейства хомяковых"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47d567a8-64c7-4010-9b92-76abd2e0dda7",
                                "sense_id": "2f39d986-532f-3918-a515-1cb697a7da1f",
                                "text": "От прочих мышевидных грызунов все полёвки отличаются очень коротким, не превышающим половины длины тела хвостом, покрытым волосами."
                            },
                            {
                                "example_id": "3d6a49e4-0987-4e49-95fb-24426b4868b6",
                                "sense_id": "2f39d986-532f-3918-a515-1cb697a7da1f",
                                "text": "Рыжая полёвка различает жёлтый и красный цвета, ведь ей надо отличать спелые плоды и зёрна от недозрелых."
                            }
                        ]
                    },
                    {
                        "sense_id": "3726031c-440c-3570-afda-a102391800e8",
                        "entry_id": "77812f73-6536-3d17-a653-d6d64ec700b3",
                        "glosses": [
                            "ботан. сорное растение семейства крестоцветных"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1d785a98-df64-375b-ba8a-efd3c0d4011c",
                        "entry_id": "77812f73-6536-3d17-a653-d6d64ec700b3",
                        "glosses": [
                            "ботан. род грибов семейства больбитиевых"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "050f27f9-b7e9-4e00-bc6a-01b5c04ffcbf",
                        "source_entry_id": "77812f73-6536-3d17-a653-d6d64ec700b3",
                        "source_sense_description": "грызун",
                        "target_lang_word": "vole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b700e94-2e14-3e59-b792-52619cc2f58b",
                                        "entry_id": "3f4a9ded-0750-3744-b797-42ef3d449398",
                                        "glosses": [
                                            "Any of a large number of species of small rodents of the tribes Arvicolini, Ellobiusini, Clethrionomyini, Pliomyini, Phenacomyini and Prometheomyini."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "vole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b39896e2-180f-3ffe-9e15-79a2644307d0",
                                        "entry_id": "b15ac8d1-4da4-3a47-a0a9-e013c0030a20",
                                        "glosses": [
                                            "A deal in a card game, écarté, that draws all the tricks."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5512f4e4-f2db-48b9-8ff9-6f15a2213aff",
                                                "sense_id": "b39896e2-180f-3ffe-9e15-79a2644307d0",
                                                "text": "Ladies, I'll venture for the vole."
                                            },
                                            {
                                                "example_id": "e1256f91-493d-4a5c-a6ed-9c57e48aa7ec",
                                                "sense_id": "b39896e2-180f-3ffe-9e15-79a2644307d0",
                                                "text": "With humble curate can I now retire,\n(While good Sir Peter boozes with the squire,)\nAnd at backgammon mortify my soul,\nThat pants for loo, or flutters at a vole?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "73596604-a2c1-3c48-97c6-0a055a3ebc39",
                                        "entry_id": "3d7f120c-99c4-3fc8-8d7a-baa2218cd7c3",
                                        "glosses": [
                                            "To win all the tricks by a vole."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8495d5c-dbb8-4abf-8d93-f1451bbd93f4",
                                                "sense_id": "73596604-a2c1-3c48-97c6-0a055a3ebc39",
                                                "text": "no lad shall chuck, or lady vole, But some excising Courtier will have toll."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01538624-a33b-42c4-82f0-5619cb6ebbc5",
                        "source_entry_id": "77812f73-6536-3d17-a653-d6d64ec700b3",
                        "source_sense_description": "грызун",
                        "target_lang_word": "Wühlmaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wühlmaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fa154e7-09f1-38b9-8eae-fa8e0911f9c9",
                                        "entry_id": "767b1538-8d6e-3f60-9075-6a296c13ddc3",
                                        "glosses": [
                                            "kleines, plumpes, kurzschwänziges Nagetier innerhalb der Unterfamilie der Wühler, mit dickem Kopf, kurzen Ohren und stumpfer Schnauze, das in Europa, Asien und Nordamerika verbreitet ist und unter der Erde Gänge wühlt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae61812-0761-49b2-9ef1-f19454e086e8",
                                                "sense_id": "6fa154e7-09f1-38b9-8eae-fa8e0911f9c9",
                                                "text": "„Wühlmäuse markieren ihr Revier durch Kot und Urin und reagieren echt sauer, wenn eine andere Wühlmaus in die Nähe kommt.“"
                                            },
                                            {
                                                "example_id": "b3f51a38-4e03-4624-95fb-8b7e73d0b8b1",
                                                "sense_id": "6fa154e7-09f1-38b9-8eae-fa8e0911f9c9",
                                                "text": "„Wenn die Frühlingssonne die Erde vom Frost befreit, machen sich Maulwurf und Wühlmaus bereit.“"
                                            },
                                            {
                                                "example_id": "b01ad8f5-8a1c-4e19-8980-34312056697c",
                                                "sense_id": "6fa154e7-09f1-38b9-8eae-fa8e0911f9c9",
                                                "text": "„Die Wühlmaus frisst in einer Woche das Sechsfache ihres Körpergewichts, während das Nashorn nur ein Drittel seines Gewichts als Grünfutter aufnimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ff211c4-bae4-33b6-8437-8f3bdcd40d1a",
                                        "entry_id": "767b1538-8d6e-3f60-9075-6a296c13ddc3",
                                        "glosses": [
                                            "artenreiche Unterfamilie der Wühler"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43dd3fd7-e5ab-47ad-9773-4d62fa9c330a",
                                                "sense_id": "6ff211c4-bae4-33b6-8437-8f3bdcd40d1a",
                                                "text": "„Unter Gartenfreunden wird sie schlicht Wühlmaus genannt, obwohl die Feldmaus auch zur Familie der Wühlmäuse gehört. Biologisch korrekt heißt sie Ostschermaus (Arvicola terrestris). Sie ist ein Gartenschädling allerersten Ranges.“"
                                            },
                                            {
                                                "example_id": "8e2ea0b6-d607-4a3f-b40e-3d585b7f5adf",
                                                "sense_id": "6ff211c4-bae4-33b6-8437-8f3bdcd40d1a",
                                                "text": "„Sie [die Bisamratte] gehört nicht zu den Ratten, sondern zu den Wühlmäusen, die aber auch keine Echten Mäuse sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "de5ee417-0401-3d2d-afcd-3803206ccf75",
                                        "entry_id": "767b1538-8d6e-3f60-9075-6a296c13ddc3",
                                        "glosses": [
                                            "Person, die im Verborgenen feindselig handelt"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
