                ],
                "senses": [
                    {
                        "sense_id": "ca800a1a-c16d-309e-8fd8-437ac17b4d18",
                        "entry_id": "4a8292d8-39f0-3dad-82a1-13215595755a",
                        "glosses": [
                            "Tagung, auf der sich Gewerkschaftsmitglieder treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9495d6b1-5bb7-486c-9dd5-f0edc159f2ce",
                                "sense_id": "ca800a1a-c16d-309e-8fd8-437ac17b4d18",
                                "text": "„Die GEW bekräftigte auf ihrer Gewerkschaftstagung nochmals ihre Position, an der integrierten Gesamtschule festhalten zu wollen.“"
                            },
                            {
                                "example_id": "0ca8f6d5-24fd-43f3-94d0-6820ad2c42f3",
                                "sense_id": "ca800a1a-c16d-309e-8fd8-437ac17b4d18",
                                "text": "„Die Verantwortung für mögliche Behinderungen im Bahnreiseverkehr zur Expo-Stadt Hannover liege bei der Deutschen Bahn AG, sagte GdED-Chef Norbert Hansen am Rande einer Gewerkschaftstagung in Magdeburg.“"
                            },
                            {
                                "example_id": "f5639c4f-905c-4036-b369-566d813fae30",
                                "sense_id": "ca800a1a-c16d-309e-8fd8-437ac17b4d18",
                                "text": "„Über die Gründe dafür war man sich bei der Gewerkschaftstagung schnell einig: Aktuell gibt es weniger Einnahmen auf Grund der rot-grünen Steuerreform.“"
                            },
                            {
                                "example_id": "f9e4f448-6567-429c-a109-a260a5eb6627",
                                "sense_id": "ca800a1a-c16d-309e-8fd8-437ac17b4d18",
                                "text": "„IG-Metall-Vizechef Berthold Huber sagte auf einer Gewerkschaftstagung in Hagen, die Arbeitgeber hätten auf die Forderungen der Gewerkschaft bisher ‚mit einem Wirrwarr aus fragwürdigen Argumenten, Fehlinformationen und teilweise widersprüchlichen Gegenforderungen‘ reagiert.“"
                            },
                            {
                                "example_id": "c743c1e4-f5a2-4999-a57c-fe4e7bf02026",
                                "sense_id": "ca800a1a-c16d-309e-8fd8-437ac17b4d18",
                                "text": "„Schon 1977 bei der Internationalen Sozialistischen Gewerkschaftstagung in Oslo sprach die österreichische Delegation von einem wichtigen Teilerfolg der Gleichstellung, die in vielen Betrieben bereits bestehe, und dass sie damit rechne, dass dies in wenigen Jahren in allen Betrieben der Fall sein werde.“"
                            },
                            {
                                "example_id": "0a07bd86-6de2-4ff8-815c-2582385eb826",
                                "sense_id": "ca800a1a-c16d-309e-8fd8-437ac17b4d18",
                                "text": "„Einmal äußerte sich bei einer Gewerkschaftstagung ein hochrangiger Funktionär abfällig über die Volkspartei.“"
                            },
                            {
                                "example_id": "6123d20d-5f64-43d2-a678-199a213a0c9a",
                                "sense_id": "ca800a1a-c16d-309e-8fd8-437ac17b4d18",
                                "text": "„Im April berichtet Res Strehle über eine grosse Gewerkschaftstagung zu neuen Personalinformationssystemen in Konzernen.“"
                            },
                            {
                                "example_id": "ecea74fd-9e35-4ace-956d-f068d362cbf8",
                                "sense_id": "ca800a1a-c16d-309e-8fd8-437ac17b4d18",
                                "text": "„Hintergrund dürfte ein heftiger Streit auf einer Gewerkschaftstagung im Burgenland gewesen sein.“"
                            },
                            {
                                "example_id": "2a35bf1c-5f2e-4dee-a976-8f3e7747451e",
                                "sense_id": "ca800a1a-c16d-309e-8fd8-437ac17b4d18",
                                "text": "„Auf der nächsten Gewerkschaftstagung vom 6. bis 8. Mai in Ingelheim stehen Vorstandswahlen an.“"
                            },
                            {
                                "example_id": "0108a497-251a-4bcc-973c-132369644e3b",
                                "sense_id": "ca800a1a-c16d-309e-8fd8-437ac17b4d18",
                                "text": "„Mit 90,1% der Delegiertenstimmen wählt der Gewerkschaftstag der IG Metall den bisherigen zweiten Vorsitzenden Klaus Zwickel zum Nachfolger des zurückgetretenen Franz Steinkühler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
