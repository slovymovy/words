                    {
                        "sense_id": "2b562977-f9be-3b73-96a5-cd9e05355429",
                        "entry_id": "de5913af-cc1f-32df-8789-4e9a2b8e9ef6",
                        "glosses": [
                            "Bühnenstück, das in vier Akten aufgeführt wird"
                        ],
                        "tags": [
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "6fb411cd-8b55-4757-9ae0-7f4047071a72",
                                "sense_id": "2b562977-f9be-3b73-96a5-cd9e05355429",
                                "text": "„Der knapp dreistündige Vierakter, der auf eine Anregung von Hermann Hesse zurückgeht, wurde 1943, mitten im Bombenhagel des Weltkriegs, an der Staatsoper in Berlin uraufgeführt.“"
                            },
                            {
                                "example_id": "ef6d2a62-80fb-45e7-8bd0-5b4368a6162d",
                                "sense_id": "2b562977-f9be-3b73-96a5-cd9e05355429",
                                "text": "„Ein hochdramatischer Vierakter voll leidenschaftlicher Arien, der zu allem Überfluss auch noch in Venedig spielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
