        "fr-extract.jsonl": [
            {
                "entry_id": "e985d6d0-72aa-3f55-b8ef-f8dc38b8e4e2",
                "word": "précautionneusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                        "entry_id": "e985d6d0-72aa-3f55-b8ef-f8dc38b8e4e2",
                        "glosses": [
                            "D'une façon précautionneuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5cb9862-7f1c-4254-8055-d788e770c966",
                                "sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                                "text": "Eugène marchait précautionneusement."
                            },
                            {
                                "example_id": "61a9ee1a-3b17-4b5d-81f9-ce485c5bd0f2",
                                "sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                                "text": "La double feuille remue entre les doigts qui la tiennent précautionneusement, — comme une colombe dans l’espace."
                            },
                            {
                                "example_id": "5b85ced9-77d1-46fa-b862-a16d38e5f236",
                                "sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                                "text": "Je regagnai l’appartement sans autre rencontre inopportune et me précipitai dans le salon, posant le sac sur le canapé et le dézippant précautionneusement."
                            },
                            {
                                "example_id": "04e709f7-501e-4907-bc7e-e5d07b00ccc7",
                                "sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                                "text": "On tourne les pages précautionneusement, avec une lenteur révélatrice : il s’agit moins d’absorber le contenu que de profiter au mieux du contenant."
                            },
                            {
                                "example_id": "919862ac-dcf9-4eaa-b68f-cb3cc82667e7",
                                "sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                                "text": "Il ne s’agissait pas de vaincre les montagnes mais de les arpenter : les gravir, y ramper, les descendre précautionneusement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c45e69d2-4da9-4663-a30a-7405b316e94e",
                        "source_entry_id": "e985d6d0-72aa-3f55-b8ef-f8dc38b8e4e2",
                        "source_sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                        "target_lang_word": "carefully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carefully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "Sorrowfully."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d576e34d-ceea-469a-92fe-9644ec612b52",
                                                "sense_id": "1f203a39-4e20-3abc-862c-ed791224790b",
                                                "text": "[…] there was she faine / To call them all in order to her ayde, / And them conjure, upon eternall paine, / To counsell her, so carefully dismayd, / How she might heale her sonne […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "With care; attentively, circumspectly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12f86b6-398b-4efc-8ec2-a7c8fde00a7b",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "As he was a politician, he discussed all subjects carefully, not offending anyone."
                                            },
                                            {
                                                "example_id": "44d6896b-126b-4311-8dd1-6153bab77d62",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "He carefully studied the papers, while planning his next move."
                                            },
                                            {
                                                "example_id": "e910d059-3f2c-4dd6-9a4a-871e8e7a1de1",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "He carefully avoided the subject all evening."
                                            },
                                            {
                                                "example_id": "6a2cba9f-d721-4c60-9a4e-db2d04a144f6",
                                                "sense_id": "deddb613-3268-34db-9360-aa99905c4099",
                                                "text": "Then his sallow face brightened, for the hall had been carefully furnished, and was very clean. ¶ There was a neat hat-and-umbrella stand, and the stranger's weary feet fell soft on a good, serviceable dark-red drugget, which matched in colour the flock-paper on the walls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae99e69-97d0-3703-bec2-85db2d0e75a0",
                                        "entry_id": "d4b7ccc1-20cb-3f1c-8ba2-8e5a3e5d1a96",
                                        "glosses": [
                                            "Conscientiously, painstakingly, fastidiously, meticulously"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3d5731a-5233-4088-800f-94e828ea2ca0",
                        "source_entry_id": "e985d6d0-72aa-3f55-b8ef-f8dc38b8e4e2",
                        "source_sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                        "target_lang_word": "cautiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cautiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c4675e0-f784-35f6-a5f2-3880332fe94b",
                                        "entry_id": "6842ea92-fd0e-3179-b1e0-1205029ca1c8",
                                        "glosses": [
                                            "In a cautious manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba7991e-9e6b-4b5c-8560-aa06cb982b74",
                                                "sense_id": "1c4675e0-f784-35f6-a5f2-3880332fe94b",
                                                "text": "He said cautiously, \"I do not think it right, Imperator.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38a1f7c2-7893-49ff-a5f5-0d506d9c4375",
                        "source_entry_id": "e985d6d0-72aa-3f55-b8ef-f8dc38b8e4e2",
                        "source_sense_id": "40ff04fa-839c-341e-99a2-a5cee624c525",
                        "target_lang_word": "gingerly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gingerly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea80039a-7967-3b13-baab-87e19170d4da",
                                        "entry_id": "05f2b93c-f1b9-3ab7-8056-32c29036ed97",
                                        "glosses": [
                                            "In a cautious and delicate manner; (very) carefully or cautiously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa31030-dc2c-4b96-8499-f327c112fcf4",
                                                "sense_id": "ea80039a-7967-3b13-baab-87e19170d4da",
                                                "text": "He placed the glass jar gingerly on the concrete step."
                                            },
                                            {
                                                "example_id": "33302f3c-18fb-4683-b8ac-1031c7fc7c93",
                                                "sense_id": "ea80039a-7967-3b13-baab-87e19170d4da",
                                                "text": "In an other corner, Mistris Minx, a marchants wife, that will eate no cherries, forsooth, but when they are at twentie shillings a pound, that lookes as simperingly as if she were besmeard, and iets it as gingerly as if she were dancing the canaries, […]"
                                            },
                                            {
                                                "example_id": "6bcfe6e2-a4f9-4d62-bf2e-394b8cbe1d09",
                                                "sense_id": "ea80039a-7967-3b13-baab-87e19170d4da",
                                                "text": "[E]nter you the chambers peaceably, locke the dores gingerly, looke vpon your vviues wofully, but vpon the euill-doers, moſt vvickedly."
                                            },
                                            {
                                                "example_id": "74bbd200-df07-4d85-8120-f58531b6dc4e",
                                                "sense_id": "ea80039a-7967-3b13-baab-87e19170d4da",
                                                "text": "Prithee, gentle officer, / Handle me gingerly, or I fall to pieces, / Before I can plead mine."
                                            },
                                            {
                                                "example_id": "02592be9-003d-42a6-9217-d9cfb8f4708d",
                                                "sense_id": "ea80039a-7967-3b13-baab-87e19170d4da",
                                                "text": "[…] Sir W. Pen made a formal speech in answer to a question of the King's, whether the lying of the sunk ships in the river would spoil the river. But, Lord! how gingerly he answered it, and with a deal of do that he did not know whether it would be safe as to the enemy to have them taken up, but that doubtless it would be better for the river to have them taken up."
                                            },
                                            {
                                                "example_id": "c7a4750d-eec1-4077-85f9-71bd0b2b5066",
                                                "sense_id": "ea80039a-7967-3b13-baab-87e19170d4da",
                                                "text": "My mother was going very gingerly in the dark along the paſſage which led to the parlour, as my uncle Toby pronounced the word wife."
                                            },
                                            {
                                                "example_id": "61c86f89-1c7d-49bd-850f-6cb5db96e379",
                                                "sense_id": "ea80039a-7967-3b13-baab-87e19170d4da",
                                                "text": "Then of a sudden the rope was still—the stone had caught at the very edge. Gingerly the ape-man clambered up the frail rope."
                                            },
                                            {
                                                "example_id": "cb609bfd-259b-4550-9525-6fecc6a2a6be",
                                                "sense_id": "ea80039a-7967-3b13-baab-87e19170d4da",
                                                "text": "Purchasing a snowplow transforms Homer [Simpson] into a new man. Mr. Burns' laziest employee suddenly becomes an ambitious self-starter who buys ad time on local television at 3:17 A.M^([sic]) (prime viewing hours, Homer gingerly volunteers, for everyone from alcoholics to the unemployable to garden-variety angry loners) and makes a homemade commercial costarring his family."
                                            },
                                            {
                                                "example_id": "945f2947-f8ea-4dd2-a239-901a456d7b52",
                                                "sense_id": "ea80039a-7967-3b13-baab-87e19170d4da",
                                                "text": "[Martin Luther] King [Jr.] was later said to have been within a sneeze or a jolt of extinction. Were it not for the pair of cops who gingerly carried him from Blumstein’s department store and the pair of surgeons who performed lifesaving surgery at Harlem Hospital there would have been no \"I Have a Dream\" speech and likely no national holiday honoring him."
                                            },
                                            {
                                                "example_id": "b3dc9a7a-f9b4-4d95-825a-a3f4886c984a",
                                                "sense_id": "ea80039a-7967-3b13-baab-87e19170d4da",
                                                "text": "When we got there and went to our room he undressed and shut off the light as I was still doing so, and I got into bed gingerly, facing his turned back, and reached out to touch him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0465b483-dc75-3585-a5c3-2e8586f78e10",
                                        "entry_id": "05f2b93c-f1b9-3ab7-8056-32c29036ed97",
                                        "glosses": [
                                            "Chiefly of dancing or walking: done with small, dainty steps; daintily; also, with excessive delicacy; affectedly, mincingly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d500cdb-bf45-4b55-9ef4-9da6fc2b4baa",
                                                "sense_id": "0465b483-dc75-3585-a5c3-2e8586f78e10",
                                                "text": "Oh! ſhe lookes ſo ſugredly, ſo ſimpringly, ſo gingerly, ſo amarouſly, ſo amiably. […] [She] is ſuch an intycing ſhee-vvitch, carrying the charmes of your Ievvels about her. Oh!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gingerly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d52ff459-e43b-3812-9ba4-3502dfcd558f",
                                        "entry_id": "3efa91f7-a42e-39f7-a08d-4d11e9929e3f",
                                        "glosses": [
                                            "Often of movements: very careful, cautious, or delicate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa2fba58-38f5-4ced-9a16-244c57942d47",
                                                "sense_id": "d52ff459-e43b-3812-9ba4-3502dfcd558f",
                                                "text": "We can honestly commend the Atlantic Monthly as the most able and spirited of American periodicals, at the present time, and we like it, moreover, because it dares have opinions and to express them in unmistakable terms, on subjects which when referred to at all, by most of the current magazines, are mentioned in the gingerliest namby-pamby style of common place neutrality."
                                            },
                                            {
                                                "example_id": "d9e1eac4-1f09-4378-8eba-f566c0bae31e",
                                                "sense_id": "d52ff459-e43b-3812-9ba4-3502dfcd558f",
                                                "text": "But, ther's somethin' in the very look and voice of Jeems Strebling, even in his gingerly walk, that riles all the black drop in me."
                                            },
                                            {
                                                "example_id": "8f8d2d8e-91c4-4657-b570-4f29057275c8",
                                                "sense_id": "d52ff459-e43b-3812-9ba4-3502dfcd558f",
                                                "text": "[P]enetrating cautiously into dark cellars, sallying with gingerly tread to the garden, now leaf-strewn by the autumn winds, […]"
                                            },
                                            {
                                                "example_id": "2143b522-a441-4a3a-b8cd-17d092b1eb04",
                                                "sense_id": "d52ff459-e43b-3812-9ba4-3502dfcd558f",
                                                "text": "During the extra session there were few crimes in the decalogue of which we were not accused, and all because of our old-fashioned tariff views and our quaint, blunt way of expressing them. While this treatment had its toughening effects, none the less did the Landmark’s icy rebuke mortify and silence us. We return to the painful subject in the gingerliest way imaginable, our mood far from affirmative, but interrogatory from first to last."
                                            },
                                            {
                                                "example_id": "0cfb335e-f5f8-42bc-b135-85d79ac572d8",
                                                "sense_id": "d52ff459-e43b-3812-9ba4-3502dfcd558f",
                                                "text": "The down \"Atlantic Coast Express\", headed by Pacific No. 35020 Bibby Line, passes the scene of operations at a gingerly 10 m.p.h."
                                            },
                                            {
                                                "example_id": "f5602a16-1500-4488-9d91-13db0ac4999c",
                                                "sense_id": "d52ff459-e43b-3812-9ba4-3502dfcd558f",
                                                "text": "Several gingerly taps on her console fired clusters of modified probes into the maelstrom of the gas giant’s atmosphere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42dfa3b4-04c1-3213-a993-19cce3d8acdb",
                                        "entry_id": "3efa91f7-a42e-39f7-a08d-4d11e9929e3f",
                                        "glosses": [
                                            "Often of a person or the way they move: dainty, delicate; also, excessively delicate; affected, mincing."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a635d40-0b0b-49e9-a410-7b94fb2f8327",
                                                "sense_id": "42dfa3b4-04c1-3213-a993-19cce3d8acdb",
                                                "text": "All yᵉ rest of my trimmest, tricksiest, gingerliest ioyes, / But very tædious and most odious toyes?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33da0269-ef71-4220-ba77-c6bcef2cf48a",
                        "source_entry_id": "e985d6d0-72aa-3f55-b8ef-f8dc38b8e4e2",
