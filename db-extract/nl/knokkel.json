                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe00122d-45d2-4162-a3da-ff13f6df4da6",
                        "source_entry_id": "dd50cd92-32e8-39cb-83a5-338dc25fc69b",
                        "source_sense_id": "6ab3f9ab-6052-38ac-99dd-8ebe74507c78",
                        "source_sense_description": "vingergewricht",
                        "target_lang_word": "Knöchel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knöchel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4164fcb5-8009-3353-864e-e69b94f064aa",
                                        "entry_id": "ea015989-9a60-3fa2-b663-fca102d3dfbc",
                                        "glosses": [
                                            "vorspringender Knochen am Fußansatz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "867e1969-c4a9-4593-a1ba-4b443f2f0c26",
                                                "sense_id": "4164fcb5-8009-3353-864e-e69b94f064aa",
                                                "text": "Es ist hart, im Reisfeld zu arbeiten: den ganzen Tag gebückt, bis über die Knöchel im Wasser, dazu brennt die Sonne vom Himmel."
                                            },
                                            {
                                                "example_id": "c3435ddd-6597-4bb5-901c-a8c04b708679",
                                                "sense_id": "4164fcb5-8009-3353-864e-e69b94f064aa",
                                                "text": "Umknicken kann schmerzhaft sein: wenn im Knöchel die Bänder stark gedehnt werden oder gerissen sind kann man eine Zeitlang keinen Sport machen."
                                            },
                                            {
                                                "example_id": "50ac5a30-c6bd-4138-aca1-99269f20c53c",
                                                "sense_id": "4164fcb5-8009-3353-864e-e69b94f064aa",
                                                "text": "Die Polin Kowalczyk läuft mit gebrochenem Knöchel zu Gold."
                                            },
                                            {
                                                "example_id": "f8fc40d6-f19a-4529-b769-82975d02e23d",
                                                "sense_id": "4164fcb5-8009-3353-864e-e69b94f064aa",
                                                "text": "„Jetzt … wenn man genau schaut … auf dem rechten Knöchel kann man eine Tätowierung entdecken, und zwar sieht man da drei schwarze Striche, die nebeneinander liegen. Er hat 60 Tätowierungen.“"
                                            },
                                            {
                                                "example_id": "a545f203-e173-4c5d-91de-6897ca9e8e55",
                                                "sense_id": "4164fcb5-8009-3353-864e-e69b94f064aa",
                                                "text": "„Er liegt da und sieht zu ihr auf, seine Hände um ihre Knöchel gelegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8abd2362-4d75-3778-8229-39e125670721",
                                        "entry_id": "ea015989-9a60-3fa2-b663-fca102d3dfbc",
                                        "glosses": [
                                            "mittleres Fingergelenk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fa3d147-74bb-455d-b85a-7d4432b849b8",
                                                "sense_id": "8abd2362-4d75-3778-8229-39e125670721",
                                                "text": "Bei einer sehr gelungen Vorlesung klopfen die Studenten am Ende mit dem Knöchel auf die Tische."
                                            },
                                            {
                                                "example_id": "53bd1f0d-0e7b-47fc-aad2-a65cfa7936fe",
                                                "sense_id": "8abd2362-4d75-3778-8229-39e125670721",
                                                "text": "„Hanns Zellenka klopfte mit den Knöcheln anerkennend auf den Tisch.“"
                                            },
                                            {
                                                "example_id": "ea7bb8f2-de3e-4ab2-be54-c908162aee96",
                                                "sense_id": "8abd2362-4d75-3778-8229-39e125670721",
                                                "text": "„Die Mutter legte Kartoffel und Messer beiseite und umklammerte die Tischkante, dass die Knöchel weiß hervortraten.“"
                                            },
                                            {
                                                "example_id": "677e245f-978e-4fde-93ee-b3a7ef29cead",
                                                "sense_id": "8abd2362-4d75-3778-8229-39e125670721",
                                                "text": "„Lee Jay umklammerte die Lehne des Kirchenstuhls, bis seine Knöchel weiß waren.“"
                                            },
                                            {
                                                "example_id": "d6e4cf09-110d-422a-be55-9449a5de5b32",
                                                "sense_id": "8abd2362-4d75-3778-8229-39e125670721",
                                                "text": "„Elsa lehnt sich zurück und klopft mit den Knöcheln auf den Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3632ef5-dae3-4f39-a03c-31ad8c0a4dd9",
                        "source_entry_id": "dd50cd92-32e8-39cb-83a5-338dc25fc69b",
                        "source_sense_id": "6ab3f9ab-6052-38ac-99dd-8ebe74507c78",
                        "source_sense_description": "vingergewricht",
                        "target_lang_word": "Fingerknöchel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fingerknöchel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eede879d-cb79-3981-9b57-1506d445024b",
                                        "entry_id": "fb05382d-300a-378c-b774-22ae785c3b79",
                                        "glosses": [
                                            "mittleres Fingergelenk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "685c2bea-4137-40e3-b4f2-af146f8c1105",
                                                "sense_id": "eede879d-cb79-3981-9b57-1506d445024b",
                                                "text": "„Lisa kommt an uns vorbei, zwinkert und klopft kurz mit den Fingerknöcheln gegen die Tischplatte.“"
                                            },
                                            {
                                                "example_id": "49934d24-1825-4c12-914f-dfcfd51b1a01",
                                                "sense_id": "eede879d-cb79-3981-9b57-1506d445024b",
                                                "text": "„Sie verschränkte die Arme und sah zu, wie Hanns die Zigarette ausdrückte und seine Fingerknöchel verlegen knacken ließ.“"
                                            },
                                            {
                                                "example_id": "aa80e329-a66a-439b-8bf3-2f757bf9c823",
                                                "sense_id": "eede879d-cb79-3981-9b57-1506d445024b",
                                                "text": "„Miss Stein klopfte mit den Fingerknöcheln auf den Band.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cce1cbeb-ed72-401a-b0d8-52427ed21945",
                        "source_entry_id": "dd50cd92-32e8-39cb-83a5-338dc25fc69b",
