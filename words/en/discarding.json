                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "weggooiend",
                                "target_lang_sense_clarification": "actieve handeling van het wegwerpen"
                            },
                            {
                                "target_lang_word": "het wegdoen",
                                "target_lang_sense_clarification": "gerundiumvorm voor het proces van verwijderen"
