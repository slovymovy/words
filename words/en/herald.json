{
    "word_family": [
        "heraldry",
        "heraldic",
        "heraldically"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b9d0e93-ed39-37a5-a502-a8eebeedc4fa",
                    "sense_definition": "To proclaim or announce an event, often indicating that something is about to happen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "announcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blooming of cherry blossoms will <w>herald</w> the arrival of the new season.",
                            "target_lang_translations": {
                                "ru": "Цветение сакуры <w>предвестит</w> приход нового сезона."
                            }
                        },
                        {
                            "text": "A loud trumpet blast was used to <w>herald</w> the arrival of the royal procession.",
                            "target_lang_translations": {
                                "ru": "Громкий звук трубы использовался, чтобы <w>возвестить</w> о прибытии королевской процессии."
                            }
                        }
                    ],
                    "synonyms": [
                        "announce",
                        "proclaim",
                        "declare"
                    ],
                    "common_phrases": [
                        "herald the arrival",
                        "herald the dawn"
                    ],
                    "target_lang_definitions": {
                        "ru": "Провозглашать или объявлять о событии, часто указывая на то, что что-то вот-вот произойдет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвещать",
                                "target_lang_sense_clarification": "указывать на скорое наступление события"
                            },
                            {
                                "target_lang_word": "возвещать",
                                "target_lang_sense_clarification": "торжественно объявлять"
                            },
                            {
                                "target_lang_word": "провозглашать",
                                "target_lang_sense_clarification": "официально заявлять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04f6ec18-3077-3f95-b5fe-754dfcb9ac65",
                    "sense_definition": "To greet or acclaim something with great enthusiasm or public praise.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young director's debut film was <w>heralded</w> as a masterpiece by international critics.",
                            "target_lang_translations": {
                                "ru": "Дебютный фильм молодого режиссера был <w>провозглашен</w> шедевром международными критиками."
                            }
                        },
                        {
                            "text": "The new medical breakthrough was <w>heralded</w> as a major success for the research team.",
                            "target_lang_translations": {
                                "ru": "Новый прорыв в медицине был <w>встречен</w> как крупный успех исследовательской группы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "heralded as a success",
                        "widely heralded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приветствовать или превозносить что-либо с большим энтузиазмом или публичной похвалой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провозглашать",
                                "target_lang_sense_clarification": "объявлять кем-либо или чем-либо выдающимся"
                            },
                            {
                                "target_lang_word": "превозносить",
                                "target_lang_sense_clarification": "высоко оценивать публично"
                            },
                            {
                                "target_lang_word": "приветствовать",
                                "target_lang_sense_clarification": "одобрять с восторгом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22d596cd-0b0c-3129-933c-53d48aebcc85",
                    "sense_definition": "A person or thing that indicates or announces the coming of something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sign",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The first falling leaves are a <w>herald</w> of autumn's approach.",
                            "target_lang_translations": {
                                "ru": "Первые опадающие листья — это <w>предвестник</w> приближения осени."
                            }
                        },
                        {
                            "text": "Many people consider the singing of birds to be a <w>herald</w> of spring.",
                            "target_lang_translations": {
                                "ru": "Многие люди считают пение птиц <w>вестником</w> весны."
                            }
                        }
                    ],
                    "synonyms": [
                        "bode"
                    ],
                    "common_phrases": [
                        "herald of spring",
                        "herald of change"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, который указывает на приближение чего-либо или объявляет о нем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предвестник",
                                "target_lang_sense_clarification": "признак скорого наступления чего-либо"
                            },
                            {
                                "target_lang_word": "вестник",
                                "target_lang_sense_clarification": "тот, кто приносит новость о приближении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c29cbb99-dc5c-3636-ad64-bc23cfe12e9e",
                    "sense_definition": "A messenger, especially one bringing important news or official proclamations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "messenger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>herald</w> stood in the town square to read the king's latest decree.",
                            "target_lang_translations": {
                                "ru": "<w>Глашатай</w> стоял на городской площади, чтобы зачитать последний указ короля."
                            }
                        },
                        {
                            "text": "In ancient times, a <w>herald</w> would travel between cities to deliver urgent messages.",
                            "target_lang_translations": {
                                "ru": "В древние времена <w>вестник</w> путешествовал между городами, чтобы доставить срочные сообщения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "royal herald"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посланник, особенно приносящий важные новости или официальные прокламации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глашатай",
                                "target_lang_sense_clarification": "лицо, объявляющее народу указы"
                            },
                            {
                                "target_lang_word": "вестник",
                                "target_lang_sense_clarification": "человек, приносящий известия"
                            },
                            {
                                "target_lang_word": "герольд",
                                "target_lang_sense_clarification": "официальный вестник при дворе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad14805-58a9-3e58-b933-b77c1c005697",
                    "sense_definition": "An official whose speciality is heraldry, responsible for regulating coats of arms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>herald</w> at the College of Arms carefully documented the family's lineage.",
                            "target_lang_translations": {
                                "ru": "<w>Герольд</w> в Геральдической палате тщательно задокументировал родословную семьи."
                            }
                        },
                        {
                            "text": "Each <w>herald</w> wore a traditional tabard embroidered with the royal symbols.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>герольд</w> носил традиционную накидку-табард с вышитыми королевскими символами."
                            }
                        }
                    ],
                    "synonyms": [
                        "pursuivant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Должностное лицо, специализирующееся на геральдике и отвечающее за регулирование гербов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "герольд",
                                "target_lang_sense_clarification": "распорядитель и знаток гербов"
                            },
                            {
                                "target_lang_word": "герольдмейстер",
                                "target_lang_sense_clarification": "глава ведомства, ведающего гербами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5f11570-6e64-3053-a21e-bacad0063e70",
                    "sense_definition": "A handbill or small printed advertisement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "advertisement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The circus distributed a colorful <w>herald</w> to every house in the neighborhood.",
                            "target_lang_translations": {
                                "ru": "Цирк раздал красочные <w>рекламные листки</w> в каждый дом в округе."
                            }
                        },
                        {
                            "text": "The local theater printed a small <w>herald</w> to promote the upcoming play.",
                            "target_lang_translations": {
                                "ru": "Местный театр напечатал небольшую <w>афишку</w> для рекламы предстоящего спектакля."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern advertising"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Листовка или небольшое печатное рекламное объявление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекламный листок",
                                "target_lang_sense_clarification": "небольшая печатная реклама"
                            },
                            {
                                "target_lang_word": "афишка",
                                "target_lang_sense_clarification": "маленькое объявление о событии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0233a252-efad-3d92-9aea-b250657f13f5",
                    "sense_definition": "A specific species of moth known as Scoliopteryx libatrix.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "moth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>herald</w> is a distinctive moth that often hibernates in caves or outbuildings.",
                            "target_lang_translations": {
                                "ru": "<w>Зубчатокрылая совка</w> — это примечательная моль, которая часто зимует в пещерах или пристройках."
                            }
                        },
                        {
                            "text": "Entomologists identified the specimen as a <w>herald</w> due to its jagged wing edges.",
                            "target_lang_translations": {
                                "ru": "Энтомологи идентифицировали экземпляр как <w>совку-перловицу</w> из-за зазубренных краев крыльев."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный вид моли, известный как Scoliopteryx libatrix."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зубчатокрылая совка",
                                "target_lang_sense_clarification": "биологическое название вида"
                            },
                            {
                                "target_lang_word": "совка-перловица",
                                "target_lang_sense_clarification": "обиходное название моли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f85907a6-4371-3892-aebe-be15f67492b5",
                    "sense_definition": "An alternative spelling of <w>hareld</w>, referring to a long-tailed duck.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bird",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>herald</w> is known for its striking plumage and long tail feathers.",
                            "target_lang_translations": {
                                "ru": "<w>Морянка</w> известна своим ярким оперением и длинными перьями хвоста."
                            }
                        },
                        {
                            "text": "Birdwatchers spotted a rare <w>herald</w> swimming near the northern coast.",
                            "target_lang_translations": {
                                "ru": "Орнитологи заметили редкую <w>морянку</w>, плавающую у северного побережья."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания слова hareld, обозначающего морянку (длиннохвостую утку)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морянка",
                                "target_lang_sense_clarification": "вид северной утки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "52c2be8a-9c62-3835-98d0-923d80c3f41a",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the philanthropist Mr. <w>Herald</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа мистера <w>Геральда</w>."
                            }
                        },
                        {
                            "text": "We invited the <w>Heralds</w> over for dinner last Saturday night.",
                            "target_lang_translations": {
                                "ru": "В прошлую субботу вечером мы пригласили <w>Геральдов</w> на ужин."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Геральд",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "550bc56d-3590-3e6b-ae5c-32e322652ba2",
                    "sense_definition": "A census-designated place in Sacramento County, California, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small community of <w>Herald</w> is located in the rural part of the county.",
                            "target_lang_translations": {
                                "ru": "Небольшая община <w>Геральд</w> расположена в сельской части округа."
                            }
                        },
                        {
                            "text": "Driving through <w>Herald</w>, one can see many beautiful vineyards and farms.",
                            "target_lang_translations": {
                                "ru": "Проезжая через <w>Геральд</w>, можно увидеть много красивых виноградников и ферм."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to California, USA"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Статистически обособленная местность в округе Сакраменто, Калифорния, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Геральд",
                                "target_lang_sense_clarification": "название населенного пункта"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}