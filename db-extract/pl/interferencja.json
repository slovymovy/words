                        "cross_references": [
                            {
                                "target_word": "interference",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4404eae4-22bd-3961-b111-7f1ad52a84de",
                                        "entry_id": "5fe2bb20-6384-33ab-a10b-c953cef34160",
                                        "glosses": [
                                            "The act of interfering with something, or something that interferes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc19d40b-70c6-434f-a3f6-7665283e69ad",
                                                "sense_id": "4404eae4-22bd-3961-b111-7f1ad52a84de",
                                                "text": "Somewhat impeded by constant political interference of one sort or another, British Railways are nevertheless pressing ahead with a mammoth modernisation programme; [...]"
                                            },
                                            {
                                                "example_id": "b3587948-ba86-4d7f-8b94-7d629778fa08",
                                                "sense_id": "4404eae4-22bd-3961-b111-7f1ad52a84de",
                                                "text": "\"With magic in limited use and hidden, it was possible to enhance the various magic resistances of humans, and to keep certain forms of magic from being possible. If magic enters common usage, this interference becomes infeasible.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc6229ea-bdba-3dfc-abbd-157987dd3f64",
                                        "entry_id": "5fe2bb20-6384-33ab-a10b-c953cef34160",
                                        "glosses": [
                                            "The illegal obstruction of an opponent in some ball games."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c26131f-7a85-4f12-91b8-2081af68cf79",
                                                "sense_id": "fc6229ea-bdba-3dfc-abbd-157987dd3f64",
                                                "text": "They were glued to the TV, as the referee called out a fifteen yard penalty for interference."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c21258f3-e13b-3324-bfa0-bf4f2803741e",
                                        "entry_id": "5fe2bb20-6384-33ab-a10b-c953cef34160",
                                        "glosses": [
                                            "An effect caused by the superposition of two systems of waves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aefcb26a-f4c1-36a7-8392-4cbd9869e24d",
                                        "entry_id": "5fe2bb20-6384-33ab-a10b-c953cef34160",
                                        "glosses": [
                                            "A distortion on a broadcast signal due to atmospheric or other effects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c244279-c558-4600-92a4-eb00db38ba4a",
                                                "sense_id": "aefcb26a-f4c1-36a7-8392-4cbd9869e24d",
                                                "text": "They wanted to watch the game on TV, but there was too much interference to even make out the score on the tiny screen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a664085-cdb3-3175-b563-555020d48417",
                                        "entry_id": "5fe2bb20-6384-33ab-a10b-c953cef34160",
                                        "glosses": [
                                            "In United States patent law, an inter partes proceeding to determine the priority issues of multiple patent applications; a priority contest."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cd5939a-9d6b-3411-b05f-f0b741690b57",
                                        "entry_id": "5fe2bb20-6384-33ab-a10b-c953cef34160",
                                        "glosses": [
                                            "The interruption of the line between an attacked piece and its defender by sacrificially interposing a piece."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9c22dd4f-404c-390a-a5c1-01b0c31c1b84",
                                        "entry_id": "5fe2bb20-6384-33ab-a10b-c953cef34160",
                                        "glosses": [
                                            "The situation where a person who knows two languages inappropriately transfers lexical items or structures from one to the other."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "interference",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fcfffac-1665-34fb-b1b1-3edf34f4e613",
                                        "entry_id": "43b6e185-215d-31be-aa4f-0fc8ce19ce4d",
                                        "glosses": [
                                            "To interfere."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42ad1479-a06c-4362-a3d3-03b66af49be3",
                                                "sense_id": "5fcfffac-1665-34fb-b1b1-3edf34f4e613",
                                                "text": "In economic terms, the two production processes can be simultaneously implemented without interferencing between themselves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32f2154e-7ba3-410f-9b8a-c4a1921a300c",
                        "source_entry_id": "4774f17b-f223-33d3-8d6a-46facf578944",
                        "source_sense_id": "9b2a56b2-b0c3-3abd-876c-0fcaf6c157ef",
                        "target_lang_word": "interférence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interférence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2457a143-b8b7-3715-8d0d-c43df7eb528b",
                                        "entry_id": "40df162c-d4ee-364b-a270-a60bbe19b649",
                                        "glosses": [
                                            "Phénomène dans lequel deux vibrations s’annulent en se superposant."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96339e05-76cc-426b-9189-5f881fa226b2",
                                                "sense_id": "2457a143-b8b7-3715-8d0d-c43df7eb528b",
                                                "text": "Il faut noter aussi que Newton, après avoir découvert le phénomène d’interférences qu'on nomme depuis lors «les anneaux de Newton» avait tenté une fort intéressante synthèse du point de vue des ondes et de celui des corpuscules […]."
                                            },
                                            {
                                                "example_id": "64405e24-6d46-4276-9b8e-298cf512b179",
                                                "sense_id": "2457a143-b8b7-3715-8d0d-c43df7eb528b",
                                                "text": "Deux vibrations mécaniques, par interférence, peuvent produire du repos. Le silence peut résulter de l’interférence de deux vibrations sonores. L’obscurité peut résulter de l’interférence de deux vibrations lumineuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07aa3b2c-a050-3810-9738-7caf59f939f5",
                                        "entry_id": "40df162c-d4ee-364b-a270-a60bbe19b649",
                                        "glosses": [
                                            "Phénomène résultant de la superposition d’au moins deux oscillations ou ondes cohérentes de même nature et de fréquences égales ou voisines; ce phénomène se manifeste par une variation dans l’espace ou dans le temps de l’amplitude de la résultante des ondes ou oscillations superposées."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66462c94-30b6-3f79-b17c-30ef9b243f97",
                                        "entry_id": "40df162c-d4ee-364b-a270-a60bbe19b649",
                                        "glosses": [
                                            "Intervention d’un élément extérieur dans un problème, une situation, un processus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82635698-80fd-4e75-b3c9-861c4f7af3f9",
                                                "sense_id": "66462c94-30b6-3f79-b17c-30ef9b243f97",
                                                "text": "Savez-vous que j'ai, moi, des devoirs envers la France et, qu’en vertu de ces devoirs, je ne puis admettre l’interférence d’aucune puissance étrangère dans l’exercice des pouvoirs français ?"
                                            },
                                            {
                                                "example_id": "d686f864-6fcb-42d1-91f6-6cf1b8cf9b37",
                                                "sense_id": "66462c94-30b6-3f79-b17c-30ef9b243f97",
                                                "text": "Pour nous, jusque là, l’interférence du religieux dans les questions féministes, c’était les courriers d’associations intégristes de lutte contre l’IVG que nous recevions dès que nous traitions du sujet !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
