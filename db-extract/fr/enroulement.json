                ],
                "senses": [
                    {
                        "sense_id": "e030bbb6-4afe-36ee-a4e0-f42a589a3c36",
                        "entry_id": "6d26d8b0-aa06-3717-8492-b0ae8cd667d1",
                        "glosses": [
                            "Action d’enrouler, de s’enrouler ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d381c238-9f12-4c11-8aaf-4e546ca63443",
                                "sense_id": "e030bbb6-4afe-36ee-a4e0-f42a589a3c36",
                                "text": "L’enroulement des feuilles dans le bourgeon."
                            },
                            {
                                "example_id": "0fc4e1f0-ecdc-439f-9534-25b08f5dd5c0",
                                "sense_id": "e030bbb6-4afe-36ee-a4e0-f42a589a3c36",
                                "text": "L’enroulement d’un lierre autour d’un arbre, d’un rinceau autour d’une colonne."
                            },
                            {
                                "example_id": "4812eef6-5e4e-4cab-883c-bf64a155765f",
                                "sense_id": "e030bbb6-4afe-36ee-a4e0-f42a589a3c36",
                                "text": "Les yeux perdus, elle continuait à regarder les murs de la chambre. Bien que la Souleiade datât du siècle dernier, on avait dû la remeubler sous le premier empire, car il y avait là, pour tenture, une ancienne indienne imprimée, représentant des bustes de sphinx, dans des enroulements de couronnes de chêne."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c9d7111-ebbf-3bc3-8a97-b8022516c88a",
                        "entry_id": "6d26d8b0-aa06-3717-8492-b0ae8cd667d1",
                        "glosses": [
                            "Bobinage électrique; l'ensemble des spires d´une bobine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f0465b2-b0bb-41ca-80d2-428a6ece10d3",
                                "sense_id": "5c9d7111-ebbf-3bc3-8a97-b8022516c88a",
                                "text": "Les électro-aimants inducteurs N, S, N, S, etc., sont pourvus d'un enroulement de fil unique, dont le sens alterne de l’un à l’autre; les noyaux de ces electros sont en fer doux ou en fonte; […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ca7f284-c7ee-4e64-89d5-2672962cad92",
