                ],
                "senses": [
                    {
                        "sense_id": "e9bb459d-dfe3-3460-ba0f-97ae95b4e92a",
                        "entry_id": "3b3cbac7-3631-3779-b0b5-365a8b7cdc1a",
                        "glosses": [
                            "(gerichtliches) Verfahren, in dem es um die Würde einer Person geht"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "79735c3e-a02b-4782-b660-7fb120e31b79",
                                "sense_id": "e9bb459d-dfe3-3460-ba0f-97ae95b4e92a",
                                "text": "„Jedenfalls war Dreyfus außer sich und scholt Levy vor versammelter Gemeinde einen Betrüger, womit ein eigentlicher Ehrprozess vor städtischer Instanz seinen Anfang nahm.“"
                            },
                            {
                                "example_id": "cc8c2c71-0721-44cf-aa1a-4856c65dc315",
                                "sense_id": "e9bb459d-dfe3-3460-ba0f-97ae95b4e92a",
                                "text": "„Er sei in einem Ehrprozess verurteilt worden, woraufhin er nach Basel zurückkehrte.“"
                            },
                            {
                                "example_id": "38ff5f65-d04c-412a-8427-749144f40089",
                                "sense_id": "e9bb459d-dfe3-3460-ba0f-97ae95b4e92a",
                                "text": "„Die Möglichkeiten, einen Ehrprozess anzustrengen, wurden radikal eingeschränkt.“"
                            },
                            {
                                "example_id": "ac89c295-37d4-4c34-b3cc-db00997fcd3d",
                                "sense_id": "e9bb459d-dfe3-3460-ba0f-97ae95b4e92a",
                                "text": "„Diese Konflikte wurden durchaus wortgewaltig ausgetragen und es kam zu einer Reihe von Ehrprozessen.“"
                            },
                            {
                                "example_id": "08ef08b5-e852-4c95-9691-976344509613",
                                "sense_id": "e9bb459d-dfe3-3460-ba0f-97ae95b4e92a",
                                "text": "„Wie KOLLMANN By Honor Bound, S. 163–165 jüngst gezeigt hat, war es bei Ehrprozessen die gängige Praxis der Zaren, im nachhinein die Strafe herabzusetzen und so zarische Gnade und Milde walten zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
