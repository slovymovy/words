                    "frequency": "Low",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze bestelden een hele <w>wagen</w> zand voor de nieuwe oprit.",
                            "target_lang_translations": {
