                                                "sense_id": "f2780a2c-73cd-37ed-a44d-e996fb0bfc77",
                                                "text": "This prediction, though somewhat obscure, is wonderfully adapt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a06e1b49-0123-499b-a597-cb98d87ef3d7",
                        "source_entry_id": "1ecd1876-d54e-3215-b428-c15f5901bbaa",
                        "source_sense_id": "9d73ab62-340b-3511-8242-7edee35c0805",
                        "target_lang_word": "adjust",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adjust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e415797-b1cd-3c71-99d9-203534d67b26",
                                        "entry_id": "9d442a1e-7d11-325d-a6bc-1dc4c530939b",
                                        "glosses": [
                                            "To modify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec5bfaf4-5fde-4bd2-b8a1-a78310d5fe09",
                                                "sense_id": "4e415797-b1cd-3c71-99d9-203534d67b26",
                                                "text": "Morimoto's recipes are adjusted to suit the American palate."
                                            },
                                            {
                                                "example_id": "61159477-f5a2-42ba-bf96-964183a79b06",
                                                "sense_id": "4e415797-b1cd-3c71-99d9-203534d67b26",
                                                "text": "As the world's drug habit shows, governments are failing in their quest to monitor every London window-box and Andean hillside for banned plants. But even that Sisyphean task looks easy next to the fight against synthetic drugs. No sooner has a drug been blacklisted than chemists adjust their recipe and start churning out a subtly different one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f914e9b3-b18f-3d28-b034-0a6c99007dbc",
                                        "entry_id": "9d442a1e-7d11-325d-a6bc-1dc4c530939b",
                                        "glosses": [
                                            "To improve or rectify."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50bd0a9d-2a7b-4004-a996-ca66c3999bdd",
                                                "sense_id": "f914e9b3-b18f-3d28-b034-0a6c99007dbc",
                                                "text": "He adjusted his initial conclusion to reflect the new data."
                                            },
                                            {
                                                "example_id": "97753889-c290-4308-a88f-bb7dc148e708",
                                                "sense_id": "f914e9b3-b18f-3d28-b034-0a6c99007dbc",
                                                "text": "But poverty’s scourge is fiercest below $1.25 (the average of the 15 poorest countries’ own poverty lines, measured in 2005 dollars and adjusted for differences in purchasing power): people below that level live lives that are poor, nasty, brutish and short."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc02fff-4c57-3c90-b3b9-2d30385383e6",
                                        "entry_id": "9d442a1e-7d11-325d-a6bc-1dc4c530939b",
                                        "glosses": [
                                            "To settle an insurance claim."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7666bdc4-ed09-3645-90ce-c1a6cbbb7e5f",
                                        "entry_id": "9d442a1e-7d11-325d-a6bc-1dc4c530939b",
                                        "glosses": [
                                            "To change to fit circumstances."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e14a94bf-da9b-4f66-9cdb-4ba9382d2af0",
                                                "sense_id": "7666bdc4-ed09-3645-90ce-c1a6cbbb7e5f",
                                                "text": "Most immigrants adjust quickly to a new community."
                                            },
                                            {
                                                "example_id": "5f8fd92c-2723-48dd-b65b-71b7cb3d767a",
                                                "sense_id": "7666bdc4-ed09-3645-90ce-c1a6cbbb7e5f",
                                                "text": "She waited for her eyes to adjust to the darkness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
