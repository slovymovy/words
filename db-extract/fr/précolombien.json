                                        "glosses": [
                                            "die Zeit vor der Entdeckung Amerikas durch Christoph Kolumbus betreffend, zu der Zeit gehörend, aus ihr stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de050fd3-a8b3-47c0-bcf6-c661c829ab83",
                                                "sense_id": "25c6dec0-c9c0-325b-82c4-3b92bdb45766",
                                                "text": "„Im Fundus des United States National Museum in Washington lagert eine vor knapp hundert Jahren entstandene Sammlung präkolumbischer Steinschleudern.“"
                                            }
