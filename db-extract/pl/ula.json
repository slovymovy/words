                        "examples": [
                            {
                                "example_id": "5f9e5c6d-aa57-4da4-8481-b1a08631e1e9",
                                "sense_id": "a8c4f0ea-2bb2-30a4-9155-0877e5133ca0",
                                "text": "Zapomniałem, że Ula się przeprowadziła, i wysłałem zaproszenie na jej stary adres."
                            },
                            {
                                "example_id": "49e84df6-6275-47e2-b919-47b026946954",
                                "sense_id": "a8c4f0ea-2bb2-30a4-9155-0877e5133ca0",
                                "text": "Ula, która przedtem postanawiała zataić wieczorne spotkanie z Zenkiem, mówi cicho: - Zenek ukradł dlatego, że był głodny"
                            }
                        ],
