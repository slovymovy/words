                    {
                        "sense_id": "3e926c9c-e52f-3ccf-b412-312c7465154f",
                        "entry_id": "b0ee39cf-a599-3c49-a409-20b95cc491a6",
                        "glosses": [
                            "Person, mit der man stark befreundet ist und der man seine tiefe Verbundenheit durch Vermischung von Blut ausdrückt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83b3ce06-cd5c-4bbb-bae6-238ece48ab4a",
                                "sense_id": "3e926c9c-e52f-3ccf-b412-312c7465154f",
                                "text": "„So schied sich Blutsfreund von dem Blutsfreund hier, sind voller Schmerz, nicht scherzen, lachen sie, die Träne beiden aus den Augen rinnt.“"
                            },
                            {
                                "example_id": "cfea24d4-4314-431a-9443-112636057cfc",
                                "sense_id": "3e926c9c-e52f-3ccf-b412-312c7465154f",
                                "text": "„Du bist doch ja mein Blutsfreund worden, Und hast's mit mir so wohl gemeint.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
