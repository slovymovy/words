                            "canonical"
                        ],
                        "form": "the Annunciation"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5558f7ac-ed23-3d72-81cd-365e65e05e86",
                        "entry_id": "6a9b6a91-e12d-3ce8-a3e2-5de5b7a6ff53",
                        "glosses": [
                            "The announcement by the archangel Gabriel to Mary that she would give birth to a son, namely Jesus. Celebrated on 25th March."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "316c2a9c-cd10-4e43-9103-384c2d1abcfe",
                        "source_entry_id": "6a9b6a91-e12d-3ce8-a3e2-5de5b7a6ff53",
                        "source_sense_id": "5558f7ac-ed23-3d72-81cd-365e65e05e86",
                        "source_sense_description": "Christianity: announcement by the archangel Gabriel that Mary would give birth to Jesus",
                        "target_lang_word": "Annonciation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Annonciation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e69ab93-e8b7-397b-94c8-604de5a458b7",
                                        "entry_id": "53c25751-83c4-357d-a4fd-922aea72cd94",
                                        "glosses": [
                                            "Fête de l’annonciation faite à Marie, le 25 mars."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2589a223-23b4-4cf1-82a9-6ff882257bd8",
                                                "sense_id": "1e69ab93-e8b7-397b-94c8-604de5a458b7",
                                                "text": "Lundi, c'était la grande fête de l’Annonciation, renvoyée du 25 mars, jour où, cette année, occurrait le Vendredi Saint, […]."
                                            },
                                            {
                                                "example_id": "d9442c89-d911-4ca5-b895-7785321a6f47",
                                                "sense_id": "1e69ab93-e8b7-397b-94c8-604de5a458b7",
                                                "text": "Parmi les douze grandes Fêtes de l’Église orthodoxe, quatre lui sont consacrées (sa Nativité, sa Présentation au Temple, l’Annonciation et sa Dormition), dont la première et la dernière des douze. Pareil symbolisme s'avère du plus haut intérêt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Annonciation",
                                "target_lang_code": "fr",
                                "target_senses": [
