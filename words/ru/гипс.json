{
    "word_family": [
        "гипсовый",
        "гипсовать",
        "гипсование"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "523b91ea-01e0-30f0-ab20-1c69bc55033d",
                    "sense_definition": "Минерал, используемый в строительстве и искусстве для создания скульптур и отделочных материалов.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скульптор сделал слепок из <w>гипса</w> для своей новой работы.",
                            "target_lang_translations": {
                                "en": "The sculptor made a mold out of <w>plaster</w> for his new work."
                            }
                        },
                        {
                            "text": "Для отделки потолка в комнате часто используют <w>гипс</w>.",
                            "target_lang_translations": {
                                "en": "For finishing the ceiling in a room, they often use <w>plaster</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "алебастр"
                    ],
                    "common_phrases": [
                        "скульптурный гипс",
                        "строительный гипс"
                    ],
                    "target_lang_definitions": {
                        "en": "A mineral used in construction and art for creating sculptures and finishing materials."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gypsum",
                                "target_lang_sense_clarification": "The raw mineral form used for industrial purposes."
                            },
                            {
                                "target_lang_word": "plaster",
                                "target_lang_sense_clarification": "The processed material used for coating walls, ceilings, or making casts."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe269138-c8eb-343c-8d57-fa88e5590410",
                    "sense_definition": "Медицинская повязка из затвердевшего материала, накладываемая на сломанную конечность.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач наложил <w>гипс</w> на сломанную ногу пациента.",
                            "target_lang_translations": {
                                "en": "The doctor put a <w>plaster cast</w> on the patient's broken leg."
                            }
                        },
                        {
                            "text": "Мне снимут <w>гипс</w> уже через неделю.",
                            "target_lang_translations": {
                                "en": "They will take my <w>cast</w> off in just a week."
                            }
                        }
                    ],
                    "synonyms": [
                        "гипсовая повязка"
                    ],
                    "common_phrases": [
                        "наложить гипс",
                        "снять гипс"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в разговорной речи вместо 'гипсовая повязка'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A medical cast made of hardened material applied to a broken limb."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "plaster cast",
                                "target_lang_sense_clarification": "A rigid medical support for a broken bone."
                            },
                            {
                                "target_lang_word": "cast",
                                "target_lang_sense_clarification": "Common term for a medical device used to immobilize a limb."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}