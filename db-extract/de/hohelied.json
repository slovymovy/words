                        "source_sense_description": "ein Buch des Alten Testaments, das aus einer Sammlung von Liebes- und Hochzeitsliedern besteht",
                        "target_lang_word": "Cantique des Cantiques",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
