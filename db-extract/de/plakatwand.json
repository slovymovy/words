                    },
                    {
                        "translation_id": "d1d60928-3bf4-4434-9dac-cefab1b5d1a8",
                        "source_entry_id": "895abac8-55ea-3614-ab38-569c8024fcbf",
                        "source_sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                        "target_lang_word": "panneau publicitaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panneau publicitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9db1d306-5c79-31e9-8cdd-cb4feed80a94",
                                        "entry_id": "9ab11934-13e4-3393-9d61-13a195df3fef",
                                        "glosses": [
                                            "Grand panneau destiné à recevoir une affiche publicitaire, généralement situé au bord d’une route."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5396ffb4-4f27-4117-af75-ae35f52c8745",
                                                "sense_id": "9db1d306-5c79-31e9-8cdd-cb4feed80a94",
                                                "text": "L'image de marque de l’agence immobilière en sortira grandie, parce que le bien visité sera plus beau, mais aussi parce que son panneau publicitaire comportera plus rapidement l’indication « vendu »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "861385cf-5041-4e51-a0cf-59dc2aa27c46",
                        "source_entry_id": "895abac8-55ea-3614-ab38-569c8024fcbf",
                        "source_sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                        "target_lang_word": "aanplakbord",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aanplakbord",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "eae90970-fd3f-3c8f-9e86-a13851306026",
                                        "entry_id": "39f16dc4-e307-361b-bdf8-5ef95f2b7c1a",
                                        "glosses": [
                                            "een bord in de openbare ruimte waarmee iemand, vaak een overheid, ruimte reserveert om biljetten op te plakken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "265670b2-2abb-47ba-9abb-429a7666b78d",
                                                "sense_id": "eae90970-fd3f-3c8f-9e86-a13851306026",
                                                "text": "Er staat een aanplakbord op de kade waar de bus stopt die een paar keer per dag naar het dorp rijdt."
                                            },
                                            {
                                                "example_id": "eff598c7-d0a3-4b48-9877-bc1b075486d5",
                                                "sense_id": "eae90970-fd3f-3c8f-9e86-a13851306026",
                                                "text": "In de nacht van vrijdag op zaterdag zijn 4 verkiezingsborden van D66 tussen de dorpen Hulsen en Hellendoorn (De Branderij, Collenstaartweg, Reggeweg) vernield. Ook de restanten van twee borden van de VVD liggen in de weilanden. Bovendien zijn zes van de zeven verkiezingsposters van een groot aanplakbord in Hulsen afgescheurd. Alleen de poster van Lokaal Hellendoorn bleef dit lot bespaard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
