                "senses": [
                    {
                        "sense_id": "d128ec2d-8fc5-34db-be1e-ed430c92c17d",
                        "entry_id": "8787a0b6-7f6b-3e7c-bf37-385672220c36",
                        "glosses": [
                            "die Untersuchung des Blutes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4f05114-4601-45b1-95c0-825a7bbd23fd",
                                "sense_id": "d128ec2d-8fc5-34db-be1e-ed430c92c17d",
                                "text": "Weil das Alkoholmessgerät bei Peter 0,6 Promille anzeigte, ordnete die Polizei eine Blutuntersuchung an."
                            },
                            {
                                "example_id": "2ed0d877-b4e6-4b6e-9ecc-255651064ee5",
                                "sense_id": "d128ec2d-8fc5-34db-be1e-ed430c92c17d",
                                "text": "„ Eine Blutuntersuchung als letzte Stufe ist schließlich nur verpflichtend, wenn sich der Verdacht der Beeinträchtigung durch Suchtgift bei der klinischen Untersuchung (Feststellung der Beeinträchtigung durch ein ärztliches Gutachten) durch einen berechtigten Arzt ergibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
