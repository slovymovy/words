{
    "word_family": [
        "cinematic",
        "cinematography",
        "cinematographer",
        "cinematize",
        "cinemagoer",
        "cinemaphile"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55badc21-9787-3792-9c71-48f06a52768a",
                    "sense_definition": "A building where movies are shown to an audience.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cinema</w> is right across the street from the restaurant.",
                            "target_lang_translations": {
                                "ru": "<w>Кинотеатр</w> находится прямо через дорогу от ресторана."
                            }
                        },
                        {
                            "text": "We are going to the <w>cinema</w> tonight to see the new action movie.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером мы идем в <w>кино</w> на новый боевик."
                            }
                        }
                    ],
                    "synonyms": [
                        "movie theater",
                        "movie theatre",
                        "moviehouse",
                        "movies",
                        "pictures"
                    ],
                    "common_phrases": [
                        "go to the cinema",
                        "local cinema",
                        "cinema screen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Здание, в котором зрителям показывают фильмы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кинотеатр",
                                "target_lang_sense_clarification": "здание или помещение для показа фильмов"
                            },
                            {
                                "target_lang_word": "кино",
                                "target_lang_sense_clarification": "разговорное обозначение места"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae77c62e-7469-33b3-bb4a-c4bd4f58b207",
                    "sense_definition": "The film and movie industry as a whole.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "industry_and_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the long history of Spanish <w>cinema</w>, many directors have won international awards.",
                            "target_lang_translations": {
                                "ru": "За долгую историю испанского <w>кинематографа</w> многие режиссеры получали международные награды."
                            }
                        },
                        {
                            "text": "The rise of streaming services has significantly changed the landscape of modern <w>cinema</w>.",
                            "target_lang_translations": {
                                "ru": "Появление стриминговых сервисов значительно изменило ландшафт современного <w>кино</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "world of cinema",
                        "history of cinema",
                        "national cinema"
                    ],
                    "target_lang_definitions": {
                        "ru": "Киноиндустрия и кинопроизводство в целом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кинематограф",
                                "target_lang_sense_clarification": "отрасль культуры и индустрии"
                            },
                            {
                                "target_lang_word": "кино",
                                "target_lang_sense_clarification": "сфера деятельности"
                            },
                            {
                                "target_lang_word": "кинематография",
                                "target_lang_sense_clarification": "совокупность отраслей, связанных с производством фильмов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4feda90f-9a01-3278-902b-f7330a2f316c",
                    "sense_definition": "The art or technique of making films; cinematography.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "industry_and_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Throughout the history of <w>cinema</w>, filmmakers have experimented with light and shadow.",
                            "target_lang_translations": {
                                "ru": "На протяжении всей истории <w>киноискусства</w> кинематографисты экспериментировали со светом и тенью."
                            }
                        },
                        {
                            "text": "He studied the art of <w>cinema</w> to understand how to tell stories visually.",
                            "target_lang_translations": {
                                "ru": "Он изучал искусство <w>кино</w>, чтобы понять, как рассказывать истории визуально."
                            }
                        }
                    ],
                    "synonyms": [
                        "seventh art"
                    ],
                    "common_phrases": [
                        "art of cinema",
                        "classic cinema"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусство или техника создания фильмов; кинопроизводство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "киноискусство",
                                "target_lang_sense_clarification": "создание фильмов как вид искусства"
                            },
                            {
                                "target_lang_word": "кинематограф",
                                "target_lang_sense_clarification": "искусство съемки и воспроизведения"
                            },
                            {
                                "target_lang_word": "кино",
                                "target_lang_sense_clarification": "вид искусства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a739390-6f82-3f71-bfdc-fc5d2960ad5b",
                    "sense_definition": "Films considered collectively as a medium or body of work.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "industry_and_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the critics, he produced excellent <w>cinema</w> that resonated with audiences.",
                            "target_lang_translations": {
                                "ru": "Несмотря на критику, он создавал превосходное <w>кино</w>, которое находило отклик у зрителей."
                            }
                        },
                        {
                            "text": "The festival celebrates independent <w>cinema</w> from all over the world.",
                            "target_lang_translations": {
                                "ru": "Фестиваль чествует независимый <w>кинематограф</w> со всего мира."
                            }
                        }
                    ],
                    "common_phrases": [
                        "independent cinema",
                        "contemporary cinema"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фильмы, рассматриваемые в совокупности как средство выражения или пласт работ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кино",
                                "target_lang_sense_clarification": "совокупность фильмов"
                            },
                            {
                                "target_lang_word": "кинематограф",
                                "target_lang_sense_clarification": "совокупность произведений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf2b1318-2979-37f2-9645-3f4c56ab4963",
                    "sense_definition": "A sophisticated or exemplary film, or any media or event that is considered a masterpiece.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That championship game was absolute <w>cinema</w> from start to finish.",
                            "target_lang_translations": {
                                "ru": "Тот финальный матч был настоящим <w>кино</w> от начала до конца."
                            }
                        },
                        {
                            "text": "The final scene of the play was pure <w>cinema</w> because of its emotional intensity.",
                            "target_lang_translations": {
                                "ru": "Финальная сцена пьесы была чистым <w>искусством</w> благодаря своей эмоциональной напряженности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "absolute cinema",
                        "pure cinema"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used to describe high-quality or dramatic moments in non-film contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изысканный или образцовый фильм, либо любое событие, считающееся шедевром."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кино",
                                "target_lang_sense_clarification": "в значении шедевра или зрелища"
                            },
                            {
                                "target_lang_word": "искусство",
                                "target_lang_sense_clarification": "в переносном смысле о высоком качестве"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}