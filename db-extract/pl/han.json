                        "glosses": [
                            "druga dynastia cesarska Chin, po dynastii Qin i przed Epoką Trzech Królestw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5eff877-53e8-45b3-9589-a5ae49e2aa3e",
                                "sense_id": "61ca387c-25fb-3178-963d-e691d4b2d661",
                                "text": "Wraz z rządami dynastii Han zapanowała atmosfera tolerancji dla wszystkich doktryn religijno-społecznych […]."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0da2aeec-12a3-4b23-acaf-447170adb11f",
                        "source_entry_id": "5df0c82d-6e80-3897-b095-f9b7a4baed37",
                        "source_sense_id": "61ca387c-25fb-3178-963d-e691d4b2d661",
