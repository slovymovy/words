                ],
                "senses": [
                    {
                        "sense_id": "8ed4ec39-ebe1-39e9-ae3e-b0e64aa39fa1",
                        "entry_id": "a4674d14-3f84-3167-a584-4dece266584f",
                        "glosses": [
                            "Écarter, écarquiller."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3f416a3e-f453-4597-8e2b-8a4cb0bddc49",
                                "sense_id": "8ed4ec39-ebe1-39e9-ae3e-b0e64aa39fa1",
                                "text": "Mais une douleur subitement revenait lui percuter le crâne; il écarquait avec angoisse ses paupières."
                            },
                            {
                                "example_id": "097bf0fc-21ff-4a7c-a230-29663761d41f",
                                "sense_id": "8ed4ec39-ebe1-39e9-ae3e-b0e64aa39fa1",
                                "text": "Elle l’écoutait sans rien dire, les sourcils écarqués, gagnée par les songeries mauvaises."
                            },
                            {
                                "example_id": "c8fa955a-1925-4d51-a247-af211ef735d7",
                                "sense_id": "8ed4ec39-ebe1-39e9-ae3e-b0e64aa39fa1",
                                "text": "Aux voûtes qui, par places, surplombent la dévastation, des nervures continuent d’accrocher leurs arêtes, pareilles aux vertèbres de quelque squelette morcelé; et de hautes baies déchiquetées, taillées par le temps dans l’arc régulier des fenêtres, s’écarquent toujours comme des yeux de pierre sur les amas de rocs qui bordent le défilé."
                            },
                            {
                                "example_id": "00aeed3b-09f1-404b-95b4-7585f572a03e",
                                "sense_id": "8ed4ec39-ebe1-39e9-ae3e-b0e64aa39fa1",
                                "text": "Mon cœur Est comme une poule qui s’écarque dans la poussière !"
                            }
                        ]
                    }
                ],
