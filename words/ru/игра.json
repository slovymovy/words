                },
                {
                    "sense_id": "ce1f1259-938a-307a-9c4b-dc0875c87700",
                    "sense_definition": "Отдельное спортивное состязание, матч или партия между соперниками.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вчерашняя <w>игра</w> закончилась с разгромным счётом.",
                            "target_lang_translations": {
                                "en": "Yesterday's <w>game</w> ended with a crushing score.",
                                "zh": "昨天的<w>比赛</w>以大比分结束了。"
                            }
                        },
                        {
                            "text": "Мы купили билеты на финальную <w>игру</w> сезона.",
                            "target_lang_translations": {
                                "en": "We bought tickets for the final <w>game</w> of the season.",
                                "zh": "我们买了本赛季决赛那场<w>比赛</w>的门票。"
                            }
