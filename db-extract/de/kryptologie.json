                ],
                "senses": [
                    {
                        "sense_id": "b503e169-dc9f-3140-87c8-81e021067eb8",
                        "entry_id": "fd485ebd-cb4d-31e1-81df-447c14fbf114",
                        "glosses": [
                            "Wissenschaft, die sich mit technischen Verfahren der Verschlüsselung beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5b5ec10-33b1-44ba-b2ea-11b14bb66495",
                                "sense_id": "b503e169-dc9f-3140-87c8-81e021067eb8",
                                "text": "Die Kryptologie lässt sich in die beiden Gebiete Kryptographie (modernere Schreibweise auch: „Kryptografie“) und Kryptoanalyse (modernere Schreibweise auch: „Kryptanalyse“) unterteilen."
                            },
                            {
                                "example_id": "762d1515-4e9c-45a2-9c6c-a20e373e9fbc",
                                "sense_id": "b503e169-dc9f-3140-87c8-81e021067eb8",
                                "text": "Vielmehr werden die Begriffe Kryptologie und Kryptographie gelegentlich vielleicht auch aus Unwissenheit oder Bequemlichkeit zuweilen gleichberechtigt verwendet."
                            },
                            {
                                "example_id": "f8c5be0a-9489-4c2c-af8a-6e6c3c34da7c",
                                "sense_id": "b503e169-dc9f-3140-87c8-81e021067eb8",
                                "text": "„Weil der Tierkreismörder allenfalls über laienhafte Kenntnisse der Kryptologie verfügt haben dürfte, sieht Autor Schmeh hier eine der Grundregeln des klandestinen Gewerbes bestätigt: »Profis sind berechenbar, die Amateure sind wirklich gefährlich«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "481d31f4-b874-4c30-b4a6-e57ba5deefdc",
                        "source_entry_id": "fd485ebd-cb4d-31e1-81df-447c14fbf114",
                        "source_sense_id": "b503e169-dc9f-3140-87c8-81e021067eb8",
                        "source_sense_description": "Wissenschaft, die sich mit technischen Verfahren der Verschlüsselung beschäftigt",
                        "target_lang_word": "cryptology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cryptology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43ed0a61-e616-3b54-86ad-1c7f5924d947",
                                        "entry_id": "63490262-fef0-3307-876d-b7545e356841",
                                        "glosses": [
                                            "The science or study of mathematical, linguistic, and other coding patterns and histories."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86c0938f-cbd5-49ce-8333-8b0d68c9a03f",
                                                "sense_id": "43ed0a61-e616-3b54-86ad-1c7f5924d947",
                                                "text": "Meronyms: cryptography, cryptanalysis; encoding, decoding; encrypting, decrypting, decyphering"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26fe3b22-18d3-371f-a29d-2e65ca93fc06",
                                        "entry_id": "63490262-fef0-3307-876d-b7545e356841",
                                        "glosses": [
                                            "The practice of analysing encoded messages, in order to decode them."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a85adcf-0e04-4948-87d7-6d38c19e5558",
                                                "sense_id": "26fe3b22-18d3-371f-a29d-2e65ca93fc06",
                                                "text": "Near-synonyms: cryptanalysis, decoding, decrypting, decyphering"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9d3b28b-ea22-3c34-8962-4e747a73918d",
                                        "entry_id": "63490262-fef0-3307-876d-b7545e356841",
                                        "glosses": [
                                            "Secret or enigmatical language."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "722838bc-a3da-4b2b-837d-6c284405926e",
                                                "sense_id": "a9d3b28b-ea22-3c34-8962-4e747a73918d",
                                                "text": "But the question of speech-play causes confusion to the slang researcher because this subject borders on family slang, private lingo, secret language, cryptologies, disguised language of children and grown-ups"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
