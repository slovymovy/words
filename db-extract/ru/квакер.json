                        "entry_id": "c3b26b43-c45c-37d3-aa88-9cc5fbfca692",
                        "glosses": [
                            "предполагаемый источник неизвестных подводных звуковых колебаний низкочастотного диапазона, иногда фиксируемых эхолокационными установками морских судов"
                        ],
