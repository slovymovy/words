                            "form-of"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6e9e00c8-0bef-337a-a801-400094aa7710",
                        "entry_id": "835375ca-d54f-3494-8a43-ed954e5a59aa",
                        "glosses": [
                            "Troisième personne du singulier du présent du subjonctif de durer."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "61bd411f-788c-4f37-bb61-0f4194d313ff",
                                "sense_id": "6e9e00c8-0bef-337a-a801-400094aa7710",
                                "text": "Moi, j’aime que l’effet waouh dure, j’aime quand on est soudain pris dans une tornade d’effets visuels inattendus en même temps que son personnage."
                            }
