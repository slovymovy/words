                    {
                        "translation_id": "77240dd5-0922-425d-87a9-d8316cbb0d6b",
                        "source_entry_id": "cc2f1ab7-929e-35a7-a9ea-f4f15b5dd000",
                        "source_sense_description": "white crystalline hydrocarbon",
                        "target_lang_word": "нафтали́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
