        "pl-extract.jsonl": [
            {
                "entry_id": "dccd292f-2c17-35af-bcef-e4fb409d1964",
                "word": "biopaliwo",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d460d9a7-697c-3450-9122-b248f7ed88ce",
                        "entry_id": "dccd292f-2c17-35af-bcef-e4fb409d1964",
                        "glosses": [
                            "paliwo otrzymywane z biomasy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ecee32d-24b9-4eda-94eb-e527e510fb91",
                                "sense_id": "d460d9a7-697c-3450-9122-b248f7ed88ce",
                                "text": "Niektóre firmy produkują biopaliwo z odpadów po produkcji kukurydzy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07c82bf1-d8e4-4fa2-9175-9186af7764a4",
                        "source_entry_id": "dccd292f-2c17-35af-bcef-e4fb409d1964",
                        "source_sense_id": "d460d9a7-697c-3450-9122-b248f7ed88ce",
                        "target_lang_word": "biofuel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biofuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                        "entry_id": "e0fb236a-3cb2-3cd7-b58f-4f181c4640af",
                                        "glosses": [
                                            "Any fuel that is obtained from a renewable biological resource, especially from biomass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7eef6db-0f59-4a0a-83e7-429aff85058c",
                                                "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                                "text": "Even second-generation biofuels, made from crop wastes or wood, are an environmental disaster, either extending the cultivated area or removing the straw and stovers which protect the soil from erosion and keep carbon and nutrients in the ground."
                                            },
                                            {
                                                "example_id": "86a12086-d47b-4836-84ed-afdac1311da3",
                                                "sense_id": "7f2bb098-4f89-39b6-a6b1-c3b55b8d0e0a",
                                                "text": "The Environmental Protection Agency announced proposed changes to its biofuels program Tuesday to spur more biofuel use and crack down on waivers issued to refineries by the Trump administration, notching a win for the biofuels industry and farmers and a blow to oil refineries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efdd0e53-c0af-483b-8a0a-1dfdc77c4061",
                        "source_entry_id": "dccd292f-2c17-35af-bcef-e4fb409d1964",
                        "source_sense_id": "d460d9a7-697c-3450-9122-b248f7ed88ce",
                        "target_lang_word": "biocarburant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biocarburant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                                        "entry_id": "ec2bedb1-e70f-3187-8338-32ba11a0a6cf",
                                        "glosses": [
                                            "Carburant constitué en tout ou partie de dérivés industriels obtenus après transformation de produits issus de l’agriculture."
                                        ],
                                        "tags": [
                                            "Bioénergie",
                                            "Raffinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2243dab-b50b-4be0-8f1d-f3701052eec8",
                                                "sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                                                "text": "Les biocarburants au banc d’essai"
                                            },
                                            {
                                                "example_id": "09c1c9e4-ee08-425b-a5e8-a427a0071304",
                                                "sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                                                "text": "La loi de finances pour 2006 avait repoussé au 1ᵉʳ janvier 2010 l’instauration de la TGAP dans les DOM, en raison de l’absence d’unité de production de biocarburants."
                                            },
                                            {
                                                "example_id": "1bb0af1c-71ee-4af3-b4aa-966c6a81cd2c",
                                                "sense_id": "e76999fc-45c3-342d-8e45-f05801e804fd",
                                                "text": "Pour commencer, il faudrait produire suffisamment de matières premières afin d'obtenir des biocarburants en quantités équivalentes à notre consommation d'énergie fossile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9246bc9-d6cb-4de8-8885-b83015edb228",
                        "source_entry_id": "dccd292f-2c17-35af-bcef-e4fb409d1964",
                        "source_sense_id": "d460d9a7-697c-3450-9122-b248f7ed88ce",
                        "target_lang_word": "agrocarburant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agrocarburant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68eabb45-a97c-388c-aea8-01e2bcdd11f5",
                                        "entry_id": "30ec5838-3c35-3b21-b544-410ed059ff90",
                                        "glosses": [
                                            "Carburant constitué en tout ou partie de dérivés industriels obtenus après transformation de produits issus de l’agriculture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18e2642f-5a95-488f-9f20-749ecbbd55f4",
                                                "sense_id": "68eabb45-a97c-388c-aea8-01e2bcdd11f5",
                                                "text": "Il existe deux filières d’agrocarburants de première génération :\n— la filière éthanol produisant de l’alcool, mélangeable à l’essence, par distillation du sucre extrait des tiges, graines ou racines (…)\n— La filière biodiesel produisant de l’huile, mélangeable au gazole, par estérification d’huile brute extraites des oléagineux (…)."
                                            },
                                            {
                                                "example_id": "18333d8e-b4ff-4232-901d-ff26b3a33323",
                                                "sense_id": "68eabb45-a97c-388c-aea8-01e2bcdd11f5",
                                                "text": "A chaque fois que vous faites le plein, vous consommez un peu d’agrocarburant : les distributeurs de carburants ont l’obligation d’intégrer 7 % d’éthanol à l’essence, et 7 % d’ester méthylique au gasoil."
                                            },
                                            {
                                                "example_id": "23910f54-b853-41eb-b79a-9c0c801f8663",
                                                "sense_id": "68eabb45-a97c-388c-aea8-01e2bcdd11f5",
                                                "text": "Le président brésilien promeut les agrocarburants en Europe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
