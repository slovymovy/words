                        "sense_id": "18f2a294-e3ef-367a-bbfe-64cb8705701f",
                        "entry_id": "a4f936f8-745f-3ad8-bca6-8a6f2cee11e6",
                        "glosses": [
                            "To exceed in buffoonery."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2d019e64-4cea-4ac8-825b-2030d754326b",
                                "sense_id": "18f2a294-e3ef-367a-bbfe-64cb8705701f",
                                "text": "Thou dost outzany Cokely"
                            },
                            {
                                "example_id": "be5d7cde-74bc-4e06-9fde-40a8e46c4e90",
                                "sense_id": "18f2a294-e3ef-367a-bbfe-64cb8705701f",
                                "text": "Jim Carrey, who played zany characters on television's In Living Color, outzanies himself here with slapstick antics"
                            },
                            {
                                "example_id": "4468efae-548d-42ea-adfa-9ab6fdf0eb23",
                                "sense_id": "18f2a294-e3ef-367a-bbfe-64cb8705701f",
                                "text": "The stories of his adventures outzany those of any other figure in jazz, even certified cuckoos like the maniacal Jack Purvis and the perverse Joe Venuti."
                            }
                        ]
                    }
