                                "target_senses": [
                                    {
                                        "sense_id": "a1755d32-6a4f-3329-8bec-0c73b9681bc3",
                                        "entry_id": "5e9ac11e-f4e3-3ac1-bd2e-08a01879ce93",
                                        "glosses": [
                                            "Too confident."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "632a7e53-255d-4162-94b5-18027e5bc8b9",
                                                "sense_id": "a1755d32-6a4f-3329-8bec-0c73b9681bc3",
                                                "text": "The downturn triggered by putting everyday life on hold to halt the infection should, we were told, be V-shaped: a shock, but one from which we’d soon bounce back. Like many comforting predictions in the early days of this pandemic, that is beginning to look alarmingly over-confident."
                                            },
                                            {
                                                "example_id": "3909a03e-ef1a-4eb4-a6a2-6a994f6e2131",
                                                "sense_id": "a1755d32-6a4f-3329-8bec-0c73b9681bc3",
                                                "text": "By propagating a \"reality distortion field\"—that is, mesmerizing potential employees, investors, and strategic partners so they focus on a startup's world-changing potential rather than on its real-world risks—overconfident and charismatic founders in particular are able to persuade people to commit resources under terms favorable to their new venture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43f3edf6-1101-35c4-b279-5d0edb2dc500",
                                        "entry_id": "5e9ac11e-f4e3-3ac1-bd2e-08a01879ce93",
                                        "glosses": [
                                            "Presumptuous, cocksure, rude and disrespectful."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
