                        "sense_id": "f83eca72-526f-34bd-a107-c121026e3474",
                        "entry_id": "e370101a-7927-382a-bbf7-4f0613ac6ab5",
                        "glosses": [
                            "Théorie affirmant qu’il convient de privilégier les valeurs finies aux infinies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24b05364-8a5a-40e5-bde3-6ff291649980",
                                "sense_id": "f83eca72-526f-34bd-a107-c121026e3474",
                                "text": "Mais les transcriptions de Carnap que nous examinons nous donnent une idée plus précise du nominalisme et du finitisme de Tarski (en tout cas vers 1940)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9cf51890-caeb-4ab9-8980-23242e8f1aad",
                        "source_entry_id": "e370101a-7927-382a-bbf7-4f0613ac6ab5",
