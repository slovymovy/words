                    {
                        "translation_id": "3edfa196-dc78-4296-8ca7-cb4bfba0fec4",
                        "source_entry_id": "b2d2b369-c798-3449-9e03-a6689e8ce83f",
                        "source_sense_id": "9e274b34-b60e-3c4b-b17d-ad55aacd3bb4",
