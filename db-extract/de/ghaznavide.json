                        "sense_id": "0cdfcf59-09d4-3db9-92da-a965f5da65c0",
                        "entry_id": "4ae79749-fa8d-3cd8-8eb6-dfaf1587b941",
                        "glosses": [
                            "Angehöriger der gleichnamigen Dynastie in Zentral- und Südasien"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "b3205897-a6cc-4d54-85aa-987ea8b7bb35",
                                "sense_id": "0cdfcf59-09d4-3db9-92da-a965f5da65c0",
                                "text": "„Dieses Mal kamen die Eroberer von Norden her. Es waren vor allem die Ghaznaviden, die nach ihrer Hauptstadt Ghazni im heutigen Afghanistan benannt sind.“"
                            },
                            {
                                "example_id": "5d5d6e41-81cd-4501-a5f7-31ea96e61647",
                                "sense_id": "0cdfcf59-09d4-3db9-92da-a965f5da65c0",
                                "text": "„Der koreanische Mönch Hui-Tschao, der 827 in die Stadt kam, schrieb, der König von Bamian sei immer noch Buddhist, und erst im 11. Jahrhundert sollten die Ghaznaviden den Islam im Tal etablieren können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
