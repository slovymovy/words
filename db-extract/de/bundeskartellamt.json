                "senses": [
                    {
                        "sense_id": "19485d1b-1e65-3f45-a66d-43699e485ca0",
                        "entry_id": "cb8cc07d-c674-376f-86c3-f0c7ba20c3e2",
                        "glosses": [
                            "Behörde auf Bundesebene, deren Aufgabe der Schutz des Wettbewerbes ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96731547-6789-43a7-a980-2720ed102ce4",
                                "sense_id": "19485d1b-1e65-3f45-a66d-43699e485ca0",
                                "text": "„In Deutschland hat das Bundeskartellamt die Aufgabe, den Wettbewerb zu überwachen.“"
                            },
                            {
                                "example_id": "8ce66e7c-a2ce-4d9f-818e-8304a4c4372b",
                                "sense_id": "19485d1b-1e65-3f45-a66d-43699e485ca0",
                                "text": "„Da das Bundeskartellamt beabsichtigte, den Zusammenschluss zu untersagen, haben die Beteiligten das Vorhaben aufgegeben.“"
                            },
                            {
                                "example_id": "ba5715dc-b775-43bf-aa74-d31f0093afe3",
                                "sense_id": "19485d1b-1e65-3f45-a66d-43699e485ca0",
                                "text": "„Das Bundeskartellamt diskutiert zwei durch die Zentralvermarktung betroffene Märkte, die Medienmärkte und die Zuschauermärkte.“"
                            },
                            {
                                "example_id": "d9d1e2b0-26b1-40ee-9432-56c56a18f70b",
                                "sense_id": "19485d1b-1e65-3f45-a66d-43699e485ca0",
                                "text": "„Im Frühjahr 2002 deckte das Bundeskartellamt ein Kartell im deutschen Zementmarkt auf.“"
                            },
                            {
                                "example_id": "c5ad8b89-86c9-4f96-9d63-d290dc720a6b",
                                "sense_id": "19485d1b-1e65-3f45-a66d-43699e485ca0",
                                "text": "„Dies zeigt etwa das Verfahren, dass das Bundeskartellamt 2016 gegen Facebook wegen des Verdachts des Missbrauchs seiner marktbeherrschenden Stellung durch Verstöße gegen das Datenschutzrecht einleitete.“"
                            },
                            {
                                "example_id": "51aa466c-f5df-4b63-bb73-36d897738292",
                                "sense_id": "19485d1b-1e65-3f45-a66d-43699e485ca0",
                                "text": "„Die Europäische Kommission und das Bundeskartellamt verstärken den Fokus auf die vertikalen Beschränkungen im Internethandel zwischen Herstellern und Händlern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
