                    },
                    {
                        "form_id": "cdeae873-ed84-4db6-93f2-d00587789704",
                        "entry_id": "ef9720f1-692b-36d4-8769-bea0eb66cfd9",
                        "tags": [],
                        "form": "mocha"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bfe18bd0-0d73-3754-8c0c-c615cde48a67",
                        "entry_id": "ef9720f1-692b-36d4-8769-bea0eb66cfd9",
                        "glosses": [
                            "Variété de café qu’on cultive à Moka, ville d’Arabie. Il est parfois employé comme synonyme de café."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c45bc86-c28c-4bc0-a7fd-3f4697eb5202",
                                "sense_id": "bfe18bd0-0d73-3754-8c0c-c615cde48a67",
                                "text": "Sous prétexte qu’ils ont surpris le moka de l’établissement en adultère avec de la chicorée, ils ont apporté un filtre à esprit-de-vin, et rédigent eux-mêmes leur café."
                            },
                            {
                                "example_id": "271568fe-d38e-4c90-a635-a58fcaa0fb6c",
                                "sense_id": "bfe18bd0-0d73-3754-8c0c-c615cde48a67",
                                "text": "Dites-moi, belle cousine, dites-moi quelle est la remplaçante de Josépha, et vous aurez de quoi payer votre loyer, votre petit déjeuner le matin, ce bon café que vous aimez tant, vous pourrez vous donner du moka pur… hein ? Oh ! comme c’est bon du moka pur !"
                            },
                            {
                                "example_id": "aa523c43-e12d-45ef-b76a-4bef40d22368",
                                "sense_id": "bfe18bd0-0d73-3754-8c0c-c615cde48a67",
                                "text": "Tous les jours, je voyais ma grand-mère. Elle venait chez nous prendre en compagnie de ma mère une tase du fameux moka du Planteur de Caïffa."
                            }
                        ]
                    },
                    {
                        "sense_id": "5db45dad-3e94-34eb-abff-77110c91d492",
                        "entry_id": "ef9720f1-692b-36d4-8769-bea0eb66cfd9",
                        "glosses": [
                            "Café additionné de cacao."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f01fc733-a874-4f93-8962-fc0a0c3a710a",
                                "sense_id": "5db45dad-3e94-34eb-abff-77110c91d492",
                                "text": "Un moka garni d’un chapeau de lait moussé, saupoudré de chocolat et cannelle."
                            }
                        ]
                    },
                    {
                        "sense_id": "4fa99546-99a0-365e-86c0-041147229383",
                        "entry_id": "ef9720f1-692b-36d4-8769-bea0eb66cfd9",
                        "glosses": [
                            "Gâteau de biscuit de Savoie garni de crème au café."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "e7138d57-1a5d-452a-a1f8-47a47a080450",
                                "sense_id": "4fa99546-99a0-365e-86c0-041147229383",
                                "text": "Pour dessert nous avons eu un moka."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90fab312-291a-4025-abbb-6f3a2ea50239",
                        "source_entry_id": "ef9720f1-692b-36d4-8769-bea0eb66cfd9",
                        "target_lang_word": "Mokka",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mokka",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "447a685b-46fa-3631-91b7-c3ff36d5fe9e",
                                        "entry_id": "84f78825-921b-358b-ba77-b20fcc0cc508",
                                        "glosses": [
                                            "jemenitische Kaffeesorte mit kleinen, halbkugeligen Kaffeebohnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e892cbe3-392d-4d9c-9e31-8fe1d5fbbebc",
                                                "sense_id": "447a685b-46fa-3631-91b7-c3ff36d5fe9e",
                                                "text": "Echten Mokka kann man heute nur noch selten kaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "11eeb4e7-3d4f-3772-9de9-250e5dc9a5e2",
                                        "entry_id": "84f78825-921b-358b-ba77-b20fcc0cc508",
                                        "glosses": [
                                            "ursprünglich aus Mokka^([1]) hergestellte Zubereitungsform von Kaffee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68fe5409-f735-4f8a-a4be-9071d4ec0f28",
                                                "sense_id": "11eeb4e7-3d4f-3772-9de9-250e5dc9a5e2",
                                                "text": "Nach dem Essen trinke ich gerne einen Mokka."
                                            },
                                            {
                                                "example_id": "dac5b8ed-affe-4334-aef0-0048a55c460c",
                                                "sense_id": "11eeb4e7-3d4f-3772-9de9-250e5dc9a5e2",
                                                "text": "„Dann kommen zwei Diener mit Mokka und Zigaretten.“"
                                            },
                                            {
                                                "example_id": "bc308ae9-d481-4505-b332-27a83f2e060c",
                                                "sense_id": "11eeb4e7-3d4f-3772-9de9-250e5dc9a5e2",
                                                "text": "„Grenfeld rührte missmutig in seinem Mokka.“"
                                            },
                                            {
                                                "example_id": "a348f3ba-7619-4f62-a3a5-f57c7e5c6683",
                                                "sense_id": "11eeb4e7-3d4f-3772-9de9-250e5dc9a5e2",
                                                "text": "„Das Dienstmädchen war gerade mit einer Kanne Mokka gekommen, blieb aber in der Tür stehen und wich langsam zurück, als die Mama laut wurde.“"
                                            },
                                            {
                                                "example_id": "e36fa85e-a2c8-4f5f-aca7-fa9ab5e95251",
                                                "sense_id": "11eeb4e7-3d4f-3772-9de9-250e5dc9a5e2",
                                                "text": "„Nach dem nicht enden wollenden Reigen aus Vorspeisen brachte der Kellner noch eine Runde Mokka.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
