                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7ae2e36-3ab5-4545-a7d6-eb024e28b3ce",
                                "sense_id": "0ef2feb0-29e5-3ddb-a03c-9a2236d7dc9b",
                                "text": "„Lauffen - Augen schließen und ganz tief einatmen: Das ist nicht die Vorbereitung auf eine Entspannungsübung, sondern die auf ein besonderes Geruchserlebnis.“"
                            },
                            {
                                "example_id": "7ca6ce80-3d5b-4a7c-994a-c1ab5263be2b",
                                "sense_id": "0ef2feb0-29e5-3ddb-a03c-9a2236d7dc9b",
                                "text": "„Für das Geruchserlebnis braucht die Nase zwei Anläufe.“"
                            },
                            {
                                "example_id": "240ee89b-f1b0-43f1-8893-be1f1c1a8c16",
                                "sense_id": "0ef2feb0-29e5-3ddb-a03c-9a2236d7dc9b",
                                "text": "„In Berlin bietet das Bundesinstitut für Risikobewertung in Form eines Schnupperlabyrinths ein Geruchserlebnis der besonderen Art an.“"
                            },
                            {
                                "example_id": "71ee440e-4873-4f41-9500-5256140a1ea2",
                                "sense_id": "0ef2feb0-29e5-3ddb-a03c-9a2236d7dc9b",
                                "text": "„Ein zarter Hauch nach Himbeeren und roter Johannisbeere runden das Geruchserlebnis ab.“"
                            }
                        ],
