                        "form": "die Herrin"
                    },
                    {
                        "form_id": "ce30a848-a2a0-4448-a828-b2059e4cd0cc",
                        "entry_id": "9539637d-29e5-3ee5-b36a-65465150a34c",
                        "tags": [
                            "accusative",
