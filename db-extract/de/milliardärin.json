                "senses": [
                    {
                        "sense_id": "8298ebfe-bc53-39d7-baa0-4640b3a4f066",
                        "entry_id": "80ff029f-5ecf-3c3e-b5dd-7d12414360e0",
                        "glosses": [
                            "weibliche Person, die ein Vermögen von mindestens einer Milliarde (1 000 000 000) einer Währungseinheit hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34497554-45ae-4e8f-a039-96fda24bfcf7",
                                "sense_id": "8298ebfe-bc53-39d7-baa0-4640b3a4f066",
                                "text": "„Die Idee war bestechend und machte Elizabeth Holmes zur Milliardärin: einfache Bluttests mit nur einem Tropfen für jedermann zugänglich zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54f05759-4d0f-41b8-8f72-3dc8c8b75ead",
                        "source_entry_id": "80ff029f-5ecf-3c3e-b5dd-7d12414360e0",
                        "source_sense_id": "8298ebfe-bc53-39d7-baa0-4640b3a4f066",
                        "source_sense_description": "weibliche Person, die ein Vermögen von mindestens einer Milliarde (1 000 000 000) einer Währungseinheit hat",
                        "target_lang_word": "billionaire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "billionaire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa233c56-15c1-321f-b2c4-a58aa01b6928",
                                        "entry_id": "b302fd8d-a939-389e-8bf5-6cc37481ee36",
                                        "glosses": [
                                            "Somebody whose wealth is at least one billion (10⁹) currency units."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21ee5f6f-528b-4192-bc24-751af5934d80",
                                                "sense_id": "fa233c56-15c1-321f-b2c4-a58aa01b6928",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            },
                                            {
                                                "example_id": "2b82d6a5-281a-498d-bb5d-94ebb0235fb8",
                                                "sense_id": "fa233c56-15c1-321f-b2c4-a58aa01b6928",
                                                "text": "The ranks of the billionaire class last year grew by just over 200 to nearly 2,770 people. Their wealth skyrocketed by $2.1 trillion — three times faster than the year before — to a total of $15 trillion. In the United States alone, where 816 billionaires reside, the net worth of this group soared by $1.4 trillion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59e1701d-3e62-460f-9dc3-ec05d1bf22ba",
                        "source_entry_id": "80ff029f-5ecf-3c3e-b5dd-7d12414360e0",
                        "source_sense_id": "8298ebfe-bc53-39d7-baa0-4640b3a4f066",
                        "source_sense_description": "weibliche Person, die ein Vermögen von mindestens einer Milliarde (1 000 000 000) einer Währungseinheit hat",
                        "target_lang_word": "milliardaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milliardaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "029412f5-788e-3ffc-9201-291d8aee6c4e",
                                        "entry_id": "5c5e0d4b-92c4-3ca5-a7b5-29258879e965",
                                        "glosses": [
                                            "Celui, celle qui possède un ou plusieurs milliards, qui est extrêmement riche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "718d79f1-a11a-4a33-bac2-176d68ce4faa",
                                                "sense_id": "029412f5-788e-3ffc-9201-291d8aee6c4e",
                                                "text": "Des caprices de pin-up, des croqueuses de diamants qui se déhanchent pour le milliardaire du jour, des vedettes américaines en villégiature à Cinecittà qui veulent en montrer aux jeunes Romains, des gigolos qui se lancent dans des kazatchoks pour impressionner la cliente, oui.' — (Clément Ghys, Vadim, le plaisir sans remords, 2017)"
                                            },
                                            {
                                                "example_id": "43eb9b50-de71-4f0e-9ec3-10c05e20ddc2",
                                                "sense_id": "029412f5-788e-3ffc-9201-291d8aee6c4e",
                                                "text": "Ma dernière vision de lui, alors que je lançais un grand au revoir, fut celle d'un riche milliardaire perdu dans le carrousel des bagages, parmi la plèbe, jouant des coudes avec le reste des mortels afin de récupérer ses bagages."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "milliardaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c4c17db-0eaa-358c-a174-8ce599e8be13",
                                        "entry_id": "d44d3bdc-0aa5-3ed5-bd9c-f26b6aadd0cc",
                                        "glosses": [
                                            "Qui possède un ou plusieurs milliards, qui est extrêmement riche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d17d0844-9123-4478-9f11-16074e6d8923",
                                                "sense_id": "8c4c17db-0eaa-358c-a174-8ce599e8be13",
                                                "text": "Mais là n’est pas le plus important : qui pensait, franchement, qu’à l'âge de Kanye, Drake et Gucci, un producteur milliardaire de cinquante ans pourrait encore révolutionner cette musique éternellement adolescente qu’est le hip-hop ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16689ac7-907d-3fe0-bf67-2a8cb9803fc9",
                                        "entry_id": "d44d3bdc-0aa5-3ed5-bd9c-f26b6aadd0cc",
                                        "glosses": [
                                            "Se dit d’une rime composée de nombreuses syllabes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49591c32-fcef-4a2c-a36f-ba285c861184",
                                                "sense_id": "16689ac7-907d-3fe0-bf67-2a8cb9803fc9",
                                                "text": "J’en prendrai à témoin ces deux vers milliardaires de Henri de Régnier, plus intelligibles à la lecture visuelle qu’à la seule audition :\nTout poète épris d’art haut court\nAux jeudis d’Edmond Haraucourt,\n[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
