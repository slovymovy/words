                                    {
                                        "sense_id": "80bf7841-f535-3444-b452-71afdf10568c",
                                        "entry_id": "224785f2-ff7f-3ec4-971a-22f388ee3308",
                                        "glosses": [
                                            "A protector of a dependent, especially a master who had freed a slave but still retained some paternal rights."
