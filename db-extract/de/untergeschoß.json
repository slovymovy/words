                "senses": [
                    {
                        "sense_id": "97198e10-9e5e-3c53-b2f3-4b41be47015d",
                        "entry_id": "baf52c66-226f-3aad-9cc1-0913b4fe7626",
                        "glosses": [
                            "unter der Erde befindlicher Teil eines Gebäudes"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "9d47f9fd-1968-4178-b680-5150865275ae",
                                "sense_id": "97198e10-9e5e-3c53-b2f3-4b41be47015d",
                                "text": "Im Untergeschoß möchte ich nicht wohnen."
                            },
                            {
                                "example_id": "da80689c-39c2-4fb6-8b7e-fb65160321f6",
                                "sense_id": "97198e10-9e5e-3c53-b2f3-4b41be47015d",
                                "text": "„Wir wählen ein Zimmer im Untergeschoß, das gleich zweifach Vorteile bietet: ein Waschbecken mit Wasserleitung, die sogar funktioniert, und einen rückwärtigen Ausgang.“"
                            },
                            {
                                "example_id": "a7b06bed-0d5f-4072-9bbd-85051a9bb614",
                                "sense_id": "97198e10-9e5e-3c53-b2f3-4b41be47015d",
                                "text": "„Als Geschoße gelten das Erdgeschoß sowie Ober- und Untergeschoße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
