                "senses": [
                    {
                        "sense_id": "3ecab2ba-e4df-3916-9490-b3dc34e21916",
                        "entry_id": "9dd26d04-2106-393d-9db3-b6d02ef8c2e8",
                        "glosses": [
                            "устар. и диал. подосиновик"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dc5ceb0-3b29-42f7-a46e-5f58d5d9f2b0",
                                "sense_id": "3ecab2ba-e4df-3916-9490-b3dc34e21916",
                                "text": "У меня срисован осиновик, у которого шесть отдельных корней покрыты одною шляпкой."
                            },
                            {
                                "example_id": "c3392312-65f5-4882-8a91-f159d0691701",
                                "sense_id": "3ecab2ba-e4df-3916-9490-b3dc34e21916",
                                "text": "Редкое удовольствие собирать челыши. Так у нас называют подосиновики, или более правильно, более по-книжному — осиновики."
                            }
                        ]
                    }
