                        "sense_id": "dc552417-6afa-3565-8507-83ea4df94283",
                        "entry_id": "d39e270f-b195-35b8-876c-a377f53629f7",
                        "glosses": [
                            "Galette de pain levé, rond et plat, cuit dans un tandoor, et populaire dans la cuisine de l’Asie centrale et du sud."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3b3b03-8152-4ec3-a765-1b48076784df",
                                "sense_id": "dc552417-6afa-3565-8507-83ea4df94283",
                                "text": "Mais pas d’inquiétudes, le naan ressemble de toute façon davantage un pain plat (comme les pitas) : il ne lèvera pas beaucoup une fois sorti du four."
                            },
                            {
                                "example_id": "529b09f5-30bf-4fcb-b663-0b382fd94bc5",
                                "sense_id": "dc552417-6afa-3565-8507-83ea4df94283",
                                "text": "Sachez également, que le naan au fromage est une pure invention … française !"
                            },
                            {
                                "example_id": "cbaa06ba-f055-4a15-8d28-6768c371e9e6",
                                "sense_id": "dc552417-6afa-3565-8507-83ea4df94283",
                                "text": "Bien refermer la boule puis l’étaler délicatement à l’aide d’un rouleau à pâtisserie de façon à former huit beaux naans."
                            }
                        ]
                    }
                ],
