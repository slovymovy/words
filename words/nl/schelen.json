                {
                    "sense_id": "13a7917b-a6ae-3ef9-828d-c4db526c6320",
                    "sense_definition": "Iets mankeren of mis zijn; last hebben van iets.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik vraag me af wat er met hem <w>scheelt</w> vandaag.",
                            "target_lang_translations": {
                                "ru": "Интересно, что с ним сегодня <w>не так</w>.",
                                "en": "I wonder what is <w>wrong</w> with him today.",
                                "pl": "Zastanawiam się, co mu dzisiaj <w>dolega</w>.",
                                "de": "Ich frage mich, was heute mit ihm <w>nicht stimmt</w>.",
                                "fr": "Je me demande ce qui <w>ne va pas</w> avec lui aujourd'hui.",
                                "it": "Mi chiedo cosa <w>abbia</w> oggi.",
                                "cs": "Zajímalo by mě, co s ním dnes <w>je</w>.",
                                "tr": "Bugün onun neyi <w>var</w> merak ediyorum.",
                                "es": "Me pregunto qué le <w>pasa</w> hoy.",
                                "zh": "我纳闷他今天怎么<w>不对劲</w>。"
                            }
                        },
                        {
                            "text": "Er <w>scheelt</w> niets aan de motor, hij loopt als een zonnetje.",
                            "target_lang_translations": {
                                "ru": "В моторе ничего не <w>барахлит</w>, он работает как часы.",
                                "en": "There is nothing <w>wrong</w> with the engine, it runs like a charm.",
                                "pl": "Z silnikiem wszystko jest w porządku, <w>nic mu nie dolega</w>, pracuje jak zegarek.",
                                "de": "Dem Motor <w>fehlt</w> nichts, er läuft wie geschmiert.",
                                "fr": "Il n'y a rien qui <w>ne va pas</w> avec le moteur, il tourne comme une horloge.",
                                "it": "Non c'è nulla che <w>non vada</w> nel motore, funziona a meraviglia.",
                                "cs": "S motorem <w>není nic v nepořádku</w>, běží jako hodinky.",
                                "tr": "Motorda hiçbir <w>sorun yok</w>, saat gibi çalışıyor.",
                                "es": "No le <w>pasa</w> nada al motor, funciona a la perfección.",
                                "zh": "发动机没<w>出问题</w>，运行得非常顺畅。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wat scheelt er"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть не в порядке, беспокоить (о здоровье или состоянии); случаться.",
                        "en": "To be wrong with someone or something; to be the matter.",
                        "pl": "Być nie w porządku, dolegać komuś lub czemuś.",
                        "de": "Etwas ist nicht in Ordnung oder ein Problem liegt vor.",
                        "fr": "Être anormal, avoir un problème, ou être la cause d'un souci.",
                        "it": "Essere qualcosa che non va, avere un problema o essere la causa di un malessere.",
                        "cs": "Být v nepořádku, mít nějaký problém nebo být příčinou potíží.",
                        "tr": "Bir şeyin yanlış olması, bir sorunun bulunması veya birinin bir derdinin olması.",
                        "es": "Estar mal, tener un problema o ser la causa de una molestia.",
                        "zh": "指某人或某物出了问题，或者身体不适。"
