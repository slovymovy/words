                                "target_senses": [
                                    {
                                        "sense_id": "a5f7dc03-b753-35a8-bd2d-842d9da724a9",
                                        "entry_id": "3eeae1b2-5c4e-3810-b4e7-9aaa7e81d302",
                                        "glosses": [
                                            "Departure from one's homeland to live in another country; migration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24ffc420-1380-3c07-812b-b91428427042",
                                        "entry_id": "3eeae1b2-5c4e-3810-b4e7-9aaa7e81d302",
                                        "glosses": [
                                            "A change from one state of existence to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9078aa31-4b61-48dd-be65-a7d4191049d2",
                                                "sense_id": "24ffc420-1380-3c07-812b-b91428427042",
                                                "text": "Any great change is like cold water in winter—one shrinks from the first plunge; and a lover may be excused who shivers a little at the transmigration into a husband."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97ecc65a-db1f-3cc2-a044-b8041b2e364a",
                                        "entry_id": "3eeae1b2-5c4e-3810-b4e7-9aaa7e81d302",
                                        "glosses": [
                                            "The movement of a soul from one body to another after death; metempsychosis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01f165a6-1082-4e9e-a222-315aa3465a61",
                                                "sense_id": "97ecc65a-db1f-3cc2-a044-b8041b2e364a",
                                                "text": "The curioſity of the lady was highly inflamed, to know the hiſtory of the parrot's tranſmigration, which ſhe intreated the bird with all her eloquence to relate; but he preſented a deaf ear to her importunity, and, like a painted nightingale, remained ſilent."
                                            },
                                            {
                                                "example_id": "1a73be99-7ab0-433f-b424-936503f31a71",
                                                "sense_id": "97ecc65a-db1f-3cc2-a044-b8041b2e364a",
                                                "text": "To the strength and fierceness of barbarians they [the Dacians] added a contempt for life, which was derived from a warm persuasion of the immortality and transmigration of the soul."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b0b8ff4-aed8-494c-88fe-9981cf5af3bc",
