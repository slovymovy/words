                    ]
                },
                {
                    "sense_id": "fa290a21-99ff-3da7-97cc-198147df0461",
                    "sense_definition": "Maintenir un cheval sous contrôle entre la main et les jambes du cavalier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cavalier expérimenté sait exactement comment <w>renfermer</w> sa monture lors des virages serrés."
                        },
                        {
                            "text": "Il convient de <w>renfermer</w> ce jeune cheval avec calme pour éviter les écarts."
