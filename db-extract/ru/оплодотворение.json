                    },
                    {
                        "translation_id": "1a3bae05-b758-4f1a-abdb-446f067b8340",
                        "source_entry_id": "1d70385f-cb64-39dd-aa10-64d3855cb236",
                        "target_lang_word": "Befruchtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Befruchtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea31a701-2dec-3f1e-9156-6bf6a868fe3e",
                                        "entry_id": "18dd4f41-e1cb-3986-978a-f60166288f3e",
                                        "glosses": [
                                            "der Fortpflanzung und Entstehung eines neuen Individuums dienende Vereinigung einer weiblichen und einer männlichen Geschlechtszelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87dde5de-8267-4abb-9ac6-4148dbe1e858",
                                                "sense_id": "ea31a701-2dec-3f1e-9156-6bf6a868fe3e",
                                                "text": "„Immer mehr Paare versuchen per künstliche Befruchtung ein Kind zu bekommen.“"
                                            },
                                            {
                                                "example_id": "cd049351-91e9-47ff-bb2c-f347dcce4a55",
                                                "sense_id": "ea31a701-2dec-3f1e-9156-6bf6a868fe3e",
                                                "text": "„Zur Befruchtung brauchen sie dennoch einen Partner; eine Garnele muss die männliche Rolle übernehmen, die andere die weibliche.“"
                                            },
                                            {
                                                "example_id": "f51be3f8-8b35-4ff6-a864-02d941665a7e",
                                                "sense_id": "ea31a701-2dec-3f1e-9156-6bf6a868fe3e",
                                                "text": "„Der Eierstock […] produziert die weiblichen Hormone und die Eizellen, die vom Eileiter […] aufgefangen werden, wo die Befruchtung stattfindet.“"
                                            },
                                            {
                                                "example_id": "e01d80c2-e3d6-4583-ae1c-a16b11b8bd8d",
                                                "sense_id": "ea31a701-2dec-3f1e-9156-6bf6a868fe3e",
                                                "text": "„Für die Befruchtung wollten sie nicht auf künstliche Mittel zurückgreifen; es war viel leichter, einen Freund darum zu bitten, sie kannte mehrere Männer, die sich vorstellen konnten, Barbara zu schwängern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "62d7c1c5-6b8d-3dd6-9999-6b7b0f3812c1",
                                        "entry_id": "18dd4f41-e1cb-3986-978a-f60166288f3e",
                                        "glosses": [
                                            "geistige Anregung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aa3f295-6f93-42ad-9977-2ecc393644df",
                                                "sense_id": "62d7c1c5-6b8d-3dd6-9999-6b7b0f3812c1",
                                                "text": "Die Neuzeit lebte kraft ihrer Befruchtung durch die Antike auf."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "997dd383-7432-4ea6-97b7-f01999d61b71",
                        "source_entry_id": "1d70385f-cb64-39dd-aa10-64d3855cb236",
                        "target_lang_word": "zapłodnienie",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zapłodnienie",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "265cd5d3-bfea-3b79-b0fc-a35ea20ec726",
                                        "entry_id": "347fa768-311c-3022-b53b-c8e312bfb813",
                                        "glosses": [
                                            "dokonanie połączenia komórki jajowej z plemnikiem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9994c416-e19d-4d40-98d8-cce56e6b0aa2",
                                                "sense_id": "265cd5d3-bfea-3b79-b0fc-a35ea20ec726",
                                                "text": "Są kobiety, które w godzinę po zapłodnieniu, zlepek komórek traktują jako swoje najprawdziwsze na świecie dziecko, a są też takie, dla których to tylko zlepek, przez jeszcze długie tygodnie. Do których kobiet Ty się zaliczasz?"
                                            },
                                            {
                                                "example_id": "b3cfefa7-8de8-4623-a013-68295149c592",
                                                "sense_id": "265cd5d3-bfea-3b79-b0fc-a35ea20ec726",
                                                "text": "W czasie całego cyklu miesięcznego, tylko w ciągu 36 godzin (tyle trwa faza owulacyjna) może dojść do zapłodnienia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "aa66f087-a971-3fc2-ada9-7d61791382ac",
                                        "entry_id": "347fa768-311c-3022-b53b-c8e312bfb813",
                                        "glosses": [
                                            "rzecz. odczas. od zapłodnić"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d651f47-9068-495f-89f5-3ff25f3ddb16",
                        "source_entry_id": "1d70385f-cb64-39dd-aa10-64d3855cb236",
                        "target_lang_word": "fécondation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fécondation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7bb2632-c78e-343e-b1e4-912aa4a6973c",
                                        "entry_id": "ca0ee85c-2277-37b7-b35c-6fdfa5639365",
                                        "glosses": [
                                            "Action de féconder ; résultat de cette action."
                                        ],
                                        "tags": [
                                            "Reproduction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8b3c20c-9264-43d0-853e-a28688437ccf",
                                                "sense_id": "e7bb2632-c78e-343e-b1e4-912aa4a6973c",
                                                "text": "Les reproducteurs ont absolument besoin d'eau avant et pendant la ponte ; sans quoi la fécondation n'a pas lieu (et tous les œufs sont clairs)."
                                            },
                                            {
                                                "example_id": "7cccb374-5615-477c-b8c6-8513d1ba3eea",
                                                "sense_id": "e7bb2632-c78e-343e-b1e4-912aa4a6973c",
                                                "text": "Une autre condition pour la formation des graines est que la pollinisation qui assure la fécondation puisse se produire. Or il arrive souvent que la pollinisation doive être effectuée par un insecte (quelquefois oiseau, mollusque...) déterminé. Dans ce cas l'aire de l'insecte pollinisateur limite celle de la plante."
                                            },
                                            {
                                                "example_id": "da859963-3324-4c4b-9368-5e40efcece69",
                                                "sense_id": "e7bb2632-c78e-343e-b1e4-912aa4a6973c",
                                                "text": "Il y a fécondation lorsqu’un spermatozoïde et un ovule se rencontrent et fusionnent. Chacun apporte un nombre haploïde (n) de chromosomes au zygote (l’œuf fécondé) qui contient par conséquent une série de chromosomes provenant du spermatozoïde (les chromosomes paternels) et une série homologue de chromosomes issus de l’ovule (les chromosomes maternels)."
                                            },
                                            {
                                                "example_id": "5a28a78b-8ed5-4cb7-80ea-867488059038",
                                                "sense_id": "e7bb2632-c78e-343e-b1e4-912aa4a6973c",
                                                "text": "La conception nécessite l’atteinte et la pénétration par le spermatozoïde de l’ovocyte, […]. La période de fécondation est limitée au temps de vie des gamètes; l’ovocyte a une durée de vie de 24 heures et le spermatozoïde de 48 à 72 heures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcbb1a4b-2bff-3cd2-a845-652c7ffc0616",
                                        "entry_id": "ca0ee85c-2277-37b7-b35c-6fdfa5639365",
                                        "glosses": [
                                            "Action pour une personne du susciter efficacement un effort de création chez une autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8989cd84-916b-4ca0-b39a-e4267c9cee18",
                                                "sense_id": "bcbb1a4b-2bff-3cd2-a845-652c7ffc0616",
                                                "text": "Parler d'estime, voire d'admiration réciproque est insuffisant : il s'agit d'une véritable fécondation, comme le prouve le nombre d'écrits composés par l'un et par l'autre pendant toute la durée du dialogue [épistolaire]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
