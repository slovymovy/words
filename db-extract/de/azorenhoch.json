                ],
                "senses": [
                    {
                        "sense_id": "653533a7-d7f8-333a-857e-8f3108df773e",
                        "entry_id": "c26acab9-c70f-3000-86de-04686e2bcc58",
                        "glosses": [
                            "Hochdruckgebiet, das sich über dem Atlantik im Bereich der Inselgruppe der Azoren bildet und das Wetter in West- und Mitteleuropa beeinflusst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27178b17-da13-4af0-adf6-e3c618418a3d",
                                "sense_id": "653533a7-d7f8-333a-857e-8f3108df773e",
                                "text": "„Das Azorenhoch verharrte fast wie angewurzelt auf seiner gewöhnlichen Position über dem Atlantik und entsandte nur zwei kleine Ableger in Richtung Südwestdeutschland.“"
                            },
                            {
                                "example_id": "b5806a0e-8b2f-41e3-9af0-24387f3f4413",
                                "sense_id": "653533a7-d7f8-333a-857e-8f3108df773e",
                                "text": "„Zweitens werde diskutiert, ob die globale Erwärmung die jährlichen Schwankungen im Luftdruckunterschied zwischen Islandtief und Azorenhoch verstärkt.“"
                            },
                            {
                                "example_id": "07827494-280d-4624-8b58-3a509c91a3ff",
                                "sense_id": "653533a7-d7f8-333a-857e-8f3108df773e",
                                "text": "„Denn erst jetzt wird klar, wie bedeutsam jene wiederkehrenden Luftdruckänderungen über dem Atlantik sind, die Meteorologen seit gut hundert Jahren verfolgen, deren Bedeutung sie aber nie verstanden haben: die \"Nordatlantische Oszillation\", eine Art atmosphärische Wippe zwischen Azorenhoch und Islandtief, offenbar jenes atlantische Gegenstück zu den Schwankungen, die im Pazifik den El Niño antreiben (siehe Grafik Seite 304).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
