                "senses": [
                    {
                        "sense_id": "24d3c5ef-f52e-3131-af32-1300011f6e96",
                        "entry_id": "d4e91f07-dd26-391d-82ef-05f12c4abe9e",
                        "glosses": [
                            "To know again; to relearn or understand anew."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "972e9842-f547-4958-b9b9-7a286764a7e4",
                                "sense_id": "24d3c5ef-f52e-3131-af32-1300011f6e96",
                                "text": "The teacher’s special function is to lead the pupil to reknow these elements, and by thought to attain the desired knowledge."
                            },
                            {
                                "example_id": "44a82694-ce9c-4f88-9dff-99bd7d914c0a",
                                "sense_id": "24d3c5ef-f52e-3131-af32-1300011f6e96",
                                "text": "In recognizing one another in our aesthetic constructs, in coming to reknow one another, we come to reknow ourselves as well."
                            },
                            {
                                "example_id": "eaa41500-f2f7-4e37-addd-baf2980ea77b",
                                "sense_id": "24d3c5ef-f52e-3131-af32-1300011f6e96",
                                "text": "It is a story of human beings constantly reknowing themselves as the reciprocal of the self-reknowing of others."
                            },
                            {
                                "example_id": "224a2c37-5400-490a-a90b-c27a00e5c9fa",
                                "sense_id": "24d3c5ef-f52e-3131-af32-1300011f6e96",
                                "text": "And only then, when he has recovered his true self, does he uncover, or reknow, the true distinctions, identifying erōs as a divine gift, and distinguishing between “good” and “bad” madness—a distinction that is essential if human beings are to have a true understanding of themselves and what they experience in love."
                            }
                        ]
                    }
