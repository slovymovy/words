                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "789caa99-ffb1-4d5e-82be-7a211d569f16",
                                "sense_id": "9137669c-23d4-3172-b4c4-63e839642202",
                                "text": "I had never honchoed that many people so even something as simple as ordering them to knead dough or fondant became an important decision."
                            },
                            {
                                "example_id": "513bedc3-54f2-40a1-8d68-fb5308a2315a",
                                "sense_id": "9137669c-23d4-3172-b4c4-63e839642202",
                                "text": "The task of choosing the clips that comprised the allotted 10 minutes in the bake-off was left to the supervising sound editor, as it was he or she who honchoed the preparation of the soundtrack for the rerecording mixing stage in the first place."
                            }
                        ]
                    }
