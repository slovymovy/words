                                "example_id": "de7951a7-f87f-4367-a385-f29961de3be4",
                                "sense_id": "a2323233-3ce5-322d-a49b-80892205a410",
                                "text": "À Nice, Martine Landry, 73 ans, militante à Amnesty International, a été jugée pour avoir secouru deux jeunes Guinéens de 15 ans."
                            }
                        ]
                    }
                ],
