                                    {
                                        "sense_id": "0379efb5-f704-3327-bf5f-cf607eed2267",
                                        "entry_id": "61e9bbce-a012-3cbf-93aa-301d84932850",
                                        "glosses": [
                                            "oudste zoon van Adam en Eva die uit afgunst zijn broeder Abel doodsloeg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b18d1004-e926-43a2-bbc1-7708662d33b4",
                                                "sense_id": "0379efb5-f704-3327-bf5f-cf607eed2267",
                                                "text": "Het begon al in Genesis 4. Zoon Kaïn werd landbouwer, zoon Abel herder. Opa God trok Abel voor, dus lokte Kaïn hem het veld in en vermoordde hem. Toen opa vroeg waar Abel toch was, zei hij: „Ik weet het niet, ben ik mijn broeders hoeder?”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40a6c4cd-b229-409c-8cc1-4f83dedb62ff",
                        "source_entry_id": "2632e086-ff9a-34f0-a98b-25e8f281f318",
                        "source_sense_description": "son of Adam and Eve",
                        "target_lang_word": "Caïn",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Caïn",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6583b093-f7c1-34dc-9289-987c2749bdef",
                                        "entry_id": "12fb67cc-f873-36d3-bacf-f70b706cc968",
                                        "glosses": [
                                            "Premier fils d’Adam et Ève dans la Bible, connu pour avoir tué son frère cadet Abel."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ef3eff9-6f4a-41bf-a2bb-9e9c85fa8f1c",
                                                "sense_id": "6583b093-f7c1-34dc-9289-987c2749bdef",
                                                "text": "Adam connut Ève, sa femme ; elle conçut, et enfanta Caïn et elle dit : J’ai formé un homme avec l’aide de l’Éternel."
                                            },
                                            {
                                                "example_id": "517fccb7-b791-473e-872b-cf1f650dea6e",
                                                "sense_id": "6583b093-f7c1-34dc-9289-987c2749bdef",
                                                "text": "Lorsque avec ses enfants vêtus de peaux de bêtes,\nÉchevelé, livide au milieu des tempêtes,\nCaïn se fut enfui de devant Jéhovah,\nComme le soir tombait, l’homme sombre arriva\nAu bas d’une montagne en une grande plaine ;\nSa femme fatiguée et ses fils hors d’haleine\nLui dirent : « Couchons-nous sur la terre, et dormons. »\nCaïn, ne dormant pas, songeait au pied des monts."
                                            },
                                            {
                                                "example_id": "76bc8f0d-45d8-4453-88d0-8c2e29b1f988",
                                                "sense_id": "6583b093-f7c1-34dc-9289-987c2749bdef",
                                                "text": "Je suis sûr, moi, que Caïn était un garçon bonasse, sans méfiance… Tandis que cet Abel…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Caïn",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
