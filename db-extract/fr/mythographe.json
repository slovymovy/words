                "senses": [
                    {
                        "sense_id": "d3cadd95-04c3-33c8-85f3-d51eb726f72d",
                        "entry_id": "059f63ab-d0b5-3219-acc2-c57042b87b3e",
                        "glosses": [
                            "Auteur qui a écrit sur les mythes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1a178b3-84f7-4a1a-9d8d-9e0c61b79b39",
                                "sense_id": "d3cadd95-04c3-33c8-85f3-d51eb726f72d",
                                "text": "Parfois, la mythographe s'interroge sur les mythes qu'elle rédige. Et parfois, elle se demande bien ce qui peut fonder la réputation de certains héros."
                            },
                            {
                                "example_id": "3a4a8971-b9ad-4c08-9ac5-d48e2123fd52",
                                "sense_id": "d3cadd95-04c3-33c8-85f3-d51eb726f72d",
                                "text": "À cet égard, la démarche de Sébillet est très proche de celle d’un mythographe comme Natale Conti."
                            },
                            {
                                "example_id": "c57c0c1d-8b9a-4817-895a-bd7ee8045f98",
                                "sense_id": "d3cadd95-04c3-33c8-85f3-d51eb726f72d",
                                "text": "D'autres voyageurs, comme le mythographe Nonnos de Pannopolis, ont évoqué les paysages et les cités du Levant, dont le souvenir est ainsi toujours resté vivant parmi les adeptes de la culture antique."
                            }
                        ]
                    }
                ],
