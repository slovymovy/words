                    "sense_id": "d7c862b4-9a9d-3992-9e08-91a9012f0679",
                    "sense_definition": "Een sterke, vaak gevaarlijke zeestroom die loodrecht van de kust af naar open zee stroomt door een geul in de zandbanken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zeestroming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pas op dat je niet in een <w>mui</w> terechtkomt bij het zwemmen in de zee.",
                            "target_lang_translations": {
                                "en": "Be careful not to end up in a <w>rip current</w> when swimming in the sea."
                            }
                        },
                        {
                            "text": "De sterke <w>mui</w> trok de onvoorzichtige zwemmers snel mee naar dieper water.",
                            "target_lang_translations": {
                                "en": "The strong <w>riptide</w> quickly pulled the careless swimmers into deeper water."
                            }
                        }
                    ],
                    "synonyms": [
                        "muistroom"
                    ],
                    "antonyms": [
                        "zwin"
                    ],
                    "common_phrases": [
                        "gevaarlijke mui",
                        "in een mui getrokken"
                    ],
                    "target_lang_definitions": {
                        "en": "A strong, often dangerous sea current that flows perpendicular to the coast towards the open sea through a channel in the sandbanks."
                    },
                    "translations": {
                        "en": [
                            {
