                "senses": [
                    {
                        "sense_id": "c16dbbe8-cd1c-3ab7-8aab-b527ac1d4288",
                        "entry_id": "c7008ae9-d1be-3000-add5-7b71ebefdd46",
                        "glosses": [
                            "Entzündung der Schleimhäute des Magen-Darm-Traktes, die zu starkem Durchfall und Erbrechen führt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a6789ef9-794f-485f-9667-e3642d552b44",
                                "sense_id": "c16dbbe8-cd1c-3ab7-8aab-b527ac1d4288",
                                "text": "„Zu den Magengrippen, die regelmäßig im Frühjahr und Herbst wiederkehrten, und zu der Schwäche der Füße, die man mit warmen Sandbädern und mit in Essig gekochten Schilfumschlägen zu beheben versuchte, hatte sich im letzten Winter ein ernstes Leberleiden gesellt, das von dem Leibarzt Aemilius ebenso einwandfrei festgestellt wie falsch behandelt worden war.“"
                            },
                            {
                                "example_id": "a9a9ad48-c51c-4fba-acb2-d3d3f1b50452",
                                "sense_id": "c16dbbe8-cd1c-3ab7-8aab-b527ac1d4288",
                                "text": "„Die Magengrippe hatte ihn erwischt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
