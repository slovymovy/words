                "senses": [
                    {
                        "sense_id": "47e013cb-0945-3cd8-834a-1c8c2840f244",
                        "entry_id": "1716a377-841e-313e-b6df-b1ebd0501ef4",
                        "glosses": [
                            "Licht von nur einer Farbe; Einfarbigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e1daf5d-e6b1-40f5-acb4-a0b519e7d5a2",
                                "sense_id": "47e013cb-0945-3cd8-834a-1c8c2840f244",
                                "text": "„Für die Konstanz der Lichtintensität sorgt die entsprechend gewählte Lichtquelle, die Monochromasie müssen wir selbst herstellen.“"
                            },
                            {
                                "example_id": "06e4ceb4-761f-4223-840d-2fb6a2373317",
                                "sense_id": "47e013cb-0945-3cd8-834a-1c8c2840f244",
                                "text": "„Eigenschaften von Laserstrahlung Laserstrahlung zeichnet sich durch eine hohe Kohärenz und Monochromasie (Einfarbigkeit) aus […].“"
                            },
                            {
                                "example_id": "b4cbb164-4423-4b97-97a0-6aa4f95d1473",
                                "sense_id": "47e013cb-0945-3cd8-834a-1c8c2840f244",
                                "text": "„Die natürliche Lebensdauer hängt mit der Schärfe der Energieniveaus und der Frage nach der Monochromasie des Lichts zusammen.“"
                            },
                            {
                                "example_id": "2e4ebac2-231c-447d-9184-9df46d6fdab2",
                                "sense_id": "47e013cb-0945-3cd8-834a-1c8c2840f244",
                                "text": "„Abhängigkeit von deren spektralen Zusammensetzung (Qualität) steht und ein gewisser Grad von Monochromasie ein günstiges Moment darstellt.“"
                            },
                            {
                                "example_id": "4fe50be1-cf99-4264-b459-0244b7c9c524",
                                "sense_id": "47e013cb-0945-3cd8-834a-1c8c2840f244",
                                "text": "„Monochromasie (Einfarbigkeit) bedeutet, dass das von einem Laser ausgesendete Licht nur eine einzige Wellenlänge besitzt.“"
                            },
                            {
                                "example_id": "81ec722c-1cec-4184-9d8a-40556869de06",
                                "sense_id": "47e013cb-0945-3cd8-834a-1c8c2840f244",
                                "text": "„Dieses Licht ist demzufolge reiner und einfarbiger als natürliches Licht, man spricht von Monochromasie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d614b945-3212-39fa-a472-cf2070044998",
                        "entry_id": "1716a377-841e-313e-b6df-b1ebd0501ef4",
                        "glosses": [
                            "angeborener oder erworbener gänzlicher Ausfall des Farbensehens durch Fehlen der Zapfenfunktion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7314a20b-1883-4929-9093-e207f9b5b2a7",
                                "sense_id": "d614b945-3212-39fa-a472-cf2070044998",
                                "text": "„Achromasie bedeutet totale Farbenblindheit (ungenau auch Monochromasie).“"
                            },
                            {
                                "example_id": "f580d68d-9f16-4a5f-b727-5ae64e95c4b8",
                                "sense_id": "d614b945-3212-39fa-a472-cf2070044998",
                                "text": "„Endlich gibt es noch Sehorgane, die im Spektrum nur einen Farbenton verschiedener Helligkeit unterscheiden: Monochromasie.“"
                            },
                            {
                                "example_id": "285d84c1-cae0-435b-bf01-34fc1c9893ce",
                                "sense_id": "d614b945-3212-39fa-a472-cf2070044998",
                                "text": "„Der totalen Farbenblindheit (Achromatopsie, Monochromasie) liegt eine autosomal-rezessiv vererbte Zapfenaplasie zugrunde.“"
                            },
                            {
                                "example_id": "4a031e09-3104-47b8-9d42-086a13dd558d",
                                "sense_id": "d614b945-3212-39fa-a472-cf2070044998",
                                "text": "„Mit totaler Farbenblindheit behaftete Personen sind keiner bunten Farbempfindung fähig (Achromasie, Monochromasie) […].“"
                            },
                            {
                                "example_id": "cd2d6a41-6c9c-4ad4-a732-9aa9d1bcb4fa",
                                "sense_id": "d614b945-3212-39fa-a472-cf2070044998",
                                "text": "„Alle Dichromasien und Monochromasien entstehen durch genetische Defekte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
