                "senses": [
                    {
                        "sense_id": "479a56e9-dc17-33a2-ba55-b007a7c5fc58",
                        "entry_id": "1c83b122-c161-34fa-85a6-bc230952aee1",
                        "glosses": [
                            "Schleppnetz (ursprünglich mit zwei Flügeln)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dbc08ae-70aa-4183-a32e-dae0a9ad204d",
                                "sense_id": "479a56e9-dc17-33a2-ba55-b007a7c5fc58",
                                "text": "„Die Zeese selbst ist ein Schleppnetz, das durch zwei Driftleinen offengehalten wird. Diese Leinen, auch Treibleinen genannt, sind bei den Zeesenkähnen am Vor- und am Achtersteven befestigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a2638af0-a180-33a6-a510-9e03e7cdf10b",
                        "entry_id": "1c83b122-c161-34fa-85a6-bc230952aee1",
                        "glosses": [
                            "Fischerboot, das mit Schleppnetzen fischt"
                        ],
                        "tags": [
                            "Fischfang",
                            "besonders historisch in der Ostsee bei Pommern"
                        ],
                        "examples": [
                            {
                                "example_id": "7b6420c8-c225-40c1-93d3-b7756c44e204",
                                "sense_id": "a2638af0-a180-33a6-a510-9e03e7cdf10b",
                                "text": "„Tidemanns Boote sind nicht dort. Das kleine liegt am Ufer unterhalb seines Grundstücks, die Zeese ankert hundert Meter davor im Bodden, nur bei Sturm läuft er damit ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
