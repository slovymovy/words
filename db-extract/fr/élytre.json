                                        "sense_id": "e76d90da-8cee-39de-a9fd-52d8e4889860",
                                        "entry_id": "a23ee384-459d-3f3b-a09a-4cd41cec0b12",
                                        "glosses": [
                                            "A sheath or outer covering, especially around the spinal cord or over the hindwings of certain insects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b22825b-8a1a-4667-bc29-d7b58e060daa",
                                                "sense_id": "e76d90da-8cee-39de-a9fd-52d8e4889860",
                                                "text": "In a corner, the Darkling Beetle rustles in its Cage, its Elytra the same unforgiving white as the great sand-waste call’d ‘Kalahari’ lying north of here […]"
                                            },
                                            {
                                                "example_id": "f6fa16f4-a94d-4aa4-8b25-a7c92646c84c",
                                                "sense_id": "e76d90da-8cee-39de-a9fd-52d8e4889860",
                                                "text": "[…] the elytra covering the hind wings of the firefly lift like a light leather, suppler than any other beetle’s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
