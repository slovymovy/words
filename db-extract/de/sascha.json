                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d459efd8-0e54-402b-a6f4-83c44c0f7c65",
                                                "sense_id": "ed079773-b8b4-3286-9405-b6229b472e62",
                                                "text": "Саша предпочитала совсем не учить немецких уроков, за это на неё, как манна небесная, сыпались единицы… Саша плакала и опять не учила."
                                            }
                                        ]
                                    }
