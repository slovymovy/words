                        "form": "пристре́лочна"
                    },
                    {
                        "form_id": "2a7e2a81-4fe8-4910-a585-402e320a7369",
                        "entry_id": "64b0c9fd-79e9-3b72-9194-4db5cf957a82",
                        "tags": [
                            "plural",
