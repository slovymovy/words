        "fr-extract.jsonl": [
            {
                "entry_id": "aef7af5f-de80-38bf-ba34-0b1a2b427eb6",
                "word": "sic",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f463660e-b7f3-34cd-9ddd-f788ff52ddb1",
                        "entry_id": "aef7af5f-de80-38bf-ba34-0b1a2b427eb6",
                        "glosses": [
                            "Tel que cela a été dit ou écrit, sans modification, aussi étrange ou incorrect que cela paraisse. Il s’utilise le plus souvent en italique et entre crochets pour confirmer l’exactitude de la citation d’un texte, même dans le cas d’une erreur manifeste, d’une faute de langue ou de propos choquants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4f88954-5035-4dfa-98b9-6fa1cf639967",
                                "sense_id": "f463660e-b7f3-34cd-9ddd-f788ff52ddb1",
                                "text": "La Belgique est un État fédéral qui se compose des [sic] communautés et des [sic] régions."
                            },
                            {
                                "example_id": "0793860f-c06f-4a2a-b19e-f818397af6c3",
                                "sense_id": "f463660e-b7f3-34cd-9ddd-f788ff52ddb1",
                                "text": "Ils préparent les voies du saigneur [sic] de la démocratie, du Bonaparte que nous tient en réserve notre excellent allié et bon petit père le Tsar."
                            },
                            {
                                "example_id": "d6083fb2-6ba8-49ba-a752-4b6a2998b177",
                                "sense_id": "f463660e-b7f3-34cd-9ddd-f788ff52ddb1",
                                "text": "C’est ce « groupe intermédiaire », ce « corps central prolétaire mais héritier » (sic) qui doit, selon lui, faire l’objet de toutes les attentions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe5c3243-48a2-46f8-ac24-428eed12489c",
                        "source_entry_id": "aef7af5f-de80-38bf-ba34-0b1a2b427eb6",
                        "source_sense_id": "f463660e-b7f3-34cd-9ddd-f788ff52ddb1",
                        "source_sense_description": "Textuellement",
                        "target_lang_word": "sic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6ceb54f-7817-3434-b815-5b037d5a8ec8",
                                        "entry_id": "967dc01e-290b-36c6-880a-42543973604a",
                                        "glosses": [
                                            "Thus; as written; used to indicate, for example, that text is being quoted as it is from the source."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55670d3d-a026-40b3-bdc8-61f7a84b3a5d",
                                                "sense_id": "d6ceb54f-7817-3434-b815-5b037d5a8ec8",
                                                "text": "When it is all over they merge and go in a body to visit [...] the Telegraph Office – with plausible expressions of regret and excuses for the mob ‘which’ they say ‘is deplorably ignorant and will not be restrained when its feelings are strongly moved’ – sic, the fact being that the mob’s feelings will never be ‘moved’ unless it is by one of them."
                                            },
                                            {
                                                "example_id": "4b29fb59-5bd3-4919-a5db-e0d97959de5c",
                                                "sense_id": "d6ceb54f-7817-3434-b815-5b037d5a8ec8",
                                                "text": "Bolinger, Dwight (1977) ‘Pronoun and repeated nouns.’ Lingua18:1-34 [Quoted sic in Toolan 1990. Neither in Lingua 18, nor in the 1977 volume of that journal.]"
                                            },
                                            {
                                                "example_id": "2874e97e-6338-47ab-84d1-c5878aef5ca8",
                                                "sense_id": "d6ceb54f-7817-3434-b815-5b037d5a8ec8",
                                                "text": "Joseph Wright, his predecessor in the chair, called him ‘a firstrate Scholar and a kind of man who will easily make friends’ at Oxford (quoted, sic, in E.M. Wright, The Life of Joseph Wright (1932), p. 483)."
                                            },
                                            {
                                                "example_id": "2f8d8374-57f8-4ee6-8e53-8d0ade3e2a6a",
                                                "sense_id": "d6ceb54f-7817-3434-b815-5b037d5a8ec8",
                                                "text": "Jim’s Interests: General: Working out, hanging out at the local bars, expanding my mind, eating Tuna Sandwhiches...or so I’m told and poker... Television: ... this show that’s on Thuresday nights at 8 :30pm... I can’t place the name of it but it has this crazy interview style thing...[all sic]"
                                            },
                                            {
                                                "example_id": "b997f6ae-7c17-4f6e-b821-bdde8dd81290",
                                                "sense_id": "d6ceb54f-7817-3434-b815-5b037d5a8ec8",
                                                "text": "whole bussiness: Quoted sic in George F. Willison, Saints and Strangers (New York: Reynal and Hitchcock, 1945)"
                                            },
                                            {
                                                "example_id": "11da7713-beee-469a-9eb2-912040ab9ed3",
                                                "sense_id": "d6ceb54f-7817-3434-b815-5b037d5a8ec8",
                                                "text": "In the posting, Matthews said he wished that, “more blacks [sic] people would look into ancient beliefs of pre Christian Africa.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0188d2e-3743-371b-8231-42e1a86b7400",
                                        "entry_id": "967dc01e-290b-36c6-880a-42543973604a",
                                        "glosses": [
                                            "Used in the manner of scare quotes"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0817ffc7-09fa-4abf-bed3-b363adf66583",
                                                "sense_id": "f0188d2e-3743-371b-8231-42e1a86b7400",
                                                "text": "In the past few months, we in Upstate N.Y. have been subjected to fire bombings, firings, verbal and physical harassment, etc. The list goes on and on. These (sic) Christians are calling for a million marchers and may very well get that many."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b126ae0-c511-3bc5-ad0a-74c8676e7ce4",
                                        "entry_id": "8c78f28d-1770-3f4c-8f6c-368350dddf82",
                                        "glosses": [
                                            "To mark with a bracketed sic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07bb4f70-718c-4331-b09c-ec5d9ecadf50",
                                                "sense_id": "9b126ae0-c511-3bc5-ad0a-74c8676e7ce4",
                                                "text": "The fact is, of course, that the modern reviewer’s taste is not really shocked by half the things he sics or otherwise castigates, but he must find something to say and above all make a slow of purism."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63f9cfcb-3a3d-3aa4-b964-2339f68ac3ab",
                                        "entry_id": "5f02a7be-0c51-3b86-af18-169c1bdd64c0",
                                        "glosses": [
                                            "To incite an attack by, especially a dog or dogs."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d1e6b83-6cb4-4e75-a012-f55c272b89a2",
                                                "sense_id": "63f9cfcb-3a3d-3aa4-b964-2339f68ac3ab",
                                                "text": "He sicced his dog on me!"
                                            },
                                            {
                                                "example_id": "8815da61-8ec7-4297-9cb0-253128a9f87f",
                                                "sense_id": "63f9cfcb-3a3d-3aa4-b964-2339f68ac3ab",
                                                "text": "Phreaks can max-out 911 systems just by siccing a bunch of computer-modems on them in tandem, dialling them over and over until they clog."
                                            },
                                            {
                                                "example_id": "f585648e-51a7-438a-b486-2e1eebb90522",
                                                "sense_id": "63f9cfcb-3a3d-3aa4-b964-2339f68ac3ab",
                                                "text": "I was interviewing the victims of a harebrained scheme to sic contract killers on an innocent woman"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12e681c0-6d65-3e16-aa1a-e57784c25bc9",
                                        "entry_id": "5f02a7be-0c51-3b86-af18-169c1bdd64c0",
                                        "glosses": [
                                            "To set upon; to chase; to attack."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fc996a7-a0af-42d9-b256-c700cef9a0c6",
                                                "sense_id": "12e681c0-6d65-3e16-aa1a-e57784c25bc9",
                                                "text": "Sic ’em, Mitzi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
