                        "examples": [
                            {
                                "example_id": "19bd90c7-2560-4eab-8467-21ff075a649a",
                                "sense_id": "3378698e-76dd-34a9-803a-2977f80aaaa3",
                                "text": "„Das heutige Wissen über die Elementarteilchen und ihre Wechselwirkungen wird im Standardmodell der Elementarteilchenphysik zusammengefasst.",
                                "translation": "Today's knowledge about elementary particles and their interactions is summarized in the standard model of elementary particle physics.",
                                "english": "Today's knowledge about elementary particles and their interactions is summarized in the standard model of elementary particle physics."
                            },
                            {
                                "example_id": "0a3f7c59-42f7-4589-9b25-0d28f42db8da",
                                "sense_id": "3378698e-76dd-34a9-803a-2977f80aaaa3",
                                "text": "Die Elementarteilchenphysik ist ein interessantes Teilgebiet der Physik.",
                                "translation": "Elementary particle physics is an interesting branch of physics.",
                                "english": "Elementary particle physics is an interesting branch of physics."
                            },
                            {
                                "example_id": "8e8b7497-71ae-4395-abf4-2eed751e2851",
                                "sense_id": "3378698e-76dd-34a9-803a-2977f80aaaa3",
                                "text": "„Die »Weltmaschine« soll etliche der schwierigsten Probleme der modernen Elementarteilchenphysik und Kosmologie lösen.“",
                                "translation": "The \"world machine\" is intended to solve many of the most difficult problems of modern elementary particle physics and cosmology.",
                                "english": "The \"world machine\" is intended to solve many of the most difficult problems of modern elementary particle physics and cosmology."
                            }
                        ]
                    }
