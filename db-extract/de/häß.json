                                "example_id": "242df802-ebe7-44ba-bf61-fc8e587ce612",
                                "sense_id": "a368f17d-f3c2-3677-906a-4a5dd4c6bc5a",
                                "text": "„Häß sind alle Kleidungsstück, ond wer Dusel hot, hot Glück (…)“ [Internetbeleg]"
                            },
                            {
                                "example_id": "12e17179-6fff-483c-9994-067f63455cfe",
                                "sense_id": "a368f17d-f3c2-3677-906a-4a5dd4c6bc5a",
                                "text": "Wer sein Häß kann selber flicken, braucht es nicht zum Schneider schicken."
                            }
                        ],
