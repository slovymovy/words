                                "target_senses": [
                                    {
                                        "sense_id": "de655b8d-b254-3459-91a6-d08bfb12072a",
                                        "entry_id": "20113789-dc5a-3d3f-aa75-d3342535e90e",
                                        "glosses": [
                                            "The hand of a clock or watch face that revolves once each hour and indicates the minutes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18abf445-0745-41df-b4a2-753edb9d9ae3",
                        "source_entry_id": "97a20f9e-6326-3cc5-9db8-f9ce8189b1fb",
                        "source_sense_id": "bceec719-fa08-3b0a-9c39-ce1d71b3373c",
                        "source_sense_description": "Zeiger für Minuten",
                        "target_lang_word": "big hand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "big hand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77ada2b2-cfe2-353e-92cf-5c395f03495e",
                                        "entry_id": "bdb9dd86-f41e-360a-8f38-79525e6f2d8f",
                                        "glosses": [
                                            "Synonym of minute hand (on a clock face)."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e72627b3-3f9f-4492-a8ed-2781b7c42faa",
                                                "sense_id": "77ada2b2-cfe2-353e-92cf-5c395f03495e",
                                                "text": "When the big hand gets to the \"9\", we say that there are 15 minutes left before the next hour strikes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "054991ad-9994-3d7a-832b-a4f64b281f0f",
                                        "entry_id": "bdb9dd86-f41e-360a-8f38-79525e6f2d8f",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see big, hand: for example, a strong round of applause, a great deal of assistance, or a large body part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c29c039-3a6f-4c50-b0b2-2939968bb2ba",
                                                "sense_id": "054991ad-9994-3d7a-832b-a4f64b281f0f",
                                                "text": "What a great job these kids have done today! Let's give them a big hand, everybody! [hearty applause]"
                                            },
                                            {
                                                "example_id": "d52c4bb3-2bd8-4461-9991-bed8ce1e1322",
                                                "sense_id": "054991ad-9994-3d7a-832b-a4f64b281f0f",
                                                "text": "Several people gave me a hand with getting this work done on time. In particular, Sean gave me a really big hand with the number-crunching."
                                            },
                                            {
                                                "example_id": "065769f0-243b-4f5b-a30c-f6962803d7cb",
                                                "sense_id": "054991ad-9994-3d7a-832b-a4f64b281f0f",
                                                "text": "My grandfather had very big hands. They were so big that some of his classmates when he was a child even teased him about it — that is, the ones who dared! He would reply by asking whether they were looking for a slap or a punch!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb80ccff-4314-4eed-adaa-5f9253d0ee3e",
                        "source_entry_id": "97a20f9e-6326-3cc5-9db8-f9ce8189b1fb",
