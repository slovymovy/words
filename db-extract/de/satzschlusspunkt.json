                "senses": [
                    {
                        "sense_id": "096b7a49-128e-340b-ba95-d8551d4c2526",
                        "entry_id": "4456fa50-cdbe-3812-b9f6-fea8201c09e7",
                        "glosses": [
                            "Satzzeichen, das das Ende eines Satzes (vor allem eines Aussagesatzes) markiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86749f8e-2323-4b6f-a432-360b1e1c25b0",
                                "sense_id": "096b7a49-128e-340b-ba95-d8551d4c2526",
                                "text": "„Stehen Auslassungspunkte am Satzende, entfällt der Satzschlusspunkt <§ 100>.“"
                            },
                            {
                                "example_id": "e6910a4a-821d-49ed-8374-6c329f2df71f",
                                "sense_id": "096b7a49-128e-340b-ba95-d8551d4c2526",
                                "text": "„Da der Punkt für verschiedene Kürzel bereits vergeben ist, wird der Satzschlusspunkt durch einen rechtsschrägen Schrägstrich (neuer Absatz zwei Schrägstriche) ersetzt.“"
                            },
                            {
                                "example_id": "5ea3f6ce-2e8c-463d-bd91-6f9d563e9c94",
                                "sense_id": "096b7a49-128e-340b-ba95-d8551d4c2526",
                                "text": "„Für folgende Satzzeichen gilt: Der Satzschlusspunkt entfällt, andere Satzzeichen werden direkt nach den drei Punkten angeschlossen.“"
                            },
                            {
                                "example_id": "fec7fce4-7c7a-4267-a500-9738bee823c5",
                                "sense_id": "096b7a49-128e-340b-ba95-d8551d4c2526",
                                "text": "„Anmerkung: Wenn an einem Satzende zwei Punkte aufeinander treffen, durch einen Abkürzungspunkt und einen Satzschlusspunkt, wird dennoch nur ein Punkt geschrieben.“"
                            },
                            {
                                "example_id": "54dea812-a42e-4cd1-be4e-c4e3fa26b008",
                                "sense_id": "096b7a49-128e-340b-ba95-d8551d4c2526",
                                "text": "„Steht dieser Textteil wie im Beispiel oben am Satzende, dann enthalten diese drei Punkte auch den Satzschlusspunkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
