{
    "word_family": [
        "suspendre",
        "suspens",
        "suspensif",
        "suspenseur"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5104e951-245e-3396-a52a-0083d557e218",
                    "sense_definition": "Interruption ou arrêt temporaire d'une activité, d'un événement ou d'un processus.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "interruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le président de l'assemblée a demandé une brève <w>suspension</w> de séance."
                        },
                        {
                            "text": "La neige abondante a provoqué la <w>suspension</w> temporaire des vols à l'aéroport."
                        }
                    ],
                    "synonyms": [
                        "interruption",
                        "arrêt",
                        "pause",
                        "trêve"
                    ],
                    "antonyms": [
                        "reprise",
                        "continuation",
                        "maintien"
                    ],
                    "common_phrases": [
                        "suspension de séance",
                        "suspension temporaire",
                        "suspension des cours"
                    ]
                },
                {
                    "sense_id": "ba0211f7-2ba2-32f1-ae7d-cd730ddff39d",
                    "sense_definition": "Appareil d'éclairage fixé au plafond et pendant au bout d'un câble ou d'une chaîne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "luminaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont acheté une belle <w>suspension</w> en rotin pour éclairer la salle à manger."
                        },
                        {
                            "text": "La lumière douce de la <w>suspension</w> crée une atmosphère chaleureuse dans la pièce."
                        }
                    ],
                    "synonyms": [
                        "lustre",
                        "plafonnier"
                    ],
                    "common_phrases": [
                        "suspension lumineuse",
                        "suspension design"
                    ]
                },
                {
                    "sense_id": "778abc43-3b67-3216-a8dd-7359116a5f1f",
                    "sense_definition": "Interruption de la parole ou de la pensée, souvent marquée dans le texte par une suite de trois points.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "typographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur utilise des points de <w>suspension</w> pour laisser planer le doute."
                        },
                        {
                            "text": "Une longue <w>suspension</w> dans sa voix montrait clairement son hésitation."
                        }
                    ],
                    "common_phrases": [
                        "points de suspension"
                    ]
                },
                {
                    "sense_id": "fc1544c1-10bb-3c1f-acaf-065ad79358f3",
                    "sense_definition": "Ensemble des organes mécaniques d'un véhicule qui amortissent les chocs causés par les irrégularités de la route.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette voiture offre un confort remarquable grâce à sa <w>suspension</w> souple."
                        },
                        {
                            "text": "Le garagiste a vérifié l'état de la <w>suspension</w> avant le départ en vacances."
                        }
                    ],
                    "synonyms": [
                        "amortisseur"
                    ],
                    "common_phrases": [
                        "suspension hydraulique",
                        "système de suspension",
                        "suspension pneumatique"
                    ]
                },
                {
                    "sense_id": "64fe30ce-05a0-3d22-b09e-506140a8ab57",
                    "sense_definition": "Mesure disciplinaire privant temporairement une personne de l'exercice de ses fonctions, d'un droit ou d'un titre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sanction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'automobiliste imprudent a reçu une <w>suspension</w> de permis de six mois."
                        },
                        {
                            "text": "Le joueur a écopé d'une lourde <w>suspension</w> après son comportement violent."
                        }
                    ],
                    "synonyms": [
                        "exclusion",
                        "mise à pied"
                    ],
                    "antonyms": [
                        "réintégration"
                    ],
                    "common_phrases": [
                        "suspension de permis",
                        "suspension disciplinaire",
                        "suspension de fonction"
                    ]
                },
                {
                    "sense_id": "17e8e2ef-4bc7-316a-a41d-23f58cf00987",
                    "sense_definition": "Action de suspendre un objet à une attache ou état de ce qui est suspendu dans l'air.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La solidité du câble garantit la bonne <w>suspension</w> de la passerelle au-dessus du fleuve."
                        },
                        {
                            "text": "L'acrobate a réalisé une impressionnante figure en <w>suspension</w> au milieu de la piste."
                        }
                    ],
                    "synonyms": [
                        "accrochage"
                    ],
                    "common_phrases": [
                        "point de suspension",
                        "en suspension"
                    ]
                },
                {
                    "sense_id": "4c9f67a4-4cb4-34de-9121-559ff563aa64",
                    "sense_definition": "Mélange constitué de particules solides très fines dispersées au sein d'un liquide ou d'un gaz sans s'y dissoudre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut bien agiter cette <w>suspension</w> buvable avant de la donner à l'enfant."
                        },
                        {
                            "text": "L'eau du ruisseau est devenue trouble à cause des fines particules d'argile en <w>suspension</w>."
                        }
                    ],
                    "synonyms": [
                        "dispersion"
                    ],
                    "antonyms": [
                        "solution"
                    ],
                    "common_phrases": [
                        "particules en suspension",
                        "suspension buvable"
                    ]
                }
            ]
        }
    ]
}