                ],
                "senses": [
                    {
                        "sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
                        "entry_id": "9d8d46d1-a0a3-3511-bccd-85b8644f820e",
                        "glosses": [
                            "weibliche Person, die sich eine Vorführung oder Veranstaltung ansieht (zum Beispiel ein Theaterstück, ein Film, eine Fernsehsendung, eine Sportveranstaltung)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce3dfd6-5900-475f-a393-17a3093e3404",
                                "sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
                                "text": "Die zahlreichen Zuschauerinnen freuten sich lautstark über den Boxkampf, was ihn befremdete."
                            },
                            {
                                "example_id": "61b7f9db-28e4-4e8d-bf4e-6cf2d52e0e4c",
                                "sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
                                "text": "„Durch einen Zufall, und weil sie nichts zu tun hatte, geriet sie als Zuschauerin in einen Prozeß in einen Gerichtssaal in Frankfurt.“"
                            },
                            {
                                "example_id": "3bbcdb91-f194-413d-9132-c5c11adb7a50",
                                "sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
                                "text": "„Sie saß da wie eine Zuschauerin in einer Theateraufführung.“"
                            },
                            {
                                "example_id": "faca24ee-7ba7-4d54-ab89-d148a34fcf4d",
                                "sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
                                "text": "„Ich erblickte die schönsten Damen von Turin, die sich in ihrer Eigenschaft als Zuschauerinnen einbilden konnten, man gebe den Ball nur für sie.“"
                            },
                            {
                                "example_id": "0d7d99f4-e677-4734-96d3-82c64aae7b7e",
                                "sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
                                "text": "„Als ich vor einiger Zeit ein Gastspiel in Köln gab, kam ich während der Pause mit einer Zuschauerin ins Gespräch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33d743c4-8d42-4003-8462-262e2ccc4cc2",
                        "source_entry_id": "9d8d46d1-a0a3-3511-bccd-85b8644f820e",
                        "source_sense_id": "1d4658ee-7480-343b-8fb2-5a23462d3941",
