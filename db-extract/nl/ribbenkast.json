                                "target_senses": [
                                    {
                                        "sense_id": "5c9ece0a-8892-394a-b5db-90cd0b86535a",
                                        "entry_id": "5c38ec64-4ec3-3e24-8433-9e39198df8fa",
                                        "glosses": [
                                            "A part of the skeleton within the thoracic area consisting of ribs, sternum and thoracic vertebrae."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
