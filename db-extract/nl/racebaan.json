                                "target_senses": [
                                    {
                                        "sense_id": "2926b1de-7458-3792-922a-983634127897",
                                        "entry_id": "4d599129-cdd3-3c07-bd59-5217ae461436",
                                        "glosses": [
                                            "hergerichtete Strecke für Rennveranstaltungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b57bfbd5-1dff-4fa1-ae71-43d153ebbe73",
                                                "sense_id": "2926b1de-7458-3792-922a-983634127897",
                                                "text": "„Die Bohémiens gehen jetzt ins Romanische Café, in dessen kuppelförmiger Halle die unter Kettenhändlern von der Rennbahn und Börsenspekulanten ein ziemlich geduldetes Dasein fristen.“"
                                            },
                                            {
                                                "example_id": "b7ff8707-fdcc-4140-8415-a6e3a9137118",
                                                "sense_id": "2926b1de-7458-3792-922a-983634127897",
                                                "text": "„Die Rennbahn hatte geschlossen, und es sah nach Regen aus.“"
                                            },
                                            {
                                                "example_id": "10c74520-b7c3-4bb7-8f7a-71e06d1ea005",
                                                "sense_id": "2926b1de-7458-3792-922a-983634127897",
                                                "text": "„Wenn ich konnte, betätigte ich mich während der Saison auf zwei Rennbahnen, Auteuil und Enghien."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b3f0337-5478-4821-80eb-602447953fc8",
                        "source_entry_id": "cf301ac4-9739-3eda-995d-e90ee62fddbb",
                        "source_sense_id": "d4ccd096-b8ba-34d2-a491-e3d763d8b9d2",
                        "source_sense_description": "een baan om snelheidswedstrijden op te houden",
                        "target_lang_word": "racetrack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "racetrack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54bf8fd7-196c-3897-aced-e33b91512226",
                                        "entry_id": "f067a2a3-fdd9-397f-9e2b-0305d7f54e86",
                                        "glosses": [
                                            "A course over which any type of races are run."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bbf387a-98f6-4793-9352-a69d5bd8721d",
                                                "sense_id": "54bf8fd7-196c-3897-aced-e33b91512226",
                                                "text": "During the 2018-2019 season, a staggering 56 horses died at one of the most glamorous racetracks in the country, Santa Anita Park, once home to the famous 1940s thoroughbred Seabiscuit. […] Most of the horse deaths Battuello has identified are based on state records, although a handful are based on news reports or verbal confirmation he received from racetrack officials."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08a3ef40-0e83-38ee-bb4b-fbd8eefa79a8",
                                        "entry_id": "f067a2a3-fdd9-397f-9e2b-0305d7f54e86",
                                        "glosses": [
                                            "A characteristic circular erosion pattern in deposition processes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9c0ed0c-ff8b-4891-bbbb-7e7f41096bfd",
                        "source_entry_id": "cf301ac4-9739-3eda-995d-e90ee62fddbb",
                        "source_sense_id": "d4ccd096-b8ba-34d2-a491-e3d763d8b9d2",
                        "source_sense_description": "een baan om snelheidswedstrijden op te houden",
                        "target_lang_word": "circuit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circuit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f5c3cd4f-ec1b-3ec7-8be2-6eb5f55f3efd",
                                        "entry_id": "141196e6-60d8-318b-9562-a272b5de9a9c",
                                        "glosses": [
                                            "Pourtour d’un lieu déterminé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d0769d6-a531-4cbd-b1ce-2bcb62818d13",
                                                "sense_id": "f5c3cd4f-ec1b-3ec7-8be2-6eb5f55f3efd",
                                                "text": "En remplaçant les moulins à vent par les moulins à vapeur, on acheva en trente-neuf mois la grande entreprise du dessèchement du lac de Haarlem, qui avait quarante-quatre kilomètres de circuit."
                                            },
                                            {
                                                "example_id": "931db1a9-9585-4f00-8ce6-3c7abf77c75e",
                                                "sense_id": "f5c3cd4f-ec1b-3ec7-8be2-6eb5f55f3efd",
                                                "text": "Puis, à certains tournants, quelques quinquets rougeoyaient indiquant le circuit que l’on décrivait dans ces atermoiements de lumière et d’ombre."
                                            },
                                            {
                                                "example_id": "fd679964-8a90-47e6-90f4-456e79728472",
                                                "sense_id": "f5c3cd4f-ec1b-3ec7-8be2-6eb5f55f3efd",
                                                "text": "Il paraît, nous a-t-on dit un jour, qu'il existe à Châteauneuf-le-Rouge un labyrinthe de buis si vaste, que le jardinier a besoin de l'année entière pour le tailler : il commence à un bout, et, lorsqu'il arrive à la fin du tracé, recommence un nouveau circuit et une nouvelle année."
                                            },
                                            {
                                                "example_id": "af42205c-122b-4d4d-a5e8-4703f9e47160",
                                                "sense_id": "f5c3cd4f-ec1b-3ec7-8be2-6eb5f55f3efd",
                                                "text": "Le circuit de la ville. — Le circuit des murailles."
                                            },
                                            {
                                                "example_id": "d60e8882-9cba-43a6-83b8-75a1961527fa",
                                                "sense_id": "f5c3cd4f-ec1b-3ec7-8be2-6eb5f55f3efd",
                                                "text": "Le circuit touristique, ou simplement circuit est un produit de l'industrie touristique comprenant des nuitées dans plusieurs sites différents ainsi que le transport entre ces différents sites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e041446-8bcd-33bc-bf43-8cfc6c32e085",
                                        "entry_id": "141196e6-60d8-318b-9562-a272b5de9a9c",
                                        "glosses": [
                                            "Chemin fixé d’avance que doivent parcourir tous les concurrents d’une course pour revenir au point de départ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ed349e1-bf47-45ea-9c8f-a7ff3ab64d46",
                                                "sense_id": "3e041446-8bcd-33bc-bf43-8cfc6c32e085",
                                                "text": "La décision sur la tenue de l’édition 2021 de cet événement, prévue le 13 juin sur le circuit Gilles-Villeneuve à Montréal, est très attendue."
                                            },
                                            {
                                                "example_id": "e6399b52-364c-4810-afa4-1ff1ed52b805",
                                                "sense_id": "3e041446-8bcd-33bc-bf43-8cfc6c32e085",
                                                "text": "Puis je suis parti pour le circuit de Cornadieu et la compétition internationale de grasstrack, une course de motos au cours de laquelle des pilotes s’affrontent en tournant en rond sur un piste de terre et dont la ville possède un des rares circuits en France."
                                            },
                                            {
                                                "example_id": "5cdd97ec-091c-4832-a599-831e5232503d",
                                                "sense_id": "3e041446-8bcd-33bc-bf43-8cfc6c32e085",
                                                "text": "Le circuit Paris-Bordeaux."
                                            },
                                            {
                                                "example_id": "2d60752e-c44f-44a7-aa99-af3295d7053a",
                                                "sense_id": "3e041446-8bcd-33bc-bf43-8cfc6c32e085",
                                                "text": "Le circuit des Vosges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16df972f-35bc-3e55-a3b0-055a3bb176d4",
                                        "entry_id": "141196e6-60d8-318b-9562-a272b5de9a9c",
                                        "glosses": [
                                            "Détour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "967be511-9efc-482a-9dca-41eded1c1f12",
                                                "sense_id": "16df972f-35bc-3e55-a3b0-055a3bb176d4",
                                                "text": "J’ai fait un long circuit, un grand circuit pour arriver chez moi."
                                            },
                                            {
                                                "example_id": "315fd50f-d931-47ac-86ca-d8e1f6651953",
                                                "sense_id": "16df972f-35bc-3e55-a3b0-055a3bb176d4",
                                                "text": "circuit de paroles, Tout ce qu’on dit avant de venir au fait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "992086a5-7294-3cfc-ad41-f2dd3ec9c581",
                                        "entry_id": "141196e6-60d8-318b-9562-a272b5de9a9c",
                                        "glosses": [
                                            "Parcours organisé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd2475e9-d893-4993-b7af-f41b32bf6bd2",
                                                "sense_id": "992086a5-7294-3cfc-ad41-f2dd3ec9c581",
                                                "text": "De même, se repose la logique des circuits du propre et du sale, avec la lancinante question du lave-linge qui trouve difficilement sa place, surtout depuis qu'il est accompagné d'un sèche-linge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35638a6c-eaf5-323f-b34e-37828d9daef7",
                                        "entry_id": "141196e6-60d8-318b-9562-a272b5de9a9c",
                                        "glosses": [
                                            "Contour d’intégration qui contient tous les points critiques de la fonction que l’on intègre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d8b1fb7-8c03-337e-912d-a6791f2c7a43",
                                        "entry_id": "141196e6-60d8-318b-9562-a272b5de9a9c",
                                        "glosses": [
                                            "Ensemble des corps parcourus par le courant électrique et qui doivent former avec la source d’électricité une chaîne continue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ef8afb2-a9e4-4397-8fd3-550ce4b08cb2",
                                                "sense_id": "4d8b1fb7-8c03-337e-912d-a6791f2c7a43",
                                                "text": "Quand le circuit est fermé, le courant passe."
                                            },
                                            {
                                                "example_id": "3845cdc3-68fe-4d98-8f95-8e4907add7bb",
                                                "sense_id": "4d8b1fb7-8c03-337e-912d-a6791f2c7a43",
                                                "text": "Quand le circuit est ouvert ou rompu, le courant est interrompu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7391446-bf27-3ccd-b219-054a70c6bc63",
                                        "entry_id": "141196e6-60d8-318b-9562-a272b5de9a9c",
                                        "glosses": [
                                            "Connexion établie entre deux terminaux"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5e3853aa-4a8b-38eb-983a-c8e839acceea",
                                        "entry_id": "141196e6-60d8-318b-9562-a272b5de9a9c",
                                        "glosses": [
                                            "Abréviation de coup de circuit, permettant au frappeur de toucher les quatre bases et ainsi marquer un point, sans avoir à s’immobiliser à l’une d’elles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39f72a55-e19b-4a7a-8235-b476388d9bb1",
                                                "sense_id": "5e3853aa-4a8b-38eb-983a-c8e839acceea",
                                                "text": "Le frappeur ambidextre Kendrys Morales est devenu le troisième joueur de l'histoire des majeures à frapper un circuit de chaque côté du marbre …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
