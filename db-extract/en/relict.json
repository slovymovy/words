                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a90831d-b725-4b1d-8d4f-7e18bb3d6c8a",
                        "source_entry_id": "3ff604f5-4c94-3bfe-a53f-fd181214114d",
                        "source_sense_id": "1be3b76c-b7ce-3faf-9cf6-25f792f37a96",
                        "source_sense_description": "Überrest, Relikt",
                        "target_lang_word": "Überrest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überrest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22f302a5-2a27-34ee-8dae-1750567042b3",
                                        "entry_id": "68b1d8e4-0a0a-3eb3-baa0-b10cc10e286c",
                                        "glosses": [
                                            "relativ kleine, übrig gebliebene Menge, letzter Rest"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fd18c54-b822-41fa-8df7-24eee943159d",
                                                "sense_id": "22f302a5-2a27-34ee-8dae-1750567042b3",
                                                "text": "„Für die Aylesford-Swarling-Kultur (in der Zeit kurz vor Christi Geburt) im Südosten Englands sind die ansonsten seltenen Brandgräber, in denen die Überreste verbrannter Toter beigesetzt wurden, mit vielen Grabbeigaben kennzeichnend.“"
                                            },
                                            {
                                                "example_id": "5d1b9dd3-2dbe-41cf-b96e-c3f2cfcaa57e",
                                                "sense_id": "22f302a5-2a27-34ee-8dae-1750567042b3",
                                                "text": "„Im Boden fressen Amöben andere Mikroben wie auch Überreste größerer Lebewesen.“"
                                            },
                                            {
                                                "example_id": "755c54e2-18f7-4765-92d9-949fe51eb5c1",
                                                "sense_id": "22f302a5-2a27-34ee-8dae-1750567042b3",
                                                "text": "„Ihre sterblichen Überreste ruhen heute unter einem Hügel.“"
                                            },
                                            {
                                                "example_id": "71df9714-696f-4a1c-a3d5-cd7e30a9adc2",
                                                "sense_id": "22f302a5-2a27-34ee-8dae-1750567042b3",
                                                "text": "„Sie rafft die Überreste ihres Mutes zusammen und wählt noch einmal die gleiche Nummer.“"
                                            },
                                            {
                                                "example_id": "8abf5cf4-16b4-4e32-9edd-ebc93fd3296c",
                                                "sense_id": "22f302a5-2a27-34ee-8dae-1750567042b3",
                                                "text": "„Mit russischer Laune und den Überresten sibirischer Wurst in meinem Körper ziehe ich also mit Sara los, um Menschen kennenzulernen, die uns nicht kennenlernen wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7de707f5-3cef-48b2-9384-42360a9093f0",
                        "source_entry_id": "3ff604f5-4c94-3bfe-a53f-fd181214114d",
                        "source_sense_id": "1be3b76c-b7ce-3faf-9cf6-25f792f37a96",
                        "source_sense_description": "Überrest, Relikt",
                        "target_lang_word": "Relikt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Relikt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4249c21-bd1d-3818-894e-dbb11dba8d24",
                                        "entry_id": "de39254c-466b-3f21-810c-35ffbb3538c3",
                                        "glosses": [
                                            "Überbleibsel aus einer vergangenen Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a815b13-6fd6-4bca-937a-6a0dcfb4e848",
                                                "sense_id": "a4249c21-bd1d-3818-894e-dbb11dba8d24",
                                                "text": "„Initiationsriten scheinen in unserer modernen Gesellschaft zu den Relikten vergangener Epochen zu gehören. Und doch begegnen sie uns auch in der Moderne in vielen gesellschaftlichen Bereichen.“"
                                            },
                                            {
                                                "example_id": "22b927d7-c772-492a-a4d1-b9d37c504d48",
                                                "sense_id": "a4249c21-bd1d-3818-894e-dbb11dba8d24",
                                                "text": "„Die Frage nach Gott, nach dem Sinn des menschlichen Lebens, nach dem Wesen des Menschen oder nach den großen Zusammenhängen erschien den meisten Vertretern der Wissenschaft unwissenschaftlich und wurde als Relikt einer überwundenen Zeit angesehen.“"
                                            },
                                            {
                                                "example_id": "2640a88d-7fd6-45b9-95bf-86e144a4e128",
                                                "sense_id": "a4249c21-bd1d-3818-894e-dbb11dba8d24",
                                                "text": "„Er will vom Rummel um seine Person nichts mehr wissen, die Frau stirbt, er sitzt wieder auf dem Kutschbock, bei jedem Wetter, ein Relikt aus vergangener Zeit.“"
                                            },
                                            {
                                                "example_id": "f917dd77-e4ad-4f79-a581-79ec8408b7d1",
                                                "sense_id": "a4249c21-bd1d-3818-894e-dbb11dba8d24",
                                                "text": "Überall stößt man auf Relikte einer alten Hochkultur."
                                            },
                                            {
                                                "example_id": "a31269f1-ae7a-4bc0-bf78-1c31910788d3",
                                                "sense_id": "a4249c21-bd1d-3818-894e-dbb11dba8d24",
                                                "text": "Das sind doch Relikte aus den frühen 80-ern!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85cfea75-8e0a-37cb-b4e1-94c6700a4cef",
                                        "entry_id": "de39254c-466b-3f21-810c-35ffbb3538c3",
                                        "glosses": [
                                            "Überbleibsel aus einem früheren Zustand einer Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c30dd3ec-f1f1-42fe-8a83-b137b9c166c7",
                                                "sense_id": "85cfea75-8e0a-37cb-b4e1-94c6700a4cef",
                                                "text": "Die Wendung „mit Kind und Kegel“ ist das Relikt einer alten Bedeutung des Wortes „Kegel“."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
