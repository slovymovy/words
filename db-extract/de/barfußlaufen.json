                        "sense_id": "ebd4456e-c11f-38cf-b1ed-590ed5f7b5a4",
                        "entry_id": "9dee8dc7-0e2e-3c06-8913-307d6a090fd8",
                        "glosses": [
                            "Fortbewegung mit bloßen Füßen (ohne Schuhe)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa9c99d5-7206-410e-b358-501dea2395bc",
                                "sense_id": "ebd4456e-c11f-38cf-b1ed-590ed5f7b5a4",
                                "text": "„Das Barfußlaufen ist die natürlichste Art des Gehens.“"
                            },
                            {
                                "example_id": "bcef9ebc-2da1-49eb-962f-7198df94d89a",
                                "sense_id": "ebd4456e-c11f-38cf-b1ed-590ed5f7b5a4",
                                "text": "„Barfußlaufen hat eine besondere Bedeutung im Bereich natürlicher Bewegung und im Kontext Gesundheit.“"
                            },
                            {
                                "example_id": "8339959b-4542-4071-88b7-fbcdd47620fb",
                                "sense_id": "ebd4456e-c11f-38cf-b1ed-590ed5f7b5a4",
                                "text": "„Barfußlaufen bietet nicht nur eine natürliche, sondern auch eine äußerst effektive Möglichkeit, Ihre Gesundheit und Ihr Wohlbefinden zu steigern.“"
                            },
                            {
                                "example_id": "801205ea-06df-41a9-82a8-afd1301210c6",
                                "sense_id": "ebd4456e-c11f-38cf-b1ed-590ed5f7b5a4",
                                "text": "„Er fühlte sich beim Barfußlaufen im Schlamm wohl.“"
                            },
                            {
                                "example_id": "3a8b9ab8-b449-4aea-8150-2d033ddf7e3e",
                                "sense_id": "ebd4456e-c11f-38cf-b1ed-590ed5f7b5a4",
                                "text": "„Kein Wunder: Sowohl Barfußschuhe als auch Minimalschuhe beschreiben den gleichen Typ Schuh –eine breite Zehenbox und eine dünne, flexible Sohle sollen dem Gefühl von Barfußlaufen möglichst nahekommen.“"
                            }
                        ],
