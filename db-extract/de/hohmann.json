                ],
                "senses": [
                    {
                        "sense_id": "cd71e1ca-ca05-3eab-80fe-06fe711e0141",
                        "entry_id": "f4fcf998-47fb-31a6-926a-56995575eca2",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac8b1b88-a2f4-47ff-8598-020b79f989f3",
                                "sense_id": "cd71e1ca-ca05-3eab-80fe-06fe711e0141",
                                "text": "Frau Hohmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f503a73e-522a-4d6b-b639-f8579f790b6a",
                                "sense_id": "cd71e1ca-ca05-3eab-80fe-06fe711e0141",
                                "text": "Herr Hohmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f08bfcba-1a03-4e51-9256-386fa2894cc5",
                                "sense_id": "cd71e1ca-ca05-3eab-80fe-06fe711e0141",
                                "text": "Die Hohmanns fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "56094411-ffcd-4a97-8147-a30d1c853279",
                                "sense_id": "cd71e1ca-ca05-3eab-80fe-06fe711e0141",
                                "text": "Der Hohmann trägt nie die Schals, die die Hohmann ihm strickt."
                            },
                            {
                                "example_id": "723a3ee5-6f26-4abf-b020-5796f9252361",
                                "sense_id": "cd71e1ca-ca05-3eab-80fe-06fe711e0141",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hohmann kommt, geht der Herr Hohmann.“"
                            },
                            {
                                "example_id": "d5446551-a5f3-48e6-a3b1-f85ae0b451e0",
                                "sense_id": "cd71e1ca-ca05-3eab-80fe-06fe711e0141",
                                "text": "Hohmann kommt und geht."
                            },
                            {
                                "example_id": "8599944e-61f4-42ee-af6f-fd7a9694dd65",
                                "sense_id": "cd71e1ca-ca05-3eab-80fe-06fe711e0141",
                                "text": "Hohmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
