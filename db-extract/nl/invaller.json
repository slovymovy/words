                    {
                        "sense_id": "de143322-3c2c-37fc-9a9b-1c5fa80cbdb8",
                        "entry_id": "1c869e6c-b7ee-3c62-9437-0eb8f2c59438",
                        "glosses": [
                            "Iemand die plotseling de taak van iemand anders moet overnemen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eabd6b6f-20a1-4680-9306-1186283a36d6",
                                "sense_id": "de143322-3c2c-37fc-9a9b-1c5fa80cbdb8",
                                "text": "Hij speelde één interland: op 27 september 1953 speelde hij als invaller bij het Nederlands voetbalelftal 20 minuten in de vriendschappelijke wedstrijd tegen Noorwegen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
