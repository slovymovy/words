                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05729403-fe16-3c8b-b3f0-bd724ed2caa9",
                                        "entry_id": "f3e4c3ad-a273-3293-b1cf-b3af57d663d9",
                                        "glosses": [
                                            "A person from Bosnia and Herzegovina or of Bosnian descent."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10d39e43-dd00-43ac-bf9b-f11c06bb4326",
                                                "sense_id": "05729403-fe16-3c8b-b3f0-bd724ed2caa9",
                                                "text": "Ten days later, however, the deal was dead, largely because the United States opposed it and persuaded the Bosnians to do the same, or so Gibbs argues."
