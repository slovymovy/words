                        "sense_id": "158ec0cf-9dc2-31f5-9ffc-8c171548a325",
                        "entry_id": "2ab385bb-5368-3829-b212-1ba82617d0d9",
                        "glosses": [
                            "een paard dat geschikt is met een zadel bereden te worden"
                        ],
                        "tags": [
                            "paardrijden"
                        ],
                        "examples": [
                            {
                                "example_id": "1e79c0f2-5f70-444f-aab5-98857cc34de6",
                                "sense_id": "158ec0cf-9dc2-31f5-9ffc-8c171548a325",
                                "text": "Een tuig- of trekpaard heeft rechtere schouders dan een zadelpaard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07404af6-f954-46fd-b84c-a095dc33dbea",
                        "source_entry_id": "2ab385bb-5368-3829-b212-1ba82617d0d9",
                        "source_sense_id": "158ec0cf-9dc2-31f5-9ffc-8c171548a325",
                        "source_sense_description": "voor rijden geschikt paard",
                        "target_lang_word": "Reitpferd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reitpferd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e174287-5400-3f3e-b881-7e8496873e3f",
                                        "entry_id": "1cd7a09d-19ed-3554-9b76-37e24899219e",
                                        "glosses": [
                                            "Pferd, auf dem man reiten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "975a3a25-4a1d-431a-8a41-113ef3721a71",
                                                "sense_id": "2e174287-5400-3f3e-b881-7e8496873e3f",
                                                "text": "„Dann gingen wir zum Korral, wo die Tochter des Hauses ein Reitpferd trainierte, einen talentierten Hengst namens Specklebottom.“"
                                            },
                                            {
                                                "example_id": "c70ff055-3c26-4cd4-81d6-2336079288c5",
                                                "sense_id": "2e174287-5400-3f3e-b881-7e8496873e3f",
                                                "text": "„Noch am Leben waren auch an die tausend Zugochsen und mehr als hunderttausend Pferde, die die Kanonen und Kutschen bis nach Borodino gezogen hatten, dazu die Reitpferde der Garde und die Kavalleriepferde des Königs von Neapel.“"
                                            },
                                            {
                                                "example_id": "84578b11-3e7f-42a7-8ac5-42336d1816e4",
                                                "sense_id": "2e174287-5400-3f3e-b881-7e8496873e3f",
                                                "text": "„Fürst Andrej kam an Kutusows Equipage und an den Reitpferden der Suite und den laut miteinander plaudernden Kosaken vorüber und betrat den Hausflur.“"
                                            },
                                            {
                                                "example_id": "9fac96ac-fece-409f-aee3-0fe52c6dce7c",
                                                "sense_id": "2e174287-5400-3f3e-b881-7e8496873e3f",
                                                "text": "„Das Hauptproblem aller Reiterkriegerstaaten war die Unterhaltung von Hunderttausenden von für den Kriegsdienst geeigneten Reitpferden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b871ab93-b9ed-4537-b2a3-834d8b12e85a",
                        "source_entry_id": "2ab385bb-5368-3829-b212-1ba82617d0d9",
