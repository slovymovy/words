                        "target_lang_word": "вишня",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вишня",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9a7e977b-6189-3845-8555-d5fff8a9cdfa",
                                        "entry_id": "512f0257-8edd-328e-93e6-cad5e05fb7ac",
                                        "glosses": [
                                            "ботан. плодовое растение из рода слив семейства розоцветных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4399622-6c82-43d2-a7b2-84ea042cba14",
                                                "sense_id": "9a7e977b-6189-3845-8555-d5fff8a9cdfa",
                                                "text": "Встреча со старым другом всегда овеяна ароматом цветущей вишни, говорят в моей стране."
                                            },
                                            {
                                                "example_id": "018b13d1-a9d4-4929-b6cb-fdb6745fbf4d",
                                                "sense_id": "9a7e977b-6189-3845-8555-d5fff8a9cdfa",
                                                "text": "За раскрытым проёмом стены лежал дремлющий сад. Смутно белели осыпанные цветом вишни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91ed87fc-dd19-303c-ba07-1557f269e621",
                                        "entry_id": "512f0257-8edd-328e-93e6-cad5e05fb7ac",
                                        "glosses": [
                                            "плод вишни [1], сочная костянка красного цвета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08457a5c-7ee4-43e5-b7ba-0e6b96859504",
                                                "sense_id": "91ed87fc-dd19-303c-ba07-1557f269e621",
                                                "text": "Купить вишни"
                                            },
                                            {
                                                "example_id": "59b09c38-7949-4a43-873d-15e4dab0746f",
                                                "sense_id": "91ed87fc-dd19-303c-ba07-1557f269e621",
                                                "text": "Поесть вишен"
                                            },
                                            {
                                                "example_id": "1bbeaf1d-7a28-4a5d-b9f7-84260cc7c906",
                                                "sense_id": "91ed87fc-dd19-303c-ba07-1557f269e621",
                                                "text": "Ему таки удалось скрестить клубнику с крыжовником, а вишни стали размером хоть и не с азиатскую сливу, но изрядно покрупнели."
                                            },
                                            {
                                                "example_id": "198a376c-34a1-4abb-ac2e-3d5966b66895",
                                                "sense_id": "91ed87fc-dd19-303c-ba07-1557f269e621",
                                                "text": "Красные пятна, вспыхнувшие вдруг в разных местах на её щеках, чем-то походили на вишни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5070993-f899-39f9-abb6-2add9c505c4f",
                                        "entry_id": "512f0257-8edd-328e-93e6-cad5e05fb7ac",
                                        "glosses": [
                                            "древесина вишни [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "568414f2-d6b5-4be2-a97e-8287aaf21ff5",
                                                "sense_id": "f5070993-f899-39f9-abb6-2add9c505c4f",
                                                "text": "Этот стол сделан из вишни."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
