                        "entry_id": "98173999-1b6f-3c71-8d6b-8c1f0439e6b3",
                        "glosses": [
                            "die Gehirn-Rückenmark-Flüssigkeit ( Gehirnwasser) ist klar, zellarm und zirkuliert im Hohlraumsystem des Gehirns"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "864b2c13-c12e-4412-abaa-c56ed75bc7fe",
                                "sense_id": "0b9a182b-05ce-3bb2-82e2-852c0ea07680",
                                "text": "Unter dem Begriff Liquor cerebrospinalis versteht man die Gehirn- und Rückenmarksflüssigkeit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d935bf8d-b293-3e4a-86b4-d8b1f2299867",
                        "entry_id": "98173999-1b6f-3c71-8d6b-8c1f0439e6b3",
                        "glosses": [
                            "Flüssigkeit im Herzbeutel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "482d8657-df98-48aa-ab27-3c0359666003",
                                "sense_id": "d935bf8d-b293-3e4a-86b4-d8b1f2299867",
                                "text": "Der vom Epikard gebildet Liquor pericardii befeuchtet den Spaltraum zwischen dem viszeralen und parietalen Blatt des Herzbeutels."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6fbbf561-40eb-39e7-9957-777b5edc2592",
                        "entry_id": "98173999-1b6f-3c71-8d6b-8c1f0439e6b3",
                        "glosses": [
                            "Flüssigkeit im Tertiärfollikel, in einer weiblichen Eizelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8392366-df65-4628-9c26-50234aa31917",
                                "sense_id": "6fbbf561-40eb-39e7-9957-777b5edc2592",
                                "text": "Der Liquor folliculi ist eine hyluronsäurereiche Flüssigkeit, die Spalträume und Antrum folliculi füllt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
