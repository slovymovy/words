                "senses": [
                    {
                        "sense_id": "f4f3dcb7-ec76-3345-9514-e5d60e3a3e31",
                        "entry_id": "e272a642-063c-3d62-9db6-a620ec2f8548",
                        "glosses": [
                            "A female jackaroo, a woman who does the job of a jackaroo."
                        ],
                        "tags": [
                            "Australia"
                        ],
                        "examples": [
                            {
                                "example_id": "ca7d603f-a249-41e0-ab3c-cb4b037584d4",
                                "sense_id": "f4f3dcb7-ec76-3345-9514-e5d60e3a3e31",
                                "text": "2001, Vivienne Cleven, Bitin′ Back, author biography, title page,\nShe left school at thirteen-years-of-age to work with her father as a jillaroo: building fences, mustering cattle, and working at various jobs on stations throughout Queensland and New South Wales."
                            },
                            {
                                "example_id": "dd243285-7465-4260-a662-830830fbc99c",
                                "sense_id": "f4f3dcb7-ec76-3345-9514-e5d60e3a3e31",
                                "text": "You can also train to become a jillaroo through apprenticeship schemes at technical colleges (such as TAFE in New South Wales) or by attending a private jackeroo and jillaroo school."
                            },
                            {
                                "example_id": "224badf1-c570-4146-910d-0451b0fde859",
                                "sense_id": "f4f3dcb7-ec76-3345-9514-e5d60e3a3e31",
                                "text": "While John worked cattle full time, Rachael worked as a jillaroo part time and wrote part time. Her work saw her doing everything from cattle mustering to cleaning toilets."
                            },
                            {
                                "example_id": "8434b69a-b2ec-46e9-87b0-b2724e75bc7c",
                                "sense_id": "f4f3dcb7-ec76-3345-9514-e5d60e3a3e31",
                                "text": "Only before daybreak was she allowed to get on a horse and do the things jillaroos are supposed to do, like rounding up cattle for the market."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
