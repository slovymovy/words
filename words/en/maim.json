{
    "word_family": [
        "maimed",
        "maiming"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a76a5e7c-a126-3e59-9bd5-b0931bf0fe22",
                    "sense_definition": "To wound seriously; to cause permanent loss of function of a limb or part of the body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier was <w>maimed</w> by a landmine during the conflict.",
                            "target_lang_translations": {
                                "ru": "Солдат был <w>изувечен</w> миной во время конфликта."
                            }
                        },
                        {
                            "text": "A tragic accident at the factory could <w>maim</w> for life anyone who ignores the safety protocols.",
                            "target_lang_translations": {
                                "ru": "Трагический несчастный случай на заводе может на всю жизнь <w>искалечить</w> любого, кто игнорирует протоколы безопасности."
                            }
                        }
                    ],
                    "synonyms": [
                        "mutilate"
                    ],
                    "common_phrases": [
                        "maim for life",
                        "maim and kill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серьезно ранить; вызвать необратимую потерю функций конечности или части тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изувечить",
                                "target_lang_sense_clarification": "нанести тяжелое телесное повреждение"
                            },
                            {
                                "target_lang_word": "искалечить",
                                "target_lang_sense_clarification": "причинить увечья, сделать калекой"
                            },
                            {
                                "target_lang_word": "увечить",
                                "target_lang_sense_clarification": "наносить неизлечимое повреждение"
                            },
                            {
                                "target_lang_word": "калечить",
                                "target_lang_sense_clarification": "делать калекой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "534f520e-e963-3c3a-ae81-ee5b82b539a3",
                    "sense_definition": "A severe, serious wound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "injury",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old knight carried the <w>maim</w> from his last battle as a badge of honor.",
                            "target_lang_translations": {
                                "ru": "Старый рыцарь носил свое <w>увечье</w>, полученное в последней битве, как знак почета."
                            }
                        },
                        {
                            "text": "He suffered a great <w>maim</w> to his happiness after losing his livelihood.",
                            "target_lang_translations": {
                                "ru": "Его счастью был нанесен тяжелый <w>удар</w> после потери средств к существованию."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used primarily in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелая, серьезная рана или увечье."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увечье",
                                "target_lang_sense_clarification": "серьезное телесное повреждение"
                            },
                            {
                                "target_lang_word": "рана",
                                "target_lang_sense_clarification": "повреждение тканей тела"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}