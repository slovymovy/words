                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "用火钳夹",
                                "target_lang_sense_clarification": "用火钳或夹钳夹取、移动某物"
                            },
                            {
                                "target_lang_word": "用夹钳夹",
                                "target_lang_sense_clarification": "较通用的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23ed8b98-6819-340c-bf12-1a86834ea1d5",
                    "sense_definition": "To use a pair of tongs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>tong</w> the ice cubes to keep the drink clean.",
                            "target_lang_translations": {
                                "zh": "为了保持饮料干净，你应该<w>用夹子夹取</w>冰块。"
                            }
                        },
                        {
                            "text": "He learned how to <w>tong</w> the hot metal safely.",
                            "target_lang_translations": {
                                "zh": "他学会了如何安全地<w>用钳子夹取</w>高温金属。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使用一把钳子或夹子。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "用钳子夹取",
                                "target_lang_sense_clarification": "强调使用一把钳子或夹子的动作"
                            },
                            {
                                "target_lang_word": "用夹子夹",
                                "target_lang_sense_clarification": "一般说法"
                            }
                        ]
                    }
                }
            ]
        },
