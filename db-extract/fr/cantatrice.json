                        "glosses": [
                            "Chanteuse professionnelle spécialisée dans l’art lyrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67a315ec-98ba-44be-8703-7cee33bc3fc2",
                                "sense_id": "45ad782c-4ee8-30dd-a8da-e442a6c69007",
                                "text": "[…] ; et Manilov, séduit par les belles phrases, balançait la tête avec la satisfaction béate d’un mélomane devant une cantatrice qui, l’emportant même sur le violon, lance une note aiguë à désespérer un gosier d’oiseau."
                            },
                            {
                                "example_id": "cbb05eea-f071-415b-827d-739123447689",
                                "sense_id": "45ad782c-4ee8-30dd-a8da-e442a6c69007",
                                "text": "La cantatrice est prise d’une colère froide."
                            }
                        ]
