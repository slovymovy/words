                {
                    "sense_id": "a66d3c2b-bbae-36b8-9841-3e0909cf60a1",
                    "sense_definition": "Geld op een bankrekening zetten of betalen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik moet vandaag nog de huur voor de volgende maand <w>storten</w>.",
                            "target_lang_translations": {
                                "en": "I still have to <w>deposit</w> the rent for next month today.",
                                "ru": "Я должен сегодня <w>перевести</w> арендную плату за следующий месяц.",
                                "pl": "Muszę jeszcze dzisiaj <w>wpłacić</w> czynsz za następny miesiąc."
                            }
                        },
                        {
                            "text": "Hij heeft gisteren een groot bedrag op zijn spaarrekening <w>gestort</w>.",
                            "target_lang_translations": {
                                "en": "He <w>deposited</w> a large amount into his savings account yesterday.",
                                "ru": "Вчера он <w>внёс</w> крупную сумму на свой сберегательный счет.",
                                "pl": "Wczoraj <w>wpłacił</w> dużą kwotę na swoje konto oszczędnościowe."
