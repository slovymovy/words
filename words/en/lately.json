{
    "word_family": [
        "late",
        "lateness",
        "belated"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9d4972b9-c1c6-3c11-9717-18ba01d35cb2",
                    "sense_definition": "Recently; not long ago.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have been feeling very tired <w>lately</w> because of all the extra work.",
                            "target_lang_translations": {
                                "ru": "Я чувствую себя очень уставшим <w>в последнее время</w> из-за большого количества дополнительной работы.",
                                "zh": "因为额外的工作太多，我<w>最近</w>感到非常疲惫。"
                            }
                        },
                        {
                            "text": "It is only <w>lately</w> that she has started to enjoy reading books.",
                            "target_lang_translations": {
                                "ru": "Только <w>в последнее время</w> она начала получать удовольствие от чтения книг.",
                                "zh": "她也是<w>近来</w>才开始喜欢上读书的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "recently"
                    ],
                    "common_phrases": [
                        "only lately",
                        "quite lately"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недавно; в последнее время.",
                        "zh": "指不久前或最近一段时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в последнее время",
                                "target_lang_sense_clarification": "о текущем периоде"
                            },
                            {
                                "target_lang_word": "недавно",
                                "target_lang_sense_clarification": "о недавнем прошлом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "最近",
                                "target_lang_sense_clarification": "指当前的一段时间"
                            },
                            {
                                "target_lang_word": "近来",
                                "target_lang_sense_clarification": "指近期的状态或情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df1743f0-a795-3d18-a90d-266aa2363394",
                    "sense_definition": "Formerly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document mentions Mr. Jones, <w>lately</w> the chairman of the board.",
                            "target_lang_translations": {
                                "ru": "В документе упоминается мистер Джонс, <w>в прошлом</w> председатель совета директоров.",
                                "zh": "这份文件提到了琼斯先生，他是董事会的<w>前</w>主席。"
                            }
                        },
                        {
                            "text": "The letter was addressed to Mr Smith, <w>lately</w> of this parish.",
                            "target_lang_translations": {
                                "ru": "Письмо было адресовано мистеру Смиту, <w>ранее</w> проживавшему в этом приходе.",
                                "zh": "这封信是寄给史密斯先生的，他<w>先前</w>住在这个教区。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В прошлом; ранее (обычно о должности или месте жительства).",
                        "zh": "指以前，通常用于描述曾经担任的职位或居住地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в прошлом",
                                "target_lang_sense_clarification": "бывший"
                            },
                            {
                                "target_lang_word": "ранее",
                                "target_lang_sense_clarification": "формально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前",
                                "target_lang_sense_clarification": "指曾经担任的职位"
                            },
                            {
                                "target_lang_word": "先前",
                                "target_lang_sense_clarification": "指以前的状态或地点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "138f8f49-f817-3e74-8afc-852224d75420",
                    "sense_definition": "In a late manner; after the expected time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not try to come <w>lately</w> to the discussion after the decision is made.",
                            "target_lang_translations": {
                                "ru": "Не пытайтесь приходить <w>поздно</w> к обсуждению, когда решение уже принято.",
                                "zh": "别在决定做出后才<w>迟</w>来参与讨论。"
                            }
                        },
                        {
                            "text": "He arrived <w>lately</w> and missed the beginning of the show.",
                            "target_lang_translations": {
                                "ru": "Он приехал <w>поздно</w> и пропустил начало представления.",
                                "zh": "他<w>晚</w>到了，错过了演出的开头。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "standard English uses 'late' instead"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поздно; с опозданием (устаревшее употребление).",
                        "zh": "指迟到或在预定时间之后（现多用 late 代替）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поздно",
                                "target_lang_sense_clarification": "наречие времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迟",
                                "target_lang_sense_clarification": "指时间晚了"
                            },
                            {
                                "target_lang_word": "晚",
                                "target_lang_sense_clarification": "指动作发生的时间滞后"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}