                "senses": [
                    {
                        "sense_id": "451eb1c5-2889-362a-b0af-f9735739d38a",
                        "entry_id": "f96abe46-da55-39fb-819b-1373394df3a1",
                        "glosses": [
                            "Person, die sich im akademischen Bildungsbereich in Forschung und Lehre mit dem Phänomen Spiel beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4faeb168-0177-483f-b6d2-9573a37aff8f",
                                "sense_id": "451eb1c5-2889-362a-b0af-f9735739d38a",
                                "text": "„Die Stagnation der schulpädagogischen Diskussion, die auf der Interschul - Bildungsmesse Anfang Februar in Hannover - erschreckend deutlich geworden war, fand vergangene Woche auf der Düsseldorfer Didacta ihre Fortsetzung in den Diskussionen der Erzieher, Spielpädagogen, Kommunalpolitiker und sozialpädagogischen Erziehungswissenschaftler.“"
                            },
                            {
                                "example_id": "f5a2d873-f6d6-4afb-bfce-bd4466995ac1",
                                "sense_id": "451eb1c5-2889-362a-b0af-f9735739d38a",
                                "text": "„Der Kölner Spielpädagoge Jürgen Fritz hat seit mehreren Jahren Kinder und Jugendliche bei Videospielen beobachtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a59e2a07-1c47-357f-ad83-e0d5b72b9bc3",
                        "entry_id": "f96abe46-da55-39fb-819b-1373394df3a1",
                        "glosses": [
                            "Person, die sich (beruflich) als Spielerzieher im praktischen Lehrbetrieb betätigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a801396-fc0f-45b5-8038-10fe04f165db",
                                "sense_id": "a59e2a07-1c47-357f-ad83-e0d5b72b9bc3",
                                "text": "„Dem ratsuchenden Spielpädagogen eine befriedigende Antwort zu geben, wie man Kinderspiel fördern sollte, ist dennoch schwieriger, als es der verbreitete Glaube an die Kraft des Spiels erwarten lässt.“"
                            },
                            {
                                "example_id": "6ebf6a9e-c6eb-4e64-99ea-15681d010594",
                                "sense_id": "a59e2a07-1c47-357f-ad83-e0d5b72b9bc3",
                                "text": "„Sie sind sich weithin in zwei Punkten einig, die von der referierten Spielforschung missachtet und in deren Gefolge auch von den Spielpädagogen oft vergessen werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
