                                        "glosses": [
                                            "Causing opprobrium; offensive and shameful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "108d9e78-0bb0-4430-a25a-525ea0924d65",
                                                "sense_id": "327ad18d-58ff-3b25-bfba-4dcc53e7c809",
                                                "text": "\"Don’t speak of my painting before Naumann,\" said Will. \"He will tell you, it is all pfuscherei, which is his most opprobrious word!\""
                                            },
                                            {
                                                "example_id": "60633b2a-1d94-41be-a85b-00767c8d4ec1",
                                                "sense_id": "327ad18d-58ff-3b25-bfba-4dcc53e7c809",
                                                "text": "KLAUS: You're so much nicer than the other one. He was a complete asshole!\n REGINALD: Such opprobrious language for your father!\n KLAUS: Yeah, I… I don't know what that means."
                                            }
