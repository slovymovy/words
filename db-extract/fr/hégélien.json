                        "sense_id": "f4390a96-7b51-397c-9c56-f16ebd7a3e29",
                        "entry_id": "7b2f2db1-cbbd-3080-a45a-47265cce0a17",
                        "glosses": [
                            "Qui découle ou s’apparente à la pensée de Georg Wilhelm Friedrich Hegel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "137b915e-ad95-4dcf-b2fd-16608f796ba4",
                                "sense_id": "f4390a96-7b51-397c-9c56-f16ebd7a3e29",
                                "text": "Quant à l’analyse historique hégélienne, c’est catégoriquement différent, elle ne veut rien savoir."
                            },
                            {
                                "example_id": "b1078ec9-9066-446d-9d9a-f8da2916b65d",
                                "sense_id": "f4390a96-7b51-397c-9c56-f16ebd7a3e29",
                                "text": "Communistes, anti-communistes, tous portent le masque hégélien."
                            }
                        ]
                    }
                ],
