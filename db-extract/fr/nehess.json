                        "source_entry_id": "06705e4a-6abc-3b9e-b2e5-5e8a3ef20bd8",
                        "source_sense_id": "f801467d-d617-3467-88ab-703d04ca9bf8",
                        "target_lang_word": "slumber",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
