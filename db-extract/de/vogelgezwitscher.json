                "senses": [
                    {
                        "sense_id": "43c788fa-c19b-3f33-8b05-67cf3f0b5daa",
                        "entry_id": "0c314ea4-91ca-3185-80d9-11e764647ccd",
                        "glosses": [
                            "Lautäußerungen von Singvögeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11f13772-ebb5-4b32-a0cf-435ee82521b0",
                                "sense_id": "43c788fa-c19b-3f33-8b05-67cf3f0b5daa",
                                "text": "Es gibt nichts Schöneres als am Morgen von Sonnenstrahlen und Vogelgezwitscher geweckt zu werden."
                            },
                            {
                                "example_id": "30174075-e815-4341-8f71-ab08a4a37796",
                                "sense_id": "43c788fa-c19b-3f33-8b05-67cf3f0b5daa",
                                "text": "„Eine eigenartige Stille, die nur durch das Vogelgezwitscher durchbrochen wurde, hatte sich über das Viertel gelegt.“"
                            },
                            {
                                "example_id": "678dc6fa-92d7-4b12-85e3-60e7df2f6b65",
                                "sense_id": "43c788fa-c19b-3f33-8b05-67cf3f0b5daa",
                                "text": "„Nach einem Herrenabend beim Intendanten des Königlichen Schauspielhauses in Berlin kam er bei Vogelgezwitscher nach Hause, und zwar gründlich beschwipst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
