                                        "entry_id": "c1926a82-1813-367b-861e-9129b089cdee",
                                        "glosses": [
                                            "Not beknown."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae9a3e0e-4106-4408-818b-4e27aa153072",
                                                "sense_id": "5fa5621f-407f-3efe-ad81-b860a0b81b37",
                                                "text": "Following the debate in question, Tim Loughton sent an unmarked copy of Hansard to his constituent to inform him that he would no longer be acting as his MP as the constituent had made this position untenable. [...] However, and unbeknown to Loughton, the constituent reported the debate to the police as a 'hate crime' and complained that sending a copy of Hansard was 'harassment'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e816edde-a138-4635-83e0-a2f2734009e1",
                        "source_entry_id": "f8436366-7b74-3db6-8974-95db6500e7b8",
                        "source_sense_id": "c1cc07ff-abe6-3243-82f4-22c6bdb41585",
                        "target_lang_word": "unbeknownst",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbeknownst",
