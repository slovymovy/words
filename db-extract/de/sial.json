                "senses": [
                    {
                        "sense_id": "452e2dd3-45be-30c0-b77b-1c56efd497e2",
                        "entry_id": "987b4f3d-6db7-3aaa-8a68-3b3b226f4319",
                        "glosses": [
                            "oberste Schicht der kontinentalen Erdkruste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00fcca5b-881d-4c3f-9b7c-19c5ccf3edb7",
                                "sense_id": "452e2dd3-45be-30c0-b77b-1c56efd497e2",
                                "text": "Während die Erdkruste (Sial) fest ist, wird für den Erdmantel (Sima) ein fließbarer (wenn auch nicht „fließender“) Zustand des Magmas angenommen."
                            },
                            {
                                "example_id": "4740904c-ff49-4c60-a594-1720eaf98d97",
                                "sense_id": "452e2dd3-45be-30c0-b77b-1c56efd497e2",
                                "text": "Der Auffassung von A. Wegener gemäß schwimmen die aus Sial gebildeten Blöcke auf dem Sima."
                            },
                            {
                                "example_id": "885727fa-4837-45aa-9e16-27f8499367df",
                                "sense_id": "452e2dd3-45be-30c0-b77b-1c56efd497e2",
                                "text": "Durch Massenströme im Sial unter der festen Erdkruste schaffen Oszillationen der Erdkruste Geotumore (Aufwölbungen) und Geodepressionen (Einsenkungen)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
