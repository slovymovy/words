                        "sense_id": "06d2e95c-a240-3826-b4bf-cd8fccc552b8",
                        "entry_id": "5095a272-cc57-31b7-971c-dda744f221de",
                        "glosses": [
                            "Fucus vésiculeux, algue brune dont le nom scientifique est Fucus vesiculosus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "284ebcd7-455a-4a14-81b3-0eb72be2bece",
                                "sense_id": "06d2e95c-a240-3826-b4bf-cd8fccc552b8",
                                "text": "Het blaaswier wordt dikwijls door de zee op het strand geworpen, op toegankelijke plaatsen ook met den sikkel weggemaaid, en als mest op akkers uitgespreid. Gebrand, levert het wierasch, waaruit men het jodium afzondert."
                            },
                            {
                                "example_id": "126bb68d-8663-4d52-8236-7cf7defa5e2f",
                                "sense_id": "06d2e95c-a240-3826-b4bf-cd8fccc552b8",
                                "text": "De vloedmerken langs de Noordzee en Oostzeekusten bestaan altijd voor een groot deel uit blaaswier en andere algen uit ondiep water."
                            },
                            {
                                "example_id": "ae5d788e-3d51-4954-9220-0a905f8c56ab",
                                "sense_id": "06d2e95c-a240-3826-b4bf-cd8fccc552b8",
                                "text": "Blaaswier groeit bij voorkeur binnen het getijdengebied, dat wil zeggen dat het bij eb droog ligt. Dan beschermt het zich met een slijmlaag tegen uitdrogen."
                            }
                        ]
                    }
