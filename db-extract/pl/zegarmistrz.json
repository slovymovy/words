                        "examples": [
                            {
                                "example_id": "b93d5b08-b3f0-437a-9dde-93040483f448",
                                "sense_id": "c4fd72d8-6da1-3c19-9e80-c61c33ef8593",
                                "text": "Zepsuł mi się zegarek, pójdę więc do zegarmistrza."
                            },
                            {
                                "example_id": "d36c9154-7a27-4318-ae64-a74ed66b7289",
                                "sense_id": "c4fd72d8-6da1-3c19-9e80-c61c33ef8593",
                                "text": "A kiedy przyjdzie także po mnie • Zegarmistrz światła purpurowy • By mi zabełtać błękit w głowie • To będę jasny i gotowy…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
