                        "sense_id": "61305d9a-0d38-32f9-86ef-fe0dcf56e233",
                        "entry_id": "c1b5be07-7cdc-302b-b2c5-a570013e7d7f",
                        "glosses": [
                            "Of two or more liquids that are not mutually soluble: unmixable."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3b965e75-1209-4b55-ba4b-1a2be8b3db3c",
                                "sense_id": "61305d9a-0d38-32f9-86ef-fe0dcf56e233",
                                "text": "A mixture of oil, water, and mercury forms three immiscible layers."
                            }
                        ]
                    }
                ],
                "translations": [
