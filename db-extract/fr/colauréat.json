                        "sense_id": "7d63b39a-9d3d-3b9f-84f5-7a689d4c4e2f",
                        "entry_id": "da2fb94c-3234-38e1-939e-942cc34ee552",
                        "glosses": [
                            "Personne qui est lauréat aux côtés d’autres lauréats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfd2878f-13d1-4eb2-8d91-ad2c0b07cdb9",
                                "sense_id": "7d63b39a-9d3d-3b9f-84f5-7a689d4c4e2f",
                                "text": "La colauréate du prix Nobel de la paix a 32 ans et vit sous une tente, entourée de dizaines de milliers de révolutionnaires."
                            },
                            {
                                "example_id": "a99df6fb-a21e-461c-90e5-3d922702fad0",
                                "sense_id": "7d63b39a-9d3d-3b9f-84f5-7a689d4c4e2f",
                                "text": "Les lauréats reçoivent un prix de 10 millions de couronnes suédoises (1,09 million d’euros) qui peut être partagé par trois colauréats au maximum."
                            },
                            {
                                "example_id": "cd6b8d1c-d530-4699-88aa-d5d55319a304",
                                "sense_id": "7d63b39a-9d3d-3b9f-84f5-7a689d4c4e2f",
                                "text": "M. W. Rommelaere et son colauréat n’ont rien dit, mais absolument rien de ces croyances et de ces dispositions d’esprit de Van Helmont."
                            }
                        ]
                    }
