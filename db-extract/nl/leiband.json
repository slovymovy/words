                                "target_word": "Gängelband",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7282fcc4-ff10-303c-839f-7195d12d4f54",
                                        "entry_id": "de36e0be-ea3f-3ee0-acc0-a5ea8546ec7f",
                                        "glosses": [
                                            "Laufhilfe für Kinder in Form von Bändern, die am Ärmelansatz der Kleidung angenäht sind"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5cf2209-88f2-42e1-a523-3ae9f707df5f",
                                                "sense_id": "7282fcc4-ff10-303c-839f-7195d12d4f54",
                                                "text": "„Jean-Jacques Rousseau schrieb 1762 in seinem Erziehungsroman „Émile ou De l'éducation“ („Emile oder über die Erziehung“), der in ganz Europa ein Riesenerfolg wurde, es gebe nichts „Lächerlicheres als den Gang von Leuten, die als kleine Kinder zu lange am Gängelband geführt“ worden seien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "eb6ee8ea-37b9-3470-b606-65abea9e8de1",
                                        "entry_id": "de36e0be-ea3f-3ee0-acc0-a5ea8546ec7f",
                                        "glosses": [
                                            "Gesamtheit der Mittel, mit denen die Handlungs- und Denkfreiheit einer anderen Person eingeschränkt wird"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d53b77c-d78e-46fd-9ade-181aefc91981",
                                                "sense_id": "eb6ee8ea-37b9-3470-b606-65abea9e8de1",
                                                "text": "„Die Bahn ist eine Aktiengesellschaft, hängt also nicht mehr am politischen Gängelband.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a53f09a1-99e7-4ad0-bf74-650b6d3aeffb",
                        "source_entry_id": "9d304d96-dde7-3422-bfc4-9e612ab5a353",
                        "source_sense_id": "7de5d772-0b88-3996-a9f3-7a7986755258",
                        "target_lang_word": "leading strings",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leading strings",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6b5b1ef-f4b3-323e-803e-dcddc984560d",
                                        "entry_id": "d1a2f0bb-79ae-3b27-a8d6-eb708fdd65b9",
                                        "glosses": [
                                            "Strings or straps by which a child is supported when learning to walk."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ca520bc-37ad-46b3-b90d-617d8e16b4e8",
                                                "sense_id": "e6b5b1ef-f4b3-323e-803e-dcddc984560d",
                                                "text": "Thenceforward my voice was a household law; and at an age when few children have abandoned their leading-strings, I was left to the guidance of my own will, and became, in all but name, the master of my own actions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c25994d-04d8-3b59-a079-503bba97bbe9",
                                        "entry_id": "d1a2f0bb-79ae-3b27-a8d6-eb708fdd65b9",
                                        "glosses": [
                                            "Guidance given during childhood."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62d249ec-63c4-4ca1-8377-78f749a28ae6",
                                                "sense_id": "3c25994d-04d8-3b59-a079-503bba97bbe9",
                                                "text": "In the hey-day of youth, and hardly out of the leading strings of a school, he formed an intention to nuptialize, and joined heart and hand with sweet Ann Hathaway at the age of eighteen and a half."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
