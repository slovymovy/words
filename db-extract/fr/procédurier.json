                    },
                    {
                        "translation_id": "2676aa23-5a09-47b8-8518-b36f051179bc",
                        "source_entry_id": "381e9a01-b38e-37d4-a0d6-0ec21dcdc114",
                        "source_sense_id": "fec6291d-862b-3909-a41c-ec8255827f4c",
                        "target_lang_word": "Querulant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Querulant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd8e5378-e18b-3be6-b4d5-a8c6ebdb93bc",
                                        "entry_id": "d77c55a9-e440-3f79-95d2-d25afbe21be1",
                                        "glosses": [
                                            "Person, die sich ständig wegen jeder Kleinigkeit beschwert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fdf3201-1c93-48a5-ac7b-743a068b4233",
                                                "sense_id": "cd8e5378-e18b-3be6-b4d5-a8c6ebdb93bc",
                                                "text": "Du nervst so! Dir kann man es wirklich nicht recht machen, du Querulant!"
                                            },
                                            {
                                                "example_id": "3b51e4e0-4ea6-4d26-9abe-f37240eb580c",
                                                "sense_id": "cd8e5378-e18b-3be6-b4d5-a8c6ebdb93bc",
                                                "text": "„Man hatte bald genug, übergenug von diesem Querulanten und seiner Prahlerei, er sei schließlich schon ein Wunderkind gewesen.“"
                                            },
                                            {
                                                "example_id": "713349f8-2440-40af-b4de-819584565792",
                                                "sense_id": "cd8e5378-e18b-3be6-b4d5-a8c6ebdb93bc",
                                                "text": "„Er war ein Querulant, der sich ständig über die hohen Kosten seines Familiengeschäftes beklagte.“"
                                            },
                                            {
                                                "example_id": "7f08f158-0c34-47ed-b2bb-8bfd39ec55d2",
                                                "sense_id": "cd8e5378-e18b-3be6-b4d5-a8c6ebdb93bc",
                                                "text": "„Da gab es die Gruppe der Querulanten, deren Eigensucht sich auf unwürdige Weise hintangesetzt fühlte.“"
                                            },
                                            {
                                                "example_id": "7f822aeb-18d8-4fb2-9bcf-eba7fedd5d62",
                                                "sense_id": "cd8e5378-e18b-3be6-b4d5-a8c6ebdb93bc",
                                                "text": "„In der Presse wurde er meist als Querulant belächelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
