                    "sense_id": "0958bf4e-104a-31f7-8be9-43cef98d7209",
                    "sense_definition": "Испытывающий чувство удивления, изумления (о человеке).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "surprised_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он стоял посреди комнаты, абсолютно <w>удивлённый</w> внезапным визитом старых друзей.",
                            "target_lang_translations": {
                                "en": "He stood in the middle of the room, absolutely <w>surprised</w> by the sudden visit of his old friends."
                            }
                        },
                        {
                            "text": "Она выглядела очень <w>удивлённой</w>, когда услышала эту новость.",
                            "target_lang_translations": {
                                "en": "She looked very <w>surprised</w> when she heard the news."
                            }
                        }
