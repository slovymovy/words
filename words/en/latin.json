    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e07a7418-f536-3555-a766-f54b6277c5b1",
                    "sense_definition": "The language of the ancient Romans, widely used in the Roman Catholic Church and in scientific classification.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "language_sense",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "She decided to study <w>Latin</w> to understand the roots of English words.",
                            "target_lang_translations": {
                                "ru": "Она решила изучать <w>латынь</w>, чтобы понять корни английских слов.",
                                "zh": "她决定学习<w>拉丁语</w>，以了解英语单词的词根。"
                            }
                        },
                        {
                            "text": "Many medical and legal terms are still written in <w>Latin</w>.",
                            "target_lang_translations": {
                                "ru": "Многие медицинские и юридические термины до сих пор пишутся на <w>латыни</w>.",
                                "zh": "许多医学和法律术语至今仍用<w>拉丁语</w>书写。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Classical Latin",
                        "Vulgar Latin",
                        "speak Latin",
                        "Pig Latin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Язык древних римлян, широко используемый в Римско-католической церкви и в научной классификации.",
                        "zh": "古罗马人的语言，广泛用于罗马天主教会和科学分类中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "латы́нь",
                                "target_lang_sense_clarification": "разговорное, общеупотребительное"
                            },
                            {
                                "target_lang_word": "лати́нский язы́к",
                                "target_lang_sense_clarification": "официальное название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉丁语",
                                "target_lang_sense_clarification": "指代该语言"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a5a2858-52df-386b-8837-57633d8c9d7c",
                    "sense_definition": "The alphabet or writing system used for English and many other languages.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "script_sense",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "Most European languages are written using <w>Latin</w> characters.",
                            "target_lang_translations": {
                                "ru": "Большинство европейских языков используют <w>латинские</w> буквы.",
                                "zh": "大多数欧洲语言都使用<w>拉丁字母</w>书写。"
                            }
                        },
                        {
                            "text": "Please write your name clearly in the <w>Latin</w> script.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, напишите свое имя разборчиво <w>латиницей</w>.",
                                "zh": "请用<w>拉丁字母</w>清晰地写下你的名字。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Latin alphabet",
                        "Latin script",
                        "Latin characters"
                    ],
                    "target_lang_definitions": {
                        "ru": "Алфавит или система письма, используемая для английского и многих других языков.",
                        "zh": "用于英语及许多其他语言的字母表或书写系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лати́ница",
                                "target_lang_sense_clarification": "система письма"
                            },
                            {
                                "target_lang_word": "лати́нский алфави́т",
                                "target_lang_sense_clarification": "алфавит"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉丁字母",
                                "target_lang_sense_clarification": "指代书写系统"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "11e1a97f-7529-3b29-8af9-3c8424b6de71",
                    "sense_definition": "Of or relating to the Latin language.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "language_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher explained the complex rules of <w>Latin</w> grammar.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил сложные правила <w>латинской</w> грамматики.",
                                "zh": "老师讲解了复杂的<w>拉丁语</w>语法规则。"
                            }
                        },
                        {
                            "text": "He found an old book full of <w>Latin</w> inscriptions.",
                            "target_lang_translations": {
                                "ru": "Он нашел старую книгу, полную <w>латинских</w> надписей.",
                                "zh": "他发现了一本满是<w>拉丁语</w>铭文的旧书。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Latin word",
                        "Latin grammar",
                        "Latin text"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к латинскому языку.",
                        "zh": "与拉丁语有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лати́нский",
                                "target_lang_sense_clarification": "о языке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉丁语的",
                                "target_lang_sense_clarification": "形容词，修饰与语言相关的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92fdbc5a-9d4e-3690-9b64-950c6a16551d",
                    "sense_definition": "Of or relating to Latin America or its culture.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "culture_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves dancing to energetic <w>Latin</w> music on weekends.",
                            "target_lang_translations": {
                                "ru": "Она любит танцевать под энергичную <w>латиноамериканскую</w> музыку по выходным.",
                                "zh": "她周末喜欢随着动感的<w>拉丁</w>音乐跳舞。"
                            }
                        },
                        {
                            "text": "The restaurant serves delicious <w>Latin</w> dishes from various countries.",
                            "target_lang_translations": {
                                "ru": "В ресторане подают вкусные <w>латиноамериканские</w> блюда из разных стран.",
                                "zh": "这家餐厅供应来自不同国家的美味<w>拉丁美洲</w>菜肴。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Latin American",
                        "Latino",
                        "Hispanic"
                    ],
                    "common_phrases": [
                        "Latin music",
                        "Latin America",
                        "Latin culture",
                        "Latin lover"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Латинской Америке или её культуре.",
                        "zh": "与拉丁美洲或其文化有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "латиноамерика́нский",
                                "target_lang_sense_clarification": "относящийся к Латинской Америке"
                            },
                            {
                                "target_lang_word": "лати́нский",
                                "target_lang_sense_clarification": "в контексте музыки или культуры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉丁美洲的",
                                "target_lang_sense_clarification": "指代地理或文化区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9286bec0-28c0-376f-b9c9-a516f894dacc",
                    "sense_definition": "Of or relating to ancient Rome, its people, or its empire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "history_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum features a vast collection of <w>Latin</w> antiquities.",
                            "target_lang_translations": {
                                "ru": "В музее представлена обширная коллекция <w>латинских</w> древностей.",
                                "zh": "博物馆展出了大量<w>罗马</w>时期的文物。"
                            }
                        },
                        {
                            "text": "We studied <w>Latin</w> history and the rise of the empire in class.",
                            "target_lang_translations": {
                                "ru": "Мы изучали <w>латинскую</w> историю и расцвет империи на уроке.",
                                "zh": "我们在课上学习了<w>罗马</w>历史和帝国的兴起。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Roman"
                    ],
                    "common_phrases": [
                        "Latin literature",
                        "Latin poet",
                        "Latin authors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Древнему Риму, его народу или империи.",
                        "zh": "与古罗马、其人民或帝国有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лати́нский",
                                "target_lang_sense_clarification": "относящийся к латинам/Лацию"
                            },
                            {
                                "target_lang_word": "ри́мский",
                                "target_lang_sense_clarification": "относящийся к Риму"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罗马的",
                                "target_lang_sense_clarification": "指代古罗马历史"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "597cd5e1-edff-362b-a647-9e06830a2ab4",
                    "sense_definition": "Of or relating to the script or letters used in the ancient Roman language and many modern alphabets.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "script_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sign was written in large <w>Latin</w> letters so everyone could read it.",
                            "target_lang_translations": {
                                "ru": "Вывеска была написана крупными <w>латинскими</w> буквами, чтобы все могли её прочитать.",
                                "zh": "标牌是用大号<w>拉丁字母</w>写的，以便每个人都能看懂。"
                            }
                        },
                        {
                            "text": "This printer supports both Cyrillic and <w>Latin</w> fonts.",
                            "target_lang_translations": {
                                "ru": "Этот принтер поддерживает как кириллические, так и <w>латинские</w> шрифты.",
                                "zh": "这台打印机同时支持西里尔字母和<w>拉丁字母</w>字体。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Roman"
                    ],
                    "common_phrases": [
                        "Latin letters",
                        "Latin font"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к шрифту или буквам, используемым в древнеримском языке и многих современных алфавитах.",
                        "zh": "与古罗马语言及许多现代字母表中使用的脚本或字母有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лати́нский",
                                "target_lang_sense_clarification": "о буквах или шрифте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉丁字母的",
                                "target_lang_sense_clarification": "指代字体或书写形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13566b1d-00b5-35f0-a4f7-318fe2fa894d",
                    "sense_definition": "Of or pertaining to the Roman Rite of the Catholic Church.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>Latin</w> mass is still celebrated in some traditional parishes.",
                            "target_lang_translations": {
                                "ru": "<w>Латинская</w> месса до сих пор служится в некоторых традиционных приходах.",
                                "zh": "一些传统教区至今仍举行<w>拉丁礼</w>弥撒。"
                            }
                        },
                        {
                            "text": "He is a bishop in the <w>Latin</w> church.",
                            "target_lang_translations": {
                                "ru": "Он епископ <w>латинской</w> церкви.",
                                "zh": "他是<w>拉丁礼</w>教会的一位主教。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Roman Catholic",
                        "Catholic"
                    ],
                    "common_phrases": [
                        "Latin Rite",
                        "Latin Church"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к римскому обряду католической церкви.",
                        "zh": "与天主教会的罗马礼仪有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лати́нский",
                                "target_lang_sense_clarification": "церковный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拉丁礼的",
                                "target_lang_sense_clarification": "宗教术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4c0fc56-58bf-3566-9566-6fc9ec3c3c4b",
                    "sense_definition": "A person from Latin America.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "person_modern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The festival was a gathering place for <w>Latins</w> from all over the city.",
                            "target_lang_translations": {
                                "ru": "Фестиваль стал местом сбора <w>латиноамериканцев</w> со всего города.",
                                "zh": "这个节日是全城<w>拉丁美洲人</w>的聚会场所。"
                            }
                        },
                        {
                            "text": "Many <w>Latins</w> have contributed significantly to the local music scene.",
                            "target_lang_translations": {
                                "ru": "Многие <w>латиноамериканцы</w> внесли значительный вклад в местную музыкальную сцену.",
                                "zh": "许多<w>拉丁美洲人</w>为当地音乐界做出了重大贡献。"
                            }
                        }
