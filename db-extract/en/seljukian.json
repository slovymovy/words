                        "sense_id": "9f82bd3b-d703-38b2-a6c3-a4aa2d046b52",
                        "entry_id": "adc844d2-5fd0-3c76-b566-1ac4b22c5a23",
                        "glosses": [
                            "Synonym of Seljuk, of or related to Seljuk, his dynasty, their empire, or their period of rule."
                        ],
                        "tags": [
                            "historical",
                            "not-comparable",
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "fd890465-428e-4926-80fa-3c97848f57e4",
                                "sense_id": "9f82bd3b-d703-38b2-a6c3-a4aa2d046b52",
                                "text": "Romanus at once took the field against the Seljukian hordes, who were now devastating Cappadocia with fiendish cruelty, and had just captured Caesarea and plundered the shrine of St. Basil."
                            },
                            {
                                "example_id": "8cd4d8e0-1714-4f17-b6d7-4bbeee8e652b",
                                "sense_id": "9f82bd3b-d703-38b2-a6c3-a4aa2d046b52",
                                "text": "This was the time when the Seljukian Empire in West Asia was dissolved by Mongol invasions, thus causing the out-migration of Seljukian artisans and craftsmen, many of whom found refuge in India under the Khiljis..."
                            }
                        ]
                    }
