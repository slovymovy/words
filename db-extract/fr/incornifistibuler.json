                        "glosses": [
                            "Faire entrer de force dans la mémoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8b3d86f-164d-4806-b362-850895865b06",
                                "sense_id": "316986d7-cb2f-3edf-800e-4231e70be200",
                                "text": "À la tête de ces troupes incornifistibulées, nous placerons ces banquiers travaillant à remuer des millions, dont les têtes sont tellement remplies de calculs que les chiffres finissent par percer leur occiput et s’élever en colonnes d’additions au-dessus de leurs fronts"
                            },
                            {
                                "example_id": "a4c8887b-2533-44c7-a7e2-078cb6f4e67a",
                                "sense_id": "316986d7-cb2f-3edf-800e-4231e70be200",
                                "text": "Eckermann n’est plus incornifistibulé par les idées noires qui le poursuivoient à Genève"
                            }
                        ]
                    }
