                                        "entry_id": "bb772dfe-1287-3cf3-9708-025dd7bc480d",
                                        "glosses": [
                                            "Of or referring to the Old Stone Age (the Paleolithic period or Paleolithic age)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34b5d342-5b5b-452f-9237-3c919b907edd",
                                                "sense_id": "cdc953b1-7b57-3cb7-9987-414ec0aacd16",
                                                "text": "We find material evidences of magical practices in the European caves of the Palæolithic age[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "850c84e3-8a4a-3097-b372-7a812e8d5133",
                                        "entry_id": "bb772dfe-1287-3cf3-9708-025dd7bc480d",
                                        "glosses": [
                                            "Antiquated, antediluvian."
                                        ],
                                        "tags": [
                                            "excessive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf84474-1377-4c3a-a13a-9d8879baf6c3",
                                                "sense_id": "850c84e3-8a4a-3097-b372-7a812e8d5133",
                                                "text": "Stacked up against ChatGPT’s ability to instantly transform any image into a Studio Ghibli cartoon, Instagram’s photo filters are practically Paleolithic."
