{
    "word_family": [
        "prankster",
        "prankish"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e0d4af3b-896b-3d20-9594-b4032b2eb491",
                    "sense_definition": "A practical joke or mischievous trick.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "noun_trick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students decided to play a harmless <w>prank</w> on their teacher.",
                            "target_lang_translations": {
                                "ru": "Студенты решили устроить безобидный <w>розыгрыш</w> над своим учителем.",
                                "tr": "Öğrenciler öğretmenlerine zararsız bir <w>şaka</w> yapmaya karar verdiler.",
                                "es": "Los estudiantes decidieron gastarle una <w>broma</w> inofensiva a su profesor."
                            }
                        },
                        {
                            "text": "He pulled a funny <w>prank</w> on his sister yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера он устроил забавную <w>шалость</w> со своей сестрой.",
                                "tr": "Dün kız kardeşine komik bir <w>şaka</w> yaptı.",
                                "es": "Ayer le gastó una <w>broma</w> graciosa a su hermana."
                            }
                        }
                    ],
                    "synonyms": [
                        "practical joke",
                        "trick",
                        "gag",
                        "lark",
                        "shenanigan"
                    ],
                    "common_phrases": [
                        "play a prank",
                        "pull a prank",
                        "harmless prank"
                    ],
                    "target_lang_definitions": {
                        "ru": "Розыгрыш или озорная выходка.",
                        "tr": "Birine yapılan muzipçe veya eğlenceli şaka.",
                        "es": "Una broma pesada, truco travieso o inocentada."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "розыгрыш",
                                "target_lang_sense_clarification": "шутка над кем-то"
                            },
                            {
                                "target_lang_word": "шалость",
                                "target_lang_sense_clarification": "озорство"
                            },
                            {
                                "target_lang_word": "выходка",
                                "target_lang_sense_clarification": "поступок"
                            },
                            {
                                "target_lang_word": "пранк",
                                "target_lang_sense_clarification": "современный сленг"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şaka",
                                "target_lang_sense_clarification": "genel anlamda şaka"
                            },
                            {
                                "target_lang_word": "eşek şakası",
                                "target_lang_sense_clarification": "fiziksel veya ağır şaka"
                            },
                            {
                                "target_lang_word": "muziplik",
                                "target_lang_sense_clarification": "yaramazlık, haylazlık"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "broma",
                                "target_lang_sense_clarification": "engaño o truco para reírse"
                            },
                            {
                                "target_lang_word": "travesura",
                                "target_lang_sense_clarification": "acción pícara o traviesa"
                            },
                            {
                                "target_lang_word": "inocentada",
                                "target_lang_sense_clarification": "broma o engaño festivo"
                            },
                            {
                                "target_lang_word": "pesadez",
                                "target_lang_sense_clarification": "broma pesada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e956e417-c80f-34b8-9b58-36e20005841f",
                    "sense_definition": "An evil deed; a malicious trick or an act of cruel deception.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_trick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel <w>prank</w> left the victim in tears and distress.",
                            "target_lang_translations": {
                                "ru": "Эта жестокая <w>выходка</w> довела жертву до слёз и отчаяния.",
                                "tr": "Bu zalimce <w>oyun</w> kurbanı gözyaşları ve acı içinde bıraktı.",
                                "es": "Aquella cruel <w>mala pasada</w> dejó a la víctima entre lágrimas y angustia."
                            }
                        },
                        {
                            "text": "He was known for many a wicked <w>prank</w> in his youth.",
                            "target_lang_translations": {
                                "ru": "В молодости он был известен своими злыми <w>проделками</w>.",
                                "tr": "Gençliğinde yaptığı birçok haince <w>numarayla</w> tanınırdı.",
                                "es": "Era conocido por muchas <w>trastadas</w> perversas en su juventud."
                            }
                        }
                    ],
                    "synonyms": [
                        "trick"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Modern usage typically implies harmlessness."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Злое деяние; злонамеренная уловка или акт жестокого обмана.",
                        "tr": "Kötü niyetli, zalimce veya aldatıcı hareket ya da numara.",
                        "es": "Mala pasada, mala jugada o truco malicioso y cruel."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "злая выходка",
                                "target_lang_sense_clarification": "жестокий поступок"
                            },
                            {
                                "target_lang_word": "проделка",
                                "target_lang_sense_clarification": "хитрость"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hainlik",
                                "target_lang_sense_clarification": "kötü niyetli eylem"
                            },
                            {
                                "target_lang_word": "kötü niyetli oyun",
                                "target_lang_sense_clarification": "zarar verici hile veya tuzak"
                            },
                            {
                                "target_lang_word": "düzen",
                                "target_lang_sense_clarification": "hile, aldatmaca"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "mala pasada",
                                "target_lang_sense_clarification": "acción perjudicial o desleal"
                            },
                            {
                                "target_lang_word": "mala jugada",
                                "target_lang_sense_clarification": "engaño o faena maliciosa"
                            },
                            {
                                "target_lang_word": "trastada",
                                "target_lang_sense_clarification": "acción de mala fe para perjudicar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17a6e49f-4aca-341b-a040-f1e0ebdb58aa",
                    "sense_definition": "To perform a practical joke on someone; to trick and make a fool of them.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_trick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They planned to <w>prank</w> their friend by hiding his phone.",
                            "target_lang_translations": {
                                "ru": "Они планировали <w>разыграть</w> друга, спрятав его телефон.",
                                "tr": "Telefonunu saklayarak arkadaşlarını <w>işletmeyi</w> planladılar.",
                                "es": "Planearon <w>gastarle una broma</w> a su amigo escondiendo su teléfono."
                            }
                        },
                        {
                            "text": "I can't believe you <w>pranked</w> me like that!",
                            "target_lang_translations": {
                                "ru": "Не могу поверить, что ты так меня <w>разыграл</w>!",
                                "tr": "Bana böyle bir <w>şaka yaptığına</w> inanamıyorum!",
                                "es": "¡No puedo creer que me <w>hayas gastado una broma</w> así!"
                            }
                        }
                    ],
                    "synonyms": [
                        "trick",
                        "rag"
                    ],
                    "common_phrases": [
                        "get pranked",
                        "prank someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разыграть кого-то, устроив практическую шутку; выставить кого-то в глупом свете.",
                        "tr": "Birine şaka yapmak, onu işletmek veya kandırmak.",
                        "es": "Gastar una broma a alguien; engañar o burlarse de una persona."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разыграть",
                                "target_lang_sense_clarification": "подшутить"
                            },
                            {
                                "target_lang_word": "подшутить",
                                "target_lang_sense_clarification": "сделать объектом шутки"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şaka yapmak",
                                "target_lang_sense_clarification": "biriyle eğlenmek"
                            },
                            {
                                "target_lang_word": "işletmek",
                                "target_lang_sense_clarification": "kandırmak, şakayla aldatmak"
                            },
                            {
                                "target_lang_word": "oyuna getirmek",
                                "target_lang_sense_clarification": "tuzak kurup aldatmak"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "gastar una broma",
                                "target_lang_sense_clarification": "hacer objeto de una broma"
                            },
                            {
                                "target_lang_word": "hacer una broma",
                                "target_lang_sense_clarification": "burlar o engañar por diversión"
                            },
                            {
                                "target_lang_word": "embromar",
                                "target_lang_sense_clarification": "tomar el pelo o engañar festivamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb3f8248-1dab-3095-86e8-2d264f8fdcea",
                    "sense_definition": "To call someone's phone and hang up before they answer, usually to signal them without paying for the call.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_call",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Just <w>prank</w> me when you are outside so I can come out.",
                            "target_lang_translations": {
                                "ru": "Просто <w>маякни</w> мне, когда будешь на улице, чтобы я вышел.",
                                "tr": "Dışarı çıktığında beni sadece <w>çaldır</w>, böylece dışarı gelebilirim.",
                                "es": "Solo <w>dame un toque</w> cuando estés fuera para que pueda salir."
                            }
                        },
                        {
                            "text": "I do not have credit, so I will <w>prank</w> you when I arrive.",
                            "target_lang_translations": {
                                "ru": "У меня нет денег на счету, поэтому я <w>сделаю дозвон</w>, когда приеду.",
                                "tr": "Kontörüm yok, bu yüzden vardığımda seni <w>çaldırıp kapatırım</w>.",
                                "es": "No tengo saldo, así que te <w>daré un toque</w> cuando llegue."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Позвонить кому-то и сбросить вызов до ответа, обычно чтобы подать сигнал.",
                        "tr": "Birini telefonla arayıp ücret ödemeden sinyal vermek amacıyla hemen kapatmak.",
                        "es": "Llamar al teléfono de alguien y colgar antes de que responda para dar una señal."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маякнуть",
                                "target_lang_sense_clarification": "разг. дать сигнал звонком"
                            },
                            {
                                "target_lang_word": "сделать дозвон",
                                "target_lang_sense_clarification": "сбросить вызов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çaldırıp kapatmak",
                                "target_lang_sense_clarification": "işaret vermek için arayıp kapatmak"
                            },
                            {
                                "target_lang_word": "çaldırmak",
                                "target_lang_sense_clarification": "kısa süreli arama yapmak"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "dar un toque",
                                "target_lang_sense_clarification": "llamar y colgar para avisar"
                            },
                            {
                                "target_lang_word": "hacer una llamada perdida",
                                "target_lang_sense_clarification": "dar un timbrazo sin contestar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "017710ba-67d4-3d72-92aa-f78d624ebb84",
                    "sense_definition": "To adorn in a showy manner; to dress or equip ostentatiously.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_adorn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>pranked</w> in her finest jewels for the ball.",
                            "target_lang_translations": {
                                "ru": "Она <w>вырядилась</w> в свои лучшие драгоценности для бала.",
                                "tr": "Balo için en güzel mücevherleriyle <w>süslenip püslenmişti</w>.",
                                "es": "Estaba <w>engalanada</w> con sus mejores joyas para el baile."
                            }
                        },
                        {
                            "text": "The hall was <w>pranked</w> with garlands and ribbons.",
                            "target_lang_translations": {
                                "ru": "Зал был <w>украшен</w> гирляндами и лентами.",
                                "tr": "Salon çelenkler ve kurdelelerle <w>donatılmıştı</w>.",
                                "es": "El salón estaba <w>engalanado</w> con guirnaldas y cintas."
                            }
                        }
                    ],
                    "synonyms": [
                        "caper",
                        "curvet"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наряжать в броской манере; одевать или украшать напоказ.",
                        "tr": "Gösterişli bir şekilde süslemek ya da abartılı giyinmek/donatmak.",
                        "es": "Adornar u ostentar con atuendos vistosos o llamativos."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырядиться",
                                "target_lang_sense_clarification": "одеться напоказ"
                            },
                            {
                                "target_lang_word": "украсить",
                                "target_lang_sense_clarification": "декорировать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "süslenmek",
                                "target_lang_sense_clarification": "gösterişli giyinmek"
                            },
                            {
                                "target_lang_word": "donatmak",
                                "target_lang_sense_clarification": "süslerle bezemek"
                            },
                            {
                                "target_lang_word": "süslemek",
                                "target_lang_sense_clarification": "dekore etmek"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "engalanar",
                                "target_lang_sense_clarification": "adornar o vestir de gala"
                            },
                            {
                                "target_lang_word": "ataviar",
                                "target_lang_sense_clarification": "vestir con esmero o adornos"
                            }
                        ]
                    }
                }
            ]
        }
    ]
