                ],
                "senses": [
                    {
                        "sense_id": "3afce3c7-742e-36fc-9439-f1ddc3e427bc",
                        "entry_id": "e1ab0f5a-8e0a-3a6c-b358-99e5d260ce8a",
                        "glosses": [
                            "Prinzip, wonach quantenphysikalische Objekte je nach Versuchsbedingung als klassische Welle (Feld) oder klassisches Teilchen (Korpuskel) in Erscheinung treten können"
                        ],
                        "tags": [
                            "Quantenphysik"
                        ],
                        "examples": [
                            {
                                "example_id": "520ac439-df37-4dec-ac65-b31e8b902bbe",
                                "sense_id": "3afce3c7-742e-36fc-9439-f1ddc3e427bc",
                                "text": "„Der Welle-Teilchen-Dualismus besagt, dass physikalische Teilchen bei der Ausbreitung Welleneigenschaften, bei der Wechselwirkung mit Materie jedoch Teilcheneigenschaften zeigen.“"
                            },
                            {
                                "example_id": "f5c89ab1-0aa2-4bd9-9ae0-708d6a4251ff",
                                "sense_id": "3afce3c7-742e-36fc-9439-f1ddc3e427bc",
                                "text": "„Das Wirkungsquantum verknüpft Eigenschaften, die vorher in der klassischen Physik entweder nur Teilchen oder nur Wellen zugeschrieben wurden. Damit ist es die Basis des Welle-Teilchen-Dualismus der modernen Physik.“"
                            },
                            {
                                "example_id": "b0d60a2d-af24-4bca-9b8f-e03a41fc2ad9",
                                "sense_id": "3afce3c7-742e-36fc-9439-f1ddc3e427bc",
                                "text": "„Dieses Wiener Quantenmännlein ist nahezu viertausend mal schwerer als ein Wasserstoffatom und damit das bislang schwerste Molekül, bei dem bewiesen ist, dass es dem Welle-Teilchen-Dualismus gehorcht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
