                        "entry_id": "93aec21c-2f77-35ec-a7a6-1887fb32f8e3",
                        "glosses": [
                            "komisariat policji, zwłaszcza w byłym zaborze rosyjskim"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
