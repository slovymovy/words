                                            "časový úsek, kdy je možné udělat něco, s čím se předem nepočítalo"
                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "600f86cc-0ef0-4d5f-9c73-e34f996ad8f5",
                                                "sense_id": "ec949ad8-9150-3363-92a8-2ebc4b4010cc",
                                                "text": "Od sedmi do osmi mám ve svém pracovním programu okno, tak se můžeme sejít."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c11c86-eb89-374c-ad4c-31093d723d8d",
                                        "entry_id": "3f196249-060e-3311-a1b5-a419d4670468",
                                        "glosses": [
                                            "obdélníková oblast na obrazovce počítače, která představuje jeden nebo více běžících programů"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d5391aa-4923-4a1f-b76d-454bc9dc586d",
                                                "sense_id": "32c11c86-eb89-374c-ad4c-31093d723d8d",
                                                "text": "Mám na obrazovce tolik oken, že se v nich nevyznám."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65cc1599-d9da-38b3-8c69-24f3f71ed8a9",
                                        "entry_id": "3f196249-060e-3311-a1b5-a419d4670468",
