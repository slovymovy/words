                "senses": [
                    {
                        "sense_id": "f4f8c0d6-6f76-3df3-9251-29ef001f2007",
                        "entry_id": "df4b6d31-931f-3af6-b068-6c7730527f85",
                        "glosses": [
                            "A westerly wind, especially one that blows into the Mediterranean Sea around the area of the Straits of Gibraltar and Morocco, or a similar wind in the Philippines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a2b3203-33ba-4729-9e97-bb8dd39a9500",
                                "sense_id": "f4f8c0d6-6f76-3df3-9251-29ef001f2007",
                                "text": "The vendaval gives unequivocal signs of its approach. If the easterly wind be blowing, it will veer to the S.E., the sky will become obscured and the coast concealed, […]"
                            },
                            {
                                "example_id": "c425e1e8-ff3c-443e-bd57-c24358feecb8",
                                "sense_id": "f4f8c0d6-6f76-3df3-9251-29ef001f2007",
                                "text": "Setting sail, then, with the vendaval, within a short time they reached the outside of the channel . The ships sailing from Manila do not do this, and are much delayed, because they must run a greater distance within the channel and among ..."
                            },
                            {
                                "example_id": "c48332c8-65be-4cec-9468-47ffb656cca7",
                                "sense_id": "f4f8c0d6-6f76-3df3-9251-29ef001f2007",
                                "text": "This navigation should not be made at any other season, for from June the vendavals blow, and they are contrary to the voyage. As a rule, these ships sail and are despatched at the end of February, or at the latest by the twentieth of March."
                            },
                            {
                                "example_id": "06ceb9e8-81dd-42f3-98e8-b5e930873630",
                                "sense_id": "f4f8c0d6-6f76-3df3-9251-29ef001f2007",
                                "text": "The vendaval occurs mainly in the cool season, and it is most frequent from October to November and February to March."
                            }
                        ]
                    }
                ],
