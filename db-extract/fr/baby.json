                "senses": [
                    {
                        "sense_id": "c5cd13ae-aead-3c04-bba6-9fb51421658b",
                        "entry_id": "1bafb397-3944-306f-9fe1-014b280d418e",
                        "glosses": [
                            "Commune française, située dans le département de Seine-et-Marne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd576bd8-7ba7-481f-8c6f-e65dd7a0186b",
                                "sense_id": "c5cd13ae-aead-3c04-bba6-9fb51421658b",
                                "text": "À Baby (Seine-et-Marne), il a été encore construit en 1743, c’est-à-dire à une date avancée du XVIIIᵉ siècle, un mausolée en forme de rotonde au chevet de l’église paroissiale pour abriter le tombeau d’Alexis-Jean Durand de Lagny."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "91b4be44-6abd-3f26-a475-0632fb051f38",
                "word": "Baby",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "10ed4a67-923c-3a09-9500-94120fc72469",
                        "entry_id": "91b4be44-6abd-3f26-a475-0632fb051f38",
                        "glosses": [
                            "Nom de famille français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3cb061e-6191-4cd5-893a-e47c19cac5fb",
                                "sense_id": "10ed4a67-923c-3a09-9500-94120fc72469",
                                "text": "Nicolas est une des belles récompenses que le rugby français peut avoir, observait Benoît Baby, son ex-entraîneur chez les Bleuets, lundi dans Midol."
                            }
                        ]
                    }
                ],
