                "senses": [
                    {
                        "sense_id": "65e6b140-d598-3ada-b4e0-a23c22a81ba9",
                        "entry_id": "f50864d9-e3fe-3eac-9647-6dc02d4875c1",
                        "glosses": [
                            "kleiner Bus für den Transport relativ weniger Fahrgäste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6513302-08b8-40d5-9fd0-d9c5f452f689",
                                "sense_id": "65e6b140-d598-3ada-b4e0-a23c22a81ba9",
                                "text": "„Während sie rastet, hält manchmal ein klimatisierter Minibus an, der eine Gruppe mit Kameras bewaffneter Touristen ausspuckt.“"
                            },
                            {
                                "example_id": "7673ff77-6ed8-42e4-83a9-fd6cf2031c5c",
                                "sense_id": "65e6b140-d598-3ada-b4e0-a23c22a81ba9",
                                "text": "„Die Arbeiter einer Stadt wohnen nie im Zentrum, sondern in den Außenbezirken, und pendeln mit Zug oder Minibus zur Arbeit.“"
                            },
                            {
                                "example_id": "09fe469f-e889-4ab4-9b50-a24a20ab82b0",
                                "sense_id": "65e6b140-d598-3ada-b4e0-a23c22a81ba9",
                                "text": "„Ich stieg wieder in den Minibus; als er nachkam, bot ich ihm den Fensterplatz an; er war begeistert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8de8068f-3b0b-4eb2-ac0a-d9d3c552f952",
                        "source_entry_id": "f50864d9-e3fe-3eac-9647-6dc02d4875c1",
                        "source_sense_id": "65e6b140-d598-3ada-b4e0-a23c22a81ba9",
