                        "examples": [
                            {
                                "example_id": "3f815a48-aac8-441b-b4b2-550b006f8939",
                                "sense_id": "785f17a5-7091-35dc-b83e-2859dd6dca55",
                                "text": "Precies een jaar geleden overleed Apple-topman Steve Jobs. Hij werd door velen gezien als de leider van een revolutie op computergebied. Hij was hét gezicht van het trendbepalende Apple. Al snel rees de vraag of die revolutie kon worden voortgezet zonder de leiding van de mediagenieke Jobs."
                            },
                            {
                                "example_id": "9e6d6731-97ef-45f4-b9b0-37d6f4b2787c",
                                "sense_id": "785f17a5-7091-35dc-b83e-2859dd6dca55",
                                "text": "Bij de vogelshow balen eigenaren van de noodzaak tot beveiliging. \"Het is een hobby en als andere mensen aan jouw hobby komen, dan vind ik dat heel erg\", zegt Martien Strijdveen. Bij hem werden al eens vogels ontvreemd. Een andere liefhebber zegt: \"Of je nou op computergebied bezig bent of met vogels, het maakt niet uit waarmee. Alles moet tegenwoordig beveiligd worden.\""
                            }
                        ]
