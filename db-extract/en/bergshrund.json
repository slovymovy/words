                    {
                        "sense_id": "5ccadb56-f675-3d10-be64-594eb88dc245",
                        "entry_id": "46709798-5537-363c-8af4-616bbbf9f489",
                        "glosses": [
                            "A large crack or crevasse in a glacier where the glacier is pulling away from the mountain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99f78aba-d531-4f88-8d29-3bd9cc10b018",
                                "sense_id": "5ccadb56-f675-3d10-be64-594eb88dc245",
                                "text": "The snow was extremely hard and there was a well defined path all the way up to the bergshrund."
                            },
                            {
                                "example_id": "f5ebb963-9013-403a-9b2f-ac6d261e3c75",
                                "sense_id": "5ccadb56-f675-3d10-be64-594eb88dc245",
                                "text": "By this time the cloud had rolled in once more and we stopped on the lip of a bergschrund and around 6730 m."
                            },
                            {
                                "example_id": "6b3d6f9c-e093-412a-a219-76ec5e8a6f85",
                                "sense_id": "5ccadb56-f675-3d10-be64-594eb88dc245",
                                "text": "None of the other climbers says a word, and one by one we climb over a field of shaggy rocks and cross a ladder over the bergschrund."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34114f9f-c01b-4aab-b6b5-119b70831835",
                        "source_entry_id": "46709798-5537-363c-8af4-616bbbf9f489",
                        "source_sense_id": "5ccadb56-f675-3d10-be64-594eb88dc245",
