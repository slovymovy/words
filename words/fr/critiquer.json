    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44f8a9d2-a993-33cd-ac68-dd815f99448d",
                    "sense_definition": "Faire des reproches ou souligner les défauts de quelqu'un ou de quelque chose avec sévérité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "jugement_negatif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il passe tout son temps à <w>critiquer</w> les choix de ses collègues de bureau."
                        },
                        {
                            "text": "Les citoyens ont vivement <w>critiqué</w> cette nouvelle mesure fiscale."
                        }
                    ],
                    "synonyms": [
                        "blâmer",
                        "désapprouver",
                        "reprocher"
                    ],
                    "antonyms": [
                        "complimenter",
                        "féliciter",
                        "louer"
                    ],
                    "common_phrases": [
                        "critiquer ouvertement",
                        "critiquer sévèrement",
                        "critiquer sans cesse"
                    ]
                },
                {
                    "sense_id": "a2234854-8414-328a-8b65-10a1de59f4f6",
                    "sense_definition": "Analyser et évaluer les qualités et les défauts d'une œuvre littéraire, artistique ou scientifique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluation_artistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce journaliste culturel adore <w>critiquer</w> les romans récents dans sa chronique hebdomadaire."
                        },
                        {
                            "text": "Le professeur a demandé aux étudiants de <w>critiquer</w> cette pièce de théâtre avec impartialité."
                        }
                    ],
                    "synonyms": [
                        "analyser",
                        "commenter",
                        "juger"
                    ],
                    "common_phrases": [
                        "critiquer un film",
                        "critiquer un livre",
                        "critiquer une œuvre"
                    ]
                },
                {
                    "sense_id": "03490ac4-aabe-30bc-9638-244d418e7a04",
                    "sense_definition": "Examiner méthodiquement une idée, un témoignage ou un fait pour discerner le vrai du faux et en apprécier la valeur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "methode_intellectuelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'historien doit scrupuleusement <w>critiquer</w> chaque document d'archive avant de formuler une conclusion."
                        },
                        {
                            "text": "Les chercheurs apprennent à <w>critiquer</w> les sources statistiques pour éviter toute interprétation trompeuse."
                        }
                    ],
                    "synonyms": [
                        "examiner",
                        "scruter"
                    ],
                    "common_phrases": [
                        "critiquer un texte",
                        "critiquer une source"
                    ]
                }
            ]
        }
    ]
