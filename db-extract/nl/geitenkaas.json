                                        "examples": [
                                            {
                                                "example_id": "7010e871-50e1-4975-a22e-a6d8c07034e8",
                                                "sense_id": "8753d02f-a525-3809-8e38-2b21c96bbc95",
                                                "text": "[…]it may easily become so to an enlarged extent when goat′s cheese shall be offered in our markets."
                                            },
                                            {
                                                "example_id": "81019cc5-c4b5-4f90-9fdc-b85fecbf0fe0",
                                                "sense_id": "8753d02f-a525-3809-8e38-2b21c96bbc95",
                                                "text": "2002, New Statesman, Volume 131, Issues 4577-4585, page 47,\nOn the other hand, goat′s cheeses made by the British equivalents of Mme Blondeau, though you feel you ought to like them, never seem as inspired as their French counterparts."
                                            },
                                            {
                                                "example_id": "b609f02e-840c-49fb-a4d8-2a36656de8e0",
                                                "sense_id": "8753d02f-a525-3809-8e38-2b21c96bbc95",
                                                "text": "Place goat′s cheese parcels alongsise the roast tomatoes"
                                            },
                                            {
                                                "example_id": "92583da5-0b67-4076-b8a1-9ceec5363bd8",
                                                "sense_id": "8753d02f-a525-3809-8e38-2b21c96bbc95",
                                                "text": "2010, Amelia Thomas, Michael Kohn, Miriam Raphael, Dan Savery Raz, Israel & the Palestinian Territories, Lonely Planet, page 164,\nShai Seltzer, Israel′s most famous goat′s cheese maker, emerged wearing a white frock and thick white beard, an arrangement that made him appear like Charlton Heston when he played Moses in The Ten Commandments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
