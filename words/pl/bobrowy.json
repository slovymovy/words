                {
                    "sense_id": "a01e26c4-66f9-3faf-a008-cac684bd2947",
                    "sense_definition": "dotyczący <w>bobra</w> lub odnoszący się do niego",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beaver-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym lesie znajduje się duży rezerwat <w>bobrowy</w>, gdzie zwierzęta te żyją w spokoju.",
                            "target_lang_translations": {
                                "ru": "В этом лесу находится большой <w>бобровый</w> заповедник, где эти животные живут в покое."
                            }
                        },
                        {
                            "text": "Podczas spaceru nad rzeką zauważyliśmy nową tamę <w>bobrową</w> zbudowaną z gałęzi.",
                            "target_lang_translations": {
                                "ru": "Во время прогулки у реки мы заметили новую <w>бобровую</w> плотину, построенную из веток."
                            }
                        }
                    ],
                    "synonyms": [
                        "bobrzy"
                    ],
                    "common_phrases": [
                        "tama bobrowa",
                        "rezerwat bobrowy",
                        "żeremia bobrowe"
                    ],
                    "target_lang_definitions": {
                        "ru": "относящийся к бобру или связанный с ним"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бобровый",
                                "target_lang_sense_clarification": "связанный с бобром как животным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abb217c1-d2b9-3ddb-ae01-2fecb7d9eb13",
                    "sense_definition": "pochodzący od <w>bobra</w>, wykonany z jego części lub produktów",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beaver-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Robert często woził ze sobą bardzo gustowną czapkę z futra <w>bobrowego</w>.",
                            "target_lang_translations": {
                                "ru": "Роберт часто возил с собой очень изящную шапку из <w>бобрового</w> меха."
                            }
                        },
                        {
                            "text": "W starym kufrze znaleźliśmy elegancki <w>bobrowy</w> kołnierz, który należał do dziadka.",
                            "target_lang_translations": {
                                "ru": "В старом сундуке мы нашли элегантный <w>бобровый</w> воротник, который принадлежал дедушке."
                            }
                        }
                    ],
                    "synonyms": [
                        "bobrzy"
                    ],
                    "common_phrases": [
                        "bobrowe futro",
                        "bobrowy kołnierz",
                        "bobrowa czapka"
                    ],
                    "target_lang_definitions": {
                        "ru": "происходящий от бобра, сделанный из его меха или частей тела"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бобровый",
                                "target_lang_sense_clarification": "сделанный из меха бобра"
                            }
                        ]
                    }
                }
            ]
        }
