                        "entry_id": "3ee77c83-ecd8-37bb-9303-664834604344",
                        "glosses": [
                            "In the manner of a pugilist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c86e43e7-2907-42df-9f75-62be460d74ff",
                                "sense_id": "eee29b25-227b-3019-9cc9-5ea93158443c",
                                "text": "It was no time for pugilistic chivalry, and my brother laid him quiet with a kick, and gripped the collar of the man who pulled at the slender lady's arm."
                            },
                            {
                                "example_id": "c03abd76-1cfa-434d-8acb-3ff6deea9841",
                                "sense_id": "eee29b25-227b-3019-9cc9-5ea93158443c",
                                "text": "Mr. Christie, who as a presidential candidate has frequently suppressed his most pugilistic instincts, cast off any restraint and did what he does best: slice and slash."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cff811d-88c4-3f23-8937-0d0d234fb3aa",
