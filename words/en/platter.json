{
    "word_family": [
        "plat",
        "plait"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb50d072-2555-3cc0-8967-02cd844952fc",
                    "sense_definition": "A large, flat dish or tray used for serving food.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "serving_dish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter brought a large <w>platter</w> of fresh fruit to our table.",
                            "target_lang_translations": {
                                "cs": "Číšník přinesl k našemu stolu velký <w>tác</w> čerstvého ovoce."
                            }
                        },
                        {
                            "text": "She arranged the appetizers neatly on a silver <w>platter</w> for the guests.",
                            "target_lang_translations": {
                                "cs": "Úhledně naaranžovala předkrmy na stříbrný <w>tác</w> pro hosty."
                            }
                        }
                    ],
                    "common_phrases": [
                        "serving platter"
                    ],
                    "target_lang_definitions": {
                        "cs": "Velký plochý talíř nebo podnos používaný k servírování jídla."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tác",
                                "target_lang_sense_clarification": "plochý podnos pro přenášení pokrmů"
                            },
                            {
                                "target_lang_word": "servírovací mísa",
                                "target_lang_sense_clarification": "větší nádoba na servírování jídla"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b378606e-1b9f-3620-a064-1e46c03c5ad4",
                    "sense_definition": "A meal consisting of a main dish accompanied by several side dishes served together on one plate.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "serving_dish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ordered the seafood <w>platter</w> which included shrimp, fish, and chips.",
                            "target_lang_translations": {
                                "cs": "Objednal si <w>obložený talíř</w> s mořskými plody, který obsahoval krevety, rybu a hranolky."
                            }
                        },
                        {
                            "text": "The lunch <w>platter</w> comes with a salad and a choice of soup.",
                            "target_lang_translations": {
                                "cs": "Polední <w>menu</w> se podává se salátem a výběrem polévky."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lunch platter"
                    ],
                    "target_lang_definitions": {
                        "cs": "Jídlo sestávající z hlavního chodu a několika příloh podávaných společně na jednom talíři."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "obložený talíř",
                                "target_lang_sense_clarification": "jídlo složené z více komponentů na jednom talíři"
                            },
                            {
                                "target_lang_word": "degustační talíř",
                                "target_lang_sense_clarification": "výběr různých druhů pokrmů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "976074de-feed-301b-9794-d1899791918f",
                    "sense_definition": "A vinyl phonograph record.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "audio_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The DJ spun a classic jazz <w>platter</w> to start the evening.",
                            "target_lang_translations": {
                                "cs": "DJ na začátek večera pustil klasickou jazzovou <w>desku</w>."
                            }
                        },
                        {
                            "text": "Collectors often search for a rare <w>platter</w> in old music shops.",
                            "target_lang_translations": {
                                "cs": "Sběratelé často pátrají po vzácných <w>deskách</w> ve starých hudebninách."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used in the context of music or radio."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vinylová gramofonová deska."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "gramofonová deska",
                                "target_lang_sense_clarification": "standardní označení pro vinylový nosič"
                            },
                            {
                                "target_lang_word": "deska",
                                "target_lang_sense_clarification": "hovorové označení pro hudební nosič"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2bcdf93e-3393-308f-8ba0-95e6fdc7c52d",
                    "sense_definition": "The rotating circular surface of a turntable that holds a record.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "audio_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Place the record carefully onto the <w>platter</w> before lowering the needle.",
                            "target_lang_translations": {
                                "cs": "Položte desku opatrně na <w>talíř</w>, než spustíte jehlu."
                            }
                        },
                        {
                            "text": "The <w>platter</w> stopped spinning when the automatic arm returned to its rest.",
                            "target_lang_translations": {
                                "cs": "<w>Talíř</w> se přestal otáčet, když se automatické raménko vrátilo do výchozí polohy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Otáčivá kruhová plocha gramofonu, na které leží deska."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "talíř",
                                "target_lang_sense_clarification": "otočná část gramofonu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8e2293f-6334-337f-9a7e-86d6ed345628",
                    "sense_definition": "A circular magnetic disk inside a hard drive used for data storage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computer_hardware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The read-write head hovers just above the spinning <w>platter</w> inside the drive.",
                            "target_lang_translations": {
                                "cs": "Čtecí a zápisová hlava se vznáší těsně nad rotující <w>plotnou</w> uvnitř disku."
                            }
                        },
                        {
                            "text": "A scratch on the magnetic <w>platter</w> can lead to permanent data loss.",
                            "target_lang_translations": {
                                "cs": "Škrábanec na magnetické <w>plotně</w> může vést k trvalé ztrátě dat."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Kruhový magnetický disk uvnitř pevného disku sloužící k ukládání dat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "plotna",
                                "target_lang_sense_clarification": "magnetický disk v pevném disku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04fb4904-d3cb-368a-b16e-d8acda39f173",
                    "sense_definition": "A person who braids or plaits hair or other materials.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professional <w>platter</w> created intricate designs in the client's hair.",
                            "target_lang_translations": {
                                "cs": "Profesionální <w>pletařka</w> vytvořila ve vlasech klientky složité vzory."
                            }
                        },
                        {
                            "text": "She is a skilled <w>platter</w> who works with natural fibers for basketry.",
                            "target_lang_translations": {
                                "cs": "Je to zručná <w>pletařka</w>, která pracuje s přírodními vlákny při košíkářství."
                            }
                        }
                    ],
                    "synonyms": [
                        "plaiter",
                        "braider"
                    ],
                    "target_lang_definitions": {
