                ],
                "translations": [
                    {
                        "translation_id": "754c1f89-bc89-4372-90d8-98c991fa22f9",
                        "source_entry_id": "341ec41b-b853-3846-a656-9d7cda72703b",
                        "source_sense_id": "eed82847-08c0-3974-be34-769c413f265b",
                        "target_lang_word": "Mother of God",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mother of God",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97f8f374-80fd-340a-b8dc-a848dac37d26",
                                        "entry_id": "e2aa750b-eee7-3793-a852-3cf9324005c1",
                                        "glosses": [
                                            "A dogmatic title of Mary, mother of Jesus, in particular reference to her role as mother of God (God the Son)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Mother of God",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "256e7061-ee8f-39a8-afea-212569ad3ac2",
                                        "entry_id": "444de3a5-a555-3ad5-a781-b345a7e5cafd",
                                        "glosses": [
                                            "Said in supplication to Mary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63aa27f6-e26d-48d0-b51c-a78e9e8a7741",
                                                "sense_id": "256e7061-ee8f-39a8-afea-212569ad3ac2",
                                                "text": "Holy Mary, Mother of God, pray for us sinners, now and at the hour of death. Amen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef36d071-e1a2-39de-a7cb-f3ef8f5f5bfa",
                                        "entry_id": "444de3a5-a555-3ad5-a781-b345a7e5cafd",
                                        "glosses": [
                                            "An expression of surprise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e72eb91c-db15-4484-a89b-269552433754",
                                                "sense_id": "ef36d071-e1a2-39de-a7cb-f3ef8f5f5bfa",
                                                "text": "Near-synonyms: Jesus, Mary and Joseph; wow; see also Thesaurus:wow"
                                            },
                                            {
                                                "example_id": "f5a26fb8-63b1-41bb-9e4c-2e23a8ff5fd5",
                                                "sense_id": "ef36d071-e1a2-39de-a7cb-f3ef8f5f5bfa",
                                                "text": "And your husband's parents were in the earthquake zone? Mother of God! Did they survive?"
                                            },
                                            {
                                                "example_id": "281aed7d-26ba-4eee-a449-81159605e8c1",
                                                "sense_id": "ef36d071-e1a2-39de-a7cb-f3ef8f5f5bfa",
                                                "text": "“What a place!” her mother had exclaimed, when they finally arrived after almost a week of driving. “Sensational! Smell that? Eucalyptus trees! Mother of God, I feel a hundred percent better already, I swear it. And a big nice pool for you—two of them, will you look at that. Now how could anybody stay sick in a place like this, I ask you?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95a3360e-5c12-369b-8585-da1c0fc39ddb",
                                        "entry_id": "444de3a5-a555-3ad5-a781-b345a7e5cafd",
                                        "glosses": [
                                            "An expression of disgust, annoyance, or disappointment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff229bd9-c86e-49d2-b006-46691fc47b48",
                                                "sense_id": "95a3360e-5c12-369b-8585-da1c0fc39ddb",
                                                "text": "Mother of God! I've had it up to here with your bullshit!"
                                            },
                                            {
                                                "example_id": "b3a22e33-ca69-400d-98e6-5f0a43a192ab",
                                                "sense_id": "95a3360e-5c12-369b-8585-da1c0fc39ddb",
                                                "text": "“Mother of God! You should have asked me before you released that old woman. Now I can expect the wrath of hell to fall on my head when I walk through that door!” Tristan exclaimed, nodding at his cabin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f50a7c3a-fe8c-4783-8e33-b106bb9e2cc1",
                        "source_entry_id": "341ec41b-b853-3846-a656-9d7cda72703b",
                        "source_sense_id": "eed82847-08c0-3974-be34-769c413f265b",
                        "target_lang_word": "Gottesgebärerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "25e31075-7b7a-42b8-8257-de0669fa853a",
                        "source_entry_id": "341ec41b-b853-3846-a656-9d7cda72703b",
                        "source_sense_id": "eed82847-08c0-3974-be34-769c413f265b",
                        "target_lang_word": "Богородица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Богородица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d05e0266-4030-3b14-ae54-0ef38dd840a4",
                                        "entry_id": "3f6baad1-5a6c-37b9-83fb-3a249942eb34",
                                        "glosses": [
                                            "религ. в христианской, иудаистической и исламской традиции — мать Иисуса Христа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29a2a89d-b012-4e88-b46c-a988d5f5913d",
                                                "sense_id": "d05e0266-4030-3b14-ae54-0ef38dd840a4",
                                                "text": "На алтарных столбах изображение Благовещения: на левой стороне Ангел с ветвью, а на противоположном столбе прядущая Богородица."
                                            },
                                            {
                                                "example_id": "0549a677-d4cd-4422-b878-f21238f18566",
                                                "sense_id": "d05e0266-4030-3b14-ae54-0ef38dd840a4",
                                                "text": "Добро б травы худо росли и морозы вдвое серчали, уж человеки, аки звери лютые, предают друг друга, роют друг другу ямы; забыли вовсе бога (тут барская барыня перекрестилась) — прости, мать пресвятая богородица тихвинская, что вхожу во осуждение!"
                                            },
                                            {
                                                "example_id": "6bd98e18-319d-479b-99aa-b9bd197952c6",
                                                "sense_id": "d05e0266-4030-3b14-ae54-0ef38dd840a4",
                                                "text": "И с какой благодарностью, с каким изумлением мы думаем о Ней: Источник жизни, Живоносный Источник, как называет Её Церковь, прославляя Её в одной из икон, — Живоносный Источник, Богородица, кончает Свою земную жизнь, окружённая трепетною любовью всех."
                                            },
                                            {
                                                "example_id": "d8633120-52c8-4093-a646-e8507aab5999",
                                                "sense_id": "d05e0266-4030-3b14-ae54-0ef38dd840a4",
                                                "text": "Владычица Богородица, в Тебе почило всё существо благости Божией, святости, премудрости, милости, долготерпения Божия к грешным, вся сила ходатайства за род христианский, чтущий Тя."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
