                "senses": [
                    {
                        "sense_id": "5305fabf-97b8-3675-8a5f-c1dcfda503d5",
                        "entry_id": "ed86ad51-8cc3-3fd1-a720-e7a26344a10a",
                        "glosses": [
                            "Mann, der (angeblich oder tatsächlich) über mystische, übernatürliche oder magische Fähigkeiten verfügt"
                        ],
                        "tags": [
                            "Esoterik"
                        ],
                        "examples": [],
