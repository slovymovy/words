                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b0d2fa-c4a4-4380-b8a7-38b99803f8df",
                                                "sense_id": "08578b40-6633-3cbc-9175-27a49f2cb62c",
                                                "text": "Деревня Воронеж входит в Перемиловское сельское поселение Шуйского района."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dd4c245-950d-3c8a-bf5f-93c2a85586db",
                                        "entry_id": "fbe027da-0c4e-38e6-959c-7cbd4f07f704",
