                        ],
                        "examples": [
                            {
                                "example_id": "db4b48d5-9515-46e2-b97b-422c39c5628f",
                                "sense_id": "10187355-b343-3465-bc49-d9dc40c65022",
                                "text": "Une Guenuche coiffée",
                                "translation": "femme laide et parée de façon ridicule"
                            },
                            {
                                "example_id": "646d1a09-c2fc-40ea-bf6c-56838f75af0c",
                                "sense_id": "10187355-b343-3465-bc49-d9dc40c65022",
                                "text": "— D’autres ont été jalouses de moi, dit-elle, mais pas encore des guenuches comme vous !"
                            }
                        ]
