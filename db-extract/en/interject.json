                                            {
                                                "example_id": "774edcc4-2689-4317-b1e6-6c7d2c7766d4",
                                                "sense_id": "2d955f3d-6d5d-30dc-9982-79e7df48894a",
                                                "text": "Een vonnis of een arrest bij verstek kan ook nadelig zijn voor de verzekeraar die voor het strafgerecht vrijwillig of gedwongen is tussengekomen,"
                                            }
