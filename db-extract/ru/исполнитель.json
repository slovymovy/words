                        "source_sense_description": "тот, кто делает, исполняет",
                        "target_lang_word": "executor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "executor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c28969a-5e0f-360a-8a41-e9b495da5655",
                                        "entry_id": "498bd9e9-0728-37ca-9757-e36072bb9a95",
                                        "glosses": [
                                            "A person who carries out some task."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0c47680-9fdc-300f-a6c2-a31d0ef3b3d4",
                                        "entry_id": "498bd9e9-0728-37ca-9757-e36072bb9a95",
                                        "glosses": [
                                            "A component of a system that executes or runs something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "513fc8aa-46cb-4cfd-adf3-27106ebb2b7f",
                                                "sense_id": "e0c47680-9fdc-300f-a6c2-a31d0ef3b3d4",
                                                "text": "When searching for a solution is unnecessary, then the program executor \"doesn't care\" which solution is generated nor how it is obtained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b61db42d-aaf2-31a4-a31e-905a1b9a1c99",
                                        "entry_id": "498bd9e9-0728-37ca-9757-e36072bb9a95",
                                        "glosses": [
                                            "Someone appointed by a testator to administer their estate in accordance with their will; an administrator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d523607-e13a-4766-be31-71659e8c9442",
                                                "sense_id": "b61db42d-aaf2-31a4-a31e-905a1b9a1c99",
                                                "text": "literary executor"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e959a3e-beeb-3c08-95e1-00e973d5db7c",
                                        "entry_id": "498bd9e9-0728-37ca-9757-e36072bb9a95",
                                        "glosses": [
                                            "An executioner."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b76106c-bd5b-46be-8b4b-9438f746c797",
                                                "sense_id": "7e959a3e-beeb-3c08-95e1-00e973d5db7c",
                                                "text": "The sad-eyed justice, with his surly hum, / Delivering o'er to executors pale / The lazy yawning drone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c130c42-2b97-4b3c-877f-36e6996c4846",
                        "source_entry_id": "bc9ce642-c9db-32cd-ae5f-67fa9b4600bb",
                        "source_sense_description": "тот, кто делает, исполняет",
                        "target_lang_word": "doer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "doer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bc66599-4b85-3fcc-8e26-533268cd8337",
                                        "entry_id": "35f476e5-c849-316e-a1b8-82aff0bc421d",
                                        "glosses": [
                                            "Someone who does, performs, or executes; an active person, an agent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "459e57cb-7311-48d7-ade2-4828774d02e9",
                                                "sense_id": "2bc66599-4b85-3fcc-8e26-533268cd8337",
                                                "text": "The doer and the thinker\nNo allowance for the other."
                                            },
                                            {
                                                "example_id": "d12fd3c3-b7be-425c-88f8-a5b56b7c328d",
                                                "sense_id": "2bc66599-4b85-3fcc-8e26-533268cd8337",
                                                "text": "Though his name was closely linked to that of Physiocrats, he was less an armchair intellectual like Quesnay or the elder Mirabeau than a doer in the vein of Bertin and Trudaine [...]."
                                            },
                                            {
                                                "example_id": "8728b0f3-e823-462a-9351-afa83aaecabb",
                                                "sense_id": "2bc66599-4b85-3fcc-8e26-533268cd8337",
                                                "text": "In schools, submission, not curiosity, was a highly valued virtue. Thinkers were out, doers were in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68215621-ee0a-4376-8a90-2af84492f95f",
                        "source_entry_id": "bc9ce642-c9db-32cd-ae5f-67fa9b4600bb",
