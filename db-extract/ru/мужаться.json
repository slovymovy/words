                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36142f60-249d-408b-a88f-4f2f028e85f9",
                                "sense_id": "6d08d944-ce41-3768-82a5-b2d6ab6b5b0d",
                                "text": "В мире будете иметь скорбь; но мужайтесь: Я победил мир."
                            },
                            {
                                "example_id": "a871d937-ba94-4232-ae76-a7ccb6a277dd",
                                "sense_id": "6d08d944-ce41-3768-82a5-b2d6ab6b5b0d",
                                "text": "Но я мужаюсь, но я не подаю виду, что робею, но я не пускаюсь все же в бегство."
                            }
                        ]
                    }
