                    {
                        "sense_id": "4bf081ba-028b-3e39-9fc2-fab577412e28",
                        "entry_id": "8f9a2165-da76-3806-8b31-51206b8509d4",
                        "glosses": [
                            "weibliche Person, die sich um Passagiere im Flugzeug, Schiff, Bus oder Zug kümmert"
                        ],
                        "tags": [
                            "Beruf"
                        ],
