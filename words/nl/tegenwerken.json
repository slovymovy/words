{
    "word_family": [
        "tegenwerking",
        "werk",
        "werken",
        "werker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5126b9ab-fe8b-3d47-8e04-816e52f7de9c",
                    "sense_definition": "iemand of iets belemmeren in de voortgang of het succes door actieve weerstand te bieden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "belemmeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oppositie probeert de nieuwe wetten van de regering voortdurend <w>tegen te werken</w>.",
                            "target_lang_translations": {
                                "en": "The opposition is constantly trying to <w>work against</w> the government's new laws."
                            }
                        },
                        {
                            "text": "Hij had die verandering altijd <w>tegengewerkt</w> omdat hij bang was voor zijn baan.",
                            "target_lang_translations": {
                                "en": "He had always <w>thwarted</w> that change because he was afraid for his job."
                            }
                        }
                    ],
                    "synonyms": [
                        "belemmeren",
                        "dwarsbomen",
                        "tegenstreven",
                        "hinderen"
                    ],
                    "antonyms": [
                        "meewerken"
                    ],
                    "common_phrases": [
                        "elkaar tegenwerken",
                        "plannen tegenwerken"
                    ],
                    "target_lang_definitions": {
                        "en": "To hinder someone or something in progress or success by offering active resistance."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "work against",
                                "target_lang_sense_clarification": "to oppose or resist someone's efforts"
                            },
                            {
                                "target_lang_word": "thwart",
                                "target_lang_sense_clarification": "to prevent someone from accomplishing something"
                            },
                            {
                                "target_lang_word": "obstruct",
                                "target_lang_sense_clarification": "to block or get in the way of progress"
                            },
                            {
                                "target_lang_word": "oppose",
                                "target_lang_sense_clarification": "to actively resist or fight against"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "082ccace-c0a0-3ef4-ab9c-966fb1a96673",
                    "sense_definition": "zich koppig of onwillig gedragen, vaak door niet mee te gaan in een gevraagde actie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weerstand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind begon <w>tegen te werken</w> toen het zijn tanden moest poetsen.",
                            "target_lang_translations": {
                                "en": "The child started to <w>resist</w> when it had to brush its teeth."
                            }
                        },
                        {
                            "text": "Als je blijft <w>tegenwerken</w>, zal het proces alleen maar langer duren.",
                            "target_lang_translations": {
                                "en": "If you continue to <w>be uncooperative</w>, the process will only take longer."
                            }
                        }
                    ],
                    "synonyms": [
                        "tegenstribbelen",
                        "weerspannig zijn"
                    ],
                    "antonyms": [
                        "meewerken"
                    ],
                    "common_phrases": [
                        "actief tegenwerken"
                    ],
                    "target_lang_definitions": {
                        "en": "To behave stubbornly or unwillingly, often by not cooperating with a requested action."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resist",
                                "target_lang_sense_clarification": "to refuse to comply or cooperate"
                            },
                            {
                                "target_lang_word": "be uncooperative",
                                "target_lang_sense_clarification": "to not help or do what is asked"
                            },
                            {
                                "target_lang_word": "dig one's heels in",
                                "target_lang_sense_clarification": "to stubbornly refuse to change one's mind or act"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}