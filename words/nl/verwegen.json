                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bouwkundig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vakman besloot de oude schuur volledig te <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "The craftsman decided to completely <w>reface</w> the old barn."
                            }
                        },
                        {
                            "text": "Het is noodzakelijk om dit bouwvallige huis te <w>verwegen</w>.",
                            "target_lang_translations": {
                                "en": "It is necessary to <w>re-wall</w> this dilapidated house."
                            }
                        }
