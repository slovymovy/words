                        "glosses": [
                            "Eigenschaft einer Krankheit, schnell (und heftig) (akut) zu verlaufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99d1ba98-81de-4646-9d43-b0168d039ea7",
                                "sense_id": "80ea2204-1aee-31a7-871a-07ad8352e282",
                                "text": "„Das Syndrom wird also bestimmt durch vorgegebene individuale Besonderheiten einerseits und die Akuität und Intensität der krankhaften Störung andererseits.“"
                            },
                            {
                                "example_id": "33a597ce-b2a2-4f1f-8fc3-08f68a1faeda",
                                "sense_id": "80ea2204-1aee-31a7-871a-07ad8352e282",
                                "text": "„Erst in den letzten Jahren beginnt sich ein vor allen Dingen von Gilliam und Sontheimer vorgeschlagenes Einteilungsprinzip durchzusetzen, das die Hautmanifestationen der Erkrankung nach ihrer Lokalisation, Morphologie und Akuität differenziert.“"
                            }
                        ],
