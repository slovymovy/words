                    {
                        "translation_id": "9724b18c-461a-4272-a546-38da3342e7fb",
                        "source_entry_id": "5b2a2c52-b5b5-3e65-8303-ab9cca725d7c",
                        "source_sense_id": "c4805afa-0267-3a2a-8b37-bbaed925cbb4",
                        "source_sense_description": "vroegere Russische keizer",
                        "target_lang_word": "Zar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31e01eb5-0c55-378a-96f1-9d5466549eb0",
                                        "entry_id": "476bc799-aa63-3ffe-a974-5c856edfac1f",
                                        "glosses": [
                                            "historisch: Herrscher und Herrschertitel in Russland, Bulgarien und Serbien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68e1ff0-0f5c-4a40-b733-7a32066fdaaa",
                                                "sense_id": "31e01eb5-0c55-378a-96f1-9d5466549eb0",
                                                "text": "Der russische Zar Peter der Große hat Sankt Petersburg gegründet."
                                            },
                                            {
                                                "example_id": "264afab2-6548-4f3f-b59d-587d16ee65e5",
                                                "sense_id": "31e01eb5-0c55-378a-96f1-9d5466549eb0",
                                                "text": "„Auf das Fleisch folgte konserviertes Gemüse, und zum Abschluß gab es Tee nach Blättern erster Wahl, die der russische Zar den Mondfahrern dediziert hatte.“"
                                            },
                                            {
                                                "example_id": "04a7df17-75ef-48ff-9f09-b999527b0c1a",
                                                "sense_id": "31e01eb5-0c55-378a-96f1-9d5466549eb0",
                                                "text": "„Wenn sich der russische Zar auch nicht viel um die Tschuktschenhalbinsel gekümmert hat, war seine Regierung doch klug genug, Fehler, wie sie in Alaska gemacht wurden, zu vermeiden.“"
                                            },
                                            {
                                                "example_id": "5c5139f7-0468-4cd4-b535-0c27ad2023c0",
                                                "sense_id": "31e01eb5-0c55-378a-96f1-9d5466549eb0",
                                                "text": "„Bereits unter den Zaren hatte die orthodoxe Kirche es nicht leicht, den heidnischen, kirchenfeindlichen Aberglauben zu bekämpfen.“"
                                            },
                                            {
                                                "example_id": "a0bd0a1a-b50e-4581-a931-13c1a0ae3517",
                                                "sense_id": "31e01eb5-0c55-378a-96f1-9d5466549eb0",
                                                "text": "„Kein Zar hat so menschenverachtend und blutrünstig geherrscht wie Stalin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acb8413a-1da1-452d-9579-fbe59176fef7",
                        "source_entry_id": "5b2a2c52-b5b5-3e65-8303-ab9cca725d7c",
                        "source_sense_id": "c4805afa-0267-3a2a-8b37-bbaed925cbb4",
                        "source_sense_description": "vroegere Russische keizer",
                        "target_lang_word": "tsar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tsar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9c45512-509d-3777-82a7-a021da6fa6ce",
                                        "entry_id": "c8e24bea-9e45-3d08-854d-b7c27df8c8aa",
                                        "glosses": [
                                            "An emperor of Russia (1547 to 1917) and of some South Slavic states."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58d09fa8-e713-4437-9de4-e2236af9069f",
                                                "sense_id": "d9c45512-509d-3777-82a7-a021da6fa6ce",
                                                "text": "[W]hy, in the name of common sense, should the English call the Czar (tsar) of Russia razc?"
                                            },
                                            {
                                                "example_id": "21140a2b-b47a-4fca-a31c-7fa77b342dca",
                                                "sense_id": "d9c45512-509d-3777-82a7-a021da6fa6ce",
                                                "text": "I vuz never beink too krazy about any of dose tsari."
                                            },
                                            {
                                                "example_id": "d90961b2-cef6-493e-a1c6-fab4720734a8",
                                                "sense_id": "d9c45512-509d-3777-82a7-a021da6fa6ce",
                                                "text": ">There IS a difference between the Russians as a group of people and Soviet communism!\nHa ha ha! Know any other good ones? First their^([sic]) were the plain old tsari, then the red tsari (Stalin, etc) and know Putin is the 'new look' tsar. But the same beastly imperialist bullying goes on."
                                            },
                                            {
                                                "example_id": "87a68a9d-4cd6-4f60-89e4-6a2b9095e719",
                                                "sense_id": "d9c45512-509d-3777-82a7-a021da6fa6ce",
                                                "text": "At that time Mongol princes faced the challenge of choosing from three options: either combine all their forces and fight against the Manchus, which were stronger and had taken over all of China at that time, or approach the Russian Tsari as did the Buryat and Khalmig Mongol princedoms or to follow the way of Inner Mongolia and accept relative autonomy given by the Manchu.",
                                                "translation": "Potsdam University Press",
                                                "english": "Potsdam University Press"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2161ebf-24d0-38e6-8ce6-9f4a947f9f3c",
                                        "entry_id": "c8e24bea-9e45-3d08-854d-b7c27df8c8aa",
                                        "glosses": [
                                            "A person with great power; an autocrat."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc45b5c5-47db-4fff-92e5-5f126ac88aab",
                                                "sense_id": "a2161ebf-24d0-38e6-8ce6-9f4a947f9f3c",
                                                "text": "Chin Chien-shih, an old poor peasant of Korean nationality, said: \"The wolfish ambition of the new tsars is exactly the same as that of the old tsars. The Soviet revisionist renegade clique is struggling desperately in the hope of saving itself from doom, but this will only bring on its destruction more quickly.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cefa830c-93ed-4fb1-b1cf-f49afb5e6c57",
                        "source_entry_id": "5b2a2c52-b5b5-3e65-8303-ab9cca725d7c",
                        "source_sense_id": "c4805afa-0267-3a2a-8b37-bbaed925cbb4",
                        "source_sense_description": "vroegere Russische keizer",
                        "target_lang_word": "czar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "czar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efce3383-3b31-3bff-adbb-8ffb3bc35028",
                                        "entry_id": "9507321f-0138-3a45-a3ed-71ea688fa0f4",
                                        "glosses": [
                                            "Alternative spelling of tsar (especially common in American English)"
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a56e51f-fd99-44c3-86fb-777d05d5e67b",
                                                "sense_id": "efce3383-3b31-3bff-adbb-8ffb3bc35028",
                                                "text": "Note therfore that Czar in the Ruthens tounge signifieth a kynge, wheras in the language of the Slauons, Pollons, Bohemes, and other, the same woorde Czar, signifieth Cesar by whiche name Themperours haue byn commonly cauled."
                                            },
                                            {
                                                "example_id": "f0779a39-93a3-4d13-99a1-66354155ebe6",
                                                "sense_id": "efce3383-3b31-3bff-adbb-8ffb3bc35028",
                                                "text": "To understand Russia, you have to dive deep into its history — boyars and czars, Pushkin and Pasternak, Stalin and Stalingrad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fa7e6c1-8b03-3973-87bc-85f62bd10feb",
                                        "entry_id": "9507321f-0138-3a45-a3ed-71ea688fa0f4",
                                        "glosses": [
                                            "An appointed official tasked to regulate or oversee a specific area."
                                        ],
                                        "tags": [
                                            "Philippine",
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa84918c-3477-4a64-bf39-6cdf5e388207",
                                                "sense_id": "0fa7e6c1-8b03-3973-87bc-85f62bd10feb",
                                                "text": "drug czar"
                                            },
                                            {
                                                "example_id": "8e5f58b6-706f-41ab-9ee1-3038fc1560d2",
                                                "sense_id": "0fa7e6c1-8b03-3973-87bc-85f62bd10feb",
                                                "text": "cyberczar"
                                            },
                                            {
                                                "example_id": "61b1bd30-6fee-4ed9-9cac-293b30ff6f31",
                                                "sense_id": "0fa7e6c1-8b03-3973-87bc-85f62bd10feb",
                                                "text": "The federal mental health czar is calling for more money to expand services to help people suffering amid the social isolation imposed by the coronavirus pandemic […]"
                                            }
                                        ]
