                "senses": [
                    {
                        "sense_id": "1ecd40ba-ae58-3d9c-812f-f2e4ab87e088",
                        "entry_id": "93faa582-9b2a-3937-b091-35d861963079",
                        "glosses": [
                            "Wechsel eines Temperaturzustandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96de1443-ffcf-45a2-adff-9b9a608ebb24",
                                "sense_id": "1ecd40ba-ae58-3d9c-812f-f2e4ab87e088",
                                "text": "„Die geringste Temperaturänderung der Hohlkugel bewirkt eine weithin sichtbare Verschiebung des Tropfens und zeigt die Volumenänderung ∆V an. “"
                            },
                            {
                                "example_id": "202c80ac-df66-4e68-adc5-1176e1cf3d8c",
                                "sense_id": "1ecd40ba-ae58-3d9c-812f-f2e4ab87e088",
                                "text": "„Wenn Salze gelöst werden, sind oft Temperaturänderungen zu beobachten. So löst sich Kaliumchlorid unter Abkühlung, Lithiumchlorid dagegen unter Erwärmung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
