                        "sense_id": "4a7e9c55-ba74-3a54-a09c-5d69f43f25f1",
                        "entry_id": "ee0431c8-084e-3a05-948f-dd6ad82435ab",
                        "glosses": [
                            "bladzijde aan de rechterkant (gezien vanuit de lezer) van een opengeslagen drukwerk dat meestal een oneven paginanummer bevat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e3380ee-b04c-4e27-871e-536438aa9105",
                                "sense_id": "4a7e9c55-ba74-3a54-a09c-5d69f43f25f1",
                                "text": "De twee pagina's, 78 en 79, komen uit het eerste bekende roodgeruite dagboekje dat Anne Frank schreef. Op de linkerpagina van 28 september 1942 staan een paar 'schunnige' moppen en op de rechterpagina geeft ze antwoord op de vraag wat ze zou antwoorden als iemand een jong meisje om seksuele voorlichting zou vragen."
                            },
                            {
                                "example_id": "d40fdc26-9dd0-41a7-9abf-885e895f6c78",
                                "sense_id": "4a7e9c55-ba74-3a54-a09c-5d69f43f25f1",
                                "text": "Ook bladerde hij allerlei kinderboeken door, op zoek naar de beste werkwijze. Daarbij ontdekte hij dat de illustraties vrijwel altijd op de rechterpagina staan, de teksten links."
                            }
                        ]
                    }
