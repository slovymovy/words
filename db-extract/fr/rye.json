                "senses": [
                    {
                        "sense_id": "4783cefa-c258-3dc8-ae0f-1c05d2f779e4",
                        "entry_id": "36601c16-52d1-3b84-b5d8-b329c2546208",
                        "glosses": [
                            "Whisky canadien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8a2fe39-6e9e-44a4-a1a9-a8b4c954146a",
                                "sense_id": "4783cefa-c258-3dc8-ae0f-1c05d2f779e4",
                                "text": "Il y avait un placard derrière moi. Je l'ouvris sans quitter Richard des yeux et je trouvais à tâtons la bouteille de rye ; je bus… quatre, cinq gorgées."
                            },
                            {
                                "example_id": "2735dc75-91f5-48ba-af02-d7373c9e6bc0",
                                "sense_id": "4783cefa-c258-3dc8-ae0f-1c05d2f779e4",
                                "text": "Le whisky n’était pas du bourbon mais du scotch, du White Horse, du bon, pour Gérard du moins : les Yankees buvaient du rye, ils aiment le goût de brillantine."
                            },
                            {
                                "example_id": "e91c7849-ae7a-4d20-b279-13dc54b61119",
                                "sense_id": "4783cefa-c258-3dc8-ae0f-1c05d2f779e4",
                                "text": "Il aurait ouvert le tiroir du bas d’un bras nonchalant, en crochetant la poignée inoxydable avec deux doigts, et aurait pêché par le goulot une bouteille de bourbon ou de rye."
                            }
                        ]
                    }
