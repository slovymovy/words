                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3aaa6cd3-0309-4b30-9c06-65bca6146d2b",
                                "sense_id": "4c8504e9-cdf1-37ba-9686-6d0e6f059a76",
                                "text": "The success of ransomware could be attributed to wide adoption of digital currencies or crypto currencies, such as bitcoin, litecoin ukash, dogecoin, ripple and monero, among others."
                            },
                            {
                                "example_id": "773aeb80-d483-4fc7-9d4d-19df710e7afd",
                                "sense_id": "4c8504e9-cdf1-37ba-9686-6d0e6f059a76",
                                "text": "The net worth of Markus and Palmer is unknown due to their tendency to stay off social media and online platforms. However, dogecoin was estimated to be worth almost $17billion as of April 14, 2021."
                            }
                        ]
                    },
                    {
                        "sense_id": "405e4d8f-f539-3537-9b5a-44896fd7a4f3",
                        "entry_id": "f7056183-4c55-345e-8c2b-2d1b083affb4",
                        "glosses": [
                            "A unit of this currency. Symbols: Ð, DOGE."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "9d04f576-68e4-4f4a-bd65-76f3e0a885f9",
                                "sense_id": "405e4d8f-f539-3537-9b5a-44896fd7a4f3",
                                "text": "And there really are a lot of people willing to pay cash (or at least Bitcoins, which are easily converted into cash) for dogecoins."
                            },
                            {
                                "example_id": "395dec93-4be1-40b7-91ff-93fdd1109c23",
                                "sense_id": "405e4d8f-f539-3537-9b5a-44896fd7a4f3",
                                "text": "Litke and Shear say mining that many dogecoins couldn't be accomplished with the hijacked storage devices alone—each has the cryptocurrency mining power of a smartphone, they say."
                            }
                        ]
                    }
                ],
