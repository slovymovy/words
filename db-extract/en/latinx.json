    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9dd5c799-4f25-32a9-85a3-95de4b982f49",
                "word": "Latinx",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3a369e25-859c-375a-ab14-28d889fa566b",
                        "entry_id": "9dd5c799-4f25-32a9-85a3-95de4b982f49",
                        "glosses": [
                            "Of Latin American descent or origin."
                        ],
                        "tags": [
                            "US",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "376c2138-ecc2-4de3-92f9-faa2e53100f2",
                                "sense_id": "3a369e25-859c-375a-ab14-28d889fa566b",
                                "text": "(which see for more)"
                            },
                            {
                                "example_id": "a29dc489-6050-4049-b066-41f1b0903a06",
                                "sense_id": "3a369e25-859c-375a-ab14-28d889fa566b",
                                "text": "\"Black and/or Latinx transgender people often find ourselves the target of increased police hostility,...\""
                            },
                            {
                                "example_id": "c28edd7d-f2a3-4773-be31-2561e59536fe",
                                "sense_id": "3a369e25-859c-375a-ab14-28d889fa566b",
                                "text": "There is also the fact that, from an early age, people of color— especially young black people and to some extent Hispanic and Latinx/Latino/Latina people—are automatically sexualized to a higher degree by white observers [...]"
                            },
                            {
                                "example_id": "ef9d4b55-833c-4c0f-a760-e513925e6947",
                                "sense_id": "3a369e25-859c-375a-ab14-28d889fa566b",
                                "text": "[…] anti-black racism, anti-Latinx racism, […]"
                            },
                            {
                                "example_id": "68a40578-27ae-4a40-be1d-7b3475be2023",
                                "sense_id": "3a369e25-859c-375a-ab14-28d889fa566b",
                                "text": "Police found no weapon on 93% of the people stopped, and it is unclear what was found on the remaining 7%. Actually, among people that the police frisked, black and Latinx people were less likely than white people to have a weapon on them."
                            }
                        ]
                    }
                ],
                "translations": [],
