                ],
                "translations": [
                    {
                        "translation_id": "6f87a7ce-ee5f-435c-bfe5-d22ddf9930a3",
                        "source_entry_id": "37221695-55cd-3582-8949-ee2c1c045e1d",
                        "target_lang_word": "Titan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Titan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "414357ed-8090-3b46-a0ce-eb9d8a6148ba",
                                        "entry_id": "ddfe78e8-11fc-3ace-a61f-f88ad1eaa348",
                                        "glosses": [
                                            "chemisches Element mit der Ordnungszahl 22, das zur Serie der Übergangsmetalle gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e987bf4-3049-4474-8d5d-1957cbe361b3",
                                                "sense_id": "414357ed-8090-3b46-a0ce-eb9d8a6148ba",
                                                "text": "Titan ist ein hartes und korrosionsbeständiges Metall und das einzige Element, das in einer reinen Stickstoffatmosphäre brennt."
                                            },
                                            {
                                                "example_id": "bb9d65fa-6c40-479e-910a-a612ee4d5867",
                                                "sense_id": "414357ed-8090-3b46-a0ce-eb9d8a6148ba",
                                                "text": "„So lösten die bisher aus Titan hergestellten Hüftgelenke oder Kieferimplantate, im Gegensatz zu Nickel, keinerlei Allergien aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Titan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09d553bd-3a15-3f69-b597-1a89345326e8",
                                        "entry_id": "98e20dbc-a2cb-35f2-b88a-2df51ad91bd9",
                                        "glosses": [
                                            "Gott des ältesten Göttergeschlechts der griechischen Mythologie"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e8469a9-ae5f-454c-9018-feba4559f969",
                                                "sense_id": "09d553bd-3a15-3f69-b597-1a89345326e8",
                                                "text": "Kronos war Anführer der Titanen."
                                            },
                                            {
                                                "example_id": "1e99e672-3687-44da-ad33-d3cc25dcd227",
                                                "sense_id": "09d553bd-3a15-3f69-b597-1a89345326e8",
                                                "text": "„Manche Archäologen sind der Ansicht, dass die sogenannten Jupiter-Giganten-Säulen, die den Himmelsgott im Kampf mit den Titanen darstellen, die keltische Stele in römischer Zeit weiterführen, weil sie nur in gallischen Gebieten vorkommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "470d1ce3-6385-311a-8dfc-af67407bd203",
                                        "entry_id": "98e20dbc-a2cb-35f2-b88a-2df51ad91bd9",
                                        "glosses": [
                                            "Person mit Fähigkeiten, die weit über das normale Maß hinausgehen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8745efe3-b599-43c7-864f-f36a561cac2c",
                                                "sense_id": "470d1ce3-6385-311a-8dfc-af67407bd203",
                                                "text": "Als Dichter ist er ein Titan."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Titan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "540506df-60b7-3337-8112-2edb5ee6c1db",
                                        "entry_id": "3be056ad-c8dc-3ea4-ad74-5705ed114d36",
                                        "glosses": [
                                            "Mond des Planeten Saturn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe864797-c9bd-473b-a435-67047265057e",
                                                "sense_id": "540506df-60b7-3337-8112-2edb5ee6c1db",
                                                "text": "Titan ist der zweitgrößte Mond unseres Sonnensystems."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de2c78f1-6b61-4fc2-ab35-32991b6c7634",
                        "source_entry_id": "37221695-55cd-3582-8949-ee2c1c045e1d",
                        "target_lang_word": "titanium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "titanium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5535c954-22e2-3012-a80b-c92dc0a9b2f9",
                                        "entry_id": "1f607918-3d4c-3bad-9c29-8f1f91117372",
                                        "glosses": [
                                            "A chemical element, atomic number 22; it is a strong, corrosion-resistant transition metal, used to make light alloys for aircraft etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e6764dd-a4e1-40a5-a9f5-465a8f1986a2",
                                                "sense_id": "5535c954-22e2-3012-a80b-c92dc0a9b2f9",
                                                "text": "Even as FDA works to develop that plan, consumers continue to be exposed to unsafe food chemicals including not just dyes but also the artificial sweetener aspartame, the white pigment titanium dioxide, the preservative propylparaben, and the phthalate food packaging chemicals, according to CSPI."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3df5f7e4-a2d0-3a9d-b582-f6276bd6e41f",
                                        "entry_id": "1f607918-3d4c-3bad-9c29-8f1f91117372",
                                        "glosses": [
                                            "A single atom of this element."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8031bbad-44a9-4531-a421-7e5381796949",
                        "source_entry_id": "37221695-55cd-3582-8949-ee2c1c045e1d",
                        "target_lang_word": "titane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "titane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a04e729-61f6-3bdb-997f-bdcb07dcd954",
                                        "entry_id": "8b1b869e-f06f-3888-aa82-8ea6d807eaad",
                                        "glosses": [
                                            "Élément chimique de symbole chimique Ti et de numéro atomique 22 de la série des métaux de transition."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "602ee64a-3ea7-49dc-bdb3-73b8f9e4590f",
                                                "sense_id": "9a04e729-61f6-3bdb-997f-bdcb07dcd954",
                                                "text": "La faible quantité de neutrons s’échappant de la surface témoigne d’une forte abondance de fer et de titane - des éléments qui absorbent efficacement ces particules élémentaires."
                                            },
                                            {
                                                "example_id": "acba6209-4327-4812-8e31-bd8f393801c8",
                                                "sense_id": "9a04e729-61f6-3bdb-997f-bdcb07dcd954",
                                                "text": "Des retouches montrent la présence de titane (Ti), de zinc (Zn), de chrome (Cr) et de cadmium (Cd) qui confirment l’usage de pigments modernes, comme le blanc de titane, le blanc de zinc, le vert oxyde de chrome ou le rouge de cadmium."
                                            },
                                            {
                                                "example_id": "1790fdb3-cac2-4a14-b2a7-4a4c05e152eb",
                                                "sense_id": "9a04e729-61f6-3bdb-997f-bdcb07dcd954",
                                                "text": "[L’impact géant qui a créé le cratère Aitken] a entraîné une instabilité (thermique et chimique) dans le manteau de la face cachée, qui a engendré la migration des roches riches en titane vers la face visible en seulement quelques dizaines de millions d’années."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50053336-b4cf-3ed7-8a05-84f243836dd6",
                                        "entry_id": "8b1b869e-f06f-3888-aa82-8ea6d807eaad",
                                        "glosses": [
                                            "Corps simple élémentaire, métal blanc brillant"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c989a24-b7dc-469e-8756-b102d6b32f9f",
                                                "sense_id": "50053336-b4cf-3ed7-8a05-84f243836dd6",
                                                "text": "On peut ainsi obtenir un matériau autocicatrisant. C’est le cas, par exemple, de la stabilisation de certaines céramiques par l’inclusion de particules de zircone, oxyde de zirconium, un métal assez semblable au titane."
                                            },
                                            {
                                                "example_id": "01589716-b56c-4c78-b3fd-c3ae341ca803",
                                                "sense_id": "50053336-b4cf-3ed7-8a05-84f243836dd6",
                                                "text": "Le titane pur est un métal blanc et brillant, très léger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df0ac42a-0082-3c83-b86d-9cad41a3bf65",
                                        "entry_id": "8b1b869e-f06f-3888-aa82-8ea6d807eaad",
                                        "glosses": [
                                            "Atome (ou, par ellipse, noyau) de titane."
                                        ],
                                        "tags": [
                                            "physical",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b33f6d18-bdf1-4e98-9196-5927367ba7c5",
                                                "sense_id": "df0ac42a-0082-3c83-b86d-9cad41a3bf65",
                                                "text": "L’ajout de deux titanes aux extrémités opposées d’une molécule d’éthylène en fait un adsorbeur d’hydrogène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbfc8ff2-e91a-3435-a5ac-de2b3e108886",
                                        "entry_id": "8b1b869e-f06f-3888-aa82-8ea6d807eaad",
                                        "glosses": [
                                            "Alliages ou pigments de titane, dans leur ensemble."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "060f7cb5-1271-4a72-a0cb-04d36cad327f",
                                                "sense_id": "bbfc8ff2-e91a-3435-a5ac-de2b3e108886",
                                                "text": "Notions d’usinage des titanes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "titane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98502c64-aac0-38a6-83b8-2b677e6b1481",
                                        "entry_id": "6defcb60-66f0-3ea3-90b0-be13d713281d",
                                        "glosses": [
                                            "Titan femelle (personne, animal ou chose)."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb318c82-19e6-4002-8e28-c091cb173fef",
                                                "sense_id": "98502c64-aac0-38a6-83b8-2b677e6b1481",
                                                "text": "Et le peuple, qu’au fond votre impuissance blesse,\nRit devant la titane avortée en diablesse ;"
                                            },
                                            {
                                                "example_id": "66ca67c5-9043-48c1-9081-8f720aed7224",
                                                "sense_id": "98502c64-aac0-38a6-83b8-2b677e6b1481",
                                                "text": "Libérée de ses menottes de dymérite, se tenant bien droite, la tête fièrement relevée, elle avait l’air d’une titane. Avec sa crinière noire désordonnée, on avait l’impression qu’elle touchait la voûte."
                                            },
                                            {
                                                "example_id": "ca956137-3101-497d-b93c-f706eb38b83f",
                                                "sense_id": "98502c64-aac0-38a6-83b8-2b677e6b1481",
                                                "text": "A toujours s’affirmer\nComme cette belle\nQu’elle est\nComme cette lionne\nQu’elle est\nA la force d’une titane\nSous un cœur sulfurant"
                                            }
                                        ]
                                    }
                                ]
                            },
