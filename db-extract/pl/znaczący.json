                ],
                "translations": [
                    {
                        "translation_id": "d20f104d-1b15-49dc-9db4-1b6518106ee4",
                        "source_entry_id": "ae08f976-d6c1-3511-a6b2-f41b13d00864",
                        "source_sense_id": "88ed5bb6-4fda-38f2-b98d-a8dc175d1184",
                        "target_lang_word": "significant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "significant",
