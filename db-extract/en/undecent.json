                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1821a925-04c7-4e9c-98d8-a92ba7dc6432",
                                "sense_id": "cfd1e7ae-e94d-3525-9805-e3994e14c35d",
                                "text": "Conversation is immoral, where the discourse is undecent, immodest, scandalous, slanderous, and abusive."
                            },
                            {
                                "example_id": "f384090e-c92e-46da-9634-31b356980dc4",
                                "sense_id": "cfd1e7ae-e94d-3525-9805-e3994e14c35d",
                                "text": "Such usage is very undecent from one Gentleman to another, and does not at all contribute to the discovery of Truth, which ought to be the great End in all disputes of the Learned."
                            }
                        ]
                    }
