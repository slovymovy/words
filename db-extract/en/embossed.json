                        "cross_references": [
                            {
                                "target_word": "erhaben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d08b05f3-2fac-391c-8973-4f09d0ef7cde",
                                        "entry_id": "3b878d63-41d5-3e93-aeb2-276dbb86dffc",
                                        "glosses": [
                                            "(als Mensch) darüberstehend, unangreifbar; andere weit übertreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d27e01ed-995d-4c86-abc5-f51d799f6728",
                                                "sense_id": "d08b05f3-2fac-391c-8973-4f09d0ef7cde",
                                                "text": "Die Fürstin war über jeden Vorwurf erhaben, nichts konnte mehr ihre Pläne durchkreuzen."
                                            },
                                            {
                                                "example_id": "01f0a779-bd07-4086-9b11-981dac8a79fc",
                                                "sense_id": "d08b05f3-2fac-391c-8973-4f09d0ef7cde",
                                                "text": "„Jakob und ich bestaunen die erhabene Erscheinung dieser Troika wie kleine Jungs den Auftritt eines Weihnachtsmanns samt Rentieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "473f44a2-a2cf-30bf-938e-cffb34c49bdf",
                                        "entry_id": "3b878d63-41d5-3e93-aeb2-276dbb86dffc",
                                        "glosses": [
                                            "aus der Fläche nach oben gewölbt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a1caef5-cd80-42f8-a75d-7467e8dda2e0",
                                                "sense_id": "473f44a2-a2cf-30bf-938e-cffb34c49bdf",
                                                "text": "Den Vorläufer der erhabenen Schnitzerei finden wir in der Wachstechnik, bei der die Zwischenräume zwischen den Motiven aus dem Holz herausgeschnitten wurden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f6de9c17-b209-3f18-977f-3bd8d87c8f1d",
                                        "entry_id": "3b878d63-41d5-3e93-aeb2-276dbb86dffc",
                                        "glosses": [
                                            "voller großer und feierlicher Gefühle"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54e563eb-eafd-4456-941d-f46cc1654b62",
                                                "sense_id": "f6de9c17-b209-3f18-977f-3bd8d87c8f1d",
                                                "text": "Es war schon ein erhabener Moment, als im großen Rathaussaal die Urkunden überreicht wurden."
                                            },
                                            {
                                                "example_id": "239275c1-9b97-4a1e-8bd3-0bd0f81b8c66",
                                                "sense_id": "f6de9c17-b209-3f18-977f-3bd8d87c8f1d",
                                                "text": "Tiefe Einsamkeit ist erhaben, aber auf eine schreckliche Art."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
