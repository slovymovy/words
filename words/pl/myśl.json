            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1cc8becf-42b6-3cd4-8231-7f393b8b6340",
                    "sense_definition": "wytwór pracy umysłu, pojedynczy akt poznawczy",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "procesy_umysłowe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta <w>myśl</w> nie dawała mu spokoju przez całą noc.",
                            "target_lang_translations": {
                                "ru": "Эта <w>мысль</w> не давала ему покоя всю ночь."
                            }
                        },
                        {
                            "text": "Przyszła mi do głowy pewna <w>myśl</w> dotycząca naszego projektu.",
                            "target_lang_translations": {
                                "ru": "Мне пришла в голову одна <w>мысль</w> касательно нашего проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "myślenie"
                    ],
                    "common_phrases": [
                        "przyjść na myśl",
                        "zmienić myśl"
                    ],
                    "target_lang_definitions": {
                        "ru": "результат мыслительной деятельности, идея или отдельный акт познания"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мысль",
                                "target_lang_sense_clarification": "результат процесса мышления, идея"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bffcb90-0ade-3f76-b8b8-ab12d5bdb985",
                    "sense_definition": "pomysł lub plan działania",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "procesy_umysłowe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mam świetną <w>myśl</w> – pojedźmy w góry w ten weekend.",
                            "target_lang_translations": {
                                "ru": "У меня отличная <w>идея</w> — давайте поедем в горы в эти выходные."
                            }
                        },
                        {
                            "text": "To była bardzo odważna <w>myśl</w>, aby otworzyć własną firmę.",
                            "target_lang_translations": {
                                "ru": "Это была очень смелая <w>затея</w> — открыть собственную фирму."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mieć myśl"
                    ],
                    "target_lang_definitions": {
                        "ru": "замысел, план или идея для реализации чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идея",
                                "target_lang_sense_clarification": "замысел, план действий"
                            },
                            {
                                "target_lang_word": "задумка",
                                "target_lang_sense_clarification": "намерение, еще не реализованный план"
                            },
                            {
                                "target_lang_word": "затея",
                                "target_lang_sense_clarification": "предпринятое дело, часто творческое или развлекательное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a7ee8b2-9488-3e6d-85cf-b20d1a424767",
                    "sense_definition": "zbiór poglądów lub ideologia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "procesy_umysłowe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Współczesna <w>myśl</w> filozoficzna często odwołuje się do etyki.",
                            "target_lang_translations": {
                                "ru": "Современная философская <w>мысль</w> часто обращается к этике."
                            }
                        },
                        {
                            "text": "Poznałem główną <w>myśl</w> tego autora podczas wykładu na uczelni.",
                            "target_lang_translations": {
                                "ru": "Я узнал главную <w>идею</w> этого автора во время лекции в университете."
                            }
                        }
                    ],
                    "common_phrases": [
                        "myśl przewodnia"
                    ],
                    "target_lang_definitions": {
                        "ru": "система взглядов, идеология или основная концепция"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мысль",
                                "target_lang_sense_clarification": "философская или научная концепция"
                            },
                            {
                                "target_lang_word": "идея",
                                "target_lang_sense_clarification": "основная концепция или мировоззренческий принцип"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8dc2ae04-4ccb-3a9e-8d39-773fc7e291eb",
                    "sense_definition": "druga osoba liczby pojedynczej trybu rozkazującego od <w>myśleć</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "czasownik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Myśl</w> pozytywnie, a wszystko się ułoży.",
                            "target_lang_translations": {
                                "ru": "<w>Думай</w> позитивно, и всё наладится."
                            }
                        },
                        {
                            "text": "Często <w>myśl</w> o swoich celach, aby nie stracić motywacji.",
                            "target_lang_translations": {
                                "ru": "Часто <w>думай</w> о своих целях, чтобы не терять мотивацию."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "forma czasownika"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "повелительное наклонение глагола «думать» (второе лицо, ед. число)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "думай",
                                "target_lang_sense_clarification": "повелительная форма глагола «думать»"
                            }
                        ]
                    }
                }
            ]
        }
