    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc981b5d-705a-3a20-9196-1ae5be431bbb",
                    "sense_definition": "sich von etwas lösen und zu Boden fallen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "herunterfallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Herbst <w>fallen</w> die bunten Blätter von den Bäumen <w>ab</w>."
                        },
                        {
                            "text": "Wenn die reife Frucht nicht gepflückt wird, <w>fällt</w> sie bald von selbst <w>ab</w>."
                        }
                    ],
                    "common_phrases": [
                        "von selbst abfallen"
                    ]
                },
                {
                    "sense_id": "980c00d7-de1b-349f-88b0-da8e94ad24d2",
                    "sense_definition": "geringer oder schwächer werden; an Wert, Druck oder Leistung verlieren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sinken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Nacht <w>fällt</w> die Temperatur in den Bergen stark <w>ab</w>."
                        },
                        {
                            "text": "Gegen Ende des langen Rennens <w>fiel</w> seine Leistung spürbar <w>ab</w>."
                        }
                    ],
                    "antonyms": [
                        "ansteigen"
                    ],
                    "common_phrases": [
                        "stark abfallen",
                        "deutlich abfallen"
                    ],
                    "synonyms": [
                        "sinken",
                        "nachlassen"
                    ]
                },
                {
                    "sense_id": "a6f46d44-8552-3f78-8826-2c6ce87b471b",
                    "sense_definition": "schräg nach unten verlaufen; eine Neigung oder ein Gefälle aufweisen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "neigung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der schmale Weg <w>fällt</w> zum Fluss hin ziemlich steil <w>ab</w>."
                        },
                        {
                            "text": "Hinter dem kleinen Haus <w>fällt</w> das Gelände sanft zu einer Wiese <w>ab</w>."
                        }
                    ],
                    "antonyms": [
                        "ansteigen"
                    ],
                    "common_phrases": [
                        "steil abfallen",
                        "sanft abfallen"
                    ]
                },
                {
                    "sense_id": "f0b0128c-930e-3305-8b0d-889721488177",
                    "sense_definition": "bei einer Tätigkeit als Nebenprodukt oder Rest entstehen bzw. als kleiner Gewinn übrig bleiben",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uebrigbleiben",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim Zuschneiden des Holzes <w>fällt</w> jede Menge Sägemehl <w>ab</w>."
                        },
                        {
                            "text": "Vielleicht <w>fällt</w> bei diesem großen Geschäft auch für uns eine kleine Prämie <w>ab</w>."
                        }
                    ],
                    "common_phrases": [
                        "für jemanden abfallen"
                    ]
                },
                {
                    "sense_id": "81412713-3944-3808-bfb5-1ec561bea982",
                    "sense_definition": "sich von einer Gemeinschaft, einem Glauben oder einer Vereinbarung lossagen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "untreue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Viele Mitglieder sind nach dem Führungswechsel von der Partei <w>abgefallen</w>."
                        },
                        {
                            "text": "Während der Reformation <w>fielen</w> viele Fürsten vom alten Glauben <w>ab</w>."
                        }
                    ],
                    "common_phrases": [
                        "vom Glauben abfallen"
                    ]
                },
                {
                    "sense_id": "86add51c-94d7-34a7-8c44-22864b3e0f34",
                    "sense_definition": "ein Boot oder Segelschiff so steuern, dass es sich weiter vom Wind wegdreht",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "segeln",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Um die nächste Boje zu umrunden, musste die Mannschaft rasch vom Wind <w>abfallen</w>."
                        },
                        {
                            "text": "Die Steuerfrau <w>fiel</w> leicht <w>ab</w>, um das Boot bei der starken Böe zu stabilisieren."
                        }
                    ],
                    "antonyms": [
                        "anluven"
                    ],
                    "common_phrases": [
                        "vom Wind abfallen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ec9ca83-70b9-354f-818e-f35cd51d2b12",
                    "sense_definition": "das Sichlösen und Heruntersinken oder das Absinken von Werten",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "herunterfallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das plötzliche <w>Abfallen</w> des Luftdrucks kündigt oft ein schweres Gewitter an."
                        },
                        {
                            "text": "Das herbstliche <w>Abfallen</w> der Blätter schützt den Baum vor dem Austrocknen."
                        }
                    ]
                }
            ]
        }
    ]
}