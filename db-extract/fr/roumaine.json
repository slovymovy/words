                "senses": [
                    {
                        "sense_id": "e4bd1b43-57f9-3928-a9ed-6f743da5bd58",
                        "entry_id": "545db402-e194-30b2-b950-a3c38ac1f713",
                        "glosses": [
                            "Habitante ou personne originaire de la Roumanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8e404a2-3aa8-420d-9ec1-75c858ec830e",
                                "sense_id": "e4bd1b43-57f9-3928-a9ed-6f743da5bd58",
                                "text": "Gladys raconta que son mari, en reportage à Bucarest, « s’amusait sûrement là-bas avec de belles Roumaines » : aussi pourquoi ne « s'enjoyerait-elle » pas de son côté ?"
                            },
                            {
                                "example_id": "c798166f-5703-49fa-a10b-fef6984f00c9",
                                "sense_id": "e4bd1b43-57f9-3928-a9ed-6f743da5bd58",
                                "text": "Cette fois, elle n’a eu besoin que d’une heure et trois minutes de jeu pour s’adjuger cette demi-finale et rejoindre la Roumaine Ana Bogdan sur la dernière marche."
                            }
                        ]
                    }
                ],
