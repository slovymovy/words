                        "glosses": [
                            "Propriété de tissu organique à être sensible aux rayons ionisants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "950136f3-04d2-4181-8939-9322e5ccadeb",
                                "sense_id": "4fa0f431-d75f-3143-9109-3a022ae7ad43",
                                "text": "Selon que la radiosensibilité prévisible est faible ou forte, la chirurgie ou la radiothérapie seront choisies."
                            },
                            {
                                "example_id": "42cae3cb-537f-4a6f-807f-691c6c5f60a2",
                                "sense_id": "4fa0f431-d75f-3143-9109-3a022ae7ad43",
                                "text": "La radiosensibilité augmente en présence d’oxygène (agents radiosensibilisants) ou avec l’élévation de température."
                            }
                        ]
                    }
                ],
