                        "cross_references": [
                            {
                                "target_word": "Weimar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79bf5279-e586-3997-a871-8f6a659a8e1f",
                                        "entry_id": "43bc17e4-1bb7-3a92-99c3-8c2448f1182b",
                                        "glosses": [
                                            "Ville, commune et arrondissement d’Allemagne, située dans la Thuringe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07acf404-4e3f-4449-b317-27f3e80ef769",
                                                "sense_id": "79bf5279-e586-3997-a871-8f6a659a8e1f",
                                                "text": "Je me décide à leur parler allemand : pour qu'ils comprennent mieux, j'emploie mon haut allemand le plus clair, la langue officielle des théâtres de Meiningen et de Weimar, le hanovrien saccadé des auteurs juifs qui déclament les traductions de Verlaine."
                                            },
                                            {
                                                "example_id": "31583269-92b6-4004-8f66-2d83c1a8e4c8",
                                                "sense_id": "79bf5279-e586-3997-a871-8f6a659a8e1f",
                                                "text": "— On se pèle le cul en Scandinavie, tu sais, ajouta Wilhelm. Les hivers de Weimar, c’est de la rigolade à côté des nôtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b429632-e9d7-39c4-832c-f8b69e2883b9",
                                        "entry_id": "43bc17e4-1bb7-3a92-99c3-8c2448f1182b",
                                        "glosses": [
                                            "Commune d’Allemagne, située dans la Hesse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d86f13f-35bf-35a2-ba1b-1e86a9441bed",
                                        "entry_id": "43bc17e4-1bb7-3a92-99c3-8c2448f1182b",
                                        "glosses": [
                                            "Abréviation de République de Weimar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34fbe6ac-6a10-43fc-915f-6a1c583a7352",
                                                "sense_id": "1d86f13f-35bf-35a2-ba1b-1e86a9441bed",
                                                "text": "Weimar est une histoire si vivante qu’elle ressuscite les morts et qu’elle n’en finit plus d’interroger l’Allemagne et, au-delà, toutes les démocraties qui, avec la séquence 1932-1933, avec von Papen et Hitler, mais aussi avec Schleicher, Hindenburg, Hugenberg et Thyssen, sont confrontées à leur finitude. Si la Grande Guerre a enseigné aux civilisations qu’elles sont mortelles, la fin de la République de Weimar a montré que la démocratie est périssable. Weimar est un signifiant inépuisable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37a23cb3-137e-43ed-88e9-723b243934a1",
                        "source_entry_id": "28d60580-d5b1-3dd0-ae5e-267054934dda",
                        "source_sense_description": "city",
                        "target_lang_word": "Weimar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weimar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e1e3157-4fdf-3b21-973f-6ec8bdd84a1c",
                                        "entry_id": "4ee4275c-c342-389b-b6a6-eb1120f2b3fb",
                                        "glosses": [
                                            "Stadt in Thüringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccbd433d-ca22-4d26-b1cc-f1669b1001a7",
                                                "sense_id": "0e1e3157-4fdf-3b21-973f-6ec8bdd84a1c",
                                                "text": "„Man erinnere sich bloß an seinen 250. Geburtstag vor acht Jahren: Ein Jahr lang stand Weimar, die Kulturhauptstadt von 1999, Kopf.“"
                                            },
                                            {
                                                "example_id": "7693a0d4-49a5-4dc7-a72b-d70c68e61d05",
                                                "sense_id": "0e1e3157-4fdf-3b21-973f-6ec8bdd84a1c",
                                                "text": "„Ab dem 1. April ist im Schlossmuseum Weimar die Ausstellung „Ereignis Weimar – Anna Amalia, Carl August und das Entstehen der Klassik 1757-1807“ zu besichtigen, in der mit über 500 Exponaten die Entwicklung des Herzogtums zur „kulturellen Großmacht“ skizziert wird.“"
                                            },
                                            {
                                                "example_id": "17dbe227-8b20-4f8d-b5a2-c00adb28dfe4",
                                                "sense_id": "0e1e3157-4fdf-3b21-973f-6ec8bdd84a1c",
                                                "text": "„Weimar würdigt seinen berühmtesten Bürger mit einigen kulturellen Veranstaltungen.“"
                                            },
                                            {
                                                "example_id": "c5f472ed-06e9-4e7f-8167-d72b2f2836ab",
                                                "sense_id": "0e1e3157-4fdf-3b21-973f-6ec8bdd84a1c",
                                                "text": "„In Weimar wird die Angelegenheit beim Geheimen Consilium besprochen, zwischen dem Minister Fritsch und Görtz kommt es zu einem heftigen Schlagabtausch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c4bd88b9-c550-3976-87a9-e2eaad782aa5",
                                        "entry_id": "4ee4275c-c342-389b-b6a6-eb1120f2b3fb",
                                        "glosses": [
                                            "kurz für: Weimarer Republik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75cc6519-5761-45bd-9938-9abc444913b8",
                                                "sense_id": "c4bd88b9-c550-3976-87a9-e2eaad782aa5",
                                                "text": "„Auch nach dem Untergang Weimars und der Niederschlagung des europäischen Faschismus hat die Geschichte von Paul Bäumer und seinen Kameraden jede heranwachsende Generation bewegt und gefesselt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
