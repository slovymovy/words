                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70af2944-6cd4-480c-8617-5d4f5169bb38",
                                "sense_id": "d944cccc-4611-3a3b-907c-a3101ed5f0af",
                                "text": "Musicie zobaczyć Akropol podczas pobytu w Grecji."
