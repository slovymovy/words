                                "target_senses": [
                                    {
                                        "sense_id": "3372f618-2dcd-3731-a412-7c9d16155be7",
                                        "entry_id": "7953d636-65e8-3f91-b60f-6f707c166aa6",
                                        "glosses": [
                                            "That bakes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8ee1b4b-bd2d-42d2-a29f-e97dbf32e222",
                                                "sense_id": "3372f618-2dcd-3731-a412-7c9d16155be7",
                                                "text": "baking bread; baking clay"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6c42109-526a-377b-ad9c-4551bc087edd",
                                        "entry_id": "7953d636-65e8-3f91-b60f-6f707c166aa6",
                                        "glosses": [
                                            "Of a person, an object, or the weather: very hot; boiling, broiling, roasting."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c649d056-1397-4814-8dfd-1e5e764b03f8",
                                                "sense_id": "e6c42109-526a-377b-ad9c-4551bc087edd",
                                                "text": "I’m baking—could you open the window?"
                                            },
                                            {
                                                "example_id": "4fc4acc9-4727-4097-a19d-ed4a06538e8a",
                                                "sense_id": "e6c42109-526a-377b-ad9c-4551bc087edd",
                                                "text": "The car was baking after having been parked in the sun the whole afternoon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6ef0098-8eed-3feb-bde1-21dc329e168d",
                                        "entry_id": "e387db2f-c8c7-3826-8820-cdfc125343f8",
                                        "glosses": [
                                            "An action in which something is baked."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "049d7256-5707-4995-ae4b-0f5558341411",
                                                "sense_id": "d6ef0098-8eed-3feb-bde1-21dc329e168d",
                                                "text": "I’m going to do some baking this afternoon."
                                            },
                                            {
                                                "example_id": "2320266a-dedb-440c-842c-f863cb754b39",
                                                "sense_id": "d6ef0098-8eed-3feb-bde1-21dc329e168d",
                                                "text": "Upon these terms, after working hard all day for her mistress, she began her midnight bakings, assisted by her two oldest children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "663fc308-2ee9-3c63-9723-e7e3707de352",
                                        "entry_id": "e387db2f-c8c7-3826-8820-cdfc125343f8",
                                        "glosses": [
                                            "The way in which something is baked."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3721252-1972-4906-8b31-ed0c003fd34c",
                                                "sense_id": "663fc308-2ee9-3c63-9723-e7e3707de352",
                                                "text": "How often have we risen in the morning, after spending the night in this manner, with a feeling akin to that which we fancy would come from being knocked in the head with a sack of meal, then gently stewed, and all out of pure fraternal regard to supply any deficiencies in our original bakings."
                                            },
                                            {
                                                "example_id": "9940faca-c5d0-42b5-b925-326787d6987d",
                                                "sense_id": "663fc308-2ee9-3c63-9723-e7e3707de352",
                                                "text": "Clissold’s work of cooking has fallen on Hooper and Lashly, and it is satisfactory to find that the various dishes and bread bakings maintain their excellence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "595a3247-e533-3a04-8323-d0fed8c72186",
                                        "entry_id": "e387db2f-c8c7-3826-8820-cdfc125343f8",
                                        "glosses": [
                                            "The production of a batch of baked product."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7324450f-fe2b-4f9a-90f1-885734a80282",
                        "source_entry_id": "bf26387b-c790-31e9-8f4f-a6040e7ca3b2",
                        "source_sense_id": "bbf6fdf3-51c3-3308-93eb-cdf4be4d8ed7",
                        "target_lang_word": "Gebäck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebäck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "728bdc90-6785-3356-8482-18a8cd831a82",
                                        "entry_id": "a0e334f1-cbd6-3798-8f38-0f507e322fbe",
                                        "glosses": [
                                            "Speise auf Mehlbasis, welche auf einem Backblech oder in einer Form in einem Ofen oder in Fett in einer Pfanne eine ausreichend lange Zeit ausgebacken wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cea96b6e-b556-48af-96f2-a34d6b177add",
                                                "sense_id": "728bdc90-6785-3356-8482-18a8cd831a82",
                                                "text": "„Ach, wenn meine Gattin aufwacht, nimmt sie gern eine Tasse Tee mit etwas Gebäck.“ (Loriot)"
                                            },
                                            {
                                                "example_id": "e321bece-d9ee-4ec1-9251-bef85c87d686",
                                                "sense_id": "728bdc90-6785-3356-8482-18a8cd831a82",
                                                "text": "„Der Verein für Konsumenteninformation hat rechtzeitig zur Krapfen-Hochsaison das beliebte Gebäck unter die Lupe genommen. 13 Faschingskrapfen in der gängigsten Variante, also mit Füllung aus Marillenmarmelade, wurden untersucht.“"
                                            },
                                            {
                                                "example_id": "ca7c4605-01d7-4e2d-a2bb-7d7429935734",
                                                "sense_id": "728bdc90-6785-3356-8482-18a8cd831a82",
                                                "text": "„Die Pizza ist doch ein sonderbares Gebäck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da0d72c7-408d-4699-83d7-b191ae652d96",
                        "source_entry_id": "bf26387b-c790-31e9-8f4f-a6040e7ca3b2",
