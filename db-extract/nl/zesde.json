                "senses": [
                    {
                        "sense_id": "994de929-4c75-3689-804f-c7ed55b7bbef",
                        "entry_id": "cd7a86b1-4906-313d-b7cd-625a8126c173",
                        "glosses": [
                            "nummer zes in een rij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53a2e4f9-f89a-4386-9373-cbde4c6d4ff0",
                                "sense_id": "994de929-4c75-3689-804f-c7ed55b7bbef",
                                "text": "Hij werd zesde in de slalom."
                            },
                            {
                                "example_id": "534501aa-f00e-4664-9bfb-481522aafb93",
                                "sense_id": "994de929-4c75-3689-804f-c7ed55b7bbef",
                                "text": "De tweede werd geboren in de zesde eeuw. Eigenlijk was hij een zeer eenvoudige monnik, die later abt werd van het klooster in Myra. Een bijzonder vrome man, die door zijn gebed de mensen kon genezen. Hij overleed op 10 december van het jaar 564."
                            },
                            {
                                "example_id": "d37834ed-ab7a-4980-93af-994d008a901d",
                                "sense_id": "994de929-4c75-3689-804f-c7ed55b7bbef",
                                "text": "Kort na mijn terugkomst liep mijn vrouw in haar eentje voor de zesde keer naar Santiago de Compostela."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f8c1a6e-6033-3a02-ba66-ebee43940cbb",
                        "entry_id": "cd7a86b1-4906-313d-b7cd-625a8126c173",
                        "glosses": [
                            "gedeeld door zes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f0dd889-6967-445f-82c1-23676afbbecd",
                                "sense_id": "1f8c1a6e-6033-3a02-ba66-ebee43940cbb",
                                "text": "Een zesde van de aanwezigen kwam uit Vlaanderen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
