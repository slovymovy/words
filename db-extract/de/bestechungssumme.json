                ],
                "senses": [
                    {
                        "sense_id": "c8b1e3ba-3f3f-3132-8152-0a2fbdfdf153",
                        "entry_id": "cae2b45d-2627-32b3-9f3e-95dec7bc2656",
                        "glosses": [
                            "Geldsumme, die als Bestechung gezahlt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a57f805-3ac9-4584-a68a-e4fcb4ef0051",
                                "sense_id": "c8b1e3ba-3f3f-3132-8152-0a2fbdfdf153",
                                "text": "„Allerdings war die Akte ans zuständige Ministerium weitergeleitet worden, und von dort aus hatte ihnen ein kleinerer Beamter mitgeteilt, zur Bearbeitung ihres Falles sei die Zahlung einer Bestechungssumme in Höhe von zweitausend Rupien erforderlich.“"
                            },
                            {
                                "example_id": "02f8c1dc-9714-4f57-9188-e63af5145669",
                                "sense_id": "c8b1e3ba-3f3f-3132-8152-0a2fbdfdf153",
                                "text": "„Der eigene Sohn des Präsidenten wurde als Minister für das Fernmeldewesen eingesetzt und begann Bestechungssummen zu fordern, die selbst für libanesische Verhältnisse horrend waren.“"
                            },
                            {
                                "example_id": "0d962a40-bb92-45f3-9011-371c09cb2281",
                                "sense_id": "c8b1e3ba-3f3f-3132-8152-0a2fbdfdf153",
                                "text": "„Ich ging davon aus, dass sie in ihrem Versuch, sich Gerechtigkeit zu kaufen, erfolgreich sein würden, verdreifachte folglich die Höhe der Bestechungssumme, legte sie ihnen als Strafe auf und beschloss, in gleicher Weise gegen jenen vorzugehen, der versucht hatte, die Senatoren zu bestechen.“"
                            },
                            {
                                "example_id": "a8cde994-4b90-4770-ad68-0647fdee321c",
                                "sense_id": "c8b1e3ba-3f3f-3132-8152-0a2fbdfdf153",
                                "text": "„›Ich hab’ gehört, dass Blanchard drüben im Club Satan einen solchen Aufstand gemacht hat, dass er sich mit einer happigen Bestechungssumme bei Captain Vasquez freikaufen musste.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
