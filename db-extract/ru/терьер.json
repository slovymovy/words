                                        "entry_id": "15919bf7-14dc-30a1-8c0c-d96aa1c23f1c",
                                        "glosses": [
                                            "Race de chien qui a pour fonction au départ de déterrer des nuisibles réfugiés dans leurs terriers ou abris souterrains."
                                        ],
                                        "tags": [
                                            "Cynologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "912e212b-dce2-4362-97a0-03ac65792d0a",
                                                "sense_id": "f5d13c65-b02c-3b09-a9fe-813ed41ed454",
                                                "text": "Les terriers forment le groupe 3 du classement des races de chien par la société centrale canine ou SCC."
                                            },
                                            {
                                                "example_id": "8eec5385-2bf1-4993-8153-78bad02021b7",
                                                "sense_id": "f5d13c65-b02c-3b09-a9fe-813ed41ed454",
                                                "text": "Un petit terrier écossais soufflait lamentablement, la langue dehors."
                                            },
                                            {
                                                "example_id": "704675f0-e47b-400e-9daa-675151983fb0",
                                                "sense_id": "f5d13c65-b02c-3b09-a9fe-813ed41ed454",
                                                "text": "La nacelle avait l’air de traîner le cylindre récalcitrant, à la façon dont un vaillant petit terrier remorquerait un timide éléphant."
                                            }
                                        ]
                                    }
