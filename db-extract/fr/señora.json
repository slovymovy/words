                    {
                        "sense_id": "6af46e05-70c0-3043-a160-82b510114d64",
                        "entry_id": "8d76ef9b-00c9-354b-8e37-5631795da1c5",
                        "glosses": [
                            "Dame, en Espagne ou dans les pays hispanophones."
                        ],
                        "tags": [
                            "Hispanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "a3e5d52d-b59c-48df-839a-449dd21e2f35",
                                "sense_id": "6af46e05-70c0-3043-a160-82b510114d64",
                                "text": "On voit aussi des gens de la campagne qui arrivent à cheval, la carabine à l’arçon de la selle ; d’autres sur des ânes, seuls ou avec leurs femmes ; tout cela sans compter les calèches des gens du grand monde, et une foule d’honnêtes citadins et de señoras en mantille qui se hâtent et pressent le pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a0b848e-fd2b-387c-b91e-db39a34079cf",
                        "entry_id": "8d76ef9b-00c9-354b-8e37-5631795da1c5",
                        "glosses": [
                            "Parfois utilisé pour introduire le nom d'une dame espagnole."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40902f07-286f-41d7-a775-5ce0970e9630",
                                "sense_id": "5a0b848e-fd2b-387c-b91e-db39a34079cf",
                                "text": "Après avoir longuement réfléchi, la señora Galina prend le parti d'ouvrir le pli, afin, s'il est nécessaire, de préparer la reine avec ménagements à la pénible nouvelle."
                            }
                        ]
                    }
