                    {
                        "sense_id": "91ca1d67-3818-3c9a-bdf9-02e9f162f60e",
                        "entry_id": "11e76f18-3ef5-3c2b-abde-7f8a69a985e8",
                        "glosses": [
                            "Band, die ohne instrumentale Begleitung (a cappella) singt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "6fce3217-5dd1-40bd-8629-855cd70444d7",
                                "sense_id": "91ca1d67-3818-3c9a-bdf9-02e9f162f60e",
                                "text": "„Am 17. Juni gastiert dann die A-Cappella-Band Viva Voce im Rahmen der Matineen erstmalig in Regensburg.“"
                            },
                            {
                                "example_id": "8f567b22-7015-4faa-9b61-23cb3de7c614",
                                "sense_id": "91ca1d67-3818-3c9a-bdf9-02e9f162f60e",
                                "text": "„Vier kreative Persönlichkeiten, vier starke Solostimmen, die zusammen eine furiose A-Cappella-Band bilden.“"
                            },
                            {
                                "example_id": "2fb7dc4a-8f11-4195-a761-ef810343a3fc",
                                "sense_id": "91ca1d67-3818-3c9a-bdf9-02e9f162f60e",
                                "text": "„Er singt noch in einer A-Cappella-Band, kommt aber auch eher schlecht als recht mit seinem Lebensunterhalt aus.“"
                            }
                        ],
