                        "form_id": "a7796bbc-c450-43da-9095-791024c94384",
                        "entry_id": "86cc35c1-4055-31de-904a-73dc6e087df9",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "грему́чи"
                    },
                    {
                        "form_id": "71b2fe27-8fb9-4c6a-b716-be9fa5685d59",
                        "entry_id": "86cc35c1-4055-31de-904a-73dc6e087df9",
                        "tags": [
                            "comparative"
                        ],
                        "form": "грему́чее"
                    },
                    {
                        "form_id": "e98aa562-9fcb-4515-bc73-c12e3fb169d1",
                        "entry_id": "86cc35c1-4055-31de-904a-73dc6e087df9",
                        "tags": [
                            "comparative"
                        ],
                        "form": "грему́чей"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "951c282a-4ccd-35d5-a692-88f2f3463956",
                        "entry_id": "86cc35c1-4055-31de-904a-73dc6e087df9",
                        "glosses": [
                            "звонко шумящий; гремящий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de772fc1-c662-4b2f-87e4-472fc5d346c4",
                                "sense_id": "951c282a-4ccd-35d5-a692-88f2f3463956",
                                "text": "Что может быть лучше ― прицепить такой вагончик к автомобилю, выехать из гремучего города и помчаться, помчаться куда глаза глядят!"
                            },
                            {
                                "example_id": "f3e52718-92cc-45ce-bc5b-12eb5b6fe3ae",
                                "sense_id": "951c282a-4ccd-35d5-a692-88f2f3463956",
                                "text": "И гремучая дробь перепелиного боя, и усыпляющее пение жаворонков, и теплый ветер, наплывавший из-за Дона с неостывших за ночь песков, ― все располагало ко сну."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0d5b6d3-b1fb-3e1c-bd05-b920c13a0f56",
                        "entry_id": "86cc35c1-4055-31de-904a-73dc6e087df9",
                        "glosses": [
                            "перен. или хим. взрывчатый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d21052a4-92a9-4ff5-8e2a-05605c039af9",
                                "sense_id": "a0d5b6d3-b1fb-3e1c-bd05-b920c13a0f56",
                                "text": "Эта сила, гремучая, огненно-холодная материя, ― освобождаясь, устремлялась в пространство."
                            },
                            {
                                "example_id": "d1bea53c-fa90-475c-84cb-43e1ca0c063b",
                                "sense_id": "a0d5b6d3-b1fb-3e1c-bd05-b920c13a0f56",
                                "text": "Как уже сказано, таких взрывчатых смесей множество, например обыкновенный светильный газ в смеси с воздухом дает гремучую, т. е. взрывчатую, смесь; к этой категории относится и рудничный газ."
                            }
                        ]
                    }
                ],
