                        "душа компании",
                        "в компании друзей",
                        "водить компанию"
                    ],
                    "target_lang_definitions": {
                        "en": "A group of people, friends, or acquaintances who spend time together.",
                        "zh": "一起消磨时间的一群人、朋友或熟人。"
                    },
