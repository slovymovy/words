                                        "entry_id": "d9e97657-ffe1-3595-aea9-343056c0979d",
                                        "glosses": [
                                            "jemanden zu etwas Bösem animieren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f861870d-732c-4644-a50f-13778a15d3d9",
                                                "sense_id": "b2f2b33c-6685-39de-ba34-51c3db5e2864",
                                                "text": "„Jetzt aber, da sich all seine düsteren Prophezeiungen über die ›blutige Jezabel‹ und das Unheil, das sie durch ihre Leichtfertigkeit anstiften werde, in verblüffender Weise erfüllt und übertroffen haben, kehrt er im Mantel des Propheten nach Edinburgh zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66bde371-a00e-4148-a090-c707394b88ac",
                        "source_entry_id": "467d2a16-77e8-34d2-b0c9-8351853dad27",
                        "source_sense_id": "1aa74ac9-f09c-32c1-ab73-f0f07d68eea3",
                        "target_lang_word": "verleiten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verleiten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ab0c237-01b3-3968-9765-cf2e83ef8d48",
                                        "entry_id": "63847305-053f-30f9-8d64-366dc8048bb3",
                                        "glosses": [
                                            "jemanden zu einer Handlung veranlassen, die er von sich aus nicht gemacht hätte"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7491d88-18ef-46a2-adf0-18efbecfb1ba",
                                                "sense_id": "9ab0c237-01b3-3968-9765-cf2e83ef8d48",
                                                "text": "„Nun zeigen US-amerikanische Studien, dass die fettreduzierten Lebensmittel genau das Gegenteil erreichen: Sie verleiten Menschen eher dazu, mehr zu essen.“"
                                            },
                                            {
                                                "example_id": "66ccbdf9-836c-4568-b249-62b9229cb233",
                                                "sense_id": "9ab0c237-01b3-3968-9765-cf2e83ef8d48",
                                                "text": "„Das Verleiten zum Vertragsbruch ist grundsätzlich sittenwidrig, das Verleiten zur ordentlichen Vertragsauflösung nur dann, wenn es unter sittenwidrigen Begleitumständen geschieht.“"
                                            }
                                        ],
