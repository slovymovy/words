                "senses": [
                    {
                        "sense_id": "585d5334-e626-3b61-ac58-705041aae541",
                        "entry_id": "5933da0b-7d27-368b-a8de-fcef32899c52",
                        "glosses": [
                            "dameskous met grote diamantvormige mazen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e35ef51c-22c1-4989-bae9-9085e9f44da2",
                                "sense_id": "585d5334-e626-3b61-ac58-705041aae541",
                                "text": "Aan de uitgang treffen we Valery, gehuld in rode latextop en netkousen. ‘Dit zijn te veel indrukken voor mij’, zegt ze. ‘Er is nergens een chillzone op het terrein om te bekomen. Trop is te veel.’ Al kan ze wel nog lachen om de Kortrijkzanen die grote ogen trekken als ze twee mannen in Borat-string zien voorbijhuppelen."
                            },
                            {
                                "example_id": "9d31df8a-164b-482d-90e7-9ea4a8dcc215",
                                "sense_id": "585d5334-e626-3b61-ac58-705041aae541",
                                "text": "Mariah Carey heeft haar volgers vandaag met een reeks opvallende kiekjes en korte filmpjes verblijd. Op de beelden is te zien hoe de zangeres aan het 'sporten' is in netkousen en op bijzonder hoge hakken."
                            }
                        ]
                    }
