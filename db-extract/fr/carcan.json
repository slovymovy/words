                    {
                        "sense_id": "964f0c28-b7b7-3028-8c22-d3f978d4fc97",
                        "entry_id": "47acfe4d-38ba-34b1-a829-d32c729b52f5",
                        "glosses": [
                            "straitjacket"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "64ebaaca-75b1-4a41-a188-ba7518b443c4",
                                "sense_id": "964f0c28-b7b7-3028-8c22-d3f978d4fc97",
                                "text": "J'en ai assez de ce carcan qui m'enferme dans toutes ses règles / Il me dit de rester dans la norme, mais l'on finit par s'y ennuyer",
                                "translation": "I've had enough of this straitjacket that hems me in with all its rules / It tells me to stay within the norm, but if you do that you end up bored",
                                "english": "I've had enough of this straitjacket that hems me in with all its rules / It tells me to stay within the norm, but if you do that you end up bored"
                            },
                            {
                                "example_id": "a5451574-82bd-4bca-987e-03c8cbebeb03",
                                "sense_id": "964f0c28-b7b7-3028-8c22-d3f978d4fc97",
                                "text": "Et pour sortir de ce carcan / Économique, capitaliste / Il faut savoir dire \"non, non, non, mec !\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
