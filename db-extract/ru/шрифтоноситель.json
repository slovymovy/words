                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9757b4a9-d16e-3b9f-b628-30928581c697",
                                        "entry_id": "1b771d4f-6f04-3270-ad1d-a470959435ac",
                                        "glosses": [
                                            "Ellipsis of master key."
                                        ],
                                        "tags": [
                                            "abbreviation",
