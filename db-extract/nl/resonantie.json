                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dffce480-1e3f-306e-93a0-8f2605cfd019",
                                        "entry_id": "56afa455-60bd-380c-84a2-2643f2632b01",
                                        "glosses": [
                                            "Schwingen eines Systems durch Anregung von außen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d365f4d-6c41-4468-bc19-36f8556fac9d",
                                                "sense_id": "dffce480-1e3f-306e-93a0-8f2605cfd019",
                                                "text": "Bei der Kernspintomographie kommt es zur Resonanz der Atomkerne durch ein starkes Magnetfeld."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b5892d01-cdf2-3fcb-8de1-079d7f7a3ea4",
                                        "entry_id": "56afa455-60bd-380c-84a2-2643f2632b01",
                                        "glosses": [
                                            "die Reaktion(en) auf eine Äußerung/Handlung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb9c9db4-f225-42dc-8c20-81140e8c85a4",
                                                "sense_id": "b5892d01-cdf2-3fcb-8de1-079d7f7a3ea4",
                                                "text": "Der Papst bedauerte die Resonanz auf seine, den Islam betreffenden, Äußerungen."
                                            },
                                            {
                                                "example_id": "fc9dd430-04d5-420a-ad2a-5085c6626a19",
                                                "sense_id": "b5892d01-cdf2-3fcb-8de1-079d7f7a3ea4",
                                                "text": "Die Resonanz auf den Vortrag kann bestenfalls als zurückhaltend bezeichnet werden."
                                            },
                                            {
                                                "example_id": "d3b8626e-7525-490c-a3bc-e06934301d16",
                                                "sense_id": "b5892d01-cdf2-3fcb-8de1-079d7f7a3ea4",
                                                "text": "„Wegen zu geringer Resonanz hatte man sich in Wiesbaden nicht entschließen können, den Preis zu vergeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71f708cf-10dd-4589-9099-4d8c8e1cef21",
                        "source_entry_id": "cb745bbf-bf7a-3354-8ff1-a3fbca58fc28",
                        "target_lang_word": "resonance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resonance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c318e9d6-af81-3cc9-bc84-2eb03656ae72",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "The quality of being resonant."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af4a84e5-dbf2-4224-a404-0c3117d7a439",
                                                "sense_id": "c318e9d6-af81-3cc9-bc84-2eb03656ae72",
                                                "text": "The leiter-wagons contained great, square boxes, with handles of thick rope; these were evidently empty by the ease with which the Slovaks handled them, and by their resonance as they were roughly moved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d47bc80c-9515-3aca-9c82-56db7add0b37",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "A resonant sound, echo, or reverberation, such as that produced by blowing over the top of a bottle."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad1a0b3b-78e7-419e-b39b-9b492540f612",
                                                "sense_id": "d47bc80c-9515-3aca-9c82-56db7add0b37",
                                                "text": "He passed on, and the lights and cries of the station dropped away, merged in a wider haze and a hollower resonance, as the train gathered itself up with a long shake and rolled out again into the darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82cda728-6706-3886-9dc2-e0fcd2d32275",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "The sound produced by a hollow body part such as the chest cavity upon auscultation, especially that produced while the patient is speaking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f741451-87f7-3ee8-a65f-f1f357ec92fe",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "Something that evokes an association, or a strong emotion; something that strikes a chord."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fbb46b2-1deb-4f8d-bf49-c1e58c8c31ca",
                                                "sense_id": "9f741451-87f7-3ee8-a65f-f1f357ec92fe",
                                                "text": "emotional resonance"
                                            },
                                            {
                                                "example_id": "f86ef3d8-7b22-456f-b266-d29e83f536a1",
                                                "sense_id": "9f741451-87f7-3ee8-a65f-f1f357ec92fe",
                                                "text": "But the film is largely redeemed by an unexpected emotional resonance befitting a Steven Spielberg production."
                                            },
                                            {
                                                "example_id": "1c21f949-3fd3-4fce-8745-e5d93be4f38f",
                                                "sense_id": "9f741451-87f7-3ee8-a65f-f1f357ec92fe",
                                                "text": "The whole recognition process has a deep colonial resonance. [title]"
                                            },
                                            {
                                                "example_id": "2a3c0252-89bb-41b6-9f89-71f7ccf2d599",
                                                "sense_id": "9f741451-87f7-3ee8-a65f-f1f357ec92fe",
                                                "text": "For audiences, all these shows mean a chance to revisit a story that still chimes loudly, and to see whether, as many suspect, it will have a more chilling resonance in the winter of 2022."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ef2b758-db24-3260-b166-923100be0b48",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "The increase in the amplitude of an oscillation of a system under the influence of a periodic force whose frequency is close to that of the system's natural frequency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d9ad822-04a6-48ba-98e4-f9879c68c23f",
                                                "sense_id": "0ef2b758-db24-3260-b166-923100be0b48",
                                                "text": "One of the most important developments beyond the original concept of magnetic resonance is so-called double resonance in which, as the name suggests, one excites one resonant transition of a system while simultaneously monitoring a different transition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11731bc2-22d5-3dce-86b0-4b1f76653d3b",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "A short-lived subatomic particle or state of atomic excitation that results from the collision of atomic particles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a78c9ad0-4081-44a0-b499-99b2778b237b",
                                                "sense_id": "11731bc2-22d5-3dce-86b0-4b1f76653d3b",
                                                "text": "When experiments with the first ‘atom-smashers’ took place in the 1950s to 1960s, many short-lived heavier siblings of the proton and neutron, known as ‘resonances’, were discovered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c3f5e7f-964f-3ac8-95a1-e220018808ba",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "An increase in the strength or duration of a musical tone produced by sympathetic vibration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "316be2d3-4b22-3583-a597-ba0758a4c85c",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "The property of a compound that can be visualized as having two structures differing only in the distribution of electrons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18cc055d-afb0-309a-85eb-f61f5b84881f",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "An influence of the gravitational forces of one orbiting object on the orbit of another, causing periodic perturbations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38f8a664-edb5-4c2d-9783-766ed9b54669",
                                                "sense_id": "18cc055d-afb0-309a-85eb-f61f5b84881f",
                                                "text": "The dedicated time Cheops spent observing the star helped astronomers iron out the mixed signals from the TESS data to determine how many planets were crossing in front of the star and the resonance of their orbits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7734d1f-48b2-3f8e-b798-fae2a708dee6",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "The condition where the inductive and capacitive reactances have equal magnitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "956bf1fd-f612-3150-b7cb-e3e8cae35d45",
                                        "entry_id": "4e136614-fa8f-3fb0-90cf-12e9975a707c",
                                        "glosses": [
                                            "A quality of human relationship with the world."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d693c5c-9e07-4543-a73a-d5b26344e823",
                                                "sense_id": "956bf1fd-f612-3150-b7cb-e3e8cae35d45",
                                                "text": "Resonance is a kind of relationship to the world, formed through affect and emotion, intrinsic interest, and perceived self-efficacy, in which subject and world are mutually affected and transformed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d7ebd35-09b3-418d-8cb4-1cc58405d9c7",
                        "source_entry_id": "cb745bbf-bf7a-3354-8ff1-a3fbca58fc28",
                        "target_lang_word": "résonance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résonance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ed12939-255d-368a-b21e-07af2d5c1f99",
                                        "entry_id": "8a9b312b-a992-3067-898a-d2aa8cc5a20d",
                                        "glosses": [
                                            "Propriété de résonner que possèdent certains objets, certains milieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf99ea48-0b89-43fb-b81d-7b8591bdfb71",
                                                "sense_id": "9ed12939-255d-368a-b21e-07af2d5c1f99",
                                                "text": "Elle croyait percevoir des sonneries de clairon, le vacarme que son père faisait, le matin, en se levant, la résonance de ses éperons dans le corridor, la porte qu’il n’avait jamais pu s’habituer à refermer doucement"
                                            },
                                            {
                                                "example_id": "2498abf4-f63e-4976-b209-563a17d1b6f7",
                                                "sense_id": "9ed12939-255d-368a-b21e-07af2d5c1f99",
                                                "text": "Tu veux essayer ? dit Harry Mitchell, en abattant son verre XXL de martini sur une table basse dotée d'une belle résonance et en s'efforçant de prendre un air de bouledogue – très convaincant, je l'admets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b42b9be-5829-3327-a788-742ee0fe207f",
                                        "entry_id": "8a9b312b-a992-3067-898a-d2aa8cc5a20d",
                                        "glosses": [
                                            "Propriété d’un corps d’entrer en vibration quand il est soumis à une excitation."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a81fc0d4-6504-48d9-b8f7-ad05fb0b8dac",
                                                "sense_id": "4b42b9be-5829-3327-a788-742ee0fe207f",
                                                "text": "Les supports élastiques peuvent être constitués par des lames vibrantes dont on connaît la période propre, ce qui permet de préestimer la vitesse de rotation à laquelle sera observée la résonance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b958a115-4a2f-3e5d-8827-19e3684a0b45",
                                        "entry_id": "8a9b312b-a992-3067-898a-d2aa8cc5a20d",
                                        "glosses": [
                                            "Méthode ayant pour objet de décrire mathématiquement la répartition des électrons dans une entité moléculaire à liaisons délocalisées par une combinaison des répartitions électroniques dans des structures hypothétiques à liaisons localisées."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcf51bfb-34e1-36c4-97ea-8e155494bb07",
                                        "entry_id": "8a9b312b-a992-3067-898a-d2aa8cc5a20d",
                                        "glosses": [
                                            "Prolongation de la durée d’un son."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3294110f-bc96-32db-b975-c5ee7704d9fe",
                                        "entry_id": "8a9b312b-a992-3067-898a-d2aa8cc5a20d",
                                        "glosses": [
                                            "Effet qui se répercute dans les esprits collectivement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "972b8d63-a372-4b67-8cdb-70d58ef35bb7",
                                                "sense_id": "3294110f-bc96-32db-b975-c5ee7704d9fe",
                                                "text": "Il évitait de donner trop de résonance à une affaire criminelle."
                                            },
                                            {
                                                "example_id": "f5dbe1c9-2473-4b0a-8cdf-c59ad9dc2293",
                                                "sense_id": "3294110f-bc96-32db-b975-c5ee7704d9fe",
                                                "text": "Je lui ai parlé de son père, cette fameuse Jambe de bois qui eut sa minute de résonance dans l’histoire intime des événements de Février."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02748302-6759-3530-9911-bd21b28f1d82",
                                        "entry_id": "8a9b312b-a992-3067-898a-d2aa8cc5a20d",
                                        "glosses": [
                                            "Effet qui se répercute dans l'être d'une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45157570-c153-4e05-b77e-ec67d02cc76c",
                                                "sense_id": "02748302-6759-3530-9911-bd21b28f1d82",
                                                "text": "Au moment où ces suicides ont eu lieu, cette vision politique ou philosophique du passage à l’acte l’a parfois emporté sur le reste. Plus tard, d’aucuns se sont interrogés sur la manière dont ces désillusions étaient entrées en résonance, pour chacun d’eux, avec des failles infiniment plus intimes."
                                            },
                                            {
                                                "example_id": "fd28e668-d104-4183-9b56-efd55dce1907",
                                                "sense_id": "02748302-6759-3530-9911-bd21b28f1d82",
                                                "text": "Être ému par la souffrance de l'autre, ressentir soi-même de la souffrance parce qu'il souffre, être joyeux lorsqu'il est en joie et triste lorsqu'il est affligé relèvent de la résonance émotionnelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
