                            {
                                "example_id": "36829296-be4f-4671-873f-53c809abf8f2",
                                "sense_id": "e16e67c4-9e01-3f16-8ecc-0ed44a6c0d89",
                                "text": "Voordat we weggaan, wil ik dat je een sweater meeneemt."
                            }
