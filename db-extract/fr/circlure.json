                                "example_id": "97e6ec8e-97b2-4671-9aca-fe0ef627cc79",
                                "sense_id": "44abeda2-9ea7-3dda-b113-4b80fec87c6e",
                                "text": "Dans le futur du porno, il n’y aura plus de hashtags, on explorera pour de vrai sans se laisser circlure par les algorithmes."
                            }
                        ]
                    }
