                        "translation_id": "175e387e-1293-423c-aaca-12acc51309e3",
                        "source_entry_id": "238296a2-b578-3218-af56-71bcc44e0230",
                        "source_sense_description": "tomb consisting of a capstone supported by two or more upright stones",
                        "target_lang_word": "hunebed",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hunebed",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b99501fe-8de1-3595-b9ed-a514a915611b",
                                        "entry_id": "910a9b49-cf9e-3223-9986-50d5e95cb231",
                                        "glosses": [
                                            "megalithische grafkamer uit de jonge steentijd die bestaat uit rechtopstaande draagstenen, overdekt door platte dekstenen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f80c670-e968-4fe7-9f63-c4cd41c31273",
                                                "sense_id": "b99501fe-8de1-3595-b9ed-a514a915611b",
                                                "text": "In Drenthe staan nog meer dan 50 hunebedden."
                                            },
                                            {
                                                "example_id": "bb80eed0-23bb-4334-a9e4-30b50413db46",
                                                "sense_id": "b99501fe-8de1-3595-b9ed-a514a915611b",
                                                "text": "Het draagt allemaal bij aan de herleving van een roemruchte periode. Daar hoort ook de aparte expositie van fotograaf Rudy Leukfeldt bij, Blues from Heaven. Heel bijzonder hoe hij Muskee heeft vereeuwigd, als heerser van Drenthe, op een hunebed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8579e6c6-670d-4265-a88f-8b28929f1bf9",
                        "source_entry_id": "238296a2-b578-3218-af56-71bcc44e0230",
                        "source_sense_description": "tomb consisting of a capstone supported by two or more upright stones",
                        "target_lang_word": "dolmen",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dolmen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdbf89e3-df5b-3a4c-b85d-68421053c06e",
                                        "entry_id": "7c873056-4043-37ca-91c6-b9b617f651bd",
                                        "glosses": [
                                            "Sépulture mégalithique préhistorique constituée d’une ou plusieurs grosses dalles horizontales posées sur des pierres verticales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bc52454-a6cd-466d-922a-74322782b0c4",
                                                "sense_id": "fdbf89e3-df5b-3a4c-b85d-68421053c06e",
                                                "text": "Elle fendit la presse, portant toujours ce cadavre que personne n’osait toucher, et elle alla le déposer sur le dolmen d’Ep-Nell, cette longue pierre plate appuyée sur deux autres, qu’on prendrait pour un ancien pont dont l’eau voisine se serait détournée et dont les assises se seraient abaissées."
                                            },
                                            {
                                                "example_id": "29030e9b-a2a5-4546-89bc-f6c494e027bc",
                                                "sense_id": "fdbf89e3-df5b-3a4c-b85d-68421053c06e",
                                                "text": "Près du hameau de Bellevillotte se trouvait un dolmen dit la Pierre-couverte, dont les supports seuls restent en place. La table, enlevée il y a environ quarante ans, sert de pont sur l’Orvin : largeur, 2ᵐ,80 ; longueur, 2ᵐ,90 ; épaisseur, 0ᵐ,50."
                                            },
                                            {
                                                "example_id": "cdaf6105-23e2-4f94-8414-eb20c9abff00",
                                                "sense_id": "fdbf89e3-df5b-3a4c-b85d-68421053c06e",
                                                "text": "La civilisation mégalithique, qui succède à celle des cavernes, a surtout pour caractère saillant les grands monuments connus sous le nom de dolmens, allées couvertes, menhirs."
                                            },
                                            {
                                                "example_id": "509e12dd-132f-47aa-b5f3-0f03bd820419",
                                                "sense_id": "fdbf89e3-df5b-3a4c-b85d-68421053c06e",
                                                "text": "Je me ferai faire un costume breton... celui des femmes de Pont-Labbé... c'est le plus joli... et nous nous ferons photographier tous les deux, la main dans la main, au pied de cet énorme dolmen que vous nous avez montré de loin."
                                            },
                                            {
                                                "example_id": "fd04fb72-b651-49bc-a5e7-53bce3fd4fb8",
                                                "sense_id": "fdbf89e3-df5b-3a4c-b85d-68421053c06e",
                                                "text": "Sur la côte et plus avant dans les terres, quelques grands dolmens ; c’est un cercle de pierres brutes dressées, sur lequel une autre pierre plate énorme, brute aussi, a été posée en guise de couvercle ; elle ne pose que par trois ou quatre endroits. On n’imagine pas une invention plus primitive : il y a des accidents semblables dans les éboulements de rochers."
                                            },
                                            {
                                                "example_id": "572017e3-6ce9-440c-922a-08a63e46edf2",
                                                "sense_id": "fdbf89e3-df5b-3a4c-b85d-68421053c06e",
                                                "text": "L’extraordinaire concentration de dolmens dans la région de Carnac témoigne bien que ce fut là un centre exceptionnel du mégalithisme."
                                            },
                                            {
                                                "example_id": "b2a09ccb-c9de-4ce6-a74d-a3e1d1a69502",
                                                "sense_id": "fdbf89e3-df5b-3a4c-b85d-68421053c06e",
                                                "text": "Dolmin ou mieux dolmen, signifie en breton table de pierre, de taol table, contracté en tol, qui, en construction ou employé dans le discours, se change en dol, par les loix de l’euphonie propres à cette langue, et du singulier men, ou du plurier mein, pierre."
                                            },
                                            {
                                                "example_id": "0c2da353-1a21-47c1-8809-6f32eaf2cefa",
                                                "sense_id": "fdbf89e3-df5b-3a4c-b85d-68421053c06e",
                                                "text": "L'aspect actuel d'un monument mégalithique se dressant sur un monticule a donné à Schumacher et Karge la fausse impression que les dolmens furent construits au-dessus des tumulus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f89c9d02-ceea-4091-b8fc-57772c9739cb",
                        "source_entry_id": "238296a2-b578-3218-af56-71bcc44e0230",
                        "source_sense_description": "tomb consisting of a capstone supported by two or more upright stones",
                        "target_lang_word": "Dolmen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dolmen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0578b13f-dc11-3fc8-8e98-d2cbaf93dfc5",
                                        "entry_id": "9d8e70eb-6e13-31f0-901d-4904abf087df",
                                        "glosses": [
                                            "ein in der Regel aus einigen großen Steinblöcken (Megalithen) errichtetes Bauwerk, das zumeist als Grabstätte diente"
                                        ],
                                        "tags": [
                                            "Archäologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5af84e6d-8b1d-47a3-b6b9-a03a564d6802",
                                                "sense_id": "0578b13f-dc11-3fc8-8e98-d2cbaf93dfc5",
                                                "text": "„Die meisten Dolmen bestehen aus großen aufgerichteten Steinen, sogenannten Orthostaten, auf denen große Decksteine ruhen, die meist größer und schwerer sind als die Orthostaten.“"
                                            },
                                            {
                                                "example_id": "80843f74-b446-425c-a3b2-c239aa1382a6",
                                                "sense_id": "0578b13f-dc11-3fc8-8e98-d2cbaf93dfc5",
                                                "text": "„In diesen Dolmen wurden aber keine Individuen bestattet, es handelte sich um Sippen- oder Gemeinschaftsgräber, also Dorffriedhöfe, oft mit Dutzenden Beisetzungen über lange Zeiträume.“"
                                            },
                                            {
                                                "example_id": "8cb8ad81-5bcf-4284-a8b8-4e0b00ff9561",
                                                "sense_id": "0578b13f-dc11-3fc8-8e98-d2cbaf93dfc5",
                                                "text": "„Ein hochgestellter deutscher Baron, der im Dienst des dänischen Königs gestanden, sollte, wie es heißt, unter einem Dolmen, gleich einem Hund unter einem Steinhaufen, begraben liegen, und zwar nur einen Steinwurf entfernt vom Küchengarten des Skálholt-Bischofssitzes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Dolmen",
