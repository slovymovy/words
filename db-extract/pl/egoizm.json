                    },
                    {
                        "translation_id": "bda9007a-5825-4c64-9412-094673dabe85",
                        "source_entry_id": "cdecd621-fe43-3df0-98ab-92bc742dc0b2",
                        "source_sense_id": "10fc2d73-b6e0-34f1-93eb-84f908db06d4",
                        "target_lang_word": "Egoismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Egoismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb1b420-3213-3ca8-95e8-d3f894a764c1",
                                        "entry_id": "d7761973-dd83-3050-93d0-60fef6695b8d",
                                        "glosses": [
                                            "Haltung, bei der nur der eigene Vorteil zählt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9c3423c-860d-4940-bc71-99e0f9e22512",
                                                "sense_id": "dbb1b420-3213-3ca8-95e8-d3f894a764c1",
                                                "text": "Egoismus ist keine angenehme Haltung."
                                            },
                                            {
                                                "example_id": "575c298b-d26c-478b-8c58-a4c6f1a52640",
                                                "sense_id": "dbb1b420-3213-3ca8-95e8-d3f894a764c1",
                                                "text": "Wenn es den Egoismus der Gene gibt, dann gibt es auch den Egoismus des Kohlenstoff-Atoms. (Eine kleine Kritik an Richard Dawkins Buch: \"Das egoistische Gen\")"
                                            },
                                            {
                                                "example_id": "165da575-0a1c-4fbf-aacf-6f02d311da29",
                                                "sense_id": "dbb1b420-3213-3ca8-95e8-d3f894a764c1",
                                                "text": "„Der von mir beklagte deutsche Egoismus hat nicht viel mit Arroganz und Eitelkeit zu tun, sondern ist eher eine Form von blindem Ehrgeiz.“"
                                            },
                                            {
                                                "example_id": "9078884b-d84d-4ccd-966a-24eeb84dbb1d",
                                                "sense_id": "dbb1b420-3213-3ca8-95e8-d3f894a764c1",
                                                "text": "„Wielands Raffinement ist, dass gerade der Altruismus des Liebhabers den Egoismus des Liebhabers weckt.“"
                                            },
                                            {
                                                "example_id": "d606fd66-f9c9-458b-8ced-e44c0e8ecebd",
                                                "sense_id": "dbb1b420-3213-3ca8-95e8-d3f894a764c1",
                                                "text": "„Adam trug Egoismus und Mutlosigkeit zur Schau, Nina gab sich blasiert, desillusioniert und ausgesprochen verärgert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3517b968-01f6-36fc-8b41-d935a056fd69",
                                        "entry_id": "d7761973-dd83-3050-93d0-60fef6695b8d",
                                        "glosses": [
                                            "eigennützige, selbstsüchtige Handlungen"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a13c68c6-d281-4581-bcc7-a7123ab6c68f",
                                                "sense_id": "3517b968-01f6-36fc-8b41-d935a056fd69",
                                                "text": "„Es sei erfreulich, dass regionale Egoismen einzelner Bundesländer die Verabschiedung des Pakets nicht verzögert hätten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
