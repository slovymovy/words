                "senses": [
                    {
                        "sense_id": "c2394cc4-8daf-35e3-948b-c0ec97f2bdea",
                        "entry_id": "d6f00ce7-f2d7-3c15-b6bc-06b99f77b226",
                        "glosses": [
                            "Any of many minute aquatic multicellular organisms, of the phylum Rotifera, that have a ring of cilia resembling a wheel."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "752151d3-3f8c-447a-9c26-ce8d5a330a7f",
                        "source_entry_id": "d6f00ce7-f2d7-3c15-b6bc-06b99f77b226",
                        "source_sense_id": "c2394cc4-8daf-35e3-948b-c0ec97f2bdea",
                        "source_sense_description": "organism of the phylum Rotifera",
                        "target_lang_word": "rotifère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rotifère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "644fe619-91dc-3d9f-956c-b60df097bca7",
                                        "entry_id": "b458efe1-018c-397b-a68d-d980589f82ae",
                                        "glosses": [
                                            "Animal d’une extrême petitesse (entre 50 µm et 3 mm), vivant principalement en eau douce mais quelques espèces occupent les eaux salées ainsi que les milieux humides, qui constitue une grande partie du zooplancton d’eau douce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "296ff42f-3597-4487-a1cf-3f885f5d2ff8",
                                                "sense_id": "644fe619-91dc-3d9f-956c-b60df097bca7",
                                                "text": "Les protozoaires, nématodes, tardigrades, rotifères et copépodes représentent à eux seuls jusqu’à quatre cents millions d’individus par mètre carré de sol forestier."
                                            },
                                            {
                                                "example_id": "073c2ede-99a9-4306-ab2b-dbd7db566880",
                                                "sense_id": "644fe619-91dc-3d9f-956c-b60df097bca7",
                                                "text": "Les rotifères bdelloïdes, comptant plusieurs centaines d’espèces et présents sur toute la surface du globe depuis quelques dizaines de millions d'années, ont une reproduction exclusivement asexuée."
                                            },
                                            {
                                                "example_id": "b6be7aaa-1b8d-409b-ab26-f827df3b917b",
                                                "sense_id": "644fe619-91dc-3d9f-956c-b60df097bca7",
                                                "text": "C’était le rotifère, dont le corps, composé d’anneaux rentrant les uns dans les autres, comme les tubes d’une lunette, porte en avant deux espèces de roues ; être singulier, qui ne peut vivre que dans l’eau et habite pourtant les mousses de nos toits, qui meurt chaque fois que le soleil dessèche sa retraite, pour ressusciter aussitôt qu’une ondée de pluie fait pénétrer jusqu’à lui le liquide nécessaire à son existence, et qui peut ainsi employer près d’une année à dépenser les dix-huit jours de vie que lui départit la nature."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
