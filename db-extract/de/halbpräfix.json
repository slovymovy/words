                "senses": [
                    {
                        "sense_id": "28cb7e78-9985-37da-a879-8c1d12a5bf46",
                        "entry_id": "3970a128-d8d6-3919-ad89-350367c07588",
                        "glosses": [
                            "grammatisches Morphem, das in seiner Form einem Lexem gleicht, aber nicht die Bedeutung dieses Lexems hat, und das wie ein Präfix für die Ableitung verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ce18f96-ab7f-4dd9-91a9-61e9c306252d",
                                "sense_id": "28cb7e78-9985-37da-a879-8c1d12a5bf46",
                                "text": "In dem Lexem \"Riesenfest\" ist \"Riesen-\" ein Halbpräfix; es sieht aus wie das Substantiv \"Riese\" (großer Mensch, Sagenfigur), hat aber nicht diese Bedeutung. Es bedeutet stattdessen hier \"sehr gelungenes, sehr großes (Fest)\"."
                            },
                            {
                                "example_id": "a8fa8593-bdb7-4ec3-9f05-4e83053fe943",
                                "sense_id": "28cb7e78-9985-37da-a879-8c1d12a5bf46",
                                "text": "„Ein entsprechendes Phänomen wird uns bei den Präfixen begegnen, was in der Bezeichnung Präfixoid (Halbpräfix) zum Ausdruck kommt.“"
                            },
                            {
                                "example_id": "d3f5eaef-d139-4981-a75b-1ae7ba380c1c",
                                "sense_id": "28cb7e78-9985-37da-a879-8c1d12a5bf46",
                                "text": "„Deshalb befürwortet FLEISCHER die Einführung einer Übergangsklasse, für die er die Bezeichnung ‚Halbsuffix‘ bzw. Halbpräfix oder ‚relatives Suffix‘ bzw. ‚relatives Präfix‘ (…) vorschlägt.“"
                            },
                            {
                                "example_id": "e5f37cdf-399d-452c-af4b-e7e59fb3b08a",
                                "sense_id": "28cb7e78-9985-37da-a879-8c1d12a5bf46",
                                "text": "„Der Terminus Halbpräfix entspricht dabei dem Terminus Präfixoid, der hier verwendet wird.“"
                            },
                            {
                                "example_id": "5860c03f-a95e-4789-9d57-f0cf1554cbd4",
                                "sense_id": "28cb7e78-9985-37da-a879-8c1d12a5bf46",
                                "text": "„In der Forschung werden diese Wortbildungsmittel Halbpräfixe und Halbsuffixe bzw. Präfixoide und Suffixoide genannt (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
