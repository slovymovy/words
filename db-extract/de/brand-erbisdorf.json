                "senses": [
                    {
                        "sense_id": "3221537a-7e26-34fe-864c-b0c8cde5f343",
                        "entry_id": "439e741f-4293-3abf-916f-50009ebc77ff",
                        "glosses": [
                            "Stadt im Landkreis Mittelsachsen, Sachsen, Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bf1c553-0d21-4171-ae99-f84283de9813",
                                "sense_id": "3221537a-7e26-34fe-864c-b0c8cde5f343",
                                "text": "Ich bin in Brand-Erbisdorf geboren."
                            },
                            {
                                "example_id": "9297fdcc-288e-4403-9520-41d8fd505467",
                                "sense_id": "3221537a-7e26-34fe-864c-b0c8cde5f343",
                                "text": "Ich habe in Brand-Erbisdorf meinen Urlaub verbracht."
                            },
                            {
                                "example_id": "b4a87d2b-4d2d-43c5-b1c6-d2f299a81ccd",
                                "sense_id": "3221537a-7e26-34fe-864c-b0c8cde5f343",
                                "text": "Nach Brand-Erbisdorf führen viele Wege."
                            },
                            {
                                "example_id": "90edde46-eb3e-44c7-8593-208baa4e35c0",
                                "sense_id": "3221537a-7e26-34fe-864c-b0c8cde5f343",
                                "text": "„Auf der Erkundungsliste steht daneben ein ähnlich großes Areal um die Gemeinden Wolkenstein und Großrückerswalde südöstlich von Chemnitz und ein 20,7 Quadratkilometer großes Feld bei Brand-Erbisdorf, Weißenborn und Freiberg, fast genau in der Mitte zwischen Chemnitz und Dresden.“"
                            },
                            {
                                "example_id": "b69ad8ba-5e57-4f45-a68c-e32dabeba0f9",
                                "sense_id": "3221537a-7e26-34fe-864c-b0c8cde5f343",
                                "text": "„Im sächsischen Brand-Erbisdorf setzte ein Blitz den Dachstuhl eines Wohnhauses in Brand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
