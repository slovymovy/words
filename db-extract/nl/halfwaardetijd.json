                            {
                                "example_id": "c22da472-501e-4843-ac9f-e474e01208e1",
                                "sense_id": "c017a47b-d8ec-37ee-a69c-6c49764cd1e8",
                                "text": "As a measure for that rate the socalled half-life has been chosen, i.e. the time that passes until a certain quantity of a radioactive body, accompanied by the emission of the characteristic radiation, has halfway passed into the next element of the series. These half-lives vary formidably, from a few seconds up to billions of years. Uranium, standing at the top of the series, has a half-life of 5000 million years; […]"
                            }
                        ]
