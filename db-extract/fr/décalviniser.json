                "senses": [
                    {
                        "sense_id": "0eedcd0e-69ae-3eb0-8ef8-ca2f2179fe10",
                        "entry_id": "ee478e83-bb80-35ae-a4e3-b1c4e8f76029",
                        "glosses": [
                            "Défaire de l'influence de Calvin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49f3ccb4-83e7-47cb-bee2-fd2978c1a076",
                                "sense_id": "0eedcd0e-69ae-3eb0-8ef8-ca2f2179fe10",
                                "text": "Il ne parlera ni de décalviniser certaines de nos Provinces, ni de déjanséniser certaines Corporations : leur état actuel de révolte contre la Puissance spirituelle lui garantissant d'avance leur inclination à se soustraire au joug de la temporelle."
                            },
                            {
                                "example_id": "bd051f18-a66e-44c0-91ef-ebc479131420",
                                "sense_id": "0eedcd0e-69ae-3eb0-8ef8-ca2f2179fe10",
                                "text": "J’ai reçu… la Revue de Genève qui aurait grand besoin de se décalviniser pour être lisible à Paris."
                            }
                        ]
                    }
                ],
