                "senses": [
                    {
                        "sense_id": "5bd3fb76-a346-3177-952b-1ad87e3daecb",
                        "entry_id": "b7045de5-b30e-3030-8c8b-ce42f4263219",
                        "glosses": [
                            "(Forschungs-)Reise ins nördliche Polargebiet (Arktis)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46abb724-1bdf-465f-b074-0453d0497843",
                                "sense_id": "5bd3fb76-a346-3177-952b-1ad87e3daecb",
                                "text": "„Sein Held, Sven Elversson, der in England bei Pflegeeltern aufgewachsen ist, hat an einer Arktisexpedition teilgenommen.“"
                            },
                            {
                                "example_id": "d6c9d16e-bb99-44fa-a060-a358dbc7bb80",
                                "sense_id": "5bd3fb76-a346-3177-952b-1ad87e3daecb",
                                "text": "„Beraten ließ sich Nansen vom norwegischen Meteorologen und Ozeanografen Henrik Mohn, der den Anstoß zu der Arktisexpedition gab.“"
                            },
                            {
                                "example_id": "cf9ff53b-1749-441a-a084-4f07e22190b2",
                                "sense_id": "5bd3fb76-a346-3177-952b-1ad87e3daecb",
                                "text": "„Erst 33 Jahre später entdeckten Mitglieder einer norwegischen Arktisexpedition Überreste der Abenteurer.“"
                            },
                            {
                                "example_id": "ad874cf5-9327-426e-ae55-24c80e129704",
                                "sense_id": "5bd3fb76-a346-3177-952b-1ad87e3daecb",
                                "text": "„Sie waren auf den Spuren der verschwundenen Arktisexpedition gewandelt und hatten zu zweit einen Rennschlitten mit zehn Hunden gelenkt.“"
                            },
                            {
                                "example_id": "e8830487-e51e-4281-ad22-48def1708fbf",
                                "sense_id": "5bd3fb76-a346-3177-952b-1ad87e3daecb",
                                "text": "„Arktisexpeditionen kosteten viele Entdecker, Polarforscher und Seefahrer das Leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
