                        "glosses": [
                            "A tropical American weevil of the genus Zyzzyva."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b23ab08-3c4c-477a-a93b-7409fa279a41",
                                "sense_id": "9094ab3f-32d0-3c3f-a2e1-d4e927dca066",
                                "text": "A zyzzyva is a weevil of the genus Zyzzyva."
                            },
                            {
                                "example_id": "95557e32-6682-4fc7-98f7-331179f603c6",
                                "sense_id": "9094ab3f-32d0-3c3f-a2e1-d4e927dca066",
                                "text": "Against the Yak, the zyzzyva zips\nHe yammers, has yaws, he yawns and he yips"
                            },
                            {
                                "example_id": "a1a135ea-505f-4664-a5b8-e476d8557deb",
                                "sense_id": "9094ab3f-32d0-3c3f-a2e1-d4e927dca066",
                                "text": "Everything on earth has an end, for your mortally thin dictionary, the tropical, American weevil, the Zyzzyva."
                            },
                            {
                                "example_id": "80673a52-da1a-4247-9c62-da4dbe517839",
                                "sense_id": "9094ab3f-32d0-3c3f-a2e1-d4e927dca066",
                                "text": "No wonder you wanted to look it up. A zyzzyva is a weevil."
                            }
                        ]
                    }
                ],
