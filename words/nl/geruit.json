            "senses": [
                {
                    "sense_id": "7d17c926-b0bb-3d7d-934a-09c5fc37e896",
                    "sense_definition": "voorzien van een patroon van vierkanten of ruiten",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "patroon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij draagt vandaag een <w>geruit</w> overhemd naar zijn werk.",
                            "target_lang_translations": {
                                "en": "He is wearing a <w>checked</w> shirt to work today."
                            }
                        },
                        {
                            "text": "De picknicktafel was gedekt met een rood <w>geruit</w> tafelkleed.",
                            "target_lang_translations": {
                                "en": "The picnic table was covered with a red <w>checkered</w> tablecloth."
                            }
                        }
                    ],
                    "synonyms": [
                        "geblokt"
                    ],
                    "common_phrases": [
                        "geruit overhemd",
                        "rood geruit",
                        "geruit patroon"
                    ],
                    "target_lang_definitions": {
                        "en": "featuring a pattern of squares or diamonds"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "checked",
                                "target_lang_sense_clarification": "pattern of squares"
                            },
                            {
                                "target_lang_word": "checkered",
                                "target_lang_sense_clarification": "pattern of squares"
                            },
                            {
                                "target_lang_word": "plaid",
                                "target_lang_sense_clarification": "pattern of crossed horizontal and vertical bands"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e3fbb76-5462-33ee-a592-d96372e9438d",
                    "sense_definition": "voorzien van glazen ruiten of vensterglas",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beglazing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hagel sloeg alle <w>geruite</w> ramen van de oude kas in.",
                            "target_lang_translations": {
                                "en": "The hail smashed all the <w>paned</w> windows of the old greenhouse."
                            }
                        },
                        {
                            "text": "De <w>geruite</w> deuren gaven de kamer een klassieke uitstraling.",
                            "target_lang_translations": {
                                "en": "The <w>paned</w> doors gave the room a classic look."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geruite ramen"
                    ],
                    "target_lang_definitions": {
                        "en": "fitted with glass panes or window glass"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "paned",
                                "target_lang_sense_clarification": "having window panes"
                            },
                            {
                                "target_lang_word": "glazed",
                                "target_lang_sense_clarification": "fitted with glass"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8b13012f-82e2-347c-9371-574799cc7362",
                    "sense_definition": "voltooid deelwoord van <w>ruiten</w>",
