                ],
                "senses": [
                    {
                        "sense_id": "77e527fe-2b9f-35c7-8604-d5330a8dd725",
                        "entry_id": "a945efda-29ff-35d9-aba2-e2556e0e821f",
                        "glosses": [
                            "die erste Veröffentlichung eines Druckwerks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a2e621e-2a78-43d2-8ca0-15ad09c80e9c",
                                "sense_id": "77e527fe-2b9f-35c7-8604-d5330a8dd725",
                                "text": "„Die Erstausgabe belief sich auf nur 1250 Exemplare.“"
                            },
                            {
                                "example_id": "cbbb96a0-9234-4f20-9291-b0c90d50309c",
                                "sense_id": "77e527fe-2b9f-35c7-8604-d5330a8dd725",
                                "text": "„Die deutsche Erstausgabe erschien 1901.“"
                            },
                            {
                                "example_id": "7c8b3c0f-0bda-4fde-b22b-ae1fc6566e8b",
                                "sense_id": "77e527fe-2b9f-35c7-8604-d5330a8dd725",
                                "text": "„Ebenfalls in Memmingen kam um 1485 die Erstausgabe heraus.“"
                            },
                            {
                                "example_id": "b7dd48bb-551b-4636-966a-4ebbe37f9ea2",
                                "sense_id": "77e527fe-2b9f-35c7-8604-d5330a8dd725",
                                "text": "„Die vorliegende vollständige und originalgetreue deutsche Erstausgabe der Memoiren Casanovas beruht auf der oben beschriebenen Edition des Verlages F. A. Brockhaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "74d08f06-d4e5-3716-a430-365afb2ff7e6",
                        "entry_id": "a945efda-29ff-35d9-aba2-e2556e0e821f",
                        "glosses": [
                            "ein Exemplar der Erstveröffentlichung eines Druckwerks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "646a5ebf-1296-4164-b0f5-8133ba26a6fb",
                                "sense_id": "74d08f06-d4e5-3716-a430-365afb2ff7e6",
                                "text": "„Die Erstausgabe des Buches von Sartre war dick und schwer.“"
                            },
                            {
                                "example_id": "fd298767-b089-4c1d-87d9-8201a5545d9a",
                                "sense_id": "74d08f06-d4e5-3716-a430-365afb2ff7e6",
                                "text": "„Um uns herum standen Erstausgaben von F. Bacon, Balzac, Erasmus, Goethe, Goldoni, Lessing, Luther, Milton, Opitz, Rousseau, Hans Sachs, Schiller und Spinoza.“"
                            },
                            {
                                "example_id": "53d131a6-66e2-475c-8981-cc054d72d949",
                                "sense_id": "74d08f06-d4e5-3716-a430-365afb2ff7e6",
                                "text": "„Red war damit beschäftigt, bei ein paar seltenen Erstausgaben die Preise raufzusetzen.“"
                            },
                            {
                                "example_id": "190cd28e-0acd-4ed1-997b-e18fd5ea246d",
                                "sense_id": "74d08f06-d4e5-3716-a430-365afb2ff7e6",
                                "text": "„Wie ein Pastor am Ostersonntag schlug Eliot feierlich und voller Freude die Erstausgabe seines Gedichts auf, von der Sylvia sich bei ihren Verkäufen nicht hatte trennen können, und begann.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
