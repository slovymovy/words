                        "entry_id": "5f2c0636-5784-3365-b47d-371bd2b081fe",
                        "glosses": [
                            "Jeune plant d’ail, avant que la tête se forme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34ad498a-c1d1-41a8-9641-df2b1b4b1f4b",
                                "sense_id": "de8aa51c-698a-3ab0-8c3a-b9f114ea27d4",
                                "text": "Certains sont très pénibles, tel celui qui consiste à dépiquer ou « déforcir » les plants d’aillette dont la disette en matières grasses a développé la culture."
                            },
                            {
                                "example_id": "70bf279c-9e4c-417f-b34a-aaee4408317a",
                                "sense_id": "de8aa51c-698a-3ab0-8c3a-b9f114ea27d4",
                                "text": "Couper la racine de l’aillette, laver en vérifiant chaque feuille sous l’eau courante."
                            },
                            {
                                "example_id": "6c2c2fe1-85bb-4dae-941e-6b608e60fa30",
                                "sense_id": "de8aa51c-698a-3ab0-8c3a-b9f114ea27d4",
                                "text": "Pour de magnifiques plats de printemps, on peut associer l’aillette avec l’autre produit phare du printemps : l’œuf."
                            }
                        ]
                    }
