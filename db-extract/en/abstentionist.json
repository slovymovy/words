                ],
                "senses": [
                    {
                        "sense_id": "4b8ff02e-4cb1-3791-bd3a-4cfbe774997a",
                        "entry_id": "ffb88aac-f807-3d70-8183-8600a9880f3a",
                        "glosses": [
                            "A practitioner or advocate of not getting involved politically."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a80f1925-aefa-402c-bbfe-01cd7fe873b5",
                                "sense_id": "4b8ff02e-4cb1-3791-bd3a-4cfbe774997a",
                                "text": "An abstentionist only has influence through public opinion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d00ce0f-8625-440b-b156-811aefd5ac8f",
                        "source_entry_id": "ffb88aac-f807-3d70-8183-8600a9880f3a",
                        "source_sense_id": "4b8ff02e-4cb1-3791-bd3a-4cfbe774997a",
                        "source_sense_description": "advocate of not getting involved politically",
                        "target_lang_word": "onthouder",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onthouder",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9786ddf2-1a86-3cb5-b150-db31dc5456d5",
                                        "entry_id": "f8786da1-506a-33f0-bae9-abb87c13aec4",
                                        "glosses": [
                                            "mensen die (bepaalde) drugs en genotmiddelen niet gebruiken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c39ed5d-76a0-4fda-9af5-4646ca0f3162",
                                                "sense_id": "9786ddf2-1a86-3cb5-b150-db31dc5456d5",
                                                "text": "„Als christen hoef je geen geheelonthouder te zijn. Maar het alcoholgebruik moet wel passen binnen een sober en matig christelijk leven.”"
                                            },
                                            {
                                                "example_id": "1686c087-9e35-45eb-aea5-1260b3c8d727",
                                                "sense_id": "9786ddf2-1a86-3cb5-b150-db31dc5456d5",
                                                "text": "Per persoon kwam het gebruik vorig jaar neer op 7 liter pure alcohol, stelt het Nederlands instituut voor alcoholbeleid STAP vast aan de hand van cijfers van de Nederlandse Brouwers, de Organisation Internationale de la Vigne et du Vin en het Centraal Bureau voor de Statistiek. Daarbij werd wel echt iedereen meegeteld, onder wie baby's en onthouders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2117a09-5ad3-3f86-9e7d-39c31b2ae95f",
                                        "entry_id": "f8786da1-506a-33f0-bae9-abb87c13aec4",
                                        "glosses": [
                                            "een stemgerechtigde die niet stemt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cde69025-018f-411c-a796-cc1f1dc21a6e",
                                                "sense_id": "f2117a09-5ad3-3f86-9e7d-39c31b2ae95f",
                                                "text": "Binnen de christendemocratische CDU/CSU-fractie van bondskanselier Angela Merkel waren er 63 tegenstemmers en 3 onthouders, de overige 228 parlementsleden van CDU/CSU stemden voor. Merkel heeft bij het parlement aangedrongen in te stemmen met het derde steunpakket voor Griekenland van 86 miljard euro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "950d1f88-d42f-3682-85e7-8193d692550b",
                                        "entry_id": "f8786da1-506a-33f0-bae9-abb87c13aec4",
                                        "glosses": [
                                            "iemand die weigert ergens aan mee te doen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb975744-2c8f-4b05-b2e9-f2bbe4d9a906",
                                                "sense_id": "950d1f88-d42f-3682-85e7-8193d692550b",
                                                "text": "Voor de overgrote meerderheid van de telefoonmakers is dat geen probleem omdat zij toch al van micro-USB gebruikmaken. De enige grote onthouder is Apple, die een eigen Lightning-stekker gebruikt en alleen dit type kabel levert. Wel biedt het bedrijf apart een Lightning-naar-micro-USB-adapter aan zodat de telefoon wel hiermee opgeladen kan worden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe990af8-5dca-3484-afa7-677f95530b20",
                                        "entry_id": "f8786da1-506a-33f0-bae9-abb87c13aec4",
                                        "glosses": [
                                            "iemand die iets niet vergeet"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12837091-a909-4e5f-9d65-eeefa67afff5",
                        "source_entry_id": "ffb88aac-f807-3d70-8183-8600a9880f3a",
                        "source_sense_id": "4b8ff02e-4cb1-3791-bd3a-4cfbe774997a",
                        "source_sense_description": "advocate of not getting involved politically",
                        "target_lang_word": "abstentionniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abstentionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f89c856-560f-3dc8-ac3d-777886bb0d0b",
                                        "entry_id": "97181e42-c66d-3ad6-82cf-af03383c3bcc",
                                        "glosses": [
                                            "Qui ne participe pas à une élection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a9c598-e002-4e23-8dcd-83be3d928e7a",
                                                "sense_id": "6f89c856-560f-3dc8-ac3d-777886bb0d0b",
                                                "text": "Une dizaine d’autres, issus de l’aile gauche, se sont abstenus, jugeant que l’absence de mesures sociales en pleine crise empêche de débattre d’un tel texte. « Une abstention chez LRM n’a rien d’anodin. C’est avant tout notre seul moyen de protester sans perdre la face », indiquait une députée abstentionniste."
                                            },
                                            {
                                                "example_id": "14d26d7c-76eb-4039-b693-f6fc68a0dd1d",
                                                "sense_id": "6f89c856-560f-3dc8-ac3d-777886bb0d0b",
                                                "text": "On les agitait déjà dans une petite brochure abstentionniste publiée au commencement de 1876, à Genève, par des proscrits lyonnais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81515d45-c014-304d-8324-6d1ca760935a",
                                        "entry_id": "97181e42-c66d-3ad6-82cf-af03383c3bcc",
                                        "glosses": [
                                            "Qui incite à l’abstention comme acte politique, aux boycotts des scrutins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ee466b2-7fd9-4f9f-8e01-7301a442a861",
                                                "sense_id": "81515d45-c014-304d-8324-6d1ca760935a",
                                                "text": "En 1953, les mariées avec enfants forment la catégorie la moins abstentionniste des femmes, et la moins portée à déclarer qu’elle « ne s’intéresse pas à la politique »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abstentionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36160433-d7a6-313c-aa24-6a0a5c2349b4",
                                        "entry_id": "0c267349-cb0b-3da1-89ab-79dac65e454d",
                                        "glosses": [
                                            "Personne qui s’est abstenue de voter à un scrutin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d03b5c33-32b6-4e21-aac6-3bc832364bef",
                                                "sense_id": "36160433-d7a6-313c-aa24-6a0a5c2349b4",
                                                "text": "Ça remobiliserait peut-être les abstentionnistes, qui sait ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46ae5d88-b538-3f01-9084-333e2884eff3",
                                        "entry_id": "0c267349-cb0b-3da1-89ab-79dac65e454d",
                                        "glosses": [
                                            "Personne qui a l’habitude de s’abstenir de voter aux élections."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
