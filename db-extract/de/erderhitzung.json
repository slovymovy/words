                ],
                "senses": [
                    {
                        "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                        "entry_id": "b2ab15f9-b5cc-3973-96ec-b5bd6011daab",
                        "glosses": [
                            "Erhöhung der Oberflächentemperaturen (Atmosphäre, Ozeane) der Erde infolge des menschengemachten Klimawandels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eeb2388-4fa0-4e50-a5f2-3c48a5642de9",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Dabei verfolgt Bellona das Ziel, die Erderhitzung bei deutlich unter 2 °C globalem Temperaturanstieg zu stoppen.“"
                            },
                            {
                                "example_id": "bd2f5117-5cac-47c0-b881-5e4fe38bc734",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Ursache für die Erderhitzung sind Treibhausgase.“"
                            },
                            {
                                "example_id": "7419251e-32d2-4c07-b592-ffcd5f87df2f",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Die Risiken durch Folgen der Erderhitzung für Deutschland sind seit langem bekannt“ […]."
                            },
                            {
                                "example_id": "82fabb52-ffac-4cfa-bf98-9cc1eaecd62e",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "[Schlagzeile:] „Neue Analyse zeigt Risiken der Erderhitzung für Deutschland“"
                            },
                            {
                                "example_id": "a97aa555-e36b-42e2-83b0-0e26b90dc33c",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Forscher gehen davon aus, dass das weltweite Bruttosozialprodukt infolge der Erderhitzung um 37 Prozent sinken wird.“"
                            },
                            {
                                "example_id": "a9fe8135-4046-4216-9815-155e84fc1e90",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Mit zunehmender Erderhitzung werden Extremwettereignisse wie Starkregen, Sturm und Hitzewellen immer häufiger vorkommen und intensiver ausfallen.“"
                            },
                            {
                                "example_id": "4bcb78c5-c981-4b6f-9838-1cb1f115e1b8",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Ein aktueller Bericht des Weltklimarats geht davon aus, dass sich die Erderhitzung noch drastischer auf Land- und Meeresökosysteme auswirkt als ursprünglich angenommen.“"
                            },
                            {
                                "example_id": "4d382128-579c-45b3-a516-0532c9df8553",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Wegen der Erderhitzung und der Zerstörung ihrer Lebensräume ist die Existenz der Hummel demnach mehrfach bedroht.“"
                            },
                            {
                                "example_id": "e025e34a-0b4d-4280-bb1f-1c2c562876db",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„So verpflichte etwa das Pariser Klimaabkommen die Bundesregierung dazu, zur Begrenzung der Erderhitzung weit unter zwei Grad beizutragen.“"
                            },
                            {
                                "example_id": "aa222e70-8ff5-4f2b-9683-28350610ec82",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Aus Sicht des Ökolandwirts trägt Volkswagen eine Mitverantwortung für die Erderhitzung.“"
                            },
                            {
                                "example_id": "9d45d485-1216-4472-823c-7b0e0e31d042",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Eigentlich wollten die Staaten einen höheren Anstieg als 1,5 Grad über dem vorindustriellen Niveau verhindern, um noch schlimmere Auswirkungen der Erderhitzung zu vermeiden. So hatten sie es im Pariser Klimaabkommen versprochen.“"
                            },
                            {
                                "example_id": "93fd84e6-98e0-425b-915f-f6ef3481dcb9",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Die Erderhitzung steigt, trotzdem ist die Klimapolitik zahlreicher Staaten höchstens Mittelmaß.“"
                            },
                            {
                                "example_id": "2550ef20-9600-4b99-a5e4-a68495b88390",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Tausende Menschen haben knapp eine Woche nach dem Start der Weltklimakonferenz COP26 im schottischen Glasgow für mehr Tempo im Kampf gegen die Erderhitzung demonstriert.“"
                            },
                            {
                                "example_id": "39a7d946-010f-469b-80e6-6506486d8898",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Denn aus Sicht der \"Letzten Generation\" ist es höchste Zeit umzusteuern, um die Erderhitzung noch in den Griff zu bekommen.“"
                            },
                            {
                                "example_id": "26321907-cae0-4a15-a581-bfb5550df6ab",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Damit auch nachfolgende Generationen noch die Möglichkeit haben, sich wirksam vor den Folgen der Erderhitzung zu schützen, muss daher sofort gehandelt werden.“"
                            },
                            {
                                "example_id": "adc2e215-3b10-4071-bc28-8d4b9d868aba",
                                "sense_id": "6339a6d8-1daa-3680-ba1b-8250ebd69024",
                                "text": "„Im Sinne des Versuchs, das Klimathema mehr in den Fokus des Interesses zu rücken, ist natürlich \"Erderhitzung\" der passendere Ausdruck. Allerdings ist Erderwärmung wohl der etablierte fachliche Begriff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
