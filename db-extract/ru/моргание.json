                "senses": [
                    {
                        "sense_id": "bc2fc187-ecd2-37a6-82ac-c1ff9d4ab51f",
                        "entry_id": "a014674f-3bcd-3d3a-be84-1df4c3baf7f4",
                        "glosses": [
                            "действие по значению гл. моргать, моргаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36d8436c-920d-422a-9c86-f3147bae5e84",
                                "sense_id": "bc2fc187-ecd2-37a6-82ac-c1ff9d4ab51f",
                                "text": "Входящие в него сульфат декстрана, термальная вода и серин увлажняют кожу и помогают ей легче пережить наши моргания."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18075f20-0cbf-4656-82d4-11880629dd69",
                        "source_entry_id": "a014674f-3bcd-3d3a-be84-1df4c3baf7f4",
                        "source_sense_id": "bc2fc187-ecd2-37a6-82ac-c1ff9d4ab51f",
                        "target_lang_word": "winking",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "winking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2524e25-eb8b-373b-b469-df65716ec58c",
                                        "entry_id": "c93d4a8f-ea84-319c-91b4-f8948cfda6fb",
                                        "glosses": [
                                            "present participle and gerund of wink"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "winking",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4603c92c-5280-3241-a5ea-d6804ceda34f",
                                        "entry_id": "68bfbfea-2f4c-3351-8ec6-9c69f49ea315",
                                        "glosses": [
                                            "The act of someone who winks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ac070c-5034-4b6c-9a4b-41da08e4442b",
                                                "sense_id": "4603c92c-5280-3241-a5ea-d6804ceda34f",
                                                "text": "I have known some happy spirits, who could sit for hours, when no other amusement presented, and talk of the winkings and squintings, they had lately been so eagle-eyed, as to detect between some innocent couple […]"
                                            },
                                            {
                                                "example_id": "e61d4faa-131a-4c7b-8158-2cfc5dca755c",
                                                "sense_id": "4603c92c-5280-3241-a5ea-d6804ceda34f",
                                                "text": "[…] Billy didn’t get to see Dresden do one of the most cheerful things a city is capable of doing when the sun goes down, which is to wink its lights on one by one. ¶ There was a broad river to reflect those lights, which would have made their nighttime winkings very pretty indeed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b832dae-e293-4f3d-a995-9987042476bb",
                        "source_entry_id": "a014674f-3bcd-3d3a-be84-1df4c3baf7f4",
                        "source_sense_id": "bc2fc187-ecd2-37a6-82ac-c1ff9d4ab51f",
                        "target_lang_word": "blink",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "022743df-f1e8-3e19-a7ff-5d432e20b3e8",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To close and reopen both eyes quickly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ce4169d-ac61-48d2-8d30-274d519b3f6b",
                                                "sense_id": "022743df-f1e8-3e19-a7ff-5d432e20b3e8",
                                                "text": "The loser in the staring game is the person who blinks first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eae97cbe-e16b-3bd9-9c89-8294d71fddb5",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To close and reopen both eyes quickly.",
                                            "To close and reopen one's eyes to remove (something) from on or around the eyes."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44bb444c-2766-40ab-a899-3cc9070f7dbe",
                                                "sense_id": "eae97cbe-e16b-3bd9-9c89-8294d71fddb5",
                                                "text": "She blinked her tears away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d3d924a-a142-3c9c-82a7-43dcef74a1e9",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To close and reopen both eyes quickly.",
                                            "To wink; to twinkle with, or as with, the eye."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc71104b-aae4-424e-bac1-2e7d4d81abe8",
                                                "sense_id": "1d3d924a-a142-3c9c-82a7-43dcef74a1e9",
                                                "text": "One eye was blinking, and one leg was lame."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eb77954-e2bf-3c62-8f58-6efdb0d69c90",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To close and reopen both eyes quickly.",
                                            "To see with the eyes half shut, or indistinctly and with frequent winking, as a person with weak eyes."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28f783af-b375-4b84-8675-fbfffc5d44ae",
                                                "sense_id": "0eb77954-e2bf-3c62-8f58-6efdb0d69c90",
                                                "text": "Show me thy chink, to blink through with mine eyne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11569012-5715-330c-b8f2-dc85d5d6d3ae",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To close and reopen both eyes quickly.",
                                            "To shine, especially with intermittent light; to twinkle; to flicker; to glimmer, as a lamp."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bcc4b87-c52f-47ac-85e5-ed5008bf00c8",
                                                "sense_id": "11569012-5715-330c-b8f2-dc85d5d6d3ae",
                                                "text": "The dew was falling fast, the stars began to blink."
                                            },
                                            {
                                                "example_id": "ba67cdcc-3cf7-481b-8fbe-cee71706da64",
                                                "sense_id": "11569012-5715-330c-b8f2-dc85d5d6d3ae",
                                                "text": "The sun blinked fair on pool and stream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ca048a7-7ada-3954-9578-c8a37e580a1d",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To close and reopen both eyes quickly.",
                                            "To glance."
                                        ],
                                        "tags": [
                                            "Geordie",
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3211107e-5d0b-4bd3-84dd-0850f51f8a85",
                                                "sense_id": "3ca048a7-7ada-3954-9578-c8a37e580a1d",
                                                "text": "Now exile is over, I'll fly to the north,\nThe home of my childhood, the place of my birth;\nO the transports of gladness that over me reign,\nTo blink upon canny Newcastle again!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf572b39-68d8-3d53-a641-c3a3b6c9656a",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To flash on and off at regular intervals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5d9aedd-0156-4f7f-be36-16e4ce552ed5",
                                                "sense_id": "bf572b39-68d8-3d53-a641-c3a3b6c9656a",
                                                "text": "The blinking text on the screen was distracting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83039952-cb74-3c5f-b7a3-d2bcb7b17f15",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To flash on and off at regular intervals.",
                                            "To flash headlights on a car at."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05faf6d4-20c9-4792-b726-e746080fa437",
                                                "sense_id": "83039952-cb74-3c5f-b7a3-d2bcb7b17f15",
                                                "text": "An urban legend claims that gang members will attack anyone who blinks them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46f4a6a5-e43a-3d01-877f-963f8ebd4f36",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To flash on and off at regular intervals.",
                                            "To send a signal with a lighting device."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e8cb2e-9902-4d38-a298-d9402cca603e",
                                                "sense_id": "46f4a6a5-e43a-3d01-877f-963f8ebd4f36",
                                                "text": "Don't come to the door until I blink twice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2a81d68-9383-3b9f-902f-e0bb78d61f4d",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To perform the smallest action that could solicit a response."
                                        ],
                                        "tags": [
                                            "excessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4610b134-e669-432c-b642-75a84f4b07d4",
                                                "sense_id": "d2a81d68-9383-3b9f-902f-e0bb78d61f4d",
                                                "text": "All the waiters in your grand cafe / Leave their tables when you blink."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6778604d-f89a-3cf0-b377-79d00dbb9c32",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To have the slightest doubt, hesitation or remorse."
                                        ],
                                        "tags": [
                                            "in negative constructions"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd408ea6-af17-49e7-8891-ba7ae6ec227b",
                                                "sense_id": "6778604d-f89a-3cf0-b377-79d00dbb9c32",
                                                "text": "The soldier shot the intruders without so much as blinking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93121b55-9515-32ed-908e-67d6aa046da6",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To shut out of sight; to evade; to shirk."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d321e4f3-a248-462a-91e6-841aed983b4d",
                                                "sense_id": "93121b55-9515-32ed-908e-67d6aa046da6",
                                                "text": "to blink the question"
                                            },
                                            {
                                                "example_id": "21435b65-cb7c-4a7f-9968-344d599c8a7b",
                                                "sense_id": "93121b55-9515-32ed-908e-67d6aa046da6",
                                                "text": "I have no wish to blink or extenuate the serious nature of the difficulty arising from this discrepancy of dates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce86a4d7-c380-33f0-91fa-cbbe0b201a27",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To turn slightly sour, or blinky, as beer, milk, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d0b1d41-eb8b-3750-b4de-5f3f5a28af98",
                                        "entry_id": "2fa0cafc-4653-3808-aee5-793c5f93d501",
                                        "glosses": [
                                            "To teleport, mostly for short distances."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blink",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f884132-1be3-3101-91b8-60e1321cc757",
                                        "entry_id": "7ff109b9-fa72-3df0-8e12-3f35be3c15aa",
                                        "glosses": [
                                            "The act of quickly closing both eyes and opening them again."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "309639aa-affe-3424-83af-00e27a62cc81",
                                        "entry_id": "7ff109b9-fa72-3df0-8e12-3f35be3c15aa",
                                        "glosses": [
                                            "The time needed to close and reopen one's eyes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a70c3004-6ccd-3cdd-86fa-ee9fd2ce2570",
                                        "entry_id": "7ff109b9-fa72-3df0-8e12-3f35be3c15aa",
                                        "glosses": [
                                            "A text formatting feature that causes text to disappear and reappear as a form of visual emphasis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c6ee4f-712c-4b84-89b6-5abc03704846",
                                                "sense_id": "a70c3004-6ccd-3cdd-86fa-ee9fd2ce2570",
                                                "text": "I can think of no good reason to use blink because blinking text and images are annoying, they mark the creator as an amateur, and they have poor browser support."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "058a6689-2551-3d93-be22-d10435d77d77",
                                        "entry_id": "7ff109b9-fa72-3df0-8e12-3f35be3c15aa",
                                        "glosses": [
                                            "A glimpse or glance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b1d6efe-bed1-45bc-9ead-9e3731327dd1",
                                                "sense_id": "058a6689-2551-3d93-be22-d10435d77d77",
                                                "text": "This is the first blink that ever I had of him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "785abda2-1eaa-3a94-a447-ba63aba739aa",
                                        "entry_id": "7ff109b9-fa72-3df0-8e12-3f35be3c15aa",
                                        "glosses": [
                                            "gleam; glimmer; sparkle"
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cf4b21b-07b5-4292-9a49-314660e0adf8",
                                                "sense_id": "785abda2-1eaa-3a94-a447-ba63aba739aa",
                                                "text": "Not a blink of light was there."
                                            },
                                            {
                                                "example_id": "5cbe3a84-0dc8-4a03-97eb-a859d7ba7d51",
                                                "sense_id": "785abda2-1eaa-3a94-a447-ba63aba739aa",
                                                "text": "this man vanished away […]as he had been a blink of the sun"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "445c506f-8e8b-3293-a7ed-64adb7207a25",
                                        "entry_id": "7ff109b9-fa72-3df0-8e12-3f35be3c15aa",
                                        "glosses": [
                                            "The dazzling whiteness about the horizon caused by the reflection of light from fields of ice at sea; iceblink"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9ab5b6d-f134-3f4f-9384-987d2c1db2c6",
                                        "entry_id": "7ff109b9-fa72-3df0-8e12-3f35be3c15aa",
                                        "glosses": [
                                            "Boughs cast where deer are to pass, in order to turn or check them."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
