                "senses": [
                    {
                        "sense_id": "a0f4e93f-5407-36aa-a407-68a989d6f3d7",
                        "entry_id": "b4bde78f-6d0d-3439-99d8-2d3a4fcef70d",
                        "glosses": [
                            "Personne des peuples nomades vivant en Mongolie, en Transbaïkalie et en Chine du Nord du IIIᵉ au IIᵉ av. J.-C.."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33a16d35-07d4-48c0-9d60-522882569c17",
                                "sense_id": "a0f4e93f-5407-36aa-a407-68a989d6f3d7",
                                "text": "Les steppes d’Asie centrale ont été habité tout au long de l’histoire par une succession de peuples nomades parmi lesquels on compte les Hunnu, les Khitans, les Turks,, les Ouïgours, les Kirghiz et les Mongols."
                            },
                            {
                                "example_id": "f89ad4a2-bcce-452d-be05-d563c9060e91",
                                "sense_id": "a0f4e93f-5407-36aa-a407-68a989d6f3d7",
                                "text": "Les Hunnu semblent avoir été des pasteurs nomades : ils sont essentiellement connus grâce aux tombes mises au jour par une expédition russo-mongole en 1943 à Noïn-Ula, à un peu plus de 120 km au nord de Ulan-Bator."
                            }
                        ]
                    }
