{
    "word_family": [
        "hiss"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9a5ac3aa-325d-34dd-98cd-71bf7a50f5f3",
                    "sense_definition": "present participle and gerund of <w>hiss</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hissing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hissing</w> steam escaped from the broken pipe in the basement.",
                            "target_lang_translations": {
                                "zh": "地下室破裂的管道中喷出了<w>嘶嘶作响的</w>蒸汽。"
                            }
                        },
                        {
                            "text": "She heard the <w>hissing</w> sound of a snake in the tall grass.",
                            "target_lang_translations": {
                                "zh": "她听到高草丛中传来蛇的<w>嘶嘶声</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hissing sound",
                        "hissing steam"
                    ],
                    "target_lang_definitions": {
                        "zh": "发出嘶嘶声的动作或状态"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘶嘶声",
                                "target_lang_sense_clarification": "指物体（如蒸汽或蛇）发出的持续摩擦声"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d084ba1c-5bd0-3342-8aa1-b723a1e09090",
                    "sense_definition": "that produces or is accompanied with a hiss",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hissing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hissing</w> radiator kept us awake all night long.",
                            "target_lang_translations": {
                                "zh": "暖气片<w>嘶嘶作响</w>，吵得我们整晚都没睡着。"
                            }
                        },
                        {
                            "text": "A <w>hissing</w> kettle signaled that the water was finally boiling.",
                            "target_lang_translations": {
                                "zh": "水壶发出<w>嘶嘶声</w>，提示水终于烧开了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hissing radiator",
                        "hissing kettle"
                    ],
                    "target_lang_definitions": {
                        "zh": "发出嘶嘶声的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘶嘶作响的",
                                "target_lang_sense_clarification": "形容正在发出嘶嘶声的物体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d59ffffc-a456-393f-8777-e11bd462c903",
                    "sense_definition": "The sound of a hiss",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hissing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sharp <w>hissings</w> from the audience showed their clear disapproval.",
                            "target_lang_translations": {
                                "zh": "观众席传来的尖锐<w>嘘声</w>表明了他们明确的不满。"
                            }
                        },
                        {
                            "text": "He ignored the angry <w>hissings</w> of the crowd as he walked away.",
                            "target_lang_translations": {
                                "zh": "他走开时无视了人群愤怒的<w>嘘声</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "angry hissings"
                    ],
                    "target_lang_definitions": {
                        "zh": "嘶嘶声（通常指表示不满或愤怒的声音）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "嘘声",
                                "target_lang_sense_clarification": "指人群发出的表示不满或嘲讽的嘶嘶声"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}