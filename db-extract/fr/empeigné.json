                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d3c3ec5-7442-413d-89a4-24937c4ae017",
                                "sense_id": "73a55085-cc98-3391-9bef-0cd338ddbcef",
                                "text": "Ce serait le duitage qu’il faudrait considérer plutôt que le poids, surtout pour les tissus qui sont empeignés clair, c’est-à-dire qui ont peu de fils en chaîne, et qui néanmoins sont fortement duités."
                            },
                            {
                                "example_id": "fe8c2cac-c2ec-4fe0-aefa-a2a29e026d98",
                                "sense_id": "73a55085-cc98-3391-9bef-0cd338ddbcef",
                                "text": "Je ne fabrique que les calicots de qualité courante, plus ou moins empeignés, plus ou moins duités."
                            }
                        ]
