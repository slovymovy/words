                "senses": [
                    {
                        "sense_id": "1e4a8376-e69d-3553-9b02-d7e8feea3fb6",
                        "entry_id": "844f4b3a-7a13-3c7a-b440-be5c1e4e5f5a",
                        "glosses": [
                            "Präsentationstour, die jemand (zum Beispiel ein Unternehmen) veranstaltet, um für etwas zu werben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b76d166f-a9f0-4010-a5b0-5d774660d644",
                                "sense_id": "1e4a8376-e69d-3553-9b02-d7e8feea3fb6",
                                "text": "„Die Roadshow der Universitätsbibliothek dient dazu, die elektronischen Angebote und Dienstleistungen der Bibliothek, unter besonderer Berücksichtigung der verschiedenen Fächer, den Studierenden wie dem Lehrpersonal der Albert-Ludwigs-Universität vor Ort näher zu bringen.“"
                            },
                            {
                                "example_id": "4bf9ec0f-bda7-4850-b0a4-4b4e2f145e22",
                                "sense_id": "1e4a8376-e69d-3553-9b02-d7e8feea3fb6",
                                "text": "„Die Berliner Flughäfen präsentieren sich im Rahmen einer Roadshow in Polen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5e71045b-06ef-3deb-b961-cc5f6f525c16",
                        "entry_id": "844f4b3a-7a13-3c7a-b440-be5c1e4e5f5a",
                        "glosses": [
                            "Seminarreihe, die zur gleichen Zeit an verschiedenen Orten zu demselben Thema veranstaltet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f82db2c5-839d-4f2c-8c8d-9c2cbf004a37",
                                "sense_id": "5e71045b-06ef-3deb-b961-cc5f6f525c16",
                                "text": "„Eine Roadshow muss umfangreicher beworben werden als ein einzelnes Seminar.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
