                    },
                    {
                        "sense_id": "dac16989-8869-3552-9ab2-9dcd8e1218a8",
                        "entry_id": "987dfc31-8783-3da9-9a39-d8f52f3852e9",
                        "glosses": [
                            "A wit."
                        ],
