                    {
                        "sense_id": "7bb70a59-6a96-3426-a937-89ba75591b57",
                        "entry_id": "ccd8cbbf-e6de-34aa-a0b0-377db2ff207b",
                        "glosses": [
                            "Theaterform, bei der die Schauspieler durch Puppen ersetzt werden, die von Puppenspielern geführt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a21130ed-06be-41c8-9aa3-00da7b8cb723",
                                "sense_id": "7bb70a59-6a96-3426-a937-89ba75591b57",
                                "text": "Das Kasperletheater ist nur eine mögliche Form des Puppentheaters."
                            },
                            {
                                "example_id": "6e5715c5-6ff4-4b9e-90f6-69952875ed29",
                                "sense_id": "7bb70a59-6a96-3426-a937-89ba75591b57",
                                "text": "„Der Senior des deutschen Puppenspiels selbst, Max Jacob, leitet ihn; er erzählt von seinen ‚Hohnsteinern’, mit denen er seit 1921 das Handpuppenspiel auf ein bis dahin unbekanntes künstlerisches und literarisches Niveau erhoben, ja, geradezu den Stil für das ernstzunehmende Puppentheater geschaffen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
