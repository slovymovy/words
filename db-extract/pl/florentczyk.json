                                        "glosses": [
                                            "Einwohner von Florenz (männlich oder unbestimmten Geschlechts)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20f5383d-8a91-4ecc-b9f7-78737f12ee2d",
                                                "sense_id": "bc363b51-2535-3018-a99e-d014ddb14014",
                                                "text": "Er ist Florentiner."
                                            },
                                            {
                                                "example_id": "46456dda-3d2e-4c3a-bd41-e240f3e27e72",
                                                "sense_id": "bc363b51-2535-3018-a99e-d014ddb14014",
                                                "text": "„Der Vater Galileis, Vincenzio (1520-91), war Florentiner und stammte aus einem Geschlecht, das schon im 14. Jahrhundert zu den Patriziern der Stadt gehörte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0c377c48-2f21-3bb6-8131-c1e02d241633",
                                        "entry_id": "b7792d56-7c6d-3f1c-be9b-3269fd930f91",
                                        "glosses": [
                                            "Plätzchen aus Mandeln, Orangeat (oder anderen kandierten Fruchtstücken) und Honig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d7a2689-2346-45be-8b93-82bba9cd613a",
                                                "sense_id": "0c377c48-2f21-3bb6-8131-c1e02d241633",
                                                "text": "Die Florentiner sind lecker!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ccc7d8e4-28bc-3621-9fee-efb5fb717e14",
                                        "entry_id": "b7792d56-7c6d-3f1c-be9b-3269fd930f91",
                                        "glosses": [
