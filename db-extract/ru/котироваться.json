                "senses": [
                    {
                        "sense_id": "ddeaedc9-8305-3811-862d-493ce8991944",
                        "entry_id": "a85d711a-66f3-3780-a805-7731d627af42",
                        "glosses": [
                            "бирж. быть в обращении на бирже (о ценных бумагах)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0726463-8a9c-4559-ad1f-25be2d236a80",
                                "sense_id": "ddeaedc9-8305-3811-862d-493ce8991944",
                                "text": "Его акции перестали котироваться на бирже, упав до стоимости веса бумаги."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0c49716-317f-3042-9a4e-6ce003e1a47b",
                        "entry_id": "a85d711a-66f3-3780-a805-7731d627af42",
                        "glosses": [
                            "перен., разг. цениться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a131f2c4-09db-467f-ba85-aac20d92ca85",
                                "sense_id": "c0c49716-317f-3042-9a4e-6ce003e1a47b",
                                "text": "Поэтому и публика на лекции особенная, мужчины котируются как редкость: прямо дамская кофейная комната у Мюра и Мерилиза."
                            }
                        ]
                    },
                    {
                        "sense_id": "53b4ce18-f0a4-32c0-9b87-e340a8f5e7be",
                        "entry_id": "a85d711a-66f3-3780-a805-7731d627af42",
                        "glosses": [
                            "бирж. страд. к котировать; иметь определённую цену (о валюте, ценных бумагах, товарах)"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe236cda-a827-4334-b435-14d931f8643d",
                        "source_entry_id": "a85d711a-66f3-3780-a805-7731d627af42",
                        "target_lang_word": "kotieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
