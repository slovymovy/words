                "senses": [
                    {
                        "sense_id": "d8e55521-52bb-3f91-a1c0-1198c19f31a7",
                        "entry_id": "dd3c5ab2-faca-3770-af66-b39831958994",
                        "glosses": [
                            "Qui manque de consistance ; dont la texture est malléable ou qui manque d’homogénéité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec49a0b8-4e79-41d7-b277-d88b09ede1ee",
                                "sense_id": "d8e55521-52bb-3f91-a1c0-1198c19f31a7",
                                "text": "[…] puis ils ralentirent progressivement jusqu’à peiner dans les derniers mètres sur un sable inconsistant."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad652e52-4d7b-3db2-86e8-7a37596f1dbe",
                        "entry_id": "dd3c5ab2-faca-3770-af66-b39831958994",
                        "glosses": [
                            "Qui manque de suite et d’ensemble dans sa conduite et dans ses discours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fe74b75-8e1f-4f5d-b212-f4317b183f36",
                                "sense_id": "ad652e52-4d7b-3db2-86e8-7a37596f1dbe",
                                "text": "Mais tandis que notre politique marocaine restait inconsistante, notre opinion publique avait enfin commencé à s’intéresser au Maroc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "011d6651-60e6-4cee-96ef-4b2cfde44af6",
                        "source_entry_id": "dd3c5ab2-faca-3770-af66-b39831958994",
                        "target_lang_word": "inconsistent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconsistent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc15a936-a1a6-3dde-b822-da414cf6eef5",
                                        "entry_id": "21d7ffee-7e12-3778-989b-aca1b4ed6748",
                                        "glosses": [
                                            "Not consistent:",
                                            "Not compatible (with another thing); incompatible, discrepant, at odds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cd955f6-055f-43c2-adfd-47a929f3be83",
                                                "sense_id": "fc15a936-a1a6-3dde-b822-da414cf6eef5",
                                                "text": "His account of the evening was inconsistent with the security-camera footage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "151d6f9f-745c-3dbb-8531-1b56d67bd525",
                                        "entry_id": "21d7ffee-7e12-3778-989b-aca1b4ed6748",
                                        "glosses": [
                                            "Not consistent:",
                                            "Lacking internal consistency; self-contradicting; not compatible with itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68288e3-2718-4293-831b-9d794488dfb2",
                                                "sense_id": "151d6f9f-745c-3dbb-8531-1b56d67bd525",
                                                "text": "He gave an inconsistent account of the evening, saying he called her before eight, but later that he had not talked to her until after nine."
                                            },
                                            {
                                                "example_id": "a82d5d89-c95d-435b-a52f-f80ae0041149",
                                                "sense_id": "151d6f9f-745c-3dbb-8531-1b56d67bd525",
                                                "text": "He was one of those men of inconsistent politics, governed at once by prejudice and sympathies, whose 'attitude' it is impossible to foretell."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb863a4e-d9af-3b19-8ef1-1fa6d325180b",
                                        "entry_id": "21d7ffee-7e12-3778-989b-aca1b4ed6748",
                                        "glosses": [
                                            "Not consistent:",
                                            "Not consistent or coherent in thought or behavior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a57db2e6-84a7-41be-9523-6577263c28f2",
                                                "sense_id": "fb863a4e-d9af-3b19-8ef1-1fa6d325180b",
                                                "text": "“Take him for better or worse,” added Mr. Lee, “and I think he is the strangest and most inconsistent man I ever saw.”\n“Inconsistent!” resumed Mr. Jones. “He is worse than inconsistent. Inconsistencies may be pardoned as constitutional defects [...]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd1c154f-537b-3dd9-91cc-ff4e98fb6f5e",
                                        "entry_id": "21d7ffee-7e12-3778-989b-aca1b4ed6748",
                                        "glosses": [
                                            "Not consistent:",
                                            "Having the property that a contradiction can be derived."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
