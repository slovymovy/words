                    {
                        "sense_id": "b6a6bfe2-60f2-3442-85c1-7b1864435142",
                        "entry_id": "c88e5695-69ef-3345-8e8e-fab60588f27e",
                        "glosses": [
                            "niet duidelijk uitgesproken en daardoor niet goed verstaanbaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b41f383-e224-4ac5-8fee-210f6ca67af2",
                                "sense_id": "b6a6bfe2-60f2-3442-85c1-7b1864435142",
                                "text": "Uit hun ongearticuleerde kreten, hun gesis, viel niets over de ruzie op te maken."
                            },
                            {
                                "example_id": "e4cf1e07-808c-4eb0-8cb4-4495a952f850",
                                "sense_id": "b6a6bfe2-60f2-3442-85c1-7b1864435142",
                                "text": "Voordat Steinz in de zomer van 2013 de diagnose ALS kreeg had hij gemerkt dat zijn hardlooptijden snel slechter werden, dat hij stemproblemen kreeg en dat hij ongearticuleerd begon te praten."
                            }
                        ]
