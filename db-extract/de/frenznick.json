                ],
                "senses": [
                    {
                        "sense_id": "5e1448ab-d618-3824-8fe3-cdce228cea42",
                        "entry_id": "8232e9b3-34c4-3300-bc18-b5566225f61f",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61a52872-5499-4439-ab31-390785b8b4ac",
                                "sense_id": "5e1448ab-d618-3824-8fe3-cdce228cea42",
                                "text": "Frau Frenznick ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "4bcc6132-47af-4b92-b997-f6338dbdb52c",
                                "sense_id": "5e1448ab-d618-3824-8fe3-cdce228cea42",
                                "text": "Herr Frenznick wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bc57dcec-c50d-4bb0-921e-873c8e4eeab5",
                                "sense_id": "5e1448ab-d618-3824-8fe3-cdce228cea42",
                                "text": "Die Frenznicks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6d247d29-0514-426d-aba4-e9f8ca866a14",
                                "sense_id": "5e1448ab-d618-3824-8fe3-cdce228cea42",
                                "text": "Der Frenznick trägt nie die Schals, die die Frenznick ihm strickt."
                            },
                            {
                                "example_id": "ea4da0df-c634-45a9-9ce6-9c321a31485b",
                                "sense_id": "5e1448ab-d618-3824-8fe3-cdce228cea42",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Frenznick kommt, geht der Herr Frenznick.“"
                            },
                            {
                                "example_id": "17a4b048-bcda-44ae-8264-4e99971b3484",
                                "sense_id": "5e1448ab-d618-3824-8fe3-cdce228cea42",
                                "text": "Frenznick kommt und geht."
                            },
                            {
                                "example_id": "b57a3bd6-f0e0-4b71-8108-a67658cc515f",
                                "sense_id": "5e1448ab-d618-3824-8fe3-cdce228cea42",
                                "text": "Frenznicks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
