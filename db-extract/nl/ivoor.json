                        ]
                    },
                    {
                        "translation_id": "d7ae092c-2b2f-4bb0-95ab-fdc3171f2a54",
                        "source_entry_id": "032ce3d8-9f08-34b6-aae3-58b6d1375d74",
                        "target_lang_word": "ivoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ivoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5bafe308-ee3e-3d24-a7f0-1864d139f313",
                                        "entry_id": "972d737a-3ac2-3d03-8ead-74b3e765e59d",
                                        "glosses": [
                                            "Substance dure, blanche, opaque qui est la matière principale des dents et des défenses d’animaux comme l’éléphant, l’hippopotame, le morse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29e0b65f-4894-4c36-adde-e9bc806e843f",
                                                "sense_id": "5bafe308-ee3e-3d24-a7f0-1864d139f313",
                                                "text": "Ne revois-tu pas le palais rose, les grands joncs aux feuilles étroites en soie pâle, et le coq blanc comme un oiseau d’ivoire, parmi les dépouilles sanglantes des camphriers."
                                            },
                                            {
                                                "example_id": "bbc23575-69dc-4cb3-80e7-2982d96676b0",
                                                "sense_id": "5bafe308-ee3e-3d24-a7f0-1864d139f313",
                                                "text": "Sa spécialité consistait à scier les dés et à les piper. Il m’expliqua l’opération, car achetant lui-même l’ivoire, il le débitait en petits cubes dont il forait certains côtés pour les bourrer de plomb."
                                            },
                                            {
                                                "example_id": "26dd0f25-064e-4849-a425-06fe04cf596d",
                                                "sense_id": "5bafe308-ee3e-3d24-a7f0-1864d139f313",
                                                "text": "Des Soudanais vendent des porte-cigarettes en ivoire, des colliers pour les femmes, des fouets de cuir."
                                            },
                                            {
                                                "example_id": "d6648a5a-4363-4056-b7c0-9143d3302605",
                                                "sense_id": "5bafe308-ee3e-3d24-a7f0-1864d139f313",
                                                "text": "À l’intérieur, son plafond est de style mudéjar, à caissons de bois de cèdre incrusté d’ivoire."
                                            },
                                            {
                                                "example_id": "15c6ee94-c864-4cb2-b15e-81d1d1e367c8",
                                                "sense_id": "5bafe308-ee3e-3d24-a7f0-1864d139f313",
                                                "text": "Cela leur a permis de réaliser que les anciens Nordiques se procuraient de l' ivoire jusque dans les eaux de l'Extrême-Arctique, «en particulier de la polynie des eaux du Nord, et peut-être de l’intérieur de l’Arctique canadien»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09b1a191-a7b5-3a47-9d85-611380ce1fe4",
                                        "entry_id": "972d737a-3ac2-3d03-8ead-74b3e765e59d",
                                        "glosses": [
                                            "Objet d’art travaillé en ivoire."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11d3e07d-04d8-48a8-a8e7-b22623a9230c",
                                                "sense_id": "09b1a191-a7b5-3a47-9d85-611380ce1fe4",
                                                "text": "Les ivoires du Louvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d3d3af9-533b-3c90-8362-74f15de43a14",
                                        "entry_id": "972d737a-3ac2-3d03-8ead-74b3e765e59d",
                                        "glosses": [
                                            "Substance majoritaire constituant la dent et plus généralement l’organe dentaire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a87b3c7-0994-324d-9262-14349346ec2b",
                                        "entry_id": "972d737a-3ac2-3d03-8ead-74b3e765e59d",
                                        "glosses": [
                                            "D’un blanc parfait."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "753f0384-5e34-424f-955a-be9ab5fedb6c",
                                                "sense_id": "8a87b3c7-0994-324d-9262-14349346ec2b",
                                                "text": "Les vêtements noirs, adoptés alors par la cour et dont la forme fut même fixée par un édit, relevaient encore l’ivoire de ses bras, découverts jusqu’au coude et ornés d’une profusion de dentelles qui sortaient de ses larges manches."
                                            },
                                            {
                                                "example_id": "a4ce4ab6-63f0-4a3a-950c-03451b0af313",
                                                "sense_id": "8a87b3c7-0994-324d-9262-14349346ec2b",
                                                "text": "Un cou d’ivoire, un cou bien fait et très blanc."
                                            },
                                            {
