                                        "entry_id": "cd0236d7-f2c1-3a0f-a5a7-384295ebe7e0",
                                        "glosses": [
                                            "from now on; from this time on"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e70a18f-195b-40f4-8cb7-58f761dc8770",
                                                "sense_id": "03ef003c-e896-33de-b49f-1a142077ecb4",
                                                "text": "In other words, what we can expect to see henceforward, provided that all Regions make the effort, is a welcome brightening-up of stations and improvement in the general standard of amenities."
                                            }
                                        ]
                                    }
                                ]
