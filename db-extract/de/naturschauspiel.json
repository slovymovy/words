                "senses": [
                    {
                        "sense_id": "a50a64aa-23cd-36ae-9d4b-9fecde3dd178",
                        "entry_id": "2dd1cae4-bac5-3891-a6c8-a010657ee2c0",
                        "glosses": [
                            "ein seltener Vorgang, eine ungewöhnliche Erscheinung in der Natur, die aufgrund ihrer Schönheit beim Betrachter große Faszination bewirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43f00031-c10b-4438-bf29-9198c5de96d7",
                                "sense_id": "a50a64aa-23cd-36ae-9d4b-9fecde3dd178",
                                "text": "„Ein besonders schönes Naturschauspiel ist das Meeresleuchten durch verschiedene Leuchtorganismen des Meeres, die damit große Schwärme organisieren können.“"
                            },
                            {
                                "example_id": "8db1149e-849a-4b44-b037-09e59d210866",
                                "sense_id": "a50a64aa-23cd-36ae-9d4b-9fecde3dd178",
                                "text": "„Der Ingenieur ließ sich aber mit der Aussicht auf Naturschauspiele nicht trösten.“"
                            },
                            {
                                "example_id": "0f1cb1a5-630d-4b66-bf41-ec60fa3c19b8",
                                "sense_id": "a50a64aa-23cd-36ae-9d4b-9fecde3dd178",
                                "text": "„Die braunen, grauen und grüngrauen Hänge rundherum boten ein spektakuläres Naturschauspiel direkt vor den Fenstern des kleinen Hauses.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
