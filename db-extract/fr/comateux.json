                                        "entry_id": "7d90226c-7603-3301-9817-ca1169cedfe9",
                                        "glosses": [
                                            "In a coma: unconscious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26ab0a27-8b95-4b35-9dec-fd2fd94a0448",
                                                "sense_id": "56caea77-d541-3092-8a82-26b1abdfd8c5",
                                                "text": "the patient was comatose for 2 weeks before finally passing away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "193629c9-71ee-305c-8468-e55c15f32f7e",
                                        "entry_id": "7d90226c-7603-3301-9817-ca1169cedfe9",
                                        "glosses": [
                                            "Drowsy or lethargic."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e69dba92-aec4-4c69-99b7-93cf9757721d",
                                                "sense_id": "193629c9-71ee-305c-8468-e55c15f32f7e",
                                                "text": "Weary of big Sunday dinners that leave you feeling comatose (and result in your having to spend Sunday evening scrubbing the kitchen)?"
                                            },
                                            {
                                                "example_id": "426144bd-1a4e-4569-8ac9-2b00d6683827",
                                                "sense_id": "193629c9-71ee-305c-8468-e55c15f32f7e",
                                                "text": "The thought of food snapped her out of her comatose demeanor."
                                            },
                                            {
                                                "example_id": "6423d65b-dd22-4014-a0e8-1c9974cea94f",
                                                "sense_id": "193629c9-71ee-305c-8468-e55c15f32f7e",
                                                "text": "I felt comatose, passing time instead of living as passions went unfulfilled."
                                            },
                                            {
                                                "example_id": "7cc8bf3b-21ef-486b-9ee2-dbaab732fdd8",
                                                "sense_id": "193629c9-71ee-305c-8468-e55c15f32f7e",
                                                "text": "But most of all I'm sick of feeling comatose, like I'm walking through a fog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fd67571-e058-3054-b3b5-c3493bfa1982",
                                        "entry_id": "7d90226c-7603-3301-9817-ca1169cedfe9",
                                        "glosses": [
                                            "Fast asleep."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "979fa793-4fcb-4e69-b8eb-fe6261265b01",
                                                "sense_id": "8fd67571-e058-3054-b3b5-c3493bfa1982",
                                                "text": "She was lying comatose on the sofa."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comatose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7a4a90b-659a-3575-8f36-812e270945ed",
                                        "entry_id": "d87124bf-e9fb-3f56-92e1-9e39cd6416fb",
                                        "glosses": [
                                            "To make comatose; to send into, or as if into, a coma."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "nonstandard",
