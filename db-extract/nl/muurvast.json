                ],
                "senses": [
                    {
                        "sense_id": "42bf8093-c2c0-306a-ae14-2fef252f06d9",
                        "entry_id": "08e9e2b4-8a52-3b4f-983e-4cd89eacd1fd",
                        "glosses": [
                            "vast in een muur bevestigd (dus niet zo vast als een muur!)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ae9fe440-95f7-3b8e-ace5-3d217b0eeffa",
                        "entry_id": "08e9e2b4-8a52-3b4f-983e-4cd89eacd1fd",
                        "glosses": [
                            "heel erg vast, iets wat niet meer te veranderen is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f38377fa-9533-4f33-9aa0-d4796c3d633c",
                                "sense_id": "ae9fe440-95f7-3b8e-ace5-3d217b0eeffa",
                                "text": "Door gebrek aan kennis van de morfologie en het gedrag van deze populaire aquariumvis ging het mis voor een 28-jarige visslikker. De meerval zette, zoals gebruikelijk bij gevaar, de stekels van zijn vinnen uit en nestelde zich muurvast in de keel. Braken, doorduwen, spoelen met bier en smeren met honing hadden geen effect."
                            },
                            {
                                "example_id": "f3c99ad2-e3c3-46c2-8d63-94030b3da317",
                                "sense_id": "ae9fe440-95f7-3b8e-ace5-3d217b0eeffa",
                                "text": "De meeste ongelovigen denken dat een gesprek niet zinvol is, omdat gelovigen muurvast zitten in het eigen gelijk. Wanneer het Bijbelcitaat, dat als fundament dient, enigszins eenduidig is, zullen de meeste christenen hun meningen nooit bijstellen."
                            },
                            {
                                "example_id": "d9ad7cb0-64fe-4032-a37f-acef24f57be6",
                                "sense_id": "ae9fe440-95f7-3b8e-ace5-3d217b0eeffa",
                                "text": "De ongeveer 18.000 supporters die terugkwamen vanuit De Kuip zorgden vannacht nog wel voor grote drukte op de wegen richting Deventer. Volgens De Stentor stond het op en rondom een bedrijventerrein langs de A1 om 01.00 uur nog muurvast."
                            }
                        ]
                    }
                ],
