                                "target_senses": [
                                    {
                                        "sense_id": "222af37f-aa15-3117-9155-5704d27121d7",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "Prayer, later especially with a rosary."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27a5bad8-e5af-4607-adf7-ea8ad82342e1",
                                                "sense_id": "222af37f-aa15-3117-9155-5704d27121d7",
                                                "text": "That he must believe in the Pope;—go to Mass;—cross himself;—tell his beads;—be a good Catholick, and that this, in all conscience, was enough to carry him to heaven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37287248-8a6c-385e-b7ff-945e958a4f6d",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "Each in a string of small balls making up the rosary or paternoster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b304bd0-64b9-41be-8961-841f75188b49",
                                                "sense_id": "37287248-8a6c-385e-b7ff-945e958a4f6d",
                                                "text": "Holonym: prayer beads"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d6ca4fd-2a9b-3c6e-a5e4-24b756da3e71",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "A small, round object.",
                                            "A small, round object with a hole to allow it to be threaded on a cord or wire, particularly for decorative purposes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70dbf9b3-5b07-3097-a165-1d766c8bc0d5",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "A small, round object.",
                                            "Various small, round solid objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f51cfb50-0a01-4902-850f-b1223c29f954",
                                                "sense_id": "70dbf9b3-5b07-3097-a165-1d766c8bc0d5",
                                                "text": "Similar studies of rats have employed four different intracranial resorbable, slow sustained release systems—surgical foam, a thermal gel depot, a microcapsule or biodegradable polymer beads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3299b01b-977d-3d92-a02f-349a4f673bb7",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "A small, round object.",
                                            "A small drop of water or other liquid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40370bae-1ed4-419c-a3b7-6be8ff95f810",
                                                "sense_id": "3299b01b-977d-3d92-a02f-349a4f673bb7",
                                                "text": "beads of sweat"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61b4dffa-e2e8-32e8-a310-615e020eb6dc",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "A small, round object.",
                                            "A bubble, in spirits."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9850a9e-395d-3b7a-a548-1e6c10280340",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "A small, round object.",
                                            "A small, round ball at the end of a barrel of a gun used for aiming."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b61e287a-7969-4a2b-a563-f505b69a88bb",
                                                "sense_id": "e9850a9e-395d-3b7a-a548-1e6c10280340",
                                                "text": "She drew a bead on the target and fired."
                                            },
                                            {
                                                "example_id": "c4290d32-f0f4-4201-a7f9-ed6625eda917",
                                                "sense_id": "e9850a9e-395d-3b7a-a548-1e6c10280340",
                                                "text": "But then I had the [massive] flintlock by me for protection. ¶[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window[…], and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge, little dreaming that the deadly tube was levelled at them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7730dcf7-9f7d-3a0e-bcbe-f1a8f6447b75",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "A small, round object.",
                                            "A small, round ball at the end of a barrel of a gun used for aiming.",
                                            "Knowledge sufficient to direct one's activities to a purpose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dc4b318-f187-4bf0-9e45-d1f6f6b97bfa",
                                                "sense_id": "7730dcf7-9f7d-3a0e-bcbe-f1a8f6447b75",
                                                "text": "We now have a bead on the main technical issues for the project"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "318811cb-cbe2-351a-91b4-c696072220f9",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "A ridge, band, or molding.",
                                            "A rigid edge of a tire that mounts it on a wheel; tire bead."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dc8bc49-0dc0-32bb-9004-7c1ea6301a08",
                                        "entry_id": "732b02c7-aecd-38cf-81c2-4dbb3aa54a06",
                                        "glosses": [
                                            "A ridge, band, or molding.",
                                            "A narrow molding with semicircular section."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
