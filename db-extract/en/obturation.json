                        "source_sense_id": "ef4bced1-d9cc-35c3-aeb1-cff367c536c6",
                        "source_sense_description": "(Medizin) Verschluss einer Ader oder eines Hohlorgans",
                        "target_lang_word": "Verschluss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verschluss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d658862-26bd-3f00-bf51-792a31a13067",
                                        "entry_id": "1720151f-8197-3513-bf06-d26e4c37d176",
                                        "glosses": [
                                            "Vorrichtung zum Zumachen, Sperrvorrichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b88ab345-84d6-453b-868f-e3f72baff5c5",
                                                "sense_id": "9d658862-26bd-3f00-bf51-792a31a13067",
                                                "text": "Der Verschluss klemmt, daher kann ich nicht öffnen."
                                            },
                                            {
                                                "example_id": "5ca63133-acd3-4cfb-af13-2d8e0ca11e02",
                                                "sense_id": "9d658862-26bd-3f00-bf51-792a31a13067",
                                                "text": "„Kanther spielte mit dem Verschluss seiner Rindsledertasche.“"
                                            },
                                            {
                                                "example_id": "220b2882-51e6-40ac-9f85-a347cd151734",
                                                "sense_id": "9d658862-26bd-3f00-bf51-792a31a13067",
                                                "text": "„Ich klinkte die Tür wieder ein, kam mir aber trotz des Verschlusses ein wenig bloßgestellt vor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "689d5371-f0e2-3cf8-a1eb-9549bfeab8b0",
                                        "entry_id": "1720151f-8197-3513-bf06-d26e4c37d176",
                                        "glosses": [
                                            "die Handlung des Verschließens, Absperrung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a71bd1e-4729-4514-8ed2-070748dbe282",
                                                "sense_id": "689d5371-f0e2-3cf8-a1eb-9549bfeab8b0",
                                                "text": "Der Verschluss aller Wertgegenstände ist sinnvoll."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "13a3a057-8646-3f22-92c3-6c57cd5a1d89",
                                        "entry_id": "1720151f-8197-3513-bf06-d26e4c37d176",
                                        "glosses": [
                                            "Baugruppe eines Hinterladers, die den Lauf nach hinten abschließt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ed38896f-5a65-351d-bd78-56dc758ab2d1",
                                        "entry_id": "1720151f-8197-3513-bf06-d26e4c37d176",
                                        "glosses": [
                                            "lichtdichtes bewegliches Element einer Kamera"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b1bd939d-cf6d-3d09-a38b-b748ee9421e5",
                                        "entry_id": "1720151f-8197-3513-bf06-d26e4c37d176",
                                        "glosses": [
                                            "Unterbrechung eines Blutgefäßes oder Organs, zum Beispiel dem Darm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78179435-019e-4b45-99bc-d630b3ed4201",
                                                "sense_id": "b1bd939d-cf6d-3d09-a38b-b748ee9421e5",
                                                "text": "Der Eingriff war wegen des plötzlichen Verschlusses der Beinarterie notwendig geworden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
