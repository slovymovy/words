                "senses": [
                    {
                        "sense_id": "a60a01e6-4814-31b0-ac0e-5a7fbed6d5ba",
                        "entry_id": "095adffc-bc57-31d5-866e-1b7771fdeba1",
                        "glosses": [
                            "meist sexuelle Beziehung von drei Personen untereinander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bdbebee-6861-4980-af0f-366699e97907",
                                "sense_id": "a60a01e6-4814-31b0-ac0e-5a7fbed6d5ba",
                                "text": "Sie führten eine Dreiecksbeziehung."
                            },
                            {
                                "example_id": "2aa8b59f-3cab-4f3f-b776-384c263c3004",
                                "sense_id": "a60a01e6-4814-31b0-ac0e-5a7fbed6d5ba",
                                "text": "„So sind denn auch Dreiecksbeziehungen in der Regel durch Verzweiflung, Eifersucht und Skandale gekennzeichnet.“"
                            },
                            {
                                "example_id": "409f56f7-3b14-4b10-9826-b90a1096c9f4",
                                "sense_id": "a60a01e6-4814-31b0-ac0e-5a7fbed6d5ba",
                                "text": "„Und natürlich, so wie es sich für Dramen gehört, wird es tragisch innerhalb dieser Dreiecksbeziehung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df9236e1-08b7-47b7-a4a0-e4869ec8dd47",
                        "source_entry_id": "095adffc-bc57-31d5-866e-1b7771fdeba1",
                        "source_sense_id": "a60a01e6-4814-31b0-ac0e-5a7fbed6d5ba",
