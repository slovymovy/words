                        "entry_id": "f91c36b6-7be0-3359-9847-be78cf30a84b",
                        "glosses": [
                            "inopportune time"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "9e9c3439-5089-4179-bf9d-2fb82c79361f",
                                "sense_id": "3d4ea51d-bb8a-3ceb-bff0-7de88b368588",
                                "text": "zur Unzeit",
                                "translation": "at an inopportune time",
                                "english": "at an inopportune time"
                            },
                            {
                                "example_id": "80b59bc5-cf1d-4f75-bb8d-4a5419dda94b",
                                "sense_id": "3d4ea51d-bb8a-3ceb-bff0-7de88b368588",
                                "text": "Hinweg mit dir, du selige Stunde! Mit dir kam mir eine Seligkeit wider Willen! Willig zu meinem tiefsten Schmerze stehe ich hier:—zur Unzeit kamst du!",
                                "translation": "Thus Spoke Zarathustra",
                                "english": "Thus Spoke Zarathustra"
                            },
                            {
                                "example_id": "06b2b53b-88b4-46e7-b009-1373284bf5b8",
                                "sense_id": "3d4ea51d-bb8a-3ceb-bff0-7de88b368588",
                                "text": "Russlands Militär gewinnt im Donbass an Boden, mit einer neuen Strategie auf dem Schlachtfeld. Wichtige Städte geraten kurz vor dem Gipfel zwischen Trump und Putin in Gefahr, für die Ukraine zur Unzeit."
                            }
                        ]
                    }
