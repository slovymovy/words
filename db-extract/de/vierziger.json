                "senses": [
                    {
                        "sense_id": "de08ff6e-fa9a-397e-83d3-427e007c8526",
                        "entry_id": "12a2ed55-1d7d-3043-b15b-6c9caec85097",
                        "glosses": [
                            "das fünfte Jahrzehnt eines Jahrhunderts oder eines Lebens"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "06e5347f-131a-4c76-a693-5c623932ca97",
                                "sense_id": "de08ff6e-fa9a-397e-83d3-427e007c8526",
                                "text": "Diese Arbeit war in den Vierzigern als unwichtig betrachtet, aber heutzutage ist es anders."
                            },
                            {
                                "example_id": "58643278-b17c-4693-810a-5415ed0d1ff0",
                                "sense_id": "de08ff6e-fa9a-397e-83d3-427e007c8526",
                                "text": "„Schon in seinen frühen Verzigern war Wilhelm Busch eine bekannte Persönlichkeit geworden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a6e93c5d-74db-3626-b961-d95400e841b0",
                        "entry_id": "12a2ed55-1d7d-3043-b15b-6c9caec85097",
                        "glosses": [
                            "Person im Alter von 40 bis 49 Jahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "301df608-49dc-47a4-bcb9-72faa0eef009",
                                "sense_id": "a6e93c5d-74db-3626-b961-d95400e841b0",
                                "text": "„Ein heiterer Vierziger, gütig und von gemüthlichen Absichten bewegt, umgab er sich gern mit fröhlichen und sinnreichen Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
