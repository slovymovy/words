                        "entry_id": "92f35789-c79c-3cf9-930d-25b57d975629",
                        "glosses": [
                            "A device used to measure the freezing point of a liquid (or the melting point of a solid)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b594cd4-c9cb-4e8b-af80-5f02cb328611",
                                "sense_id": "a369eb57-d9d8-3b82-b1bd-555d7e988a95",
                                "text": "Since this work was undertaken, Raoult has kindly informed me that he has repeated his work with cane-sugar, using an improved cryoscope, constructed so as to prevent direct radiation from the freezing-mixture to the bulb of the thermometer."
                            },
                            {
                                "example_id": "3139e3d0-ec74-49d2-949c-0999d6b35cf8",
                                "sense_id": "a369eb57-d9d8-3b82-b1bd-555d7e988a95",
                                "text": "It has been considered preferable to adhere to the apparent freezing point as determined by a standard cryoscope, rather than to confuse matters by attempting to apply corrections, which may or may not be themselves correct."
                            }
                        ]
                    }
                ],
