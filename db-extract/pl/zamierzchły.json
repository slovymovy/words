                        "examples": [
                            {
                                "example_id": "e9ef0f18-b2a7-4fe4-a9f6-e5c8c874e0af",
                                "sense_id": "82ebd373-42a3-32db-b4a2-9d5551137862",
                                "text": "W zamierzchłych czasach Polacy słodzili miodem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf6f0ccc-e7f9-4019-847c-99f0fec2e864",
                        "source_entry_id": "967ccaa6-e56a-3b32-957f-8f36cfb472f6",
                        "source_sense_id": "82ebd373-42a3-32db-b4a2-9d5551137862",
                        "target_lang_word": "vorzeitlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorzeitlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4ae753f-8e73-32d0-8667-cd603ac164f1",
                                        "entry_id": "98f81938-bfcf-3338-a9b2-856d046d3943",
                                        "glosses": [
                                            "aus der Vorzeit stammend; die Vorzeit betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d602e80-358b-4ef3-a296-dd048d01025c",
                                                "sense_id": "e4ae753f-8e73-32d0-8667-cd603ac164f1",
                                                "text": "Man unterscheidet demnach Körper- und Spurenfossilien, wobei unter „vorzeitlich“ sämtliche vorholozänen tierischen oder pflanzlichen Reste verstanden sind, d. h. also Reste aus einer Zeit, die der geologischen Gegenwart, dem Holozän (s. Zeittafel), vorausging."
                                            },
                                            {
                                                "example_id": "02b48fc8-65a1-4663-b147-17a6288c6ab4",
                                                "sense_id": "e4ae753f-8e73-32d0-8667-cd603ac164f1",
                                                "text": "Sie war in einer riesigen vorzeitlichen Nekropole beigesetzt worden, die damals schon uralt gewesen sein muss."
                                            },
                                            {
                                                "example_id": "b9728254-4295-4d40-95cc-02de28d7c0eb",
                                                "sense_id": "e4ae753f-8e73-32d0-8667-cd603ac164f1",
                                                "text": "Zwar sind die Schichtflächen vieler Gesteine überzogen von vorzeitlichen Tierspuren, die es mit Detektiv-Methoden zu entziffern gilt."
                                            },
                                            {
                                                "example_id": "900c5f61-0d23-477f-8e06-9543f16496cd",
                                                "sense_id": "e4ae753f-8e73-32d0-8667-cd603ac164f1",
                                                "text": "Diprotodon war das größte Beuteltier, das jemals existierte – und eines der rätselhaftesten. Jetzt hat ein australischer Forscher zumindest einige Geheimnisse des vorzeitlichen Riesen gelüftet."
                                            },
                                            {
                                                "example_id": "27b34411-f5a6-4c20-93db-dcf3f965e547",
                                                "sense_id": "e4ae753f-8e73-32d0-8667-cd603ac164f1",
                                                "text": "Die Erzeugung elektrischer Energie erfolgt dann lediglich durch Umwandlung der so vorzeitlich geschaffenen fossilen Vorräte wie Öl, Gas und Kohle oder der im Augenblick verfügbaren Energie von Sonne, Wind oder Biomasse."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
