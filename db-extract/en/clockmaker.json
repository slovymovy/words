                "senses": [
                    {
                        "sense_id": "15cf7f3d-24c7-3cb4-b488-a77f7cf373f7",
                        "entry_id": "c77da694-07e8-38c2-8615-e38cd028e2ef",
                        "glosses": [
                            "ein Handwerker, der Uhren herstellt und repariert"
                        ],
                        "tags": [],
