                    {
                        "sense_id": "cd9a4154-6061-37ea-893a-8d1b7401ca4e",
                        "entry_id": "49548f96-444e-34fb-a67f-d9abb2790187",
                        "glosses": [
                            "perfide, heimtückische Art"
                        ],
                        "tags": [
                            "derogatory",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "5299384b-1d22-4aab-ba2c-b842269fc788",
                                "sense_id": "cd9a4154-6061-37ea-893a-8d1b7401ca4e",
                                "text": "Gipfel der Perfidie in afrikanischer Sicht: Jetzt sollen Schwarzafrikaner vor der Einreise nach Großbritannien einen Aids-Test passieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0936c9b9-f95b-377b-9195-9f56cc4b0eb0",
                        "entry_id": "49548f96-444e-34fb-a67f-d9abb2790187",
                        "glosses": [
                            "gemeine, heimtückische Tat/Handlung"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "020647a2-b0da-485e-8784-0fdd3c1b6fa2",
                                "sense_id": "0936c9b9-f95b-377b-9195-9f56cc4b0eb0",
                                "text": "„Es hätte dieser protektorischen Perfidie nicht bedurft.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcd5b1f5-905e-47e7-b0d4-e6d01e3ee351",
                        "source_entry_id": "49548f96-444e-34fb-a67f-d9abb2790187",
                        "source_sense_id": "cd9a4154-6061-37ea-893a-8d1b7401ca4e",
                        "source_sense_description": "kein Plural: perfide, heimtückische Art",
                        "target_lang_word": "perfidy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfidy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cba4fe62-64c3-3e13-aaad-029a0a96777b",
                                        "entry_id": "1ceb3cee-f979-302d-8628-bf12fa782fba",
                                        "glosses": [
                                            "A state or act of violating faith or allegiance; violation of a promise or vow, or of trust."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44eab26a-c95b-364e-9d28-5e66dcda1c2e",
                                        "entry_id": "1ceb3cee-f979-302d-8628-bf12fa782fba",
                                        "glosses": [
                                            "An illegitimate act of deception, such as using symbols like the Red Cross or white flag in a false claim of surrender to gain proximity to an enemy for purposes of attack."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "176f0937-e028-4d8d-bcb2-4646d8ceeb39",
                                                "sense_id": "44eab26a-c95b-364e-9d28-5e66dcda1c2e",
                                                "text": "Stratagems must be carefully distinguished strategy from perfidy, since the former are allowed, whereas the latter is prohibited."
                                            },
                                            {
                                                "example_id": "441c6f8f-fc69-4f5d-b554-ed7f21347bba",
                                                "sense_id": "44eab26a-c95b-364e-9d28-5e66dcda1c2e",
                                                "text": "Abuse of a protective emblem amounts to perfidy and constitutes a war crime under the customary law of armed conflict."
                                            },
                                            {
                                                "example_id": "86701351-b816-48b2-bfe6-66eece299bc9",
                                                "sense_id": "44eab26a-c95b-364e-9d28-5e66dcda1c2e",
                                                "text": "Ruses of war are legitimate so long as they do not involve treachery or perfidy on the part of the belligerent resorting to them."
                                            },
                                            {
                                                "example_id": "70096b78-586f-4f94-b436-1be8dbeea612",
                                                "sense_id": "44eab26a-c95b-364e-9d28-5e66dcda1c2e",
                                                "text": "Cyberattacks almost inevitably involve an element of deception, such as tricking a user to click on a malicious link. So, to what extent could cyberattacks count as perfidy and therefore be illegal given international humanitarian law?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f767e14-9967-3278-a84c-c83cf19d0243",
                                        "entry_id": "1ceb3cee-f979-302d-8628-bf12fa782fba",
                                        "glosses": [
                                            "A state or act of deceit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e098347-da2f-4b84-877a-8c744d33670a",
                                                "sense_id": "3f767e14-9967-3278-a84c-c83cf19d0243",
                                                "text": "Letterman roared about the perfidy of lying politicos."
                                            },
                                            {
                                                "example_id": "82e3e1a3-7e0c-4ecc-9bf5-00ec91b975ac",
                                                "sense_id": "3f767e14-9967-3278-a84c-c83cf19d0243",
                                                "text": "Germans could not get over the perfidy of it. It was unbelievable that the English, having degenerated to the stage where suffragettes heckled the Prime Minister and defied the police, were going to fight."
                                            },
                                            {
                                                "example_id": "b6673f36-5484-4eae-8597-c7aa1493b7b6",
                                                "sense_id": "3f767e14-9967-3278-a84c-c83cf19d0243",
                                                "text": "Honda Motor Co. is the latest victim of e-mail perfidy, which started when a phony chain letter promised that the automaker would give away free cars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "891de811-05b9-45b6-81f3-979003d7ff14",
                        "source_entry_id": "49548f96-444e-34fb-a67f-d9abb2790187",
                        "source_sense_id": "cd9a4154-6061-37ea-893a-8d1b7401ca4e",
                        "source_sense_description": "kein Plural: perfide, heimtückische Art",
                        "target_lang_word": "perfidia",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perfidia",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "ad6b90a7-ccfd-3ec4-874c-91c4aca34d78",
                                        "entry_id": "5a499292-0413-3afe-a2f7-cefafbaeb4e7",
                                        "glosses": [
                                            "allusione malvagia e maliziosa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cebb2a6-24ec-4ab9-af74-d6d800a20b15",
                                                "sense_id": "ad6b90a7-ccfd-3ec4-874c-91c4aca34d78",
                                                "text": "sono frasi pungenti perché dette con perfidia al fine di offendere"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "01a80727-a808-3b70-9969-86bd511cb467",
                                        "entry_id": "5a499292-0413-3afe-a2f7-cefafbaeb4e7",
                                        "glosses": [
                                            "inclinazione cattiva espressa con pensieri, parole e/o azioni disdicevoli"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6761d647-6ce3-43a2-9120-ccf47c140ff2",
                                                "sense_id": "01a80727-a808-3b70-9969-86bd511cb467",
                                                "text": "ha giudicato male perché con perfidia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23bb2449-8f47-36ae-8cbf-56e1d91ebc5f",
                                        "entry_id": "5a499292-0413-3afe-a2f7-cefafbaeb4e7",
                                        "glosses": [
                                            "sfogo a gravi offese ingiustamente espresse"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc66d521-4840-4e2f-a7d0-61fb7a76f422",
                                                "sense_id": "23bb2449-8f47-36ae-8cbf-56e1d91ebc5f",
                                                "text": "dopo il suo pensar male agì con perfidia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1e52c4f-bdcd-30df-ba2c-cc0125904c46",
                                        "entry_id": "5a499292-0413-3afe-a2f7-cefafbaeb4e7",
                                        "glosses": [
                                            "di chi è immondo, diabolico e macchinoso in modo insanabile"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b82bbc75-3f6e-4cca-875f-f5ab88916d79",
                                                "sense_id": "b1e52c4f-bdcd-30df-ba2c-cc0125904c46",
                                                "text": "l'assassino che ha compiuto simili atti con tale perfidia, a dir poco è un mostro"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9331facf-362a-38a6-a683-5ec0e5e31af4",
                                        "entry_id": "5a499292-0413-3afe-a2f7-cefafbaeb4e7",
                                        "glosses": [
                                            "con tono amichevole e scherzoso, soprattutto in questioni di cuore, indica un atteggiamento distaccato, snob, quasi di indifferenza, spesso anche quando è comunque presente un interesse verso la persona che si è dichiarata"
                                        ],
                                        "tags": [
                                            "familiare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c417317-605a-4ec5-9e28-bce92680e03a",
                                                "sense_id": "9331facf-362a-38a6-a683-5ec0e5e31af4",
                                                "text": "\"Ma è perfidia! Non la degni neanche di uno sguardo!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
