                "senses": [
                    {
                        "sense_id": "24ad36f8-8ef5-3a9b-8c3d-999fff3efabc",
                        "entry_id": "590f9276-4887-363c-b8e6-305d469c0eff",
                        "glosses": [
                            "fragend-entwickelnder Unterricht, bei dem der Lehrer vor der Klasse steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab4e90fa-af58-49d5-9a06-d15ec4ad4996",
                                "sense_id": "24ad36f8-8ef5-3a9b-8c3d-999fff3efabc",
                                "text": "Der Frontalunterricht weicht immer mehr dem offenen Unterricht."
                            },
                            {
                                "example_id": "cdeae56d-b0ed-4a2e-b195-6946578d52d3",
                                "sense_id": "24ad36f8-8ef5-3a9b-8c3d-999fff3efabc",
                                "text": "„Unterrichtet worden sei zudem vornehmlich im Stile des Frontalunterrichts.“"
                            },
                            {
                                "example_id": "e6b691aa-e6fb-41d0-b31c-f24130e18d6c",
                                "sense_id": "24ad36f8-8ef5-3a9b-8c3d-999fff3efabc",
                                "text": "„Friedel tat sich dabei weniger als Lehrer hervor, der vor dem Kamin Frontalunterricht gab, sondern eher als Moderator, der uns bei der Lektüre des Lehrbuchs unterstützte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
