                "senses": [
                    {
                        "sense_id": "fe1a4719-b8f9-31f8-8e5c-18aa33c77b3d",
                        "entry_id": "4101714f-4a46-335e-88a4-088a0ee739ba",
                        "glosses": [
                            "Celui qui aime riboter, faire la noce."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "972b35aa-57ae-442e-a25b-3902f834872c",
                                "sense_id": "fe1a4719-b8f9-31f8-8e5c-18aa33c77b3d",
                                "text": "Sʼil tʼabandonne, tu resteras avec moi; jʼai de bons bras et je ne suis plus un ivrogne, un riboteur comme autrefois !"
                            },
                            {
                                "example_id": "dadb5922-1df6-4e67-8252-a1afaba3cf3a",
                                "sense_id": "fe1a4719-b8f9-31f8-8e5c-18aa33c77b3d",
                                "text": "Faites attention à lui. C’est un franc riboteur ; mais nous ne sommes pas là pour faire les délicats."
                            },
                            {
                                "example_id": "0ef45077-3fa7-4a59-87ab-aafa89a6a4bf",
                                "sense_id": "fe1a4719-b8f9-31f8-8e5c-18aa33c77b3d",
                                "text": "Quelle tragédie avait bien pu bouleverser cette existence de riboteuse ?"
                            },
                            {
                                "example_id": "a8c6bfd2-81bc-4488-a038-8671d559e66d",
                                "sense_id": "fe1a4719-b8f9-31f8-8e5c-18aa33c77b3d",
                                "text": "On est sûr d’y voir bayer aux corneilles quelque valet riboteur, une cantine à la main avec le dîner de son maître qui ,e mangera certainement pas une soupe chaude[…]."
                            }
                        ]
                    }
                ],
