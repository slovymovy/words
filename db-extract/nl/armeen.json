                    {
                        "translation_id": "cf8c8616-998b-4e7b-95a6-b883ec8c8ccf",
                        "source_entry_id": "512dfcde-822c-31ba-9f91-a64e6c1201e3",
                        "source_sense_id": "fc06ae57-6ce1-3477-8bdc-391a60482724",
                        "source_sense_description": "een inwoner van Armenië, of iemand afkomstig uit Armenië",
