                "senses": [
                    {
                        "sense_id": "54ec86ca-cca9-3552-9c57-82baa8cfd9ca",
                        "entry_id": "43f598f6-3771-3c99-824b-7c17952b5ace",
                        "glosses": [
                            "lautstarker Protest durch Trommeln und Klopfen mit verschiedensten Gegenständen"
                        ],
                        "tags": [
                            "Gaunersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "51de8145-3e49-414b-9b42-b8efde20d959",
                                "sense_id": "54ec86ca-cca9-3552-9c57-82baa8cfd9ca",
                                "text": "Die Gefangenen machten Bambule."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "efbaa3e3-f320-3f8f-b7f5-2be5eff24752",
                        "entry_id": "43f598f6-3771-3c99-824b-7c17952b5ace",
                        "glosses": [
                            "buntes, ausgelassenes Treiben"
                        ],
                        "tags": [
                            "Jugendsprache"
                        ],
                        "examples": [
                            {
                                "example_id": "1f56523e-dd49-48aa-8373-df910582ae59",
                                "sense_id": "efbaa3e3-f320-3f8f-b7f5-2be5eff24752",
                                "text": "In der Disco war wieder Bambule angesagt."
                            },
                            {
                                "example_id": "85ba9ae6-e94c-4ad5-a3e7-baa8d38855c5",
                                "sense_id": "efbaa3e3-f320-3f8f-b7f5-2be5eff24752",
                                "text": "„Wegen der zu dieser Zeit heißesten Sonne würde man eher erwarten, dass die Leute ruhen und erst in der Nacht ihre Bambule veranstalten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2909714c-c693-42c6-910d-342f4003d98e",
                        "source_entry_id": "43f598f6-3771-3c99-824b-7c17952b5ace",
                        "source_sense_id": "54ec86ca-cca9-3552-9c57-82baa8cfd9ca",
                        "source_sense_description": "lautstarker Protest durch Trommeln und Klopfen",
                        "target_lang_word": "rampage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rampage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a90f6d2-8d96-37a3-b29f-bd746f25c7ed",
                                        "entry_id": "3fad3d86-c468-36ff-8dfd-5b5ab3496381",
                                        "glosses": [
                                            "A course of violent, frenzied action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca6efe34-2e3d-4c19-9174-be06d3b0eb07",
                                                "sense_id": "0a90f6d2-8d96-37a3-b29f-bd746f25c7ed",
                                                "text": "Blast after blast, fiery outbreak after fiery outbreak, like a flaming barrage from within,[…]most of Edison's grounds soon became an inferno. As though on an incendiary rampage, the fires systematically devoured the contents of Edison's headquarters and facilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f68ea73-490e-3209-bf9e-f2cacb674f85",
                                        "entry_id": "3fad3d86-c468-36ff-8dfd-5b5ab3496381",
                                        "glosses": [
                                            "Wild partying, typically a drinking binge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fba8b70f-8ac7-42fa-8feb-963ff03fed52",
                                                "sense_id": "8f68ea73-490e-3209-bf9e-f2cacb674f85",
                                                "text": "Great card he was. Waltzing in Stamer street with Ignatius Gallaher on a Sunday morning, the landlady's two hats pinned on his head. Out on the rampage all night."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rampage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3160dec5-5fde-34c7-a101-703c86510eb5",
                                        "entry_id": "4ff64ac2-205d-3ad8-a136-1e495ae83ffd",
                                        "glosses": [
                                            "To move about wildly or violently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "226d474e-a85f-4306-a6f4-5bf1d7e6914a",
                                                "sense_id": "3160dec5-5fde-34c7-a101-703c86510eb5",
                                                "text": "In the hip science of ultrasmall nanotechnology, fantastical future possibilities like rampaging nanorobots capture the most attention, but the first fruits of the field have been more mundane: tiny bits of mostly ordinary stuff that just sit there."
                                            },
                                            {
                                                "example_id": "3ae96e4a-98c5-4373-a891-4a48072a277e",
                                                "sense_id": "3160dec5-5fde-34c7-a101-703c86510eb5",
                                                "text": "It is a sunny morning in Amman and the three uniformed judges in Jordan’s state security court are briskly working their way through a pile of slim grey folders on the bench before them. Each details the charges against 25 or so defendants accused of supporting the fighters of the Islamic State (Isis), now rampaging across Syria and Iraq under their sinister black banners and sending nervous jitters across the Arab world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f1f9a1f-5b91-4d26-b69c-1e6293b6c62b",
                        "source_entry_id": "43f598f6-3771-3c99-824b-7c17952b5ace",
                        "source_sense_id": "efbaa3e3-f320-3f8f-b7f5-2be5eff24752",
                        "source_sense_description": "Jugendsprache: buntes, ausgelassenes Treiben",
                        "target_lang_word": "shindy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shindy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d8301ac-336c-3608-bc35-715137b96ed0",
                                        "entry_id": "f8752f89-c8a9-3c53-ab49-396773c26820",
                                        "glosses": [
                                            "A shindig."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a71bb46-c6f5-48b1-85b4-878accded919",
                                                "sense_id": "3d8301ac-336c-3608-bc35-715137b96ed0",
                                                "text": "She and Eileen are giving a shindy for Gladys—that's Gerald's new acquisition, you know. So if you don't mind butting into a baby-show we'll run down."
                                            },
                                            {
                                                "example_id": "bd4a6d09-e979-4aaa-bb34-2f2877163bf2",
                                                "sense_id": "3d8301ac-336c-3608-bc35-715137b96ed0",
                                                "text": "\"Well, from what I hear,\" Dr. Buckie went on, complacently, \"there'll be more shindies. So look out!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f17392b8-e237-3a9f-bba2-5d66c49599e2",
                                        "entry_id": "f8752f89-c8a9-3c53-ab49-396773c26820",
                                        "glosses": [
                                            "An uproar or disturbance; a spree; a row; a riot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7954311-61de-442e-9989-140626dd76b3",
                                                "sense_id": "f17392b8-e237-3a9f-bba2-5d66c49599e2",
                                                "text": "\"[…] I've married her. And I know there will be an awful shindy at home.\""
                                            },
                                            {
                                                "example_id": "8fdba498-3c5b-4ef7-95f1-40eb2c53825c",
                                                "sense_id": "f17392b8-e237-3a9f-bba2-5d66c49599e2",
                                                "text": "I always do sit with my hands in my pockets except when I am in the company of my sisters, my cousins, or my aunts; and they kick up such a shindy—I should say expostulate so eloquently upon the subject—that I have to give in and take them out—my hands I mean."
                                            },
                                            {
                                                "example_id": "c055a2c6-4bf1-4fe4-99bd-44895f8721d3",
                                                "sense_id": "f17392b8-e237-3a9f-bba2-5d66c49599e2",
                                                "text": "[…] it was like a Catholic priest striking peace in an Irish shindy."
                                            },
                                            {
                                                "example_id": "04e2aca1-5cfd-48b3-a129-e2a335eaed9f",
                                                "sense_id": "f17392b8-e237-3a9f-bba2-5d66c49599e2",
                                                "text": "More severe injuries were sustained by a young man who received two stab wounds in the chest from a woman's umbrella.\nOne of the lighter moments was related by an unidentified witness whose glass eye fell or was torn out in the hostilities. As he later searched the gutter for his hand made optic, a woman approached and handed it back to him none the worse, saying it had found its way down her cleavage in the shindy."
                                            },
                                            {
                                                "example_id": "30abb796-03f5-44ad-bc86-c34fed9b9320",
                                                "sense_id": "f17392b8-e237-3a9f-bba2-5d66c49599e2",
                                                "text": "Nurse Solveig inserted the thermometer and disappeared—disappeared (I timed it) for more than twenty minutes. Nor did she answer my bell, or come back, until I set up a shindy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea76aa20-956f-36ed-8f9c-2a0cea87e4d8",
                                        "entry_id": "f8752f89-c8a9-3c53-ab49-396773c26820",
                                        "glosses": [
                                            "hockey; shinney"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7530f9c-de66-4ff9-91d4-f54d64adcbfb",
                                                "sense_id": "ea76aa20-956f-36ed-8f9c-2a0cea87e4d8",
                                                "text": "[…] what is even more disgusting still, I have seen children playing at \"shindy\" in a Churchyard, a skull used as a substitute for a ball, and large fragments of leg or arm-bones in the place of sticks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f37a561-9564-337d-9363-5f996acb4a22",
                                        "entry_id": "f8752f89-c8a9-3c53-ab49-396773c26820",
                                        "glosses": [
                                            "A fancy or liking."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "dated",
                                            "dialectal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb0ad0db-9530-4974-858f-c9fe9044c048",
                                                "sense_id": "1f37a561-9564-337d-9363-5f996acb4a22",
                                                "text": "\"Father took a wonderful shindy to her, for even old men can't help liking beauty. […]\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
