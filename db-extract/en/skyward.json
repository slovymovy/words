                            {
                                "example_id": "0fbe36dc-9974-4c62-bf29-ca29041ca97f",
                                "sense_id": "6b82aa3b-2fa1-329b-9724-e8088cacf3eb",
                                "text": "The rocket shot skyward and exploded in a burst of glittering stars."
                            },
                            {
                                "example_id": "1091eaf9-6469-4ed8-9854-13aed35054fd",
                                "sense_id": "6b82aa3b-2fa1-329b-9724-e8088cacf3eb",
                                "text": "No Jute is left to wield a sword to save this hoard. No one is left to swing the battle-ax skyward."
                            },
                            {
                                "example_id": "73192d99-a223-41c7-853c-aeffbffda75e",
                                "sense_id": "6b82aa3b-2fa1-329b-9724-e8088cacf3eb",
                                "text": "If there is a heaven up there, Carl Sagan will be in his element on November 30, when Venus, Jupiter, and the moon align in a facelike formation. Gaze skyward to appreciate this rare triple feature of the brightest planets with a wry grin from the moon."
                            }
                        ]
