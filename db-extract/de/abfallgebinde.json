                        "examples": [
                            {
                                "example_id": "10c7b424-0617-4943-8876-a5b26478fb2b",
                                "sense_id": "b90e410c-d7dc-3436-b5fc-959eefa05e37",
                                "text": "„Die innerste (technische) Barriere ist das Abfallgebinde, bestehend aus Abfallprodukt und Behälter.“"
                            },
                            {
                                "example_id": "9d999eec-9e2a-4339-8313-ea1bffef544d",
                                "sense_id": "b90e410c-d7dc-3436-b5fc-959eefa05e37",
                                "text": "„Ziel der Fahrt: das Zwischenlager Gorleben, wo, nebst 1500 Tonnen abgebrannter Brennelemente, 35 000 solcher »Abfallgebinde« gestapelt werden sollen, bis sie in einem Endlager verschwinden können.“"
                            }
                        ],
