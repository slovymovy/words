        "fr-extract.jsonl": [
            {
                "entry_id": "1eb06a68-8aad-30c1-84ca-6e8105b9145d",
                "word": "nettoiement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6b65d8bf-a33d-4c2b-8505-04eb8459062b",
                        "entry_id": "1eb06a68-8aad-30c1-84ca-6e8105b9145d",
                        "tags": [
                            "plural"
                        ],
                        "form": "nettoiements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46f6537d-2611-347b-8be6-a9feabede2c7",
                        "entry_id": "1eb06a68-8aad-30c1-84ca-6e8105b9145d",
                        "glosses": [
                            "Ensemble des opérations ayant pour but de nettoyer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae69504f-205f-48ef-9b42-f9d7e947035d",
                                "sense_id": "46f6537d-2611-347b-8be6-a9feabede2c7",
                                "text": "Il n'y avait pas pour cet objet, non plus que le nettoiement, d'adjudication au rabais."
                            }
                        ]
                    },
                    {
                        "sense_id": "1dff9f0f-496f-3595-ae54-14957d86efb7",
                        "entry_id": "1eb06a68-8aad-30c1-84ca-6e8105b9145d",
                        "glosses": [
                            "Recrutement de tiges d’avenir, par élimination de tiges concurrentes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55481151-3d17-4e63-ba11-f581ca0f8507",
                                "sense_id": "1dff9f0f-496f-3595-ae54-14957d86efb7",
                                "text": "Entre 3 et 6 m de hauteur, seul le nettoiement est envisagé. Il est trop tôt pour intervenir sur la densité des chênes. Le nettoiement est régulièrement justifié dans les ensembles stationnels des chênaies continentales bien drainés et sans contrainte hydrique, c’est-à-dire là où le charme et le hêtre sont dynamiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09a58c74-a067-4b48-bac6-504cc89f05f8",
                        "source_entry_id": "1eb06a68-8aad-30c1-84ca-6e8105b9145d",
                        "target_lang_word": "Reinigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reinigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80504b72-884e-3efa-8245-11532f719e2c",
                                        "entry_id": "17f55247-7113-318a-93c3-3cdb14e30eb0",
                                        "glosses": [
                                            "das Entfernen von Verschmutzung; das Reinigen von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aa15edc-881f-4404-a2db-a4bd4742c64d",
                                                "sense_id": "80504b72-884e-3efa-8245-11532f719e2c",
                                                "text": "Die Reinigung eines Kleides kann teuer sein."
                                            },
                                            {
                                                "example_id": "fdd7aa21-dff0-483f-826f-03462e944ac2",
                                                "sense_id": "80504b72-884e-3efa-8245-11532f719e2c",
                                                "text": "Zur Reinigung empfindlicher Haut kann man ein unparfümiertes Syndet nehmen."
                                            },
                                            {
                                                "example_id": "6f5b9f6b-ff40-42bd-822b-24eba84f96e6",
                                                "sense_id": "80504b72-884e-3efa-8245-11532f719e2c",
                                                "text": "Ziel ist die Reinigung der Sünder von ihren Sünden."
                                            },
                                            {
                                                "example_id": "607457d3-253a-4806-b0b3-a1213ddc0899",
                                                "sense_id": "80504b72-884e-3efa-8245-11532f719e2c",
                                                "text": "Die Reinigung der Straßen übernimmt immer noch die Stadtreinigung."
                                            },
                                            {
                                                "example_id": "6da4622c-6718-485e-b164-8279c35fff1c",
                                                "sense_id": "80504b72-884e-3efa-8245-11532f719e2c",
                                                "text": "„Ein anderes Mittel der Reinigung ist die Flamme; in der Küche dient sie zum Kochen der Speisen.“"
                                            },
                                            {
                                                "example_id": "b095e694-6f06-4f6d-aa44-538b61e821b6",
                                                "sense_id": "80504b72-884e-3efa-8245-11532f719e2c",
                                                "text": "Die Reinigung einer verstopften Rohrleitung ist leicht durch die eingebaute Reinigungsöffnung möglich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42e28f70-5ce6-3a15-af00-92e3803c0719",
                                        "entry_id": "17f55247-7113-318a-93c3-3cdb14e30eb0",
                                        "glosses": [
                                            "ein Geschäft, das [1] als Dienstleistung anbietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a36237bf-f6f8-4632-ba73-a0c9ea749361",
                                                "sense_id": "42e28f70-5ce6-3a15-af00-92e3803c0719",
                                                "text": "Man kann auch einen Teppich zur Reinigung bringen."
                                            },
                                            {
                                                "example_id": "36436c46-9c73-4c78-b88c-8ffc1b1d62ba",
                                                "sense_id": "42e28f70-5ce6-3a15-af00-92e3803c0719",
                                                "text": "Bei schwierigen Flecken gibst du den Pullover besser direkt in die Reinigung."
                                            },
                                            {
                                                "example_id": "2c4425a4-bfcd-4073-ba72-e169a66d8a08",
                                                "sense_id": "42e28f70-5ce6-3a15-af00-92e3803c0719",
                                                "text": "Ich habe die Hemden bei der Reinigung abgegeben. Kannst du sie morgen wieder abholen?"
                                            },
                                            {
                                                "example_id": "5f022682-0466-4737-b335-c9a8854bc232",
                                                "sense_id": "42e28f70-5ce6-3a15-af00-92e3803c0719",
                                                "text": "„Das Mädchen dagegen wirkt stets wie aus dem Ei gepellt, sieht immer so aus, als hätte es sein einziges Kleid und seine Schuluniform gerade aus der Reinigung geholt.“"
                                            },
                                            {
                                                "example_id": "a2749dd7-6e43-4755-862c-2f438cd0f2d5",
                                                "sense_id": "42e28f70-5ce6-3a15-af00-92e3803c0719",
                                                "text": "„Sie und Bess liebten sich innig und sahen einander auch ähnlich, doch Ethel lebte in Pelham, New York, wo ihr Mann, Max Greiss, eine Reinigung besaß und Ferngespräche waren ein Luxus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
