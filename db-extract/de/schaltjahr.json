                    }
                ],
                "senses": [
                    {
                        "sense_id": "f965a0d8-3d5d-37b2-98d0-723beb5e659b",
                        "entry_id": "9f0c47d8-4d77-3891-97ca-770fcc8f1b3f",
                        "glosses": [
                            "Jahr, das durch das Hinzukommen eines Schalttags 366 Tage zählt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfb84884-ac6d-48a2-8390-3dd9116a72a9",
                                "sense_id": "f965a0d8-3d5d-37b2-98d0-723beb5e659b",
                                "text": "2008 und 2012 sind Schaltjahre, da sie 366 Tage haben."
                            },
                            {
                                "example_id": "5a1b2020-f70a-4de8-9a47-dfd81e4c26cf",
                                "sense_id": "f965a0d8-3d5d-37b2-98d0-723beb5e659b",
                                "text": "„Um Mitternacht durften wir mit brennenden Wunderkerzen durch den Garten rennen und das Schaltjahr begrüßen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "575f10a9-4248-3024-b464-63c9d1ba276b",
                        "entry_id": "9f0c47d8-4d77-3891-97ca-770fcc8f1b3f",
                        "glosses": [
                            "seltenes Ereignis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e56333b-5faa-4d4d-b920-278f1af88f8f",
                                "sense_id": "575f10a9-4248-3024-b464-63c9d1ba276b",
                                "text": "Dass er seiner Frau etwas zum Geburtstag schenkte, geschah nur alle Schaltjahre."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db2a1d27-038c-4166-bf5c-8b475bfb3b3a",
                        "source_entry_id": "9f0c47d8-4d77-3891-97ca-770fcc8f1b3f",
                        "source_sense_id": "f965a0d8-3d5d-37b2-98d0-723beb5e659b",
                        "target_lang_word": "leap year",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "leap year",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d013c05f-1bd2-3036-81f0-10450281bc48",
                                        "entry_id": "ab08a8de-aa5a-3054-b2cd-645bddeafbc8",
                                        "glosses": [
                                            "A year in the Julian or Gregorian calendar with an intercalary day added to February (in the Gregorian calendar, February 29), used to adjust for the extra hours of the solar year; a 366-day year."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8a1f1e9-97bb-46c0-bd3d-a9a4b73caaba",
                                                "sense_id": "d013c05f-1bd2-3036-81f0-10450281bc48",
                                                "text": "The additional day which occurred every fourth year [after the Julian Reform] was given to February, as being the shortest month, and was inserted in the calendar between the twenty-fourth and twenty-fifth day. February having then twenty-nine days, the twenty-fifth was the sixth of the calends of March, sexto calendas; the preceding, which was the additional or intercalary day, was called bis-sexto calendas, hence the term bissextile, which is still employed to distinguish the year of 366 days. The English denomination of Leap-Year would have been more appropriate if that year had differed from common years in defect, and contained only 364 days. In the ecclesiastical calendar the intercalary day is still placed between the 24th and 25th of February; in the civil calendar it is the 29th."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc183bfd-f7ed-3eb3-90aa-02794aa375d0",
                                        "entry_id": "ab08a8de-aa5a-3054-b2cd-645bddeafbc8",
                                        "glosses": [
                                            "Any other year featuring intercalation, such as a year in a lunisolar calendar with 13 months instead of 12, used to maintain its alignment with the seasons of the solar year."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00040396-85d2-4a04-b4ff-00b778aea47b",
                        "source_entry_id": "9f0c47d8-4d77-3891-97ca-770fcc8f1b3f",
                        "source_sense_id": "f965a0d8-3d5d-37b2-98d0-723beb5e659b",
                        "target_lang_word": "année bissextile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "année bissextile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "495d692a-8268-3a2e-aa86-f92fa96de786",
                                        "entry_id": "d93cc202-f719-3e79-b838-c90ac22b99c7",
                                        "glosses": [
                                            "Année qui comporte 366 jours au lieu de 365 habituellement dans le calendrier grégorien ou dans le calendrier julien, le jour ajouté étant le 29 février."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71266627-e9fe-4521-a40a-a49d4cd575b1",
                                                "sense_id": "495d692a-8268-3a2e-aa86-f92fa96de786",
                                                "text": "Cette année 2024 est ce qu’on appelle une année bissextile. Cela signifie qu’au lieu d’avoir 365 jours, l’année comptera 366 jours. Un jour est rajouté, le 29 février. En dehors des années bissextiles, le 29 février n’existe tout simplement pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
