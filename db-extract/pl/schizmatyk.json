                "senses": [
                    {
                        "sense_id": "1981f71e-2baa-3a9f-b16b-dbad9c635887",
                        "entry_id": "d359d47d-07ef-3fa7-b5cd-b801b11cf1e4",
                        "glosses": [
                            "o członku innej wspólnoty religijnej, która powstała w wyniku podziału jakiejś organizacji wyznaniowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a5414c-d46a-434a-92bf-42404637334d",
                                "sense_id": "1981f71e-2baa-3a9f-b16b-dbad9c635887",
                                "text": "Jeśli przed śmiercią nie dali żadnych oznak pokuty, pogrzebu kościelnego powinni być pozbawieni notoryczni apostaci, heretycy i schizmatycy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4f3335ac-a41d-3a33-bb63-ce28eba4da9b",
                        "entry_id": "d359d47d-07ef-3fa7-b5cd-b801b11cf1e4",
                        "glosses": [
                            "o osobie, która opuściła jakąś organizację lub wspólnotę"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
