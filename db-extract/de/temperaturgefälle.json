                ],
                "senses": [
                    {
                        "sense_id": "1fd054b4-43c9-37bd-bae5-0ef874bcf3a9",
                        "entry_id": "36022e51-892f-3e7b-8c1e-9be0bc8c32e1",
                        "glosses": [
                            "(große) Differenz der Temperatur (an verschiedenen Orten zu einem Zeitpunkt (räumlich) oder an einem Ort zu verschiedenen Zeitpunkten (zeitlich))"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "ffcdd61f-5653-429b-b6e1-b733e380e050",
                                "sense_id": "1fd054b4-43c9-37bd-bae5-0ef874bcf3a9",
                                "text": "„Im Frühjahr erwärmt sich die Luft über Südeuropa und Afrika aufgrund der unterschiedlichen Intensität der Sonnenstrahlung schneller als über Nordeuropa und dem Meer. Dadurch entsteht ein großes Temperaturgefälle zwischen Nord und Süd.“"
                            },
                            {
                                "example_id": "b25aaddd-7a90-43a3-92f8-5e705d6e2c5d",
                                "sense_id": "1fd054b4-43c9-37bd-bae5-0ef874bcf3a9",
                                "text": "„Zusammen mit einem ausreichend hohen Temperaturgefälle zwischen Tag und Nacht sowie dem steinigen Untergrund entsteht ein Mikroklima, dass den Weinbau noch ermöglicht und bei dem die Reben ein gutes Säuregerüst beibehalten.“"
                            },
                            {
                                "example_id": "b283728f-10a0-4285-be99-13e4ba40f462",
                                "sense_id": "1fd054b4-43c9-37bd-bae5-0ef874bcf3a9",
                                "text": "„Die Waldzone ist durch kontinentales Klima mit einem starken Temperaturgefälle zwischen heißen Sommern und kalten Wintern geprägt.“"
                            },
                            {
                                "example_id": "67466828-40c4-415d-acbf-787923c1134b",
                                "sense_id": "1fd054b4-43c9-37bd-bae5-0ef874bcf3a9",
                                "text": "„In der Klimatologie ist der Wärmefluss vom Temperaturgefälle und von der Stärke der turbulenten Flüsse abhängig.“"
                            },
                            {
                                "example_id": "25651628-1035-45a3-873f-02601cb80f09",
                                "sense_id": "1fd054b4-43c9-37bd-bae5-0ef874bcf3a9",
                                "text": "„Das Temperaturgefälle zwischen Tropen und Polarregionen bedeutet daher grundsätzlich ein Luftdruckgefälle (siehe Luftdruck, Druckgradientkraft):“ […]."
                            },
                            {
                                "example_id": "5f27b9dc-9d68-45ad-9d00-ea3e615a5e19",
                                "sense_id": "1fd054b4-43c9-37bd-bae5-0ef874bcf3a9",
                                "text": "„Das Klima in und um Frolowo ist trocken und hochkontinental mit einem starken Temperaturgefälle zwischen den Sommer- und den Wintermonaten (bis 40 °C bzw. bis unter −35 °C).“"
                            },
                            {
                                "example_id": "afd1d804-0f75-4e02-8099-8416a3c7bc47",
                                "sense_id": "1fd054b4-43c9-37bd-bae5-0ef874bcf3a9",
                                "text": "„Über Österreich herrschte mit dem Kaltlufteinbruch zeitweise ein Temperaturgefälle von knapp 30 °C zwischen dem heißen Osten und nur 10 °C im Westen.“"
                            },
                            {
                                "example_id": "f2a6518c-2ae3-4a0e-96f4-ff5956f19858",
                                "sense_id": "1fd054b4-43c9-37bd-bae5-0ef874bcf3a9",
                                "text": "„Die Abschattung kühlt die Oberfläche ab und verstärkt dadurch das Temperaturgefälle in den obersten Bodenschichten.“"
                            },
                            {
                                "example_id": "ae70cbb7-adaf-484b-b12b-0529df01bec8",
                                "sense_id": "1fd054b4-43c9-37bd-bae5-0ef874bcf3a9",
                                "text": "„Das Temperaturgefälle bleibt: Die Höchstwerte erreichen –7 Grad in Nordost und 7 Grad am Rhein.“"
                            },
                            {
                                "example_id": "84819c6b-a658-493f-8503-2b96aa03f43f",
                                "sense_id": "1fd054b4-43c9-37bd-bae5-0ef874bcf3a9",
                                "text": "[Lawinen:] „Je größer das Temperaturgefälle, desto intensiver erfolgt die aufbauende Metamorphose.“"
                            },
                            {
                                "example_id": "f9f7b47e-3711-4d43-9648-ea06be7934c4",
                                "sense_id": "1fd054b4-43c9-37bd-bae5-0ef874bcf3a9",
                                "text": "[Technikexperiment:] „Ob der Versuch klappt oder nicht, das hängt vor allem vom richtigen Temperaturgefälle ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
