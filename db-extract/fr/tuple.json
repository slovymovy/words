                "senses": [
                    {
                        "sense_id": "51a747d1-3212-3f48-b8ad-00aca529e534",
                        "entry_id": "b76473c5-3d74-39c8-8aa3-c8c8ffe714ab",
                        "glosses": [
                            "Collection ordonnée des valeurs d'un nombre indéfini d'attributs relatifs à un même objet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7d40703-b0a6-4e90-9195-0540a709cd8f",
                                "sense_id": "51a747d1-3212-3f48-b8ad-00aca529e534",
                                "text": "Les tuples sont rangés à l'intérieur de partitions associatives dont la taille est en général une piste mais peut être moins. L’adressage à l'intérieur d'une partition s'effectue par le contenu."
                            },
                            {
                                "example_id": "7666e0e1-d891-4c20-956c-727fc845e5ff",
                                "sense_id": "51a747d1-3212-3f48-b8ad-00aca529e534",
                                "text": "Les tuples sont un type de données composé servant à stocker une collection d'éléments. Les éléments d'un tuple sont des valeurs Erlang qui ne sont pas nécessairement du même type ; ils sont placés entre accolades et sont séparés par des virgules."
                            },
                            {
                                "example_id": "a909fe12-0102-4cb7-9268-1b3e410546ee",
                                "sense_id": "51a747d1-3212-3f48-b8ad-00aca529e534",
                                "text": "Dans le spout, les données sont transformées en tuples, l'équivalent Storm des lignes d'une table. Ces tuples sont partitionnés en lots et chaque lot est envoyé à un ou plusieurs bolts répartis sur le cluster."
                            }
                        ]
                    }
                ],
