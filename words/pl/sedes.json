            "senses": [
                {
                    "sense_id": "6b44e9d2-cbe3-3a2d-a7df-4464aaf6dee6",
                    "sense_definition": "urządzenie sanitarne w postaci miski klozetowej, służące do załatwiania potrzeb fizjologicznych",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "urządzenia sanitarne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W nowo wyremontowanej łazience hydraulik zamontował nowoczesny, wiszący <w>sedes</w>.",
                            "target_lang_translations": {
                                "ru": "В свежеотремонтированной ванной сантехник установил современный подвесной <w>унитаз</w>."
                            }
                        },
                        {
                            "text": "Przed wyjściem z domu zawsze pamiętaj, aby opuścić klapę na <w>sedesie</w>.",
                            "target_lang_translations": {
                                "ru": "Перед выходом из дома всегда помни о том, чтобы опускать крышку на <w>унитазе</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "klozet",
                        "kibel"
                    ],
                    "common_phrases": [
                        "deska na sedes",
                        "czyścić sedes"
                    ],
                    "target_lang_definitions": {
                        "ru": "санитарно-техническое приспособление в виде чаши для отправления естественных потребностей; унитаз"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "унитаз",
                                "target_lang_sense_clarification": "сантехническое устройство"
                            },
                            {
                                "target_lang_word": "туалет",
                                "target_lang_sense_clarification": "сантехника / клозет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5eda016b-1c1f-3061-9c37-5558fba4ed56",
                    "sense_definition": "część miski klozetowej przeznaczona do siadania, zazwyczaj wyposażona w pokrywę; deska klozetowa",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "urządzenia sanitarne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plastikowy <w>sedes</w> pękł i trzeba było jak najszybciej kupić nowy w sklepie budowlanym.",
                            "target_lang_translations": {
                                "ru": "Пластиковый <w>стульчак</w> треснул, и пришлось как можно скорее купить новый в строительном магазине."
                            }
                        },
                        {
                            "text": "Warto regularnie dezynfekować <w>sedes</w> specjalnym płynem czyszczącym.",
                            "target_lang_translations": {
                                "ru": "Стоит регулярно дезинфицировать <w>сиденье унитаза</w> специальным чистящим средством."
                            }
                        }
                    ],
                    "common_phrases": [
                        "drewniany sedes",
                        "wymienić sedes"
                    ],
                    "target_lang_definitions": {
                        "ru": "деталь унитаза, на которую садятся, обычно с крышкой; сиденье для унитаза"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стульчак",
                                "target_lang_sense_clarification": "сиденье унитаза"
                            },
                            {
                                "target_lang_word": "сиденье для унитаза",
                                "target_lang_sense_clarification": "ободок с крышкой"
                            }
                        ]
                    }
                }
            ]
