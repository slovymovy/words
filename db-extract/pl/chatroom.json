                                "sense_id": "b23ea04e-d5b5-3df0-9869-0307561e9887",
                                "text": "Abyście się jednak mogli spotkać, musicie się pojawiać w chatroomie o ustalonej porze."
                            },
                            {
                                "example_id": "7993e924-f143-40f2-8eae-33e120651e48",
                                "sense_id": "b23ea04e-d5b5-3df0-9869-0307561e9887",
                                "text": "Nie zawsze spotykała się z miłym przyjęciem, często była wyrzucana z chatroomów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
