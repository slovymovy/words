                            {
                                "example_id": "920b954d-03f7-4983-8bfb-8d615558a6b7",
                                "sense_id": "31b8ba4f-59c3-3837-b8e9-61b2a7245fc9",
                                "text": "„In vielen Frauengräbern finden sich Armringe, -spangen und -bänder.“"
                            },
                            {
                                "example_id": "5d045d43-a4e4-47fb-be11-2d46625155e5",
                                "sense_id": "31b8ba4f-59c3-3837-b8e9-61b2a7245fc9",
                                "text": "„Pompöse Frauengräber reichen bis in die spätkeltische Zeit – und hier gibt es auch Hinweise auf einen Kult, in dessen Mittelpunkt die Verstorbene stand.“"
                            }
                        ],
