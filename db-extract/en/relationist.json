                        "glosses": [
                            "A subscriber to relationism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80b68dce-1ea3-4fca-93c3-ec8cf13634a3",
                                "sense_id": "4c9c984e-d870-38cc-9528-1befcabab423",
                                "text": "The relationist is likely to reply that this is a far cry from demonstrating that the dynamic shift is nomically possible in a strict sense."
                            },
                            {
                                "example_id": "5c96aa21-35ca-41c2-a89a-5e0376c3066f",
                                "sense_id": "4c9c984e-d870-38cc-9528-1befcabab423",
                                "text": "On the other hand, the relationists, agreeing that the past is a powerful determinant in the individual's current life, contend that one is much more independent of the past than a strict determinist philosophy will allow."
                            },
                            {
                                "example_id": "ce09d6b5-8b6e-4f9e-b14e-e9ff6baf043f",
                                "sense_id": "4c9c984e-d870-38cc-9528-1befcabab423",
                                "text": "Relationists and non-relationists differ in their assessment of the scope of the principles of justice."
                            }
                        ]
                    }
                ],
