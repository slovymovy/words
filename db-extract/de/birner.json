                ],
                "senses": [
                    {
                        "sense_id": "ac32fad8-3140-36e8-b832-aba88c3018ad",
                        "entry_id": "675fc9c5-b812-348d-b5a9-03207ad59c52",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "731faf87-9f11-4d9e-9784-678cdba75766",
                                "sense_id": "ac32fad8-3140-36e8-b832-aba88c3018ad",
                                "text": "Frau Birner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c9eb6d08-132a-4178-a507-f7ec3f7c5ee2",
                                "sense_id": "ac32fad8-3140-36e8-b832-aba88c3018ad",
                                "text": "Herr Birner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9ada2a1a-353f-4799-89ac-1c6f4f8f1e9d",
                                "sense_id": "ac32fad8-3140-36e8-b832-aba88c3018ad",
                                "text": "Die Birners fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "803f16bb-b25c-4117-91e4-780258ba7e46",
                                "sense_id": "ac32fad8-3140-36e8-b832-aba88c3018ad",
                                "text": "Der Birner trägt nie die Schals, die die Birner ihm strickt."
                            },
                            {
                                "example_id": "888bd089-f24a-4b30-b075-887d0d5b92bc",
                                "sense_id": "ac32fad8-3140-36e8-b832-aba88c3018ad",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Birner kommt, geht der Herr Birner.“"
                            },
                            {
                                "example_id": "231ba62a-c347-44b5-8790-b29eb029dfc2",
                                "sense_id": "ac32fad8-3140-36e8-b832-aba88c3018ad",
                                "text": "Birner kommt und geht."
                            },
                            {
                                "example_id": "0a8f71b2-5740-42c0-b4cc-73a5e3173b62",
                                "sense_id": "ac32fad8-3140-36e8-b832-aba88c3018ad",
                                "text": "Birners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
