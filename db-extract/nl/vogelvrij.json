                "translations": [
                    {
                        "translation_id": "55563fa9-21bf-48de-b2d9-662ddf712def",
                        "source_entry_id": "d596d6d1-6cfd-34d9-93da-d1ea4c3d5e87",
                        "source_sense_id": "7ece3b17-a2f1-388b-b294-8edd000ef79b",
                        "source_sense_description": "buiten de wet gesteld",
                        "target_lang_word": "vogelfrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vogelfrei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12903a40-a308-3c02-bdfa-43890a06c131",
                                        "entry_id": "00d9f265-fb38-37a0-a01a-0bce9c6116b5",
                                        "glosses": [
                                            "als Strafe vom Reichsacht betroffen; ausgestoßen, keine Rechte und kein Eigentum mehr besitzend"
                                        ],
                                        "tags": [
                                            "im Mittelalter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17afecc2-9a2e-4c6d-8141-f827b8d903b2",
                                                "sense_id": "12903a40-a308-3c02-bdfa-43890a06c131",
                                                "text": "Seit er vogelfrei ist, wird er überall verfolgt."
                                            },
                                            {
                                                "example_id": "7e2bc6b6-36e1-4e0a-a479-7c38b4975ce8",
                                                "sense_id": "12903a40-a308-3c02-bdfa-43890a06c131",
                                                "text": "Vogelfreie Menschen konnten ungestraft getötet werden."
                                            },
                                            {
                                                "example_id": "d7b74ef4-2560-436a-b38b-4ea4b903fc41",
                                                "sense_id": "12903a40-a308-3c02-bdfa-43890a06c131",
                                                "text": "„Und kurz darauf beschließt er, heimzureiten, obwohl er nun vogelfrei ist.“"
                                            },
                                            {
                                                "example_id": "4cd2a92c-9f44-4302-a2f1-d5ca60469b81",
                                                "sense_id": "12903a40-a308-3c02-bdfa-43890a06c131",
                                                "text": "„Und da zwei Landesverweisungen einer Rechtlosigkeit gleichkommen, solle das Thing Thorstein für vogelfrei erklären.“"
                                            },
                                            {
                                                "example_id": "305fb15e-5586-4e8c-bfdb-85b4d41e90dc",
                                                "sense_id": "12903a40-a308-3c02-bdfa-43890a06c131",
                                                "text": "„Einige der Vorfälle gegen die für vogelfrei erklärten Zigeuner werden nicht vergessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
