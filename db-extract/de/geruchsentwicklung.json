                "senses": [
                    {
                        "sense_id": "91877d04-f751-338b-8445-45cd1ed5b38e",
                        "entry_id": "987bec3e-1c20-3b58-868a-ff817d1974b6",
                        "glosses": [
                            "geruchliche Veränderung in einem zeitlichen Prozess"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69829ee7-47c1-476f-9b6e-afb2d72b1810",
                                "sense_id": "91877d04-f751-338b-8445-45cd1ed5b38e",
                                "text": "„ASP hat diesen Sachverhalt geprüft um die Quelle für die Geruchsentwicklung zu bestimmen und empfiehlt dringend die Einhaltung der unten aufgeführten Maßnahmen.“"
                            },
                            {
                                "example_id": "d39ff0f0-c3d6-40ab-98ba-402f62539d6a",
                                "sense_id": "91877d04-f751-338b-8445-45cd1ed5b38e",
                                "text": "„Als wahrscheinliche Ursache hierfür wurde im Abschlussbericht eine massive Geruchsentwicklung im Cockpitbereich hergeleitet, deren Entstehung und Verteilung nicht ermittelt werden konnte.“"
                            },
                            {
                                "example_id": "a23610ff-2741-47e9-92c1-b316e1c865c3",
                                "sense_id": "91877d04-f751-338b-8445-45cd1ed5b38e",
                                "text": "„Wie kann Geruchsentwicklung bei der Kompostierung verhindert werden?“"
                            },
                            {
                                "example_id": "adb81190-e8b2-4fd9-8398-ae654977e274",
                                "sense_id": "91877d04-f751-338b-8445-45cd1ed5b38e",
                                "text": "„Die Erfindung bezieht sich auf eine Vorrichtung zur Verhinderung von Geruchsentwicklungen und zur Verbesserung der Ölabscheidung mittels Luftzufuhr bei nach dem Phasentrennprinzip arbeitenden Ölabscheideanlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
