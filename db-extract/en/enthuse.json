                        "source_entry_id": "b90d2884-2583-325d-981f-465084823e72",
                        "source_sense_description": "to cause (someone) to feel enthusiasm",
                        "target_lang_word": "enthousiasmer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
