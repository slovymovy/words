                    "frequency": "VeryLow",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Efficient gene <w>delivery</w> remains a major challenge in modern biotechnology.",
                            "target_lang_translations": {
                                "ru": "Эффективная <w>доставка</w> генов остается серьезной проблемой в современной биотехнологии."
                            }
