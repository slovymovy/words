                        "entry_id": "b9579781-f53f-3f80-bbe1-a0a62d6be860",
                        "glosses": [
                            "уменьш. к бедняга, эмоциональное обозначение человека, попавшего в беду или испытавшего неприятность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "587502c1-f36a-418a-9bfd-1373d9da62c9",
                                "sense_id": "0a200d14-cd60-3ef6-8e58-16233382d013",
                                "text": "Ах ты бедняжка!"
                            },
                            {
                                "example_id": "edffba5e-e985-4d97-8bb5-28dcf04c8766",
                                "sense_id": "0a200d14-cd60-3ef6-8e58-16233382d013",
                                "text": "Он, бедняжка, получал одни побои."
                            },
                            {
                                "example_id": "a5b509cd-7113-4757-9647-9d42c2d2ef8b",
                                "sense_id": "0a200d14-cd60-3ef6-8e58-16233382d013",
                                "text": "Эта бедняжка целый день не ела!"
                            }
                        ]
                    }
