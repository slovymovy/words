                "senses": [
                    {
                        "sense_id": "85016fa4-0907-3ee7-a7c1-b9554c6febda",
                        "entry_id": "668e76eb-891e-39c1-b1e3-41a9766b49c1",
                        "glosses": [
                            "prozaverhaal dat wat de omvang betreft tussen de roman en het korte verhaal geplaatst wordt. De lengte is typisch tussen de 50 en 100 pagina's, maar hierover bestaat geen consensus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b561816e-e848-47ee-ba2e-f30434222917",
                                "sense_id": "85016fa4-0907-3ee7-a7c1-b9554c6febda",
                                "text": "Voorbeelden van novellen zijn De Kreutzersonate van Lev Tolstoj (1889), Die Verwandlung (De Gedaanteverwisseling) van Franz Kafka (1915) en The Old Man and the Sea (De oude man en de zee) van Ernest Hemingway (1951). Een modern voorbeeld uit het Nederlandse taalgebied is De grote wereld van Arthur Japin (het boekenweekgeschenk van 2006)."
                            }
                        ]
                    },
                    {
                        "sense_id": "a960258a-6834-36be-b5a7-aae40bfa67dd",
                        "entry_id": "668e76eb-891e-39c1-b1e3-41a9766b49c1",
                        "glosses": [
                            "wijziging van een wetsvoorstel dat de Tweede Kamer al heeft aangenomen, maar de Eerste Kamer nog niet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f3fa31c-8cd9-46bb-ac39-4984a47d5e0a",
                                "sense_id": "a960258a-6834-36be-b5a7-aae40bfa67dd",
                                "text": "De Eerste Kamer heeft geen recht van amendement, maar kan wel dreigen een wetsvoorstel af te stemmen als de regering niet met een novelle komt."
                            }
                        ]
                    }
                ],
