        "fr-extract.jsonl": [
            {
                "entry_id": "252ded68-6fb9-3959-ad53-2f69c0460fa8",
                "word": "anthropocentrisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "806652b8-7254-4e9a-8128-08d8119c2273",
                        "entry_id": "252ded68-6fb9-3959-ad53-2f69c0460fa8",
                        "tags": [
                            "plural"
                        ],
                        "form": "anthropocentrismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b48383ab-a4ce-3298-941b-0c130bc43872",
                        "entry_id": "252ded68-6fb9-3959-ad53-2f69c0460fa8",
                        "glosses": [
                            "Doctrine implicite ou diffuse, dominante dans certaines cultures et époques, qui considère que l’humain est au centre de toute chose."
                        ],
                        "tags": [
                            "Écologie politique"
                        ],
                        "examples": [
                            {
                                "example_id": "48ef653b-3c1b-4331-a46e-f29bb5990dc2",
                                "sense_id": "b48383ab-a4ce-3298-941b-0c130bc43872",
                                "text": "Le darwinisme, on le sait, est affiché par Freud comme un moment capital de la pensée humaine, comme une des trois grandes révolutions détrônant l’homme de son anthropocentrisme, entre la révolution copernicienne qui détrône la terre de sa place centrale et la révolution freudienne qui détrône même l'âme humaine de sa centration puisqu'elle se trouve excentrée par rapport à son propre inconscient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77da949a-2117-49ff-a333-f2e88c40521c",
                        "source_entry_id": "252ded68-6fb9-3959-ad53-2f69c0460fa8",
                        "source_sense_id": "b48383ab-a4ce-3298-941b-0c130bc43872",
                        "target_lang_word": "Anthropozentrismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anthropozentrismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5dccb30b-2568-3ad0-b9fb-ab215969c142",
                                        "entry_id": "c5138818-93b1-38a8-9cc5-878a8ee6af1c",
                                        "glosses": [
                                            "Position, nach der sich der Mensch selbst als Mittelpunkt der weltlichen Realität versteht"
                                        ],
                                        "tags": [
                                            "Weltanschauung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4827523f-c3d4-4940-bd6c-f3c5df97312f",
                                                "sense_id": "5dccb30b-2568-3ad0-b9fb-ab215969c142",
                                                "text": "„Der Anthropozentrismus ist ein mehrdeutiger Begriff. Zum einen bezeichnet er eine epistemische Tatsache, und zwar, dass jedes ethische Modell von Menschen gemacht wurde und insofern ein menschliches System darstellt, welches nur ausgehend vom Menschen zu verstehen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4fc3a4f3-33a5-44f3-aa54-95138564e7ac",
                        "source_entry_id": "252ded68-6fb9-3959-ad53-2f69c0460fa8",
                        "source_sense_id": "b48383ab-a4ce-3298-941b-0c130bc43872",
                        "target_lang_word": "anthropocentrism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropocentrism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ef64aa0-e174-3ae9-8c52-e57db1d3eeed",
                                        "entry_id": "70859259-2215-3653-808e-29bfff32cb36",
                                        "glosses": [
                                            "A viewpoint or theory that places human beings at the center of everything, giving preference to human beings above all other considerations."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a011151-1d29-4c0c-8955-e0e22595aee1",
                                                "sense_id": "7ef64aa0-e174-3ae9-8c52-e57db1d3eeed",
                                                "text": "Is challenging anthropocentrism irrelevant and unhelpful? The arguments against human—centredness I have advanced in the previous chapter include a strongly prudential one for the human species — that anthropocentrism leads to […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
