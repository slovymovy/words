                    {
                        "sense_id": "22d06b5f-59f5-359a-b46c-35b23d617aba",
                        "entry_id": "fd56f54e-f919-3b7e-a2ea-e1eadd55801d",
                        "glosses": [
                            "robbery, hold-up"
                        ],
