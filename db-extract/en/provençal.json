                    {
                        "translation_id": "9872ad5a-d9ba-4fc7-800f-a971d1fd03a0",
                        "source_entry_id": "e6a74e9f-2805-39b4-a053-30a060c31564",
                        "source_sense_description": "dialect of the Occitan language",
