                    },
                    {
                        "translation_id": "5d439bca-cfdd-41f7-8481-49b63186a05a",
                        "source_entry_id": "9e9e18d1-9704-3638-bb3e-8e686586eaef",
                        "source_sense_id": "1bb73fea-d7d6-394b-899d-479bb1d31c9c",
                        "target_lang_word": "caress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae0d43c6-7e02-3649-b49b-fdfd657e1217",
                                        "entry_id": "4362bacf-4c71-3c59-9434-d5654ae34a44",
                                        "glosses": [
                                            "An act of endearment; any act or expression of affection; an embracing, or touching, with tenderness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1991bbe-797f-4fbe-98bc-f6ddefe1707c",
                                                "sense_id": "ae0d43c6-7e02-3649-b49b-fdfd657e1217",
                                                "text": "He exerted himself to win by indulgence and caresses the hearts of all who were under his command."
                                            },
                                            {
                                                "example_id": "173079f5-4ef8-423e-be12-766ca60fba33",
                                                "sense_id": "ae0d43c6-7e02-3649-b49b-fdfd657e1217",
                                                "text": "And he wooed her with his soft caresses, / Wooed her with his smile of sunshine, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c023843a-35c2-33f9-b8fc-d6f909044234",
                                        "entry_id": "4362bacf-4c71-3c59-9434-d5654ae34a44",
                                        "glosses": [
                                            "A gentle stroking or rubbing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "caress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82570f29-ee57-3310-b49c-0cd7369cfc39",
                                        "entry_id": "2cda65c6-0b17-3e90-9579-8bb150d0d1bd",
                                        "glosses": [
                                            "To touch or kiss lovingly; to fondle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2feec6df-5c08-4916-a229-faff552275f9",
                                                "sense_id": "82570f29-ee57-3310-b49c-0cd7369cfc39",
                                                "text": "She loves being caressed by her boyfriend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b966c58-dc31-348f-92e6-2d4b8bb41570",
                                        "entry_id": "2cda65c6-0b17-3e90-9579-8bb150d0d1bd",
                                        "glosses": [
                                            "To affect as if with a caress."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44f38375-00b2-4ec0-9f98-547c8af65dd2",
                                                "sense_id": "9b966c58-dc31-348f-92e6-2d4b8bb41570",
                                                "text": "The love and anguish in his voice caressed my mind and soul."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad66e429-affe-4153-82ea-33f4669c8777",
                        "source_entry_id": "9e9e18d1-9704-3638-bb3e-8e686586eaef",
                        "source_sense_id": "1bb73fea-d7d6-394b-899d-479bb1d31c9c",
                        "target_lang_word": "caresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29fddc50-63ba-32fa-85df-08122e0fa326",
                                        "entry_id": "32c99fbb-45e4-3f80-8caf-c45d263f2eb9",
                                        "glosses": [
                                            "Témoignage d’affection, de tendresse ou de sensualité que l’on donne à quelqu’un, en geste ou en paroles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33f331a6-838f-4716-94a3-1cc7c050d889",
                                                "sense_id": "29fddc50-63ba-32fa-85df-08122e0fa326",
                                                "text": "Ce n’était point une linition douce, une fomentation onctueuse, mais un massage vigoureux, pratiqué à bras raccourcis, et qui rappelait plutôt les éraillures de l’étrille que les caresses de la main."
                                            },
                                            {
                                                "example_id": "08b62167-215e-493f-be54-364f9d917559",
                                                "sense_id": "29fddc50-63ba-32fa-85df-08122e0fa326",
                                                "text": "Aussi, Line ayant l’instinct des caresses en même temps que le désir d’en être l’heureux objet, elle ne doutait pas un instant que les faveurs de son amant ne dussent aborder peu à peu à toutes les parties de son corps où il serait doux de les attendre, et délicieux de les retenir."
                                            },
                                            {
                                                "example_id": "68ec2fdb-8109-4d17-9cda-876e35b76098",
                                                "sense_id": "29fddc50-63ba-32fa-85df-08122e0fa326",
                                                "text": "Oh ! chère petite ! je te comprends ! dit le colonel en serrant la main de Modeste à un moment où elle l’assaillait de caresses."
                                            },
                                            {
                                                "example_id": "505c0415-c381-4626-b4ef-631d08a72806",
                                                "sense_id": "29fddc50-63ba-32fa-85df-08122e0fa326",
                                                "text": "Le petit orphelin fut reçu par elle comme un fils, élevé près de sa fille, et partagea avec celle-ci les caresses de la douairière, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a11e3390-9960-34f2-b6e7-152287e3367a",
                                        "entry_id": "32c99fbb-45e4-3f80-8caf-c45d263f2eb9",
                                        "glosses": [
                                            "On le dit également des animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d729cd0-ac6e-45e0-9ab6-cc7351aa1110",
                                                "sense_id": "a11e3390-9960-34f2-b6e7-152287e3367a",
                                                "text": "Ce chien fait des caresses à tout le monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "332c5d09-c28b-304d-b119-01870c9ecdd8",
                                        "entry_id": "32c99fbb-45e4-3f80-8caf-c45d263f2eb9",
                                        "glosses": [
                                            "Se dit aussi des choses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35974358-f0a5-4228-a787-fd75c98cff7d",
                                                "sense_id": "332c5d09-c28b-304d-b119-01870c9ecdd8",
                                                "text": "Durtal le connaissait ce moment délicieux où l’on reprend haleine, encore abasourdi par ce brusque passage d’une bise cinglante à une caresse veloutée d’air."
                                            },
                                            {
                                                "example_id": "1fc8db6b-dad4-48ec-9e51-89eab1f8b456",
                                                "sense_id": "332c5d09-c28b-304d-b119-01870c9ecdd8",
                                                "text": "Il ne faut pas se fier aux caresses de la fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca8fef57-7b8e-3001-8087-eec882047d7f",
                                        "entry_id": "32c99fbb-45e4-3f80-8caf-c45d263f2eb9",
                                        "glosses": [
                                            "Témoignage par paroles d’une affection plus ou moins sincère."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77915403-4bb5-4c4c-adce-3bf6cd344a81",
                                                "sense_id": "ca8fef57-7b8e-3001-8087-eec882047d7f",
                                                "text": "[…] , voilà ce qui fait que j’ose vous dire que je ne suis dupe ni des caresses que me fait la maison de France, ni de celles que me fait la maison de Lorraine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ef65313-e320-327a-bab2-14ec3fab70b6",
                                        "entry_id": "9c9390b3-9d68-31b8-888e-a7c54b1a8270",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent du verbe caresser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb2296a5-e536-3a48-a573-eac493175ab1",
                                        "entry_id": "9c9390b3-9d68-31b8-888e-a7c54b1a8270",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent du verbe caresser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65dbd92f-7872-4d02-a34f-595d71d862b4",
                                                "sense_id": "fb2296a5-e536-3a48-a573-eac493175ab1",
                                                "text": "A-t-elle une main royalement belle, le plus fin croira qu’il était absolument nécessaire de rouler, de remonter ou d’écarter celle de ses ringleets ou de ses boucles qu’elle caresse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b03f13ba-332b-39ee-a357-27d8d057a7ee",
                                        "entry_id": "9c9390b3-9d68-31b8-888e-a7c54b1a8270",
                                        "glosses": [
                                            "Première personne du singulier du subjonctif présent du verbe caresser."
                                        ],
