                                "target_senses": [
                                    {
                                        "sense_id": "0f16fcdd-53cd-323d-a77e-c476e56b3f3c",
                                        "entry_id": "97ed4c40-74cf-3f4b-b120-b072e215b4f8",
                                        "glosses": [
                                            "gebakken vaatwerk en sierstukken, gevormd uit aarde, klei of leem. Keramiek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de753bbb-b749-460e-b890-1e35df448141",
                                                "sense_id": "0f16fcdd-53cd-323d-a77e-c476e56b3f3c",
                                                "text": "In Delft en Makkum werd veel aardewerk gemaakt."
                                            },
                                            {
                                                "example_id": "6370d927-6b19-4598-92b0-eacbc3f00cd8",
                                                "sense_id": "0f16fcdd-53cd-323d-a77e-c476e56b3f3c",
                                                "text": "Wij hebben kopjes en borden van aardewerk terwijl mijn ouders porseleinen vaatwerk hebben."
                                            },
                                            {
                                                "example_id": "2e539b2f-a0c3-4979-a2ea-423c6465deb1",
                                                "sense_id": "0f16fcdd-53cd-323d-a77e-c476e56b3f3c",
                                                "text": "Er stonden gedetailleerde artikelen in over de totstandkoming van pijporgels, de bewerking van materialen in een draaibank, baktechnieken en suikerraffinage, papierscheppen en boekbinden, leerlooien en zeepzieden, mijnbouw en metallurgie en de productie van porselein en aardewerk."
                                            },
                                            {
                                                "example_id": "5d098955-66a6-4ddf-834d-171c27e371bf",
                                                "sense_id": "0f16fcdd-53cd-323d-a77e-c476e56b3f3c",
                                                "text": "Haar haar was nu kortgeknipt en dof, haar pot lag in scherven om haar heen, een puzzel die niemand meer in elkaar zou kunnen zetten. Om de rand van de waterput stonden levensgrote herten en konijnen die naar beneden keken, alsof ze waren losgebroken uit het kapotte aardewerk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aardewerk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3e687a41-0ef5-3e34-a924-b427e92317c2",
                                        "entry_id": "879006cf-0084-3671-af9e-73294aff4e16",
                                        "glosses": [
                                            "van aardewerk"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
