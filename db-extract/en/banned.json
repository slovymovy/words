                "senses": [
                    {
                        "sense_id": "afe2d557-1d44-3cad-94c4-1725464039c3",
                        "entry_id": "b54c8608-3fe3-3136-a873-c7d0e97b1228",
                        "glosses": [
                            "Forbidden; not allowed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92092b2-9d8d-4a10-8ae6-6393a1a36fd6",
                                "sense_id": "afe2d557-1d44-3cad-94c4-1725464039c3",
                                "text": "As the world's drug habit shows, governments are failing in their quest to monitor every London window-box and Andean hillside for banned plants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8be3d2b4-949e-4216-b3dc-528d73759aca",
                        "source_entry_id": "b54c8608-3fe3-3136-a873-c7d0e97b1228",
                        "source_sense_id": "afe2d557-1d44-3cad-94c4-1725464039c3",
                        "source_sense_description": "Translations",
                        "target_lang_word": "interdit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interdit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a3a9017-af24-3d78-9a6a-63be063133d6",
                                        "entry_id": "4342276d-578f-3158-b412-b30c902deade",
                                        "glosses": [
                                            "Défendu par la loi, ou par la morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b7709b1-c367-4bb3-afd7-99b4b7c75368",
                                                "sense_id": "1a3a9017-af24-3d78-9a6a-63be063133d6",
                                                "text": "L’addition d’eau à la vendange ou au vin est une opération — appelée mouillage — formellement interdite par la loi. Il n'en fut pourtant pas toujours ainsi."
                                            },
                                            {
                                                "example_id": "cbd25cd5-214e-4218-bb38-df1430a6c37b",
                                                "sense_id": "1a3a9017-af24-3d78-9a6a-63be063133d6",
                                                "text": "Dans le sud de cette dernière, se trouve environ deux hectares appartenant à cette dernière mais entourés par des « mas » privés avec chasse interdite. Aussi très peu de chasseurs vont s'aventurer dans le secteur."
                                            },
                                            {
                                                "example_id": "934da098-8e51-4b1d-b46a-154be0245ddc",
                                                "sense_id": "1a3a9017-af24-3d78-9a6a-63be063133d6",
                                                "text": "Ainsi, chaque saison, les grimpeurs les plus actifs se vantaient d’avoir réalisé plus d’une demi-douzaine d’ascensions illégales du côté interdit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27220167-4dc9-3b98-b163-1397d8d6fb7b",
                                        "entry_id": "4342276d-578f-3158-b412-b30c902deade",
                                        "glosses": [
                                            "Fortement troublé, paralysé par la stupeur."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f752592a-cfa9-49ee-b957-677827911aca",
                                                "sense_id": "27220167-4dc9-3b98-b163-1397d8d6fb7b",
                                                "text": "L’homme, interdit, siffla son chien et s’éloigna."
                                            },
                                            {
                                                "example_id": "bf0eeb83-9e16-4be0-9c40-66a1dbe06dfa",
                                                "sense_id": "27220167-4dc9-3b98-b163-1397d8d6fb7b",
                                                "text": "En le voyant, Fourbel demeura interdit."
                                            },
                                            {
                                                "example_id": "bba9f432-1823-41c2-9d50-d5fd61e52786",
                                                "sense_id": "27220167-4dc9-3b98-b163-1397d8d6fb7b",
                                                "text": "La cagole est à la mode. Pourtant jusqu'à quelques années en arrière, si vous prononciez ce mot au-delà des strictes limites de l'agglomération marseillaise, on vous regardait interdit. Cagole ? Késaco ?"
                                            },
                                            {
                                                "example_id": "a34ef8da-c90c-4aa9-acc8-17702a6236c9",
                                                "sense_id": "27220167-4dc9-3b98-b163-1397d8d6fb7b",
                                                "text": "Le tout allait fort bien jusque-là ; je me félicitais intérieurement, je touchais à ma conclusion, quand le mot eut le malheur de me manquer ; l’absence atteignit bientôt jusqu’à l’idée, et me voilà muet, interdit, sans plus savoir ni ce que je voulais, ni même où j’étais."
                                            },
                                            {
                                                "example_id": "f19ee262-94a1-4121-8a22-d38bdcbe29b3",
                                                "sense_id": "27220167-4dc9-3b98-b163-1397d8d6fb7b",
                                                "text": "Done Elvire : Voilà comme il faut vous défendre, et non pas être interdit comme vous êtes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "interdit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "745e5479-ca2e-30aa-a5b3-ea86f7b4faf4",
                                        "entry_id": "b68fac00-d8f8-396b-a3fa-425df378d696",
                                        "glosses": [
                                            "Quelque chose qui est interdit par la loi, la morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abc34e2d-3e24-45c9-8b48-cda29edfa017",
                                                "sense_id": "745e5479-ca2e-30aa-a5b3-ea86f7b4faf4",
                                                "text": "Roland avait, depuis le berceau, ce que nos grands-mères appelaient le diable au corps, ce que nous appellerions nous la bougeotte névrotique, un besoin viscéral de se frotter à tous les interdits, […]."
                                            },
                                            {
                                                "example_id": "7ebe3aca-108b-49aa-bebb-c4da6ed77a5b",
                                                "sense_id": "745e5479-ca2e-30aa-a5b3-ea86f7b4faf4",
                                                "text": "L’interdit sur l’avortement, qui résultait du populationnisme français de la loi de 1920, ou plus souvent d'une prescription religieuse chrétienne, aggravait l’insécurité sexuelle et les risques d'accidents mortels résultant d’interventions clandestines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a2f7324-a8fc-3b97-b7c5-932b38835998",
                                        "entry_id": "b68fac00-d8f8-396b-a3fa-425df378d696",
                                        "glosses": [
                                            "Ensemble de règles auxquelles sont soumises les ouailles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd27c378-586d-4d8e-81ab-8e01eb906f18",
                                                "sense_id": "6a2f7324-a8fc-3b97-b7c5-932b38835998",
                                                "text": "Depuis Michelet, on a aussi, bien souvent, incriminé l’influence exercée par le prêtre sur le comportement des épouses; […]. En multipliant les interdits, il gênait l’épanouissement du plaisir des couples, quelle qu’ait pu être la valeur érotique de la transgression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16f32a73-3acb-34c3-936d-df97c71f512d",
                                        "entry_id": "b68fac00-d8f8-396b-a3fa-425df378d696",
                                        "glosses": [
                                            "Personne majeure dont l’exercice des droits est interdit et exercé par un tuteur ou une tutrice."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9f0c626-42a9-4813-8f69-8439276b39eb",
                                                "sense_id": "16f32a73-3acb-34c3-936d-df97c71f512d",
                                                "text": "L’interdit est assimilé au mineur, pour sa personne et pour ses biens : les lois sur la tutelle des mineurs s’appliqueront à la tutelle des interdits."
                                            },
                                            {
                                                "example_id": "b62eba6a-0b1f-4725-95f3-480fb1c6f881",
                                                "sense_id": "16f32a73-3acb-34c3-936d-df97c71f512d",
                                                "text": "Note : la notion d’interdit a été supprimée en France en 1968, au Luxembourg en 1982, en Belgique en 2013."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "585a22d1-241b-3100-b0bb-65fc3f66e9c5",
                                        "entry_id": "b68fac00-d8f8-396b-a3fa-425df378d696",
                                        "glosses": [
                                            "Peine canonique prononcée par une autorité ecclésiastique (le pape ou l’évêque)"
                                        ],
                                        "tags": [
                                            "Discipline ecclésiastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3be93c5a-8f93-46d5-8dc2-4843ddf8179d",
                                                "sense_id": "585a22d1-241b-3100-b0bb-65fc3f66e9c5",
                                                "text": "Prononcer l’interdit."
                                            },
                                            {
                                                "example_id": "8cef9876-6e19-492b-aa7c-1f3ace3a3b23",
                                                "sense_id": "585a22d1-241b-3100-b0bb-65fc3f66e9c5",
                                                "text": "Encourir l’interdit ; frapper d’interdit ; fulminer un interdit ; lancer l’interdit sur quelqu’un, sur une ville ; lever l’interdit."
                                            },
                                            {
                                                "example_id": "93b75091-0945-4d39-98e5-fb4a14664a3a",
                                                "sense_id": "585a22d1-241b-3100-b0bb-65fc3f66e9c5",
                                                "text": "Il fallait faire cesser le culte, fermer les portes des temples, mettre les églises en interdit, ordonner aux prêtres de ne plus administrer les sacrements."
                                            },
                                            {
                                                "example_id": "efc9f738-8aae-4813-820e-24ff00e7346b",
                                                "sense_id": "585a22d1-241b-3100-b0bb-65fc3f66e9c5",
                                                "text": "Le précédent recteur, M. K…, était vicaire général quelque part dans le Nord. Aussitôt arrivé ici, il a été mis en interdit ; pas un ecclésiastique ne lui rendait ses visites, pas même le plus petit abbé. L’Université étant l’ennemie, un prêtre qui devient son chef passe à l’ennemi."
                                            },
                                            {
                                                "example_id": "bece6579-2f42-4e2c-8b6c-72662637af00",
                                                "sense_id": "585a22d1-241b-3100-b0bb-65fc3f66e9c5",
                                                "text": "— Au nom de la bien-pensance, des groupes et des partis politiques instillent des interdits qui chamboulent notre démocratie alors que la voix des minorités devient plus tonitruante que celle de la majorité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efb8a05e-66ae-3f86-8313-73a0faec6ef3",
                                        "entry_id": "b68fac00-d8f8-396b-a3fa-425df378d696",
                                        "glosses": [
                                            "Peine canonique prononcée par une autorité ecclésiastique (le pape ou l’évêque)",
                                            "Qui défend à un ecclésiastique en particulier l’exercice des ordres sacrés."
                                        ],
                                        "tags": [
                                            "Discipline ecclésiastique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24ba56c0-749d-3bcf-9073-43669a00886d",
                                        "entry_id": "b68fac00-d8f8-396b-a3fa-425df378d696",
                                        "glosses": [
                                            "Peine canonique prononcée par une autorité ecclésiastique (le pape ou l’évêque)",
                                            "Ou qui, porté contre une localité, défend à tout ecclésiastique la célébration des sacrements et du service divin dans les lieux marqués par la sentence."
                                        ],
                                        "tags": [
                                            "Discipline ecclésiastique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7012ff76-7353-3030-b22f-754aad52cd79",
                                        "entry_id": "b68fac00-d8f8-396b-a3fa-425df378d696",
                                        "glosses": [
                                            "Sentence proclamée par un groupe religieux contre un autre groupe soupçonné d’hérésie."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7282204-3fba-4dc2-8197-7de4e969ea73",
                                                "sense_id": "7012ff76-7353-3030-b22f-754aad52cd79",
                                                "text": "Les partisans de Maïmonide répliquèrent à l’interdit prononcé par les « littéralistes » en lançant, à leur tour, l’excommunication contre les auteurs de l’interdit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "interdit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a81ba072-cb23-331c-9963-7fd889e6d20e",
                                        "entry_id": "0cbd8d43-3d98-32b2-9b8d-7354d356831a",
                                        "glosses": [
                                            "Participe passé masculin singulier de interdire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d73d07e1-e85e-495b-becd-d754d7c150bb",
                                                "sense_id": "a81ba072-cb23-331c-9963-7fd889e6d20e",
                                                "text": "Suzy, qui s’était mis en tête de la décatéchiser, lui avait formellement interdit d’entrer dans toute église, elle célébrait chaque dimanche matin son propre office dans sa chambre, dont elle avait pris soin auparavant de verrouiller la porte et de fermer les volets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb0cf51-8027-3ba2-9cbd-4c0bc95a8e61",
                                        "entry_id": "0cbd8d43-3d98-32b2-9b8d-7354d356831a",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de interdire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eabbf180-c4f6-46e2-bfcc-b6cf253cbd54",
                                                "sense_id": "7eb0cf51-8027-3ba2-9cbd-4c0bc95a8e61",
                                                "text": "L’immense répartition du conte 425 et des formes associées interdit de même toute localisation pour le passage du mythe au conte, en admettant même - ce que je tiens pour probable - qu’il se soit opéré une seule fois, et de là diffusé, puis re-partagé en variantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0072b55-48ca-3521-8b8d-8a7d1e03f54a",
                                        "entry_id": "0cbd8d43-3d98-32b2-9b8d-7354d356831a",
                                        "glosses": [
                                            "Troisième personne du singulier du passé simple de interdire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d1e9f86-b51d-466b-b4e4-627d3ed8a4ab",
                                                "sense_id": "e0072b55-48ca-3521-8b8d-8a7d1e03f54a",
                                                "text": "Lorsque la troupe des pastoureaux entra dans Orléans, le jour de saint Barnabas, l’évêque de cette ville interdit à tous ses clercs d’assister à ses prédications ; car, disait-il, ce sont les souricières du diable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a11d39a0-51bb-491b-b21f-9a976a9111be",
                        "source_entry_id": "b54c8608-3fe3-3136-a873-c7d0e97b1228",
