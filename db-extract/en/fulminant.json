                    },
                    {
                        "sense_id": "8bce23f1-6633-3108-a059-95de3f506efb",
                        "entry_id": "48de6023-a793-39f1-9206-b45fad4c53d6",
                        "glosses": [
                            "Appearing quickly and with destructive effects."
                        ],
                        "tags": [
                            "especially",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4e676045-3fee-4d0f-8262-9ad4e1d70691",
                                "sense_id": "8bce23f1-6633-3108-a059-95de3f506efb",
                                "text": "Fulminant hepatitis seems to be more common in females than in males (11).[…]In contrast to common belief, Chalmers (17) has shown that physical exercise during infectious hepatitis does not increase the risk of a fulminant course of disease."
                            },
                            {
                                "example_id": "08094402-5a47-45f6-ac1f-e0bf6437c8ac",
                                "sense_id": "8bce23f1-6633-3108-a059-95de3f506efb",
                                "text": "When his liver function was measured, an acute, fulminant hepatitis was discovered."
                            }
                        ]
                    }
                ],
