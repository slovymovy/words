                ],
                "senses": [
                    {
                        "sense_id": "2499f60a-6473-3b0b-b10d-dae714b2a961",
                        "entry_id": "b4929961-3664-32f6-9913-e5d484c29001",
                        "glosses": [
                            "sehr arm an Licht, sodass keine effektive Photosynthese mehr betrieben werden kann"
                        ],
                        "tags": [
                            "Meereskunde"
                        ],
                        "examples": [
                            {
                                "example_id": "4632613e-7eb6-4d1e-b990-d8b3f4ea86f4",
                                "sense_id": "2499f60a-6473-3b0b-b10d-dae714b2a961",
                                "text": "„Die Grenze zwischen dysphotischer und aphotischer Zone wird anhand der Augenausbildung bei Ostrakoden gezogen (s. Abb. 4).“"
                            },
                            {
                                "example_id": "048132e2-ce19-4b8a-8c65-79ad37094985",
                                "sense_id": "2499f60a-6473-3b0b-b10d-dae714b2a961",
                                "text": "„Unter der euphotischen Zone befindet sich die nur noch schwach durchleuchtete dysphotische Zone, so tief, dass nur blaues Licht noch eindringen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
