            {
                "entry_id": "0aa0ff6d-ea6a-3ae3-955d-9f1a0743ffd0",
                "word": "schoolmarm",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e430b5b8-6014-443d-aae4-c0d54cef43ca",
                        "entry_id": "0aa0ff6d-ea6a-3ae3-955d-9f1a0743ffd0",
                        "tags": [
                            "plural"
                        ],
                        "form": "schoolmarms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae9f2926-0516-358a-b18c-1f643414e3ba",
                        "entry_id": "0aa0ff6d-ea6a-3ae3-955d-9f1a0743ffd0",
                        "glosses": [
                            "A female teacher, especially one seen to be old-fashioned and extremely severe and strict."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f161c9cc-50b9-463a-871d-11dc6410bd2b",
                                "sense_id": "ae9f2926-0516-358a-b18c-1f643414e3ba",
                                "text": "The schoolmarm came to an abrupt stop in her arithmetic quizzing, her face set into a pruny scowl that looked to be permanent."
                            },
                            {
                                "example_id": "8936e922-6fd6-49a8-8b5e-188cacf7d62a",
                                "sense_id": "ae9f2926-0516-358a-b18c-1f643414e3ba",
                                "text": "I never thought of [my granfather] as \"colorful.\" Matter of fact, he was an unsavory old coot - not a good influence for a growing boy by the standards of those times. Mmm, there was something about a young schoolmarm and him in the town my family had lived in, some scandal - \"scandal\" for those days, I mean - and I think that was why we moved."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d39d806-3e87-3fcf-a034-087613710d44",
                        "entry_id": "0aa0ff6d-ea6a-3ae3-955d-9f1a0743ffd0",
                        "glosses": [
                            "Someone who acts like a schoolmarm; a person acting harsh and stern."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1272e2d9-a4fb-4f2c-9ece-38a6c0d1ce0d",
                                "sense_id": "6d39d806-3e87-3fcf-a034-087613710d44",
                                "text": "Bernstein, am I a stuffed shirt? Am I a horse-faced hypocrite? Am I a New England school marm?"
                            }
                        ]
                    },
                    {
                        "sense_id": "acb3ffa8-db14-3c6b-b156-d338d64c0769",
                        "entry_id": "0aa0ff6d-ea6a-3ae3-955d-9f1a0743ffd0",
                        "glosses": [
                            "A tree with two or more trunks; a forked tree."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31c34486-0299-4cd7-909b-3bba85b66d6d",
                                "sense_id": "acb3ffa8-db14-3c6b-b156-d338d64c0769",
                                "text": "His brother Thomas, impaled upon the \"schoolmarm tree,\" had opened his mouth to cry but snow and wind hurled back the words into his throat so that nothing emerges but white froth."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd8c5ce2-b939-42bb-9226-41ea0dae5daa",
                        "source_entry_id": "0aa0ff6d-ea6a-3ae3-955d-9f1a0743ffd0",
                        "source_sense_description": "female teacher",
                        "target_lang_word": "institutrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "institutrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96fb26ff-ecf1-3e95-b34c-83f5898a6b39",
                                        "entry_id": "ad1307d5-e768-3df4-8501-d2e4e0a1d196",
                                        "glosses": [
                                            "Femme qui enseigne dans une école primaire, publique ou privée."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bd88267-9eb8-48df-850c-adfa5c857876",
                                                "sense_id": "96fb26ff-ecf1-3e95-b34c-83f5898a6b39",
                                                "text": "Les dames institutrices durent être des religieuses."
                                            },
                                            {
                                                "example_id": "2da531a9-af4f-4b36-be74-d0f6c43e4527",
                                                "sense_id": "96fb26ff-ecf1-3e95-b34c-83f5898a6b39",
                                                "text": "Mais, au fait, les institutrices sont de deux sortes : les normaliennes et les autres, simplement pourvues du brevet élémentaire ou du brevet supérieur. Mme Paulin m’a appris cette importante différence, du premier jour, rien qu’à sa façon d’appeler Mlle Bord « la normalienne », et moi-même, depuis, j’ai constaté non seulement une dissemblance, mais un antagonisme entre les institutrices. La normalienne se croit d’une autre essence que sa collègue ; elle juge inférieure et « popotte » toute institutrice qui ne sort pas de la fabrique spéciale."
                                            },
                                            {
                                                "example_id": "6e0889dd-3ae2-48b1-8fc5-e415bd369cc0",
                                                "sense_id": "96fb26ff-ecf1-3e95-b34c-83f5898a6b39",
                                                "text": "La « Mort aux Chats » a connu, jadis, une prospérité relative ; institutrice, mariée à un employé, elle portait des chapeaux."
                                            },
                                            {
                                                "example_id": "b2dc1989-5c9b-47b8-a4d1-8bca3484f012",
                                                "sense_id": "96fb26ff-ecf1-3e95-b34c-83f5898a6b39",
                                                "text": "Elle avait quelques difficultés avec l’institutrice qui avait tendance à « corsiser » systématiquement son enseignement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b507158-6706-4ba9-9d45-d647b5785e1e",
                        "source_entry_id": "0aa0ff6d-ea6a-3ae3-955d-9f1a0743ffd0",
                        "source_sense_description": "female teacher",
                        "target_lang_word": "maîtresse d'école",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aba27432-2a7d-4f05-99fc-2ddd3c5a5d2e",
                        "source_entry_id": "0aa0ff6d-ea6a-3ae3-955d-9f1a0743ffd0",
                        "source_sense_description": "female teacher",
                        "target_lang_word": "peau de vache",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peau de vache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38cd4aa0-329a-3fcd-bf89-f989c1a6af5d",
                                        "entry_id": "c50a9595-43e7-305a-b7b7-8724e384dbe0",
                                        "glosses": [
                                            "Individu méchant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "742aefa2-35b7-42e3-89f0-681f6c91e710",
                                                "sense_id": "38cd4aa0-329a-3fcd-bf89-f989c1a6af5d",
                                                "text": "Il n’est guère plus fort en orthographe que son collègue de l’Intérieur. Mais il en sait plus long en histoire et en économie sociale, ce savetier, que n’en savent tous les diplômés réunis qui ont, avant lui, pris le portefeuille — dont il a, avant-hier, tâté le ventre, avec une moue d’homme qui se connaît plus en peau de vache qu’en maroquin."
                                            },
                                            {
                                                "example_id": "b850395e-ae5a-4295-9f7e-8ab9572083c4",
                                                "sense_id": "38cd4aa0-329a-3fcd-bf89-f989c1a6af5d",
                                                "text": "– Faut pas dire le contraire, fait le sergent-chef Dupieu, y a de bons gars chez eux.\n– T’as raison, dit Pater, des bons gars habillés dans une peau de vache."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "peau de vache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3ec0001-5ef8-3e85-9fd2-b3b1b32d3228",
                                        "entry_id": "24d5e44d-97a6-3095-b2ea-df66a40616d7",
                                        "glosses": [
                                            "Qui est méchant."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e870ab3d-7751-4fb0-bc69-f8d6d56653a8",
                                                "sense_id": "a3ec0001-5ef8-3e85-9fd2-b3b1b32d3228",
                                                "text": "Il maintient son fils dans le droit chemin du travail et de l’austère vertu avec une sévérité de patriarche peau de vache qui fait l’admiration de maman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd894a0a-89ee-42ba-884c-7de3102a03cd",
                        "source_entry_id": "0aa0ff6d-ea6a-3ae3-955d-9f1a0743ffd0",
