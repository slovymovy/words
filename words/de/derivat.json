                {
                    "sense_id": "b29fa419-7a5e-35de-9a9f-adb2e144acbe",
                    "sense_definition": "Finanzinstrument, dessen Wertentwicklung sich aus dem Preis eines zugrunde liegenden Basiswerts ergibt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Finanzwesen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Banken nutzen verschiedene <w>Derivate</w>, um sich gegen Schwankungen von Wechselkursen abzusichern."
                        },
                        {
                            "text": "Anleger können durch riskante <w>Derivate</w> innerhalb kurzer Zeit viel Geld verlieren."
                        }
                    ],
                    "synonyms": [
                        "Finanzderivat"
                    ],
                    "common_phrases": [
                        "Handel mit Derivaten",
                        "komplexe Derivate"
                    ]
                },
                {
                    "sense_id": "c5d54801-2a33-3f6c-bd51-84f8e597220b",
                    "sense_definition": "Produkt, Modell oder System, das aus einer bestehenden Version oder Plattform hervorgegangen ist.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "Produktentwicklung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das neue Betriebssystem ist ein direktes <w>Derivat</w> einer bewährten Open-Source-Software."
                        },
                        {
                            "text": "Der Autobauer bringt nächstes Jahr ein sportliches <w>Derivat</w> des bekannten Modells auf den Markt."
                        }
                    ],
                    "synonyms": [
                        "Ableitung"
                    ],
                    "common_phrases": [
                        "ein sportliches Derivat",
                        "Derivate der Software"
                    ]
                },
                {
                    "sense_id": "977440c7-3576-3386-b57a-f48afb56eeab",
                    "sense_definition": "Chemische Verbindung, die aus einem Grundstoff durch gezielte molekulare Veränderung entstanden ist.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "Chemie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Labor synthetisierten die Forscher ein neues <w>Derivat</w> des bekannten Wirkstoffs."
                        },
                        {
                            "text": "Viele synthetische Kunststoffe sind chemische <w>Derivate</w> von Erdöl oder Erdgas."
                        }
                    ],
                    "common_phrases": [
                        "organische Derivate",
                        "ein synthetisches Derivat"
                    ]
                },
                {
                    "sense_id": "1d7af353-56da-3178-a3a0-13f93b3b6e14",
                    "sense_definition": "Wort, das durch morphologische Ableitung aus einem anderen Wort oder Stamm gebildet wurde.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "Linguistik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Substantiv 'Schönheit' ist ein sprachliches <w>Derivat</w> des Adjektivs 'schön'."
                        },
                        {
                            "text": "In der Grammatik untersucht man, wie verschiedene <w>Derivate</w> aus einfachen Wortstämmen entstehen."
