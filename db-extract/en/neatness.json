                        "form_id": "5bcb3f63-752f-426b-a4f1-bfeb77593eac",
                        "entry_id": "55712805-e15a-3389-9bbf-ced1e6d5c2b5",
                        "tags": [
                            "plural"
                        ],
                        "form": "neatnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27a452b4-fde4-31d4-aef4-3fd9f50b5d08",
                        "entry_id": "55712805-e15a-3389-9bbf-ced1e6d5c2b5",
                        "glosses": [
                            "The state of being neat."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0433a29a-1bbf-4a5e-9433-2e065817f0d3",
                                "sense_id": "27a452b4-fde4-31d4-aef4-3fd9f50b5d08",
                                "text": "Both engines and carriages were maintained in admirable cleanliness, and a very high standard of neatness characterised the permanent way and lineside buildings."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e265f6a-5cd3-46e0-b00b-d43db3227bc1",
                        "source_entry_id": "55712805-e15a-3389-9bbf-ced1e6d5c2b5",
                        "source_sense_id": "27a452b4-fde4-31d4-aef4-3fd9f50b5d08",
                        "source_sense_description": "the state of being neat",
                        "target_lang_word": "netteté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "netteté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "183950ae-2683-325c-a85d-e1135a0b8e25",
                                        "entry_id": "87b4e851-eb4a-393b-a0da-f9b4f7a9fb93",
                                        "glosses": [
                                            "Qualité de ce qui est net."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "446cd1d5-851f-4774-90e1-0aba117e40a9",
                                                "sense_id": "183950ae-2683-325c-a85d-e1135a0b8e25",
                                                "text": "Il conçoit, il s’exprime avec beaucoup de netteté."
                                            },
                                            {
                                                "example_id": "d0cbf1dc-0b0a-4fc5-91d5-423133788323",
                                                "sense_id": "183950ae-2683-325c-a85d-e1135a0b8e25",
                                                "text": "Cette expression manque de netteté."
                                            },
                                            {
                                                "example_id": "8d230df7-7d9d-48e4-8adb-e3314957a2c8",
                                                "sense_id": "183950ae-2683-325c-a85d-e1135a0b8e25",
                                                "text": "La netteté d’une glace, d’un diamant."
                                            },
                                            {
                                                "example_id": "1145774f-c98e-48e7-be45-7ef098890608",
                                                "sense_id": "183950ae-2683-325c-a85d-e1135a0b8e25",
                                                "text": "La netteté de son écriture flatte l’œil."
                                            },
                                            {
                                                "example_id": "a5f1e270-5841-4b36-9751-f41bde3e6c2f",
                                                "sense_id": "183950ae-2683-325c-a85d-e1135a0b8e25",
                                                "text": "Il a beaucoup de netteté dans l’esprit, dans les idées."
                                            },
                                            {
                                                "example_id": "45edf7d1-774c-42f1-85a5-af90e75d08d7",
                                                "sense_id": "183950ae-2683-325c-a85d-e1135a0b8e25",
                                                "text": "Son style est d’une netteté admirable."
                                            },
                                            {
                                                "example_id": "21c28617-acb4-43c6-8616-ff84e88a442c",
                                                "sense_id": "183950ae-2683-325c-a85d-e1135a0b8e25",
                                                "text": "Le recours au béton autoplaçant a permis de diminuer les épaisseurs des dalles et refends et d'accentuer leur netteté, leur aspect tranchant et radical."
                                            },
                                            {
                                                "example_id": "4def0fa6-2d57-4de5-8dc5-e462e1bc1a76",
                                                "sense_id": "183950ae-2683-325c-a85d-e1135a0b8e25",
                                                "text": "Les paramètres numériques de dérawtisation (luminosité, facteur de contraste, saturation des teintes, netteté, accentuation, filtres, etc.) ont été testés comparativement, avant leur sélection définitive."
                                            },
                                            {
                                                "example_id": "f978ccb6-2787-4a15-8def-5a6ba1dfdffb",
                                                "sense_id": "183950ae-2683-325c-a85d-e1135a0b8e25",
                                                "text": "L’évaluation de la netteté se fait ordinairement par le plus petit intervalle e mesuré entre deux points ou deux traits distincts de l'épreuve ; […]."
                                            },
                                            {
                                                "example_id": "cd26e150-b88d-4772-8613-8527854d2ed6",
                                                "sense_id": "183950ae-2683-325c-a85d-e1135a0b8e25",
                                                "text": "L’harmonicorde de Debain, sur lequel Lefébure Wely excellait, était un harmonium pourvu de cordes tendues qui pouvaient être, ou non, frappées pour donner plus de netteté à l'attaque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
