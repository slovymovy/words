                "senses": [
                    {
                        "sense_id": "7493250f-6a3f-3791-9df7-bc32035f741a",
                        "entry_id": "ed5ab108-b37b-3ade-b3b6-9798b47dcd2c",
                        "glosses": [
                            "Journaliste qui tient la rubrique des faits divers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7c03fa8-b3c0-41a5-940c-0c09fff2e726",
                                "sense_id": "7493250f-6a3f-3791-9df7-bc32035f741a",
                                "text": "Il y a branle-bas dans les rédactions de journaux, tous les reporters, interviewers, chroniqueurs, faits-diversiers, sont mobilisés."
                            },
                            {
                                "example_id": "a841380a-6854-4c5d-b68c-1422f9838cb3",
                                "sense_id": "7493250f-6a3f-3791-9df7-bc32035f741a",
                                "text": "Les sources où les faits-diversiers puisent une partie de leurs informations sont, à Paris, la Préfecture de police et la Sûreté, où sont centralisés les rapports reçus des différents quartiers ; en province, les secrétariats de mairie, les commissariats et les gendarmeries."
                            },
                            {
                                "example_id": "7cd48e53-9342-48f2-8f78-6da181226725",
                                "sense_id": "7493250f-6a3f-3791-9df7-bc32035f741a",
                                "text": "Qu’elle nous débarrass’des bell’s-mèr'’s, des huissiers\nEt des joueurs d’orgu’de Barbarie,\nDes apach’s, des bomb’s, et des faits-diversiers,\nEt des sauveurs de la Patrie !"
                            },
                            {
                                "example_id": "5e8e1209-006d-45c7-8201-c8db33350801",
                                "sense_id": "7493250f-6a3f-3791-9df7-bc32035f741a",
                                "text": "Depuis qu'il avait couvert, quatre ans plus tôt, la célèbre \"affaire Mary Lampson\", le meurtre d'une actrice dans un cinéma de quartier, François était reconnu comme le plus doué des faits-diversiers."
                            }
                        ]
                    }
