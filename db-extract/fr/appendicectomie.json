                        "entry_id": "ec489702-26ba-39d3-bde0-c32e8a1c2c06",
                        "glosses": [
                            "Ablation de l’appendice vermiforme du cæcum, appelé aussi appendice iléo-cæcal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9466535c-4e01-43a0-8afa-3a6b3127ab7a",
                                "sense_id": "5bdb6fae-4371-3572-8fbe-7e3088cbba08",
                                "text": "L’appendicectomie consiste classiquement, en une incision, dite de Mac Burney, réalisée en fosse iliaque droite pour réséquer l’appendice."
                            },
                            {
                                "example_id": "77840b0e-7951-49f3-ab83-1e105da26201",
                                "sense_id": "5bdb6fae-4371-3572-8fbe-7e3088cbba08",
                                "text": "Selon une étude récente, 360000 personnes subissent uneappendicectomie chaque année en France."
                            }
                        ]
                    }
