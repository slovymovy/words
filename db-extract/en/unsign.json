                "senses": [
                    {
                        "sense_id": "2796b3ee-6c79-313f-97b0-5747fc8bd768",
                        "entry_id": "455cc452-0231-34f3-85d9-b5a910bf4166",
                        "glosses": [
                            "To remove one's signature from (something one has signed)."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f9579a98-7f3c-40e6-821b-f5f1dd0f508f",
                                "sense_id": "2796b3ee-6c79-313f-97b0-5747fc8bd768",
                                "text": "Listen : I say we signed, and there's no unsigning.\nAnd the voyage is never completed, though some may ask\nWhat creature is this, with the sea through his eyes looking[?]\n[…]\nWe signed and there's no unsigning.\nHell, no, but she rolls\nAnd she rolls us like foam from her flanks, the gay mulatto."
                            },
                            {
                                "example_id": "e751a224-54ab-45a1-864a-a74bce30cde8",
                                "sense_id": "2796b3ee-6c79-313f-97b0-5747fc8bd768",
                                "text": "UNSIGNING AND CHANGING A REPORT SHOULD ONLY BE USED IN VERY RARE CASES IN WHICH FAILURE TO CHANGE THE ORIGINAL REPORT COULD RESULT IN SIGNIFICANT HARM TO THE PATIENT."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba73669e-4281-3048-a12c-d5b4853370aa",
                        "entry_id": "455cc452-0231-34f3-85d9-b5a910bf4166",
                        "glosses": [
                            "To declare void one's signing of (a treaty)."
                        ],
                        "tags": [
                            "of a state"
                        ],
                        "examples": [
                            {
                                "example_id": "dd2d280c-fcb3-4ce5-8bbf-bf46f43210a4",
                                "sense_id": "ba73669e-4281-3048-a12c-d5b4853370aa",
                                "text": "Third, transnational legal process could be used to erode the force of the novel US tactic of unsigning the Rome Treaty."
                            },
                            {
                                "example_id": "62b23fce-82e4-41a3-aec9-e04598968da0",
                                "sense_id": "ba73669e-4281-3048-a12c-d5b4853370aa",
                                "text": "Unsigning the Rome Statute. My happiest moment at State was personally “unsigning” the Rome Statute that created the International Criminal Court (ICC). […] bureaucrats urged at every turn that foreign governments would be extremely upset if we unsigned. In fact, only High Minded Europeans cared even slightly, which was simply further evidence that unsigning was the right thing to do."
                            },
                            {
                                "example_id": "001839f5-d6ed-4632-b266-9b598b26e8f4",
                                "sense_id": "ba73669e-4281-3048-a12c-d5b4853370aa",
                                "text": "The administration took the unprecedented step of unsigning the treaty, entered into negotiations with over 100 countries to inoculate the United States from its provisions, […]"
                            }
                        ]
                    }
