                    {
                        "translation_id": "b879c852-d920-4135-be02-c6b0d9ecec66",
                        "source_entry_id": "d639e055-77ce-3b3f-8b8f-1ee9d1073dc7",
                        "source_sense_description": "человек, владеющий фермой",
                        "target_lang_word": "Farmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Farmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7e2f100-ecb2-370f-8080-ea95c23f58c0",
                                        "entry_id": "16c47d55-59ca-3faf-aa39-864e9359966e",
                                        "glosses": [
                                            "Person, die eine Farm besitzt und diese auch meist betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1a87aa7-805c-401f-aa88-030b815a79df",
                                                "sense_id": "d7e2f100-ecb2-370f-8080-ea95c23f58c0",
                                                "text": "Sein Vater arbeitet als Farmer."
                                            },
                                            {
                                                "example_id": "5a65edbe-34c6-4f66-b09d-f4c05452efc0",
                                                "sense_id": "d7e2f100-ecb2-370f-8080-ea95c23f58c0",
                                                "text": "„Neben dem Tor, auf einem Holzklotz, saß der Farmer.“"
                                            },
                                            {
                                                "example_id": "ed0a6269-7ef4-47d4-8ef0-f2efeb1bf850",
                                                "sense_id": "d7e2f100-ecb2-370f-8080-ea95c23f58c0",
                                                "text": "„Gleichzeitig arbeiten immer mehr weiße Farmer mit moderner Agrartechnik und entlassen ihre Helfer in die Arbeitslosigkeit.“"
                                            },
                                            {
                                                "example_id": "29f8d902-bde2-402e-95c7-7339218126b1",
                                                "sense_id": "d7e2f100-ecb2-370f-8080-ea95c23f58c0",
                                                "text": "„Dort wurden sie im fruchtbaren Stellenbosch Valley von Farmern für die Obst- und Gemüseernte sowie für die Weinlese eingestellt, und auch von den Fabriken, die diese Produkte verarbeiteten und verpackten.\""
                                            },
                                            {
                                                "example_id": "910481c2-530b-4256-85f2-a1a786e5e396",
                                                "sense_id": "d7e2f100-ecb2-370f-8080-ea95c23f58c0",
                                                "text": "„John Fletcher stand auf der einen Seite und wartete, bis Mr. Lane den Farmer fertig bedient hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a300bec-9e9d-4ef5-b67f-217d0c015301",
                        "source_entry_id": "d639e055-77ce-3b3f-8b8f-1ee9d1073dc7",
                        "source_sense_description": "человек, владеющий фермой",
                        "target_lang_word": "fermier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fermier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40a030c5-6640-3813-adff-2db6311f01e3",
                                        "entry_id": "343120ef-75cf-3fe0-91a1-b5934cb30aad",
                                        "glosses": [
                                            "Agriculteur, cultivateur, paysan."
                                        ],
                                        "tags": [
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8aa74e50-5187-4839-8b41-59416d9240c4",
                                                "sense_id": "40a030c5-6640-3813-adff-2db6311f01e3",
                                                "text": "Les subsistances, dans ce moment, […] inquiètent en particulier les fermiers ces derniers sont indécis sur le parti qu'ils doivent prendre pour la vente de leurs grains."
                                            },
                                            {
                                                "example_id": "408a7925-23a4-490a-a2d7-2aa06c05c840",
                                                "sense_id": "40a030c5-6640-3813-adff-2db6311f01e3",
                                                "text": "Dans lers états agricoles du Middle-West, les fermiers, voyant les prix des terres monter sans arrêt, empruntaient à 8 ou 10 % pour agrandir leurs fermes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f1b7c3b-642e-39b4-beab-0469021eddd0",
                                        "entry_id": "343120ef-75cf-3fe0-91a1-b5934cb30aad",
                                        "glosses": [
                                            "Celui qui tient à ferme une propriété agricole."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b15132e2-13e8-3cb2-b124-d8324d6a704f",
                                        "entry_id": "343120ef-75cf-3fe0-91a1-b5934cb30aad",
                                        "glosses": [
                                            "Celui qui prend à ferme des terres ou des droits."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dfb98a3-3092-4efe-9ef1-125789f3e52b",
                                                "sense_id": "b15132e2-13e8-3cb2-b124-d8324d6a704f",
                                                "text": "Le moulin de Montgon ayant été supprimé par suite de la création du canal des Ardennes , outre l'indemnité d’expropriation due au propriétaire , il en était dû une au fermier […]."
                                            },
                                            {
