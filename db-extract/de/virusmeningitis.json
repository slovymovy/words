                ],
                "senses": [
                    {
                        "sense_id": "1d998cec-db94-3f53-9920-2eeb7fc26099",
                        "entry_id": "bd9a82bf-0c9e-38fc-98e3-5d0ae7dec293",
                        "glosses": [
                            "Entzündung der Hirnhaut, die durch ein Virus verursacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83ce55aa-fe94-483f-9b26-64139b779d6e",
                                "sense_id": "1d998cec-db94-3f53-9920-2eeb7fc26099",
                                "text": "„Jedes Jahr werden in diesem Labor mehrere Tausend Proben von Patienten mit Verdacht auf Virusmeningitis oder schlaffe Lähmungen untersucht.“"
                            },
                            {
                                "example_id": "1ffbaf38-5acf-4c3b-ab1a-84c627a1bd32",
                                "sense_id": "1d998cec-db94-3f53-9920-2eeb7fc26099",
                                "text": "„In der Differenzialdiagnose sind zunächst andere intrakranielle Infektionen zu unterscheiden, v. a. die Virusmeningitis, aber auch Virusenzephalitis, tuberkulöse Meningitis, Pilzmeningitis, Mollaret-Meningitis, Rickettsiose und parameningeale Eiterherde wie Hirnabszess, epiduraler Abszess oder subdurales Empyem (Pfister 2002).“"
                            },
                            {
                                "example_id": "ae36564e-2872-4bfa-8756-3fa5c0a1a245",
                                "sense_id": "1d998cec-db94-3f53-9920-2eeb7fc26099",
                                "text": "„Die Virusmeningitis ist eine meist akute, fast immer gutartig verlaufende Infektionskrankheit, bei der neben Störungen des Allgemeinbefindens und neben katarrhalischen Erscheinungen der oberen Atemwege meningeale Zeichen das Bild beherrschen, entsprechend den entzündlichen Veränderungen der Meningen und des Plexus chorioideus. Erreger ist das sog. LCM-Virus.“"
                            },
                            {
                                "example_id": "beca5fd3-e2eb-41fb-a589-d0795145bde5",
                                "sense_id": "1d998cec-db94-3f53-9920-2eeb7fc26099",
                                "text": "„Eine Therapie ist bis auf die durch Herpes-simplex-Viren ausgelöste Infektion nicht notwendig, da die Virusmeningitis nach 10—14 (1 spontan abheilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
