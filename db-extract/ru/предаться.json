                ],
                "senses": [
                    {
                        "sense_id": "78e925ff-666b-3625-9fd7-2406c3b5a5d4",
                        "entry_id": "a382cc19-30a6-397e-8e8d-9e676931e150",
                        "glosses": [
                            "to give oneself up (to)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14512d6b-10a5-4ab8-aaa6-b9d702b1624d",
                                "sense_id": "78e925ff-666b-3625-9fd7-2406c3b5a5d4",
                                "text": "преда́ться гне́ву (страстя́м)",
                                "translation": "to give oneself up (abandon oneself) to anger (passions)",
                                "english": "to give oneself up (abandon oneself) to anger (passions)"
                            },
                            {
                                "example_id": "5160f22b-08a6-422d-b575-260a0db02fea",
                                "sense_id": "78e925ff-666b-3625-9fd7-2406c3b5a5d4",
                                "text": "преда́ться отча́янию",
                                "translation": "to give way to despair",
                                "english": "to give way to despair"
                            },
                            {
                                "example_id": "449ffd6d-15c7-41dd-a2e8-738056c19c85",
                                "sense_id": "78e925ff-666b-3625-9fd7-2406c3b5a5d4",
                                "text": "преда́ться поро́кам",
                                "translation": "to indulge in vices",
                                "english": "to indulge in vices"
                            },
                            {
                                "example_id": "08f53b05-a26d-4303-a2a8-6528551ef6eb",
                                "sense_id": "78e925ff-666b-3625-9fd7-2406c3b5a5d4",
                                "text": "преда́ться мечта́м",
                                "translation": "to fall into a reverie; lapse into daydreams",
                                "english": "to fall into a reverie; lapse into daydreams"
                            },
                            {
                                "example_id": "daa2d67a-6d1d-487b-89cb-335222ae7003",
                                "sense_id": "78e925ff-666b-3625-9fd7-2406c3b5a5d4",
                                "text": "Я показа́л письмо́ Ма́рье Ива́новне, кото́рая нашла́ его́ столь убеди́тельным и тро́гательным, что не сомнева́лась в успе́хе его́ и предала́сь чу́вствам не́жного своего́ се́рдца со все́ю дове́рчивостию мо́лодости и любви́.",
                                "translation": "I showed my letter to Maria Ivanovna, who thought it so convincing and so touching, that she did not doubt its success, and gave herself up to the feelings of her tender heart in all the confidence of youth and love.",
                                "english": "I showed my letter to Maria Ivanovna, who thought it so convincing and so touching, that she did not doubt its success, and gave herself up to the feelings of her tender heart in all the confidence of youth and love."
                            }
                        ]
