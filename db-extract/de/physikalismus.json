                "senses": [
                    {
                        "sense_id": "fd1920be-dcad-3ee0-9293-f7c8e224b93f",
                        "entry_id": "988362af-8c3c-31c8-ab4c-1bc184a61f9c",
                        "glosses": [
                            "die These, dass die Realität vollständig physisch ist und sich folglich alle Phänomene (also auch etwa das Bewusstsein, Leben oder die Moral) aus der Zusammensetzung physischer Elemente ergeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29fc4fb9-c1a1-49ad-89d7-2a2a770ca453",
                                "sense_id": "fd1920be-dcad-3ee0-9293-f7c8e224b93f",
                                "text": "Für den Physikalismus gibt es auf die Frage nach dem, was uns und unsere Welt ausmacht, letztlich die Antwort: Moleküle und Atome, andere neigen eher dazu, das Leben und seine Erscheinungsformen für reine Ideen und ein Produkt unseres Geistes zu halten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d0cb80db-ba46-3e58-8be7-eecbc0fd614b",
                        "entry_id": "988362af-8c3c-31c8-ab4c-1bc184a61f9c",
                        "glosses": [
                            "ein metaphysikkritisches Programm der philosophischen Schule des Logischen Empirismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d87c630-5b9d-4d24-ad5a-1e5d2aea5625",
                                "sense_id": "d0cb80db-ba46-3e58-8be7-eecbc0fd614b",
                                "text": "Der Physikalismus forderte eine physikalistische Sprache, um alle Aussagen aller Wissenschaften in dieser einen Sprache ausdrücken zu können."
                            }
                        ],
                        "sense_index_json": "\"2\""
