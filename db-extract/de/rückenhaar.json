                "senses": [
                    {
                        "sense_id": "5ba5aa7d-987e-3323-9d5c-f292025788dd",
                        "entry_id": "99759658-fd37-3935-b0ea-f3c6f9e02ff9",
                        "glosses": [
                            "Behaarung des Rückens (bei einem Tier)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "004d5ad2-401e-475b-ada9-1affdd78d3dc",
                                "sense_id": "5ba5aa7d-987e-3323-9d5c-f292025788dd",
                                "text": "„Ebenfalls aus Rückenhaar entsteht der Dachsbart, der Hirschbart dagegen aus der Halsmähne unten.“"
                            },
                            {
                                "example_id": "d99e94ff-53a3-4166-94f6-54990b0fd46e",
                                "sense_id": "5ba5aa7d-987e-3323-9d5c-f292025788dd",
                                "text": "„Zu diesem Zweck geliert er das Rückenhaar, stellt es zu einem Kamm auf und modelliert anschliessend mit der Schere die gewünschte ebenmässige Rückenlinie.“"
                            },
                            {
                                "example_id": "131801a0-ea1d-451a-8ffe-7bcd0495cc1f",
                                "sense_id": "5ba5aa7d-987e-3323-9d5c-f292025788dd",
                                "text": "„Zum Entfernen der Rückenhaare stehen Ihnen verschiedene effiziente Methoden zur Verfügung.“"
                            },
                            {
                                "example_id": "5eaa4d6f-23ea-4b6d-a96f-00d40e511540",
                                "sense_id": "5ba5aa7d-987e-3323-9d5c-f292025788dd",
                                "text": "„Hunde und Katzen sträuben die Rückenhaare und wirken so größer und imposanter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
