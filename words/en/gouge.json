{
    "word_family": [
        "gouger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2aff6653-a5fd-3b55-8ca2-260a9037085b",
                    "sense_definition": "To make a groove, hole, or mark in a surface by scooping or cutting with or as if with a gouge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "carving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a sharp tool to <w>gouge</w> a deep groove into the wooden block.",
                            "target_lang_translations": {
                                "ru": "Художник использовал острый инструмент, чтобы <w>выдолбить</w> глубокий желоб в деревянном бруске."
                            }
                        },
                        {
                            "text": "Be careful not to <w>gouge</w> the table when you are carving that piece of wood.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, чтобы не <w>повредить</w> стол, когда будете вырезать этот кусок дерева."
                            }
                        }
                    ],
                    "synonyms": [
                        "engrave",
                        "grave",
                        "incise"
                    ],
                    "common_phrases": [
                        "gouge a groove",
                        "gouge the wood"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проделывать паз, отверстие или след на поверхности путем вырезания или выдалбливания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдалбливать",
                                "target_lang_sense_clarification": "делать углубление"
                            },
                            {
                                "target_lang_word": "выдолбить",
                                "target_lang_sense_clarification": "сделать углубление (сов. вид)"
                            },
                            {
                                "target_lang_word": "продолбить",
                                "target_lang_sense_clarification": "проделать отверстие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac512850-8c8f-359f-b317-1b12045c5b32",
                    "sense_definition": "To cheat or overcharge someone by demanding an unfairly or unreasonably high price.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cheating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the fuel shortage, some gas stations tried to <w>gouge</w> customers by doubling their prices.",
                            "target_lang_translations": {
                                "ru": "Во время нехватки топлива некоторые заправочные станции пытались <w>обдирать</w> клиентов, удваивая цены."
                            }
                        },
                        {
                            "text": "The company has no competition, so it tends to <w>gouge</w> its clients.",
                            "target_lang_translations": {
                                "ru": "У компании нет конкурентов, поэтому она склонна <w>обдирать</w> своих клиентов."
                            }
                        }
                    ],
                    "synonyms": [
                        "defraud",
                        "swindle"
                    ],
                    "common_phrases": [
                        "gouge customers",
                        "price gouging"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the context of price gouging"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обманывать или завышать цену, требуя несправедливо или необоснованно высокую плату."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдирать",
                                "target_lang_sense_clarification": "брать непомерную плату"
                            },
                            {
                                "target_lang_word": "ободрать",
                                "target_lang_sense_clarification": "обобрать, взять слишком много денег"
                            },
                            {
                                "target_lang_word": "завышать цены",
                                "target_lang_sense_clarification": "устанавливать грабительские цены"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dfde792-4cf3-3610-98d9-3bd40a1e30cd",
                    "sense_definition": "To dig or scoop something out forcefully; specifically, to try to push someone's eye out of its socket with a thumb.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "scooping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The attacker tried to <w>gouge</w> his opponent's eyes during the brutal street fight.",
                            "target_lang_translations": {
                                "ru": "Нападавший пытался <w>выколоть</w> глаза своему противнику во время жестокой уличной драки."
                            }
                        },
                        {
                            "text": "He used a heavy iron spoon to <w>gouge</w> out the remaining clay from the mold.",
                            "target_lang_translations": {
                                "ru": "Он использовал тяжелую железную ложку, чтобы <w>выскрести</w> оставшуюся глину из формы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gouge out eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Силой выкапывать или выковыривать что-либо; в частности, пытаться выдавить кому-то глаз большим пальцем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкалывать",
                                "target_lang_sense_clarification": "глаза"
                            },
                            {
                                "target_lang_word": "выколоть",
                                "target_lang_sense_clarification": "глаз (сов. вид)"
                            },
                            {
                                "target_lang_word": "выковыривать",
                                "target_lang_sense_clarification": "силой извлекать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "17197cd0-f7c8-3194-9693-685bbd2c2e86",
                    "sense_definition": "To use a gouge tool for cutting or carving.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "carving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter began to <w>gouge</w> along the marked lines of the timber.",
                            "target_lang_translations": {
                                "ru": "Плотник начал <w>долбить</w> вдоль размеченных линий на брусе."
                            }
                        },
                        {
                            "text": "He learned how to <w>gouge</w> and chisel properly during his apprenticeship.",
                            "target_lang_translations": {
                                "ru": "Во время ученичества он научился правильно <w>работать стамеской</w> и долотом."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать полукруглое долото для резки или резьбы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "долбить",
                                "target_lang_sense_clarification": "инструментом"
                            },
                            {
                                "target_lang_word": "резать стамеской",
                                "target_lang_sense_clarification": "полукруглым долотом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9113909b-d993-36fa-b759-403c3dd2d201",
                    "sense_definition": "A cut, groove, or cavity left by a gouge or a sharp object.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "marks",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The falling branch left a deep <w>gouge</w> in the side of the car.",
                            "target_lang_translations": {
                                "ru": "Упавшая ветка оставила глубокую <w>вмятину</w> на боку машины."
                            }
                        },
                        {
                            "text": "He noticed a fresh <w>gouge</w> on the wooden floor where the heavy box had been dragged.",
                            "target_lang_translations": {
                                "ru": "Он заметил свежую <w>борозду</w> на деревянном полу там, где тащили тяжелый ящик."
                            }
                        }
                    ],
                    "common_phrases": [
                        "deep gouge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Срез, борозда или впадина, оставленная полукруглым долотом или острым предметом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выемка",
                                "target_lang_sense_clarification": "углубление"
                            },
                            {
                                "target_lang_word": "жёлоб",
                                "target_lang_sense_clarification": "продольное углубление"
                            },
                            {
                                "target_lang_word": "царапина",
                                "target_lang_sense_clarification": "глубокий след на поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4615b18a-0577-380a-8c78-b152d394f61d",
                    "sense_definition": "A chisel with a curved blade used for cutting or scooping channels, grooves, or holes in wood or stone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The woodcarver selected a sharp <w>gouge</w> to hollow out the bowl.",
                            "target_lang_translations": {
                                "ru": "Резчик по дереву выбрал острое <w>полукруглое долото</w>, чтобы выдолбить чашу."
                            }
                        },
                        {
                            "text": "He used a curved <w>gouge</w> to create smooth channels in the stone sculpture.",
                            "target_lang_translations": {
                                "ru": "Он использовал изогнутую <w>стамеску</w>, чтобы сделать плавные желоба в каменной скульптуре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "curved gouge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Долото с изогнутым лезвием, используемое для вырезания или выдалбливания канавок, пазов или отверстий в дереве или камне."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полукруглое долото",
                                "target_lang_sense_clarification": "инструмент для резьбы"
                            },
                            {
                                "target_lang_word": "полукруглая стамеска",
                                "target_lang_sense_clarification": "столярный инструмент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e6f168b-8d9b-3fb4-a5d2-065fb10bd0ab",
                    "sense_definition": "An act of cheating, a fraud, or an excessive overcharge.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cheating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Charging fifty dollars for a bottle of water is a complete <w>gouge</w>.",
                            "target_lang_translations": {
                                "ru": "Брать пятьдесят долларов за бутылку воды — это чистая <w>обдираловка</w>."
                            }
                        },
                        {
                            "text": "The customers complained that the sudden price increase was an absolute <w>gouge</w>.",
                            "target_lang_translations": {
                                "ru": "Покупатели жаловались, что внезапное повышение цен было абсолютным <w>грабежом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "swindle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used to describe financial exploitation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт обмана, мошенничества или чрезмерного завышения цен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обдираловка",
                                "target_lang_sense_clarification": "грабительские цены"
                            },
                            {
                                "target_lang_word": "надувательство",
                                "target_lang_sense_clarification": "обман с деньгами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d0c6c2b-332d-3618-b710-379d14e1bd35",
                    "sense_definition": "A bookbinder's tool with a curved face, used for blind tooling or gilding.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan carefully pressed the heated <w>gouge</w> onto the leather spine to create a gold curve.",
                            "target_lang_translations": {
                                "ru": "Мастер аккуратно прижал нагретый <w>штамп</w> к кожаному корешку, чтобы создать золотой изгиб."
                            }
                        },
                        {
                            "text": "A specialized <w>gouge</w> is required to achieve the delicate curved patterns on antique books.",
                            "target_lang_translations": {
                                "ru": "Для создания тонких изогнутых узоров на старинных книгах требуется специальный <w>фигурный штамп</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переплетный инструмент с изогнутой рабочей частью, используемый для тиснения или золочения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штамп-голыш",
                                "target_lang_sense_clarification": "переплетный инструмент"
                            },
                            {
                                "target_lang_word": "фигурный штамп",
                                "target_lang_sense_clarification": "для тиснения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96c586ab-b206-373e-8ba6-1fac4c7cb28e",
                    "sense_definition": "An incising tool used to cut out shaped blanks for envelopes, gloves, or other items from paper or leather.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory worker aligned the leather sheet under the heavy <w>gouge</w> to stamp out glove shapes.",
                            "target_lang_translations": {
                                "ru": "Рабочий фабрики выровнял кожаный лист под тяжелым <w>вырубным штампом</w>, чтобы вырезать заготовки для перчаток."
                            }
                        },
                        {
                            "text": "Each envelope blank was cleanly sliced using a custom-shaped steel <w>gouge</w>.",
                            "target_lang_translations": {
                                "ru": "Каждая заготовка для конверта была аккуратно вырезана с помощью стального <w>пробойника</w> особой формы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Режущий инструмент, используемый для вырубки фигурных заготовок для конвертов, перчаток или других изделий из бумаги или кожи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырубной штамп",
                                "target_lang_sense_clarification": "для кожи или бумаги"
                            },
                            {
                                "target_lang_word": "просечка",
                                "target_lang_sense_clarification": "вырубной инструмент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73b1d483-ab48-3f59-8707-1aafb750ef77",
                    "sense_definition": "The act of scooping, digging out, or overcharging.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With one swift <w>gouge</w> of his thumb, he cleared the packed dirt from the pipe.",
                            "target_lang_translations": {
                                "ru": "Одним быстрым <w>движением</w> большого пальца он вычистил спрессованную грязь из трубы."
                            }
                        },
                        {
                            "text": "The consumer watchdog group protested against the systematic <w>gouge</w> of utility payers.",
                            "target_lang_translations": {
                                "ru": "Группа по защите прав потребителей выразила протест против систематического <w>обмана</w> плательщиков коммунальных услуг."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по выковыриванию, выкапыванию или завышению цен."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдалбливание",
                                "target_lang_sense_clarification": "процесс создания углубления"
                            },
                            {
                                "target_lang_word": "взвинчивание цен",
                                "target_lang_sense_clarification": "завышение стоимости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27a4378d-88de-3124-badf-91a5374c8317",
                    "sense_definition": "An impostor or a swindler.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cheating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was exposed as a dishonest <w>gouge</w> who had tricked several families out of their savings.",
                            "target_lang_translations": {
                                "ru": "Его разоблачили как нечестного <w>мошенника</w>, который выманил сбережения у нескольких семей."
                            }
                        },
                        {
                            "text": "Do not trust that smooth-talking salesman; he is nothing but a <w>gouge</w>.",
                            "target_lang_translations": {
                                "ru": "Не верьте этому слащавому продавцу, он всего лишь <w>пройдоха</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Rarely used in modern English to refer to a person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самозванец или мошенник."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мошенник",
                                "target_lang_sense_clarification": "обманщик"
                            },
                            {
                                "target_lang_word": "пройдоха",
                                "target_lang_sense_clarification": "плут"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c2133c7-e139-3bec-bbcb-8fe3728cf0cd",
                    "sense_definition": "Soft, clay-like material found between the wall of a vein and the solid ore in a mine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners easily dug through the soft layer of <w>gouge</w> to reach the rich vein of gold.",
                            "target_lang_translations": {
                                "ru": "Шахтеры легко прокопали мягкий слой <w>глины</w>, чтобы добраться до богатой золотой жилы."
                            }
                        },
                        {
                            "text": "A thick band of fault <w>gouge</w> separated the solid rock formations in the tunnel.",
                            "target_lang_translations": {
                                "ru": "Плотная полоса <w>тектонической глины</w> разделяла твердые породы в туннеле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fault gouge"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly used in mining and geological contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий глиноподобный материал, находящийся между стенкой жилы и твердой рудой в шахте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зальбанд",
                                "target_lang_sense_clarification": "глинистый слой в жиле"
                            },
                            {
                                "target_lang_word": "fault gouge",
                                "target_lang_sense_clarification": "тектоническая глина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a746198a-50b0-35ee-ae75-78215252425b",
                    "sense_definition": "Information, especially inside information or study guides used to prepare for exams.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The senior students passed down some useful <w>gouge</w> on what to expect during the flight exam.",
                            "target_lang_translations": {
                                "ru": "Старшекурсники передали полезную <w>информацию</w> о том, чего ожидать на экзамене по полетам."
                            }
                        },
                        {
                            "text": "He spent the night studying the test <w>gouge</w> provided by his classmates.",
                            "target_lang_translations": {
                                "ru": "Он провел ночь, изучая <w>шпаргалки</w> к тесту, которые дали ему одноклассники."
                            }
                        }
                    ],
                    "common_phrases": [
                        "good gouge"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Primarily US military and naval academy slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Информация, особенно инсайдерская информация или учебные пособия, используемые для подготовки к экзаменам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шпаргалка",
                                "target_lang_sense_clarification": "материалы для подготовки"
                            },
                            {
                                "target_lang_word": "слив",
                                "target_lang_sense_clarification": "инсайдерская информация"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c44e5d64-1399-3ee8-969c-83a769d542df",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
