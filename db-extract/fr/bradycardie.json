                        "entry_id": "560eff92-775b-3307-ab62-c425e8528c22",
                        "glosses": [
                            "Diminution anormale du nombre des battements du cœur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f85a9f27-181d-4dbe-b69e-8df00151a03c",
                                "sense_id": "12f0f53e-e015-3d6d-a1d4-ca8ea6fcc437",
                                "text": "Les bradycardies sont définies par une fréquence cardiaque inférieure à 60/min."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "028cd53a-6ca0-4983-a1db-19505d126c69",
                        "source_entry_id": "560eff92-775b-3307-ab62-c425e8528c22",
                        "source_sense_id": "12f0f53e-e015-3d6d-a1d4-ca8ea6fcc437",
                        "target_lang_word": "bradycardia",
