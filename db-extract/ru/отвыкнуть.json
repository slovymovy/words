                    },
                    {
                        "sense_id": "11875eeb-c4f5-3bce-8c43-8bfcf175c344",
                        "entry_id": "31fb5ec7-4a94-3eab-a2ac-5c72e374c8e0",
                        "glosses": [
                            "находясь в отдалении, не общаясь, забыть кого-либо или что-либо"
                        ],
                        "tags": [],
