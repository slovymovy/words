                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He thinks the new girl in our class is a total <dime>.",
                            "target_lang_translations": {
                                "ru": "Он считает, что новенькая в нашем классе — просто <w>красотка</w>.",
                                "zh": "他觉得我们班新来的那个女生是个十足的<w>大美女</w>。"
                            }
                        },
                        {
                            "text": "My friend is dating a certified <dime>.",
                            "target_lang_translations": {
                                "ru": "Мой друг встречается с настоящей <w>красоткой</w>.",
                                "zh": "我朋友正在和一个公认的<w>大美女</w>交往。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dime piece"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень привлекательный человек, особенно женщина, которую оценивают на десять баллов из десяти.",
                        "zh": "非常有魅力的人，尤其指被认为外貌满分的美女。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красотка",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "десятка",
                                "target_lang_sense_clarification": "оценка внешности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大美女",
                                "target_lang_sense_clarification": "口语、俚语，指非常漂亮的女人"
                            },
                            {
                                "target_lang_word": "美女",
                                "target_lang_sense_clarification": "较口语化，指很有吸引力的人，常指女性"
                            }
                        ]
