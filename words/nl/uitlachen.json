    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd63e946-2643-3c62-9212-d545cbb01201",
                    "sense_definition": "Iemand bespotten door om diegene te lachen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bespotten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen <w>lachten</w> de nieuwe leerling <w>uit</w> vanwege zijn vreemde kleding.",
                            "target_lang_translations": {
                                "en": "The children <w>laughed at</w> the new student because of his strange clothes."
                            }
                        },
                        {
                            "text": "Je moet hem niet <w>uitlachen</w>, want hij doet gewoon zijn best.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>laugh at</w> him, because he is just doing his best."
                            }
                        }
                    ],
                    "synonyms": [
                        "bespotten",
                        "belachelijk maken"
                    ],
                    "antonyms": [
                        "prijzen",
                        "respecteren"
                    ],
                    "common_phrases": [
                        "iemand vierkant uitlachen",
                        "iemand hardop uitlachen"
                    ],
                    "target_lang_definitions": {
                        "en": "To mock or ridicule someone by laughing at them"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "laugh at",
                                "target_lang_sense_clarification": "mockingly"
                            },
                            {
                                "target_lang_word": "mock",
                                "target_lang_sense_clarification": "make fun of"
                            },
                            {
                                "target_lang_word": "ridicule",
                                "target_lang_sense_clarification": "subject to laughter"
                            },
                            {
                                "target_lang_word": "make fun of",
                                "target_lang_sense_clarification": "tease or mock"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4e570f0-5b64-306d-9be1-757272a92a14",
                    "sense_definition": "Ophouden met lachen, klaar zijn met lachen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stoppen_met_lachen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als jullie eenmaal <w>uitgelachen</w> zijn, kunnen we eindelijk met de vergadering beginnen.",
                            "target_lang_translations": {
                                "en": "Once you all <w>have finished laughing</w>, we can finally start the meeting."
                            }
                        },
                        {
                            "text": "Ik ben nog lang niet <w>uitgelachen</w> om die grappige grap van gisteravond.",
                            "target_lang_translations": {
                                "en": "I <w>haven't finished laughing</w> about that funny joke from last night yet."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uitgelachen zijn"
                    ],
                    "target_lang_definitions": {
                        "en": "To finish laughing, to stop laughing after a period of time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finish laughing",
                                "target_lang_sense_clarification": "stop laughing"
                            },
                            {
                                "target_lang_word": "have one's laugh out",
                                "target_lang_sense_clarification": "laugh until satisfied"
                            }
                        ]
                    }
                }
            ]
        }
    ]
