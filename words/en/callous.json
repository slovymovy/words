                    "frequency": "Middle",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was so <w>callous</w> that she could criticize a patient for being sick."
                        },
                        {
                            "text": "The judge made a <w>callous</w> remark about the contestant's failed performance."
                        }
                    ],
                    "synonyms": [
                        "heartless",
                        "insensitive",
                        "hardhearted"
                    ],
                    "common_phrases": [
                        "callous disregard",
                        "callous indifference"
                    ]
                },
                {
                    "sense_id": "3c868ff7-7f06-38dc-adbd-dda8557c5027",
                    "sense_definition": "Having or relating to hardened skin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guitarist developed <w>callous</w> skin on his fingertips from years of practice."
                        },
                        {
                            "text": "Manual labor often results in <w>callous</w> patches on the palms of the hands."
                        }
                    ],
                    "synonyms": [
