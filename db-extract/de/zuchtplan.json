                "senses": [
                    {
                        "sense_id": "52015cca-e396-3b0f-be9f-ac7e52a5bc70",
                        "entry_id": "a7680850-7c60-3623-b92b-9b8e307f160f",
                        "glosses": [
                            "Konzept zur erfolgreichen Vermehrung bei Nutztieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6d77415-c23d-4826-aec6-9d8edaeb79be",
                                "sense_id": "52015cca-e396-3b0f-be9f-ac7e52a5bc70",
                                "text": "„Das Verständnis für Vererbungsgrundsätze und Zuchtpläne ist zu wecken.“"
                            },
                            {
                                "example_id": "42129cd6-740c-449d-aec6-8be551ce1b69",
                                "sense_id": "52015cca-e396-3b0f-be9f-ac7e52a5bc70",
                                "text": "„Ihr Ziel ist es, Zuchtpläne für Rinder auszuarbeiten, die gegen die Schlafkrankheit tolerant sind, also trotz Ansteckung weiterhin Milch produzieren und sich vermehren, und die ausserdem an die lokalen Lebensbedingungen gewöhnt sind.“"
                            },
                            {
                                "example_id": "cd32b52d-2475-462b-a524-72a0da65db2a",
                                "sense_id": "52015cca-e396-3b0f-be9f-ac7e52a5bc70",
                                "text": "„Sich ein Urteil darüber zu bilden, ob er mit diesem Zuchtplan das Richtige getroffen, war Herrn v. Scholl nicht vergönnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
