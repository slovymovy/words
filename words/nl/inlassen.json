                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Om de stroomvoorziening te verbeteren, werd er een nieuwe middenspanningsruimte <w>ingelast</w>.",
                            "target_lang_translations": {
                                "en": "To improve the power supply, a new medium-voltage substation was <w>looped in</w>."
                            }
                        },
                        {
                            "text": "De technici moesten een extra transformatorstation in het bestaande netwerk <w>inlassen</w>.",
                            "target_lang_translations": {
