                ],
                "translations": [
                    {
                        "translation_id": "11792bf7-5439-443d-b74e-ab46c233f0f2",
                        "source_entry_id": "faf7fa4f-037a-3393-8a38-72a7350c6da6",
                        "source_sense_id": "e3ede9b9-34b9-325d-a4f6-34fd1d6d65df",
                        "target_lang_word": "perplexité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perplexité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4da6c2fb-7901-354a-a4ff-b4e22cb0e0ca",
                                        "entry_id": "9bea73c8-4ab5-3414-9529-9536bebb64a8",
                                        "glosses": [
                                            "État de celui, celle qui est perplexe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35616d47-3686-49a3-94ec-b155a952cd65",
                                                "sense_id": "4da6c2fb-7901-354a-a4ff-b4e22cb0e0ca",
                                                "text": "Le général resta pendant un moment en proie à des perplexités faciles à comprendre."
                                            },
                                            {
                                                "example_id": "c5184ff9-fe4c-4eaa-b5e3-cd349791d407",
                                                "sense_id": "4da6c2fb-7901-354a-a4ff-b4e22cb0e0ca",
                                                "text": "Choisir un fruit, une femme ou une cravate le frappait d'une perplexité qui ressemblait à une angoisse."
                                            },
                                            {
                                                "example_id": "f78b7614-f4a4-4501-8b42-651dc0e04194",
                                                "sense_id": "4da6c2fb-7901-354a-a4ff-b4e22cb0e0ca",
                                                "text": "Le front barré des plis de la plus douloureuse perplexité, il était là, immobile demandant, après l’avoir vigoureusement blasphémé, un miracle à son Dieu."
                                            },
                                            {
                                                "example_id": "d9b000fa-290a-4cde-a666-524a743e73b5",
                                                "sense_id": "4da6c2fb-7901-354a-a4ff-b4e22cb0e0ca",
                                                "text": "Elle perdit d’un coup son assurance et montra une perplexité de chatte à qui l’on verse du lait dans une bouteille au goulot étroit."
                                            },
                                            {
                                                "example_id": "290110f2-c9f9-465d-8d92-43b475538533",
                                                "sense_id": "4da6c2fb-7901-354a-a4ff-b4e22cb0e0ca",
                                                "text": "Son visage portait les marques de la plus profonde perplexité et, visiblement, il se demandait si Tacherot ne se moquait pas un peu de lui."
                                            },
                                            {
                                                "example_id": "b8b752ed-b4f3-42d4-9381-9c48f6d4bb6a",
                                                "sense_id": "4da6c2fb-7901-354a-a4ff-b4e22cb0e0ca",
                                                "text": "Assez docilement se laissa-t-il convaincre : l'aptitude pour le dessin qu'il s'était découverte en croquant, au ministère, les binettes de ses voisins de pupitre, achevait de lui supprimer toute perplexité de vocation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "86eda7a2-7000-46d7-a12c-b41b0e20ac68",
                        "source_entry_id": "faf7fa4f-037a-3393-8a38-72a7350c6da6",
                        "source_sense_id": "e3ede9b9-34b9-325d-a4f6-34fd1d6d65df",
                        "target_lang_word": "embarras",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "embarras",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "acb7fe94-e909-338d-8f17-6d532827775b",
                                        "entry_id": "c213aea2-9e4b-3994-8bf4-3f5d1d3e883d",
                                        "glosses": [
                                            "Ce qui embarrasse ou résultat de l’action d’embarrasser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "befeb9fa-5fa2-4668-8082-2f8f5ef72c28",
                                                "sense_id": "acb7fe94-e909-338d-8f17-6d532827775b",
                                                "text": "Dans la plupart des familles, une jeune fille est considérée comme un embarras ; marier sa fille à dix-huit ans, c’est faire une bonne affaire, la marier à seize ans, c’est en faire une meilleure. La voir malheureuse chez son mari est un embarras bien moins grand que de la voir heureuse chez soi, sans mari !…"
                                            },
                                            {
                                                "example_id": "96346f81-b997-4ed0-85d5-52b7ac38fab0",
                                                "sense_id": "acb7fe94-e909-338d-8f17-6d532827775b",
                                                "text": "Elles sont bien sombres, ces rues, bien boueuses, bien encombrées de voitures, de caisses, de ballots, de paquets de toute espèce, et c’est difficilement que nous parvenons à nous faufiler au milieu de ces embarras sans cesse renaissants."
                                            },
                                            {
                                                "example_id": "e260888b-f7be-4380-b0af-96b6e98e31af",
                                                "sense_id": "acb7fe94-e909-338d-8f17-6d532827775b",
                                                "text": "Pas une querelle entre nous ; chez lui pas la moindre marque de la supériorité que lui donnait sa position, et chez moi pas le plus léger embarras ; je n’avais même pas conscience que je pouvais être embarrassé."
                                            },
                                            {
                                                "example_id": "d0da2388-829c-4743-a203-741510608c0c",
                                                "sense_id": "acb7fe94-e909-338d-8f17-6d532827775b",
                                                "text": "Entrés dans la campagne, notre embarras commença."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "237dbed8-5fd9-36f9-af96-878d34a6805c",
                                        "entry_id": "c213aea2-9e4b-3994-8bf4-3f5d1d3e883d",
                                        "glosses": [
                                            "Commencement d’obstruction, et surtout d’une accumulation de matières dans l’estomac ou dans les intestins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c171db5a-6788-4a43-9f80-a50b76d0da5b",
                                                "sense_id": "237dbed8-5fd9-36f9-af96-878d34a6805c",
                                                "text": "Il y a un peu d’embarras. Embarras gastrique. Embarras intestinal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb3c8853-4943-3b68-906d-09fba7376f41",
                                        "entry_id": "c213aea2-9e4b-3994-8bf4-3f5d1d3e883d",
                                        "glosses": [
                                            "Prétention, affectation, attitude de faiseur."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "804ec5e4-a86e-4ca3-8e21-8e9ddaae1176",
                                                "sense_id": "eb3c8853-4943-3b68-906d-09fba7376f41",
                                                "text": "Faire de l’embarras, des embarras, ses embarras : se donner de grands airs, ou afficher des prétentions ridicules, quand on voit le résultat."
                                            },
                                            {
                                                "example_id": "c399e3df-5e17-41b0-b781-3a26c4d82056",
                                                "sense_id": "eb3c8853-4943-3b68-906d-09fba7376f41",
                                                "text": "Cet homme fait bien de l’embarras, bien des embarras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e380ec09-cfc0-300f-b22f-94e732400c68",
                                        "entry_id": "c213aea2-9e4b-3994-8bf4-3f5d1d3e883d",
                                        "glosses": [
                                            "Confusion de plusieurs choses difficiles à débrouiller."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4c389b8-15e8-4e1f-bd74-236c25d878a7",
                                                "sense_id": "e380ec09-cfc0-300f-b22f-94e732400c68",
                                                "text": "Il y a de l’embarras dans ce procès, dans cette succession. Il y a de l’embarras dans ses affaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf779986-10b9-322e-be58-13581a7dbb6d",
                                        "entry_id": "c213aea2-9e4b-3994-8bf4-3f5d1d3e883d",
                                        "glosses": [
                                            "Manque d’argent, pénurie."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da6a402c-173f-4b20-a174-0179e903b3c2",
                                                "sense_id": "bf779986-10b9-322e-be58-13581a7dbb6d",
                                                "text": "[…] de grands embarras financiers avaient conduit le gouvernement à signer avec des compagnies de chemin de fer des conventions que les radicaux avaient dénoncées comme étant des actes de brigandage […]"
                                            },
                                            {
                                                "example_id": "b0d59887-f02a-49c1-b745-3dfb15045145",
                                                "sense_id": "bf779986-10b9-322e-be58-13581a7dbb6d",
                                                "text": "Le départ des juifs n’avait pas supprimé les embarras financiers de leurs clients et ceux qui avaient besoin de capitaux n’eurent d’autre ressource que de s’adresser aux prêteurs chrétiens (lombards ou cahorsins)."
                                            },
                                            {
                                                "example_id": "8777462e-2ec7-41d7-8069-d95e9cdecb27",
                                                "sense_id": "bf779986-10b9-322e-be58-13581a7dbb6d",
                                                "text": "Les bijoux plus sérieux, déposés, eux, dans un coffre-fort de banque, furent vendus par moi un jour d’embarras de trésorerie […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e94768c8-3297-3016-b33c-ba1019b37a59",
                                        "entry_id": "c213aea2-9e4b-3994-8bf4-3f5d1d3e883d",
                                        "glosses": [
                                            "Irrésolution dans laquelle on se trouve lorsqu’on ne sait quel parti prendre, ni par quelle voie se tirer de quelque pas difficile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de3a9b93-6891-4b12-af3b-7e82bcbc8a28",
                                                "sense_id": "e94768c8-3297-3016-b33c-ba1019b37a59",
                                                "text": "Je me suis vu dans un étrange embarras."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39100859-d6c5-3329-8c97-e4922a4ff7ad",
                                        "entry_id": "c213aea2-9e4b-3994-8bf4-3f5d1d3e883d",
                                        "glosses": [
                                            "Gêne, malaise que cause la nécessité d’agir ou de parler, lorsqu’on ne sait que faire ni que dire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb727228-f6f2-499c-8e83-040166d2bd6f",
                                                "sense_id": "39100859-d6c5-3329-8c97-e4922a4ff7ad",
                                                "text": "Il ne pouvait cacher son embarras. Tout le monde s’aperçut de son embarras. Tout trahit son embarras."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "embarras",
                                "target_lang_code": "fr",
                                "target_senses": [
