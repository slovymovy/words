                                        "sense_id": "f2ec9981-9dcb-3680-9848-ad7fc6f588e2",
                                        "entry_id": "1e931ae9-97d0-3cc0-b932-520a3491a0a0",
                                        "glosses": [
                                            "kleineres Einzelhandelsgeschäft; Räumlichkeiten, in denen Waren zum Verkauf angeboten und verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c8c151c-3d6c-459d-8401-caf74a625c5e",
                                                "sense_id": "f2ec9981-9dcb-3680-9848-ad7fc6f588e2",
                                                "text": "Geh in den Shop und kaufe drei Brötchen und eine Packung Milch."
                                            },
                                            {
                                                "example_id": "5da171bd-9966-4b06-9a5b-2c440e684b8c",
                                                "sense_id": "f2ec9981-9dcb-3680-9848-ad7fc6f588e2",
                                                "text": "In diesem Shop gibt es auch Zeitungen."
                                            }
