                ],
                "senses": [
                    {
                        "sense_id": "d8859593-c6a2-30e8-be61-412c14e22a28",
                        "entry_id": "72484971-edee-313c-8020-4978abab7145",
                        "glosses": [
                            "mit Blech bedeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f1469f-154d-4e90-a284-024714b59177",
                                "sense_id": "d8859593-c6a2-30e8-be61-412c14e22a28",
                                "text": "„Zwei junge Männer, wie Börsenmakler in glänzende Anzüge gekleidet, steigen aus und gehen zu einem alten Mann, der an einem kleinen, blechverkleideten und mit zwei überkreuzten Briefen geschmückten Schreibpult sitzt.“"
                            },
                            {
                                "example_id": "17824cbf-e5f6-488c-96e8-8ea9f0fada4d",
                                "sense_id": "d8859593-c6a2-30e8-be61-412c14e22a28",
                                "text": "„Ansonsten war der Raum leer; ein blechverkleideter Kamin aus weißem Marmor, altes lackiertes Täfelholz, eine Rokokodecke mit Hochrelief aus Stuckschnörkeln und perlschnurförmigen Tropfen, beides bronziert; dazwischen die Gasdüse, wo nun eine Glühlampe brannte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
