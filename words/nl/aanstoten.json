    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c3d8a60-715b-3e28-a0c4-5bcfcf0f9b24",
                    "sense_definition": "iemand met de elleboog of hand even aantikken om de aandacht te trekken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>stootte</w> zijn vriend <w>aan</w> toen hij de leraar zag binnenkomen.",
                            "target_lang_translations": {
                                "fr": "Il a <w>donné un coup de coude à</w> son ami quand il a vu entrer le professeur."
                            }
                        },
                        {
                            "text": "Ze bleven maar giechelen en elkaar <w>aanstoten</w> tijdens de saaie presentatie.",
                            "target_lang_translations": {
                                "fr": "Ils n'arrêtaient pas de ricaner et de <w>se donner des coups de coude</w> pendant l'ennuyeuse présentation."
                            }
                        }
                    ],
                    "common_phrases": [
                        "elkaar aanstoten",
                        "iemand discreet aanstoten"
                    ],
                    "target_lang_definitions": {
                        "fr": "Toucher légèrement quelqu'un de la main ou du coude pour attirer son attention"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "donner un coup de coude",
                                "target_lang_sense_clarification": "pour attirer l'attention"
                            },
                            {
                                "target_lang_word": "pousser du coude",
                                "target_lang_sense_clarification": "pour signaler quelque chose discrètement"
                            },
                            {
                                "target_lang_word": "toucher",
                                "target_lang_sense_clarification": "légèrement pour interpeller"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e613366-cc9e-352e-b53d-680056b248b0",
                    "sense_definition": "per ongeluk tegen iets of iemand botsen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het donker <w>stootte</w> hij per ongeluk tegen de salontafel <w>aan</w>.",
                            "target_lang_translations": {
                                "fr": "Dans le noir, il <w>s'est heurté</w> accidentellement contre la table basse."
                            }
                        },
                        {
                            "text": "Ze rende gehaast door het smalle gangpad en bleef voorbijgangers <w>aanstoten</w>.",
                            "target_lang_translations": {
                                "fr": "Elle courait précipitamment dans l'allée étroite et ne cessait de <w>bousculer</w> les passants."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ergens tegen aanstoten"
                    ],
                    "target_lang_definitions": {
                        "fr": "Heurter ou cogner accidentellement quelque chose ou quelqu'un"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "heurter",
                                "target_lang_sense_clarification": "cogner involontairement"
                            },
                            {
                                "target_lang_word": "se cogner contre",
                                "target_lang_sense_clarification": "entrer en collision avec"
                            },
                            {
                                "target_lang_word": "bousculer",
                                "target_lang_sense_clarification": "toucher quelqu'un au passage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9dc60ce-2e94-323a-a37c-c46ae121d663",
                    "sense_definition": "de glazen tegen elkaar tikken bij het uitbrengen van een toost",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laten we even met onze glazen <w>aanstoten</w> op het goede nieuws!",
                            "target_lang_translations": {
                                "fr": "Levons nos verres et <w>trinquons</w> à la bonne nouvelle !"
                            }
                        },
                        {
                            "text": "Zij <w>stoten</w> vrolijk <w>aan</w> om de verjaardag van hun vader te vieren.",
                            "target_lang_translations": {
                                "fr": "Ils <w>trinquent</w> joyeusement pour fêter l'anniversaire de leur père."
                            }
                        }
                    ],
                    "synonyms": [
                        "klinken",
                        "proosten"
                    ],
                    "common_phrases": [
                        "met glazen aanstoten"
                    ],
                    "target_lang_definitions": {
