                                "example_id": "9b13821f-91f1-4e91-9593-95e1ab860a83",
                                "sense_id": "28150864-03cd-35a6-b689-c67dee99e49b",
                                "text": "La compartimentation d'un projet."
                            },
                            {
                                "example_id": "2f347aa4-6544-404e-b6de-9142e47bcc2c",
                                "sense_id": "28150864-03cd-35a6-b689-c67dee99e49b",
                                "text": "Toutefois, la compartimentation des compétences au sein des différents corps de métiers rend difficile la propagation des techniques éprouvées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "610acdf1-0398-4cd7-aef7-0af15c16ef02",
                        "source_entry_id": "31bb54d8-7a0a-3bd5-8b52-eca2b81b3f6f",
