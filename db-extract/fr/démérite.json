                "forms": [
                    {
                        "form_id": "eb222298-94bd-41f5-9946-e3c7bec51969",
                        "entry_id": "de14927d-a825-3a06-8e56-40463078e6a2",
                        "tags": [
                            "plural"
                        ],
                        "form": "démérites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d02623c4-912c-3e6a-a87a-0ede1e935061",
                        "entry_id": "de14927d-a825-3a06-8e56-40463078e6a2",
                        "glosses": [
                            "Ce qui peut attirer l’improbation, ce qui peut vous faire perdre la bienveillance, l’estime d’autrui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ae8300-dd64-4732-ae29-40a0a105f9c2",
                                "sense_id": "d02623c4-912c-3e6a-a87a-0ede1e935061",
                                "text": "Où est le démérite de cette action ?"
                            },
                            {
                                "example_id": "0c71beca-3b87-4ac4-9a9b-bfec36cbbfa6",
                                "sense_id": "d02623c4-912c-3e6a-a87a-0ede1e935061",
                                "text": "On m’en a fait un démérite auprès de vous."
                            },
                            {
                                "example_id": "a1b9d9ec-5424-408f-b03a-a1604e848184",
                                "sense_id": "d02623c4-912c-3e6a-a87a-0ede1e935061",
                                "text": "D’autres estiment que l’acte augmente le démérite en raison du mépris, lequel augmente nécessairement si l’on réalise son vouloir interne."
                            },
                            {
                                "example_id": "d1b45b65-35fe-4ebf-83b6-132f528c31e8",
                                "sense_id": "d02623c4-912c-3e6a-a87a-0ede1e935061",
                                "text": "Je les soupçonne de s’adonner un peu, à leurs moments perdus, au négoce si profitable qui enrichit vers la même époque la Mrs. Warren de Bernard Shaw, et d’avoir comme leur émule anglaise raisonné avec bon sens des mérites et des démérites du métier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d27a177e-1474-4507-a147-738abb8fa404",
                        "source_entry_id": "de14927d-a825-3a06-8e56-40463078e6a2",
                        "source_sense_id": "d02623c4-912c-3e6a-a87a-0ede1e935061",
