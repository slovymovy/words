    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ca4b09ff-0f06-371f-a633-b6f65681738c",
                    "sense_definition": "In strijd met de wet; niet door de wet toegestaan.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "illegaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het downloaden van die films via die website is <w>onwettig</w>.",
                            "target_lang_translations": {
                                "en": "Downloading those movies via that website is <w>illegal</w>."
                            }
                        },
                        {
                            "text": "De politie greep in omdat de demonstranten een <w>onwettige</w> handeling pleegden.",
                            "target_lang_translations": {
                                "en": "The police intervened because the protesters committed an <w>unlawful</w> act."
                            }
                        }
                    ],
                    "synonyms": [
                        "illegaal",
                        "onrechtmatig",
                        "wetsovertredend"
                    ],
                    "antonyms": [
                        "wettig",
                        "legaal",
                        "rechtmatig"
                    ],
                    "common_phrases": [
                        "onwettige handeling",
                        "onwettig verklaard"
                    ],
                    "target_lang_definitions": {
                        "en": "Contrary to the law; not permitted by law."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "illegal",
                                "target_lang_sense_clarification": "contrary to or forbidden by law"
                            },
                            {
                                "target_lang_word": "unlawful",
                                "target_lang_sense_clarification": "not authorized by law; illicit"
                            },
                            {
                                "target_lang_word": "illegitimate",
                                "target_lang_sense_clarification": "not authorized by law; invalid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "980539ee-0254-3790-a17f-a9aa222b518c",
                    "sense_definition": "Geboren buiten een wettelijk huwelijk.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "afstamming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning had een <w>onwettig</w> kind dat geen recht had op de troon.",
                            "target_lang_translations": {
                                "en": "The king had an <w>illegitimate</w> child who had no right to the throne."
                            }
                        },
                        {
                            "text": "In de negentiende eeuw was de maatschappelijke positie van een <w>onwettig</w> kind erg moeilijk.",
                            "target_lang_translations": {
                                "en": "In the nineteenth century, the social position of an <w>illegitimate</w> child was very difficult."
                            }
                        }
                    ],
                    "synonyms": [
                        "buitenechtelijk",
                        "onwettig-geboren"
                    ],
                    "antonyms": [
                        "wettig",
                        "echtelijk"
                    ],
                    "common_phrases": [
                        "onwettig kind"
                    ],
                    "target_lang_definitions": {
                        "en": "Born outside of a legal marriage."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "illegitimate",
                                "target_lang_sense_clarification": "born of parents not lawfully married to each other"
                            },
                            {
                                "target_lang_word": "out of wedlock",
                                "target_lang_sense_clarification": "born to unmarried parents"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}