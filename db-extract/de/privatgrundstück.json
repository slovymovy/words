                                "sense_id": "bd50bcd2-de10-3f28-86ef-176cc906242f",
                                "text": "„Denn ohne Ölabscheider darf eine Autowäsche auch auf Privatgrundstücken aus Gründen des Umweltschutzes nicht durchgeführt werden.“"
                            },
                            {
                                "example_id": "86ada6dc-20d6-4529-8860-2a07a65d79d7",
                                "sense_id": "bd50bcd2-de10-3f28-86ef-176cc906242f",
                                "text": "Sie dürfen hier nicht parken, das ist ein Privatgrundstück!"
                            }
                        ],
                        "sense_index_json": "\"1\""
