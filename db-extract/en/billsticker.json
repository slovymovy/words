                                        "sense_id": "b7839ef5-5986-3ccc-ab14-74865a58ccd9",
                                        "entry_id": "d3c79fce-8711-30ae-bf7f-acdd70711d7c",
                                        "glosses": [
                                            "Celui qui appose des affiches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8074cb4d-55a3-4b31-ade1-b496424e25db",
                                                "sense_id": "b7839ef5-5986-3ccc-ab14-74865a58ccd9",
                                                "text": "Il attendait, impatient, derrière l’afficheur, qui, avec son gros pinceau, barbouillait le dos de l'affiche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "563c59e0-4d64-367d-bf55-c08f0cff1f42",
                                        "entry_id": "d3c79fce-8711-30ae-bf7f-acdd70711d7c",
                                        "glosses": [
                                            "Dispositif comportant des emplacements où l’on peut représenter des chiffres ou des lettres, sur un appareil, un réveil, un tableau etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b27526d-4a93-4933-acc8-5ea99b230a49",
                                                "sense_id": "563c59e0-4d64-367d-bf55-c08f0cff1f42",
                                                "text": "Smartphones, ordinateurs et tablettes sont passés à l’heure d’hiver automatiquement mais ce n’est pas forcément le cas de votre montre, de l’horloge de mamie ou de l’afficheur du four ou de la voiture."
                                            },
                                            {
                                                "example_id": "f63ba0e9-dcab-41ff-a34b-784c015adacd",
                                                "sense_id": "563c59e0-4d64-367d-bf55-c08f0cff1f42",
                                                "text": "Quand Maeva, étudiante de 22 ans manie le pistolet de distribution d’essence, c’est avec précaution. Un œil sur l’afficheur de prix, elle presse délicatement la poignée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
