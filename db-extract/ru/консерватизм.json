                ],
                "senses": [
                    {
                        "sense_id": "822df83b-78df-3fea-a87b-8febc3f46cf4",
                        "entry_id": "3b6f3a5b-0cb8-3a24-8b4e-02a24164b1cc",
                        "glosses": [
                            "книжн. приверженность ко всему старому, традиционному, консервативные убеждения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a72e930f-457b-45c7-ad61-bfa0740a7bc8",
                                "sense_id": "822df83b-78df-3fea-a87b-8febc3f46cf4",
                                "text": "При этом игнорируются упоминавшийся выше крайний идейный консерватизм РПЦ, характерная для многих её архипастырей любовь к земным благам, а также хорошо заметный антисемитизм, который, как известно, является одним из основных симптомов фашизма."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21f53049-aa57-4b24-ba26-e535d9f14745",
                        "source_entry_id": "3b6f3a5b-0cb8-3a24-8b4e-02a24164b1cc",
                        "source_sense_id": "822df83b-78df-3fea-a87b-8febc3f46cf4",
                        "target_lang_word": "conservatism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conservatism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5b66642-60b4-3617-be55-f406df777690",
                                        "entry_id": "0de67931-50bb-3916-844f-6b93b3e3b917",
                                        "glosses": [
                                            "A political philosophy that advocates traditional values."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2afa1f02-932d-47e2-ad9b-749893444fbd",
                                                "sense_id": "e5b66642-60b4-3617-be55-f406df777690",
                                                "text": "Oddly, with the liberals and radicals in power in NSW, the conservatives realized that a nominated upper house was no longer a bastion of conservatism and some began to call for an elected legislative council."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99bed43a-8441-3782-8716-ffb4b208e00c",
                                        "entry_id": "0de67931-50bb-3916-844f-6b93b3e3b917",
                                        "glosses": [
                                            "A risk-averse attitude or approach."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
