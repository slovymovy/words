                "senses": [
                    {
                        "sense_id": "90f59405-cc49-36b6-bd62-f3633a9af986",
                        "entry_id": "ff10aa79-877f-3b5d-a828-2cad942a0bc7",
                        "glosses": [
                            "Donner un caractère rappelant l’émission de télévision Secret Story à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fd28b57-ec19-4c8a-9068-3930d0710d1e",
                                "sense_id": "90f59405-cc49-36b6-bd62-f3633a9af986",
                                "text": "La prod’ a donc songé à se secretstoryser en faisant appel aux passés douloureux des candidats mais a finalement assez vite abandonné l’idée, par pudeur certainement."
                            },
                            {
                                "example_id": "670e69b2-e2b9-43dd-a99b-56415aea51f1",
                                "sense_id": "90f59405-cc49-36b6-bd62-f3633a9af986",
                                "text": "Alors pourquoi te loftstoryser, te secretstoryser ou te Parishiltoniser…"
                            },
                            {
                                "example_id": "b9063d6f-694b-4111-9b49-f0e89f1d0ad0",
                                "sense_id": "90f59405-cc49-36b6-bd62-f3633a9af986",
                                "text": "Sur ce, je retourne prendre ma place dans le troupeau comme un gentil petit mouton (parce que apparemment c'est ce que je suis) pour me secretstoryser la tête."
                            }
                        ]
                    }
