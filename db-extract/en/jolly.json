                    {
                        "sense_id": "6548ad71-972a-376e-a619-127a15d2d114",
                        "entry_id": "a14582c3-fd80-3b2e-b24f-e2d59d2c2f05",
                        "glosses": [
                            "To praise or talk up."
                        ],
                        "tags": [
                            "archaic",
