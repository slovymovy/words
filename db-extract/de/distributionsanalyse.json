                "senses": [
                    {
                        "sense_id": "5ceb95bd-4f42-3666-bdc3-c7914f0af726",
                        "entry_id": "4fb17750-68fe-38c4-9304-fbd7b0827f3f",
                        "glosses": [
                            "Untersuchung der Distribution sprachlicher Ausdrücke, also ihres Vorkommens in gleichen oder unterschiedlichen sprachlichen Umgebungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8d3d3c6-4314-4d36-9d72-a7c57e31d235",
                                "sense_id": "5ceb95bd-4f42-3666-bdc3-c7914f0af726",
                                "text": "Die Distributionsanalyse ist ein Verfahren der strukturalistischen Linguistik, besonders des Distributionalismus."
                            },
                            {
                                "example_id": "c4475f0a-ce35-4ac3-a5f5-f12b3f3192b9",
                                "sense_id": "5ceb95bd-4f42-3666-bdc3-c7914f0af726",
                                "text": "Die Distributionsanalyse zeigt, welche sprachlichen Einheiten man gegeneinander in gleicher sprachlicher Umgebung austauschen kann und welche nicht."
                            },
                            {
                                "example_id": "ef110428-58df-4dc8-8d29-a285fe406d13",
                                "sense_id": "5ceb95bd-4f42-3666-bdc3-c7914f0af726",
                                "text": "„Mit der Distributionsanalyse ermittelt man die syntagmatischen Beziehungen, d. h. die Verbindbarkeit (auf der Ebene der Langue) und die Verbindung (auf der Ebene der Parole) des zu untersuchenden Elements mit anderen Elementen in der Redekette.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
