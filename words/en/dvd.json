                {
                    "sense_id": "d22260dd-a693-3dfc-926e-1c33a34b7730",
                    "sense_definition": "A type of eye misalignment where one eye drifts upward, often seen in patients with strabismus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical conditions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ophthalmologist noted that the patient exhibited <w>DVD</w> during the clinical examination.",
                            "target_lang_translations": {
