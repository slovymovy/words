                        "cross_references": [
                            {
                                "target_word": "камео",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ca9dae08-b5f3-379b-a978-6a780deaaa24",
                                        "entry_id": "c9cbdb67-04b6-3b91-91ed-215af16ea942",
                                        "glosses": [
                                            "кино эпизодическая роль в фильме, сыгранная известным актёром, спортсменом, политиком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2ce6bbe-99f8-41b2-b376-83b7c123702e",
                                                "sense_id": "ca9dae08-b5f3-379b-a978-6a780deaaa24",
                                                "text": "Камео … ― это эпизодическая роль в кино какой-либо знаменитости. Помните, в фильме «Москва слезам не верит» в сцене у кинотеатра Смоктуновский и Юматов изображают себя в юности? Так вот это и есть камео. А в 1993 году Вим Вендерс в фильме «Так далеко, так близко» использовал камео с Михаилом Горбачёвым."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c5a0970-0ce7-3e06-9c8e-a57066e4a2ae",
                                        "entry_id": "c9cbdb67-04b6-3b91-91ed-215af16ea942",
                                        "glosses": [
                                            "спец. название породы кошек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29072018-2412-40e3-b6a9-6f4a966581f3",
                                                "sense_id": "3c5a0970-0ce7-3e06-9c8e-a57066e4a2ae",
                                                "text": "Персидская камео — элегантная кошка с шелковистой, мягкой шерстью. Очень похожа на шиншиллу. Выведена сравнительно недавно — в конце 50-х годов XX столетия — путём скрещивания серебристых, красных и кремовых персидских кошек. Вскоре удалось достичь целой гаммы цветов: появились камео красно-дымчатые, серебристые, серебристо-теневые, голубо-кремовые и черепаховые, пользующиеся заслуженным успехом на выставках."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
