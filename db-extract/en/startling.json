                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3efe023d-b9fb-4822-b396-3dd7d685dcb8",
                                                "sense_id": "d7b12852-e821-3138-98a3-a2a8c365d1f1",
                                                "text": "Die weltweite Tendenz für Kriege ist alarmierend."
                                            },
                                            {
                                                "example_id": "c1a13f4b-6be2-4eaf-888a-95319e82db65",
                                                "sense_id": "d7b12852-e821-3138-98a3-a2a8c365d1f1",
                                                "text": "Hungersnöte und Dürren sind alarmierend."
                                            },
                                            {
                                                "example_id": "34e10482-8993-45a9-b8ea-90a0cbd5548b",
                                                "sense_id": "d7b12852-e821-3138-98a3-a2a8c365d1f1",
                                                "text": "Wenn eine Hurrikan-Warnung herausgegeben wird, ist das alarmierend."
                                            },
                                            {
                                                "example_id": "9447bb38-538b-4d73-b4a6-7dfe76095fc7",
                                                "sense_id": "d7b12852-e821-3138-98a3-a2a8c365d1f1",
                                                "text": "Das Schmelzen der Pole, in der Folge der Anstieg des Meeresspiegels sowie die Klimaerwärmung; all dies ist alarmierend."
                                            },
                                            {
                                                "example_id": "834dcbfe-4e03-4450-a0fc-0cd272493504",
                                                "sense_id": "d7b12852-e821-3138-98a3-a2a8c365d1f1",
                                                "text": "„Die Prognosen des neuen Weltklimaberichts der UNO sind alarmierend: Die Menschheit muss sich in den nächsten Jahrzehnten verstärkt auf steigende Meeresspiegel, gigantische Überschwemmungen, extreme Dürre und Wirbelstürme einstellen.“"
                                            },
                                            {
                                                "example_id": "6f903a70-9761-454e-844e-81d3163acb6b",
                                                "sense_id": "d7b12852-e821-3138-98a3-a2a8c365d1f1",
                                                "text": "„Nachdem er öffentlich über alarmierende Krebsraten gesprochen hatte, wurde der Nuklearmediziner 1999 verhaftet und sechs Jahre später ins Exil abgeschoben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
