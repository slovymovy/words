                        ],
                        "examples": [
                            {
                                "example_id": "580e0bc4-81cf-4303-9cc2-c7e4ec806e23",
                                "sense_id": "b6c0771e-0e14-3272-a127-e471b567350b",
                                "text": "Bring the rathe primrose that forsaken dies."
                            },
                            {
                                "example_id": "ecc6074a-f8d2-4847-a889-c3faf8702267",
                                "sense_id": "b6c0771e-0e14-3272-a127-e471b567350b",
                                "text": "Thy converse drew us with delight,\nThe men of rathe and riper years:\nThe feeble soul, a haunt of fears,\nForgot his weakness in thy sight."
                            }
                        ]
                    }
