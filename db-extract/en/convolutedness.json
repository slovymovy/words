                "senses": [
                    {
                        "sense_id": "a238b5d2-8ab7-3fa1-90e4-7d3c182cdc14",
                        "entry_id": "1cf42c09-242a-3e34-a4dc-f768b68ed347",
                        "glosses": [
                            "The quality of being convoluted."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6732a15d-0cc0-44c6-b836-0486ce9d7057",
                                "sense_id": "a238b5d2-8ab7-3fa1-90e4-7d3c182cdc14",
                                "text": "Mr. D. J. Cunningham, of Dublin, in a communication addressed to our contemporary Nature, brings into evidence the theory of Zelgersina, who explains the convolutedness or otherwise of the brain on mechanical grounds."
                            },
                            {
                                "example_id": "983fe811-eab2-4d43-b038-d16044041d80",
                                "sense_id": "a238b5d2-8ab7-3fa1-90e4-7d3c182cdc14",
                                "text": "A classic way of measuring the degree of convolutedness of a brain has been to determine the exposed surface relative to the total surface of the cerebral cortex."
                            },
                            {
                                "example_id": "c18cd933-1a2c-4a6e-aadb-2b497d8dcf0e",
                                "sense_id": "a238b5d2-8ab7-3fa1-90e4-7d3c182cdc14",
                                "text": "Analysts of morality must retreat from their subject far enough to examine the reasons for its convolutedness."
                            }
                        ]
                    }
                ],
