                    },
                    {
                        "translation_id": "daab2c53-12b2-496b-a54f-24b57c7ef75a",
                        "source_entry_id": "bdfdd728-fd99-39ae-8275-7e88f83cad39",
                        "source_sense_id": "795c5bb9-64d0-3ba9-ae5f-5cfc6945afc4",
                        "source_sense_description": "tooth",
                        "target_lang_word": "prémolaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prémolaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59c80c69-8087-3332-a3cc-f1ff4fa938e1",
                                        "entry_id": "adb3c6e0-5e62-33e1-924b-1c4bb765ecd0",
                                        "glosses": [
                                            "Dent qui se situe entre les canines et les molaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8087f276-8953-4bc9-b4e1-361104ed9f5a",
                                                "sense_id": "59c80c69-8087-3332-a3cc-f1ff4fa938e1",
                                                "text": "Non, il n’y avait pas de doute permis, ici l’impact de la carnassière supérieure, la quatrième prémolaire droite, voyez, et ici, devant, la canine droite, voyez là, et ici, et dessous, ici."
                                            },
                                            {
                                                "example_id": "58a8da42-346c-41cc-8e9a-d6133b778504",
                                                "sense_id": "59c80c69-8087-3332-a3cc-f1ff4fa938e1",
                                                "text": "Le trou - sa bouche -, à l’intérieur duquel il manque une prémolaire inférieure, probablement une dent de lait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3a4739b-8b25-4ab5-9d62-194abcfa955d",
                        "source_entry_id": "bdfdd728-fd99-39ae-8275-7e88f83cad39",
                        "source_sense_id": "795c5bb9-64d0-3ba9-ae5f-5cfc6945afc4",
                        "source_sense_description": "tooth",
                        "target_lang_word": "Prämolar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prämolar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "363e9c3a-71ad-35ac-9fbd-3135fd77714e",
                                        "entry_id": "abb007b4-cb8e-32a7-bcf4-a040e0cfa7a4",
                                        "glosses": [
                                            "kleiner, zweihöckriger Backenzahn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdee8bbe-b03e-429e-b42b-78e7904f3e59",
                                                "sense_id": "363e9c3a-71ad-35ac-9fbd-3135fd77714e",
                                                "text": "Wiederkäuer haben drei Prämolaren."
                                            },
                                            {
                                                "example_id": "aa6a5008-8786-4077-bf6b-cadf3fe4c606",
                                                "sense_id": "363e9c3a-71ad-35ac-9fbd-3135fd77714e",
                                                "text": "„Während diese in ihren seitlichen bukkalen Becherwandteilen der Betrachtung frei offen stehen, sind die Zähne des Unterkiefers mit Ausnahme des Prämolars pr. 2⁴ nur in ihren basalen Teilstücken sichtbar.“"
                                            },
                                            {
                                                "example_id": "2ec18fe8-fce9-43b6-99ed-d4a8e063cd17",
                                                "sense_id": "363e9c3a-71ad-35ac-9fbd-3135fd77714e",
                                                "text": "„›Haben Sie die Leute draußen gesehen?‹, fragt Tenenboym, und der goldene Zahnstocher klickt gegen einen Prämolar.“"
                                            },
                                            {
                                                "example_id": "61045a57-2498-470d-a91b-8780914b9af5",
                                                "sense_id": "363e9c3a-71ad-35ac-9fbd-3135fd77714e",
                                                "text": "„Sie ist rudimentär auf dem Prämolar und letzten Molar, aber deutlich auf dem ersten Molar.“"
                                            },
                                            {
                                                "example_id": "3ca93150-5724-4d92-9873-35102c555de3",
                                                "sense_id": "363e9c3a-71ad-35ac-9fbd-3135fd77714e",
                                                "text": "„Wohl gemerkt, gilt dies nur für den Prämolar 2 der ersten Dentition!“"
                                            },
                                            {
                                                "example_id": "f147fd17-f2aa-4354-89b7-2d549c275b2f",
                                                "sense_id": "363e9c3a-71ad-35ac-9fbd-3135fd77714e",
                                                "text": "„In Figur 53 steht an Stelle des zweiten Prämolars links ein stumpfer Zapfenzahn, während er rechterseits gar nicht erschienen ist.“"
                                            },
                                            {
                                                "example_id": "858be3ad-b430-4353-8bc6-9eca04d8c4b1",
                                                "sense_id": "363e9c3a-71ad-35ac-9fbd-3135fd77714e",
                                                "text": "„Die Prämorale sitzen etwas tiefer und sind infolgedessen weniger abgekaut.“"
                                            },
                                            {
                                                "example_id": "06c35076-a098-422f-a7bf-f8bd51cffb5d",
                                                "sense_id": "363e9c3a-71ad-35ac-9fbd-3135fd77714e",
                                                "text": "„Schwieriger ist es, eine Schilderung der Prämorale zu geben.“"
                                            },
                                            {
                                                "example_id": "067b508f-3991-4e91-934f-21a9f0de06b9",
                                                "sense_id": "363e9c3a-71ad-35ac-9fbd-3135fd77714e",
                                                "text": "„Jetzt werden die ersten 3 Backenzähne (Milchzähne), die Prämolare 1, 2, 3, grundsätzlich gewechselt.“"
                                            },
                                            {
                                                "example_id": "0239df06-38c4-49d0-b4a9-5c47c74fc505",
                                                "sense_id": "363e9c3a-71ad-35ac-9fbd-3135fd77714e",
                                                "text": "„In Qafzeh waren die Prämolare der Schädel Qafzeh 3, 6, 8 stark usuriert, so daß detailliertere Beobachtungen nur bei Qafzeh 5–7 und besonders 9 durchgeführt werden konnten.“"
                                            },
                                            {
                                                "example_id": "3cbce4db-db7a-4381-9b36-0047080fa66e",
                                                "sense_id": "363e9c3a-71ad-35ac-9fbd-3135fd77714e",
                                                "text": "„Es musste dies deshalb erwähnt werden, da manche Autoren die Prämolare von rückwärts nach vorn zählen und unter ersten Prämolar jenen verstehen, welcher an die Reihe der echten Molaren stösst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
