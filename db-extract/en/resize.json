                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Größe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d185f7c-85dd-3e46-a3b5-af5dc605c871",
                                        "entry_id": "b85824a4-3c74-3f09-b66f-0353f466d422",
                                        "glosses": [
                                            "räumliche Ausdehnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e639007-c9a7-413c-ad0a-b6930740f239",
                                                "sense_id": "5d185f7c-85dd-3e46-a3b5-af5dc605c871",
                                                "text": "Das Paket hat eine Größe von 20 cm × 30 cm × 40 cm."
                                            },
                                            {
                                                "example_id": "b8c1ce24-947a-466b-a8d8-7dec03bbcae4",
                                                "sense_id": "5d185f7c-85dd-3e46-a3b5-af5dc605c871",
                                                "text": "„Gertrude war eine beeindruckende Gestalt, nicht nur wegen ihrer Größe und Leibesfülle, sondern auch wegen ihres strengen anthrazitfarbenen Kleids und des wettergegerbten Gesichts, das ständig zu einem Stirnrunzeln verzogen schien, selbst wenn sie lächelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d8daffce-da5c-3b17-b218-0432a64c40c3",
                                        "entry_id": "b85824a4-3c74-3f09-b66f-0353f466d422",
                                        "glosses": [
                                            "Person mit (gesellschaftlicher) Bedeutung"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4adff2d0-778e-449d-9285-ea1e642d9169",
                                                "sense_id": "d8daffce-da5c-3b17-b218-0432a64c40c3",
                                                "text": "Mozart war eine Größe unter den Komponisten."
                                            },
                                            {
                                                "example_id": "5bc0b1a2-e22a-4294-a4f1-bfb1421d8a29",
                                                "sense_id": "d8daffce-da5c-3b17-b218-0432a64c40c3",
                                                "text": "„Letztere wurden infolge der Unruhen in Karatschi Mitte der 1990er Jahre nach Absprachen mit den lokalen Größen hier angesiedelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7f3abfb5-bee4-3268-a65e-bfb4ed946c39",
                                        "entry_id": "b85824a4-3c74-3f09-b66f-0353f466d422",
                                        "glosses": [
                                            "alles, was sich durch Messung oder Schätzung miteinander in Beziehung setzen lässt"
                                        ],
                                        "tags": [
                                            "Naturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f452a3b2-11c6-4435-821d-8b5c1e021ba3",
                                                "sense_id": "7f3abfb5-bee4-3268-a65e-bfb4ed946c39",
                                                "text": "Der elektrische Strom ist eine Größe, man misst ihn in Ampere."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9e755204-9441-3ab0-80e1-20902bad9be7",
                                        "entry_id": "b85824a4-3c74-3f09-b66f-0353f466d422",
                                        "glosses": [
                                            "Konfektionsgröße"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fb241fd-fb40-443b-b2fc-19f54de9e9c9",
                                                "sense_id": "9e755204-9441-3ab0-80e1-20902bad9be7",
                                                "text": "„Das Kleid passt Ihnen nicht. Sie könnten es eine Größe kleiner probieren.“"
                                            },
                                            {
                                                "example_id": "b4452d0c-25c5-45c0-823c-47c1c514134a",
                                                "sense_id": "9e755204-9441-3ab0-80e1-20902bad9be7",
                                                "text": "Wir haben auch große Größen ab XXL."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "dd49f834-381a-3f89-8802-7adda3b4cd85",
                                        "entry_id": "b85824a4-3c74-3f09-b66f-0353f466d422",
                                        "glosses": [
                                            "Stärke der Moralempfindung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "596bf4ff-68f3-4411-95d0-54e63b6b7248",
                                                "sense_id": "dd49f834-381a-3f89-8802-7adda3b4cd85",
                                                "text": "Er hatte die Größe, die Wahrheit zu sagen."
                                            },
                                            {
                                                "example_id": "c783f55d-e4d3-4273-95cc-93b0f6dc3acc",
                                                "sense_id": "dd49f834-381a-3f89-8802-7adda3b4cd85",
                                                "text": "Er zeigte Größe und übernahm die Rechnung für den ganzen Tisch."
                                            }
