                ],
                "senses": [
                    {
                        "sense_id": "425c25b3-44ba-358b-8d6d-99af27e59c7c",
                        "entry_id": "fef30780-a003-389c-9721-48166ddde743",
                        "glosses": [
                            "Leine zum Starten eines Motors"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20c3a2f2-853e-461d-9c82-cbb002e1e85e",
                                "sense_id": "425c25b3-44ba-358b-8d6d-99af27e59c7c",
                                "text": "„Noch ehe sie sich setzen konnten, riß Mansfield schon an der Startleine.“"
                            },
                            {
                                "example_id": "1b59c139-f4e1-4a99-aaf0-29cbc29ad43f",
                                "sense_id": "425c25b3-44ba-358b-8d6d-99af27e59c7c",
                                "text": "„Olaf Jensen zieht die Startleine. Einmal, zweimal, dann knattert der Außenborder los und zerstört die Stille.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "64138068-1393-377d-b6ed-a3e0e27db1f0",
                        "entry_id": "fef30780-a003-389c-9721-48166ddde743",
                        "glosses": [
                            "Leine, mit der ein Flugzeug oder Sportgerät angeschleppt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6215cda6-5792-4e8b-9ccc-19055c09c732",
                                "sense_id": "64138068-1393-377d-b6ed-a3e0e27db1f0",
                                "text": "„Der Flugroboter mit einer Spannweite von zwei Metern wiegt sechs Kilo und wird mit Hilfe einer Startleine gestartet, wie bei klassischen Modellflugzeugen.“"
                            },
                            {
                                "example_id": "52c0016b-8f41-4903-8c67-f097a3ed3d80",
                                "sense_id": "64138068-1393-377d-b6ed-a3e0e27db1f0",
                                "text": "„Die Flugmodelle mit ca. 250 cm Spannweite, einem Mindestgewicht von 410 Gramm bei einem Gesamtflächeninhalt von 32–34 dm² werden mit einer 50 m langen Startleine auf Höhe gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "000fdd50-23a0-3c1e-bc53-707e07f719bf",
                        "entry_id": "fef30780-a003-389c-9721-48166ddde743",
                        "glosses": [
                            "Leine, mit der der Start eines Wettkampfs freigegeben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "912156ef-e256-4bb2-b597-e0ce810a8b26",
                                "sense_id": "000fdd50-23a0-3c1e-bc53-707e07f719bf",
                                "text": "„Friesenheims Bürgermeister Armin Roesner höchstpersönlich zog zusammen mit Abteilungskommandant Karl-Rainer Kopf die Startleine, um die gelben Schwimmenten auf ihre Reise in Richtung Offohalle zu schicken.“"
                            },
                            {
                                "example_id": "defb7ae5-2fc5-4043-9794-00e1ddc8aaf8",
                                "sense_id": "000fdd50-23a0-3c1e-bc53-707e07f719bf",
                                "text": "„Gleich hebt sich die Startleine und die jungen Fahrer der 125er-Klasse können davonbrausen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
