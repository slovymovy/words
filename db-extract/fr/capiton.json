        "fr-extract.jsonl": [
            {
                "entry_id": "e1487529-a1be-3cce-9a44-5b633b2754a7",
                "word": "capiton",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b2aba3ff-e8df-42cf-9760-8be6f98661da",
                        "entry_id": "e1487529-a1be-3cce-9a44-5b633b2754a7",
                        "tags": [
                            "plural"
                        ],
                        "form": "capitons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3325d019-b442-3234-a3f0-aeebc3169b08",
                        "entry_id": "e1487529-a1be-3cce-9a44-5b633b2754a7",
                        "glosses": [
                            "Soie grossière dont on se sert pour divers ouvrages. Bourre de soie."
                        ],
                        "tags": [
                            "Soierie"
                        ],
                        "examples": [
                            {
                                "example_id": "00222a16-f9c0-48f5-a173-d05ee6f56cb1",
                                "sense_id": "3325d019-b442-3234-a3f0-aeebc3169b08",
                                "text": "On ne voyait pas le bois de ces meubles ; le satin, le capiton couvraient tout."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d821bd7-2c01-3d28-a940-cc7e55414554",
                        "entry_id": "e1487529-a1be-3cce-9a44-5b633b2754a7",
                        "glosses": [
                            "Chacune des divisions formées par la piqûre sur la surface d’un tissu matelassé, notamment d’un matelas ou d’un siège rembourré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ac61c2-52a8-4a74-b51a-6b69cd60c2bd",
                                "sense_id": "8d821bd7-2c01-3d28-a940-cc7e55414554",
                                "text": "Quelques tableaux entre glaces, d’assez libres allures, s’accrochaient aux capitons des murailles."
                            },
                            {
                                "example_id": "b4ee8131-d48a-4203-bdff-86bd8affddb2",
                                "sense_id": "8d821bd7-2c01-3d28-a940-cc7e55414554",
                                "text": "Dans ce décor qui lui convenait si bien je revois un petit homme assis dans un grand fauteuil à capitons, la face levée vers moi, mais le regard dirigé vers ses livres, mon oncle."
                            },
                            {
                                "example_id": "7b962c73-dd65-4c72-8ac8-9a8ca374c044",
                                "sense_id": "8d821bd7-2c01-3d28-a940-cc7e55414554",
                                "text": "Malgré l'entrevue avec maître Dibon où nous fûmes accueillis par une débauche de capiton qui épaississait la porte, les murs, les fauteuils et le notaire lui-même, boudiné de partout, gonflé de silence et trouvant moyen, un œil sur ma mère, un œil sur la poitrine de Salomé, de m'observer quand même sans cesser de se gratter un genou et de réfléchir à l'évolution imprévue des familles…"
                            },
                            {
                                "example_id": "c7ff62ff-ef5d-44d7-91c0-f3897e9d9f53",
                                "sense_id": "8d821bd7-2c01-3d28-a940-cc7e55414554",
                                "text": "Il songea qu’il y avait un rapport mystérieux entre l’imperceptible mollissement des angles, l’affaissement des capitons, la décoloration des tentures et sa propre fatigue."
                            },
                            {
                                "example_id": "3ef229a0-f899-4440-8bc8-07b0c4305736",
                                "sense_id": "8d821bd7-2c01-3d28-a940-cc7e55414554",
                                "text": "Les capitons étaient rudimentaires, fils de coton tirés à travers l'épaisseur, bloqués des deux côtés par des pompons de laine."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba703471-86ed-3576-844c-cbbbe99cd192",
                        "entry_id": "e1487529-a1be-3cce-9a44-5b633b2754a7",
                        "glosses": [
                            "Cellulite, par association avec l’aspect d’un matelas capitonné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a237a27c-9d2a-49f8-aef2-19aad14767c6",
                                "sense_id": "ba703471-86ed-3576-844c-cbbbe99cd192",
                                "text": "Il était une fois la cellulite : des capitons et des femmes"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
