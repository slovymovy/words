                "senses": [
                    {
                        "sense_id": "63331167-e9f4-347c-8b08-37f1ca9010b8",
                        "entry_id": "7fd8db02-37bc-374e-90fc-01c911589956",
                        "glosses": [
                            "Médire, dire du mal des autres, se comporter en langue de pute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61ddb51d-3131-484c-b454-f2e3e1acdfed",
                                "sense_id": "63331167-e9f4-347c-8b08-37f1ca9010b8",
                                "text": "Public bobo, branché, fashion, certes (je suis mal placée pour me moquer malgré mon besoin chronique de langue-de-puter), mais motivé par les concerts."
                            },
                            {
                                "example_id": "8ff09d41-2485-4b87-9dcd-17dad3d247ff",
                                "sense_id": "63331167-e9f4-347c-8b08-37f1ca9010b8",
                                "text": "Cher Père Noël, Apporte moi un amoureux. Afin que l'on puisse langue-de-puter ensemble pour l'éternité"
                            },
                            {
                                "example_id": "85ad9cad-37d2-436b-838e-39e9f86e7b68",
                                "sense_id": "63331167-e9f4-347c-8b08-37f1ca9010b8",
                                "text": "On peut s'endormir devant ses collègues, langue-de-puter sur le boulot, se plaindre de sa femme, ne plus marcher droit : tout est permis."
                            }
                        ]
                    }
                ],
