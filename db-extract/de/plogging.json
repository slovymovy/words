                            {
                                "example_id": "3c98bbdc-2d64-4d43-9133-ed9572a24877",
                                "sense_id": "b73d83fc-4937-30c6-aac4-7f7f9c945c82",
                                "text": "„Plogging ist nicht direkt ein von einer Organisation ins Leben gerufenes Projekt, sondern ein Trend der ursprünglich aus Schweden kommt.“"
                            },
                            {
                                "example_id": "6909a534-b268-47fd-b507-8437f34cc2f6",
                                "sense_id": "b73d83fc-4937-30c6-aac4-7f7f9c945c82",
                                "text": "„Zum sogenannten Plogging riefen in April und Mai unter anderem die Uni Magdeburg, der Freiwilligentag in Halle, SPD-Politiker Karamba Diaby und Grünen-Politikerin Steffi Lemke auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
