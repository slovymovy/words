                        "sense_id": "121ade6c-1df5-3b7d-aed3-9f06d20aee15",
                        "entry_id": "c2519e3e-bb63-3d65-b2d9-294d685ba2e1",
                        "glosses": [
                            "autumn freak, autumn-head (a woman obsessed with autumn)"
                        ],
                        "tags": [
                            "colloquial",
                            "feminine",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "b5043649-5ac2-4c87-84e7-27165b396c27",
                                "sense_id": "121ade6c-1df5-3b7d-aed3-9f06d20aee15",
                                "text": "Ta jesieniara z rogu nigdy nie odłoży jej kawy.",
                                "translation": "That autumn freak in the corner will never set her coffee aside.",
                                "english": "That autumn freak in the corner will never set her coffee aside."
                            },
                            {
                                "example_id": "5dd4adc9-e6fa-4d17-aa14-070c74137854",
                                "sense_id": "121ade6c-1df5-3b7d-aed3-9f06d20aee15",
                                "text": "Na przekór wszystkim jesieniarom świata, Zosia postanowiła porzucić panoszące się po ulicach brązy i szarości na rzecz odważnego błękitu.",
                                "translation": "In defiance of all autumn-heads of the world, Zosia has resolved to throw the brown and grey clothes dominating the streets aside in favor of a serious azure color.",
                                "english": "In defiance of all autumn-heads of the world, Zosia has resolved to throw the brown and grey clothes dominating the streets aside in favor of a serious azure color."
                            }
                        ]
                    }
