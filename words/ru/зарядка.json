                {
                    "sense_id": "43b9fe2f-f954-30aa-914e-268d0f2e3fd8",
                    "sense_definition": "Комплекс физических упражнений, выполняемых обычно по утрам для разминки и укрепления здоровья.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каждое утро я делаю <w>зарядку</w> под музыку.",
                            "target_lang_translations": {
                                "en": "Every morning I do <w>exercises</w> to music.",
                                "nl": "Elke ochtend doe ik <w>ochtendgymnastiek</w> op muziek."
                            }
                        },
                        {
                            "text": "Лёгкая <w>зарядка</w> помогает быстрее проснуться и чувствовать себя бодрым.",
                            "target_lang_translations": {
                                "en": "Light <w>exercise</w> helps you wake up faster and feel energized.",
                                "nl": "Lichte <w>gymnastiek</w> helpt je sneller wakker te worden en je energiek te voelen."
                            }
                        }
                    ],
                    "synonyms": [
                        "гимнастика",
                        "физзарядка"
                    ],
                    "common_phrases": [
                        "утренняя зарядка",
                        "делать зарядку"
                    ],
                    "target_lang_definitions": {
                        "en": "A set of physical exercises performed to warm up, usually in the morning.",
                        "nl": "Een reeks fysieke oefeningen, meestal 's ochtends uitgevoerd om op te warmen en fit te blijven."
                    },
                    "translations": {
                        "en": [
                            {
