{
    "word_family": [
        "billen",
        "billetje",
        "bilspier",
        "bilnaad"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e4ef9c0-788c-38d6-9b6c-232601ac113c",
                    "sense_definition": "elk van beide vlezige delen van het menselijk lichaam waarop men zit",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lichaamsdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind viel hard op zijn <w>bil</w> tijdens het spelen in de tuin.",
                            "target_lang_translations": {
                                "en": "The child fell hard on his <w>buttock</w> while playing in the garden."
                            }
                        },
                        {
                            "text": "Ze ging met haar <w>billen</w> in het zachte mos zitten om uit te rusten.",
                            "target_lang_translations": {
                                "en": "She sat down with her <w>bottom</w> on the soft moss to rest."
                            }
                        }
                    ],
                    "common_phrases": [
                        "linker bil",
                        "rechter bil",
                        "op je billen zitten"
                    ],
                    "target_lang_definitions": {
                        "en": "each of the two fleshy parts of the human body on which one sits"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "buttock",
                                "target_lang_sense_clarification": "anatomical term for one side of the bottom"
                            },
                            {
                                "target_lang_word": "cheek",
                                "target_lang_sense_clarification": "informal term for one side of the buttocks"
                            },
                            {
                                "target_lang_word": "bottom",
                                "target_lang_sense_clarification": "general term for the buttocks"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02280b71-1618-3daa-b37f-1fef2f7fe845",
                    "sense_definition": "een hamerachtig werktuig met twee snijkanten dat door steenhouwers en molenaars wordt gebruikt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De molenaar gebruikte een <w>bil</w> om de molenstenen weer scherp te maken.",
                            "target_lang_translations": {
                                "en": "The miller used a <w>mill pick</w> to sharpen the millstones again."
                            }
                        },
                        {
                            "text": "Dit type <w>bil</w> is essentieel voor het bewerken van harde steensoorten.",
                            "target_lang_translations": {
                                "en": "This type of <w>stone hammer</w> is essential for working with hard types of stone."
                            }
                        }
                    ],
                    "synonyms": [
                        "bilhamer",
                        "zwaaispits",
                        "tweespits"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical tool"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a hammer-like tool with two cutting edges used by stonemasons and millers"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mill pick",
                                "target_lang_sense_clarification": "tool for dressing millstones"
                            },
                            {
                                "target_lang_word": "stone hammer",
                                "target_lang_sense_clarification": "tool for shaping stone"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3ad5140a-c2fa-36b5-bc1d-42f12cd1ad63",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>billen</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bil</w> de molensteen om de groeven te verdiepen.",
                            "target_lang_translations": {
                                "en": "I <w>dress</w> the millstone to deepen the grooves."
                            }
                        },
                        {
                            "text": "Wanneer ik de steen <w>bil</w>, draag ik altijd een veiligheidsbril.",
                            "target_lang_translations": {
                                "en": "When I <w>pick</w> the stone, I always wear safety goggles."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "first person singular present tense of 'billen' (to dress a millstone)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dress",
                                "target_lang_sense_clarification": "to sharpen or groove a millstone"
                            },
                            {
                                "target_lang_word": "pick",
                                "target_lang_sense_clarification": "to roughen a stone surface with a tool"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}