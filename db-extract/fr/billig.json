                "senses": [
                    {
                        "sense_id": "b2feb78e-d1be-3789-9bf0-7af2feddf81f",
                        "entry_id": "a85d7c83-92a3-3fbd-b568-c22779842c8b",
                        "glosses": [
                            "Sorte de plaque chauffée qui sert à cuire les crêpes et les galettes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e05d0301-529f-4cf0-a3bf-8810d17876b7",
                                "sense_id": "b2feb78e-d1be-3789-9bf0-7af2feddf81f",
                                "text": "Le chaudron va laisser la place aux fait-tout, casseroles et autres poêles, la tuile à galettes se voit concurrencer par la galetière munie d'une poignée, ou bien le billig couplé au gaz."
                            },
                            {
                                "example_id": "f6f9a2b2-468a-41e8-9b10-c883ee03b91b",
                                "sense_id": "b2feb78e-d1be-3789-9bf0-7af2feddf81f",
                                "text": "Ci-dessus, ustensiles servant à la fabrication des crêpes en Bretagne : la billig (« galettoire »), le rozell (raclette) et le spanell (spatule). Cl. musée de la Crêpe."
                            },
                            {
                                "example_id": "86d13d43-4256-4359-96b8-dc6f496799b7",
                                "sense_id": "b2feb78e-d1be-3789-9bf0-7af2feddf81f",
                                "text": "Les crêpes de froment, comme les crêpes ou galettes de blé noir, se cuisent traditionnellement sur la billig (la galettière), mais là aussi, il faut avoir à la fois la billig et le tour de main !"
                            },
                            {
                                "example_id": "262d216b-b642-492a-b05c-187f03664193",
                                "sense_id": "b2feb78e-d1be-3789-9bf0-7af2feddf81f",
                                "text": "Il salua chaleureusement le fief à crêpes où Paule, la spécialiste de la fabrication de la pâte, armée de sa spatule, œuvrait avec son équipe devant les billigs. Cette année, le record précédent des trois mille sept cents crêpes risquait fort d'être pulvérisé !"
                            },
                            {
                                "example_id": "ec0ec4eb-104e-4511-9701-988e510bec97",
                                "sense_id": "b2feb78e-d1be-3789-9bf0-7af2feddf81f",
                                "text": "Le club édernois compte 50 adhérents. Un prochain « concours » aura lieu en octobre en semi-nocturne. Mais d'ici-là, les billigou vont chauffer ! Un repas-crêpes est prévu prochainement pour rassembler les pétanqueurs du club."
                            },
                            {
                                "example_id": "88296dc8-2fe2-46d5-bf7d-97ee4d630c43",
                                "sense_id": "b2feb78e-d1be-3789-9bf0-7af2feddf81f",
                                "text": "La Chandeleur (2 février) approche, faites chauffer le billig (prononcez billic, en bon breton). Autrement dit la crêpière ou la galettière !"
                            }
                        ]
                    }
