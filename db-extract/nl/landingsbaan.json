                    {
                        "sense_id": "e64596e5-48a5-3952-8885-628c13729cb9",
                        "entry_id": "8db1c750-3f38-3c5d-b8d9-f1c731c7713c",
                        "glosses": [
                            "vlakke, brede strook land op een vliegveld waarvan vliegtuigen gebruik kunnen maken bij het landen en het opstijgen\\nEen landingsbaan is feitelijk hetzelfde als een startbaan, maar dan benaderd vanuit een vliegtuig dat landt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c68b6c43-459a-444e-bed9-51f910148328",
                                "sense_id": "e64596e5-48a5-3952-8885-628c13729cb9",
                                "text": "Op Toronto Pearson International Airport in Canada is een vliegtuig gecrasht tijdens de landing. Het toestel belandde ondersteboven op de landingsbaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "23adad23-8738-32d4-802c-d385e86c6870",
                        "entry_id": "8db1c750-3f38-3c5d-b8d9-f1c731c7713c",
                        "glosses": [
                            "functie met minder werkuren per week, bedoeld om voor oudere werknemers aan het eind van hun carrière een geleidelijke overgang naar het pensioen mogelijk te maken"
                        ],
                        "tags": [
                            "België"
                        ],
                        "examples": [
                            {
                                "example_id": "f0c4e2f7-45cc-4ac3-a807-fa5ecfe3ddb2",
                                "sense_id": "23adad23-8738-32d4-802c-d385e86c6870",
                                "text": "Dan is er nog de landingsbaan, bedoeld om het voor werknemers op het einde van hun loopbaan wat lichter te maken. Je kan 4/5 gaan werken of halftijds."
                            }
                        ]
                    },
                    {
                        "sense_id": "24b33d21-69d0-3b05-b1a7-a48007b737b1",
                        "entry_id": "8db1c750-3f38-3c5d-b8d9-f1c731c7713c",
                        "glosses": [
                            "schaamhaar bij een vrouw dat is teruggeschoren tot een verticaal reepje op de venusheuvel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "300c02be-b680-4ad6-9a52-ca3e99773a35",
                                "sense_id": "24b33d21-69d0-3b05-b1a7-a48007b737b1",
                                "text": "Ruim 65 procent van de vrouwen die naar een waxsalon gaat, laat haar schaamstreek het liefst helemaal kaal harsen. Ook het bekende streepje, ofwel de ‘landingsbaan’, is nog steeds een populaire keuze."
                            }
                        ]
                    }
