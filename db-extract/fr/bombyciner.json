                        "sense_id": "4e3e1f67-03e7-3d22-9363-bd2035c1fb49",
                        "entry_id": "1fff0f20-271d-39a8-9452-e1282b099945",
                        "glosses": [
                            "Réfléchir en tournant en rond, sans avancer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c552f630-1423-4596-b26f-f48b4b15f470",
                                "sense_id": "4e3e1f67-03e7-3d22-9363-bd2035c1fb49",
                                "text": "La discussion ne pouvait que bombyciner dans le vide."
                            },
                            {
                                "example_id": "50ca7310-003a-4199-8d37-b57f429134a3",
                                "sense_id": "4e3e1f67-03e7-3d22-9363-bd2035c1fb49",
                                "text": "Je n’ai jamais vu personne bombyciner dans le vague comme lui."
                            },
                            {
                                "example_id": "d3e8735e-535c-41a6-9b54-7e9d36044675",
                                "sense_id": "4e3e1f67-03e7-3d22-9363-bd2035c1fb49",
                                "text": "Prise et maintenue à ce niveau, la discussion ne peut que tourner en rond, « bombyciner dans le vide »."
                            }
                        ]
                    }
