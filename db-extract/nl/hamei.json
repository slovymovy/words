                        "examples": [
                            {
                                "example_id": "8445a41f-c51a-4256-a188-caebf3338134",
                                "sense_id": "faba8777-42e3-322b-8b76-d4bcedc90c86",
                                "text": "⧖ Een uur later achtte Aurora het geraden de houten zijbruggen te laten afbreken en de voorbrug op te halen. De zware slagboomen werden voor de poort geschoven, balken en met zand gevulde vaten daartegen gestapeld en de hamei neergelaten."
                            }
                        ]
                    },
