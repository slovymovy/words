                "senses": [
                    {
                        "sense_id": "b83ed70c-1495-3f05-a449-2eed3932deb1",
                        "entry_id": "5d01a136-356d-3390-b27c-47cd1d4255e1",
                        "glosses": [
                            "Courant de pensée et des théories économiques qui estime que le monde, un pays ou une entité est en déclin, tant sur le plan économique que sur le plan culturel ou géopolitique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "872f6f62-28b1-4454-a1ae-03f37b44ab57",
                                "sense_id": "b83ed70c-1495-3f05-a449-2eed3932deb1",
                                "text": "Si nous deux, étudiants de 22 ans sans légitimité particulière, décidons de nous exprimer aujourd’hui, c’est parce que nous étouffons sous le poids du déclinisme ambiant (qui est d’ailleurs récurrent dans l’histoire de notre pays)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cc93d17-b149-4c21-b8f3-566b9c98f331",
                        "source_entry_id": "5d01a136-356d-3390-b27c-47cd1d4255e1",
                        "source_sense_id": "b83ed70c-1495-3f05-a449-2eed3932deb1",
                        "target_lang_word": "declinism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "declinism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6bf2ef22-1448-38cd-8fb8-9f530a3d5a5a",
                                        "entry_id": "587d74a0-af7d-346c-9c3d-93d157246778",
                                        "glosses": [
                                            "A pessimistic belief that things are in decline."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afbacec2-5bc9-464b-8099-e29ae8f03f1d",
                                                "sense_id": "6bf2ef22-1448-38cd-8fb8-9f530a3d5a5a",
                                                "text": "Laudably, he [Cullen Murphy] ends on some optimistic notes, and some prescriptions, rather than wallowing in declinism."
                                            },
                                            {
                                                "example_id": "c278a434-fa29-404e-9e38-309e8299bd1c",
                                                "sense_id": "6bf2ef22-1448-38cd-8fb8-9f530a3d5a5a",
                                                "text": "So maybe declinism is just a quirk of human psychology."
                                            },
                                            {
                                                "example_id": "21313e94-c3a7-488e-93b8-eddfd4414297",
                                                "sense_id": "6bf2ef22-1448-38cd-8fb8-9f530a3d5a5a",
                                                "text": "Instead, declinism ruled—the belief that Britain was in a state of terminal, irreversible decline being widely shared, and—as glam has demonstrated—frequently and forcibly expressed."
                                            },
                                            {
                                                "example_id": "eab75521-178b-4eeb-8a36-6bec69730bd0",
                                                "sense_id": "6bf2ef22-1448-38cd-8fb8-9f530a3d5a5a",
                                                "text": "The chancellor came to Bloomberg’s HQ in the City of London on Friday seeking to raise the country’s spirits, hail the split with Brussels and dispel the “declinism” he says saps Britain’s energy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
