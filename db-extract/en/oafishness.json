                                "target_senses": [
                                    {
                                        "sense_id": "3eca149d-8a0c-3c54-a628-2abeb2728c43",
                                        "entry_id": "a7f110bb-13fa-3ab7-932e-2b33d729045a",
                                        "glosses": [
                                            "geistiges Unvermögen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74317a82-93b8-45f0-9203-45c5856a75e3",
                                                "sense_id": "3eca149d-8a0c-3c54-a628-2abeb2728c43",
                                                "text": "Es zeugt von großer Einfalt, wenn er wirklich geglaubt hat, damit durchzukommen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "08709e13-3466-3f01-b276-11b6d599814c",
                                        "entry_id": "a7f110bb-13fa-3ab7-932e-2b33d729045a",
                                        "glosses": [
                                            "Schlichtheit, Unverdorbenheit des Gemütes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68a14c00-6685-41d3-a01f-364bd1abf83e",
                                                "sense_id": "08709e13-3466-3f01-b276-11b6d599814c",
                                                "text": "Aus seinen Worten sprach mehr als nur kindliche Einfalt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
