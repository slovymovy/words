                                        "entry_id": "9a59a6d8-8e4e-33db-a8ac-acb6c9c899c4",
                                        "glosses": [
                                            "A person, device, or agent that presses or squeezes, as:",
                                            "A person or device that removes wrinkles, usually from clothing."
