                                                "example_id": "82a4ec1c-ba1a-4045-98b7-cfc015677a83",
                                                "sense_id": "5a03b465-db01-3fae-bd6a-aa87538f7c8f",
                                                "text": "But the real test of my adaptability came senior year, when I became chapter president of DKA."
                                            }
