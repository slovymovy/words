                "senses": [
                    {
                        "sense_id": "5327f74e-1e35-3c39-bc8c-320551d3a437",
                        "entry_id": "5607a1a3-64e6-388f-8f18-f58122c76193",
                        "glosses": [
                            "белый как снег, белоснежный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6151aaa6-0387-463c-bff1-5db5642c385c",
                                "sense_id": "5327f74e-1e35-3c39-bc8c-320551d3a437",
                                "text": "Бросив бесформенный комочек зелени в раскалённую каменным углём печь, он долго смотрел, как его враг шипел, съёживался и наконец превратился в нежный снежно-белый комочек золы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2daf152-7841-48cc-b178-e82e6c770398",
                        "source_entry_id": "5607a1a3-64e6-388f-8f18-f58122c76193",
                        "source_sense_id": "5327f74e-1e35-3c39-bc8c-320551d3a437",
                        "target_lang_word": "snow-white",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snow-white",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ddeca8c-4e55-302b-9f56-a0b789ab0924",
                                        "entry_id": "25c193a6-59e5-3c49-8f13-ba4ef502f49f",
                                        "glosses": [
                                            "As white as snow; exceptionally white."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb6ccbe6-cc1a-481a-9f8a-a28d5aa9e692",
                                                "sense_id": "6ddeca8c-4e55-302b-9f56-a0b789ab0924",
                                                "text": "One day he wandered to the banks of the Rhine. On its discolored waters swam a snow-white swan, playfully pulling at the rope which bound a small skiff to the shore."
                                            },
                                            {
                                                "example_id": "dd58c938-e5d3-42f2-9fe1-f9d57cdadeb4",
                                                "sense_id": "6ddeca8c-4e55-302b-9f56-a0b789ab0924",
                                                "text": "It was also a delight to see a racially mixed band from Boston. Too bad that the crowd was snow white. We've all still got a helluva long way to go."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "snow-white",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
