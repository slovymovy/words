{
    "word_family": [
        "rejoicing",
        "rejoicement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6dc71d42-3ab3-30bd-94de-2419c5c64c7e",
                    "sense_definition": "To feel or show great joy or delight; to be exceptionally happy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "feel_joy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire nation began to <w>rejoice</w> when the peace treaty was finally signed.",
                            "target_lang_translations": {
                                "cs": "Celý národ se začal <w>radovat</w>, když byla konečně podepsána mírová smlouva."
                            }
                        },
                        {
                            "text": "We have every reason to <w>rejoice</w> in our team's historic victory today.",
                            "target_lang_translations": {
                                "cs": "Máme dnes všechny důvody <w>radovat se</w> z historického vítězství našeho týmu."
                            }
                        }
                    ],
                    "synonyms": [
                        "delight",
                        "exult"
                    ],
                    "antonyms": [
                        "mourn",
                        "grieve",
                        "lament"
                    ],
                    "common_phrases": [
                        "rejoice in",
                        "reason to rejoice"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pociťovat nebo projevovat velkou radost či potěšení; být mimořádně šťastný."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "radovat se",
                                "target_lang_sense_clarification": "pociťovat nebo projevovat radost"
                            },
                            {
                                "target_lang_word": "těšit se z",
                                "target_lang_sense_clarification": "pociťovat radost z něčeho konkrétního"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9fdae37-f314-3dcd-bdd1-cae31f0a3c4c",
                    "sense_definition": "To make someone happy; to gladden or exhilarate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "make_happy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It would <w>rejoice</w> my heart to see you succeed after all your hard work.",
                            "target_lang_translations": {
                                "cs": "Velmi by mě <w>potěšilo</w> vidět tvůj úspěch po vší té tvrdé práci."
                            }
                        },
                        {
                            "text": "The good news of her recovery <w>rejoiced</w> the entire family.",
                            "target_lang_translations": {
                                "cs": "Dobrá zpráva o jejím uzdravení <w>potěšila</w$ celou rodinu."
                            }
                        }
                    ],
                    "synonyms": [
                        "gladden",
                        "cheer",
                        "exhilarate",
                        "gratify",
                        "please"
                    ],
                    "antonyms": [
                        "sadden",
                        "depress"
                    ],
                    "common_phrases": [
                        "rejoice the heart",
                        "rejoice the soul"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This transitive use meaning 'to make happy' is now literary or dated."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Udělat někoho šťastným; potěšit nebo rozveselit."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "těšit",
                                "target_lang_sense_clarification": "přinášet někomu radost či uspokojení"
                            },
                            {
                                "target_lang_word": "radovat",
                                "target_lang_sense_clarification": "literární nebo zastaralé vyjádření pro působení radosti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f420f35-7ab3-3edc-8c17-b3164e837db4",
                    "sense_definition": "To have the use or benefit of; to enjoy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enjoyment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In those days, the local lords <w>rejoiced</w> the sole right to fish in these waters.",
                            "target_lang_translations": {
                                "cs": "V oněch dobách místní páni <w>užívali</w> výhradní právo rybolovu v těchto vodách."
                            }
                        },
                        {
                            "text": "He <w>rejoiced</w> the privilege of a private library during his long stay.",
                            "target_lang_translations": {
                                "cs": "Během svého dlouhého pobytu <w>užíval</w> výsady soukromé knihovny."
                            }
                        }
                    ],
                    "synonyms": [
                        "enjoy",
                        "possess"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the sense of possessing or enjoying a right or property."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mít užitek nebo prospěch z něčeho; užívat si (zastaralé)."
                    },
                    "translations": {
                        "cs": []
                    }
                },
                {
                    "sense_id": "1ff6a669-22b6-3786-ac64-2c6b1bebe290",
                    "sense_definition": "To have someone as a lover or spouse; to enjoy sexually.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sexual_enjoyment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient tale spoke of a knight who would never <w>rejoice</w> any lady other than his queen.",
                            "target_lang_translations": {
                                "cs": "Starý příběh vyprávěl o rytíři, který by nikdy <w>neobcoval</w> s jinou dámou než se svou královnou."
                            }
                        },
                        {
                            "text": "He lamented that he might never <w>rejoice</w> his beloved again.",
                            "target_lang_translations": {
                                "cs": "Naříkal, že už možná nikdy <w>nespoine</w> se svou milovanou."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Used in Middle English and early modern texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mít někoho jako milence nebo manžela; užívat si sexuálně (zastaralé)."
                    },
                    "translations": {
                        "cs": []
                    }
                }
            ]
        }
    ]
}