                        "sense_id": "e0b97a76-6cee-35db-9b1d-0fd386dc8642",
                        "entry_id": "524fbe46-91cc-302d-ae8c-fcd4a4c7ef2c",
                        "glosses": [
                            "лингв. тип билингвизма, вызванный влиянием чужого языка на язык аборигенов"
                        ],
                        "tags": [],
                        "examples": []
                    }
