                "senses": [
                    {
                        "sense_id": "2626af33-0734-3b56-926c-d06d62a6ca59",
                        "entry_id": "3b0d9c2b-0351-323d-a3e9-86d24acf4ec9",
                        "glosses": [
                            "Eine Gattung aus der Familie der Kreuzdorngewächse (Rhamnaceae), die weltweit rund 100 tropisch beheimatete Arten umfasst."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c21c7c33-5aee-4eec-91cf-7147b45233f6",
                                "sense_id": "2626af33-0734-3b56-926c-d06d62a6ca59",
                                "text": "„Im Unterholz steht außerdem Omukaru (Ziziphus mucronata), zu erkennen an einem Hakendorn und einem spitzen geraden Dorn die paarweise angeordnet sind sowie glänzend grünen Blättern mit drei deutlichen, vom Blattgrund ausgehenden Blattnerven. […] Der Inhalt der Kokons kann auch getrocknet aufbewahrt und bei Bedarf mit dem Saft des Omukaru (Ziziphus mucronata) angerührt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
