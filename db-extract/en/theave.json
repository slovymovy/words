                        "glosses": [
                            "A ewe lamb of a specific age; in some areas, applied to lambs in their the first or second year (before they have had lambs themselves), in others to lambs in their third year, before their second shearing."
                        ],
                        "tags": [
                            "UK",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "84b1de85-164a-4e28-8148-9626ebd9037e",
                                "sense_id": "b0b1a2d0-9c1f-3b0b-b787-10e2811ccaf4",
                                "text": "The ewes by them-selfe, the share-hogges and theyues by them selfe"
                            },
                            {
                                "example_id": "4ac994b6-8e53-4c4c-8faa-c551bf8b84d4",
                                "sense_id": "b0b1a2d0-9c1f-3b0b-b787-10e2811ccaf4",
                                "text": "Comprising eleven calved and in-calf cows and heifers, three barren cows, […] fifteen in-lamb ewes and theaves, […] yearling draught colt and filly, pony, yearling fummel, mare ass in-foal to a pony, two waggons, […]"
                            },
                            {
                                "example_id": "7bdb7e9f-a71c-4ac0-8aea-81d896bcd59e",
                                "sense_id": "b0b1a2d0-9c1f-3b0b-b787-10e2811ccaf4",
                                "text": "A dorring drush in the caddled yew. / A seance o' theaves beneath the woak."
                            }
                        ]
                    }
                ],
