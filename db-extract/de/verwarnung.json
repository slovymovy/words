                        "form": "die Verwarnung"
                    },
                    {
                        "form_id": "76bc5ab0-bb85-457c-a7ad-f5f6d2ba8ac1",
                        "entry_id": "7258541b-fca2-398e-9181-58820b798294",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Verwarnungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                        "entry_id": "7258541b-fca2-398e-9181-58820b798294",
                        "glosses": [
                            "Ermahnung oder Warnung, die eine Person für eine Regelverletzung oder ein Fehlverhalten erhält; oft beinhaltet eine Verwarnung die Androhung einer strengeren Strafe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c8cd6ad-44f1-4eb0-a0d6-b90cfd94ccfe",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "„Wer erwischt wird, bekommt meistens eine Verwarnung.“"
                            },
                            {
                                "example_id": "464c9c56-26c1-4862-b0c7-7aa6eac78445",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "„Gegen die Leiterin der Kinderkrippe des Kantonsspitals wurde eine «arbeitsrechtliche Verwarnung» ausgesprochen.“"
                            },
                            {
                                "example_id": "18fd6c1f-d952-4c49-8e36-a245182204f6",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "„2015 wurde Clarksons Vertrag aufgrund mehrerer Verwarnungen von der BBC nicht verlängert.“"
                            },
                            {
                                "example_id": "d05c1ce8-0279-4baa-a60c-fbb443db2aec",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "[Was geschah am 26. November 1943:] „Der US-amerikanische General George Smith Patton erhält eine dienstliche Verwarnung, weil er Soldaten, die nach einem Granatenangriff unter Schock standen, hatte schlagen lassen.“"
                            },
                            {
                                "example_id": "a06caf6c-c75d-475d-9e53-a93a77330839",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "„»Wer einmal unentschuldigt nicht am Unterricht teilnimmt, muss nicht gleich mit einem Bußgeld rechnen«, so Hentschelmann. Möglich sei auch eine bloße Verwarnung mit oder ohne Verwarnungsgeld.“"
                            },
                            {
                                "example_id": "827459ae-cd68-4a2d-9520-9b061e9ea1b4",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "[Tennis:] „Die Atmosphäre spitzte sich kurzzeitig zu, als Medwedew beim Seitenwechsel Ende des ersten Satzes von Referee Eva Asderaki eine Verwarnung wegen unsportlichen Verhaltens bekam, weil Medwedew offenbar nach einer Entscheidung von ihr geflucht hatte.“"
                            },
                            {
                                "example_id": "bc897e68-ea10-42c4-8919-1b913d91b17e",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "[Fußball:] „Gegen Hannover blieb Dahoud ohne Verwarnung, sonst wäre er auch nach der Länderspielpause in der Partie beim FC Bayern gesperrt gewesen.“"
                            },
                            {
                                "example_id": "05e6d453-6429-444a-9eb9-1bb9e5e8eb7b",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "[Fußball:] „Diskussionsversuche von Spielern ohne Kapitänsbinde wurden gleich mehrfach streng mit einer Gelben Karte geahndet, die Verwarnungen zeigten eine abschreckende Wirkung.“"
                            },
                            {
                                "example_id": "f2e2db3b-6d8a-4ae0-b8a8-54620ac6823f",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "[Fußball:] „In der 79. Minute sah Dovedan nach einem leichten Treffer gegen Kaiser nach vorheriger Verwarnung die gelb-rote Karte. Eine harte Entscheidung.“"
                            },
                            {
                                "example_id": "6fe88d4a-c291-41f0-8bbb-5e8fd397980d",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "[Was geschah am 21. Dezember 1954:] „Durch einen Beschluss der Bundesregierung wird die gebührenpflichtige Verwarnung im Verkehr von zwei auf fünf DM heraufgesetzt.“"
                            },
                            {
                                "example_id": "aab2067b-86fe-42b3-8587-48225a6be87c",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "„Ein \"Klima der Angst\" in Afghanistan – Die Sittenpolizei kann Verstöße mit Verwarnungen, Drohungen, Geldstrafen, einer Untersuchungshaft von bis zu drei Tagen oder weiteren Sanktionen bestrafen.“"
                            },
                            {
                                "example_id": "220fc1d7-d44a-4319-9ada-9b2b4387423b",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "[Iran:] „Das Gesetz sieht neue und harte Strafen bei Verstößen gegen die Kopftuchpflicht vor - zunächst mehrfache Verwarnungen, etwa per SMS. Dann drohen Geldbußen, Berufsverbote und in Extremfällen sogar Gefängnis.“"
                            },
                            {
                                "example_id": "5a98b0aa-a669-4bc7-99c5-3d8369b02488",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "[Ruhestörungen in Bars und Cafés in Paris:] „Insgesamt wurden 4.500 gebührenpflichtige Verwarnungen von der Polizei ausgesprochen.“"
                            },
                            {
                                "example_id": "5f8f1a35-ca65-437d-b6e9-8584f398a914",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "„Die Stadt Luzern hat diesen Frühling den Raum blau markiert, wo die Restaurants Tische und Stühle auf öffentlichem Grund platzieren dürfen. Die Kontrollen wurden seither intensiviert und ein paar Verwarnungen ausgesprochen.“"
                            },
                            {
                                "example_id": "11e515d7-89e1-44c8-a4bd-1f9c14dee359",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "„Im Oktober 2007 bekam die Regierung in Bukarest eine schriftliche Verwarnung der Europäischen Kommission, da das Land seine Gesetze zur Erhaltung der Biodiversität nicht eingehalten habe.“"
                            },
                            {
                                "example_id": "4fe7552d-ddbb-46f2-914e-0f659f5f0163",
                                "sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                                "text": "„Die EU will die polnische Justizreform nicht hinnehmen. Die EU-Kommission will nun eine offizielle Verwarnung an Warschau schicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7ce1205-1405-4893-9243-341f56032752",
                        "source_entry_id": "7258541b-fca2-398e-9181-58820b798294",
                        "source_sense_id": "c5110693-35c4-35e6-bc08-8b646e5e7846",
                        "source_sense_description": "Ermahnung oder Warnung, die eine Person für eine Regelverletzung oder ein Fehlverhalten erhält; oft beinhaltet eine Verwarnung die Androhung einer strengeren Strafe",
                        "target_lang_word": "warning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d18326c2-adc0-3421-9d3b-b2789cc5020a",
                                        "entry_id": "e15b9947-7123-3eed-b748-ac07747bacae",
                                        "glosses": [
                                            "present participle of warn"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "714d661c-5c3e-47b7-abf9-ad190e201b43",
                                                "sense_id": "d18326c2-adc0-3421-9d3b-b2789cc5020a",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness,[…]. It was with a palpable relief that he heard the first warning notes of the figure."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "warning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "196576a3-8eb3-3c89-9b36-3945c174bf34",
                                        "entry_id": "eb6f05bc-cb42-3439-805c-3816cb415f62",
                                        "glosses": [
                                            "The action of the verb warn; an instance of warning someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17291c83-c313-47a7-a4f1-edf0f88351a5",
                                                "sense_id": "196576a3-8eb3-3c89-9b36-3945c174bf34",
                                                "text": "“[…] Churchill, my dear fellow, we have such greedy sharks, and wolves in lamb's clothing. Oh, dear, there's so much to tell you, so many warnings to give you, but all that must be postponed for the moment.”"
                                            },
                                            {
                                                "example_id": "e8cf8cff-826a-4628-8105-aca963a5443d",
                                                "sense_id": "196576a3-8eb3-3c89-9b36-3945c174bf34",
                                                "text": "Without much warning, a deep voice addressed the crowd, calling for a reverent silence as the Texans who died at the Alamo battle were named."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95bb4b0-520c-3649-9d00-cfdc0fd2923e",
                                        "entry_id": "eb6f05bc-cb42-3439-805c-3816cb415f62",
                                        "glosses": [
                                            "Something spoken or written that is intended to warn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba0af597-65be-4afe-ba9c-d882551eb4ae",
                                                "sense_id": "c95bb4b0-520c-3649-9d00-cfdc0fd2923e",
                                                "text": "The boss gave him a warning that he would be fired if he did not desist from his behaviour."
                                            },
                                            {
                                                "example_id": "c93e111d-0d40-4721-b7c8-894656861fe8",
                                                "sense_id": "c95bb4b0-520c-3649-9d00-cfdc0fd2923e",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "warning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c37516c-a253-390b-9fa4-9042ffe011c4",
                                        "entry_id": "2d4e0929-e6de-3aeb-804f-e049992d6a75",
                                        "glosses": [
                                            "Used to warn of danger in signs and notices."
                                        ],
