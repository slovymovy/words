                "senses": [
                    {
                        "sense_id": "07967879-bd30-3c70-a45f-a0b6fab6502a",
                        "entry_id": "04f8712b-5b0b-3ff6-a0b1-dbf7a578c9f1",
                        "glosses": [
                            "Femme dévote, pratiquante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8e35907-6324-45cc-bd58-70b8a6871460",
                                "sense_id": "07967879-bd30-3c70-a45f-a0b6fab6502a",
                                "text": "Par compensation, un beau surnuméraire, jeune de ses fringants dix-neuf ans, apparaît à une dévote dans le simple appareil d’un homme qui se barbifie."
                            },
                            {
                                "example_id": "ce011276-6cfe-46a6-984f-6fca0025eec4",
                                "sense_id": "07967879-bd30-3c70-a45f-a0b6fab6502a",
                                "text": "Il remet à la dévote sa feuille cléricale, au concierge sa gazette nationaliste, où pullulent les faits-divers (rubrique des « chiens écrasés » ), à la midinette son journal à nouvelles et à feuilletons, à chacun de quoi se fournir d'opinions pour toute la journée."
                            }
                        ]
                    }
