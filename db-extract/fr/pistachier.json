                ],
                "senses": [
                    {
                        "sense_id": "ee85fbcd-b6f1-389f-9b50-378cbe4036ff",
                        "entry_id": "5619e9be-d626-3b92-bd42-680b3678f3c1",
                        "glosses": [
                            "Arbuste dioïque, originaire du Levant, dont certaines espèces comme le pistachier vrai sont cultivées pour les pistaches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c8e0cb4-cc93-4705-a130-256e7f48600c",
                                "sense_id": "ee85fbcd-b6f1-389f-9b50-378cbe4036ff",
                                "text": "Les arbres fruitiers tels que l’olivier, l’amandier et le pistachier jouent un rôle important dans l’équilibre de l’écosystème semi-désertique."
                            },
                            {
                                "example_id": "100ab419-58c1-4973-90fe-ea7e4bc95757",
                                "sense_id": "ee85fbcd-b6f1-389f-9b50-378cbe4036ff",
                                "text": "Hors les murs s’étendaient à perte de vue les champs de pistachiers qui faisaient sa modeste richesse."
                            },
                            {
                                "example_id": "a7930898-3eff-4a29-bb25-548e446bf372",
                                "sense_id": "ee85fbcd-b6f1-389f-9b50-378cbe4036ff",
                                "text": "L’après-midi était sec et les pistachiers étaient couverts de velours rosâtre."
                            },
                            {
                                "example_id": "3dd399d3-ab41-479f-9a23-3d890423452e",
                                "sense_id": "ee85fbcd-b6f1-389f-9b50-378cbe4036ff",
                                "text": "La culture du pistachier est idéale pour les pays arides et semi-arides."
                            }
                        ]
                    }
                ],
