                        "tags": [],
                        "examples": [
                            {
                                "example_id": "664bc295-5d59-4784-bc43-50dffda40e5e",
                                "sense_id": "ff050cd0-c52b-3d28-bcef-ec991a1f3b1b",
                                "text": "After supper, the men sprawled in their bunks or along the deacon-seat, and fearsomely they spat and swore, and fearsomely they lied."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
