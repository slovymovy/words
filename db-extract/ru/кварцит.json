                                        "sense_id": "63c3a39a-f2c2-39ad-83da-d747ec51b7d9",
                                        "entry_id": "da3dce48-c94e-3f7b-921e-84dc579d2e61",
                                        "glosses": [
                                            "Yalnız kuvars tanelerinden birleşik bir kayaç, kum taşı"
                                        ],
