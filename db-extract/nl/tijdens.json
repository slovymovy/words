                                "sense_id": "8d11ad67-02a6-355c-8c2d-19d66a67adfb",
                                "text": "Tijdens de vakantie was ik ziek.",
                                "translation": "During the holidays I was ill.",
                                "english": "During the holidays I was ill."
                            },
                            {
                                "example_id": "3eaa9b94-22a2-4640-80e5-c33787ba3a87",
                                "sense_id": "8d11ad67-02a6-355c-8c2d-19d66a67adfb",
                                "text": "Zing en dans niet tijdens de rouwperiode.",
                                "translation": "Don't sing and dance during the period of mourning.",
