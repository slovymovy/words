                ],
                "senses": [
                    {
                        "sense_id": "d4bc8f8b-fdad-3839-97c5-470193945e76",
                        "entry_id": "83cd5baa-d247-3647-b7aa-a952e4c29793",
                        "glosses": [
                            "Jäger, der Eichhörnchen jagt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "966b0d69-a8b0-49d0-af61-21834d7fcb84",
                                "sense_id": "d4bc8f8b-fdad-3839-97c5-470193945e76",
                                "text": "„Geschichten von rothaarigen Jungen, kalifornischen Baumwollfeldern, dem weiten Weg nach Hause, Eichhörnchenjägern und der sonnigen Seite der Straße.“"
                            },
                            {
                                "example_id": "8a007e48-ae87-46b8-ac8e-1a2c7eb93a9f",
                                "sense_id": "d4bc8f8b-fdad-3839-97c5-470193945e76",
                                "text": "„Er war bloß ein Eichhörnchenjäger, der die Straße entlangging, falls das irgendwen etwas anging.“"
                            },
                            {
                                "example_id": "a24bcc06-3417-442c-bf55-e1163b6acf3c",
                                "sense_id": "d4bc8f8b-fdad-3839-97c5-470193945e76",
                                "text": "„In Frank Capras Klassiker „Mr Smith geht nach Washington“ spielt er einen Pfadfinder und Eichhörnchenjäger, der als Senator nach Washington geschickt wird.“"
                            },
                            {
                                "example_id": "175b61e7-1aac-4829-ba7d-db562e311c6f",
                                "sense_id": "d4bc8f8b-fdad-3839-97c5-470193945e76",
                                "text": "„Ihm sei berichtet worden, dass Albrecht einen Eichhörnchenjäger in seinen Diensten habe, welcher ‚dieselben (Eichhörnchen) wunderbarlicher weyse zusammentreiben und hernach auff einen baum mitteinander in schlaifken fahen soll, das dann erst lustigk wirdt, es erst zu sehen…‘ Umgekehrt empfahl August Albrecht 1574 von Annaburg aus seinen Jägerjungen Castor Meisner.“"
                            },
                            {
                                "example_id": "3f88c262-4959-4e80-b2a9-109aec48d7e1",
                                "sense_id": "d4bc8f8b-fdad-3839-97c5-470193945e76",
                                "text": "„Hier wollen wir hin, denn Arne hat zu tun. Aber wir kommen nicht als Eichhörnchenjäger. Die Zeiten sind vorbei.“"
                            },
                            {
                                "example_id": "c653f4aa-d9be-4708-9124-b94f5fd31bda",
                                "sense_id": "d4bc8f8b-fdad-3839-97c5-470193945e76",
                                "text": "„Wer also begeisterter Gärtner ist, ist auch Eichhörnchenjäger, sollte er seinen Garten mögen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
