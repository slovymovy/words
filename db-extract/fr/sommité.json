                        "source_sense_id": "ec835f36-ac4e-32c7-9b83-8f3251b99ef7",
                        "source_sense_description": "(Sens figuré) (Familier) Personne qui s'est élevée au sommet des dignités, de l’art ou des sciences.",
                        "target_lang_word": "expert",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expert",
