                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ae9c3b5-0550-41cb-9891-77c614806916",
                                                "sense_id": "fab13846-3662-35f3-b93b-92886cfca6ff",
                                                "text": "A black man with his back turned to me was putting three potaroos on the fire to cook."
                                            },
                                            {
                                                "example_id": "c7b6fadf-5445-4ddd-b80b-15e91993f381",
                                                "sense_id": "fab13846-3662-35f3-b93b-92886cfca6ff",
                                                "text": "Potoroos resemble bettongs, both in size and lifestyle, but the potoroos have a more tapered head and pointed snout, a less robust build and a shorter tail."
                                            }
