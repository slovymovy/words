                        "target_lang_word": "斯瓦希利语",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4c4375b4-d91c-448d-8360-b6b61d667916",
                        "source_entry_id": "089185c2-a3f6-305b-bf97-4694a3254ed0",
                        "source_sense_id": "39743c68-02be-30f3-b388-05ab2128a35f",
                        "source_sense_description": "een Bantoetaal die veel gesproken wordt in Oost-Afrika",
                        "target_lang_word": "Suaheli",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Suaheli",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                        "entry_id": "20028f0f-1a5e-308d-abca-15e66f3f58f5",
                                        "glosses": [
                                            "eine in Kenia und Tansania gesprochene Bantusprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8eeaca0-21de-42be-92f2-b7920e489b21",
                                                "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                                "text": "„Wilson sprach auf Suaheli mit dem Fahrer.“"
                                            },
                                            {
                                                "example_id": "1aa8659f-edc9-41e3-a6d4-ab5773ad6d65",
                                                "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                                "text": "Sprechen Sie Suaheli?"
                                            },
                                            {
                                                "example_id": "49d9fca8-ca9a-4fa1-a8e7-adce02e15336",
                                                "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                                "text": "Hast Du in Afrika auch Suaheli gelernt?"
                                            },
                                            {
                                                "example_id": "1af430a4-9eae-447c-9b91-a0d8ede750fa",
                                                "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                                "text": "Das Suaheli erlangte durch den Film „Der König der Löwen“ größere Bekanntheit in Europa."
                                            },
                                            {
                                                "example_id": "6919bd76-189a-46a8-82b0-328d7e18e085",
                                                "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                                "text": "„Dort gab es die politische Entscheidung, Suaheli zur Nationalsprache zu machen, was aber keine rein afrikanische Sprache ist, sondern eine durch den Sklavenhandel entstandene Mischung aus afrikanischen Dialekten, Arabisch und portugiesischen Brocken.“"
                                            },
                                            {
                                                "example_id": "b793fc9d-4bc7-43ca-a676-c6acc80d243b",
                                                "sense_id": "6c2cec63-cda8-38c4-905f-9b52f7ae0109",
                                                "text": "„Über Finschs Kopf tauchte die Afrikanerin auf, schrie etwas auf Suaheli und schlug mit den Fäusten auf Finsch ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Suaheli",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b5582b9-fca1-3d24-9fea-16248b3a6f50",
                                        "entry_id": "fc9c2423-789e-3ceb-8ea3-43a6b01ad16d",
                                        "glosses": [
                                            "Bewohner Ostafrikas, der die Bantusprache Suaheli als Muttersprache spricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c20df2-8cbd-467a-988f-255d8381deae",
                                                "sense_id": "2b5582b9-fca1-3d24-9fea-16248b3a6f50",
                                                "text": "Der Wohlstand der Suaheli gründete auf dem Handel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd8ce328-e282-487c-a5f6-3f4e018f3b85",
                        "source_entry_id": "089185c2-a3f6-305b-bf97-4694a3254ed0",
                        "source_sense_id": "39743c68-02be-30f3-b388-05ab2128a35f",
                        "source_sense_description": "een Bantoetaal die veel gesproken wordt in Oost-Afrika",
                        "target_lang_word": "Swahili",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Swahili",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cae3d26-676e-3b80-932b-f463c3abe265",
                                        "entry_id": "913ee5df-6f4a-3c72-bb88-558fc9948c04",
                                        "glosses": [
                                            "An agglutinative language of the Bantu branch widely spoken in East Africa. Born in its modern form from the hybridization of the Arabic and Bantu cultures, it was the language of the traders in East Africa, and spread along the routes of trade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6867caf-aef1-4039-9477-8feb64aa2960",
                                                "sense_id": "1cae3d26-676e-3b80-932b-f463c3abe265",
                                                "text": "On Tuesday night at the Club Serene in Brooklyn, Mayor Koch proclaimed Kwanzaa Week in New York. Then he told the crowd of about 400 that he had practiced his Swahili in order to pronounce correctly such exotic-sounding words as kujichagulia (self-determination), ujamaa (cooperative economics) and imani (faith), the theme of Kwanzaa '83."
                                            },
                                            {
                                                "example_id": "11fd2053-2f7e-4abe-8396-a60e230743de",
                                                "sense_id": "1cae3d26-676e-3b80-932b-f463c3abe265",
                                                "text": "Similarly, Swahili evolved as the trading language in East Africa and is described as having an Arab vocabulary upon an African grammar."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Swahili",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f9f556f-4589-3475-9a7d-4bf42159ac87",
                                        "entry_id": "0c94a234-e385-3da6-b9bc-51842b5c05ed",
                                        "glosses": [
                                            "A member of various ethnic groups — mainly Bantu, Afro-Arab and Comorian — inhabiting the Swahili coast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d19bdd4-b66c-4fce-88c9-7eb1035ce33d",
                                                "sense_id": "9f9f556f-4589-3475-9a7d-4bf42159ac87",
                                                "text": "The Swahilis are a unique and important community that began to form before the arrival of Islam, as a result of intermarriage between Arab traders who came to the coast and women from local ethnic groups."
                                            },
                                            {
                                                "example_id": "96ed8aa2-9868-4e69-9302-98e3ca0741f2",
                                                "sense_id": "9f9f556f-4589-3475-9a7d-4bf42159ac87",
                                                "text": "The final sources for the early history of the Swahili are the oral traditions related by them about their own past."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
