                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small town of <w>Likely</w> on their road trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки они проехали через маленький городок <w>Лайкли</w>.",
                                "tr": "Araba yolculuklarında küçük <w>Likely</w> kasabasından geçtiler."
