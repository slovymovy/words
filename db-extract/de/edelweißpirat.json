                "senses": [
                    {
                        "sense_id": "608492fc-4281-3ebf-8605-6b0d261b874d",
                        "entry_id": "3cb61207-d1c5-366b-9f03-3e5e81ff1c37",
                        "glosses": [
                            "A member of a loosely organized nonconformist youth movement opposed to the Hitler Youth and the status quo in Nazi Germany, primarily active in the Rhineland and Ruhr Area."
                        ],
                        "tags": [
                            "Nazism",
                            "in-plural",
                            "masculine",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "fb78b89f-9ff4-40d3-92ef-bcbb67a1800c",
                                "sense_id": "608492fc-4281-3ebf-8605-6b0d261b874d",
                                "text": "Doch sie haben ihn grün und blau geschlagen, zuerst die Gestapo in der Elisenstraße, dann im Gefängnis, in Braunweiler. Und jetzt darfst du mal raten, warum? Weil er ein Edelweißpirat war, weil er ein Edelweiß angeheftet hatte, und gerne auf der Gitarre spielte."
                            },
                            {
                                "example_id": "535d3fb7-21fb-4797-b128-68469b691d75",
                                "sense_id": "608492fc-4281-3ebf-8605-6b0d261b874d",
                                "text": "Sie verweigerten die Zwangsmitgliedschaft in der HJ, teilweise waren sie aktiv im organisierten Widerstand. Als „Edelweißpiraten“ wurden Jugendliche wie sie im Rheinland oder Ruhrgebiet von den Nazis verspottet, eine Bezeichnung, die sie später mit Stolz trugen."
                            }
                        ]
                    }
