                ],
                "senses": [
                    {
                        "sense_id": "221b4769-6288-357d-8874-5061c13b6d71",
                        "entry_id": "23b2dc7f-6c12-3e8f-8c86-517def4c8d8a",
                        "glosses": [
                            "Bereich/Gegend voller Schutt zerstörter Gegenstände oder Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c632c318-b0af-4be6-95d1-8e3f57b8d33d",
                                "sense_id": "221b4769-6288-357d-8874-5061c13b6d71",
                                "text": "„Wunderbar hell strahlte die Sonne über die Trümmerlandschaft von Rothenburgsort, mit klarem Licht, in dem Roman von seinem Platz am Schraubstock durch die hohen Fenster des Werksaales weit über den zerstörten Stadtteil sehen konnte.“"
                            },
                            {
                                "example_id": "ea28bac3-acdf-49ea-8680-c7ff7d65ea2b",
                                "sense_id": "221b4769-6288-357d-8874-5061c13b6d71",
                                "text": "„Am Ziel muß ich mich durch Trümmerlandschaften hindurchfragen, doch das angegebene Haus blieb glücklich verschont.“"
                            },
                            {
                                "example_id": "292c0221-6470-4693-943b-596cb9a9fa12",
                                "sense_id": "221b4769-6288-357d-8874-5061c13b6d71",
                                "text": "„Die Menschen richteten sich in der Trümmerlandschaft ein, gewöhnten sich an den schwarzen Markt mit seiner Zigarettenwährung, fanden sich mit der Besetzung ab, bauten neue politische Verbände, neue Verwaltungen auf.“"
                            },
                            {
                                "example_id": "81008025-f6d9-4caa-8aa5-e45b8c30c056",
                                "sense_id": "221b4769-6288-357d-8874-5061c13b6d71",
                                "text": "„Es gab einen Witz, den sich die Besatzer nach der Stunde null, in der Trümmerlandschaft der zu Schutt und Asche gebombten deutschen Städte erzählten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
