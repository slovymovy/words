                                        "glosses": [
                                            "Eigenschaft, extrem schrecklich/ungeheuerlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22571869-8e23-4723-9c78-d5cf3c1e1572",
                                                "sense_id": "8f847959-8b12-35a9-9023-0a510bdf227a",
                                                "text": "„Nichts jedoch hätte bei ihnen auf die Ungeheuerlichkeit eines Verbrechens hingedeutet, nicht einmal bei Pepa, die am unbeherrschtesten war.“"
                                            },
                                            {
                                                "example_id": "cf2e090f-92f3-4fad-962f-75a75d1f8b1d",
                                                "sense_id": "8f847959-8b12-35a9-9023-0a510bdf227a",
                                                "text": "„Es ist eine ganz gewöhnliche deutsche Familiengeschichte, die trotz, vielleicht auch wegen ihrer Ungeheuerlichkeit selten erzählt wird.“"
                                            }
                                        ],
