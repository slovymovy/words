                                    {
                                        "sense_id": "a076cbeb-f4f3-399f-83f9-895f88976bee",
                                        "entry_id": "2bebc8e2-2b52-322f-a5d6-dcaf68eb2d7b",
                                        "glosses": [
                                            "To transition (to undergo a transition) from being one sex/gender to being another (especially by sex reassignment surgery). (Compare transgender.)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c903b7a-5dfe-4e44-83e3-1f6872b5dcd4",
                                                "sense_id": "a076cbeb-f4f3-399f-83f9-895f88976bee",
                                                "text": "For quotations using this term, see Citations:transsex."
                                            },
                                            {
                                                "example_id": "f0202cd6-d5fa-47b5-8dd1-9a52107093eb",
                                                "sense_id": "a076cbeb-f4f3-399f-83f9-895f88976bee",
                                                "text": "Many intersexuals, however, are surgically assigned as male or female, and for some that assignment causes such disharmony between body and psyche that the subject then transsexes in adulthood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a90ebd4-1f59-3bec-8a5e-9c4f148786fb",
                                        "entry_id": "2bebc8e2-2b52-322f-a5d6-dcaf68eb2d7b",
                                        "glosses": [
                                            "To transgender; to (cause something to) change from being sexed/gendered in one way to being sexed/gendered in another way."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce8a6c74-caff-4c60-b55c-fe748b2c43eb",
                                                "sense_id": "4a90ebd4-1f59-3bec-8a5e-9c4f148786fb",
                                                "text": "There is a common misconception that gay men, for instance, are naturally effeminate and may someday wish to transsex their bodies."
                                            },
                                            {
                                                "example_id": "947f3a8c-abea-4843-9871-5f44c1fe312c",
                                                "sense_id": "4a90ebd4-1f59-3bec-8a5e-9c4f148786fb",
                                                "text": "Isis transsexes Iphis, female to male (Met. 9.668: Iphide mutata) in the nick of time (unusque dies restabat) on his/her wedding day."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "transsex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "077d7e08-ee25-3ada-b46c-2616fd3dfb40",
                                        "entry_id": "57804dbc-91cc-357f-a941-c085cab39d1c",
                                        "glosses": [
                                            "Transsexual."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
