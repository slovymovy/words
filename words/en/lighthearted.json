{
    "word_family": [
        "lightheartedness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "972dbf86-74e3-39f2-862f-0c9619a3ba3d",
                    "sense_definition": "Feeling happy and free from worry or sadness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "happiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lighthearted</w> children played happily in the park all afternoon.",
                            "target_lang_translations": {
                                "zh": "<w>轻松愉快</w>的孩子们整个下午都在公园里快乐地玩耍。"
                            }
                        },
                        {
                            "text": "She felt <w>lighthearted</w> after hearing the good news about her promotion.",
                            "target_lang_translations": {
                                "zh": "听到升职的好消息后，她感到心情<w>轻松</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "carefree",
                        "joyful"
                    ],
                    "common_phrases": [
                        "lighthearted mood",
                        "lighthearted attitude"
                    ],
                    "target_lang_definitions": {
                        "zh": "心情轻松愉快，没有忧虑或悲伤。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轻松",
                                "target_lang_sense_clarification": "形容心情放松，没有负担。"
                            },
                            {
                                "target_lang_word": "无忧无虑",
                                "target_lang_sense_clarification": "形容心情非常愉快，没有任何烦恼。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3bc0741-470d-309c-a684-0466a7479ae7",
                    "sense_definition": "Not serious or grave; amusing and relaxed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "happiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was a <w>lighthearted</w> comedy that made everyone laugh.",
                            "target_lang_translations": {
                                "zh": "这部电影是一部<w>轻松愉快</w>的喜剧，让每个人都笑了。"
                            }
                        },
                        {
                            "text": "They had a <w>lighthearted</w> conversation about their favorite childhood memories.",
                            "target_lang_translations": {
                                "zh": "他们就各自最喜欢的童年回忆进行了一场<w>轻松</w>的谈话。"
                            }
                        }
                    ],
                    "synonyms": [
                        "casual",
                        "relaxed"
                    ],
                    "antonyms": [
                        "serious"
                    ],
                    "common_phrases": [
                        "lighthearted banter",
                        "lighthearted approach"
                    ],
                    "target_lang_definitions": {
                        "zh": "不严肃或不沉重；轻松有趣，令人放松。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轻松愉快",
                                "target_lang_sense_clarification": "形容氛围或内容不沉重，让人感到舒适。"
                            },
                            {
                                "target_lang_word": "诙谐",
                                "target_lang_sense_clarification": "形容言谈或作品幽默风趣。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}