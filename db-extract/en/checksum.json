                                    {
                                        "sense_id": "0f832ce7-1090-3d3c-99d9-c9af503f2c25",
                                        "entry_id": "129cfaa6-1ae3-3d82-955d-9b0b6d690333",
                                        "glosses": [
                                            "Nombre associé à un ensemble de données numériques permettant de vérifier que leur intégrité a été préservée après un processus de copie ou de transmission."
                                        ],
                                        "tags": [
                                            "Réseaux informatiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "784626ed-d5df-415d-aa7c-4c2a922946cc",
                                                "sense_id": "0f832ce7-1090-3d3c-99d9-c9af503f2c25",
                                                "text": "Par exemple, la somme des chiffres de la première latitude ci-dessus est 1 + 5 + 4 + 7 = 17, si bien que le chiffre de la somme de contrôle est 7."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d53fa05-541e-4908-9f99-8ebaf4c7de46",
                        "source_entry_id": "4577919c-4c16-31b1-8479-51bc79288e57",
                        "source_sense_id": "fbc81ada-a354-37e8-8f72-f83b6cda41d0",
                        "source_sense_description": "number serving to detect error",
                        "target_lang_word": "Prüfsumme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prüfsumme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6df64cf7-60da-32c4-b5d1-c952dccee1b8",
                                        "entry_id": "3882dae1-93ad-33d1-b870-a1550cf27371",
                                        "glosses": [
                                            "aus Ausgangsdaten unter Anwendung einer Berechnungsvorschrift erzeugter Wert, mit dessen Hilfe bestimmte Fehler bei der Übertragung oder Speicherung dieser Daten erkannt werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3caaea2-36dd-46e5-bfe6-61a7979af475",
                                                "sense_id": "6df64cf7-60da-32c4-b5d1-c952dccee1b8",
                                                "text": "„Mit der Zeit brachten die Zeitschriften aber Checksum-Programme auf den Markt, die für eine Erleichterung sorgten. Stimmte die Prüfsumme am Ende der Zeile, wurde der Text richtig abgetippt.“"
                                            },
                                            {
                                                "example_id": "c3098e45-b51e-483b-987c-bc4f77f9b9c2",
                                                "sense_id": "6df64cf7-60da-32c4-b5d1-c952dccee1b8",
                                                "text": "„Zwar identifiziert Ginlo seine Nutzer anhand ihrer Rufnummer, diese wird aber nur als für Dritte nicht direkt auslesbare Prüfsumme gespeichert.“"
                                            },
                                            {
                                                "example_id": "c52a205e-fda9-421b-a49d-1f56fe03b469",
                                                "sense_id": "6df64cf7-60da-32c4-b5d1-c952dccee1b8",
                                                "text": "„Manche Messenger lösen das mittels eines QR-Codes, den man vom Smartphone des anderen einscannt und dann abgleicht. Darin ist der öffentliche Schlüssel kodiert. Oder es gibt eine elektronische Prüfsumme der Schlüssel in wenigen Zeichen, die man beispielsweise telefonisch vergleichen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
