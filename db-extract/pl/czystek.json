                                        "glosses": [
                                            "Any of various plants in the family Cistaceae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30242fe9-6042-434a-99a4-c315550943e9",
                                                "sense_id": "0a1137be-4c69-317b-97a5-459d7d4ec0fd",
                                                "text": "Sometimes I lost track of them and had to hunt round in a circle, thrusting through sharp-scented bushes, scratching myself on various plants which were still new to me: resinaceous rock-roses [translating cistes], juniper, ilex, yellow and white asphodel."
                                            }
                                        ]
                                    },
