                                "target_senses": [
                                    {
                                        "sense_id": "c35c4f2f-d47d-3b24-b57c-67c1da2ed25d",
                                        "entry_id": "e2c4c58f-06c6-3292-b90f-1c10559ff29a",
                                        "glosses": [
                                            "A historical region and former administrative region of France; since 2016, part of the administrative region of Bourgogne-Franche-Comté."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d362e47c-0ba6-37dc-ac0e-54350164bd7c",
                                        "entry_id": "e2c4c58f-06c6-3292-b90f-1c10559ff29a",
                                        "glosses": [
                                            "An early-medieval kingdom and later former duchy in France and the Netherlands."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Burgundy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dddd26f-db7c-369d-9cef-13dceec52be1",
                                        "entry_id": "21e4dd82-11a1-3756-9935-998b7b5f5073",
                                        "glosses": [
                                            "A variety of wine from this region, chiefly red wine made with pinot noir grapes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d276991-b6ac-41f2-9f32-19f52da69627",
                                                "sense_id": "7dddd26f-db7c-369d-9cef-13dceec52be1",
                                                "text": "Some day, when you are tired of London, come down to Treadley, and expound to me your philosophy of pleasure over some admirable Burgundy I am fortunate enough to possess."
                                            },
                                            {
                                                "example_id": "cc35feb7-e055-4522-be13-d0e55530f41c",
                                                "sense_id": "7dddd26f-db7c-369d-9cef-13dceec52be1",
                                                "text": "That in turn has pushed out many ambitious younger producers from the most fashionable addresses, and led to larger firms, such as luxury goods company LVMH, sweeping in. All of which helps explain why so many Burgundy lovers have grown disillusioned with the region."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b97a4173-7588-39c5-a39b-9c0d7a50e5b9",
                                        "entry_id": "21e4dd82-11a1-3756-9935-998b7b5f5073",
                                        "glosses": [
                                            "A variety of wine resembling that of Burgundy; especially from Australia or California."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a44719a1-f0ab-3050-8b1a-bb858a0f82e8",
                                        "entry_id": "21e4dd82-11a1-3756-9935-998b7b5f5073",
                                        "glosses": [
                                            "Obsolete form of burgundy."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "708e7154-8a4f-4fc8-8c09-15c13098a32a",
                                                "sense_id": "a44719a1-f0ab-3050-8b1a-bb858a0f82e8",
                                                "text": "At 5.85—A new wool Panama dress in all the preferred plain shades—Burgundy, myrtle green, navy blue, seal brown and black."
                                            },
                                            {
                                                "example_id": "cd7ec372-328c-4e09-84d7-037239368cbb",
                                                "sense_id": "a44719a1-f0ab-3050-8b1a-bb858a0f82e8",
                                                "text": "[T]here are also hats in all white and black and white and some of the new shades in brown, Burgundy, red, myrtle, green and toupe shades."
                                            },
                                            {
                                                "example_id": "1b3cb6af-81d7-461d-9eb2-845917a4fb97",
                                                "sense_id": "a44719a1-f0ab-3050-8b1a-bb858a0f82e8",
                                                "text": "We have thirty of the new shades to pick from, including Copenhagen blue, Burgundy, myrtle, empire, green, Java, etc, and there is a guarantee with every yard that it will keep the color and will not spot, 22 inches wide ............ ....... 79c a yard"
                                            },
                                            {
                                                "example_id": "13e8b807-7f10-4697-a73d-054e459017f3",
                                                "sense_id": "a44719a1-f0ab-3050-8b1a-bb858a0f82e8",
                                                "text": "Last week we had a lot of this Crepe de Chine. The yards flew! Here is another lot—alert shoppers will buy early. In beautiful shades of tan, brown, gray, gun-metal, navy, Burgundy, purple, myrtle green, also black; […]"
                                            },
                                            {
                                                "example_id": "84e0f838-b5d3-4726-979b-47701d782482",
                                                "sense_id": "a44719a1-f0ab-3050-8b1a-bb858a0f82e8",
                                                "text": "Remember, the imported chiffon finished, 52 inches, all wool French Broadcloths in red, wine, Burgundy, navy, myrtle, green, matelot, pearl gray, Chasseur green, mode, and black."
                                            },
                                            {
                                                "example_id": "46323ea9-347d-4074-b432-a97a06b4cdfa",
                                                "sense_id": "a44719a1-f0ab-3050-8b1a-bb858a0f82e8",
                                                "text": "This immense assortment embraces all the popular shades for spring wear, including gray, tan, brown, champagne, gold, nile, pink-ciel, lavender, London smoke, Burgundy, myrtle green, taupe, navy, black, white, etc."
                                            },
                                            {
                                                "example_id": "6fbc80a6-0bd4-4a72-9f62-a084d5485821",
                                                "sense_id": "a44719a1-f0ab-3050-8b1a-bb858a0f82e8",
                                                "text": "MAGNIFICENT COLLECTION OF NEW FANCY SILKS, for costumes and dresses, 27 inches wide, soft finish, will not break or cut, solid colors, come in woven stripes, jacquard and best pretty figured effects, come in all the new shades such as amethyst, raisin, Burgundy, myrtle green, gray, navy and royal blue, etc., all pure silk, […]"
                                            },
                                            {
                                                "example_id": "5213c6e8-9771-4ca4-883d-476193dfaea8",
                                                "sense_id": "a44719a1-f0ab-3050-8b1a-bb858a0f82e8",
                                                "text": "A Special Bargain for Men is an extra heavy thread silk sock of excellent wearing quality, and our regular 35c grade. We have these in black, tan, Burgundy, smoke, pearl gray and purple."
                                            },
                                            {
                                                "example_id": "1864cafa-94e0-4f2f-b578-e8e589968872",
                                                "sense_id": "a44719a1-f0ab-3050-8b1a-bb858a0f82e8",
                                                "text": "Navy blue heads the color chart. Grays, from slate gray to dove gray, Burgundy, rose, purple shades and browns are worth more than a passing thought."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Burgundy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e90da3fb-2071-3120-9dbe-4eb239db22bc",
                                        "entry_id": "30fbabf7-43e5-3b39-874d-7b721bc33c3d",
                                        "glosses": [
                                            "Obsolete form of burgundy."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f46fef01-5f27-49d7-9a01-0a965c6805bb",
                                                "sense_id": "e90da3fb-2071-3120-9dbe-4eb239db22bc",
                                                "text": "She was assited in the drawing room by Mrs. H. L. Daville, wearing Burgundy silk veiled in chiffon of the same shade, and bronze garnitures, and Mrs. Harry Phelan, in cream marquisette with Persian borders."
                                            },
                                            {
                                                "example_id": "866245f0-3aa0-4a4a-941a-6045de85fbb5",
                                                "sense_id": "e90da3fb-2071-3120-9dbe-4eb239db22bc",
                                                "text": "Mr. and Mrs. Moes left after the reception for New York and other places, the bride wearing Burgundy cloth with a chic grey hat and veil and Isabella fox furs."
                                            },
                                            {
                                                "example_id": "89aead98-db93-493f-91cc-10aa2a8fd138",
                                                "sense_id": "e90da3fb-2071-3120-9dbe-4eb239db22bc",
                                                "text": "Mr. and Mrs. Olson left last evening for Minneapolis, the bride wearing a Burgundy broadcloth suit with hat to match."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffc5a530-e92e-4072-b97b-26a910287218",
                        "source_entry_id": "4497355d-7835-3a2f-a40b-41f20cf8afaf",
                        "source_sense_id": "1d2c75ab-1696-3b24-bb46-8b9a458f7826",
                        "source_sense_description": "een van de 26 regio's van Frankrijk",
                        "target_lang_word": "Bourgogne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bourgogne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "849cf028-e802-3904-bded-48d79eda754e",
                                        "entry_id": "1be485dd-8ef6-34cb-8d2f-c4650851e4d2",
                                        "glosses": [
                                            "Ancien duché indépendant, qui avait pour capitale Dijon, puis ancienne province française."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad381639-4b34-4336-baad-a72ce15672f2",
                                                "sense_id": "849cf028-e802-3904-bded-48d79eda754e",
                                                "text": "Enfin, tous les intendants de Bourgogne passèrent par la fonction obligée de maître des requêtes."
                                            },
                                            {
                                                "example_id": "953bc869-51a4-4474-a064-972fbaa0c30d",
                                                "sense_id": "849cf028-e802-3904-bded-48d79eda754e",
                                                "text": "En Bourgogne, la situation des juifs n’étaient, d’ailleurs, guère plus enviable qu’en Neustrie (Ile de France, Normandie)."
                                            },
                                            {
                                                "example_id": "3fc3d2c8-2dd9-42ed-8008-ce3fcbec9a6c",
                                                "sense_id": "849cf028-e802-3904-bded-48d79eda754e",
                                                "text": "L’Entrepôt se trouve partagé dans toute sa longueur par la rue de la Côte-d’Or, donnant ainsi la préférence aux vins de Bourgogne, une des spécialités les plus authentiquement, les plus parfaitement françaises, et qui méritent partout le coup de chapeau."
                                            },
                                            {
                                                "example_id": "297577af-0428-49d9-badd-035e2d98cd88",
                                                "sense_id": "849cf028-e802-3904-bded-48d79eda754e",
                                                "text": "« En ces temps-là, la Bourgogne était heureuse »… et la Franche-Comté itou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f800b14-8001-3a42-9084-2292449822f1",
                                        "entry_id": "1be485dd-8ef6-34cb-8d2f-c4650851e4d2",
                                        "glosses": [
                                            "Ancienne région administrative française, composée des quatre départements de l’Yonne, de la Nièvre, de la Saône-et-Loire, et de la Côte-d’Or."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3e6291a-9dea-4259-a33f-53eaaadf2aba",
                                                "sense_id": "9f800b14-8001-3a42-9084-2292449822f1",
                                                "text": "Maintenant qu’elle siège au 10, Downing Street, son discours « va devenir national dans la seule idéologie du parti, recontextualise Agnès Alexandre-Collier, professeure à l’université de Bourgogne et co-autrice de Les partis politiques en Grande-Bretagne (Armand Colin). Une fois en place, la realpolitik et les faits vous rattrapent. »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Bourgogne",
                                "target_lang_code": "fr",
