                "senses": [
                    {
                        "sense_id": "83721664-6f66-33e7-9bbe-a159b71fbe04",
                        "entry_id": "5f2e604d-1fb4-3044-9d8e-f99513403b64",
                        "glosses": [
                            "Undergoing or pertaining to rehabilitation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dcee82f-12ed-4d0d-bac8-b8809ffbfa65",
                                "sense_id": "83721664-6f66-33e7-9bbe-a159b71fbe04",
                                "text": "There are no differences, on any of the twenty factors studied, between the rehabilitant and non-rehabilitant groups."
                            },
                            {
                                "example_id": "7bca4484-ee64-4d6d-97dc-63937f7ec170",
                                "sense_id": "83721664-6f66-33e7-9bbe-a159b71fbe04",
                                "text": "However, some evidence exists on spatial memory in both wild and captive apes and on delayed imitation in rehabilitant apes."
                            },
                            {
                                "example_id": "95b55b6f-077b-481a-ab20-88ac236a23ec",
                                "sense_id": "83721664-6f66-33e7-9bbe-a159b71fbe04",
                                "text": "Recently sensory involvement in relation to pain has been studied asserting the clinical observation of pain ranging from mild to severe in the acute and rehabilitant phases."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "472e2836-5255-3759-b839-6419ec938bf0",
                "word": "rehabilitant",
