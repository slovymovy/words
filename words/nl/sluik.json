    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4ad63a7a-d9da-3f62-a69f-9d45f82a1e8a",
                    "sense_definition": "glad en recht naar beneden hangend, meestal gezegd van haar",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij heeft van zichzelf erg <w>sluik</w> haar dat nooit in de krul blijft zitten.",
                            "target_lang_translations": {
                                "en": "She naturally has very <w>straight</w> hair that never stays curled."
                            }
                        },
                        {
                            "text": "Na de regenbui hing zijn <w>sluike</w> haar futloos langs zijn gezicht.",
                            "target_lang_translations": {
                                "en": "After the rain shower, his <w>lank</w> hair hung lifelessly along his face."
                            }
                        }
                    ],
                    "synonyms": [
                        "steil",
                        "glad"
                    ],
                    "antonyms": [
                        "krullend",
                        "golvend"
                    ],
                    "common_phrases": [
                        "sluik haar"
                    ],
                    "target_lang_definitions": {
                        "en": "Smooth and hanging straight down, usually said of hair."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "straight",
                                "target_lang_sense_clarification": "of hair, not curly"
                            },
                            {
                                "target_lang_word": "lank",
                                "target_lang_sense_clarification": "long, limp, and straight hair"
                            },
                            {
                                "target_lang_word": "smooth",
                                "target_lang_sense_clarification": "even and without curls"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "369b69aa-5545-311c-8046-66a5aa07fc0a",
                    "sense_definition": "handel of activiteiten waarbij wettelijke regels of belastingen worden ontdoken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "illegaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie deed onderzoek naar de <w>sluik</w> in verboden goederen aan de grens.",
                            "target_lang_translations": {
                                "en": "The police investigated the <w>smuggling</w> of prohibited goods at the border."
                            }
                        },
                        {
                            "text": "Door de hoge accijnzen nam de <w>sluik</w> van sigaretten de afgelopen jaren flink toe.",
                            "target_lang_translations": {
                                "en": "Due to high excise duties, the <w>illicit trade</w> of cigarettes increased significantly in recent years."
                            }
                        }
                    ],
                    "synonyms": [
                        "sluikhandel",
                        "smokkel"
                    ],
                    "target_lang_definitions": {
                        "en": "Trade or activities where legal rules or taxes are evaded."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "smuggling",
                                "target_lang_sense_clarification": "illegal trade"
                            },
                            {
                                "target_lang_word": "contraband",
                                "target_lang_sense_clarification": "illegal goods or trade"
                            },
                            {
                                "target_lang_word": "illicit trade",
                                "target_lang_sense_clarification": "unlawful commerce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffae6ebe-6d5d-3f11-9516-6a0df313f863",
                    "sense_definition": "de eigenschap van het heimelijk of stiekem handelen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zat een zekere <w>sluik</w> in zijn manier van doen die niemand vertrouwde.",
                            "target_lang_translations": {
                                "en": "There was a certain <w>slyness</w> in his manner that no one trusted."
                            }
                        },
                        {
                            "text": "Zijn voortdurende <w>sluik</w> zorgde voor veel achterdocht binnen de organisatie.",
                            "target_lang_translations": {
                                "en": "His constant <w>stealthiness</w> caused a lot of suspicion within the organization."
                            }
                        }
                    ],
                    "synonyms": [
                        "stiekemheid",
                        "heimelijkheid"
                    ],
                    "antonyms": [
                        "openheid",
                        "eerlijkheid"
                    ],
                    "target_lang_definitions": {
                        "en": "The quality of acting secretly or stealthily."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stealthiness",
                                "target_lang_sense_clarification": "acting in a secret way"
                            },
                            {
                                "target_lang_word": "slyness",
                                "target_lang_sense_clarification": "being sneaky or cunning"
                            },
                            {
                                "target_lang_word": "surreptitiousness",
                                "target_lang_sense_clarification": "the quality of being stealthy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b46a8fb-7242-3e9e-8ca0-9ae42464d9ff",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>sluiken</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>sluik</w> de goederen over de grens zonder dat iemand het merkt.",
                            "target_lang_translations": {
                                "en": "I <w>smuggle</w> the goods across the border without anyone noticing."
                            }
                        },
                        {
                            "text": "Wanneer ik goederen <w>sluik</w>, neem ik altijd een groot risico.",
                            "target_lang_translations": {
                                "en": "When I <w>sneak</w> goods through, I always take a big risk."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb stem"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'to smuggle' or 'to move stealthily'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "smuggle",
                                "target_lang_sense_clarification": "to move goods illegally"
                            },
                            {
                                "target_lang_word": "sneak",
                                "target_lang_sense_clarification": "to move something secretly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
