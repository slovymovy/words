                        "sense_id": "60a4b610-fcde-3b18-a637-fb0b868ec2d5",
                        "entry_id": "183a7c76-4bad-3dd9-8818-caacc6dc6c74",
                        "glosses": [
                            "een ontbrekend deel, met name in een tekst of ander bestand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b3b250c-49e6-40a9-9bf5-392009c29b29",
                                "sense_id": "60a4b610-fcde-3b18-a637-fb0b868ec2d5",
                                "text": "Door dit hiaat is het onmogelijk na te gaan wat er precies gebeurd is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d48516d-84dc-4e91-9993-da0fa6f5a40c",
                        "source_entry_id": "183a7c76-4bad-3dd9-8818-caacc6dc6c74",
                        "source_sense_id": "60a4b610-fcde-3b18-a637-fb0b868ec2d5",
                        "target_lang_word": "hiatus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hiatus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7ac9139-999b-353b-8a99-0bbe22c2a7f8",
                                        "entry_id": "86b5cfdf-a46f-3bf3-8433-b41566de3014",
                                        "glosses": [
                                            "A gap in a series, making it incomplete."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c037d5-1fbd-4ba9-8153-3135845dac21",
                                                "sense_id": "f7ac9139-999b-353b-8a99-0bbe22c2a7f8",
                                                "text": "Even the mechanical engineer comes at last to an end of his figures, and must stand up, a practical man, face to face with the discrepancies of nature and the hiatuses of theory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f91a02c1-8616-3199-bdde-a64d15c12925",
                                        "entry_id": "86b5cfdf-a46f-3bf3-8433-b41566de3014",
                                        "glosses": [
                                            "An interruption, break, pause or absence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7fce861-88e4-4358-adbb-ff830544a2c4",
                                                "sense_id": "f91a02c1-8616-3199-bdde-a64d15c12925",
                                                "text": "The band decided to go on hiatus, citing creative differences."
                                            },
                                            {
                                                "example_id": "af938f02-36e9-4416-b7a5-567f391e6ef7",
                                                "sense_id": "f91a02c1-8616-3199-bdde-a64d15c12925",
                                                "text": "It is wonderful that you should have slipped back into your American life so easily after your English hiatus."
                                            },
                                            {
                                                "example_id": "1c1fe04e-8e92-4d2a-ad35-4cec22e764ed",
                                                "sense_id": "f91a02c1-8616-3199-bdde-a64d15c12925",
                                                "text": "After a ten-year dividend hiatus, shareholder payments only re-started in July 2022."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eaf9a1a-b2d9-3cee-bd85-a8eb39b9e8cb",
                                        "entry_id": "86b5cfdf-a46f-3bf3-8433-b41566de3014",
                                        "glosses": [
                                            "An temporary break from work, especially one which is unexpected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4408c7d6-5fb8-3ef2-a50a-1abe5ca9a4e0",
                                        "entry_id": "86b5cfdf-a46f-3bf3-8433-b41566de3014",
                                        "glosses": [
                                            "A gap in geological strata."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dce5fc36-11af-4af2-b84b-4a7a6ee20cfd",
                                                "sense_id": "4408c7d6-5fb8-3ef2-a50a-1abe5ca9a4e0",
                                                "text": "The beginning of the Mesozoic Era on the Colorado Plateau is marked by a regional hiatus or break of sedimentary deposition that lasted about 25 to 30 Ma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5225cac4-8b80-3d6e-87a5-17ec4a654d44",
                                        "entry_id": "86b5cfdf-a46f-3bf3-8433-b41566de3014",
                                        "glosses": [
                                            "An opening in an organ."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae1dcf98-d096-4a95-8bb9-253d8f9908a2",
                                                "sense_id": "5225cac4-8b80-3d6e-87a5-17ec4a654d44",
                                                "text": "Hiatus aorticus is an opening in the diaphragm through which aorta and thoracic duct pass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c3b2c4e-78c9-3f1e-9a0a-fa5b5fa1a129",
                                        "entry_id": "86b5cfdf-a46f-3bf3-8433-b41566de3014",
                                        "glosses": [
                                            "A syllable break between two vowels, without an intervening consonant."
                                        ],
                                        "tags": [
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8626f8a0-8aef-496c-aa36-2a5807fe9674",
                                                "sense_id": "0c3b2c4e-78c9-3f1e-9a0a-fa5b5fa1a129",
                                                "text": "A hiatus is agreeable to any Polynesian ear; the ear even of the stranger soon grows used to these barbaric voids; but only in the Marquesan will you find such names as Haaii and Paaaeua, when each individual vowel must be separately uttered."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
