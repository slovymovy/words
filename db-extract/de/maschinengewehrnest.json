                "senses": [
                    {
                        "sense_id": "de68a711-1d44-362b-a7f6-97bf84edf93c",
                        "entry_id": "cc319f44-1522-36e3-9efa-b57c2ed0b55b",
                        "glosses": [
                            "kleine Stellung, in der ein Maschinengewehr und dessen Bedienung postiert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "841259bd-17e3-4e79-8e57-70315a6255ff",
                                "sense_id": "de68a711-1d44-362b-a7f6-97bf84edf93c",
                                "text": "„[…] Die Infanteriegeschütze sollen diejenigen Ziele bekämpfen, welche die Infanterie allein niederzukämpfen nicht imstande ist und welche von der weiter rückwärts stehenden Artillerie nicht genügend gefaßt werden können, z. B. Maschinengewehrnester, Maschinengewehre hinter Schutzschilden, Tanks, Stützpunkte.“"
                            },
                            {
                                "example_id": "b3c79dc0-e0ad-4f65-a39f-6e69fbfde706",
                                "sense_id": "de68a711-1d44-362b-a7f6-97bf84edf93c",
                                "text": "„Er stand am Rand des Sees und versuchte, durch die Sonnenglut zu blicken, die auf dem Wasser so hell wie der weiße Phosphor lag, den sie mit ihren M-79s damals in Vietnam in die feindlichen Maschinengewehrnester gepumpt hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
