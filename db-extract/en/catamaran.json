    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                "word": "catamaran",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "79742b68-c023-40c0-ba4b-a2271e57b746",
                        "entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                        "tags": [
                            "plural"
                        ],
                        "form": "catamarans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ac571ac9-4829-3d73-a119-06d6bcd2271d",
                        "entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                        "glosses": [
                            "A twin-hulled ship or boat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50c27973-5edc-4af0-ac21-3a72911110f3",
                                "sense_id": "ac571ac9-4829-3d73-a119-06d6bcd2271d",
                                "text": "Swift over the seas the vessel drives; Madras appears in sight. The first object catching the eye, upon the anchor being cast, was an Indian upon his catamaran, who, making a sudden motion, sprung to the side of the ship, grappled there for a moment, and the next was on the deck."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cfdeaf7-b71d-3822-a574-36ac5f145145",
                        "entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                        "glosses": [
                            "A quarrelsome woman; a scold."
                        ],
                        "tags": [
                            "colloquial",
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d129fbd7-c19d-434c-ab80-ca14b5b34471",
                                "sense_id": "3cfdeaf7-b71d-3822-a574-36ac5f145145",
                                "text": "She meddles with my prescriptions for your wife; she doctors the infant in private: you'll never have a quiet house or a quiet wife as long as that old Catamaran is here."
                            }
                        ]
                    },
                    {
                        "sense_id": "767bef62-9391-3895-aacf-ce0261b4508d",
                        "entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                        "glosses": [
                            "A raft of three pieces of wood lashed together, the middle piece being longer than the others, and serving as a keel on which the rower squats while paddling."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e20531f0-9f31-4c7a-8856-2e575bf8ed4d",
                                "sense_id": "767bef62-9391-3895-aacf-ce0261b4508d",
                                "text": "Three or four strange-looking things now came close to our boat, which I understood were called ‘catamarans’, consisting of nothing more than two or three large trees, the trunk part only strongly lashed together, upon which sat two men nearly in a state of nature […] ."
                            }
                        ]
                    },
                    {
                        "sense_id": "741f271c-5be5-39a8-b039-f184356f2094",
                        "entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                        "glosses": [
                            "An old kind of fireship."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc146928-3bef-4891-ad68-f88e05967837",
                        "source_entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                        "source_sense_description": "twin-hulled boat",
                        "target_lang_word": "katamaran",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0b5dd9de-61cc-4e1d-92cd-2e873e6877b9",
                        "source_entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                        "source_sense_description": "twin-hulled boat",
                        "target_lang_word": "catamaran",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catamaran",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60fc2f84-541c-3005-8795-7958c8fc0e17",
                                        "entry_id": "39da2e76-4056-3a8a-a8fe-1b5e404182b2",
                                        "glosses": [
                                            "Bateau possédant deux coques, en général l’une à côté de l’autre."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5706b079-62be-4812-98d9-095fe510c032",
                                                "sense_id": "60fc2f84-541c-3005-8795-7958c8fc0e17",
                                                "text": "Par rapport aux monocoques, les catamarans ont plus de stabilité et moins de tirant d’eau."
                                            },
                                            {
                                                "example_id": "f243714d-0d1d-48da-b16a-195b8899ac8e",
                                                "sense_id": "60fc2f84-541c-3005-8795-7958c8fc0e17",
                                                "text": "Dans toute l’histoire de la navigation, le catamaran est sans doute l’embarcation qui réalise les transformations les plus radicales et, sous sa forme moderne, les plus récentes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd55e0b0-0e89-4af7-a93e-28da9e325127",
                        "source_entry_id": "49d8b7b3-8325-307d-a56b-abb51592f029",
                        "source_sense_description": "twin-hulled boat",
                        "target_lang_word": "Katamaran",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Katamaran",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc5232da-c6b7-3d89-9174-111232605761",
                                        "entry_id": "761c9c28-d204-3f6a-b6b9-ea8a5e9e5f70",
                                        "glosses": [
                                            "ein schnelles Segelboot mit Doppelrumpf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32f0779a-c499-46ba-9b0a-b5dcfff74deb",
                                                "sense_id": "dc5232da-c6b7-3d89-9174-111232605761",
                                                "text": "Der Traum eines jeden Segler ist einfach beschrieben: ein Katamaran, viel Speed, eine professionelle Mannschaft und stundenlang auf einer Kufe oder auf den Schwertern auf freier See dahin fliegen, Tage und Wochen lang; Power rund um die Uhr ohne Halt!"
                                            },
                                            {
                                                "example_id": "a1b8e462-f611-4152-8ad3-bb59db8b1473",
                                                "sense_id": "dc5232da-c6b7-3d89-9174-111232605761",
                                                "text": "„Katamarane sind im Mittelmeer, der Karibik und auf den Routen der Weltumsegler aus gutem Grund weit verbreitet.“"
                                            },
                                            {
                                                "example_id": "115fc592-04fd-4a2d-a3f1-52a1b2947e1f",
                                                "sense_id": "dc5232da-c6b7-3d89-9174-111232605761",
                                                "text": "„Einen Ausflug auf einem Katamaran sollte man sich bei seinem Fuerteventura-Urlaub nicht entgehen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "982d32ba-ab9c-36d7-a431-a83181d3d361",
                                        "entry_id": "761c9c28-d204-3f6a-b6b9-ea8a5e9e5f70",
                                        "glosses": [
                                            "Handelsschiff in der Bauweise eines Katamarans^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
