                "senses": [
                    {
                        "sense_id": "65bd2c3d-1982-3645-8a09-8bc1ff80414a",
                        "entry_id": "b1989631-327d-3c2d-be43-7f29720aa166",
                        "glosses": [
                            "weg die men varend aflegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a6a8e90-5cab-4de9-9cdf-84f60b4e71f0",
                                "sense_id": "65bd2c3d-1982-3645-8a09-8bc1ff80414a",
                                "text": "De bootvluchtelingen werden aangetroffen op de vaarroute tussen Libië en Europa. De maritieme EU-operatie Sophia liet via Facebook weten dat een Spaans schip de lichamen heeft geborgen. Hulpverleners ontdekten de stoffelijke resten tijdens een operatie waarbij 64 overlevenden van een zinkende rubberboot werden gehaald."
                            },
                            {
                                "example_id": "c62cbe5f-55bd-467e-8731-8dc8ebd61197",
                                "sense_id": "65bd2c3d-1982-3645-8a09-8bc1ff80414a",
                                "text": "De komende editie van Amsterdam Light Festival kan rekenen op deelname van de wereldberoemde Chinese kunstenaar Ai Weiwei. Van zijn hand komt het kunstwerk ’thinline’, een 7 kilometer lange lichtlijn langs de vaarroute door Amsterdam die bij het lichtfestival hoort."
                            },
                            {
                                "example_id": "c013436b-4bdc-4cd6-9457-e44a8b8cce34",
                                "sense_id": "65bd2c3d-1982-3645-8a09-8bc1ff80414a",
                                "text": "De Noord-Hollandse hoofdstad Haarlem ligt aan de bochtige rivier het Spaarne en vanuit de stad kun je een schitterende vaarroute door afwisselend landschap maken. Deze 21 km lange tocht loopt vanuit het gezellige stadscentrum via de verrassend ruime Mooie Nel langs forten en polders naar Vijfhuizen en Cruquius om ons over het lieflijke Spaarne weer terug naar Haarlem te brengen."
                            }
                        ]
                    }
