                "senses": [
                    {
                        "sense_id": "fed35bd8-a237-3fe2-89ef-b3c1f7fadf18",
                        "entry_id": "66670648-fb33-33ec-9553-b76dd3795c3c",
                        "glosses": [
                            "Modifier l’organisation des salariés au sein d’une entreprise."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "afdcdf47-fe54-47b8-ac22-cb9358a16610",
                                "sense_id": "fed35bd8-a237-3fe2-89ef-b3c1f7fadf18",
                                "text": "Le gros enjeu pour nous c’est la réalisation du budget global. Nous pourrons ainsi avoir une vision consolidée, disposer de notre propre masse salariale pour repyramider nos emplois selon nos besoins aussi bien en enseignants-chercheurs qu’en personnels d’appui à l’enseignement et à la recherche."
                            },
                            {
                                "example_id": "ee991480-5d5b-4c17-8543-5be83f4ea7c9",
                                "sense_id": "fed35bd8-a237-3fe2-89ef-b3c1f7fadf18",
                                "text": "Repyramider les emplois de la filière des ingénieurs et personnels techniques de recherche et de formation, afin de mieux reconnaître les compétences des agents et de mieux répondre aux besoins de qualification croissante des emplois affectés ou au service des unités de recherche."
                            }
                        ]
                    }
                ],
