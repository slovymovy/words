        "fr-extract.jsonl": [
            {
                "entry_id": "648c1dc6-4ebc-381c-a42e-df63dd306dc4",
                "word": "incroyablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "48d615a6-a3ce-380e-96c7-caced08ac375",
                        "entry_id": "648c1dc6-4ebc-381c-a42e-df63dd306dc4",
                        "glosses": [
                            "D’une manière incroyable, excessivement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9c073c9b-b606-4915-a6d1-1381883b8db9",
                                "sense_id": "48d615a6-a3ce-380e-96c7-caced08ac375",
                                "text": "Il y en avait incroyablement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2b2d423-172e-4500-9928-1681c4352dd9",
                        "source_entry_id": "648c1dc6-4ebc-381c-a42e-df63dd306dc4",
                        "source_sense_id": "48d615a6-a3ce-380e-96c7-caced08ac375",
                        "target_lang_word": "amazingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amazingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4e3c572-29ac-3f16-88f5-aff64cc94ed9",
                                        "entry_id": "79f7d897-b2b6-345a-977a-7c0e4b867fac",
                                        "glosses": [
                                            "In an amazing manner; in a way that causes amazement; wonderfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4398029-fe65-4e86-b94f-3d3c6b466f7d",
                                                "sense_id": "f4e3c572-29ac-3f16-88f5-aff64cc94ed9",
                                                "text": "That violin solo was played amazingly."
                                            },
                                            {
                                                "example_id": "52598c2f-e63a-4edd-9940-69d360039eb1",
                                                "sense_id": "f4e3c572-29ac-3f16-88f5-aff64cc94ed9",
                                                "text": "While at first in the U.S.A. it may have been a matter of high-pressure salesmanship—and it has undoubtely been the irresistible enterprise of the General Motors Corporation, through its Electro-Motive subsidiary, that has set in motion this amazingly rapid transformation of American railway motive power, and has caused all the steam locomotive builders in the U.S.A. to follow suit or be left out in the cold—it seems now beyond dispute that, so far as the U.S.A. is concerned, the economics of the power question can be solved no other way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3481d11f-6bb5-3cb9-9e49-e67f5ae3640d",
                                        "entry_id": "79f7d897-b2b6-345a-977a-7c0e4b867fac",
                                        "glosses": [
                                            "Difficult to believe; strange but true."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c126aba-30ec-4766-b567-f8e374b1f39d",
                                                "sense_id": "3481d11f-6bb5-3cb9-9e49-e67f5ae3640d",
                                                "text": "Amazingly, no one was injured in the crash."
                                            },
                                            {
                                                "example_id": "da94ad3b-671e-4197-9cb9-446127be676b",
                                                "sense_id": "3481d11f-6bb5-3cb9-9e49-e67f5ae3640d",
                                                "text": "Signalman Bridges was killed by the blast, as was fireman Nightall. Amazingly, driver Gimbert came round some 200 yards away, on the grass outside the Station Hotel where he had been flung."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a7525e7-6762-3e89-822d-8dae09eced1b",
                                        "entry_id": "79f7d897-b2b6-345a-977a-7c0e4b867fac",
                                        "glosses": [
                                            "To a wonder-inspiring extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd227fff-34b0-4794-8367-a21f5fa01455",
                                                "sense_id": "9a7525e7-6762-3e89-822d-8dae09eced1b",
                                                "text": "The car has amazingly low fuel consumption."
                                            },
                                            {
                                                "example_id": "95d038e8-feab-40ae-975c-6325f9ef4331",
                                                "sense_id": "9a7525e7-6762-3e89-822d-8dae09eced1b",
                                                "text": "The disease AIDS is wiping out a significant portion of the Gay Community and concerns about it are well-justified. But there is another disease that strikes an amazingly high percentage in our community. This disease is Chemical Dependency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "780ba676-5092-4022-bbd0-a6e6e0dd1130",
                        "source_entry_id": "648c1dc6-4ebc-381c-a42e-df63dd306dc4",
                        "source_sense_id": "48d615a6-a3ce-380e-96c7-caced08ac375",
                        "target_lang_word": "unbelievably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbelievably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bc58ab9-db63-3032-9c53-362ce5652202",
                                        "entry_id": "412257b5-a3ee-3c88-a1ed-ff7988ef61bd",
                                        "glosses": [
                                            "In a manner that one does not or cannot believe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "140d665a-138f-4976-8f9f-e4f9ae5e5fcd",
                                                "sense_id": "2bc58ab9-db63-3032-9c53-362ce5652202",
                                                "text": "He gestured unbelievably. Everyone knew he was faking his illness."
                                            },
                                            {
                                                "example_id": "9bd1e505-bf13-4d21-b1a3-22353abd1838",
                                                "sense_id": "2bc58ab9-db63-3032-9c53-362ce5652202",
                                                "text": "Almost unbelievably, some authors have formed the erroneous conception that ‘Hobson-Jobson’ is actually the double-barrelled surname of the dictionary’s editor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fac9e9c0-1344-3608-994a-3ce874142769",
                                        "entry_id": "412257b5-a3ee-3c88-a1ed-ff7988ef61bd",
                                        "glosses": [
                                            "To an extent not to be believed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c9de11b-2e93-4450-87ca-69f862268966",
                                                "sense_id": "fac9e9c0-1344-3608-994a-3ce874142769",
                                                "text": "His face turned unbelievably blue. We realized he was actually choking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5130bbd-7a99-3727-8613-2166f27b8fb1",
                                        "entry_id": "412257b5-a3ee-3c88-a1ed-ff7988ef61bd",
                                        "glosses": [
                                            "Contrary to expectations, amazingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29aab8c6-dac3-417c-922d-70e27a163473",
                                                "sense_id": "f5130bbd-7a99-3727-8613-2166f27b8fb1",
                                                "text": "Unbelievably, Rudy saved the man's life but got sued for breaking two of his ribs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96715a60-6135-4796-af86-ad9c6fa0e352",
                        "source_entry_id": "648c1dc6-4ebc-381c-a42e-df63dd306dc4",
                        "source_sense_id": "48d615a6-a3ce-380e-96c7-caced08ac375",
                        "target_lang_word": "improbably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "improbably",
