                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "2fce7788-1f3c-486d-bf09-838225f34ec6",
                        "entry_id": "649c2c4e-3e93-3aa9-8dfd-0dd981dd0ee5",
                        "tags": [
                            "plural"
                        ],
                        "form": "line-ups"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "40673203-bb03-3cbf-a31d-3fc21f6c1f6e",
                        "entry_id": "649c2c4e-3e93-3aa9-8dfd-0dd981dd0ee5",
                        "glosses": [
                            "in het gelid staan"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b54b6736-8646-3cab-97a2-c55d5d490a13",
                        "entry_id": "649c2c4e-3e93-3aa9-8dfd-0dd981dd0ee5",
                        "glosses": [
                            "lijst met optredende artiesten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aba78053-a6bc-40bb-be65-dbefc2c814df",
                                "sense_id": "b54b6736-8646-3cab-97a2-c55d5d490a13",
                                "text": "De 49 banners zijn bevestigd aan lantaarnpalen in de straten rondom festivalterrein Megaland. Het gaat om originele posters waarop de line-up staat van de optredens in het betreffende jaar."
                            },
                            {
                                "example_id": "c54f0d25-77f2-4854-9b67-a2839a20e0bb",
                                "sense_id": "b54b6736-8646-3cab-97a2-c55d5d490a13",
                                "text": ",,Wij staan als organisatie voor veilige en gezellige party’s en kunnen dit niet waarborgen met dit soort \"artiesten\" en die willen we dan ook niet in onze line up\", laat de organisatie maandag op Facebook weten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dec88e84-56f8-461f-be45-245bea0515b3",
                        "source_entry_id": "649c2c4e-3e93-3aa9-8dfd-0dd981dd0ee5",
                        "source_sense_id": "40673203-bb03-3cbf-a31d-3fc21f6c1f6e",
                        "target_lang_word": "lineup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lineup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15b83551-928f-36b6-9c14-a49fe8bf22e7",
                                        "entry_id": "32fafd4b-8e51-3b35-9482-5c9a87339c06",
                                        "glosses": [
                                            "a physical or photographic queue of people allegedly involved in a crime, allowing a witness to identify them"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9acc30cf-3b38-4979-8fa8-1a77fb699cb8",
                                                "sense_id": "15b83551-928f-36b6-9c14-a49fe8bf22e7",
                                                "text": "Before viewing the lineup, each witness should be required to give to the officer in charge of the lineup a written description of the perpetrator of the crime."
                                            },
                                            {
                                                "example_id": "adcce3c3-49d3-4f31-a36a-a04ebd87c4be",
                                                "sense_id": "15b83551-928f-36b6-9c14-a49fe8bf22e7",
                                                "text": "This innocent suspect is placed in a lineup with five fillers who look similar to that innocent suspect. Given this scenario, one may ask How many people are in the lineup because they fit the description of the perpetrator?"
                                            },
                                            {
                                                "example_id": "02de4134-4b47-4062-8c5a-54444bba26f3",
                                                "sense_id": "15b83551-928f-36b6-9c14-a49fe8bf22e7",
                                                "text": "Foster was placed in a three-man lineup for viewing by the only witness (the manager of the office). Foster was about 6 feet tall, whereas the other two men in the lineup were about 5 feet 6 inches tall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c4be84a-b78e-348b-b3ab-d9169002cdc5",
                                        "entry_id": "32fafd4b-8e51-3b35-9482-5c9a87339c06",
                                        "glosses": [
                                            "A list of trains that are expected to cross over a specified section of track during a specified time period."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ff1e74-34b8-41dc-af0a-fde233e28503",
                                                "sense_id": "9c4be84a-b78e-348b-b3ab-d9169002cdc5",
                                                "text": "It is recognized that lineup will not contain information as to all train and yard movements within yard limits."
                                            },
                                            {
                                                "example_id": "cf2839c5-0ac8-4361-ad80-b4423f8d1bf0",
                                                "sense_id": "9c4be84a-b78e-348b-b3ab-d9169002cdc5",
                                                "text": "Except under special or emergency conditions, track cars are not allowed on the main-line tracks until the man in charge has secured a lineup."
                                            },
                                            {
                                                "example_id": "773288ad-2f78-44d4-888e-a87202f19e09",
                                                "sense_id": "9c4be84a-b78e-348b-b3ab-d9169002cdc5",
                                                "text": "When it is impossible to obtain a lineup, track cars may proceed, using special care, as the way is seen or known to be clear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e542ddeb-0d0c-35c1-abf9-50dd2e731c45",
                                        "entry_id": "32fafd4b-8e51-3b35-9482-5c9a87339c06",
                                        "glosses": [
                                            "A line of people or vehicles, in which the individual at the front end is dealt with first, the one behind is dealt with next, and so on, and in which newcomers join at the end; a queue."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a96665dc-76e8-4ccc-861e-188168634bb5",
                                                "sense_id": "e542ddeb-0d0c-35c1-abf9-50dd2e731c45",
                                                "text": "We have a simple business process that consists of two steps: people wait in a lineup then fill out an application form."
                                            },
                                            {
                                                "example_id": "92b77360-1c56-42bb-9bd2-83c2c3365f72",
                                                "sense_id": "e542ddeb-0d0c-35c1-abf9-50dd2e731c45",
                                                "text": "I've heard that information before and try to remember to do that when there isn't a lineup of customers. When there is a lineup of customers, I don't feel that I have enough time."
                                            },
                                            {
                                                "example_id": "bcc8cc00-5983-4367-9a2b-1097a827efe3",
                                                "sense_id": "e542ddeb-0d0c-35c1-abf9-50dd2e731c45",
                                                "text": "As soon as I entered, I saw a lineup of about 10 to 15 customers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd5a3842-cd35-3a78-bc73-dad2253edccc",
                                        "entry_id": "32fafd4b-8e51-3b35-9482-5c9a87339c06",
                                        "glosses": [
                                            "An ordered list."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7e45c90-3a2d-4715-bc26-9bbc64354131",
                                                "sense_id": "fd5a3842-cd35-3a78-bc73-dad2253edccc",
                                                "text": "Look at the lineup of sideways, up and down gaps, spinning top days, all bunched around the two-hundred-day MA."
                                            },
                                            {
                                                "example_id": "a9c6881a-635d-420f-b566-c2c57a85a992",
                                                "sense_id": "fd5a3842-cd35-3a78-bc73-dad2253edccc",
                                                "text": "At the University of Alabama, Robert M. Metzger's group synthesized a molecule that had an internal energetic lineup of orbitals, which varied depending on the polarity of the voltage applied to it. The lineup of orbitals was analogous to the rungs on a ladder."
                                            },
                                            {
                                                "example_id": "a6010e83-96c0-4024-a0d0-03aa0a16c63e",
                                                "sense_id": "fd5a3842-cd35-3a78-bc73-dad2253edccc",
                                                "text": "The electronic properties of contacts between two semiconductors or, as they are commonly called, semiconductor heterostructures are determined by the lineup of their band structures across the interface and the existence of space-charge layers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dbff1de-84de-3fa7-89bd-d6b7dd9f17bd",
                                        "entry_id": "32fafd4b-8e51-3b35-9482-5c9a87339c06",
                                        "glosses": [
                                            "Collectively, the members of a team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4324d7f5-f77e-47d1-85e1-36fcae17a2ea",
                                                "sense_id": "9dbff1de-84de-3fa7-89bd-d6b7dd9f17bd",
                                                "text": "The manager fielded his strongest lineup for the game against United."
                                            },
                                            {
                                                "example_id": "faf245bf-ab12-447f-bbdb-0030205b3078",
                                                "sense_id": "9dbff1de-84de-3fa7-89bd-d6b7dd9f17bd",
                                                "text": "Elton Brand in 1998 missed 15 games because of an injury in the middle of the year but returned to the lineup late in the season, so he is listed as a starter here. The aim here is to list the lineup that was in use near the end of each season […]"
                                            },
                                            {
                                                "example_id": "9d5f0a9c-8f4d-4b8a-abdb-f66ddc07cb4f",
                                                "sense_id": "9dbff1de-84de-3fa7-89bd-d6b7dd9f17bd",
                                                "text": "Before any game, a team is usually quite interested in its opponent's lineup."
                                            },
                                            {
                                                "example_id": "f2cb4715-eaa8-4d23-ab9e-e326eb40e319",
                                                "sense_id": "9dbff1de-84de-3fa7-89bd-d6b7dd9f17bd",
                                                "text": "Rossi's five starts during the 2015 Formula One season were more like a tryout for the Manor Marussia team, in which he replaced Roberto Merhi for a few races in order to help the team decide what its driver lineup would be the next year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6f83c11-d5c1-3e4e-ab43-957bbedf724c",
                                        "entry_id": "32fafd4b-8e51-3b35-9482-5c9a87339c06",
                                        "glosses": [
                                            "The batting order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b97c8b92-b450-4673-9b14-38d6c595984b",
                                                "sense_id": "d6f83c11-d5c1-3e4e-ab43-957bbedf724c",
                                                "text": "More than any other batter in the lineup, he can keep the inning going with a a base hit, and over a season he'll have as many at-bats as teh lead-off man and thus hit hard and often for his team."
                                            },
                                            {
                                                "example_id": "45bd0355-56f7-4e49-ab03-18daedd67e31",
                                                "sense_id": "d6f83c11-d5c1-3e4e-ab43-957bbedf724c",
                                                "text": "For example, as before, the leadoff hitter for the visiting team in the top of the first inning fails to come to bat and the #2 batter in the lineup subsequently becomes the initial batter in the inning."
                                            },
                                            {
                                                "example_id": "2a3f50ce-a276-4613-9bec-20c1a2b856ea",
                                                "sense_id": "d6f83c11-d5c1-3e4e-ab43-957bbedf724c",
                                                "text": "That meant Howell moved from a weak-hitting lineup to a great-hitting lineup, and players generally said they hit better if they had better hitters around them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db42f5bd-73a9-38b7-804e-ac2cf0909614",
                                        "entry_id": "32fafd4b-8e51-3b35-9482-5c9a87339c06",
                                        "glosses": [
                                            "The order in which race-cars are positioned at the start of a race, based on qualifying times."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aea3a28-2388-44fd-b79d-d14e2bbbc93c",
                                                "sense_id": "db42f5bd-73a9-38b7-804e-ac2cf0909614",
                                                "text": "A double-car lineup means the third-fastest car lines up behind the pole sitter and the fourth-fastest behind the car on the outside of the front row, and so on throughout the field."
                                            },
                                            {
                                                "example_id": "1cd1942c-0beb-4267-9afe-738362534dfd",
                                                "sense_id": "db42f5bd-73a9-38b7-804e-ac2cf0909614",
                                                "text": "The lineup was then set fastest to slowest."
                                            },
                                            {
                                                "example_id": "447ed9b1-2514-47e7-8600-189b42440419",
                                                "sense_id": "db42f5bd-73a9-38b7-804e-ac2cf0909614",
                                                "text": "Next, Tuddy gave us the lineup for the next race, which would be as follows: Bud, Puck, Joey, Pepper, me, then Ty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45668805-131d-3346-a1c6-023f5153eb05",
                                        "entry_id": "32fafd4b-8e51-3b35-9482-5c9a87339c06",
                                        "glosses": [
                                            "The set of product options available from a particular manufacturer or under a particular brand name."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ffed60-e1a8-45bc-9293-4551fba5c4f6",
                                                "sense_id": "45668805-131d-3346-a1c6-023f5153eb05",
                                                "text": "The mid-size Chevelle lineup featured revised frontal styling and one new model, a Concours Estate Wagon that sported wood-grain exterior trim and a black-accented grille."
                                            },
                                            {
                                                "example_id": "5894b6bf-1b05-4c84-aeaf-8b7d0c29138a",
                                                "sense_id": "45668805-131d-3346-a1c6-023f5153eb05",
                                                "text": "If you look at its whole product lineup—cars, motorcycles, marine engines, lawn mowers , power generators, and so forth —Honda makes about 30 million engines a year worldwide."
                                            },
                                            {
                                                "example_id": "48f83c5f-590e-4507-81b1-c519b3e1bdd2",
                                                "sense_id": "45668805-131d-3346-a1c6-023f5153eb05",
                                                "text": "If you decide that part of your portfolio should be in mutual funds, you can do a lot worse than going with T. Rowe Price's lineup of entirely load-free funds."
                                            },
                                            {
                                                "example_id": "80b01997-28ea-47cb-825b-6a3f65a8c4a3",
                                                "sense_id": "45668805-131d-3346-a1c6-023f5153eb05",
                                                "text": "Let's take another example in this space looking at Dr.^([sic]) Pepper Snapple (DPS), which has a strong lineup of leading brands, including Snapple A&W Root Beer, 7UP, Hawaiian Punch, Sunkist, Country Time Lemonade, and Yoo‐hoo chocolate beverage against Monster Beverage Corporation (MNST), the high‐caffeine energy drink maker."
                                            },
                                            {
                                                "example_id": "ca2d1990-8a2a-4bc7-b205-797dc7889235",
                                                "sense_id": "45668805-131d-3346-a1c6-023f5153eb05",
                                                "text": "Starbucks has continuously reshaped its lineup, tweaking its prices and introducing new offers like the Frappuccino, the Pumpkin Spice Latte, and the Oleato. These active adjustments to its lineup allow Starbucks to continue to deliver what customers need at prices they're willing to pay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aef8e38f-144e-396f-9397-9f8d1c408bf8",
                                        "entry_id": "32fafd4b-8e51-3b35-9482-5c9a87339c06",
                                        "glosses": [
                                            "The members of a music group at any one time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11f49a20-426c-4ec7-83d8-21b2edf474ba",
                                                "sense_id": "aef8e38f-144e-396f-9397-9f8d1c408bf8",
                                                "text": "After losing half the lineup, the band went on hiatus before reemerging in late 1991 with a new lineup of Goss, bassist Googe and the legendary Ginger Baker of Cream and Blind Faith on drums."
                                            },
                                            {
                                                "example_id": "484070dd-10bc-4b14-b18a-0e9582cbcfb4",
                                                "sense_id": "aef8e38f-144e-396f-9397-9f8d1c408bf8",
                                                "text": "Honing the band's anthemic sound and stance, they relocated to Richmond and created a solid lineup."
                                            },
                                            {
                                                "example_id": "93cbd7a8-763d-44e5-8c8b-9f008d2332b4",
                                                "sense_id": "aef8e38f-144e-396f-9397-9f8d1c408bf8",
                                                "text": "Throughout their career, Pearl Jam has experienced a number of lineup changes, and the band has had several members come and go over the years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5b49f10-4fbe-3102-9610-86e6bfdfe5d8",
                                        "entry_id": "32fafd4b-8e51-3b35-9482-5c9a87339c06",
                                        "glosses": [
                                            "The acts performing at a concert or festival."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5898bb-81ee-47ed-b9ba-53b7be87157c",
                                                "sense_id": "b5b49f10-4fbe-3102-9610-86e6bfdfe5d8",
                                                "text": "As the festival grew and the lineup featured more daring works, collections exemplified trends in national playwriting rather than the producing director's personal tastes."
                                            },
                                            {
                                                "example_id": "5055a67f-f4fa-417f-b371-71f791e1438f",
                                                "sense_id": "b5b49f10-4fbe-3102-9610-86e6bfdfe5d8",
                                                "text": "Festival talent buyers can take one of several approaches in putting together their lineup. […] [H]e was very concerned about putting together a talent lineup that resonates with music lovers."
                                            },
                                            {
                                                "example_id": "5c3faf41-37d6-42fd-92e4-dd3c8c8aa0c4",
                                                "sense_id": "b5b49f10-4fbe-3102-9610-86e6bfdfe5d8",
                                                "text": "The annual festival lineup is guided in part by the festival's efforts to maintain a rough 50/50 split between northern and southern performers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb5a69d4-8ab1-3618-b797-ab84ff2d90f4",
                                        "entry_id": "32fafd4b-8e51-3b35-9482-5c9a87339c06",
                                        "glosses": [
                                            "The list of programs scheduled to be broadcast by a television station, or a position in that list."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c3cd375-8e10-43ac-90cd-c8ec4aca11b3",
                                                "sense_id": "bb5a69d4-8ab1-3618-b797-ab84ff2d90f4",
                                                "text": "In the case of Quaker Oats, which brought to us a program called \"Bewitched,\" for which we sold them the time at 9 o'clock Thursday, they selected a minimum lineup of $60,000, because that is the half-hour minimum lineup."
                                            },
                                            {
                                                "example_id": "06ee530f-863a-4921-bdff-9606928167a9",
                                                "sense_id": "bb5a69d4-8ab1-3618-b797-ab84ff2d90f4",
                                                "text": "Currently ABC's linkage with parent Disney has paid off on Saturday morning, with a 3-hour lineup of shows from Disney-owned studios. CBS has a Saturday-morning lineup of shows produced by Cookie Jar Entertainment and NBC's programming is produced by QUBO."
                                            },
                                            {
                                                "example_id": "aff6c309-5c6e-4e29-a8ca-2eb6bc956f93",
                                                "sense_id": "bb5a69d4-8ab1-3618-b797-ab84ff2d90f4",
                                                "text": "First, it moved the original Mystery Movie lineup of Columbo, McCloud, and McMillan and Wife to the highly competitive Sunday night schedule and, as a fourth installment to this rotation, added Hec Ramsey, starring Richard Boone as a turn-of-the-century western crime fighter."
                                            },
                                            {
                                                "example_id": "dab45675-18ce-45f0-ac00-3400fa8995f3",
                                                "sense_id": "bb5a69d4-8ab1-3618-b797-ab84ff2d90f4",
                                                "text": "Joining the long list of returning shows, CBS also revives “CSI” as “CSI: Vegas” with several familiar faces and a few new ones, joining spinoffs “FBI: International” and “NCIS: Hawaii,” in a lineup that again looks as if it gets a discount on abbreviated titles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0759d9b8-aa73-4828-95ea-138127a22169",
                        "source_entry_id": "649c2c4e-3e93-3aa9-8dfd-0dd981dd0ee5",
                        "source_sense_id": "40673203-bb03-3cbf-a31d-3fc21f6c1f6e",
                        "target_lang_word": "line-up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "line-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a24b8e4-dd81-3b6e-bdd7-3d105d7b700c",
                                        "entry_id": "03eb07ca-b269-3246-9f1c-886aa5e23fe1",
                                        "glosses": [
                                            "Alternative spelling of lineup."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1edf15f-c52d-4076-a6ad-fb8f5eaf028b",
                                                "sense_id": "5a24b8e4-dd81-3b6e-bdd7-3d105d7b700c",
                                                "text": "The result in Greece meant Tottenham could not progress, no matter how many goals they scored against Rovers but, after making nine changes to his starting line-up, Harry Redknapp will be pleased with the performance of his fringe players."
                                            },
                                            {
                                                "example_id": "3040fdde-fb7a-4311-a786-15b55fdbef7d",
                                                "sense_id": "5a24b8e4-dd81-3b6e-bdd7-3d105d7b700c",
                                                "text": "The railway faces a line-up of strong-willed metro mayors with four-year terms and a new big-majority government covering the same period."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "451c0a4d-c5a5-4bcd-9002-9421b2ebace0",
                        "source_entry_id": "649c2c4e-3e93-3aa9-8dfd-0dd981dd0ee5",
                        "source_sense_ids": [
                            "40673203-bb03-3cbf-a31d-3fc21f6c1f6e"
                        ],
                        "linkage_type": "synonyms",
                        "word": "rangschikking"
                    },
