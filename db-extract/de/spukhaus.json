                ],
                "senses": [
                    {
                        "sense_id": "6de90ec9-5006-32df-a7c6-e0a572b357db",
                        "entry_id": "0c991de7-f612-3bfb-8157-b728204b918c",
                        "glosses": [
                            "Haus, in dem es spukt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "306509ec-8411-4ada-8cb1-5761abea2438",
                                "sense_id": "6de90ec9-5006-32df-a7c6-e0a572b357db",
                                "text": "„Tollington Place 65 war ein Spukhaus, und keiner konnte sich lang drin behaupten, ohne allmählich verrückt zu werden.“"
                            },
                            {
                                "example_id": "ac996a43-0b4d-4fd6-945d-2b1d9eec5793",
                                "sense_id": "6de90ec9-5006-32df-a7c6-e0a572b357db",
                                "text": "„Die erschütterten Siedler brachten das Grauen sogleich mit dem Spukhaus der Martenses in Verbindung, auch wenn der Tatort mehr als fünf Kilometer davon entfernt lag.“"
                            },
                            {
                                "example_id": "54c9b9b2-e786-439a-90fd-5472693a4f67",
                                "sense_id": "6de90ec9-5006-32df-a7c6-e0a572b357db",
                                "text": "„»Aber Sie sagten doch, dass Sie gerne ein Spukhaus hätten.«“"
                            },
                            {
                                "example_id": "2a070958-1ae5-4260-9dce-f8d8cc4e9e1d",
                                "sense_id": "6de90ec9-5006-32df-a7c6-e0a572b357db",
                                "text": "„Der Text lautet: ‹Hat man Ihnen ein Spukhaus verkauft? Falls ja, rufen Sie bitte die folgende Nummer an, um sich an einer Sammelklage zu beteiligen.›“"
                            },
                            {
                                "example_id": "7247ae55-59b3-400f-9960-70feae770e68",
                                "sense_id": "6de90ec9-5006-32df-a7c6-e0a572b357db",
                                "text": "„Ein ›Spukhaus‹ gibt es fast in jedem Ort im Süden, und um jedes einzelne ranken sich unzählige Legenden.“"
                            },
                            {
                                "example_id": "3c8e1b2a-001e-4c08-88f2-eec1e7d042b1",
                                "sense_id": "6de90ec9-5006-32df-a7c6-e0a572b357db",
                                "text": "„Mir wurde klar, dass viele örtliche Legenden über das verlassene Bishop-Haus entstanden sein mussten. Was wäre natürlicher, als es als Spukhaus anzusehen?“"
                            },
                            {
                                "example_id": "7c9e3c37-a428-44b8-8997-57242c3600ac",
                                "sense_id": "6de90ec9-5006-32df-a7c6-e0a572b357db",
                                "text": "„›Es ist ein Spukhaus. Was soll es sont sein?‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
