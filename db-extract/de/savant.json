                "senses": [
                    {
                        "sense_id": "41ae3359-28bd-3113-ba5a-d53cabe0d990",
                        "entry_id": "5ca4cd85-5af1-3e9f-b55b-edef6c12343c",
                        "glosses": [
                            "in eine bestimmte Richtung sehr begabte Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f2b8e9-23fe-4f57-b064-bf43e4da66ed",
                                "sense_id": "41ae3359-28bd-3113-ba5a-d53cabe0d990",
                                "text": "„Tammet ist ein Inselbegabter, ein Savant.“"
                            },
                            {
                                "example_id": "5d3b5ba2-a719-452c-bb11-edab5d70e39a",
                                "sense_id": "41ae3359-28bd-3113-ba5a-d53cabe0d990",
                                "text": "„Allein – das Vorbild für die Rolle war gar kein Autist, sagt Linke. Sondern ein Savant, ein Mensch mit einer Inselbegabung – und bei Weitem nicht repräsentativ für Autisten.“"
                            },
                            {
                                "example_id": "2795db8c-ccfb-4848-a9ee-acf462f512f9",
                                "sense_id": "41ae3359-28bd-3113-ba5a-d53cabe0d990",
                                "text": "„Etwa einer von zehn Autisten ist ein Savant; und laut Schätzungen sind mehr als die Hälfte aller Savants Autisten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "961279c6-b100-45bd-b11f-0948c72f0a6a",
