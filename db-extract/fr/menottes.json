                    {
                        "translation_id": "751c8aa9-20b6-4a6b-874d-49cbc631afcc",
                        "source_entry_id": "6ddc95fd-6e5a-3465-ad5b-e9e41f3dfe88",
                        "source_sense_id": "ba7342da-284a-3cdc-8c9c-84d6c4d8d25b",
