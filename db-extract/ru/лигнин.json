                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86e92962-fcc6-376e-957d-61f9660a6a17",
                                        "entry_id": "bea74877-5b9e-3a01-8718-937012249a49",
                                        "glosses": [
                                            "farbloses, feststoffartiges Biopolymer, das Bestandteil der Zellwand von Pflanzen ist und die Verholzung derer Zellen bewirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc203c8-a120-4b34-a03f-1c19e11d9e24",
                                                "sense_id": "86e92962-fcc6-376e-957d-61f9660a6a17",
                                                "text": "„So stammt Vanillearoma etwa aus Lignin, das in Zellwänden vorkommt, also in Hölzern.“"
                                            },
                                            {
                                                "example_id": "c9f11473-dedd-4156-b880-8a15bf2317b8",
                                                "sense_id": "86e92962-fcc6-376e-957d-61f9660a6a17",
                                                "text": "„Getestet werden auch Pflanzen die einen geringeren Ligninanteil haben. Lignin stört bei der Papierherstellung.“"
                                            },
                                            {
                                                "example_id": "b50d015d-5ebd-4cab-8229-ff58bff7fba7",
                                                "sense_id": "86e92962-fcc6-376e-957d-61f9660a6a17",
                                                "text": "„Ganz anders zeigte sich erst hundert Jahre nach der Erfindung des Holzschliffs, dass das darin enthaltene Lignin nicht altersbeständig ist, sondern im Laufe relativ kurzer Zeit brüchig bis zur Zerstörung des Papiers wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be7e07ec-ba1f-4c7a-a8a8-eeb540bb3fa1",
                        "source_entry_id": "8f7f70da-9748-3913-88b2-30adbcc25bdb",
