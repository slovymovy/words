                    {
                        "translation_id": "a7709bc3-f8b0-4e1f-9e3e-1fc74496109a",
                        "source_entry_id": "4d1b6731-ee93-31d3-8b6c-d7f8462f6e8f",
                        "source_sense_id": "1077a12e-4aa5-3b2b-a6c4-b8d851792110",
