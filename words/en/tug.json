{
    "word_family": [
        "tugboat",
        "tugger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54c22146-52ce-3d3d-b689-ec5fa45be0a0",
                    "sense_definition": "To pull or drag with great effort or force.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>tug</w> the heavy suitcase through the narrow hallway. ",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>протащить</w> тяжелый чемодан через узкий коридор."
                            }
                        },
                        {
                            "text": "She had to <w>tug</w> hard to open the rusty metal gate.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось сильно <w>потянуть</w>, чтобы открыть ржавые металлические ворота."
                            }
                        }
                    ],
                    "synonyms": [
                        "haul",
                        "drag",
                        "pull"
                    ],
                    "antonyms": [
                        "push"
                    ],
                    "common_phrases": [
                        "tug hard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тянуть или тащить с большим усилием или силой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тягивать",
                                "target_lang_sense_clarification": "тянуть с усилием"
                            },
                            {
                                "target_lang_word": "тянуть",
                                "target_lang_sense_clarification": "прилагать усилие, чтобы переместить"
                            },
                            {
                                "target_lang_word": "тащить",
                                "target_lang_sense_clarification": "перемещать с трудом или волоком"
                            },
                            {
                                "target_lang_word": "потянуть",
                                "target_lang_sense_clarification": "поволочь или сделать усилие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b5221e9-0243-3dc8-9d93-eaf75649ae6f",
                    "sense_definition": "To pull sharply or repeatedly at something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little child began to <w>tug</w> at his mother's sleeve to get her attention.",
                            "target_lang_translations": {
                                "ru": "Маленький ребенок стал <w>дёргать</w> маму за рукав, чтобы привлечь её внимание."
                            }
                        },
                        {
                            "text": "She felt the dog <w>tug</w> at the leash during their evening walk.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала, как собака <w>потянула</w> за поводок во время вечерней прогулки."
                            }
                        }
                    ],
                    "synonyms": [
                        "yank",
                        "pluck"
                    ],
                    "common_phrases": [
                        "tug at",
                        "tug on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко или неоднократно дёргать за что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дёргать",
                                "target_lang_sense_clarification": "тянуть рывками или неоднократно"
                            },
                            {
                                "target_lang_word": "дёрнуть",
                                "target_lang_sense_clarification": "сделать однократный рывок"
                            },
                            {
                                "target_lang_word": "потягивать",
                                "target_lang_sense_clarification": "слегка подёргивать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56e5ed56-195a-3287-a83d-4c7a9601f886",
                    "sense_definition": "To tow a vessel using a tugboat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small boat had to <w>tug</w> the large ship safely into the harbor.",
                            "target_lang_translations": {
                                "ru": "Маленькому катеру пришлось <w>буксировать</w> большое судно в безопасную гавань."
                            }
                        },
                        {
                            "text": "Two boats were needed to <w>tug</w> the damaged vessel across the bay.",
                            "target_lang_translations": {
                                "ru": "Понадобилось два катера, чтобы <w>отбуксировать</w> поврежденное судно через залив."
                            }
                        }
                    ],
                    "synonyms": [
                        "tow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Буксировать судно с помощью буксира."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буксировать",
                                "target_lang_sense_clarification": "тянуть другое судно на буксире"
                            },
                            {
                                "target_lang_word": "отбуксировать",
                                "target_lang_sense_clarification": "доставить или переместить на буксире"
                            },
                            {
                                "target_lang_word": "тянуть на буксире",
                                "target_lang_sense_clarification": "вести судно за собой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ce527bd-1819-3ff5-b463-fa84576d5efe",
                    "sense_definition": "A sudden, strong pull.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a sudden <w>tug</w> on her bag while standing in the crowded train.",
                            "target_lang_translations": {
                                "ru": "Она ощутила внезапный <w>рывок</w> своей сумки, стоя в переполненном поезде."
                            }
                        },
                        {
                            "text": "With a quick <w>tug</w>, he managed to free the stuck rope.",
                            "target_lang_translations": {
                                "ru": "Быстрым <w>рывком</w> ему удалось освободить застрявшую веревку."
                            }
                        }
                    ],
                    "synonyms": [
                        "jerk",
                        "yank",
                        "pull"
                    ],
                    "antonyms": [
                        "push"
                    ],
                    "common_phrases": [
                        "sharp tug",
                        "quick tug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное, резкое или сильное движение на себя; рывок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рывок",
                                "target_lang_sense_clarification": "резкое и сильное движение на себя"
                            },
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "резкое усилие"
                            },
                            {
                                "target_lang_word": "потягивание",
                                "target_lang_sense_clarification": "легкое утягивающее движение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25b6d3bc-0567-31fb-94f3-c0a22dac738e",
                    "sense_definition": "A small, powerful boat used for maneuvering larger vessels; a tugboat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small <w>tug</w> guided the massive cargo ship into the busy port.",
                            "target_lang_translations": {
                                "ru": "Небольшой <w>буксир</w> провел массивное грузовое судно в оживленный порт."
                            }
                        },
                        {
                            "text": "We watched the harbor <w>tug</w> pull the cruise liner away from the dock.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как портовый <w>буксир</w> оттягивает круизный лайнер от причала."
                            }
                        }
                    ],
                    "synonyms": [
                        "tugboat"
                    ],
                    "common_phrases": [
                        "harbor tug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое мощное судно, используемое для маневрирования и перемещения крупных судов; буксир."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буксир",
                                "target_lang_sense_clarification": "судно для буксировки"
                            },
                            {
                                "target_lang_word": "буксирное судно",
                                "target_lang_sense_clarification": "специальное судно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d727e75-accd-36f5-bbc3-ba93b353271c",
                    "sense_definition": "A dog toy made of rope, often with knots, used for playing tug-of-war.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy played with its new rope <w>tug</w> in the backyard.",
                            "target_lang_translations": {
                                "ru": "Щенок играл со своим новым канатным <w>грейфером</w> на заднем дворе."
                            }
                        },
                        {
                            "text": "She bought a durable rope <w>tug</w> for her dog at the pet store.",
                            "target_lang_translations": {
                                "ru": "Она купила прочную игрушку-<w>перетягивалку</w> из каната для своей собаки в зоомагазине."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rope tug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Игрушка для собак из каната (часто с узлами), используемая для игры в перетягивание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канатик",
                                "target_lang_sense_clarification": "веревочная игрушка для собак"
                            },
                            {
                                "target_lang_word": "игрушка-перетягивалка",
                                "target_lang_sense_clarification": "игрушка для игры в перетягивание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}