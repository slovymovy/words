                "senses": [
                    {
                        "sense_id": "529bcf18-1c3d-353a-8704-d86d9889f8bc",
                        "entry_id": "eefefdee-9b49-3cb5-8410-1e50b219de58",
                        "glosses": [
                            "eine nicht isolierte Stromleitung, an der die Potentialausgleichsleiter angeklemmt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a1242e9-22fe-4dab-97bb-28244b4ff439",
                                "sense_id": "529bcf18-1c3d-353a-8704-d86d9889f8bc",
                                "text": "„Eine Potentialausgleichsschiene (PAS) ist eine Verbindungsschiene für den inneren Blitzschutz, die bei Blitzeinschlag Spannungsunterschiede mit möglichen Spannungsüberschlägen verhindert.“"
                            },
                            {
                                "example_id": "43a1878f-00ca-415a-99be-3fcc6df8d1e4",
                                "sense_id": "529bcf18-1c3d-353a-8704-d86d9889f8bc",
                                "text": "„Potentialausgleichsschienen und Erdungsschienen für den Potentialausgleich von fremden, leitfähigen Teilen nach VDE 0100 sowie den Blitzschutz-Potentialausgleich nach DIN EN 62305-3.“"
                            },
                            {
                                "example_id": "b7ca08a1-c46b-4b2f-8947-c8e629bdd074",
                                "sense_id": "529bcf18-1c3d-353a-8704-d86d9889f8bc",
                                "text": "„Bei großen baulichen Anlagen können mehrere Potentialausgleichsschienen installiert sein, vorausgesetzt, sie werden miteinander verbunden.“"
                            },
                            {
                                "example_id": "44b2404d-5553-4b1e-adf5-2e8cc812aae3",
                                "sense_id": "529bcf18-1c3d-353a-8704-d86d9889f8bc",
                                "text": "„In diesem Zusammenhang werden an die Potentialausgleichsschiene alle Geräte und alle Gegenstände angeschlossen, die elektrischen Strom leiten können.“"
                            },
                            {
                                "example_id": "53d91e6f-4361-4314-9369-bac0d47cb9dc",
                                "sense_id": "529bcf18-1c3d-353a-8704-d86d9889f8bc",
                                "text": "„Die Potentialausgleichsschiene (PAS) dient zur elektrisch leitenden Verbindung aller Potentialausgleichsleitungen mit dem Fundamenterder und weiteren Rohrleitungen und Metallteilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
