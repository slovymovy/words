                        "entry_id": "2d8e2e05-c6e0-31e0-a543-e396a596d9cc",
                        "glosses": [
                            "A statement about or prior knowledge of the future."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c8d4f19a-7d29-42c2-9029-3c54e9f22bb0",
                                "sense_id": "8258e08b-8b46-3baf-a8f6-debbc467e139",
                                "text": "She could have joined most comfortably in all their supposings, and suspicions, and doubts, and prognostications, but the honour of the family was too nearly concerned to allow free reins to her tongue."
                            },
                            {
                                "example_id": "6b2a8ff6-9597-46ba-8350-db8e4b7285a9",
                                "sense_id": "8258e08b-8b46-3baf-a8f6-debbc467e139",
                                "text": "Today is that most sacred of American holidays. A day when people from all walks of life set aside their differences and focus their undivided attention on the prognostication abilities of a subterranean rodent."
                            }
                        ]
                    }
                ],
                "translations": [
