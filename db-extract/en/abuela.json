                        "glosses": [
                            "A Hispanic grandmother."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a80c5b87-ba0e-4531-a046-43d8f3badf5d",
                                "sense_id": "fd7b5655-838f-389a-86fc-910f1417aa61",
                                "text": "I, an abuela-aged woman of Northern European ancestry, have lived within 50 miles of the Mexican border most of my life. Mexican culture is part of my life as much as any of my DNA cultures, if not more, and I love it all."
                            },
                            {
                                "example_id": "294fda94-c496-45d3-8100-724eeb3b53e5",
                                "sense_id": "fd7b5655-838f-389a-86fc-910f1417aa61",
                                "text": "8 a.m. Wake up early for breakfast at an abuela’s house"
                            },
                            {
                                "example_id": "ff35601f-ff97-413f-82d0-4efb40a7a3e0",
                                "sense_id": "fd7b5655-838f-389a-86fc-910f1417aa61",
                                "text": "[L]ook no further than this week’s surreal exchange between Sen. Josh Hawley and a Berkeley law professor insisting that men can and do get pregnant. Yes, that happened, in a Senate hearing. You say that to an abuela, and the most likely response will be “que?” followed by a quick “adios!”"
                            },
                            {
                                "example_id": "a5a8a789-3566-48c9-b6a1-777f5a492ea9",
                                "sense_id": "fd7b5655-838f-389a-86fc-910f1417aa61",
                                "text": "On the east side of San Jose, Calif., there is an abuela who seems to have more grandchildren than she can count."
                            },
                            {
                                "example_id": "1bc575e9-f869-4bf8-8c00-92b2912519c6",
                                "sense_id": "fd7b5655-838f-389a-86fc-910f1417aa61",
                                "text": "Together, the abuelas wrote pleading letters to international organizations and the pope, and posed as baby supply saleswomen and housekeepers to more closely surveil children they thought might be their relations."
                            }
                        ]
                    }
