                {
                    "sense_id": "d8a2d266-719c-385a-81ac-6aa5c9fbdeb2",
                    "sense_definition": "jemanden vorläufig von seinen dienstlichen Pflichten oder einem Amt freistellen bzw. entbinden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Dienstentbindung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach den schweren Vorwürfen wurde der Beamte sofort vom Dienst <w>suspendiert</w>."
                        },
                        {
                            "text": "Die Schulleitung beschloss, den Schüler für zwei Wochen vom Unterricht zu <w>suspendieren</w>."
                        }
                    ],
                    "synonyms": [
                        "beurlauben",
                        "entheben",
                        "freistellen"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "vom Dienst suspendieren",
                        "vorläufig suspendieren"
                    ]
                },
                {
                    "sense_id": "8d3bb35a-5711-3f0d-b297-a41f78597a7d",
                    "sense_definition": "eine Regelung, ein Verfahren oder eine Vereinbarung zeitweilig außer Kraft setzen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "Aussetzung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die beiden Staaten vereinbarten, das gemeinsame Abkommen bis auf Weiteres zu <w>suspendieren</w>."
                        },
                        {
                            "text": "Wegen der schweren Krise wurden die strengen Haushaltsregeln vorübergehend <w>suspendiert</w>."
                        }
                    ],
                    "synonyms": [
                        "aussetzen",
                        "außer Kraft setzen"
                    ],
                    "common_phrases": [
