                "translations": [
                    {
                        "translation_id": "bb6edbd9-0a22-42e9-bf93-03637d0733cd",
                        "source_entry_id": "9cc77704-359e-33a7-b579-34e087406236",
                        "source_sense_id": "14f0bbe8-f6ee-3010-b671-f2e23727937e",
                        "source_sense_description": "Kabinen oder Sessel, die an einem Förderseil hängend bewegt werden",
                        "target_lang_word": "Seilbahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seilbahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86e844d7-1519-32c6-b6fd-e66c91358ddd",
                                        "entry_id": "9a1fad08-bef3-3df5-8e9c-cc64b1a02938",
                                        "glosses": [
                                            "Schwebebahn, deren Gondel an einem Hochseil befestigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52052313-0a89-40e6-a156-d3b87e4eb57f",
                                                "sense_id": "86e844d7-1519-32c6-b6fd-e66c91358ddd",
                                                "text": "Die Seilbahn verbindet das Tal mit dem Berggipfel."
                                            },
                                            {
                                                "example_id": "52abd94b-79c1-4f9c-a587-92642df42836",
                                                "sense_id": "86e844d7-1519-32c6-b6fd-e66c91358ddd",
                                                "text": "„Die Umsetzung einer Seilbahn mit Kapazitäten von 7.600 Personen pro Stunde ist im städtischen Raum bislang einzigartig und stellt damit ein Vorzeigeprojekt dar.“"
                                            },
                                            {
                                                "example_id": "0cecbe5f-d3d6-40db-b3dc-14bc544bbd58",
                                                "sense_id": "86e844d7-1519-32c6-b6fd-e66c91358ddd",
                                                "text": "„Weil die Anbindung ans öffentliche Verkehrsnetz nicht gut ist, will Düsterdick eine Seilbahn bauen, mit Gondeln, bis rüber zur S-Bahn-Station Vaihingen.“"
                                            },
                                            {
                                                "example_id": "a5f68bf1-d605-4384-83b1-87a703fab46d",
                                                "sense_id": "86e844d7-1519-32c6-b6fd-e66c91358ddd",
                                                "text": "„Heute ist die Seilbahn weiterhin eine Attraktion.“"
                                            },
                                            {
                                                "example_id": "55664c01-917c-4ae5-b8a8-e7d9f07e7a7c",
                                                "sense_id": "86e844d7-1519-32c6-b6fd-e66c91358ddd",
                                                "text": "„Auch gibt es eine Seilbahn, die über den Rhein schwebt, hin und zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
