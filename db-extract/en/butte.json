                    {
                        "form_id": "16c32b40-b767-4107-b574-9cdea862e357",
                        "entry_id": "59a3ce06-8c4a-3534-ae4c-77598ba8f9c9",
                        "tags": [
                            "plural"
                        ],
                        "form": "buttes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dfa92274-baf6-3a1b-af86-97ef1e9629b4",
                        "entry_id": "59a3ce06-8c4a-3534-ae4c-77598ba8f9c9",
                        "glosses": [
                            "An isolated hill with steep sides and a flat top."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "ea7e6d98-8c57-419b-bf89-522a9297a9d3",
                                "sense_id": "dfa92274-baf6-3a1b-af86-97ef1e9629b4",
                                "text": "Those multitoned buttes and mesas [of the Grand Canyon], and that incandescent sequence of colorful bands that make one of the natural wonders of the world so grand, can also be found over 100 million miles away [on Mars]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "274539e5-a300-4ed0-b284-a0d7392d9ee4",
                        "source_entry_id": "59a3ce06-8c4a-3534-ae4c-77598ba8f9c9",
                        "source_sense_id": "dfa92274-baf6-3a1b-af86-97ef1e9629b4",
                        "source_sense_description": "hill",
                        "target_lang_word": "butte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "butte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e85397ba-cbc4-3bca-bd8d-e79838785a4f",
                                        "entry_id": "07f98df3-5b2e-3ab3-afa1-17d033a019e5",
                                        "glosses": [
                                            "Petit tertre, petite colline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "668cf549-c6ed-41a5-aef4-af9ea06e951c",
                                                "sense_id": "e85397ba-cbc4-3bca-bd8d-e79838785a4f",
                                                "text": "Habituellement les terrains mouilleux qu’on veut planter sont assainis au préalable et le creusement des fossés de drainage sert à faire des buttes ou des remblais."
                                            },
                                            {
                                                "example_id": "02e38adb-b0cf-42ce-a034-b51a18209054",
                                                "sense_id": "e85397ba-cbc4-3bca-bd8d-e79838785a4f",
                                                "text": "La ferme Navarin, les buttes de Souain, du mont Muret, de Tahure et du Mesnil, les villages de Tahure, Ripont, Rouvroy, Cernay-en-Dormois, Servon-Melzicourt, organisés en points d'appui et opiniâtrement défendus par l'ennemi, ont été conquis de haute lutte dans la première journée de la bataille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c627743-ea43-3011-ab77-4d46e624973a",
                                        "entry_id": "07f98df3-5b2e-3ab3-afa1-17d033a019e5",
                                        "glosses": [
                                            "Massif de terre où l’on place le but pour tirer et viser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86a7ccd5-be07-40f2-bc4a-fc788a7cbf0e",
                                                "sense_id": "7c627743-ea43-3011-ab77-4d46e624973a",
                                                "text": "La butte du polygone pour le tir de l’artillerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5a2ef79-3fb1-3bff-a2e7-a4f2e291a4fe",
                                        "entry_id": "07f98df3-5b2e-3ab3-afa1-17d033a019e5",
                                        "glosses": [
                                            "Cible, victime."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eb5e2e6-5567-49ed-ab38-a9a2a4dc6f74",
                                                "sense_id": "b5a2ef79-3fb1-3bff-a2e7-a4f2e291a4fe",
                                                "text": "Ils n’ont du mouvement ni des yeux que pour vous, Seul la butte, l’objet et l’estime de tous."
                                            },
                                            {
                                                "example_id": "4b7ba9f1-77b4-41b4-b4a9-fe1cbcf67cbc",
                                                "sense_id": "b5a2ef79-3fb1-3bff-a2e7-a4f2e291a4fe",
                                                "text": "Le pauvre Brutus eût été la butte de toutes les pointes de son temps."
                                            },
                                            {
                                                "example_id": "4e505f5f-7ac6-4223-b21e-e3b8dc803dbb",
                                                "sense_id": "b5a2ef79-3fb1-3bff-a2e7-a4f2e291a4fe",
                                                "text": "Qu’ils soient au lieu de moi, le reste de leurs ans, La butte du mépris dont ils m’ont fait la proie."
                                            },
                                            {
                                                "example_id": "d6c0e60b-1cd9-41bf-80d2-7ad1a71a96f9",
                                                "sense_id": "b5a2ef79-3fb1-3bff-a2e7-a4f2e291a4fe",
                                                "text": "C’est pourquoy maintenant je m’expose au vulgaire,\nEt me donne pour butte aux jugements divers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94f59abf-91fc-3c5d-a777-b17146a657d0",
                                        "entry_id": "07f98df3-5b2e-3ab3-afa1-17d033a019e5",
                                        "glosses": [
                                            "Jeu des chevaliers de l’arquebuse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "073bcea5-8668-3b32-b534-da8478122f8e",
                                        "entry_id": "07f98df3-5b2e-3ab3-afa1-17d033a019e5",
                                        "glosses": [
                                            "Poteau de soutènement, d'étai, utilisé dans les galeries de mine pour soutenir le chapeau quand la galerie est large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f6be45d-5af4-49b7-92fd-5432950dcd65",
                                                "sense_id": "073bcea5-8668-3b32-b534-da8478122f8e",
                                                "text": "L'étai le plus simple est la butte."
                                            },
                                            {
                                                "example_id": "d14ec4ab-cbaf-4f8f-92c0-9eca35a5cc55",
                                                "sense_id": "073bcea5-8668-3b32-b534-da8478122f8e",
                                                "text": "BUTTE: En terme minier, étai en bois pour soutènement ponctuel ou renforcement de soutènement. (Syn.): Button (et Étai)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f51ecfe-992b-3072-9d25-a142a06fe428",
                                        "entry_id": "07f98df3-5b2e-3ab3-afa1-17d033a019e5",
                                        "glosses": [
                                            "Un des types d'obstacle figurant dans les courses de steeple-chase."
                                        ],
                                        "tags": [
                                            "Sports hippiques"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
