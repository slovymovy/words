                "senses": [
                    {
                        "sense_id": "78edf0ea-acfd-36fa-b630-008fe97a3af3",
                        "entry_id": "7516e86e-ee18-30c0-8e9e-82456d9e34b1",
                        "glosses": [
                            "Variante non standard de stationner, garer son véhicule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "075aae7b-5fb7-4522-91ba-2d26e53b0585",
                                "sense_id": "78edf0ea-acfd-36fa-b630-008fe97a3af3",
                                "text": "Prétextant son mi-chemin sur le tronçon, il imagine l’âne de Burideau, un meunier des environs, hésitant à choisir sa destination entre Saintes et Cognac et préférant finalement estationner à Rouffiat…"
                            },
                            {
                                "example_id": "c9172042-55e9-43ab-95e3-a2cd8462d55b",
                                "sense_id": "78edf0ea-acfd-36fa-b630-008fe97a3af3",
                                "text": "Une pompe américaine noire est venue estationner derrière ta tire juste immédiatement aussitôt après que tu l’eusses quittée."
                            },
                            {
                                "example_id": "59a85d1e-ab84-427d-af38-41b78fc3d853",
                                "sense_id": "78edf0ea-acfd-36fa-b630-008fe97a3af3",
                                "text": "Pis l’estationnent au Casino Gratis, un vrai joke."
                            },
                            {
                                "example_id": "3d13a2e9-4478-4788-8bef-ccbd99d70335",
                                "sense_id": "78edf0ea-acfd-36fa-b630-008fe97a3af3",
                                "text": "Du monde sont arrivé : des agents qui sondaient pour s’assurer qu’ personne v’nait lutiner les voitures estationnées."
                            }
                        ]
                    }
                ],
