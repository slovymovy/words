                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sweater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e708f7b3-b58a-329e-9b5f-b79b89e74eab",
                                        "entry_id": "59228088-7b2a-3c12-8bce-23a63067eb23",
                                        "glosses": [
                                            "A knitted jacket or jersey, usually of thick wool, worn by athletes before or after exercise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ad6cc5a-d01b-38dd-92af-e9a8cb2e30ac",
                                        "entry_id": "59228088-7b2a-3c12-8bce-23a63067eb23",
                                        "glosses": [
                                            "A similar garment worn for warmth."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec2ea162-18b6-464d-8a3e-3f8deec0879a",
                                                "sense_id": "1ad6cc5a-d01b-38dd-92af-e9a8cb2e30ac",
                                                "text": "We could slip away / Wouldn't that be better? / Me with nothing to say / And you in your autumn sweater"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c0a9206-a59f-32eb-8b33-eea9c391cf3c",
                                        "entry_id": "59228088-7b2a-3c12-8bce-23a63067eb23",
                                        "glosses": [
                                            "One who sweats (produces sweat)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c00d2f-c3dc-4068-91d5-a98912cf177e",
                                                "sense_id": "2c0a9206-a59f-32eb-8b33-eea9c391cf3c",
                                                "text": "The cardiologist who administered Alex's exercise stress test on August 21 observed during that test that Alex was a profuse sweater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e1032e-60b4-3c35-a720-6b6f64c7b08d",
                                        "entry_id": "59228088-7b2a-3c12-8bce-23a63067eb23",
                                        "glosses": [
                                            "One who or that which causes to sweat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e5bd2f7-4bf8-41d8-aa97-df38e7a8e7a0",
                                                "sense_id": "23e1032e-60b4-3c35-a720-6b6f64c7b08d",
                                                "text": "We learn of the cruelty of some school or child-factory from journalists; we learn it from inspectors, we learn it from doctors, we learn it even from shame-stricken schoolmasters and repentant sweaters; but we never learn it from the children; we never learn it from the victims."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcec2aa3-c45b-3020-a42f-e8de1db68916",
                                        "entry_id": "59228088-7b2a-3c12-8bce-23a63067eb23",
                                        "glosses": [
                                            "A diaphoretic remedy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75aaa74a-d514-30e5-8f77-98ae45cb3718",
                                        "entry_id": "59228088-7b2a-3c12-8bce-23a63067eb23",
                                        "glosses": [
                                            "An exploitative middleman who subcontracted piece work in the tailoring trade."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "068c0df0-ca44-4591-b5bf-a5e9247321f1",
                                                "sense_id": "75aaa74a-d514-30e5-8f77-98ae45cb3718",
                                                "text": "If the piecework system had not existed there never would have been any sweatees. The men who are sweaters, I am sorry to say, are men who formerly belonged to our union."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e779925e-56b6-37f8-ac97-962ac8a17435",
                                        "entry_id": "59228088-7b2a-3c12-8bce-23a63067eb23",
                                        "glosses": [
                                            "One who sweats coins, i.e. removes small portions by shaking them."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b30f6cd2-edfd-3a48-b17d-48ee222a7a12",
                                        "entry_id": "59228088-7b2a-3c12-8bce-23a63067eb23",
                                        "glosses": [
                                            "A London street ruffian in Queen Anne's time who prodded passers-by with his sword-point."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aa72428-5726-4987-8313-66f46d6c1909",
                                                "sense_id": "b30f6cd2-edfd-3a48-b17d-48ee222a7a12",
                                                "text": "Among them were the \"sweaters\" who formed a circle round their prisoner and pricked him with their swords until he sank exhausted to the ground, […]"
                                            }
                                        ]
                                    }
                                ]
