                "senses": [
                    {
                        "sense_id": "5bf783b6-c274-3a77-b18f-03152816fb1d",
                        "entry_id": "d0dcaa80-0953-300b-bcd7-cc4f79beb537",
                        "glosses": [
                            "US-amerikanischer Fahrzeughersteller"
                        ],
                        "tags": [
                            "ohne Genus, ohne Plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b9026ee-d673-3c64-abf5-5b5c97b3d325",
                        "entry_id": "d0dcaa80-0953-300b-bcd7-cc4f79beb537",
                        "glosses": [
                            "Fahrzeug von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7dbcc65-b86e-45d1-93da-4ea6bc53e579",
                                "sense_id": "6b9026ee-d673-3c64-abf5-5b5c97b3d325",
                                "text": "„Sie durchquerten das Land in Ninos kirschrotem Cadillac, hielten mehrmals am Tag für Hamburger und Steaks an Truckerbuden, begnügten sich die restliche Zeit mit Chips, Wiener Würstchen und Sardinen.“"
                            },
                            {
                                "example_id": "5bd0c906-feb5-4871-ab33-2d31ddc43862",
                                "sense_id": "6b9026ee-d673-3c64-abf5-5b5c97b3d325",
                                "text": "„In dem Moment schaute ich aus dem Fenster und sah meinen Cadillac, der am Gehsteig parkte.“"
                            },
                            {
                                "example_id": "0faa9139-eb3d-4e0c-93c4-271a56fa08b0",
                                "sense_id": "6b9026ee-d673-3c64-abf5-5b5c97b3d325",
                                "text": "„Aber die fette Federung des Cadillac schien die Schlaglöcher auszufüllen und die Unebenheiten auszubügeln, während er die S Street hinunter glitt, die 32nd nutzte, um zur R Street überzuwechseln, und weiter nach Osten an Dumbarton Oaks, Montrose Park und dem Oak Hill Cemetery vorbeifuhr, der bergab verläuft, um auf den Rock Creek Park zu treffen.“"
                            },
                            {
                                "example_id": "e218d910-8c39-4902-9753-380bccfd7660",
                                "sense_id": "6b9026ee-d673-3c64-abf5-5b5c97b3d325",
                                "text": "„Er hatte ein schönes Haus und einen fast neuen Cadillac, mit dem er jeden Morgen zu seinem kleinen Laden in Queens fuhr.“"
                            },
                            {
                                "example_id": "d4ae12ec-84cb-40de-b528-315eabb4c5c2",
                                "sense_id": "6b9026ee-d673-3c64-abf5-5b5c97b3d325",
                                "text": "„Kimmer ist mit dem mitternachtsblauen Cadillac ihrer Mutter in die Stadt gefahren, deshalb nehmen Bentley und ich für die fünfminütige Fahrt die Sixteenth Street hinunter zur Shepard Street unseren Leihwagen, einen prosaischen weißen Taurus.“"
                            },
                            {
                                "example_id": "832e0758-4763-4646-92e5-61caebf34018",
                                "sense_id": "6b9026ee-d673-3c64-abf5-5b5c97b3d325",
                                "text": "„Er behauptet, er habe die Frau des Direktors, Louise, in seiner Gewalt: Sie hat einen Cadillac, fährt morgens hierhin, dann dahin und so weiter.“"
                            },
                            {
                                "example_id": "8fc0ea05-c1a2-4c3a-854a-f7791e0b45b7",
                                "sense_id": "6b9026ee-d673-3c64-abf5-5b5c97b3d325",
                                "text": "„Atticus wählte Ray Bradburys Mars-Chroniken, setzte sich in den Cadillac und las etwas über den ›Raketensommer‹ von 1999, als infolge der Abgase eines Raumschiffs vom Mars der Schnee schmolz.“"
                            },
                            {
                                "example_id": "c362890d-9521-452a-9c3e-3785bcc739ce",
                                "sense_id": "6b9026ee-d673-3c64-abf5-5b5c97b3d325",
                                "text": "„Für andere war sie eine halb gebildete Laienpredigerin, besaß einen grauen Cadillac und ein weißes Steinhaus mit einer Täfelung aus Holzimitat und abgehängten Decken.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
