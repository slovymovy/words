                    "sense_id": "09bc20be-e280-3d7e-b0fe-39ac98d8ecd7",
                    "sense_definition": "The act of releasing someone from military service.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the war ended, many soldiers waited anxiously for their <w>demob</w>.",
                            "target_lang_translations": {
                                "nl": "Na afloop van de oorlog wachtten veel soldaten angstig op hun <w>demobilisatie</w>."
                            }
                        },
                        {
                            "text": "He received his official <w>demob</w> papers after serving for three years.",
                            "target_lang_translations": {
                                "nl": "Hij ontving zijn officiële <w>ontslagpapieren</w> na drie jaar dienst."
                            }
                        }
                    ],
                    "synonyms": [
                        "discharge"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het ontslag uit militaire dienst na afloop van een conflict."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "demobilisatie",
                                "target_lang_sense_clarification": "Het proces van het afbouwen van militaire paraatheid."
                            },
                            {
                                "target_lang_word": "ontslag uit militaire dienst",
                                "target_lang_sense_clarification": "De formele beëindiging van de diensttijd."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "25583c0e-d56c-3940-acde-cbd8b42f007d",
                    "sense_definition": "To release someone from military service.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>demob</w> thousands of troops following the peace treaty.",
                            "target_lang_translations": {
                                "nl": "De regering besloot na het vredesverdrag duizenden troepen te <w>demobiliseren</w>."
                            }
                        },
                        {
                            "text": "He was finally <w>demobbed</w> after the conflict concluded last month.",
                            "target_lang_translations": {
                                "nl": "Hij werd eindelijk <w>uit militaire dienst ontslagen</w> nadat het conflict vorige maand was beëindigd."
                            }
                        }
                    ],
                    "synonyms": [
                        "discharge"
                    ],
                    "traits": [
