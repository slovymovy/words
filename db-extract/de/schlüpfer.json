                ],
                "senses": [
                    {
                        "sense_id": "81f1da2f-ad28-3c34-8f5a-94bc7f24bdef",
                        "entry_id": "ee8f2e4f-fb40-307d-bde7-e236a8a5c4e9",
                        "glosses": [
                            "Unterhose für Damen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e702ce24-452d-4755-90e6-8bc7f86f40bf",
                                "sense_id": "81f1da2f-ad28-3c34-8f5a-94bc7f24bdef",
                                "text": "Sie zieht sich einen Schlüpfer an."
                            },
                            {
                                "example_id": "6b5244dd-4fd2-4764-8d5a-8682fb08f6ac",
                                "sense_id": "81f1da2f-ad28-3c34-8f5a-94bc7f24bdef",
                                "text": "„Wir machten den Vorschlag, sie solle es ausziehen, was sie tat, wobei sie eine tolle Figur enthüllte, durch reinseidene Strümpfe, einen Büstenhalter und einen blauen Schlüpfer verschönt.“"
                            },
                            {
                                "example_id": "092c2c5f-ee2e-4978-a3e5-551d9b2ea9df",
                                "sense_id": "81f1da2f-ad28-3c34-8f5a-94bc7f24bdef",
                                "text": "„Das Kleid rutschte hoch und ließ den hellgrünen Schlüpfer sehen, am Beinling ausgefranste Stopfstellen.“"
                            },
                            {
                                "example_id": "6314b882-d3b1-4c33-86e6-ca9616e98a22",
                                "sense_id": "81f1da2f-ad28-3c34-8f5a-94bc7f24bdef",
                                "text": "„Pauls rechte Hand wanderte langsam an ihrem Bauch herunter und verschwand unter ihrem Schlüpfer.“"
                            },
                            {
                                "example_id": "c5028157-6670-4589-9d0f-c5f3c8bacc4e",
                                "sense_id": "81f1da2f-ad28-3c34-8f5a-94bc7f24bdef",
                                "text": "„Sie zog den Schlüpfer aus, indem sie das Knie bog und mit den Armen nach unten langte; dann trat sie aus ihnen heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "077d9fee-5a14-334c-9084-e516cedab2ae",
                        "entry_id": "ee8f2e4f-fb40-307d-bde7-e236a8a5c4e9",
                        "glosses": [
                            "Kleidungsstück, in das man rasch hineinschlüpfen kann wie Sweater (Pullover) oder Slipon (weiter Herrenmantel), oder die Schlupfhose für Damen oder auch bequeme Hausschuhe, Pulswärmer und Kniewärmer"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "28d9789c-ce52-4f35-8144-8a6f423e4531",
                                "sense_id": "077d9fee-5a14-334c-9084-e516cedab2ae",
                                "text": "„Ich beobachte, wie es in ihr arbeitet, und versuche ihre Gedanken zu lesen: „So ein fauler Mensch, er trägt nur Schlüpfer und keine Schnürschuhe.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
