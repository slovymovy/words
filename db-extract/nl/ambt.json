                ],
                "senses": [
                    {
                        "sense_id": "f8d13565-6d5a-304d-a701-77fe8985269d",
                        "entry_id": "2d4a3d4b-9e90-35a0-a254-dc452fcb84bd",
                        "glosses": [
                            "officiële betrekking, post die meestal van overheidswege toegekend wordt en enige vorm van gezag uitstraalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91be0bad-de9e-44dd-a54e-941bff94dcdf",
                                "sense_id": "f8d13565-6d5a-304d-a701-77fe8985269d",
                                "text": "Het ambt van politieagent, minister, leerplichtambtenaar."
                            },
                            {
                                "example_id": "a47f49c0-4576-4214-b60d-1b1e76345c30",
                                "sense_id": "f8d13565-6d5a-304d-a701-77fe8985269d",
                                "text": "Zo waren er bijvoorbeeld geliefden als Abigail Adams en haar echtgenoot John, de tweede president van de Verenigde Staten, wier warme en vertederende relatie alom door de romantici werd bejubeld als een voorbeeld van een huwelijk zoals het voor iedereen kon zijn (in plaats van als een charmant sprookje, voor net zo weinig mensen weggelegd als het ambt van president)."
                            }
                        ]
                    },
                    {
                        "sense_id": "abccd22e-6dd6-3b32-9fe9-ee1065531780",
                        "entry_id": "2d4a3d4b-9e90-35a0-a254-dc452fcb84bd",
                        "glosses": [
                            "geestelijke taak of dienst die iemand beroepshalve uitvoert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd1e4a3a-c008-4e63-9b03-59e36b13b073",
                                "sense_id": "abccd22e-6dd6-3b32-9fe9-ee1065531780",
                                "text": "Het ambt van priester, diaken."
                            },
                            {
                                "example_id": "104cf898-59b9-4141-bc99-e41e0829178c",
                                "sense_id": "abccd22e-6dd6-3b32-9fe9-ee1065531780",
                                "text": "In vroeger tijden zat die begeerlijkheid hem niet alleen in de status van het ambt maar strekte die zich ook uit tot de gebiedsdelen waarover de vorst of vorstin de scepter zwaaide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf4de71f-150c-4de1-b8ad-03a63121421b",
                        "source_entry_id": "2d4a3d4b-9e90-35a0-a254-dc452fcb84bd",
                        "source_sense_id": "f8d13565-6d5a-304d-a701-77fe8985269d",
                        "source_sense_description": "officiële betrekking",
                        "target_lang_word": "Amt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "638255e7-2612-3070-ad68-3ab945f742bd",
                                        "entry_id": "49331402-76e2-3614-bae5-e8d2408d95d7",
                                        "glosses": [
                                            "eine mit Würde und Verantwortung verbundene offizielle (staatliche) Stellung"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50f81506-b9f7-3034-80af-bd10c22d8812",
                                        "entry_id": "49331402-76e2-3614-bae5-e8d2408d95d7",
                                        "glosses": [
                                            "eine mit Würde und Verantwortung verbundene offizielle (staatliche) Stellung",
                                            "das von einem Amtsträger bekleidete Amt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1415ab5e-ea73-47d7-b79b-10a6f3c6a690",
                                                "sense_id": "50f81506-b9f7-3034-80af-bd10c22d8812",
                                                "text": "„Wenn wir auf der weiten Skala der zielgerichteten, im Auftrag Dritter ausgeübten menschlichen Tätigkeiten ganz links den Job verorten, so steht ganz rechts das Amt. Der Job wird gemacht, das Amt aber wird bekleidet, getragen oder ausgefüllt.““"
                                            },
                                            {
                                                "example_id": "1762343f-026b-480f-a03a-74a35e4168f9",
                                                "sense_id": "50f81506-b9f7-3034-80af-bd10c22d8812",
                                                "text": "„Das einzige Interesse der Beamten war, ihre Ämter nach dem Thronwechsel zu behalten.“"
                                            },
                                            {
                                                "example_id": "57bbdfbb-b3b1-4595-a265-7f3f0a22d209",
                                                "sense_id": "50f81506-b9f7-3034-80af-bd10c22d8812",
                                                "text": "„In Biberach wurden Rats- und Gerichtsstellen und städtische Ämter gleichberechtigt und zahlenmäßig gleich auf beide Konfessionen verteilt, es gab keine herrschende Religion, es galten die Feiertage beider Konfessionen, die Kirche wurde bikonfessionell genutzt, desgleichen das Hospital.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "1ad3e4a0-8b23-35b7-96f6-121ed0a7e787",
                                        "entry_id": "49331402-76e2-3614-bae5-e8d2408d95d7",
                                        "glosses": [
                                            "eine mit Würde und Verantwortung verbundene offizielle (staatliche) Stellung",
                                            "das Amt einer öffentlichen Funktion, zum Beispiel des Politikers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d9c69b-f59c-4a0a-8475-82bfcffcb699",
                                                "sense_id": "1ad3e4a0-8b23-35b7-96f6-121ed0a7e787",
                                                "text": "Der Bundespräsident bekleidet das höchste Amt in Deutschland."
                                            },
                                            {
                                                "example_id": "a2f0f1af-5644-4dcf-901a-dbcbaedf0eb5",
                                                "sense_id": "1ad3e4a0-8b23-35b7-96f6-121ed0a7e787",
                                                "text": "„Seit Antritt seines Amtes hatte Simen Tjing täglich im Strafvollzugsamte gearbeitet, an den Sitzungen im Saale teilgenommen und seine Amtsgeschäfte erledigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "13b796ff-2f4e-3bf8-91c5-06fcbc3ac501",
                                        "entry_id": "49331402-76e2-3614-bae5-e8d2408d95d7",
                                        "glosses": [
                                            "eine mit Würde und Verantwortung verbundene offizielle (staatliche) Stellung",
                                            "eine offizielle Stellung in der römisch-katholischen Kirche, zum Beispiel der Abt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "83a274be-a0a5-36bb-850b-256ebaad4d3d",
                                        "entry_id": "49331402-76e2-3614-bae5-e8d2408d95d7",
                                        "glosses": [
                                            "eine freiwillige und ohne Bezahlung ausgeübte Tätigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48f35546-3add-42d9-8636-8025c6bffdcc",
                                                "sense_id": "83a274be-a0a5-36bb-850b-256ebaad4d3d",
                                                "text": "Ihr undankbares Amt als Leiterin des Kirchenchors erfüllte sie bis ins hohe Alter mit eiserner Selbstdisziplin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "34e67b8d-bfe3-3110-af2d-ca448aca31f7",
                                        "entry_id": "49331402-76e2-3614-bae5-e8d2408d95d7",
                                        "glosses": [
                                            "öffentliche Dienststelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67cacf22-2953-4a98-bafa-318a46a0f348",
                                                "sense_id": "34e67b8d-bfe3-3110-af2d-ca448aca31f7",
                                                "text": "Die Bundesagentur für Arbeit hieß früher Arbeitsamt."
                                            },
                                            {
                                                "example_id": "23a6ce71-afa5-4ea4-9001-8c6eaf75924e",
                                                "sense_id": "34e67b8d-bfe3-3110-af2d-ca448aca31f7",
                                                "text": "„Der Lügen-Detektiv rief das Amt an, ließ feststellen, von wo der Anruf gekommen war.“"
                                            },
                                            {
                                                "example_id": "cac76798-4ff1-46e9-bf46-2f70d780d2ff",
                                                "sense_id": "34e67b8d-bfe3-3110-af2d-ca448aca31f7",
                                                "text": "„Tagaus, tagein ritt nun Simen Tjing zum Amt auf stattlichem Schimmel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a945d83c-1a48-30fa-ab05-71dbc598e172",
                                        "entry_id": "49331402-76e2-3614-bae5-e8d2408d95d7",
                                        "glosses": [
                                            "landschaftlich historische untere territoriale Einheit, auch Amtsbezirk"
                                        ],
                                        "tags": [
                                            "Swiss Standard German",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df12bed6-cf1f-4bdb-889d-fc50a7fa0df6",
                                                "sense_id": "a945d83c-1a48-30fa-ab05-71dbc598e172",
                                                "text": "„Im Herzogtum Nassau waren die Ämter erstinstanzliche Gerichte und untere Verwaltungsbehörden.“"
                                            },
                                            {
                                                "example_id": "21f529e4-0f71-4764-97f1-48080d127884",
                                                "sense_id": "a945d83c-1a48-30fa-ab05-71dbc598e172",
                                                "text": "„Das Amt des Erzstifts Mainz fiel mit diesem im Reichsdeputationshauptschluss 1803 an das neugebildete Fürstentum Aschaffenburg, …“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "47e40ff5-651a-336c-8f69-53df36a6b134",
                                        "entry_id": "49331402-76e2-3614-bae5-e8d2408d95d7",
                                        "glosses": [
                                            "eine feierliche Heilige Messe in der römisch-katholischen Kirche, Hochamt"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "9761f34a-36f0-352b-9c1b-ccda7329dd65",
                                        "entry_id": "49331402-76e2-3614-bae5-e8d2408d95d7",
                                        "glosses": [
                                            "eine Zunft"
                                        ],
