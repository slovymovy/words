                "senses": [
                    {
                        "sense_id": "ed7b4134-794e-3770-a42c-5e03889c8887",
                        "entry_id": "a784694b-2286-3ebe-a099-20d7249365a1",
                        "glosses": [
                            "Einstellung, auf Fortschritt ausgerichtet zu sein; Förderung, Befürwortung einer fortschrittlichen Haltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b188902f-e97a-4da7-a18e-d4214a31035d",
                                "sense_id": "ed7b4134-794e-3770-a42c-5e03889c8887",
                                "text": "„Insgeheim weiß er um den fatalen Zusammenhang von Fortschrittsorientiertheit und Verlust an Integrität und Glückshoffnung.“"
                            },
                            {
                                "example_id": "ede2ecf8-2fc8-4244-bf9c-36654835dc39",
                                "sense_id": "ed7b4134-794e-3770-a42c-5e03889c8887",
                                "text": "„Angesichts des gewaltigen sozialen Aufbruchs, angesichts der Fortschrittsorientiertheit der neuen Regierung erschienen derartige konservativ-mythische Vorstellungen weiten Kreisen der Bevölkerung als antiquiert.“"
                            },
                            {
                                "example_id": "204735b5-fcbc-49f1-bc79-83a22ca31e85",
                                "sense_id": "ed7b4134-794e-3770-a42c-5e03889c8887",
                                "text": "„Eigentlich begegnen wir in der Vielfalt heutiger Lebensentwürfe einer bunten Mischung – Weltoffenheit und Bodenständigkeit, Kühle und Romantik, Technik-Fetischismus und soziale Verbundenheit, Fortschrittsorientiertheit und konservatives Verhaftetsein, kritiklose Anpassung und überraschender Nonkonformismus.“"
                            },
                            {
                                "example_id": "681a8a49-4208-4bb7-95af-82db2c8db44c",
                                "sense_id": "ed7b4134-794e-3770-a42c-5e03889c8887",
                                "text": "„Wenngleich dieses Institut keinesfalls für eine ideologiSche Homogenität steht, denn seine Haltung war geprägt von traditionellen Werten und Fortschrittsorientiertheit bis zu konservativer Religiosität, so besaß es doch das Monopol über die Herstellung und Verbreitung pädagogischen Lehrmaterials.“"
                            },
                            {
                                "example_id": "988b2a5b-45ce-47f6-9909-f73ddae17e56",
                                "sense_id": "ed7b4134-794e-3770-a42c-5e03889c8887",
                                "text": "„Zumindest steht er oft in der Musik nach 1945 für Fortschrittsorientiertheit schlechthin, wie diese im Einzelnen auch immer aussehen mag […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
