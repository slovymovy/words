                "senses": [
                    {
                        "sense_id": "5f8a956e-d460-3fe2-acb3-31dcbfe2a7f4",
                        "entry_id": "d6663cce-0fe9-33a7-af63-580b6a1afa1b",
                        "glosses": [
                            "ou Prédicateur ; celui qui prêche."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "33458375-5415-4d19-af6d-6fbe19bfd57f",
                                "sense_id": "5f8a956e-d460-3fe2-acb3-31dcbfe2a7f4",
                                "text": "Les terribles prêcheurs de Seize, les moines qui portaient le mousquet aux processions de la Ligue, s'humanisent tout à coup ; les voilà devenus bénins. C'est qu'il faut bien essayer d’endormir ceux qu'on n'a pas pu tuer."
                            },
                            {
                                "example_id": "1bad5d69-bbad-4bdc-a2d4-dc50a9651780",
                                "sense_id": "5f8a956e-d460-3fe2-acb3-31dcbfe2a7f4",
                                "text": "Frères prêcheurs, Religieux de l’ordre de Saint-Dominique."
                            }
                        ]
                    },
                    {
                        "sense_id": "07aa5257-0c9b-3e1b-aef8-096dc5fe2300",
                        "entry_id": "d6663cce-0fe9-33a7-af63-580b6a1afa1b",
                        "glosses": [
                            "Celui qui fait la leçon aux autres."
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "a79237f9-9e0b-4389-af27-2898096fbf9a",
                                "sense_id": "07aa5257-0c9b-3e1b-aef8-096dc5fe2300",
                                "text": "Et les camarades bien divers d’agir en sourdine, de miner peu à peu les résolutions les plus vaillantes, prêcheurs d’oubli, de laisser-courre, d’exutoires !"
                            }
                        ]
                    },
                    {
                        "sense_id": "2431e6e8-732a-3723-bb69-759b057b2ce5",
                        "entry_id": "d6663cce-0fe9-33a7-af63-580b6a1afa1b",
                        "glosses": [
                            "Celui qui se mêle de faire toujours des réprimandes, des remontrances sur les moindres choses."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "6e9efc79-ebe9-4a25-83dd-67c765858f98",
                                "sense_id": "2431e6e8-732a-3723-bb69-759b057b2ce5",
                                "text": "C’est un prêcheur éternel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa67efb1-2e34-4ceb-932e-95f34f2718d0",
