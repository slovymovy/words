    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "582ce28b-89c2-39ed-80e7-aa7cd02b5491",
                    "sense_definition": "De gelijkheid van klank aan het einde van woorden of versregels.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "poëzie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dit gedicht is er geen sprake van een vast <w>rijm</w>.",
                            "target_lang_translations": {
                                "en": "In this poem, there is no mention of a fixed <w>rhyme</w>."
                            }
                        },
                        {
                            "text": "De dichter maakt gebruik van subtiel <w>rijm</w> om de tekst te verbinden.",
                            "target_lang_translations": {
                                "en": "The poet uses subtle <w>rhyme</w> to connect the text."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geen rijm of rede"
                    ],
                    "target_lang_definitions": {
                        "en": "The correspondence of sound at the end of words or lines of verse."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rhyme",
                                "target_lang_sense_clarification": "the phonetic similarity in verse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e8853443-b611-33c9-add7-b6f93394e577",
                    "sense_definition": "Een kort gedicht of versje waarin de regels op elkaar eindigen met dezelfde klank.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "poëzie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij schreef een grappig <w>rijm</w> voor de verjaardag van haar opa.",
                            "target_lang_translations": {
                                "en": "She wrote a funny <w>rhyme</w> for her grandfather's birthday."
                            }
                        },
                        {
                            "text": "Het kind leerde een eenvoudig <w>rijm</w> uit het oude boek.",
                            "target_lang_translations": {
                                "en": "The child learned a simple <w>rhyme</w> from the old book."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een kort rijm"
                    ],
                    "target_lang_definitions": {
                        "en": "A short poem or verse in which the lines end with the same sound."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rhyme",
                                "target_lang_sense_clarification": "a short poem or verse"
                            },
                            {
                                "target_lang_word": "nursery rhyme",
                                "target_lang_sense_clarification": "specifically for children"
                            },
                            {
                                "target_lang_word": "ditty",
                                "target_lang_sense_clarification": "a simple, short poem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c216183f-407c-3b54-9b85-e8968cb2a08e",
                    "sense_definition": "Een witte laag van ijskristallen die ontstaat door de bevriezing van waterdamp of mist.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "weer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De takken van de bomen waren bedekt met een dun laagje <w>rijm</w>.",
                            "target_lang_translations": {
                                "en": "The branches of the trees were covered with a thin layer of <w>hoarfrost</w>."
                            }
                        },
                        {
                            "text": "Na de koude nacht glinsterde de <w>rijm</w> in het vroege ochtendlicht.",
                            "target_lang_translations": {
                                "en": "After the cold night, the <w>rime</w> glistened in the early morning light."
                            }
                        }
                    ],
                    "synonyms": [
                        "rijp",
                        "vriesdauw",
                        "dauwvorst"
                    ],
                    "common_phrases": [
                        "een laagje rijm"
                    ],
                    "target_lang_definitions": {
                        "en": "A white layer of ice crystals formed by the freezing of water vapor or fog."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hoarfrost",
                                "target_lang_sense_clarification": "frozen dew or mist"
                            },
                            {
                                "target_lang_word": "rime",
                                "target_lang_sense_clarification": "ice crystals on surfaces"
                            },
                            {
                                "target_lang_word": "frost",
                                "target_lang_sense_clarification": "general term for ice crystals"
                            }
                        ]
                    }
                }
            ]
        },
