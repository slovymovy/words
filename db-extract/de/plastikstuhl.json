                "senses": [
                    {
                        "sense_id": "ba075084-a1fa-3ddf-b81b-6993771323de",
                        "entry_id": "2a729ac9-e118-31be-b95c-db47d323c04f",
                        "glosses": [
                            "Stuhl aus Plastik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b48db8c-e203-4049-b20a-8c00811dec95",
                                "sense_id": "ba075084-a1fa-3ddf-b81b-6993771323de",
                                "text": "„Da saßen sie auf ehemals weißen Plastikstühlen an abgenutzten Tischchen, die Kaffeetrinker, die Raucher, die Kartenspieler.“"
                            },
                            {
                                "example_id": "0e9d3f6f-620a-44cb-b419-45027491cc58",
                                "sense_id": "ba075084-a1fa-3ddf-b81b-6993771323de",
                                "text": "„Sie setzten sich auf zwei Plastikstühle auf der betonierten Terrasse, unter einem hölzernen Vordach, das tagsüber die Sonne abhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
