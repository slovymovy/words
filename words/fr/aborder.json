    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86299e39-5970-3974-9f42-456db6972654",
                    "sense_definition": "Commencer à traiter d'un sujet, entamer une discussion ou une réflexion sur un thème.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la réunion, le directeur a souhaité <w>aborder</w> le problème du budget."
                        },
                        {
                            "text": "Nous devons <w>aborder</w> cette question délicate avant la fin du projet."
                        }
                    ],
                    "common_phrases": [
                        "aborder un sujet",
                        "aborder une question",
                        "aborder un thème"
                    ]
                },
                {
                    "sense_id": "cb561cbc-4689-3752-9c12-cb567d77a4c1",
                    "sense_definition": "S'approcher de quelqu'un pour engager la conversation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un touriste hésitant m'a <w>abordé</w> dans la rue pour me demander son chemin."
                        },
                        {
                            "text": "Il était trop timide pour <w>aborder</w> la jeune femme assise en face de lui."
                        }
                    ],
                    "synonyms": [
                        "accoster"
                    ],
                    "common_phrases": [
                        "aborder un passant",
                        "aborder des inconnus"
                    ]
                },
                {
                    "sense_id": "a3f9dde7-823c-339a-80fe-138ca812e7b0",
                    "sense_definition": "Commencer à faire face à une situation ou s'attaquer à une difficulté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les sportifs préfèrent <w>aborder</w> cette nouvelle compétition avec beaucoup de sérénité."
                        },
                        {
                            "text": "Le conducteur doit ralentir avant d'<w>aborder</w> ce virage dangereux."
                        }
                    ],
                    "common_phrases": [
                        "aborder une étape",
                        "aborder un virage"
                    ]
                },
                {
                    "sense_id": "1e7b7ec5-c85a-3826-8746-2a5f3b39e862",
                    "sense_definition": "Arriver au rivage, toucher terre en parlant d'un navire ou de navigateurs.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs jours de tempête, les marins ont pu enfin <w>aborder</w> sur la côte."
                        },
                        {
                            "text": "Le petit voilier a <w>abordé</w> dans une crique protégée du vent."
                        }
                    ],
                    "synonyms": [
                        "accoster"
                    ],
                    "common_phrases": [
                        "aborder une côte",
                        "aborder au port"
                    ]
                },
                {
                    "sense_id": "bccda395-814d-38b6-a1b5-026eeb964b9b",
                    "sense_definition": "Entrer en collision avec un autre navire.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans l'obscurité et le brouillard épais, le cargo a accidentellement <w>abordé</w> un chalutier."
                        },
                        {
                            "text": "Les deux navires se sont <w>abordés</w> violemment à cause du fort courant."
                        }
                    ],
                    "synonyms": [
                        "heurter"
                    ]
                }
            ]
        }
    ]
