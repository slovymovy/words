                        "entry_id": "114f3507-129c-39b1-82bf-fc220196868c",
                        "glosses": [
                            "Of or pertaining to something at a diagonal to another; of four corners, those diagonal to another."
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "not-comparable"
                        ],
                        "examples": [
