                            {
                                "example_id": "8754b7a2-cc1a-4d18-ad45-f038b5570e8f",
                                "sense_id": "1aeea267-42ca-355b-b80f-6b4f638df02b",
                                "text": "The Sixty-third Naval Construction Battalion, 15 per cent of which is composed of World War I veterans, arrived here today. The group, which includes 741 Seabees, will be processed for thirty-day leaves before reassignment, the Navy announced."
