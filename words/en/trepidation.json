                    "frequency": "Middle",
                    "semantic_group_id": "fear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided, with considerable <w>trepidation</w>, to let him drive my car."
                        },
                        {
                            "text": "She approached the interview with a sense of <w>trepidation</w> about the difficult questions."
                        }
                    ],
                    "synonyms": [
                        "apprehension",
                        "fear",
                        "worry"
                    ],
                    "common_phrases": [
