                                            {
                                                "example_id": "c4719797-fe2d-4953-bfb7-19a1b2996aed",
                                                "sense_id": "0092a435-e5dd-39f5-9a3b-89bca55d47ce",
                                                "text": "Er kommt aus Guinea-Bissau."
                                            },
                                            {
                                                "example_id": "cdb3f20a-23f5-494c-9107-761536c211d2",
                                                "sense_id": "0092a435-e5dd-39f5-9a3b-89bca55d47ce",
                                                "text": "Guinea-Bissau ist eines der ärmsten Länder der Erde."
                                            },
                                            {
                                                "example_id": "dafee6da-6540-41b1-81ec-fb9b142d14c0",
                                                "sense_id": "0092a435-e5dd-39f5-9a3b-89bca55d47ce",
                                                "text": "Bissau ist die Hauptstadt von Guinea-Bissau."
                                            },
                                            {
                                                "example_id": "309ed195-536e-43bd-9741-f35218efb414",
                                                "sense_id": "0092a435-e5dd-39f5-9a3b-89bca55d47ce",
                                                "text": "„In Guinea-Bissau könnte man wunderbar leben.“"
                                            },
                                            {
                                                "example_id": "a31dd6ba-dd08-41a4-868b-bc0a6e6ff266",
                                                "sense_id": "0092a435-e5dd-39f5-9a3b-89bca55d47ce",
                                                "text": "„Zwar mischt sich, etwa mit der ungarischen Schachspielerin Judith Polgar oder Ex-Schwimmvizeweltmeister Maxim Podoprigora, vereinzelt Prominenz unter die Teilnehmer – die überwiegende Mehrheit sind jedoch Hobbysportler, die von jüdischen Sportvereinen in der ganzen Welt entsandt werden (am größten ist die britische Mannschaft, gefolgt von der deutschen und der österreichischen), ein Teilnehmer kommt aus Guinea-Bissau, ein anderer aus Gibraltar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
