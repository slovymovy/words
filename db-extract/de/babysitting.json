                        "sense_id": "4403511f-fdba-3d27-87ad-a7e25b7aa315",
                        "entry_id": "10f1c897-72da-3798-af73-07ad76dee20e",
                        "glosses": [
                            "meist bezahlte Beaufsichtigung von Kindern, während ihre Eltern abwesend sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c75a747-7db5-4aaa-8563-a097ab6e4fb7",
                                "sense_id": "4403511f-fdba-3d27-87ad-a7e25b7aa315",
                                "text": "„Wer älter als 13 ist, darf zwei Stunden an Werktagen leichte Hilfstätigkeiten wie Zeitungsaustragen oder Babysitting ausüben, aber nur zwischen 8 und 18 Uhr.“"
                            },
                            {
                                "example_id": "2c5732ad-e62b-47b3-96d3-632c1390cf79",
                                "sense_id": "4403511f-fdba-3d27-87ad-a7e25b7aa315",
                                "text": "„Nach alter deutscher Tradition werden bald die Gerichte entscheiden, wann Babysitting rechnungspflichtig ist …[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
