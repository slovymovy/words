                                        "glosses": [
                                            "attenzione, avvedutezza verso le proprie scelte e comportamenti, e in particolar modi sugli effetti che essi possono avere sul prossimo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2ffcedd-5a0e-4ee3-baf4-2527508bbe43",
                                                "sense_id": "df69ca92-a63e-3b13-b2f5-883a8bad4f47",
                                                "text": "agendo così hai dimostrato molta considerazione"
