                                "sense_id": "7f5fe647-d70d-34b0-8276-de2170b91132",
                                "text": "Звоно́к, кажи́сь, не рабо́тает.",
                                "translation": "I guess the doorbell doesn't work.",
                                "english": "I guess the doorbell doesn't work."
                            }
