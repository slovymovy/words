                        ],
                        "examples": [
                            {
                                "example_id": "d14d02bc-049e-4580-88a5-4b989241a56c",
                                "sense_id": "de88efab-031c-33a5-9731-1ff9445331af",
                                "text": "Quercitin-β-glucoside is more easily absorbed than the aglycone quercitin. Isorhamnetin-β-glucoside, which is chemically similar to quercitin, differing only by a single methoxyl group, is more readily absorbed."
                            },
                            {
                                "example_id": "261296c4-572b-4c8e-8661-672a57ebb487",
                                "sense_id": "de88efab-031c-33a5-9731-1ff9445331af",
                                "text": "Here again the consumption of a bioflavonoid (quercitin) was related to the incidence of CAD mortality. It was found that men who consumed (from the diet) less than 10 mg per day of quercitin had a 200% increase in the CAD death rate, compared to those who consumed more than 30 mg."
                            },
                            {
                                "example_id": "8f5a067e-63e6-4290-8a00-df178d7ffec9",
                                "sense_id": "de88efab-031c-33a5-9731-1ff9445331af",
                                "text": "In the case of the flavanol quercitin, the absorption spectrum of quercitin itself was red-shifted and its fluorescence intensity increased, while the fluorescence intensity of albumin was quenched."
                            }
                        ]
                    }
