                },
                {
                    "sense_id": "4a14e6d6-f7c4-337f-b683-e5c8e62934aa",
                    "sense_definition": "voldoende zijn of duren voor een bepaalde periode of behoefte",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voldoen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze speciale aanbieding in de winkel geldt zolang de voorraad <w>strekt</w>.",
                            "target_lang_translations": {
                                "en": "This special offer in the store is valid while stocks <w>last</w>.",
                                "ru": "Это специальное предложение в магазине действует, пока <w>хватит</w> запасов."
                            }
                        },
                        {
                            "text": "We moeten voorzichtig zijn zodat ons budget voor de hele vakantie <w>strekt</w>.",
                            "target_lang_translations": {
                                "en": "We have to be careful so that our budget <w>stretches</w> for the entire holiday.",
                                "ru": "Мы должны быть осторожны, чтобы нашего бюджета <w>хватило</w> на весь отпуск."
                            }
                        }
                    ],
                    "synonyms": [
                        "reiken",
                        "volstaan"
                    ],
                    "common_phrases": [
                        "zolang de voorraad strekt"
                    ],
                    "target_lang_definitions": {
                        "en": "To be sufficient or last for a certain period or need.",
                        "ru": "быть достаточным или длиться в течение определенного периода или для определенной нужды"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stretch",
                                "target_lang_sense_clarification": "to make a limited resource last longer"
                            },
                            {
                                "target_lang_word": "last",
                                "target_lang_sense_clarification": "to be enough for a duration"
                            },
                            {
                                "target_lang_word": "suffice",
                                "target_lang_sense_clarification": "to be adequate"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хватать",
                                "target_lang_sense_clarification": "быть достаточным"
                            },
                            {
                                "target_lang_word": "хватить",
                                "target_lang_sense_clarification": "о запасах или бюджете"
                            },
                            {
                                "target_lang_word": "доставать",
                                "target_lang_sense_clarification": "иметься в наличии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ff3f9ec-e755-3376-94f1-5c10760ca735",
                    "sense_definition": "dienen als iets of een bepaald effect teweegbrengen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dienen_tot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze nieuwe maatregel <w>strekt</w> tot voordeel van de lokale ondernemers.",
                            "target_lang_translations": {
                                "en": "This new measure <w>serves</w> to the advantage of local entrepreneurs.",
                                "ru": "Эта новая мера <w>служит</w> на пользу местным предпринимателям."
                            }
                        },
                        {
                            "text": "Het <w>strekt</w> hem tot eer dat hij altijd de waarheid spreekt.",
                            "target_lang_translations": {
                                "en": "It <w>redounds</w> to his credit that he always speaks the truth.",
                                "ru": "Ему <w>делает</w> честь то, что он всегда говорит правду."
                            }
                        }
                    ],
                    "synonyms": [
                        "dienen",
                        "fungeren"
                    ],
                    "common_phrases": [
                        "strekken tot eer",
                        "strekken tot voordeel"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in formele of juridische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To serve as something or produce a particular effect, often in a formal context.",
                        "ru": "служить чем-либо или вызывать определенный эффект, часто в официальном контексте"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "serve",
                                "target_lang_sense_clarification": "to act as or result in"
                            },
                            {
                                "target_lang_word": "redound",
                                "target_lang_sense_clarification": "to contribute to someone's credit or honor"
                            },
                            {
                                "target_lang_word": "be",
                                "target_lang_sense_clarification": "to constitute (e.g., to be to someone's credit)"
                            }
                        ],
                        "ru": [
