                                        "sense_id": "332d47c1-89f8-39e2-b843-fa6d58a1f8ac",
                                        "entry_id": "d8a23f3b-0696-3622-bf68-e37037d438e0",
                                        "glosses": [
                                            "stabilisierendes Gerüst, zum Beispiel eines Fahrzeugs oder Gerätes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f164471-c5d6-4e75-8c2c-9a6303fbc2fb",
                                                "sense_id": "332d47c1-89f8-39e2-b843-fa6d58a1f8ac",
                                                "text": "Der Rahmen dieses Rennrads wiegt etwa zwei Kilogramm."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35d1915b-c22f-3032-9983-eab5f93937f6",
                                        "entry_id": "d8a23f3b-0696-3622-bf68-e37037d438e0",
                                        "glosses": [
                                            "Einfassung eines Bildes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb2d38a2-7e57-487e-9fba-7af61466fb74",
                                                "sense_id": "35d1915b-c22f-3032-9983-eab5f93937f6",
                                                "text": "Das Bild hatte einen Rahmen aus Holz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6b81a99c-e963-3f2f-a341-6cf2dc934173",
                                        "entry_id": "d8a23f3b-0696-3622-bf68-e37037d438e0",
                                        "glosses": [
                                            "umschließende Einheit in einer Rahmenerzählung, die mehrere Binnengeschichten umfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a615c2-1378-47dd-8ad4-90954b9fc160",
                                                "sense_id": "6b81a99c-e963-3f2f-a341-6cf2dc934173",
                                                "text": "Den Rahmen des fiktiven Besuchs des wiederkehrenden Christus beim Großinquisitor bildet der Roman „Die Brüder Karamasow“."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6b2c463a-19b9-35c8-a2d4-70dfe5b766b1",
                                        "entry_id": "d8a23f3b-0696-3622-bf68-e37037d438e0",
                                        "glosses": [
                                            "Fenster- oder Türeinfassung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7410afa1-42fa-4327-b48b-5c6dd53c11d8",
                                                "sense_id": "6b2c463a-19b9-35c8-a2d4-70dfe5b766b1",
                                                "text": "Nachdem der Rahmen der Tür montiert war, konnte die Tür eingehängt werden."
                                            },
                                            {
                                                "example_id": "027784c7-a098-42fe-9053-0aa85c9d405d",
                                                "sense_id": "6b2c463a-19b9-35c8-a2d4-70dfe5b766b1",
                                                "text": "„Sie hatte die Rahmen mit schwarzem Luftschutzpapier bespannt, aber davor leichte helle Vorhänge angebracht, die im Winde wehten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0ff05577-65c7-323f-86d4-56fac4cca363",
                                        "entry_id": "d8a23f3b-0696-3622-bf68-e37037d438e0",
                                        "glosses": [
                                            "übergeordnete Aktivität, thematischer Zusammenhang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0cf263f-0e3e-44cb-9acf-72c95b9a9c00",
                                                "sense_id": "0ff05577-65c7-323f-86d4-56fac4cca363",
                                                "text": "Im Rahmen des Projekts konnte auch dieses Problem behandelt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "cc2b8062-e1ba-31b3-aca2-a19e940d6e2c",
                                        "entry_id": "d8a23f3b-0696-3622-bf68-e37037d438e0",
                                        "glosses": [
                                            "Grenzen erwarteten oder erlaubten Handelns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5afc6c05-072a-4efc-84f0-a175203f9aba",
                                                "sense_id": "cc2b8062-e1ba-31b3-aca2-a19e940d6e2c",
                                                "text": "Dem Projekt war ein enger finanzieller Rahmen gesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15e8a013-e837-4d0f-a85c-bf9481abb84e",
