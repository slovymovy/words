                "senses": [
                    {
                        "sense_id": "08dbd9ec-3d56-3fc6-abb2-3df20f1d1f93",
                        "entry_id": "59378306-4bd3-3631-89aa-765d3b66f817",
                        "glosses": [
                            "während der Nachtstunden stattfindende Vorstellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16213e11-f68b-42b7-aed3-0b9d5e74a15b",
                                "sense_id": "08dbd9ec-3d56-3fc6-abb2-3df20f1d1f93",
                                "text": "Sie überlegen sich, ob sie in die Nachtvorstellung gehen sollen."
                            },
                            {
                                "example_id": "f2bd3d76-8e22-486b-b379-d38e00e71b62",
                                "sense_id": "08dbd9ec-3d56-3fc6-abb2-3df20f1d1f93",
                                "text": "„Nachtvorstellung von ‚Spectre‘ im Malthäser-Kino in München: Günter Hein ist mit seinen Söhnen Santiago und Elias dabei.“"
                            },
                            {
                                "example_id": "0c22bbd3-cc31-428b-a137-57f0df99ab1b",
                                "sense_id": "08dbd9ec-3d56-3fc6-abb2-3df20f1d1f93",
                                "text": "„Sie hat immerhin noch das Kino, die Nachtvorstellung, nach ihrer Arbeit im Theater.“"
                            },
                            {
                                "example_id": "489b0e78-424c-4c80-a1a8-8a2300d7d205",
                                "sense_id": "08dbd9ec-3d56-3fc6-abb2-3df20f1d1f93",
                                "text": "„Manchmal sah er sich eine Nachtvorstellung im Kino an oder ging auf ein Glas Whisky in einen Klub.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
