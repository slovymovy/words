                "senses": [
                    {
                        "sense_id": "5090d411-cf93-3f4f-ab50-94228ac941cd",
                        "entry_id": "7ed22871-65c8-3f44-94c0-bb62f9dbf9bd",
                        "glosses": [
                            "Gruppe von Personen, die zur eigenen Familie gehören"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4621e1c-2ffb-47af-8c1e-ce012f1b00d3",
                                "sense_id": "5090d411-cf93-3f4f-ab50-94228ac941cd",
                                "text": "„Zurück in Leipzig, feierte Meyer im trauten Familienkreis Kaiser Wilhelms Geburtstag.“"
                            },
                            {
                                "example_id": "550e88cf-fd47-47d1-a36b-081c7d3c1c7f",
                                "sense_id": "5090d411-cf93-3f4f-ab50-94228ac941cd",
                                "text": "„Lebendigeren Anteil nahm sie erst, als die Rede auf ihren eigenen Eintritt in den Rostowschen Familienkreis kam.“"
                            },
                            {
                                "example_id": "48ecd590-355a-428a-b8e5-d7c10a1a1d71",
                                "sense_id": "5090d411-cf93-3f4f-ab50-94228ac941cd",
                                "text": "„Er liebte ein gutes Bett, einen Schoppen Wein und Frohsinn im Familienkreise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
