                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5e20e5d-5691-4140-ab49-c832e30e48a3",
                                "sense_id": "1a54beda-3beb-3467-9f11-277dad92955b",
                                "text": "„Die Moleküle in den Elastomeren sind wie bei den Duroplasten netzartig verknüpft, allerdings ist das Netz viel grobmaschiger, so dass eine Verformbarkeit möglich ist.“"
                            }
                        ],
