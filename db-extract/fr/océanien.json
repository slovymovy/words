                ],
                "senses": [
                    {
                        "sense_id": "70764e84-1b83-3e53-bdc7-510b5e1ce295",
                        "entry_id": "ba94cf0a-30b6-3b98-b415-e4abc5d9d069",
                        "glosses": [
                            "Qui vient d’Océanie ou qui est relatif à l’Océanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c4bd6cc-6905-4c37-961f-a0f3a15ea32c",
                                "sense_id": "70764e84-1b83-3e53-bdc7-510b5e1ce295",
                                "text": "La logique océanienne consiste à toujours ramener tout le monde dans la case. Nous sommes aux antipodes du règlement par la force, la sanction, la prison. Nous préférons l’éducation : convaincre, avec patience, les êtres égarés de revenir parmi nous."
                            }
                        ]
                    },
                    {
                        "sense_id": "8811d4d8-c764-3bfe-8880-009cb25e806c",
                        "entry_id": "ba94cf0a-30b6-3b98-b415-e4abc5d9d069",
                        "glosses": [
                            "Qui a un rapport avec la langue de cette contrée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f501ea1a-3e5d-3646-8529-a36686ea6b83",
                        "entry_id": "ba94cf0a-30b6-3b98-b415-e4abc5d9d069",
                        "glosses": [
                            "Relatif à l'océan Atlantique."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7048af2f-e35e-4922-b4e4-c9da84af1c16",
                                "sense_id": "f501ea1a-3e5d-3646-8529-a36686ea6b83",
                                "text": "Hercule, […], arriva dans la brillante Oasis des Hespérides, et, guidé par les instructions du prophète océanien Nérée, il s'empara des pommes."
                            },
                            {
                                "example_id": "6b81a804-05c9-42a2-86ad-57b562017f6f",
                                "sense_id": "f501ea1a-3e5d-3646-8529-a36686ea6b83",
                                "text": "Dans mon hypothèse, toute la masse des eaux de la mer qui aura une fois atteint la température de 4°,4 et cette masse sera considérable dans les latitudes élevées, par suite de son excès de pesanteur, aura dû se déposer vers le fond du bassin océanien."
                            },
                            {
                                "example_id": "b019d688-4c56-40dd-9d23-5fb20699c251",
                                "sense_id": "f501ea1a-3e5d-3646-8529-a36686ea6b83",
                                "text": "Regardez sur la carte cette longue presqu’île armoricaine, perdue en mer, isolée de tout, comme un brise-lames opposé aux colères océaniennes; …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c92de3d2-7276-4fa8-a75a-e2c62bf37170",
                        "source_entry_id": "ba94cf0a-30b6-3b98-b415-e4abc5d9d069",
                        "source_sense_id": "70764e84-1b83-3e53-bdc7-510b5e1ce295",
                        "source_sense_description": "Qui vient d’Océanie ou qui est relatif à l’Océanie.",
                        "target_lang_word": "ozeanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ozeanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad76ca58-9616-3e44-9477-9db723941b90",
                                        "entry_id": "24d59603-2a8d-30b8-bc3a-863f96923d4b",
                                        "glosses": [
                                            "den Ozean betreffend; durch den Ozean beeinflusst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23a3494d-fcce-4546-b2c9-29265836ec6b",
                                                "sense_id": "ad76ca58-9616-3e44-9477-9db723941b90",
                                                "text": "Die ozeanische Erdkruste unterscheidet sich in Struktur, Aufbau und Genese grundlegend von der kontinentalen Erdkruste."
                                            },
                                            {
                                                "example_id": "1c6a210c-11fc-4e1b-bc7a-f7b5826d42d9",
                                                "sense_id": "ad76ca58-9616-3e44-9477-9db723941b90",
                                                "text": "Die ozeanische Zirkulation sorgt für einen permanenten Wärmetransport."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b5728ca-4581-300e-aac3-ba0a0ccf8d36",
                                        "entry_id": "24d59603-2a8d-30b8-bc3a-863f96923d4b",
                                        "glosses": [
                                            "die Inselwelt Ozeanien betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef35cf6-db0f-4afe-a412-3da6e269ac76",
                                                "sense_id": "1b5728ca-4581-300e-aac3-ba0a0ccf8d36",
                                                "text": "Derzeit umfasst es 16 ozeanische Mitgliedstaaten einschließlich Australien, Neuseeland und Papua Neuguinea."
                                            },
                                            {
                                                "example_id": "2ee075d1-53a0-4ffa-b079-87f15f9c2780",
                                                "sense_id": "1b5728ca-4581-300e-aac3-ba0a0ccf8d36",
                                                "text": "Die ozeanischen Sprachen sind die östliche Gruppe des malayo-polynesischen Zweigs der austronesischen Sprachen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
