                    },
                    {
                        "translation_id": "aef68209-b642-4ede-9dbe-b434030b3994",
                        "source_entry_id": "c95f25a7-6a01-39dd-b8ba-b187c256ea6c",
                        "source_sense_id": "4f14a9f3-6528-38de-9026-e178ed02a178",
                        "source_sense_description": "mit cisnormativen Geschlechternormen spielend oder sich darüber hinwegsetzend",
                        "target_lang_word": "genderqueer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genderqueer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b202be39-fcfe-31af-8347-ae3bec37540b",
                                        "entry_id": "bfb59164-00e4-39a0-abe3-d3f993393164",
                                        "glosses": [
                                            "weder dem weiblichen noch dem männlichen Geschlecht zuordenbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c8411ba-fe78-4b5c-9c16-b549aa75638a",
                                                "sense_id": "b202be39-fcfe-31af-8347-ae3bec37540b",
                                                "text": "„Gino - in den USA geboren und aufgewachsen - bezeichnet sich selbst als transgender oder genderqueer.“"
                                            },
                                            {
                                                "example_id": "c6b9b10c-81b2-463c-966e-c8d4ec24df14",
                                                "sense_id": "b202be39-fcfe-31af-8347-ae3bec37540b",
                                                "text": "„Dann sind da noch genderqueere Menschen wie ich es bin, für die weder der eine noch der andere Weg, keine Box die richtige ist.“"
                                            },
                                            {
                                                "example_id": "49390b67-9a0a-43c9-a426-15efb0bcc233",
                                                "sense_id": "b202be39-fcfe-31af-8347-ae3bec37540b",
                                                "text": "„Mit ihrem Projekt wollen Fabbre und Dugan jüngeren trans und genderqueeren Menschen Vorbilder geben.“"
                                            },
                                            {
                                                "example_id": "38fd34a9-5bee-42e0-82ce-707b04f8c712",
                                                "sense_id": "b202be39-fcfe-31af-8347-ae3bec37540b",
                                                "text": "„Eine skoliosexuelle Person fühlt sich ausschließlich von genderqueeren oder transsexuellen Menschen angezogen.“"
                                            },
                                            {
                                                "example_id": "a75a7b06-35d6-4cf1-80d8-804d6394a508",
                                                "sense_id": "b202be39-fcfe-31af-8347-ae3bec37540b",
                                                "text": "„Dazu gehören Frauen und Männer, die sich keinem Geschlecht zuordnen können oder möchten, und auch diejenigen, die sich – so steht es auf der Website der Hochschule – als ‚a-/bi-/homo- oder pansexuell, genderqueer, inter, poly oder trans‘ identifizieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
