                        "glosses": [
                            "plechtige bijeenkomst waarbij iemand door besprenkeling met of onderdompeling in water wordt toegelaten tot een kerkgenootschap en waarbij vaak ook de naam bekend gemaakt wordt"
                        ],
                        "tags": [],
