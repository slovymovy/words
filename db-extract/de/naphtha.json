                    },
                    {
                        "form_id": "0c393e72-3f4c-4727-aa3c-ee520a070352",
                        "entry_id": "2b4be045-dfcf-34f0-802f-f2270f424cda",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Naphtha"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c1c051a-9d43-3474-b24d-27ff58107892",
                        "entry_id": "2b4be045-dfcf-34f0-802f-f2270f424cda",
                        "glosses": [
                            "helles, flüchtiges Erdöl"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5ee7fd24-5819-4f3d-80ba-9ab022dcfe1a",
                                "sense_id": "8c1c051a-9d43-3474-b24d-27ff58107892",
                                "text": "„Sie wurde als Asphalt, Bitumen, Erdpech, Naphtha, Peteröl oder Petroleum bezeichnet und zum Schmieren, Abdichten, manchmal zum Beleuchten und auch als Pharmazeutikum verwandt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "601b465e-f4c1-3e00-a264-547d565bf775",
                        "entry_id": "2b4be045-dfcf-34f0-802f-f2270f424cda",
                        "glosses": [
                            "Schwerbenzin, das als wichtiger Rohstoff für die petrochemische Industrie dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f860cc0a-663b-400c-b470-d2a2aca8ad1a",
                                "sense_id": "601b465e-f4c1-3e00-a264-547d565bf775",
                                "text": "„Unsere Lokomotive heizt jetzt mit rohem Naphtha von Baku, und der Geruch dieses Brennmaterials ist in der starken Hitze viel unangenehmer als Steinkohlenrauch.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bd53144-2edf-4f3b-ae77-f80fcb2cef27",
                        "source_entry_id": "2b4be045-dfcf-34f0-802f-f2270f424cda",
                        "source_sense_id": "8c1c051a-9d43-3474-b24d-27ff58107892",
                        "source_sense_description": "veraltete Bedeutung: helles, flüchtiges Erdöl",
                        "target_lang_word": "naphtha",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naphtha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b8d8249-155b-3bcb-acb0-1b0d441655a3",
                                        "entry_id": "013a9564-1e0b-3a67-87d3-419a1415fb2a",
                                        "glosses": [
                                            "Naturally occurring liquid petroleum."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6bd2c46-0c6f-35e6-91a9-4e3f112b856a",
                                        "entry_id": "013a9564-1e0b-3a67-87d3-419a1415fb2a",
                                        "glosses": [
                                            "Any of a wide variety of aliphatic or aromatic liquid hydrocarbon mixtures distilled from petroleum or coal tar, especially as used in solvents or petrol."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59bc2f3c-fe9b-471e-bafd-e32b394e129b",
                                                "sense_id": "a6bd2c46-0c6f-35e6-91a9-4e3f112b856a",
                                                "text": "The turmoil went on—no rest, no peace. […] It was nearly eleven o'clock now, and he strolled out again. In the little fair created by the costers' barrows the evening only seemed beginning; and the naphtha flares made one's eyes ache, the men's voices grated harshly, and the girls' faces saddened one."
                                            },
                                            {
                                                "example_id": "82bb67c1-9b0b-431d-b952-8ac5852db542",
                                                "sense_id": "a6bd2c46-0c6f-35e6-91a9-4e3f112b856a",
                                                "text": "No, this is not a disentanglement from, but a progressive knotting into — they go in under archways, secret entrances of rotted concrete that only looked like loops of an underpass... certain trestles of blackened wood have moved slowly by overhead, and the smells begun of coal from days far to the past, smells of naphtha winters, of Sundays when no traffic came through..."
                                            },
                                            {
                                                "example_id": "38fcd5f3-c1b0-49ba-bee0-9bb7163fa550",
                                                "sense_id": "a6bd2c46-0c6f-35e6-91a9-4e3f112b856a",
                                                "text": "The Common Room and the Library were lit by anbaric light, but the Scholars preferred the older, softer naphtha lamps in the Retiring Room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abfbdae9-3cc1-4ae4-b36b-f81260581cd7",
                        "source_entry_id": "2b4be045-dfcf-34f0-802f-f2270f424cda",
                        "source_sense_id": "8c1c051a-9d43-3474-b24d-27ff58107892",
                        "source_sense_description": "veraltete Bedeutung: helles, flüchtiges Erdöl",
                        "target_lang_word": "naphte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naphte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95be8c5b-d62c-3401-a259-cc22b62d2727",
                                        "entry_id": "eb1446f2-ec70-3bad-9c99-a3e0e1539beb",
                                        "glosses": [
                                            "Carbure d’hydrogène, sorte de bitume transparent, léger et très inflammable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33b2c4a6-1e74-402f-9d73-c8b1665fe7d9",
                                                "sense_id": "95be8c5b-d62c-3401-a259-cc22b62d2727",
                                                "text": "Enfin une énorme futaille vide, montée au grenier, avait été chargée de deux cents litres de naphte que le diabolique recors était parvenu à se procurer, pour qu’au moment de l’apothéose, toute la maison fût enveloppée d’une immense chasuble de feu."
                                            },
                                            {
                                                "example_id": "e92165ec-9db7-46b9-8c1c-ef58717a86e1",
                                                "sense_id": "95be8c5b-d62c-3401-a259-cc22b62d2727",
                                                "text": "Les gaz poussèrent des bulles dans le naphte, une sorte de glouglou régulier qui couvrait le bruit du moteur au ralenti."
                                            },
                                            {
                                                "example_id": "5b6d199f-c921-4bf4-bbcc-09f1cf87d526",
                                                "sense_id": "95be8c5b-d62c-3401-a259-cc22b62d2727",
                                                "text": "– Il est salement blessé, Signor… brûlé.\n[…]\n– Ils ont utilisé un mélange de naphte, de sel et de prunellier. Il ne guérira pas rapidement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25461288-510a-4352-9503-be6651d12e8f",
                        "source_entry_id": "2b4be045-dfcf-34f0-802f-f2270f424cda",
                        "source_sense_id": "8c1c051a-9d43-3474-b24d-27ff58107892",
                        "source_sense_description": "veraltete Bedeutung: helles, flüchtiges Erdöl",
                        "target_lang_word": "naphta",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naphta",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8fe832da-b608-3c27-9c45-b8cc095ded05",
                                        "entry_id": "65545401-043c-3091-b424-9f618206dc3d",
                                        "glosses": [
                                            "Variante de naphte."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25f5ef4c-8c86-4e4f-9b58-8529781fdac8",
                                                "sense_id": "8fe832da-b608-3c27-9c45-b8cc095ded05",
                                                "text": "Une des matières de base de l’industrie pétrochimique est constituée par les coupes de naphta qui sont des fractions issues de la distillation du pétrole brut."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
