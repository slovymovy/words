                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "протеже",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "88860ed3-f4ab-3ab0-b774-de273bc8a8e3",
                                        "entry_id": "9da8345a-99c4-3972-ae99-46023bf8d73f",
                                        "glosses": [
                                            "тот (та), кому кто-либо покровительствует, осуществляет поддержку"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e977234-aaad-439d-96f2-3f456e37c1ac",
                                                "sense_id": "88860ed3-f4ab-3ab0-b774-de273bc8a8e3",
                                                "text": "Они убеждены, что, кроме них, никто не понимает скрытых талантов их протеже, все другие люди не доросли до этого."
                                            }
                                        ]
