                        "examples": [
                            {
                                "example_id": "f1a3a522-637d-40df-9076-782126b880ac",
                                "sense_id": "77501015-dad4-3143-9e2b-13c9fdcd412d",
                                "text": "Deze kleine porties klokten we in een noodvaart naar binnen en ik bestelde meteen een aantal nieuwe planken proefglazen voor de hele tafel."
                            },
                            {
                                "example_id": "120de9ee-d5c5-4f4e-91ff-f0f0ff8eef78",
                                "sense_id": "77501015-dad4-3143-9e2b-13c9fdcd412d",
                                "text": "Maar om te zorgen dat de boog niet instortte in de harde wind moest je een vakwerk van hout en planken bouwen dat vanaf de bodem van het dal omhoogging — er waren enorme hoeveelheden hout nodig om de ondersteuning sterk genoeg te maken."
                            }
                        ]
                    }
