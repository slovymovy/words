            {
                "entry_id": "aaad5019-b61f-3d0f-b155-65fa9ebd1319",
                "word": "afzondering",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "328c11a9-94b4-4261-b810-044410572ff0",
                        "entry_id": "aaad5019-b61f-3d0f-b155-65fa9ebd1319",
                        "tags": [
                            "plural"
                        ],
                        "form": "afzonderingen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1e47921-950d-32be-b09c-e68d7814c83d",
                        "entry_id": "aaad5019-b61f-3d0f-b155-65fa9ebd1319",
                        "glosses": [
                            "een bestaan in een geïsoleerd leefgebied"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9767e078-c312-451c-9c5b-5a0c47f1b8e8",
                                "sense_id": "f1e47921-950d-32be-b09c-e68d7814c83d",
                                "text": "Er zijn in Zuid-Amerika nog altijd stammen die in grote afzondering leven."
                            }
                        ]
                    },
                    {
                        "sense_id": "30cd9acb-4ffb-3abe-9e4c-7574df01d5a9",
                        "entry_id": "aaad5019-b61f-3d0f-b155-65fa9ebd1319",
                        "glosses": [
                            "het uit elkaar houden van dieren"
                        ],
                        "tags": [
                            "veeteelt"
                        ],
                        "examples": [
                            {
                                "example_id": "11d2faa5-235c-4ee9-bf11-ad1663193b8f",
                                "sense_id": "30cd9acb-4ffb-3abe-9e4c-7574df01d5a9",
                                "text": "De afzondering werd niet goed gehandhaafd waardoor de twee dieren snel weer met elkaar konden vechten."
                            }
                        ]
                    },
                    {
                        "sense_id": "72be854f-2299-3186-b96d-73b58c3d7b4f",
                        "entry_id": "aaad5019-b61f-3d0f-b155-65fa9ebd1319",
                        "glosses": [
                            "een gedwongen verblijf in eenzaamheid vanwege gedragsproblemen, besmettingsgevaar enz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eb69e0b-c6a8-409e-81e9-ef4af79c96c9",
                                "sense_id": "72be854f-2299-3186-b96d-73b58c3d7b4f",
                                "text": "Hij had gelijk, mijn experiment om in stilte te lopen moest ik meer in afzondering uitproberen en niet de groep er te veel mee lastigvallen, dus ik trok me in de dagen daarna steeds meer terug."
                            },
                            {
                                "example_id": "c987b8b4-4f17-4e79-8332-c5a12c25a73f",
                                "sense_id": "72be854f-2299-3186-b96d-73b58c3d7b4f",
                                "text": "Hij moest vanwege zijn gedragsstoornis jarenlang in afzondering leven."
                            }
                        ]
                    },
                    {
                        "sense_id": "23cd2c78-08e2-3550-b087-e148d2c36384",
                        "entry_id": "aaad5019-b61f-3d0f-b155-65fa9ebd1319",
                        "glosses": [
                            "het beperkt raken van contact door lichamelijke of geestelijke gebreken, voorspoed of financiële tegenslag, familieomstandigheden enz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "879299a0-ffab-4b19-89a4-55bcf5b83a7a",
                                "sense_id": "23cd2c78-08e2-3550-b087-e148d2c36384",
                                "text": "Zij leeft in afzondering nu de familie niets meer met haar te maken wil hebben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47cdb82f-c009-4a30-8ffa-40008c23b5e4",
                        "source_entry_id": "aaad5019-b61f-3d0f-b155-65fa9ebd1319",
                        "source_sense_id": "f1e47921-950d-32be-b09c-e68d7814c83d",
                        "source_sense_description": "het afzonderen",
                        "target_lang_word": "Absonderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absonderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73ecc7de-51e0-32d5-8fb1-7f18213e9d19",
                                        "entry_id": "15bd8382-d5bc-37ac-af81-9753d5c2f8ed",
                                        "glosses": [
                                            "Vorsatz oder Ergebnis der Entscheidung, sich von etwas oder jemandem fernzuhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5254e95e-1b03-41ae-bf61-fa8f228c96a2",
                                                "sense_id": "73ecc7de-51e0-32d5-8fb1-7f18213e9d19",
                                                "text": "„Daß die Zeiten idyllischer Absonderung und des Wirkens nach Väter Weise vorüber sind, haben nicht nur die von C. E. L. angeführten Soziologen, Agrarwissenschaftler und Verwaltungsbehörden, sondern vor allem wir Bauern selbst erkannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aab42a6c-193d-39b4-bb51-414128bb92bf",
                                        "entry_id": "15bd8382-d5bc-37ac-af81-9753d5c2f8ed",
                                        "glosses": [
                                            "etwas, das jemand ausgeschieden hat oder dabei ist auszuscheiden; Abscheidung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "296215a0-f0ab-459d-a6b3-fb748a962f00",
                                                "sense_id": "aab42a6c-193d-39b4-bb51-414128bb92bf",
                                                "text": "„Gallenflüssigkeit ist eine Absonderung (Sekret) der Leber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9019453-f20b-4ce0-a764-a86d9cba9c9c",
                        "source_entry_id": "aaad5019-b61f-3d0f-b155-65fa9ebd1319",
                        "source_sense_id": "f1e47921-950d-32be-b09c-e68d7814c83d",
                        "source_sense_description": "het afzonderen",
                        "target_lang_word": "separation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "separation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31540f68-47aa-333a-b9d7-75933aef23d4",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "The act of disuniting two or more things, or the condition of being separated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9781b8ef-38ab-300e-900a-98aab9cdd453",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "The act or condition of two or more people being separated from one another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac03e60a-540f-41d5-9da1-8a24b88a1b2e",
                                                "sense_id": "9781b8ef-38ab-300e-900a-98aab9cdd453",
                                                "text": "We were a band of brothers, and never dearer to each other than now. The thought which gave us the most pain, was the probable separation which would now take place, in case we were sold off to the far south, as we were likely to be."
                                            },
                                            {
                                                "example_id": "b90253d7-dae2-4025-b701-afd9fde9474c",
                                                "sense_id": "9781b8ef-38ab-300e-900a-98aab9cdd453",
                                                "text": "[…] my longing for her was undiminished despite our months of near-complete separation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "394528e7-11e5-383b-8a74-9785625665b0",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "The act or condition of a married couple living in separate homes while remaining legally married."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30ffcace-0f9b-479e-a1cd-70919afbfd2b",
                                                "sense_id": "394528e7-11e5-383b-8a74-9785625665b0",
                                                "text": "‘If he dares to refuse me a separation, I’ll have one in law—I can—and I hope this will be a warning to all girls who have seen this disgraceful exhibition.’"
                                            },
                                            {
                                                "example_id": "3198795d-13d9-48f6-b78d-3b43a5c300d5",
                                                "sense_id": "394528e7-11e5-383b-8a74-9785625665b0",
                                                "text": "[…] she [knows] her great-aunt’s concern over her son Warren, his two divorces, and now Alice’s bitter separation from her husband, Ben."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beb8bd66-56e2-39c0-8bd0-f0219241da96",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "The act or condition of a married couple living in separate homes while remaining legally married.",
                                            "An agreement legalizing such an arrangement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cfbe4be-7651-48b3-97c5-7b656a121140",
                                                "sense_id": "beb8bd66-56e2-39c0-8bd0-f0219241da96",
                                                "text": "I should have gone back to her the day after the fair, if it hadn't been for you talking about the law, and rubbish about getting a separation;"
                                            },
                                            {
                                                "example_id": "e32477bc-ab34-4983-a0cd-3d45d431fd86",
                                                "sense_id": "beb8bd66-56e2-39c0-8bd0-f0219241da96",
                                                "text": "“You are deserting me?”\n“Don’t be the neglected, dramatic wife, Scarlett. The rôle isn’t becoming. I take it, then, you do not want a divorce or even a separation? Well, then, I’ll come back often enough to keep gossip down.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e62f04ba-8897-399a-977f-6ab144ebca79",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "The place at which a division occurs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6bb9889-962e-4778-8532-4528717db04c",
                                                "sense_id": "e62f04ba-8897-399a-977f-6ab144ebca79",
                                                "text": "I was now on the separation of two vast water-sheds; behind me all the streams were bound for the Garonne and the Western Ocean; before me was the basin of the Rhone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c392145a-05ae-3c86-b877-515d7862e8ef",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "An interval, gap or space that separates things or people."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50fb3e8a-cec4-4b58-9a99-46cb5bc75e9a",
                                                "sense_id": "c392145a-05ae-3c86-b877-515d7862e8ef",
                                                "text": "[…] gentle friend, for love and courtesy\nLie further off; in human modesty,\nSuch separation as may well be said\nBecomes a virtuous bachelor and a maid,\nSo far be distant;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd5b588e-3ba7-35fd-9063-0ea3a1965187",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "An object that separates two spaces."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec754414-8007-425e-829d-ea5a961cf168",
                                                "sense_id": "cd5b588e-3ba7-35fd-9063-0ea3a1965187",
                                                "text": "[The orchard] was full of trees, it bloomed with flowers: a very high wall shut it out from the court, on one side; on the other, a beech avenue screened it from the lawn. At the bottom was a sunk fence; its sole separation from lonely fields:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f3a61a2-beb2-345a-b206-7d32898cabdb",
                                        "entry_id": "72ab5178-bc32-38a2-ae0f-63f22254821c",
                                        "glosses": [
                                            "Departure from active duty, while not necessarily leaving the service entirely."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
