                "senses": [
                    {
                        "sense_id": "1d6391bc-a1ba-3ad0-86c1-864f89fd54ea",
                        "entry_id": "9bf0d4c1-2575-34a2-ab72-29f9ab75bcfd",
                        "glosses": [
                            "Blatt, das den Buchblock mit dem Einband verbindet; Blatt auf der Innenseite des vorderen/hinteren Buchdeckels"
                        ],
                        "tags": [
                            "Buchbinderei"
                        ],
                        "examples": [
                            {
                                "example_id": "4800d2d8-3ce9-401b-b534-8b9ed425c688",
                                "sense_id": "1d6391bc-a1ba-3ad0-86c1-864f89fd54ea",
                                "text": "„Da ist ein Vorsatzblatt, ein weißes, glattes Vorsatzblatt, ich stutze: Auf dieses weiße Blatt hat ein vorsichtiger Arzt mit einem Gummistempel seinen Namen gesetzt, seine Adresse, seine Telefonnummer.“"
                            }
                        ],
