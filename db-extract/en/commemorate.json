                "senses": [
                    {
                        "sense_id": "cc154599-cfd3-3485-bf5b-7d0230aff582",
                        "entry_id": "5cfe3f15-d42f-39f5-9f6e-747308f96328",
                        "glosses": [
                            "To honour the memory of someone or something with a ceremony or object."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "53e92fee-7f54-4b18-98cf-0791fd634471",
                                "sense_id": "cc154599-cfd3-3485-bf5b-7d0230aff582",
                                "text": "On November 11th we commemorate the fallen with a march."
                            },
                            {
                                "example_id": "c28b2db7-4049-4923-aaff-eff96689738b",
                                "sense_id": "cc154599-cfd3-3485-bf5b-7d0230aff582",
                                "text": "On the anniversary of Korczak's murder, Israel commemorated him with a special postal issue. As a stamp collector and philatelic columnist, it pleased me greatly when other countries followed Israel's example in honoring him."
                            }
                        ]
                    },
                    {
                        "sense_id": "30ea67c9-6e56-3e63-a15a-8a1819304ade",
                        "entry_id": "5cfe3f15-d42f-39f5-9f6e-747308f96328",
                        "glosses": [
                            "To serve as a memorial to someone or something."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "05734d3a-82a3-42b5-88fb-3fbc8e5b611b",
                                "sense_id": "30ea67c9-6e56-3e63-a15a-8a1819304ade",
                                "text": "The cenotaph commemorates the fallen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00824510-2fc3-4870-b3d7-42ec1d906729",
                        "source_entry_id": "5cfe3f15-d42f-39f5-9f6e-747308f96328",
                        "source_sense_description": "to honor the memory of someone or something",
                        "target_lang_word": "herdenken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herdenken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c199eec4-86d7-3ba3-b58b-dbb0fb9b739b",
                                        "entry_id": "a0e118ee-7119-3d08-b506-6068489cfb1f",
                                        "glosses": [
                                            "plechtig aandacht schenken aan een gebeurtenis uit het verleden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c512d5e-5ae6-46a9-a4e5-bdfe7905e48a",
                                                "sense_id": "c199eec4-86d7-3ba3-b58b-dbb0fb9b739b",
                                                "text": "Zij herdachten de gevallenen van de oorlog."
                                            },
                                            {
                                                "example_id": "7b8b09f0-8145-47e5-b88d-7cf3d29c903f",
                                                "sense_id": "c199eec4-86d7-3ba3-b58b-dbb0fb9b739b",
                                                "text": "Havana maakt zich op om donderdag de vijftigste verjaardag van de triomfale intrede van de 'Comandante' van de Cubaanse Revolutie, Fidel Castro, te herdenken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e46e2ac8-9b08-4666-ae0f-029c061cae43",
                        "source_entry_id": "5cfe3f15-d42f-39f5-9f6e-747308f96328",
                        "source_sense_description": "to honor the memory of someone or something",
                        "target_lang_word": "commémorer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commémorer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a5c4cec-bbd6-3557-855d-1f51d3cf9efe",
                                        "entry_id": "3b8122b0-4425-37fd-9f62-a3c2e846f576",
                                        "glosses": [
                                            "Rappeler par une cérémonie, une plaque de commémoration ou un autre objet, le souvenir d’une personne ou d’un fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c0cdc81-8a9d-4b73-9378-fed23145bc93",
                                                "sense_id": "8a5c4cec-bbd6-3557-855d-1f51d3cf9efe",
                                                "text": "Fraîchement réinvesti, Emmanuel Macron a commémoré, dimanche à Paris, la victoire du 8 mai 1945 des Alliés sur l’Allemagne nazie."
                                            },
                                            {
                                                "example_id": "7e2186a2-a1f9-4dc2-bcc6-26237496c1a5",
                                                "sense_id": "8a5c4cec-bbd6-3557-855d-1f51d3cf9efe",
                                                "text": "Comme chaque année, les batailles de la Chipotte seront commémorées le dernier dimanche d'août."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b88c257-8e90-4734-ad22-3ac31657e2dd",
                        "source_entry_id": "5cfe3f15-d42f-39f5-9f6e-747308f96328",
                        "source_sense_description": "to honor the memory of someone or something",
                        "target_lang_word": "gedenken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gedenken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a45d4c0-2643-3ac1-955f-33ea524d4e9c",
                                        "entry_id": "a3f8889c-74c6-3274-a58d-92438b5eefb9",
                                        "glosses": [
                                            "die Erinnerung an jemand oder etwas pflegen, wachhalten"
                                        ],
                                        "tags": [
                                            "genitive",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d73feda0-c610-4dfc-bd15-780986da111b",
                                                "sense_id": "5a45d4c0-2643-3ac1-955f-33ea524d4e9c",
                                                "text": "An Allerheiligen wird der Verstorbenen gedacht."
                                            },
                                            {
                                                "example_id": "68074c04-867b-42f9-a991-c697956be8d5",
                                                "sense_id": "5a45d4c0-2643-3ac1-955f-33ea524d4e9c",
                                                "text": "„Gerne der Zeiten gedenk ich, / da alle Glieder gelenkig / bis auf eins. / Die Zeiten sind vorüber, / steif sind alle Glieder / bis auf eins.“"
                                            },
                                            {
                                                "example_id": "94123a4a-c713-4f45-944a-133a76470d6d",
                                                "sense_id": "5a45d4c0-2643-3ac1-955f-33ea524d4e9c",
                                                "text": "„Mir fallen die Treffen der Vertriebenenverbände ein, wo alte Menschen Breslaus, Königsbergs, Ostpreußens und Schlesiens gedenken, aber kaum einer würde die Koffer packen und zurückwollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c8cad20b-881c-3f21-971c-235be268d809",
                                        "entry_id": "a3f8889c-74c6-3274-a58d-92438b5eefb9",
                                        "glosses": [
                                            "etwas beabsichtigen, planen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "722190e5-f287-4694-b7f7-e4fe66049c67",
                                                "sense_id": "c8cad20b-881c-3f21-971c-235be268d809",
                                                "text": "Wir gedenken uns dieses Spiel anzusehen."
                                            },
                                            {
                                                "example_id": "05387197-c896-4ce3-8775-9310d5eb17df",
                                                "sense_id": "c8cad20b-881c-3f21-971c-235be268d809",
                                                "text": "„Beim Tee unterbrach Carpenter seinen Redeschwall, so daß ihm John endlich die Frage stellen konnte, die ihm die ganze Zeit auf der Zunge lag: wann er denn abzureisen gedenke.“"
                                            },
                                            {
                                                "example_id": "dd94df51-bd98-4ef7-b4d7-8043f7b2adc3",
                                                "sense_id": "c8cad20b-881c-3f21-971c-235be268d809",
                                                "text": "„Man hätte ihn von dort sonst jederzeit deportieren können, und Martin gedachte nicht, es den Verfolgern so leicht zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
