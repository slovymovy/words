                "translations": [
                    {
                        "translation_id": "a73f3604-b496-4a16-8dce-ea518e8868b5",
                        "source_entry_id": "17d94604-5021-3252-899d-7f8362936883",
                        "source_sense_id": "5c24ca61-1238-3be6-9779-1e991fec6fa3",
                        "target_lang_word": "long ago",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "long ago",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21375293-d207-308a-9c5e-b828472a19a5",
                                        "entry_id": "35f6718b-029c-3b85-b7bb-52f83836854f",
                                        "glosses": [
                                            "At a time in the past, especially the distant past."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9d68572-6d19-4c18-a580-170ff9e609da",
                                                "sense_id": "21375293-d207-308a-9c5e-b828472a19a5",
                                                "text": "There was a Roman fort here long ago."
                                            },
                                            {
                                                "example_id": "175ca966-7cbe-46ca-a9d7-d7914f8adf64",
                                                "sense_id": "21375293-d207-308a-9c5e-b828472a19a5",
                                                "text": "How long ago did she die? It's not that long ago that she did."
                                            },
                                            {
                                                "example_id": "9135793b-cc03-46de-b50c-c9a6cd593fd1",
                                                "sense_id": "21375293-d207-308a-9c5e-b828472a19a5",
                                                "text": "Long ago, in a far country, there lived a queen who had three princes."
                                            },
                                            {
                                                "example_id": "cd3f5928-1638-4433-bedd-2989bc7ecd4e",
                                                "sense_id": "21375293-d207-308a-9c5e-b828472a19a5",
                                                "text": "That concertina was a wonder in its way. The handles that was on it first was wore out long ago, and he'd made new ones of braided rope yarn. And the bellows was patched in more places than a cranberry picker's overalls."
                                            },
                                            {
                                                "example_id": "4f3ad45d-5fc5-48a8-b679-66f994c1cb54",
                                                "sense_id": "21375293-d207-308a-9c5e-b828472a19a5",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus. That’s because the lenses that are excellent at magnifying tiny subjects produce a narrow depth of field. A photo processing technique called focus stacking has changed that."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "long ago",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9ea4295-0e80-3400-b686-3e55f0ffa19a",
                                        "entry_id": "b88fe518-f70b-348b-8840-c93b7b1117bf",
                                        "glosses": [
                                            "Existing in the relatively distant past."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395d5b88-1bb0-4b06-8e94-47b3c99b729f",
                                                "sense_id": "e9ea4295-0e80-3400-b686-3e55f0ffa19a",
                                                "text": "The answer, according to James Moore, who as minister of Canadian heritage is in charge of the campaign, is that the government simply wants the long-ago war, which few Canadians know well, to be remembered."
                                            },
                                            {
                                                "example_id": "35d00fac-c9e2-4d8d-a8da-d29bb7681439",
                                                "sense_id": "e9ea4295-0e80-3400-b686-3e55f0ffa19a",
                                                "text": "Back in the long ago days of the 2000 season, the New England Patriots were a 5-11 mess of a team that finished in the cellar of the AFC East. It was an inauspicious start to the tenure of head coach Bill Belichick."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
