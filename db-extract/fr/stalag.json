                        "translation_id": "60bd0598-2e39-417f-8c06-46e344ab6571",
                        "source_entry_id": "170317ae-ca62-3e06-a826-9cdb220c460e",
                        "source_sense_id": "9df4ed2e-15df-3f21-8646-16db0189cea8",
