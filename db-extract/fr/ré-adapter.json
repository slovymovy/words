                ],
                "senses": [
                    {
                        "sense_id": "3f13b621-8863-3465-aceb-a2e91063bfe0",
                        "entry_id": "7229aa53-173a-3e69-b3d7-453f552ce5a4",
                        "glosses": [
                            "Adapter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3f9076-57ed-4a52-ad7f-47e631de1cc5",
                                "sense_id": "3f13b621-8863-3465-aceb-a2e91063bfe0",
                                "text": "En voulant ré-adapter ce que Dieu créa avant lui, Frankenstein n’agit pas seulement en scientifique, mais en artiste."
                            },
                            {
                                "example_id": "ba0a5681-e19e-4b90-8c33-27d2c9a34c6c",
                                "sense_id": "3f13b621-8863-3465-aceb-a2e91063bfe0",
                                "text": "Faire des jeunes de gentils ouvriers, de gentils moutons, les faire devenir un bon ouvrier, ré-adapter ou adapter les mecs à la société existante"
                            },
                            {
                                "example_id": "461d02ee-3af6-441f-8cf7-045f0caec905",
                                "sense_id": "3f13b621-8863-3465-aceb-a2e91063bfe0",
                                "text": "On n’a plus le temps car tout change sans cesse et nous devons en permanence nous ré-adapter, au risque sinon de disparaître."
                            }
                        ]
                    }
                ],
