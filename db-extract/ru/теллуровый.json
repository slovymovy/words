                                    {
                                        "sense_id": "f791fec9-8032-3f95-8b6e-fa8ad9e6e9da",
                                        "entry_id": "17edbce2-26f8-3839-8d3b-c405380a893b",
                                        "glosses": [
                                            "Que pertenece o concierne al planeta Tierra."
