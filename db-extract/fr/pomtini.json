                                    {
                                        "sense_id": "f30762d4-4c0b-3d80-8a67-06bb2a6bf56e",
                                        "entry_id": "d7e596bc-bb78-33c4-9608-88743fc817ba",
                                        "glosses": [
                                            "A pomegranate martini."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea7446f-5ded-45aa-bf47-3f96477c6c5f",
                                                "sense_id": "f30762d4-4c0b-3d80-8a67-06bb2a6bf56e",
                                                "text": "And, boy, after the day I've had with my suppliers, those pomtinis are calling my name."
                                            },
                                            {
                                                "example_id": "d28a6d05-0e61-4a4f-8f5f-d4529ef4be72",
                                                "sense_id": "f30762d4-4c0b-3d80-8a67-06bb2a6bf56e",
                                                "text": "Today so many almost ridiculous versions of this drink exist that some drink menus actually have a special martini page. Varieties include the appletini, hazeltini, cherry martini, Cajun martini, habanero martini, pometini, chocolatini, and even a bacontini! Lest it be buried forever in this avalanche of new \"exoticatinis,\" here is a classic recipe from a very old bartender's manual."
                                            },
                                            {
                                                "example_id": "cd8b165d-3a15-417d-8a96-f5f705d603e7",
                                                "sense_id": "f30762d4-4c0b-3d80-8a67-06bb2a6bf56e",
                                                "text": "And to tell him if I saw her, especially if she ordered a pomtini."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
