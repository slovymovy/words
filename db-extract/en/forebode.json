                                "target_senses": [
                                    {
                                        "sense_id": "75d27f77-9d69-39ba-9827-d26b7489a2e7",
                                        "entry_id": "529a1076-37c9-39ca-905a-f6de5ec15e52",
                                        "glosses": [
                                            "eine Befürchtung haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a6a8d1f-828c-4832-88d4-f721dd044e22",
                                                "sense_id": "75d27f77-9d69-39ba-9827-d26b7489a2e7",
                                                "text": "Ich ahne Böses."
                                            },
                                            {
                                                "example_id": "fc7e360e-ad11-478c-a086-40bde2f85fc0",
                                                "sense_id": "75d27f77-9d69-39ba-9827-d26b7489a2e7",
                                                "text": "Oi, Oi, sie ahnte, was da kommen würde."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa19dc56-9509-3506-9768-2c8723917433",
                                        "entry_id": "529a1076-37c9-39ca-905a-f6de5ec15e52",
                                        "glosses": [
                                            "etwas vermuten, vorhersehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4feafef9-327c-46e7-b46e-58da4ddf9afb",
                                                "sense_id": "aa19dc56-9509-3506-9768-2c8723917433",
                                                "text": "Ich ahne, dass gleich ein Gewitter losbrechen wird."
                                            },
                                            {
                                                "example_id": "e177f06c-8702-4f37-bd43-45ae2c5e54b5",
                                                "sense_id": "aa19dc56-9509-3506-9768-2c8723917433",
                                                "text": "Das habe ich geahnt, dass da dein Vater dahintersteckt."
                                            },
                                            {
                                                "example_id": "aac18fd3-eba0-4d4c-ac7e-8eba959f3b16",
                                                "sense_id": "aa19dc56-9509-3506-9768-2c8723917433",
                                                "text": "Das kann doch keiner ahnen, dass das nur ein Scherz war!"
                                            },
                                            {
                                                "example_id": "9f18ebc8-aef5-4bf8-9819-9fc1831c05ad",
                                                "sense_id": "aa19dc56-9509-3506-9768-2c8723917433",
                                                "text": "„Die europäische Politik ist besser als ihr Ruf. Viele Bürger ahnen das. Selbst in Großbritannien ist die Zustimmung zur EU zuletzt gewachsen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
