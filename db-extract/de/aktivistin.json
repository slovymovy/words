                ],
                "senses": [
                    {
                        "sense_id": "76315823-a49b-31e8-8ea1-d8ec234f3b02",
                        "entry_id": "e5bc373f-14a9-3f84-ba7a-88ba21ec7289",
                        "glosses": [
                            "oft politisch engagierte, zielbewusst handelnde weibliche Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3328904e-84d1-41de-a684-75f279aff56f",
                                "sense_id": "76315823-a49b-31e8-8ea1-d8ec234f3b02",
                                "text": "Die Aktivistinnen fertigten Wahlplakate an."
                            },
                            {
                                "example_id": "ed3a4eb8-7abc-461b-be44-da49177cef5b",
                                "sense_id": "76315823-a49b-31e8-8ea1-d8ec234f3b02",
                                "text": "„In dieser Zeit trat Mugabes Frau Sally selbst als Aktivistin in Erscheinung, als sie im Dezember 1961 eine Gruppe von Frauen bei lautstarken Demonstrationen vor der britischen Botschaft und dem Amtssitz des Premierministers anführte, um gegen die Akzeptanz der neuen Verfassung durch Großbritannien zu protestieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0117df8d-57c4-331d-9c74-04a63d37bac0",
                        "entry_id": "e5bc373f-14a9-3f84-ba7a-88ba21ec7289",
                        "glosses": [
                            "werktätige weibliche Person in der DDR, die Leistungen erbracht hat, die über die Normen und Vorgaben hinausgingen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f9a130b7-bc3c-4e34-acb8-d9a54edfff84",
                                "sense_id": "0117df8d-57c4-331d-9c74-04a63d37bac0",
                                "text": "Heutzutage ist sie Rentnerin, aber früher war sie Aktivist der sozialistischen Arbeit in der DDR."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c000310-c55d-447b-a39c-d6faed61923e",
                        "source_entry_id": "e5bc373f-14a9-3f84-ba7a-88ba21ec7289",
                        "source_sense_id": "76315823-a49b-31e8-8ea1-d8ec234f3b02",
                        "source_sense_description": "oft politisch engagierte, zielbewusst handelnde weibliche Person",
                        "target_lang_word": "activist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "activist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9371ea8c-22eb-3cf9-ac20-adca73a8d6d5",
                                        "entry_id": "2d8eec51-a98d-37a3-85f4-8fcbc54b18af",
                                        "glosses": [
                                            "One who is politically active in the role of a citizen; especially, one who campaigns for change."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d51dbc0-8b5a-4f81-8685-3742673278a8",
                                                "sense_id": "9371ea8c-22eb-3cf9-ac20-adca73a8d6d5",
                                                "text": "It has jailed environmental activists and is planning to limit the power of judicial oversight by handing a state-approved body a monopoly over bringing environmental lawsuits."
                                            },
                                            {
                                                "example_id": "3987b315-eb54-4a92-87a4-8b07106648c0",
                                                "sense_id": "9371ea8c-22eb-3cf9-ac20-adca73a8d6d5",
                                                "text": "The six activists will now face a retrial at Highbury Magistrates' Court, in front of a new judge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "688bdc77-53e8-3b64-9ebb-e187cffb26a7",
                                        "entry_id": "2d8eec51-a98d-37a3-85f4-8fcbc54b18af",
                                        "glosses": [
                                            "One who is conspicuously active in carrying out any occupational or professional functions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "activist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                                        "entry_id": "ba5970b6-e294-398c-90fe-26912fc94068",
                                        "glosses": [
                                            "Behaving as an activist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86eb1319-2809-4571-af82-cc7118489603",
                                                "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                                                "text": "Even in the area of free speech, Justice Harlan sometimes emerged as more activist than his brother"
                                            },
                                            {
                                                "example_id": "41cb93d1-ac0c-4d05-a68a-041573a01159",
                                                "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                                                "text": "Now GM has what may well be the most activist board ever."
                                            },
                                            {
                                                "example_id": "87a8ad9b-2808-49a1-80c1-b561da93f64e",
                                                "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                                                "text": "Gov. Chris Christie has long complained that New Jersey's Supreme Court is too liberal and too activist"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bab78a48-59a2-46ae-9a79-21abdcd3ff2b",
                        "source_entry_id": "e5bc373f-14a9-3f84-ba7a-88ba21ec7289",
                        "source_sense_id": "76315823-a49b-31e8-8ea1-d8ec234f3b02",
                        "source_sense_description": "oft politisch engagierte, zielbewusst handelnde weibliche Person",
                        "target_lang_word": "activiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "activiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0659af3a-9e86-359b-bc50-a43f9b00680e",
                                        "entry_id": "1715fd75-546c-3060-bcc0-9431457e5b3a",
                                        "glosses": [
                                            "Relatif à l’activisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb3b98ef-a1cf-455c-848a-02fc852b7adf",
                                                "sense_id": "0659af3a-9e86-359b-bc50-a43f9b00680e",
                                                "text": "Certains juges utiliseront déjà au XIXᵉ siècle la Constitution de manière activiste dans un certain nombre de décisions."
                                            },
                                            {
                                                "example_id": "d1a518d0-0a94-4fe6-b8ee-c76f8e69e106",
                                                "sense_id": "0659af3a-9e86-359b-bc50-a43f9b00680e",
                                                "text": "Il s’agit d’une organisation activiste, qui multiplie les opérations spectaculaires : commandos contre des fast-food halals, « apéros saucisson-pinard », ou manifestations musclées."
                                            },
                                            {
                                                "example_id": "e279fd94-3380-4304-975a-a65b1cdeb911",
                                                "sense_id": "0659af3a-9e86-359b-bc50-a43f9b00680e",
                                                "text": "L’OCML-VP pêche depuis longtemps par des tendances activistes, c’est à dire la tentation d’être présente dans toutes les luttes à la fois, même si cela est au-dessus de nos forces et entraîne surcharge et tensions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "activiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc6c8c04-d2d8-3380-b774-e6755a1d547d",
                                        "entry_id": "0ac2f7e7-ce9a-3139-8d1c-9c47dacb19ce",
                                        "glosses": [
                                            "Celui, celle qui pratique l’activisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c34106e6-57d9-48fc-b115-7f7b4d35efc8",
                                                "sense_id": "dc6c8c04-d2d8-3380-b774-e6755a1d547d",
                                                "text": "En fait, l’un des jurés devint lui-même un activiste en faveur des programmes d’échanges."
                                            },
                                            {
                                                "example_id": "eae19688-e759-424d-89d9-d784b0ff8490",
                                                "sense_id": "dc6c8c04-d2d8-3380-b774-e6755a1d547d",
                                                "text": "Une patricienne italienne peut ripoliner la façade de son présidentiel époux, et tenter, en vain, de dissimuler sa confondante vulgarité d’activiste, sa vraie nature pointe toujours."
                                            },
                                            {
                                                "example_id": "ea186bbd-46e1-4b76-a5f2-d814e7b755d5",
                                                "sense_id": "dc6c8c04-d2d8-3380-b774-e6755a1d547d",
                                                "text": "Le propriétaire d’une ferme laitière de Compton, en Estrie, a eu une bien mauvaise surprise samedi midi, quand trois activistes ont pénétré dans son étable, sans autorisation, et ont libéré plusieurs de ses vaches."
                                            }
                                        ]
                                    }
                                ]
                            }
