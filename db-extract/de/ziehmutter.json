                            "Mentorin, unterstützende Begleiterin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9948d1d2-cd3b-43ac-b286-3501ad5f7165",
                                "sense_id": "d6fb6f77-b3f1-3c95-b725-5a105faae9b2",
                                "text": "„Dies war der offene Bruch mit der Anti-EG-Politik seiner Ziehmutter Margaret Thatcher.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
