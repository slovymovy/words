                                                "example_id": "5e7e73a2-9eaa-4adf-8618-5c31e8ba4d7c",
                                                "sense_id": "d6c2d3db-bac2-3e9b-a53d-ee4ee74242b8",
                                                "text": "Hast wandred through the world now long a day;Yet ceasest not thy wearie soles to lead"
                                            },
                                            {
                                                "example_id": "a1c504a8-6c17-49d6-aa82-2805564ccc8e",
                                                "sense_id": "d6c2d3db-bac2-3e9b-a53d-ee4ee74242b8",
                                                "text": "But the doue found no rest for the sole of her foote, and she returned vnto him into the Arke: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26e17170-a08d-39a0-aa9b-61a9f0db08bd",
                                        "entry_id": "a09e22ed-4618-3a5b-9839-39f1eb0cfe9f",
                                        "glosses": [
