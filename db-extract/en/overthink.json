                                        "entry_id": "f7a5a421-0ea6-363b-939b-aa4bc0b84423",
                                        "glosses": [
                                            "mit einem bestimmten Ziel nachdenken, in Gedanken versinken, etwas überdenken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4bb1a51-70d7-4f32-af0f-0a27ecd0fff9",
                                                "sense_id": "893a46b4-8000-3443-a8e9-cc89b6f100dd",
                                                "text": "Er überlegte eine Zeitlang, wie er aus dem Schlamassel herauskommen sollte."
                                            },
                                            {
                                                "example_id": "d5e63e59-82a1-4f64-8f21-a0433a38dad8",
                                                "sense_id": "893a46b4-8000-3443-a8e9-cc89b6f100dd",
                                                "text": "Sie sagte: „Das möchte ich mir nochmal überlegen, bevor ich entscheide.“"
                                            },
                                            {
                                                "example_id": "cd22b3b1-48c5-48e1-8f0e-c0535140e230",
                                                "sense_id": "893a46b4-8000-3443-a8e9-cc89b6f100dd",
                                                "text": "Sie fragte: „Was hältst du davon?“ Ich sagte: „Einverstanden, das hatte ich mir auch schon überlegt.“"
                                            },
                                            {
                                                "example_id": "b11c7941-05a1-4c68-8471-62339f3d4335",
                                                "sense_id": "893a46b4-8000-3443-a8e9-cc89b6f100dd",
                                                "text": "„Es gibt diese Augenblicke, wo man in ein Loch der Sinnlosigkeit stürzt und überlegt, ob nicht alles vertan ist, ob das, was man macht, ein falscher Weg ist.“"
                                            }
                                        ],
