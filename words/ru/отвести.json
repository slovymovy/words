{
    "word_family": [
        "отвод",
        "отводка",
        "отводный",
        "отводной"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "86e4dc04-4c1b-30ea-86c4-fc0d307a00ce",
                    "sense_definition": "сопровождая, помочь кому-либо дойти до определенного места",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мать решила <w>отвести</w> ребёнка в детский сад самостоятельно.",
                            "target_lang_translations": {
                                "it": "La madre ha deciso di <w>accompagnare</w> il bambino all'asilo da sola."
                            }
                        },
                        {
                            "text": "Друг обещал <w>отвести</w> меня к нужному кабинету в университете.",
                            "target_lang_translations": {
                                "it": "Un amico ha promesso di <w>portarmi</w> all'ufficio giusto all'università."
                            }
                        }
                    ],
                    "common_phrases": [
                        "отвести ребенка",
                        "отвести домой"
                    ],
                    "target_lang_definitions": {
                        "it": "Accompagnare qualcuno in un luogo specifico."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "accompagnare",
                                "target_lang_sense_clarification": "portare qualcuno in un posto"
                            },
                            {
                                "target_lang_word": "portare",
                                "target_lang_sense_clarification": "condurre qualcuno verso una destinazione"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b5e8686-308c-34a3-83b5-6d1378dc83dc",
                    "sense_definition": "переместить что-либо в сторону от исходного положения",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему пришлось <w>отвести</w> руку, чтобы не задеть прохожего.",
                            "target_lang_translations": {
                                "it": "Ha dovuto <w>spostare</w> il braccio per non urtare il passante."
                            }
                        },
                        {
                            "text": "Девушка решила <w>отвести</w> взгляд, когда он на неё посмотрел.",
                            "target_lang_translations": {
                                "it": "La ragazza ha deciso di <w>distogliere</w> lo sguardo quando lui l'ha guardata."
                            }
                        }
                    ],
                    "synonyms": [
                        "отодвинуть",
                        "передвинуть"
                    ],
                    "common_phrases": [
                        "отвести взгляд",
                        "отвести руку"
                    ],
                    "target_lang_definitions": {
                        "it": "Spostare qualcosa lateralmente o lontano dalla posizione originale."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "spostare",
                                "target_lang_sense_clarification": "muovere di lato"
                            },
                            {
                                "target_lang_word": "distogliere",
                                "target_lang_sense_clarification": "usato specificamente per lo sguardo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6073137d-7040-3ca3-b816-6c7c84dfb08c",
                    "sense_definition": "выделить, назначить или зарезервировать что-либо для определенной цели",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нам нужно <w>отвести</w> больше времени на подготовку к экзамену.",
                            "target_lang_translations": {
                                "it": "Dobbiamo <w>destinare</w> più tempo alla preparazione dell'esame."
                            }
                        },
                        {
                            "text": "Директор решил <w>отвести</w> отдельное помещение под архив документов.",
                            "target_lang_translations": {
                                "it": "Il direttore ha deciso di <w>riservare</w> una stanza separata per l'archivio dei documenti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "отвести время",
                        "отвести место"
                    ],
                    "target_lang_definitions": {
                        "it": "Destinare o riservare qualcosa per uno scopo specifico."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "destinare",
                                "target_lang_sense_clarification": "assegnare risorse o tempo a un fine"
                            },
                            {
                                "target_lang_word": "riservare",
                                "target_lang_sense_clarification": "tenere da parte per un uso particolare"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d6be399-cfff-3ea3-bcfe-f348d5c75b99",
                    "sense_definition": "предотвратить воздействие чего-либо, отразить удар или угрозу",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "defense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Опытный боец смог <w>отвести</w> удар противника в последний момент.",
                            "target_lang_translations": {
                                "it": "Un combattente esperto è riuscito a <w>parare</w> il colpo dell'avversario all'ultimo momento."
                            }
                        },
                        {
                            "text": "Только чудо помогло <w>отвести</w> беду от нашего дома.",
                            "target_lang_translations": {
                                "it": "Solo un miracolo ha aiutato a <w>scongiurare</w> la sventura dalla nostra casa."
                            }
                        }
                    ],
                    "common_phrases": [
                        "отвести удар",
                        "отвести беду"
                    ],
                    "target_lang_definitions": {
                        "it": "Prevenire un impatto, respingere un attacco o allontanare un pericolo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "parare",
                                "target_lang_sense_clarification": "respingere un colpo fisico"
                            },
                            {
                                "target_lang_word": "scongiurare",
                                "target_lang_sense_clarification": "evitare un pericolo o una sventura"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f372c73-f79b-302a-baf3-d7bc55c3ce9a",
                    "sense_definition": "полностью провести запланированный цикл занятий или лекций",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Преподаватель должен <w>отвести</w> все лекции до начала сессии.",
                            "target_lang_translations": {
                                "it": "Il docente deve <w>tenere</w> tutte le lezioni prima dell'inizio della sessione."
                            }
                        },
                        {
                            "text": "После того как вы <w>отвели</w> курс, сдайте отчёт в деканат.",
                            "target_lang_translations": {
                                "it": "Dopo aver <w>svolto</w> il corso, consegnate il rapporto in segreteria."
                            }
                        }
                    ],
                    "synonyms": [
                        "провести"
                    ],
                    "common_phrases": [
                        "отвести лекции",
                        "отвести часы"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "часто используется в академической среде"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Tenere o completare un ciclo di lezioni o un corso."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "tenere",
                                "target_lang_sense_clarification": "svolgere una lezione o un corso"
                            },
                            {
                                "target_lang_word": "svolgere",
                                "target_lang_sense_clarification": "completare un programma didattico"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}