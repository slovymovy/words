                "senses": [
                    {
                        "sense_id": "c218f96f-a8b8-3422-9dba-935c37c31d8c",
                        "entry_id": "c6501e00-91c0-30e7-8ed3-19e4ce2ebcf4",
                        "glosses": [
                            "een handeling die je vooraf doet om te zorgen dat iets vervelends later niet kan gebeuren, vaak gedaan onder het motto 'voorkomen is beter dan genezen'"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60759111-9edd-414f-baad-21a3e0db52a8",
                                "sense_id": "c218f96f-a8b8-3422-9dba-935c37c31d8c",
                                "text": "Voor de deur is een stalen schot van 30 centimeter dik aangebracht dat voor de deur gerold wordt en dat vergrendeld wordt met een 10 centimeter dikke stalen pin. Het is een voorzorgsmaatregel die moet voorkomen dat in geval van een aardbeving - toch tamelijk zeldzaam in Zeeland - de gewone deur open zou gaan terwijl daar binnen zwaar stralend afval behandeld wordt.'."
                            },
                            {
                                "example_id": "05d55747-d473-40d3-a062-aba06520860d",
                                "sense_id": "c218f96f-a8b8-3422-9dba-935c37c31d8c",
                                "text": "Het had natuurlijk een uur eerder moeten zijn, maar het was een voorzorgsmaatregel met in zijn achterhoofd dat het deze avond laat kon worden met een heleboel wijn."
                            }
                        ]
                    }
                ],
