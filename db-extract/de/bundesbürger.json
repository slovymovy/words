                "senses": [
                    {
                        "sense_id": "a999c7cf-26c8-3889-9504-1e31f0c06cb8",
                        "entry_id": "c3b4ba66-2e53-3743-aeb2-56a37524512d",
                        "glosses": [
                            "a citizen of the Federal Republic of Germany, whether they live in Germany or not (male or of unspecified gender)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "85c5932f-0f15-4d0d-86cc-af632a4f80ad",
                                "sense_id": "a999c7cf-26c8-3889-9504-1e31f0c06cb8",
                                "text": "Alle männlichen Bundesbürger zwischen 18 und 45 Jahren sind wehrpflichtig.",
                                "translation": "All male German citizens between 18 and 45 years of age are liable to military service.",
                                "english": "All male German citizens between 18 and 45 years of age are liable to military service."
                            }
                        ]
                    },
                    {
                        "sense_id": "64742634-2544-3229-95a2-1eb5519fcc5a",
                        "entry_id": "c3b4ba66-2e53-3743-aeb2-56a37524512d",
                        "glosses": [
                            "someone who lives in the Federal Republic of Germany, whether they are citizens or not (male or of unspecified gender)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e2291f71-c436-49f8-b930-1a241c89883a",
                                "sense_id": "64742634-2544-3229-95a2-1eb5519fcc5a",
                                "text": "Der durchschnittliche Bundesbürger trinkt im Jahr über 150 Liter Kaffee.",
                                "translation": "The average person in Germany drinks more than 150 litres of coffee per year.",
                                "english": "The average person in Germany drinks more than 150 litres of coffee per year."
                            }
                        ]
                    }
