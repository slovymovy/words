                        "entry_id": "90a70124-1374-3717-b8fc-677b443842c3",
                        "glosses": [
                            "Religion: einfach gestaltetes Andachtsgebäude, kleines Gotteshaus im Wald oder bei einem Dorf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c9bebec-9c28-44e9-849b-0c9c5e89785a",
                                "sense_id": "72e8e9d2-2a30-3998-ac06-6abf30702e4f",
                                "text": "„Seit Jahrhunderten ist die Waldkapelle ein Ort für viele Gläubige.“"
                            },
                            {
                                "example_id": "d849f94c-97fa-4812-8cc6-b8dac0bf24d4",
                                "sense_id": "72e8e9d2-2a30-3998-ac06-6abf30702e4f",
                                "text": "„Im hohen Buchenwald, oberhalb der Burg, liegt die Waldkapelle.“"
                            },
                            {
                                "example_id": "07d20bf2-4f8d-46b6-b116-7869ddf9fe77",
                                "sense_id": "72e8e9d2-2a30-3998-ac06-6abf30702e4f",
                                "text": "„Im Jahr 1909/10 von den Architekten Bachmann und Jürgensen erbaut, wird die Waldkapelle heute vom Freundeskreis Waldkapelle im Rahmen des Denkmalschutzes betreut.“"
                            }
                        ],
