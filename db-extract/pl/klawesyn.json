                        "source_sense_id": "23e5ee0f-40ce-3900-90ac-aed0ae38f435",
                        "target_lang_word": "harpsichord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harpsichord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5f03f8a-544c-3c25-85dc-3d8bf9029e56",
                                        "entry_id": "a3272bae-f119-35c5-9374-846f9bbd7135",
                                        "glosses": [
                                            "A musical instrument with a keyboard that produces sound through a mechanical process. When the performer presses a key, a corresponding plectrum plucks a tuned string. The harpsichord originated in late medieval Europe and is one of the most important instruments used to perform Baroque music."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d916d12-4d3d-4477-adba-e50609d6326a",
                        "source_entry_id": "f114db94-e6c1-3a6c-929c-e97c9279e908",
                        "source_sense_id": "23e5ee0f-40ce-3900-90ac-aed0ae38f435",
                        "target_lang_word": "Cembalo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cembalo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                        "entry_id": "9e75ee6e-a456-3546-844b-fbd9578c1423",
                                        "glosses": [
                                            "Tasteninstrument in Form eines Flügels mit Zupfmechanik (Kurzform für Clavicembalo)"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1747224b-1603-461a-b886-b8523e194c95",
                                                "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                                "text": "„Ohne es zu merken, war ich aufgestanden und lauschte den glasfeinen Tönen und perlenden Glissandi eines Cembalos oder Spinetts, die wie ein kühler, belebender Lufthauch durch das stickige Treppenhaus des Wehrturms strichen.“"
                                            },
                                            {
                                                "example_id": "7858d390-c157-4a4f-a417-b9760526fb98",
                                                "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                                "text": "„Er entdeckte auf dem Cembalo zehn oder zwölf Datteln und aß sie auf.“"
                                            },
                                            {
                                                "example_id": "5ea580cd-9a13-4301-90c2-1519df963d9e",
                                                "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                                "text": "„Der dünne Silberklang des Cembalos zitterte manchmal ein wenig wie das Werk einer Spieldose.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
