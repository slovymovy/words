                                "target_senses": [
                                    {
                                        "sense_id": "499bc199-562f-3eff-ac2b-689853d21a62",
                                        "entry_id": "e7a6e279-829b-3fa3-b63d-92636c77c666",
                                        "glosses": [
                                            "устар. молодой светский щёголь, франт, рабски подражающий всему французскому"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32a580af-0ed6-4e9e-94ab-899ec0f9ac12",
                                                "sense_id": "499bc199-562f-3eff-ac2b-689853d21a62",
                                                "text": "Вот она, немецкая слобода, где юные петиметры, молодые люди начинают распутствовать, думая, что они в Европе."
                                            },
                                            {
                                                "example_id": "261a3034-0d09-439c-bb2c-90bbf2e9c92a",
                                                "sense_id": "499bc199-562f-3eff-ac2b-689853d21a62",
                                                "text": "Здесь было любимое место московских франтов ― петиметров, как называла их тогдашняя сатирическая литература."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
