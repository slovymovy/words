                                "target_senses": [
                                    {
                                        "sense_id": "93184537-78fa-34ae-8494-247263e00b16",
                                        "entry_id": "e387a5dc-8bdd-34a3-88e7-7fd148253be0",
                                        "glosses": [
                                            "A diversion or deviation from one's original route."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0940e673-aa82-4524-aab9-ea092de33d5e",
                                                "sense_id": "93184537-78fa-34ae-8494-247263e00b16",
                                                "text": "On the third day I made a detour westward to avoid the country of the Band-lu, as I did not care to be detained by a meeting with To-jo."
                                            },
                                            {
                                                "example_id": "6a332b57-a5c6-4fe5-846d-702d02b438f0",
                                                "sense_id": "93184537-78fa-34ae-8494-247263e00b16",
                                                "text": "Of course the Johnston swings around to engage the entire flotilla, and, despite taking several more hits, Johnston successfully forces away the first two ships, which leads to the entire squadron taking a detour to avoid the single pugnacious ship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7710e994-c968-3666-93f6-87aa5662dcf5",
                                        "entry_id": "e387a5dc-8bdd-34a3-88e7-7fd148253be0",
                                        "glosses": [
                                            "An temporary alternative route available to motorists away from the usual route due to a closure for repairs, dealing with an accident, or some event rendering the usual route unusable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "detour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "98549335-cc00-31c2-9500-1fd30476614a",
