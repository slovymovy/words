                        "glosses": [
                            "Arbre ou arbuste du genre Mimusops, de la famille des sapotacées, poussant en zone tropicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57abc553-b38e-4b64-b8ab-7cdfc7ecedaa",
                                "sense_id": "6a6ece03-a767-39d0-bf87-d2867e97739c",
                                "text": "Les mimusopes sont des arbres à feuilles simples, alternes, et à fleurs ordinairement fasciculées sur les rameaux dans les aisselles des feuilles."
                            },
                            {
                                "example_id": "3c8d9bfc-d48a-45df-ae77-8d67daa6ed24",
                                "sense_id": "6a6ece03-a767-39d0-bf87-d2867e97739c",
                                "text": "Nous avons dit à l’article Imbricaria que ce genre ne différait du Mimusope que par ses lanières trifides sur trois rangs, et par la crête saillante des graines."
                            }
                        ]
                    }
