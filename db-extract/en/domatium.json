                    {
                        "sense_id": "039feac6-1eea-3668-9b85-31b3f871ddb0",
                        "entry_id": "041d43ac-f19e-3272-b45e-202eab1397da",
                        "glosses": [
                            "Domatie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cd43664-b24f-42ca-a02b-062155beda01",
                                "sense_id": "039feac6-1eea-3668-9b85-31b3f871ddb0",
                                "text": "The angiosperm family Rubiaceae contains the highest diversity of ant plants, and the new study focused on those in the subtribe Hydnophytinae, of which some 100 species are found in southeast Asia and Australasia. These epiphytes form hollow tubers, known as domatia, with preformed entrance holes, which give access to a network of galleries that provide the ants with protected nesting space."
                            }
                        ]
                    }
