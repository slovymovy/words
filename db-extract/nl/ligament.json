                            {
                                "example_id": "ad50992d-4a77-417b-8747-0c44e9908460",
                                "sense_id": "6b0f0c1e-c6b4-30c9-b6d3-2199fb4bb6a3",
                                "text": "De ligamenten bestaan ook uit bindweefsel en vormen de verbinding tussen de botten. Ze helpen het gewricht te stabiliseren."
                            }
                        ]
                    },
                    {
                        "sense_id": "9cdc22a7-b2e5-3c36-a66a-a72525508e6c",
                        "entry_id": "689fb001-1616-31e0-953a-79a1c2ae9679",
                        "glosses": [
                            "elastische delen van de slotband van een schelp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1251941-b3b7-4877-ab7b-58cd0a8fa334",
                                "sense_id": "9cdc22a7-b2e5-3c36-a66a-a72525508e6c",
                                "text": "Om de kleppen bij elkaar te houden hebben veel soorten tweekleppigen ook een band (ligament) van hoornstof."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22dc9898-8776-45d8-bf78-70e3308e414a",
                        "source_entry_id": "689fb001-1616-31e0-953a-79a1c2ae9679",
