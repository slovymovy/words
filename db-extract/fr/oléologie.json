                        "entry_id": "6928616b-d634-352b-814f-d2e52f28cb08",
                        "glosses": [
                            "Étude de l’huile d’olive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdbb2c84-14d2-4c28-8962-963463475569",
                                "sense_id": "0dd24da2-1055-3ece-965c-147d75bf9fb5",
                                "text": "En 2010, j’ai passé un diplôme d’oléologie à l’UFR des sciences de l’Université de Montpellier. Cette formation m’a permis d’avoir une approche très complète sur tout ce qui touche à l’olivier, l’olive et l’huile."
                            },
                            {
                                "example_id": "c46b4316-6396-455c-b6d9-667ace0e6238",
                                "sense_id": "0dd24da2-1055-3ece-965c-147d75bf9fb5",
                                "text": "De plus en plus, sur le modèle du vin, on parle donc d’oléologie où comme pendant une session d’œnologie, l’huile se savoure mais surtout se comprend et s’apprend."
                            }
                        ]
                    }
