                        "cross_references": [
                            {
                                "target_word": "Veitstanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb343649-f160-3d18-a5e4-31bd2bbcf8bc",
                                        "entry_id": "c8b2c350-f357-3370-ab77-e6ea11d20ecf",
                                        "glosses": [
                                            "Veitstanz ist eine veraltete Bezeichnung für die krampfartigen Zuckungen eines an der Nervenkrankheit Ergotismus Erkrankten, verursacht durch eine Vergiftung mit dem im Mutterkorn enthaltenden Nervengift Ergotamin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c99e41-5515-4c96-b696-258039418224",
                                                "sense_id": "bb343649-f160-3d18-a5e4-31bd2bbcf8bc",
                                                "text": "Wie im Veitstanz springend."
                                            },
                                            {
                                                "example_id": "2ff6b8f9-9807-4d1e-a694-f7c3649c1b05",
                                                "sense_id": "bb343649-f160-3d18-a5e4-31bd2bbcf8bc",
                                                "text": "„Vielmehr befiel ein unaufhaltsames Zittern ihren ganzen Körper, schüttelte ihn, als hätte sie einen Veitstanz, wobei sie auf jeden ihrer Angehörigen einzeln zuzugehen und ihn zu betasten versuchte.“"
                                            },
                                            {
                                                "example_id": "8869a0ef-a86a-4389-9c24-36423d6b304a",
                                                "sense_id": "bb343649-f160-3d18-a5e4-31bd2bbcf8bc",
                                                "text": "„Der ›Veitstanz‹, wie die Anfälle bei Epilepsie und Tollwut unterschiedslos genannt wurden, hat seinen Namen von ihm.“"
                                            },
                                            {
                                                "example_id": "b3876cc4-c9ba-429b-9fe1-251f6a8a4ab5",
                                                "sense_id": "bb343649-f160-3d18-a5e4-31bd2bbcf8bc",
                                                "text": "Sein Körper geriet in einen unkontrollierten Veitstanz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce38d9d1-b96a-359c-930d-d537a8a4577f",
                                        "entry_id": "c8b2c350-f357-3370-ab77-e6ea11d20ecf",
                                        "glosses": [
                                            "Bezeichnung für die Nervenkrankheiten Chorea major (Huntington) und Chorea minor (Sydenham)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1489aa96-b527-4417-8bb0-416c177470f1",
                                                "sense_id": "ce38d9d1-b96a-359c-930d-d537a8a4577f",
                                                "text": "Sein Körper geriet in einen unkontrollierten Veitstanz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a7aa31cd-8d09-311e-b3d8-d0fb597edeac",
                                        "entry_id": "c8b2c350-f357-3370-ab77-e6ea11d20ecf",
                                        "glosses": [
                                            "Bezeichnung der Tanzwut aus dem 14. Jahrhundert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc8a523-a9e3-49c5-8a86-db0546c8c289",
                                                "sense_id": "a7aa31cd-8d09-311e-b3d8-d0fb597edeac",
                                                "text": "„Die gelehrten Kreise Berlins waren fast vom Veitstanz ergriffen, als ihnen die Phänomene vorgeführt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
