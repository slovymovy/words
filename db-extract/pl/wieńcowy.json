                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54d67c95-ae06-4e46-aa93-c8f6298fcd0e",
                                "sense_id": "df4334de-3c9e-33f1-994f-9de6d9685097",
                                "text": "Jedną z przyczyn choroby wieńcowej jest miażdżyca tętnic wieńcowych."
                            },
                            {
                                "example_id": "ed49ad6d-e508-4feb-88f6-ac86b006cc37",
                                "sense_id": "df4334de-3c9e-33f1-994f-9de6d9685097",
                                "text": "Abcyksymab stosuje się u pacjentów poddawanych przezskórnym interwencjom wieńcowym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
