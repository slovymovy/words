                "senses": [
                    {
                        "sense_id": "6cf35da3-6e5e-3521-b309-177c9456d130",
                        "entry_id": "0de5f40f-4e3e-3abc-948c-30acb0f26022",
                        "glosses": [
                            "tadelnde und zurechtweisende Worte, meist von einer höherstehenden Person"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9284efa9-3c48-46a8-8f38-a8aea92aa9a7",
                                "sense_id": "6cf35da3-6e5e-3521-b309-177c9456d130",
                                "text": "Dafür hat er aber mächtigen Anschiss bekommen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c4df3f8-233d-4b78-a2ba-5e74a3942879",
                        "source_entry_id": "0de5f40f-4e3e-3abc-948c-30acb0f26022",
                        "source_sense_id": "6cf35da3-6e5e-3521-b309-177c9456d130",
                        "source_sense_description": "tadelnde und zurechtweisende Worte, meist von einer höherstehenden Person",
                        "target_lang_word": "dressing-down",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dressing-down",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0389a7a0-b8b8-3bdd-a2a9-ed0a24d06423",
                                        "entry_id": "07dbbf6a-2b7b-3432-870e-e51bb7c8c7ef",
                                        "glosses": [
                                            "A reprimand or rarely, a thrashing."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef7fb5e5-9b90-4675-a752-322494c621a6",
                                                "sense_id": "0389a7a0-b8b8-3bdd-a2a9-ed0a24d06423",
                                                "text": "\"I'll give him a dressing down, see if I don't.\" Mrs. Mudge's eyes snapped viciously, and she clutched the relics of the broom with a degree of energy which rendered it uncertain what sort of a dressing down she intended for her husband."
                                            },
                                            {
                                                "example_id": "1aa62190-6714-4ec4-b248-9e518949725d",
                                                "sense_id": "0389a7a0-b8b8-3bdd-a2a9-ed0a24d06423",
                                                "text": "When the blacksmith saw what Babo had done to his mother, he caught him by the collar, and fell to giving him such a dressing down as never man had before."
                                            },
                                            {
                                                "example_id": "ae7a3c6e-ad6a-4011-a005-8e524fad9f60",
                                                "sense_id": "0389a7a0-b8b8-3bdd-a2a9-ed0a24d06423",
                                                "text": "\"We must all bow to you, and try to get a favorable word, must we? This man shall have a leg up, and this man shall have a dressing down!\""
                                            },
                                            {
                                                "example_id": "12154691-b238-47c0-82d5-36d8edac6778",
                                                "sense_id": "0389a7a0-b8b8-3bdd-a2a9-ed0a24d06423",
                                                "text": "Just ask Gen. Yevgeny I. Ignatov, a former mayor of Torzhok, who stepped down two years ago after a dressing-down from the regional governor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a08247e6-8885-46bc-9ef7-021f7e8933c2",
                        "source_entry_id": "0de5f40f-4e3e-3abc-948c-30acb0f26022",
                        "source_sense_id": "6cf35da3-6e5e-3521-b309-177c9456d130",
                        "source_sense_description": "tadelnde und zurechtweisende Worte, meist von einer höherstehenden Person",
                        "target_lang_word": "engueulade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engueulade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4848af-3ecc-37e9-b87b-b8a6e8fc8d83",
                                        "entry_id": "09bdb658-d06b-3a84-b9a3-15bb83c61062",
                                        "glosses": [
                                            "Action d’engueuler ou de s’engueuler."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78ed7d0a-7168-4f9d-9840-e2ac3f810907",
                                                "sense_id": "8f4848af-3ecc-37e9-b87b-b8a6e8fc8d83",
                                                "text": "Il y a des engueulades qui rougissent les yeux, bleuissent les joues, crispent les poings, arrachent les cheveux, cassent les œufs, renversent les éventaires, dépoitraillent les matrones, et me remplissent d'une joie pure."
                                            },
                                            {
                                                "example_id": "9748a355-a2de-4a25-962d-c783cd8a2019",
                                                "sense_id": "8f4848af-3ecc-37e9-b87b-b8a6e8fc8d83",
                                                "text": "Jude venait d’accueillir une engueulade du capitaine Trugex, lorsque Simon l’aperçut par hasard, affalé sur le marchepied d’un camion, au fond d’un garage, et pleurant à gros sanglots."
                                            },
                                            {
                                                "example_id": "dcf0f2f4-ea27-4f5e-8855-d58d13a58f14",
                                                "sense_id": "8f4848af-3ecc-37e9-b87b-b8a6e8fc8d83",
                                                "text": "La société traversait une période difficile, expliqua-t-il à Jed. Le nouveau siège social coûtait cher, et ils avaient raté un contrat important pour la rénovation d’une station balnéaire sur les bords de la mer Noire, il venait d’avoir une violente engueulade avec un des associés."
                                            },
                                            {
                                                "example_id": "9fc3ef43-8051-4f51-91bb-8954c26bf226",
                                                "sense_id": "8f4848af-3ecc-37e9-b87b-b8a6e8fc8d83",
                                                "text": "C’est l’un des paradoxes de l’époque : on se plaint des interviews consensuelles et aseptisées, mais dès qu’un échange est un peu tendu, il est considéré comme un clash, dès qu’une parole surnage, ça devient l’engueulade du siècle."
                                            },
                                            {
                                                "example_id": "db909d47-2231-449d-85db-29197350adfe",
                                                "sense_id": "8f4848af-3ecc-37e9-b87b-b8a6e8fc8d83",
                                                "text": "Bien que ce passage chez sa mère ait débuté par une séance d’engueulade en bonne et due forme, c'est tout revigoré que papa en repart."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
