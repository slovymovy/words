                                "target_senses": [
                                    {
                                        "sense_id": "433aaace-c760-3032-a131-54e3e7776773",
                                        "entry_id": "a3107ac3-c36b-34b9-b946-8bdfdf7fdcae",
                                        "glosses": [
                                            "Membre du genre Salvia, plantes souvent aromatiques de la famille des lamiacées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4d1b6df-8bc5-402f-bb32-8fd26b302664",
                                                "sense_id": "433aaace-c760-3032-a131-54e3e7776773",
                                                "text": "Ici de la verveine en fleur… là, trois brins de sauge cueillis à minuit dans le cimetière de ceux qui sont morts par l’épée."
                                            },
                                            {
                                                "example_id": "47d04773-07ba-4253-85b1-6ff86aa6c3a4",
                                                "sense_id": "433aaace-c760-3032-a131-54e3e7776773",
                                                "text": "Des lavandes faisaient bordure devant une touffe de sauge, deux ou trois rosiers pomponnants et un épais buisson d'herbe de la pampa arborant ses plumets vaniteusement décoratifs."
                                            },
                                            {
                                                "example_id": "db01c0a3-5c64-430f-91dd-ed0fa7f7bce4",
                                                "sense_id": "433aaace-c760-3032-a131-54e3e7776773",
                                                "text": "La sauge est considérée comme la reine des herbes aromatiques."
                                            },
                                            {
                                                "example_id": "496f2d6f-1dc1-4aa7-947b-1a1939223949",
                                                "sense_id": "433aaace-c760-3032-a131-54e3e7776773",
                                                "text": "Avant de rentrer dans la réserve du parc national de Purace, dans le sud-ouest de la Colombie, Rosendo Quira agite en signe de respect des branches de sauge trempées dans une décoction de plantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75d77fa5-b488-34e3-a59f-c9b08e090b65",
                                        "entry_id": "a3107ac3-c36b-34b9-b946-8bdfdf7fdcae",
                                        "glosses": [
                                            "Salvia officinalis, la sauge officinale, espèce à feuilles ridées et un peu épaisses, qui est employée comme tonique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "057eafb9-d6ab-45f2-ab6b-7a8a06e40ee9",
                                                "sense_id": "75d77fa5-b488-34e3-a59f-c9b08e090b65",
                                                "text": "Unique aromate de la cuisson des grives, la sauge avait son petit buisson au jardin. Elle sortait du domaine culinaire pour entrer dans la pharmacopée domestique – au même titre que de nombreuses plantes aromatiques."
                                            },
                                            {
                                                "example_id": "928d7134-3f1e-4bd6-9350-35ca0dd5965c",
                                                "sense_id": "75d77fa5-b488-34e3-a59f-c9b08e090b65",
                                                "text": "La sauge est œstrogénique, antioxydante, antalgique, anti-inflammatoire, neuro-protectrice, anti-asthénique et antiseptique localement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98ba8972-97e7-30b7-b089-d29176ee7274",
                                        "entry_id": "a3107ac3-c36b-34b9-b946-8bdfdf7fdcae",
                                        "glosses": [
                                            "Nom donné à de nombreuses plantes d’aspect ou d’usage similaire à la sauge officinale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
