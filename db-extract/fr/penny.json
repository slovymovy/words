                                                "text": "to turn an honest penny"
                                            },
                                            {
                                                "example_id": "65ba50d6-9e45-4abb-b53f-623165672c67",
                                                "sense_id": "2b331cb0-94fc-33e4-a3cf-471a8f6ff481",
