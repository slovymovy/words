                "senses": [
                    {
                        "sense_id": "25834087-5b67-39b5-a44e-9813ac5261a7",
                        "entry_id": "2991cc88-f5cb-3686-b521-52e9912b40d6",
                        "glosses": [
                            "overeenkomst voorlopig een einde te maken aan de gevechtshandelingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf39e2e-ff9c-40dc-82af-266eb11d26eb",
                                "sense_id": "25834087-5b67-39b5-a44e-9813ac5261a7",
                                "text": "Het staakt-het-vuren ging gisteren in, maar vandaag zijn er al weer vijandelijkheden uitgebroken."
                            },
                            {
                                "example_id": "cd7b1df8-9a35-4316-9ccf-586b7dc2f487",
                                "sense_id": "25834087-5b67-39b5-a44e-9813ac5261a7",
                                "text": "De onderhandelingen waren in een stroomversnelling geraakt, nadat in april van dat jaar een staakt-het-vuren overeen was gekomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fca37fd3-76ca-455a-8e40-fba8fdc01464",
                        "source_entry_id": "2991cc88-f5cb-3686-b521-52e9912b40d6",
                        "source_sense_id": "25834087-5b67-39b5-a44e-9813ac5261a7",
                        "source_sense_description": "overeenkomst voorlopig een einde te maken aan de gevechtshandelingen",
                        "target_lang_word": "Feuerpause",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerpause",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4300164-6362-3cb5-b2c0-e26d1ecf37f2",
                                        "entry_id": "6e7ca1c4-d082-37ae-a8dd-0176a21e32f5",
                                        "glosses": [
                                            "vorübergehende Einstellung von Kampfhandlungen mit Feuerwaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "289f210b-9fbc-474f-9471-fc2341bec415",
                                                "sense_id": "b4300164-6362-3cb5-b2c0-e26d1ecf37f2",
                                                "text": "„Russland hat eine Resolution des UN-Sicherheitsrats für eine einwöchige Feuerpause in der schwer umkämpften nordsyrischen Stadt Aleppo blockiert.“"
                                            },
                                            {
                                                "example_id": "0fb8fbde-e00a-4509-8183-3bb544eaca38",
                                                "sense_id": "b4300164-6362-3cb5-b2c0-e26d1ecf37f2",
                                                "text": "„Sie lauschen angespannt, aber es scheint tatsächlich eine Feuerpause eingetreten zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e2dce2b-92c9-49bb-b28d-db6adb37a039",
                        "source_entry_id": "2991cc88-f5cb-3686-b521-52e9912b40d6",
                        "source_sense_id": "25834087-5b67-39b5-a44e-9813ac5261a7",
                        "source_sense_description": "overeenkomst voorlopig een einde te maken aan de gevechtshandelingen",
                        "target_lang_word": "ceasefire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ceasefire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "355e805b-fd90-3497-9dc3-b852415af553",
                                        "entry_id": "9030a07f-b379-3c92-9e97-9875710d999f",
                                        "glosses": [
                                            "In warfare, an agreed end to hostilities for a specific purpose. (Typically only temporary)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dc54d3d-7f9e-435d-b76d-befd1ff4daf4",
                                                "sense_id": "355e805b-fd90-3497-9dc3-b852415af553",
                                                "text": "The rebels agreed to a ceasefire while the peace talks were underway."
                                            },
                                            {
                                                "example_id": "fafa991d-85e7-4a62-90db-9cfb6cbbe0f9",
                                                "sense_id": "355e805b-fd90-3497-9dc3-b852415af553",
                                                "text": "But residents say steady Russian military pressure – combined now with an American president’s apparent parroting of Kremlin talking points about the war, and his push for a ceasefire that could include Ukrainian territorial losses – means Russia is also winning in a different way, by escalating Ukrainian anxiety."
                                            },
                                            {
                                                "example_id": "6f76eb12-2059-4d02-ba0d-f6d4226be2a2",
                                                "sense_id": "355e805b-fd90-3497-9dc3-b852415af553",
                                                "text": "Putin’s answered by simply stating he did not believe Ukraine had honored the previous ceasefires Moscow had unilaterally called, and that Kyiv has said Moscow never respected either."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d285f30-5aa4-4542-80f1-c1c334ca9857",
                        "source_entry_id": "2991cc88-f5cb-3686-b521-52e9912b40d6",
                        "source_sense_id": "25834087-5b67-39b5-a44e-9813ac5261a7",
                        "source_sense_description": "overeenkomst voorlopig een einde te maken aan de gevechtshandelingen",
                        "target_lang_word": "cessez-le-feu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cessez-le-feu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d04a025-af23-3a07-b7a5-7d1a9845a467",
                                        "entry_id": "585bdc2a-10ee-3104-be4e-6d503e7dc711",
                                        "glosses": [
                                            "En guerre, une interruption des hostilités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "476e025c-37b1-4c27-9a12-39edeb208ebc",
                                                "sense_id": "2d04a025-af23-3a07-b7a5-7d1a9845a467",
                                                "text": "Le Président a qualifié d’« hypothétique » la possibilité de démilitariser Quemoy et Matsu en échange d'un cessez-le-feu, néanmoins il a reconnu que c'était théoriquement envisagé par la diplomatie américaine."
                                            },
                                            {
                                                "example_id": "e38d6a46-ebf5-41b6-9411-14df0e20f9d6",
                                                "sense_id": "2d04a025-af23-3a07-b7a5-7d1a9845a467",
                                                "text": "De la trêve au cessez-le-feu, jusqu’à la paix"
                                            },
                                            {
                                                "example_id": "6a24b171-ec94-482e-9be4-7ad5c5267ea2",
                                                "sense_id": "2d04a025-af23-3a07-b7a5-7d1a9845a467",
                                                "text": "Depuis le cessez-le-feu d’août 2014, Israël a ouvert le feu contre la bande de Gaza en « au moins 696 occasions », a déclaré le 11 septembre 2015 Tobias Ellwood, vice-secrétaire d’État aux Affaires étrangères et au Commonwealth, qui citait des chiffres en provenance de l’agence des Nations unies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
