                                "target_senses": [
                                    {
                                        "sense_id": "c9d16046-6026-3eea-8172-ef721ceef8c6",
                                        "entry_id": "0dba2256-db66-3550-8e55-71fa8b4c7845",
                                        "glosses": [
                                            "Joking, humorous remarks or behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e18dd33-304e-4a40-9d55-6910da120cd0",
                                                "sense_id": "c9d16046-6026-3eea-8172-ef721ceef8c6",
                                                "text": "It should seem he had that day been in a humour for jocularity and merriment, and upon such occasions I never knew a man laugh more heartily."
                                            },
                                            {
                                                "example_id": "480e1cc5-ea1d-4ac8-aca4-607d44d07ef0",
                                                "sense_id": "c9d16046-6026-3eea-8172-ef721ceef8c6",
                                                "text": "[…] Cristal Nixon at that moment rode up to them, and said, with an affectation of jocularity which sat very ill upon his sullen features, […]"
                                            },
                                            {
                                                "example_id": "68d59801-47a1-486d-95db-c3d3e2a24625",
                                                "sense_id": "c9d16046-6026-3eea-8172-ef721ceef8c6",
                                                "text": "All were armed with pistols, and there was a small armoury of rifles against a wall. “Guns,” I said with fearful jocularity, “in a holy place?”"
                                            },
                                            {
                                                "example_id": "adde4ee8-0ce0-4cc7-91bf-5ac43133ab55",
                                                "sense_id": "c9d16046-6026-3eea-8172-ef721ceef8c6",
                                                "text": "Madouc was neither pleased nor impressed by Prince Bittern’s mannerisms, and remained pointedly unresponsive to his lame jocularities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
