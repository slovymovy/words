                "senses": [
                    {
                        "sense_id": "e1ec79d3-d488-395b-b823-014cb401e097",
                        "entry_id": "f5633014-8af3-30e8-9e89-cd9e87fe6e2f",
                        "glosses": [
                            "zuverlässiges Wissen über einen bestimmten Gegenstandsbereich, ein bestimmtes Fach/Berufsfeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63352ad1-a76a-4c67-ad50-dc6d28c9ef01",
                                "sense_id": "e1ec79d3-d488-395b-b823-014cb401e097",
                                "text": "Dazu reichen deine Fachkenntnisse noch nicht aus."
                            },
                            {
                                "example_id": "3351e1ef-c2a1-47d8-a9fb-7921685eef5b",
                                "sense_id": "e1ec79d3-d488-395b-b823-014cb401e097",
                                "text": "Wenn man in einem Beruf arbeitet, muss man die nötigen Fachkenntnisse haben."
                            },
                            {
                                "example_id": "a4a92301-60a7-4a84-922d-a8857ad812f3",
                                "sense_id": "e1ec79d3-d488-395b-b823-014cb401e097",
                                "text": "„Zwar blieb ihr Vorstoß in den Traumberuf der Bibliothekarin erfolglos, die Bibliothek des Glasmuseums lehnte sie ab, obwohl sie mit Deutsch, Englisch und Fachkenntnissen in Sachen Schmuck die ideale Besetzung gewesen wäre.“"
                            },
                            {
                                "example_id": "9f230950-703f-47db-a5ff-f2b0a22d02f2",
                                "sense_id": "e1ec79d3-d488-395b-b823-014cb401e097",
                                "text": "„So diente er sich mit seinen Fachkenntnissen in Sachen Kunst der Moderne den Herrschenden an, als die Eroberungspolitik begann und die Deutschen ihre Raubzüge in Museen und Privatsammlungen der besetzten Gebiete aufnahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
