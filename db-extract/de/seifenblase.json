                        ],
                        "form": "die Seifenblasen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a7e0edf0-266e-3293-b2fd-4ca07ed4bc02",
                        "entry_id": "cd443243-6d50-3f6e-ac57-7e386952c573",
                        "glosses": [
                            "ein dünner Film Seifenwasser, der eine hohle Kugel mit schillernder Oberfläche formt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1968855f-d5d2-480b-9ff5-c28ccd26eb3f",
                                "sense_id": "a7e0edf0-266e-3293-b2fd-4ca07ed4bc02",
                                "text": "Als Kinder haben wir mit einem Becher Seifenlösung und einem Strohhalm Seifenblasen gemacht."
                            },
                            {
                                "example_id": "00ec271c-cb97-4809-9a8e-f79b3df404a8",
                                "sense_id": "a7e0edf0-266e-3293-b2fd-4ca07ed4bc02",
                                "text": "„Aus dem Garten von Stracks kamen Seifenblasen über den Zaun geflogen.“"
                            },
                            {
                                "example_id": "31c2a380-5f8a-4067-9a40-0a8b8e51db70",
                                "sense_id": "a7e0edf0-266e-3293-b2fd-4ca07ed4bc02",
                                "text": "„Eine Menge Seifenblasen scheinen auf einmal in meinem Gehirn zu platzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6939a698-2d98-3fb9-9a7a-4558a7d9ca10",
                        "entry_id": "cd443243-6d50-3f6e-ac57-7e386952c573",
                        "glosses": [
                            "ein Synonym für etwas, das zwar anziehend, aber dennoch inhaltslos ist"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e7744f96-560c-442d-863f-2569afa7e63e",
                                "sense_id": "6939a698-2d98-3fb9-9a7a-4558a7d9ca10",
                                "text": "Mein Traum von einer großen Gesangskarriere stellte sich als Seifenblase heraus."
                            },
                            {
                                "example_id": "5fed5327-6aca-4d13-ae8b-60a1a1058fbc",
                                "sense_id": "6939a698-2d98-3fb9-9a7a-4558a7d9ca10",
                                "text": "„Sie wollte nichts lieber, als sich in der Seifenblase zu verkriechen und die Welt um sich herum zu vergessen.“"
                            },
                            {
                                "example_id": "8404d904-2c75-49af-9ebc-1d956a80659e",
                                "sense_id": "6939a698-2d98-3fb9-9a7a-4558a7d9ca10",
                                "text": "„Jetzt, wo die Seifenblase des Reichtums langsam zerplatzte und Dubai zurück auf den Boden der Tatsachen kam, mochte Sophie das Land sogar noch mehr: die Hotels, die nicht mehr ausgebucht, und die Parkplätze, die mit verlassenen Mercedes-Limousinen übersät waren, deren Besitzer ihre Raten nicht mehr bezahlen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cdf9f10-591c-4960-9f44-956fd70429ac",
                        "source_entry_id": "cd443243-6d50-3f6e-ac57-7e386952c573",
                        "source_sense_id": "a7e0edf0-266e-3293-b2fd-4ca07ed4bc02",
