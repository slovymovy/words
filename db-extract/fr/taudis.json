        "fr-extract.jsonl": [
            {
                "entry_id": "42060a62-9c38-3ba2-b89f-6d6056323fdc",
                "word": "taudis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4c517a96-fbbc-3af8-9fe0-1017ee4a1394",
                        "entry_id": "42060a62-9c38-3ba2-b89f-6d6056323fdc",
                        "glosses": [
                            "Petit logement en mauvais état, voire insalubre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f001860-9d67-490b-aac2-fadc318c8ef5",
                                "sense_id": "4c517a96-fbbc-3af8-9fe0-1017ee4a1394",
                                "text": "Sa maison était propre, bien tenue ; elle tranchait avec la blancheur gaie de sa façade et le luisant de ses meubles, sur les taudis immondes où, d’ordinaire, croupissent dans la fange et dans la vermine, les marins bretons."
                            },
                            {
                                "example_id": "0340c6ba-e762-4d9b-983a-d0a59db74390",
                                "sense_id": "4c517a96-fbbc-3af8-9fe0-1017ee4a1394",
                                "text": "Sous le socialisme, bien entendu, il en ira tout autrement. Personne n’habitera plus de taudis puants, nul ne sera plus vêtu de haillons dégoûtants, n’aura plus à s’occuper d’enfants maladifs, affamés, dans des conditions inacceptables et absolument affreuses."
                            },
                            {
                                "example_id": "d4f45a9d-2585-4bfb-815d-ff12c9fbe9a5",
                                "sense_id": "4c517a96-fbbc-3af8-9fe0-1017ee4a1394",
                                "text": "Aussi les taudis marseillais sont innombrables et recèlent des accumulations incroyables, des promiscuités qui ravalent l’espèce humaine au niveau de l’animalité !"
                            }
                        ]
                    },
                    {
                        "sense_id": "e61ec969-ab52-3c52-be37-4f210247136a",
                        "entry_id": "42060a62-9c38-3ba2-b89f-6d6056323fdc",
                        "glosses": [
                            "Chambre, appartement où tout est en désordre et malpropre."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3c1348d2-54e8-4a95-960f-faca488ffaa7",
                                "sense_id": "e61ec969-ab52-3c52-be37-4f210247136a",
                                "text": "C’est un taudis, un vrai taudis."
                            },
                            {
                                "example_id": "b93aea6d-b731-48ff-b9c6-189ec50b76bb",
                                "sense_id": "e61ec969-ab52-3c52-be37-4f210247136a",
                                "text": "J'ai souvenir encore d'une rue, d'un quartier\n Qui me vit souffrir, grandir par les années\n C'est dans un vieux taudis que dix ans de ma vie\n J'apprenais à mentir, pourquoi vieillir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdbbeae0-c369-490e-95c7-7109131a9eac",
                        "source_entry_id": "42060a62-9c38-3ba2-b89f-6d6056323fdc",
                        "target_lang_word": "hovel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hovel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52f9a910-e541-31e0-802a-1761dca3aebb",
                                        "entry_id": "f1ec4091-82f7-3a33-8c17-db320f0d14c7",
                                        "glosses": [
                                            "An open shed for sheltering cattle, or protecting produce, etc., from the weather."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d8e7d86-c9f8-30b7-b0ce-a2bd8787dbfc",
                                        "entry_id": "f1ec4091-82f7-3a33-8c17-db320f0d14c7",
                                        "glosses": [
                                            "A poor cottage; a small, mean house; a hut."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "607668ab-d710-4002-80f7-b469e86e252a",
                                                "sense_id": "4d8e7d86-c9f8-30b7-b0ce-a2bd8787dbfc",
                                                "text": "'Behold! once more I kiss thee, and by that kiss I give to thee dominion over sea and earth, over the peasant in his hovel, over the monarch in his palace halls, and cities crowned with towers, and those who breathe therein.'"
                                            },
                                            {
                                                "example_id": "dbd8fbb1-00fa-4ab7-a7e0-390e27ca504c",
                                                "sense_id": "4d8e7d86-c9f8-30b7-b0ce-a2bd8787dbfc",
                                                "text": "The hovel stood in the centre of what had once been a vegetable garden, but was now a patch of rank weeds. Surrounding this, almost like a zareba, was an irregular ring of gorse and brambles, an unclaimed vestige of the original common."
                                            },
                                            {
                                                "example_id": "c0aaf70d-e65b-4a55-8978-76f2b439cbb4",
                                                "sense_id": "4d8e7d86-c9f8-30b7-b0ce-a2bd8787dbfc",
                                                "text": "I have to say it again, my Dearest Friend. What a wonderful Comedown for the Godhead! What a wonderful Comeuppance for Humankind! That’s because You, Lord God, Creator, Bellows Maker of All That Breathes, deigned to come to my hovel of a soul; once there, to fatten up the leanness of my soul with the plumpitude of Your Sacrament; that’s to say, with the plenitude of Your Divinity and Humanity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cd51824-9a0b-3ca1-8ada-b005046d73c2",
                                        "entry_id": "f1ec4091-82f7-3a33-8c17-db320f0d14c7",
                                        "glosses": [
                                            "In the manufacture of porcelain, a large, conical brick structure around which the firing kilns are grouped."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af0193a5-afb9-3fc0-af5a-d1f7c58be6ea",
                                        "entry_id": "f1ec4091-82f7-3a33-8c17-db320f0d14c7",
                                        "glosses": [
                                            "A straitjacket."
                                        ],
                                        "tags": [
                                            "Midwestern-US",
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hovel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96e7304d-a9bf-30c4-b58c-6b7bd5ad7555",
                                        "entry_id": "22aceccc-af0a-33d0-b5c8-90ea0d15e613",
                                        "glosses": [
                                            "To put in a hovel; to shelter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "852ba8a0-25ae-4126-a32f-14dffc8290ed",
                                                "sense_id": "96e7304d-a9bf-30c4-b58c-6b7bd5ad7555",
                                                "text": "To hovel thee with swine, and rogues forlorn."
                                            },
                                            {
                                                "example_id": "02332fe1-4c0b-4ea6-bdc8-7d89ba15cab6",
                                                "sense_id": "96e7304d-a9bf-30c4-b58c-6b7bd5ad7555",
                                                "text": "The poor are hovell'd and hustled together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e4a4a7-5f1f-3c5e-8807-6a444290d559",
                                        "entry_id": "22aceccc-af0a-33d0-b5c8-90ea0d15e613",
                                        "glosses": [
                                            "To construct a chimney so as to prevent smoking, by making two of the more exposed walls higher than the others, or making an opening on one side near the top."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
