                "senses": [
                    {
                        "sense_id": "396eeea4-855a-3618-97ed-28520b7137a4",
                        "entry_id": "c0382032-ab8e-3249-9577-038666e474df",
                        "glosses": [
                            "Richtantenne zum Senden und Empfangen von Ultrakurzwellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca96ef9f-df49-405b-9d93-c501c43a16c9",
                                "sense_id": "396eeea4-855a-3618-97ed-28520b7137a4",
                                "text": "„Durch Kombination einer gespeisten Antenne mit einem Direktor und einen Reflektor erhält man die einfachste Form der Yagiantenne.“"
                            },
                            {
                                "example_id": "e5c2eb9d-d4ad-4476-bd57-2e4fe688e78c",
                                "sense_id": "396eeea4-855a-3618-97ed-28520b7137a4",
                                "text": "„Die in der Grafik gezeigte Yagiantenne hat als aktiven Strahler einen Dipol und als passive Elemente einen Reflektor und drei Direktoren in unregelmäßigen Abständen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
