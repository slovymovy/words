                "senses": [
                    {
                        "sense_id": "24568848-2c4b-3cec-a660-59e5d0d78239",
                        "entry_id": "3c109d39-c7b6-3137-b484-4aa49c3ef827",
                        "glosses": [
                            "Retirer à quelque chose son caractère héroïque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d2e575-3a93-4142-b9d2-ada1a2271b10",
                                "sense_id": "24568848-2c4b-3cec-a660-59e5d0d78239",
                                "text": "Il est impossible de déshéroïser complètement la guerre, comme Soljenitsyne le demandait au général Grigorenko."
                            },
                            {
                                "example_id": "26e16e67-ed82-41f9-a070-d29fbe25946d",
                                "sense_id": "24568848-2c4b-3cec-a660-59e5d0d78239",
                                "text": "Mais une nouvelle génération est animée par une volonté de parler du quotidien, de « déshéroïser », de dénoncer le culte de la personnalité."
                            }
                        ]
                    }
