                "senses": [
                    {
                        "sense_id": "e3db6cb6-1c40-3f68-9ec6-217f919ea42d",
                        "entry_id": "9c4e55a0-c082-39dd-b44a-ae7b97405c8c",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4db69b22-9d40-4f91-bbdb-58add3fe356b",
                                "sense_id": "e3db6cb6-1c40-3f68-9ec6-217f919ea42d",
                                "text": "Frau Buck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3a9dfcdb-4b8b-4d6f-a9de-0c0ff030036a",
                                "sense_id": "e3db6cb6-1c40-3f68-9ec6-217f919ea42d",
                                "text": "Herr Buck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a34ed44c-e4c8-4091-9e96-bc1dba604385",
                                "sense_id": "e3db6cb6-1c40-3f68-9ec6-217f919ea42d",
                                "text": "Die Bucks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5e9bc13d-43ff-42a8-ac57-b19d95372717",
                                "sense_id": "e3db6cb6-1c40-3f68-9ec6-217f919ea42d",
                                "text": "Der Buck trägt nie die Schals, die die Buck ihm strickt."
                            },
                            {
                                "example_id": "e31fd66d-3fce-409c-9f34-602c7fd09b08",
                                "sense_id": "e3db6cb6-1c40-3f68-9ec6-217f919ea42d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Buck kommt, geht der Herr Buck.“"
                            },
                            {
                                "example_id": "5d007124-88f7-4694-9a61-576bb50dd1d2",
                                "sense_id": "e3db6cb6-1c40-3f68-9ec6-217f919ea42d",
                                "text": "Buck kommt und geht."
                            },
                            {
                                "example_id": "125f6187-fc5f-4731-bb77-2f7414a89010",
                                "sense_id": "e3db6cb6-1c40-3f68-9ec6-217f919ea42d",
                                "text": "Bucks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
