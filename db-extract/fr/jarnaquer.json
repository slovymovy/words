                "senses": [
                    {
                        "sense_id": "7fb075a2-c164-35b4-93b6-44bee1250058",
                        "entry_id": "5cad6943-8031-3c49-ae53-23b2e52cb198",
                        "glosses": [
                            "Faire un coup de Jarnac."
                        ],
                        "tags": [
                            "En particulier au jeu de Jarnac"
                        ],
                        "examples": [
                            {
                                "example_id": "16fb320d-452a-4b3e-8739-72b455a33dc5",
                                "sense_id": "7fb075a2-c164-35b4-93b6-44bee1250058",
                                "text": "En effet, quand on ne joue pas on cherche sans cesse à voler (jarnaquer) des mots de l'adversaire."
                            },
                            {
                                "example_id": "737beddb-cb71-4940-861d-919b00fd4334",
                                "sense_id": "7fb075a2-c164-35b4-93b6-44bee1250058",
                                "text": "Ou bien est-ce que vous vous permettez de le jarnaquer dès lors qu'un 2ème mot est posé ?"
                            },
                            {
                                "example_id": "5eaf55f1-45b7-480a-8c43-0404d4635877",
                                "sense_id": "7fb075a2-c164-35b4-93b6-44bee1250058",
                                "text": "Si le mot est faux, la main passe à l'adversaire, qui peut éventuellement “jarnaquer\"."
                            }
                        ]
                    }
