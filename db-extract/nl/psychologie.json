                                        "entry_id": "e58671ff-317a-3df3-92b3-6af8571f7473",
                                        "glosses": [
                                            "Prudencia y tacto en el trato a las personas."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
