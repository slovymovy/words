                ],
                "senses": [
                    {
                        "sense_id": "c09a3839-0d79-3397-83f7-fa2151356ec2",
                        "entry_id": "4b0cb222-680d-375b-aa6f-71637b654fe0",
                        "glosses": [
                            "Donner un caractère interprofessionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc05932a-8d91-474d-8e2b-7daf89304883",
                                "sense_id": "c09a3839-0d79-3397-83f7-fa2151356ec2",
                                "text": "Une façon d'inter-professionnaliser le métier."
                            },
                            {
                                "example_id": "e69bf715-dc9a-41ad-97b4-7dd1e27ce98e",
                                "sense_id": "c09a3839-0d79-3397-83f7-fa2151356ec2",
                                "text": "Désireux avant tout de voir les professions se regrouper et s’inter-professionnaliser, mutualiser leurs savoir-faire et leurs coûts, et bénéficier ainsi de la transversalité des compétences et des économies d’échelle."
                            },
                            {
                                "example_id": "b872dcdb-b73f-4111-ac0b-822270c57b5c",
                                "sense_id": "c09a3839-0d79-3397-83f7-fa2151356ec2",
                                "text": "Si certaines caisses de retraite par répartition s'inter-professionnalisent et se déterritorialisent, il s'agit d'un processus négocié qui prendra infiniment plus de temps que la concentration des gestionnaires d’actifs, filiales de banques ou d’assurances."
                            }
                        ]
                    }
                ],
