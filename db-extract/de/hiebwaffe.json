                        "cross_references": [
                            {
                                "target_word": "arme blanche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c508ed6-93f7-3566-9a1a-89ef7a226334",
                                        "entry_id": "f32b05a3-8d11-36eb-9744-8ab5334690b9",
                                        "glosses": [
                                            "Arme ni gravée, ni dorée, ni bronzée."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98c0ac81-6744-3787-b66e-e048f5bc54fb",
                                        "entry_id": "f32b05a3-8d11-36eb-9744-8ab5334690b9",
                                        "glosses": [
                                            "Arme offensive, tranchante, perforante ou contondante, par opposition à l’arme à feu."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d058f420-6329-4dd2-abd9-58904b9627ef",
                                                "sense_id": "98c0ac81-6744-3787-b66e-e048f5bc54fb",
                                                "text": "Nous attaquerons à l'arme blanche!"
                                            },
                                            {
                                                "example_id": "4375573e-6dd4-4743-920d-b3f93dbf1d3b",
                                                "sense_id": "98c0ac81-6744-3787-b66e-e048f5bc54fb",
                                                "text": "Le 4 décembre, Kendy, un adolescent de 15 ans, a été tué par arme blanche, à Ézanville (Val-d’Oise)."
                                            },
                                            {
                                                "example_id": "adeec547-b9bc-4d6f-98b1-7cfc839b4298",
                                                "sense_id": "98c0ac81-6744-3787-b66e-e048f5bc54fb",
                                                "text": "L’endroit était presque vide, mais sur divers établis étaient déployés des dizaines d’armes blanches, et des outils qui pouvaient être considérés comme autant d’armes. Haches, rasoirs, machettes, marteaux, poignards, couteaux, dagues étaient stockés, empilés, parfois jetés au sol."
                                            }
                                        ]
                                    }
                                ]
                            }
