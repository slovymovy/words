                    }
                ],
                "senses": [
                    {
                        "sense_id": "32425381-e485-328f-bbaa-5b1c859593a2",
                        "entry_id": "4e3062a3-ee15-3ec9-95ef-316faa1b7e79",
                        "glosses": [
                            "Frau, die großen Schrecken verbreitet; böses, rasendes Weib"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40b35634-91ca-406d-9984-989e13f92ea0",
                                "sense_id": "32425381-e485-328f-bbaa-5b1c859593a2",
                                "text": "„Nur zwei Megären keifen einsam gegeneinander.“"
                            },
                            {
                                "example_id": "14feff62-9768-4dbb-9a73-4447c3820f52",
                                "sense_id": "32425381-e485-328f-bbaa-5b1c859593a2",
                                "text": "„Clintons zweite Stütze ist seine Frau Hillary. Die ausgezeichnete Juristin wurde im Wahlkampf immer wieder als feministische Megäre gebrandmarkt, die an den amerikanischen Werten rüttelt.“"
                            },
                            {
                                "example_id": "69a6fd09-2716-42b3-b63d-93c7d24c2116",
                                "sense_id": "32425381-e485-328f-bbaa-5b1c859593a2",
                                "text": "„In diesem Augenblick verurteilte ich mich selbst zum Tode, war aber fest entschlossen, vor meinem letzten Atemzug mit eigenen Händen die Megäre in Stücke zu reißen, die mich zum unglücklichsten aller Menschen gemacht hatte.“"
                            },
                            {
                                "example_id": "36c3ca3a-bb6c-4adb-b4fc-53a066c486e3",
                                "sense_id": "32425381-e485-328f-bbaa-5b1c859593a2",
                                "text": "„Die wässerigen Augen der Megären glotzten leer zur Kellerdecke, die Knuten hingen schlaff von den Hüften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
