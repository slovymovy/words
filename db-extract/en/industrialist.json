                                            {
                                                "example_id": "c8fd380a-192e-4c70-9c89-0a43b07226b5",
                                                "sense_id": "baba901a-6a8f-38d1-8e7f-fabc43b50a0d",
                                                "text": "Der Industrielle Oskar Schindler rettete etwa 1200 Juden das Leben, weil er diese in seiner Fabrik arbeiten ließ."
                                            },
                                            {
                                                "example_id": "114cb464-6e95-47af-9554-466f4c636abb",
                                                "sense_id": "baba901a-6a8f-38d1-8e7f-fabc43b50a0d",
                                                "text": "„Deutsche Industrielle waren mit ihrer viel jüngeren Geliebten dort.“"
                                            },
                                            {
                                                "example_id": "9822062a-2284-4a84-8e7e-c4815430c3a5",
                                                "sense_id": "baba901a-6a8f-38d1-8e7f-fabc43b50a0d",
                                                "text": "„Deutliche Spuren von akademischen Ressentiments verrät auch der intelligente Dialog zwischen einem Privatdozenten der Nationalökonomie und einem Industriellen.“"
                                            },
                                            {
                                                "example_id": "8e0805f6-24a6-4ff9-97cc-c2c166955f0d",
                                                "sense_id": "baba901a-6a8f-38d1-8e7f-fabc43b50a0d",
                                                "text": "„Die Brüder Nawaz und Shahbaz Sharif sind im Gegensatz zu den Bhuttos Vertreter der Industriellen Pakistans und werden gemeinhin zu den fünf reichsten Familien des Landes gezählt.“"
                                            },
                                            {
                                                "example_id": "60bce227-608b-4663-ac4a-9d05fe8400ce",
                                                "sense_id": "baba901a-6a8f-38d1-8e7f-fabc43b50a0d",
                                                "text": "„1924 wurde deren berühmtestem Professor, Immanuel Kant, zum 200. Geburtstag ein neues, pompöses Ehrenmal spendiert; es stiftete ein westdeutscher Industrieller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
