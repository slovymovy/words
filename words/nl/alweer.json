{
    "word_family": [
        "weer",
        "al"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "58a1770f-effd-35f7-bae8-a305c68d4110",
                    "sense_definition": "geeft aan dat iets sneller of eerder gebeurt dan verwacht",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is <w>alweer</w> negen uur en ik moet nog beginnen met werken.",
                            "target_lang_translations": {
                                "en": "It is <w>already</w> nine o'clock and I still have to start working."
                            }
                        },
                        {
                            "text": "Is het <w>alweer</w> oktober? Wat gaat de tijd toch ontzettend snel!",
                            "target_lang_translations": {
                                "en": "Is it October <w>already</w>? Time really does fly!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "is het alweer",
                        "gaat alweer voorbij"
                    ],
                    "target_lang_definitions": {
                        "en": "indicates that something is happening faster or sooner than expected"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "already",
                                "target_lang_sense_clarification": "so soon"
                            },
                            {
                                "target_lang_word": "yet again",
                                "target_lang_sense_clarification": "emphasizing the speed of recurrence"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fa3534b-4da8-32dc-8516-71081eee8020",
                    "sense_definition": "voor de herhaalde keer; opnieuw of nogmaals",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "herhaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het geeft niets dat je de som <w>alweer</w> fout hebt gemaakt.",
                            "target_lang_translations": {
                                "en": "It doesn't matter that you got the sum wrong <w>again</w>."
                            }
                        },
                        {
                            "text": "Hij heeft <w>alweer</w> dezelfde fout gemaakt ondanks mijn duidelijke waarschuwing.",
                            "target_lang_translations": {
                                "en": "He made the same mistake <w>yet again</w> despite my clear warning."
                            }
                        }
                    ],
                    "synonyms": [
                        "weeral"
                    ],
                    "common_phrases": [
                        "alweer hetzelfde",
                        "alweer een keer"
                    ],
                    "target_lang_definitions": {
                        "en": "for a repeated time; once more or again"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "again",
                                "target_lang_sense_clarification": "another time"
                            },
                            {
                                "target_lang_word": "once more",
                                "target_lang_sense_clarification": "repeated action"
                            },
                            {
                                "target_lang_word": "yet again",
                                "target_lang_sense_clarification": "emphasizing repetition"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}