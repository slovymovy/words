                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sibylline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd1dc5e7-cfbf-39fa-aa83-31883efbb933",
                                        "entry_id": "e5be0130-cbdc-361b-9aa0-85b3220c8e63",
                                        "glosses": [
                                            "Of or pertaining to or resembling a sibyl or female oracle, especially the Cumaean Sibyl and the Sibylline Books."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8f8592d-97c4-43c5-aa7c-57da24943417",
                                                "sense_id": "dd1dc5e7-cfbf-39fa-aa83-31883efbb933",
                                                "text": "Cleopatra immediately comes down to the chair of state; seizes Ptolemy and drags him out of his seat; then takes his place in the chair. Ftatateeta seats herself on the step of the loggia, and sits there, watching the scene with sybilline intensity."
                                            },
                                            {
                                                "example_id": "cf39beb3-846a-4f48-9e77-3b2882c40a20",
                                                "sense_id": "dd1dc5e7-cfbf-39fa-aa83-31883efbb933",
                                                "text": "But directly she had closed the door behind her, Mother Théot's manner underwent a chance. Here the broad light of day appeared to divest her of all her sybilline attributes. She became just an ugly old woman, wrinkled and hook-nosed, dressed in shabby draperies that were grey with age and dirt, and with claw-like hands that looked like the talons of a bird of prey."
                                            },
                                            {
                                                "example_id": "41a94e12-bd4e-4362-8b59-5caf19923c78",
                                                "sense_id": "dd1dc5e7-cfbf-39fa-aa83-31883efbb933",
                                                "text": "Another early form of rhapsodomancy is represented by the sibylline books."
                                            },
                                            {
                                                "example_id": "dbae73f9-4f82-4ac2-b79a-f157a03c38e9",
                                                "sense_id": "dd1dc5e7-cfbf-39fa-aa83-31883efbb933",
                                                "text": "Bitch ov a sibylline vulva / Usurpress and liar / Centuries wept because ov thee / Where art thou now in the hour ov trial?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c8ed5b8-e13a-3738-a5f7-22bf214c7d5e",
                                        "entry_id": "e5be0130-cbdc-361b-9aa0-85b3220c8e63",
                                        "glosses": [
                                            "Of or pertaining to or resembling a sibyl or female oracle, especially the Cumaean Sibyl and the Sibylline Books.",
                                            "Having oracle-like predicting powers, clairvoyant."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4319b80c-862e-3bbc-bf91-c7028c3bd5cc",
                                        "entry_id": "e5be0130-cbdc-361b-9aa0-85b3220c8e63",
                                        "glosses": [
                                            "Of or pertaining to or resembling a sibyl or female oracle, especially the Cumaean Sibyl and the Sibylline Books.",
                                            "Occult, mysterious."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "594e9db0-a4cb-34e4-a12e-e95b6186edcd",
                                        "entry_id": "e5be0130-cbdc-361b-9aa0-85b3220c8e63",
                                        "glosses": [
                                            "Excessively and exorbitantly expensive. (In allusion to the Sibyl who sold three books to Tarquinius Superbus at the price of the original nine.)"
                                        ],
