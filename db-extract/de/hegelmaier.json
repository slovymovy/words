                "senses": [
                    {
                        "sense_id": "b86a3c53-da14-3cdc-b95f-de5204743f57",
                        "entry_id": "e85851d6-f7d0-3eea-83d1-f1a8217bf898",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7614e152-11d4-414a-b5fe-9d5c753735f8",
                                "sense_id": "b86a3c53-da14-3cdc-b95f-de5204743f57",
                                "text": "Frau Hegelmaier ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "61547815-6504-4214-84a8-26b81709ea96",
                                "sense_id": "b86a3c53-da14-3cdc-b95f-de5204743f57",
                                "text": "Herr Hegelmaier wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ab256cc7-8f2f-4746-8b5d-be9b903ac687",
                                "sense_id": "b86a3c53-da14-3cdc-b95f-de5204743f57",
                                "text": "Die Hegelmaiers fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "0b0b4422-23ff-40ab-af72-c6ccc43a7e7a",
                                "sense_id": "b86a3c53-da14-3cdc-b95f-de5204743f57",
                                "text": "Der Hegelmaier trägt nie die Pullover, die die Hegelmaier ihm strickt."
                            },
                            {
                                "example_id": "fce7e6dd-b9d9-4800-a6c3-2a495fd863f2",
                                "sense_id": "b86a3c53-da14-3cdc-b95f-de5204743f57",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hegelmaier kommt, geht der Herr Hegelmaier.“"
                            },
                            {
                                "example_id": "00822285-abe5-4902-8996-86d3bb33946d",
                                "sense_id": "b86a3c53-da14-3cdc-b95f-de5204743f57",
                                "text": "Hegelmaier kommt und geht."
                            },
                            {
                                "example_id": "5a27779f-f130-41b9-a591-2510eab51d71",
                                "sense_id": "b86a3c53-da14-3cdc-b95f-de5204743f57",
                                "text": "Hegelmaiers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
