                                        "entry_id": "f3c10d8b-98a3-38ac-885f-d7a4221719f7",
                                        "glosses": [
                                            "Savoir garder son équilibre sur un bateau, ne pas y souffrir du mal de mer."
                                        ],
                                        "tags": [],
