            "pos": "noun",
            "senses": [
                {
                    "sense_id": "deb6826f-56b1-3ef3-bf5d-e883cdc8bd74",
                    "sense_definition": "Fête ou réunion caractérisée par la débauche, des excès de nourriture, de boisson ou des pratiques sexuelles en groupe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fete_exces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le banquet officiel, la soirée a dégénéré en une véritable <w>orgie</w> nocturne."
                        },
                        {
                            "text": "Les récits d'historiens évoquent souvent une <w>orgie</w> romaine où régnaient l'alcool et le désordre."
                        }
                    ],
                    "synonyms": [
                        "bacchanale",
                        "débauche"
                    ],
                    "common_phrases": [
                        "orgie romaine"
                    ]
                },
                {
                    "sense_id": "080740dd-49db-3442-8b7c-6bc96c895dcc",
                    "sense_definition": "Grande profusion, abondance excessive ou consommation effrénée de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "profusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant les fêtes de fin d'année, ils se sont offert une véritable <w>orgie</w> de chocolat."
                        },
                        {
                            "text": "Cette exposition d'art moderne offrait aux visiteurs une <w>orgie</w> de couleurs vives."
                        }
                    ],
                    "synonyms": [
                        "profusion",
                        "excès"
                    ],
                    "antonyms": [
                        "pénurie",
                        "frugalité"
                    ],
                    "common_phrases": [
                        "orgie de chocolat",
                        "orgie de nourriture"
                    ]
                },
                {
                    "sense_id": "44498650-5ab3-3f37-9413-7d9b05cad9e4",
                    "sense_definition": "Dans l'Antiquité païenne, fêtes religieuses et mystères célébrés en l'honneur de Bacchus ou Dionysos.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion_antique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles de Dionysos célébraient des <w>orgies</w> sacrées lors des cérémonies antiques."
                        },
                        {
                            "text": "Dans la mythologie grecque, chaque <w>orgie</w> rituelle rendait hommage au dieu de la vigne."
                        }
                    ],
                    "synonyms": [
                        "bacchanale",
                        "dionysie"
                    ],
                    "common_phrases": [
                        "orgies sacrées"
                    ]
                }
            ]
        }
    ]
