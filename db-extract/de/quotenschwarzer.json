                ],
                "senses": [
                    {
                        "sense_id": "3e93756d-075c-3bfa-be0a-ebebe150d702",
                        "entry_id": "6176cbc9-0452-38a7-9000-57b3723cd42b",
                        "glosses": [
                            "dunkelhäutige Person, die aufgrund einer Quotenregelung eine Position erlangt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5573b9a3-473e-4aff-b117-714e014bc05d",
                                "sense_id": "3e93756d-075c-3bfa-be0a-ebebe150d702",
                                "text": "Gibt es eine amerikanische Fernsehserie ohne Quotenschwarzen?"
                            },
                            {
                                "example_id": "1e2e78f3-2724-4cde-a39e-ab745ebf4056",
                                "sense_id": "3e93756d-075c-3bfa-be0a-ebebe150d702",
                                "text": "„Ansonsten ist Rain unverfälscht aus \"Aliens\" übernommen, aus \"Deep Blue Sea\" hat man den Trick gelernt, früh einen Schauspieler zu opfern, bei dem es das Publikum nicht erwartet hat (hier wie dort der Quotenschwarze).“"
                            },
                            {
                                "example_id": "cf202caf-310d-42b5-ba15-8529fcba1072",
                                "sense_id": "3e93756d-075c-3bfa-be0a-ebebe150d702",
                                "text": "„… Hudson war, wie man es gern sagte, der Quotenschwarze.“, sowie als Bildunterschrift „Ernie Hudson war mehr Quotenschwarzer denn Ghostbuster“"
                            },
                            {
                                "example_id": "468958c0-da5a-4870-ae21-c0d956dfe366",
                                "sense_id": "3e93756d-075c-3bfa-be0a-ebebe150d702",
                                "text": "„Quotenschwarzer und gleichzeitig Quotenrapper Busta Rhymes kann in etwa so gut schauspielern wie Florian Silbereisen rappen kann – nämlich gar nicht.“"
                            },
                            {
                                "example_id": "0bcbb4af-6bb1-479e-896e-22af91b7ce59",
                                "sense_id": "3e93756d-075c-3bfa-be0a-ebebe150d702",
                                "text": "„Aber Anthony Hopkins als stereotyp langweilender Boss, Dougray Scott als 08/15-Böser-Agent ohne Charisma und nachvollziehbares Motiv, Brendan Gleeson als skrupelloser Abziehbild-Magnat und Ving Rhames als Quotenschwarzer, über den gelacht werden darf (Hollywood erklärt uns die Welt), bewegen sich auf dem gleichen niedrigen Niveau.“"
                            },
                            {
                                "example_id": "18bd93fb-2331-4fb9-aa05-c79d0fa8c52b",
                                "sense_id": "3e93756d-075c-3bfa-be0a-ebebe150d702",
                                "text": "„Er fällt in Nairobi, der Satz. Ishmael, Quotenschwarzer sozusagen im Kriminalkommissariat von Maple Bluff/Wisconsin, einer Gemeinde, die regelmäßig zu den lebenswertesten Gemeinden der Vereinigten Staaten gewählt wird, sagt ihn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
