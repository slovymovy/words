                ],
                "senses": [
                    {
                        "sense_id": "bb66d711-0302-3dc9-b66d-ae9f51a33cfe",
                        "entry_id": "e3efe3c4-9289-3294-bbd0-13753939dd0b",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a5a5576-4bcb-44bf-b302-711b5946769b",
                                "sense_id": "bb66d711-0302-3dc9-b66d-ae9f51a33cfe",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Acer kommt, geht der Herr Acer.“"
                            },
                            {
                                "example_id": "559a4498-4c2c-4b9e-ab0b-e35cf5d59f6e",
                                "sense_id": "bb66d711-0302-3dc9-b66d-ae9f51a33cfe",
                                "text": "Acer kommt und geht."
                            },
                            {
                                "example_id": "beb16b3f-7913-4478-b263-298a2b98e4c6",
                                "sense_id": "bb66d711-0302-3dc9-b66d-ae9f51a33cfe",
                                "text": "Acers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "4a270600-8f1e-49c4-b0e8-7b097eeb57ea",
                                "sense_id": "bb66d711-0302-3dc9-b66d-ae9f51a33cfe",
                                "text": "Frau Acer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9a2d25ba-69ff-427a-8341-19467b5c314e",
                                "sense_id": "bb66d711-0302-3dc9-b66d-ae9f51a33cfe",
                                "text": "Herr Acer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "316f76d0-9dbf-4885-be85-7bd4b00ef6d1",
                                "sense_id": "bb66d711-0302-3dc9-b66d-ae9f51a33cfe",
                                "text": "Die Acers kommen heute aus Köln."
                            },
                            {
                                "example_id": "69cdcfd8-dc1f-4cff-99ca-5121e0e7b72d",
                                "sense_id": "bb66d711-0302-3dc9-b66d-ae9f51a33cfe",
                                "text": "Der Acer trägt nie die Schals, die die Acer ihm strickt."
                            },
                            {
                                "example_id": "a74028f0-93e5-49c3-9236-7492934945d1",
                                "sense_id": "bb66d711-0302-3dc9-b66d-ae9f51a33cfe",
                                "text": "An verregneten Herbsttagen ist Familie Acers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "c6cc03cb-4508-43c5-b846-c8ff32e4b1af",
                                "sense_id": "bb66d711-0302-3dc9-b66d-ae9f51a33cfe",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Acer das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
