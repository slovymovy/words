                    {
                        "sense_id": "998048ff-4ed2-3832-8ce5-e67a4d5c44ff",
                        "entry_id": "d1e9ba03-64e0-31ed-a236-ab5bb59e394d",
                        "glosses": [
                            "een kopie van een document, gewoonlijk van een transactie of rekening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1210bab-7c6f-46c9-89d9-ec2c73b1c0e6",
                                "sense_id": "998048ff-4ed2-3832-8ce5-e67a4d5c44ff",
                                "text": "Er lagen een paar afschriften in de bus, meer niet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42a7dd5e-e8db-4fda-9d66-da6f4dcb6e47",
                        "source_entry_id": "d1e9ba03-64e0-31ed-a236-ab5bb59e394d",
                        "source_sense_id": "998048ff-4ed2-3832-8ce5-e67a4d5c44ff",
                        "target_lang_word": "Abschrift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abschrift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                        "entry_id": "d6ed3710-e6f5-3b72-bfc8-7998d4aa4339",
                                        "glosses": [
                                            "durch Abschreiben erzeugte Kopie eines Schriftstücks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58d1fe25-97ee-4702-aed4-d372c8185bcd",
                                                "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                                "text": "Diese Abschrift wurde von einem Mönch im Mittelalter angefertigt."
                                            },
                                            {
                                                "example_id": "fb91c1a7-df8f-40a8-9872-f67fb06a44f5",
                                                "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                                "text": "Die Abschriften der Dokumente sind in den Kriegswirren verloren gegangen."
                                            },
                                            {
                                                "example_id": "a4595c37-c645-4fc4-a98d-82b597cd9b7b",
                                                "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                                "text": "„Zum Glück erlaubte der von allem Antiken begeisterte Kirchenfürst sehr bald, dass Abschriften hergestellt wurden.“"
                                            },
                                            {
                                                "example_id": "14a76e6d-8ce3-441f-bdd0-8643c2c54507",
                                                "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                                "text": "„Die vorliegende Abschrift entstand acht Jahrzehnte später.“"
                                            },
                                            {
                                                "example_id": "62ae306c-2f24-461e-8a3a-d43243765365",
                                                "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                                "text": "„Sämtliche Glossen stammen aus der Entstehungszeit dieser Werke und werden seit jeher in den meisten Abschriften und Drucken mit aufgeführt.“"
                                            },
                                            {
                                                "example_id": "1dfafa45-d1f6-4511-b629-184539744e31",
                                                "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                                "text": "„Man weiß jedoch nicht, wo und von wem sie hergestellt wurde. Wahrscheinlich irgendwo in einem Kloster, wo Abschriften zumeist geleistet wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f06ec375-43ba-4402-b302-c9c3952382b8",
                        "source_entry_id": "d1e9ba03-64e0-31ed-a236-ab5bb59e394d",
                        "source_sense_id": "998048ff-4ed2-3832-8ce5-e67a4d5c44ff",
                        "target_lang_word": "transcription",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transcription",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "390c0ce1-1b7e-37ef-a0f7-2176b0a8484a",
                                        "entry_id": "e104f53d-70c6-3efb-b79a-7c01cb3e3241",
                                        "glosses": [
                                            "The act or process of transcribing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a01649-9f97-4196-8bfc-2067d730d07d",
                                                "sense_id": "390c0ce1-1b7e-37ef-a0f7-2176b0a8484a",
                                                "text": "One might eaſier beleeue that the error was committed in the tranſcription of the copy from Ptolomies library, and ſo that it had a ſucceſſiue propagation through all the copies diſperſed."
                                            },
                                            {
                                                "example_id": "dea7eedb-6fa8-4e55-881c-a06bdc21d4ad",
                                                "sense_id": "390c0ce1-1b7e-37ef-a0f7-2176b0a8484a",
                                                "text": "[...] the error originated in a mistaken transcription, as the locomotive involved was No. 61271 (a B1 4-6-0), not No. 61771."
                                            },
                                            {
                                                "example_id": "21068ffd-fa02-4c31-a648-d4e73a4b3646",
                                                "sense_id": "390c0ce1-1b7e-37ef-a0f7-2176b0a8484a",
                                                "text": "In other words, data are (re)constructed in the process of transcription as a result of multiple decisions that reflect both theoretical and ostensibly pragmatic considerations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40ddc562-69da-3d38-9713-f147cc12df7c",
                                        "entry_id": "e104f53d-70c6-3efb-b79a-7c01cb3e3241",
                                        "glosses": [
                                            "Something that has been transcribed, including:",
                                            "An adaptation of a composition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f765cc5-643c-4831-ada0-de6ed963c2fa",
                                                "sense_id": "40ddc562-69da-3d38-9713-f147cc12df7c",
                                                "text": "These frame tale interludes frequently include transcriptions of Italian folk songs."
                                            },
                                            {
                                                "example_id": "76935e91-12bf-42e9-8b44-081cb79d1615",
                                                "sense_id": "40ddc562-69da-3d38-9713-f147cc12df7c",
                                                "text": "In other words, the adantino was written first as an independent piece; it is, moreover, hardly more than an elaborated transcription of the little song, ‘Im Herbste’, written in 1828, with its two exactly similar strophes (each only five bars long) and four-bar piano epilogue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e11c2df6-ed0d-3d2b-bdc8-5c6147f5c4ed",
                                        "entry_id": "e104f53d-70c6-3efb-b79a-7c01cb3e3241",
                                        "glosses": [
                                            "Something that has been transcribed, including:",
                                            "A recorded radio or television programme."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94a77189-5a43-48b8-98de-80edaf55a156",
                                                "sense_id": "e11c2df6-ed0d-3d2b-bdc8-5c6147f5c4ed",
                                                "text": "From the outset, Selvage had hoped to interest NBC or CBS in broadcasting the American Family Robinson on a sustaining basis. Neither did, and the series ended up in transcription, recorded and circulated to individual stations by the World Broadcasting System."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cda6546-8db9-3aa7-8831-97ffec7b1f32",
                                        "entry_id": "e104f53d-70c6-3efb-b79a-7c01cb3e3241",
                                        "glosses": [
                                            "Something that has been transcribed, including:",
                                            "A representation of speech sounds as phonetic symbols."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed76d03b-211f-42b6-81ae-335b99cf473e",
                                                "sense_id": "6cda6546-8db9-3aa7-8831-97ffec7b1f32",
                                                "text": "While the sounds of the language [English] undergo constant change and growth, the writing system is rarely reviewed or adapted to recent changes in speech. Consequently, there is a patent need for a transcription in linguistic research and dictionaries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82246772-c253-3d28-9a5a-4d0fba70a949",
                                        "entry_id": "e104f53d-70c6-3efb-b79a-7c01cb3e3241",
                                        "glosses": [
                                            "A written document."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a95821a-b802-4f2d-b0f7-1a974319c96d",
                                                "sense_id": "82246772-c253-3d28-9a5a-4d0fba70a949",
                                                "text": "THeſe Ages have beene, and are to this day, much indebted to Tranſcriptions. Inventions are oft-times ſlow, where the application of things invented to the preſent State ſeemes more facile and eaſie : Hereto then ſhould the Scope of Hiſtories tend ; not onely to perſonate the Acts of men upon the Theater of this world, but likewiſe to cull out ſuch Lawes, Orders, and Precepts, as well Morall as Divine, which may benefit their preſent eſtate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2fd0560-d2ff-3d18-ab4a-862bac5f29a4",
                                        "entry_id": "e104f53d-70c6-3efb-b79a-7c01cb3e3241",
                                        "glosses": [
                                            "The synthesis of RNA under the direction of DNA."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ab22e95-8441-4df6-92a4-11338d50f2f1",
                                                "sense_id": "c2fd0560-d2ff-3d18-ab4a-862bac5f29a4",
                                                "text": "The process in which the DNA molecule unwinds, separates its two polynucleotide strands, and synthesizes an RNA molecule from one of these DNA strands is called transcription. Genes transcribe chemical messages in the form of RNA molecules. Transcription begins at some site in the DNA duplex and ends at some other point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da203ef6-4c51-47fd-ab1e-f2fc2c52695c",
                        "source_entry_id": "d1e9ba03-64e0-31ed-a236-ab5bb59e394d",
                        "source_sense_id": "998048ff-4ed2-3832-8ce5-e67a4d5c44ff",
