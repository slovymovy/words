                ],
                "senses": [
                    {
                        "sense_id": "a5041ee5-ceba-35ee-8a32-a599490e3ad7",
                        "entry_id": "a33ceadc-f58f-324f-b543-373cac5b90df",
                        "glosses": [
                            "Anrede, Benennung mit einer bestimmten Bezeichnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f53905c6-a1d5-4209-a409-a972eb050b73",
                                "sense_id": "a5041ee5-ceba-35ee-8a32-a599490e3ad7",
                                "text": "„Selbst gegen seine diskriminierende Titulierung der Technologenbaracke als ‚Faultierfarm‘ gibt es keinen offiziellen Protest.“"
                            },
                            {
                                "example_id": "6bcdbfeb-983c-4c23-9dc5-cb8f00e6f3ef",
                                "sense_id": "a5041ee5-ceba-35ee-8a32-a599490e3ad7",
                                "text": "„So gilt in der Anrede beim Gruß innerhalb der Familie, dass der ältere vom jüngeren Bruder mit juädä und die ältere Schwester vom jüngeren Bruder mit nju angeredet wird. Diese Titulierung gilt auch schon während der Jugend und nicht erst im Erwachsenenalter.“"
                            },
                            {
                                "example_id": "516573f6-c3f7-417f-afbf-7a7765c1bab3",
                                "sense_id": "a5041ee5-ceba-35ee-8a32-a599490e3ad7",
                                "text": "„Außerhalb des Sprachraums läßt sich die Titulierung ‚Intendant‘ indes nicht nachweisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ab050bb7-9135-3308-8157-0630a0a1ed58",
                        "entry_id": "a33ceadc-f58f-324f-b543-373cac5b90df",
                        "glosses": [
                            "gerichtliche oder notarielle Feststellung, dass ein (Zahlungs-)Anspruch besteht"
                        ],
                        "tags": [
                            "Rechtssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "f5f94427-e27c-49b5-9981-dd81ae4214ac",
                                "sense_id": "ab050bb7-9135-3308-8157-0630a0a1ed58",
                                "text": "„Im ersten Fall begehrt der Kläger die Titulierung nur eines seiner Anträge, wobei bei Klageerhebung zunächst unklar bleibt, welchen dieser Anträge ein Gericht titulieren soll.“"
                            },
                            {
                                "example_id": "c25aef7c-796a-467c-80ca-dd84ed1daa4a",
                                "sense_id": "ab050bb7-9135-3308-8157-0630a0a1ed58",
                                "text": "„Betreibt der Gläubiger das gerichtliche Mahnverfahren und damit die Titulierung im eigenen Namen, so erhält er diese Vergütung nach herrschender Rechtsauffassung nicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
