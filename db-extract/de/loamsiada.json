                "senses": [
                    {
                        "sense_id": "3f9c65fe-22f1-33a4-b122-1016a2cabede",
                        "entry_id": "6fea4935-aec9-36da-9f05-af43df06ffdc",
                        "glosses": [
                            "jemand, der nichts richtig auf die Reihe kriegt; Langweiler, langsamer Mensch"
                        ],
                        "tags": [
                            "bairisch mundartlich",
                            "Schimpfwort"
                        ],
                        "examples": [
                            {
                                "example_id": "712cd69e-7fd6-4c06-a81f-322969037d00",
                                "sense_id": "3f9c65fe-22f1-33a4-b122-1016a2cabede",
                                "text": "Des is a Loamsiada.",
                                "translation": "Dieser Mensch arbeitet langsam."
                            },
                            {
                                "example_id": "01257690-f511-4bd7-ad9b-0aceb45928f1",
                                "sense_id": "3f9c65fe-22f1-33a4-b122-1016a2cabede",
                                "text": "„Fragt man einen Ostfriesen nach einem »Loamsiada«, wird der nur mit den Schultern zucken.“"
                            },
                            {
                                "example_id": "e2ab45f5-7025-4be9-818d-3ffc1eb92543",
                                "sense_id": "3f9c65fe-22f1-33a4-b122-1016a2cabede",
                                "text": "„Wenn mal wieder die Dreckhammen dieser Welt das Sagen haben, die Glezn und Gloiffen, die Matzn und Mistamseln und diese ganzen dappigen Dridschler, Loamsiada und Zipfeschwinger. Und dann schleichts eich mit eirer Contenance, hamma uns?!“"
                            },
                            {
                                "example_id": "02dd6c30-212d-44ce-b119-b6b2a6bbd346",
                                "sense_id": "3f9c65fe-22f1-33a4-b122-1016a2cabede",
                                "text": "„»Loamsiada, windiga!« sagte auf einmal die Vorderdirn Fanny halblaut“"
                            },
                            {
                                "example_id": "ef62d406-2268-4cd9-b579-e967f5d03184",
                                "sense_id": "3f9c65fe-22f1-33a4-b122-1016a2cabede",
                                "text": "„»Geh, du Loamsiada, a Oachkatzl werd uns beißn! Nix wissn duast!«“"
                            },
                            {
                                "example_id": "61d1d473-4c84-46f8-b840-3889458a868a",
                                "sense_id": "3f9c65fe-22f1-33a4-b122-1016a2cabede",
                                "text": "„Der Loamsiada, der verflixte, der kommt doch bloß immer mit irgendoana Bamperlarbeit daher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a8df4e8-fa9e-4f82-becc-360a8585e976",
