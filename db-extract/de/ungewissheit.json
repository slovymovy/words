                "senses": [
                    {
                        "sense_id": "e5ba1923-8508-3286-be3b-9636ea57299d",
                        "entry_id": "c7e62d0e-6873-3503-be6b-2189960fbe9d",
                        "glosses": [
                            "Unsicherheit hinsichtlich der Geltung oder Entwicklung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "963610d8-5172-467a-8fe1-89c663d969ec",
                                "sense_id": "e5ba1923-8508-3286-be3b-9636ea57299d",
                                "text": "„Hinter ihnen liegen endlose Leichenfelder, vor ihnen ist nichts als Ungewissheit, in ihnen brennt eine Leere, die sie mit Anstand zu ertragen versuchen.“"
                            },
                            {
                                "example_id": "ad02dccd-6fd5-4448-b3e5-913a0c36a37d",
                                "sense_id": "e5ba1923-8508-3286-be3b-9636ea57299d",
                                "text": "„Die Ungewissheit gehört nach dem Kriegsende zum Alltag.“"
                            },
                            {
                                "example_id": "3f83c943-6d42-44c1-94e5-d8fd83e043b8",
                                "sense_id": "e5ba1923-8508-3286-be3b-9636ea57299d",
                                "text": "„Der Gedanke stimmte mich zuversichtlich, dass eines Tages, wenn ich wieder sicher in London wäre, der Stein mich an diese Nacht voller Ungewissheit in der Sahara erinnern würde.“"
                            },
                            {
                                "example_id": "ff284985-2a4e-4b7b-96d6-c5b51ef7ca89",
                                "sense_id": "e5ba1923-8508-3286-be3b-9636ea57299d",
                                "text": "„Und Unruhe und Ungewissheit blieben bestehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4324534d-54c7-4e79-9b32-0aca922ed3dd",
                        "source_entry_id": "c7e62d0e-6873-3503-be6b-2189960fbe9d",
                        "source_sense_id": "e5ba1923-8508-3286-be3b-9636ea57299d",
                        "source_sense_description": "Unsicherheit hinsichtlich der Geltung oder Entwicklung von etwas",
                        "target_lang_word": "uncertainty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uncertainty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61617d86-3582-32d4-aa01-40f17886af27",
                                        "entry_id": "12c80ec7-1ab0-3dc9-af61-06c6f4abbbc3",
                                        "glosses": [
                                            "Doubt; the condition of being uncertain or without conviction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "334d7dfa-13bf-44e4-a88f-55d2f61f4c65",
                                                "sense_id": "61617d86-3582-32d4-aa01-40f17886af27",
                                                "text": "“Well,” I answered, at first with uncertainty, then with inspiration, “he would do splendidly to lead your cotillon, if you think of having one.” ¶ “So you do not dance, Mr. Crocker?” ¶ I was somewhat set back by her perspicuity."
                                            },
                                            {
                                                "example_id": "30f37314-9bf4-464f-be45-febb4732605d",
                                                "sense_id": "61617d86-3582-32d4-aa01-40f17886af27",
                                                "text": "After spending so much of the season looking upwards, the swashbuckling style and swagger of early season Spurs was replaced by uncertainty and frustration against a Norwich side who had the quality and verve to take advantage"
                                            },
                                            {
                                                "example_id": "38ea4f05-ffa2-494d-8be8-0d76bb393197",
                                                "sense_id": "61617d86-3582-32d4-aa01-40f17886af27",
                                                "text": "Piecing together Corbynomics is difficult, not least because it has evolved during Mr Corbyn’s time in charge of Labour. The gulf between the Labour leadership’s past positions and the milder proposals in the manifesto means that enormous uncertainty hangs over what a Corbyn-led government would do in office."
                                            },
                                            {
                                                "example_id": "6059925d-5894-463b-ab54-2810964dcc67",
                                                "sense_id": "61617d86-3582-32d4-aa01-40f17886af27",
                                                "text": "It's a full circle. Over the past 43 years, RAIL has reported on how the railways have gone from uncertainty under government control to sectorisation, privatisation, and back to uncertainty under government control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce4f1d67-6920-386a-947f-8aad5a30b4cf",
                                        "entry_id": "12c80ec7-1ab0-3dc9-af61-06c6f4abbbc3",
                                        "glosses": [
                                            "Something uncertain or ambiguous."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f178bcb-95f3-4c57-bcde-713702ec7ce3",
                                                "sense_id": "ce4f1d67-6920-386a-947f-8aad5a30b4cf",
                                                "text": "Despite these uncertainties, Clarke told MPs he was convinced of the need to order trains powered by batteries. He said: \"We're calling for a 'no regrets' order of battery trains because we see them always having a future. We see them being fundable, financeable, similar cost to diesel trains, and we know that however much electrification we would aspire to do, there's always going to be at least a third of the network that isn't electrified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3befa4b1-f58d-3831-af5f-e834785b9e7f",
                                        "entry_id": "12c80ec7-1ab0-3dc9-af61-06c6f4abbbc3",
                                        "glosses": [
                                            "A parameter that measures the dispersion of a range of measured values."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "799d9e2d-2cc1-4dd9-aaec-86a461027506",
                        "source_entry_id": "c7e62d0e-6873-3503-be6b-2189960fbe9d",
                        "source_sense_id": "e5ba1923-8508-3286-be3b-9636ea57299d",
                        "source_sense_description": "Unsicherheit hinsichtlich der Geltung oder Entwicklung von etwas",
                        "target_lang_word": "incertitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incertitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a77f546-e46a-3a47-ab4d-785f8cffa3b3",
                                        "entry_id": "9ca8d2de-3017-3588-bf36-1c553555a8e0",
                                        "glosses": [
                                            "État d’une personne irrésolue sur ce qu’elle doit faire, ou incertaine de ce qui doit arriver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133fba18-976d-4d1b-ad18-71a0aff1a198",
                                                "sense_id": "1a77f546-e46a-3a47-ab4d-785f8cffa3b3",
                                                "text": "C'est cet état général d’incertitude intellectuelle qui permet chez beaucoup la persistance d’attitudes doctrinales périmées, irréalistes, sans que l'on puisse faire de leurs égarements des symptômes psycho-pathologiques. […]. Mais on ne doit pas oublier que l’indéfinition des structures sociales crée chez beaucoup un état de trouble psychique."
                                            },
                                            {
                                                "example_id": "b8f593d6-c44d-40af-9f42-62bb9b544e88",
                                                "sense_id": "1a77f546-e46a-3a47-ab4d-785f8cffa3b3",
                                                "text": "Il est dans l’incertitude du parti qu’il doit prendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                        "entry_id": "9ca8d2de-3017-3588-bf36-1c553555a8e0",
                                        "glosses": [
                                            "Ce qui est susceptible de doute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a268b8e3-eda4-4f4f-a534-9633e151d506",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "Le lecteur lui-même sera tenu dans l’incertitude, sachant de moins en moins au fur et à mesure qu’il avance dans le texte, si les événements qu'on lui rapporte sont réels ou illusoires."
                                            },
                                            {
                                                "example_id": "9dd6ed14-1c09-4be2-b94a-d738d723d283",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "L’incertitude des jugements humains."
                                            },
                                            {
                                                "example_id": "b9cee70b-3205-4384-9068-79a9fb205edf",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "L’incertitude des doctrines philosophiques."
                                            },
                                            {
                                                "example_id": "e4aa5316-4c31-4dcc-b352-884668cfae53",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "Il y a beaucoup d’incertitude dans la médecine, dans l’histoire."
                                            },
                                            {
                                                "example_id": "ff0d6b05-04aa-45c9-b9fc-bb0f8534cd1c",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "L’incertitude du temps, l’état incertain du temps."
                                            },
                                            {
                                                "example_id": "b5b0ab12-26cd-4b65-a2ff-fa408f731f11",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "Un mémoire que je publierai prochainement ne laissera plus, je l’espère, aucune incertitude dans l’esprit de tous les archéologues de bonne foi."
                                            },
                                            {
                                                "example_id": "7387495e-d211-4525-86f1-c88ad0c0dd0a",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "Quant à l’incertitude, il y trouvait son compte également car l’incertitude est la face cachée du bonheur. Être sûr de l’amour de l’autre, c’est déjà le perdre."
                                            },
                                            {
                                                "example_id": "c7b75d4c-98dd-4ae4-81e7-a98b6aac5032",
                                                "sense_id": "45cf8525-0ff7-3978-a3ba-44813addee50",
                                                "text": "Ce rejet des deux leaders démocrates jette à nouveau une dose d’incertitude sur l’adoption d’un plan de relance supplémentaire avant l’investiture du démocrate Joe Biden le 20 janvier, au moment même où la résurgence de la pandémie de Covid-19 incite les États à restreindre l’activité économique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20295416-9f52-321c-a465-8e8c678a0a6d",
                                        "entry_id": "9ca8d2de-3017-3588-bf36-1c553555a8e0",
                                        "glosses": [
                                            "Ce qui n’est pas d’une nature bien arrêtée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87790598-4b0e-467f-b6e9-ddc00359c0f8",
                                                "sense_id": "20295416-9f52-321c-a465-8e8c678a0a6d",
                                                "text": "L’incertitude de son caractère."
                                            },
                                            {
                                                "example_id": "4da15d8d-2f7e-4925-be41-07eaf88f581b",
                                                "sense_id": "20295416-9f52-321c-a465-8e8c678a0a6d",
                                                "text": "L’incertitude habituelle de ses opinions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccaf656e-7015-3d22-b285-65ed0ed7773c",
                                        "entry_id": "9ca8d2de-3017-3588-bf36-1c553555a8e0",
                                        "glosses": [
                                            "Erreur attendue dans une mesure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae01bbfb-3399-4afe-a658-3d9bc04550ef",
                                                "sense_id": "ccaf656e-7015-3d22-b285-65ed0ed7773c",
                                                "text": "L'incertitude déterminée pour le système de mesure dans le cadre de la combinaison de niveaux choisie englobe l'incertitude spécifiée pour les instruments de mesure employés, l'incertitude d'étalonnage et toute autre incertitude liée au mode d'utilisation des instruments de mesure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ba24efa-b92a-314b-b1a4-bdc66fc3f08d",
                                        "entry_id": "9ca8d2de-3017-3588-bf36-1c553555a8e0",
                                        "glosses": [
                                            "Qualité exprimant la valeur moyenne, ou la valeur maximale, de l’erreur inhérente à la mise en œuvre d’un processus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
