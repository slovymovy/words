                            {
                                "target_lang_word": "hem allowance",
                                "target_lang_sense_clarification": "extra fabric for lengthening"
                            },
                            {
                                "target_lang_word": "facing",
                                "target_lang_sense_clarification": "garment construction"
                            }
                        ]
