                    "sense_id": "9724750d-6bbb-30fe-9a2b-8222b84fe4bc",
                    "sense_definition": "w teologii chrześcijańskiej: uwolnienie ludzi od grzechu i jego skutków, dokonane przez ofiarę Jezusa Chrystusa",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wierni modlą się o <w>odkupienie</w> swoich grzechów.",
                            "target_lang_translations": {
                                "ru": "Верующие молятся об <w>искуплении</w> своих грехов.",
                                "en": "The faithful pray for the <w>redemption</w> of their sins."
                            }
                        },
                        {
                            "text": "Dzieło <w>odkupienia</w> jest centralnym punktem nauki chrześcijańskiej.",
                            "target_lang_translations": {
                                "ru": "Дело <w>искупления</w> занимает центральное место в христианском учении.",
                                "en": "The work of <w>redemption</w> is central to Christian teaching."
                            }
                        }
                    ],
                    "synonyms": [
                        "zbawienie"
                    ],
                    "common_phrases": [
                        "odkupienie grzechów",
                        "dzieło odkupienia",
                        "tajemnica odkupienia"
                    ],
                    "target_lang_definitions": {
                        "ru": "в христианском богословии: освобождение людей от греха и его последствий, совершенное жертвой Иисуса Христа",
                        "en": "in Christian theology, the deliverance of humanity from sin and its consequences through the sacrifice of Jesus Christ"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искупление",
                                "target_lang_sense_clarification": "религиозное понятие, спасение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "redemption",
                                "target_lang_sense_clarification": "theological sense, salvation from sin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a13ce25-d03d-3597-80f6-7a36d245ee6c",
                    "sense_definition": "rzeczownik odczasownikowy od <w>odkupić</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zaoferował mi <w>odkupienie</w> moich udziałów w firmie.",
                            "target_lang_translations": {
                                "ru": "Он предложил мне <w>выкуп</w> моих долей в компании.",
                                "en": "He offered to <w>buy out</w> my shares in the company."
                            }
                        },
                        {
                            "text": "<w>Odkupienie</w> win wymaga szczerego żalu i zadośćuczynienia.",
                            "target_lang_translations": {
                                "ru": "<w>Искупление</w> вины требует искреннего раскаяния и возмещения ущерба.",
                                "en": "<w>Atonement</w> for faults requires sincere repentance and restitution."
                            }
                        }
                    ],
                    "common_phrases": [
