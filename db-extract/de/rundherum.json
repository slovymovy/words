        "de-extract.jsonl": [
            {
                "entry_id": "8b0914e1-2156-3623-b5df-2943da4284fb",
                "word": "rundherum",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "48d10d9e-46c3-3baa-a14b-e19d17ea55f8",
                        "entry_id": "8b0914e1-2156-3623-b5df-2943da4284fb",
                        "glosses": [
                            "zu allen Seiten, in allen Richtungen, überall im Umkreis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dc00aac-a462-46bc-8780-48c7cf1155de",
                                "sense_id": "48d10d9e-46c3-3baa-a14b-e19d17ea55f8",
                                "text": "„Dicht am Ufer steht ein Stein, rundherum wurden Rosen gepflanzt, wahrscheinlich sind es die alten Stöcke vom Friedhof, die wollten sie damals mitnehmen, für eben das hier, für diese Gedenkstätte.“"
                            },
                            {
                                "example_id": "3208fbab-6969-4fed-ab73-6d9351ae261e",
                                "sense_id": "48d10d9e-46c3-3baa-a14b-e19d17ea55f8",
                                "text": "„1150 m über dem Meere und ist rundherum von Bergen umgeben, im Norden von der LosansweKette, im Süden und Osten von dem Lokinga - Gebirge, dem mauerartigen Plateau von Bisa und der Tschibale - Kette.“"
                            },
                            {
                                "example_id": "639f05d3-ece2-4b22-957b-cae87547247d",
                                "sense_id": "48d10d9e-46c3-3baa-a14b-e19d17ea55f8",
                                "text": "„Da gab es rundherum freien Raum, so dass infolge dieser starken Ventilation die reinste Luft das Zimmer erfüllte.“"
                            },
                            {
                                "example_id": "a1b7737f-ec20-4f68-956b-78cfcd45daea",
                                "sense_id": "48d10d9e-46c3-3baa-a14b-e19d17ea55f8",
                                "text": "„Marion Landwehr hat die schönsten Stell- und Campingplätze getestet und gibt ausführliche Tipps für Aktivitäten rundherum.“"
                            },
                            {
                                "example_id": "17f4ac53-e5cb-45d3-8a20-72a19ae3138d",
                                "sense_id": "48d10d9e-46c3-3baa-a14b-e19d17ea55f8",
                                "text": "„Petra Dinhof schreibt Geschichten und Anekdoten von der Bühne und allem was dahinter und rundherum passiert.“"
                            },
                            {
                                "example_id": "223d1263-56bb-4296-b3ee-0e2ff3245e39",
                                "sense_id": "48d10d9e-46c3-3baa-a14b-e19d17ea55f8",
                                "text": "„Er schaute auf die Gipfel rundherum, auf die Texelgruppe, die Ötztaler Alpen, das Ortlergebiet, die Dolomiten, dann auf die umliegenden Latschenfelder, schließlich wieder auf das Mandl vor ihm.“"
                            },
                            {
                                "example_id": "6bdc8d80-abe5-4dcf-ad47-08a8b9026608",
                                "sense_id": "48d10d9e-46c3-3baa-a14b-e19d17ea55f8",
                                "text": "„Ich schaute mich um. Rundherum war nichts, einfach gar nichts. Erst als ich nach oben sah, war dort ein blauer Himmel, an dem sich ein paar Wolken kräuselten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "88e20a8a-136a-3fd7-b925-d55963971325",
                        "entry_id": "8b0914e1-2156-3623-b5df-2943da4284fb",
                        "glosses": [
                            "im Kreis (um etwas) herum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31c92185-daa6-4b42-952e-e2378490332d",
                                "sense_id": "88e20a8a-136a-3fd7-b925-d55963971325",
                                "text": "„Wer den ganzen See erkunden möchte, leiht sich auf dem Campingplatz ein Ruderboot oder läuft einmal rundherum.“"
                            },
                            {
                                "example_id": "c8d3cb1e-107a-4a15-92b7-ed6d12e30be2",
                                "sense_id": "88e20a8a-136a-3fd7-b925-d55963971325",
                                "text": "„Georg wendet sich nach links und rechts und dreht sich rundherum.“"
                            },
                            {
                                "example_id": "626563bb-7cce-4faa-b23e-c5b07c010bda",
                                "sense_id": "88e20a8a-136a-3fd7-b925-d55963971325",
                                "text": "„Charlo ließ die manikürten Hände in den Schoß sinken und kreiselte einmal auf dem Klavierstuhl rundherum.“"
                            },
                            {
                                "example_id": "e71af902-a540-4a68-a1fd-d89a8d9c35e9",
                                "sense_id": "88e20a8a-136a-3fd7-b925-d55963971325",
                                "text": "„Am Opernplatz setzte ich mich dann, weil meine Füße schon etwas schmerzten, in die Linie 1, die immer den Ring entlang fuhr, rundherum und wieder rundherum, wie ein Karussell.“"
                            },
                            {
                                "example_id": "751194ff-c1c0-4ea0-bb97-bbe9ac2ee734",
                                "sense_id": "88e20a8a-136a-3fd7-b925-d55963971325",
                                "text": "„Im großen Kreis ging es rundherum, rundherum, immer rundherum. Bis sich die Blumen drehten, und bis es aussah, als ob viele viele klitzekleinen Hasen auf die kleinen wilden Schweinchen und die Bärenkinder schließlich ins Gras vielen vielen Flöten spielten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "6bdb783b-16ee-3687-aea6-d49b6326eb47",
                        "entry_id": "8b0914e1-2156-3623-b5df-2943da4284fb",
                        "glosses": [
                            "gänzlich, vollständig, ganz und gar"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "4cff002c-4c9c-4253-b156-3af56801f1f0",
                                "sense_id": "6bdb783b-16ee-3687-aea6-d49b6326eb47",
                                "text": "„Roberto ist mit seinem Leben rundherum zufrieden.“"
                            },
                            {
                                "example_id": "33eec37d-1399-4f44-93b2-4bc82ed23788",
                                "sense_id": "6bdb783b-16ee-3687-aea6-d49b6326eb47",
                                "text": "„Mit einem lachenden Auge erzählt die Autorin, was man so alles mit Kindern, Haustieren oder rundherum erleben kann.“"
                            },
                            {
                                "example_id": "00bcb220-21c7-486d-95a1-09efeb046f0c",
                                "sense_id": "6bdb783b-16ee-3687-aea6-d49b6326eb47",
                                "text": "„Ich fühlte, er liebte dieses neue Leben, wenn ich bei ihm hätte sein können, wäre er rundherum glücklich gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
