                    "frequency": "Middle",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont passé la nuit dans un hôtel <w>borgne</w> près de la gare déserte."
                        },
                        {
                            "text": "La police surveille régulièrement ce cabaret <w>borgne</w> fréquenté par des trafiquants."
