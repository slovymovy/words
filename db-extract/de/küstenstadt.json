                "senses": [
                    {
                        "sense_id": "cf515488-a9a6-308d-afb3-8765c2d696b3",
                        "entry_id": "c8e478fd-daa1-3b1b-b306-2887165d6f0f",
                        "glosses": [
                            "Stadt, die an einer Meeresküste liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "022dcbc2-7ef8-4e14-8f9c-c2af3f0e1ffa",
                                "sense_id": "cf515488-a9a6-308d-afb3-8765c2d696b3",
                                "text": "Calais ist eine am Ärmelkanal gelegene Küstenstadt."
                            },
                            {
                                "example_id": "f4dc817b-01c6-4171-8863-d352e1ddc6c1",
                                "sense_id": "cf515488-a9a6-308d-afb3-8765c2d696b3",
                                "text": "„Die Küstenstadt, rund zehn Kilometer vom heutigen Tunis entfernt, war in der Spätantike neben Rom die bedeutendste Großansiedlung des Weströmischen Reiches.“"
                            },
                            {
                                "example_id": "6949d357-6fab-487f-8b2e-13cf18e66b1b",
                                "sense_id": "cf515488-a9a6-308d-afb3-8765c2d696b3",
                                "text": "„In der Küstenstadt Pangani geriet er mit dem Vertreter des Sultans im Streit.“"
                            },
                            {
                                "example_id": "05ce4d3f-dc07-4666-8e0b-ec63c8f4621e",
                                "sense_id": "cf515488-a9a6-308d-afb3-8765c2d696b3",
                                "text": "„Die Franzosen halten nur die Stadt Algier und ihr unmittelbares Hinterland sowie mehrere Küstenstädte besetzt.“"
                            },
                            {
                                "example_id": "160ce780-a8fa-4102-9f76-65e7bcf714db",
                                "sense_id": "cf515488-a9a6-308d-afb3-8765c2d696b3",
                                "text": "„In den Küstenstädten Wismar, Rostock und Stralsund sind moderne und leistungsfähige Werften entstanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
