{
    "word_family": [
        "folklore",
        "folksy",
        "folklorist",
        "folksiness",
        "folkway"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "110e3e0d-65cd-306f-8ab1-c6add681f6a4",
                    "sense_definition": "People in general or a specific group of persons.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were a lot of <w>folk</w> in the streets during the festival.",
                            "target_lang_translations": {
                                "ru": "Во время фестиваля на улицах было много <w>народу</w>.",
                                "zh": "节日期间街上有许多<w>人</w>。"
                            }
                        },
                        {
                            "text": "Some <w>folk</w> prefer to stay at home rather than go out in the rain.",
                            "target_lang_translations": {
                                "ru": "Некоторые <w>люди</w> предпочитают оставаться дома, а не выходить под дождь.",
                                "zh": "有些<w>人</w>宁愿待在家里，也不愿在雨天出门。"
                            }
                        }
                    ],
                    "synonyms": [
                        "people",
                        "persons"
                    ],
                    "common_phrases": [
                        "town folk",
                        "country folk",
                        "fine folk"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in plural form 'folks'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди в целом или определенная группа лиц.",
                        "zh": "指一般人或特定的一群人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "люди",
                                "target_lang_sense_clarification": "в общем смысле"
                            },
                            {
                                "target_lang_word": "народ",
                                "target_lang_sense_clarification": "разговорное обращение или группа людей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人们",
                                "target_lang_sense_clarification": "指代一般大众"
                            },
                            {
                                "target_lang_word": "大家",
                                "target_lang_sense_clarification": "口语中指代一群人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d12004fe-fe45-3f48-b3a7-fe247d76eb62",
                    "sense_definition": "A person's relatives, especially their parents.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to call my <w>folks</w> back home to tell them I arrived safely.",
                            "target_lang_translations": {
                                "ru": "Мне нужно позвонить своим <w>предкам</w> домой и сказать, что я благополучно добрался.",
                                "zh": "我得给家里的<w>父母</w>打个电话，告诉他们我平安到达了。"
                            }
                        },
                        {
                            "text": "Are you going to visit your <w>folks</w> over the Christmas holidays?",
                            "target_lang_translations": {
                                "ru": "Собираешься навестить своих <w>родителей</w> на рождественские праздники?",
                                "zh": "圣诞假期你打算去探望你的<w>父母</w>吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "parents",
                        "relatives",
                        "family"
                    ],
                    "common_phrases": [
                        "visit your folks",
                        "my old folks"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually used in the plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Родственники человека, особенно его родители.",
                        "zh": "指某人的亲属，尤指父母。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предки",
                                "target_lang_sense_clarification": "разговорное о родителях"
                            },
                            {
                                "target_lang_word": "родные",
                                "target_lang_sense_clarification": "члены семьи"
                            },
                            {
                                "target_lang_word": "родители",
                                "target_lang_sense_clarification": "мать и отец"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "父母",
                                "target_lang_sense_clarification": "指父亲和母亲"
                            },
                            {
                                "target_lang_word": "家人",
                                "target_lang_sense_clarification": "指亲属"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "744b294d-467e-36f1-b4b0-f06accf373f7",
                    "sense_definition": "A group of people sharing a common culture, tribe, or nation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Germanic <w>folk</w> migrated across Europe many centuries ago.",
                            "target_lang_translations": {
                                "ru": "Германские <w>народы</w> мигрировали по Европе много веков назад.",
                                "zh": "日耳曼<w>民族</w>在几个世纪前迁徙到了欧洲各地。"
                            }
                        },
                        {
                            "text": "Each <w>folk</w> has its own unique set of traditions and stories.",
                            "target_lang_translations": {
                                "ru": "У каждого <w>народа</w> есть свой уникальный набор традиций и историй.",
                                "zh": "每个<w>民族</w>都有其独特的一套传统和故事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nation",
                        "tribe",
                        "people"
                    ],
                    "common_phrases": [
                        "native folk",
                        "Germanic folk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, разделяющих общую культуру, племя или нацию.",
                        "zh": "指共享共同文化、部落或民族的一群人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "народ",
                                "target_lang_sense_clarification": "этнос или нация"
                            },
                            {
                                "target_lang_word": "народность",
                                "target_lang_sense_clarification": "этническая группа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民族",
                                "target_lang_sense_clarification": "指具有共同文化或血缘的群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05d318bf-d658-3bbc-94cd-95c45dcc2b5a",
                    "sense_definition": "A genre of music originating in popular culture, typically passed on by oral tradition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She enjoys listening to <w>folk</w> while she works in the garden.",
                            "target_lang_translations": {
                                "ru": "Ей нравится слушать <w>фолк</w>, пока она работает в саду.",
                                "zh": "她在花园里干活时喜欢听<w>民谣</w>。"
                            }
                        },
                        {
                            "text": "The festival features a mix of rock, jazz, and traditional <w>folk</w>.",
                            "target_lang_translations": {
                                "ru": "На фестивале представлена смесь рока, джаза и традиционной <w>народной музыки</w>.",
                                "zh": "音乐节融合了摇滚、爵士和传统的<w>民间音乐</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "folk music"
                    ],
                    "common_phrases": [
                        "traditional folk",
                        "contemporary folk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жанр музыки, зародившийся в народной культуре и обычно передающийся устно.",
                        "zh": "一种源于民间文化，通常通过口头传统传承的音乐流派。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фолк",
                                "target_lang_sense_clarification": "музыкальный жанр"
                            },
                            {
                                "target_lang_word": "народная музыка",
                                "target_lang_sense_clarification": "традиционный жанр"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民谣",
                                "target_lang_sense_clarification": "指民间音乐流派"
                            },
                            {
                                "target_lang_word": "民间音乐",
                                "target_lang_sense_clarification": "指传统音乐形式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "57871c34-3321-3a47-b1f1-94323e05aa5d",
                    "sense_definition": "Relating to the traditional culture, customs, and beliefs of a community.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum has a wonderful collection of <w>folk</w> art from the region.",
                            "target_lang_translations": {
                                "ru": "В музее собрана замечательная коллекция <w>народного</w> искусства этого региона.",
                                "zh": "博物馆收藏了许多该地区精美的<w>民间</w>艺术品。"
                            }
                        },
                        {
                            "text": "They performed a traditional <w>folk</w> dance at the wedding reception.",
                            "target_lang_translations": {
                                "ru": "На свадебном приеме они исполнили традиционный <w>народный</w> танец.",
                                "zh": "他们在婚宴上表演了传统的<w>民间</w>舞蹈。"
                            }
                        }
                    ],
                    "synonyms": [
                        "traditional",
                        "customary"
                    ],
                    "common_phrases": [
                        "folk art",
                        "folk dance",
                        "folk tale",
                        "folk music"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к традиционной культуре, обычаям и верованиям сообщества.",
                        "zh": "与社区的传统文化、习俗和信仰有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "народный",
                                "target_lang_sense_clarification": "традиционный"
                            },
                            {
                                "target_lang_word": "фольклорный",
                                "target_lang_sense_clarification": "связанный с фольклором"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民间",
                                "target_lang_sense_clarification": "指代传统或非官方的"
                            },
                            {
                                "target_lang_word": "民俗",
                                "target_lang_sense_clarification": "指与风俗习惯相关"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "541fab3d-27db-3a76-985e-d18df2cfebbb",
                    "sense_definition": "Relating to ordinary people rather than the elite or ruling classes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician tried to appeal to <w>folk</w> wisdom rather than complex statistics.",
                            "target_lang_translations": {
                                "ru": "Политик пытался апеллировать к <w>народной</w> мудрости, а не к сложной статистике.",
                                "zh": "这位政客试图诉诸<w>民间</w>智慧，而不是复杂的统计数据。"
                            }
                        },
                        {
                            "text": "This style of cooking is rooted in <w>folk</w> traditions of the working class.",
                            "target_lang_translations": {
                                "ru": "Этот стиль приготовления пищи уходит корнями в <w>народные</w> традиции рабочего класса.",
                                "zh": "这种烹饪风格植根于工人阶级的<w>民间</w>传统。"
                            }
                        }
                    ],
                    "synonyms": [
                        "popular",
                        "common",
                        "plebeian"
                    ],
                    "antonyms": [
                        "elite",
                        "aristocratic"
                    ],
                    "common_phrases": [
                        "folk wisdom",
                        "folk hero"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к простым людям, а не к элите или правящим классам.",
                        "zh": "指普通民众，而非精英或统治阶级。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "народный",
                                "target_lang_sense_clarification": "простонародный"
                            },
                            {
                                "target_lang_word": "общенародный",
                                "target_lang_sense_clarification": "принадлежащий народу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民间",
                                "target_lang_sense_clarification": "指普通百姓的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4dce70b-a6a4-3301-95a6-8c382d40d9cb",
                    "sense_definition": "Based on common popular belief rather than scientific or academic rigor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study of <w>folk</w> linguistics examines how non-experts perceive language.",
                            "target_lang_translations": {
                                "ru": "Изучение <w>народной</w> лингвистики исследует то, как неспециалисты воспринимают язык.",
                                "zh": "“<w>通俗</w>语言学”研究的是非专家如何看待语言。"
                            }
                        },
                        {
                            "text": "Many people rely on <w>folk</w> psychology to explain the behavior of others.",
                            "target_lang_translations": {
                                "ru": "Многие люди полагаются на <w>обыденную</w> психологию, чтобы объяснить поведение других.",
                                "zh": "许多人依靠<w>通俗</w>心理学来解释他人的行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "informal",
                        "unscientific"
                    ],
                    "antonyms": [
                        "academic",
                        "scientific"
                    ],
                    "common_phrases": [
                        "folk psychology",
                        "folk linguistics",
                        "folk medicine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на общепринятых народных убеждениях, а не на научной строгости.",
                        "zh": "基于大众普遍信仰而非科学或学术严谨性的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "народный",
                                "target_lang_sense_clarification": "бытовой, ненаучный"
                            },
                            {
                                "target_lang_word": "обыденный",
                                "target_lang_sense_clarification": "основанный на здравом смысле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通俗",
                                "target_lang_sense_clarification": "指非专业的、大众化的"
                            },
                            {
                                "target_lang_word": "民间",
                                "target_lang_sense_clarification": "指非学术性的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48a5c015-4ac1-3487-b873-d4d72639742f",
                    "sense_definition": "Relating to local building styles and materials used by ordinary people.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village is famous for its well-preserved <w>folk</w> architecture.",
                            "target_lang_translations": {
                                "ru": "Деревня славится своей хорошо сохранившейся <w>народной</w> архитектурой.",
                                "zh": "这个村庄以其保存完好的<w>民间</w>建筑而闻名。"
                            }
                        },
                        {
                            "text": "They used <w>folk</w> building techniques to restore the old farmhouse.",
                            "target_lang_translations": {
                                "ru": "Для реставрации старого фермерского дома они использовали <w>традиционные</w> строительные методы.",
                                "zh": "他们使用<w>民间</w>建筑技术修复了这座老农舍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vernacular"
                    ],
                    "common_phrases": [
                        "folk architecture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к местным строительным стилям и материалам, используемым простыми людьми.",
                        "zh": "指普通民众使用的当地建筑风格和材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "народный",
                                "target_lang_sense_clarification": "традиционный для местности"
                            },
                            {
                                "target_lang_word": "вернакулярный",
                                "target_lang_sense_clarification": "местный архитектурный стиль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "民间",
                                "target_lang_sense_clarification": "指传统的、地方性的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a3786a90-793f-33dc-9a3d-1bb3ad1abf4b",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the book is a man named Robert <w>Folk</w>.",
                            "target_lang_translations": {
                                "ru": "Автор книги — человек по имени Роберт <w>Фолк</w>.",
                                "zh": "这本书的作者是一位名叫罗伯特·<w>福克</w>的男士。"
                            }
                        },
                        {
                            "text": "We should invite the <w>Folks</w> over for dinner this weekend.",
                            "target_lang_translations": {
                                "ru": "Нам стоит пригласить <w>Фолков</w> на ужин в эти выходные.",
                                "zh": "我们这个周末应该邀请<w>福克</w>一家来吃晚饭。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фолк",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "福克",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}