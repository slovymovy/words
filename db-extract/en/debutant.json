                        "entry_id": "96fa9c18-4435-3c55-925a-107d8d9d4cef",
                        "glosses": [
                            "A person (especially a male) who débuts, or appears for the first time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08979417-0b6e-46c1-8690-229ca2745f03",
                                "sense_id": "6e6b9137-3f25-385b-a722-033cd7751d8d",
                                "text": "The Australian batsmen were expecting an easier time with debutants Lonwabo Tsotsobe (4-50) and Wayne Parnell (1-52) replacing Dale Steyn and Ntini, while allrounder Kallis was also rested."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
