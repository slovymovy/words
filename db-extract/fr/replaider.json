                "senses": [
                    {
                        "sense_id": "67cd8724-1e6e-3979-abab-8fed21b24ef4",
                        "entry_id": "67f23a83-0558-3db0-bb98-202619f98cd0",
                        "glosses": [
                            "Plaider de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df563ad1-c41a-4ced-a25c-3ab225591b2c",
                                "sense_id": "67cd8724-1e6e-3979-abab-8fed21b24ef4",
                                "text": "Où irons-nous ? plaider à la plus voisine juridiction de Cirey, et de là replaider à Bruxelles."
                            },
                            {
                                "example_id": "2ea04ff5-50b5-4031-80e9-4ffa2bcc086a",
                                "sense_id": "67cd8724-1e6e-3979-abab-8fed21b24ef4",
                                "text": "Celles-ci ont pu replaider à la lumière de la nouvelle loi Aubry."
                            },
                            {
                                "example_id": "e913ea87-e110-443d-8ad0-5e75f3f08c29",
                                "sense_id": "67cd8724-1e6e-3979-abab-8fed21b24ef4",
                                "text": "La cheftaine a fait appel, mais l’affaire ne se replaidera sur le fond, devant la cour de Versailles, qu’en décembre."
                            }
                        ]
                    }
