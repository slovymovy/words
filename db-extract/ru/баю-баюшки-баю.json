                "forms": [],
                "senses": [
                    {
                        "sense_id": "d2333fbc-c038-3d43-8f21-7b48d06a525f",
                        "entry_id": "48e98c41-2786-3da3-8cf8-a601f6ccd5f6",
                        "glosses": [
                            "употребляется при укачивании ребёнка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65fac30b-a358-4721-9785-355003b19d1e",
                                "sense_id": "d2333fbc-c038-3d43-8f21-7b48d06a525f",
                                "text": "И хотя еще с раннего детства он слыхал песню «Баю-баюшки-баю, не ложися на краю», Гек все равно всегда спал с краю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61048581-f88b-4642-b2b7-617a81ab5cb9",
                        "source_entry_id": "48e98c41-2786-3da3-8cf8-a601f6ccd5f6",
                        "source_sense_id": "d2333fbc-c038-3d43-8f21-7b48d06a525f",
                        "target_lang_word": "hushaby",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hushaby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d0f62c7-1690-3a6e-8b50-f99ada20bf0f",
                                        "entry_id": "52e02f38-df5f-3969-be63-68e1144e773f",
                                        "glosses": [
                                            "hush and be still; a lull to sleep"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00eb0868-3d81-494d-99dc-0677a9f6a47c",
                                                "sense_id": "1d0f62c7-1690-3a6e-8b50-f99ada20bf0f",
                                                "text": "Hush-a-by, baby, upon the tree-top; / When the wind blows the cradle will rock; / When the bough breaks the cradle will fall; / Down will come cradle and baby and all."
                                            },
                                            {
                                                "example_id": "60ab0a59-e60e-49bf-abfc-1f89e6737e3d",
                                                "sense_id": "1d0f62c7-1690-3a6e-8b50-f99ada20bf0f",
                                                "text": "The night is fair, and the waves are still,\nAnd the wind is singing to you and to me\nIn this lowly home beside the sea —\nHushaby, sweet my own!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hushaby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50fabcf8-ff9f-3327-aed4-972ccd77f633",
                                        "entry_id": "d3501703-37aa-376d-b663-f23f3f4a218b",
                                        "glosses": [
                                            "A lullaby used to soothe babies to sleep."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dea0b692-3989-499c-b8ce-8f14efcd7a38",
                                                "sense_id": "50fabcf8-ff9f-3327-aed4-972ccd77f633",
                                                "text": "The moaning of their voices seemed to me to be like what is understood in Scotland by a \"sugh,\" and might very well have passed for a hushaby, when the nurse had nearly succeeded in murmuring herself to sleep, as well as her infant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hushaby",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "880bda95-c431-34af-ac7d-f700989e23d4",
                                        "entry_id": "87f4bd4b-8a64-33d6-9bc9-15bd05c2beb6",
                                        "glosses": [
                                            "To lull to sleep by saying \\\"hushaby\\\"."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
