                                "target_senses": [
                                    {
                                        "sense_id": "bd82ec2c-109c-3901-a7e7-1efdee3db0a9",
                                        "entry_id": "ce4524d6-78ad-38c8-bb01-b7a9727eb4a9",
                                        "glosses": [
                                            "present participle and gerund of embrace"
                                        ],
                                        "tags": [
                                            "form-of",
