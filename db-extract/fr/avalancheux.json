                        "glosses": [
                            "Sujet aux avalanches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e5725a5-4b92-464e-af1d-09651ba3dd07",
                                "sense_id": "a0d601aa-e57c-304f-ad14-a898adc6e180",
                                "text": "Aucune activité avalancheuse observée si ce n’est deux petites coulées au-dessus des Mouilles."
                            },
                            {
                                "example_id": "60676c8b-a9fd-4cb9-a6ef-d77491815d08",
                                "sense_id": "a0d601aa-e57c-304f-ad14-a898adc6e180",
                                "text": "Si vous partez sans accompagnateurs, […], renseignez vous sur votre itinéraire (un chemin facile en été peut être dans un secteur avalancheux et dangereux en hiver) […]"
                            },
                            {
                                "example_id": "7dc98d92-598e-4803-8b60-c98bab3948b1",
                                "sense_id": "a0d601aa-e57c-304f-ad14-a898adc6e180",
                                "text": "Elle était de là, elle aussi, désormais. Du pays impossible, avalancheux et débordant."
                            }
                        ]
                    }
