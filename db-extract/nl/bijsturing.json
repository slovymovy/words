                        "glosses": [
                            "het aanpassen van eerder gemaakte plannen of voornemens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae89823b-713f-44a7-bb70-1c07caf4cad0",
                                "sense_id": "ce7e1093-f0f9-3e16-93e8-127d67b0f2f7",
                                "text": "Coalitiepartners PvdA, VVD en CDA zijn kritisch over een verdere samenwerking met D66. Zij hekelen de eigenzinnige koers van de partij, die overleg over bijsturing van het stadionplan uit de weg zou zijn gegaan."
                            },
                            {
                                "example_id": "7bdcf1df-5db3-4bdf-a607-933cdf3c32cc",
                                "sense_id": "ce7e1093-f0f9-3e16-93e8-127d67b0f2f7",
                                "text": "Bij de evaluatie van het seizoen hadden zowel Michel Everaert namens de bond als Jeroen Rauwerdink en Rob Bontje namens de spelers geconstateerd dat de werkwijze richting EK niet de juiste was en dat bijsturing noodzakelijk werd geacht."
                            },
                            {
                                "example_id": "ef0237ea-5af9-4de4-bda5-a5a1463810d6",
                                "sense_id": "ce7e1093-f0f9-3e16-93e8-127d67b0f2f7",
                                "text": "Snoek las zijn harde commentaar voor van papier. 'Het ging hier steevast om experimenten met Exelon', het zware medicijn ter bestrijding van alzheimer, zonder enige bijsturing na het stellen van de diagnose'. Volgens Snoek lag het werk van de ex-neuroloog ver onder de standaard van de beroepsgroep."
                            }
                        ]
                    }
