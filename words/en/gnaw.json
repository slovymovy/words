                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "gryzienie",
                                "target_lang_sense_clarification": "proces gryzienia"
                            },
                            {
                                "target_lang_word": "obgryzanie",
                                "target_lang_sense_clarification": "czynność obgryzania czegoś"
                            }
                        ]
                    }
                }
            ]
        }
    ]
