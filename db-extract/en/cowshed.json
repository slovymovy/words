                                            {
                                                "example_id": "17b46c04-b553-4569-aef8-5de329c1c164",
                                                "sense_id": "7c860004-d1a1-3f3f-9a1c-7bf88449b61e",
                                                "text": "Rano w oborze gospodyni wydoiła krowy."
