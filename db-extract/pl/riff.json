                "translations": [
                    {
                        "translation_id": "22e9e6a4-f5ad-4e7c-ac85-d6548c5aae4f",
                        "source_entry_id": "26924164-97f8-3ec4-921a-c9bfc4c38319",
                        "source_sense_id": "ae562a67-6bf7-348e-b90e-bdc3c44e80b2",
                        "target_lang_word": "riff",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "riff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04dbeb97-d79a-3303-870b-01ab99ee1516",
                                        "entry_id": "e4da1864-0080-3f3a-a384-e58ede2e6e87",
                                        "glosses": [
                                            "A repeated melody line in a song, usually instrumental but sometimes vocal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce19ae55-2d78-4155-b98b-cfc9c1b5fb15",
                                                "sense_id": "04dbeb97-d79a-3303-870b-01ab99ee1516",
                                                "text": "Listen to one of the greatest guitar riffs of all time!"
                                            },
                                            {
                                                "example_id": "58952f9b-fb39-46c2-aea0-678ed8c3522c",
                                                "sense_id": "04dbeb97-d79a-3303-870b-01ab99ee1516",
                                                "text": "Jimi Hendrix's Voodoo Child has been named the greatest guitar riff of all time, 41 years after it was recorded, in a poll by website Music Radar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02818035-e0ea-3af4-818e-aa8e282cbe04",
                                        "entry_id": "e4da1864-0080-3f3a-a384-e58ede2e6e87",
                                        "glosses": [
                                            "A clever or witty remark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be729ce2-610b-4088-811b-81c9918cf9bf",
                                                "sense_id": "02818035-e0ea-3af4-818e-aa8e282cbe04",
                                                "text": "Pope Francis delivers off-the-cuff riff on family life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8f4b800-3dbb-3fcf-8239-805929ea0315",
                                        "entry_id": "e4da1864-0080-3f3a-a384-e58ede2e6e87",
                                        "glosses": [
                                            "A variation on something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5ccd64c-ae68-4c53-9d9b-d494012790e5",
                                                "sense_id": "c8f4b800-3dbb-3fcf-8239-805929ea0315",
                                                "text": "Both the Orbit and the Pinnacle are riffs on an idea sketched out in 1917 by Vladimir Tatlin for a monument to international communism."
                                            },
                                            {
                                                "example_id": "f4ebdbd1-3e29-48ab-8585-74d1173f1f7d",
                                                "sense_id": "c8f4b800-3dbb-3fcf-8239-805929ea0315",
                                                "text": "Grok’s companions are a riff on the idea of AI assistants or agents, which some people use for friendship or romance in place of or in addition to human partners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f107acd1-dbbb-3b70-8472-b464120e4b14",
                                        "entry_id": "e4da1864-0080-3f3a-a384-e58ede2e6e87",
                                        "glosses": [
                                            "A spoof."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc4c1ca-2d10-461d-936d-592475a0f419",
                                                "sense_id": "f107acd1-dbbb-3b70-8472-b464120e4b14",
                                                "text": "The creative team has experience with spoofing: Both [Paul] Rudd and [Amy] Poehler had parts in [David] Wain’s Wet Hot American Summer, a hysterically irreverent riff on ’80s summer-camp comedies."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "riff",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0907d204-1d02-38b8-88c0-f1d0d9299175",
                                        "entry_id": "dbf888b2-2e3d-355c-a9ec-8d833ba90758",
                                        "glosses": [
                                            "To improvise in the performance or practice of an art, especially by expanding on or making novel use of traditional themes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f41ddf26-bf7a-4fa8-a86e-28b9301b98ce",
                                                "sense_id": "0907d204-1d02-38b8-88c0-f1d0d9299175",
                                                "text": "She riffed on the Olympic judges, the bobsled team, then ad-libbed with a woman drinking a martini at the front table."
                                            },
                                            {
                                                "example_id": "c7fab628-2497-443a-bb67-0a0d386d32a9",
                                                "sense_id": "0907d204-1d02-38b8-88c0-f1d0d9299175",
                                                "text": "They were great architects deeply enmeshed in an urban chain of innovation; Wright riffed on Sullivan's idea of form following function, and Sullivan riffed on Jenney, and Jenney relied on the fireproofing innovations of Peter B. Wight."
                                            },
                                            {
                                                "example_id": "21f5e915-520b-4dd1-9b73-6c4c562bce84",
                                                "sense_id": "0907d204-1d02-38b8-88c0-f1d0d9299175",
                                                "text": "For Holyoake a strategic advantage of his newly coined label was the way it riffed on the term 'secular' in the Western Christian imaginary."
                                            },
                                            {
                                                "example_id": "7bb45e34-fc26-402c-abf3-8e457848b6d1",
                                                "sense_id": "0907d204-1d02-38b8-88c0-f1d0d9299175",
                                                "text": "He riffed an upward arpeggio and in a smooth, slightly neutered baritone began singing “Baby Face.”"
                                            },
                                            {
                                                "example_id": "16f8a1ff-66ff-4536-ab50-9f48e3bd6b77",
                                                "sense_id": "0907d204-1d02-38b8-88c0-f1d0d9299175",
                                                "text": "In particular, Ralph Breaks The Internet riffs a lot on its enormous parent company, from that princess bit to the Sterling Holloway tone that new good-luck charm Alan Tudyk brings to his vocal performance to a goof on the de facto parenting advice that’s at the heart of so many Pixar movies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb377ee6-0ece-39d8-80fd-507a51739c1d",
                                        "entry_id": "dbf888b2-2e3d-355c-a9ec-8d833ba90758",
                                        "glosses": [
                                            "To riffle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4b400aa-e08f-47bf-b109-f37bdff98eea",
                                                "sense_id": "fb377ee6-0ece-39d8-80fd-507a51739c1d",
                                                "text": "He reached into his jacket pocket and pulled out a wellworn deck of cards. He hated Saturday duty. He cut the deck and riffed the two halves together."
                                            },
                                            {
                                                "example_id": "fbc8bc27-bc98-4561-8d0b-06d6c0dd0bdc",
                                                "sense_id": "fb377ee6-0ece-39d8-80fd-507a51739c1d",
                                                "text": "He was gracious enough to thank her, and briefly riffed through the pages before putting it in his briefcase."
                                            },
                                            {
                                                "example_id": "27abff86-d498-40c8-91d4-75a71e73b90e",
                                                "sense_id": "fb377ee6-0ece-39d8-80fd-507a51739c1d",
                                                "text": "The man reached inside a pocket of the black broadcloth coat he'd draped over the back of his chair and withdrew a deck of cards, which he fanned in one hand, then bent back and riffed rapidly into the palm of his other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f8e5089-613e-316a-a277-0f1bb201623b",
                                        "entry_id": "dbf888b2-2e3d-355c-a9ec-8d833ba90758",
                                        "glosses": [
                                            "To tell jokes over a movie or similar performance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01d0b67c-4d01-40eb-ae80-4b580754bc3b",
                                                "sense_id": "1f8e5089-613e-316a-a277-0f1bb201623b",
                                                "text": "Most MSTers confine their \"riffing\" to original fan fiction rather than scripts from corporate-owned entertainment properties, which renders such twice-removed MSTing somewhat toothless: the cannibalizing parody of a pastiche."
                                            },
                                            {
                                                "example_id": "25b6c014-c3a0-4235-8fea-a10734236c2a",
                                                "sense_id": "1f8e5089-613e-316a-a277-0f1bb201623b",
                                                "text": "A bad sci-fi movie is often ludicrous and silly and ripe for riffing. A bad comedy is usually just dull."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "riff",
                                "target_lang_code": "en",
                                "target_senses": [
