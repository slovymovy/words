                "senses": [
                    {
                        "sense_id": "16de92a9-7b33-3912-a297-df8cc283871c",
                        "entry_id": "6fecf016-f8d3-3531-ba9a-eaa7d680ed34",
                        "glosses": [
                            "Construire un nouveau groupe à partir d’un groupe et de l’un de ses sous-groupes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b891ff36-d570-4685-96e2-736971517d1b",
                                "sense_id": "16de92a9-7b33-3912-a297-df8cc283871c",
                                "text": "On peut donc toujours quotienter un groupe abélien par l’un quelconque de ses sous-groupes."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff3c3252-c9ff-31eb-baf9-cbdb6e0057d7",
                        "entry_id": "6fecf016-f8d3-3531-ba9a-eaa7d680ed34",
                        "glosses": [
                            "Construire un nouvel anneau sur l’ensemble quotient d’un anneau par un de ses idéaux bilatères."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e11bd08-18fc-40c7-a5c9-e8d7a1300155",
                                "sense_id": "ff3c3252-c9ff-31eb-baf9-cbdb6e0057d7",
                                "text": "Retenons le principe : pour quotienter l’anneau A par I + J, on peut quotienter successivement par I puis par (l’image de) J."
                            }
                        ]
                    },
                    {
                        "sense_id": "5f987f7c-06b4-3bb5-b006-0576aedce894",
                        "entry_id": "6fecf016-f8d3-3531-ba9a-eaa7d680ed34",
                        "glosses": [
