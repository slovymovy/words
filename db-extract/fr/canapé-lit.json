                        "form": "canapés-lits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "60d96ad1-5108-3ec2-8d60-e668fd090188",
                        "entry_id": "c35fe5f0-4c27-35c9-8505-f9fb6e843b38",
                        "glosses": [
                            "Canapé qui se transforme en lit quand il est déplié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15664434-852d-49f4-a777-644face6661c",
                                "sense_id": "60d96ad1-5108-3ec2-8d60-e668fd090188",
                                "text": "Nous avons acheté un nouveau canapé-lit."
                            },
                            {
                                "example_id": "6ff176e7-ec58-44b0-86d7-04b014fcaa35",
                                "sense_id": "60d96ad1-5108-3ec2-8d60-e668fd090188",
                                "text": "J'ai posé ma tasse, je suis allé m'allonger sur le canapé-lit et je me suis endormi instantanément."
                            },
                            {
                                "example_id": "b0d3450a-72e5-4b36-bc70-31a1bd9ceaa3",
                                "sense_id": "60d96ad1-5108-3ec2-8d60-e668fd090188",
                                "text": "Soudain je prends conscience que tout ça, c’est fini. Donc je rentre chez ma mère, prends une double dose de tranquillisants et m’écroule sur le canapé-lit du bureau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "657f42e5-0dd9-46c4-a3c6-25b6bd093f84",
                        "source_entry_id": "c35fe5f0-4c27-35c9-8505-f9fb6e843b38",
                        "source_sense_id": "60d96ad1-5108-3ec2-8d60-e668fd090188",
                        "target_lang_word": "Schlafsofa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlafsofa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d9085ea-9f03-38dc-80ad-8221169d8d7b",
                                        "entry_id": "389af5e5-90e0-31aa-b297-d25184de719c",
                                        "glosses": [
                                            "Sofa, auf dem man schlafen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f1ec542-032f-45d8-83a9-309712e992d4",
                                                "sense_id": "0d9085ea-9f03-38dc-80ad-8221169d8d7b",
                                                "text": "„Als wir nach Hause kommen, sind unsere Schlafsofas zurechtgemacht, jedes mit zwei kaukasischen Decken als Unterlage.“"
                                            },
                                            {
                                                "example_id": "134f666e-bd1a-4117-b7d2-13a073217f19",
                                                "sense_id": "0d9085ea-9f03-38dc-80ad-8221169d8d7b",
                                                "text": "„Ihr hätte das alte Schlafsofa aus dem Gästezimmer der Eltern gereicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
