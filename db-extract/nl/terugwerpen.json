                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5eac712-70d7-3f06-848a-fb0aad33493a",
                                        "entry_id": "9d980574-80c9-3010-8cd7-67502ab730e2",
                                        "glosses": [
                                            "To revert to an earlier stage of development."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "850ecfa3-c1dd-4612-9455-e0989edb35b9",
                                                "sense_id": "e5eac712-70d7-3f06-848a-fb0aad33493a",
                                                "text": "The Century\nA large proportion of the steerage passengers throw back to their Darwinian ancestry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "214f00f7-ea87-391e-9334-cf66e507903c",
                                        "entry_id": "9d980574-80c9-3010-8cd7-67502ab730e2",
                                        "glosses": [
                                            "To retort."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eae8e6c3-95f6-42ff-8957-f0cc90f07e6b",
                                                "sense_id": "214f00f7-ea87-391e-9334-cf66e507903c",
                                                "text": "She jumped to her feet and began stalking away. “Going to cost me fifteen dollars to clean this outfit,” she threw back over her shoulder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cea42a78-dd89-3c3d-98bf-0bd6f2d9d8ea",
                                        "entry_id": "9d980574-80c9-3010-8cd7-67502ab730e2",
                                        "glosses": [
                                            "To drink quickly, especially alcoholic beverages."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a560690-c1c4-46e9-bbc2-f9fd3fa92231",
                                                "sense_id": "cea42a78-dd89-3c3d-98bf-0bd6f2d9d8ea",
                                                "text": "We threw back drinks until the next morning."
                                            },
                                            {
                                                "example_id": "34ee41e3-bdee-428c-8678-247fc4f4f902",
                                                "sense_id": "cea42a78-dd89-3c3d-98bf-0bd6f2d9d8ea",
                                                "text": "“He and I used to throw back beers every now and then when I was with the Bureau.” Shaw grinned arrogantly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99059c60-a342-3f3a-b5fb-36708f4831c0",
                                        "entry_id": "9d980574-80c9-3010-8cd7-67502ab730e2",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see throw, back."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5df16529-cec5-4578-86bb-240bd7c2587d",
                                                "sense_id": "99059c60-a342-3f3a-b5fb-36708f4831c0",
                                                "text": "I threw back my head and laughed uproariously."
                                            },
                                            {
                                                "example_id": "f8facc4e-4624-48c5-b023-2dc2b35f19c9",
                                                "sense_id": "99059c60-a342-3f3a-b5fb-36708f4831c0",
                                                "text": "We caught several fish in the river but threw them back."
                                            },
                                            {
                                                "example_id": "33e99080-b9f4-4abe-b1c6-08c85a35aee9",
                                                "sense_id": "99059c60-a342-3f3a-b5fb-36708f4831c0",
                                                "text": "We all raised our glasses, threw them back. I was getting better, but I still felt the alcohol harder than Stephen ever had."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
