                    ]
                },
                {
                    "sense_id": "4c4543f7-61fa-3f7f-847b-09c8d942e39f",
                    "sense_definition": "Qui a la capacité ou la possibilité de faire, de subir ou de produire quelque chose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "capacite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle proposition de loi est <w>susceptible</w> de changer les règles actuelles."
                        },
                        {
                            "text": "La météo annonce des pluies abondantes qui sont <w>susceptibles</w> de provoquer des inondations dans la région."
                        }
                    ],
                    "synonyms": [
                        "capable",
                        "passible"
                    ],
                    "antonyms": [
                        "insusceptible"
                    ],
                    "common_phrases": [
                        "susceptible de changer",
                        "susceptible de convenir"
                    ]
                },
                {
                    "sense_id": "b166a6b5-b305-355b-92bd-2eda820ade83",
                    "sense_definition": "Se dit d'un cheval de trot qui risque de se mettre fautivement au galop.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hippisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce trotteur reste très <w>susceptible</w> dans les derniers mètres de la course s'il est bousculé."
                        },
                        {
                            "text": "L'entraîneur craint que son cheval ne se montre <w>susceptible</w> lors des accélérations soudaines."
