                                    },
                                    {
                                        "sense_id": "94ef8d2a-818e-3107-aaeb-1fa140a786f6",
                                        "entry_id": "b3a54528-6986-36a4-91a2-fd4e14892096",
                                        "glosses": [
                                            "člověk mající takový oblek na sobě"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fa42cfd-fa66-4552-98c0-e7586fce3d28",
                                                "sense_id": "94ef8d2a-818e-3107-aaeb-1fa140a786f6",
                                                "text": "Co sis to na sebe navlíkl, ty maškaro?"
                                            },
                                            {
                                                "example_id": "4d6d9e74-fcd7-4f7e-b0be-e3d8d758734e",
                                                "sense_id": "94ef8d2a-818e-3107-aaeb-1fa140a786f6",
                                                "text": "Ven z šedivých baráků vylezly maškary v ledovém jitru den po soudné noci."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfccac86-92e5-4cc3-8483-0d53de4ec948",
                        "source_entry_id": "dee9c505-c58b-3bee-a54c-b28fc7393f6b",
                        "source_sense_description": "person who dons a disguising costume",
                        "target_lang_word": "Mumme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mumme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e55dd614-ee5f-3490-831b-532a2dfb678b",
                                        "entry_id": "ea85485f-a81d-3a53-9315-114949dd875a",
                                        "glosses": [
                                            "Malzbier nach Braunschweiger Art"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47611c1d-aa82-4e29-9807-555d24e10445",
                                                "sense_id": "e55dd614-ee5f-3490-831b-532a2dfb678b",
                                                "text": "„Wie weit die Mumme die Traurigkeit vertreibe / zeigen diese Platt - Teutsche Verse / welche Rudel / in der einen Hand eine Braunschweigische Mettwurst in der andern ein Glaß Mumme haltend in der Opera: Heinrich der Vogler genannt: 1718“ (1725)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mumme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "080b4f7a-8e80-3897-8d8e-12580d7c3d37",
                                        "entry_id": "d8a9bc9c-a090-3e01-ade7-79e030879554",
                                        "glosses": [
                                            "Verkleidung, speziell etwas, das das Gesicht verhüllt, Larve, Maske"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4154623b-8b94-4631-a701-f7a902c6abbe",
                                                "sense_id": "080b4f7a-8e80-3897-8d8e-12580d7c3d37",
                                                "text": "„Und eine Mumme vor dem Gesicht: ok grimu fyrir andliti. Das gute alte deutsche Wort Mumme für Larve, Maske schien mir hier ganz an seiner Stelle zu sein.“"
                                            },
                                            {
                                                "example_id": "e4ae90e7-1cc1-466f-bc7b-a0681e94937e",
                                                "sense_id": "080b4f7a-8e80-3897-8d8e-12580d7c3d37",
                                                "text": "„Muhme ist hier offenbar aus Mumme, Larve, Maske, verdorben und bezeichnet eine verlarvte Person ohne Bestimmung des Geschlechts, so wie uns Maske ein maskirtes Individuum bezeichnet, das so männlichen, wie weiblichen Geschlechts sein kann.“ (1847)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d24e26d5-4bd1-37ea-aca3-8a15a01a6ae1",
                                        "entry_id": "d8a9bc9c-a090-3e01-ade7-79e030879554",
                                        "glosses": [
                                            "maskierte/verkleidete Person"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5082d74f-8c6a-4d4c-a6d4-aafb663adf66",
                                                "sense_id": "d24e26d5-4bd1-37ea-aca3-8a15a01a6ae1",
                                                "text": "„Muhme ist hier offenbar aus Mumme, Larve, Maske, verdorben und bezeichnet eine verlarvte Person ohne Bestimmung des Geschlechts, so wie uns Maske ein maskirtes Individuum bezeichnet, das so männlichen, wie weiblichen Geschlechts sein kann.“ (1847)"
                                            },
                                            {
                                                "example_id": "1ad390ef-84d5-4377-890c-fc41530ab1dd",
                                                "sense_id": "d24e26d5-4bd1-37ea-aca3-8a15a01a6ae1",
                                                "text": "„Eine Magd aber weigerte sich und flüchtete sich in ein Haus. Als sie eine Mumme (eine der vermummten Junggesellen) verfolgte, ergriff sie das Bratenmesser und erstach ihren Verfolger damit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
