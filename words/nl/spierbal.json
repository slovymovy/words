    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0433b02b-0589-3afd-b7f5-d74a004b506d",
                    "sense_definition": "verdikking van de spier aan de voorkant van de bovenarm, vooral zichtbaar bij aanspanning",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jongen spande zijn arm aan om zijn <w>spierbal</w> aan zijn vrienden te tonen.",
                            "target_lang_translations": {
                                "fr": "Le garçon a contracté son bras pour montrer son <w>biceps</w> à ses amis."
                            }
                        },
                        {
                            "text": "Hij traint elke dag in de sportschool om een grotere <w>spierbal</w> te krijgen.",
                            "target_lang_translations": {
                                "fr": "Il s'entraîne tous les jours à la salle de sport pour avoir de plus gros <w>biceps</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "biceps"
                    ],
                    "common_phrases": [
                        "spierballen tonen",
                        "spierballen laten zien"
                    ],
                    "target_lang_definitions": {
                        "fr": "Gonflement du muscle à l'avant du bras, particulièrement visible lors de la contraction."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "biceps",
                                "target_lang_sense_clarification": "muscle du bras contracté"
                            },
                            {
                                "target_lang_word": "muscle",
                                "target_lang_sense_clarification": "gonflement musculaire visible"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1993e4b0-b014-31ac-a1ab-7f5ae3f80038",
                    "sense_definition": "iemand die zich stoer, gespierd of daadkrachtig voordoet",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die nieuwe bewaker gedraagt zich als een echte <w>spierbal</w> bij de ingang van de club.",
                            "target_lang_translations": {
                                "fr": "Ce nouveau vigile se comporte comme un vrai <w>gros bras</w> à l'entrée de la boîte."
                            }
                        },
                        {
                            "text": "We hebben geen overmoedige <w>spierbal</w> nodig, maar iemand die rustig kan onderhandelen.",
                            "target_lang_translations": {
                                "fr": "Nous n'avons pas besoin d'un <w>gros bras</w> présomptueux, mais de quelqu'un capable de négocier calmement."
                            }
                        }
                    ],
                    "synonyms": [
                        "krachtpatser",
                        "spierbundel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "figuurlijk gebruikt voor een stoer persoon"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne qui fait l'étalage de sa force physique ou qui cherche à paraître dure et intimidante."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "gros bras",
                                "target_lang_sense_clarification": "personne musclée ou intimidante"
                            },
                            {
                                "target_lang_word": "gourdin",
                                "target_lang_sense_clarification": "homme fort ou agressif"
                            },
                            {
                                "target_lang_word": "costaud",
                                "target_lang_sense_clarification": "personne forte physiquement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}