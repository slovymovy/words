                ],
                "senses": [
                    {
                        "sense_id": "b59846bd-dee9-3122-bcfd-889c047ab872",
                        "entry_id": "a90ba149-631a-3f10-86e4-1fa35d3d7226",
                        "glosses": [
                            "Hinterschenkel des Kalbs, Lamms oder Rehs"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "c6499b9d-5d6f-4027-a972-4bc1c603b558",
                                "sense_id": "b59846bd-dee9-3122-bcfd-889c047ab872",
                                "text": "Wie die Nuss, die Schale und das Fricandeau wird auch der Schlussbraten aus dem Schlögel von Schwein geschnitten."
                            },
                            {
                                "example_id": "3ddd71a6-691f-4fa7-8bc8-7b6784bc6aea",
                                "sense_id": "b59846bd-dee9-3122-bcfd-889c047ab872",
                                "text": "Weiters werden aus dem Schlögel Steaks oder Schnitzel geschnitten, die gebraten, gegrillt oder gebacken werden. Gewürfelt ist der Schlögel ideal für kurz gebratene Ragouts, Spieße und Fondues."
                            },
                            {
                                "example_id": "1be6817c-d091-442b-9ef1-080181e828e3",
                                "sense_id": "b59846bd-dee9-3122-bcfd-889c047ab872",
                                "text": "Die weiblichen Tiere haben im Schlögel 3,3%, im Karree 6,2%, in der Schulter 3.9% und im Bauch 4,6% mehr Fleisch bezogen auf die jeweiligen Teilstückgewichte."
                            },
                            {
                                "example_id": "ac3e3f5a-b41a-42b6-9e49-c617966a3e8e",
                                "sense_id": "b59846bd-dee9-3122-bcfd-889c047ab872",
                                "text": "Den Schlögel mit Wildgewürz gut einreiben, im heißen Sonnenblumenöl gut anbraten, den Braten kurz aus dem Bräter auf den Teller, bitte abdecken."
                            },
                            {
                                "example_id": "70d111a2-7e16-48c5-a9a5-d7c470de9020",
                                "sense_id": "b59846bd-dee9-3122-bcfd-889c047ab872",
                                "text": "Die schon apostrophierten repräsentativen Teile des Wildbrets, wie Schlögel, Rücken (Ziemer), bedürfen weiterer Bearbeitung, um für meine Kochgepflogenheiten entsprechend konserviert werden zu können."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
