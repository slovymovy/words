                        "examples": []
                    },
                    {
                        "sense_id": "01fc7bce-9455-3072-879a-89855f4cc1b5",
                        "entry_id": "5ab15106-ecbf-3501-8862-c0c74e42ebc9",
                        "glosses": [
                            "veel ruimte innemend, ruim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e689204e-b746-42e0-98ef-c49bc86fe138",
                                "sense_id": "01fc7bce-9455-3072-879a-89855f4cc1b5",
                                "text": "Ik zou hem beschrijven als omvangrijk en uitbundig, met expansieve gebaren die een gevaar vormen voor het glaswerk, en een dik hoofd dat speciaal is gemaakt om ruimte te bieden aan zijn brede lach."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "418df4a6-cfc6-487b-a6cb-024a41adcff5",
                        "source_entry_id": "5ab15106-ecbf-3501-8862-c0c74e42ebc9",
                        "target_lang_word": "expansiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7af96229-9e29-4ba2-aa5b-48d81f28d871",
                        "source_entry_id": "5ab15106-ecbf-3501-8862-c0c74e42ebc9",
                        "target_lang_word": "expansive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expansive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32ef1109-bf16-3343-8f39-a47fd4900157",
                                        "entry_id": "ee066a34-f5eb-3797-a7d9-4da37b1fa388",
                                        "glosses": [
                                            "Comprehensive in scope or extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cafa603c-5e35-4c3e-96fe-e7bee87bf93b",
                                                "sense_id": "32ef1109-bf16-3343-8f39-a47fd4900157",
                                                "text": "expansive research work"
                                            },
                                            {
                                                "example_id": "268b6622-73b7-43b5-bda2-52cd57074659",
                                                "sense_id": "32ef1109-bf16-3343-8f39-a47fd4900157",
                                                "text": "She laughed, she winked, and nodded knowingly at Pen; she tapped him on the arm with her fan; she tapped Blanche; she tapped the Major;—her contentment was boundless, and her method of showing her joy equally expansive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "297baf9e-1671-35b0-8935-5c05f3789e8a",
                                        "entry_id": "ee066a34-f5eb-3797-a7d9-4da37b1fa388",
                                        "glosses": [
                                            "Talkative and sociable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d7732f1-5a5f-34a4-bc24-ebee95089ef4",
                                        "entry_id": "ee066a34-f5eb-3797-a7d9-4da37b1fa388",
                                        "glosses": [
                                            "Able to be expanded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6cc3b58-3e1a-4fe0-b0f8-f0d3e0d525b1",
                                                "sense_id": "2d7732f1-5a5f-34a4-bc24-ebee95089ef4",
                                                "text": "The Elastick or expansive faculty of the Air, whereby it dilates itself, when compressed (indeed this lower Region of it by reason of the weight of the superincumbent is al∣ways in a compressed State) hath been made use of in the common Weather-glasses, in Wind guns, and in several ingenious Water∣works, and doubtless hath a great Interest in many natural Effects and Operations."
                                            },
                                            {
                                                "example_id": "bce5ff37-3d51-4b9c-852f-4e7b6cec95da",
                                                "sense_id": "2d7732f1-5a5f-34a4-bc24-ebee95089ef4",
                                                "text": "Such instruments, however ingenious, are not of scientific value; because they do not admit of rigid comparison, are liable to alter in their contractile and expansive properties, and cannot be made to indicate precisely alike."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41c7ec96-a010-33b9-a187-7beab5b41117",
                                        "entry_id": "ee066a34-f5eb-3797-a7d9-4da37b1fa388",
                                        "glosses": [
                                            "Exhibiting expansivity."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb5f60ea-e261-4f6a-b55d-ede614e43766",
                        "source_entry_id": "5ab15106-ecbf-3501-8862-c0c74e42ebc9",
