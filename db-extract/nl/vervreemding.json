                        ]
                    },
                    {
                        "translation_id": "3acec21e-80c1-4a6f-88ac-5e513bc53c81",
                        "source_entry_id": "0f2abf4d-c160-38f5-8804-3445e68841ba",
                        "source_sense_id": "64f1162d-ad65-3186-8e06-837692e79d9e",
                        "source_sense_description": "overdracht van het eigendom",
                        "target_lang_word": "alienation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alienation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1163f71d-73ef-3026-93e1-7e193f17b33e",
                                        "entry_id": "c5484081-5350-3031-af4d-223b6dba9363",
                                        "glosses": [
                                            "The act of alienating."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb4960f9-190b-4d99-b472-aa4b4638d569",
                                                "sense_id": "1163f71d-73ef-3026-93e1-7e193f17b33e",
                                                "text": "The alienation of that viewing demographic is a poor business decision."
                                            },
                                            {
                                                "example_id": "4b075774-8e26-492d-a2b3-cce2984e8b5b",
                                                "sense_id": "1163f71d-73ef-3026-93e1-7e193f17b33e",
                                                "text": "That the mode of alienating their lands, the main source of discontent and war, should be so defined and regulated as to obviate imposition and as far as may be practicable controversy concerning the reality and extent of the alienations which are made."
                                            },
                                            {
                                                "example_id": "b292fa99-d7f1-4da2-8956-36decc90a859",
                                                "sense_id": "1163f71d-73ef-3026-93e1-7e193f17b33e",
                                                "text": "Wearing an Audie Murphy black jacket, playing a Chuck Berry guitar, and performing his electrified alienation with passionate indifference, Dylan assassinated the audience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c483514-838c-3349-a3e2-4249d121bebe",
                                        "entry_id": "c5484081-5350-3031-af4d-223b6dba9363",
                                        "glosses": [
                                            "The state of being alienated."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "871c26ff-5f1c-4d2c-8c04-7f555b1c0187",
                                                "sense_id": "9c483514-838c-3349-a3e2-4249d121bebe",
                                                "text": "I refer to the state of our divisions and alienations of spirit on account of religion."
                                            },
                                            {
                                                "example_id": "46b76b19-80e6-46b6-b8c4-b10dd5ab0d43",
                                                "sense_id": "9c483514-838c-3349-a3e2-4249d121bebe",
                                                "text": "As Hegel showed, time is the necessary alienation, the terrain where the subject realizes himself by losing himself, becomes other in order to become truly himself. In total contrast, the current form of alienation is imposed on the producers of an estranged present. In this spatial alienation, the society that radically separates the subject from the activity it steals from him is in reality separating him from his own time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85c55c35-e007-3fd2-8235-121f21f2fde4",
                                        "entry_id": "c5484081-5350-3031-af4d-223b6dba9363",
                                        "glosses": [
                                            "Emotional isolation or dissociation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "557c557c-101e-4c25-b85b-145cda72d4ae",
                                                "sense_id": "85c55c35-e007-3fd2-8235-121f21f2fde4",
                                                "text": "But these domestic alienations are not confined to those who once moved in the higher orders of society--the monthly registers announce almost as many divorces as marriages, and the facility of separation has rendered the one little more than a licentious compact, which the other is considered as a means of dissolving."
                                            },
                                            {
                                                "example_id": "d2179f44-bf3c-4f53-83d2-3e5f70b2bb4d",
                                                "sense_id": "85c55c35-e007-3fd2-8235-121f21f2fde4",
                                                "text": "To watch it even once is to be distracted, but in an evocative and resonant manner--to be drawn away from Benning's travels and alienations and reminded of one's own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90a34032-174b-337b-bb6d-1c27ae5df81e",
                                        "entry_id": "c5484081-5350-3031-af4d-223b6dba9363",
                                        "glosses": [
                                            "Verfremdungseffekt."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "084b6fa8-6545-3256-bc2d-6fd2cd10fa54",
                                        "entry_id": "c5484081-5350-3031-af4d-223b6dba9363",
                                        "glosses": [
                                            "The transfer of property to another person."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c312efc-7503-497a-8702-f8a632a6a97f",
                                                "sense_id": "084b6fa8-6545-3256-bc2d-6fd2cd10fa54",
                                                "text": "The most usual and universal method of acquiring a title to real estates is that of alienation, conveyance, or purchase in it's limited sense: under which may be comprized any method wherein estates are voluntarily resigned by one man, and accepted by another; whether that be effected by sale, gift, marriage settlement, devise, or other transmission of property by the mutual consent of the parties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8753197a-d62d-3909-8507-78224bada9cb",
                                        "entry_id": "c5484081-5350-3031-af4d-223b6dba9363",
                                        "glosses": [
                                            "The estrangement of people from aspects of their human nature as a consequence of the division of labour and living in a society of stratified social classes."
                                        ],
                                        "tags": [
                                            "Marxism",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2f6544b-274f-4701-aff9-aa59bf48a3cf",
                        "source_entry_id": "0f2abf4d-c160-38f5-8804-3445e68841ba",
                        "source_sense_id": "64f1162d-ad65-3186-8e06-837692e79d9e",
                        "source_sense_description": "overdracht van het eigendom",
                        "target_lang_word": "aliénation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aliénation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47f811ae-47e4-3616-9530-55963b82645f",
                                        "entry_id": "2f58a741-bca0-3eff-9f0b-7ab4a81e2d1e",
                                        "glosses": [
                                            "Transfert volontaire ou forcé à autrui de la propriété ou d’un droit réel sur un bien appartenant au patrimoine d’une personne (→ voir cession et transfert)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a93bd1e4-0a0d-4852-8f20-8ab1d9ae682e",
                                                "sense_id": "47f811ae-47e4-3616-9530-55963b82645f",
                                                "text": "On distingue l’aliénation à titre gratuit (don, legs) et l’aliénation à titre onéreux (échange, prêt de consommation, vente)."
                                            },
                                            {
                                                "example_id": "0b430e68-c8d1-4d41-9417-73c0c60df9e8",
                                                "sense_id": "47f811ae-47e4-3616-9530-55963b82645f",
                                                "text": "L’aliénation volontaire, l’aliénation forcée."
                                            },
                                            {
                                                "example_id": "788d1eb2-6e4c-4419-8f70-5320bed0d09d",
                                                "sense_id": "47f811ae-47e4-3616-9530-55963b82645f",
                                                "text": "Aliénation d’un domaine, d’une terre."
                                            },
                                            {
                                                "example_id": "8a4870aa-031d-4fae-9d38-b6e3fd22a975",
                                                "sense_id": "47f811ae-47e4-3616-9530-55963b82645f",
                                                "text": "Ce qu'il y a de singulier dans cette aliénation, c'est que, loin qu'en acceptant les biens des particuliers, la communauté les en dépouille, elle ne fait que leur en assurer la légitime possession, changer l'usurpation en un véritable droit et la jouissance en propriété."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ec5119b-bd34-3016-bf71-4b5e65266203",
                                        "entry_id": "2f58a741-bca0-3eff-9f0b-7ab4a81e2d1e",
                                        "glosses": [
                                            "Éloignement que des personnes ont les unes pour les autres."
                                        ],
                                        "tags": [
                                            "dated",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dd74a92-c908-4299-8806-e2d4dc8b8a6b",
                                                "sense_id": "9ec5119b-bd34-3016-bf71-4b5e65266203",
                                                "text": "Aliénation des volontés, des esprits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "926bc113-a2f9-35e4-8ac2-15327053104a",
                                        "entry_id": "2f58a741-bca0-3eff-9f0b-7ab4a81e2d1e",
                                        "glosses": [
                                            "Trouble mental grave, perte de la raison ou égarement de l’esprit."
                                        ],
                                        "tags": [
                                            "dated",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27bd359c-a59b-465d-8c0c-ca60d6c5df57",
                                                "sense_id": "926bc113-a2f9-35e4-8ac2-15327053104a",
                                                "text": "Aliénation d’esprit ou aliénation mentale,"
                                            },
                                            {
                                                "example_id": "5b825d02-8b33-4708-b134-ea2a57be747a",
                                                "sense_id": "926bc113-a2f9-35e4-8ac2-15327053104a",
                                                "text": "Marcel commençait à donner des signes visibles d’aliénation mentale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c57d280-1555-3d99-8bd6-4ead4f92f707",
                                        "entry_id": "2f58a741-bca0-3eff-9f0b-7ab4a81e2d1e",
                                        "glosses": [
                                            "Dépossession de ce qui fait réellement le charme de l'existence ; éloignement de la réalité ; dépendance à des activités virtuelles, étrangères à la vie réelle ; vie fictive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c323569a-3f8a-4376-a86a-8ca01a0ff947",
                                                "sense_id": "9c57d280-1555-3d99-8bd6-4ead4f92f707",
                                                "text": "[Le souverain pontife (le pape Benoît XVI)]: y note [dans un message intitulé: \"Vérité, proclamation et authenticité de vie à l'âge numérique\"] les grandes possibilités offertes par les nouveaux médias et les réseaux sociaux, mais il met en garde contre les risques de dépersonnalisation, d'aliénation et d'autocomplaisance. Il souligne aussi le danger d'avoir davantage de relations virtuelles que de véritables amis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81c51ac7-1b27-3945-9f42-55977e4df80d",
                                        "entry_id": "2f58a741-bca0-3eff-9f0b-7ab4a81e2d1e",
                                        "glosses": [
                                            "Concernant un peuple ou un groupe social : perte d'autonomie, effacement programmé de sa culture, de sa langue et de sa pensée, dépossession de son héritage et de sa culture traditionnelle par une puissance marchande étrangère ou transnationale. Fait de devenir étranger sur son propre territoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "948821dd-0db9-4b37-83cf-29e4b8299df7",
                                                "sense_id": "81c51ac7-1b27-3945-9f42-55977e4df80d",
                                                "text": "Mais si l'occidentalisation a provoqué une aliénation chez les musulmans, une aliénation parallèle est apparue dans la communauté avec ce que Laroui nomme médiévalisation, à savoir l'identification de l'Arabe avec la grande époque de l’âge d'or de l'histoire islamique."
                                            },
                                            {
                                                "example_id": "e79b49ca-9a6f-4251-b04d-ffd38c6ee878",
                                                "sense_id": "81c51ac7-1b27-3945-9f42-55977e4df80d",
                                                "text": "La production massive de l’aliénation trouve désormais sa source et ses points d’appui principaux dans la guerre totale que les industries combinées du divertissement, de la publicité et du mensonge médiatique livrent quotidiennement à l’intelligence humaine."
                                            },
                                            {
                                                "example_id": "e7c0d5d7-f3fa-494a-b43d-fcdb7fd286eb",
                                                "sense_id": "81c51ac7-1b27-3945-9f42-55977e4df80d",
                                                "text": "Mais Barreto s’attaque aussi à un nouveau phénomène urbain, à l’engouement des masses pour un sport envahissant, le football, dont il pressent le pouvoir d’aliénation, avec ce qu’il charrie de traficotage et de violence. Il ne se doute pas que la maladie deviendra planétaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb791439-ac9e-3bdd-bb3c-5e3860629391",
                                        "entry_id": "2f58a741-bca0-3eff-9f0b-7ab4a81e2d1e",
                                        "glosses": [
                                            "Atteinte aux droits sociaux, politiques et civils des individus."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16ee6c2e-e847-432b-8929-555077fed2e2",
                                                "sense_id": "cb791439-ac9e-3bdd-bb3c-5e3860629391",
                                                "text": "[…], Out-el-Kouloub, quant à elle, n’est pas à proprement parler une femme engagée politiquement. Elle se préoccupe du politique en luttant contre les aliénations de l’être afin de réintégrer la femme dans la vie de la cité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
