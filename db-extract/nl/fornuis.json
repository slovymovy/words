                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "63b8a833-406f-3398-8392-26bef79ebd57",
                                        "entry_id": "c4c5e25d-6571-3268-b471-20e28e259190",
                                        "glosses": [
                                            "(zentrale) Feuerstelle, Wärmequelle und Kochstelle eines Hauses"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f70bfe85-bd07-4f5e-9db0-9c365a244340",
                                                "sense_id": "63b8a833-406f-3398-8392-26bef79ebd57",
                                                "text": "Stell den Kessel auf den Herd!"
                                            },
                                            {
                                                "example_id": "2a36e9bd-540f-43df-889d-0a4f98505365",
                                                "sense_id": "63b8a833-406f-3398-8392-26bef79ebd57",
                                                "text": "Abends versammelte man sich um den Herd."
                                            },
                                            {
                                                "example_id": "04e863d5-73fb-496e-86db-575ce965ccac",
                                                "sense_id": "63b8a833-406f-3398-8392-26bef79ebd57",
                                                "text": "„Es gab vermutlich einen gusseisernen Herd, von den Wänden baumelten Kerosinleuchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a442f640-9f1a-36f7-9dc3-57396fdf302b",
                                        "entry_id": "c4c5e25d-6571-3268-b471-20e28e259190",
                                        "glosses": [
                                            "mit Elektrizität oder Gas betriebenes Gerät, auf dem Speisen gekocht werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f805c45-9a7a-4dfa-99bd-7b194fc98476",
                                                "sense_id": "a442f640-9f1a-36f7-9dc3-57396fdf302b",
                                                "text": "Das Essen der Familie steht auf dem Herd."
                                            },
                                            {
                                                "example_id": "226b4492-3527-4002-8219-e83e8314953f",
                                                "sense_id": "a442f640-9f1a-36f7-9dc3-57396fdf302b",
                                                "text": "Dieser Herd hat Keramikkochfelder und einen Backofen."
                                            },
                                            {
                                                "example_id": "edd60dbc-8b82-4dc3-84e4-b6bccbf9d1b8",
                                                "sense_id": "a442f640-9f1a-36f7-9dc3-57396fdf302b",
                                                "text": "„Auf dem Herd stapelten sich die Plastikteller vom Kabab-Lieferdienst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "33e709bb-c65e-32b3-b9c1-4a2ca5fa73f8",
                                        "entry_id": "c4c5e25d-6571-3268-b471-20e28e259190",
                                        "glosses": [
                                            "der Ort, von dem eine (meist negative) Entwicklung ausgeht"
                                        ],
                                        "tags": [
                                            "mit Genitiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ed40852-db2a-4f16-9abf-a492f4ab18f8",
                                                "sense_id": "33e709bb-c65e-32b3-b9c1-4a2ca5fa73f8",
                                                "text": "Universitäten sind ein Herd der Unruhe."
                                            },
                                            {
                                                "example_id": "7bc211be-03a3-47de-ad57-b2f0e316d148",
                                                "sense_id": "33e709bb-c65e-32b3-b9c1-4a2ca5fa73f8",
                                                "text": "Der Spanische Bürgerkrieg war der Herd des Zweiten Weltkriegs."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "73c7c1a5-3781-310c-bd9b-285a20319af2",
                                        "entry_id": "c4c5e25d-6571-3268-b471-20e28e259190",
                                        "glosses": [
                                            "der Ort, an dem eine Krankheit beginnt oder zuerst auftritt"
                                        ],
                                        "tags": [
                                            "mit Genitiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8fa6ba1-e5f6-4572-b8e4-1ad4f09436b3",
                                                "sense_id": "73c7c1a5-3781-310c-bd9b-285a20319af2",
                                                "text": "Wenn wir den Herd ausgemacht haben, bekommen wir die Infektion sicher bald unter Kontrolle."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40a31045-6803-4103-9a40-3abeaa27e266",
                        "source_entry_id": "b04a008c-54b0-3d05-9325-885a891b1db0",
                        "source_sense_id": "083d980c-ee04-3deb-8dfe-0d2d85b742b9",
