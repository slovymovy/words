                        "glosses": [
                            "A person with such a belly."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3d44d33b-ef50-41d1-9470-4a7f2449c9c0",
                                "sense_id": "c618c712-a9fb-3063-9816-29188f90b8d8",
                                "text": "The belching gorbelly hath well nigh killed me."
                            },
                            {
                                "example_id": "5f0c5607-398f-4bff-a3d4-054363e274e5",
                                "sense_id": "c618c712-a9fb-3063-9816-29188f90b8d8",
                                "text": "To be briefe with him, he is a pestilence to pasties, which sweepeth many of them sheere away; a consumption to capons, chickins, and other poultry; a sepulchre to seafish and others in ponds, moates and rivers; a sharp sheepe-biter, and a marveilous mutton monger, a gorbelly glutton."
                            },
                            {
                                "example_id": "8eeb8cdf-7754-47b0-8a7b-2fbade8640c6",
                                "sense_id": "c618c712-a9fb-3063-9816-29188f90b8d8",
                                "text": "\"You girt vlat-vooted, gorbelly, stunpole, Zolomon Moggridge,\" he yelled, louder and louder with each word, \"you've a-squot I so vlat as a dough-fig.\""
                            }
                        ]
                    }
