                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "rapidite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il marche très <w>vite</w> pour ne pas manquer son bus du matin."
                        },
                        {
                            "text": "Ne conduis pas trop <w>vite</w> car la route est glissante aujourd'hui."
                        }
                    ],
                    "synonyms": [
                        "rapidement"
                    ],
                    "antonyms": [
                        "lentement"
                    ],
                    "common_phrases": [
                        "aller vite",
                        "faire vite",
                        "parler vite"
                    ]
                }
            ]
        },
        {
