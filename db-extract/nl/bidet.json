                                    },
                                    {
                                        "sense_id": "eaa754e7-d5b4-3bc3-a4e2-01313c45d8e9",
                                        "entry_id": "d5d8b135-0ca7-31d9-b1bd-ef6d42ff0d7e",
                                        "glosses": [
                                            "A small horse formerly allowed to each trooper or dragoon for carrying his baggage."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bcbf2c2-9255-486b-8e6c-7be619c73707",
                                                "sense_id": "eaa754e7-d5b4-3bc3-a4e2-01313c45d8e9",
                                                "text": "For joy of which I will return to myself, mount my bidet in a dance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dde86ce2-fc37-4603-a8e7-81769a525a1c",
                        "source_entry_id": "aeb626d1-11ee-3ec3-bcba-56d8f22ef310",
                        "source_sense_id": "04215773-441d-3abb-8e34-16b015e11701",
                        "source_sense_description": "soort van aan de muur bevestigde kom of bak voor het met behulp van water reinigen van de geslachtsdelen, billen en anus na gebruik van het toilet, of om de voeten te wassen",
                        "target_lang_word": "bidet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bidet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "759078c7-2c83-314c-bb9c-3b259dc872d5",
                                        "entry_id": "6d11bf78-3782-3c50-8008-dac76ad2fdf1",
                                        "glosses": [
                                            "Petit cheval trapu souvent utilisé autrefois par les courriers de poste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e222bf6a-7808-49d3-9585-a614519e36ec",
                                                "sense_id": "759078c7-2c83-314c-bb9c-3b259dc872d5",
                                                "text": "Un double bidet : une botte de foing, une de paille, & trois piccotins d’avoine."
                                            },
                                            {
                                                "example_id": "1f73c53f-e588-4450-b5d3-901ae95a00d6",
                                                "sense_id": "759078c7-2c83-314c-bb9c-3b259dc872d5",
                                                "text": "Il [Louis XV] commençait à monter un petit bidet, et il alla demander au roi la permission d’y aller [à la revue des gendarmes]."
                                            },
                                            {
                                                "example_id": "306c29b6-bde4-4473-a057-c32665aa2ae2",
                                                "sense_id": "759078c7-2c83-314c-bb9c-3b259dc872d5",
                                                "text": "Peut-être enverront-ils au vieux prieur un petit bidet à allure douce."
                                            },
                                            {
                                                "example_id": "2bd18f3f-25ec-4367-87e6-1155a8e0175e",
                                                "sense_id": "759078c7-2c83-314c-bb9c-3b259dc872d5",
                                                "text": "Derrière l’âne venaient un notaire et deux alguazils en habit noir à la française, culottes et bas de soie, l’épée au côté, et montés sur de mauvais bidets très mal harnachés. Un piquet de cavalerie fermait la marche."
                                            },
                                            {
                                                "example_id": "366b01ae-68a2-459b-822c-b13471ac4fc0",
                                                "sense_id": "759078c7-2c83-314c-bb9c-3b259dc872d5",
                                                "text": "– Quant aux chevaux, les miens sont des bidets de dix à douze louis, peu dignes d’un officier bien ficelé et requinqué comme vous, et bons tout au plus à faire une course ; de vrais bidets, quoi !"
                                            },
                                            {
                                                "example_id": "46a405f1-a5fe-48d0-9b4c-8e9701796582",
                                                "sense_id": "759078c7-2c83-314c-bb9c-3b259dc872d5",
                                                "text": "Car notre jeune homme avait une monture, et cette monture était même si remarquable, qu’elle fut remarquée : c’était un bidet du Béarn, âgé de douze ou quatorze ans, jaune de robe, sans crins à la queue, mais non pas sans javarts aux jambes, et qui, tout en marchant la tête plus bas que les genoux, ce qui rendait inutile l’application de la martingale, faisait encore également ses huit lieues par jour."
                                            },
                                            {
                                                "example_id": "7d1bcd14-06a2-4999-afb6-2fd1f7f108c0",
                                                "sense_id": "759078c7-2c83-314c-bb9c-3b259dc872d5",
                                                "text": "Mais, aussitôt, le trot saccadé du bidet secoua si terriblement la voiture que les chaises commencèrent à danser, jetant les voyageuses en l’air, à droite, à gauche, avec des mouvements de pantins, des grimaces effarées, des cris d’effroi, coupés soudain par une secousse plus forte."
                                            },
                                            {
                                                "example_id": "6f43b11c-d978-4292-a8a6-04f63f847ee8",
                                                "sense_id": "759078c7-2c83-314c-bb9c-3b259dc872d5",
                                                "text": "À dada sur mon bidet."
                                            },
                                            {
                                                "example_id": "4a2038bf-2e95-4b74-8bba-cf48d147ed6e",
                                                "sense_id": "759078c7-2c83-314c-bb9c-3b259dc872d5",
                                                "text": "Longtemps il m’avait fait sauter sur sa jambe tendue en chantant : « À cheval sur mon bidet ; quand il trotte il fait des pets », et je riais de scandale."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bidet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "146cc465-84e7-37a7-b8a5-0eed07d1869d",
                                        "entry_id": "b9076bdd-49ac-30b8-bb59-5c9a27b663e5",
                                        "glosses": [
                                            "Établi portatif en bois sur lequel les ouvriers exécutent leur menu travail sur le chantier → voir chevalet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ae08b9db-18c9-3483-aad1-735d5063046d",
                                        "entry_id": "b9076bdd-49ac-30b8-bb59-5c9a27b663e5",
                                        "glosses": [
                                            "Élément de salle de bains (ou meuble de garde-robe) comportant une cuvette longue, destiné à la toilette intime sur laquelle on peut s’asseoir à califourchon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27fd68a3-c3d1-4807-a108-89aeb1c1314c",
                                                "sense_id": "ae08b9db-18c9-3483-aad1-735d5063046d",
                                                "text": "Et au bout de sa tirade, par une déduction pas absolument logique, de déclarer que les dévotes ne se lavent pas le derrière, assertion contre laquelle proteste la baronne et que coupe la princesse par cette répartie à brûle-pourpoint : « Madame je connais à fond Saint-Denis, Écouen, Picpus : eh bien, je puis faire le serment qu’il n’y a pas un bidet ! »"
                                            },
                                            {
                                                "example_id": "79d46608-d33a-4f90-a1ba-a2bbebfd1935",
                                                "sense_id": "ae08b9db-18c9-3483-aad1-735d5063046d",
                                                "text": "17 août 1940 – Enfin je verrai Pasquale hors du cadre sordide de sa chambre d’hôtel avec bidet apparent."
                                            },
                                            {
                                                "example_id": "583b083a-5c7d-49e1-952f-b178741356cc",
                                                "sense_id": "ae08b9db-18c9-3483-aad1-735d5063046d",
                                                "text": "Ça refoule vilain, dans ce coincetot. La paella d'abord, et puis aussi l'eau de lavande et l'éponge de bidet."
                                            },
                                            {
                                                "example_id": "d9a0c761-8bd8-400d-b119-5305f69ecee6",
                                                "sense_id": "ae08b9db-18c9-3483-aad1-735d5063046d",
                                                "text": "J’avais jamais vu de femme sur un bidet, j’avais même jamais vu de bidet, même pas une chiotte où qu’on s’assoit dessus, […]"
                                            },
                                            {
                                                "example_id": "09a08344-64c0-4eac-8d87-9fe942a1c21c",
                                                "sense_id": "ae08b9db-18c9-3483-aad1-735d5063046d",
                                                "text": "Il a eu une adolescence précocement queutarde : […]. On pourrait le brancher des heures sur ces fumantes évocations avec des gargouillements de bidet en fond sonore et des poils de cul sur la langue pour le faire zozoter."
                                            },
                                            {
                                                "example_id": "a4750e9f-0d7a-403e-bacf-c0a4c8983c4c",
                                                "sense_id": "ae08b9db-18c9-3483-aad1-735d5063046d",
                                                "text": "(Monsieur Wilder nous a raconté une anecdote amusante sur les bidets au dîner l’autre soir. Apparemment, la dernière fois qu’il faisait un film à Paris, sa femme lui a demandé d’acheter un bidet et de le lui faire expédier aux États-Unis. À la place, il lui a envoyé un télégramme qui disait : « Pas pu trouver de bidet – te suggère de faire le poirier sous la douche. »)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
