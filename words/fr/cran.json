                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une journée de travail aussi stressante, il était particulièrement à <w>cran</w>.",
                            "target_lang_translations": {
                                "en": "After such a stressful day at work, he was particularly on <w>edge</w>.",
