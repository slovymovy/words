                "senses": [
                    {
                        "sense_id": "8a32b1e2-c7cc-37b0-aa8b-0f9f9c173e1b",
                        "entry_id": "e85c3752-7ac8-3203-a23d-97b06facb550",
                        "glosses": [
                            "das Geld, das von Personen einer wirtschaftlichen Gemeinschaft für den Lebensunterhalt ausgegeben wird"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "2de07d19-1c3f-4fdf-81c4-c2614eb7bfb7",
                                "sense_id": "8a32b1e2-c7cc-37b0-aa8b-0f9f9c173e1b",
                                "text": "„Eine Übersicht - Fast 2000 Euro gibt ein deutscher Haushalt pro Monat im Durchschnitt aus. Dabei sind Wohn- und Energiekosten im privaten Budget der weitaus größte Posten: Ein Drittel der Haushaltsausgaben, 662 Euro, fließt in Miete, Strom und Reparaturen. Ins Gewicht fallen auch das eigene Fahrzeug, Sprit und Tickets für Bahn und Bus: 270 Euro monatlich werden für die Mobilität verbraucht.“"
                            },
                            {
                                "example_id": "091dd7e3-b9c1-4fbc-913b-3766ad3d41c8",
                                "sense_id": "8a32b1e2-c7cc-37b0-aa8b-0f9f9c173e1b",
                                "text": "„Sie stimmten zu, die Haushaltsausgaben für die beiden kommenden Jahre um 4,6 Milliarden Kanada-Dollar (rund 2,8 Milliarden Euro) auszuweiten - für sozialen Wohnungsbau, Umweltinitiativen und Entwicklungshilfe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e74e0d3f-476b-397f-ba50-dce6b273e160",
                        "entry_id": "e85c3752-7ac8-3203-a23d-97b06facb550",
                        "glosses": [
                            "das Geld, das der Staat in Übereinstimmung mit seiner Haushaltsplanung ausgibt"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "db954f28-73e6-47b3-a12a-b2ec22070f07",
                                "sense_id": "e74e0d3f-476b-397f-ba50-dce6b273e160",
                                "text": "Die geplanten Haushaltsausgaben werden nächstes Jahr die Milliardengrenze erreichen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
