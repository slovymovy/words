                        "entry_id": "a3774fed-b313-3b01-9286-e4fdde4100d0",
                        "glosses": [
                            "Resembling or characteristic of pork."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2f8cf1f-cb9d-42f1-bae4-79bf0171db35",
                                "sense_id": "abf787da-9fad-3820-848e-ffaad30e04f3",
                                "text": "It was tender and delicious, with a kind of porky taste you didn't often get from supermarket meats."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4d0ae6f-c74d-3f8d-be29-50583704cfec",
                        "entry_id": "a3774fed-b313-3b01-9286-e4fdde4100d0",
                        "glosses": [
                            "Rather fat; chubby."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7e86ca4a-e9c5-49ba-9ce9-8a3e65d33a47",
                                "sense_id": "c4d0ae6f-c74d-3f8d-be29-50583704cfec",
                                "text": "In front of Lister a small red-haired man, with a porky roll of flesh above his towel-top, was examining a line of girls."
                            }
                        ]
                    }
                ],
                "translations": [
