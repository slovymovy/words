                "senses": [
                    {
                        "sense_id": "6de13dc6-b771-352b-8757-516f473c464a",
                        "entry_id": "6e7eadeb-738f-30cf-ad92-0f8da7ed1af5",
                        "glosses": [
                            "Eigenschaft, sanft zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ceed0e3-bae2-4a81-ae5f-b177b8119560",
                                "sense_id": "6de13dc6-b771-352b-8757-516f473c464a",
                                "text": "„Sie war versucht, diese Höflichkeit zu durchbrechen, die polierte Oberfläche ihrer Sanftheit anzukratzen mit ihrer Extravaganz.“"
                            },
                            {
                                "example_id": "2641495f-f16a-44e2-bf2f-4c36eb95d0b3",
                                "sense_id": "6de13dc6-b771-352b-8757-516f473c464a",
                                "text": "„Sie antwortete mir mit größter Sanftheit, ich solle mir deshalb keine Gedanken machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
