                        "translation_id": "20384536-2290-4518-936e-e18d4cffda6c",
                        "source_entry_id": "ca88c6d5-722e-3274-a7b0-dd3cfb842c6f",
                        "source_sense_description": "curved file used in carving wood and marble",
                        "target_lang_word": "rifloir",
