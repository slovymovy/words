                                    },
                                    {
                                        "sense_id": "b95bbac5-4e6d-39e5-9b8b-a789d6682390",
                                        "entry_id": "48e243a0-9f34-3a9c-b959-0450fa3c3064",
                                        "glosses": [
                                            "A light tap of the ball."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a881ea4-8cef-4d7b-982f-31db4d8c50d7",
                                                "sense_id": "b95bbac5-4e6d-39e5-9b8b-a789d6682390",
                                                "text": "There's a very fine line between a tickle and an edge!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c3a7564-e9ad-3cfd-a65d-9a0e7cec1fc7",
                                        "entry_id": "48e243a0-9f34-3a9c-b959-0450fa3c3064",
                                        "glosses": [
                                            "A narrow strait, such as between an island and the shore."
                                        ],
                                        "tags": [
                                            "Newfoundland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a485ca5e-3cbb-4a61-9420-69cd317e321d",
                                                "sense_id": "6c3a7564-e9ad-3cfd-a65d-9a0e7cec1fc7",
                                                "text": "Charts and Plans. [...] No. New Charts. 2253 England, and south coast—Dartmouth harbour. [...] 3320 Newfoundland, Thimble tickles and Glover harbour—Head of Seal bay."
                                            },
                                            {
                                                "example_id": "ec31a8d6-caf3-4271-8a27-06178c3e3cfa",
                                                "sense_id": "6c3a7564-e9ad-3cfd-a65d-9a0e7cec1fc7",
                                                "text": "Cow Head itself is a prominent headland connected to the settlement by a natural causeway, or ‘tickle’ as the Newfoundlanders prefer it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tickle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78de0d29-1804-322f-87e2-66b4a02ebcb4",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To touch repeatedly or stroke delicately in a manner which typically causes laughter, pleasure and twitching."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46e6d8a7-e683-4ad1-ab0f-a660e7855f5b",
                                                "sense_id": "78de0d29-1804-322f-87e2-66b4a02ebcb4",
                                                "text": "He tickled Nancy's tummy, and she started to giggle."
                                            },
                                            {
                                                "example_id": "b62a63ab-6bd5-46b0-b5c3-3415728ced76",
                                                "sense_id": "78de0d29-1804-322f-87e2-66b4a02ebcb4",
                                                "text": "If you tickle us, do we not laugh?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac240a6d-316b-3860-a1a3-59258522e019",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To feel as if the body part in question is being tickled."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18192f46-2ce8-42b3-9f91-cccf8f314a71",
                                                "sense_id": "ac240a6d-316b-3860-a1a3-59258522e019",
                                                "text": "My nose tickles, and I'm going to sneeze!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "808de3bc-0fb5-3777-b8da-24122dad0798",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To appeal to someone's taste, curiosity etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80f1d0c1-1c29-3c80-870d-5dcb77c8f42c",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To cause delight or amusement in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "357dbd34-752e-4fe5-a0b9-690802a4b766",
                                                "sense_id": "80f1d0c1-1c29-3c80-870d-5dcb77c8f42c",
                                                "text": "He was tickled to receive such a wonderful gift."
                                            },
                                            {
                                                "example_id": "07204cc5-3e7a-4e6a-9237-230b7df3495d",
                                                "sense_id": "80f1d0c1-1c29-3c80-870d-5dcb77c8f42c",
                                                "text": "Behold the child, by Nature's kindly law,\nPleas'd with a rattle, tickled with a straw."
                                            },
                                            {
                                                "example_id": "14b4f9f7-2973-4771-a6ad-6aaddc6138c5",
                                                "sense_id": "80f1d0c1-1c29-3c80-870d-5dcb77c8f42c",
                                                "text": "Such a nature\nTickled with good success, disdains the shadow\nWhich he treads on at noon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "798fb4fe-ce39-36c5-b0e5-a86b014570ee",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To feel titillation."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "840f2389-3bda-42f2-9b93-a064e49cfbe5",
                                                "sense_id": "798fb4fe-ce39-36c5-b0e5-a86b014570ee",
                                                "text": "He with secret joy therefore\nDid tickle inwardly in every vein."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d7e9d9a-cfc2-39f5-8f8c-bcfa1e617b36",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To catch fish in the hand (usually in rivers or smaller streams) by manually stimulating the fins."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2de4bf4-2554-38d3-85ea-9f06ccc00e49",
                                        "entry_id": "68a17651-3945-3713-a768-1d9bb29d1a28",
                                        "glosses": [
                                            "To be excited or heartened."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
