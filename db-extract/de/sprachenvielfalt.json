                "senses": [
                    {
                        "sense_id": "4570385b-df5e-3953-b015-acd860cfd0c5",
                        "entry_id": "4789af53-f2e6-3910-9d4d-6fda2fc7edfc",
                        "glosses": [
                            "Vorhandensein mehrerer/vieler Sprachen im gleichen Raum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cb893d0-8107-4fd8-a2d1-76d0f65ff23c",
                                "sense_id": "4570385b-df5e-3953-b015-acd860cfd0c5",
                                "text": "„Die Multikulturalität des kolonialen Raumes wird durch die Sprachenvielfalt wiedergegeben.“"
                            },
                            {
                                "example_id": "97f3b455-1654-4b25-91c0-22db1a5f61b2",
                                "sense_id": "4570385b-df5e-3953-b015-acd860cfd0c5",
                                "text": "„Wer die Inselgruppe Ryukyu (japanisch: Nansei-Inseln) besucht, wird sich über die dortige Sprachenvielfalt wundern.“"
                            },
                            {
                                "example_id": "b6ebcf3b-6187-4caf-bcba-8dc39bc80dde",
                                "sense_id": "4570385b-df5e-3953-b015-acd860cfd0c5",
                                "text": "„Linguistisch gesehen steht der Turmbau von Babel, das biblische Wahrzeichen vermessenen menschlichen Hochmuts, der vor dem Fall kommt, nicht nur als Sinnbild für die hernach auf der Erde herrschende Sprachenvielfalt, sondern auch für den uralten Sprachverfalls-Topos.“"
                            },
                            {
                                "example_id": "84e0bb82-d1ef-4f89-98c3-86ea09df2d85",
                                "sense_id": "4570385b-df5e-3953-b015-acd860cfd0c5",
                                "text": "„Die größte Sprachenvielfalt findet sich in Afrika und Asien – Spitzenreiter ist Papua-Neuguinea mit 820 Sprachen.“"
                            },
                            {
                                "example_id": "7ef02b74-82bc-4fd4-ae13-12acd18dc427",
                                "sense_id": "4570385b-df5e-3953-b015-acd860cfd0c5",
                                "text": "„Die höchste Sprachenvielfalt weist der Hindukusch auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
