    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7d60018e-3e0c-3aca-a9ab-19706f05acef",
                "word": "merch",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0c0926fd-f01a-3762-bcb7-8c4cab5a2197",
                        "entry_id": "7d60018e-3e0c-3aca-a9ab-19706f05acef",
                        "glosses": [
                            "goods which are or were offered or intended for sale."
                        ],
                        "tags": [
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "91433904-1b8a-4b01-8d5f-03059caad5a0",
                                "sense_id": "0c0926fd-f01a-3762-bcb7-8c4cab5a2197",
                                "text": "His playful point of view on youthful American sportswear, expressed in boxy mohair jackets with graphic resin bubble buttons and tomboy T-shirt dresses in superfine chiffon as bright as tangerine sorbet, is backed up with what stores would describe as the merch: easy scoop-neck cashmere sweaters in a mix of colors, lightweight T-shirts and sheared mink Army caps."
                            }
                        ]
                    },
                    {
                        "sense_id": "1919bf8d-a3f7-35e9-91da-af99ca635690",
                        "entry_id": "7d60018e-3e0c-3aca-a9ab-19706f05acef",
                        "glosses": [
                            "goods which are or were offered or intended for sale.",
                            "goods connected with an entity such as a team, band, work of fiction, etc."
                        ],
                        "tags": [
                            "especially",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "88bb1da1-3b72-43a1-af39-88984709ca6d",
                                "sense_id": "1919bf8d-a3f7-35e9-91da-af99ca635690",
                                "text": "Many musicians make merch you can only get if you join the fanclub."
                            },
                            {
                                "example_id": "72ef816a-4c7d-4096-814c-091f3f360916",
                                "sense_id": "1919bf8d-a3f7-35e9-91da-af99ca635690",
                                "text": "With almost two months until Inauguration Day, fans who were \"With Her\" (or are still \"With Her\") can grab Clinton merch — now at deeply marked-down prices."
                            },
                            {
                                "example_id": "ada539b9-589d-4162-9711-e1c617497cf0",
                                "sense_id": "1919bf8d-a3f7-35e9-91da-af99ca635690",
                                "text": "The merch is proof of how much the sentiment resonates with people."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b2011cd-a499-4c0c-b0c5-e25014d7a719",
