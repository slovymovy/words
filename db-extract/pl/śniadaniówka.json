                                        "entry_id": "6125b5a0-3267-3425-b86a-98227243921e",
                                        "glosses": [
                                            "A luggable; an early laptop computer, usually a unit with a handle and a fold-out keyboard."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdfad7b0-40c6-447c-ba71-88857b514ee8",
                                                "sense_id": "8c735517-0a7d-308e-8c4a-d1a3e00ddf5f",
                                                "text": "You'll find a mix among clamshell laptops for strong laps, lunchboxes, and sewing-machine configurations; the latter two designs typically have detachable keyboards."
                                            },
                                            {
                                                "example_id": "093fd062-e862-46b1-81be-753ec546c578",
                                                "sense_id": "8c735517-0a7d-308e-8c4a-d1a3e00ddf5f",
                                                "text": "The performance difference between desktops and lunchboxes was practically nil."
                                            }
