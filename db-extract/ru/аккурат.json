                                "target_senses": [
                                    {
                                        "sense_id": "0f31dc08-b288-3a9c-9542-fce3f5055e86",
                                        "entry_id": "e63ba750-1fa2-31ab-be23-e76f7c64915d",
                                        "glosses": [
                                            "Without approximation; precisely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb3aa7e7-df42-45f5-b059-2a99993db50c",
                                                "sense_id": "0f31dc08-b288-3a9c-9542-fce3f5055e86",
                                                "text": "Measure exactly so we can be sure it is right."
                                            },
                                            {
                                                "example_id": "fd9431ac-877b-4ae7-a7ea-9975c26cc96f",
                                                "sense_id": "0f31dc08-b288-3a9c-9542-fce3f5055e86",
                                                "text": "The edge is not exactly straight."
                                            },
                                            {
                                                "example_id": "ba46e162-9da7-4fad-a11f-ee373a350aaf",
                                                "sense_id": "0f31dc08-b288-3a9c-9542-fce3f5055e86",
                                                "text": "He divided the coins exactly in half."
                                            },
                                            {
                                                "example_id": "1cde011d-c64d-48ef-84af-7cc7e5c036f8",
                                                "sense_id": "0f31dc08-b288-3a9c-9542-fce3f5055e86",
                                                "text": "He, that would write exactly, muſt avoid a Barbarous Pronunciation, and conſider for facility, or thorow miſtake, many words are not ſounded after the beſt dialect. Such as […] Wun, one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bd494a2-fc2f-3c83-997d-4eafa08e43d7",
                                        "entry_id": "e63ba750-1fa2-31ab-be23-e76f7c64915d",
                                        "glosses": [
                                            "Precisely, used to provide emphasis."
                                        ],
                                        "tags": [
                                            "focus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f707da7-8f99-49c4-8ced-b39b01533d8f",
                                                "sense_id": "3bd494a2-fc2f-3c83-997d-4eafa08e43d7",
                                                "text": "He did it that way exactly to prove the point."
                                            },
                                            {
                                                "example_id": "d767fe21-8c4e-44f2-a10f-bc0e1d522c03",
                                                "sense_id": "3bd494a2-fc2f-3c83-997d-4eafa08e43d7",
                                                "text": "His hair is a semilong dull red and pulled back in a sloppy pony at the base of his neck, and his face is riddled with small freckles and grease, but out here I can see personal hygiene isn't exactly at the top of the priority list."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exactly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e72e46a5-9266-3dbb-8770-3088be7bba45",
                                        "entry_id": "36c50201-c169-3c2e-9bd0-4af6bcc43a9b",
                                        "glosses": [
                                            "Signifies agreement or recognition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
