                "senses": [
                    {
                        "sense_id": "8133d7ef-7674-3baa-962b-293badc49a53",
                        "entry_id": "135d9661-659d-3402-a2a8-c9b5d7c3876a",
                        "glosses": [
                            "Evakuiertes, meistens zylindrisches Gefäß aus Glas, Metall oder Keramik, in dem neben einer Elektronenquelle weitere Elektroden zur Steuerung des Elektronenflusses im Vakuum angebracht sind."
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "14d4e1a9-3176-4e75-a033-705afef429b7",
                                "sense_id": "8133d7ef-7674-3baa-962b-293badc49a53",
                                "text": "„Elektronenröhren waren bis zur Einführung des Transistors die einzigen schnellen aktiven (steuerbaren) Bauelemente der Elektronik.“"
                            },
                            {
                                "example_id": "a16a3943-1440-43b9-8cd8-e79d589de2e7",
                                "sense_id": "8133d7ef-7674-3baa-962b-293badc49a53",
                                "text": "„Die Elektronenröhre C3m ist eine sehr rauscharme Pentode für Frequenzen bis wenige Megahertz mit einer beeindruckend linearen Kennlinie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
