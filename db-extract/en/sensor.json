                "senses": [
                    {
                        "sense_id": "0b341fc4-78ab-343b-8781-14c1199a4239",
                        "entry_id": "5cc1e4d1-b4a3-3d10-9529-4c5970dfc653",
                        "glosses": [
                            "A device or organ that detects certain external stimuli and responds in a distinctive manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80691fb5-108c-4112-b236-e5cd4376e6d0",
                                "sense_id": "0b341fc4-78ab-343b-8781-14c1199a4239",
                                "text": "The smoke sensor triggered the alarm."
                            },
                            {
                                "example_id": "1e888e6e-4ae3-48e3-a9e5-bac6bb7e0134",
                                "sense_id": "0b341fc4-78ab-343b-8781-14c1199a4239",
                                "text": "Modern phones contain a light sensor that adjusts brightness."
                            },
                            {
                                "example_id": "dc9e4065-de49-4dde-9e46-b23e6f2baae0",
                                "sense_id": "0b341fc4-78ab-343b-8781-14c1199a4239",
                                "text": "A motion sensor detected movement in the empty room."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bffe14f6-9fd8-4384-8d4b-6954ad8131a3",
                        "source_entry_id": "5cc1e4d1-b4a3-3d10-9529-4c5970dfc653",
                        "source_sense_id": "0b341fc4-78ab-343b-8781-14c1199a4239",
                        "source_sense_description": "device or organ that detects certain external stimuli",
                        "target_lang_word": "détecteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détecteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1bcb7e8-0523-3534-a889-c3d464e0e7cd",
                                        "entry_id": "87f8b982-df6d-331b-b479-c74ad2ae2e99",
                                        "glosses": [
                                            "Dispositif destiné à détecter quelque chose de difficilement perceptible ou caché ; capteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "190713b7-17e3-4e24-b99e-65f7ab42cd8d",
                                                "sense_id": "d1bcb7e8-0523-3534-a889-c3d464e0e7cd",
                                                "text": "Détecteur à transfert de charges (anglais charge-coupled device, CCD), technologie de capteur photographique fonctionnant par effet photoélectrique sur un substrat semi-conducteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3e78c73-d9e0-37d0-a8d0-783d7a73ea6a",
                                        "entry_id": "87f8b982-df6d-331b-b479-c74ad2ae2e99",
                                        "glosses": [
                                            "Dispositif effectuant une transformation non linéaire d'un signal électromagnétique en vue d’extraire une information portée par ce signal."
                                        ],
                                        "tags": [
                                            "Radiocommunications"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2074dcce-6f3a-4701-8557-3494f6420ae2",
                                                "sense_id": "d3e78c73-d9e0-37d0-a8d0-783d7a73ea6a",
                                                "text": "Les récepteurs récents utilisent le discriminateur à coïncidence aussi appelé détecteur à quadrature ou détecteur synchrone."
                                            },
                                            {
                                                "example_id": "52e99d20-e1f9-42dd-95a8-2f68bda05cab",
                                                "sense_id": "d3e78c73-d9e0-37d0-a8d0-783d7a73ea6a",
                                                "text": "Le détecteur à cristal est une diode, fonctionne en valve. Le rôle du détecteur est de servir de clapet anti-retour électrique au courant électrique alternatif de haute fréquence en supprimant l'une des alternances reçues […]."
                                            },
                                            {
                                                "example_id": "a24bc722-1273-421e-bb3d-e16dc17691ad",
                                                "sense_id": "d3e78c73-d9e0-37d0-a8d0-783d7a73ea6a",
                                                "text": "Détecteur hétérodyne, détecteur qui transforme une entrée de haute fréquence en signal de basse fréquence par couplage non linéaire avec un oscillateur local à basse fréquence."
                                            },
                                            {
                                                "example_id": "f6ecb414-9fa0-4cf5-abbb-9c6f5202296e",
                                                "sense_id": "d3e78c73-d9e0-37d0-a8d0-783d7a73ea6a",
                                                "text": "Détecteur homodyne, détecteur qui utilise un oscillateur local à la même fréquence que le signal d'entrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1d43543-b242-3887-82a5-d588ba1ad585",
                                        "entry_id": "87f8b982-df6d-331b-b479-c74ad2ae2e99",
                                        "glosses": [
                                            "Personnel disposant d’un brevet d’aptitude à utiliser un détecteur radar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "détecteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "223c593d-38b9-3002-9556-6198144fa2eb",
                                        "entry_id": "7018f154-837a-3c50-a6df-b10714fa4d5a",
                                        "glosses": [
                                            "Qui permet de détecter, qui sert de détecteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfe77f39-d396-424d-ae6b-ce7d8791d1d1",
                                                "sense_id": "223c593d-38b9-3002-9556-6198144fa2eb",
                                                "text": "Cellule détectrice = cellule mesurant le flux lumineux provenant d’un objet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7ee3311-dac9-4c3b-a85d-6df77d6553c0",
                        "source_entry_id": "5cc1e4d1-b4a3-3d10-9529-4c5970dfc653",
                        "source_sense_id": "0b341fc4-78ab-343b-8781-14c1199a4239",
                        "source_sense_description": "device or organ that detects certain external stimuli",
                        "target_lang_word": "capteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "df02d183-33f6-3c3f-a69f-7b31c0747e83",
                                        "entry_id": "4912144e-d0d2-3194-ba6f-93cfb6e3cbc0",
                                        "glosses": [
                                            "Qui capte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b07f141-68d4-4cea-947b-e750879b453c",
                                                "sense_id": "df02d183-33f6-3c3f-a69f-7b31c0747e83",
                                                "text": "Avec une bonté indulgente, capteuse, perspicace, avec une adresse presque maternelle qui force l’expansion cordiale, appelle les confidences, le Père de Marel l’interrogeait, et Sébastien s’abandonnait à l’impérieuse joie de lui répondre, au soulageant besoin d’ouvrir ce cœur, trop violenté, trop solitaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "capteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ffa0067b-f903-3c37-a9cd-a1ebaf12931a",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Celui qui capte, qui capture, qui fait une prise."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f88be0-a87c-41b7-95af-452c4fbc49db",
                                                "sense_id": "ffa0067b-f903-3c37-a9cd-a1ebaf12931a",
                                                "text": "Butin et prisonniers étaient emmenés vers les contrées d’où l’expédition était partie, parce qu'ils ne pouvaient être partagés entre les capteurs et l’État qu’en terre musulmane."
                                            },
                                            {
                                                "example_id": "489fe7e1-2916-418a-8a52-0c56d49147eb",
                                                "sense_id": "ffa0067b-f903-3c37-a9cd-a1ebaf12931a",
                                                "text": "Un vaisseau capteur ou, substantivement, un capteur, bâtiment qui a fait une prise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a05f713b-527d-3e0e-927b-de3779a3f3cb",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Appareil destiné à capter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53025799-a9de-4412-b183-253750c0272e",
                                                "sense_id": "a05f713b-527d-3e0e-927b-de3779a3f3cb",
                                                "text": "Capteur solaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19a55ea0-75a7-324a-bfe3-7934ff1c41cb",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Dispositif détectant une donnée physique de son environnement pour la transformer en signal émis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "217409de-605b-47fe-b043-432a1ab6c9ba",
                                                "sense_id": "19a55ea0-75a7-324a-bfe3-7934ff1c41cb",
                                                "text": "Cela est rendu réalisable par l’extension massive de capteurs sur toutes les surfaces possibles, du corps aux objets domestiques, conduisant à un traçage intégral de la vie."
                                            },
                                            {
                                                "example_id": "553a1834-172d-42b1-90a2-f38e02123743",
                                                "sense_id": "19a55ea0-75a7-324a-bfe3-7934ff1c41cb",
                                                "text": "Fort, également, de ses trois capteurs photo (50 mpx, 8 mpx ultra grand-angle et 2 mégapixels macro), le smartphone de Motorola, qui ne pèse que 184 g, est, par ailleurs, lesté d’un processeur à huit cœurs (Snapdragon 680, aussi présent sur les Oppo A96 et Realme 9I)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c432756-8481-37dc-b203-4368de572d08",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Instrument qui recueille de l’énergie radiative provenant de la scène visée et délivre un signal électrique correspondant et mesurable."
                                        ],
                                        "tags": [
                                            "Télédétection spatiale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4567f685-ab95-4d6a-83a6-fe400a8879eb",
                                                "sense_id": "1c432756-8481-37dc-b203-4368de572d08",
                                                "text": "La caméra utilisée est une Camelia 8M (ATMEL). Il s'agit d'une caméra haute résolution disposant d'un capteur de 2300x3500 pixels carrés de 10 µm de côté."
                                            },
                                            {
                                                "example_id": "c557f88d-0c9d-437f-af8b-90c0967fb697",
                                                "sense_id": "1c432756-8481-37dc-b203-4368de572d08",
                                                "text": "À cause de la diffraction, on ne peut pas diaphragmer notablement un objectif formant ses images sur un petit capteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f4b2aec-69a7-3aba-a21b-310227e5926c",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Piège chimique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9433e4c8-72ad-3c1e-bf02-38f76a3ed4e7",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Capteur analytique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5fd080b-3da5-316d-8bd9-4148ae73f154",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Accessoire électronique fixé sur un instrument de percussion, qui permet de convertir le son produit par cet instrument en le numérisant, et ainsi de le transformer ou de l’enrichir selon un programme prédéterminé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f76a62d-2e9c-3a43-825f-5399dfaca282",
                                        "entry_id": "72a564f4-d01c-35ef-a6aa-cd8fc6508327",
                                        "glosses": [
                                            "Celui qui capturait les esclaves en fuite."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6099186-0aa9-40cb-9266-68868c50934d",
                                                "sense_id": "7f76a62d-2e9c-3a43-825f-5399dfaca282",
                                                "text": "Ainsi, les marrons, et les capteurs envoyés à leur poursuite, furent-ils les premiers explorateurs de l’intérieur de l'île de La Réunion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
