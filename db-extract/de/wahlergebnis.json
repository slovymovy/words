                "senses": [
                    {
                        "sense_id": "6ed40055-ef8c-3f56-9676-f208e943ab00",
                        "entry_id": "f9b92736-32b4-302e-9358-07d5d34ca7cf",
                        "glosses": [
                            "Ergebnis, das durch eine Wahl zustande gekommen ist und nach der Wahl veröffentlicht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61246ca3-9da3-46e9-bcc3-f1bf24787db3",
                                "sense_id": "6ed40055-ef8c-3f56-9676-f208e943ab00",
                                "text": "Das Wahlergebnis hat ein für alle Beteiligten schwieriges Resultat erbracht."
                            },
                            {
                                "example_id": "f7290e3f-0174-4f6f-b2fa-8fa4f9f2f8c3",
                                "sense_id": "6ed40055-ef8c-3f56-9676-f208e943ab00",
                                "text": "„Wahlergebnisse, die an sowjetische Zeiten erinnern, kennt man inzwischen aus vielen Ländern Afrikas.“"
                            },
                            {
                                "example_id": "181104b0-6bc2-4036-889b-292f8bbe4433",
                                "sense_id": "6ed40055-ef8c-3f56-9676-f208e943ab00",
                                "text": "„Das Wahlergebnis schockierte die Armenier.“"
                            },
                            {
                                "example_id": "da3fd6f0-2364-417b-8f8f-53121e6f2960",
                                "sense_id": "6ed40055-ef8c-3f56-9676-f208e943ab00",
                                "text": "„Am Nachmittag flogen Churchill, Eden und Attlee nach London, wo am nächsten Tag das Wahlergebnis verkündet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
