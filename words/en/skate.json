{
    "word_family": [
        "skater",
        "skating",
        "skateboard",
        "skateboarder"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b021c344-a2ed-3502-952f-5e59f6e4c449",
                    "sense_definition": "A boot or shoe fitted with a metal blade or wheels, used for gliding on ice or rolling on a hard surface.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tied the laces of her <w>skates</w> tightly before stepping onto the ice.",
                            "target_lang_translations": {
                                "ru": "Она туго завязала шнурки своих <w>коньков</w>, прежде чем выйти на лед.",
                                "zh": "她上冰前把<w>冰鞋</w>的鞋带系紧了。"
                            }
                        },
                        {
                            "text": "He needs to buy a new pair of roller <w>skates</w> because his old ones are broken.",
                            "target_lang_translations": {
                                "ru": "Ему нужно купить новую пару роликовых <w>коньков</w>, потому что его старые сломались.",
                                "zh": "他得买双新的<w>轮滑鞋</w>，因为旧的那双坏了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ice skate",
                        "roller skate"
                    ],
                    "common_phrases": [
                        "pair of skates",
                        "put on skates"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ботинок, оснащенный металлическим лезвием или колесами, используемый для скольжения по льду или катания по твердой поверхности.",
                        "zh": "装有金属刀片或轮子的鞋，用于在冰上滑行或在坚硬地面上滚动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коньки",
                                "target_lang_sense_clarification": "спортивный инвентарь (мн. ч.)"
                            },
                            {
                                "target_lang_word": "конёк",
                                "target_lang_sense_clarification": "спортивный инвентарь (ед. ч.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冰鞋",
                                "target_lang_sense_clarification": "用于滑冰的鞋"
                            },
                            {
                                "target_lang_word": "轮滑鞋",
                                "target_lang_sense_clarification": "用于滑旱冰的鞋"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a4e8cc9-6f20-3ba7-b555-b758dfaafd79",
                    "sense_definition": "A session or instance of moving on ice skates, roller skates, or a skateboard.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went for a quick <w>skate</w> around the park before dinner.",
                            "target_lang_translations": {
                                "ru": "Мы пошли немного <w>покататься</w> по парку перед ужином.",
                                "zh": "晚饭前我们去公园里<滑冰>了一会儿。"
                            }
                        },
                        {
                            "text": "The frozen lake is perfect for a morning <w>skate</w> with friends.",
                            "target_lang_translations": {
                                "ru": "Замерзшее озеро идеально подходит для утреннего <w>катания</w> с друзьями.",
                                "zh": "结冰的湖面非常适合和朋友们早起去<w>滑冰</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go for a skate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сеанс или процесс катания на коньках, роликах или скейтборде.",
                        "zh": "滑冰、滑旱冰或滑滑板的活动或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "катание",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "катание на коньках",
                                "target_lang_sense_clarification": "вид активности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑冰",
                                "target_lang_sense_clarification": "滑冰活动"
                            },
                            {
                                "target_lang_word": "溜冰",
                                "target_lang_sense_clarification": "滑冰活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "705dee48-53ca-3ca8-b453-a93733af3cd9",
                    "sense_definition": "A flat sea fish with a skeleton made of cartilage and wide fins, related to the ray, often used as food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a delicious dish of grilled <w>skate</w> with capers and butter.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил вкусное блюдо из жареного <w>ската</w> с каперсами и маслом.",
                                "zh": "厨师做了一道美味的黄油酸豆煎<w>鳐鱼</w>。"
                            }
                        },
                        {
                            "text": "Divers often see a <w>skate</w> resting on the sandy ocean floor.",
                            "target_lang_translations": {
                                "ru": "Дайверы часто видят <w>ската</w>, отдыхающего на песчаном дне океана.",
                                "zh": "潜水员经常能看到<w>鳐鱼</w>在沙质的海底休息。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская морская рыба с хрящевым скелетом и широкими плавниками, родственная скатам.",
                        "zh": "一种扁平的海洋鱼类，骨骼由软骨组成，有宽大的鳍，与鳐鱼亲缘关系密切，常被食用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скат",
                                "target_lang_sense_clarification": "рыба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鳐鱼",
                                "target_lang_sense_clarification": "软骨鱼类"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3fc94721-34c8-394d-81c5-a0339f6d0c0b",
                    "sense_definition": "To move or glide along a surface wearing ice skates, roller skates, or using a skateboard.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children love to <w>skate</w> on the frozen pond in winter.",
                            "target_lang_translations": {
                                "ru": "Дети любят <w>кататься на коньках</w> на замерзшем пруду зимой.",
                                "zh": "孩子们冬天喜欢在结冰的池塘上<w>滑冰</w>。"
                            }
                        },
                        {
                            "text": "He learned to <w>skate</w> backwards after weeks of practice.",
                            "target_lang_translations": {
                                "ru": "Он научился <w>кататься</w> задом наперед после недель тренировок.",
                                "zh": "经过几周的练习，他学会了倒着<w>滑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ice skate",
                        "roller skate",
                        "skateboard",
                        "glide"
                    ],
                    "common_phrases": [
                        "skate on thin ice",
                        "learn to skate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Передвигаться или скользить по поверхности на коньках, роликах или скейтборде.",
                        "zh": "穿着冰鞋、轮滑鞋或使用滑板在表面上移动或滑行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кататься на коньках",
                                "target_lang_sense_clarification": "действие (лед)"
                            },
                            {
                                "target_lang_word": "кататься",
                                "target_lang_sense_clarification": "общее действие"
                            },
                            {
                                "target_lang_word": "скользить",
                                "target_lang_sense_clarification": "двигаться плавно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑冰",
                                "target_lang_sense_clarification": "在冰上移动"
                            },
                            {
                                "target_lang_word": "滑旱冰",
                                "target_lang_sense_clarification": "在地面上移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f26c092a-e4cf-3cc6-8469-d01bd494e76b",
                    "sense_definition": "To avoid punishment, consequences, or hard work; to get through a situation easily.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>skate</w> through the difficult course with minimal effort.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>проскочить</w> сложный курс с минимальными усилиями.",
                                "zh": "他没费什么力气就<w>蒙混过关</w>完成了那门难课。"
                            }
                        },
                        {
                            "text": "The suspect thought he would <w>skate</w> on the charges due to a lack of evidence.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый думал, что ему удастся <w>легко отделаться</w> от обвинений из-за недостатка улик.",
                                "zh": "嫌疑人以为由于证据不足，他能<w>侥幸逃脱</w>指控。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coast"
                    ],
                    "common_phrases": [
                        "skate by",
                        "skate through"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Избежать наказания, последствий или тяжелой работы; легко справиться с ситуацией.",
                        "zh": "逃避惩罚、后果或繁重的工作；轻松地度过某种局面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проскочить",
                                "target_lang_sense_clarification": "разг. легко преодолеть"
                            },
                            {
                                "target_lang_word": "легко отделаться",
                                "target_lang_sense_clarification": "избежать последствий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蒙混过关",
                                "target_lang_sense_clarification": "轻松逃避责任"
                            },
                            {
                                "target_lang_word": "侥幸逃脱",
                                "target_lang_sense_clarification": "幸运地避开后果"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}