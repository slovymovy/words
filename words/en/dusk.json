{
    "word_family": [
        "dusky",
        "duskiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "566087bc-a565-3cac-b41b-092ae01b8a44",
                    "sense_definition": "The time after the sun has set but when the sky is still lit by sunlight; the evening twilight period.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_of_day",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The park is beautiful at <w>dusk</w> when the streetlights begin to glow.",
                            "target_lang_translations": {
                                "cs": "Park je krásný za <w>soumraku</w>, když se začínají rozsvěcet pouliční lampy."
                            }
                        },
                        {
                            "text": "They finished their long hike just as <w>dusk</w> arrived.",
                            "target_lang_translations": {
                                "cs": "Svou dlouhou túru dokončili právě ve chvíli, kdy nastal <w>soumrak</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sunset",
                        "sundown",
                        "nightfall"
                    ],
                    "antonyms": [
                        "dawn",
                        "daybreak"
                    ],
                    "common_phrases": [
                        "at dusk"
                    ],
                    "target_lang_definitions": {
                        "cs": "Čas po západu slunce, kdy je obloha stále osvětlena slunečním světlem; období večerního šera."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "soumrak",
                                "target_lang_sense_clarification": "obecné označení pro dobu mezi dnem a nocí"
                            },
                            {
                                "target_lang_word": "šero",
                                "target_lang_sense_clarification": "stav sníženého osvětlení v podvečer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed26643f-6eca-3734-91c3-6c2c5a50d9e6",
                    "sense_definition": "A darkish colour.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist used a soft <w>dusk</w> to paint the shadows on the wall.",
                            "target_lang_translations": {
                                "cs": "Umělec použil jemný <w>tmavý odstín</w> k vykreslení stínů na zdi."
                            }
                        },
                        {
                            "text": "Her dress had a subtle <w>dusk</w> that looked elegant in the evening light.",
                            "target_lang_translations": {
                                "cs": "Její šaty měly jemný <w>tmavý nádech</w>, který ve večerním světle vypadal elegantně."
                            }
                        }
                    ],
                    "synonyms": [
                        "dark"
                    ],
                    "target_lang_definitions": {
                        "cs": "Tmavší odstín barvy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "tmavý odstín",
                                "target_lang_sense_clarification": "popis barvy s nízkou světlostí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cb7ec55-d83f-37ec-9518-e7ca74695c33",
                    "sense_definition": "The condition of being dusky; duskiness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dusk</w> of the room made it difficult to read the small print.",
                            "target_lang_translations": {
                                "cs": "<w>Šero</w> v místnosti ztěžovalo čtení drobného písma."
                            }
                        },
                        {
                            "text": "He felt a sense of peace in the <w>dusk</w> of the forest.",
                            "target_lang_translations": {
                                "cs": "Cítil klid v <w>přítmí</w> lesa."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Stav, kdy je někde šero nebo tma."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šero",
                                "target_lang_sense_clarification": "nedostatek světla v prostoru"
                            },
                            {
                                "target_lang_word": "přítmí",
                                "target_lang_sense_clarification": "tlumené světlo v místnosti nebo lese"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fffba67c-8f2c-39dd-b8df-bc8e56127825",
                    "sense_definition": "Tending to darkness or blackness; moderately dark or black.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dusk</w> sky signaled that a storm was approaching the valley.",
                            "target_lang_translations": {
                                "cs": "<w>Temná</w> obloha signalizovala, že se k údolí blíží bouře."
                            }
                        },
                        {
                            "text": "They walked through the <w>dusk</w> woods as the light faded away.",
                            "target_lang_translations": {
                                "cs": "Kráčeli <w>šeřícím se</w> lesem, zatímco světlo pomalu mizelo."
                            }
                        }
                    ],
                    "synonyms": [
                        "dark"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající sklon k temnotě; mírně tmavý."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "temný",
                                "target_lang_sense_clarification": "mající málo světla"
                            },
                            {
                                "target_lang_word": "šeřící se",
                                "target_lang_sense_clarification": "stávající se tmavým"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "617c3093-053f-37d7-ab19-323bda66607b",
                    "sense_definition": "To begin to lose light or whiteness; to grow dark.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "time_of_day",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The valley began to <w>dusk</w> as the sun slipped behind the mountains.",
                            "target_lang_translations": {
                                "cs": "Údolí se začalo <w>stmívat</w>, jakmile slunce zapadlo za hory."
                            }
                        },
                        {
                            "text": "We watched the horizon <w>dusk</w> while sitting on the porch.",
                            "target_lang_translations": {
                                "cs": "Seděli jsme na verandě a pozorovali, jak se obzor <w>stmívá</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Začít ztrácet světlo; stmívat se."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "stmívat se",
                                "target_lang_sense_clarification": "proces přechodu do tmy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08d5c0ec-e0dc-3fed-bdfc-bc7b9171dd69",
                    "sense_definition": "To make dark.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy clouds seemed to <w>dusk</w> the entire landscape in an instant.",
                            "target_lang_translations": {
                                "cs": "Těžké mraky jako by v mžiku <w>zatemnily</w> celou krajinu."
                            }
                        },
                        {
                            "text": "The thick curtains <w>dusk</w> the room even during the brightest part of the day.",
                            "target_lang_translations": {
                                "cs": "Tlusté závěsy <w>zatemňují</w> pokoj i během té nejsvětlejší části dne."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Učinit něco tmavým."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zatemnit",
                                "target_lang_sense_clarification": "způsobit tmu v prostoru"
                            },
                            {
                                "target_lang_word": "ztmavit",
                                "target_lang_sense_clarification": "ubrat světlo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}