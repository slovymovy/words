                                                "example_id": "4c791030-f2a5-4c4d-973d-9b32312ca002",
                                                "sense_id": "9c32bd71-4839-3bae-8a3d-e6b5946af736",
                                                "text": "„Nader Schah, einem Mohammadzai aus einer Nebenlinie der Herrscherfamilie, gelang es, paschtunische Stämme gegen ihn aufzuwiegeln und ihn nach neunmonatiger Regierung zu entmachten.“"
                                            }
                                        ],
