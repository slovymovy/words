                "senses": [
                    {
                        "sense_id": "80c851df-fa71-3bdb-a60a-c8c76dc590f1",
                        "entry_id": "0166b376-167c-310b-9334-5c8cb2b6528e",
                        "glosses": [
                            "Retirer (en totalité ou en partie) la syntaxe wiki au sein d’un article, c’est-à-dire les mots en gras encadrés de trois apostrophes, les mots en italiques de deux, les liens internes de deux crochets, etc."
                        ],
                        "tags": [
                            "Wikis"
                        ],
                        "examples": [
                            {
                                "example_id": "6af9349a-5677-4bfa-b840-81766faa8c84",
                                "sense_id": "80c851df-fa71-3bdb-a60a-c8c76dc590f1",
                                "text": "Si je déwikifie ce texte, alors ce texte sera déwikifié…"
                            }
                        ]
                    },
                    {
                        "sense_id": "2d54fb7a-bbf1-3ada-a5ab-471a1270dfb9",
                        "entry_id": "0166b376-167c-310b-9334-5c8cb2b6528e",
                        "glosses": [
                            "Remettre la syntaxe HTML au lieu de la syntaxe wiki, par exemple dans un tableau."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
