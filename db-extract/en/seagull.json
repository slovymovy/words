        "de-extract.jsonl": [
            {
                "entry_id": "7b9d7444-7214-3152-bf27-cadde845d190",
                "word": "seagull",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c22f1dc-fbf0-35ee-a821-5b7bacb3cbf1",
                        "entry_id": "7b9d7444-7214-3152-bf27-cadde845d190",
                        "glosses": [
                            "am Meer gesellig lebender mittelgroßer bis großer schwimmfähiger, vorwiegend leuchtend weiß oder silbergrau gefiederter Seevogel (Larinae) mit relativ langen, schmalen und spitzen Flügeln, die ihm ein ausgezeichnetes Flugvermögen verleihen, mit einem kräftigen, schlanken, scharfen Schnabel und mit Schwimmhäuten an den Füßen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b1161a75-ce0e-4b49-aab4-8a8dff04283d",
                                "sense_id": "1c22f1dc-fbf0-35ee-a821-5b7bacb3cbf1",
                                "text": "“But the sea roared in their ears it was true sea, look it was breaking white on the sand and the seagulls crying and skimming and the bits of white flying and look at all of the coloured shells, look a little pink one like a fan, and a cat’s eye.”",
                                "translation": "„Aber das Meer rauschte ihnen in den Ohren, es war richtiges Meer, schau, es brandete weiß an den Strand, und die Seemöwen schrien und jagten vorüber, und die weißen Flocken flogen, und sieh nur, all die farbigen Muscheln, da, eine kleine, rosa wie ein Fächer, und ein Katzenauge.“"
                            },
                            {
                                "example_id": "cfa8fd1a-1dfa-4702-93c5-505808e3b3e7",
                                "sense_id": "1c22f1dc-fbf0-35ee-a821-5b7bacb3cbf1",
                                "text": "“They had tattered the silence with their shouts to one another and under these cries like the cries of the absent seagulls they did not hear a distant approach of sound rising as a great wind does.”",
                                "translation": "„Sie hatten die Stille mit ihren hin und her fliegenden Rufen zerrissen, und unter ihrem Geschrei, das wie das Geschrei der abwesenden Möwen war, hörten sie nicht, dass aus der Ferne ein Geräusch näher kam und anschwoll wie ein großer Wind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4c0e762-31e8-497e-b575-79c0a6bdfad8",
                        "source_entry_id": "7b9d7444-7214-3152-bf27-cadde845d190",
                        "source_sense_id": "1c22f1dc-fbf0-35ee-a821-5b7bacb3cbf1",
                        "source_sense_description": "leuchtend weiß oder silbergrau gefiederter Seevogel (Larinae)",
                        "target_lang_word": "Möwe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Möwe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                        "entry_id": "4696fa4e-7053-381b-bde3-7182a97636d1",
                                        "glosses": [
                                            "(am Meer und an Binnengewässern gesellig lebender) mittelgroßer bis großer schwimmfähiger, vorwiegend leuchtend weiß oder silbergrau gefiederter Seevogel (Larinae) mit relativ langen, schmalen und spitzen Flügeln, die ihm ein ausgezeichnetes Flugvermögen verleihen, mit einem kräftigen, schlanken, scharfen Schnabel und mit Schwimmhäuten an den Füßen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d833a79f-09d9-4869-b4ec-4f673ffa121d",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "Er beobachtet die Möwen im Hafen."
                                            },
                                            {
                                                "example_id": "5e5fd6dc-f262-413e-a3d6-3dac58d83cfd",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Aber die Statue iſt verwittert und verſtuͤmmelt, das Waſſer ausgetrocknet, und die Moͤven niſten in den ſchwarzen Zypreſſen.“"
                                            },
                                            {
                                                "example_id": "af2f90ac-34fd-4001-85d2-f3a755301dcb",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Alles blühte hier, Schmetterlinge flogen über die Gräber hin, und hoch in den Lüften ſtanden ein paar Möven.“"
                                            },
                                            {
                                                "example_id": "91e13820-92ee-45b4-b3d8-6e122efa7d28",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Es iſt jene Schwermut, die manchmal in der Nähe des Meeres herrſcht, an ſturmſtillen Tagen, wenn die Möwen nach Regen ſchreien.“"
                                            },
                                            {
                                                "example_id": "b4fdd0e9-05b9-462a-bb9f-cafb70a7d1bf",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Die Möwen strichen sehr niedrig und zischten über die Brücken hinweg.“"
                                            },
                                            {
                                                "example_id": "ccb7c3f6-d15e-4632-b97d-1a581b36117f",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Die weißen Möwen trieben im Strandwinde vorüber, er folgte ihnen mit leeren Blicken, aus denen jede Freude und jede Teilnahme verſchwunden war.“"
                                            },
                                            {
                                                "example_id": "71c8cbad-fa14-49c0-910b-ea492eefacfc",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Denn das fliessende Wasser, die Moewen, das Ein- und Ausladen auf den Schiffen, all das bewegt sich fuer sie, die ganz starr zusehen.“"
                                            },
                                            {
                                                "example_id": "9e8aa1c9-057d-48ee-ada3-8dc47636622d",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Gregor ging zwischen den Vögeln hindurch, zwischen den Gruppen der schlafenden Wildgänse und Wildenten und Möwen, zwischen Vögeln, die sich auf der Wanderschaft befanden, und Vögeln, die hier bleiben und sich in den Winterstürmen wiegen würden.“"
                                            },
                                            {
                                                "example_id": "57428d3d-7b67-4db5-be3b-901543e9d791",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Über den Türmen kreisten die Möwen, sie hockten sich auf die Bojen, die der Kot schon weiß gekalkt hatte.“"
                                            },
                                            {
                                                "example_id": "1959f6dc-68d0-49ef-b502-7f3129494f69",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Robert stand unausgeschlafen am Fenster und sah auf die leeren Straßen und auf die ruhelosen Möwen über der Spree, bis ihm ein Haus an der Luisenstraßenbrücke die Sicht versperrte.“"
                                            },
                                            {
                                                "example_id": "004f6e15-1717-4511-9808-28243c867c07",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Eine Möwe eröffnete den Angriff. […] Keine Möwe an unserer Küste gibt ihre Eier freiwillig heraus.“"
                                            },
                                            {
                                                "example_id": "32d4c8d2-8d2f-405c-b182-42ab8c1f32d9",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Kiebitze und Möwen waren ständig anzutreffen, aber auch Eisvögel und Mandelkrähen.“"
                                            },
                                            {
                                                "example_id": "10555de5-22ca-47e3-bc15-b354d3a674d7",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Eine Möwe beschrieb hoch in der Luft ihre Kreise.“"
                                            },
                                            {
                                                "example_id": "244fe916-1113-4f58-944f-208c0b67b626",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Der Regen hatte sich verzogen, Mittagslicht fiel durch die hohen Fenster, die Oberlichter standen offen, von draußen das Kreischen der Möwen, von ferne Gehämmer, die Werft.“"
                                            },
                                            {
                                                "example_id": "d433d7ab-3728-433c-b06c-31d9a767a87e",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Auf dem Meer ein ganzer Schwarm Möwen wie eine Eisscholle, von der Dünung angehoben.“"
                                            },
                                            {
                                                "example_id": "6705cc1b-78ec-468d-a950-ec72b7f1cbcd",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Mehrere grausilberne Möwen sind aufgeflogen, ein paar Enten, zwei Krähen kauern verloren am Rand.“"
                                            },
                                            {
                                                "example_id": "03af2c88-0674-45d7-81d6-6e39ddd268db",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Der Rhein lag silbern in mattem Mittagslicht, die Möwen schrien weit weg über einem Fischerkahn.“"
                                            },
                                            {
                                                "example_id": "ca76d069-f54a-45be-8e7a-65604ad76855",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Nun, an diesem ersten lauen und sonnigen Abend sehen wir Möwen, Kraniche, Reiher, Kormorane, Grau- und Ringelgänse.“"
                                            },
                                            {
                                                "example_id": "c1937bc5-2796-472d-8926-d528700a2e2a",
                                                "sense_id": "2a133b6e-5882-3dec-9a98-69c22d7147b6",
                                                "text": "„Im Sommer leuchten die flechtenbewachsenen Felswände orange, gelb und rostrot, und die Vogelklippen wimmeln von Möwen, Sturmtauchern und Sturmschwalben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c0b2b7f-8146-49e9-8c07-8ab1c725156f",
                        "source_entry_id": "7b9d7444-7214-3152-bf27-cadde845d190",
                        "source_sense_id": "1c22f1dc-fbf0-35ee-a821-5b7bacb3cbf1",
                        "source_sense_description": "leuchtend weiß oder silbergrau gefiederter Seevogel (Larinae)",
                        "target_lang_word": "Seemöwe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seemöwe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bce6d8d2-4fa0-3166-9e82-91fa336b8834",
                                        "entry_id": "fb56c65b-cee6-3c58-a4ab-9674e9f71d47",
                                        "glosses": [
                                            "am Meer gesellig lebender mittelgroßer bis großer schwimmfähiger, vorwiegend leuchtend weiß oder silbergrau gefiederter Seevogel (Larinae) mit relativ langen, schmalen und spitzen Flügeln, die ihm ein ausgezeichnetes Flugvermögen verleihen, mit einem kräftigen, schlanken, scharfen Schnabel und mit Schwimmhäuten an den Füßen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb718ece-ae6b-4438-a6c1-7c28a3413893",
                                                "sense_id": "bce6d8d2-4fa0-3166-9e82-91fa336b8834",
                                                "text": "«Wahrscheinlich wird eine Seemöwe vor dem Fenster kreischen, Helsinki liegt ja am Meer, Seemöwen sind die beutegierigsten Vögel der Welt, leider verhindert die Doppelverglasung der Fenster, daß du das beutegierige Gekreisch hören kannst, Eva, und diese rötlichen Raubvogelschnäbel wie Reißzähne, vermutlich allerdings wird es bereits Nacht sein, und ich bin nicht sicher, ob Seemöwen auch nachts kreischen.»"
                                            },
                                            {
                                                "example_id": "f503942c-8895-4bd2-9cdf-e86396d9efb6",
                                                "sense_id": "bce6d8d2-4fa0-3166-9e82-91fa336b8834",
                                                "text": "„Unter den Schwimmhäutlern sah Pencroff einige Labben aus der Familie der Seemöwen, auch Raubmöwen genannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
