                                        "glosses": [
                                            "mit der Absicht, sich einen unerlaubten Vorteil/Gewinn zu verschaffen, einen Betrug zu begehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e31cd39-1efe-4768-b67d-da2b351d72fc",
                                                "sense_id": "1bf3dfbd-2aed-3b50-b3d5-a2868f282e8c",
                                                "text": "Seine betrügerischen Machenschaften wurden dann im Zuge der Steuerüberprüfung aufgedeckt."
