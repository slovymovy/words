                    {
                        "sense_id": "82eb545b-9fe5-326d-bcaf-b12b34b957bb",
                        "entry_id": "784f1ce9-f334-3aa5-b612-0d74af080faa",
                        "glosses": [
                            "het verrichten van nachtelijke werkzaamheden volgens een diensrooster"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dfaaa247-7ec1-4880-afb4-0bc1f471c05a",
                                "sense_id": "82eb545b-9fe5-326d-bcaf-b12b34b957bb",
                                "text": "Het draaien van nachtdiensten heeft zo zijn voor- als nadelen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f22d2c50-518b-4ed3-84a7-40cc28b9638b",
                        "source_entry_id": "784f1ce9-f334-3aa5-b612-0d74af080faa",
                        "source_sense_id": "82eb545b-9fe5-326d-bcaf-b12b34b957bb",
                        "source_sense_description": "het verrichten van nachtelijke werkzaamheden volgens een diensrooster",
                        "target_lang_word": "Nachtdienst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtdienst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74f74719-2957-3e86-bfdd-0a216d66191c",
                                        "entry_id": "4db722e7-1d71-3e19-bcb1-e8b82e96c651",
                                        "glosses": [
                                            "Arbeit während der Nacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bc1d5fb-1e4d-437c-ac93-cad2a0b8ac45",
                                                "sense_id": "74f74719-2957-3e86-bfdd-0a216d66191c",
                                                "text": "„Gerhards Nachtdienst beinhaltet zweierlei Aufgaben.“"
                                            },
                                            {
                                                "example_id": "94696e48-fd25-4a93-9920-69114db2f5c6",
                                                "sense_id": "74f74719-2957-3e86-bfdd-0a216d66191c",
                                                "text": "„Er hatte seinen Nachtdienst hinter sich.“"
                                            },
                                            {
                                                "example_id": "47404791-6707-416b-8eba-5f48352e8277",
                                                "sense_id": "74f74719-2957-3e86-bfdd-0a216d66191c",
                                                "text": "„Er hatte an diesem Tage keinen Nachtdienst und begab sich auf den Heimweg.“"
                                            },
                                            {
                                                "example_id": "68a3c57a-ec35-41ac-9217-0b7f7add3dfe",
                                                "sense_id": "74f74719-2957-3e86-bfdd-0a216d66191c",
                                                "text": "„Auf meine Frage erwiderte sie kurz angebunden, Georg habe Nachtdienst in einer Mühle, sie selbst sei gerade erst aus der Zuckerfabrik gekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f285e7ab-f29a-4129-90c1-02bfcf72c84e",
                        "source_entry_id": "784f1ce9-f334-3aa5-b612-0d74af080faa",
                        "source_sense_id": "82eb545b-9fe5-326d-bcaf-b12b34b957bb",
                        "source_sense_description": "het verrichten van nachtelijke werkzaamheden volgens een diensrooster",
                        "target_lang_word": "Nachtschicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtschicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                        "entry_id": "9ddbeb4f-def0-38d9-9023-1edb6b91adfc",
                                        "glosses": [
                                            "Arbeitszeit, Dienst in der Nacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11e5f709-0fb1-4ae7-a2ca-f9d8058c67ff",
                                                "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                                "text": "„Im Hause der Ermordeten wohnten zwei Arbeiter aus der Zuckerfabrik, die Nachtschicht hatten und um zwei Uhr gehen mußten. Die beiden Männer machten sich ihre Laternen zurecht und gingen die Treppe hinunter.“"
                                            },
                                            {
                                                "example_id": "6a5dae9d-b7f4-416d-921d-673a61cf1977",
                                                "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                                "text": "Wie immer musste er einige Nachtschichten einlegen, damit er seine Seminararbeit rechtzeitig abgeben konnte."
                                            },
                                            {
                                                "example_id": "d9c713fa-f0ec-45f9-b8e2-ecbee28b4863",
                                                "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                                "text": "„Am frühen Morgen einer Nachtschicht wurden wir zur Unterstützung von Kollegen zu einem Streit zwischen etwa 30 Südländern angefordert.“"
                                            },
                                            {
                                                "example_id": "3b43d6a5-5b0d-4c0f-babe-b0e608d62fcd",
                                                "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                                "text": "„Dieser wünschte ihm mit mitleidsvollem Blick einen guten Schlaf, denn die Müdigkeit, die eine Nachtschicht mit sich brachte, war deutlich im Gesicht des Kollegen erkennbar.“"
                                            },
                                            {
                                                "example_id": "622e205a-4a32-4adb-b70f-193de9cbdcae",
                                                "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                                "text": "„Im Schmelzwerk verdiente ich viel mehr, als ich in einem Café oder einem Laden bekommen hätte, ich machte so viele Nachtschichten wie nur möglich, das gab richtig viel Geld.“"
                                            },
                                            {
                                                "example_id": "96fb699d-9572-4168-baa0-f800a491491b",
                                                "sense_id": "1abfecc9-693c-35a6-9bfb-7c72c9485daa",
                                                "text": "„Und Sævar war auf dem Heimweg von der Nachtschicht gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f638e0ee-8f0a-3bf1-bf38-8477bc979fb7",
                                        "entry_id": "9ddbeb4f-def0-38d9-9023-1edb6b91adfc",
                                        "glosses": [
                                            "die Gruppe der Arbeiter in einer Nachtschicht^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a44fa6-cfb2-4618-b628-ea661292a5ad",
                                                "sense_id": "f638e0ee-8f0a-3bf1-bf38-8477bc979fb7",
                                                "text": "Die Nachtschicht hat sich einstimmig für die Teilnahme am Warnstreik ausgesprochen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
