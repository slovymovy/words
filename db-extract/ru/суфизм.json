                    },
                    {
                        "translation_id": "86365adc-173e-43db-9fa2-730a87ad3c93",
                        "source_entry_id": "c13d02db-9533-3225-9b41-15ba0b9ba35c",
                        "source_sense_id": "4cc5f2d6-8f28-3b6a-8bfe-95239d75364c",
                        "target_lang_word": "sufismo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3d16113b-5ae0-478a-ad0c-dffe4bc8bf6e",
                        "source_entry_id": "c13d02db-9533-3225-9b41-15ba0b9ba35c",
                        "source_sense_id": "4cc5f2d6-8f28-3b6a-8bfe-95239d75364c",
                        "target_lang_word": "Sufismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sufismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bee6655a-f768-3a9f-ba23-a36ce999fdb8",
                                        "entry_id": "00574aa7-abb6-30d5-8c15-b4c1e5351c1c",
                                        "glosses": [
                                            "die Gesamtheit der mystischen Strömungen im Islam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3566215-2cc7-4834-bec7-6b945f16c68f",
                                                "sense_id": "bee6655a-f768-3a9f-ba23-a36ce999fdb8",
                                                "text": "„Ich war der einzige von ihnen, der vom Sufismus sprach und davon, dass der Mensch ein ewig Gottsuchender ist.“"
                                            },
                                            {
                                                "example_id": "f74c91f4-ec4d-4d69-ad49-18ceb0f1dbc7",
                                                "sense_id": "bee6655a-f768-3a9f-ba23-a36ce999fdb8",
                                                "text": "„Ich hatte bereits von Professor Effendi gelernt, dass wir uns im Grenzbereich zum Sudan auf der Schnittstelle des orientalischen und afrikanischen Sufismus bewegten.“"
                                            },
                                            {
                                                "example_id": "857ff039-8725-4a54-a237-dda5327bbc2f",
                                                "sense_id": "bee6655a-f768-3a9f-ba23-a36ce999fdb8",
                                                "text": "„Ihre einzige Hoffnung lag in der Vergangenheit, die der Großmogul symbolisierte: Als Angehöriger des Sufismus, einer mystischen Strömung des Islam, verkörperte er die Einheit der Nation.“"
                                            },
                                            {
                                                "example_id": "610a57cd-e34c-4257-b1ff-91c4e0200a6a",
                                                "sense_id": "bee6655a-f768-3a9f-ba23-a36ce999fdb8",
                                                "text": "„Darüber hinaus galt er als talentierter Kalligraph, er legte Gärten an, malte Miniaturen und philosophierte über den Sufismus.“"
                                            },
                                            {
                                                "example_id": "7196d003-c9c1-4a23-9cbf-4d1061adcdfd",
                                                "sense_id": "bee6655a-f768-3a9f-ba23-a36ce999fdb8",
                                                "text": "„Mystische Strömungen wie der Sufismus spielen in der pakistanischen Gesellschaft eine herausragende Rolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b47a964c-917e-4a73-a2c8-7a5d1106d1f1",
                        "source_entry_id": "c13d02db-9533-3225-9b41-15ba0b9ba35c",
                        "source_sense_id": "4cc5f2d6-8f28-3b6a-8bfe-95239d75364c",
                        "target_lang_word": "Sufitum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sufitum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66a74799-7353-3d6c-92cf-62d48f75f7ae",
                                        "entry_id": "3e1221d1-cb35-3c15-8436-a46e6dcfe877",
                                        "glosses": [
                                            "die Gesamtheit der mystischen Strömungen im Islam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7ce45b-29c7-4ebf-bd4e-cc000ed43589",
                                                "sense_id": "66a74799-7353-3d6c-92cf-62d48f75f7ae",
                                                "text": "„In dieser Epoche des politischen Niedergangs wandte er sich dem Sufitum zu als dem einzigen Weg der Erneuerung, für den Einzelnen und für die Gemeinschaft.“"
                                            },
                                            {
                                                "example_id": "93b855ac-f443-436b-a098-f6d629ce9f62",
                                                "sense_id": "66a74799-7353-3d6c-92cf-62d48f75f7ae",
                                                "text": "„Eine wesentliche Besonderheit von Husseins Lehrtätigkeit liegt im Versuch der Zusammenführung von Sufitum und westlicher Psychologie.“"
                                            },
                                            {
                                                "example_id": "fe86f6aa-02d3-4a4a-b13d-5993d9d1ea37",
                                                "sense_id": "66a74799-7353-3d6c-92cf-62d48f75f7ae",
                                                "text": "„Im 14. Jh. hatten führende Gelehrte wie Ibn Khaldun das Sufitum als integralen Bestandteil des religiösen Wissens anerkannt.“"
                                            },
                                            {
                                                "example_id": "861dae4a-8663-4a57-afde-893493b9ffe9",
                                                "sense_id": "66a74799-7353-3d6c-92cf-62d48f75f7ae",
                                                "text": "„Bis heute gilt der Sindh mit seinen Schreinen, die jährlich Hunderttausende Pilger anziehen, als das Zentrum des Sufitums in Pakistan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "269869a2-7626-45ac-befd-f36003a7025d",
                        "source_entry_id": "c13d02db-9533-3225-9b41-15ba0b9ba35c",
