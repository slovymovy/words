                "senses": [
                    {
                        "sense_id": "54f629fe-5100-3478-8bbe-83db76ca98f4",
                        "entry_id": "73da84ce-d41c-317a-88cf-e2e934b2ed49",
                        "glosses": [
                            "Fiente du pigeon et, par extension, des volailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ed73c51-c8a1-4abf-b855-ed8645361ae9",
                                "sense_id": "54f629fe-5100-3478-8bbe-83db76ca98f4",
                                "text": "On estime à une centaine de francs la valeur de la colombine produite dans un colombier de 700 à 800 pigeons . On peut admettre qu'un pigeon moyen produit dans le cours de l'année de 8 à 10 litres de cet engrais."
                            },
                            {
                                "example_id": "68797d48-642f-45e6-bbaa-7bebfaf69372",
                                "sense_id": "54f629fe-5100-3478-8bbe-83db76ca98f4",
                                "text": "Les colombines ou résidus de poulailler sont des engrais de premier ordre."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c6759d4-6241-3f21-8be3-6bb06479ff3e",
                        "entry_id": "73da84ce-d41c-317a-88cf-e2e934b2ed49",
                        "glosses": [
                            "Ancolie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b75fb56-aea0-474e-af66-33781fb1373c",
                                "sense_id": "2c6759d4-6241-3f21-8be3-6bb06479ff3e",
                                "text": "L'ancolie est aussi appelée gant de bergère, gant de Notre-Dame, cornette, aiglantine, colombine ou encore tourette."
                            }
                        ]
                    }
