                "senses": [
                    {
                        "sense_id": "0f1b8720-0dee-3571-96cb-9c40cd5c1a28",
                        "entry_id": "726ea7f7-246e-31c6-9634-19b67be25612",
                        "glosses": [
                            "umieranie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eae5aacc-b48c-428e-8ef9-fb4078e6770c",
                                "sense_id": "0f1b8720-0dee-3571-96cb-9c40cd5c1a28",
                                "text": "Deszcz jak siwe łodygi, szary szum, • a u okien smutek i konanie"
                            },
                            {
                                "example_id": "252144d0-c411-4ca7-ac3e-bb99d02f3989",
                                "sense_id": "0f1b8720-0dee-3571-96cb-9c40cd5c1a28",
                                "text": "Nosimy nieustannie w ciele naszym konanie Jezusa, aby życie Jezusa objawiło się w naszym ciele"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fde520e8-d0be-42e1-9491-fc691ce16639",
                        "source_entry_id": "726ea7f7-246e-31c6-9634-19b67be25612",
                        "source_sense_id": "0f1b8720-0dee-3571-96cb-9c40cd5c1a28",
                        "target_lang_word": "death",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "death",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "330966d8-bcaa-3307-9a6a-f4f07bae4692",
                                        "entry_id": "3e655c0f-06f4-3a06-9c83-51cca53e153e",
                                        "glosses": [
                                            "The cessation of life and all associated processes; the end of an organism's existence as an entity independent from its environment and its return to an inert, nonliving state."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab010a42-dc05-417b-9441-6f7ac772bf08",
                                                "sense_id": "330966d8-bcaa-3307-9a6a-f4f07bae4692",
                                                "text": "My grandfather died a violent death, which saddened the whole family."
                                            },
                                            {
                                                "example_id": "eadd5935-8522-4b52-850e-5e84f8734b51",
                                                "sense_id": "330966d8-bcaa-3307-9a6a-f4f07bae4692",
                                                "text": "But foraſmuch as this [the faintneſs of the Heart] is a very bad and heavy diſtemper, and a fore-runner of death, therefore 'tis called a timely death."
                                            },
                                            {
                                                "example_id": "696f5b8a-5569-4327-8c6c-ac848265f361",
                                                "sense_id": "330966d8-bcaa-3307-9a6a-f4f07bae4692",
                                                "text": "Perhaps the reason why he seemed in such a ghastly rage was that he did not come by his death fairly."
                                            },
                                            {
                                                "example_id": "49306cf7-e1c1-4e0d-96d3-06ffed2fdf00",
                                                "sense_id": "330966d8-bcaa-3307-9a6a-f4f07bae4692",
                                                "text": "\"‘Death,’\" quoted Warwick, with whose mood the undertaker's remarks were in tune, \"‘is the penalty that all must pay for the crime of living.’\""
                                            },
                                            {
                                                "example_id": "987b2649-31d5-4dee-986b-e4f192e42c4d",
                                                "sense_id": "330966d8-bcaa-3307-9a6a-f4f07bae4692",
                                                "text": "Furthermore, this increase in risk is comparable to the risk of death from leukemia after long-term exposure to benzene, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33243998-756b-3a0e-a9b7-bda7abb1ec7e",
                                        "entry_id": "3e655c0f-06f4-3a06-9c83-51cca53e153e",
                                        "glosses": [
                                            "The cessation of life and all associated processes; the end of an organism's existence as an entity independent from its environment and its return to an inert, nonliving state.",
                                            "Execution (in the judicial sense)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08371bd4-62f5-470c-9e12-d0b6a44b0264",
                                                "sense_id": "33243998-756b-3a0e-a9b7-bda7abb1ec7e",
                                                "text": "The serial killer was sentenced to death."
                                            },
                                            {
                                                "example_id": "208319c2-47d3-4fd8-b6f9-e3322bd79228",
                                                "sense_id": "33243998-756b-3a0e-a9b7-bda7abb1ec7e",
                                                "text": "Thirty years after Gao Chengyong embarked on a succession of 11 rape-murders of women in northwest China, a court sentenced him to death on Friday, following an investigation that involved sifting through 230,000 fingerprints."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83fcc11a-0c8a-3eea-8e78-31d4f0296603",
                                        "entry_id": "3e655c0f-06f4-3a06-9c83-51cca53e153e",
                                        "glosses": [
                                            "The personification of death as a (usually male) hooded figure with a scythe; the Grim Reaper."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e26089c-089e-4d93-a1c1-7e5d08b9210f",
                                                "sense_id": "83fcc11a-0c8a-3eea-8e78-31d4f0296603",
                                                "text": "When death walked in, a chill spread through the room."
                                            },
                                            {
                                                "example_id": "5c4dfed0-4279-4d6c-b40a-b1c38a82a9d0",
                                                "sense_id": "83fcc11a-0c8a-3eea-8e78-31d4f0296603",
                                                "text": "And I looked, and behold, a pale horse, & his name that sat on him was Death\""
                                            },
                                            {
                                                "example_id": "fdbe660d-ed55-441b-825a-48e443afa6b3",
                                                "sense_id": "83fcc11a-0c8a-3eea-8e78-31d4f0296603",
                                                "text": "[T]o thoſe, Jonathan, who know what death is, and what havock and deſtruction he can make, before a man can well wheel about—'tis like a whole age."
                                            },
                                            {
                                                "example_id": "0db9994b-ecc3-43bc-b68c-299abc36951a",
                                                "sense_id": "83fcc11a-0c8a-3eea-8e78-31d4f0296603",
                                                "text": "O boy! running man is out of death ... Anyway, they say she comes on a pale horse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d95a1576-36f8-310f-98b0-2206567870f4",
                                        "entry_id": "3e655c0f-06f4-3a06-9c83-51cca53e153e",
                                        "glosses": [
                                            "The collapse or end of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a668f21-d9ad-4c50-aed8-ea8538ed7649",
                                                "sense_id": "d95a1576-36f8-310f-98b0-2206567870f4",
                                                "text": "England scored a goal at the death to even the score at one all."
                                            },
                                            {
                                                "example_id": "d6ac18f1-a3cd-4ad3-9027-a0daebb7e8df",
                                                "sense_id": "d95a1576-36f8-310f-98b0-2206567870f4",
                                                "text": "Buyer (negotiating): You were at two-fifty on that one. Go on, then, what's the death on that? Seller: Two hundred pounds is the absolute death. Buyer: Sold. Thank you."
                                            },
                                            {
                                                "example_id": "fdb50e51-0b42-4d2c-ac52-9ea702f9bdbd",
                                                "sense_id": "d95a1576-36f8-310f-98b0-2206567870f4",
                                                "text": "He may even find himself being blamed if the project dies a quick and horrible death at the box office or is unceremoniously axed by the network."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "886ebee2-9e49-3545-aef6-28615f53db7e",
                                        "entry_id": "3e655c0f-06f4-3a06-9c83-51cca53e153e",
                                        "glosses": [
                                            "The collapse or end of something.",
                                            "A cause of great stress, exhaustion, embarrassment, or another negative condition (for someone)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "especially",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9111b41b-3163-413e-b39d-de47f48ec744",
                                                "sense_id": "886ebee2-9e49-3545-aef6-28615f53db7e",
                                                "text": "This bake sale is going to be the death of me!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56da36ee-53da-3ac3-802f-adae69d11c09",
                                        "entry_id": "3e655c0f-06f4-3a06-9c83-51cca53e153e",
                                        "glosses": [
                                            "Spiritual lifelessness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e9a5278-9c6a-486a-a3f9-245cb65dc4ae",
                        "source_entry_id": "726ea7f7-246e-31c6-9634-19b67be25612",
                        "source_sense_id": "0f1b8720-0dee-3571-96cb-9c40cd5c1a28",
                        "target_lang_word": "decease",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e89ebc7-039a-37e8-81c9-0ef0aa60baf8",
                                        "entry_id": "3651deaa-168a-3f75-b992-98bfde8ddfc0",
                                        "glosses": [
                                            "Death, departure from life."
                                        ],
                                        "tags": [
                                            "countable",
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbb31956-a75c-44b8-854f-9050943038cc",
                                                "sense_id": "3e89ebc7-039a-37e8-81c9-0ef0aa60baf8",
                                                "text": "So should that beauty which you hold in lease\nFind no determination: then you were\nYourself again after yourself's decease […]"
                                            },
                                            {
                                                "example_id": "fd4bf109-db3a-447b-9ea4-06e54bd0a7c1",
                                                "sense_id": "3e89ebc7-039a-37e8-81c9-0ef0aa60baf8",
                                                "text": "I thought about my predecessor, who had died of drink and smoke; and I could have wished he had been so good as to live, and not bother me with his decease."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "decease",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7becba34-b32c-3c8d-a02a-f58f806af582",
                                        "entry_id": "d49cd7b5-51c5-3104-8a7e-534a158e05a6",
                                        "glosses": [
                                            "To die."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4740ce84-1841-4e5f-a67b-7154d3782fcc",
                                                "sense_id": "7becba34-b32c-3c8d-a02a-f58f806af582",
                                                "text": "After which usurped victorie, he presently deceased: and partly through the excessive joy he thereby conceived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e73d6b95-b247-32bf-9276-fdf72cc7bd06",
                                        "entry_id": "d49cd7b5-51c5-3104-8a7e-534a158e05a6",
                                        "glosses": [
                                            "To cause to die."
                                        ],
                                        "tags": [
                                            "formal",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
