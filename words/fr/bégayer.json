{
    "word_family": [
        "bégaiement",
        "bégayement",
        "bégayeur",
        "bégayeuse",
        "bègue"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b711e472-6102-32ef-a3c8-2f80bc6a0340",
                    "sense_definition": "Éprouver une difficulté d'élocution caractérisée par l'hésitation ou la répétition involontaire de sons et de syllabes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "trouble_de_la_parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quand il doit parler devant un public nombreux, il commence à <w>bégayer</w> légèrement."
                        },
                        {
                            "text": "Sous le coup de l'émotion soudaine, elle <w>bégayait</w> et n'arrivait plus à terminer sa phrase."
                        }
                    ],
                    "synonyms": [
                        "balbutier"
                    ]
                },
                {
                    "sense_id": "18384ea2-bc6e-3f71-8ed6-2bfd51387d95",
                    "sense_definition": "Prononcer des paroles d'une voix mal assurée, confuse ou hésitante sous l'effet du trouble.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "trouble_de_la_parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pris sur le fait, le suspect a <w>bégayé</w> une excuse maladroite que personne n'a crue."
                        },
                        {
                            "text": "Terrorisé par le professeur sévère, l'écolier a <w>bégayé</w> sa récitation sans regarder la classe."
                        }
                    ],
                    "synonyms": [
                        "balbutier",
                        "bredouiller"
                    ],
                    "common_phrases": [
                        "bégayer des excuses",
                        "bégayer sa leçon"
                    ]
                },
                {
                    "sense_id": "696715ca-ff82-3b2d-b833-9fb61a7bcef3",
                    "sense_definition": "En parlant d'un très jeune enfant, commencer à formuler ses premiers mots de façon encore imparfaite.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "apprentissage_du_langage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bébé sourit à ses parents tout en <w>bégayant</w> quelques sons joyeux dans son berceau."
                        },
                        {
                            "text": "Âgée de quinze mois, leur petite fille apprend à parler et <w>bégaie</w> déjà ses premiers mots."
                        }
                    ],
                    "synonyms": [
                        "balbutier",
                        "babiller"
                    ],
                    "common_phrases": [
                        "bégayer ses premiers mots"
                    ]
                },
                {
                    "sense_id": "832754b6-ed8f-3a24-b571-53bebb6adc79",
                    "sense_definition": "Se répéter ou se reproduire vainement, sans apporter de renouveau ni de progrès.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "repetition_figuree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les erreurs politiques passées refont surface et semblent faire <w>bégayer</w> notre Histoire commune."
                        },
                        {
                            "text": "Faute d'imagination, cette série télévisée s'épuise et <w>bégaie</w> les mêmes intrigues depuis plusieurs saisons."
                        }
                    ],
                    "synonyms": [
                        "radoter",
                        "piétiner"
                    ],
                    "common_phrases": [
                        "faire bégayer l'histoire"
                    ]
                }
            ]
        }
    ]
}