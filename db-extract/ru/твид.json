                        "entry_id": "4d262c4a-a91a-3c88-81b8-08a9cfd0ea1d",
                        "glosses": [
                            "грубая шерстяная ткань, из которой шьют верхнюю одежду"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "188eb76a-4a81-4d44-9f2f-678b3099008d",
                                "sense_id": "b07f29d0-b988-3b9c-9124-e571e0407935",
                                "text": "Я хотела бы купить пальто из твида."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67bf8087-493b-48fc-8473-ed66262cf228",
