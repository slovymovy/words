                        "examples": [
                            {
                                "example_id": "0e675b0a-e1b9-42a5-965d-7d0c6d351dc8",
                                "sense_id": "997d9470-2e31-3467-b2a0-c7d3dd16c86f",
                                "text": "„Der Premierminister selbst war ein gutes Beispiel für die nationale Schizophrenie: Obwohl er als Amateurpoet schon T. S. Eliot und Ezra Pound ins Türkische übersetzt hatte, machte er keinen Hehl daraus, dass er die USA nicht sonderlich mochte.“"
                            }
                        ],
