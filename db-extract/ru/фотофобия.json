                "translations": [
                    {
                        "translation_id": "1625a844-9b7a-456f-bbad-3497e0d8482b",
                        "source_entry_id": "c4aab3c2-cce4-3235-a5dc-b62e1620a00f",
                        "source_sense_id": "fd8f95be-7a3d-37d2-a58b-b761e541d10c",
                        "target_lang_word": "photophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "870dda7a-8fc3-39b7-92fc-140cdcf3f3ed",
                                        "entry_id": "bd88155d-6e6c-32da-ad12-2fdee16c7e40",
                                        "glosses": [
                                            "Excessive sensitivity to light and the aversion to bright light; abnormal fear of light."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "photophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d111efaa-c791-3fb6-b2e6-f56db3bc6dc9",
                                        "entry_id": "804ac64c-3cf5-30e0-b7c8-ae058bf2ef94",
                                        "glosses": [
                                            "An aversion to or fear of being photographed, the dissemination of personal photographs, or viewing photographs."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b31d6d8-ac37-4793-91b0-74ad33ec4340",
                                                "sense_id": "d111efaa-c791-3fb6-b2e6-f56db3bc6dc9",
                                                "text": "Photophobia was the latest affliction of Afghan officialdom—by contagion, probably, from Persia which tries to nip in the bud pictures that show her not yet entirely modern."
                                            },
                                            {
                                                "example_id": "b02b6a60-3626-4edf-980d-ba150bd53b1f",
                                                "sense_id": "d111efaa-c791-3fb6-b2e6-f56db3bc6dc9",
                                                "text": "Craig Armstrong doesn't want to be photographed. His record company wouldn't like it, he says, and besides he has flu so he looks a little puffy. So \"orders\" and vanity combine to stop the shoot, due to take place in a trendy bar in Glasgow's West End.\nThe cynic may see alternative reasons for the 39-year-old composer's photophobia, […]"
                                            },
                                            {
                                                "example_id": "c73153e8-c485-40e3-9ba2-ba5701cf76ee",
                                                "sense_id": "d111efaa-c791-3fb6-b2e6-f56db3bc6dc9",
                                                "text": "He concludes that Mapplethorpe blocks racist photophobia by making the nudes whose penises are not visible highly erotic, while using blatantly penis-focused images to force white viewers to recognize that when they see a black man, they see him not just in possession of a large penis, but actually as a penis (Mercer 1991; Fanon 1952/2008)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
