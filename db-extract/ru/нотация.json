                    }
                ],
                "senses": [
                    {
                        "sense_id": "86e0e44a-6698-3f01-9923-5c22654dd11b",
                        "entry_id": "ebae91a2-6679-33d7-946b-b28dd9135535",
                        "glosses": [
                            "наставление, нравоучение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db6a153a-a38b-47b2-a135-bc40ec66e260",
                                "sense_id": "86e0e44a-6698-3f01-9923-5c22654dd11b",
                                "text": "Чем больше была вина, тем длиннее читалась нотация."
                            },
                            {
                                "example_id": "014dfa75-2433-4d21-8f73-8e877e8eb9b4",
                                "sense_id": "86e0e44a-6698-3f01-9923-5c22654dd11b",
                                "text": "От огорчения я внезапно проснулся, не открывая глаз, и через секунду понял, что сна уже нет, а мамина нотация продолжается, причем читают ее прямо над левым ухом, и голос почему-то мужской."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
