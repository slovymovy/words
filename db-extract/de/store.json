                ],
                "senses": [
                    {
                        "sense_id": "9b399b5c-4119-39b1-9c9d-36d2038de4f6",
                        "entry_id": "93217e82-8b8b-35ac-b0ad-28248731f1e4",
                        "glosses": [
                            "Sicht- und/oder Lichtschutz vor Fenstern aus durchsichtigem Stoff"
                        ],
                        "tags": [
                            "Austrian German",
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "5e59a3d9-21c8-4c33-948f-51780ad4da26",
                                "sense_id": "9b399b5c-4119-39b1-9c9d-36d2038de4f6",
                                "text": "Eine klassische Gardine besteht aus zwei Teilen, dem Store und dem Dekoschal."
                            },
                            {
                                "example_id": "0ca8ec43-9c56-47f7-8c14-5b49cbad57bc",
                                "sense_id": "9b399b5c-4119-39b1-9c9d-36d2038de4f6",
                                "text": "Der Store ist eine halbdurchsichtige, meist weiße Untergardine, die sich zuziehen lässt."
                            },
                            {
                                "example_id": "dfdbd8a5-325d-41a0-a4df-9bf7220d737b",
                                "sense_id": "9b399b5c-4119-39b1-9c9d-36d2038de4f6",
                                "text": "„Üppige Raffbögen und Seidenzipfel-Dekorationen in großen Villen, klassische Stores als schlichter Sichtschutz, schwere Vorhänge als Akustikelement in Büros oder einfache Schlafzimmergardinen zur Verdunkelung – all das hat die Manufaktur im Repertoire.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ca1eb647-5b39-348a-8452-45abcad4f390",
                        "entry_id": "93217e82-8b8b-35ac-b0ad-28248731f1e4",
                        "glosses": [
                            "Sicht- und/oder Lichtschutz an Fenstern, der aufgerollt oder gerafft werden kann"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "914aed05-5ab7-4855-a376-91aa1e149357",
                                "sense_id": "ca1eb647-5b39-348a-8452-45abcad4f390",
                                "text": "„Herr Müller berührt «Szene Gäste» auf dem Touchpanel an der Wand. Das Licht geht an, die Store hoch, der Fernseher aus, im Hintergrund läuft jetzt das Klassikprogramm von Radio DRS 2.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "c591133e-527e-3c58-bb23-339b144bd091",
                        "entry_id": "93217e82-8b8b-35ac-b0ad-28248731f1e4",
                        "glosses": [
                            "Sonnendach vor Fenstern, auf Balkonen/Terrassen, das aufgerollt oder gerafft werden kann"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "5b714734-4503-4cc4-9b48-4e5f61c11c0e",
                                "sense_id": "c591133e-527e-3c58-bb23-339b144bd091",
                                "text": "„Draussen sind [am heissen Nachmittag] die Schaufenster der Bäckereien und Metzgereien halb verhängt oder hinter Storen verborgen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
