                ],
                "senses": [
                    {
                        "sense_id": "e25ce0d5-47f9-31d9-926d-00c2dde5cad5",
                        "entry_id": "b26e0f01-156f-345c-81e4-e7fd2c8cac98",
                        "glosses": [
                            "Relatif au néoréalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8ba5a03-211a-4d53-b6a8-874247f87170",
                                "sense_id": "e25ce0d5-47f9-31d9-926d-00c2dde5cad5",
                                "text": "Il appécie beaucoup le cinéma néoréaliste italien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8b7cc906-970b-4e59-a7d2-943cad41b672",
                        "source_entry_id": "b26e0f01-156f-345c-81e4-e7fd2c8cac98",
                        "source_sense_id": "e25ce0d5-47f9-31d9-926d-00c2dde5cad5",
                        "target_lang_word": "neorealist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neorealist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cad4be36-36b9-3881-89cc-e2e186571739",
                                        "entry_id": "3ca33620-2c0d-3cb9-a747-67d75d093042",
                                        "glosses": [
                                            "Of or pertaining to the post World War II international relations movement of neorealism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54cd4bac-ccfa-384d-8621-0316281a6a31",
                                        "entry_id": "3ca33620-2c0d-3cb9-a747-67d75d093042",
                                        "glosses": [
                                            "Of or pertaining to the post-World War II Italian movement of neorealism, which focused on realistic portrayals of daily life."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6321e63-1ee8-45c7-b345-98e122208264",
                                                "sense_id": "54cd4bac-ccfa-384d-8621-0316281a6a31",
                                                "text": "If by “neorealism” you mean the opposite of manufactured effects, of the laws of dramaturgy, spectacle, and even of cinematography, then Rossellini has made the only neorealist films."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2286893-9dd6-3187-9932-54622fc283ef",
                                        "entry_id": "3ca33620-2c0d-3cb9-a747-67d75d093042",
                                        "glosses": [
                                            "Of or pertaining to the neorealism movement in art, which emerged in Britain around 1914."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "neorealist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "133d719b-38f8-30ae-a018-3dec7f7530df",
                                        "entry_id": "385e9190-0042-376d-8917-513b52331947",
                                        "glosses": [
                                            "An adherent of neorealism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb33d99d-2a04-4660-aec4-a96c89806813",
                                                "sense_id": "133d719b-38f8-30ae-a018-3dec7f7530df",
                                                "text": "DeSanctis wasn't a neorealist; he was a follower of D'Annunzio, who took calendar-art shots of the sea."
                                            },
                                            {
                                                "example_id": "3b7a9f3d-3534-41c2-903a-d9c6cfcbb743",
                                                "sense_id": "133d719b-38f8-30ae-a018-3dec7f7530df",
                                                "text": "Rossellini was one of a diverse group of filmmakers, including Luchino Visconti and Vittorio De Sica, who became known as neorealists for their determination to get out of the studio and rediscover a sense of gritty, working-class authenticity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
