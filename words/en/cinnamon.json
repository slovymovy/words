                    "sense_id": "09f69879-6068-309f-9f06-24231c7366a2",
                    "sense_definition": "Containing or tasting of the spice cinnamon.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cinnamon_spice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bakery sells delicious <w>cinnamon</w> rolls that are very popular in the morning.",
                            "target_lang_translations": {
