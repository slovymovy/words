                ],
                "senses": [
                    {
                        "sense_id": "ff77e2bf-c22c-34c4-89bf-40aab66b1751",
                        "entry_id": "09e7e2ca-4545-31b9-9069-f019fc2a0dc7",
                        "glosses": [
                            "kleiner Hohlraum oder kleine Öffnung in einem festen oder lockeren Material oder einem Gewebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fd7e6c1-296e-4e5f-8399-80b3dc086bfb",
                                "sense_id": "ff77e2bf-c22c-34c4-89bf-40aab66b1751",
                                "text": "Wegen der großen Poren kann Bimsstein auf Wasser schwimmen."
                            },
                            {
                                "example_id": "757252f1-5c7e-4ba0-a4be-cbd4ad40569a",
                                "sense_id": "ff77e2bf-c22c-34c4-89bf-40aab66b1751",
                                "text": "Sandböden haben größere Poren als Tonböden."
                            },
                            {
                                "example_id": "6df81f12-24ad-462b-be5f-c1903f5a5959",
                                "sense_id": "ff77e2bf-c22c-34c4-89bf-40aab66b1751",
                                "text": "„Unaufhaltsam quetschte sich der Schweiß aus allen Poren meines Körpers.“"
                            },
                            {
                                "example_id": "65a13887-5a54-4d4a-bdac-69cbb7b7ff2f",
                                "sense_id": "ff77e2bf-c22c-34c4-89bf-40aab66b1751",
                                "text": "„Mit allen Poren sog Morrison die indianischen Kräfte auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "355512bf-95a8-428c-a1ef-4933978284f9",
                        "source_entry_id": "09e7e2ca-4545-31b9-9069-f019fc2a0dc7",
                        "source_sense_id": "ff77e2bf-c22c-34c4-89bf-40aab66b1751",
                        "source_sense_description": "kleiner Hohlraum oder kleine Öffnung in einem festen oder lockeren Material oder einem Gewebe",
                        "target_lang_word": "pore",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "690651a1-e3ac-3dff-bdb5-6f15e8ae5378",
                                        "entry_id": "57a0971f-392d-3b00-961f-9b047be1a178",
                                        "glosses": [
                                            "A tiny opening in the skin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd912937-b81e-4252-aa53-ab70396008ad",
                                                "sense_id": "690651a1-e3ac-3dff-bdb5-6f15e8ae5378",
                                                "text": "I could sense the sweat dripping out of all my pores."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abb846f2-7152-3012-8938-c10674922f5f",
                                        "entry_id": "57a0971f-392d-3b00-961f-9b047be1a178",
                                        "glosses": [
                                            "By extension any small opening or interstice, especially one of many, or one allowing the passage of a fluid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48f6a9fc-2a64-406c-8173-adc37d886e89",
                                                "sense_id": "abb846f2-7152-3012-8938-c10674922f5f",
                                                "text": "the pores of a rock."
                                            },
                                            {
                                                "example_id": "70c4f96e-f4df-4ef7-b3f0-bb3cce6726bf",
                                                "sense_id": "abb846f2-7152-3012-8938-c10674922f5f",
                                                "text": "Under certain conditions tangential sections indicate that the zoœcial walls and the intermural space are seemingly pierced by communication pores or connecting foramina."
                                            },
                                            {
                                                "example_id": "721794b3-4cb8-4037-81c0-eb8175cc6be8",
                                                "sense_id": "abb846f2-7152-3012-8938-c10674922f5f",
                                                "text": "After reading White’s vitriolic language, The New York Times facetiously remarked that “Kansas is bleeding from every pore of her vocabularium. Sharp’s rifles are discharging from the well-known Emporium of White & Son, unlimited, and Bibles are closed until after election.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pore",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86e9db66-3e44-3afe-b9af-e71d2684ec8e",
                                        "entry_id": "6e4b8ced-eb6a-3987-b548-81458c9cd152",
                                        "glosses": [
                                            "To study meticulously; to go over again and again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdb5913e-0f86-4d8a-8eb0-19cfa1ddd1bf",
                                                "sense_id": "86e9db66-3e44-3afe-b9af-e71d2684ec8e",
                                                "text": "Yet each foreign post day she watched for the arrival of letters - knew the postmark, and watched me as I read. I found her often poring over the articles of Greek intelligence in the newspaper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd3e91e1-11b3-33cc-a4d8-87813ef504b6",
                                        "entry_id": "6e4b8ced-eb6a-3987-b548-81458c9cd152",
                                        "glosses": [
                                            "To meditate or reflect in a steady way."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd65ed42-3b9e-4636-90bf-19200377e068",
                        "source_entry_id": "09e7e2ca-4545-31b9-9069-f019fc2a0dc7",
                        "source_sense_id": "ff77e2bf-c22c-34c4-89bf-40aab66b1751",
                        "source_sense_description": "kleiner Hohlraum oder kleine Öffnung in einem festen oder lockeren Material oder einem Gewebe",
                        "target_lang_word": "pore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ac214dd-5b88-313e-95eb-0e55bec1814e",
                                        "entry_id": "d10bdb32-b905-396a-9a89-76220a6364bf",
                                        "glosses": [
                                            "Ouverture imperceptible dans la peau de l’homme ou de l’animal, par où se fait la transpiration. Il n’est guère d’usage qu’au pluriel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "068e5120-c681-4ee3-8536-e71c4159cc01",
                                                "sense_id": "8ac214dd-5b88-313e-95eb-0e55bec1814e",
                                                "text": "Les observateurs comprendront alors que la Péchina, chez qui la passion sortait par tous les pores, réveillât en des natures perverses la fantaisie endormie par l’abus ; de même qu’à table l’eau vient à la bouche à l’aspect de ces fruits contournés, troués, tachés de noir que les gourmands connaissent pas expérience, et sous la peau desquels la nature se plaît à mettre des saveurs et des parfums de choix."
                                            },
                                            {
                                                "example_id": "1b799fcd-751e-4154-a3a7-c4676920873b",
                                                "sense_id": "8ac214dd-5b88-313e-95eb-0e55bec1814e",
                                                "text": "(Sens figuré) Il sue l’hypocrisie par tous les pores."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d775f345-c847-3d5e-8706-924f7360e681",
                                        "entry_id": "d10bdb32-b905-396a-9a89-76220a6364bf",
                                        "glosses": [
                                            "Petits orifices, petites ouvertures analogues dans les végétaux. (→ voir plasmodesme)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5d6eaa3-5d5e-47bd-b3f5-f4f2593153b3",
                                                "sense_id": "d775f345-c847-3d5e-8706-924f7360e681",
                                                "text": "L’air était d’une transparence bleuâtre, sa lumière crue enveloppant tout, frappant tout, pénétrait jusque dans leurs pores les vieux bois gris de la barque, …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbfd5677-3fd7-3ca5-870f-a69ebf9445df",
                                        "entry_id": "d10bdb32-b905-396a-9a89-76220a6364bf",
                                        "glosses": [
                                            "Interstices qui séparent les molécules d’un corps."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
