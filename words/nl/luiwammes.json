                    "sense_definition": "iemand die erg traag of lui is en liever niets doet",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kom eindelijk eens van die bank af, luie <w>luiwammes</w>!",
                            "target_lang_translations": {
