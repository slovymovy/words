                    {
                        "translation_id": "28429da4-526b-42c7-b920-d93591a9d66a",
                        "source_entry_id": "2fc3f580-9418-366c-ba51-933ac986f85c",
                        "source_sense_id": "5f5ed6cd-67cb-37d7-836a-eda52af4f9bb",
                        "source_sense_description": "de tak van de geneeskunde die het ontstaan en verloop van ziektes bestudeert",
