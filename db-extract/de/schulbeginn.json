                        ],
                        "form": "die Schulbeginne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "176ad373-0a03-3932-a2c4-974d82dd71de",
                        "entry_id": "2d31d4a2-ec06-3954-bf00-2f20674a4b20",
                        "glosses": [
                            "Zeitpunkt, an dem offiziell die Schule (wieder) beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4dc8d20-4522-4b1b-adc5-13d3e3078a3a",
                                "sense_id": "176ad373-0a03-3932-a2c4-974d82dd71de",
                                "text": "Vor dem Schulbeginn bin ich immer so aufgeregt."
                            },
                            {
                                "example_id": "c660f7d2-1d8b-4349-99ef-fe61087d345e",
                                "sense_id": "176ad373-0a03-3932-a2c4-974d82dd71de",
                                "text": "„Oft müssen die Kinder zudem vor Schulbeginn auf dem kleinen Feld ihrer Eltern mitarbeiten.“"
                            },
                            {
                                "example_id": "5d5f9ed6-48e4-4e21-b5cd-f65d7fe28ab5",
                                "sense_id": "176ad373-0a03-3932-a2c4-974d82dd71de",
                                "text": "„Gleich zu Schulbeginn zeigte sich, dass stimmte, was sie behauptet hatten: Er war dumm.“"
                            },
                            {
                                "example_id": "321f608a-235d-49fb-b541-201f77fc6c5d",
                                "sense_id": "176ad373-0a03-3932-a2c4-974d82dd71de",
                                "text": "„Er hatte damals vor, Musik zu studieren, stand morgens um halb sechs auf, um vor Schulbeginn noch zu üben.“"
                            },
                            {
                                "example_id": "10bffa12-9e9e-46bb-821c-ae5e7a8a3139",
                                "sense_id": "176ad373-0a03-3932-a2c4-974d82dd71de",
                                "text": "„Die gleichzeitig mit dem Schulbeginn erfolgte Immatrikulation an der Leipziger Universität war ein Privileg, das ihm als Professorensohn zustand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
