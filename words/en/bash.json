{
    "word_family": [
        "basher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "584b0bb4-215a-3931-90b4-fdd572449314",
                    "sense_definition": "A forceful blow or impact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He received a painful <w>bash</w> on the head during the game.",
                            "target_lang_translations": {
                                "cs": "Během hry dostal bolestivou <w>ránu</w> do hlavy."
                            }
                        },
                        {
                            "text": "The door took a heavy <w>bash</w> from the falling tree branch.",
                            "target_lang_translations": {
                                "cs": "Dveře dostaly silnou <w>ránu</w> od padající větve stromu."
                            }
                        }
                    ],
                    "synonyms": [
                        "lash"
                    ],
                    "target_lang_definitions": {
                        "cs": "Silný úder nebo náraz."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rána",
                                "target_lang_sense_clarification": "obecné označení pro úder nebo náraz"
                            },
                            {
                                "target_lang_word": "pecka",
                                "target_lang_sense_clarification": "hovorové označení pro silný úder"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd1d6cdf-d6ee-3a02-93f4-d86b04a3f6aa",
                    "sense_definition": "An attempt at doing something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am not sure I can fix this, but I will give it a <w>bash</w>.",
                            "target_lang_translations": {
                                "cs": "Nejsem si jistý, jestli to dokážu opravit, ale <w>zkusím to</w>."
                            }
                        },
                        {
                            "text": "This was my first <w>bash</w> at baking bread, and it turned out well.",
                            "target_lang_translations": {
                                "cs": "Byl to můj první <w>pokus</w> o pečení chleba a dopadlo to dobře."
                            }
                        }
                    ],
                    "common_phrases": [
                        "give it a bash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pokus o provedení něčeho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "pokus",
                                "target_lang_sense_clarification": "obecné označení pro snahu něco udělat"
                            },
                            {
                                "target_lang_word": "zkusit to",
                                "target_lang_sense_clarification": "vyjádření snahy o provedení akce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56568329-5ded-3b38-8563-2305abbf49f9",
                    "sense_definition": "A large party or gala event.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "party",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They organized a huge <w>bash</w> to celebrate their company anniversary.",
                            "target_lang_translations": {
                                "cs": "Uspořádali obrovský <w>večírek</w> na oslavu výročí firmy."
                            }
                        },
                        {
                            "text": "Everyone was invited to the birthday <w>bash</w> held at the local hall.",
                            "target_lang_translations": {
                                "cs": "Všichni byli pozváni na narozeninovou <w>oslavu</w> v místním sále."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for a celebration."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Velká oslava nebo společenská událost."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "večírek",
                                "target_lang_sense_clarification": "neformální společenská oslava"
                            },
                            {
                                "target_lang_word": "oslava",
                                "target_lang_sense_clarification": "událost pořádaná při příležitosti něčeho"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f7cfebc-744a-3253-931e-83b19adec5c1",
                    "sense_definition": "To strike heavily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry man started to <w>bash</w> the table with his fist.",
                            "target_lang_translations": {
                                "cs": "Rozzlobený muž začal pěstí <w>bušit</w> do stolu."
                            }
                        },
                        {
                            "text": "He accidentally <w>bashed</w> his knee against the sharp corner of the desk.",
                            "target_lang_translations": {
                                "cs": "Nechtěně si <w>narazil</w> koleno o ostrý roh stolu."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Silně udeřit."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "udeřit",
                                "target_lang_sense_clarification": "zasáhnout někoho nebo něco silou"
                            },
                            {
                                "target_lang_word": "praštit",
                                "target_lang_sense_clarification": "neformální výraz pro prudký úder"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32b1d644-a50e-360a-8517-0af2a9696378",
                    "sense_definition": "To collide with something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>bash</w> into the other players on the field.",
                            "target_lang_translations": {
                                "cs": "Dávej pozor, abys <w>nenarazil</w> do ostatních hráčů na hřišti."
                            }
                        },
                        {
                            "text": "The two cars <w>bashed</w> into each other at the busy intersection.",
                            "target_lang_translations": {
                                "cs": "Ta dvě auta do sebe <w>narazila</w> na rušné křižovatce."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bash into"
                    ],
                    "target_lang_definitions": {
                        "cs": "Narazit do něčeho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "narazit",
                                "target_lang_sense_clarification": "prudce se střetnout s překážkou"
                            },
                            {
                                "target_lang_word": "vrazit",
                                "target_lang_sense_clarification": "prudce do něčeho narazit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7d833d6-76ed-3ac8-be81-97344ba837f9",
                    "sense_definition": "To criticize someone or something harshly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "criticize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper article continued to <w>bash</w> the government for its new policies.",
                            "target_lang_translations": {
                                "cs": "Novinový článek pokračoval v <w>kritizování</w> vlády za její novou politiku."
                            }
                        },
                        {
                            "text": "It is unfair to <w>bash</w> his efforts when he is trying his best.",
                            "target_lang_translations": {
                                "cs": "Je nefér <w>ztrhat</w> jeho snahu, když se snaží, jak nejlépe umí."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in political or media contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Někoho nebo něco ostře kritizovat."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kritizovat",
                                "target_lang_sense_clarification": "vyjadřovat nesouhlas nebo výhrady"
                            },
                            {
                                "target_lang_word": "ztrhat",
                                "target_lang_sense_clarification": "velmi ostře a negativně hodnotit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6020071-a3f3-34ce-9090-f25a4ba467ff",
                    "sense_definition": "To <w>abash</w> or make someone feel ashamed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His cruel words were intended to <w>bash</w> her spirit in front of everyone.",
                            "target_lang_translations": {
                                "cs": "Jeho krutá slova měla za cíl <w>ponížit</w> jejího ducha před všemi."
                            }
                        },
                        {
                            "text": "The public humiliation served to <w>bash</w> the pride of the arrogant leader.",
                            "target_lang_translations": {
                                "cs": "Veřejné ponížení posloužilo k tomu, aby <w>zahanbilo</w> pýchu arogantního vůdce."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zahanbit někoho nebo způsobit, že se cítí poníženě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ponížit",
                                "target_lang_sense_clarification": "způsobit někomu ztrátu důstojnosti"
                            },
                            {
                                "target_lang_word": "zahanbit",
                                "target_lang_sense_clarification": "vyvolat v někom pocit studu"
                            }
                        ]
                    }
                }
            ]
        },
        {
