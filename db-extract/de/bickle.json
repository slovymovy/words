                "senses": [
                    {
                        "sense_id": "825c0509-aaf8-315a-950c-29e9830d6da7",
                        "entry_id": "a39f5626-0ed1-31f0-ae69-f9ec50154755",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ca8e606-775f-4a62-a02c-dd4b33c0ebc9",
                                "sense_id": "825c0509-aaf8-315a-950c-29e9830d6da7",
                                "text": "Frau Bickle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6cd0f55d-e565-4c5b-85e2-90458fe41d84",
                                "sense_id": "825c0509-aaf8-315a-950c-29e9830d6da7",
                                "text": "Herr Bickle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "caa58ee4-9a76-4923-9aa3-5cce617b0102",
                                "sense_id": "825c0509-aaf8-315a-950c-29e9830d6da7",
                                "text": "Die Bickles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "b775fead-87fd-416c-a3b0-b3d89d67ffa8",
                                "sense_id": "825c0509-aaf8-315a-950c-29e9830d6da7",
                                "text": "Der Bickle trägt nie die Schals, die die Bickle ihm strickt."
                            },
                            {
                                "example_id": "8ddbd01d-af92-4775-ae97-5efb0c6bd4ee",
                                "sense_id": "825c0509-aaf8-315a-950c-29e9830d6da7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bickle kommt, geht der Herr Bickle.“"
                            },
                            {
                                "example_id": "5eb03df7-c3e0-4159-820a-b0516a82550a",
                                "sense_id": "825c0509-aaf8-315a-950c-29e9830d6da7",
                                "text": "Bickle kommt und geht."
                            },
                            {
                                "example_id": "95b79067-78e8-493b-afb9-ab1beebdf89a",
                                "sense_id": "825c0509-aaf8-315a-950c-29e9830d6da7",
                                "text": "Bickles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
