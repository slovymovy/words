{
    "word_family": [
        "entrée",
        "rentrer",
        "rentrée"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cbdf99ce-42e6-3377-aa08-98e68ce01d8f",
                    "sense_definition": "Aller de l'extérieur vers l'intérieur d'un espace fermé ou délimité.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il frappe poliment à la porte avant d'<w>entrer</w> dans la pièce."
                        },
                        {
                            "text": "Les enfants <w>entrent</w> dans la maison pour se mettre à l'abri."
                        }
                    ],
                    "synonyms": [
                        "pénétrer",
                        "rentrer"
                    ],
                    "antonyms": [
                        "sortir"
                    ],
                    "common_phrases": [
                        "entrer dans la pièce",
                        "entrer sans frapper",
                        "faire entrer"
                    ]
                },
                {
                    "sense_id": "adfadd43-dc7d-3d0f-bdb3-0af80b7cebd3",
                    "sense_definition": "Être admis ou s'engager dans un groupe, un établissement ou une profession.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "admission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le baccalauréat, ma sœur souhaite <w>entrer</w> à l'université."
                        },
                        {
                            "text": "Il est <w>entré</w> dans cette entreprise comme simple stagiaire."
                        }
                    ],
                    "common_phrases": [
                        "entrer à l'université",
                        "entrer au service",
                        "entrer dans le métier"
                    ]
                },
                {
                    "sense_id": "576bfa12-6a32-3e88-9289-2cbed24ebd56",
                    "sense_definition": "Commencer à être dans un état particulier ou débuter une période ou une action.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "debut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La nouvelle loi va bientôt <w>entrer</w> en vigueur dans tout le pays."
                        },
                        {
                            "text": "Il est immédiatement <w>entré</w> en colère en découvrant ces résultats inacceptables."
                        }
                    ],
                    "synonyms": [
                        "commencer",
                        "débuter"
                    ],
                    "common_phrases": [
                        "entrer en vigueur",
                        "entrer en colère",
                        "entrer en contact"
                    ]
                },
                {
                    "sense_id": "bced978d-54f6-3307-ac35-fbf31831c30a",
                    "sense_definition": "Pouvoir être contenu ou logé dans un espace donné.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contenance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous ces livres volumineux n'<w>entrent</w> pas dans mon sac à dos."
                        },
                        {
                            "text": "Combien de meubles peuvent <w>entrer</w> dans ce petit camion de déménagement ?"
                        }
                    ],
                    "common_phrases": [
                        "entrer dans la boîte",
                        "entrer dans le coffre"
                    ]
                },
                {
                    "sense_id": "f9bd0441-f8c2-3ca7-b708-5162363e3bb5",
                    "sense_definition": "Faire partie des ingrédients, composants ou éléments constitutifs d'une chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs plantes médicinales <w>entrent</w> dans la composition de cette tisane traditionnelle."
                        },
                        {
                            "text": "Le beurre et la farine <w>entrent</w> dans la préparation de cette pâte feuilletée."
                        }
                    ],
                    "common_phrases": [
                        "entrer dans la composition",
                        "entrer dans la recette"
                    ]
                }
            ]
        }
    ]
}