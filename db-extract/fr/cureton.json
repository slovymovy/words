                        "entry_id": "8ef79630-2113-37e1-9423-e49cc03ae8ca",
                        "glosses": [
                            "Qui relève du monde catholique."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "020c8ab6-70eb-4f52-82c9-0b4495518171",
                                "sense_id": "ca18396b-55ef-3cde-9819-4c1e7e54b847",
                                "text": "Seules, les mornes cucuteries curetonnes réussirent à se cramponner, grâce aux marraines de province qui y abonnaient traditionnellement leurs filleuls, aux anniversaires."
                            }
                        ]
                    }
                ],
