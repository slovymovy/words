                "senses": [
                    {
                        "sense_id": "775e5fea-1e50-3306-b3c7-8f56fd11db1a",
                        "entry_id": "295ea61d-21c8-3add-b48e-b27f86635d6d",
                        "glosses": [
                            "earhole",
                            "a puncture or piercing in the ear(lobe)"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e0e6f170-f527-40d7-8760-0d3db22b1a98",
                                "sense_id": "775e5fea-1e50-3306-b3c7-8f56fd11db1a",
                                "text": "Meine Mutter sagt, nächstes Jahr darf ich mir Ohrlöcher stechen lassen.",
                                "translation": "My mother says I may get earholes next year / may have my ears pierced next year.",
                                "english": "My mother says I may get earholes next year / may have my ears pierced next year."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b73cb01-c5ad-324a-8da9-b450058b02dc",
                        "entry_id": "295ea61d-21c8-3add-b48e-b27f86635d6d",
                        "glosses": [
                            "earhole",
                            "the orifice of the ear"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "62b728da-7d24-4587-879c-9aed6dff0963",
                                "sense_id": "1b73cb01-c5ad-324a-8da9-b450058b02dc",
                                "text": "Man soll Wattestäbchen nicht zu tief ins Ohrloch stecken.",
                                "translation": "You shouldn’t shove cotton buds too deep into your earhole.",
                                "english": "You shouldn’t shove cotton buds too deep into your earhole."
                            }
                        ]
                    }
