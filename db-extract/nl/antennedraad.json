                                "sense_id": "790fe542-cb16-3a35-8aee-0090efc8fbf9",
                                "text": "Een geschikte draadsoort voor antennedraad is litzedraad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "449b3f0d-35e5-49b2-920a-7767a53c772c",
                        "source_entry_id": "cb165b6e-1c85-3fd5-a2f0-76fdf35219e2",
