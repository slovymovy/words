                "senses": [
                    {
                        "sense_id": "52ca9143-8c27-3414-a8c6-a8a024b2a060",
                        "entry_id": "f0dbe693-9f8b-3312-9d9f-7bf80744ba5d",
                        "glosses": [
                            "zwolenniczka faszyzmu"
                        ],
                        "tags": [],
