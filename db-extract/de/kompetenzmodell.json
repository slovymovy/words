                "senses": [
                    {
                        "sense_id": "2bf251fd-6d04-3d09-a332-d5974e8bb1fa",
                        "entry_id": "2504af88-7771-3c6e-8268-6af65c61a8ce",
                        "glosses": [
                            "Entwurf, der verschiedene Kompetenzen beinhaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "910a95ba-6c31-4081-b0ba-b4d7b47cd5e6",
                                "sense_id": "2bf251fd-6d04-3d09-a332-d5974e8bb1fa",
                                "text": "„Unabhängig vom historischen Sachwissen, dessen Definition für Gautschi stark an gesellschaftliche Aushandlungsprozesse gekoppelt ist, definiert er für sein Kompetenzmodell fünf Kompetenzbereiche: Erschließungskompetenz, Methodenkompetenz, Interpretationskompetenz, Narrative Kompetenz und Urteilskompetenz.“"
                            },
                            {
                                "example_id": "59368948-6e36-4842-9593-3d599f614d6c",
                                "sense_id": "2bf251fd-6d04-3d09-a332-d5974e8bb1fa",
                                "text": "„Außerdem sei bislang kein theoretisch hinreichend differenziertes und zugleich konsensfähiges Kompetenzmodell in der geschichtsdidaktischen Forschung entwickelt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
