                                        "entry_id": "61c7d89e-578b-394b-9652-5f0f8c7e0645",
                                        "glosses": [
                                            "Alternative spelling of monobloc, a forging or casting made in a single piece."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fcac21d-38fc-4a62-af9f-df3327c455c1",
                                                "sense_id": "8355413d-e96f-383d-a77c-1a27ae457c01",
                                                "text": "The \"S3s\" had three cylinders in a single monoblock casting, and like many other of Sir Vincent Raven's designs, used a direct drive through short connecting rods on to the leading pair of coupled wheels."
                                            }
                                        ]
                                    }
                                ]
                            }
