                ],
                "senses": [
                    {
                        "sense_id": "623ac5b6-7ac5-3555-81fc-9a083a174abb",
                        "entry_id": "30af0508-a5ec-3a90-92b3-44aba3092f42",
                        "glosses": [
                            "kartografische Darstellung von Sternen und Sternbildern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86c2baf8-132e-4112-9b17-d728c54d207b",
                                "sense_id": "623ac5b6-7ac5-3555-81fc-9a083a174abb",
                                "text": "In Sternkarten werden äquatoriale Koordinaten angewendet."
                            },
                            {
                                "example_id": "857a0b4c-7b21-4791-8584-402cafe8db2b",
                                "sense_id": "623ac5b6-7ac5-3555-81fc-9a083a174abb",
                                "text": "Der prominente Zwergplanet kann jetzt am Abendhimmel beobachtet werden, vorausgesetzt, man verfügt über ein Teleskop mit mindestens 25 Zentimeter freier Öffnung und eine gute Sternkarte."
                            },
                            {
                                "example_id": "0595dec1-3074-40d8-8102-005b2d2d505c",
                                "sense_id": "623ac5b6-7ac5-3555-81fc-9a083a174abb",
                                "text": "Die zweite buchstäbliche Sternstunde des Jungen: Zu seinem zwölften Geburtstag bekam er eine Sternkarte geschenkt, mit der das Kind eines Nachts allein dem Himmel begegnete."
                            },
                            {
                                "example_id": "2de424e5-8139-4c56-b5a6-15f632ea48c0",
                                "sense_id": "623ac5b6-7ac5-3555-81fc-9a083a174abb",
                                "text": "Das einfachste zweidimensionale Planetarium ist eine drehbare Sternkarte."
                            },
                            {
                                "example_id": "0730367d-8ce7-4812-8aa3-4646e330687b",
                                "sense_id": "623ac5b6-7ac5-3555-81fc-9a083a174abb",
                                "text": "Das Prinzip der drehbaren Sternkarte wurde im antiken Rom entwickelt. Der Architekt und Techniker Vitruvius beschrieb um 27 v. Chr. eine Sternkarte, die auf eine feste Platte eingeritzt war, und eine Horizontmaske, die sich darüber hinweg drehte."
                            },
                            {
                                "example_id": "f87c743d-c84c-4548-b6ef-b83c2f9db353",
                                "sense_id": "623ac5b6-7ac5-3555-81fc-9a083a174abb",
                                "text": "Trotz dieser pragmatischen Sichtweise erschien in den ersten Jahrhunderten nach Christi die eine oder andere Sternkarte mit geflügelten Wesen, die eine kleine Waage in Händen halten."
                            },
                            {
                                "example_id": "d3b1a684-5312-47b2-960a-e6da10bc49c9",
                                "sense_id": "623ac5b6-7ac5-3555-81fc-9a083a174abb",
                                "text": "1515 brachte Albrecht Dürer seine Karten des nördlichen und südlichen Sternenhimmels heraus. Es handelt sich um die ersten gedruckten Sternkarten, die es je gab."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
