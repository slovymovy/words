            {
                "entry_id": "19553cc2-0962-326a-a533-09bc3a26b6a5",
                "word": "tarnation",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "956518c1-0197-462a-a437-e767adb11fcf",
