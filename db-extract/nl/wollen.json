                    }
                ],
                "senses": [
                    {
                        "sense_id": "eddc67d3-e7e1-3c35-bc86-8e1b5e2819ba",
                        "entry_id": "c3199887-62b7-3219-8f13-9778d09ffa2b",
                        "glosses": [
                            "gemaakt van wol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "910ff58a-1355-4a1e-b82a-00b2d0f73625",
                                "sense_id": "eddc67d3-e7e1-3c35-bc86-8e1b5e2819ba",
                                "text": "Hij draagt sinds kort weer wollen sokken."
                            },
                            {
                                "example_id": "ccc51731-bbb8-4992-9beb-25bcce60120f",
                                "sense_id": "eddc67d3-e7e1-3c35-bc86-8e1b5e2819ba",
                                "text": "Verder zaten er handschoenen, een lange wollen onderbroek, een sneeuwbril en een hele lading pillen in."
                            },
                            {
                                "example_id": "e69ea744-c4a7-4ca6-b66d-db3e19449be7",
                                "sense_id": "eddc67d3-e7e1-3c35-bc86-8e1b5e2819ba",
                                "text": "Caspar Witsen, met zijn woeste haardos, die slaphangende wollen sjaal om zijn nek en die versleten schoudertas schuin over zijn lichaam, staat op de drempel van de ontvangkamer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4db5618-6448-4474-b0cc-15f0c25915d2",
                        "source_entry_id": "c3199887-62b7-3219-8f13-9778d09ffa2b",
                        "source_sense_id": "eddc67d3-e7e1-3c35-bc86-8e1b5e2819ba",
                        "source_sense_description": "gemaakt van wol",
                        "target_lang_word": "wollen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wollen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3a038a47-d026-3bba-b270-2466c39b0050",
                                        "entry_id": "b9411dde-38c0-3e10-9c44-468c8cc5d8e6",
                                        "glosses": [
                                            "entschieden haben und deswegen vorhaben beziehungsweise den Vorsatz haben, etwas zu tun, um etwas zu erlangen oder zu erreichen"
                                        ],
                                        "tags": [
                                            "Modalverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9e24008-4f0e-4236-bb5a-0945a970e98f",
                                                "sense_id": "3a038a47-d026-3bba-b270-2466c39b0050",
                                                "text": "verkürzt: Ich will morgen zum Friseur. (Ich will morgen zum Friseur [gehen]/[fahren].)"
                                            },
                                            {
                                                "example_id": "f9d26491-3e18-47ce-8de3-43f49c480ff6",
                                                "sense_id": "3a038a47-d026-3bba-b270-2466c39b0050",
                                                "text": "„Ich meine, er hat mir erzählt, was er hat wollen, nicht was ich habe wollen, aber im Großen und Ganzen hat er einen Kontakt mit mir gehabt.“"
                                            },
                                            {
                                                "example_id": "f07ccf47-fbd0-439a-9e68-91111f2e54fb",
                                                "sense_id": "3a038a47-d026-3bba-b270-2466c39b0050",
                                                "text": "„Du kannst! So wolle nur! die Thür steht offen.“"
                                            },
                                            {
                                                "example_id": "6496dd89-2f46-4457-b401-13f8e6399b70",
                                                "sense_id": "3a038a47-d026-3bba-b270-2466c39b0050",
                                                "text": "„Wolle nur was du sollst, so kannst du was du willst.“"
                                            },
                                            {
                                                "example_id": "5a6be055-aa6b-414b-934b-242c0415dcf6",
                                                "sense_id": "3a038a47-d026-3bba-b270-2466c39b0050",
                                                "text": "„Wolle fromm, denke frei, handle froh, trage frisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "685f9908-1e62-355c-8e29-b39ba6107e78",
                                        "entry_id": "b9411dde-38c0-3e10-9c44-468c8cc5d8e6",
                                        "glosses": [
                                            "nur den Wunsch nach etwas haben, danach verlangen, es begehren, sich danach (nur) sehnen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ae4133-7837-4662-bf80-7d21483af01a",
                                                "sense_id": "685f9908-1e62-355c-8e29-b39ba6107e78",
                                                "text": "„Wolle fromm, denke frei, handle froh, trage frisch.“"
                                            },
                                            {
                                                "example_id": "ad4bb980-50b8-49c5-9c27-abfcd020c0d2",
                                                "sense_id": "685f9908-1e62-355c-8e29-b39ba6107e78",
                                                "text": "Kinder wollen ein Geschenk vom Weihnachtsmann."
                                            },
                                            {
                                                "example_id": "a5c9e373-f0f6-4d89-a055-135acc918aa0",
                                                "sense_id": "685f9908-1e62-355c-8e29-b39ba6107e78",
                                                "text": "„Ich frage Leute auf der Straße, in der U-Bahn, im Büro, alle woll'n Computer haben, keiner weiß genau wieso.“"
                                            },
                                            {
                                                "example_id": "d16b25bf-e88f-4b30-a1df-d0737c95d94c",
                                                "sense_id": "685f9908-1e62-355c-8e29-b39ba6107e78",
                                                "text": "„Die große Mehrheit [hat] wie die meisten Menschen im Krieg nur eines gewollt: überleben.“"
                                            },
                                            {
                                                "example_id": "bc57bd2c-1f53-4b3d-ac11-5f4194e6e2c9",
                                                "sense_id": "685f9908-1e62-355c-8e29-b39ba6107e78",
                                                "text": "Euch kann man aber auch nichts anbieten! Wollt halt auch mal was!"
                                            },
                                            {
                                                "example_id": "e825e235-fdbd-40db-8123-3ca1f81dc89c",
                                                "sense_id": "685f9908-1e62-355c-8e29-b39ba6107e78",
                                                "text": "„Wolle die Wandlung.“"
                                            },
                                            {
                                                "example_id": "f35ba747-67b3-4dd1-b5db-152aef8d6390",
                                                "sense_id": "685f9908-1e62-355c-8e29-b39ba6107e78",
                                                "text": "„Wolle das Gute, erkenne das Wahre, fühle das Schöne“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7c722c2f-e76f-33c2-b0c5-2198298c624d",
                                        "entry_id": "b9411dde-38c0-3e10-9c44-468c8cc5d8e6",
                                        "glosses": [
                                            "drückt Distanz/Zweifel an einer wiedergegebenen Aussage aus"
                                        ],
                                        "tags": [
                                            "Modalverb",
                                            "epistemisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "319d23af-9c7b-4c8f-ab05-619856545ae1",
                                                "sense_id": "7c722c2f-e76f-33c2-b0c5-2198298c624d",
                                                "text": "Er will 3 Jahre in Madrid gelebt haben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "45e76d5c-6c9a-3d4d-ab55-c0099256f547",
                                        "entry_id": "b9411dde-38c0-3e10-9c44-468c8cc5d8e6",
                                        "glosses": [
                                            "freundlich auffordern, sollen (abgeschwächt), oft mit „bitte“, auch appellierend"
                                        ],
                                        "tags": [
                                            "outdated",
                                            "subjunctive-i"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56139d11-b470-4303-93cf-fb263dc8dc8f",
                                                "sense_id": "45e76d5c-6c9a-3d4d-ab55-c0099256f547",
                                                "text": "„Wollen Sie bitte meinen aufrichtigen Dank empfangen für Ihre Aussage über meinen Plan.“"
                                            },
                                            {
                                                "example_id": "27357cf5-fbfd-4def-84ca-d2e38ea1a53a",
                                                "sense_id": "45e76d5c-6c9a-3d4d-ab55-c0099256f547",
                                                "text": "„Ihre Aussage, die Drohnentechnik sei ethisch neutral, wollen Sie bitte nicht ernst gemeint haben, Herr Minister.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "wollen",
                                "target_lang_code": "de",
                                "target_senses": [
