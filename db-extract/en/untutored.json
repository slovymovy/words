                        "glosses": [
                            "untrained, not taught or educated in a field of knowledge"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2ff62708-5765-47d0-bd1a-ac8c3700c51f",
                                "sense_id": "60bb5e51-5dbb-33fa-9cab-dbcb6b600c9b",
                                "text": "To my untutored eye all the trees looked alike."
                            },
                            {
                                "example_id": "9bddeafb-809c-4835-b6bb-9de719528f55",
                                "sense_id": "60bb5e51-5dbb-33fa-9cab-dbcb6b600c9b",
                                "text": "The eye wandered from object to object, and rested upon none; neither the “Grotesques” of the Greek painters, nor the sculptures of the best Italian days, nor the huge carvings of untutored Egypt."
                            },
                            {
                                "example_id": "15793e1e-1f3f-4dc3-b956-bdec04dfb766",
                                "sense_id": "60bb5e51-5dbb-33fa-9cab-dbcb6b600c9b",
                                "text": "\"Instead of being a rollicking bull-necked quarterstaff player with an eye for a wench and a good but untutored voice for roaring a roundelay, he's nothing but a weasel-faced herring-gutted wowser deliberately stuck in a cell to mislead travellers.\""
                            }
                        ]
                    }
