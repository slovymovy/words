                ],
                "senses": [
                    {
                        "sense_id": "1e0bc327-2b07-3e4d-a24a-de250913c9f6",
                        "entry_id": "4983b788-0593-3190-8ed0-e831d6507fa9",
                        "glosses": [
                            "der Kult, den eine Kultur in Hinsicht auf den Tod und ihre Toten praktiziert"
                        ],
                        "tags": [
                            "Kultur"
                        ],
                        "examples": [
                            {
                                "example_id": "0819397b-e6e6-4a18-bc40-5bbfe1a65233",
                                "sense_id": "1e0bc327-2b07-3e4d-a24a-de250913c9f6",
                                "text": "Zum Totenkult gehört außer anderen Dingen auch die Gestaltung der Grabmäler."
                            },
                            {
                                "example_id": "301ea3c8-941c-4024-a7fc-b68224d6fbf0",
                                "sense_id": "1e0bc327-2b07-3e4d-a24a-de250913c9f6",
                                "text": "Es handelt sich bei Totenkulten um offensichtliche Formen einer Erinnerungskultur. Bestattungsrituale und Bestattungsfeiern finden sich daher in jeder Kultur, in der mehr als Werkzeuggebrauch üblich ist."
                            },
                            {
                                "example_id": "ed6dfc88-9ff4-4f40-a8ce-caf35112d567",
                                "sense_id": "1e0bc327-2b07-3e4d-a24a-de250913c9f6",
                                "text": "„Der sehr intensive polnische Totenkult ist übrigens auch vom Eurocity aus zu erkennen.“"
                            },
                            {
                                "example_id": "a6e65f7a-7a2c-4484-8032-d5f3e8a2d809",
                                "sense_id": "1e0bc327-2b07-3e4d-a24a-de250913c9f6",
                                "text": "„Der Totenkult war allem Anschein nach schlicht, die Beigaben deuten darauf hin, dass man die Verstorbenen für ein Weiterleben nach dem Tod ausstatten wollte.“"
                            },
                            {
                                "example_id": "74ddbe5f-472e-47c5-82ed-339888a670cd",
                                "sense_id": "1e0bc327-2b07-3e4d-a24a-de250913c9f6",
                                "text": "„Für viele Ägypter kommt der Glaube hinzu, daß das Wohlergehen der Toten im Jenseits durch die Aufrechterhaltung eines Totenkultes (Sprechen von Gebeten, regelmäßige Opfergaben) gefördert wird, und hierfür sind in erster Linie die Kinder verantwortlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
