{
    "word_family": [
        "accomplishment",
        "unaccomplished"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b13bc28-abfa-3895-ad05-f1c1b2acd184",
                    "sense_definition": "Having many accomplishments or skills, often as a result of extensive study or training.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "skilled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an <w>accomplished</w> pianist who has performed in concert halls around the world.",
                            "target_lang_translations": {
                                "ru": "Она — <w>искусная</w> пианистка, выступавшая в концертных залах по всему миру.",
                                "pl": "Jest <w>utalentowaną</w> pianistką, która występowała w salach koncertowych na całym świecie."
                            }
                        },
                        {
                            "text": "As an <w>accomplished</w> public speaker, he knows exactly how to engage his audience.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>опытным</w> оратором, он точно знает, как заинтересовать аудиторию.",
                                "pl": "Jako <w>doświadczony</w> mówca wie dokładnie, jak zaangażować publiczność."
                            }
                        }
                    ],
                    "synonyms": [
                        "skilled",
                        "expert",
                        "talented",
                        "proficient",
                        "gifted"
                    ],
                    "antonyms": [
                        "unskilled",
                        "inept",
                        "amateurish",
                        "incompetent"
                    ],
                    "common_phrases": [
                        "accomplished musician",
                        "accomplished artist",
                        "highly accomplished",
                        "accomplished scholar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий множеством достижений или навыков, опытный и талантливый.",
                        "pl": "Posiadający liczne osiągnięcia lub umiejętności, często będące wynikiem intensywnej nauki lub treningu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искусный",
                                "target_lang_sense_clarification": "обладающий высоким мастерством"
                            },
                            {
                                "target_lang_word": "опытный",
                                "target_lang_sense_clarification": "имеющий большой опыт"
                            },
                            {
                                "target_lang_word": "состоявшийся",
                                "target_lang_sense_clarification": "достигший успеха и признания"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "utalentowany",
                                "target_lang_sense_clarification": "obdarzony talentem i umiejętnościami"
                            },
                            {
                                "target_lang_word": "doświadczony",
                                "target_lang_sense_clarification": "posiadający dużą praktykę w danej dziedzinie"
                            },
                            {
                                "target_lang_word": "wybitny",
                                "target_lang_sense_clarification": "wyróżniający się wysokim poziomem umiejętności"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae07b9ee-0501-3967-801b-9827603bbeb2",
                    "sense_definition": "Showing a high level of skill, polish, and artistry.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "skilled",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author's debut novel was an <w>accomplished</w> piece of writing that won several awards.",
                            "target_lang_translations": {
                                "ru": "Дебютный роман автора стал <w>мастерским</w> произведением, завоевавшим несколько наград.",
                                "pl": "Debiutancka powieść autora była <w>mistrzowskim</w> dziełem, które zdobyło kilka nagród."
                            }
                        },
                        {
                            "text": "Her <w>accomplished</w> performance in the play earned her rave reviews from critics.",
                            "target_lang_translations": {
                                "ru": "Её <w>безупречная</w> игра в пьесе заслужила восторженные отзывы критиков.",
                                "pl": "Jej <w>perfekcyjna</w> rola w sztuce przyniosła jej entuzjastyczne recenzje krytyków."
                            }
                        }
                    ],
                    "synonyms": [
                        "polished",
                        "masterly",
                        "impeccable",
                        "skillful"
                    ],
                    "antonyms": [
                        "amateurish",
                        "clumsy",
                        "poor"
                    ],
                    "common_phrases": [
                        "accomplished performance",
                        "accomplished work"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполненный с большим мастерством, безупречный.",
                        "pl": "Wykazujący wysoki poziom umiejętności, kunsztu i artyzmu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мастерский",
                                "target_lang_sense_clarification": "сделанный с большим умением"
                            },
                            {
                                "target_lang_word": "безупречный",
                                "target_lang_sense_clarification": "не имеющий недостатков"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "mistrzowski",
                                "target_lang_sense_clarification": "wykonany z wielkim kunsztem"
                            },
                            {
                                "target_lang_word": "perfekcyjny",
                                "target_lang_sense_clarification": "nieposiadający żadnych wad"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "610e2567-e6df-3fe5-92d4-30b0cbbb4ae6",
                    "sense_definition": "Completed, established, or effected beyond doubt or dispute.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "completed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee presented the decision to the staff as an <w>accomplished</w> fact.",
                            "target_lang_translations": {
                                "ru": "Комитет представил это решение персоналу как <w>свершившийся</w> факт.",
                                "pl": "Komitet przedstawił decyzję personelowi jako fakt <w>dokonany</w>."
                            }
                        },
                        {
                            "text": "We must deal with the situation as an <w>accomplished</w> reality rather than wishing it were different.",
                            "target_lang_translations": {
                                "ru": "Мы должны иметь дело с ситуацией как со <w>свершившейся</w> реальностью, а не желать, чтобы всё было иначе.",
                                "pl": "Musimy zmierzyć się z sytuacją jako z <w>dokonaną</w> rzeczywistością, zamiast życzyć sobie, by było inaczej."
                            }
                        }
                    ],
                    "synonyms": [
                        "completed",
                        "established",
                        "finished"
                    ],
                    "antonyms": [
                        "incomplete",
                        "unfinished"
                    ],
                    "common_phrases": [
                        "accomplished fact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Окончательно утвердившийся, не вызывающий сомнений (обычно о фактах).",
                        "pl": "Ukończony, ustalony lub wprowadzony w życie bez wątpliwości."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свершившийся",
                                "target_lang_sense_clarification": "уже произошедший, ставший фактом"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dokonany",
                                "target_lang_sense_clarification": "taki, który już się wydarzył i jest faktem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82fdcd07-e230-3ae1-9888-cf77c15d9c0b",
                    "sense_definition": "Simple past and past participle of <w>accomplish</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>accomplished</w> all her goals well before the deadline.",
                            "target_lang_translations": {
                                "ru": "Она <w>достигла</w> всех своих целей задолго до крайнего срока.",
                                "pl": "Ona <w>osiągnęła</w> wszystkie swoje cele na długo przed wyznaczonym terminem."
                            }
                        },
                        {
                            "text": "The team <w>accomplished</w> the mission despite the difficult weather conditions.",
                            "target_lang_translations": {
                                "ru": "Команда <w>выполнила</w> миссию, несмотря на сложные погодные условия.",
                                "pl": "Zespół <w>wykonał</w> misję pomimo trudnych warunków pogodowych."
                            }
                        }
                    ],
                    "synonyms": [
                        "achieved",
                        "fulfilled",
                        "completed",
                        "attained",
                        "finished",
                        "reached"
                    ],
                    "antonyms": [
                        "failed",
                        "abandoned"
                    ],
                    "common_phrases": [
                        "mission accomplished",
                        "successfully accomplished"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола accomplish (выполнять, достигать).",
                        "pl": "Czas przeszły i imiesłów czasu przeszłego od czasownika 'osiągnąć' lub 'wykonać'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выполнил",
                                "target_lang_sense_clarification": "сделал, завершил"
                            },
                            {
                                "target_lang_word": "достиг",
                                "target_lang_sense_clarification": "добился желаемого"
                            },
                            {
                                "target_lang_word": "осуществил",
                                "target_lang_sense_clarification": "воплотил в жизнь"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "osiągnął",
                                "target_lang_sense_clarification": "zrealizował cel"
                            },
                            {
                                "target_lang_word": "wykonał",
                                "target_lang_sense_clarification": "zrealizował zadanie"
                            },
                            {
                                "target_lang_word": "zrealizował",
                                "target_lang_sense_clarification": "doprowadził coś do końca"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}