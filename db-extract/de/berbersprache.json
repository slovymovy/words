                        "form": "die Berbersprache"
                    },
                    {
                        "form_id": "6d2875cb-3da5-4031-aacc-228295fc3366",
                        "entry_id": "3fd25b23-e0cf-3438-8034-99712ca25dfc",
                        "tags": [
                            "accusative",
