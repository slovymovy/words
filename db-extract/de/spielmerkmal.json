                "senses": [
                    {
                        "sense_id": "5bbc1211-52b3-34fa-aa15-b8fdbe9f9f0f",
                        "entry_id": "9f729607-81e5-3cb0-8bad-59e50144617e",
                        "glosses": [
                            "charakteristisches Kennzeichen eines Spiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14299f55-a20f-4942-979d-b8f9dceb013a",
                                "sense_id": "5bbc1211-52b3-34fa-aa15-b8fdbe9f9f0f",
                                "text": "„Neben unterschiedlichen Spielmerkmalen· werden häufig auch verschiedene Spielformen unterschieden […].“"
                            },
                            {
                                "example_id": "f8305466-e461-470f-b82f-a84a8c69fddf",
                                "sense_id": "5bbc1211-52b3-34fa-aa15-b8fdbe9f9f0f",
                                "text": "„Die hohe Attraktivität dieses Spielmerkmals ist dafür verantwortlich, dass die spannungsintensiven Spielformen im Spielinteresse der meisten Spielenden den höchsten Rang einnehmen.“"
                            },
                            {
                                "example_id": "d9451a60-86db-4fd9-a5eb-874826e0d189",
                                "sense_id": "5bbc1211-52b3-34fa-aa15-b8fdbe9f9f0f",
                                "text": "„Als zweites Spielmerkmal nennt er die Freiheit, Spielen sei freies Spielen.“"
                            },
                            {
                                "example_id": "1112ed3c-a739-4b0e-b7b5-b0c143abcab9",
                                "sense_id": "5bbc1211-52b3-34fa-aa15-b8fdbe9f9f0f",
                                "text": "„Ein weiterer positiver Aspekt dieses Erklärungsansatzes resultiert aus den offenen und dennoch treffend formulierten Spielmerkmalen des Kinderspiels.“"
                            },
                            {
                                "example_id": "f98d437a-e176-46e8-b786-c13ca63e8d56",
                                "sense_id": "5bbc1211-52b3-34fa-aa15-b8fdbe9f9f0f",
                                "text": "„Besser ist es, alle Versuchsbedingungen in einem einzigen Spiel zu realisieren, weil so alle Spielmerkmale in den Bedingungen identisch sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
