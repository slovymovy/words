                    {
                        "translation_id": "7ad561b1-6cfe-4a5d-b957-3fffaa11ef61",
                        "source_entry_id": "e05fa08c-9811-39ae-89e9-9861aabf616b",
                        "source_sense_id": "b2b4a42d-3375-3ae1-9d5a-031b18306de5",
