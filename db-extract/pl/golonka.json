                    {
                        "translation_id": "f71d425a-9b0f-4880-b40c-b3828fe77b12",
                        "source_entry_id": "e7480ab5-5ac0-3339-8fbe-cbd65c3fe458",
                        "source_sense_id": "29c78bd4-ecc3-37c9-9443-6457c4a9298e",
