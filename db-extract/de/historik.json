                    },
                    {
                        "form_id": "273aa42a-4891-4324-9582-a21522680ad8",
                        "entry_id": "79431ca2-4190-3afd-b4b5-2a3ea9961bc4",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Historik"
                    },
                    {
                        "form_id": "84687497-1d7a-4757-8acf-23dd29a49a20",
                        "entry_id": "79431ca2-4190-3afd-b4b5-2a3ea9961bc4",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Historik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae2d8cf3-eea7-347d-bac8-c5a30ce036e9",
                        "entry_id": "79431ca2-4190-3afd-b4b5-2a3ea9961bc4",
                        "glosses": [
                            "die systematisierte Selbstreflexion der Geschichtswissenschaft"
                        ],
                        "tags": [
                            "Geschichtswissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "f855bc37-0e15-4eb4-b63d-9b45f6705086",
                                "sense_id": "ae2d8cf3-eea7-347d-bac8-c5a30ce036e9",
                                "text": "„Vor dem Hintergrund der Tradition von Droysen her bestreitet Rüsen, daß Historik eine spezifisch philosophische Aufgabe sei. Vielmehr sei sie eine „systematisierte Selbstreflexion der Geschichtswissenschaft“.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bfeee9e-bd7b-4156-8d92-2ba13191b7db",
                        "source_entry_id": "79431ca2-4190-3afd-b4b5-2a3ea9961bc4",
                        "source_sense_id": "ae2d8cf3-eea7-347d-bac8-c5a30ce036e9",
                        "source_sense_description": "Philosophie, Geschichtswissenschaft: die systematisierte Selbstreflexion der Geschichtswissenschaft",
                        "target_lang_word": "history",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "history",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15503fb5-049c-30e2-818b-88169d71acc8",
                                        "entry_id": "8f28404c-9b7c-33d8-b831-3da1941a655d",
                                        "glosses": [
                                            "The aggregate of past events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed5c70dc-a06a-45f6-9c82-e167b6a5051a",
                                                "sense_id": "15503fb5-049c-30e2-818b-88169d71acc8",
                                                "text": "History repeats itself if we don’t learn from its mistakes."
                                            },
                                            {
                                                "example_id": "4d02613b-9aa9-4dd7-a6fe-4c932e7b3043",
                                                "sense_id": "15503fb5-049c-30e2-818b-88169d71acc8",
                                                "text": "He dreams of an invention that will make history."
                                            },
                                            {
                                                "example_id": "9610780c-0ade-4b27-ab36-a61c203595e9",
                                                "sense_id": "15503fb5-049c-30e2-818b-88169d71acc8",
                                                "text": "With some of it on the south and more of it on the north of the great main thoroughfare that connects Aldgate and the East India Docks, St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London."
                                            },
                                            {
                                                "example_id": "b6cd31c3-d601-4f35-b2f6-c0f6ba425bd7",
                                                "sense_id": "15503fb5-049c-30e2-818b-88169d71acc8",
                                                "text": "Few concepts are as emotionally charged as that of race. The word conjures up a mixture of associations—culture, ethnicity, genetics, subjugation, exclusion and persecution. But is the tragic history of efforts to define groups of people by race really a matter of the misuse of science, the abuse of a valid biological concept?"
                                            },
                                            {
                                                "example_id": "88d1a4ba-3dc6-4cf4-a6f3-95ce6629eaee",
                                                "sense_id": "15503fb5-049c-30e2-818b-88169d71acc8",
                                                "text": "So, we have a shared history - we will also have a shared future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "474e4b72-abb4-3851-9659-b1c42d9a7bb9",
                                        "entry_id": "8f28404c-9b7c-33d8-b831-3da1941a655d",
                                        "glosses": [
                                            "The empirical study of past events, as distinct from literature, myth, or scripture; the assessment of notable events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfc28df6-ecb2-4d48-8a3e-6ba5a4806d09",
                                                "sense_id": "474e4b72-abb4-3851-9659-b1c42d9a7bb9",
                                                "text": "He teaches Latin American history at the university and publishes books about the Cold War."
                                            },
                                            {
                                                "example_id": "caa6f013-990f-4d08-bf1f-bd9f942bb686",
                                                "sense_id": "474e4b72-abb4-3851-9659-b1c42d9a7bb9",
                                                "text": "History and experience act as a filter that can distort as much as elucidate. It is largely forgotten now, overlooked in the one-line description of Tony Blair and George W Bush as the men who lied about Iraq's weapons of mass destruction, but there was a wider context to their conviction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e682ef7c-ca69-38ee-8191-5d09ca09a4bf",
                                        "entry_id": "8f28404c-9b7c-33d8-b831-3da1941a655d",
                                        "glosses": [
                                            "The portion of the past that is known and recorded by this field of study, as opposed to all earlier and unknown times that preceded it (prehistory)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13b0a74a-16ab-4c13-87a9-e1a7c66a5c79",
                                                "sense_id": "e682ef7c-ca69-38ee-8191-5d09ca09a4bf",
                                                "text": "in all of human history and prehistory"
                                            },
                                            {
                                                "example_id": "1262ade5-3b5a-4abc-97b1-52518c46b5a7",
                                                "sense_id": "e682ef7c-ca69-38ee-8191-5d09ca09a4bf",
                                                "text": "in all recorded history"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfe69478-1462-3b55-8055-b33dbc2c45b4",
                                        "entry_id": "8f28404c-9b7c-33d8-b831-3da1941a655d",
                                        "glosses": [
                                            "A set of events involving an entity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d11c52d-bfbe-45d0-9d92-f7ba025eb439",
                                                "sense_id": "bfe69478-1462-3b55-8055-b33dbc2c45b4",
                                                "text": "a long and sordid history"
                                            },
                                            {
                                                "example_id": "03a94fc1-2193-4742-abb8-d82f105a4708",
                                                "sense_id": "bfe69478-1462-3b55-8055-b33dbc2c45b4",
                                                "text": "What is your medical history?"
                                            },
                                            {
                                                "example_id": "121f40d3-a855-46b5-8ed5-e90feeea9e8c",
                                                "sense_id": "bfe69478-1462-3b55-8055-b33dbc2c45b4",
                                                "text": "The family's history includes events best forgotten."
                                            },
                                            {
                                                "example_id": "ea25cb5f-eef0-4bf0-94bd-d11cb38e8265",
                                                "sense_id": "bfe69478-1462-3b55-8055-b33dbc2c45b4",
                                                "text": "[I]n the 575 days since [Oscar] Pistorius shot dead his girlfriend Reeva Steenkamp, there has been an unseemly scramble to construct revisionist histories, to identify evidence beneath that placid exterior of a pugnacious, hair-trigger personality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5437a35-55b9-3ab9-8e70-c3005ca44f82",
                                        "entry_id": "8f28404c-9b7c-33d8-b831-3da1941a655d",
                                        "glosses": [
                                            "A record or narrative description of past events."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa0146cc-f54d-406e-805d-e7802e4580b7",
                                                "sense_id": "d5437a35-55b9-3ab9-8e70-c3005ca44f82",
                                                "text": "a short history of post-Columbian colonization"
                                            },
                                            {
                                                "example_id": "b333ce45-ee34-4544-a844-499222ec231f",
                                                "sense_id": "d5437a35-55b9-3ab9-8e70-c3005ca44f82",
                                                "text": "Thucydides wrote a history of the Peleponnesian War that uses different sources than Herodotus' work."
                                            },
                                            {
                                                "example_id": "99840819-c956-490b-b7fd-cafedcbe698d",
                                                "sense_id": "d5437a35-55b9-3ab9-8e70-c3005ca44f82",
                                                "text": "I really enjoyed Shakespeare's tragedies more than his histories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e16f1bf2-748e-3ca4-9425-565658d58eb5",
                                        "entry_id": "8f28404c-9b7c-33d8-b831-3da1941a655d",
                                        "glosses": [
                                            "A list of past and continuing medical conditions of an individual or family."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aed27c96-8816-439f-a423-4ca561426467",
                                                "sense_id": "e16f1bf2-748e-3ca4-9425-565658d58eb5",
                                                "text": "A personal medical history is required for the insurance policy."
                                            },
                                            {
                                                "example_id": "19342c70-95b2-40c8-b1a2-dc2ef37e7e92",
                                                "sense_id": "e16f1bf2-748e-3ca4-9425-565658d58eb5",
                                                "text": "He has a history of cancer in his family."
                                            },
                                            {
                                                "example_id": "4546755e-3e89-4d67-baaf-03d524102845",
                                                "sense_id": "e16f1bf2-748e-3ca4-9425-565658d58eb5",
                                                "text": "This diagnosis is usually based solely on the history and physical examination, although laboratory tests are occasionally also obtained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4ab349d-b44e-33c3-9541-b2bf1c342802",
                                        "entry_id": "8f28404c-9b7c-33d8-b831-3da1941a655d",
                                        "glosses": [
                                            "A record of previous user events, especially of visited web pages in a browser."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaecbcaf-5b84-4764-924e-05f22a5a0b9c",
                                                "sense_id": "e4ab349d-b44e-33c3-9541-b2bf1c342802",
                                                "text": "I visited a great site yesterday but forgot the URL. Luckily, I didn't clear my history."
                                            },
                                            {
                                                "example_id": "92770992-9437-4f25-8ade-878c1218a7f9",
                                                "sense_id": "e4ab349d-b44e-33c3-9541-b2bf1c342802",
                                                "text": "When you do that, the browser window has no browser history, so it doesn't report a referrer page to the first site you visit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feba574e-e451-3efe-a01d-6287485fe09f",
                                        "entry_id": "8f28404c-9b7c-33d8-b831-3da1941a655d",
                                        "glosses": [
                                            "Something that no longer exists or is no longer relevant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d513e707-9065-46dc-811d-d905b07af411",
                                                "sense_id": "feba574e-e451-3efe-a01d-6287485fe09f",
                                                "text": "I told him that if he doesn't get his act together, he's history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73ead2c1-b5ac-38d2-8fe8-85fa487be394",
                                        "entry_id": "8f28404c-9b7c-33d8-b831-3da1941a655d",
                                        "glosses": [
                                            "Shared experience or interaction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aed90e7c-02e1-468c-9592-29d4b6391059",
                                                "sense_id": "73ead2c1-b5ac-38d2-8fe8-85fa487be394",
                                                "text": "There is too much history between them for them to split up now."
                                            },
                                            {
                                                "example_id": "3c8f5195-0d15-4660-856f-8c4bdf6cb9f2",
                                                "sense_id": "73ead2c1-b5ac-38d2-8fe8-85fa487be394",
                                                "text": "He has had a lot of history with the police."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f438de55-aa8e-3eaf-a945-d00d160b28c1",
                                        "entry_id": "8f28404c-9b7c-33d8-b831-3da1941a655d",
                                        "glosses": [
                                            "A historically significant event."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "169c2c6c-0875-4331-88e1-fb63459bd4a0",
                                                "sense_id": "f438de55-aa8e-3eaf-a945-d00d160b28c1",
                                                "text": "You are witnessing history!"
                                            },
                                            {
                                                "example_id": "989ea559-1a12-4ea9-abb6-a23cfdb332d1",
                                                "sense_id": "f438de55-aa8e-3eaf-a945-d00d160b28c1",
                                                "text": "We have a new president: Barack Obama. I never thought a black man would be elected. It's exciting! It's history!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "history",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d107f1b9-2b5e-386f-b46e-46806212d212",
                                        "entry_id": "77fc76d2-5f0b-336d-ba5c-42323e4464b5",
                                        "glosses": [
                                            "To narrate or record."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "850af65e-e206-4f90-8c45-0d1fcb338726",
                                                "sense_id": "d107f1b9-2b5e-386f-b46e-46806212d212",
                                                "text": "And therefore will hee wipe his Tables cleane,\nAnd keepe no Tell-tale to his Memorie,\nThat may repeat, and Historie his losse"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
