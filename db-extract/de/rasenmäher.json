                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grasmaaier",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c81f64e5-c8a6-3a9f-9be1-1374a9afafdf",
                                        "entry_id": "c5017415-3241-3ad8-8e37-d17c278b4f89",
                                        "glosses": [
                                            "een machine om het gras te maaien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45fc148d-0af2-48ce-a40a-a710ebb3d9a7",
                                                "sense_id": "c81f64e5-c8a6-3a9f-9be1-1374a9afafdf",
                                                "text": "De grasmaaier werd niet vaak gebruikt door dat gezin."
                                            },
                                            {
                                                "example_id": "6dfc1ec9-4e5d-47a1-a7b5-c38d9eba4805",
                                                "sense_id": "c81f64e5-c8a6-3a9f-9be1-1374a9afafdf",
                                                "text": "Het is één grote chaos op Sint-Maarten. De verwoestingen zijn enorm. Alsof iemand met een grasmaaier vanuit de hemel over het eiland is gegaan, typeerde een ooggetuige de verwoestingen door orkaan Irma."
                                            },
                                            {
                                                "example_id": "1583e353-1b6f-4c15-99f0-5979e6bd9438",
                                                "sense_id": "c81f64e5-c8a6-3a9f-9be1-1374a9afafdf",
                                                "text": "Een bezoekje aan het eerste voetbalstadion van Qatar voelt, gevoelsmatig ver weg van de commercie, fijn aan. Terwijl een man met een grote grasmaaier over de middenstip sjeest, is bij de goal een gastarbeider bezig met een kruiwagen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d472f544-ba20-3f51-98fc-ce07c6c9f119",
                                        "entry_id": "c5017415-3241-3ad8-8e37-d17c278b4f89",
                                        "glosses": [
                                            "iemand die het gras maait"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad8160d3-5262-4ce5-a8ff-1cfb1289a4dd",
                                                "sense_id": "d472f544-ba20-3f51-98fc-ce07c6c9f119",
                                                "text": "Hoewel mijn vrouw het meeste werk verricht in de tuin, ben ik de grasmaaier van de familie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
