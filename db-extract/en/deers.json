                    {
                        "sense_id": "64a41057-162e-31c8-88e7-e5593518142b",
                        "entry_id": "756f2cac-6e9a-3e54-b267-046d9296c4bf",
                        "glosses": [
                            "plural of deer"
                        ],
                        "tags": [
                            "dated",
