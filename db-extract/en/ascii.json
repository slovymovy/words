        "de-extract.jsonl": [
            {
                "entry_id": "c681f81a-beed-3cd6-a539-9463d983d8ba",
                "word": "ASCII",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4581a9ad-e82b-3866-b5d0-396e90568cd0",
                        "entry_id": "c681f81a-beed-3cd6-a539-9463d983d8ba",
                        "glosses": [
                            "ASCII, ASCII-Code"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "f4ccb8cc-a487-49c7-a411-d269b853a520",
                                "sense_id": "4581a9ad-e82b-3866-b5d0-396e90568cd0",
                                "text": "„The first 128 characters of Unicode, which correspond one-to-one with ASCII, are encoded using a single octet with the same binary value as ASCII, making valid ASCII text valid UTF-8-encoded Unicode as well. “",
                                "translation": "Die sich eins-zu-eins mit ASCII deckenden ersten 128 Zeichen von Unicode werden durch ein einziges Oktett mit demselben Binärwert wie in ASCII kodiert, was gültigen ASCII-Text auch zu gültigem UTF-kodierten macht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85edec5c-5a0d-4cb5-915e-2864d459564e",
                        "source_entry_id": "c681f81a-beed-3cd6-a539-9463d983d8ba",
                        "source_sense_id": "4581a9ad-e82b-3866-b5d0-396e90568cd0",
                        "source_sense_description": "EDV: ASCII, ASCII-Code",
                        "target_lang_word": "ASCII",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ASCII",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a21db2fe-d6af-3a72-a1ca-1f48a9b0931c",
                                        "entry_id": "7aa7b4ea-54f7-3062-96df-d9febb4beea2",
                                        "glosses": [
                                            "genormter Code für die Darstellung von Zeichen"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "354729e0-125e-49e1-8d6a-20843f5df06f",
                                                "sense_id": "a21db2fe-d6af-3a72-a1ca-1f48a9b0931c",
                                                "text": "Die Menge der verfügbaren Zeichen wird durch die zugrunde liegende Kodierung bestimmt, am gebräuchlichsten sind hierbei ASCII oder Unicode."
                                            },
                                            {
                                                "example_id": "d8bfc4db-6669-493b-bd01-c31914c0d5b3",
                                                "sense_id": "a21db2fe-d6af-3a72-a1ca-1f48a9b0931c",
                                                "text": "„UTF-8 ist in den ersten 128 Zeichen (Indizes 0–127) deckungsgleich mit ASCII und eignet sich mit in der Regel nur einem Byte Speicherbedarf für Zeichen vieler westlicher Sprachen besonders für die Kodierung englischsprachiger Texte, die sich im Regelfall ohne Modifikation daher sogar mit nicht-UTF-8-fähigen Texteditoren ohne Beeinträchtigung bearbeiten lassen, was einen der Gründe für den Status als De-facto-Standard-Zeichenkodierung des Internets und damit verbundener Dokumenttypen darstellt. Im Mai 2016 verwendeten 86,9 % aller Websites UTF-8.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ec82a36-9a1c-4fd5-9b4a-01a641caec6e",
                        "source_entry_id": "c681f81a-beed-3cd6-a539-9463d983d8ba",
                        "source_sense_id": "4581a9ad-e82b-3866-b5d0-396e90568cd0",
