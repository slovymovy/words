                                                "example_id": "216c2339-79e6-44e7-b36f-6f71e50a82a2",
                                                "sense_id": "b9876b40-c067-3399-b513-d970a9d12c82",
                                                "text": "Ectopic chondrocyte hypertrophy has been demonstrated in OA, suggesting that the pathogenetical process involves a recapitulation of endochondral ossification [ 11 – 13 ]."
                                            }
