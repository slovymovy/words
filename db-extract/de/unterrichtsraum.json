                        "entry_id": "1c18bc8b-b49c-3cb6-a388-733f347a0b7a",
                        "glosses": [
                            "Raum, in dem unterrichtet wird; in dem ein Unterricht abgehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e9a60f6-1208-4b13-9238-32d5ca8be6e4",
                                "sense_id": "ff1bdda9-cfcf-3c8a-a05e-a1868aa76590",
                                "text": "„Die Tat spielte sich kurz vor 10 Uhr im Unterrichtsraum einer 10. Klasse des Josef-Hofmiller-Gymnasiums ab.“"
                            },
                            {
                                "example_id": "9a097c6a-a579-4057-bec1-589e235bdbf8",
                                "sense_id": "ff1bdda9-cfcf-3c8a-a05e-a1868aa76590",
                                "text": "„Eine Augenzeugin sagte, es habe gerade eine Prüfung begonnen, als der Täter den Unterrichtsraum betrat.“"
                            }
