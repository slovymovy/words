                ],
                "senses": [
                    {
                        "sense_id": "bb0f8dc8-ceb0-377d-aa22-5e33faa2fba6",
                        "entry_id": "185b42d2-a0e5-347a-8d67-6fb4ca3fda5b",
                        "glosses": [
                            "mathematische Teildisziplin, die sich mit den Gesetzmäßigkeiten der Übertragung und Verarbeitung von Information befasst"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "ac375943-5014-4cf2-a69a-0f4a106befae",
                                "sense_id": "bb0f8dc8-ceb0-377d-aa22-5e33faa2fba6",
                                "text": "„Die Entropie ist ein in der Informationstheorie definiertes Maß, dass [sic!] den Informationsgehalt einer Nachrichtenquelle (z.B. dem [sic!] Inhalt einer Datei) bewertet.“"
                            },
                            {
                                "example_id": "c437b55d-d66a-42f4-a4e6-bb16c55c1a35",
                                "sense_id": "bb0f8dc8-ceb0-377d-aa22-5e33faa2fba6",
                                "text": "„Etwas langwieriger, aber keineswegs schwieriger ist die Berechnung der Entropie, die aus der Informationstheorie übernommen wurde und sich daher an eine weit entwickelte Disziplin anlehnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
