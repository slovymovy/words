                "senses": [
                    {
                        "sense_id": "92769d30-fe35-3c55-b199-4508fa5fbd81",
                        "entry_id": "c3558e93-5763-3b0e-a6fe-5fd2a1f08101",
                        "glosses": [
                            "Studium der Theologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f876c2ae-f3d4-46cd-85c9-845f8dfaf0a1",
                                "sense_id": "92769d30-fe35-3c55-b199-4508fa5fbd81",
                                "text": "„Søren Kierkegaard wandte sich von seinem Vater ab, gab das Theologiestudium auf, nahm sich eine eigene Wohnung, führte in der Folge das Leben eines Dandys und Bohemiens.“"
                            },
                            {
                                "example_id": "94004bfd-f6f0-40fc-8bf1-1f07e3c17548",
                                "sense_id": "92769d30-fe35-3c55-b199-4508fa5fbd81",
                                "text": "„Das Theologiestudium hat er abgebrochen, Kommilitonen haben ihn als elegant gekleidet in Erinnerung, einen Wappenring am Zeigefinger tragend, mit schwermütigen Augen Gedichte rezitierend.“"
                            },
                            {
                                "example_id": "b7b71542-5b4a-47e3-a422-cb64c3de0572",
                                "sense_id": "92769d30-fe35-3c55-b199-4508fa5fbd81",
                                "text": "„Aber an Ari war definitiv kein Seelsorger verloren gegangen, nach seinem missglückten Theologiestudium, das längst Geschichte war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
