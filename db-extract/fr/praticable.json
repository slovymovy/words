        "fr-extract.jsonl": [
            {
                "entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                "word": "praticable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "70d09698-8e11-4855-9544-e82152f6100c",
                        "entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "praticables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb8d9db2-8f3e-32c1-b1be-9c698360043b",
                        "entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                        "glosses": [
                            "Qui peut être pratiqué, qui peut être employé, dont on peut se servir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8a49d41-ab50-44ba-aff6-79097eed83e8",
                                "sense_id": "eb8d9db2-8f3e-32c1-b1be-9c698360043b",
                                "text": "Il a employé tous les moyens praticables pour venir à bout de cette affaire. Si la chose est praticable, on s’en occupera."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c33b5db-18c5-3138-856a-1ac16f1c8166",
                        "entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                        "glosses": [
                            "Par lequel on peut passer aisément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd5cc897-910c-4a70-aff5-5a1157481bc2",
                                "sense_id": "0c33b5db-18c5-3138-856a-1ac16f1c8166",
                                "text": "Le sentier du bois conduit à un marais, et, de là, à un gué qui peut être praticable, les pluies ayant cessé."
                            },
                            {
                                "example_id": "fe689746-c021-4235-bbf5-ab3af20b2b29",
                                "sense_id": "0c33b5db-18c5-3138-856a-1ac16f1c8166",
                                "text": "Les cours d’eau étaient peu nombreux et facilement praticables."
                            },
                            {
                                "example_id": "2f16256f-e56b-4dd8-a6a1-1d2aea245c9a",
                                "sense_id": "0c33b5db-18c5-3138-856a-1ac16f1c8166",
                                "text": "Quant aux routes du Simplon et du Saint-Gothard, […], il ne faudrait que quelques heures pour les détruire ; car on a déjà assez de peine à les maintenir praticables dans la belle saison."
                            },
                            {
                                "example_id": "1d0741e9-5edb-4eac-a3b3-1e476216001e",
                                "sense_id": "0c33b5db-18c5-3138-856a-1ac16f1c8166",
                                "text": "Elles ont aplani pour le passage de l’armée fortunée les parties mauvaises de leurs chemins qu’elles ont rendus praticables."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9cf345e-7791-3bc6-afd3-cd817b2c3192",
                        "entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                        "glosses": [
                            "Qualifie une porte ou fenêtre du décor, qui n’est pas seulement figurée, et que l’on peut ouvrir ou fermer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573904f3-356c-4445-9c2c-9c288b411965",
                                "sense_id": "e9cf345e-7791-3bc6-afd3-cd817b2c3192",
                                "text": "Porte, fenêtre praticable."
                            },
                            {
                                "example_id": "71f22960-fbe1-4c76-a0ff-653f16ee9522",
                                "sense_id": "e9cf345e-7791-3bc6-afd3-cd817b2c3192",
                                "text": "La scène représente le cabinet d’un commissaire de police. À droite, une fenêtre praticable."
                            }
                        ]
                    },
                    {
                        "sense_id": "6eb1ca8f-f283-38a9-b7d5-425abb333052",
                        "entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                        "glosses": [
                            "Qualifie une personne avec laquelle il est facile et agréable d’entretenir des relations."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6dfef62a-f480-4481-a542-4dffcfea2c9b",
                                "sense_id": "6eb1ca8f-f283-38a9-b7d5-425abb333052",
                                "text": "Cet homme n’est pas praticable dans le commerce de la vie. — Son humeur quelquefois n’est pas praticable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "001a8d3c-6904-46a0-9209-604dc33fbea6",
                        "source_entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                        "target_lang_word": "machbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af6c0ac2-ebbd-3722-b6d2-897f6b7726cd",
                                        "entry_id": "69ec8ba5-49ce-33c2-8d55-667aa4637138",
                                        "glosses": [
                                            "so, dass man es durchführen/machen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3631a465-e350-4741-a26c-4f9493ba4e68",
                                                "sense_id": "af6c0ac2-ebbd-3722-b6d2-897f6b7726cd",
                                                "text": "Ungiftige Ölbekämpfung ist machbar."
                                            },
                                            {
                                                "example_id": "f6394e64-ccad-4d52-a586-ddc095a8e816",
                                                "sense_id": "af6c0ac2-ebbd-3722-b6d2-897f6b7726cd",
                                                "text": "Die Tour ist fast nur im Frühsommer machbar, wenn noch günstige Firnverhältnisse herrschen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31387c1e-b7e5-475a-bebc-60c779e9debf",
                        "source_entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                        "target_lang_word": "wegsam",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wegsam",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cde6691d-9305-3f12-b408-d9ca60b7d8eb",
                                        "entry_id": "445ccf8b-c2cf-3c32-a272-d084f0ffe85c",
                                        "glosses": [
                                            "Zutritt, Durchlass oder gutes Fortkommen bietend"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87b7d792-76db-4996-8330-6eb461731f4b",
                                                "sense_id": "cde6691d-9305-3f12-b408-d9ca60b7d8eb",
                                                "text": "Wird er uns in seinem nächsten Werk auf wegsamere - Pfade führen? Oder werden wir auf seinen Wegen mit der Zeit gehen lernen?"
                                            },
                                            {
                                                "example_id": "1785001c-251b-4a4d-a53e-81f27220685f",
                                                "sense_id": "cde6691d-9305-3f12-b408-d9ca60b7d8eb",
                                                "text": "Das Taubertal ist endlich höchst wegsam, liegt aber doch überall aus dem Wege. Dies will ich noch etwas näher erläutern."
                                            },
                                            {
                                                "example_id": "d1a36cd1-bd48-4043-a939-431a31a7ab00",
                                                "sense_id": "cde6691d-9305-3f12-b408-d9ca60b7d8eb",
                                                "text": "„Was darf man sich unter einem Qualitätsweg vorstellen? Einen Weg mit wegsameren Wegen, mit schöneren Naturschönheiten und höheren Highlights?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12be8a5f-eb10-4f89-bc6c-93800046e740",
                        "source_entry_id": "8c30cc89-b53c-3049-89f8-eaa640d8c143",
                        "target_lang_word": "practicable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "practicable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8168080-29dc-3ef0-8900-b935828af678",
                                        "entry_id": "73a615cb-5eb8-3af0-a580-19962e32b6ef",
                                        "glosses": [
                                            "Capable of being accomplished; feasible."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e49735-8841-4821-837b-ec5685e2a071",
                                                "sense_id": "f8168080-29dc-3ef0-8900-b935828af678",
                                                "text": "Those who have concerned themselves exclusively with what seemed practicable in the existing state of opinion have constantly found that even this has rapidly become politically impossible as the result of changes in a public opinion which they have done nothing to guide."
                                            },
                                            {
                                                "example_id": "cc2bc982-c59c-4120-81c0-347d61fa114c",
                                                "sense_id": "f8168080-29dc-3ef0-8900-b935828af678",
                                                "text": "The law in most states says that cyclists must ride as far to the right as is practicable."
                                            },
                                            {
                                                "example_id": "f93dea53-1452-4f58-b0c1-460c2dfa94cc",
                                                "sense_id": "f8168080-29dc-3ef0-8900-b935828af678",
                                                "text": "This sober and unflinching analysis should be read and reckoned with by anyone concerned with practicable change in the long-suffering region."
                                            },
                                            {
                                                "example_id": "700d4b37-31ad-4457-8270-071028e48243",
                                                "sense_id": "f8168080-29dc-3ef0-8900-b935828af678",
                                                "text": "“The player should usually be able to play more quickly than that and is encouraged to do so,” the guidelines state, with golfers that exceed 40 seconds – AKA “bad time” – “informed as soon as practicable” by a tournament official."
                                            },
                                            {
                                                "example_id": "6f1fe804-1ca7-436a-9e14-20ed64092666",
                                                "sense_id": "f8168080-29dc-3ef0-8900-b935828af678",
                                                "text": "Monday’s executive order called on the secretary of state and director of the Office of Management and Budget to pause funding “with all practicable speed.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80c9366c-afd1-35dd-aaab-1250fb2bd95b",
                                        "entry_id": "73a615cb-5eb8-3af0-a580-19962e32b6ef",
                                        "glosses": [
                                            "Serving a useful function; useful, functional or handy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19803396-a20b-385d-a2a6-48d5a42b40c3",
                                        "entry_id": "73a615cb-5eb8-3af0-a580-19962e32b6ef",
                                        "glosses": [
                                            "Available for use; accessible or employable."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13f10b83-ff18-40f4-964e-780431926c12",
                                                "sense_id": "19803396-a20b-385d-a2a6-48d5a42b40c3",
                                                "text": "I glanced up, — there was no trap door which led to the roof. No practicable nook or cranny, in which a living being could lie concealed, was anywhere at hand."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
