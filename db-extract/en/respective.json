                                        "examples": [
                                            {
                                                "example_id": "4975e079-ca11-46d9-8d3e-5d62d63e7bd3",
                                                "sense_id": "b6c535eb-d057-3668-b8de-606b5c9d7e03",
                                                "text": "Jeder der drei Physiker ermordet eine Krankenschwester, um sein jeweiliges Geheimnis zu wahren."
                                            },
                                            {
                                                "example_id": "f9b0406b-f2ff-430a-906f-dba68e35e766",
                                                "sense_id": "b6c535eb-d057-3668-b8de-606b5c9d7e03",
                                                "text": "„So unterschiedlich das jeweilige Krisenmanagement auch ist - gemeinsam ist doch allen die Erkenntnis, dass es so jedenfalls keinesfalls weitergehen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
