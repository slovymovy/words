    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "362f65a5-caef-3b8c-a61f-5f288ff740ac",
                    "sense_definition": "present participle and gerund of <w>snarl</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stray dog was backed into a corner and was <w>snarling</w> aggressively at everyone.",
                            "target_lang_translations": {
                                "ru": "Бездомная собака была загнана в угол и агрессивно <w>рычала</w> на всех подряд."
                            }
                        },
                        {
                            "text": "He walked away while angrily <w>snarling</w> threats under his breath.",
                            "target_lang_translations": {
                                "ru": "Он ушел, сердито <w>цедя</w> угрозы сквозь зубы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snarling at someone",
                        "growling and snarling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола snarl (рычать, огрызаться, скалиться)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рычащий",
                                "target_lang_sense_clarification": "причастие: издающий рычание"
                            },
                            {
                                "target_lang_word": "скалящийся",
                                "target_lang_sense_clarification": "причастие: показывающий зубы со злобой"
                            },
                            {
