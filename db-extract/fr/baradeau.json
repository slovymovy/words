                        "glosses": [
                            "Fossé pour l’écoulement des eaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cedd1219-9d54-46bb-9c68-5812dde3f3d4",
                                "sense_id": "6839e278-e1cb-3953-b59d-e072e136f19d",
                                "text": "Arrivant au bord de la route, elle fit un crochet. Un baradeau se trouvait là. On nomme ainsi, dans les Landes, le fossé qui délimite les champs, longe les chemins, et qui est généralement embroussaillé de mûriers."
                            },
                            {
                                "example_id": "ad205744-f4aa-4ee0-a79e-c1007a4d9816",
                                "sense_id": "6839e278-e1cb-3953-b59d-e072e136f19d",
                                "text": "La présence d’un fossé, d’un baradeau, d’un sentier suffisait, dans les circonstances ordinaires, pour rendre efficaces les efforts des travailleurs accourus pour combattre le sinistre."
                            }
                        ]
                    }
