                        "cross_references": []
                    },
                    {
                        "translation_id": "1adb5ab1-478e-4a84-9d13-1d4f0ed84cec",
                        "source_entry_id": "bda8360f-3009-3640-8026-53bced4c0a79",
                        "source_sense_id": "f8947ccd-787f-3485-91cb-e3415878e1aa",
                        "source_sense_description": "Kopf eines Hundes",
                        "target_lang_word": "hondenkop",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hondenkop",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4b0480d3-d0c8-3733-aece-53757164bc5e",
                                        "entry_id": "c4d9a563-c434-350f-bc33-1adf945b06a4",
                                        "glosses": [
                                            "kop van een hond"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cf119a5-6d81-4ee3-9a47-9a70e2472760",
                                                "sense_id": "4b0480d3-d0c8-3733-aece-53757164bc5e",
                                                "text": "Op een van de eerste foto’s die ooit van me is genomen, lig ik in een dekentje gerold op mijn moeders arm. Maar dat is niet het focuspunt van de foto. De aandacht gaat meteen uit naar die grote hondenkop die nieuwsgierig toekijkt."
                                            },
                                            {
                                                "example_id": "240327f0-b1c7-4904-a344-29a3378021b0",
                                                "sense_id": "4b0480d3-d0c8-3733-aece-53757164bc5e",
                                                "text": "De dag daarop duikt de herinnering aan die hondenkop nog af en toe op, iedere keer met een zekere ontroering. Hoe kleverig sentimenteel dat woord ook moge wezen in verband met dieren, het is niet anders: ik liep erlangs en was ontroerd door de manier waarop die hond achterom naar dat wiel keek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5da7e840-13f4-3ec7-b8f2-b5ed0b6c4f3a",
                                        "entry_id": "c4d9a563-c434-350f-bc33-1adf945b06a4",
                                        "glosses": [
                                            "gelaat met forse, brede kaken"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5887549-a1df-4d52-b74d-63c0c8c504f4",
                                                "sense_id": "5da7e840-13f4-3ec7-b8f2-b5ed0b6c4f3a",
                                                "text": "Aan hun looks kan het in ieder geval niet liggen, zegt hij. Want de gitarist lijkt meer op een derderangs komiek dan op een rockgod, achter de drums zit een afzichtelijke kale dwerg, en zelf is Knight een gebochelde bonk spieren met een hondenkop én een matje."
                                            },
                                            {
                                                "example_id": "0b099c6d-b2e8-4aee-8f62-b8049e0f0948",
                                                "sense_id": "5da7e840-13f4-3ec7-b8f2-b5ed0b6c4f3a",
                                                "text": "Dieren die niets met elkaar te maken hebben, lijken soms toch erg op elkaar. Zelfs heel verschillende soorten kunnen grote overeenkomsten hebben. (…) En baasjes van pitbulls of andere vechthonden hebben zelf soms ook hondenkoppen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef7c2f1-91f6-3672-8ae4-1ce7ce15d967",
                                        "entry_id": "c4d9a563-c434-350f-bc33-1adf945b06a4",
                                        "glosses": [
                                            "type passagierstrein Materieel '54"
                                        ],
                                        "tags": [
                                            "Nederland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dad68e2-f143-4a7d-9d31-8060c7c64bb1",
                                                "sense_id": "cef7c2f1-91f6-3672-8ae4-1ce7ce15d967",
                                                "text": "De hondenkop maakt samen met een andere historische trein, de muizenneus, deze zomer weer ritjes over het spoor tussen Utrecht en Amersfoort."
                                            },
                                            {
                                                "example_id": "c721e2b9-6c6c-4b98-8594-2ec00eaa5d02",
                                                "sense_id": "cef7c2f1-91f6-3672-8ae4-1ce7ce15d967",
                                                "text": "Op een ander perron stopt een dubbeldekker. En daarachter een gewone hondenkop, wijst mijn vader."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
