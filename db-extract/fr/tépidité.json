                "senses": [
                    {
                        "sense_id": "71471ef4-6db7-3652-9814-c5baae022f5c",
                        "entry_id": "e0d85947-7b59-39b3-88dc-54779db815e9",
                        "glosses": [
                            "Tiédeur."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cb4213b5-ac28-414e-beae-78d70cd8a94b",
                                "sense_id": "71471ef4-6db7-3652-9814-c5baae022f5c",
                                "text": "Revenu de la Trappe à Paris, il vécut dans un état d’anémie spirituelle, affreux. L’âme gardait la chambre, se levait à peine, traînait sur une chaise longue, somnolait dans la tépidité d’une langueur que berçait encore le ronronnement de prières."
                            },
                            {
                                "example_id": "edc9429c-049c-4323-a5fd-b038d3293f4b",
                                "sense_id": "71471ef4-6db7-3652-9814-c5baae022f5c",
                                "text": "La galerie projetée “doublerait” l’édifice, ajouterait un matelas d’air qui en permettrait, favoriserait, si ce n’est la chaleur au moins la tépidité."
                            },
                            {
                                "example_id": "43ed3509-0f85-467a-881f-eeae3913852c",
                                "sense_id": "71471ef4-6db7-3652-9814-c5baae022f5c",
                                "text": "Elle n'aime point les tièdes, « les amoureuses de leur tépidité », mais elle redoute plus encore les mortifications exagérées « qui surchargent et bandent l'esprit et accablent le corps »."
                            }
                        ]
                    }
                ],
