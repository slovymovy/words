                "senses": [
                    {
                        "sense_id": "fc2b7dae-146f-325d-8093-3299b678cc19",
                        "entry_id": "dbfdcc45-0fd2-3370-a9e3-0190d2f01261",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, das nicht für regelmäßige Gottesdienste einer Gemeinde bestimmt ist und auf einem Kalvarienberg steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5421e694-4f8d-46a4-93af-6877ef0483f0",
                                "sense_id": "fc2b7dae-146f-325d-8093-3299b678cc19",
                                "text": "„Die Kalvarienbergkapelle zählt sicherlich zu einer der schönsten und interessantesten in Kärnten.“"
                            },
                            {
                                "example_id": "ce30b146-31cf-4669-abd6-2eb1f9a1d85d",
                                "sense_id": "fc2b7dae-146f-325d-8093-3299b678cc19",
                                "text": "„Etwa 300m westlich der Pfarrkirche steht nahe beim hier beginnenden Stationsweg hinauf nach Maria Kunterweg die eindrucksvolle Kalvarienbergkapelle.“"
                            },
                            {
                                "example_id": "2b10efca-b106-451d-a6b4-36b50fa9aa1d",
                                "sense_id": "fc2b7dae-146f-325d-8093-3299b678cc19",
                                "text": "„Die Kalvarienbergkapelle mit der Kreuzigungsgruppe ist eine gern besuchte Gebetsstätte in Mähring.“"
                            },
                            {
                                "example_id": "c39ecbf4-1cc0-4c99-91d2-d5ca71edf257",
                                "sense_id": "fc2b7dae-146f-325d-8093-3299b678cc19",
                                "text": "„Ein barocke Kalvarienbergkapelle befindet sich im Flachgau in Oberndorf bei Salzburg an der Salzach.“"
                            },
                            {
                                "example_id": "493bcbd9-e87f-4cfd-a432-c3977de62351",
                                "sense_id": "fc2b7dae-146f-325d-8093-3299b678cc19",
                                "text": "In dieser 1699 fertiggestellten und somit ältesten Kalvarienbergkapelle des Salzkammergutes, befinden sich eine barocke Kreuzigungsgruppe und alte Wandbilder."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
