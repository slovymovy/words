                    "sense_id": "9ae8fefb-ef1f-34dc-ac16-f8e514130320",
                    "sense_definition": "Maintenir en bon état, garder intact ou protéger de la dégradation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est essentiel de <w>préserver</w> l'environnement pour les générations futures.",
                            "target_lang_translations": {
                                "en": "It is essential to <w>preserve</w> the environment for future generations.",
                                "ru": "Важно <w>сохранить</w> окружающую среду для будущих поколений.",
                                "nl": "Het is essentieel om het milieu voor toekomstige generaties te <w>behouden</w>.",
                                "de": "Es ist wichtig, die Umwelt für zukünftige Generationen zu <w>erhalten</w>.",
                                "pl": "Istotne jest, aby <w>chronić</w> środowisko dla przyszłych pokoleń.",
                                "it": "È essenziale <w>preservare</w> l'ambiente per le generazioni future.",
                                "cs": "Je zásadní <w>zachovat</w> životní prostředí pro budoucí generace.",
                                "tr": "Gelecek nesiller için çevreyi <w>korumak</w> çok önemlidir.",
                                "es": "Es esencial <w>conservar</w> el medio ambiente para las generaciones futuras.",
                                "zh": "<w>保护</w>环境对子孙后代来说至关重要。"
                            }
                        },
                        {
                            "text": "Cette association cherche à <w>préserver</w> le patrimoine historique de la région.",
                            "target_lang_translations": {
                                "en": "This association is trying to <w>preserve</w> the region's historical heritage.",
                                "ru": "Эта ассоциация стремится <w>сохранить</w> историческое наследие региона.",
                                "nl": "Deze vereniging probeert het historische erfgoed van de regio te <w>behouden</w>.",
                                "de": "Dieser Verein bemüht sich, das historische Erbe der Region zu <w>bewahren</w>.",
                                "pl": "To stowarzyszenie stara się <w>chronić</w> historyczne dziedzictwo regionu.",
                                "it": "Questa associazione cerca di <w>preservare</w> il patrimonio storico della regione.",
                                "cs": "Toto sdružení se snaží <w>zachovat</w> historické dědictví regionu.",
                                "tr": "Bu dernek, bölgenin tarihi mirasını <w>korumaya</w> çalışıyor.",
                                "es": "Esta asociación busca <w>conservar</w> el patrimonio histórico de la región.",
                                "zh": "这个协会致力于<w>保存</w>该地区的历史遗产。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conserver",
                        "protéger",
                        "sauvegarder"
                    ],
                    "antonyms": [
                        "abîmer",
                        "dégrader",
                        "détruire"
                    ],
                    "common_phrases": [
                        "préserver l'environnement",
                        "préserver la nature",
                        "préserver le patrimoine"
                    ],
                    "target_lang_definitions": {
                        "en": "To keep something in good condition, intact, or protected from deterioration.",
                        "ru": "Поддерживать что-либо в хорошем состоянии, сохраняя его целостность или защищая от порчи.",
                        "nl": "Iets in goede staat houden, intact laten of beschermen tegen verval.",
                        "de": "Etwas in gutem Zustand halten, unversehrt erhalten oder vor Verfall schützen.",
                        "pl": "Utrzymywać coś w dobrym stanie i nienaruszonym lub chronić przed zniszczeniem.",
                        "it": "Mantenere qualcosa in buono stato, intatto o al riparo dal deterioramento.",
                        "cs": "Udržovat něco v dobrém stavu, zachovat to neporušené nebo to chránit před zhoršováním.",
                        "tr": "Bir şeyi iyi durumda tutmak, zarar görmesini ya da bozulmasını önlemek.",
                        "es": "Mantener algo en buen estado, intacto o protegido de su deterioro.",
                        "zh": "使事物保持良好状态、完好无损，或防止其受损、变质。"
                    },
