                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "13915a1e-639a-3478-aab8-327f2a45b045",
                        "entry_id": "466b8d92-f917-34b5-9a56-0d1087d5144a",
                        "glosses": [
                            "daarbij, ook"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4f8b170-5fe2-47b1-b4a3-c22d18df38c6",
                                "sense_id": "13915a1e-639a-3478-aab8-327f2a45b045",
                                "text": "Het tweede en tevens laatste boekje."
                            },
                            {
                                "example_id": "0210213f-5419-48ec-815e-d4e31c079eb8",
                                "sense_id": "13915a1e-639a-3478-aab8-327f2a45b045",
                                "text": "Het douchegordijn fungeerde tevens als tent en regenponcho."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97454d64-2ba1-4f6b-8440-3d576b55e60b",
                        "source_entry_id": "466b8d92-f917-34b5-9a56-0d1087d5144a",
                        "source_sense_id": "13915a1e-639a-3478-aab8-327f2a45b045",
                        "source_sense_description": "daarbij, ook",
                        "target_lang_word": "zugleich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zugleich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4781c923-7a2c-3507-af0d-af5d6628a529",
                                        "entry_id": "0b5f7d23-8979-3259-8235-55ffabf05930",
                                        "glosses": [
                                            "zur gleichen Zeit mit etwas anderem ablaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "580bfc59-c95d-4be5-9d1e-95dab9e857d0",
                                                "sense_id": "4781c923-7a2c-3507-af0d-af5d6628a529",
                                                "text": "Es stürmte und regnete zugleich."
                                            },
                                            {
                                                "example_id": "9c824681-45a8-4d2e-a1a3-7514c91cf707",
                                                "sense_id": "4781c923-7a2c-3507-af0d-af5d6628a529",
                                                "text": "Sie lachte und weinte zugleich."
                                            },
                                            {
                                                "example_id": "da0a49af-f58a-46ff-a1cc-4a9627a084f2",
                                                "sense_id": "4781c923-7a2c-3507-af0d-af5d6628a529",
                                                "text": "„Richtig wäre es gewesen, den Menschen in beiden Teilen Deutschlands reinen Wein einzuschenken und ihnen zugleich Zuversicht zu vermitteln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                        "entry_id": "0b5f7d23-8979-3259-8235-55ffabf05930",
                                        "glosses": [
                                            "auch noch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13ae7547-15b2-407b-8d23-7f0cedf1f280",
                                                "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                                "text": "Zugleich mit dem Sturm kam heftiger Regen auf."
                                            },
                                            {
                                                "example_id": "64815d40-dc87-4309-84f8-5c6d4d654a63",
                                                "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                                "text": "Sie ist Unternehmerin und zugleich Mutter einer vierjährigen Tochter."
                                            },
                                            {
                                                "example_id": "e7250c8f-8b15-4ac0-ac30-214f0c59dd5f",
                                                "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                                "text": "Das Buch ist zugleich informativ und spannend."
                                            },
                                            {
                                                "example_id": "0292c0a5-3df2-4f3a-8274-79abfa7e0e18",
                                                "sense_id": "108ab334-3cf9-348a-b650-583c96eef635",
                                                "text": "„Die Holzdielen sind herausgerissen, aber in der Turnhalle, die zugleich Aula war, hängen noch die Basketballkörbe an der Wand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7da766fa-9ea2-41ab-ade8-1c426fe97665",
                        "source_entry_id": "466b8d92-f917-34b5-9a56-0d1087d5144a",
                        "source_sense_id": "13915a1e-639a-3478-aab8-327f2a45b045",
                        "source_sense_description": "daarbij, ook",
                        "target_lang_word": "en même temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en même temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "787e6230-2627-32be-bc3d-54a8132172c5",
                                        "entry_id": "a2bf9223-2ef3-394d-8be8-762ffd25562b",
                                        "glosses": [
                                            "Durant ce même moment, ce même instant, dans le même instant, à la même heure, ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a2bbc2c-222f-46e1-8aab-f6ed389e38d5",
                                                "sense_id": "787e6230-2627-32be-bc3d-54a8132172c5",
                                                "text": "[…] ; et pour joindre la démonstration au précepte, il décoiffa en même temps une bouteille de laffitte mûri aux feux de la comète de 1811, et une bouteille de clos-Vougeot, enfant capiteux de l’année 1815 ; […]."
                                            },
                                            {
                                                "example_id": "608d62be-18d9-4e63-b200-59036d2aea6e",
                                                "sense_id": "787e6230-2627-32be-bc3d-54a8132172c5",
                                                "text": "L’an premier dut commencer le 22 septembre 1792, jour de proclamation de la République et en même temps de l’équinoxe d’automne."
                                            },
                                            {
                                                "example_id": "927e606a-d659-40bb-bbba-360b9dc17881",
                                                "sense_id": "787e6230-2627-32be-bc3d-54a8132172c5",
                                                "text": "L’eau d'un diamant est un terme difficile à définir, car tout le monde n'est pas bien d'accord sur sa signification : l'opinion la plus générale est cependant que l’eau désigne en même temps la blancheur, la limpidité et l'éclat."
                                            },
                                            {
                                                "example_id": "0608d125-2c0a-41e5-8df2-62ad22af8a15",
                                                "sense_id": "787e6230-2627-32be-bc3d-54a8132172c5",
                                                "text": "Avez-vous parfois enduré cette trinité de supplices : la faim, la soif, la chaleur ?… Avez-vous eu en même temps l’estomac creux, le gosier sec, le crâne en feu ?"
                                            },
                                            {
                                                "example_id": "3ecac330-360f-4e4d-b71f-26699e90c2dd",
                                                "sense_id": "787e6230-2627-32be-bc3d-54a8132172c5",
                                                "text": "Chaque coup m’abrutissait davantage mais en même temps me raffermissait dans ma décision : ne pas céder à ces brutes qui se flattaient d’être les émules de la Gestapo."
                                            },
                                            {
                                                "example_id": "3e53fb33-8c7a-4044-936f-1b81e19b8d4e",
                                                "sense_id": "787e6230-2627-32be-bc3d-54a8132172c5",
                                                "text": "[…] ; vous les béguines au noir bonnet, vous direz vos patenôtres au lieu de radoter sur l’un et l’autre et en même temps ça vous diminuera votre temps de purgatoire."
                                            },
                                            {
                                                "example_id": "5b1d2024-05ad-48cb-89e3-c176b6b734d0",
                                                "sense_id": "787e6230-2627-32be-bc3d-54a8132172c5",
                                                "text": "Tout en reconnaissant la dualité de son pouvoir, matériel et sacré, Macron, en même temps, fonde son exercice sur une vision purement entrepreneuriale de l’humain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd61b2c1-9578-3949-a1e8-4103c2bb6165",
                                        "entry_id": "a2bf9223-2ef3-394d-8be8-762ffd25562b",
                                        "glosses": [
                                            "Or ; d’autre part ; cependant ; néanmoins ; mais. — Note d’usage : Il est alors placé en début de phrase."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15d32cfd-c70b-402e-92c7-f51d4d599d2f",
                                                "sense_id": "fd61b2c1-9578-3949-a1e8-4103c2bb6165",
                                                "text": "Ce sont des éléments rassurants… Et en même temps, tu as besoin aussi d’aller plus loin, et tu fais une psychanalyse, tu fais du psychodrame, etc. et tu rentres dans le conflit, dans la relation, dans l’interaction."
                                            },
                                            {
                                                "example_id": "c7c6bd62-7d8f-4c5e-8afc-42f99e634030",
                                                "sense_id": "fd61b2c1-9578-3949-a1e8-4103c2bb6165",
                                                "text": "C'est sûr, il n'a pas inventé le bidon de deux litres. Mais en même temps, s'il était plus intelligent, il serait peut-être moins brave."
                                            },
                                            {
                                                "example_id": "c214b136-781a-4a74-823e-ec9cbf3d8b20",
                                                "sense_id": "fd61b2c1-9578-3949-a1e8-4103c2bb6165",
                                                "text": "En même temps, lorsqu’un Président nomme quelqu’un ministre, il le fait parce qu’il pense que c’est bon pour son pays, pas pour en faire son obligé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "en même temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0725ee1-a2a5-3776-a7fe-6f3ad9ef0b87",
                                        "entry_id": "1bdaee37-3752-3cfb-a036-0e4d23e558e1",
                                        "glosses": [
                                            "Ligne de conduite (généralement associée au président Emmanuel Macron) consistant suivre simultanément des principes contradictoires ou à faire simultanément choses incompatibles ou incohérentes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e6bdd87-cb71-4fee-9cee-29310db6e318",
                                                "sense_id": "e0725ee1-a2a5-3776-a7fe-6f3ad9ef0b87",
                                                "text": "On dit qu’on est confiné mais depuis les premiers jours, le confinement n’est pas respecté. On est en permanence dans le « en même temps ». Il n’y a pas de ligne."
                                            },
                                            {
                                                "example_id": "5105a948-72ea-464a-bbf4-93a0de41eb91",
                                                "sense_id": "e0725ee1-a2a5-3776-a7fe-6f3ad9ef0b87",
                                                "text": "On ne doit avoir qu'une obsession : être utiles. Et ça veut dire pour la droite bâtir une politique qui ne soit pas du « en même temps »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
