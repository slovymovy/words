                "senses": [
                    {
                        "sense_id": "c981e5af-2c08-305b-9cf3-aa9c36a20e1a",
                        "entry_id": "595a8c3c-4907-3ab4-8fbf-84aa56efcb9f",
                        "glosses": [
                            "Action parentale, le fait d’agir et de s’affirmer en tant que parents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff310a02-1008-4fe7-a4e5-737ce5f8dfa3",
                                "sense_id": "c981e5af-2c08-305b-9cf3-aa9c36a20e1a",
                                "text": "La parentalité englobe les pratiques éducatives destinées aux enfants."
                            },
                            {
                                "example_id": "b6343513-4743-47a7-b1e5-481e85da8522",
                                "sense_id": "c981e5af-2c08-305b-9cf3-aa9c36a20e1a",
                                "text": "La parentalité commence avant la naissance."
                            },
                            {
                                "example_id": "fcd5ea7c-a6ec-4b7f-bfd5-1e90cf6f30c5",
                                "sense_id": "c981e5af-2c08-305b-9cf3-aa9c36a20e1a",
                                "text": "Les enjeux de la parentalité."
                            },
                            {
                                "example_id": "423aa2b3-5473-4f21-aabc-23a2558fb98b",
                                "sense_id": "c981e5af-2c08-305b-9cf3-aa9c36a20e1a",
                                "text": "L’exercice de la parentalité devient de plus en plus complexe."
                            },
                            {
                                "example_id": "2bf730bb-f79b-4cd4-b866-d695b9dd7244",
                                "sense_id": "c981e5af-2c08-305b-9cf3-aa9c36a20e1a",
                                "text": "La parentalité périnatale englobe la synergie potentielle dans un espace conjugal et familial de trois processus indissociable : (re)devenir mère (maternalité), (re)devenir père (paternalité) et nâitre humain."
                            }
                        ]
                    }
