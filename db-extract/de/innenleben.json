                        "entry_id": "7ae20130-3566-3ce8-94a9-5f76f52a6f75",
                        "glosses": [
                            "sichtbarer Funktionsmechanismus eines Gerätes oder Ähnlichem, wenn dieses offen ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
