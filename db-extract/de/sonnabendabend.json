                        "examples": [
                            {
                                "example_id": "bbff0281-0fea-423a-a4f7-045e9da40952",
                                "sense_id": "3e690abb-5076-382d-8293-672a25bbab57",
                                "text": "Ist jetzt endlich Sonnabendabend? Ich will die neue Quizsendung sehen."
                            },
                            {
                                "example_id": "be36fff0-888f-4ddc-a444-58ae9edead5b",
                                "sense_id": "3e690abb-5076-382d-8293-672a25bbab57",
                                "text": "Viele Sonnabendabende hat meine Familie mit dem Ausbau der Modelleisenbahn im Keller verbracht."
                            },
                            {
                                "example_id": "56bb014d-6ee2-4141-8102-476a85f34bfb",
                                "sense_id": "3e690abb-5076-382d-8293-672a25bbab57",
                                "text": "„Sonnabendabend war anders als Freitagabend oder Mittwochabend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
