                    {
                        "sense_id": "dc7ba834-0530-3261-a423-7146f3e2d458",
                        "entry_id": "63884c68-c04c-3faa-a34a-d5974a75faef",
                        "glosses": [
                            "miłośnik lub twórca memów"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "aade56f1-226f-45af-a19b-6f104e6636a8",
                                "sense_id": "dc7ba834-0530-3261-a423-7146f3e2d458",
                                "text": "Stworzenie fałszywego nagrania jest dziś banalnie proste, a będzie jeszcze łatwiejsze. Jeśli dodamy do tego generatory głosu wiernie naśladujące barwę wybranej osoby, wkroczymy w świat, w którym trudno będzie odróżnić prawdę od fikcji, realne wystąpienie polityka od grafiki stworzonej przez memiarza"
                            },
                            {
                                "example_id": "33c26fd3-2151-4699-a635-43635068387c",
                                "sense_id": "dc7ba834-0530-3261-a423-7146f3e2d458",
                                "text": "Czy teraz prokurator będzie ścigał „memiarzy” (…)?"
                            },
                            {
                                "example_id": "2fa78894-ffb1-441f-a83a-e1ff7560fd5a",
                                "sense_id": "dc7ba834-0530-3261-a423-7146f3e2d458",
                                "text": "Tam na bank jest ktoś podstawiony wśród doradców. Taki memiarz, który podpowiada takie rzeczy żebyśmy my zwykli ludzie mogli mieć bekę ;)"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
