                                                "example_id": "e5e39a35-c53e-4d8d-9cf2-069419f4d3ae",
                                                "sense_id": "67a5bf56-18d3-3fd5-b6f9-ed62275a9220",
                                                "text": "Le Marquis.– Elle ? c’était une drôlesse de la pire espèce…"
                                            }
                                        ]
