                        "source_sense_id": "595dacdd-8f28-323d-8f9a-0a20f845df7c",
                        "source_sense_description": "Dieb, der aus Hotels stiehlt",
                        "target_lang_word": "rat d’hôtel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rat d’hôtel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d20b2251-6a56-3cb0-bf19-5a072b44e019",
                                        "entry_id": "6fb0f3f4-370d-32e9-8116-3f5a7de3053e",
                                        "glosses": [
                                            "Voleur dont la spécialité est de s’introduire dans les chambres d’hôtel pour dévaliser les voyageurs."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9f4b169-eaf7-466b-9b5f-6e13c987f369",
                                                "sense_id": "d20b2251-6a56-3cb0-bf19-5a072b44e019",
                                                "text": "[…] mystérieux comme quelque rat d’hôtel qui a guetté dans l’ombre l’occasion propice pour cambrioler une chambre […]"
                                            },
                                            {
                                                "example_id": "3e49c3fb-1a87-4209-8aa4-ddef65686471",
                                                "sense_id": "d20b2251-6a56-3cb0-bf19-5a072b44e019",
                                                "text": "Il découvrira le véritable rat d’hôtel qui est une souris […]."
                                            },
                                            {
                                                "example_id": "29b2267c-80a6-4804-bae4-3d02acfb853b",
                                                "sense_id": "d20b2251-6a56-3cb0-bf19-5a072b44e019",
                                                "text": "Y avait combien d’temps que, j’roupillais j’n’en sais rien. Toujours est-il qu’il me sembla tout à coup, mille peaux d’mulots, entendre quéque^([sic]) chose grincer dans la serrure. Scrongnieugnieu ! que j’me dis en ouvrant l’orbitre^([sic]) de l’œil dans les ténèbres, ça serait-y, mufrerie d’sort, un rat d’hôtel qui vient m’faire les poches. L’citoyen va passer un foutu quart d’heure !"
                                            },
                                            {
                                                "example_id": "3f5397e6-67a0-42bc-8a54-0fc2851d88ec",
                                                "sense_id": "d20b2251-6a56-3cb0-bf19-5a072b44e019",
                                                "text": "Ainsi, dit-on, l’hôtelier n’est pas davantage fautif lorsque le vol des effets de son client est le fait d’un rat d’hôtel que lorsqu’il est dû à une attaque à main armée […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
