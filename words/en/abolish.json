{
    "word_family": [
        "abolition",
        "abolitionist",
        "abolishment",
        "abolitionism"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "74d1836a-9fb7-31ba-ada5-5bb7cc8ee853",
                    "sense_definition": "To end a law, system, institution, custom or practice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "termination of laws",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many activists worked tirelessly to <w>abolish</w> slavery during the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "Многие активисты неустанно работали над тем, чтобы <w>отменить</w> рабство в девятнадцатом веке."
                            }
                        },
                        {
                            "text": "The government decided to <w>abolish</w> the death penalty after years of public debate.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>отменить</w> смертную казнь после многолетних общественных дебатов."
                            }
                        }
                    ],
                    "synonyms": [
                        "abrogate",
                        "annul",
                        "nullify",
                        "repeal",
                        "revoke",
                        "do away with"
                    ],
                    "antonyms": [
                        "establish",
                        "found"
                    ],
                    "common_phrases": [
                        "abolish the death penalty",
                        "abolish slavery",
                        "abolish a law",
                        "abolish taxes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отменить закон, систему, организацию, обычай или практику."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отменять",
                                "target_lang_sense_clarification": "закон или правило"
                            },
                            {
                                "target_lang_word": "упразднять",
                                "target_lang_sense_clarification": "официально прекращать существование института или должности"
                            },
                            {
                                "target_lang_word": "аннулировать",
                                "target_lang_sense_clarification": "объявлять недействительным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8522d804-9083-398a-8df5-a2c21d563253",
                    "sense_definition": "To put an end to or destroy, as a physical object; to wipe out.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight sought to <w>abolish</w> the stain on his honor with his own blood.",
                            "target_lang_translations": {
                                "ru": "Рыцарь стремился <w>смыть</w> пятно со своей чести собственной кровью."
                            }
                        },
                        {
                            "text": "He reached for his sword as if he intended to <w>abolish</w> his enemy entirely.",
                            "target_lang_translations": {
                                "ru": "Он потянулся к мечу, словно намеревался полностью <w>уничтожить</w> своего врага."
                            }
                        }
                    ],
                    "synonyms": [
                        "cancel",
                        "dissolve"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature to mean physical destruction"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Положить конец чему-либо или уничтожить физический объект; полностью стереть."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уничтожать",
                                "target_lang_sense_clarification": "прекращать существование чего-либо"
                            },
                            {
                                "target_lang_word": "искоренять",
                                "target_lang_sense_clarification": "полностью устранять (обычно переносное)"
                            },
                            {
                                "target_lang_word": "ликвидировать",
                                "target_lang_sense_clarification": "устранять или избавляться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}