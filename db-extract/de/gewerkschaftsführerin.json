                "senses": [
                    {
                        "sense_id": "61805cc7-837d-3bdf-acae-6334fa3523ab",
                        "entry_id": "a27f3fff-19dd-3c53-ac1e-dc9807cb6ef6",
                        "glosses": [
                            "weibliche Person, die eine oder mehrere Gewerkschaften bei Tarifverhandlungen und nach außen vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e5516fa-72b2-4458-8337-11317695f8aa",
                                "sense_id": "61805cc7-837d-3bdf-acae-6334fa3523ab",
                                "text": "„Innerhalb des regional zersplitterten VHTL sieht sich die auch französisch- und italienischkundige Gewerkschaftsführerin als Integrationsfigur.“"
                            },
                            {
                                "example_id": "dea8ec71-944a-45af-88da-a695a89105e8",
                                "sense_id": "61805cc7-837d-3bdf-acae-6334fa3523ab",
                                "text": "„Im Alter von 20 Jahren wurde Rigoberta Menchu Gewerkschaftsführerin in ihrem Heimatland.“"
                            },
                            {
                                "example_id": "99753a9d-2d1b-4565-b362-752bd71e9ee3",
                                "sense_id": "61805cc7-837d-3bdf-acae-6334fa3523ab",
                                "text": "„Bundeskanzlerin, Ministerinnen, Unternehmerinnen, Gewerkschaftsführerinnen, Priesterinnen, Professorinnen, Direktorinnen – es sind immer Frauen.“"
                            },
                            {
                                "example_id": "9117a1eb-308c-4929-aa1b-bf878e5940a1",
                                "sense_id": "61805cc7-837d-3bdf-acae-6334fa3523ab",
                                "text": "„Das prominenteste Beispiel ist die Gewerkschaftsführerin Sandra Cabrera, die ihr gewerkschaftliches Engagement im Januar 2004 mit ihrem Leben bezahlte.“"
                            },
                            {
                                "example_id": "9dc3118d-fa7d-4a34-9206-cab59aed2c3f",
                                "sense_id": "61805cc7-837d-3bdf-acae-6334fa3523ab",
                                "text": "„‚Schuld daran sind häufig Niedriglöhne von 5,50 Euro oder weniger‘, sagt Sabine-Almut Auerbach, die Gewerkschaftsführerin des ver.di-Bezirks Südholstein.“"
                            },
                            {
                                "example_id": "8620784c-cc03-49f7-80ab-22b9a71694e0",
                                "sense_id": "61805cc7-837d-3bdf-acae-6334fa3523ab",
                                "text": "„So soll die abgesetzte Gewerkschaftsführerin den Kauf einer Villa an Strandlage im südkalifornischen Coronado im Wert von 4 Millionen Dollar ab dem Konto einer Schweizer Grossbank bezahlt haben.“"
                            },
                            {
                                "example_id": "f3a3a2fe-4345-4f80-b08f-95e8649ebb2d",
                                "sense_id": "61805cc7-837d-3bdf-acae-6334fa3523ab",
                                "text": "„Feministin, Gewerkschaftsführerin, und eine der Wegbereiterinnen der proletarischen Frauenbewegung in Deutschland: So beschreibt Google an diesem Mittwoch Emma Ihrer – und feiert mit einem Doodle ihren 161. Geburtstag.“"
                            },
                            {
                                "example_id": "63d950e2-bd16-4f83-9b45-ff6c87261f22",
                                "sense_id": "61805cc7-837d-3bdf-acae-6334fa3523ab",
                                "text": "„Während der Rede machte Biden zweimal Scherze darüber, ob er eine Gewerkschaftsführerin umarmen oder den Arm um einen Burschen legen dürfe.“"
                            },
                            {
                                "example_id": "7e003fd0-b105-4374-9cc8-14ffca8bf3de",
                                "sense_id": "61805cc7-837d-3bdf-acae-6334fa3523ab",
                                "text": "„Gewerkschaftsführerin Karger monierte am Donnerstag, dass über den Job-Turbo angestellte Geflüchtete in Berlin ‚sehr häufig‘ unterhalb ihrer Qualifikation beschäftigt werden.“"
                            },
                            {
                                "example_id": "b1ceced9-9e5b-4cb5-adce-16f74f05f7ba",
                                "sense_id": "61805cc7-837d-3bdf-acae-6334fa3523ab",
                                "text": "„Sie ist benannt nach der Gewerkschaftsführerin Mary Harris Jones, die einst als ‚the most dangerous woman in America‘ verschrien war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
