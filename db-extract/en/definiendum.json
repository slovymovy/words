                        "glosses": [
                            "The term (word or phrase) defined in a definition (whether inside a sentence, as a dictionary entry, or otherwise)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c637227e-b54d-4a60-ae33-f2ac88e2c3ad",
                                "sense_id": "862d88da-0381-3cca-9b2c-0c5dce93501f",
                                "text": "However, most advocates of the importance of real definition have limited the definiendum to certain kinds of things: usually an abstract entity or a concept."
                            },
                            {
                                "example_id": "ebfe6d45-3469-402c-a3cb-7bb3b96b0ff3",
                                "sense_id": "862d88da-0381-3cca-9b2c-0c5dce93501f",
                                "text": "The objects themselves are the definienda of the definition. The first set of properties through which the definienda are collected together to form a group is called ‘the limiting properties of being the definienda of the definition’."
                            }
                        ]
