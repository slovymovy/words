                    {
                        "sense_id": "72862635-f754-3b41-a5c8-aadf8e9d0368",
                        "entry_id": "270095fb-05d9-3fad-bb31-c1d30dcd447c",
                        "glosses": [
                            "Être groovy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ad255fe-bc19-48be-aaea-45ee98500e88",
                                "sense_id": "72862635-f754-3b41-a5c8-aadf8e9d0368",
                                "text": "Le résultat swingue, groove, cajole et ensorcèle, avec pour trait d’union le timbre suave de madame Costello."
                            },
                            {
                                "example_id": "6cfc3f28-1f33-4fb5-9507-5184e86e9ac7",
                                "sense_id": "72862635-f754-3b41-a5c8-aadf8e9d0368",
                                "text": "Non David, ce son ne groove pas DU TOUT !"
                            },
                            {
                                "example_id": "a26cca7e-b3b6-4883-9909-526062f94c66",
                                "sense_id": "72862635-f754-3b41-a5c8-aadf8e9d0368",
                                "text": "Action BDS au New Morning : Israël, ça groove pas !"
                            },
                            {
                                "example_id": "db5ca6e7-fa20-4f89-af60-b8a6241acb8b",
                                "sense_id": "72862635-f754-3b41-a5c8-aadf8e9d0368",
                                "text": "La zik coupe-la fatigué d'entendre qu'le rap français ça groove pas."
                            }
                        ]
                    }
