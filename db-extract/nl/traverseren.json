                        "glosses": [
                            "een gebied doorkruisen of doortrekken"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ce8844dd-b994-3b92-adea-29133764d47d",
                        "entry_id": "0dc5f977-4417-3cac-bc72-be1f0a3edb76",
                        "glosses": [
                            "een bergflank zijwaarts oversteken zonder te klimmen of te dalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "997180d5-3070-408b-8258-90930f0fda7a",
                                "sense_id": "ce8844dd-b994-3b92-adea-29133764d47d",
                                "text": "Ik traverseer naar het westen en klim omhoog tot ik weer op de graat sta. Ik ben opgelucht, want aan het helling van de graat zie ik duidelijk dat ik de top onderlangs gepasseerd ben."
                            }
                        ]
                    },
                    {
                        "sense_id": "40827a51-a922-3cf4-ab3e-e24cf08d443f",
                        "entry_id": "0dc5f977-4417-3cac-bc72-be1f0a3edb76",
                        "glosses": [
                            "peddeltechniek in tegenstroom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8e87a99-402c-4e3a-ac2a-138858959ffc",
                                "sense_id": "40827a51-a922-3cf4-ab3e-e24cf08d443f",
                                "text": "‘Traverseren’ betekent niet alleen een bergflank in een zijwaartse manoeuvre nemen, het houdt ook in een rivier over te steken zonder stroomafwaarts te geraken."
                            },
                            {
                                "example_id": "562fd639-6b34-4c90-8f5c-baad452b3991",
                                "sense_id": "40827a51-a922-3cf4-ab3e-e24cf08d443f",
                                "text": "Dankzij de techniek van ‘traverseren’ is het mogelijk een sterke tegemoetkomende stroming haaks over te steken, ook is het mogelijk in een hoge golf stil te hangen ten opzichte van de oevers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8c3d199c-05b4-4bee-9e0f-d5c155f7fa6f",
                        "source_entry_id": "0dc5f977-4417-3cac-bc72-be1f0a3edb76",
                        "source_sense_id": "96312cc5-d774-3c80-ad7f-babfee48b184",
                        "source_sense_description": "een gebied doorkruisen of doortrekken",
                        "target_lang_word": "traverse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "traverse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a2a1e1b-72ed-304a-a5ef-d58e1bd05c67",
                                        "entry_id": "e080c7d7-e831-3581-b146-7283a02c90fc",
                                        "glosses": [
                                            "A route used in mountaineering, specifically rock climbing, in which the descent occurs by a different route than the ascent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71f267a8-896f-3741-baa1-5944d9fef686",
                                        "entry_id": "e080c7d7-e831-3581-b146-7283a02c90fc",
                                        "glosses": [
                                            "A series of points, with angles and distances measured between, traveled around a subject, usually for use as \\\"control\\\" i.e. angular reference system for later surveying work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "811bb213-f5e4-4af3-9bfd-89ab4f8a94b2",
                                                "sense_id": "71f267a8-896f-3741-baa1-5944d9fef686",
                                                "text": "At the entrance of the king, the first traverse was drawn, and the lower descent of the mountain discovered, which was the pendant of a hill to life, with divers boscages and grovets upon the steep or hanging grounds thereof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30f161fa-937b-3755-baa1-67555c601965",
                                        "entry_id": "e080c7d7-e831-3581-b146-7283a02c90fc",
                                        "glosses": [
                                            "A screen or partition."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51233ff9-4cb8-4e79-be6e-085fc58d29c5",
                                                "sense_id": "30f161fa-937b-3755-baa1-67555c601965",
                                                "text": "Than sholde ye see there pressynge in a pace / Of one and other that wolde this lady see, / Whiche sat behynde a traves of sylke fyne, / Of golde of tessew the fynest that myghte be […]"
                                            },
                                            {
                                                "example_id": "5db03f3c-182b-42a1-8adb-134ab9d6588f",
                                                "sense_id": "30f161fa-937b-3755-baa1-67555c601965",
                                                "text": "At the entrance of the king, / The first traverse was drawn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0afd6047-2125-3077-907e-d33f1595eaf3",
                                        "entry_id": "e080c7d7-e831-3581-b146-7283a02c90fc",
                                        "glosses": [
                                            "Something that thwarts or obstructs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d7f144-7ceb-4b74-8b3b-fb2ef1dda5a2",
                                                "sense_id": "0afd6047-2125-3077-907e-d33f1595eaf3",
                                                "text": "He will succeed, as long as there are no unlucky traverses not under his control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78513aa3-a6d5-34ae-991e-dfc6a2641e52",
                                        "entry_id": "e080c7d7-e831-3581-b146-7283a02c90fc",
                                        "glosses": [
                                            "A gallery or loft of communication from side to side of a church or other large building."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0995da6c-9776-3493-9488-2fe19289724c",
                                        "entry_id": "e080c7d7-e831-3581-b146-7283a02c90fc",
                                        "glosses": [
                                            "A formal denial of some matter of fact alleged by the opposite party in any stage of the pleadings. The technical words introducing a traverse are absque hoc (\\\"without this\\\", i.e. without what follows)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39a1bf45-60cc-3641-bf39-b7229b957efa",
                                        "entry_id": "e080c7d7-e831-3581-b146-7283a02c90fc",
                                        "glosses": [
                                            "The zigzag course or courses made by a ship in passing from one place to another; a compound course."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c13fc7d0-d6e3-3fa3-b886-80fda9c24f6c",
                                        "entry_id": "e080c7d7-e831-3581-b146-7283a02c90fc",
                                        "glosses": [
                                            "A line lying across a figure or other lines; a transversal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e6c5dac-5625-3981-bd4a-8ff425593a00",
                                        "entry_id": "e080c7d7-e831-3581-b146-7283a02c90fc",
                                        "glosses": [
                                            "In trench warfare, a defensive trench built to prevent enfilade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a23911c-861c-4ea1-a5b5-f80ec32a7837",
                                                "sense_id": "4e6c5dac-5625-3981-bd4a-8ff425593a00",
                                                "text": "At night, when the Federal guns slowed their fire, the men created new traverses and bombproofs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ed67615-dd99-3019-baf4-2158a6f8bfbf",
                                        "entry_id": "e080c7d7-e831-3581-b146-7283a02c90fc",
                                        "glosses": [
                                            "A traverse board."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b06f6ab9-e3fa-4e79-85c1-f16935f59d6f",
                                                "sense_id": "3ed67615-dd99-3019-baf4-2158a6f8bfbf",
                                                "text": "The whole care of the vessel rested, therefore, upon me, and I was obliged to direct her by my former experience, not being able to work a traverse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "traverse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1a11feb-0ff7-3ecc-9be6-46ea90c24971",
                                        "entry_id": "82d13d39-d934-3088-ad94-59213ba4be77",
                                        "glosses": [
                                            "To travel across, to go through, to pass through, particularly under difficult conditions."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22528fc3-2d65-4238-92f5-dfcd2225a062",
                                                "sense_id": "f1a11feb-0ff7-3ecc-9be6-46ea90c24971",
                                                "text": "He will have to traverse the mountain to get to the other side."
                                            },
                                            {
                                                "example_id": "5a1c4644-5bb2-4a62-be0f-7d22291a2597",
                                                "sense_id": "f1a11feb-0ff7-3ecc-9be6-46ea90c24971",
                                                "text": "What seas you travers'd, and what fields you fought! / Your country's peace how oft, how dearly bought!"
                                            },
                                            {
                                                "example_id": "2e321dd8-0f09-4e63-a93e-4f02aef0eafd",
                                                "sense_id": "f1a11feb-0ff7-3ecc-9be6-46ea90c24971",
                                                "text": "Here the line is joined by the Colne Valley branch, and both tracks are carried into Haverhill station upon a high embankment from which the town can be seen on the south side. The twin tracks, after traversing a scissors crossover, become the down and up roads through the station, which possesses an extensive goods yard."
                                            },
                                            {
                                                "example_id": "8d418503-d65f-4dbf-9d07-dae7e563ef0f",
                                                "sense_id": "f1a11feb-0ff7-3ecc-9be6-46ea90c24971",
                                                "text": "The journey is worth an article in itself, but all I can give is a flavour of a railway which traverses a bleak but dramatic coastline that's regularly battered by the elements - especially around Parton, where the line is constantly threatened by the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef8e61a9-3b80-39b0-847a-a84a79f16c2e",
                                        "entry_id": "82d13d39-d934-3088-ad94-59213ba4be77",
                                        "glosses": [
                                            "To visit all parts of; to explore thoroughly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3099ec53-4110-480f-a83f-ab3bbb24607b",
                                                "sense_id": "ef8e61a9-3b80-39b0-847a-a84a79f16c2e",
                                                "text": "to traverse all nodes in a network"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fa5daee-c4f4-3f16-ad73-3c6067a85c93",
                                        "entry_id": "82d13d39-d934-3088-ad94-59213ba4be77",
                                        "glosses": [
                                            "To lay in a cross direction; to cross."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8a7bbcb-230f-4787-8004-6d8f015aa36d",
                                                "sense_id": "8fa5daee-c4f4-3f16-ad73-3c6067a85c93",
                                                "text": "The parts should be often traversed, or crossed, by the flowing of the folds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "213bedd4-4922-3966-b735-7061d492b2b6",
                                        "entry_id": "82d13d39-d934-3088-ad94-59213ba4be77",
                                        "glosses": [
                                            "To rotate a gun around a vertical axis to bear upon a military target."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7c41709-1fe1-43cb-877d-3f83a84d8374",
                                                "sense_id": "213bedd4-4922-3966-b735-7061d492b2b6",
                                                "text": "to traverse a cannon"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81210d53-d920-3f66-ba01-aadec17b8955",
                                        "entry_id": "82d13d39-d934-3088-ad94-59213ba4be77",
                                        "glosses": [
                                            "To climb or descend a steep hill at a wide angle (relative to the slope)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11180a14-1ab8-3250-8b09-f38b7aee68b7",
                                        "entry_id": "82d13d39-d934-3088-ad94-59213ba4be77",
                                        "glosses": [
                                            "To (make a cutting, an incline) across the gradients of a sloped face at safe rate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19a9196e-975b-45a2-a43d-13401779f0cf",
                                                "sense_id": "11180a14-1ab8-3250-8b09-f38b7aee68b7",
                                                "text": "the road traversed the face of the ridge as the right-of-way climbed the mountain"
                                            },
                                            {
                                                "example_id": "7dd5478d-0de7-4ce6-8776-31c0a06bdbbd",
                                                "sense_id": "11180a14-1ab8-3250-8b09-f38b7aee68b7",
                                                "text": "The last run, weary, I traversed the descents in no hurry to reach the lodge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb8fa76b-2c03-381a-b0b0-1e9e363995b9",
                                        "entry_id": "82d13d39-d934-3088-ad94-59213ba4be77",
                                        "glosses": [
                                            "To act against; to thwart or obstruct."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e8635cd-61c6-417e-9dd0-d1cc82a336f2",
                                                "sense_id": "fb8fa76b-2c03-381a-b0b0-1e9e363995b9",
                                                "text": "The well meaning Prieſt ſuffered him to deceive himſelf, fully determined to traverſe his views, inſtead of ſeconding them."
                                            },
                                            {
                                                "example_id": "fb671cb5-c48b-420d-99d3-f8776c884916",
                                                "sense_id": "fb8fa76b-2c03-381a-b0b0-1e9e363995b9",
                                                "text": "I cannot but […] admit the force of this reasoning, which I yet hope to traverse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfa41a86-8a74-3b0f-8139-3a97620241ba",
                                        "entry_id": "82d13d39-d934-3088-ad94-59213ba4be77",
                                        "glosses": [
                                            "To pass over and view; to survey carefully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35cea0f5-790c-4b57-8203-3173cce37ac7",
                                                "sense_id": "cfa41a86-8a74-3b0f-8139-3a97620241ba",
                                                "text": "My purpose is to […] traverse the nature, principles, and properties of this detestable vice—ingratitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5b3d4e-1371-3f8c-8511-ed316137afc3",
                                        "entry_id": "82d13d39-d934-3088-ad94-59213ba4be77",
                                        "glosses": [
                                            "To plane in a direction across the grain of the wood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "003ac808-f326-4809-b07f-83f798080f6d",
                                                "sense_id": "6b5b3d4e-1371-3f8c-8511-ed316137afc3",
                                                "text": "to traverse a board"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88edff80-6a2e-3007-9d66-5b3ec0ed6403",
                                        "entry_id": "82d13d39-d934-3088-ad94-59213ba4be77",
                                        "glosses": [
                                            "To deny formally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2e11298-e581-4155-9878-70d5aa892a71",
                                                "sense_id": "88edff80-6a2e-3007-9d66-5b3ec0ed6403",
                                                "text": "Without their coſt, you terminate the cauſe; / And ſave th' expence of long litigious laws: / Where ſuits are travers'd; and ſo little won, / That he who conquers, is but laſt undone: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f36ae983-ebf2-37fe-bc29-4b06ba4d3acb",
                                        "entry_id": "82d13d39-d934-3088-ad94-59213ba4be77",
                                        "glosses": [
                                            "To use the motions of opposition or counteraction."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
