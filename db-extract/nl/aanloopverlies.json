                        "sense_id": "88e17b1f-7a97-37c7-a612-9c311cdb8169",
                        "entry_id": "56a326ec-2006-3dab-a23b-280735733c08",
                        "glosses": [
                            "verliezen die men lijdt bij het opstarten van een activiteit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8ffe1c6-a972-4c5d-a8fe-947a972052e3",
                                "sense_id": "88e17b1f-7a97-37c7-a612-9c311cdb8169",
                                "text": "Over 2007 leed De Pers 20 miljoen euro verlies, dit jaar zal dat 10 miljoen euro zijn en volgend jaar 5 miljoen euro, zegt Van den Berg. In 2011 zal de krant misschien 2 miljoen winst maken, schat de uitgever. Het aanloopverlies is tegen die tijd opgelopen tot 35 miljoen euro."
                            },
                            {
                                "example_id": "d7c07217-a260-4503-967f-ae536fb82155",
                                "sense_id": "88e17b1f-7a97-37c7-a612-9c311cdb8169",
                                "text": "Luchtvaartmaatschappij Transavia heeft de winst voor belasting in het boekjaar 2007/2008 zien teruglopen van 28 miljoen euro tot 18,1 miljoen euro. De maatschappij verklaart het verschil door een verwacht aanloopverlies afgelopen jaar van Transavia France en bijzondere boekhoudposten het jaar daarvoor."
                            }
                        ]
                    }
