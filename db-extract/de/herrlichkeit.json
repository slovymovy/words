                                                "sense_id": "97d54694-66cb-3dd6-b55f-b807f9e03af2",
                                                "text": "Il vit avec beaucoup de splendeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7992cfb2-3528-3eeb-bcb2-c943536fd4ce",
                                        "entry_id": "83057c89-e233-3b55-836d-fcddcbe4e9c1",
                                        "glosses": [
                                            "Choses éclatantes, magnifiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "979f3a7f-e0c6-4c64-9697-84dc325ba681",
                                                "sense_id": "7992cfb2-3528-3eeb-bcb2-c943536fd4ce",
                                                "text": "Toute la grande nature du Noordland qui s’est dévoilée à nos yeux depuis Throndjhem, n’est que le prélude des splendeurs qui nous attendent dans l’archipel des Loffoden."
