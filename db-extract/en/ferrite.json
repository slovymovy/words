                "senses": [
                    {
                        "sense_id": "c8c4d2b7-4201-3463-9dfb-c7fb33f7b6cd",
                        "entry_id": "fea1aadb-23d2-3326-9a63-1132124924bd",
                        "glosses": [
                            "The interstitial solid solution of carbon in body-centered cubic iron."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "35a0446e-b165-4952-8dfa-cdbc99ce7763",
                                "sense_id": "c8c4d2b7-4201-3463-9dfb-c7fb33f7b6cd",
                                "text": "Technical terms like ferrite, perlite, graphite, and hardenite were bandied to and fro, and when Paget glibly brought out such a rare exotic as ferro-molybdenum, Benson forgot that he was a master ship-builder, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "51740e33-ee1c-3541-ac0e-d1b0872d44ed",
                        "entry_id": "fea1aadb-23d2-3326-9a63-1132124924bd",
                        "glosses": [
                            "Any of a class of metal oxides which show ferrimagnetism; used in transformers, inductors, antennas, recording heads, microwave devices, motors and loudspeakers."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "673d1348-c591-4178-8d8e-6ba0ad181a92",
                                "sense_id": "51740e33-ee1c-3541-ac0e-d1b0872d44ed",
                                "text": "The actual hardware is obsolete; for example, the memories are of the old ferrite core type."
                            }
                        ]
                    },
                    {
                        "sense_id": "043d0325-df1a-3c8a-a62e-3257b0d82338",
                        "entry_id": "fea1aadb-23d2-3326-9a63-1132124924bd",
                        "glosses": [
                            "The anion FeO₂²⁻, and any of the salts (formally derived from the unknown ferrous acid) derived from it."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
