        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d63d137a-09fa-385e-8315-3c5ebb596d30",
                    "sense_definition": "The act of one who feigns; fakery or deceit.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her constant <w>feignings</w> of affection eventually made him doubt her sincerity.",
                            "target_lang_translations": {
                                "de": "Ihr ständiges <w>Vortäuschen</w> von Zuneigung ließ ihn schließlich an ihrer Aufrichtigkeit zweifeln."
                            }
                        },
                        {
                            "text": "Behind his polite smile lay a web of lies and clever <w>feigning</w>.",
                            "target_lang_translations": {
                                "de": "Hinter seinem höflichen Lächeln verbarg sich ein Netz aus Lügen und geschickter <w>Verstellung</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pretence",
                        "fakery",
                        "deceit",
                        "simulation"
                    ],
                    "antonyms": [
                        "sincerity",
                        "honesty"
                    ],
                    "common_phrases": [
                        "clever feigning",
                        "constant feignings"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Handlung des Vortäuschens; Verstellung, Heuchelei oder Täuschung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Verstellung",
                                "target_lang_sense_clarification": "das Vortäuschen falscher Tatsachen oder Gefühle"
                            },
                            {
                                "target_lang_word": "Vortäuschung",
                                "target_lang_sense_clarification": "das bewusste Vorspiegeln einer falschen Realität"
                            },
                            {
                                "target_lang_word": "Heuchelei",
                                "target_lang_sense_clarification": "unaufrichtiges Verhalten"
                            }
                        ]
                    }
