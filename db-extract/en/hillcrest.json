                    }
                ],
                "senses": [
                    {
                        "sense_id": "54b2cc56-d6f8-32f3-bfed-dcb8b14e515e",
                        "entry_id": "fc434156-37a1-3ff1-8fa8-363f7523195f",
                        "glosses": [
                            "The crest of a hill"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f719b16d-4e6c-40ec-9c78-6d820091fa14",
                                "sense_id": "54b2cc56-d6f8-32f3-bfed-dcb8b14e515e",
                                "text": "But all that sunny hillcrest seemed brightened by the marquis."
                            },
                            {
                                "example_id": "9c6f698f-17cd-4e6b-b80c-2995dd94a0dc",
                                "sense_id": "54b2cc56-d6f8-32f3-bfed-dcb8b14e515e",
                                "text": "The light got red and angry as they dipped into the valley; the firs on the hillcrest stood out black and sharp, and then melted into the gray background."
                            },
                            {
                                "example_id": "f2fd7509-be0a-4d8b-a306-04af450aa7ea",
                                "sense_id": "54b2cc56-d6f8-32f3-bfed-dcb8b14e515e",
                                "text": "The upper half of her torso is raised and she's looking away from the camera, apparently staring over the hillcrest as if hunting for something amid the foliage or plotting an escape route."
                            }
                        ]
                    }
                ],
