                        "source_sense_id": "744cf0ae-2573-3a5a-a573-b95c5dec48f0",
                        "source_sense_description": "een geheel met vloeistof gevulde pijp of slang waarvan het ene einde lager gehouden wordt dan de andere, waardoor vloeistof van de laatste mond naar de eerste stroomt",
                        "target_lang_word": "сифон",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сифон",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3d90eb6d-8303-3101-ac51-5b0c949a16f5",
                                        "entry_id": "fa9008e6-376d-3f29-a65f-94ac123aa419",
                                        "glosses": [
                                            "техн., физ. изогнутая трубка с коленами неодинаковой длины, служащая для переливания жидкости из сосуда с более высоким уровнем в сосуд с более низким уровнем"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb7f068-04ee-436f-a32e-7d9b9cce76bd",
                                                "sense_id": "3d90eb6d-8303-3101-ac51-5b0c949a16f5",
                                                "text": "Ответвление сливной трубы раковины должно находиться выше сифона раковины, чтобы конец шланга находился на высоте не менее 60 см от уровня пола."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50078c79-3020-31c9-a7c0-b704e1cb4560",
                                        "entry_id": "fa9008e6-376d-3f29-a65f-94ac123aa419",
                                        "glosses": [
                                            "разг. бутылка, сосуд для газированной или минеральной воды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb750806-fdc8-464a-82a1-e0889841a5cf",
                                                "sense_id": "50078c79-3020-31c9-a7c0-b704e1cb4560",
                                                "text": "Там стояли вазы под цветы и сифоны с газированной водой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11bd4429-7051-3b0a-9c34-fb45b1732536",
                                        "entry_id": "fa9008e6-376d-3f29-a65f-94ac123aa419",
                                        "glosses": [
                                            "зоол. орган в виде трубки у некоторых моллюсков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3c1300c-0c3a-4f3f-9fe4-32d6e2da42c1",
                                                "sense_id": "11bd4429-7051-3b0a-9c34-fb45b1732536",
                                                "text": "У беззубки два сифона: вводной и выводной."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afc52754-7c1f-3377-b982-b4c7fb4c9e4f",
                                        "entry_id": "fa9008e6-376d-3f29-a65f-94ac123aa419",
                                        "glosses": [
                                            "техн. прибор для увеличения тяги в топке паровоза"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37a75fb5-2c62-41bf-acfc-0a73c39575ca",
                                                "sense_id": "afc52754-7c1f-3377-b982-b4c7fb4c9e4f",
                                                "text": "…Пухов сам полез на паровоз, чтобы закрыть регулятор и сифон."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09bc3253-679a-3a88-ab4b-10823767f5d9",
                                        "entry_id": "fa9008e6-376d-3f29-a65f-94ac123aa419",
                                        "glosses": [
                                            "геол. подводный туннель естественного или искусственного происхождения, по которому протекает вода"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf8e133d-f85e-48a9-af68-59fec2f76f16",
                                                "sense_id": "09bc3253-679a-3a88-ab4b-10823767f5d9",
                                                "text": "Возможно, у опытных спелеоподводников лёгкую улыбку вызовет способ преодоления сифонов, который демонстрировал автор со своими друзьями."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23bd22ab-91b0-3596-a2cd-5c6656a676a5",
                                        "entry_id": "fa9008e6-376d-3f29-a65f-94ac123aa419",
                                        "glosses": [
                                            "истор. средневековое огнеметательное орудие, которое устанавливали на дромонах (разновидности византийских кораблей)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "702aa1e6-b291-4632-a6a9-3150ace6222c",
                                                "sense_id": "23bd22ab-91b0-3596-a2cd-5c6656a676a5",
                                                "text": "Сифон на каждом корабле обслуживался двумя передними гребцами, один из которых назывался «сифонатором»."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "сифон",
