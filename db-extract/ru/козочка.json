                        "examples": [
                            {
                                "example_id": "2de65d67-c4c8-4aa1-849a-8eea0d2e99b4",
                                "sense_id": "3dfbd820-9bbd-3828-acb8-00c9f286227f",
                                "text": "Козочка пощипывает муравку."
                            },
                            {
                                "example_id": "b2d31b4c-bdec-4372-93f7-5fcb8b203141",
                                "sense_id": "3dfbd820-9bbd-3828-acb8-00c9f286227f",
                                "text": "Дойную козу и козочку 7 месяцев, цена договорная, продаю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
