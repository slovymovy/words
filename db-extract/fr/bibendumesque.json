                        "glosses": [
                            "Qui rappelle le Bibendum Michelin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28e87d9d-e1fe-4d8a-b43b-34c68dd1fa2e",
                                "sense_id": "6392b86b-ae71-341d-86b6-36c247a5b7a1",
                                "text": "De grands jeunes hommes à la carrure d’athlètes — un peu moins impressionnants toutefois que dans leurs tenues bibendumesques de footballeurs — virevoltaient avec leurs partenaires ou dansaient joue contre joue, horriblement sentimentaux."
                            },
                            {
                                "example_id": "d6c6b8ed-6a07-40a6-bc2b-5b555ab32844",
                                "sense_id": "6392b86b-ae71-341d-86b6-36c247a5b7a1",
                                "text": "De celle-ci jaillit alors une forme bibendumesque qui se transforme en femme."
                            },
                            {
                                "example_id": "2dcbdedd-fe27-451c-831a-b4b573fd29ac",
                                "sense_id": "6392b86b-ae71-341d-86b6-36c247a5b7a1",
                                "text": "Deux ados et leurs parents, tous bien concrets, s’opposent à une épouvantable sorcière «bibendumesque» nue."
                            }
                        ]
                    }
                ],
