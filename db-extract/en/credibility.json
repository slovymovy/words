                    {
                        "sense_id": "e22499fd-78b4-3d3c-9958-3bf2bd85be98",
                        "entry_id": "5a537695-5ce3-3508-904d-74b519161e01",
                        "glosses": [
                            "Reputation impacting one's ability to be believed."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5c9457ab-03e0-43e2-b347-998d4fafc1c4",
                                "sense_id": "e22499fd-78b4-3d3c-9958-3bf2bd85be98",
                                "text": "After weeks of blowing smoke, her credibility with me was next to nil."
                            },
                            {
                                "example_id": "8e4ca38b-7e25-4ebd-b8cc-0bcc028dbaa8",
                                "sense_id": "e22499fd-78b4-3d3c-9958-3bf2bd85be98",
                                "text": "The inability of Trump's own spokespeople to speak authoritatively on the president's thinking and actions -- a challenge even Trump himself has acknowledged -- has left the White House with an enormous credibility gap, and has tarnished the reputations of many of its most visible spokespeople."
                            },
                            {
                                "example_id": "786c593d-a49d-4782-aa56-e7b580c1422c",
                                "sense_id": "e22499fd-78b4-3d3c-9958-3bf2bd85be98",
                                "text": "The 'partygate' controversy has played a major part in undermining the credibility of Boris Johnson and his Government and has led to calls from senior MPs for him to resign."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6041b0c-5678-3995-8a47-649ed634ce01",
                        "entry_id": "5a537695-5ce3-3508-904d-74b519161e01",
                        "glosses": [
                            "Believability of statements by a witness, as measured by whether the testimony is probable or improbable when judged by common experience."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
