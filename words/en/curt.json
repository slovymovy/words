        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c0bd1bf2-7ba9-3632-95f2-8d2db8d23b22",
                    "sense_definition": "A male given name from the Germanic languages, an anglicized spelling of Kurt.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "male_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My uncle <w>Curt</w> was named after his grandfather who immigrated from Germany.",
                            "target_lang_translations": {
                                "ru": "Мой дядя <w>Курт</w> был назван в честь своего дедушки, который иммигрировал из Германии."
                            }
                        },
                        {
                            "text": "We invited <w>Curt</w> to the family reunion next month.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили <w>Курта</w> на встречу выпускников в следующем месяце."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское личное имя германского происхождения, англизированное написание имени Курт."
                    },
                    "translations": {
                        "ru": [
                            {
