                "senses": [
                    {
                        "sense_id": "34fa6519-243e-38ea-a05e-fa931429e2a3",
                        "entry_id": "173880e5-e8bc-32dd-b0a0-376b513e2e83",
                        "glosses": [
                            "Jagd, bei der das Wild mit Pfeil und Bogen erlegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62ef2491-ed5d-4b3a-8f6a-d7dd1be67d6b",
                                "sense_id": "34fa6519-243e-38ea-a05e-fa931429e2a3",
                                "text": "„Trotz aller Begeisterung geht es den Bowhunters nicht um das Ersetzen der Büchsen- durch die Bogenjagd.“"
                            },
                            {
                                "example_id": "abf40b35-53c8-46f1-b6a2-72689640c6c3",
                                "sense_id": "34fa6519-243e-38ea-a05e-fa931429e2a3",
                                "text": "„Die Farm im Nordosten hat sich neben der reinen Büchsenjagd auch auf die Bogenjagd spezialisiert.“"
                            },
                            {
                                "example_id": "003716ca-3954-4c6d-969b-f4caff44691e",
                                "sense_id": "34fa6519-243e-38ea-a05e-fa931429e2a3",
                                "text": "„Bogenjagd präsentiert sich als eine alternative Jagdmethode für schwierige Areale, wo Büchsenjagd sich als problematisch erweist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
