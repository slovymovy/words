            "senses": [
                {
                    "sense_id": "863667e4-e509-3078-a9f0-62513163a112",
                    "sense_definition": "otwarte zgromadzenie wielu osób w celu wyrażenia opinii lub poparcia",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zgromadzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na rynku odbył się wielki <w>mityng</w> poparcia dla lokalnych przedsiębiorców.",
                            "target_lang_translations": {
                                "ru": "На площади состоялся большой <w>митинг</w> в поддержку местных предпринимателей."
                            }
                        },
                        {
                            "text": "Wszyscy mieszkańcy zostali zaproszeni na <w>mityng</w> w sprawie budowy nowej drogi.",
                            "target_lang_translations": {
                                "ru": "Все жители были приглашены на <w>собрание</w> по вопросу строительства новой дороги."
                            }
                        }
                    ],
                    "synonyms": [
                        "wiec",
                        "zgromadzenie",
                        "masówka"
                    ],
                    "common_phrases": [
                        "zorganizować mityng",
                        "uczestniczyć w mityngu"
                    ],
                    "target_lang_definitions": {
                        "ru": "открытое собрание множества людей с целью выражения мнения или поддержки"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "митинг",
                                "target_lang_sense_clarification": "политическое или общественное собрание"
                            },
                            {
                                "target_lang_word": "собрание",
                                "target_lang_sense_clarification": "общее собрание людей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6d0e7a7-4f15-397b-9b9f-25743bf47000",
                    "sense_definition": "zawody sportowe w dyscyplinach indywidualnych",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekkoatleci przygotowują się do startu w międzynarodowym <w>mityngu</w> w Berlinie.",
                            "target_lang_translations": {
                                "ru": "Легкоатлеты готовятся к старту на международных <w>соревнованиях</w> в Берлине."
                            }
                        },
                        {
                            "text": "Podczas wczorajszego <w>mityngu</w> pływackiego pobito kilka rekordów kraju.",
                            "target_lang_translations": {
                                "ru": "Во время вчерашних плавательных <w>соревнований</w> было побито несколько национальных рекордов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mityng lekkoatletyczny",
                        "mityng pływacki"
                    ],
                    "target_lang_definitions": {
                        "ru": "спортивные соревнования по индивидуальным дисциплинам"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соревнования",
                                "target_lang_sense_clarification": "спортивное мероприятие"
                            },
                            {
                                "target_lang_word": "турнир",
                                "target_lang_sense_clarification": "спортивное состязание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73a4f071-b95e-3907-b0fc-cfb6db5a2b2a",
                    "sense_definition": "spotkanie grupy wsparcia dla osób z uzależnieniami",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "spotkanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regularne uczęszczanie na <w>mityngi</w> jest kluczowym elementem terapii dla wielu osób.",
                            "target_lang_translations": {
                                "ru": "Регулярное посещение <w>собраний</w> является ключевым элементом терапии для многих людей."
                            }
                        },
                        {
                            "text": "Po pracy poszedł na <w>mityng</w> grupy wsparcia, aby porozmawiać o swoich problemach.",
                            "target_lang_translations": {
                                "ru": "После работы он пошел на <w>собрание</w> группы поддержки, чтобы поговорить о своих проблемах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mityng AA"
                    ],
                    "target_lang_definitions": {
                        "ru": "встреча группы поддержки для людей с зависимостями"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собрание",
                                "target_lang_sense_clarification": "встреча группы поддержки"
                            },
                            {
                                "target_lang_word": "встреча",
                                "target_lang_sense_clarification": "групповое занятие или сессия"
                            }
                        ]
                    }
                }
            ]
        }
