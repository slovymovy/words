                            {
                                "example_id": "6a489bc1-0a25-4746-bc1d-7926b1984a80",
                                "sense_id": "6c052929-5f1b-36f2-8e29-7b18b256ef0b",
                                "text": "De thuisploeg pakte voor rust de voorsprong, nadat het eerder in het duel al een strafschop gemist had. Rick Battels maakte op aangeven van Christiaan Ercan de treffer. Na rust kreeg ook De Tubanters een strafschop, na een duwfout van Tim Steffens."
                            },
