{
    "word_family": [
        "instigation",
        "instigator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a950ddf2-33b0-348e-83d0-d7a22e2c5e84",
                    "sense_definition": "To bring about or initiate something by urging or encouraging.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "initiate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The activists hoped to <w>instigate</w> a change in local environmental policy.",
                            "target_lang_translations": {
                                "zh": "活动人士希望<w>发起</w>当地环境政策的变革。"
                            }
                        },
                        {
                            "text": "The group planned to <w>instigate</w> a riot during the protest.",
                            "target_lang_translations": {
                                "zh": "该团伙企图在抗议期间<w>煽动</w>一场暴乱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "foment",
                        "provoke",
                        "incite",
                        "stimulate"
                    ],
                    "antonyms": [
                        "halt",
                        "prevent",
                        "stop"
                    ],
                    "common_phrases": [
                        "instigate a change",
                        "instigate a riot"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过鼓动、敦促或挑起促成某事（如变革、骚乱等）；发起或煽动"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发起",
                                "target_lang_sense_clarification": "使变革、调查等积极或中性的行动开始"
                            },
                            {
                                "target_lang_word": "煽动",
                                "target_lang_sense_clarification": "鼓动挑起骚乱、暴乱等不良行为"
                            },
                            {
                                "target_lang_word": "挑起",
                                "target_lang_sense_clarification": "故意引发冲突或争端"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8cec61c2-d3f4-39b4-8189-300f89948940",
                    "sense_definition": "To goad or urge a person forward, especially toward negative or harmful actions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "urge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal tried to <w>instigate</w> his accomplice to commit a serious crime.",
                            "target_lang_translations": {
                                "zh": "这名罪犯试图<w>教唆</w>其同谋去犯下严重的罪行。"
                            }
                        },
                        {
                            "text": "He would often <w>instigate</w> others to swear against the law.",
                            "target_lang_translations": {
                                "zh": "他经常<w>怂恿</w>他人做出违法的虚假誓言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "urge",
                        "impel",
                        "spur",
                        "tempt"
                    ],
                    "common_phrases": [
                        "instigate someone"
                    ],
                    "target_lang_definitions": {
                        "zh": "驱使、怂恿或教唆某人去做某事（尤指有害或违法的行为）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "教唆",
                                "target_lang_sense_clarification": "诱使他人犯罪或做坏事"
                            },
                            {
                                "target_lang_word": "怂恿",
                                "target_lang_sense_clarification": "从旁鼓动他人去做不当行为"
                            },
                            {
                                "target_lang_word": "驱使",
                                "target_lang_sense_clarification": "督促或推动某人行动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}