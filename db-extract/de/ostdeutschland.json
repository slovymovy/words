                ],
                "senses": [
                    {
                        "sense_id": "bcc11166-8849-3530-aa2c-de2b9c1062d1",
                        "entry_id": "e7d04c0e-69e5-39a1-b7ab-1fe216dff3b9",
                        "glosses": [
                            "östlicher Teil Deutschlands; Region östlich der Elbe oder auch östlich der Oder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b9b062d-2fb3-4799-83a2-78f811b3396e",
                                "sense_id": "bcc11166-8849-3530-aa2c-de2b9c1062d1",
                                "text": "Stammen deine Eltern aus Ostdeutschland?"
                            },
                            {
                                "example_id": "5a105bb9-898e-4b76-83e4-e4afd1475eab",
                                "sense_id": "bcc11166-8849-3530-aa2c-de2b9c1062d1",
                                "text": "„Seit den 1970er Jahren nimmt die Wahlbeteiligung in Westdeutschland kontinuierlich ab, auch Ostdeutschland folgt nun diesem Trend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4d0b1328-92e2-3e22-b1d8-8191103ccfd1",
                        "entry_id": "e7d04c0e-69e5-39a1-b7ab-1fe216dff3b9",
                        "glosses": [
                            "seit 1945, Bezeichnung für das Gebiet der Deutschen Demokratischen Republik, beziehungsweise für die neuen Bundesländer"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0d5767b8-00f1-49d5-9d6c-512fcfabf5c2",
                                "sense_id": "4d0b1328-92e2-3e22-b1d8-8191103ccfd1",
                                "text": "„Junge Frauen verlassen Ostdeutschland in Scharen.“"
                            },
                            {
                                "example_id": "0162c9b9-30d9-4748-a627-2e46ca3f0fbc",
                                "sense_id": "4d0b1328-92e2-3e22-b1d8-8191103ccfd1",
                                "text": "„Was haben Polarregionen wie Grönland und abgelegene griechische Inseln mit Ostdeutschland gemeinsam? Überall herrscht Frauenmangel.“"
                            },
                            {
                                "example_id": "465e65b1-114f-40ba-a39b-3ad5b50c7dab",
                                "sense_id": "4d0b1328-92e2-3e22-b1d8-8191103ccfd1",
                                "text": "„Tausende Baudenkmale wurden in Ostdeutschland abgerissen – weil es dafür vom Staat viel Geld gab.“"
                            },
                            {
                                "example_id": "02e241b2-07ec-4d36-beb0-63ef3ec9c003",
                                "sense_id": "4d0b1328-92e2-3e22-b1d8-8191103ccfd1",
                                "text": "„Der besondere Entwicklungsweg, den Ostdeutschland seit 1990 zurückgelegt hat, erklärt sich aus der Hinterlassenschaft des gescheiterten Systems der SED.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf95b1d2-c5dc-49b4-b104-c2d421da50ad",
                        "source_entry_id": "e7d04c0e-69e5-39a1-b7ab-1fe216dff3b9",
                        "source_sense_id": "4d0b1328-92e2-3e22-b1d8-8191103ccfd1",
                        "target_lang_word": "East Germany",
