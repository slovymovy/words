                "senses": [
                    {
                        "sense_id": "ed18f9dd-94be-3c58-b265-b4f43776a304",
                        "entry_id": "01dc6e5c-1b35-33f4-a946-542f9c4fbe52",
                        "glosses": [
                            "Sammelbezeichnung für große Wildtiere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2eeb9f6-2882-46f1-80e1-1a1a2ffb9671",
                                "sense_id": "ed18f9dd-94be-3c58-b265-b4f43776a304",
                                "text": "„Wie Marshalls Kommentar im weiteren Verlauf der Jagd, Verfolgung und Tötung ausführte und seine Mutter Lorna später in ihrem Buch über diese Menschen darlegte, war diese erste Tötung eines Großwilds ein unerlässlicher Nachweis der Männlichkeit.“"
                            },
                            {
                                "example_id": "b0274260-2014-4a5d-8548-81740366f8bd",
                                "sense_id": "ed18f9dd-94be-3c58-b265-b4f43776a304",
                                "text": "„Als es wärmer wurde und Großwild wie Mammuts verschwanden, passten sie ihre Jagdmethoden an kleinere, wendigere Tiere an und entwickelten leichtere Waffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
