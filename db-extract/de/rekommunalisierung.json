                ],
                "senses": [
                    {
                        "sense_id": "90c870df-59ce-3232-b05b-77d70a7c8d4b",
                        "entry_id": "333a7765-492d-3126-a33f-cd39f897baa8",
                        "glosses": [
                            "Rückführung ehemals aus staatlichem Besitz heraus privatisierter Betriebe (beispielsweise von Gas-, Elektizitäts-, Wasser-, Müllentsorgungs-, Telekommunikations-, Krankenhausbetrieben) in kommunalen Besitz"
                        ],
                        "tags": [
                            "Verwaltung"
                        ],
                        "examples": [
                            {
                                "example_id": "73a11cf0-704a-491d-afa7-05814aa37493",
                                "sense_id": "90c870df-59ce-3232-b05b-77d70a7c8d4b",
                                "text": "Das Geschäft mit dem Wasser - Bundesweit steigen die Preise, in Berlin allerdings sind sie konstant. Einer der Gründe ist die Rekommunalisierung der Wasserbetriebe."
                            },
                            {
                                "example_id": "b8736342-65ef-4477-bb24-495aeb20b8c8",
                                "sense_id": "90c870df-59ce-3232-b05b-77d70a7c8d4b",
                                "text": "Der Streit um die Berliner Wasserbetriebe - Die Rekommunalisierung kommt nur schleppend voran"
                            },
                            {
                                "example_id": "efbe289f-8d22-4c0f-9363-0249a4a6ff3a",
                                "sense_id": "90c870df-59ce-3232-b05b-77d70a7c8d4b",
                                "text": "Rekommunalisierung der Berliner Wasserbetriebe - Anfang 2011 hatte überraschend ein Volksentscheid Erfolg, in dem die Offenlegung der Wasser-Verträge und eine Rekommunalisierung gefordert wurden."
                            },
                            {
                                "example_id": "1961a96d-2a4c-41db-a640-980c1989713a",
                                "sense_id": "90c870df-59ce-3232-b05b-77d70a7c8d4b",
                                "text": "Einige Kommunen bemühen sich heute um eine Rekommunalisierung privatisierter Einrichtungen, um wieder einen öffentlichen Zugriff zu haben."
                            },
                            {
                                "example_id": "a68b3f18-1330-4c74-9551-5ba43b791d85",
                                "sense_id": "90c870df-59ce-3232-b05b-77d70a7c8d4b",
                                "text": "Dabei ist ein Trend zur Rekommunalisierung zu beobachten. In einzelnen Fällen versuchen Gemeinden, kommunale Eigenbetriebe, Eigengesellschaften oder Beteiligungsgesellschaften bei der Vergabeentscheidung [von neu zu vergebenden Konzessionen] zu bevorzugen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
