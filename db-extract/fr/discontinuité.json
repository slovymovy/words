                                                "sense_id": "88afc45f-6f46-34f0-acaa-b9082c0eecae",
                                                "text": "Shock waves are sudden discontinuities propagated in compressible media – usually air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6300512a-6cd8-3bea-a5e3-a345df20fb76",
                                        "entry_id": "fccd0aa6-b740-3326-8cb7-65f6e17b0392",
                                        "glosses": [
