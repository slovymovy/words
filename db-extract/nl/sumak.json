                        "sense_id": "4d27b00f-785e-36e9-9a23-f22a209806ce",
                        "entry_id": "2e7fc91e-63bd-35e6-89a7-025e8d252b1c",
                        "glosses": [
                            "poeder van gedroogde en gemalen blaadjes en scheuten van planten uit het geslacht Rhus, gebruikt bij het looien van leer en het verven van textiel"
                        ],
                        "tags": [
                            "materiaalkunde"
                        ],
                        "examples": [
                            {
