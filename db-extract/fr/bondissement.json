                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d3687bc2-eceb-42ad-bb76-dc3f48e70bbc",
                        "entry_id": "8413b102-d4dc-3e82-b2dc-51ca220bf0c0",
                        "tags": [
