                    "sense_id": "0138c612-c3e8-31cc-a93b-e8ebfb92d672",
                    "sense_definition": "zeer geliefd of gewaardeerd door anderen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liefde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overleden leraar was zeer <w>bemind</w> bij al zijn leerlingen.",
                            "target_lang_translations": {
                                "en": "The deceased teacher was much <w>beloved</w> by all his students.",
                                "ru": "Покойный учитель был очень <w>любим</w> всеми своими учениками."
                            }
                        },
                        {
                            "text": "Onbekend maakt vaak onbemind, maar wie hem leert kennen vindt hem juist <w>bemind</w>.",
                            "target_lang_translations": {
                                "en": "Unknown often means unloved, but whoever gets to know him actually finds him <w>beloved</w>.",
                                "ru": "Неизвестное часто отвергают, но тот, кто узнаёт его ближе, находит его по-настоящему <w>милым</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "geliefd",
                        "populair"
                    ],
                    "antonyms": [
                        "onbemind"
                    ],
                    "common_phrases": [
                        "zeer bemind"
                    ],
                    "target_lang_definitions": {
                        "en": "greatly loved or appreciated by others",
                        "ru": "очень любимый или ценимый другими"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "beloved",
                                "target_lang_sense_clarification": "dearly loved and cherished"
                            },
                            {
                                "target_lang_word": "loved",
                                "target_lang_sense_clarification": "held in deep affection"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "любимый",
                                "target_lang_sense_clarification": "пользующийся любовью и расположением"
                            },
                            {
                                "target_lang_word": "обожаемый",
                                "target_lang_sense_clarification": "горячо любимый"
                            }
                        ]
                    }
                }
            ]
        },
