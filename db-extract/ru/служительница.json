                "senses": [
                    {
                        "sense_id": "d9702ddd-ecf5-3ad4-9bf7-55afa3ca8605",
                        "entry_id": "d65e8000-76a5-3fd8-84d4-32863f775796",
                        "glosses": [
                            "женск. к служитель; служащая низшего ранга в некоторых учреждениях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ae39e96-bd69-4e6c-98b0-79c0f9f9e9f9",
                                "sense_id": "d9702ddd-ecf5-3ad4-9bf7-55afa3ca8605",
                                "text": "Я даже сбегал за парой банок пива, но служительница зоопарка отказалась передать гиббону пиво."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e2b98a0-0698-3bcc-9e55-a5e3d642a700",
                        "entry_id": "d65e8000-76a5-3fd8-84d4-32863f775796",
                        "glosses": [
                            "женск. к служитель; перен. та, кто отдаёт себя служению чему-либо, работает во имя чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0023a511-c3e1-4a93-b82f-83de5aa934c7",
                                "sense_id": "0e2b98a0-0698-3bcc-9e55-a5e3d642a700",
                                "text": "Казалось бы, блуднице, будь то тривиальная неверная жена или иноземная служительница богини сладострастия, свойственно в первую очередь употреблять иные, более плотские, более непосредственные соблазны, нежели риторику❬…❭"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05b43c0d-9844-4a36-8481-bc30aed50c06",
                        "source_entry_id": "d65e8000-76a5-3fd8-84d4-32863f775796",
