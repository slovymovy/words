                                                "sense_id": "2ae3d945-2139-371b-bac3-511ebb766950",
                                                "text": "the achromatism of a lens"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df8dd1a8-691c-3066-a07d-a541e6431b6a",
                                        "entry_id": "910518b7-7eec-3345-ba73-91fad8c319af",
                                        "glosses": [
                                            "The state of being free of colors, not emitting or separating into colors."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70615a78-6225-4271-aa8c-2e2b675e71a7",
                                                "sense_id": "df8dd1a8-691c-3066-a07d-a541e6431b6a",
                                                "text": "No flaming flower relieved its black achromatism although that tree had been known long ago to burst open with a three-hour glory."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a112595-dc0a-36ae-b389-6ad23199dd8e",
