                "senses": [
                    {
                        "sense_id": "e9521be2-9b7b-38d3-910a-18a6e8a91101",
                        "entry_id": "249347ca-0dbd-3df8-9ea7-b40745e9e746",
                        "glosses": [
                            "mannelijk jong kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad709520-859d-47e3-9881-f9b33d26d24b",
                                "sense_id": "e9521be2-9b7b-38d3-910a-18a6e8a91101",
                                "text": "Maar, God-zij-geloofd! het Kloempke had buiten zijn leest, zijn hamer en zijn nagelenbak, ook nog iets anders om op te bouwen en dat was zijn viool. Die had hij, toen hij nog een broekvent was van een jaar of twaalf, dertien, boven op zolder bij zijn grootmoeder, in een oude kist gevonden."
                            }
                        ]
                    },
                    {
                        "sense_id": "19845615-cc3a-3863-9b22-b68d59c4010c",
                        "entry_id": "249347ca-0dbd-3df8-9ea7-b40745e9e746",
                        "glosses": [
                            "kleine, onervaren of onbelangrijke man"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d8d9e41d-8b9e-40f4-96f2-4253bde13d42",
                                "sense_id": "19845615-cc3a-3863-9b22-b68d59c4010c",
                                "text": "Van Lint heeft zeer mooie dingen gemaakt. Bertrand, Servranckx. En een Tapiès is beslist geen broekvent. Vooral de Amerikanen zou ik niet onderschatten."
                            }
                        ]
                    }
                ],
