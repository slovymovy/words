        "fr-extract.jsonl": [
            {
                "entry_id": "4b43daf0-feb4-351f-b65a-bc0c398f9c80",
                "word": "entours",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e9cd860a-e1c1-3d3d-99ec-c00883ef799f",
                        "entry_id": "4b43daf0-feb4-351f-b65a-bc0c398f9c80",
                        "glosses": [
                            "Environs."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "651dfb61-b54f-430a-a913-f55694bfbece",
                                "sense_id": "e9cd860a-e1c1-3d3d-99ec-c00883ef799f",
                                "text": "Il s’est assuré des entours de la place."
                            },
                            {
                                "example_id": "8f2e1076-dfc1-4e1f-a315-edabd6217b9b",
                                "sense_id": "e9cd860a-e1c1-3d3d-99ec-c00883ef799f",
                                "text": "Pour être au calme et tranquille, vous ne trouverez pas mieux à dix lieues d’entours !"
                            }
                        ]
                    },
                    {
                        "sense_id": "4d478ad8-e039-316e-b799-bba4e1b18aee",
                        "entry_id": "4b43daf0-feb4-351f-b65a-bc0c398f9c80",
                        "glosses": [
                            "…."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "05f83499-0276-49cd-9958-07f39808cd1c",
                                "sense_id": "4d478ad8-e039-316e-b799-bba4e1b18aee",
                                "text": "Les entours de quelqu’un, Ceux qui vivent dans sa familiarité, qui forment sa société intime et qui ont quelque influence sur lui."
                            },
                            {
                                "example_id": "cc3dce8b-f5e3-4039-b6fd-abf53dfa672d",
                                "sense_id": "4d478ad8-e039-316e-b799-bba4e1b18aee",
                                "text": "Cet homme est gouverné par ses entours."
                            },
                            {
                                "example_id": "77204846-f8b8-41d2-9a1c-70290ae55eba",
                                "sense_id": "4d478ad8-e039-316e-b799-bba4e1b18aee",
                                "text": "Mais tel était le dévouement de tous et de chacun à la personne du premier consul, telle était l'affection qu'il savait inspirer à ses entours, que nulle des personnes attachées à son service ne fut même un instant soupçonnée d'avoir trempé dans cet infâme attentat."
                            }
                        ]
                    },
                    {
                        "sense_id": "d41defb9-36db-3229-bac2-bf5b853ad60a",
                        "entry_id": "4b43daf0-feb4-351f-b65a-bc0c398f9c80",
                        "glosses": [
                            "…."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "dcad3bf6-18d2-4d0d-9951-c32a6c3e65b5",
                                "sense_id": "d41defb9-36db-3229-bac2-bf5b853ad60a",
                                "text": "Savoir bien prendre les entours, Savoir mettre dans ses intérêts ceux qui ont du crédit sur l’esprit des personnes dont on a besoin."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb4aac37-88a2-38a2-bab9-7a9687b9bbc0",
                        "entry_id": "4b43daf0-feb4-351f-b65a-bc0c398f9c80",
                        "glosses": [
                            "…."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "26c10eb6-d9c7-4254-8bd3-b0486f631ae6",
                                "sense_id": "cb4aac37-88a2-38a2-bab9-7a9687b9bbc0",
                                "text": "Les entours d’une question."
                            },
                            {
                                "example_id": "0fe74c32-7ca0-4e65-a84b-4c9ad1a23968",
                                "sense_id": "cb4aac37-88a2-38a2-bab9-7a9687b9bbc0",
                                "text": "Il a bien étudié les entours de son sujet, Tout ce qui concerne ce sujet, cette question."
                            }
                        ]
                    }
                ],
