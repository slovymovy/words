                    {
                        "form_id": "b1a857d9-38d8-4d58-a3c6-d70aa4c343d0",
                        "entry_id": "b91301aa-450d-3d30-9355-811e0a322032",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zweckmäßigkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1b1c393-528f-3b06-a222-94e348913a4c",
                        "entry_id": "b91301aa-450d-3d30-9355-811e0a322032",
                        "glosses": [
                            "Zustand und/oder Eigenschaft, für seinen Zweck dienlich, angemessen zu sein; Nützlichkeit; Nutzen von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045ed5a8-7db0-4d7c-8a09-cd40169359fb",
                                "sense_id": "f1b1c393-528f-3b06-a222-94e348913a4c",
                                "text": "„Er stellt nun die Wirksamkeit und Zweckmäßigkeit von Impfungen ganz allgemein in Frage.“"
                            },
                            {
                                "example_id": "41765971-7859-4c0e-af71-9763b6ea8586",
                                "sense_id": "f1b1c393-528f-3b06-a222-94e348913a4c",
                                "text": "„Das Gericht hat nicht über die Zweckmäßigkeit und Sinnhaftigkeit des Rettungspaketes entschieden, sagte Gerichtspräsident Voßkuhle.“"
                            },
                            {
                                "example_id": "b48d8023-cbc3-42a5-a0e2-7096c8caa3c2",
                                "sense_id": "f1b1c393-528f-3b06-a222-94e348913a4c",
                                "text": "„Unser moderner Sprachgebrauch wird durch Grundsätze wie Knappheit und Genauigkeit, Sachlichkeit und Zweckmäßigkeit bestimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6a5ee36-d32f-4ccb-be75-62648a70160d",
                        "source_entry_id": "b91301aa-450d-3d30-9355-811e0a322032",
                        "source_sense_id": "f1b1c393-528f-3b06-a222-94e348913a4c",
                        "target_lang_word": "expediency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expediency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "595b3b92-0f16-3d88-a0d0-c6aba3e0c39f",
                                        "entry_id": "e69d625f-e68f-38c6-aa2b-4d5a854ee3fe",
                                        "glosses": [
                                            "The quality of being fit or suitable to effect some desired end or the purpose intended; suitability for particular circumstance or situation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4645fdc-dbd1-40f1-ab9d-31d572c94dad",
                                                "sense_id": "595b3b92-0f16-3d88-a0d0-c6aba3e0c39f",
                                                "text": "Imperfet governments […] may palliate crimes upon the plea of necessity or expediency; divine wisdom discovers no expediency in vice; […]"
                                            },
                                            {
                                                "example_id": "a4d17020-07a3-4541-b00d-64149f061fc7",
                                                "sense_id": "595b3b92-0f16-3d88-a0d0-c6aba3e0c39f",
                                                "text": "Much declamation may be heard in the present day against “expediency”, as if it were not the proper object of a Deliberative Assembly, and as if it were only pursued by the unprincipled."
                                            },
                                            {
                                                "example_id": "8eec9579-0b2f-47c1-accd-97a796d3d6ca",
                                                "sense_id": "595b3b92-0f16-3d88-a0d0-c6aba3e0c39f",
                                                "text": "However, by that time the powerful tides of political unionism, metropolitan fashion and commercial expediency were flowing against the language, at least among the Scottish elites."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f3ebf7c-7945-304a-a39e-c68c6ec10817",
                                        "entry_id": "e69d625f-e68f-38c6-aa2b-4d5a854ee3fe",
                                        "glosses": [
                                            "Pursuit of the course of action that brings the desired effect even if it is unjust or unprincipled."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13156e65-1307-4151-9454-e30adcf084f9",
                                                "sense_id": "6f3ebf7c-7945-304a-a39e-c68c6ec10817",
                                                "text": "Utterly neglectful of what he owes to the kingdom which he hopes to regain, Charles has learned but adversity's worst lesson—expediency."
                                            },
                                            {
                                                "example_id": "9ddaff77-3849-4b36-97eb-685b813a5f92",
                                                "sense_id": "6f3ebf7c-7945-304a-a39e-c68c6ec10817",
                                                "text": "Others warned the British government’s approach would be imitated, for political expediency, by authorities elsewhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a0c6f50-dd56-3149-bc63-6661e5af80d5",
                                        "entry_id": "e69d625f-e68f-38c6-aa2b-4d5a854ee3fe",
                                        "glosses": [
                                            "Haste; dispatch."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c9b87df-876d-36ea-9b5c-8e176c88956b",
                                        "entry_id": "e69d625f-e68f-38c6-aa2b-4d5a854ee3fe",
                                        "glosses": [
                                            "An expedient."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
