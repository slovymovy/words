                            {
                                "target_word": "bevrijdend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bbab07bc-b2dd-3ed4-8a8b-f9f688c04737",
                                        "entry_id": "b97dfe48-3db8-3959-81a6-6dfd31a27bff",
                                        "glosses": [
                                            "van iets dat men er minder gespannen door wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ae88a98-15a2-433e-a548-47699255e06d",
                                                "sense_id": "bbab07bc-b2dd-3ed4-8a8b-f9f688c04737",
                                                "text": "In deze fase leek Oranje de groepswinst al definitief af te dwingen, maar de bevrijdende 1-0 viel pas na rust na een scherp aangemeten vrije trap van Sherida Spitse. Anouk Dekker kopte met hulp van haar eigen schouder raak."
                                            },
                                            {
                                                "example_id": "4792ec4e-3f32-47f0-99b8-fb312a95c81d",
                                                "sense_id": "bbab07bc-b2dd-3ed4-8a8b-f9f688c04737",
                                                "text": "Ze kan het bevrijdende gevoel op het schip nog goed herinneren."
                                            },
                                            {
                                                "example_id": "f3bbcca3-38ad-48ec-9dd5-8f29b2239592",
                                                "sense_id": "bbab07bc-b2dd-3ed4-8a8b-f9f688c04737",
                                                "text": "Vanzelfsprekend was dat niet de verstandigste bezigheid op een hoogte van 4000 meter, vol in de zon, maar er was maar één dag per jaar om net zo naakt als Adam door het paradijs te wandelen en dat wilde ik niet missen. Ik smeerde me van top tot teen in met factor 50, hees mijn zware rugzak op mijn rug en liep omhoog richting ‘Pinchot Pass’. Het was even wennen, maar al snel voelde het bevrijdend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd360e39-583a-4b2c-8d64-a8c6ce4a9e81",
                        "source_entry_id": "6a61d1c5-be52-3e61-8cfc-5d4574200c3b",
                        "source_sense_description": "purgative; inducing catharsis",
                        "target_lang_word": "cathartique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cathartique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2fefc3-4967-32b0-9374-ef7e224ba791",
                                        "entry_id": "489f33e2-e2be-3108-8fcb-98d7450fe879",
                                        "glosses": [
                                            "Relatif à la catharsis, qui produit une action purificatrice, libératrice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e87f4151-41ad-47bc-99df-4f5657e99d66",
                                                "sense_id": "fe2fefc3-4967-32b0-9374-ef7e224ba791",
                                                "text": "La méthode cathartique est une méthode psychothérapique reposant sur la recherche de la catharsis chez le patient, pratiquée par Freud avant la mise au point de la méthode psychanalytique proprement dite."
                                            },
                                            {
                                                "example_id": "b1c3b379-5056-4dc5-94b9-2063a83a4f8b",
                                                "sense_id": "fe2fefc3-4967-32b0-9374-ef7e224ba791",
                                                "text": "Est-il permis d’avoir une vie privée compliquée quand la grande Histoire elle-même se complique à son tour et devient folle ? C’était cette rencontre entre l’Histoire et son histoire personnelle, la nôtre, qui mettait ma mère au rouet et dont Monny fut le messager cathartique."
                                            },
                                            {
                                                "example_id": "104c72ea-f63e-4d3e-a649-8aec7ddad068",
                                                "sense_id": "fe2fefc3-4967-32b0-9374-ef7e224ba791",
                                                "text": "Mais raconter ce qui vous est arrivé est toujours cathartique."
                                            },
                                            {
                                                "example_id": "ef3c6373-1ade-48af-9162-7f68a333f088",
                                                "sense_id": "fe2fefc3-4967-32b0-9374-ef7e224ba791",
                                                "text": "Forts de cette ultime confidence, les recherchistes ont repéré une jeune fille nommée Irlande. Sa présence a eu sur madame Beaudoin un effet cathartique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ec77b63-6361-3b42-833e-93cb2b159364",
                                        "entry_id": "489f33e2-e2be-3108-8fcb-98d7450fe879",
                                        "glosses": [
                                            "Purgatif."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e836479-f048-4842-b236-d237abb3af52",
                                                "sense_id": "0ec77b63-6361-3b42-833e-93cb2b159364",
                                                "text": "Poudre cathartique."
                                            }
                                        ]
                                    }
                                ]
                            },
