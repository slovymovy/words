                        "sense_id": "130b910b-8928-3bf1-84b2-532c0b693d94",
                        "entry_id": "79d68607-fadb-36aa-8aa5-4db1843ab5ab",
                        "glosses": [
                            "To make the sign of the cross on or over something or someone."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2671f98c-409c-41f0-a02b-458b75e00d77",
                                "sense_id": "130b910b-8928-3bf1-84b2-532c0b693d94",
                                "text": "Saining is the grand protection against them; a Shetlander always sains himself when passing by their hills."
                            }
                        ]
                    },
                    {
                        "sense_id": "97e9b455-edec-3737-9bb4-5807625897f9",
                        "entry_id": "79d68607-fadb-36aa-8aa5-4db1843ab5ab",
                        "glosses": [
                            "To make the sign of the cross."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b7a6fddc-fbcd-3240-9cfe-8091f868193c",
                        "entry_id": "79d68607-fadb-36aa-8aa5-4db1843ab5ab",
                        "glosses": [
                            "To bless, to keep from evil influence."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "5e50ddb5-8782-4cf3-a597-7c4ee291fd09",
                                "sense_id": "b7a6fddc-fbcd-3240-9cfe-8091f868193c",
                                "text": "Sain usǃ Sain us, oh Godǃ."
                            },
                            {
                                "example_id": "4888684d-c7c9-4185-a98c-14fd627f9038",
                                "sense_id": "b7a6fddc-fbcd-3240-9cfe-8091f868193c",
                                "text": "Far from my speech stands he who sains and saves."
                            },
                            {
                                "example_id": "00319bfd-e716-4546-9aca-18efab696d51",
                                "sense_id": "b7a6fddc-fbcd-3240-9cfe-8091f868193c",
                                "text": "The child was sained then. Fir candles were lighted and whirled round the bed in which mother and infant lay."
                            }
                        ]
                    }
