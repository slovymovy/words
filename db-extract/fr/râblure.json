                                "sense_id": "61c78ef2-ae0f-331d-bb94-bf121fb8afba",
                                "text": "La râblure est le point délicat de tout bateau en bois."
                            },
                            {
                                "example_id": "095fcb08-9ba7-4aab-89a5-9e2f5c7996ab",
                                "sense_id": "61c78ef2-ae0f-331d-bb94-bf121fb8afba",
                                "text": "Dans le cas d’une râblure conservant le même profil sur la longueur de la quille, c’est la forme du galbord qui évolue."
                            }
                        ]
                    }
