            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "247e7a89-b246-39b9-9c22-e18419c0c0d3",
                    "sense_definition": "Sert à souligner une évidence ou une réponse spontanée, notamment devant oui ou non.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu viens avec nous ce soir ? — <w>Bah</w> oui, bien sûr !"
                        },
                        {
                            "text": "<w>Bah</w> non, je ne savais pas du tout que le magasin était fermé."
                        }
                    ],
                    "synonyms": [
                        "ben"
                    ],
                    "common_phrases": [
                        "bah oui",
                        "bah non"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier et oral"
                        }
                    ]
                },
                {
                    "sense_id": "ec5bc885-8141-3b74-8591-7f30b5a4144b",
                    "sense_definition": "Sert de mot de remplissage pour se donner le temps de réfléchir ou d'hésiter.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "hesitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Que veux-tu manger ce midi ? — <w>Bah</w>, je ne sais pas trop, une salade peut-être."
                        },
                        {
                            "text": "<w>Bah</w>, c'est difficile à expliquer en quelques mots simples."
                        }
                    ],
                    "synonyms": [
                        "ben"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier et oral"
                        }
                    ]
                },
                {
                    "sense_id": "9f59a551-c87a-3f1b-b3c7-aa8e97255e47",
                    "sense_definition": "Exprime le détachement, la résignation ou l'indifférence face à une situation sans gravité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "resignation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le train est parti sans nous, mais <w>bah</w>, nous prendrons le suivant dans une heure."
                        },
                        {
                            "text": "Nous avons perdu ce match amical, mais <w>bah</w>, ce n'est pas très grave."
                        }
                    ],
                    "synonyms": [
                        "bast"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "b55c0784-108e-32cf-a01c-9634f1c855fe",
                    "sense_definition": "Exprime le doute, l'incrédulité ou l'étonnement devant une affirmation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "doute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ah <w>bah</w>, je n'aurais jamais cru qu'il accepterait cette proposition immédiatement !"
                        },
                        {
                            "text": "<w>Bah</w>, tu crois vraiment qu'il va réussir tout seul sans notre aide ?"
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                }
