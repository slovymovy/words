                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "赫尔姆",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90570cb2-2c44-3535-a296-c6d2264a75ab",
                    "sense_definition": "A place name, specifically several unincorporated communities in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small community of <w>Helm</w> is located in Fresno County, California.",
                            "target_lang_translations": {
                                "ru": "Небольшая община <w>Хелм</w> расположена в округе Фресно, штат Калифорния.",
                                "zh": "赫尔姆小社区位于加利福尼亚州的弗雷斯诺县。"
                            }
                        },
                        {
                            "text": "They drove through <w>Helm</w> while traveling across the rural parts of Kentucky.",
                            "target_lang_translations": {
                                "ru": "Они проезжали через <w>Хелм</w>, путешествуя по сельским районам Кентукки.",
                                "zh": "他们在穿越肯塔基州农村地区时开车经过了赫尔姆。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "specific to US geography"
