                "senses": [
                    {
                        "sense_id": "a96899a3-9493-38ab-9eee-41bcd9f50b96",
                        "entry_id": "4508f9db-8f02-3015-9862-bd886f344a32",
                        "glosses": [
                            "Bewegung eines Organismus, bei der sich der Körper durch abwechselndes Abstoßen der Gliedmaßen fortbewegt und dabei für einen kurzen Zeitraum kein Bodenkontakt besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02d24fea-26c7-4b91-806f-c2eb4abfcb95",
                                "sense_id": "a96899a3-9493-38ab-9eee-41bcd9f50b96",
                                "text": "„Skistöcke unterstützen die Laufbewegung.“"
                            },
                            {
                                "example_id": "32a161d6-cd53-4092-a055-ff9c503c2331",
                                "sense_id": "a96899a3-9493-38ab-9eee-41bcd9f50b96",
                                "text": "„Durch Wechselwirkungen zwischen den verschiedenen zentralnervösen Automatismen können koordinierte Bewegungen erfolgen, z. B. Schlängeln bei Aal und Schlangen, Laufbewegungen bei Insekten, Flossenschlag der Fische.“"
                            }
                        ],
