                                                "example_id": "a6afa8cd-713b-48b7-b383-6cc50452873b",
                                                "sense_id": "d3a17f01-2b95-3c89-8904-b8666d027b7a",
                                                "text": "Hi, Amelia! Are you busy? — I’m a little busy."
                                            },
                                            {
                                                "example_id": "726cf222-6de4-4291-b516-fa2a07e28eab",
                                                "sense_id": "d3a17f01-2b95-3c89-8904-b8666d027b7a",
                                                "text": "Scrooge McDuck \"A little salty.\"\nZeus \"Dip not good enough for you mortal? You offend Olympus!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fac483b0-1ee9-3b4f-a4fb-0a35b80a7ffe",
                                        "entry_id": "f41ab9cc-6491-3baf-b6a8-de40f750d70b",
                                        "glosses": [
                                            "Slightly."
