                    {
                        "translation_id": "b4998d8f-4c68-403f-b759-dc589a24f0cd",
                        "source_entry_id": "cab8e68c-01b8-32c9-b85e-51fb8c46a0b1",
                        "source_sense_id": "e8634d07-0539-3375-a22b-3ad869117d5c",
                        "source_sense_description": "Menge der distinktiven Merkmale, in denen zwei Phoneme übereinstimmen",
                        "target_lang_word": "archiphoneme",
