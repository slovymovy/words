                        "entry_id": "fc91774b-4d86-34c5-a13e-37ffeed3a7e0",
                        "glosses": [
                            "отдельный кусочек листа сухого или заваренного чая"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": [
                            {
                                "example_id": "2cb4f7b9-47a7-40d4-a5dc-fd0b5ddd2c9e",
                                "sense_id": "a34a35f9-c0f8-3735-82a0-6824fff97903",
                                "text": "Под круглой крышкой моего чайника лишь разбухшие тёмно-зелёные чаинки."
                            },
                            {
                                "example_id": "09915bff-b5f4-49fc-ba03-ac90dddacdc3",
                                "sense_id": "a34a35f9-c0f8-3735-82a0-6824fff97903",
                                "text": "Буршин смотрел в стакан, где вертикально плавала чаинка."
                            }
                        ]
                    }
