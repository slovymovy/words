                "senses": [
                    {
                        "sense_id": "29c37f6f-725a-3612-bf78-ac7509f3e9b4",
                        "entry_id": "4ef71fde-ca35-3c53-ae53-8679391263d5",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcf4c8b9-58ab-40dc-83a3-768c514fa5fb",
                                "sense_id": "29c37f6f-725a-3612-bf78-ac7509f3e9b4",
                                "text": "Frau Faißt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "45741ae4-b5e2-4d56-b93d-1bd70cf2cee2",
                                "sense_id": "29c37f6f-725a-3612-bf78-ac7509f3e9b4",
                                "text": "Herr Faißt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "cc67d641-faac-42e3-be97-f414dd2fa881",
                                "sense_id": "29c37f6f-725a-3612-bf78-ac7509f3e9b4",
                                "text": "Die Faißts fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "bcc75bab-ebd7-4cac-a0b8-05e77d33df46",
                                "sense_id": "29c37f6f-725a-3612-bf78-ac7509f3e9b4",
                                "text": "Der Faißt trägt nie die Pullover, die die Faißt ihm strickt."
                            },
                            {
                                "example_id": "5922ec4c-38e3-4893-a81d-c52b8a0e9727",
                                "sense_id": "29c37f6f-725a-3612-bf78-ac7509f3e9b4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Faißt kommt, geht der Herr Faißt.“"
                            },
                            {
                                "example_id": "0f6c9a37-044c-4afe-a5e9-7275a023003a",
                                "sense_id": "29c37f6f-725a-3612-bf78-ac7509f3e9b4",
                                "text": "Faißt kommt und geht."
                            },
                            {
                                "example_id": "6e4a8f25-997f-4dad-8ad8-1d8207dc5314",
                                "sense_id": "29c37f6f-725a-3612-bf78-ac7509f3e9b4",
                                "text": "Faißts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
