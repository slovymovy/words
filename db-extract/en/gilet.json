                    {
                        "translation_id": "4979d671-fa57-45e1-863c-5f2a2850dfc7",
                        "source_entry_id": "ae991c58-05b6-3935-b7a5-731fc45ac184",
                        "source_sense_description": "sleeveless jacket resembling a waistcoat but generally closed at the neck; specifically, one which is padded to provide warmth",
                        "target_lang_word": "жиле́т",
                        "target_lang_code": "ru",
