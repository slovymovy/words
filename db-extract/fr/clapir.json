                "senses": [
                    {
                        "sense_id": "9de38081-4f68-3c90-9a9e-ddfba3691352",
                        "entry_id": "62cf76a2-9c78-33ac-a14c-fc47a766395e",
                        "glosses": [
                            "Crier en parlant du lapin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed49f160-dd96-403d-9733-5e58c4692deb",
                                "sense_id": "9de38081-4f68-3c90-9a9e-ddfba3691352",
                                "text": "Quand j’étais enfant, je regardais fasciné le mâle monter la femelle un bref instant puis s’écrouler comme mort en clapissant."
                            }
                        ]
                    },
                    {
                        "sense_id": "b33b7d30-b91b-35cb-8aba-4628603e5abd",
                        "entry_id": "62cf76a2-9c78-33ac-a14c-fc47a766395e",
                        "glosses": [
                            "Se blottir, se tapir, se cacher dans un trou. Se dit particulièrement des lapins ou par métaphore."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "32bf16aa-1c52-4680-9c0c-68a98ed8ebbc",
                                "sense_id": "b33b7d30-b91b-35cb-8aba-4628603e5abd",
                                "text": "On se clapissait comme des lapins pour échapper aux balles."
                            }
                        ]
                    }
