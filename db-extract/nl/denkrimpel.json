                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a956d14-5265-4ab0-86cf-c5bf5e2ba33d",
                                "sense_id": "7d391412-617c-3a3e-8dd4-6e32f18178cc",
                                "text": "Ik zag een denkrimpel tussen zijn ogen, zo'n verticale waarvan je weet dat die over een jaar of twintig permanent zichtbaar zal zijn."
                            },
                            {
                                "example_id": "de94f3cb-f91c-415e-9f49-f686645d5556",
                                "sense_id": "7d391412-617c-3a3e-8dd4-6e32f18178cc",
                                "text": "Aan tafel declameert Brennan vol vuur WB Yeats-gedichten, die vooral bij de niet-Britten in het gezelschap nog een extra denkrimpel opleveren. Ook bij oosterbuur Martin, die, ondanks zijn bekentenis dat hij bij sommige gedichten 'keine Ahnung' heeft, de sfeer én de heerlijke maaltijd roemt: zelfs hij beleeft een topavond."
                            }
                        ]
                    }
