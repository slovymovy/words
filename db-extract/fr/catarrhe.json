        "fr-extract.jsonl": [
            {
                "entry_id": "bf3f9986-d05c-39d8-82ca-91028b9537c9",
                "word": "catarrhe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b32d008f-ff4c-485f-87bc-843750738321",
                        "entry_id": "bf3f9986-d05c-39d8-82ca-91028b9537c9",
                        "tags": [
                            "plural"
                        ],
                        "form": "catarrhes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "346a45f5-fb8f-3ef3-8b10-edaecaaa5fac",
                        "entry_id": "bf3f9986-d05c-39d8-82ca-91028b9537c9",
                        "glosses": [
                            "Terme générique par lequel les anciens médecins ont désigné tout écoulement d’un liquide, plus ou moins clair ou épais, par une membrane muqueuse, quelle qu’en soit d’ailleurs la cause."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8b8798c-4c39-4cf4-8235-2103e8bfa77a",
                                "sense_id": "346a45f5-fb8f-3ef3-8b10-edaecaaa5fac",
                                "text": "Catarrhe pulmonaire. Catarrhe de la vessie, etc."
                            },
                            {
                                "example_id": "ea8f24aa-0f83-4038-8706-abd133f74231",
                                "sense_id": "346a45f5-fb8f-3ef3-8b10-edaecaaa5fac",
                                "text": "À vingt pas de la porte, vous sentez je ne sais quelle odeur glaciale et fade d’eau bénite et de caveau sépulcral que vous apporte un courant d’air chargé de pleurésies et de catarrhes."
                            },
                            {
                                "example_id": "7e2aa7bc-639f-4354-a9d6-be553f636154",
                                "sense_id": "346a45f5-fb8f-3ef3-8b10-edaecaaa5fac",
                                "text": "Les gamins le regardaient par les fentes du mur, et lui jetaient des cailloux, qui tombaient sur son grabat, où il gisait, continuellement secoué par un catarrhe, avec des cheveux très longs, les paupières enflammées, et au bras une tumeur plus grosse que sa tête."
                            }
                        ]
                    },
                    {
                        "sense_id": "1136ff67-6aec-3da7-a8fe-014785bab16a",
                        "entry_id": "bf3f9986-d05c-39d8-82ca-91028b9537c9",
                        "glosses": [
                            "Gros rhume."
                        ],
                        "tags": [
                            "Communément"
                        ],
                        "examples": [
                            {
                                "example_id": "491c2613-b1f1-4b04-884c-940bc8513bad",
                                "sense_id": "1136ff67-6aec-3da7-a8fe-014785bab16a",
                                "text": "Avant que de finir au plat sur ce granit\nÉtais-tu préposé au catarrhe au prurit\nOu bien à résoudre une quinte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c924f813-141d-4cbc-aaa0-45c9ebb17e0f",
                        "source_entry_id": "bf3f9986-d05c-39d8-82ca-91028b9537c9",
                        "target_lang_word": "catarrh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "catarrh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc8dba78-ef8d-34ff-a72a-e65419355b9e",
                                        "entry_id": "595d2f27-f8c0-3c9d-aeb7-0c1867b39378",
                                        "glosses": [
                                            "Inflammation of a mucous membrane.",
                                            "Especially, that of the nose and throat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6da8cc78-eaae-4bad-833a-fe12fa278d5c",
                                                "sense_id": "fc8dba78-ef8d-34ff-a72a-e65419355b9e",
                                                "text": "And then as to your ſcurvys, and gouts, rheumatiſms, conſumptions, coughs and catarrhs, tar-vvater and turpentine vvill make you as ſound as a roach."
                                            },
                                            {
                                                "example_id": "af9f2ff9-098a-4109-94db-170f9e6d33f2",
                                                "sense_id": "fc8dba78-ef8d-34ff-a72a-e65419355b9e",
                                                "text": "Jonah mixed him a pitch-like potion of gin and molasses, which he swore was a sovereign cure for all colds and catarrhs whatsoever […]"
                                            },
                                            {
                                                "example_id": "e33883cf-ffa0-4817-858b-bb0691bbdef1",
                                                "sense_id": "fc8dba78-ef8d-34ff-a72a-e65419355b9e",
                                                "text": "\"Where I went wrong,\" he said, still speaking in that low, husky voice as if he had been a ghost suffering from catarrh, \"was in getting engaged to Phyllis Mills.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5813ca1-e8e4-3375-8d4b-aad97675c548",
                                        "entry_id": "595d2f27-f8c0-3c9d-aeb7-0c1867b39378",
                                        "glosses": [
                                            "Inflammation of a mucous membrane.",
                                            "The discharge (fluid) associated with this condition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "562368bd-d962-498a-99df-a0257b182792",
                                                "sense_id": "a5813ca1-e8e4-3375-8d4b-aad97675c548",
                                                "text": "He coughed violently and spit out the catarrh irritating his throat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84e31ca0-a690-3018-9c91-45fd9ff3fce4",
                                        "entry_id": "595d2f27-f8c0-3c9d-aeb7-0c1867b39378",
                                        "glosses": [
                                            "Inflammation of a mucous membrane.",
                                            "Rhinitis or rhinosinusitis; cold or coldlike illness; common cold."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "metonymically",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
