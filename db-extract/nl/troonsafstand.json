                                "target_senses": [
                                    {
                                        "sense_id": "bc01325f-1041-3f15-a74f-e3ed896f9bfd",
                                        "entry_id": "a3d91764-3e34-318c-b9be-4aabd7bb3532",
                                        "glosses": [
                                            "The act of disowning or disinheriting a child."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39824326-ff26-3c87-b2d0-37ef0f63fadb",
                                        "entry_id": "a3d91764-3e34-318c-b9be-4aabd7bb3532",
                                        "glosses": [
                                            "The act of abdicating; the renunciation of a high office, dignity, or trust, by its holder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9a5055b-d030-34ee-a945-c3547acebd8f",
                                        "entry_id": "a3d91764-3e34-318c-b9be-4aabd7bb3532",
                                        "glosses": [
                                            "The voluntary renunciation of sovereign power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e92035d-fea6-449a-8d9a-5116d4b8ff80",
                                                "sense_id": "a9a5055b-d030-34ee-a945-c3547acebd8f",
                                                "text": "abdication of the throne, government, power, authority"
                                            },
                                            {
                                                "example_id": "d2b05617-48f5-49f3-bf24-461d29781827",
                                                "sense_id": "a9a5055b-d030-34ee-a945-c3547acebd8f",
                                                "text": "the king’s abdication"
                                            },
                                            {
                                                "example_id": "1b85fa27-8175-4efc-95a3-1a2514ff3a4f",
                                                "sense_id": "a9a5055b-d030-34ee-a945-c3547acebd8f",
                                                "text": "So yes: the abdication was when the Windsors opened the gate. After that it was – and will be – whack-a-mole. Every crisis will draw significant numbers of people out who would ask why you couldn’t cut off whoever was displeasing them in that moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c42da596-70eb-31a1-abe9-ef83c9f543fa",
                                        "entry_id": "a3d91764-3e34-318c-b9be-4aabd7bb3532",
                                        "glosses": [
                                            "The renunciation of interest in a property or a legal claim; abandonment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05260a69-a09b-3687-b264-458a30b91939",
                                        "entry_id": "a3d91764-3e34-318c-b9be-4aabd7bb3532",
                                        "glosses": [
                                            "The action of being deposed from the seat of power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4a81968-ac2b-4606-b891-1421b55633ff",
                        "source_entry_id": "2b389d5f-0bb0-32de-8b88-4b4bda204cb0",
                        "source_sense_id": "cbdb77df-fc2c-333c-a350-fd91e55833ec",
                        "source_sense_description": "het aftreden als vorst",
                        "target_lang_word": "abdication",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abdication",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee912978-1174-3682-beb0-cd64f3553449",
                                        "entry_id": "f1001c30-09c5-344b-8673-aa0cdb5d482a",
                                        "glosses": [
                                            "Action de renoncer à une charge importante."
                                        ],
                                        "tags": [],
                                        "note": "Se dit en parlant de celui qui abdique et de la chose abdiquée",
                                        "examples": [
                                            {
                                                "example_id": "ebe38773-905b-4aca-bbeb-55e3f383b401",
                                                "sense_id": "ee912978-1174-3682-beb0-cd64f3553449",
                                                "text": "Après l'abdication expresse ou légale, le roi sera dans la classe des citoyens, et pourra être accusé et jugé comme eux pour les actes postérieurs à son abdication."
                                            },
                                            {
                                                "example_id": "1fb75af5-0e99-4a68-a952-f3fa624d08ae",
                                                "sense_id": "ee912978-1174-3682-beb0-cd64f3553449",
                                                "text": "C’est là, se dit-il, en s’asseyant sur une des roches d’où se découvre le beau paysage de Bouron, l’endroit fatal où Napoléon espéra faire un effort gigantesque, l’avant-veille de son abdication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8780bba-0dca-37e1-94a8-45aea311ecad",
                                        "entry_id": "f1001c30-09c5-344b-8673-aa0cdb5d482a",
                                        "glosses": [
                                            "Renoncement à ses valeurs, à sa personnalité, à son amour-propre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a075d3f-2533-4601-830b-e4a70b494520",
                                                "sense_id": "d8780bba-0dca-37e1-94a8-45aea311ecad",
                                                "text": "Si ces hommes étaient soumis à ses camarades, jusqu'à l’abdication complète de toute volonté humaine, c'était la peur qui les y contraignait."
                                            },
                                            {
                                                "example_id": "dab24c99-b1da-438c-bbca-fc93e54ed82d",
                                                "sense_id": "d8780bba-0dca-37e1-94a8-45aea311ecad",
                                                "text": "La Pauvreté, ah! la garce! Elle va dans un cortège d'humiliations, de basses rancunes, de fangeuses abdications. Elle traîne, derrière elle, sa sœur la Misère, au rire édenté, aux orbites desséchées, aux doigts mous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3881e40-eed9-3ea5-bd89-2aacb6784e07",
                                        "entry_id": "f1001c30-09c5-344b-8673-aa0cdb5d482a",
                                        "glosses": [
                                            "Acte par lequel un père privait son fils des droits que celui-ci avait, à ce titre, dans sa succession."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "767e902e-6650-4be8-83a2-8aebdbdfe378",
                                                "sense_id": "c3881e40-eed9-3ea5-bd89-2aacb6784e07",
                                                "text": "L’abdication était une exhérédation prononcée pendant la vie et susceptible de révocation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
