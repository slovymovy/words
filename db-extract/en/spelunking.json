                        "entry_id": "d5fab683-a7af-3b24-879e-bc52b996b4af",
                        "glosses": [
                            "The practice or hobby of exploring underground caverns."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "8a1f8bb5-a607-4070-ac79-cb6bf496bda9",
                                "sense_id": "f9629f7c-67a5-3f99-ad59-fe5958a628e5",
                                "text": "In the great myths, the adventures are external, even when they involve such metaphorical spelunkings as the voyage into the underworld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60739036-826d-414d-b497-a59a13182550",
