                "senses": [
                    {
                        "sense_id": "a903ac69-d8c5-3136-a213-e8335c2f9161",
                        "entry_id": "fc0e2859-e68b-3f24-868d-34b1ab9af732",
                        "glosses": [
                            "Klima in einer bestimmten (geographischen) Region"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4624b193-d031-4603-a904-b7ea1a1b2618",
                                "sense_id": "a903ac69-d8c5-3136-a213-e8335c2f9161",
                                "text": "„Von Vergleichen fossiler Pflanzen mit heutigen Arten erhofft sich Rößler zudem, die Klimaverhältnisse vor 290 Millionen Jahren entschlüsseln zu können.“"
                            },
                            {
                                "example_id": "e390b339-51cb-4ce2-bda5-c304ffd1975e",
                                "sense_id": "a903ac69-d8c5-3136-a213-e8335c2f9161",
                                "text": "„Die Versuche etwa, den Anstieg des Treibhauseffektes der Erde vorauszusagen, stützen sich auf Klimamodelle, die sich anhand der Klimaverhältnisse auf anderen Planeten am besten überprüfen lassen.“"
                            },
                            {
                                "example_id": "df7013ec-065f-49e4-8095-51e7816c6d98",
                                "sense_id": "a903ac69-d8c5-3136-a213-e8335c2f9161",
                                "text": "„Die Suche nach Öl und Gas in der Arktis ist wegen der extremen Klimaverhältnisse besonders schwierig.“"
                            },
                            {
                                "example_id": "02bfcd93-5114-4614-b9a2-a1f0bf67e54f",
                                "sense_id": "a903ac69-d8c5-3136-a213-e8335c2f9161",
                                "text": "„22 Prozent der Städte müssen sich demnach sogar auf völlig neue Klimaverhältnisse einstellen.“"
                            },
                            {
                                "example_id": "4a425f87-0549-4bff-97ff-ba7ca9eefe5b",
                                "sense_id": "a903ac69-d8c5-3136-a213-e8335c2f9161",
                                "text": "„Dies gestattet den Experten Aussagen über die Rolle von Wasser bei der Gesteinsbildung und damit Rückschlüsse über frühere Klimaverhältnisse auf dem Mars.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
