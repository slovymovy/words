                "senses": [
                    {
                        "sense_id": "ea37520f-8d7a-36ba-85f6-0e09519ad9d2",
                        "entry_id": "6ef1a108-a21c-35af-a56a-84b068464583",
                        "glosses": [
                            "Enlever son caractère passionnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29b56941-3713-4b9a-b1d3-e20e3e43d96e",
                                "sense_id": "ea37520f-8d7a-36ba-85f6-0e09519ad9d2",
                                "text": "Lorsque le patient-limite se met à ménager son thérapeute, c’est que s’opère la re-fusion pulsionnelle qui va dépassionnaliser le transfert."
                            },
                            {
                                "example_id": "c6b3558a-fde5-4261-a8e7-ee94f2adc73d",
                                "sense_id": "ea37520f-8d7a-36ba-85f6-0e09519ad9d2",
                                "text": "La distance sociale est variable et peut se passionnaliser quand les individualismes s’affirment en toute indépendance, que les relations se contractualisent, mais ces relations peuvent se dépassionnaliser et enfouir l’émotionnel dans un espace privé qui n’existait pas vraiment auparavant (Habermas)."
                            }
                        ]
                    }
                ],
