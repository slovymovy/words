                        "examples": [
                            {
                                "example_id": "781da4f9-3aa1-4021-b70c-dae2ccae8da9",
                                "sense_id": "5c78fe17-f4b2-366d-a505-cfe3e16405e6",
                                "text": "“Suppose I should get up a ballet, drill the girls myself, and learn ’em all the peritropal movements; see that their skirts are short enough, and that they are graceful while dancing.[…]”"
                            },
                            {
                                "example_id": "faf162c9-aa4d-4719-bce0-da5a40f6e87f",
                                "sense_id": "5c78fe17-f4b2-366d-a505-cfe3e16405e6",
                                "text": "Our three-decade friend, Joe A. Kirgan, late of the Milford Gazette, has established a paper at Frost, Navarro county. Joe is a regular peritropal and peripatetic genius, never lasting more than three months in one place."
                            },
                            {
                                "example_id": "b587e586-f0cc-4056-aa6e-13ceff2011d7",
                                "sense_id": "5c78fe17-f4b2-366d-a505-cfe3e16405e6",
                                "text": "My peritropal jaunts were propelled by the sad and dreary loneliness of my hotel room in a downtown that was a shrunken shadow of what it was when Billy Phelan “made a right turn into the warmth of the stairs to Louie’s pool room,[…]”"
                            }
                        ]
                    },
