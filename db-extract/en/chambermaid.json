        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "1b6265a5-308e-3ee4-9363-f17f9ae38780",
                "word": "chambermaid",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "041552ea-36c6-3556-9d2b-b359889d0fe8",
                        "entry_id": "1b6265a5-308e-3ee4-9363-f17f9ae38780",
                        "glosses": [
                            "Stubenmädchen, Zimmermädchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d103a88-52aa-4225-8881-168f59733be7",
                                "sense_id": "041552ea-36c6-3556-9d2b-b359889d0fe8",
                                "text": "She worked as a chambermaid for her majesty for more than 20 years.",
                                "translation": "Sie hat mehr als 20 Jahre als Stubenmädchen Ihrer Majestät gearbeitet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89c309b3-805e-4120-9627-7a1da68fc481",
                        "source_entry_id": "1b6265a5-308e-3ee4-9363-f17f9ae38780",
                        "source_sense_id": "041552ea-36c6-3556-9d2b-b359889d0fe8",
                        "source_sense_description": "Stubenmädchen, Zimmermädchen",
                        "target_lang_word": "Stubenmädchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stubenmädchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bc925ec-89fc-35c7-b9ec-1397e4d5fe87",
                                        "entry_id": "307c339a-c7f4-3f6d-a886-566cd0734076",
                                        "glosses": [
                                            "weibliche Angestellte eines Privathaushaltes oder eines Hotels, die Wohn- und Schlafräume sauber hält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed7e9a1f-2044-47eb-aa32-fd2c46a3bf4d",
                                                "sense_id": "9bc925ec-89fc-35c7-b9ec-1397e4d5fe87",
                                                "text": "Im Herrenhaus arbeiten drei Stubenmädchen."
                                            },
                                            {
                                                "example_id": "69186684-f098-4d21-a9da-87134fec73dd",
                                                "sense_id": "9bc925ec-89fc-35c7-b9ec-1397e4d5fe87",
                                                "text": "„Jetzt kann er nicht mehr zurück, die Autorität des kleinen bayerischen Stubenmädchens zwingt ihn, er geht hinein und macht die Tür leise hinter sich zu.“"
                                            },
                                            {
                                                "example_id": "f88d45d5-1ff5-4e5a-9673-22a460a1baff",
                                                "sense_id": "9bc925ec-89fc-35c7-b9ec-1397e4d5fe87",
                                                "text": "„Das Stubenmädchen ruft mich, draußen stünden zwei Herren, die wollten mich sprechen.“"
                                            },
                                            {
                                                "example_id": "77e34cfb-fa1f-4e0c-b365-abf9564a5f5c",
                                                "sense_id": "9bc925ec-89fc-35c7-b9ec-1397e4d5fe87",
                                                "text": "„Der Hausdiener und ein Stubenmädchen kommen auch und grinsen.“"
                                            },
                                            {
                                                "example_id": "dc146f81-c8ff-4dfd-a2a5-7bb8773ce822",
                                                "sense_id": "9bc925ec-89fc-35c7-b9ec-1397e4d5fe87",
                                                "text": "„Außer in solchen Gaunereien, auf die er sich viel zugute tat, besaß er eine umfassende Erfahrung in Dingen, wie sie die Stubenmädchen treiben oder wie sie in schlecht beleuchteten Hinterzimmern von kleinen Stundenhotels vor sich gehen.“"
                                            },
                                            {
                                                "example_id": "e1d1d716-b24f-4d11-902c-493cbe487baf",
                                                "sense_id": "9bc925ec-89fc-35c7-b9ec-1397e4d5fe87",
                                                "text": "„Ein Stubenmädchen führte sie in den Salon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1401cb83-9982-4d7a-a02c-b461d3fc6ee4",
                        "source_entry_id": "1b6265a5-308e-3ee4-9363-f17f9ae38780",
                        "source_sense_id": "041552ea-36c6-3556-9d2b-b359889d0fe8",
                        "source_sense_description": "Stubenmädchen, Zimmermädchen",
                        "target_lang_word": "Zimmermädchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zimmermädchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                        "entry_id": "91e2e99b-c8ca-3f32-a7ea-f826a833f408",
                                        "glosses": [
                                            "weibliche Person, die für die Pflege von Hotelzimmern beschäftigt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38ae3a4e-4708-4f0a-bb20-1ea6a2403535",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Man will sich ansehen, was am schönsten ist, man fragt den Portier, den Hausdiener, den Kellner und das Zimmermädchen und bekommt von jedem eine andere Antwort, und schließlich hält man sich an den Baedeker und läuft die Sternchen ab, jeder auf seine Weise.“"
                                            },
                                            {
                                                "example_id": "35ff84d8-3650-442c-9270-f1281e6e71a1",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Die Zimmermädchen machen mir spitze Lippen und geben küssende Laute von sich.“"
                                            },
                                            {
                                                "example_id": "4f337ee1-683d-474d-a825-0bc6f2d19c76",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Dort entdeckte ich ein Zimmermädchen in ihren Unterröcken, die gerade dabei war, sich das Korsett zurechtzurücken, und leise Verwünschungen ausstieß.“"
                                            },
                                            {
                                                "example_id": "816b799e-9b09-4bce-84d9-b41ddaacb543",
                                                "sense_id": "917ea4ff-1fb2-308a-ba3b-2c4d921af578",
                                                "text": "„Um acht Uhr klingelte er nach dem Zimmermädchen und ließ sich ein Bad richten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
