                        "target_lang_word": "agglomérer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agglomérer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91baa518-0bed-3c14-9bac-d9d02f7f3d58",
                                        "entry_id": "9c80fa94-543e-381d-8d35-241b20c8c432",
                                        "glosses": [
                                            "Masser en un tout compact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd9bada5-041e-4b03-8359-8e399c2e7d24",
                                                "sense_id": "91baa518-0bed-3c14-9bac-d9d02f7f3d58",
                                                "text": "La richesse du sol agglomère les hommes dans un pays."
                                            },
                                            {
                                                "example_id": "3f4986a1-8cf3-4e0a-8345-280da9ad9e4a",
                                                "sense_id": "91baa518-0bed-3c14-9bac-d9d02f7f3d58",
                                                "text": "Agglomérer diverses industries dans une même ville."
                                            },
                                            {
                                                "example_id": "13d90fe8-454a-4b82-854c-638642ff1375",
                                                "sense_id": "91baa518-0bed-3c14-9bac-d9d02f7f3d58",
                                                "text": "Le rôle des mucus émis par de nombreuses espèces pélagiques pour agglomérer la nourriture est essentiel en formant des agrégats de grande taille qui descendent rapidement, une centaine à quelques centaines de mètres par jour."
                                            },
                                            {
                                                "example_id": "14a97b8a-5893-4601-8711-7241b1f79b4d",
                                                "sense_id": "91baa518-0bed-3c14-9bac-d9d02f7f3d58",
                                                "text": "Les sables se sont agglomérés de manière à former des masses solides."
                                            },
                                            {
                                                "example_id": "ffc1423f-cc45-4bef-9e5a-fdad405a1884",
                                                "sense_id": "91baa518-0bed-3c14-9bac-d9d02f7f3d58",
                                                "text": "Les grains de sable de mes doutes s’agglomérèrent et devinrent un bloc."
                                            },
                                            {
                                                "example_id": "267d39d5-3c41-40ec-9bc5-3c157d23e9cd",
                                                "sense_id": "91baa518-0bed-3c14-9bac-d9d02f7f3d58",
                                                "text": "Des esclaves prirent la fuite, passant du coup au rang d'hommes libres, ou s'agglomérèrent aux barbares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
