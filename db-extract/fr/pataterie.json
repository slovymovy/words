                "senses": [
                    {
                        "sense_id": "f5df2147-b407-37aa-870b-872cb96cf021",
                        "entry_id": "a5a645ae-bc27-3edf-9d5c-f396f26e6318",
                        "glosses": [
                            "Local, endroit, où l’on stocke les patates (Tubercules d’Ipomoea batatas)."
                        ],
                        "tags": [
                            "Louisiane"
                        ],
                        "examples": [
                            {
                                "example_id": "ec6faf69-9a42-48b6-9e11-f157f7808dcc",
                                "sense_id": "f5df2147-b407-37aa-870b-872cb96cf021",
                                "text": "La Louisiane est fière de sa production de patates au point qu’on en fait le sujet de réclames sur les plaques des automobiles. La patate est très goûtée dans la paroisse et l’habitant en est particulièrement friand. … Tu les décharges dans la pataterie , \"einne tite maison pou’ conserver les patates\"."
                            }
                        ]
                    },
                    {
                        "sense_id": "159df332-8793-337e-b2c0-a7f01fb424e6",
                        "entry_id": "a5a645ae-bc27-3edf-9d5c-f396f26e6318",
                        "glosses": [
                            "Restaurant où l’on mange essentiellement des pommes de terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ee5663e-e30d-4406-9d74-2303b663b753",
                                "sense_id": "159df332-8793-337e-b2c0-a7f01fb424e6",
                                "text": "Ou plus ahurissant encore, c’est cet homme-sandwich qui était monté un jour dans le bus de la ligne FX53 pour faire, soi-disant, la promotion d’une nouvelle pataterie en offrant, à tous les passagers, une patate chaude enveloppée dans une feuille d’aluminium."
                            },
                            {
                                "example_id": "cd9efd00-ffd4-44d4-b22a-f3f1b77098c2",
                                "sense_id": "159df332-8793-337e-b2c0-a7f01fb424e6",
                                "text": "Elle déménage à Amiens. Elle travaille comme serveuse dans une pataterie du quartier Saint-Leu, quai Belu."
                            },
                            {
                                "example_id": "c7f3b0b4-6a6a-449b-b6da-d1a92698d02d",
                                "sense_id": "159df332-8793-337e-b2c0-a7f01fb424e6",
                                "text": "Il y en a qui ouvrent des « patateries », d’autres préfèrent être encore plus originaux en jouant avec les œufs..."
                            }
                        ]
                    }
