                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74eaba4-d66a-4ff8-b1e9-2890f6e995f0",
                                "sense_id": "e784e1c2-2b56-3db4-9813-29fdce88f059",
                                "text": "Nach seinem Universitätsstudium, wurde sie zum Doktorin der Biologie promoviert.",
                                "translation": "Après ses études universitaires, elle est devenue docteure en biologie."
                            }
                        ]
