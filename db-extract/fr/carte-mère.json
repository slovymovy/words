                        "sense_id": "5578d9e0-a4b4-3350-ade2-2fd9902ca235",
                        "entry_id": "c7411086-6143-39a2-814f-f969f9d9254d",
                        "glosses": [
                            "Carte électronique qui sert de support aux composants principaux d’un ensemble électronique et éventuellement aux cartes-filles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9aa09b3-f4b0-45e1-9062-f7997f85ec50",
                                "sense_id": "5578d9e0-a4b4-3350-ade2-2fd9902ca235",
                                "text": "Nous étudierons d’abord l’organisation d’un micro-ordinateur (paragraphe 2), la carte-mère ou partie interne principale de l’ordinateur (paragraphe 3), les mémoires périphériques (paragraphe 4), le poste de travail (paragraphe 5), les imprimantes (paragraphe 6), les systèmes d’exploitation et logiciels (paragraphe 7) et divers autres éléments (paragraphe 8), et nous terminerons par quelques conclusions (paragraphe 9)."
                            },
                            {
                                "example_id": "c238f16f-ffb0-46fb-9632-35d7d74d62d0",
                                "sense_id": "5578d9e0-a4b4-3350-ade2-2fd9902ca235",
                                "text": "Ses images les plus impressionnantes restent sans doute celles de cartes-mères d’ordinateurs au rebut, qui, filmées sans aucune indication d’échelle, évoquent d’étranges citadelles futuristes."
                            }
                        ]
                    }
