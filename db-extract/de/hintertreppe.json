                "senses": [
                    {
                        "sense_id": "edaeedaa-ac2e-3556-82b5-6ee2b289784e",
                        "entry_id": "3dde87e6-21a1-3ef2-afc4-a2341b472eea",
                        "glosses": [
                            "auf der Rückseite (des Hauses) befindliche Treppe (die zum Hintereingang führt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f381325-b467-470b-823e-f03ca2a49e3c",
                                "sense_id": "edaeedaa-ac2e-3556-82b5-6ee2b289784e",
                                "text": "„Die Hintertreppe hat einen Ausgang an der Hinterseite eines Gebäudes. Sie dient meistens als Zugang für Personal und Lieferanten.“"
                            },
                            {
                                "example_id": "2f1acbda-08ae-4828-8fbe-ae47702ddd65",
                                "sense_id": "edaeedaa-ac2e-3556-82b5-6ee2b289784e",
                                "text": "„Oft führt die Hintertreppe auch in den Keller.“"
                            },
                            {
                                "example_id": "02d540b4-a4c7-4e59-830e-ea9c0f64b0f7",
                                "sense_id": "edaeedaa-ac2e-3556-82b5-6ee2b289784e",
                                "text": "„Er verschwand wieder in der Küche, und ich ging zur Tür, sah, dass auf der Hintertreppe das Licht brannte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
