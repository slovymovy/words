                        "entry_id": "6a736265-4955-3c31-8c84-bc82bd4157a6",
                        "glosses": [
                            "iemand die bijen houdt voor het verkrijgen van honing"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "51e28679-4b26-4110-88dc-802048cf05f3",
                                "sense_id": "37552a53-1a50-3d8f-a0d4-9aaaa7c23058",
                                "text": "De imker werd gestoken door één van zijn bijen."
                            }
                        ]
