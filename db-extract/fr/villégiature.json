                                                "sense_id": "d2db59e8-0a20-350d-87eb-55bd4a395457",
                                                "text": "„Die Anwesenheit von Engländern an einem Urlaubsort gibt also keinerlei Auskunft über den Reiz des Ortes, seine Schönheit, seine touristischen Möglichkeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d501ea28-55e3-4c40-b9bb-3d0246acf700",
                        "source_entry_id": "6f12cb23-c6ce-3937-a175-b06f5d94a252",
