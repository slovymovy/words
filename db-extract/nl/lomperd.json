                "senses": [
                    {
                        "sense_id": "cbb0c608-571e-3b90-a8e4-49da62c0cd79",
                        "entry_id": "a86dea99-160b-3be4-a51f-8b2314e9deb6",
                        "glosses": [
                            "een onhandig persoon"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d0e99dc0-d7b0-436a-aa21-9b2827b82cb8",
                                "sense_id": "cbb0c608-571e-3b90-a8e4-49da62c0cd79",
                                "text": "Ach, wat ben je toch een lomperd!"
                            }
                        ]
                    },
                    {
                        "sense_id": "0bc2c436-7400-36de-ad9b-b14920ff566d",
                        "entry_id": "a86dea99-160b-3be4-a51f-8b2314e9deb6",
                        "glosses": [
                            "een grof en onbeleefd persoon"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "f843dc82-3fb7-4418-9fb4-3589a3ace91f",
                                "sense_id": "0bc2c436-7400-36de-ad9b-b14920ff566d",
                                "text": "Ga toch weg, jij lomperd!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04f59b15-3fcb-477f-bdaf-3fa69e57b768",
                        "source_entry_id": "a86dea99-160b-3be4-a51f-8b2314e9deb6",
                        "source_sense_id": "cbb0c608-571e-3b90-a8e4-49da62c0cd79",
                        "source_sense_description": "een onhandig persoon",
                        "target_lang_word": "lout",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d0e9b850-6bea-3b54-a349-0c0803423d0b",
                                        "entry_id": "2e3dcf4a-8dff-3dc1-8249-c28029e9e7e9",
                                        "glosses": [
                                            "A troublemaker, often violent; a rude violent person; a yob."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf4f1d0-cb38-49f2-85cd-149ad24ec719",
                                                "sense_id": "d0e9b850-6bea-3b54-a349-0c0803423d0b",
                                                "text": "But the lout looked only to his market, and was not easily repulsed. “He’s there, I tell you,” he persisted. “And for threepence I’ll get you to see him. Come on, your honour! It’s many a Westminster election I’ve seen, and beer running, from Mr. Fox,[…]when maybe it’s your honour’s going to stand! Anyway, it’s, Down with the mongers!”"
                                            },
                                            {
                                                "example_id": "5f2f3574-79b4-4251-afc6-84850536ee48",
                                                "sense_id": "d0e9b850-6bea-3b54-a349-0c0803423d0b",
                                                "text": "You see louts fresh from school kicking grey-haired servants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47b7b171-47b5-328e-a7a1-7c377a668fd5",
                                        "entry_id": "2e3dcf4a-8dff-3dc1-8249-c28029e9e7e9",
                                        "glosses": [
                                            "A clownish, awkward fellow; a bumpkin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d0df43c-9117-41d8-aede-37df46f8a596",
                                                "sense_id": "47b7b171-47b5-328e-a7a1-7c377a668fd5",
                                                "text": "The faire Pamela, whose noble hart I finde doth greatly disdaine, that the trust of her vertue is reposed in such a louts hands, as Dametas, had yet to shew an obedience, taken on a shepeardish apparell[…]",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "3e956f03-c546-4eb2-809d-90aecb22988d",
                                                "sense_id": "47b7b171-47b5-328e-a7a1-7c377a668fd5",
                                                "text": "Sebaſtian, I haue entertained thee, / Partly that I haue neede of ſuch a youth, / That can with ſome diſcretion doe my buſineſſe: / For ’tis no truſting to yond fooliſh Lowt;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed09bde1-2e2d-3dae-896a-9b451b994060",
                                        "entry_id": "f1a91935-fefa-3aac-a1e4-21384754ac14",
                                        "glosses": [
                                            "To treat as a lout or fool; to neglect; to disappoint."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3614e5-3630-4f88-9a2d-3956ff1eecf4",
                                                "sense_id": "ed09bde1-2e2d-3dae-896a-9b451b994060",
                                                "text": "Renowned Talbot doth expect my ayde, / And I am lowted by a Traitor Villaine, / And cannot helpe the noble Cheualier:[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lout",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d34ecec1-d395-34cf-ae03-bfcbd3293c23",
                                        "entry_id": "25742e0e-0957-35b4-a22e-af3dbd3d32ca",
                                        "glosses": [
                                            "To bend, bow, stoop."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d973891-4b02-4f1d-ad41-35e332d0f2d9",
                                                "sense_id": "d34ecec1-d395-34cf-ae03-bfcbd3293c23",
                                                "text": "He faire the knight ſaluted, louting low, / Who faire him quited, as that courteous was[…]."
                                            },
                                            {
                                                "example_id": "286aaefa-bbd5-4e73-b62e-f371fb78ace6",
                                                "sense_id": "d34ecec1-d395-34cf-ae03-bfcbd3293c23",
                                                "text": "And the priest devoutly crossed himself, and turned and louted to the alter."
                                            },
                                            {
                                                "example_id": "5396d553-30f2-458f-98af-566634cafd37",
                                                "sense_id": "d34ecec1-d395-34cf-ae03-bfcbd3293c23",
                                                "text": "He took the cup in his hand and, louting low, returned his best thanks[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af0b3e8b-d451-4888-b3be-f10b012fb215",
                        "source_entry_id": "a86dea99-160b-3be4-a51f-8b2314e9deb6",
