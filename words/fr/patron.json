            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f82e2c1f-33fa-3cf1-9163-86cb76729578",
                    "sense_definition": "Personne qui emploie des salariés ou qui dirige une entreprise commerciale ou artisanale.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon <w>patron</w> m'a accordé quelques jours de congé supplémentaires pour les fêtes."
                        },
                        {
                            "text": "Il a décidé de créer son entreprise pour devenir son propre <w>patron</w>."
                        }
                    ],
                    "synonyms": [
                        "boss",
                        "chef"
                    ],
                    "common_phrases": [
                        "son propre patron",
                        "la tournée du patron"
                    ]
                },
                {
                    "sense_id": "37909125-2937-3622-9084-a70e9d994957",
                    "sense_definition": "Modèle en papier ou en carton représentant les différentes parties d'un vêtement à découper dans l'étoffe.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "couture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle pose les pièces du <w>patron</w> sur le tissu avant de commencer la découpe."
                        },
                        {
                            "text": "Ce magazine propose un magnifique <w>patron</w> pour coudre une robe d'été."
                        }
                    ],
                    "common_phrases": [
                        "patron de couture",
                        "patron en papier"
                    ]
                },
                {
                    "sense_id": "23b8d978-9c8d-31fd-9c8c-d14726e39286",
                    "sense_definition": "Saint choisi comme protecteur d'une communauté, d'une corporation, d'une église ou d'un individu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Saint Nicolas est le saint <w>patron</w> des écoliers et des mariniers."
                        },
                        {
                            "text": "Toute la paroisse célèbre la fête de son saint <w>patron</w> au début du mois."
                        }
                    ],
                    "common_phrases": [
                        "saint patron"
                    ]
                },
                {
                    "sense_id": "63227c58-ae3a-3047-8fff-9dd3bff5e010",
                    "sense_definition": "Personne qui commande l'équipage d'un petit bâtiment de mer ou d'une embarcation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>patron</w> du chalutier a décidé de rentrer au port avant la tempête."
                        },
                        {
                            "text": "Ce marin expérimenté est devenu le <w>patron</w> de son propre bateau de pêche."
                        }
                    ],
                    "common_phrases": [
                        "patron de pêche",
                        "patron d'embarcation"
                    ]
                },
                {
                    "sense_id": "ffc91503-4221-39f0-b2c4-2ae3059cbf73",
                    "sense_definition": "Citoyen influent de la Rome antique qui accordait sa protection financière et judiciaire à des clients.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "histoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, les clients venaient saluer leur <w>patron</w> pour recevoir un soutien financier."
                        },
                        {
                            "text": "Le riche patricien exerçait son rôle de <w>patron</w> envers un grand nombre de plébéiens."
                        }
                    ]
                },
                {
                    "sense_id": "9ac10f59-0618-37b3-a6a6-2b71d98765a0",
                    "sense_definition": "Personne qui exploite la prostitution ou gère un établissement de prostitution.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "argot_social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police judiciaire a arrêté le <w>patron</w> d'un réseau de maisons closes clandestines."
                        },
                        {
                            "text": "Il reversait une partie de ses gains illégaux au <w>patron</w> qui contrôlait le quartier."
                        }
                    ],
                    "synonyms": [
                        "proxénète"
                    ],
                    "traits": [
