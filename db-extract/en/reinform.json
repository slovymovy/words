                        "source_entry_id": "93fc604c-3d68-3163-8038-7932fbfd4bfd",
                        "source_sense_id": "1fa7185b-9ae0-3b93-a48a-7a602be93bc8",
                        "source_sense_description": "etwas neu mitteilen",
                        "target_lang_word": "mitteilen",
