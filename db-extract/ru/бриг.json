                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brigg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4566670-4a5b-3c1a-814d-db22f10c06a4",
                                        "entry_id": "45fec0fc-89dd-387a-b2bc-04b05f27df8e",
                                        "glosses": [
                                            "Segelschiff mit zwei Masten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1781c489-ff04-4df0-870e-2a4f0ac40e9f",
                                                "sense_id": "a4566670-4a5b-3c1a-814d-db22f10c06a4",
                                                "text": "„John Wright ließ David Reed Morehouse, den Kapitän der Brigg, benachrichtigen, der kurze Zeit später an Deck erschien.“"
                                            },
                                            {
                                                "example_id": "8f0a2b00-5d4e-4432-8a9b-af91662d3cd3",
                                                "sense_id": "a4566670-4a5b-3c1a-814d-db22f10c06a4",
                                                "text": "„Der kleine Hafen von Gloucester lag im Norden des Burggeländes am Ufer des Severn, der bis dorthin für kleine Briggs und große Flussboote befahrbar war.“"
                                            },
                                            {
                                                "example_id": "eae79e79-2603-4fc4-9489-55a9827d6e98",
                                                "sense_id": "a4566670-4a5b-3c1a-814d-db22f10c06a4",
                                                "text": "„Bald begann ich die Takelage der Brigg aufzuentern und zu den Masttopps aufzusteigen.“"
                                            },
                                            {
                                                "example_id": "30804dcd-3599-48ce-84bd-1468c0417b62",
                                                "sense_id": "a4566670-4a5b-3c1a-814d-db22f10c06a4",
                                                "text": "„Die Brigg hielt weiter auf die Unionsbai zu und trieb mit der steigenden Flut etwas Richtung Norden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cecafff-e868-4011-a89f-9eeaa6d835fd",
                        "source_entry_id": "57f8e9b1-8539-3542-bddf-e656f6b917b9",
                        "source_sense_id": "8313137f-2c5c-345d-a764-d5d6271ed9e5",
                        "target_lang_word": "brick",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brick",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89f90f0c-50b8-3a7c-b66d-55ce25d1d246",
                                        "entry_id": "19de11d5-ef40-39af-8a7b-3d926357871c",
                                        "glosses": [
                                            "Voilier à deux mâts gréés à voiles carrées et portant des hunes à l’extrémité des bas-mâts."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f0a6054-15a4-48a0-8b93-2139d158d456",
                                                "sense_id": "89f90f0c-50b8-3a7c-b66d-55ce25d1d246",
                                                "text": "Dans l’année 1808, un brick américain, venant de la rivière de la Plata, fit naufrage près d’une des Fidji."
                                            },
                                            {
                                                "example_id": "4079cba1-2ab2-4a4d-b3bd-a660c1e1c404",
                                                "sense_id": "89f90f0c-50b8-3a7c-b66d-55ce25d1d246",
                                                "text": "Ah ! ce n’est pas toujours profit que d’être un mauvais sujet ! — ajouta-t-il, avec une mélancolie qui me frappa dans ce luron formidable que je croyais doublé de cuivre comme un brick grec."
                                            },
                                            {
                                                "example_id": "7ab1fc3d-b279-4a60-bf0a-04161cf84383",
                                                "sense_id": "89f90f0c-50b8-3a7c-b66d-55ce25d1d246",
                                                "text": "Dès la seconde année, j’ai pu avoir à moi le Mignon, joli brick de sept cents tonneaux construit en bois de teck, doublé, chevillé en cuivre."
                                            },
                                            {
                                                "example_id": "252333b7-a1ae-4549-b1e1-7331c195003f",
                                                "sense_id": "89f90f0c-50b8-3a7c-b66d-55ce25d1d246",
                                                "text": "Et Jean-Marie, malgré la rafale, malgré les soubresauts du brick, grimpait au mât de misaine pour amarrer le hunier qui flottait au vent comme un drapeau."
                                            },
                                            {
                                                "example_id": "59902a5d-a6b6-41bc-8fc4-83f1c8550c1e",
                                                "sense_id": "89f90f0c-50b8-3a7c-b66d-55ce25d1d246",
                                                "text": "[…], la Marine lui accorda le commandement du brick de 8 canons « La Lilloise ». Ce navire devait surveiller les bâtiments français qui se livraient à la pêche à la morue en Islande et leur porter assistance en cas de besoin."
                                            },
                                            {
                                                "example_id": "ae869072-379d-4d3e-866e-ddb6f619ee6e",
                                                "sense_id": "89f90f0c-50b8-3a7c-b66d-55ce25d1d246",
                                                "text": "Martinez demeura seul sur la dunette et porta ses yeux vers l’Asia, qui naviguait sous le vent du brick."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brick",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a640463-868c-3f70-845f-f69fb0fe7bde",
                                        "entry_id": "a4294ab0-b1b7-3ba9-a945-60226ff66897",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b52c24c-45f7-4645-96ef-e8785f6f5fae",
                                                "sense_id": "8a640463-868c-3f70-845f-f69fb0fe7bde",
                                                "text": "Les freins bloqués grincent. Elle fait « han ! »\nElle n’a vu qu’une masse sombre la couvrir, maintenant il fait froid. Les voix ont un son ténu comme dans le wagon quand on rêve : « Un brick… Reculez… arrêtez le premier taxi… »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brick",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e5e7ee8-f6f7-3f1a-9afb-2238aecfa9f1",
                                        "entry_id": "e94dade9-6ae3-3f92-aeb6-e7af7f806a10",
                                        "glosses": [
                                            "Problème rendant un appareil informatique (en particulier une console de jeu) inutilisable."
