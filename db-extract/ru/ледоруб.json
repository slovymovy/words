                                    {
                                        "sense_id": "ac66ac63-e9f3-3d5a-bfe5-8c328e54ca9e",
                                        "entry_id": "13be35dd-e0de-31fb-8ca4-8edcbd9acf30",
                                        "glosses": [
                                            "ein spitzförmiger Hammer zum Greifen in Eis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd3c7dcc-11e3-45c4-a67e-e46c09010c39",
                                                "sense_id": "ac66ac63-e9f3-3d5a-bfe5-8c328e54ca9e",
                                                "text": "Mit dem Eispickel war es für Egon eine Leichtigkeit, den Gipfel zu erklimmen."
                                            },
                                            {
                                                "example_id": "c9e29461-0c47-455c-9d07-a63e075eb27f",
                                                "sense_id": "ac66ac63-e9f3-3d5a-bfe5-8c328e54ca9e",
                                                "text": "In einer Bergsteigerausrüstung hat ein Polizist am Flughafen Zürich bei einem einreisenden Schweizer 1,3 Kilogramm Kokain entdeckt. Das Rauschgift war raffiniert im Stiel eines Eispickels versteckt, wie die Polizei mitteilte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d1d2d8d-ae47-3d0c-9e66-2e3b71d056d2",
                                        "entry_id": "13be35dd-e0de-31fb-8ca4-8edcbd9acf30",
                                        "glosses": [
                                            "ein Küchenwerkzeug zum Zerkleinern von Eis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be714855-f3a3-4ea8-a894-2febdf37d50f",
                                                "sense_id": "3d1d2d8d-ae47-3d0c-9e66-2e3b71d056d2",
                                                "text": "„Bevor im 20. Jahrhundert Gefrierschränke und Eiswürfelmaschinen Einzug in die Bars hielten, wurde Eis in größeren Blöcken im Eisschrank gelagert und für die Zubereitung von Drinks mittels Eispickel und Hammer in kleinere, ungleichmäßige Stücke zerkleinert und wie Eiswürfel verwendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
