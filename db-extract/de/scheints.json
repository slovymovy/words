            {
                "entry_id": "3f89d710-5c87-39c1-8023-12af10ed0ee3",
                "word": "scheints",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f8d88102-d590-3b82-b33b-2928788c3a59",
                        "entry_id": "3f89d710-5c87-39c1-8023-12af10ed0ee3",
                        "glosses": [
                            "anscheinend"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9586ae09-ba49-4ce2-9c7d-893d8af543bc",
                                "sense_id": "f8d88102-d590-3b82-b33b-2928788c3a59",
                                "text": "„Sein Gesicht strahlte vor Freude, und er konnte scheints nur mit Mühe ein Geheimnis in seiner Brust wahren, das erraten zu lassen er vor Lust brannte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7f4fe86-e86e-4129-b9e6-e8626bd211c9",
                        "source_entry_id": "3f89d710-5c87-39c1-8023-12af10ed0ee3",
                        "source_sense_id": "f8d88102-d590-3b82-b33b-2928788c3a59",
                        "source_sense_description": "umgangssprachlich, besonders süddeutsch: anscheinend",
                        "target_lang_word": "seemingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seemingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65e84580-a5a9-334d-9481-2632266d139c",
                                        "entry_id": "d240aed7-ebe6-3831-ab06-49d70ddded36",
                                        "glosses": [
                                            "As it appears; apparently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a618d20f-9688-444f-bdc4-0c9f9814d215",
                                                "sense_id": "65e84580-a5a9-334d-9481-2632266d139c",
                                                "text": "[…] an object, seemingly like those which we have experienced, may be attended with different or contrary effects."
                                            },
                                            {
                                                "example_id": "7ff9513f-20c2-4c90-91b8-1889dff1857e",
                                                "sense_id": "65e84580-a5a9-334d-9481-2632266d139c",
                                                "text": "Mr. Woodhouse at last was off; but Mr. Knightley, instead of being immediately off likewise, sat down again, seemingly inclined for more chat. He began speaking of Harriet, and speaking of her with more voluntary praise than Emma had ever heard before."
                                            },
                                            {
                                                "example_id": "e1ebc234-cca5-4c9c-a7ef-69d1f040f91f",
                                                "sense_id": "65e84580-a5a9-334d-9481-2632266d139c",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly, […], down the nave to the western door. […] At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            },
                                            {
                                                "example_id": "76512fff-a8d9-49be-a5b2-fca5daa40ea8",
                                                "sense_id": "65e84580-a5a9-334d-9481-2632266d139c",
                                                "text": "He sacrificed nothing, laboring to get even the most seemingly insignificant element of every record perfect."
                                            },
                                            {
                                                "example_id": "d7a241fc-23a5-4542-af32-c3eeca7d604f",
                                                "sense_id": "65e84580-a5a9-334d-9481-2632266d139c",
                                                "text": "With rain lashing across the ground at kick-off and every man in Auckland seemingly either English-born or supporting Scotland, Eden Park was transformed into Murrayfield in March."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b45c1d11-078e-3a96-9243-5f2ea34c220a",
                                        "entry_id": "d240aed7-ebe6-3831-ab06-49d70ddded36",
                                        "glosses": [
                                            "In a seemly manner; decorously; with propriety."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93d89a1f-5616-487a-8e50-635d58532bac",
                                                "sense_id": "b45c1d11-078e-3a96-9243-5f2ea34c220a",
                                                "text": "It was possibly chagrin at this neglect that caused James to omit the most ordinary courtesies to the few gentlemen who had behaved seemingly:[…]."
                                            },
                                            {
                                                "example_id": "ee856ef2-259a-4166-9a60-010bb1315360",
                                                "sense_id": "b45c1d11-078e-3a96-9243-5f2ea34c220a",
                                                "text": "[…]was restored to his throne but only on the understanding that he behave seemingly."
                                            },
                                            {
                                                "example_id": "9e646204-448f-480c-8a08-d9aade1a7220",
                                                "sense_id": "b45c1d11-078e-3a96-9243-5f2ea34c220a",
                                                "text": "[…]they know the roles and statuses of deities, ancestral spirits, and men, and how to behave seemingly in their presence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a5a0e29-88f5-4c05-a304-1d2b92ff0598",
                        "source_entry_id": "3f89d710-5c87-39c1-8023-12af10ed0ee3",
                        "source_sense_id": "f8d88102-d590-3b82-b33b-2928788c3a59",
                        "source_sense_description": "umgangssprachlich, besonders süddeutsch: anscheinend",
                        "target_lang_word": "apparemment",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apparemment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95cd48d3-2ee7-3320-b9e3-91a70f95ffe7",
                                        "entry_id": "0946bf74-62ab-3692-a1ef-41ad2eb15a7b",
                                        "glosses": [
                                            "Manifestement, assurément."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "note": "Ce sens a vieilli, il a été très utilisé autrefois",
                                        "examples": [
                                            {
                                                "example_id": "f6259e72-bedc-4043-9675-d86b264b7220",
                                                "sense_id": "95cd48d3-2ee7-3320-b9e3-91a70f95ffe7",
                                                "text": "Un psaume qui apparemment est de Salomon."
                                            },
                                            {
                                                "example_id": "2dd64e9d-7349-4725-8b28-8e2a3c3c8dd5",
                                                "sense_id": "95cd48d3-2ee7-3320-b9e3-91a70f95ffe7",
                                                "text": "Quoi qu’il en soit, deux choses sont assurées, l’une que le miracle de l’apparition de l’étoile servit de règle à Hérode pour étendre son massacre ; l’autre que celui qu’il cherchait fut le seul apparemment qui lui échappa."
                                            },
                                            {
                                                "example_id": "00735d0b-74fe-4333-8f5f-5a55ac86ace9",
                                                "sense_id": "95cd48d3-2ee7-3320-b9e3-91a70f95ffe7",
                                                "text": "Ce discours apparemment véritable."
                                            },
                                            {
                                                "example_id": "c6deb1de-90b9-428a-8f9c-f7b73b6b781c",
                                                "sense_id": "95cd48d3-2ee7-3320-b9e3-91a70f95ffe7",
                                                "text": "Apparemment que je suis le maître d'aller où il me plaît."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5efbe91e-d398-35f5-9b87-4320c2e1e40c",
                                        "entry_id": "0946bf74-62ab-3692-a1ef-41ad2eb15a7b",
                                        "glosses": [
                                            "Selon les apparences ; vraisemblablement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9b7a22-b71a-4a1d-b14e-310785e89222",
                                                "sense_id": "5efbe91e-d398-35f5-9b87-4320c2e1e40c",
                                                "text": "Le grand jeune homme dégingandé, qui s’appelait Laurier, s’était apparemment institué chef en raison de sa position sociale et de ses aptitudes naturelles."
                                            },
                                            {
                                                "example_id": "072bfb2a-2fbd-4213-877e-a8ccec73bd8a",
                                                "sense_id": "5efbe91e-d398-35f5-9b87-4320c2e1e40c",
                                                "text": "C’est la nécessité de ce concours de tant de qualités… qui fait apparemment que le génie est toujours si rare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd3e1b5c-078c-36ba-b2af-0bd7dfb3d593",
                                        "entry_id": "0946bf74-62ab-3692-a1ef-41ad2eb15a7b",
                                        "glosses": [
                                            "En apparence ; visiblement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e260736-51f5-41d7-9d5f-38521be03c22",
                                                "sense_id": "dd3e1b5c-078c-36ba-b2af-0bd7dfb3d593",
                                                "text": "Tant que Galba vivra, le respect de son âge,\nDu moins apparemment, soutiendra son suffrage."
                                            },
                                            {
                                                "example_id": "ec8faf62-8acd-4c31-aecb-8b6cde4fa63f",
                                                "sense_id": "dd3e1b5c-078c-36ba-b2af-0bd7dfb3d593",
                                                "text": "Sa directrice était une mégère doublée d'un tyran qui n'avait apparemment pas inventé l'eau chaude à part peut-être celle qui coule dans les veines des assoiffés de pouvoir."
                                            },
                                            {
                                                "example_id": "c6f15c6f-903c-4c6e-b459-f7c38a2775e4",
                                                "sense_id": "dd3e1b5c-078c-36ba-b2af-0bd7dfb3d593",
                                                "text": "Le coadjuteur ne laissa apparemment d’employer la dignité de son caractère et ses persuasions pour calmer les orages."
                                            },
                                            {
                                                "example_id": "8b9bd88d-01a4-4288-82c8-f26f64afe58b",
                                                "sense_id": "dd3e1b5c-078c-36ba-b2af-0bd7dfb3d593",
                                                "text": "En public elle me persécutait apparemment avec plus d’animosité que les autres."
                                            },
                                            {
                                                "example_id": "d2fe2602-cae2-4506-93c2-04d84fca9e1c",
                                                "sense_id": "dd3e1b5c-078c-36ba-b2af-0bd7dfb3d593",
                                                "text": "Ô ciel ! ta providence, apparemment prospère,\nAu gré de mes soupirs de deux fils m’a fait père."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
