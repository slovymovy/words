                "senses": [
                    {
                        "sense_id": "90b648eb-34bc-3d60-9953-a400a1b5dfc9",
                        "entry_id": "393f8816-62a2-3f9c-a72c-10b34d6341f2",
                        "glosses": [
                            "(männliche^☆) Person, die im Augenblick oder eine Zeit lang etwas intensiv lernt (studiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac85079a-0d31-450a-9055-6bf612d25529",
                                "sense_id": "90b648eb-34bc-3d60-9953-a400a1b5dfc9",
                                "text": "„Linji war als junger Mönch […] ein eifriger Studierender der buddhistischen Regeln und Lehrschriften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "740a3464-a07d-3687-bcef-3548c6ef2179",
                        "entry_id": "393f8816-62a2-3f9c-a72c-10b34d6341f2",
                        "glosses": [
                            "(männliche^☆) Person, die an einer Hochschule eingeschrieben ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "656d2efb-b8f3-4d49-ab28-981242c43d80",
                                "sense_id": "740a3464-a07d-3687-bcef-3548c6ef2179",
                                "text": "Die Bologna-Reform wurde von Professoren und Studierenden sehr kritisch aufgenommen."
                            },
                            {
                                "example_id": "0cb992a1-205f-43e9-b749-59ca0458d241",
                                "sense_id": "740a3464-a07d-3687-bcef-3548c6ef2179",
                                "text": "„Davon sollten nicht zuletzt diejenigen unserer Studierenden profitieren, die Deutschlehrerinnen und Deutschlehrer werden, denn sie vermitteln ganz wesentlich zwischen Linguistik und Öffentlichkeit.“"
                            },
                            {
                                "example_id": "42243496-ec14-4f62-a832-5a036639d2cf",
                                "sense_id": "740a3464-a07d-3687-bcef-3548c6ef2179",
                                "text": "„Im ersten Semester durften die Studierenden ihr Forschungsgebiet selbst bestimmen.“"
                            },
                            {
                                "example_id": "9a812106-8c4d-478a-af5b-254e336426da",
                                "sense_id": "740a3464-a07d-3687-bcef-3548c6ef2179",
                                "text": "„Die Universitäten wollen den Studierenden künftig wieder mehr Raum für Sinnfindung geben.“"
                            },
                            {
                                "example_id": "00c259ab-168d-44c3-8d09-2d90816fd65e",
                                "sense_id": "740a3464-a07d-3687-bcef-3548c6ef2179",
                                "text": "„Studierende protestieren immer wieder gegen den Wohnungsmangel in Großstädten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
