                ],
                "senses": [
                    {
                        "sense_id": "0917db0c-2122-3e22-8418-70575418d431",
                        "entry_id": "2dfd1219-e612-392b-920c-a3a64154a7ff",
                        "glosses": [
                            "die Fläche eines natürlichen Blattes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db73bd01-c487-4719-bd63-75989c0a0c98",
                                "sense_id": "0917db0c-2122-3e22-8418-70575418d431",
                                "text": "„Da die meisten Blätter flach sind, versteht man unter der Blattfläche seine Oberfläche oder beide Seiten eines Blattes.“"
                            },
                            {
                                "example_id": "b71fa1dc-d6a9-481f-894a-630c8bc7144f",
                                "sense_id": "0917db0c-2122-3e22-8418-70575418d431",
                                "text": "„Frühere Forschungsarbeiten machten nämlich deutlich, dass die Photosyntheserate auf die Blattfläche bezogen tatsächlich höher ist als bei Talpflanzen, wenn beide demselben CO2-Partialdruck ausgesetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3b4ffcd8-8ca2-39b5-8430-dfe595a07c64",
                        "entry_id": "2dfd1219-e612-392b-920c-a3a64154a7ff",
                        "glosses": [
                            "die Fläche eines Rotorblattes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fec43761-ba38-4d58-a76d-283149a99d64",
                                "sense_id": "3b4ffcd8-8ca2-39b5-8430-dfe595a07c64",
                                "text": "„Die Anzahl der Rotorblätter einer Windkraftanlage hat nur geringen Einfluß auf die mechanische Rotorleistung: Rotoren mit geringer Blattzahl drehen schneller und gleichen so ihren Nachteil der kleineren Blattfläche fast wieder aus.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "a3a5f501-0139-3053-9830-b11e3fcd36fb",
                        "entry_id": "2dfd1219-e612-392b-920c-a3a64154a7ff",
                        "glosses": [
                            "die Fläche von einem Blatt Papier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65699c57-2787-45fb-8db0-b07e74846de6",
                                "sense_id": "a3a5f501-0139-3053-9830-b11e3fcd36fb",
                                "text": "„Die mindere Wichtigkeit des Textes äußert sich in mehrfacher Hinsicht: Er beansprucht nur ein Fünftel der Blattfläche;“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
