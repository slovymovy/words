                    {
                        "translation_id": "21899bdc-e214-42a5-a3a3-8603937863d2",
                        "source_entry_id": "ff8a422a-b303-34f2-aae5-3ef9e41dd38e",
                        "source_sense_id": "687c66f2-fc36-383e-97d6-befdaf3625c0",
                        "target_lang_word": "Nekton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nekton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7faa4b09-1b4d-3ad3-813c-6ee7d536168d",
                                        "entry_id": "d096a02c-8eea-35ff-9db7-754d290e6be1",
                                        "glosses": [
                                            "Gesamtheit der sich im Meer und in Binnengewässern aktiv bewegenden Tiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7236054c-8369-4cb7-a487-4a073d87c0a0",
                                                "sense_id": "7faa4b09-1b4d-3ad3-813c-6ee7d536168d",
                                                "text": "Das Größenspektrum des Nektons reicht von kleinen Fischen, Tintenfischen, Krebsen und Meeresschildkröten bis hin zu den großen Haien, Rochen und Walen."
                                            },
                                            {
                                                "example_id": "fd2a69fc-adc9-4c2c-980e-b72a29f08c6d",
                                                "sense_id": "7faa4b09-1b4d-3ad3-813c-6ee7d536168d",
                                                "text": "Zum Nekton gehören darüber hinaus auch Robben und Meeresvögel wie beispielsweise die Pinguine."
                                            },
                                            {
                                                "example_id": "c68c075f-c237-49bc-a935-fab05698eb81",
                                                "sense_id": "7faa4b09-1b4d-3ad3-813c-6ee7d536168d",
                                                "text": "Da im Gegensatz zum Plankton für das Nekton keine einleuchtenden Klassifikationskriterien existieren, wird als solches meist die systematische Zugehörigkeit der Tiere herangezogen."
                                            },
                                            {
                                                "example_id": "dd1642ae-ef94-4a74-a2d2-67cb4b515a03",
                                                "sense_id": "7faa4b09-1b4d-3ad3-813c-6ee7d536168d",
                                                "text": "Die zehnarmigen Theutoidea ihrerseits gehören fast ausnahmslos dem Nekton an, obwohl viele Gattungen, wie z.B. jene der schwarmbildenden Kalmare […], ihre Gelege am Meeresboden ablaichen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
