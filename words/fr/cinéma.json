                            "target_lang_translations": {
                                "en": "The new <w>cinema</w> has very comfortable seats.",
                                "ru": "В новом <w>кинотеатре</w> очень удобные кресла.",
                                "nl": "De nieuwe <w>bioscoopzaal</w> heeft zeer comfortabele stoelen.",
                                "de": "Der neue <w>Kinosaal</w> hat sehr bequeme Sitze.",
