                "senses": [
                    {
                        "sense_id": "ae904fed-6737-3e05-be6b-7d65e1c64a72",
                        "entry_id": "1bcd6a65-45f6-3da5-8c5a-e12599d475e8",
                        "glosses": [
                            "Hybride de caprin et d’ovin provenant de la saillie d’une chèvre par un bélier."
                        ],
                        "tags": [],
                        "note": "la survie du fœtus est très rare. L’hybridation inverse entre un bouc et une brebis, encore plus rare, donne un ovicapre",
                        "examples": [
                            {
                                "example_id": "b828e7eb-df47-4ad4-9b31-23a43eb75d82",
                                "sense_id": "ae904fed-6737-3e05-be6b-7d65e1c64a72",
                                "text": "En croisant et recroisant dans un ordre déterminé le bouc et la brebis, on obtient des hybrides appelés chabins qui possèdent 3/8 du sang du père et 5/8 du sang de la mère."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f56c872-2fb6-36c0-b40a-5409783059ec",
                        "entry_id": "1bcd6a65-45f6-3da5-8c5a-e12599d475e8",
                        "glosses": [
                            "Race caprine ressemblant à un hybride."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6aff2ca9-3833-43a0-9780-170261d292bf",
                        "source_entry_id": "1bcd6a65-45f6-3da5-8c5a-e12599d475e8",
                        "target_lang_word": "Schiege",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schiege",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8106fbc1-0826-3372-b8b2-eb99364ad98c",
                                        "entry_id": "7993c04b-ab2e-3d93-8042-318e4568771d",
                                        "glosses": [
                                            "Hybride aus Schaf und Ziege"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b18a1f-ab39-414c-83a3-2d100a2f30dd",
                                                "sense_id": "8106fbc1-0826-3372-b8b2-eb99364ad98c",
                                                "text": "Bei der Paarung zwischen Ziegen und Schafen kann es zu einer Befruchtung einer Eizelle kommen, sodass eine Schiege entsteht, die selbst aber unfruchtbar ist."
                                            },
                                            {
                                                "example_id": "c8e4b71c-7939-467c-b8ca-8781c65c56a8",
                                                "sense_id": "8106fbc1-0826-3372-b8b2-eb99364ad98c",
                                                "text": "„Ein extrem seltenes Mischwesen lebt im Landkreis Göttingen. In der Schafherde eines Tierhalters aus Deiderode befinde sich eine sogenannte Schiege, eine Kreuzung aus Schaf (Muttertier) und Ziege, sagte der Nutztierforscher Christoph Knorr von der Universität Göttingen. Dies sei mittlerweile wissenschaftlich eindeutig bewiesen.“"
                                            },
                                            {
                                                "example_id": "46475b33-be95-40fe-a195-b220f18b7fee",
                                                "sense_id": "8106fbc1-0826-3372-b8b2-eb99364ad98c",
                                                "text": "„Leider ist Lisa, so hat Exsternbrink die Schiege getauft, in ihren jungen Jahren schon Halbwaise. \"Die beiden Ziegenböcke sind vor kurzem geschlachtet worden\", bedauert der Bauer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d47cb279-f183-4350-8e3f-b4aec37a2861",
