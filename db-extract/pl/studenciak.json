                "senses": [
                    {
                        "sense_id": "b770277c-e7cb-3889-915d-d1e7a0e08ee3",
                        "entry_id": "bc0ab6bf-0b72-3325-90ca-7bec4bc0cc59",
                        "glosses": [
                            "student (zwykle płci męskiej)"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "3eab8454-8d2a-44cb-81e6-fb282e336464",
                                "sense_id": "b770277c-e7cb-3889-915d-d1e7a0e08ee3",
                                "text": "W zatęchło-ugodowy dom lojalnego urzędnika wpada wesoły studenciak uniwersytetu, niewątpliwie kawalarz, niewątpliwie świszczypała"
                            },
                            {
                                "example_id": "51c6126b-600e-46fc-89b1-6b53bf414912",
                                "sense_id": "b770277c-e7cb-3889-915d-d1e7a0e08ee3",
                                "text": "A studenciaki to wykorzystują taksówkę na pocałunki. Ale to młode… niech im tam… wykorzystują dokumentnie nawet najkrótsze kursy, bo na krótkich tylko jeżdzą. Udajemy, że nie widzimy"
                            },
                            {
                                "example_id": "27057dde-ac97-42be-a485-af3abc318aa9",
                                "sense_id": "b770277c-e7cb-3889-915d-d1e7a0e08ee3",
                                "text": "Wykładowca traktuje ucznia bardziej jak kolegę niż kolejnego studenciaka, który zawraca mu głowę. Ten luz można było zauważyć także na egzaminach"
                            },
                            {
                                "example_id": "eb539a09-a3c0-4307-a86f-b88db5937abc",
                                "sense_id": "b770277c-e7cb-3889-915d-d1e7a0e08ee3",
                                "text": "— To był studenciak z inteligenckiego domu. Jest szansa, że założyli mu teczkę. Nawet jeśli wiele nie zebrali, to zawsze może pan znajdzie nazwiska lub adresy"
                            },
                            {
                                "example_id": "a62834dc-6e7c-4f36-8efd-eed95ee44b35",
                                "sense_id": "b770277c-e7cb-3889-915d-d1e7a0e08ee3",
                                "text": "W każdym dzienniku ta sama manifestacja i jakiś krzyczący studenciak"
                            },
                            {
                                "example_id": "8febfd4e-d510-4fbc-96e7-cfc4bea1eacb",
                                "sense_id": "b770277c-e7cb-3889-915d-d1e7a0e08ee3",
                                "text": "Jaki tam narkotyk… To tylko „trawka”! Trochę mocniejszy papieros i tyle. Wszystkie studenciaki to biorą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
