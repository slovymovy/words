                                        "entry_id": "27a6cb4e-5b6f-34c2-bceb-2703c92e0633",
                                        "glosses": [
                                            "Name einer Reihe von amerikanischen Panzerabwehrwaffen aus dem Zweiten Weltkrieg"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5560c462-1424-4750-b02e-acecccb4a0bf",
                                                "sense_id": "cf463741-a8d7-3233-b739-86332b338b94",
                                                "text": "Die US-Truppen setzten Bazookas auch gegen feindliche Stellungen ein."
                                            },
                                            {
                                                "example_id": "50b0f64b-2ecd-4a96-ae2e-2a10907aa892",
                                                "sense_id": "cf463741-a8d7-3233-b739-86332b338b94",
                                                "text": "„Sie schwingen Kalaschnikows, Bazookas und Macheten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e6060b7d-6b9e-3cc4-be57-1a3038e4d37c",
                                        "entry_id": "27a6cb4e-5b6f-34c2-bceb-2703c92e0633",
                                        "glosses": [
                                            "Raketenwerfer"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6830a223-9017-4f8e-a871-a432d7a49216",
                                                "sense_id": "e6060b7d-6b9e-3cc4-be57-1a3038e4d37c",
                                                "text": "In diesem Videospiel kann man eine Bazooka kaufen!"
                                            },
                                            {
                                                "example_id": "206d1a2f-4778-4c94-8b7a-8e72ffaed76e",
                                                "sense_id": "e6060b7d-6b9e-3cc4-be57-1a3038e4d37c",
                                                "text": "„\"Es ist die Bazooka\", sagte Scholz über ein gemeinsam mit Bundeswirtschaftsminister Peter Altmaier (CDU) vorgestelltes Hilfspaket gegen die Folgen der Coronakrise. \"Was wir dann noch an Kleinwaffen brauchen, das gucken wir später.\"“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
