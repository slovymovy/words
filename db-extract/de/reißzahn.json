                "senses": [
                    {
                        "sense_id": "8e101728-82ae-34de-a206-322c3244ac2e",
                        "entry_id": "03deca6b-835d-373a-8c1b-eebeb94a4829",
                        "glosses": [
                            "große Backenzähne von Raubtieren, die in zwei Paaren scherenartig angeordnet das Fleisch der Beute zerschneiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68e38f84-1e05-4062-91e7-099bb3768958",
                                "sense_id": "8e101728-82ae-34de-a206-322c3244ac2e",
                                "text": "„Sie ist ein weibliches Ungeheuer mit Händen aus Messing und scharfen Reißzähnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dead3f1-11b3-41a7-9c83-fc8b7f8e34ed",
                        "source_entry_id": "03deca6b-835d-373a-8c1b-eebeb94a4829",
                        "source_sense_id": "8e101728-82ae-34de-a206-322c3244ac2e",
                        "target_lang_word": "canine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2b25693-5f6d-32ce-be6b-c64499dea1e3",
                                        "entry_id": "9bbd2ccc-373e-38ab-968e-c34152f05c7d",
                                        "glosses": [
                                            "Dent pointue d’un mammifère (excepté les rongeurs), au nombre de deux par mâchoire, qui sert principalement à rompre ou à briser les corps durs ainsi qu'à déchirer la chair, et qui se situe entre les incisives et les molaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d00a44d3-3bda-4e19-8cef-e60d7d3ce2ef",
                                                "sense_id": "a2b25693-5f6d-32ce-be6b-c64499dea1e3",
                                                "text": "Près de la porte, contre le mur, une fourche se dressait, une de ces fourches d’acier aux longues dents puissantes et fines qui se plantent dans les gerbes de blé comme des canines de chat dans un ventre de souris."
                                            },
                                            {
                                                "example_id": "ae5de4f3-3cac-4948-af15-3bb8a2074d47",
                                                "sense_id": "a2b25693-5f6d-32ce-be6b-c64499dea1e3",
                                                "text": "Avant de séduire la belle Ariane en lui exposant dans un étourdissant détail les théorèmes, lemmes et scolies qui fondent sa haine de la séduction, le beau Solal avait commencé par se rendre horrible à sa vue — horribile visu — en masquant toutes ses dents sauf ses deux canines d’un enduit noir, qui le changeait en vieillard édenté."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "canine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "950bcd5e-6412-35e1-a0f8-66b3944fb0e4",
                                        "entry_id": "f6c515b4-7ee5-3e52-a9ce-671213a1c4d5",
                                        "glosses": [
                                            "Féminin singulier de canin."
                                        ],
