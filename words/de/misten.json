                },
                {
                    "sense_id": "fd03982d-6562-31d2-84ae-068e612d91a1",
                    "sense_definition": "landwirtschaftliche Nutzflächen mit tierischem Dung anreichern",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "landwirtschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im späten Herbst <w>mistet</w> der Landwirt seine Felder, um den Boden mit wertvollen Nährstoffen zu versorgen."
                        },
                        {
                            "text": "Der Gärtner hat das Gemüsebeet vor der Neuanpflanzung kräftig <w>gemistet</w>."
                        }
                    ],
                    "synonyms": [
