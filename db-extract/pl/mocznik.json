                                        "entry_id": "f0db5f8a-5b29-3996-8174-8db916d5ed53",
                                        "glosses": [
                                            "eines der Endprodukte des Stoffwechsels; chemische Verbindung mit der Summenformel CO(NH₂)₂"
                                        ],
                                        "tags": [
                                            "organische Chemie, ohne Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c60a25a5-1ea6-4052-860c-c66ec4cc7d5a",
                                                "sense_id": "c85d6d68-12e3-34e7-911f-c41a9671e81b",
                                                "text": "Im Harnstoffzyklus der Säugetiere wird Ammonium zu Harnstoff, welcher dann über die Niere ausgeschieden wird."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6df12010-cf23-34cb-9106-86afb2ac2168",
                                        "entry_id": "f0db5f8a-5b29-3996-8174-8db916d5ed53",
                                        "glosses": [
                                            "Bezeichnung für zahllose Derivate von [1]"
                                        ],
                                        "tags": [
                                            "organische Chemie, nur Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a5b12db-22d1-4026-a332-1d31c97d3aa7",
                                                "sense_id": "6df12010-cf23-34cb-9106-86afb2ac2168",
                                                "text": "„Cumyluron ist eine chemische Verbindung aus der Gruppe der Harnstoffe, welche in den 1990ern von Japan Carlit entdeckt wurde.“"
                                            },
                                            {
                                                "example_id": "992997c2-51fe-49f1-87d0-52ec7db1c4ff",
                                                "sense_id": "6df12010-cf23-34cb-9106-86afb2ac2168",
                                                "text": "„Inhaltsstoffe wie Bio-Hyaluronsäure oder Harnstoffe (‚Uera‘) bindet Feuchtigkeit, Sophora-Japonica-Wurzelextrakt verbessert die Elastizität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
