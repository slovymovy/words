                                        "sense_id": "65166efd-4de3-3abb-aed2-113872fb9f0c",
                                        "entry_id": "3996063f-a660-3dfb-ad10-c934a3a3863e",
                                        "glosses": [
                                            "zu Kanada gehörende Halbinsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5916974a-fe83-4df3-b5a9-03309c48d688",
                                                "sense_id": "65166efd-4de3-3abb-aed2-113872fb9f0c",
                                                "text": "„Nach den indianischen und Inuit-Ureinwohnern waren die ersten europäischen Entdecker der Küste Labradors norwegische Wikinger, die um 1000 unter Leif Eriksson von Grönland kamen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "23658eac-d8a3-3aa5-b3d2-ea4b6ab09bb2",
                                        "entry_id": "3996063f-a660-3dfb-ad10-c934a3a3863e",
                                        "glosses": [
                                            "Teil der kanadischen Atlantikprovinz Neufundland und Labrador"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc2ec55-fa70-479a-9ace-ac11eb14fc74",
                                                "sense_id": "23658eac-d8a3-3aa5-b3d2-ea4b6ab09bb2",
                                                "text": "„Labrador hat eine Fläche von 294.330 km² und ist damit etwa so groß wie Italien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Labrador",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "626c7aaf-4c5d-3a7b-843b-db2c7a5ce6e0",
                                        "entry_id": "a973f432-20f0-3d42-ac2f-8e3c257ee2d9",
                                        "glosses": [
                                            "eine Jagdhundrasse; mittelgroßer Jagdhund mit kurzem Fell und Hängeohren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a5e1c7-a112-4856-ac61-b1e127982a4e",
                                                "sense_id": "626c7aaf-4c5d-3a7b-843b-db2c7a5ce6e0",
                                                "text": "„Als Ergebnis langjähriger Selektion auf jagdlich nutzbare Eigenschaften ist der Labrador ein Hund mit einer vorzüglichen Nase und mit einem weichen Maul, womit er gefundenes Wild oder andere Gegenstände unbeschädigt seinem Herrn zuträgt.“"
                                            },
                                            {
                                                "example_id": "f59d654d-797b-432f-a580-c24fdd00781e",
                                                "sense_id": "626c7aaf-4c5d-3a7b-843b-db2c7a5ce6e0",
                                                "text": "„Einige Monate später, der Kriminalfall Piontek ruht als vorläufig ungelöst in den Akten, zeigt ein Forstarbeiter bei der Polizei an, dass sein Labrador in einem Waldgebiet, das nach Feststellung der Polizei weiter entfernt von Pionteks Jagdgründen liegt, den offensichtlich nicht tief genug vergrabenen Kadaver eines mittelgroßen Hundes aufgespürt habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fbcb7709-5277-3757-bfa3-0761820d0ff2",
                                        "entry_id": "a973f432-20f0-3d42-ac2f-8e3c257ee2d9",
                                        "glosses": [
                                            "Abart des Feldspats mit auffälligem Farbenspiel (meist in Blau-, Violett- oder Grüntönen), weshalb er auch gerne als Schmuckstein verwendet wird"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e09ebe-26d1-4ad0-8382-83825e296af7",
                                                "sense_id": "fbcb7709-5277-3757-bfa3-0761820d0ff2",
                                                "text": "Dieser geschliffene Labrador schimmert so schön."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
