                        "glosses": [
                            "Schulnote für Sozial- oder Arbeitsverhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9644fcb1-d381-4301-a680-7557de601e85",
                                "sense_id": "825095f8-9833-3fc1-b580-f333058d070a",
                                "text": "Sowohl Lehrer als auch Schüler sind gegen die Wiedereinführung der Kopfnoten in NRW."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "559d706f-2c40-31ea-aa1d-5edecc01e5fd",
                        "entry_id": "a994528d-de6f-34a3-8779-0cf23472daa2",
                        "glosses": [
                            "derjenige Anteil an einem Duft, der beim Auftragen (von Parfum) auf die Haut markant zu riechen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3aaa99a5-32ff-46d4-9557-f7bb9a03cd4f",
                                "sense_id": "559d706f-2c40-31ea-aa1d-5edecc01e5fd",
                                "text": "„Er kreierte 1917 ein Parfum mit dem ätherischen Öl einer Flechtenart, die nur auf Zypern wächst, kontrastierte es in der Kopfnote durch Zitrusfrische und in der Basisnote durch Eichenmoos.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
