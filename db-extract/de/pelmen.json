                                "example_id": "6620fd87-bfe1-4eb8-98e4-1d818ed78e41",
                                "sense_id": "f2aa3361-9e4f-32ba-ab6d-827eda494711",
                                "text": "Pelmeni ähneln den deutschen Maultaschen, sind aber kleiner."
                            },
                            {
                                "example_id": "8ba32d88-38cf-4d63-837d-313ce329500f",
                                "sense_id": "f2aa3361-9e4f-32ba-ab6d-827eda494711",
                                "text": "Karotte ins entsetzte Maul, fertig ist der Pelmen, und ab geht's, wie beim Missionarswitz, in den Kochtopf."
                            }
                        ],
                        "sense_index_json": "\"1\""
