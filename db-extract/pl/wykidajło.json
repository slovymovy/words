                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e0d07b3-dbd5-3921-9f55-a00257dcbbac",
                        "entry_id": "53ce07e1-ac75-37b0-ada0-17b6c97e68cd",
                        "glosses": [
                            "pracownik pilnujący porządku w (często podrzędnym) lokalu rozrywkowym lub gastronomicznym"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e4ec18e2-c727-4492-840e-58dfffb6e346",
                                "sense_id": "7e0d07b3-dbd5-3921-9f55-a00257dcbbac",
                                "text": "Zaczęli rozmawiać i rozmawiali tak do rana, wypijając jeden drink za drugim. Dziewczyna zdążyła się znudzić i wymknęła się z knajpy, ale żaden z panów tego nie zauważył. O świcie wyrzucili ich ochroniarze. Ponoć wysportowany McConaughey stanął w obronie Philipsa, którego jeden z wykidajłów potraktował bardzo brutalnie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "0a9b995c-bb29-3898-8733-3153ec3b8636",
                        "entry_id": "53ce07e1-ac75-37b0-ada0-17b6c97e68cd",
                        "glosses": [
                            "dowódca grupy spadochroniarzy przeznaczonej do zrzutu z samolotu"
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b18203f-2c05-4746-b0fb-1716558e8a1f",
                        "source_entry_id": "53ce07e1-ac75-37b0-ada0-17b6c97e68cd",
                        "source_sense_id": "7e0d07b3-dbd5-3921-9f55-a00257dcbbac",
                        "target_lang_word": "chucker-out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chucker-out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3246b4e7-5a62-3d1c-aa93-c4a27e280fcd",
                                        "entry_id": "5915a170-b369-3564-a7a7-0207cbfc8796",
                                        "glosses": [
                                            "Synonym of bouncer."
                                        ],
                                        "tags": [
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86a4f92c-efb7-4f5b-8e39-74aaadd52d65",
                                                "sense_id": "3246b4e7-5a62-3d1c-aa93-c4a27e280fcd",
                                                "text": "Then Dawes made a remark which caused Paul to throw half a glass of beer in his face. “Oh, Mr. Morel!” cried the barmaid, and she rang the bell for the “chucker-out.”"
                                            },
                                            {
                                                "example_id": "01242daa-4557-46b5-aca6-cdbc2647cd77",
                                                "sense_id": "3246b4e7-5a62-3d1c-aa93-c4a27e280fcd",
                                                "text": "\"An old scrapper don't find many openings. Chucker-out at a pub with free drinks. Nothing doing there.\""
                                            },
                                            {
                                                "example_id": "6c67e8e1-3512-4ca0-9681-c9eddf4fb13b",
                                                "sense_id": "3246b4e7-5a62-3d1c-aa93-c4a27e280fcd",
                                                "text": "[…] a shining angel, but — pitch! — ah now, Mrs. Philip Ederney! There's no denying that the dad's soul mayn't be as white as it would be if he hadn't spent ten years as a chucker-out in a speak-easy in Chicago. Souls get a bit blind and tough in that sort of job and, sure enough, […]"
                                            },
                                            {
                                                "example_id": "49e5b943-7541-4166-bd95-0e1b31836922",
                                                "sense_id": "3246b4e7-5a62-3d1c-aa93-c4a27e280fcd",
                                                "text": "Then came the end of the turn, when the dummy asked us all to 'kindly rise and give a toast to his Majesty the King', at which Mack didn't stand but shouted, 'Kindly leave off, will you?' I moved along the row of seats towards him. By the time I got to him they were changing the scenery on the stage, and he was having a fight with the chucker-out."
                                            },
                                            {
                                                "example_id": "bb378c79-9860-4f43-a55f-161de35dfb10",
                                                "sense_id": "3246b4e7-5a62-3d1c-aa93-c4a27e280fcd",
                                                "text": "But the feature of the place was really Abdul, the chucker-out. Abdul was a huge fellow, reputed to be an^([sic]) eunuch, coal-black, shiny, and with biceps that would have made Jack Dempsey cry."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7aa23774-f775-4fd5-9a35-f5903faef793",
                        "source_entry_id": "53ce07e1-ac75-37b0-ada0-17b6c97e68cd",
                        "source_sense_id": "7e0d07b3-dbd5-3921-9f55-a00257dcbbac",
                        "target_lang_word": "bouncer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouncer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87517783-a9a1-32b8-888e-a766dd0250b2",
                                        "entry_id": "875f992c-0a80-3c97-b656-ef42de8d2f6a",
                                        "glosses": [
                                            "A member of security personnel employed by bars, nightclubs, etc. to decide who can enter, maintain order, and deal with patrons who cause trouble."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0425c16b-8472-4a70-863b-988f973f9df3",
                                                "sense_id": "87517783-a9a1-32b8-888e-a766dd0250b2",
                                                "text": "At 199 centimetres and a hundred kilos going up, he was scary big and he found work as a bouncer and enforcer[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3af3a98-7c4a-3126-a74b-c07cc2cf416d",
                                        "entry_id": "875f992c-0a80-3c97-b656-ef42de8d2f6a",
                                        "glosses": [
                                            "A short-pitched ball that bounces up towards, or above the height of the batsman’s head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bb95576-3787-42b3-a85f-590ad6cff076",
                                                "sense_id": "f3af3a98-7c4a-3126-a74b-c07cc2cf416d",
                                                "text": "‘You try to hit the bouncer that you should duck under. Your bat misses it completely. The ball strikes your temple, whack!’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71eac622-7788-39f2-8a64-2a17d1250d45",
                                        "entry_id": "875f992c-0a80-3c97-b656-ef42de8d2f6a",
                                        "glosses": [
                                            "An account or server (as with IRC and FTP) that invisibly redirects requests to another, used for anonymity or vanity."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6dd9e280-7d78-3047-b0b4-f0c43c3c6494",
                                        "entry_id": "875f992c-0a80-3c97-b656-ef42de8d2f6a",
                                        "glosses": [
                                            "One who bounces; a large, heavy person who makes much noise in moving."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5cb76b8-b1b7-4597-9d50-1f7c1fabfd8f",
                                                "sense_id": "6dd9e280-7d78-3047-b0b4-f0c43c3c6494",
                                                "text": "\"Why, I'll tell you, Mr. Simple; he's a good tempered, kind fellow enough, but—\" / \"But what?\" / \"Such a bouncer!!\" / \"How do you mean? He's not a very stout man.\" / \"Bless you, Mr. Simple, why don't you understand English. I mean that he's the greatest liar that ever walked a deck.[…]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fd00ee7-2c09-3bfa-9239-87bf878d730b",
                                        "entry_id": "875f992c-0a80-3c97-b656-ef42de8d2f6a",
                                        "glosses": [
                                            "A boaster; a bully."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7b6404a-ab04-31a6-96a3-0f0bf949ff89",
                                        "entry_id": "875f992c-0a80-3c97-b656-ef42de8d2f6a",
                                        "glosses": [
                                            "Something big; a good stout example of the kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71159325-e058-4932-a233-588bc2409121",
                                                "sense_id": "f7b6404a-ab04-31a6-96a3-0f0bf949ff89",
                                                "text": "The stone must be a bouncer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be76da52-949c-3f2b-827b-fc0f6ace3999",
                                        "entry_id": "875f992c-0a80-3c97-b656-ef42de8d2f6a",
                                        "glosses": [
                                            "A bold lie."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e0482ef-69f1-45db-984c-0f6e57817e3b",
                                                "sense_id": "be76da52-949c-3f2b-827b-fc0f6ace3999",
                                                "text": "\"… when he wants to accomplish his purpose, he does not hesitate to invent—I am not quite sure of the word, but I think it is “bouncers.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e95bffa-ffc3-36a3-b2c4-2eda5dec8a4e",
                                        "entry_id": "875f992c-0a80-3c97-b656-ef42de8d2f6a",
                                        "glosses": [
                                            "A liar."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0beeb815-d0cc-4cd0-9615-815cc908dba1",
                                                "sense_id": "1e95bffa-ffc3-36a3-b2c4-2eda5dec8a4e",
                                                "text": "\"Why, I'll tell you, Mr. Simple; he's a good tempered, kind fellow enough, but—\" / \"But what?\" / \"Such a bouncer!!\" / \"How do you mean? He's not a very stout man.\" / \"Bless you, Mr. Simple, why don't you understand English. I mean that he's the greatest liar that ever walked a deck.[…]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e3befc8-0a31-3dac-989e-4390e85966ea",
                                        "entry_id": "875f992c-0a80-3c97-b656-ef42de8d2f6a",
                                        "glosses": [
                                            "A bouncy castle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d37a08d0-3cc5-3ddd-a2c1-50612648df5c",
                                        "entry_id": "875f992c-0a80-3c97-b656-ef42de8d2f6a",
                                        "glosses": [
                                            "A kind of seat mounted in a framework in which a baby can bounce up and down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7245adc-393c-4fea-ab85-583c21619f49",
                                                "sense_id": "d37a08d0-3cc5-3ddd-a2c1-50612648df5c",
                                                "text": "He shook his head and took up the child—Dilly kicked out her feet in tiny electric jolts to the full stretch of the Babygro.[…]He put the child in the bouncer again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03068788-da49-3223-a483-8fa190fa8001",
                                        "entry_id": "875f992c-0a80-3c97-b656-ef42de8d2f6a",
                                        "glosses": [
                                            "Short for shop-bouncer"
                                        ],
                                        "tags": [
                                            "UK",
                                            "abbreviation",
                                            "alt-of",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad22118c-cbf8-4adc-bdcc-10bddbb27a29",
                                                "sense_id": "03068788-da49-3223-a483-8fa190fa8001",
                                                "text": "Noting a shop where goods are piled on the counter, or within reach, a man goes in called a bouncer, and generally asks to look at some handkerchiefs, selecting a time when there is only one shopman in the way, breakfast-time for instance; whilst this is going on, a well-dressed youth comes in with a blue bag in his hand, asking for shoe-ties, or some trifling article. Now the work begins; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
