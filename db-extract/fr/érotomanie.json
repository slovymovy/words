                    }
                ],
                "senses": [
                    {
                        "sense_id": "855a1180-f12a-33e8-80d4-55769b5fbe0c",
                        "entry_id": "be1b0563-3ff3-3362-9bd0-abb732a2572e",
                        "glosses": [
                            "Illusion délirante d’être désiré ou aimé par une autre personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52ed198d-487d-45ca-a03e-9bf1ba516bbe",
                                "sense_id": "855a1180-f12a-33e8-80d4-55769b5fbe0c",
                                "text": "Quoi que tu fasses pour la décourager, elle l’interprètera comme une marque d’amour déguisée, c’est de l’érotomanie, crois-moi !"
                            }
                        ]
                    },
                    {
                        "sense_id": "865cca03-dd6b-3d9c-8e65-fe752b8ec07a",
                        "entry_id": "be1b0563-3ff3-3362-9bd0-abb732a2572e",
                        "glosses": [
                            "Obsession caractérisée par des préoccupations d’ordre érotique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2373a152-638c-44ee-8a44-d9e76e3ed0c3",
                        "source_entry_id": "be1b0563-3ff3-3362-9bd0-abb732a2572e",
                        "target_lang_word": "Erotomanie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erotomanie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b741317-d219-3de6-9092-7bd6ea0c3af3",
                                        "entry_id": "8f8db986-a120-37d9-8cea-e4f1e2ffeddd",
                                        "glosses": [
                                            "übersteigert erhöhtes sexuelles Verlangen beziehungsweise Geschlechtstrieb; Hypersexualität (auf der körperlichen Ebene)"
                                        ],
                                        "tags": [
                                            "Sexualwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8efc1f3-3724-465e-8399-ac8d205ecdd6",
                                                "sense_id": "0b741317-d219-3de6-9092-7bd6ea0c3af3",
                                                "text": "Auf dem Weg zu dem Arzt, der bei ihm Erotomanie diagnostizieren sollte, masturbierte er heimlich – wie gewöhnlich das neunte Mal an diesem Tag."
                                            },
                                            {
                                                "example_id": "5e1faecf-6df3-49a2-9122-32ca2db5e1c0",
                                                "sense_id": "0b741317-d219-3de6-9092-7bd6ea0c3af3",
                                                "text": "„Doch mittlerweile sei bekannt, dass die Erotomanie nicht einfach eine Mannstollheit sei, betonen Hans-Jörg Assion und Patrick Debbelt vom Zentrum für Psychiatrie der Ruhr-Universität Bochum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f77f284-273e-36d6-865e-e8b1ab060ea1",
                                        "entry_id": "8f8db986-a120-37d9-8cea-e4f1e2ffeddd",
                                        "glosses": [
                                            "wahnhafte, unwiderstehliche, romantische und idealisierte Liebe zu einer meist unerreichbaren Person; Liebeswahn (auf der psychischen Ebene)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c084d9cf-94ab-4593-8a25-89715fea8753",
                                                "sense_id": "0f77f284-273e-36d6-865e-e8b1ab060ea1",
                                                "text": "Jemand, der Erotomanie hat, sehnt sich nach einer idealisierten Person und glaubt immerfort, dass diese ihn auch liebt, obwohl diese vielleicht gar nichts davon weiß – der Eromane lässt sich jedoch nicht von seinem permanenten Scheitern beirren, sondern glaubt weiter an seine Illusion."
                                            },
                                            {
                                                "example_id": "a6665985-672e-4ab6-8a34-821262744870",
                                                "sense_id": "0f77f284-273e-36d6-865e-e8b1ab060ea1",
                                                "text": "„Das zentrale Thema der Erotomanie besteht jedoch darin, dass der Verliebte glaubt, von eben jener Person, die meist nichts von dessen Gefühlen weiß, wiedergeliebt zu werden, auch wenn hierfür keinerlei Anzeichen vorhanden sind.“"
                                            },
                                            {
                                                "example_id": "f39aae7f-fc5a-4b92-ab52-00a079cf686b",
                                                "sense_id": "0f77f284-273e-36d6-865e-e8b1ab060ea1",
                                                "text": "„Unter den Tiermasken verbergen sich zwei junge Männer. Man erinnert sich an Hans Neuenfels’ Erotomanien und an Pasolinis Träume.“"
                                            },
                                            {
                                                "example_id": "076c510d-8368-4d16-9b58-3c990c724f6f",
                                                "sense_id": "0f77f284-273e-36d6-865e-e8b1ab060ea1",
                                                "text": "„Alle Gaben seines Geistes sind nun schon durch Erotomanie gefährdet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
