                    "frequency": "Middle",
                    "semantic_group_id": "criticize_petty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no reason to <w>niggle</w> over every tiny formatting error in the draft."
                        },
                        {
                            "text": "The reviewers began to <w>niggle</w> about punctuation instead of discussing the main ideas."
                        }
                    ],
                    "synonyms": [
