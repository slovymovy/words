                "senses": [
                    {
                        "sense_id": "9d9fa2f5-f173-39d4-8bef-87ed07e85a8a",
                        "entry_id": "d34e169c-c28a-386b-bf44-fb21fa0d088d",
                        "glosses": [
                            "eingeschränkte Gleichheit/Übereinstimmung von zwei wahrgenommenen Gerüchen; entweder bei stofflicher Verschiedenheit der Geruchsstoffe oder bei stofflicher Gleichheit der Geruchsstoffe (Abgleich von Muster und Realität)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69082e71-76e8-408b-888b-41c2be274e6e",
                                "sense_id": "9d9fa2f5-f173-39d4-8bef-87ed07e85a8a",
                                "text": "„Liebstöckel ist eine Staude und auf Grund der charakteristischen Geruchsähnlichkeit mit Maggi-Würze auch „Maggi-Kraut“ genannt.“"
                            },
                            {
                                "example_id": "7c6f48a7-3c65-4452-905c-7e6ba181c7ee",
                                "sense_id": "9d9fa2f5-f173-39d4-8bef-87ed07e85a8a",
                                "text": "„Wegen der Geruchsähnlichkeit mit Nardus indica erhielt sie auch den Namen Nardus italica.“"
                            },
                            {
                                "example_id": "a088a6e1-635f-44ec-8f5d-49474d67ba8c",
                                "sense_id": "9d9fa2f5-f173-39d4-8bef-87ed07e85a8a",
                                "text": "„Tiere nutzen die Geruchsähnlichkeit zur Erkennung ihrer Familie, während diese Fähigkeit beim Menschen vergleichsweise schlecht ausgebildet ist.“"
                            },
                            {
                                "example_id": "94719689-fd72-4ab0-8c8f-090c2092d1fd",
                                "sense_id": "9d9fa2f5-f173-39d4-8bef-87ed07e85a8a",
                                "text": "„Die Feststellung der Geruchsähnlichkeit der Proben ist Ausfluss der Gasmischungsähnlichkeit, bei der auch die geruchsneutralen Stoffe mitgemessen werden.“"
                            },
                            {
                                "example_id": "08b06a0e-ea94-4e4a-af58-68b021489f8e",
                                "sense_id": "9d9fa2f5-f173-39d4-8bef-87ed07e85a8a",
                                "text": "„Wir haben nun also eine Einbettung der Geruchsähnlichkeiten in einen 32-dimensionalen Raum vorgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
