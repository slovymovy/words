                "senses": [
                    {
                        "sense_id": "20381a36-7d96-3cab-abae-27f0a4fe4d9f",
                        "entry_id": "f2be2df8-e829-3076-8e4c-ad3493789453",
                        "glosses": [
                            "dat er voor een bepaalde dienst een geldelijke vergoeding kan worden gevraagd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4efd12fb-fcaa-4a20-982e-fd1d0ea7fb96",
                                "sense_id": "20381a36-7d96-3cab-abae-27f0a4fe4d9f",
                                "text": "\"Dat kan gevaarlijk zijn\", meent Van de Goor. \"De kans bestaat dat er straks veel aandacht gaat naar lichte gevallen. De moeilijke gevallen kunnen straks onvoldoende zorg gaan krijgen omdat het niet declarabel is of tijd kost die er niet meer is.\""
                            },
                            {
                                "example_id": "4a16cd13-d5b1-4c8f-8cfe-ad275483d723",
                                "sense_id": "20381a36-7d96-3cab-abae-27f0a4fe4d9f",
                                "text": "Dales, die sinds mei weg is bij 50Plus, zegt dat hij in maart een hele lijst declaraties van Krol onder ogen kreeg. Het gaat volgens hem om bedragen van 500 tot 1000 euro per jaar. Die zijn nooit declarabel, en zeker niet bij de partij, zegt Dales."
                            }
                        ]
                    }
