{
    "word_family": [
        "affliction",
        "afflicted",
        "afflictive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "235a436c-1a70-3606-91a3-f34a04fd151c",
                    "sense_definition": "To cause physical or mental pain, suffering, or distress to someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cause_suffering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Severe droughts continue to <w>afflict</w> the region, causing widespread food shortages.",
                            "target_lang_translations": {
                                "de": "Schwere Dürren <w>plagen</w> die Region weiterhin und führen zu weit verbreiteter Nahrungsmittelknappheit.",
                                "ru": "Сильные засухи продолжают <w>мучить</w> этот регион, вызывая повсеместную нехватку продовольствия.",
                                "zh": "严重的干旱继续<w>困扰</w>着该地区，造成大范围的粮食短缺。"
                            }
                        },
                        {
                            "text": "The doctor explained that the rare disease can <w>afflict</w> patients of any age.",
                            "target_lang_translations": {
                                "de": "Der Arzt erklärte, dass die seltene Krankheit Patienten jeden Alters <w>befallen</w> kann.",
                                "ru": "Врач объяснил, что эта редкая болезнь может <w>поражать</w> пациентов любого возраста.",
                                "zh": "医生解释说，这种罕见疾病可能会<w>侵害</w>任何年龄段的患者。"
                            }
                        }
                    ],
                    "synonyms": [
                        "torment",
                        "torture",
                        "distress",
                        "plague",
                        "trouble",
                        "vex",
                        "harass"
                    ],
                    "antonyms": [
                        "comfort",
                        "soothe",
                        "relieve"
                    ],
                    "common_phrases": [
                        "afflict the region",
                        "afflict patients"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemandem körperlichen oder geistigen Schmerz, Leiden oder Kummer zufügen.",
                        "ru": "Причинять физическую или душевную боль, страдания или беспокойство.",
                        "zh": "使身心遭受痛苦、折磨或苦难；困扰，折磨。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "plagen",
                                "target_lang_sense_clarification": "durch Krankheiten, Sorgen oder Schmerzen belasten"
                            },
                            {
                                "target_lang_word": "befallen",
                                "target_lang_sense_clarification": "von einer Krankheit oder einem Unglück heimgesucht werden"
                            },
                            {
                                "target_lang_word": "heimsuchen",
                                "target_lang_sense_clarification": "schwer treffen oder belasten (z. B. Katastrophen, Krankheiten)"
                            },
                            {
                                "target_lang_word": "bekümmern",
                                "target_lang_sense_clarification": "Sorgen oder Kummer bereiten"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "причинять сильные физические или моральные страдания"
                            },
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "сильно мучить, причинять глубокие страдания"
                            },
                            {
                                "target_lang_word": "поражать",
                                "target_lang_sense_clarification": "о болезни, которая охватывает организм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "困扰",
                                "target_lang_sense_clarification": "使处于苦恼或艰难境地（常用于灾害、问题）"
                            },
                            {
                                "target_lang_word": "折磨",
                                "target_lang_sense_clarification": "使身心承受极大痛苦"
                            },
                            {
                                "target_lang_word": "侵害",
                                "target_lang_sense_clarification": "疾病或有害事物侵入并损害"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ceae8d20-b734-342d-a02d-3a5be295770e",
                    "sense_definition": "To humble, lower, or make low in condition or spirit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "humble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sought to <w>afflict</w> his proud heart through fasting and quiet contemplation.",
                            "target_lang_translations": {
                                "de": "Er versuchte, sein stolzes Herz durch Fasten und stille Kontemplation zu <w>demütigen</w>.",
                                "ru": "Он стремился <w>смирить</w> свое гордое сердце постом и тихим созерцанием.",
                                "zh": "他试图通过禁食和静思来<w>挫抑</w>自己骄傲的心。"
                            }
                        },
                        {
                            "text": "The sudden loss of his fortune served to <w>afflict</w> his arrogant nature.",
                            "target_lang_translations": {
                                "de": "Der plötzliche Verlust seines Vermögens trug dazu bei, sein arrogantes Wesen zu <w>beugen</w>.",
                                "ru": "Внезапная потеря состояния послужила тому, чтобы <w>унизить</w> его высокомерный нрав.",
                                "zh": "家财的骤失<w>打压</w>了他狂妄的本性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aggrieve",
                        "trouble"
                    ],
                    "antonyms": [
                        "exalt",
                        "uplift"
                    ],
                    "common_phrases": [
                        "afflict one's soul"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary or religious contexts to mean humbling oneself."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Demütigen, erniedrigen oder im Geist oder Zustand herabstimmen.",
                        "ru": "Смирять, унижать или подавлять гордость или дух.",
                        "zh": "使降卑、谦卑，压低其心气或地位（古旧用法，尤指宗教或文学中使灵魂或骄傲受挫）。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "demütigen",
                                "target_lang_sense_clarification": "den Stolz brechen oder erniedrigen"
                            },
                            {
                                "target_lang_word": "kasteien",
                                "target_lang_sense_clarification": "sich selbst im religiösen Sinne bezwingen oder peinigen"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "смирять",
                                "target_lang_sense_clarification": "подавлять гордость, делать более покорным"
                            },
                            {
                                "target_lang_word": "унижать",
                                "target_lang_sense_clarification": "лишать достоинства, подавлять дух"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挫抑",
                                "target_lang_sense_clarification": "压抑、挫伤（骄气或傲慢）"
                            },
                            {
                                "target_lang_word": "使谦卑",
                                "target_lang_sense_clarification": "压低傲气，使之低下"
                            },
                            {
                                "target_lang_word": "苦待",
                                "target_lang_sense_clarification": "宗教文脉中刻苦己心、自卑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f200e49-8f56-3638-84c8-39b0128a12d3",
                    "sense_definition": "To strike down, overthrow, or defeat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "overthrow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general sought to gather his <w>afflicted</w> forces after the devastating defeat.",
                            "target_lang_translations": {
                                "de": "Der General versuchte, seine <w>geschlagenen</w> Truppen nach der verheerenden Niederlage wieder zu sammeln.",
                                "ru": "Генерал пытался собрать свои <w>разбитые</w> войска после сокрушительного поражения.",
                                "zh": "惨败之后，将军试图重整自己被<w>击溃</w>的部队。"
                            }
                        },
                        {
                            "text": "A sudden storm arose to <w>afflict</w> their fleet, scattering the ships across the sea.",
                            "target_lang_translations": {
                                "de": "Ein plötzlicher Sturm zog auf, um ihre Flotte zu <w>zerschlagen</w> und die Schiffe über das Meer zu verstreuen.",
                                "ru": "Внезапно поднявшийся шторм <w>сокрушил</w> их флот, разбросав корабли по всему морю.",
                                "zh": "突如其来的暴风雨<w>重创</w>了他们的舰队，将船只冲散在海面上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smite",
                        "rend"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This sense of physically casting down or overthrowing is obsolete."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Niederschlagen, stürzen oder besiegen.",
                        "ru": "Сокрушать, наносить поражение или подавлять.",
                        "zh": "击溃、打垮或推翻（已废弃用法）。"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "niederschlagen",
                                "target_lang_sense_clarification": "Kräfte oder Truppen zerschlagen oder entmutigen"
                            },
                            {
                                "target_lang_word": "schlagen",
                                "target_lang_sense_clarification": "besiegen oder vernichten"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сокрушать",
                                "target_lang_sense_clarification": "наносить тяжелое поражение, разбивать"
                            },
                            {
                                "target_lang_word": "разбивать",
                                "target_lang_sense_clarification": "наносить поражение в бою или в делах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "击溃",
                                "target_lang_sense_clarification": "击败并使之溃散"
                            },
                            {
                                "target_lang_word": "打垮",
                                "target_lang_sense_clarification": "彻底战胜或挫败"
                            },
                            {
                                "target_lang_word": "重创",
                                "target_lang_sense_clarification": "给予严重打击"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}