                "senses": [
                    {
                        "sense_id": "72392173-e352-3d29-b028-2a7fa97f666e",
                        "entry_id": "4a022a57-dedf-3f82-a544-7d94977825b9",
                        "glosses": [
                            "die Art, wie ein Laut im Sprechtrakt gebildet wird"
                        ],
                        "tags": [
                            "speziell Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "cfee72df-cefd-417a-acd6-1fd7b8292e10",
                                "sense_id": "72392173-e352-3d29-b028-2a7fa97f666e",
                                "text": "Die Artikulationsarten des Lautes [b] sind: bilabial und stimmhaft."
                            },
                            {
                                "example_id": "bc73212c-b161-4e45-b97e-efe5e573dda6",
                                "sense_id": "72392173-e352-3d29-b028-2a7fa97f666e",
                                "text": "Laute werden in der artikulatorischen Phonetik nach Artikulationsart und Artikulationsort beschrieben."
                            },
                            {
                                "example_id": "958abcac-30ac-40d0-962c-b35630045799",
                                "sense_id": "72392173-e352-3d29-b028-2a7fa97f666e",
                                "text": "„Grundlegend für die Eigenschaften eines Lautes sind dessen Artikulationsart und dessen Artikulationsort (-stelle).“"
                            },
                            {
                                "example_id": "986a7047-87d3-4357-9b70-69606c4c58e1",
                                "sense_id": "72392173-e352-3d29-b028-2a7fa97f666e",
                                "text": "„Der nachfolgende Konsonant wird also entsprechend des Artikulationsortes und der -art variiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
