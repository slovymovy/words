                        "sense_id": "7302fc78-a5f4-3396-8bea-1bacfbe0507d",
                        "entry_id": "0a9ea584-9110-347c-af3d-adb2266309f4",
                        "glosses": [
                            "A small amount, especially a small alcoholic drink."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "b5c49273-4615-4f73-9af7-d4cd9d862645",
                                "sense_id": "7302fc78-a5f4-3396-8bea-1bacfbe0507d",
                                "text": "The signal officer was looking wise over something that boomed and buzzed alternately; the machine-gun officer may, or may not, have been enjoying another toothful."
                            },
                            {
                                "example_id": "fc58bb21-cf29-4307-9a7d-195c251fa09f",
                                "sense_id": "7302fc78-a5f4-3396-8bea-1bacfbe0507d",
                                "text": "\"Give her a toothful of whisky, your ladyship."
                            },
                            {
                                "example_id": "8e15dd3d-ba00-4e36-9ec1-c39c7056e1df",
                                "sense_id": "7302fc78-a5f4-3396-8bea-1bacfbe0507d",
                                "text": "\"Thank you,\" said David a minute or two later on, holding out the glass while John poured, \"jest a wisdom toothful."
                            },
                            {
                                "example_id": "5f1c6a9b-cb25-4500-9117-fdf0cea14944",
                                "sense_id": "7302fc78-a5f4-3396-8bea-1bacfbe0507d",
                                "text": "Of course it is better late than never, only not much bliss follows late attendance, and hardly a toothful of ecstacy can be obtained in three-quarters of a minute."
                            }
                        ]
                    }
