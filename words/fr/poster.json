                    "frequency": "High",
                    "semantic_group_id": "internet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a décidé de <w>poster</w> une photo de ses vacances sur son profil ce matin."
                        },
                        {
                            "text": "De nombreux utilisateurs aiment <w>poster</w> un commentaire sous cette vidéo captivante."
                        }
                    ],
                    "common_phrases": [
