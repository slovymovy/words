                    {
                        "translation_id": "9c90bc3e-232f-4d06-8996-a84b8fbd9d74",
                        "source_entry_id": "2d5b699e-b57b-3237-a225-079d6f2dff4e",
                        "target_lang_word": "Girlande",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Girlande",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                        "entry_id": "12968f0a-5af6-339b-a387-7b43f53da52d",
                                        "glosses": [
                                            "aus Laub, Blumen, Papier oder Stoffbändern geflochtenes, dekoratives Band"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc3aa68-b4b2-4547-a467-7e8c793c9b4b",
                                                "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                                "text": "Der Weihnachtsbaum wird oft mit Girlanden geschmückt."
                                            },
                                            {
                                                "example_id": "589b3a63-46dd-442e-8132-76f0d31482b1",
                                                "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                                "text": "Für das Straßenfest schmückten wir die Häuser und die Straßenlaternen mit Girlanden."
                                            },
                                            {
                                                "example_id": "52501774-147e-4916-9406-9e475f7f31c7",
                                                "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                                "text": "„In der Stube stand ein Vertiko und darauf eine Jesus-Figur aus Gips mit einer Girlande aus Papierrosen und einem Heiligenschein aus Katzengold.“"
                                            },
                                            {
                                                "example_id": "7a65d1b8-f5c8-4a68-8b46-830f2c16adc4",
                                                "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                                "text": "„Die Girlanden vor dem Haus sollen zusätzlich mit bunten Bändern in den Familienfarben geschmückt werden.“"
                                            },
                                            {
                                                "example_id": "8a0eaae8-6116-4576-91a3-0a6f0eb47145",
                                                "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                                "text": "„Im großen Festsaal, am Vormittag von der Hausdame und ihren Mädchen mit einer Fülle von Blumengestecken und Girlanden dekoriert, wurden die Dessert-Teller abgeräumt.“"
                                            },
                                            {
                                                "example_id": "c75e5ebb-4269-41ed-96d6-b88330114716",
                                                "sense_id": "1ed3853a-3927-3a7d-9e93-3c146b627cc5",
                                                "text": "„Überall hängen Girlanden aus Papier, Fahnen, natürlich schwarzweißrote, und Kränze aus Tannengrün.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebf55e37-4e7d-4ee2-aca8-1732bdcc34a0",
                        "source_entry_id": "2d5b699e-b57b-3237-a225-079d6f2dff4e",
                        "target_lang_word": "guirlande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guirlande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd938e9-e7d7-3019-9455-574be0f69dbc",
                                        "entry_id": "2f043f09-bfce-315d-bfb6-1f09482d0822",
                                        "glosses": [
                                            "Chaîne, feston de fleurs ou de feuillage, ou de leur imitation synthétique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e86243b1-080f-4711-8368-17bee7d6a9a5",
                                                "sense_id": "4dd938e9-e7d7-3019-9455-574be0f69dbc",
                                                "text": "Les jeunes gens qui venaient la voir l'appelaient Chrysé comme Aphrodite, dans les vers qu'ils mettaient à sa porte, avec des guirlandes de roses, le matin."
                                            },
                                            {
                                                "example_id": "4190c591-d771-48bc-95d3-c361b684e49a",
                                                "sense_id": "4dd938e9-e7d7-3019-9455-574be0f69dbc",
                                                "text": "Les pauvres bêtes apeurées, se refusaient à avancer. Deux femmes les tiraient par des guirlandes de papier de couleur dont on les avait enrubannés."
                                            },
                                            {
                                                "example_id": "1f983b00-6c3b-499c-b66e-707ad553e0f9",
                                                "sense_id": "4dd938e9-e7d7-3019-9455-574be0f69dbc",
                                                "text": "L’utopie n’a toutefois pas forcément besoin de se parer des guirlandes lumineuses des grands lendemains qui chantent, elle peut se pencher sur un registre plus modeste, celui de l’intime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3f041a1-086b-34f7-836d-d3b475144000",
                                        "entry_id": "2f043f09-bfce-315d-bfb6-1f09482d0822",
                                        "glosses": [
                                            "Ce qui, par la manière dont elle est assemblée ou disposée, imite des festons, des guirlandes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0556741e-8b54-4d25-a315-01133073e57c",
                                                "sense_id": "e3f041a1-086b-34f7-836d-d3b475144000",
                                                "text": "Il y a, sur des planches, des tomates, des pains dorés, des chapelets d’aulx et, suspendues auprès des portes, des guirlandes de petits oiseaux que les chasseurs rapportent après le coucher du soleil."
                                            },
                                            {
                                                "example_id": "63d800c5-07a8-4dfa-9be9-c8249e47bd18",
                                                "sense_id": "e3f041a1-086b-34f7-836d-d3b475144000",
                                                "text": "— Et voici que des guirlandes de jeunes filles, fleurs rieuses dans leurs corolles couleur de ciel, couleur d'eau, couleur de feuille, essaient la cadence des rondes dont le cornemusiste joufflu guidera aigrement les temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a584bed-62aa-35be-b280-72e4e2f6f191",
                                        "entry_id": "2f043f09-bfce-315d-bfb6-1f09482d0822",
                                        "glosses": [
                                            "Ornements de feuillages, de fleurs ou de fruits dont les sculpteurs et les peintres décorent les bâtiments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
