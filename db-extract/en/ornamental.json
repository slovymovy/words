                                    {
                                        "sense_id": "7e516811-474d-3108-9e50-e09bbe56dfa2",
                                        "entry_id": "51899b46-c117-345a-a296-6cc24eba2222",
                                        "glosses": [
                                            "Qui appartient à l’ornement ; qui sert l’ornement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab8eaae5-d0cc-4017-8cce-a124475cb904",
                                                "sense_id": "7e516811-474d-3108-9e50-e09bbe56dfa2",
                                                "text": "Le forsythia est un arbuste ornemental dont la couleur jaune des fleurs et la floribondité sont très appréciées au début du printemps."
                                            },
                                            {
                                                "example_id": "51f88cec-3696-4d0b-ab85-d655ba1ab55b",
                                                "sense_id": "7e516811-474d-3108-9e50-e09bbe56dfa2",
                                                "text": "Cependant, le caractère vraiment ornemental et architectural des armoiries, qui ne tolérait pas une représentation des objets sous leur forme parfaitement naturelle, se conserva […] jusqu’au milieu du 16ᵉ [siècle]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79f76ca4-2dca-4cf9-8ec7-7d8aee1147c8",
                        "source_entry_id": "ba443071-8c58-375e-9a37-970e7ea078f3",
                        "source_sense_description": "serving to ornament",
                        "target_lang_word": "Zier-",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "53008bda-d356-4e26-b62b-35498f68aec0",
                        "source_entry_id": "ba443071-8c58-375e-9a37-970e7ea078f3",
                        "source_sense_description": "serving to ornament",
                        "target_lang_word": "dekorativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dekorativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                        "entry_id": "0d554fbf-d6f4-3831-88a4-c0c6f7560a4f",
                                        "glosses": [
                                            "etwas gut aussehen lassend, schmückend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf16413-a58a-4faa-af99-5b7add229845",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "„Neben den Figuren und anderen dekorativen Elementen wurde auch eine Steinplatte mit einer Art Rinne ausgegraben,“ […]."
                                            },
                                            {
                                                "example_id": "85e646ea-e1c6-47c8-b205-3b6405707355",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "„Die arabische Kalligrafie erscheint auch als dekoratives Element in verschiedenen Formen, von Holzschnitzereien bis zu Stickereien.“"
                                            },
                                            {
                                                "example_id": "d72613fd-4eee-4bec-af87-45a74c0992ab",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "„Kosmetik lässt sich in Pflegekosmetik und dekorative Kosmetik unterteilen;“ […]."
                                            },
                                            {
                                                "example_id": "00f1ce48-99ea-4d40-a89b-09aa4bed6599",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "„Ein Altar für Nippes – Dieses um 1900 gefertigte Jugendstil-Vertiko dient als Zierschränkchen für allerlei dekorative Kleinigkeiten.“"
                                            },
                                            {
                                                "example_id": "57e524b6-7273-4b96-aa76-ebae41470c89",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "„Nach dem Vorbild von Schießscheiben wurden diese beiden dekorativen Steinzeug-Wandteller mit Jagdmotiven von der saarländischen Firma Villeroy & Boch um 1905 gestaltet.“"
                                            },
                                            {
                                                "example_id": "a5b9a22f-6444-49ac-bdb7-75bd85e11a3e",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "„Die Vase ist 54 cm x 40 cm groß und befindet sich in einem „guten Zustand“. Ein Gutachter hatte ihren Wert auf 1.500 bis 2.000 Euro geschätzt, er stufte die Vase als dekoratives Stück des 20. Jahrhunderts ein.“"
                                            },
                                            {
                                                "example_id": "4a824750-54c5-4789-8422-f77cc1478663",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "„Weil die Sonne auf dekorative Glaskugeln schien, kam es Anfang April in einer Wohnung in Aeschi bei Spiez zu einem Brand.“"
                                            },
                                            {
                                                "example_id": "11bd2c52-b8c2-461b-b5b6-c63bdc6e16f4",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "„In kleinen Gärten hat es sich bewährt die Kräuter im gesamten Garten verteilt zu pflanzen. Damit entsteht nicht nur eine ideale Mischkultur, sondern es kommt auch die dekorative Wirkung der einzelnen Pflanzen zur Geltung.“"
                                            },
                                            {
                                                "example_id": "7a56c686-2d18-4db1-94d7-5bf1a31c83f9",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "„Früher war der Vizepräsident lediglich ein dekoratives Anhängsel. Heute kommt der Präsident aber ohne Stellvertreter nicht mehr aus:“ […]."
                                            },
                                            {
                                                "example_id": "4766c7d3-d6f7-4bbe-9cdf-fac763465443",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "Der Küchenchef richtete das Zanderfilet dekorativ auf dem Teller an."
                                            },
                                            {
                                                "example_id": "3b878e2c-4d8b-4633-a34d-82e8de4b077d",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "[Scherenschnitte von Annette Schröter:] „Wie kaum ein anderer Künstler vor ihr hat sie sich an eine als bieder und dekorativ verschriene traditionelle Technik gewagt“ […]."
                                            },
                                            {
                                                "example_id": "83790f4f-26b9-4af2-9c13-8acc6c819307",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "[Ein langes Tuch] „schützt vor Fahrtwind und Klimaanlagen, indem man es sich dekorativ über die Schultern legt.“"
                                            },
                                            {
                                                "example_id": "b83c6466-2d2b-4319-acfb-551a576a9e2d",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "[Russische Holzkirchen:] Die Kirchen „wurden im Laufe der Zeit immer dekorativer ausgestaltet.“"
                                            },
                                            {
                                                "example_id": "d53845ed-32b4-49b0-8f3a-cc9cf812b931",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "„Venezianischer Putz ist aber nicht nur dekorativ, sondern reflektiert besonders gut Licht.“"
                                            },
                                            {
                                                "example_id": "e2cfa5d9-c4ec-4667-8d86-0955784c3da9",
                                                "sense_id": "b0943a5a-3a00-3c04-84ef-14695728e614",
                                                "text": "[Graffiti:] \"man muss ehrlich zugeben, dass sich mancherlei Kunst damit zufrieden gibt, rein dekorativ und harmlos zu sein.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
