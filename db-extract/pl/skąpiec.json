                        "sense_id": "0b4f046e-bfc1-3cbf-9d39-d558dae929ee",
                        "entry_id": "f6a814db-0555-3e85-b14c-e657677d4826",
                        "glosses": [
                            "osoba niechętnie wydająca swoje pieniądze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1a000ea-fb84-4a54-8a38-dd75298800df",
                                "sense_id": "0b4f046e-bfc1-3cbf-9d39-d558dae929ee",
                                "text": "W dzisiejszych czasach tylko skąpcy cerują skarpetki, zamiast nabyć parę nowych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cf01383-e113-4aa2-b01a-4f47a4e27e05",
                        "source_entry_id": "f6a814db-0555-3e85-b14c-e657677d4826",
                        "source_sense_id": "0b4f046e-bfc1-3cbf-9d39-d558dae929ee",
                        "target_lang_word": "scrooge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scrooge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d159afbc-2f2e-3c41-af6a-701436de023f",
                                        "entry_id": "d374e040-2de6-3684-884f-97b06e09dce7",
                                        "glosses": [
                                            "A miserly person; a person with an excessive dislike of spending money or other resources."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a197ea4-ba44-33ab-ade4-54ed3b3b1ec6",
                                        "entry_id": "d374e040-2de6-3684-884f-97b06e09dce7",
                                        "glosses": [
                                            "A person who is grumpy about the Christmas holidays."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "scrooge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                                        "entry_id": "fa2491b8-0f5c-3b0c-98b2-fdc47cf54954",
                                        "glosses": [
                                            "To behave in a greedy or miserly way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bf0513e-f302-408d-a1ba-d793b84ebeb2",
                                                "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                                                "text": "Mr. Chairman, $6 million is 15 times more than what the President earns and 30 times more than what a Cabinet Secretary earns. The Christmas Eve announcement of these bonuses was greeted by one commentator by saying the taxpayers got scrooged."
                                            },
                                            {
                                                "example_id": "14cbf64c-3689-4642-9799-8bbe915484a8",
                                                "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                                                "text": "He went back to live in Clayton with dad and tearfully explained to him about Aunt Eliza and her mean, scrooging ways."
                                            },
                                            {
                                                "example_id": "7182cde4-01c7-472d-8c3e-59b1042e80c7",
                                                "sense_id": "ff58ffbb-ee06-3741-aa75-63a8b6a63345",
                                                "text": "[…]corporations scrooging their way out of paying taxes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scrooge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d94771af-9e61-37fb-a879-d17fe27c4b8b",
                                        "entry_id": "bad5880a-df74-32fa-a721-d97e7a706008",
                                        "glosses": [
                                            "To crush or press; to squeeze (past, into, together, etc.)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9549be-0ea4-419b-9a8c-f9c779cf31a5",
                                                "sense_id": "d94771af-9e61-37fb-a879-d17fe27c4b8b",
                                                "text": "So he scraped and scratched and scrabbled and scrooged, then he scrooged again[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
