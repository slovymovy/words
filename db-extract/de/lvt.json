                        ],
                        "examples": [
                            {
                                "example_id": "620fa9a9-9e2c-478c-953d-577df1eb299c",
                                "sense_id": "294a330b-5755-3352-8a54-9d33d7bbf9ba",
                                "text": "Wegen einer Ermittlungspanne im Vorfeld des Terroranschlags wurde der Leiter des LVT Wien auf eigenen Wunsch vom Wiener Polizeichef abberufen."
                            },
                            {
                                "example_id": "dd2b7b6f-cd86-4649-b2f8-c32bb97abbce",
                                "sense_id": "294a330b-5755-3352-8a54-9d33d7bbf9ba",
                                "text": "Das LVT prüft jetzt, ob sich die Gruppe in Floridsdorf festsetzt."
                            },
                            {
                                "example_id": "2ad19b1b-2aa4-4b99-a6c0-51c1a3a0d5ce",
                                "sense_id": "294a330b-5755-3352-8a54-9d33d7bbf9ba",
                                "text": "Das Justizministerium hat beim Wiener Landesamt für Verfassungsschutz und Terrorismusbekämpfung (LVT) „wenig ambitionierte“ Ermittlungen nach einem Aufmarsch rechtsextremer Hooligans im September 2011 in der Wiener Generali-Arena geortet."
                            }
