                                    {
                                        "sense_id": "bf7fed1c-a41d-3739-a3e2-53657625e0a2",
                                        "entry_id": "96253a6e-4f5c-3bd1-9a8a-eb4c53496dd2",
                                        "glosses": [
                                            "sowohl Buchstaben als auch Ziffern umfassend/verwendend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e2844d8-1111-4abf-b398-a8086c10c5ca",
                                                "sense_id": "bf7fed1c-a41d-3739-a3e2-53657625e0a2",
                                                "text": "„(1) Bildschirmgerät im Sinne dieser Verordnung ist ein Bildschirm zur Darstellung alphanumerischer Zeichen oder zur Grafikdarstellung, ungeachtet des Darstellungsverfahrens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "172a7c6d-7613-489e-81c0-c5a85b45a8d8",
                        "source_entry_id": "6a8f0afc-96f8-3e34-90ca-1dbfa78c9d81",
                        "source_sense_description": "consisting of letters and numbers",
                        "target_lang_word": "alphanummerisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alphanummerisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ee0ff8e-1a98-3e2f-9973-5fc34bcf9c6c",
                                        "entry_id": "6e87e3b7-4e78-3ef8-ae95-90787fb25b5c",
                                        "glosses": [
                                            "sowohl Buchstaben als auch Ziffern umfassend/verwendend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2de82897-4ad6-4692-8979-ac63ab8fec02",
                                                "sense_id": "5ee0ff8e-1a98-3e2f-9973-5fc34bcf9c6c",
                                                "text": "„Alphanummerisch ist ein Gattungsbegriff für die Möglichkeit, Buchstaben, Ziffern und Zeichen maschinell zu verarbeiten.“"
                                            },
                                            {
                                                "example_id": "caae296f-f870-4a4d-8080-7753068f5fb2",
                                                "sense_id": "5ee0ff8e-1a98-3e2f-9973-5fc34bcf9c6c",
                                                "text": "„Für die Katalogisierung in Originalschrift wurden in der hbz-Verbunddatenbank eigene - alphanummerische - Felder eingerichtet.“"
                                            },
                                            {
                                                "example_id": "bd4bc954-d565-4e1b-9ace-b19cdd4b5058",
                                                "sense_id": "5ee0ff8e-1a98-3e2f-9973-5fc34bcf9c6c",
                                                "text": "„Der Erstinhaberschlüssel ist alphanummerisch und besteht aus drei Zeichen.“"
                                            },
                                            {
                                                "example_id": "a9b06196-bcb1-4be9-bdf1-a5e00a4919d9",
                                                "sense_id": "5ee0ff8e-1a98-3e2f-9973-5fc34bcf9c6c",
                                                "text": "„Die dafür benötigten raumbezogenen Daten/Informationen [Geodaten] können digital erfasst und redigiert, verwaltet und reorganisiert, analysiert sowie alphanummerisch und graphisch präsentiert werden.“"
                                            },
                                            {
                                                "example_id": "62053b62-893c-4000-b58b-998d658a61c7",
                                                "sense_id": "5ee0ff8e-1a98-3e2f-9973-5fc34bcf9c6c",
                                                "text": "„Diese alphanummerische Identifikation in der Form [M1], [M2], [M3] usw. spart Arbeit in umfangreichen Technischen Berichten.“"
                                            },
                                            {
                                                "example_id": "7133516a-5666-4ac3-9121-189b1c8a7ddd",
                                                "sense_id": "5ee0ff8e-1a98-3e2f-9973-5fc34bcf9c6c",
                                                "text": "„Für die Codierung von Zeichen und Symbolen werden alphanummerische Codes eingesetzt.“"
                                            },
                                            {
                                                "example_id": "0c35565e-1b67-47a7-91f2-6b0cba3bdf30",
                                                "sense_id": "5ee0ff8e-1a98-3e2f-9973-5fc34bcf9c6c",
                                                "text": "„Hier haben Sie die Wahl zwischen der nummerischen Schreibweise (08.02.2008 beziehungsweise 08.02.08; die internationale Schreibweise lautet: 2008-02-08) und der alphanummerischen Variante (8. Februar 2008 beziehungsweise 8. Feb. 2008).“"
                                            },
                                            {
                                                "example_id": "7d8f7682-014f-4be1-8cf7-d8825e86f5e3",
                                                "sense_id": "5ee0ff8e-1a98-3e2f-9973-5fc34bcf9c6c",
                                                "text": "„Die Rechtsakte werden in alphanummerischer Ordnung der Abkürzungen aufgeführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
