        "fr-extract.jsonl": [
            {
                "entry_id": "8e902500-d34c-39a7-9ed6-45dcc89134db",
                "word": "sonate",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a26a7d3a-1026-44e0-8ce4-7b3b889b5788",
                        "entry_id": "8e902500-d34c-39a7-9ed6-45dcc89134db",
                        "tags": [
                            "plural"
                        ],
                        "form": "sonates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "98b2a47e-5667-3924-932d-c45df534e0b7",
                        "entry_id": "8e902500-d34c-39a7-9ed6-45dcc89134db",
                        "glosses": [
                            "Composition instrumentale de musique classique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fe67200-9df1-491b-a09c-09b593c26143",
                                "sense_id": "98b2a47e-5667-3924-932d-c45df534e0b7",
                                "text": "Les sonates de Beethoven."
                            },
                            {
                                "example_id": "bab662d2-0695-411b-ab26-314a4b71e768",
                                "sense_id": "98b2a47e-5667-3924-932d-c45df534e0b7",
                                "text": "Je crois aussi que je tenais pour négligeable le travail de l’exécutant parce qu’il me semblait ne produire que des apparences. Au fond, je pensais que la vérité d’une sonate était sur la portée, immuable, éternelle, comme celle de Macbeth dans le livre imprimé. Créer, c’était une autre affaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "957613c5-cbfb-36e6-b474-57206251bfb5",
                        "entry_id": "8e902500-d34c-39a7-9ed6-45dcc89134db",
                        "glosses": [
                            "Forme musicale de musique classique composée de trois parties : l’exposition, le développement et la réexposition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0abc7a4-9dbd-429f-a234-68bb33612113",
                                "sense_id": "957613c5-cbfb-36e6-b474-57206251bfb5",
                                "text": "— Voyons, jeune présomptueux, dit-il, qu’as-tu fait en composition ?\n— Mais des sonates, des chants sacrés, des quintetti.\n— Des sonates après Sébastien Bach ! des chants sacrés après Pergolèse ! des quintetti après François-Joseph Haydn ! Ah ! jeunesse ! jeunesse !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57376854-0221-427b-8561-4b60814e595d",
                        "source_entry_id": "8e902500-d34c-39a7-9ed6-45dcc89134db",
                        "target_lang_word": "Sonate",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonate",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "041fb064-a94b-37f7-9d67-e256830fc987",
                                        "entry_id": "2aec1a24-b4d0-35c3-acc0-5a7d6e0bb8f5",
                                        "glosses": [
                                            "ein Klangstück mit mehreren Sätzen"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d93dcf5-9eb5-45e6-8ec6-fd4730575b75",
                                                "sense_id": "041fb064-a94b-37f7-9d67-e256830fc987",
                                                "text": "„Während sie schweigend nebeneinander hergingen, hörte Thomas plötzlich in seinem Ohr die schöne Weise aus dem Andante der ersten Sonate vom Brahms, die sich seit Tagen in seinem Ohr eingewurmt hatte.“"
                                            },
                                            {
                                                "example_id": "9f7ea750-a2fe-409b-825d-f68b3969d011",
                                                "sense_id": "041fb064-a94b-37f7-9d67-e256830fc987",
                                                "text": "„Seine Schubladen stecken voller Sonaten, Lieder für Klavier und Gitarre, Messen und Ouvertüren.“"
                                            },
                                            {
                                                "example_id": "2af693f5-252c-4282-96cb-07b0e5908e96",
                                                "sense_id": "041fb064-a94b-37f7-9d67-e256830fc987",
                                                "text": "Die Sonate ist „ein Klangstück“ und ein „Formbegriff mit doppelter Bedeutung\". Die Sonate mit mehreren Sätzen ist von dem Sonaten-Satz, der Form ihres 1. Teiles, zu unterscheiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b5b8a50-2ff6-3c0b-a8dc-6c804a8b94df",
                                        "entry_id": "2aec1a24-b4d0-35c3-acc0-5a7d6e0bb8f5",
                                        "glosses": [
                                            "der Sonatensatz, der erste Satz einer Sonate"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb18ac0d-d5b2-4d10-a6a6-9af14ef1130f",
                                                "sense_id": "8b5b8a50-2ff6-3c0b-a8dc-6c804a8b94df",
                                                "text": "Die Sonate ist „ein Klangstück“ und ein „Formbegriff mit doppelter Bedeutung\". Die Sonate mit mehreren Sätzen ist von dem Sonaten-Satz, der Form ihres 1. Teiles, zu unterscheiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
