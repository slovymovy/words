                                    {
                                        "sense_id": "25ebf0ef-ee47-3c29-b543-fc8c839af933",
                                        "entry_id": "a45796a7-0709-35de-abcc-19bb234fff0b",
                                        "glosses": [
                                            "To seem to perceive things (with one or more of one's senses) which are not really present; to have visions; to experience a hallucination."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2624cf92-905e-3981-b13f-9bdb5b2a9aa1",
                                        "entry_id": "a45796a7-0709-35de-abcc-19bb234fff0b",
                                        "glosses": [
                                            "To produce information that is not supported by the model's training data."
                                        ],
                                        "tags": [
                                            "of a model"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "596dc0be-efd6-4915-b24d-2cbfb46dca84",
                                                "sense_id": "2624cf92-905e-3981-b13f-9bdb5b2a9aa1",
                                                "text": "In case you were wondering, the yahoo url above doesn’t actually exist, the model just hallucinated it."
                                            },
                                            {
                                                "example_id": "c602a62d-3ffb-4f2e-a239-2932cb391988",
                                                "sense_id": "2624cf92-905e-3981-b13f-9bdb5b2a9aa1",
                                                "text": "Despite maintaining plausible general linguistic capabilities, dialogue models are still unable to fully discern facts and may instead hallucinate factually invalid information."
                                            },
                                            {
                                                "example_id": "d5e83515-f0ae-47e5-ac0e-805966f47cc0",
                                                "sense_id": "2624cf92-905e-3981-b13f-9bdb5b2a9aa1",
                                                "text": "Rankin sanctioned Ayala $3,000 and kicked him off the lawsuit after the lawyer admitted incorporating the hallucinated AI-generated cases in the brief. Morgan and Goody were sanctioned $1,000 each."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
