                "senses": [
                    {
                        "sense_id": "a9055bd9-3633-31c3-a585-a0f3bd4ac408",
                        "entry_id": "0d725457-982a-3cce-8c74-562e4813b301",
                        "glosses": [
                            "Division d’un mot composé, dont les parties se trouvent séparées par un ou plusieurs mots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af8215f3-c3c7-4e19-bff6-c2434856c47e",
                                "sense_id": "a9055bd9-3633-31c3-a585-a0f3bd4ac408",
                                "text": "Il y a des exemples de tmèse en français, bien qu’elle fût surtout utilisée en latin, ainsi lorsqu’on écrit « lors même que »."
                            },
                            {
                                "example_id": "d6bfc2fd-f64f-428a-ba34-98ba941da0d1",
                                "sense_id": "a9055bd9-3633-31c3-a585-a0f3bd4ac408",
                                "text": "Considérer un problème sous ses aspects socio- et politico-économiques. La tmèse, c’est le fait de ne pas dire « économiques » après « socio- ». On met alors le trait d’union pour indiquer cette absence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f2123b5-5ac2-43c4-9668-14040855d35c",
                        "source_entry_id": "0d725457-982a-3cce-8c74-562e4813b301",
                        "source_sense_id": "a9055bd9-3633-31c3-a585-a0f3bd4ac408",
                        "target_lang_word": "Tmesis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tmesis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5eb98274-a152-316f-8a8e-0a099a2b0753",
                                        "entry_id": "27e7f3fc-b53d-3d7d-b2c8-4b2bd5e8115d",
                                        "glosses": [
                                            "rhetorische Figur der Trennung zusammengehöriger Teile eines Wortes durch Einschub anderer Wörter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "978a86bc-54b6-47f8-8064-d5caab4a1051",
                                                "sense_id": "5eb98274-a152-316f-8a8e-0a099a2b0753",
                                                "text": "„Die Tmesis tritt vorrangig bei Verbalkonstruktionen auf und wird oftmals - zumal in der Umgangssprache - nicht als ungewöhnlich empfunden, so etwa bei »Wo gehst du hin?« ‚Wohin gehst du?‘ oder »Da habe ich keine Lust zu« ‚Dazu habe ich keine Lust‘.“"
                                            },
                                            {
                                                "example_id": "40948d5c-c1b9-451a-bc5e-aba01e116320",
                                                "sense_id": "5eb98274-a152-316f-8a8e-0a099a2b0753",
                                                "text": "Bei Partikelverben wie „ankommen“ oder „zuordnen“ tritt die Tmesis im Deutschen bei Zweitstellung des Verbstamms regelhaft auf: „kommt … an“, „ordnet … zu“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
