                                        "entry_id": "f0273c00-de9b-3239-9ab6-f751e5081f1a",
                                        "glosses": [
                                            "in der jetzigen mangelhaften Form/Art nicht gültig/gerechtfertigt/erträglich"
                                        ],
                                        "tags": [],
