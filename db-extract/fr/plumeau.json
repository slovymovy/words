                "senses": [
                    {
                        "sense_id": "c5b7327c-e9e4-3259-a539-2c993934b482",
                        "entry_id": "205965f2-596f-3af7-a029-404372a66e00",
                        "glosses": [
                            "метёлка из перьев; пучок перьев"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36d802b0-eefd-4a73-812a-5b084225f539",
                                "sense_id": "c5b7327c-e9e4-3259-a539-2c993934b482",
                                "text": "Jamais il ne fallait battre les habits ni les meubles de peur de les user, mais les housser légèrement avec un plumeau."
                            }
                        ]
                    }
                ],
