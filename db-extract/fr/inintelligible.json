        "fr-extract.jsonl": [
            {
                "entry_id": "fd0791c0-bc12-3d98-98cf-a54a914b33b5",
                "word": "inintelligible",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3f957cbf-ab82-409e-94dd-6510afb891ac",
                        "entry_id": "fd0791c0-bc12-3d98-98cf-a54a914b33b5",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "inintelligibles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c5e8c2d0-5f45-30c6-a1ea-048000362e84",
                        "entry_id": "fd0791c0-bc12-3d98-98cf-a54a914b33b5",
                        "glosses": [
                            "Qui n’est pas intelligible, qu’on ne peut comprendre par l’intelligence ou l’ouïe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1035a7ba-6fde-445b-ac9c-dd055c35a75a",
                                "sense_id": "c5e8c2d0-5f45-30c6-a1ea-048000362e84",
                                "text": "[…] ainsi s’enroulent, pour ainsi dire, comme le fil sur le fuseau, tous ces commentaires ingénieux d’un texte inintelligible."
                            },
                            {
                                "example_id": "816e08de-3e54-4584-bce6-bf2cc6d3fd15",
                                "sense_id": "c5e8c2d0-5f45-30c6-a1ea-048000362e84",
                                "text": "Il me salua gauchement, et prononça, en moldave, quelques paroles qui restèrent inintelligibles pour moi."
                            },
                            {
                                "example_id": "b3ebd11a-b5c7-493d-ae5c-3665b8a04985",
                                "sense_id": "c5e8c2d0-5f45-30c6-a1ea-048000362e84",
                                "text": "Le charlatanisme des saints-simoniens fut aussi dégoûtant que celui de Murat; d’ailleurs l’histoire de cette école est inintelligible quand on ne la rapproche pas des modèles napoléoniens."
                            },
                            {
                                "example_id": "c57a90de-04dd-4a32-9f66-60c488e8d4d7",
                                "sense_id": "c5e8c2d0-5f45-30c6-a1ea-048000362e84",
                                "text": "C’est afin d’améliorer l’orthographe des écoliers qu’on se propose de rendre inintelligible pour eux tout ce qui a été imprimé jusqu’à cette époque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf412f4a-9930-41eb-821f-de0cf8750a7f",
                        "source_entry_id": "fd0791c0-bc12-3d98-98cf-a54a914b33b5",
                        "source_sense_id": "c5e8c2d0-5f45-30c6-a1ea-048000362e84",
                        "target_lang_word": "unverständlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverständlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29587c54-d542-33be-ad45-94e5cd7cf99a",
                                        "entry_id": "a20ac0e0-4da3-365b-9220-4216e16b9cd1",
                                        "glosses": [
                                            "so, dass etwas akustisch nicht verstanden werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca0c0b52-6365-4290-be5b-b9766d5cc083",
                                                "sense_id": "29587c54-d542-33be-ad45-94e5cd7cf99a",
                                                "text": "Er sollte etwas deutlicher sprechen, ich höre nur unverständliches Gemurmel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e94a0c0-ff8c-3877-909c-47c6e5021ef5",
                                        "entry_id": "a20ac0e0-4da3-365b-9220-4216e16b9cd1",
                                        "glosses": [
                                            "so, dass etwas intellektuell nicht nachvollzogen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbbd4957-b1f6-4036-8452-cae40c6f8c19",
                                                "sense_id": "4e94a0c0-ff8c-3877-909c-47c6e5021ef5",
                                                "text": "Diese Bedienungsanleitung ist für meine Begriffe einfach unverständlich."
                                            },
                                            {
                                                "example_id": "e1f0d61c-b6d1-49a0-8871-de540e374719",
                                                "sense_id": "4e94a0c0-ff8c-3877-909c-47c6e5021ef5",
                                                "text": "„Für die durch die britische Bildung geprägten Inder war diese Kritik unverständlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e1d4833-93bc-4222-a4ab-a4a05176d9b9",
                        "source_entry_id": "fd0791c0-bc12-3d98-98cf-a54a914b33b5",
                        "source_sense_id": "c5e8c2d0-5f45-30c6-a1ea-048000362e84",
                        "target_lang_word": "unintelligible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unintelligible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d9386c3-37dd-3321-b23c-bcf859e65e02",
                                        "entry_id": "11bd7bc4-b766-390d-b734-8c9b0d361274",
                                        "glosses": [
                                            "Not intelligible; unable to be understood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "334963e1-c315-4a9c-b657-7a3ca9bfa2ce",
                                                "sense_id": "7d9386c3-37dd-3321-b23c-bcf859e65e02",
                                                "text": "And indeed, my lord, there are so many passages in your writing in this controversy with me, which for their construction, as well as otherwise, are so unintelligible to me, that if I should be so unmannerly as to measure your understanding by mine, I should not know what to think of them."
                                            },
                                            {
                                                "example_id": "5d2b3fb0-b6cb-4aef-b543-0d6f6f2ec04e",
                                                "sense_id": "7d9386c3-37dd-3321-b23c-bcf859e65e02",
                                                "text": "They have ſwallowed and digeſted all the Fathers, the Codes, Provincials, Decretals, Pandects, Councils, Canons ; are Maſters of all the Schoolmen, not to fill their Heads and ſtuff their Writings with Quiddities and Quoddities, and far-fetched unintelligible Diſtinctions, but to be able to reaſon cloſely, to argue ſolidly, to rebuke, to confute, to reply, to rejoind, to ſyllogize, to criticize, to apologize, to advertize, to ſermonize, to decypherize, to――"
                                            },
                                            {
                                                "example_id": "eaf7bb16-b92f-499a-991b-9b51e2f3718d",
                                                "sense_id": "7d9386c3-37dd-3321-b23c-bcf859e65e02",
                                                "text": "The curious feature of the art was that \"horse-whisperers\" actually talked to the animal, usually from mouth to ear, in an unintelligible tongue; which, however, the horses appeared to understand."
                                            },
                                            {
                                                "example_id": "9f3c164e-cf8c-47cb-880f-0cfaccd37b7f",
                                                "sense_id": "7d9386c3-37dd-3321-b23c-bcf859e65e02",
                                                "text": "Unintelligible announcements on station loudspeakers are both irritating and confusing."
                                            },
                                            {
                                                "example_id": "90daa00e-23ad-4e72-a1d6-5e5d955717ec",
                                                "sense_id": "7d9386c3-37dd-3321-b23c-bcf859e65e02",
                                                "text": "Lately, a study was made of oracle-bone inscriptions excavated in 1899 in the T'ang-yin county, 湯陰縣, of Honan Province and amounting to several thousand pieces, having unintelligible inscriptions whose dates nobody could determine.",
                                                "translation": "清代學術概論",
                                                "english": "清代學術概論"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
