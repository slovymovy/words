                "senses": [
                    {
                        "sense_id": "498a1179-1977-3110-979d-feb832a10b27",
                        "entry_id": "983c8ab6-fee3-3a08-8e6a-9c8205787b99",
                        "glosses": [
                            "Opération consistant à créer une atmosphère ou un environnement chimiquement inerte afin de prévenir les risques de corrosion, d’inflammation ou d’explosion."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "e8c77727-10db-4bb1-8059-028f0c2b67c3",
                                "sense_id": "498a1179-1977-3110-979d-feb832a10b27",
                                "text": "Cependant, cet inertage ne résout pas le troisième problème courant lié au stockage du soufre liquide et qui est dû à la formation de sulfures de fer."
                            },
                            {
                                "example_id": "e568dba8-d22d-46a7-a4f4-c830285eceb1",
                                "sense_id": "498a1179-1977-3110-979d-feb832a10b27",
                                "text": "Issue des techniques développées pour le stockage des déchets radioactifs de haute activité, cette méthode de solidification et \"d’inertage\" par emprisonnement des substances potentiellement toxique peut être considérée à court et moyen terme (plusieurs centaines d’années) comme très efficace."
                            },
                            {
                                "example_id": "b70f074b-5e3a-4ec4-bd88-fffeb8a11363",
                                "sense_id": "498a1179-1977-3110-979d-feb832a10b27",
                                "text": "L’inertage à l’azote peut durer jusqu’à une journée, sans compter le temps nécessaire au désilage, le fait de vider un silo."
                            }
                        ]
                    },
                    {
                        "sense_id": "f630fcfb-ebfb-30be-ae00-acbdfbdeeb48",
                        "entry_id": "983c8ab6-fee3-3a08-8e6a-9c8205787b99",
                        "glosses": [
                            "Résultat de cette action."
                        ],
