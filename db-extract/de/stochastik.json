                        "entry_id": "141ab2f4-b3fd-36d0-a3a5-e3a9c940ae7a",
                        "glosses": [
                            "Lehre von Zufall, Häufigkeit, Wahrscheinlichkeit und Daten, ein Teilgebiet der Mathematik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f5e1a1f-b7c0-4353-a65c-84fa7f230d43",
                                "sense_id": "29964df6-3261-3ff9-8ad4-0afc1fa16ef6",
                                "text": "Die Stochastik ermöglicht es, gültige Schlüsse aus zufallsbestimmten Daten zu ziehen."
                            },
                            {
                                "example_id": "e37e07be-7a3f-49b1-bcbe-ab64492333d5",
                                "sense_id": "29964df6-3261-3ff9-8ad4-0afc1fa16ef6",
                                "text": "„Mathematische Stochastik beschäftigt sich mit der Beschreibung und Untersuchung von Zufallsexperimenten wie zum Beispiel dem Werfen von Reißzwecken oder Würfeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
