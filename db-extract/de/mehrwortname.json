                "senses": [
                    {
                        "sense_id": "116188a8-f893-32c8-9348-bfe42bc314d5",
                        "entry_id": "8b5f7a9a-8b56-3a7c-a3ac-f41c1b34120b",
                        "glosses": [
                            "Name, der aus mehr als nur einem Wort besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe3d4576-c503-4d82-9c50-337ff47f95c9",
                                "sense_id": "116188a8-f893-32c8-9348-bfe42bc314d5",
                                "text": "„Schon hier ist die Einheit des Schriftbildes bei den sogenannten Mehrwortnamen vom Typ Rotes Meer nicht deckungsgleich mit der isolierbaren Einheit.“"
                            },
                            {
                                "example_id": "e1648c8f-5018-4f2f-ad37-176f8fa9f2e9",
                                "sense_id": "116188a8-f893-32c8-9348-bfe42bc314d5",
                                "text": "„Zur ersten Gruppe (vor 1900; insgesamt sechs Belege) zählen Mehrwortnamen, die das Produkt mit Hilfe eines qualifizierenden Elements direkt beschreiben (…).“"
                            },
                            {
                                "example_id": "de37a19c-d6d6-4a3d-8574-f60edcb29a6a",
                                "sense_id": "116188a8-f893-32c8-9348-bfe42bc314d5",
                                "text": "„In vielen, vor allem fachsprachlichen Verbindungen, in denen Substantiv und Attribut in ihrer eigentlichen Bedeutung auftreten, ist die Entscheidung oft sehr schwer, ob eine freie attributive Wortverbindung oder ein Mehrwortname vorliegt.“"
                            },
                            {
                                "example_id": "4fbe367f-9e27-46a5-aa5a-798f1bca501e",
                                "sense_id": "116188a8-f893-32c8-9348-bfe42bc314d5",
                                "text": "„Denn das Pflichtwahlfach wird in «Science in Perspective», in «Wissenschaft im Kontext», kurz: SiP umbenannt; ein handlicherer Mehrwortname.“"
                            },
                            {
                                "example_id": "a754d605-b453-4849-86c8-6147abf8674e",
                                "sense_id": "116188a8-f893-32c8-9348-bfe42bc314d5",
                                "text": "„Anders als BURGER stuft er Mehrwortnamen als referentielle nominative Phraseologismen mit dem Merkmal [+ onymisch] ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
