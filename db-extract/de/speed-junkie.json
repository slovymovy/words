                            {
                                "example_id": "4cbcd6d4-2e98-4823-ab02-c67f9ee6bba7",
                                "sense_id": "934dcf58-8735-39b1-a7b4-798bc8fcf01d",
                                "text": "„In der Gasse hinter der First Methodist Church drängten sich die Speed-Junkies.“"
                            },
                            {
                                "example_id": "a4f86d1f-ded6-40a4-ae29-bd2d20737f2d",
                                "sense_id": "934dcf58-8735-39b1-a7b4-798bc8fcf01d",
                                "text": "„Geneigte Speed-Junkies, sollten eure Eltern ihre Pflicht versäumt haben, euch mit einer breiten Vielfalt von Betäubungsmitteln bekanntzumachen, lasst euch von mir auf die Sprünge helfen.“"
                            }
