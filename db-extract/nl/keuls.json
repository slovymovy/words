                                                "sense_id": "72a0b8c9-ee87-344d-85b1-b296b76f482c",
                                                "text": "Die Tochter bekam einen blau und weiß gewürfelten Bettbezug aus Kölsch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kölsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "18722b32-8db0-38b9-b2aa-ba274d56f1f9",
                                        "entry_id": "061ce06c-2de8-30d0-9732-eb0438f25031",
                                        "glosses": [
