                    "frequency": "Low",
                    "semantic_group_id": "strach",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W jego oczach nie było widać żadnej <w>bojaźni</w>, gdy stawiał czoła niebezpieczeństwu.",
                            "target_lang_translations": {
                                "en": "No <w>fear</w> was visible in his eyes as he confronted the danger."
                            }
                        },
                        {
                            "text": "Działał bez cienia <w>bojaźni</w>, wiedząc, że broni słusznej sprawy.",
                            "target_lang_translations": {
                                "en": "He acted without a shadow of <w>fear</w>, knowing that he was defending a just cause."
                            }
                        }
                    ],
                    "synonyms": [
