                    "sense_definition": "eine gewählte Person oder eine Ernennung in einem Amt formal anerkennen und rechtsgültig machen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "amt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Parlament <w>bestätigte</w> den Minister nach einer kurzen Debatte in seinem Amt."
