                ],
                "senses": [
                    {
                        "sense_id": "5e7aeaed-28ec-3a78-8fe3-37fbc00fca8c",
                        "entry_id": "c8f62ca9-b869-3054-9ecc-320e74bd7885",
                        "glosses": [
                            "Raisonner à la manière de Descartes."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a9cf41cb-3dae-42c6-9c5e-2948c52a96dd",
                                "sense_id": "5e7aeaed-28ec-3a78-8fe3-37fbc00fca8c",
                                "text": "En somme, le plus grand danger que courent les Chinois, c'est de cartésianiser."
                            },
                            {
                                "example_id": "88d2a63e-ed34-416f-877f-6430a178f7e7",
                                "sense_id": "5e7aeaed-28ec-3a78-8fe3-37fbc00fca8c",
                                "text": "Mais ce danger ne fut visible qu'à la fin du siècle, et pendant de longues années, les gens du monde, de robe, d'Église, sans parler des savants de profession, purent cartésianiser à l'aise, sans crainte d'hérésie."
                            }
                        ]
                    },
                    {
                        "sense_id": "2612b8ae-bb73-3375-b658-4013380a9307",
                        "entry_id": "c8f62ca9-b869-3054-9ecc-320e74bd7885",
                        "glosses": [
                            "Faire devenir cartésien."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d46d8801-ca78-4696-937f-de05ced3976b",
                                "sense_id": "2612b8ae-bb73-3375-b658-4013380a9307",
                                "text": "A un point tel que certains spécialistes de Descartes et de Pascal ont parfois voulu « cartésianiser » complètement celui-ci (J. Laporte, G. Rodis-Lewis, etc.)."
                            }
                        ]
                    },
                    {
                        "sense_id": "c97d2e76-292c-3ac6-8b59-f5396b3b7021",
                        "entry_id": "c8f62ca9-b869-3054-9ecc-320e74bd7885",
                        "glosses": [
                            "Devenir cartésien."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "cf3bb95a-5e9f-4143-a3e9-9ac53e3e84d2",
                                "sense_id": "c97d2e76-292c-3ac6-8b59-f5396b3b7021",
                                "text": "D'abord, qu'est-ce qui du Dieu Inconscient le motive à se cartésianiser en chacune des discursivités — l'imaginaire, celle du maître, celle de l'analyse?"
                            }
                        ]
                    }
                ],
