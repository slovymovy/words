{
    "word_family": [
        "staple"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e44a004e-cd46-377d-b9e1-a2797de5b605",
                    "sense_definition": "A device used to bind sheets of paper together by driving a thin metal wire through them and folding the ends.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "office_supplies",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please use the <w>stapler</w> on the desk to keep these documents together.",
                            "target_lang_translations": {
                                "zh": "请用桌上的<w>订书机</w>把这些文件装订在一起。"
                            }
                        },
                        {
                            "text": "I need to refill the <w>stapler</w> because it has run out of staples.",
                            "target_lang_translations": {
                                "zh": "我需要给<w>订书机</w>装订书钉，因为它用完了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "paper fastener"
                    ],
                    "common_phrases": [
                        "office stapler",
                        "refill the stapler"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种通过将细金属丝穿过纸张并折叠末端来将纸张装订在一起的办公设备。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "订书机",
                                "target_lang_sense_clarification": "用于办公装订纸张的常用工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3cff518c-e84f-32f1-afb3-2924420fed6c",
                    "sense_definition": "Any mechanical device used for fastening materials with staples, including heavy-duty tools like staple guns.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The construction worker used a heavy-duty <w>stapler</w> to attach the insulation to the wooden frame.",
                            "target_lang_translations": {
                                "zh": "建筑工人用一把重型<w>钉枪</w>将隔热材料固定在木框架上。"
                            }
                        },
                        {
                            "text": "He bought a pneumatic <w>stapler</w> to make the upholstery work much faster.",
                            "target_lang_translations": {
                                "zh": "他买了一把气动<w>钉枪</w>，以便更快地完成软包工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "staple gun"
                    ],
                    "common_phrases": [
                        "heavy-duty stapler",
                        "pneumatic stapler"
                    ],
                    "target_lang_definitions": {
                        "zh": "任何使用订书钉固定材料的机械装置，包括重型工具如钉枪。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "钉枪",
                                "target_lang_sense_clarification": "用于建筑或工业用途的重型装订工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48f5d97d-f0a7-388e-8b39-f35c0f875462",
                    "sense_definition": "A merchant or dealer who trades in staple goods or commodities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "merchants",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval England, a wealthy wool <w>stapler</w> could exert significant political influence.",
                            "target_lang_translations": {
                                "zh": "在中世纪的英国，一位富有的羊毛<w>商人</w>可以施加重大的政治影响。"
                            }
                        },
                        {
                            "text": "The local museum features an exhibition on the historic merchants and <w>staplers</w> of the town.",
                            "target_lang_translations": {
                                "zh": "当地博物馆举办了一个关于该镇历史上的商人和羊毛<w>贸易商</w>的展览。"
                            }
                        }
                    ],
                    "synonyms": [
                        "merchant",
                        "trader"
                    ],
                    "common_phrases": [
                        "wool stapler"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly used in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "从事大宗商品或主要贸易货物的商人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大宗商品商人",
                                "target_lang_sense_clarification": "历史语境下从事特定主要商品贸易的商人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ad2d62c-2c10-3142-8be8-1b2ce260a89d",
                    "sense_definition": "A person whose job is to sort wool fibers according to their length and quality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wool_industry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The experienced wool <w>stapler</w> carefully examined the fleece to determine its grade.",
                            "target_lang_translations": {
                                "zh": "经验丰富的羊毛<w>分拣工</w>仔细检查了羊毛以确定其等级。"
                            }
                        },
                        {
                            "text": "Before the industrial revolution, the role of a <w>stapler</w> was crucial in textile production.",
                            "target_lang_translations": {
                                "zh": "在工业革命之前，羊毛<w>分拣工</w>的角色在纺织生产中至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wool sorter"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly used in historical contexts of the textile industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "根据羊毛纤维的长度和质量进行分拣的工作人员。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "羊毛分拣工",
                                "target_lang_sense_clarification": "纺织工业中负责按等级分类羊毛的职业"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}