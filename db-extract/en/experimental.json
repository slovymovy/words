                        "cross_references": []
                    },
                    {
                        "translation_id": "81c3b154-7646-4e6b-b182-d7e2234d1921",
                        "source_entry_id": "cbe71f90-0af3-3194-9b39-1d4f35276ee9",
                        "source_sense_description": "of or pertaining to an experiment",
                        "target_lang_word": "expérimental",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expérimental",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad85177-17d5-3900-96af-551304aafd82",
                                        "entry_id": "99b24a12-c830-387a-9664-3de600eeb73e",
                                        "glosses": [
                                            "Qui est fondé sur l’expérience scientifique, l'expérimentation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d693efa1-d71b-46e6-ae3d-aef24e15a75f",
                                                "sense_id": "8ad85177-17d5-3900-96af-551304aafd82",
                                                "text": "La suppression presque complète de l’oxyde de carbone dans la fabrication du gaz à l’eau, au moyen de la vapeur surchauffée est un fait expérimental qui a donné lieu à diverses interprétations sur lesquelles nous appuierons d'une manière spéciale."
                                            },
                                            {
                                                "example_id": "8f517293-a267-4079-822a-4ef33dd10358",
                                                "sense_id": "8ad85177-17d5-3900-96af-551304aafd82",
                                                "text": "Des hommes tels que Galilée ou Carnot, qui possédaient à un degré extraordinaire cette Intelligence des Analogies, ont ainsi créé l’Énergétique par généralisations progressives, prudentes et hardies tout ensemble, de relations expérimentales et de réalités sensibles."
                                            },
                                            {
                                                "example_id": "c83f77f1-e25e-4f9f-8bd9-d64279d502cb",
                                                "sense_id": "8ad85177-17d5-3900-96af-551304aafd82",
                                                "text": "L'héritière médiévale, malgré la fidélité aux sources antiques dont elle se réclame, malgré une connaissance minutieuse des agronomies orientale et byzantine contemporaines, s'avère plus expérimentale et libre de superstitions."
                                            },
                                            {
                                                "example_id": "dc7f3a33-dc0d-4e07-991a-873a0e644de8",
                                                "sense_id": "8ad85177-17d5-3900-96af-551304aafd82",
                                                "text": "Nos résultats expérimentaux montrent que certains de ces ligands présentent un intérêt potentiel pour l’adjuvantation des vaccins polysaccharidiques, chez l'adulte et chez l'enfant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9cd1acd-ad10-3f2a-a26c-ca13181253a5",
                                        "entry_id": "99b24a12-c830-387a-9664-3de600eeb73e",
                                        "glosses": [
                                            "Qui est le fruit d'une expérimentation dont le résultat pourrait s'avérer aléatoire ou marginal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f618fce1-85e6-4e78-84f2-e43a88bddece",
                                                "sense_id": "b9cd1acd-ad10-3f2a-a26c-ca13181253a5",
                                                "text": "Un film « expérimental » pour tout dire (ce qui dans sa bouche résonna comme une injure)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6d5d40e-4a40-4581-847e-415d1ab4390d",
                        "source_entry_id": "cbe71f90-0af3-3194-9b39-1d4f35276ee9",
                        "source_sense_description": "of or pertaining to an experiment",
                        "target_lang_word": "experimentell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "experimentell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aeb11731-2962-3e91-8d9f-944f6bb18430",
                                        "entry_id": "74e63f65-5a83-32ca-b2cf-8103e37c762f",
                                        "glosses": [
                                            "auf (wissenschaftlichen) Versuchen basierend; mithilfe von (wissenschaftlichen) Versuchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfd8b3b1-f74d-4d41-ba52-739d553dc99a",
                                                "sense_id": "aeb11731-2962-3e91-8d9f-944f6bb18430",
                                                "text": "„Auch die experimentelle Wirtschaftsforschung rüttelt an den Grundfesten der wirtschaftswissenschaftlichen Modelle, und die Neuroökonomen wollen den Menschen ebenfalls abbilden, wie er wirklich ist - nicht, wie er den Annahmen gemäß sein müsste.“"
                                            },
                                            {
                                                "example_id": "a041ad7c-7140-44c9-a7ef-dd73f68c4d61",
                                                "sense_id": "aeb11731-2962-3e91-8d9f-944f6bb18430",
                                                "text": "„Apex ist ein experimentelles Teleskop, das bereits erste wissenschaftliche Erkenntnisse liefert - etwa über ein neues Molekül im All.“"
                                            },
                                            {
                                                "example_id": "5ba4026d-df35-42f9-bed6-98d2bbc922ee",
                                                "sense_id": "aeb11731-2962-3e91-8d9f-944f6bb18430",
                                                "text": "„Die junge Mexikanerin forscht zurzeit in Wien, einem der weltweit führenden Zentren der experimentellen Quantenphysik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e80b8c8-5c26-300b-80c1-0701bffeb2f5",
                                        "entry_id": "74e63f65-5a83-32ca-b2cf-8103e37c762f",
                                        "glosses": [
                                            "durch besondere neuartige Merkmale geprägt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9185f871-4662-42cc-b8c9-f164289340cb",
                                                "sense_id": "9e80b8c8-5c26-300b-80c1-0701bffeb2f5",
                                                "text": "„Der Professor für experimentelle Musik, Theologe und Autor starb am Sonntag im Alter von 88 Jahren.“"
                                            },
                                            {
                                                "example_id": "011f5c2e-3f42-42cc-9b2e-f11b613ba082",
                                                "sense_id": "9e80b8c8-5c26-300b-80c1-0701bffeb2f5",
                                                "text": "„Die experimentelle Popgruppe Pram erschafft Soundtracks zu B-Movies, die es nicht gibt – in einer ebenso beklemmenden wie fidelen Melange aus Jazz, Post-Punk und Krautrock.“"
                                            },
                                            {
                                                "example_id": "f88ac132-f442-47b9-8772-76cac92de58f",
                                                "sense_id": "9e80b8c8-5c26-300b-80c1-0701bffeb2f5",
                                                "text": "„Die aktuell erfolgreichste österreichische Band Bilderbuch, die mit ihrem künstlerischen Universalansatz und experimentellem Indie-Pop seit Jahren die deutschsprachige Musikwelt aufmischt, wählte diese besondere Gitarre nicht nur als Cover ihrer Single ‚Dates‘, sondern machte sie auch zum Sinnbild ihres musikalischen Universums.“"
                                            },
                                            {
                                                "example_id": "3d2362c5-980b-4e23-979f-fac5aa6dff32",
                                                "sense_id": "9e80b8c8-5c26-300b-80c1-0701bffeb2f5",
                                                "text": "„Danach haben auch die arabischen Schriftsteller experimentellere und radikalere Wege genommen, auf denen ihnen Machfus nicht mehr zu folgen bereit war.“"
                                            },
                                            {
                                                "example_id": "78e18839-d303-45a3-bb78-ed1c3be24be7",
                                                "sense_id": "9e80b8c8-5c26-300b-80c1-0701bffeb2f5",
                                                "text": "„Alain Resnais war der intellektuellste und experimentellste unter den großen französischen Regisseuren im Umfeld der ‚Nouvelle Vague‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
