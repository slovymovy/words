            "senses": [
                {
                    "sense_id": "39aeb404-dbc2-3cf2-996c-cab454551fe9",
                    "sense_definition": "Sert à exprimer l'admiration, l'étonnement ou une vive surprise.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ouah</w>, ce gâteau au chocolat a l'air vraiment délicieux !",
                            "target_lang_translations": {
                                "en": "<w>Wow</w>, this chocolate cake looks really delicious!",
                                "ru": "<w>Ого</w>, этот шоколадный торт выглядит очень вкусным!",
                                "de": "<w>Ui</w>, dieser Schokoladenkuchen sieht wirklich köstlich aus!",
                                "es": "¡<w>Guau</w>, este pastel de chocolate tiene una pinta buenísima!",
                                "zh": "<w>哇</w>，这块巧克力蛋糕看起来真好吃！"
                            }
                        },
                        {
                            "text": "Elle a regardé le paysage depuis le sommet et a dit : <w>ouah</w>, c'est magnifique !",
                            "target_lang_translations": {
                                "en": "She looked at the view from the summit and said, <w>wow</w>, it's gorgeous!",
                                "ru": "Она посмотрела на пейзаж с вершины и сказала: «<w>Ого</w>, как же великолепно!»",
                                "de": "Vom Gipfel aus betrachtete sie die Landschaft und sagte: „<w>Wow</w>, das ist wunderschön!“",
                                "es": "Desde la cima, ella contempló el paisaje y dijo: «¡<w>Guau</w>, es magnífico!»",
                                "zh": "她从山顶望着风景，说：<w>哇</w>，太美了！"
                            }
                        }
                    ],
                    "synonyms": [
                        "waouh",
                        "oh"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express admiration, astonishment or strong surprise.",
                        "ru": "Выражает восхищение, изумление или сильное удивление.",
                        "de": "Drückt Bewunderung, Staunen oder heftige Überraschung aus.",
                        "es": "Expresa admiración, asombro o una fuerte sorpresa.",
                        "zh": "用于表达赞叹、惊讶或强烈的惊异之情。"
                    },
