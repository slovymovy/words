{
    "word_family": [
        "rebuker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "326db9cc-51a1-3ac3-b827-bad1463675a2",
                    "sense_definition": "A harsh expression of disapproval or criticism.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager issued a sharp <w>rebuke</w> to the team for missing the deadline.",
                            "target_lang_translations": {
                                "ru": "Менеджер сделал команде резкий <w>вы́говор</w> за срыв сроков."
                            }
                        },
                        {
                            "text": "She faced a public <w>rebuke</w> after her controversial comments were published.",
                            "target_lang_translations": {
                                "ru": "Она столкнулась с публичным <w>порицанием</w> после публикации её спорных комментариев."
                            }
                        }
                    ],
                    "synonyms": [
                        "reprimand",
                        "reproach",
                        "admonition"
                    ],
                    "common_phrases": [
                        "sharp rebuke",
                        "public rebuke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкое выражение неодобрения или критики."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вы́говор",
                                "target_lang_sense_clarification": "официальное или строгое порицание за проступок"
                            },
                            {
                                "target_lang_word": "упрёк",
                                "target_lang_sense_clarification": "выражение недовольства или неодобрения чьим-либо поведением"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3daaaf7d-cae5-3236-b6b0-027d2e58743e",
                    "sense_definition": "To express sharp disapproval or criticism of someone's actions.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher had to <w>rebuke</w> the students for talking during the exam.",
                            "target_lang_translations": {
                                "ru": "Учителю пришлось <w>отчита́ть</w> учеников за разговоры во время экзамена."
                            }
                        },
                        {
                            "text": "He was <w>rebuked</w> by his supervisor for failing to follow safety protocols.",
                            "target_lang_translations": {
                                "ru": "Начальник <w>отчита́л</w> его за несоблюдение правил техники безопасности."
                            }
                        }
                    ],
                    "synonyms": [
                        "reprimand",
                        "reproach",
                        "reprove",
                        "chastise",
                        "scold"
                    ],
                    "common_phrases": [
                        "sternly rebuke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать резкое неодобрение или критику чьих-либо действий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отчита́ть",
                                "target_lang_sense_clarification": "сделать строгий выговор, отругать (совершенный вид)"
                            },
                            {
                                "target_lang_word": "упрека́ть",
                                "target_lang_sense_clarification": "выражать кому-либо неодобрение или недовольство"
                            },
                            {
                                "target_lang_word": "руга́ть",
                                "target_lang_sense_clarification": "высказывать неодобрение в резком тоне"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}