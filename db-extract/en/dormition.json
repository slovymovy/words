                        "entry_id": "ca43a150-2294-37d9-82be-e888075000d7",
                        "glosses": [
                            "The death and assumption into heaven of the Virgin Mary."
                        ],
                        "tags": [
                            "capitalized",
                            "countable",
                            "often",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "87b21679-a48e-444b-82e6-d5c9eb193d8d",
                                "sense_id": "08be88d2-ea62-37dd-80d9-3f1e035e8ace",
                                "text": "The Virgin had allegedly given away her robe just before her death – what is in Eastern tradition called her Dormition, or falling asleep."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e44e242-e850-416e-b73b-660c8a11f9ad",
