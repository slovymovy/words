                "senses": [
                    {
                        "sense_id": "798cea4d-3141-3b11-91f4-35e9dd6e4606",
                        "entry_id": "eb8dd581-1635-3f27-a948-264a4f23e403",
                        "glosses": [
                            "Polymer des Ethylen; ein Kunststoff"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "fd9a6ad6-ae13-4555-b039-6ecef4752689",
                                "sense_id": "798cea4d-3141-3b11-91f4-35e9dd6e4606",
                                "text": "Polyethylen ist einer der weitverbreitetsten Kunststoffe."
                            },
                            {
                                "example_id": "19bbd5b5-faff-4631-af11-40fc8e30aabb",
                                "sense_id": "798cea4d-3141-3b11-91f4-35e9dd6e4606",
                                "text": "Gegenüber den meisten chemischen Flüssigkeiten ist Polyethylen inert oder resistent. Daher können viele flüssige Chemikalien in Flaschen oder Kanistern aus Polyethylen aufbewahrt werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ba2441b-c423-46c0-a867-a1f237a7a829",
                        "source_entry_id": "eb8dd581-1635-3f27-a948-264a4f23e403",
                        "source_sense_id": "798cea4d-3141-3b11-91f4-35e9dd6e4606",
                        "source_sense_description": "Chemie, fachsprachlich: Polymer des Ethylen; ein Kunststoff",
                        "target_lang_word": "polyethylene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polyethylene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21ccf02f-68c3-3b0c-8cb9-d3e05c8da2b1",
                                        "entry_id": "e8459bee-01a0-391f-a38c-2595328c8ce3",
                                        "glosses": [
                                            "A polymer consisting of many ethylene monomers bonded together; used for kitchenware, containers etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a7c9775-a30b-4f5d-a093-5ee040a286cf",
                                                "sense_id": "21ccf02f-68c3-3b0c-8cb9-d3e05c8da2b1",
                                                "text": "For eons, the debris has contained the same things — flecks from plant and animal carcasses, feces, mucus, dust, microbes, viruses — and transported the ocean’s carbon to be stored on the seafloor. Increasingly, however, marine snowfall is being infiltrated by microplastics: fibers and fragments of polyamide, polyethylene and polyethylene terephthalate. And this fauxfall appears to be altering our planet’s ancient cooling process."
                                            },
                                            {
                                                "example_id": "179fa17f-46c9-4326-8f70-3a7d5eabc19d",
                                                "sense_id": "21ccf02f-68c3-3b0c-8cb9-d3e05c8da2b1",
                                                "text": "The most abundant chemical in the plastics is polyethylene, which is used for single-use packaging, plastic bags and containers such as bottles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffa3f4db-feaa-46fb-8f19-b001809d7cab",
                        "source_entry_id": "eb8dd581-1635-3f27-a948-264a4f23e403",
                        "source_sense_id": "798cea4d-3141-3b11-91f4-35e9dd6e4606",
