                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ba0ff933-e4a9-4a0d-bb04-408165495f08",
                        "entry_id": "82280809-1fb5-309d-b58d-a8acb7583354",
                        "tags": [
                            "plural"
                        ],
                        "form": "waterdampen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5408e53d-6e71-33bf-87dd-0dc24a9f7ec2",
                        "entry_id": "82280809-1fb5-309d-b58d-a8acb7583354",
                        "glosses": [
                            "water in gasvorm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e601141d-5a33-45b1-ae8d-bf3f134674a9",
                                "sense_id": "5408e53d-6e71-33bf-87dd-0dc24a9f7ec2",
                                "text": "Klimaatverandering veroorzaakt een algehele temperatuurstijging over de hele wereld. Door de opwarming van het klimaat wordt de lucht warmer. Warme lucht kan meer waterdamp bevatten, zo'n 7 procent meer per graad. Als er meer waterdamp is in de atmosfeer, kunnen er meer extreme weersituaties ontstaan, zoals hagelbuien, wateroverlast door extreme regenval en meer onweer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b25f277-1d9b-4a64-880a-444d94fb167d",
                        "source_entry_id": "82280809-1fb5-309d-b58d-a8acb7583354",
                        "source_sense_id": "5408e53d-6e71-33bf-87dd-0dc24a9f7ec2",
                        "target_lang_word": "Dampf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dampf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3dd577ef-953c-3b77-b0a9-d7061a4e7b6b",
                                        "entry_id": "b251a823-3567-3971-8117-7930ca4efe79",
                                        "glosses": [
                                            "Gas, das meist noch in Kontakt mit der flüssigen beziehungsweise festen Phase steht, aus der es hervorgegangen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dc2dbc1-184b-4e0e-bf72-0b620c40dc93",
                                                "sense_id": "3dd577ef-953c-3b77-b0a9-d7061a4e7b6b",
                                                "text": "Der Dampf des Wassers wird oft zur Stromerzeugung verwendet."
                                            },
                                            {
                                                "example_id": "57679ea0-bc1f-499a-91dd-5e0268c4e11f",
                                                "sense_id": "3dd577ef-953c-3b77-b0a9-d7061a4e7b6b",
                                                "text": "„Der Dampf stieg aus dem Becken auf.“"
                                            },
                                            {
                                                "example_id": "930d361d-99f9-4929-853d-8c115147c21e",
                                                "sense_id": "3dd577ef-953c-3b77-b0a9-d7061a4e7b6b",
                                                "text": "„Es war eine Welt des Schweigens, starr und nackt; dann wiegten sich hochstämmige Pflanzen in einem Nebel, der dem Dampf einer Badestube glich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3165f718-b42a-38b3-8607-69873a05b625",
                                        "entry_id": "b251a823-3567-3971-8117-7930ca4efe79",
                                        "glosses": [
                                            "Ansammlung feinverteilter Flüssigkeitstropfen in einem Gas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4392a5d-3399-4994-90fe-909b5a635a27",
                                                "sense_id": "3165f718-b42a-38b3-8607-69873a05b625",
                                                "text": "„Der Dampf des Liquids erzeugt ein sensorisches Erlebnis, welches dem Empfinden der Inhalation von Zigarettenrauch entsprechen soll, und transportiert dabei Nikotin und andere im Liquid enthaltene Stoffe, welche vom Konsumenten direkt aufgenommen werden.“"
                                            },
                                            {
                                                "example_id": "1e154510-89e7-4d49-998f-c1ba140b08b1",
                                                "sense_id": "3165f718-b42a-38b3-8607-69873a05b625",
                                                "text": "„Einige Male zischte der Dampf noch wie rasend herüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e6bcf578-2938-3ee7-a70a-798f10acd562",
                                        "entry_id": "b251a823-3567-3971-8117-7930ca4efe79",
                                        "glosses": [
                                            "große Anstrengung"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecb39b35-0dd0-48ff-80ed-244a97812a95",
                        "source_entry_id": "82280809-1fb5-309d-b58d-a8acb7583354",
                        "source_sense_id": "5408e53d-6e71-33bf-87dd-0dc24a9f7ec2",
                        "target_lang_word": "Wasserdampf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserdampf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4e19c1db-01f9-3f18-ac34-84a9414ffacc",
                                        "entry_id": "4f4e40b8-61cb-3e26-baa2-b0298a1da655",
                                        "glosses": [
                                            "Wasser in gasförmiger Form"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efa90d2b-e829-4dbd-8656-1ffd394d14f3",
                                                "sense_id": "4e19c1db-01f9-3f18-ac34-84a9414ffacc",
                                                "text": "Die Temperatur des Wasserdampfs ist druckabhängig."
                                            },
                                            {
                                                "example_id": "bb1917f1-6e0d-48be-ad2a-c48900c01074",
                                                "sense_id": "4e19c1db-01f9-3f18-ac34-84a9414ffacc",
                                                "text": "„Eine alte Dampflok zieht etwa fünf Minuten vor Abfahrt die Waggons langsam in die Bahnhofshalle, speit Rauch und Wasserdampf in die Kuppel des Bahnhofs.“"
                                            },
                                            {
                                                "example_id": "2e88ac1f-e818-48bc-9fdc-3d2a5987f177",
                                                "sense_id": "4e19c1db-01f9-3f18-ac34-84a9414ffacc",
                                                "text": "„Die Sonne war heiß, und es roch nach Wasserdampf und Auspuffgasen.“"
                                            },
                                            {
                                                "example_id": "5cf7f8e7-e812-4196-bcff-7e86b0a422f9",
                                                "sense_id": "4e19c1db-01f9-3f18-ac34-84a9414ffacc",
                                                "text": "„Und Lampe rettet die Scherbe, die unbeschädigt ist, allerdings wird bei dieser Aktion Lampes linker Arm vom heißen Wasserdampf leicht verbrüht.“"
                                            },
                                            {
                                                "example_id": "b9a11ddd-9e7a-447a-a4d2-c56645ac6733",
                                                "sense_id": "4e19c1db-01f9-3f18-ac34-84a9414ffacc",
                                                "text": "„Wasserstoff ist ein umweltfreundlicher Energieträger. Bei seiner Verbrennung entstehen keine schädlichen Abgase, sondern nur Wasserdampf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
