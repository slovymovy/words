                                    {
                                        "sense_id": "e4407291-ff0f-37f9-b042-1e491494e435",
                                        "entry_id": "a4c47474-7e09-3d4d-ac67-f125522e16a6",
                                        "glosses": [
                                            "in Bezug auf den Luftaustausch von Tieren oder Menschen zur Lebenserhaltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd3d17b3-ea5f-4753-8dbc-90e7f17dbff1",
                                                "sense_id": "e4407291-ff0f-37f9-b042-1e491494e435",
                                                "text": "„Bei der hierorts durchgeführten persönlichen Begutachtung war die [Beschwerdeführerin] kardial und respiratorisch kompensiert, sowie in gutem Allgemein- und Ernährungszustand.“"
                                            },
                                            {
                                                "example_id": "d62eb81e-333e-494e-a31f-770dc2d1015f",
                                                "sense_id": "e4407291-ff0f-37f9-b042-1e491494e435",
                                                "text": "„Die Wissenschaftler wissen trotz enormer Forschungsleistungen noch immer zuwenig über das akute respiratorische Syndrom und seinen Erreger.“"
                                            },
                                            {
                                                "example_id": "8c8a2420-426a-49ad-a0c1-e77a5d349f9b",
                                                "sense_id": "e4407291-ff0f-37f9-b042-1e491494e435",
                                                "text": "„Tatsächlich nehmen respiratorische Epidemien unter Gorillas und Schimpansen in den Schutzgebieten zu, seit die Zahl der Ökotouristen steigt; sie rangieren neben den Wunden durch Kämpfe oder Verletzungen durch Schlingen von Wilderern weit oben auf der Liste der beobachteten Krankheitssymptome.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a5db38b-7031-4cab-90a7-21da68e02c21",
                        "source_entry_id": "a50c9198-a222-3d7a-bc8b-1fdb5790118b",
