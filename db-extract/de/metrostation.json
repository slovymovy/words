                            {
                                "example_id": "7ecd4d12-22c8-4030-9941-c3c39e929cf9",
                                "sense_id": "e84d9838-0ec7-3d49-91ce-4d1be2d5f1ff",
                                "text": "„Dort, wo das berühmte Schwimmbad Moskau neben der Metrostation Kropotkinskaja stand - benannt zu Ehren des Überväterchens der russischen Anarchie - war zuvor ebenfalls eine Kirche gewesen.“"
                            },
                            {
                                "example_id": "0d3c1db3-7d91-49a9-8f12-8d81fb32e2a6",
                                "sense_id": "e84d9838-0ec7-3d49-91ce-4d1be2d5f1ff",
                                "text": "„Der Astrologe sang und trommelte in einer Metrostation.“"
                            }
                        ],
