                        "source_entry_id": "8236099d-6955-3658-8a04-0bf9caf227e1",
                        "source_sense_id": "5e6ac7da-16dd-3272-8c61-63f496be6198",
                        "source_sense_description": "Qui porte à l’excès les témoignages de respect",
                        "target_lang_word": "fawning",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fawning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9964afbe-cfa9-351c-b2be-9fe83996141d",
                                        "entry_id": "0f2d26a8-2c01-3e6e-bf87-4de293224295",
                                        "glosses": [
                                            "present participle and gerund of fawn"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcd7eaac-3a98-499a-af84-8afa1e578918",
                                                "sense_id": "9964afbe-cfa9-351c-b2be-9fe83996141d",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fawning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b647fb80-1d2e-37f7-924f-041b2eac6911",
                                        "entry_id": "dbdc3256-b66b-3c31-ad7e-057c53c879e6",
                                        "glosses": [
                                            "Seeking favor by way of flattery; flattering, servile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99f2bfab-0da9-4909-94ad-8edf4a2e57bf",
                                                "sense_id": "b647fb80-1d2e-37f7-924f-041b2eac6911",
                                                "text": "Shylock: How like a fawning publican he looks ![…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fawning",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f32cdd9-da93-34bd-a980-bbb3033fdac4",
                                        "entry_id": "a320d586-8e43-3a8c-ae6c-8689f356df00",
                                        "glosses": [
                                            "Servile flattery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48dfda1a-0d12-414d-a01e-176eea4e069c",
                                                "sense_id": "1f32cdd9-da93-34bd-a980-bbb3033fdac4",
                                                "text": "Hamlet: No, let the candied tongue lick absurd pomp,\nAnd crook the pregnant hinges of the knee\nWhere thrift may follow fawning."
                                            },
                                            {
                                                "example_id": "08108ab4-ffdd-4396-81b5-00a34e825528",
                                                "sense_id": "1f32cdd9-da93-34bd-a980-bbb3033fdac4",
                                                "text": "Xantippus found his ruin ere it reached him,\nLurking behind your honours and rewards;\nFound it in your feigned courtesies and fawnings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1092671a-8bde-4cb2-bf9e-09915db48c68",
                        "source_entry_id": "8236099d-6955-3658-8a04-0bf9caf227e1",
                        "source_sense_id": "5e6ac7da-16dd-3272-8c61-63f496be6198",
                        "source_sense_description": "Qui porte à l’excès les témoignages de respect",
                        "target_lang_word": "obsequious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obsequious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4e28e6b-324c-3565-8dfb-477bce303348",
                                        "entry_id": "882e3b58-f445-3d41-97f1-dffda772746d",
                                        "glosses": [
                                            "Excessively eager and attentive to please or to obey instructions; fawning, subservient, servile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2ae36b4-d9b1-4d19-9152-132ddb7a1f7a",
                                                "sense_id": "c4e28e6b-324c-3565-8dfb-477bce303348",
                                                "text": "[S]he complained pettishly of the heat and the flies and at length of the walk, and reduced Robert to the antics of an obsequious dog."
                                            },
                                            {
                                                "example_id": "ee160842-eab4-4824-a327-7d34abc50b5c",
                                                "sense_id": "c4e28e6b-324c-3565-8dfb-477bce303348",
                                                "text": "Personally I felt shy and uncomfortable at this obsequious adoration, and I read the same feeling in the faces of Lord John and Summerlee, but Challenger expanded like a flower in the sun."
                                            },
                                            {
                                                "example_id": "b937c1a1-a58d-4c13-b13c-5972a7ea7762",
                                                "sense_id": "c4e28e6b-324c-3565-8dfb-477bce303348",
                                                "text": "Translation falls especially short of this conceit which carries the whole flamboyance of the Spanish language. It was intended as an obsequious flattery of the Condesa, and was untrue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a352d4e-739b-36cd-ba5f-1483c1053d73",
                                        "entry_id": "882e3b58-f445-3d41-97f1-dffda772746d",
                                        "glosses": [
                                            "Obedient; compliant with someone else's orders or wishes."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74c0b81a-0ce4-4c2c-8ebd-dc322451b5c5",
                                                "sense_id": "4a352d4e-739b-36cd-ba5f-1483c1053d73",
                                                "text": "Our ladies were situated as well as it was possible; they had good servants, splendid rooms, obsequious attendants, and had become habituated to the country, so that the loss of the Count was not any thing of moment beyond the pleasure of his society;[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a7cde0-a3d9-3d8b-af06-7f4187b704ca",
                                        "entry_id": "882e3b58-f445-3d41-97f1-dffda772746d",
                                        "glosses": [
                                            "Of or pertaining to obsequies, funereal."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8439cb5c-ccdf-46cc-93de-651f72aa3b55",
                                                "sense_id": "41a7cde0-a3d9-3d8b-af06-7f4187b704ca",
                                                "text": "[…] the ſuruiuer bound / In filliall obligation for ſome tearme\n To doe obſequious ſorrowe […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29b075dc-2a38-4c30-9209-27430fc28239",
                        "source_entry_id": "8236099d-6955-3658-8a04-0bf9caf227e1",
