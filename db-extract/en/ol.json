                "senses": [
                    {
                        "sense_id": "63442588-c16b-3661-a5e7-d6a689398d65",
                        "entry_id": "4d526eff-1675-364f-910f-f090e02c679a",
                        "glosses": [
                            "(attributive)"
                        ],
                        "tags": [
                            "attributive",
