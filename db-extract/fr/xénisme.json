                    {
                        "translation_id": "af3c4710-efa6-4c87-98e0-41175a6397b5",
                        "source_entry_id": "774fd119-e3e7-311e-a331-3880346bd236",
                        "source_sense_id": "bc70a525-6002-319e-931d-a6d4028cf7cc",
