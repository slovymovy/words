                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ece75001-606f-42fd-a731-0aeccf9af25c",
                        "source_entry_id": "a73102f6-3184-34a4-8bb8-86cc3bf32aab",
                        "source_sense_id": "1779ecd8-286a-34a8-a733-418432adb46f",
                        "target_lang_word": "bourlak",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4b96cb8e-fc09-46d7-9788-b060231159da",
                        "source_entry_id": "a73102f6-3184-34a4-8bb8-86cc3bf32aab",
                        "source_sense_id": "1779ecd8-286a-34a8-a733-418432adb46f",
                        "target_lang_word": "haleur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haleur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecbcb5e8-c3c7-3bbd-b5f6-c249d1e58ce9",
                                        "entry_id": "676d5072-38d6-325c-aba0-276c37d020da",
                                        "glosses": [
                                            "Celui qui hale, qui tire un bateau à l’aide d'un câble, pour le faire avancer."
                                        ],
                                        "tags": [
                                            "Batellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40516180-7c2a-4529-bad6-a85320bf7f87",
                                                "sense_id": "ecbcb5e8-c3c7-3bbd-b5f6-c249d1e58ce9",
                                                "text": "Comme je descendais des Fleuves impassibles,\nJe ne me sentis plus guidé par les haleurs"
                                            },
                                            {
                                                "example_id": "c4537264-a2d6-4630-8a2f-d1d0946788ad",
                                                "sense_id": "ecbcb5e8-c3c7-3bbd-b5f6-c249d1e58ce9",
                                                "text": "J’embarquai vite ; quelques minutes après, l’amarre qui retenait le bateau à la rive fut larguée, le marinier prit place au gouvernail, le haleur enfourcha son cheval, la poulie dans laquelle passait la remorque grinça ; nous étions en route."
                                            },
                                            {
                                                "example_id": "54214589-4144-4793-b9ae-85dd1d6acff6",
                                                "sense_id": "ecbcb5e8-c3c7-3bbd-b5f6-c249d1e58ce9",
                                                "text": "Les épaules en avant, il avançait comme un haleur vers un pays confus dont il savait seulement qu’on y tuait, tirant des épaules et du cerveau le poids de tous ses morts qui, enfin! ne l’empêchait plus d’avancer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caa95da7-bfdd-425c-b23c-c4b500e388b5",
                        "source_entry_id": "a73102f6-3184-34a4-8bb8-86cc3bf32aab",
                        "source_sense_id": "1779ecd8-286a-34a8-a733-418432adb46f",
                        "target_lang_word": "Treidler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treidler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41ce57cb-745f-30e9-86d0-b4ed298ba6af",
                                        "entry_id": "ba11b2dc-df16-3d26-bf29-a741ed87dc8e",
                                        "glosses": [
                                            "jemand, der einen Kahn oder ein Schiff treidelt, also von Land aus an einem Seil flussaufwärts zieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10cdea22-d868-4aa7-b295-3abca6d2ef2d",
                                                "sense_id": "41ce57cb-745f-30e9-86d0-b4ed298ba6af",
                                                "text": "„Seine Mutter hatte William Gutende weitergegeben, daß seine Familie nicht nur Nachkomme von Fischern, Treidlern und Flößern am Rhein war, sondern daß er auch mit dem Ritter Werner Gutende von Lurlinberg verwandt war.“"
                                            },
                                            {
                                                "example_id": "74d8595a-6191-491f-b097-52ad1bf0064a",
                                                "sense_id": "41ce57cb-745f-30e9-86d0-b4ed298ba6af",
                                                "text": "„Wo früher Holzflöße flussabwärts getrieben waren, kamen nun Lastkähne, von Treidlern gezogen, den Fluss herauf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d3ee78c-0104-463b-be24-37fdfbeb4a05",
                        "source_entry_id": "a73102f6-3184-34a4-8bb8-86cc3bf32aab",
                        "source_sense_id": "1779ecd8-286a-34a8-a733-418432adb46f",
                        "target_lang_word": "Treideler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Treideler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5958b45d-c9a6-3c24-9d42-0855c777705a",
                                        "entry_id": "f2fd3385-19bd-3805-9dae-d684de45835a",
                                        "glosses": [
                                            "diejenige Person, die einen Kahn oder ein Schiff treidelt, also von Land aus an einem Seil flussaufwärts zieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ac8483-792e-465e-bbc6-f28af6c634b9",
                                                "sense_id": "5958b45d-c9a6-3c24-9d42-0855c777705a",
                                                "text": "„Die letzten Treideler gab es an der Wolga bis in das beginnende 20. Jahrhundert hinein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
