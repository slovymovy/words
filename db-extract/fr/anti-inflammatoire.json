                ],
                "senses": [
                    {
                        "sense_id": "acbf4193-21e6-3f88-9602-7cd1f34638b1",
                        "entry_id": "60cb237e-08fd-36bc-9edf-e809e885b510",
                        "glosses": [
                            "Qui combat, qui s'oppose à l'inflammation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b84c7b90-3107-4116-aab7-8a3aa4ec0f5c",
                                "sense_id": "acbf4193-21e6-3f88-9602-7cd1f34638b1",
                                "text": "Si les fabricants vantent ses propriétés anxiolytiques, anti-inflammatoires, neuroprotectrices et antalgiques, l’association invite à en nuancer la fiabilité."
                            },
                            {
                                "example_id": "22c15543-7874-4d01-a832-957943d0febb",
                                "sense_id": "acbf4193-21e6-3f88-9602-7cd1f34638b1",
                                "text": "La sauge est œstrogénique, antioxydante, antalgique, anti-inflammatoire, neuro-protectrice, anti-asthénique et antiseptique localement."
                            },
                            {
                                "example_id": "bd2b0b49-6362-4514-acb7-1610541f39db",
                                "sense_id": "acbf4193-21e6-3f88-9602-7cd1f34638b1",
                                "text": "Néanmoins, l’effet protecteur et anti-inflammatoire des mucilages sur les muqueuses du système digestif est assez largement reconnu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6892ea56-70c2-4474-b2a8-7174a7e44e8f",
                        "source_entry_id": "60cb237e-08fd-36bc-9edf-e809e885b510",
