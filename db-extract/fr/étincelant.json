                        ],
                        "form": "étincelante"
                    },
                    {
                        "form_id": "55172e04-51af-4aab-9d1e-d992e3fed1b3",
                        "entry_id": "405394e9-1cff-3c38-ba49-d9b182a0e9bc",
                        "tags": [
                            "plural",
