                "senses": [
                    {
                        "sense_id": "99863ed2-7593-3f9a-9c34-af9b9378c50c",
                        "entry_id": "def62fa7-7e27-3839-9b17-3cb6decf4ed4",
                        "glosses": [
                            "Prozess, bei dem ein Fahrzeug gebremst wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e255722-8b9e-44a1-85ef-6b8434da9004",
                                "sense_id": "99863ed2-7593-3f9a-9c34-af9b9378c50c",
                                "text": "„Die Reaktionszeit eines Menschen, der sich auf den Straßenverkehr konzentriert, wird bei einem Bremsvorgang in einem Auto in der Fahrschule mit mindestens einer Sekunde angegeben.“"
                            },
                            {
                                "example_id": "9ef3e76d-de6d-4fba-a23b-64c719e2bbc5",
                                "sense_id": "99863ed2-7593-3f9a-9c34-af9b9378c50c",
                                "text": "„Bei langsamerer Fahrt nutzt das Auto den Elektromotor, dessen Batterien sich bei jedem Bremsvorgang aufladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
