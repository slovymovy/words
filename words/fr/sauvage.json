            "senses": [
                {
                    "sense_id": "f2248d9f-bb5e-3720-87fd-40e69bf8e205",
                    "sense_definition": "Qui vit en liberté dans la nature, sans être apprivoisé par l'humain ou cultivé.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons pu observer un chat <w>sauvage</w> caché derrière les grands arbres."
                        },
                        {
                            "text": "Cette réserve naturelle protège de nombreuses espèces d'animaux <w>sauvages</w> menacées d'extinction."
                        }
                    ],
                    "synonyms": [
