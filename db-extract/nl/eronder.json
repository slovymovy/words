                                        "entry_id": "a9f9d479-accd-3ea9-8e72-1620628cffa1",
                                        "glosses": [
                                            "The bottom of something."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "867e759e-ddf5-4900-b495-a72cc87663a1",
                                                "sense_id": "b7cab25b-c9ee-37d7-996f-7095e8eb118b",
                                                "text": "The underneath of the aircraft was painted blue."
                                            },
                                            {
                                                "example_id": "b9427cdb-f4d3-4f98-802b-3fecee1c7bbb",
                                                "sense_id": "b7cab25b-c9ee-37d7-996f-7095e8eb118b",
                                                "text": "Nawnim yelped, heaved away, struck his head on the underneath of the bed, and rolled into view bawling."
                                            },
