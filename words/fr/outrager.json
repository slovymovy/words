{
    "word_family": [
        "outrage",
        "outrageant",
        "outrageusement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d5e55d8-956a-377d-8939-7afdf7291af8",
                    "sense_definition": "Blesser gravement l'honneur ou la dignité de quelqu'un par des paroles insultantes ou des actes violents.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "offense_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par ses propos méprisants et agressifs, le député a cherché à <w>outrager</w> publiquement son adversaire."
                        },
                        {
                            "text": "Nul ne devrait être autorisé à <w>outrager</w> ainsi des personnes vulnérables sans subir de sanctions."
                        }
                    ],
                    "synonyms": [
                        "bafouer",
                        "injurier",
                        "insulter",
                        "offenser"
                    ],
                    "antonyms": [
                        "honorer",
                        "respecter"
                    ]
                },
                {
                    "sense_id": "0d86e0de-7122-3931-9340-657bcf4108c6",
                    "sense_definition": "Enfreindre ou heurter violemment un principe moral, la décence ou le bon sens.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "atteinte_valeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision absurde semble <w>outrager</w> le bon sens et la raison la plus élémentaire."
                        },
                        {
                            "text": "Certains comportements provocateurs peuvent gravement <w>outrager</w> la pudeur dans des espaces partagés."
                        }
                    ],
                    "synonyms": [
                        "braver",
                        "transgresser",
                        "violer"
                    ],
                    "antonyms": [
                        "respecter"
                    ],
                    "common_phrases": [
                        "outrager la pudeur",
                        "outrager les bonnes mœurs",
                        "outrager la raison"
                    ]
                },
                {
                    "sense_id": "a11a561f-3f87-3c54-bffc-e870a932d889",
                    "sense_definition": "Ressentir une profonde indignation ou un vif scandale face à une situation ou un acte.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "indignation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les citoyens s'<w>outragent</w> de la corruption grandissante au sein des institutions publiques."
                        },
                        {
                            "text": "Il s'est retiré en silence, s'<w>outrageant</w> encore de la vulgarité des attaques proférées."
                        }
                    ],
                    "synonyms": [
                        "s'indigner",
                        "s'offusquer",
                        "se scandaliser"
                    ],
                    "common_phrases": [
                        "s'outrager d'une injustice"
                    ]
                }
            ]
        }
    ]
}