                        {
                            "text": "W pokoju było <w>słonecznie</w> przez cały dzień.",
                            "target_lang_translations": {
                                "en": "The room was <w>sunny</w> all day long.",
                                "ru": "В комнате было <w>солнечно</w> на протяжении всего дня.",
                                "nl": "In de kamer was het de hele dag <w>zonnig</w>.",
                                "de": "Im Zimmer war es den ganzen Tag über <w>sonnig</w>.",
                                "fr": "La chambre a été <w>ensoleillée</w> toute la journée.",
                                "it": "La stanza è stata <w>soleggiata</w> per tutto il giorno.",
                                "cs": "V pokoji bylo po celý den <w>slunečno</w>.",
                                "tr": "Oda bütün gün <w>güneş alıyordu</w>.",
                                "es": "En la habitación dio <w>el sol</w> durante todo el día.",
                                "zh": "一整天房间里都<w>阳光充足</w>。"
