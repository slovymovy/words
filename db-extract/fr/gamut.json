                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gamut",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89a70978-77e8-3fc8-99dc-b94dbefcb029",
                                        "entry_id": "4a9a85ef-d99b-3b63-b3d8-e7292c42b97c",
                                        "glosses": [
                                            "A (normally) complete range."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456f937b-828e-4edf-8df4-b530bc154101",
                                                "sense_id": "89a70978-77e8-3fc8-99dc-b94dbefcb029",
                                                "text": "I must begin with rudiments of Art / To teach you gamoth in a briefer sort, - -\nBian. Why, I am past my gamouth long agoe."
                                            },
                                            {
                                                "example_id": "a94a7039-7a4f-4c32-914c-23d2b9b46da5",
                                                "sense_id": "89a70978-77e8-3fc8-99dc-b94dbefcb029",
                                                "text": "The entire gamut of the view's changes should have been known to her; its winter aspect, spring, summer and autumn; how storms came up from the sea; how the moors shuddered and brightened as the clouds went over; she should have noted the red spot where the villas were building; and the criss-cross of lines where the allotments were cut..."
                                            },
                                            {
                                                "example_id": "8dad3e52-1474-4b88-97c4-c0b1ce785216",
                                                "sense_id": "89a70978-77e8-3fc8-99dc-b94dbefcb029",
                                                "text": "1933?, Dorothy Parker, review of Katharine Hepburn in the Broadway play The Lake\nShe delivered a striking performance that ran the gamut of emotions, from A to B."
                                            },
                                            {
                                                "example_id": "770f767a-213d-42ed-84d8-a00ba3d08b87",
                                                "sense_id": "89a70978-77e8-3fc8-99dc-b94dbefcb029",
                                                "text": "THE LONDON BRIGHTON & SOUTH COAST RAILWAY. By C. Hamilton Ellis. Ian Allan. 30s. [...] In the course of its pages the author runs through the whole gamut of the locomotives that have during the period under review run on the rails of the L.B. & S.C. and its forebears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2733f0b-d6f6-344d-a0c0-02bffba2671a",
                                        "entry_id": "4a9a85ef-d99b-3b63-b3d8-e7292c42b97c",
                                        "glosses": [
                                            "All the notes in a musical scale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8c9518b-8e22-3c8c-b653-419a9808a645",
                                        "entry_id": "4a9a85ef-d99b-3b63-b3d8-e7292c42b97c",
                                        "glosses": [
                                            "All the colours that can be presented by a device such as a monitor or printer."
                                        ],
