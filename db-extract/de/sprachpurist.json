                        "sense_id": "a05a8bb4-97a8-3d10-b80e-4363413de845",
                        "entry_id": "59e19e8f-d482-319d-b55a-599618d99fc2",
                        "glosses": [
                            "Person, die sich darum bemüht, die Sprache von fremdsprachigen Einflüssen zu befreien oder freizuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29830395-ef28-4d0f-8458-0be06bf71981",
                                "sense_id": "a05a8bb4-97a8-3d10-b80e-4363413de845",
                                "text": "„Angeblich ein missglückter Eindeutschungsversuch eines unbekannten Sprachpuristen, tatsächlich dürfte es sich bei dieser Wortschöpfung jedoch um ein Scherzwort bzw. einen Ulk handeln.“"
                            },
                            {
                                "example_id": "c43a4d05-7eed-4b1c-8ba7-62ed46a2581c",
                                "sense_id": "a05a8bb4-97a8-3d10-b80e-4363413de845",
                                "text": "„Als besondere Form der Sprachverhunzung wird von Sprachpuristen oft das Phänomen der Pseudo-Entlehnungen angeprangert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
