                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d52126ac-af0d-46c4-a4dc-363696bef5e2",
                                "sense_id": "98af0ce0-4a3b-3c12-88ed-1d22410abc46",
                                "text": "На конверте с пин-кодом, который я получил из банка, было написано, что пин нельзя хранить вместе с карточкой, его нужно запомнить, а сам конверт лучше всего сжечь."
                            }
