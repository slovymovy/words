                        ],
                        "form": "den Schirmherren"
                    },
                    {
                        "form_id": "7f9fc16f-8065-4721-a3e6-0d2d89c650ff",
                        "entry_id": "3af5ffe0-413d-3efd-89a4-6ed8100695ae",
                        "tags": [
                            "accusative",
