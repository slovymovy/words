                        "chant patriotique",
                        "chant traditionnel"
                    ]
                },
                {
                    "sense_id": "97914842-b15a-3dca-81fa-7bdd1a1f9e4c",
                    "sense_definition": "Sons modulés et mélodieux émis par certains animaux, en particulier les oiseaux ou les insectes.",
