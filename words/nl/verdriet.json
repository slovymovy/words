                    "sense_definition": "Een gevoel van droefheid, pijn of leed.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het overlijden van haar hond deed haar veel <w>verdriet</w>.",
                            "target_lang_translations": {
                                "en": "The death of her dog caused her much <w>grief</w>.",
                                "ru": "Смерть её собаки причинила ей много <w>горя</w>.",
                                "pl": "Śmierć jej psa sprawiła jej wiele <w>smutku</w>.",
                                "de": "Der Tod ihres Hundes bereitete ihr viel <w>Kummer</w>.",
                                "fr": "La mort de son chien lui a causé beaucoup de <w>chagrin</w>.",
                                "it": "La morte del suo cane le ha causato molto <w>dolore</w>.",
                                "cs": "Smrt jejího psa jí způsobila velký <w>zármutek</w>.",
                                "tr": "Köpeğinin ölümü onu çok <w>üzdü</w>.",
                                "es": "La muerte de su perro le causó mucha <w>pena</w>.",
                                "zh": "她爱犬的离世让她感到非常<w>悲痛</w>。"
                            }
                        },
                        {
                            "text": "Hij had groot <w>verdriet</w> toen zijn beste vriend verhuisde.",
                            "target_lang_translations": {
                                "en": "He felt great <w>sadness</w> when his best friend moved away.",
                                "ru": "Он был в глубокой <w>печали</w>, когда его лучший друг переехал.",
                                "pl": "Czuł wielki <w>żal</w>, kiedy jego najlepszy przyjaciel się wyprowadził.",
                                "de": "Er empfand große <w>Trauer</w>, als sein bester Freund wegzog.",
                                "fr": "Il a ressenti une grande <w>tristesse</w> quand son meilleur ami a déménagé.",
                                "it": "Provava una grande <w>tristezza</w> quando il suo migliore amico si è trasferito.",
                                "cs": "Cítil velký <w>smutek</w>, když se jeho nejlepší přítel odstěhoval.",
                                "tr": "En iyi arkadaşı taşındığında büyük bir <w>üzüntü</w> yaşadı.",
                                "es": "Sintió una gran <w>tristeza</w> cuando su mejor amigo se mudó.",
                                "zh": "当他最好的朋友搬走时，他感到非常<w>难过</w>。"
                            }
                        }
