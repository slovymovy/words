                    {
                        "sense_id": "3b6dcc29-51ca-37cd-9e9a-8705f8f5e90b",
                        "entry_id": "9e1db9cb-7761-3794-9745-7d9660bbaa5f",
                        "glosses": [
                            "Synonym of deionize.",
                            "To cause (an ionized substance) to return to a neutral state; to convert (an ion) into a neutral atom or molecule."
                        ],
                        "tags": [
                            "physical",
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "02734380-bc03-404e-8352-c3e6b25cf665",
                                "sense_id": "3b6dcc29-51ca-37cd-9e9a-8705f8f5e90b",
                                "text": "For the experiments designed to study the effect of pH, aqueous solutions of NaOH were used. Approximately 3 mL of the aqueous phase was drawn out for sampling and a portion of this was used to determine the pH[…]. The other portion was analyzed after addition of HCl solution to bring the pH below 3.0 (to unionize the dissociated vinyl acids)."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9e4b457-a381-321d-8fdb-e77dcb1a996b",
                        "entry_id": "9e1db9cb-7761-3794-9745-7d9660bbaa5f",
                        "glosses": [
                            "Synonym of deionize.",
                            "Of an ionized substance, to return to a neutral state."
                        ],
                        "tags": [
                            "intransitive",
                            "physical",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b752deab-886c-4801-a3ec-14c678ffffbd",
                                "sense_id": "f9e4b457-a381-321d-8fdb-e77dcb1a996b",
                                "text": "The water absorbency of the anionically starch-grafted AA/AM absorbent is markedly affected by the pH of the buffer solution at different ionic strengths. The charge of the ionic monomer affects the pH sensitivity of the superabsorbent polymers. An acidic superabsorbent normally ionizes at high pH but unionizes at low pH."
                            }
                        ]
                    }
