                                                "sense_id": "0799bc60-cf7c-389d-ab7c-2fa93f39e0f8",
                                                "text": "I sat by my sister's bed, peeling oranges for her."
                                            },
                                            {
                                                "example_id": "c9c68079-19c3-40ce-bdd1-cc14bf5e44e4",
                                                "sense_id": "0799bc60-cf7c-389d-ab7c-2fa93f39e0f8",
                                                "text": "The skillful shepherd peeled me certain wands."
