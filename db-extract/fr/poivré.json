                        "entry_id": "63a9fea7-8ab0-3b9b-801a-b61479126ab1",
                        "glosses": [
                            "Dont la surface est parsemée de points de piqûres, comme des grains de poivre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f0ccf69f-3b45-4ba7-bd69-aeb06b9fc50e",
                                "sense_id": "44c973f8-6baf-3618-a52d-f161ca52cde2",
                                "text": "Moi, je me mis à ses pieds, et je lui saisis les mains, ses petites mains poivrées de coups d’aiguille ; et cela m’attendrit."
                            }
                        ]
                    }
