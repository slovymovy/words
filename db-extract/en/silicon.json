                "word": "silicon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "51142d1c-96ef-4d16-a927-b40246101883",
                        "entry_id": "f2e4b73a-e64b-33bb-bacb-cd0a5ecce315",
