                                "target_senses": [
                                    {
                                        "sense_id": "cd1f7652-3a1a-3144-8704-d405aa87fbd9",
                                        "entry_id": "7bfd41d0-a6e2-383f-8fc4-ada86e79311c",
                                        "glosses": [
                                            "The practice of massaging oneself."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37580b07-2d8d-45f1-9509-30bd02731aa2",
                                                "sense_id": "cd1f7652-3a1a-3144-8704-d405aa87fbd9",
                                                "text": "1914, Max Einhorn, “Habitual Constipation and its Treatment,” Philadelphia Medical Journal and The Medical News, Volume 99, No. 22, 30 May, 2014, p. 1064,\nThere are physical means of treatment, such as massage of the bowel and abdomen. That can be done either by an experienced masseur, or by automassage."
                                            },
                                            {
                                                "example_id": "e75c098c-4655-4ef1-8a41-6c2cf9df2453",
                                                "sense_id": "cd1f7652-3a1a-3144-8704-d405aa87fbd9",
                                                "text": "While America prepared for war, I trundled south with Baller, using the journey, which lasted a couple of days and nights, to put myself on a cure. Except for a few oranges and walnuts, I starved myself, and worked, rested and learned automassage, with gratifying results: I arrived in Mexico feeling absolutely free, loose, floating and light."
                                            },
                                            {
                                                "example_id": "cd36991f-ce40-431e-a323-2858a73d16d3",
                                                "sense_id": "cd1f7652-3a1a-3144-8704-d405aa87fbd9",
                                                "text": "Athletes, dancers, and others who must keep muscles strong and supple are often instructed in automassage, or massaging one’s own muscles, and in basic massage on a partner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be310924-310b-31ba-bdd8-e8aa1bdd41f7",
                                        "entry_id": "7bfd41d0-a6e2-383f-8fc4-ada86e79311c",
                                        "glosses": [
                                            "A device or feature providing automated massage."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f87a5ce6-348b-47db-81dc-ee529dba9783",
                                                "sense_id": "be310924-310b-31ba-bdd8-e8aa1bdd41f7",
                                                "text": "The bed in her room was as modern as next week, with automassage, coffee dispenser, weather control, reading machine, etc. […]"
                                            }
                                        ]
                                    }
                                ]
                            }
