                                                "sense_id": "9f2a21b9-2dce-3109-8c02-e379614521b7",
                                                "text": "Linneo fu il grande classificatore della natura"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03a2739b-8967-38ac-b7f4-9024dbf63941",
