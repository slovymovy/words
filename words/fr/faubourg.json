                    "frequency": "Middle",
                    "semantic_group_id": "espace_urbain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les usines ont été construites dans les <w>faubourgs</w> afin de préserver le centre historique."
                        },
                        {
                            "text": "En quittant le centre, nous avons traversé de vastes <w>faubourgs</w> industriels."
                        }
                    ],
