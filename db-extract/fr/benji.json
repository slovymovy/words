                "translations": [
                    {
                        "translation_id": "36120610-e86c-43ec-8469-99ca767918e2",
                        "source_entry_id": "2334f7b3-d11e-3c6f-8940-559320520d1e",
                        "source_sense_id": "67643bb9-9b85-3e34-a3bc-1bbaa11b8704",
                        "source_sense_description": "Sport: Bungee-Jumping, Bungeejumping, Bungeespringen, Bungee",
                        "target_lang_word": "Bungee-Jumping",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bungee-Jumping",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23067171-7455-3dc8-9ff2-6921eab7ecfb",
                                        "entry_id": "fef00f0b-f9f5-3270-976f-a974ecdf9bc3",
                                        "glosses": [
                                            "ein Springen aus großer Höhe im freien Fall, wobei der Springer an einem elastischen Gummiband befestigt ist, das ihn vor dem Untergrund (Boden, Wasser) abbremst und mehrmals zurückfedert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d45de4-6a47-4cde-9903-840d1dabd925",
                                                "sense_id": "23067171-7455-3dc8-9ff2-6921eab7ecfb",
                                                "text": "Beim Bungee-Jumping kommt es immer wieder zu schweren Unfällen."
                                            },
                                            {
                                                "example_id": "feb6081e-10ab-4982-9716-a3661ac58040",
                                                "sense_id": "23067171-7455-3dc8-9ff2-6921eab7ecfb",
                                                "text": "„Das von A.J. Hucket verbreitete moderne Bungee-Jumping wird, wie auch das Kine-Swinging, bei dem der Fall in ein Bergsteigerseil in seitwärtigen Pendelbewegungen ausgeschwungen wird, als abenteuerliches Vergnügen, als artistische Herausforderung, als kühne Präzisionskunst, als Mutprobe, als extremes Training der Seele […], als Psychotest verstanden und praktiziert.“"
                                            },
                                            {
                                                "example_id": "7e330ffc-1f0d-4ae1-8e59-d8b81d6d147e",
                                                "sense_id": "23067171-7455-3dc8-9ff2-6921eab7ecfb",
                                                "text": "„Mit ihrem Sprung am Gummiseil war das Bungee-Jumping in Neuseeland geboren und verbreitete sich wie ein Lauffeuer auf der ganzen Welt. Seitdem ist Neuseeland die Heimat des Bungee-Jumpings.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50d76863-d1d1-4d2d-ab21-19034b79cb42",
                        "source_entry_id": "2334f7b3-d11e-3c6f-8940-559320520d1e",
                        "source_sense_id": "67643bb9-9b85-3e34-a3bc-1bbaa11b8704",
                        "source_sense_description": "Sport: Bungee-Jumping, Bungeejumping, Bungeespringen, Bungee",
                        "target_lang_word": "Bungeejumping",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
