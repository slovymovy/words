                "senses": [
                    {
                        "sense_id": "fe0793ca-fc73-3fff-b966-f4c07e695a22",
                        "entry_id": "02711988-731c-346d-9555-a1d132e61ac3",
                        "glosses": [
                            "наследственное нарушение пигментного обмена с повышенным содержанием порфиринов в крови и тканях и усиленным их выделением с мочой и калом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b60ccc7d-3ec4-4043-b6d1-d7e6c069014e",
                                "sense_id": "fe0793ca-fc73-3fff-b966-f4c07e695a22",
                                "text": "Сегодня больных порфирией часто лечат путем инъекций гемоглобина."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "738ed960-b81c-40a7-9f38-e3b0ba156983",
                        "source_entry_id": "02711988-731c-346d-9555-a1d132e61ac3",
                        "source_sense_id": "fe0793ca-fc73-3fff-b966-f4c07e695a22",
                        "target_lang_word": "porphyria",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porphyria",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20192cde-a942-3a0f-993c-5c61d614febf",
                                        "entry_id": "03b45607-bd05-3c79-b535-1b1007840c22",
                                        "glosses": [
                                            "Any of several usually hereditary abnormalities of porphyrin metabolism characterized by excretion of excess porphyrins in the urine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66d34f70-87a6-4585-9fec-294253cccc61",
                                                "sense_id": "20192cde-a942-3a0f-993c-5c61d614febf",
                                                "text": "The term porphyria, derived from the Greek word porphyra, meaning purple, is apt because a hallmark of most of the porphyrias is the overexcretion of porphyrins in urine or feces."
                                            },
                                            {
                                                "example_id": "62715735-2085-4fce-b12f-c04b9b3ae4a7",
                                                "sense_id": "20192cde-a942-3a0f-993c-5c61d614febf",
                                                "text": "However, the appearance of homozygous forms without consanguinity and coincidence of two types of porphyria in the same patient, dual porphyrias, is possible."
                                            },
                                            {
                                                "example_id": "d7973294-1f35-451d-96c0-3adf00b89e7b",
                                                "sense_id": "20192cde-a942-3a0f-993c-5c61d614febf",
                                                "text": "The usual presenting symptoms and signs of porphyrias are either skin photosensitivity or neurovisceral symptoms and signs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
