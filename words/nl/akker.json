                    "sense_id": "7bc055cf-4cfb-3f47-a71f-ccfed64bbb45",
                    "sense_definition": "Een afgeperkt stuk land dat wordt gebruikt voor het verbouwen van gewassen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "landbouw",
                    "name_type": "no",
                    "examples": [
