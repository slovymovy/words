{
    "word_family": [
        "convention",
        "conventional",
        "convent",
        "convener",
        "convenience"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e682830b-7234-324a-8c46-2a75fb8830c4",
                    "sense_definition": "To come together or assemble, especially for a formal or public purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assemble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee will <w>convene</w> next Tuesday to discuss the new budget proposal.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>соберется</w> в следующий вторник, чтобы обсудить предложение по новому бюджету.",
                                "tr": "Komite, yeni bütçe teklifini görüşmek üzere önümüzdeki salı <w>toplanacak</w>."
                            }
                        },
                        {
                            "text": "The council members <w>convene</w> annually to review the progress of the city projects.",
                            "target_lang_translations": {
                                "ru": "Члены совета <w>собираются</w> ежегодно для обзора хода реализации городских проектов.",
                                "tr": "Konsey üyeleri, şehir projelerinin ilerlemesini gözden geçirmek için her yıl <w>bir araya gelir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "assemble",
                        "meet",
                        "gather"
                    ],
                    "antonyms": [
                        "disperse",
                        "scatter"
                    ],
                    "common_phrases": [
                        "convene annually",
                        "convene for a meeting",
                        "convene in the hall"
                    ],
                    "target_lang_definitions": {
                        "ru": "Собираться или объединяться, особенно для официальной или общественной цели.",
                        "tr": "Özellikle resmi veya kamuya açık bir amaç için bir araya gelmek veya toplanmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "о группе людей или организации"
                            },
                            {
                                "target_lang_word": "сходиться",
                                "target_lang_sense_clarification": "в одном месте для встречи"
                            },
                            {
                                "target_lang_word": "заседать",
                                "target_lang_sense_clarification": "о комитете или совете"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "toplanmak",
                                "target_lang_sense_clarification": "bir grup insanın bir araya gelmesi"
                            },
                            {
                                "target_lang_word": "bir araya gelmek",
                                "target_lang_sense_clarification": "toplantı veya etkinlik için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b11e5a85-9d1d-3868-be57-9b959b57424a",
                    "sense_definition": "To cause to assemble or to call people together for a meeting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assemble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chairperson decided to <w>convene</w> a meeting to address the urgent safety concerns.",
                            "target_lang_translations": {
                                "ru": "Председатель решил <w>созвать</w> собрание, чтобы рассмотреть неотложные вопросы безопасности.",
                                "tr": "Başkan, acil güvenlik endişelerini ele almak için bir toplantı <w>toplamaya</w> karar verdi."
                            }
                        },
                        {
                            "text": "It is necessary to <w>convene</w> a special session of parliament to vote on the law.",
                            "target_lang_translations": {
                                "ru": "Необходимо <w>созвать</w> специальную сессию парламента для голосования по закону.",
                                "tr": "Kanunu oylamak için parlamentoyu özel bir oturuma <w>çağırmak</w> gereklidir."
                            }
                        }
                    ],
                    "synonyms": [
                        "convoke",
                        "summon",
                        "call"
                    ],
                    "antonyms": [
                        "dismiss",
                        "adjourn"
                    ],
                    "common_phrases": [
                        "convene a meeting",
                        "convene a session",
                        "convene a panel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Созывать людей или организовывать собрание.",
                        "tr": "İnsanları bir toplantı için bir araya getirmek veya toplantıya çağırmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "созывать",
                                "target_lang_sense_clarification": "официально приглашать участников"
                            },
                            {
                                "target_lang_word": "собирать",
                                "target_lang_sense_clarification": "организовывать встречу"
                            },
                            {
                                "target_lang_word": "назначать",
                                "target_lang_sense_clarification": "о встрече или сессии"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "toplamak",
                                "target_lang_sense_clarification": "bir kurul veya grubu bir araya getirmek"
                            },
                            {
                                "target_lang_word": "toplantıya çağırmak",
                                "target_lang_sense_clarification": "resmi olarak davet etmek"
                            },
                            {
                                "target_lang_word": "çağırmak",
                                "target_lang_sense_clarification": "kurul veya meclis toplamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e9cec6b-6136-32ee-9ee2-f411e1c2976a",
                    "sense_definition": "To agree upon a rule or standard by convention or mutual arrangement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developers <w>convened</w> on a rule that all code must be reviewed by two peers.",
                            "target_lang_translations": {
                                "ru": "Разработчики <w>договорились</w> о правиле, согласно которому весь код должен проверяться двумя коллегами.",
                                "tr": "Geliştiriciler, tüm kodların iki meslektaş tarafından gözden geçirilmesi gerektiği kuralı üzerinde <w>anlaştılar</w>."
                            }
                        },
                        {
                            "text": "To ensure consistency, the team <w>convened</w> on a naming convention for all digital files.",
                            "target_lang_translations": {
                                "ru": "Чтобы обеспечить единообразие, команда <w>согласовала</w> соглашение об именовании всех цифровых файлов.",
                                "tr": "Tutarlılığı sağlamak için ekip, tüm dijital dosyalar için bir adlandırma standardı üzerinde <w>uzlaştı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "agree",
                        "stipulate"
                    ],
                    "common_phrases": [
                        "convened on a rule"
                    ],
                    "target_lang_definitions": {
                        "ru": "Договориться о правиле или стандарте путем соглашения или взаимной договоренности.",
                        "tr": "Karşılıklı anlaşma veya gelenek yoluyla bir kural veya standart üzerinde uzlaşmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "договариваться",
                                "target_lang_sense_clarification": "о правилах или стандартах"
                            },
                            {
                                "target_lang_word": "уславливаться",
                                "target_lang_sense_clarification": "о взаимном порядке действий"
                            },
                            {
                                "target_lang_word": "согласовывать",
                                "target_lang_sense_clarification": "общий стандарт"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "anlaşmak",
                                "target_lang_sense_clarification": "bir kural veya standart üzerinde"
                            },
                            {
                                "target_lang_word": "kararlaştırmak",
                                "target_lang_sense_clarification": "ortak bir karar almak"
                            },
                            {
                                "target_lang_word": "uzlaşmak",
                                "target_lang_sense_clarification": "bir standart belirlemek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6f5a418-c5f7-3d81-821e-8e48f2c87d5e",
                    "sense_definition": "To summon someone officially or judicially to appear in court or a meeting.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_summons",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness was <w>convened</w> to appear before the grand jury the following morning.",
                            "target_lang_translations": {
                                "ru": "Свидетель был <w>вызван</w> для дачи показаний перед большим жюри на следующее утро.",
                                "tr": "Tanık, ertesi sabah büyük jüri önünde hazır bulunmak üzere <w>çağrıldı</w>."
                            }
                        },
                        {
                            "text": "The tribunal has the power to <w>convene</w> any individual suspected of involvement in the fraud.",
                            "target_lang_translations": {
                                "ru": "Трибунал имеет право <w>вызвать</w> любое лицо, подозреваемое в причастности к мошенничеству.",
                                "tr": "Mahkemenin, dolandırıcılığa karıştığından şüphelenilen herhangi bir kişiyi <w>çağırma</w> yetkisi vardır."
                            }
                        }
                    ],
                    "synonyms": [
                        "summon",
                        "subpoena"
                    ],
                    "common_phrases": [
                        "convene to appear"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально или в судебном порядке вызывать кого-либо для явки в суд или на собрание.",
                        "tr": "Birini mahkemeye veya toplantıya katılması için resmi veya hukuki olarak çağırmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызывать",
                                "target_lang_sense_clarification": "в судебном порядке"
                            },
                            {
                                "target_lang_word": "призывать",
                                "target_lang_sense_clarification": "официально явиться"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çağırmak",
                                "target_lang_sense_clarification": "mahkeme veya kurul önüne"
                            },
                            {
                                "target_lang_word": "davet etmek",
                                "target_lang_sense_clarification": "resmi olarak huzura çağırmak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}