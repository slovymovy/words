                        "glosses": [
                            "Fonction mathématique qui transforme une probabilité entre 0.0 et 1.0 en un nombre réel entre -∞ et +∞."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b79cacb4-8bb4-47ff-861b-0e620c76b22d",
                                "sense_id": "959db7f1-964a-3679-bbb7-c7234a73870c",
                                "text": "La caractéristique importance de cette transformation est que la fonction logit possède plusieurs des propriétés requises d'un modèle de régression linéaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "edf63b68-ba82-3577-a3ae-f33d112791c1",
                        "entry_id": "e5a85144-be3b-3166-a82a-d561e9fe719e",
                        "glosses": [
                            "Nombre réel entre -∞ et +∞ élément du vecteur de sortie d'un réseau de neurones artificiels."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ac977909-7122-434f-aa39-e1ce0a60612c",
                                "sense_id": "edf63b68-ba82-3577-a3ae-f33d112791c1",
                                "text": "Premièrement, pour chaque instance, nous déterminons si la prévision du réseau de neurones est correcte en vérifiant si le logit le plus élevé correspond à la classe cible."
                            }
                        ]
                    }
