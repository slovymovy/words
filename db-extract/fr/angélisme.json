                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c131c37-847e-4eec-ac6e-8bb9790140cb",
                        "source_entry_id": "6aee1f85-2aa6-37ba-9c49-d2db37bdcde6",
                        "target_lang_word": "angelism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "angelism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3f5c3f0-6bba-3867-afd9-db278a9a9008",
                                        "entry_id": "081ab1e8-5f8b-3d2b-8562-66940b1e9f06",
                                        "glosses": [
                                            "A doctrine that regards humans as angelic."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e234040a-304d-41f3-a8c3-fe90b5172cfe",
                                                "sense_id": "a3f5c3f0-6bba-3867-afd9-db278a9a9008",
                                                "text": "It is too simplistic to say that Aristotle has set up two extremes (what are traditionally called 'vices') — that of angelism and beastliness — and that he is trying to articulate a mediating position, a humanizing portrait of the \"political animal\" in between them."
                                            },
                                            {
                                                "example_id": "e4216f13-eeb8-460b-9294-3a1ceef17476",
                                                "sense_id": "a3f5c3f0-6bba-3867-afd9-db278a9a9008",
                                                "text": "For McLuhan angelism is characteristic of the Euroamerican world, with its historic emphasis on Cartesianism, while robotism is characteristic of the Afroasian and aboriginal worlds where detachment and meditation are valued."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
