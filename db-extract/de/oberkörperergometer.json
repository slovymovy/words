                "senses": [
                    {
                        "sense_id": "1236a27a-e16b-3ab2-8f47-49f68ac4da1b",
                        "entry_id": "25342f21-d389-3939-ae88-841b3c5b71a1",
                        "glosses": [
                            "Ergometer, das mit dem Arm bzw. mit der Hand betrieben wird, um die Fitness des Oberkörpers zu trainieren"
                        ],
                        "tags": [
                            "Rehabilitation"
                        ],
                        "examples": [
                            {
                                "example_id": "4a240e23-877b-42c6-8bee-07c254d85ab2",
                                "sense_id": "1236a27a-e16b-3ab2-8f47-49f68ac4da1b",
                                "text": "„Je nach Zielsetzung kann diese länger dauernde rhythmische Bewegung … auf dem Laufband, Oberkörperergometer, „Reckfahrrad“ oder Beinergometer stattfinden.“"
                            },
                            {
                                "example_id": "6bf7036c-9915-4ce5-bdc0-1f2aef5cfb66",
                                "sense_id": "1236a27a-e16b-3ab2-8f47-49f68ac4da1b",
                                "text": "„Wenn man mit dem Training des Oberkörpers beginnen möchte, sollte dieser bereits in den allgemeinen Aufwärmprozess einbezogen werden, z.B. durch ein Ruderergometer oder ein Oberkörperergometer."
                            },
                            {
                                "example_id": "b1d38eba-ee5a-4ab9-9479-bfe2a6f84e52",
                                "sense_id": "1236a27a-e16b-3ab2-8f47-49f68ac4da1b",
                                "text": "„Gute Alternativen stellen das Oberkörperergometer und das Laufband dar. Die Entscheidung, welches der Ergometer genutzt wird, ist abhängig von der Schmerzsymptomatik und individuellen Bedürfnissen des Patienten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
