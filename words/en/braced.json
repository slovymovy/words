                        {
                            "text": "Engineers examined the heavily <w>braced</w> wall before continuing construction.",
                            "target_lang_translations": {
                                "de": "Ingenieure untersuchten die stark <w>abgestützte</w> Wand, bevor die Bauarbeiten fortgesetzt wurden."
                            }
                        }
                    ],
                    "synonyms": [
                        "supported",
                        "reinforced",
                        "strengthened"
                    ],
                    "antonyms": [
