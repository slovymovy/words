                "senses": [
                    {
                        "sense_id": "1c1948ba-a82b-3e4a-881f-7b8b15ba10ff",
                        "entry_id": "2d46d6b7-744b-3c0c-aab1-28533752d1f9",
                        "glosses": [
                            "Beine, die etwas nach außen gekrümmt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f60f816-9468-4cb2-81ab-d95f04c1695f",
                                "sense_id": "1c1948ba-a82b-3e4a-881f-7b8b15ba10ff",
                                "text": "„Neben ihm sammelt sich allmählich ein Haufen Sachen an, sogar Butter, Seide, Eier und Wäsche, sodass man zum Schluss dasteht wie ein Kolonialwarenladen auf O-Beinen.“"
                            },
                            {
                                "example_id": "bd620057-5b29-433b-9950-1a0fbf4b2fbf",
                                "sense_id": "1c1948ba-a82b-3e4a-881f-7b8b15ba10ff",
                                "text": "„Jean lief seine Eingangstreppe herunter und uns entgegen, als er mich aus dem Auto steigen sah, seine Schritte etwas uneben und wankend durch seine O-Beine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
