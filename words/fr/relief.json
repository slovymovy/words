                {
                    "sense_id": "6c86c756-3735-3997-ba30-13345e65488e",
                    "sense_definition": "Hauteur d'un ouvrage ou d'une construction au-dessus du sol naturel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'architecte a vérifié le <w>relief</w> de la nouvelle muraille par rapport au niveau du sol environnant."
