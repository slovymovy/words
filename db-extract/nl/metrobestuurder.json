                        "examples": [
                            {
                                "example_id": "40f55d78-8a17-4db0-b862-df97c56fe088",
                                "sense_id": "d699f18c-f5d5-3658-8d7f-881cc70160d8",
                                "text": "Ki Suk Han (58) is de man op de foto. Hij werd door een andere man op de rails geduwd. Getuigen zouden nog hebben geprobeerd om de metrobestuurder te waarschuwen, maar dat was te laat. Han overleed in het ziekenhuis. De dader wordt nog gezocht door de politie van New York."
                            },
                            {
                                "example_id": "760850b3-0b19-43b9-9672-4000ae6119af",
                                "sense_id": "d699f18c-f5d5-3658-8d7f-881cc70160d8",
                                "text": "Volgens de politie riep een man in een metrostel iets over een bom of een bomalarm en stapte vervolgens uit. Passagiers waarschuwden vervolgens de metrobestuurder. Die zette het metrostel stil op station Delfshaven en waarschuwde de politie. In het metrostel stond een verlaten rugzak. Daarin werd niets gevonden."
                            }
                        ]
                    }
