                "senses": [
                    {
                        "sense_id": "d1797c8c-24b0-3863-837f-7bbffb039a0c",
                        "entry_id": "a0a58257-86b5-3408-ac3b-d4b95233586b",
                        "glosses": [
                            "Grosse pince coupante dotée d’un mécanisme de démultiplication permettant de couper des tiges métalliques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "056e0ccf-027e-4d33-8a3f-22141992b4b1",
                                "sense_id": "d1797c8c-24b0-3863-837f-7bbffb039a0c",
                                "text": "Il ne devait pas être trop compliqué, la nuit venue, muni d’un coupe-boulons et d’un bon cageot de cocktails Molotov, de cisailler les cadenas de la grille d’accès et d’attaquer un convoi du haut de la passerelle, puis de se replier en vitesse."
                            },
                            {
                                "example_id": "cdbe1021-6e1c-4359-a97b-ad6b7ea0cba7",
                                "sense_id": "d1797c8c-24b0-3863-837f-7bbffb039a0c",
                                "text": "Peu avant 14 heures se présente un autre fonctionnaire dont l’armoire est vierge de tout objet suspect, ce qui n’est pas le cas de celui qui lui emboîte le pas : son sac de sport contient une cagoule noire, un coupe-boulons et un pied-de-biche, l’attirail du parfait cambrioleur."
                            }
                        ]
                    }
                ],
