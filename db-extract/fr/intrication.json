                    },
                    {
                        "translation_id": "cc16e47d-3093-4319-aa74-78050c83fdcd",
                        "source_entry_id": "d80fcc64-5bcf-3ab9-8468-d0170f2444aa",
                        "source_sense_description": "physique quantique",
