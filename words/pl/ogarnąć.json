{
    "word_family": [
        "ogarniać",
        "ogarnięcie",
        "ogarnięty",
        "nieogarnięty"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "510e9bd0-4fbc-321d-b12e-8d0780ce2cf2",
                    "sense_definition": "Doprowadzić miejsce lub rzeczy do porządku; posprzątać.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę szybko <w>ogarnąć</w> pokój przed przyjściem gości.",
                            "target_lang_translations": {
                                "ru": "Мне нужно быстро <w>прибрать</w> комнату перед приходом гостей.",
                                "en": "I need to quickly <w>tidy up</w> the room before the guests arrive."
                            }
                        },
                        {
                            "text": "Czy możesz wreszcie <w>ogarnąć</w> ten bałagan na swoim biurku?",
                            "target_lang_translations": {
                                "ru": "Ты можешь наконец <w>прибрать</w> этот бардак на своём столе?",
                                "en": "Can you finally <w>clean up</w> this mess on your desk?"
                            }
                        }
                    ],
                    "synonyms": [
                        "posprzątać"
                    ],
                    "common_phrases": [
                        "ogarnąć mieszkanie",
                        "ogarnąć bałagan",
                        "ogarnąć pokój"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in everyday speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести место или вещи в порядок; убраться.",
                        "en": "To tidy up, clean, or bring a place or items into order."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привести в порядок",
                                "target_lang_sense_clarification": "о помещении или вещах"
                            },
                            {
                                "target_lang_word": "прибрать",
                                "target_lang_sense_clarification": "навести чистоту"
                            },
                            {
                                "target_lang_word": "убрать",
                                "target_lang_sense_clarification": "устранить беспорядок"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "tidy up",
                                "target_lang_sense_clarification": "a room or mess"
                            },
                            {
                                "target_lang_word": "clean up",
                                "target_lang_sense_clarification": "put things in order"
                            },
                            {
                                "target_lang_word": "straighten up",
                                "target_lang_sense_clarification": "arrange neatly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b665f6f0-6bb9-3e10-a33f-939d7ba37ab9",
                    "sense_definition": "Zrozumieć coś, pojąć sens czegoś lub zorientować się w sytuacji.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie mogę <w>ogarnąć</w>, jak działa ten nowy program komputerowy.",
                            "target_lang_translations": {
                                "ru": "Я не могу <w>понять</w>, как работает эта новая компьютерная программа.",
                                "en": "I can't <w>wrap my head around</w> how this new computer program works."
                            }
                        },
                        {
                            "text": "W końcu <w>ogarnąłem</w> te trudne zadania z matematyki.",
                            "target_lang_translations": {
                                "ru": "Я наконец <w>разобрался</w> с этими трудными задачами по математике.",
                                "en": "I finally <w>figured out</w> those difficult math problems."
                            }
                        }
                    ],
                    "synonyms": [
                        "zrozumieć",
                        "złapać",
                        "skumać",
                        "skapować",
                        "sczaić"
                    ],
                    "common_phrases": [
                        "ogarnąć temat",
                        "ciężko ogarnąć"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "very common in spoken language"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Понять что-то, уловить смысл или сориентироваться в ситуации.",
                        "en": "To understand, grasp the meaning of something, or get a handle on a situation."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понять",
                                "target_lang_sense_clarification": "уловить смысл"
                            },
                            {
                                "target_lang_word": "разобраться",
                                "target_lang_sense_clarification": "вникнуть, понять устройство"
                            },
                            {
                                "target_lang_word": "постичь",
                                "target_lang_sense_clarification": "глубоко понять"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "wrap one's head around",
                                "target_lang_sense_clarification": "understand something complex"
                            },
                            {
                                "target_lang_word": "grasp",
                                "target_lang_sense_clarification": "comprehend fully"
                            },
                            {
                                "target_lang_word": "figure out",
                                "target_lang_sense_clarification": "solve or understand"
                            },
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "informal, understand"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19d71fc0-2017-3bea-8d75-70bb63399e48",
                    "sense_definition": "Odzyskać równowagę psychiczną, uspokoić się lub doprowadzić swój wygląd do ładu (używane z zaimkiem „się”).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reflexive_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musisz się <w>ogarnąć</w> i przestać płakać z byle powodu.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>взять себя в руки</w> и перестать плакать по пустякам.",
                                "en": "You need to <w>pull yourself together</w> and stop crying over nothing."
                            }
                        },
                        {
                            "text": "Daj mi chwilę, muszę się <w>ogarnąć</w> po długiej podróży.",
                            "target_lang_translations": {
                                "ru": "Дай мне минуту, мне нужно <w>привести себя в порядок</w> после долгой поездки.",
                                "en": "Give me a moment, I need to <w>freshen up</w> after the long trip."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ogarnij się",
                        "muszę się ogarnąć"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстановить душевное равновесие, успокоиться или привести свой внешний вид в порядок (используется с возвратным местоимением).",
                        "en": "To regain composure, pull oneself together, or freshen up one's appearance (used reflexively with 'się')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прийти в себя",
                                "target_lang_sense_clarification": "успокоиться, восстановить равновесие"
                            },
                            {
                                "target_lang_word": "привести себя в порядок",
                                "target_lang_sense_clarification": "о внешнем виде"
                            },
                            {
                                "target_lang_word": "взять себя в руки",
                                "target_lang_sense_clarification": "собраться с духом"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "pull oneself together",
                                "target_lang_sense_clarification": "regain emotional control"
                            },
                            {
                                "target_lang_word": "get one's act together",
                                "target_lang_sense_clarification": "become organized or focused"
                            },
                            {
                                "target_lang_word": "freshen up",
                                "target_lang_sense_clarification": "tidy one's appearance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef107e4b-0936-3de0-b708-e6325ba20165",
                    "sense_definition": "Zorganizować coś, załatwić jakąś sprawę lub poradzić sobie z zadaniem.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "managing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy uda ci się <w>ogarnąć</w> bilety na ten piątkowy koncert?",
                            "target_lang_translations": {
                                "ru": "У тебя получится <w>достать</w> билеты на этот пятничный концерт?",
                                "en": "Will you be able to <w>sort out</w> tickets for Friday's concert?"
                            }
                        },
                        {
                            "text": "Spokojnie, <w>ogarnę</w> ten projekt do końca tygodnia.",
                            "target_lang_translations": {
                                "ru": "Спокойно, я <w>улажу</w> всё с этим проектом до конца недели.",
                                "en": "Don't worry, I will <w>handle</w> this project by the end of the week."
                            }
                        }
                    ],
                    "synonyms": [
                        "uporać się",
                        "załatwić",
                        "zorganizować"
                    ],
                    "common_phrases": [
                        "ogarnąć sprawę",
                        "ogarnąć temat",
                        "ogarnąć wszystko"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Организовать что-то, решить вопрос или справиться с задачей.",
                        "en": "To handle, organize, or sort out a matter, task, or problem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "организовать",
                                "target_lang_sense_clarification": "устроить что-либо"
                            },
                            {
                                "target_lang_word": "уладить",
                                "target_lang_sense_clarification": "решить проблему или дело"
                            },
                            {
                                "target_lang_word": "достать",
                                "target_lang_sense_clarification": "разг. добыть, купить (напр. билеты)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "handle",
                                "target_lang_sense_clarification": "manage a task or situation"
                            },
                            {
                                "target_lang_word": "sort out",
                                "target_lang_sense_clarification": "resolve or organize"
                            },
                            {
                                "target_lang_word": "take care of",
                                "target_lang_sense_clarification": "deal with a responsibility"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be3e8492-d7b8-35fb-9911-74dbf015db47",
                    "sense_definition": "O uczuciach, myślach lub zjawiskach: silnie na kogoś wpłynąć, opanować kogoś całkowicie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nagle <w>ogarnął</w> go wielki strach przed nieznanym.",
                            "target_lang_translations": {
                                "ru": "Внезапно его <w>охватил</w> сильный страх перед неизвестным.",
                                "en": "Suddenly, a great fear of the unknown <w>overcame</w> him."
                            }
                        },
                        {
                            "text": "Głęboki smutek <w>ogarnął</w> wszystkich zgromadzonych na sali.",
                            "target_lang_translations": {
                                "ru": "Глубокая печаль <w>охватила</w> всех собравшихся в зале.",
                                "en": "Deep sorrow <w>washed over</w> everyone gathered in the hall."
                            }
                        }
                    ],
                    "synonyms": [
                        "opanować",
                        "objąć",
                        "chwycić"
                    ],
                    "common_phrases": [
                        "ogarnął go strach",
                        "ogarnęła go radość",
                        "ogarnął go smutek"
                    ],
                    "target_lang_definitions": {
                        "ru": "О чувствах, мыслях или явлениях: сильно повлиять на кого-то, полностью завладеть кем-то.",
                        "en": "Of feelings or thoughts: to overcome, engulf, or wash over someone completely."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "охватить",
                                "target_lang_sense_clarification": "о сильных чувствах или состояниях"
                            },
                            {
                                "target_lang_word": "овладеть",
                                "target_lang_sense_clarification": "полностью подчинить себе"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "overcome",
                                "target_lang_sense_clarification": "of an emotion or feeling"
                            },
                            {
                                "target_lang_word": "wash over",
                                "target_lang_sense_clarification": "suddenly affect emotionally"
                            },
                            {
                                "target_lang_word": "engulf",
                                "target_lang_sense_clarification": "completely consume emotionally"
                            },
                            {
                                "target_lang_word": "seize",
                                "target_lang_sense_clarification": "take hold of someone suddenly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8a983bc-0ed5-3b86-8392-c0dd4f6ca519",
                    "sense_definition": "Objąć kogoś ramionami lub otoczyć coś ze wszystkich stron (także wzrokiem).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_embrace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Matka czule <w>ogarnęła</w> płaczące dziecko ramionami.",
                            "target_lang_translations": {
                                "ru": "Мать нежно <w>обняла</w> плачущего ребенка.",
                                "en": "The mother tenderly <w>embraced</w> the crying child in her arms."
                            }
                        },
                        {
                            "text": "Dyrektor <w>ogarnął</w> wzrokiem całą salę konferencyjną.",
                            "target_lang_translations": {
                                "ru": "Директор <w>окинул взглядом</w> весь конференц-зал.",
                                "en": "The director <w>scanned</w> the entire conference room with his eyes."
                            }
                        }
                    ],
                    "synonyms": [
                        "objąć",
                        "otoczyć"
                    ],
                    "common_phrases": [
                        "ogarnąć wzrokiem",
                        "ogarnąć spojrzeniem",
                        "ogarnąć ramionami"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обнять кого-то или окружить что-то со всех сторон (также взглядом).",
                        "en": "To embrace someone in one's arms, surround something, or take in an entire view with one's eyes."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обнять",
                                "target_lang_sense_clarification": "заключить в объятия"
                            },
                            {
                                "target_lang_word": "окинуть взглядом",
                                "target_lang_sense_clarification": "посмотреть на всё сразу"
                            },
                            {
                                "target_lang_word": "окружить",
                                "target_lang_sense_clarification": "расположиться вокруг"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "embrace",
                                "target_lang_sense_clarification": "hold in arms"
                            },
                            {
                                "target_lang_word": "take in",
                                "target_lang_sense_clarification": "survey with one's gaze"
                            },
                            {
                                "target_lang_word": "scan",
                                "target_lang_sense_clarification": "look over visually"
                            }
                        ]
                    }
                }
