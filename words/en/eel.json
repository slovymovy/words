{
    "word_family": [
        "eeler",
        "eeling",
        "eelgrass",
        "eellike"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6f5ff66-b111-36a1-b828-2dfe02991c50",
                    "sense_definition": "Any freshwater or marine fish of the order Anguilliformes, which are elongated and resemble snakes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a traditional dish using fresh <w>eel</w> caught in the local river.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил традиционное блюдо из свежего <w>угря</w>, пойманного в местной реке."
                            }
                        },
                        {
                            "text": "We watched a slippery <w>eel</w> glide effortlessly through the muddy water.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как скользкий <w>угорь</w> без усилий скользит в мутной воде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slippery eel",
                        "freshwater eel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая пресноводная или морская рыба отряда угреобразных (Anguilliformes), имеющая удлиненное тело и напоминающая змею."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угорь",
                                "target_lang_sense_clarification": "рыба"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fef8121-8a16-3934-bb58-c2c982b55ed3",
                    "sense_definition": "Someone or something that is sneaky, evasive, and hard to catch or pin down.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect was a slippery <w>eel</w>, constantly changing his story and evading the police.",
                            "target_lang_translations": {
                                "ru": "Подозреваемый был скользким <w>типом</w>, постоянно менял свои показания и уходил от полиции."
                            }
                        },
                        {
                            "text": "You will have a hard time getting a straight answer from that politician; he is a real <w>eel</w>.",
                            "target_lang_translations": {
                                "ru": "Вам будет трудно получить прямой ответ от этого политика; он настоящий <w>угорь</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dodger",
                        "trickster"
                    ],
                    "common_phrases": [
                        "slippery eel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used metaphorically to describe a person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кто-то или что-то скрытное, увертливое, кого трудно поймать или уличить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угорь",
                                "target_lang_sense_clarification": "о скользком, увертливом человеке"
                            },
                            {
                                "target_lang_word": "скользкий тип",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2331532-e2b2-39e5-a17d-0fac7b29b62c",
                    "sense_definition": "A European eel (Anguilla anguilla).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The European <w>eel</w> is currently critically endangered due to overfishing and habitat loss.",
                            "target_lang_translations": {
                                "ru": "Европейский <w>угорь</w> в настоящее время находится на грани исчезновения из-за чрезмерного вылова и утраты среды обитания."
                            }
                        },
                        {
                            "text": "Researchers tracked the migration of the European <w>eel</w> to the Sargasso Sea.",
                            "target_lang_translations": {
                                "ru": "Исследователи проследили миграцию европейского <w>угря</w> в Саргассово море."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Европейский угорь (Anguilla anguilla)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "европейский угорь",
                                "target_lang_sense_clarification": "вид рыбы"
                            },
                            {
                                "target_lang_word": "речной угорь",
                                "target_lang_sense_clarification": "обиходное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b4fd5a1-9440-3e99-8081-2be44fcd1551",
                    "sense_definition": "An electric eel (any knifefish of the genus Electrophorus).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An electric <w>eel</w> can generate powerful shocks to stun its prey.",
                            "target_lang_translations": {
                                "ru": "Электрический <w>угорь</w> может генерировать мощные разряды, чтобы оглушить свою добычу."
                            }
                        },
                        {
                            "text": "Despite its name, the electric <w>eel</w> is more closely related to catfish than to true eels.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свое название, электрический <w>угорь</w> ближе к сомообразным, чем к настоящим угрям."
                            }
                        }
                    ],
                    "common_phrases": [
                        "electric eel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрический угорь (рыба рода Electrophorus)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электрический угорь",
                                "target_lang_sense_clarification": "рыба"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9da7c7e-26ab-3e2b-9ba1-6a7f347b6237",
                    "sense_definition": "A swamp eel (any fish in the family Synbranchidae).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Asian swamp <w>eel</w> has become an invasive species in several North American waterways.",
                            "target_lang_translations": {
                                "ru": "Азиатский болотный <w>угорь</w> стал инвазивным видом в нескольких водных путях Северной Америки."
                            }
                        },
                        {
                            "text": "A swamp <w>eel</w> can breathe air, allowing it to survive out of water for long periods.",
                            "target_lang_translations": {
                                "ru": "Болотный <w>угорь</w> может дышать атмосферным воздухом, что позволяет ему долго выживать без воды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "swamp eel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слитножаберный угорь (рыба семейства Synbranchidae)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слитножаберник",
                                "target_lang_sense_clarification": "семейство рыб"
                            },
                            {
                                "target_lang_word": "болотный угорь",
                                "target_lang_sense_clarification": "буквальный перевод"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5197a2f-73c4-31fd-8e8f-6d12005a65b6",
                    "sense_definition": "An earthworm eel, also called the spineless eel (any fish in the family Chaudhuriidae).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tiny earthworm <w>eel</w> is rarely seen because it burrows deep into the muddy riverbeds.",
                            "target_lang_translations": {
                                "ru": "Крошечный бесшипый <w>угорь</w> встречается редко, так как он зарывается глубоко в илистое дно реки."
                            }
                        },
                        {
                            "text": "Scientists discovered a new species of spineless <w>eel</w> in the freshwater streams of Asia.",
                            "target_lang_translations": {
                                "ru": "Ученые обнаружили новый вид бесшипых <w>угрей</w> в пресноводных ручьях Азии."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рыба семейства Chaudhuriidae (бесшипые угри)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хоудериева рыба",
                                "target_lang_sense_clarification": "семейство Chaudhuriidae"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7072953-29d5-3c39-9305-d3c9e69e2e72",
                    "sense_definition": "A spiny eel (any fish in the family Mastacembelidae).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The aquarium hobbyist added a colorful spiny <w>eel</w> to the freshwater tank.",
                            "target_lang_translations": {
                                "ru": "Аквариумист добавил яркого колючего <w>угря</w> в пресноводный аквариум."
                            }
                        },
                        {
                            "text": "A spiny <w>eel</w> uses its pointed snout to forage for small invertebrates in the sand.",
                            "target_lang_translations": {
                                "ru": "Колючий <w>угорь</w> использует свое заостренное рыло для поиска мелких беспозвоночных в песке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spiny eel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Колючий угорь (рыба семейства Mastacembelidae)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мастацембел",
                                "target_lang_sense_clarification": "семейство хоботнорылых"
                            },
                            {
                                "target_lang_word": "колючий угорь",
                                "target_lang_sense_clarification": "аквариумное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "525684fb-4d95-3db6-9162-3140e9de0592",
                    "sense_definition": "A deep-sea spiny eel (any fish in the family Notacanthidae).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The deep-sea spiny <w>eel</w> is adapted to survive under the immense pressure of the ocean floor.",
                            "target_lang_translations": {
                                "ru": "Глубоководный шипастый <w>угорь</w> приспособлен к выживанию под огромным давлением на дне океана."
                            }
                        },
                        {
                            "text": "Marine biologists captured footage of a rare deep-sea spiny <w>eel</w> swimming near a hydrothermal vent.",
                            "target_lang_translations": {
                                "ru": "Морские биологи засняли редкого глубоководного шипастого <w>угря</w>, плавающего вблизи гидротермального источника."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубоководный шипастый угорь (рыба семейства Notacanthidae)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нотакант",
                                "target_lang_sense_clarification": "семейство спиношипых"
                            },
                            {
                                "target_lang_word": "глубоководный шипастый угорь",
                                "target_lang_sense_clarification": "описание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0a1f555-9ab0-3def-a161-750424ae5c51",
                    "sense_definition": "A conger eel, also called the Congo eel, amphiuma, and Congo snake (any salamander of the genus Amphiuma).",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "amphibian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The three-toed amphiuma is a large salamander often referred to locally as a Congo <w>eel</w>.",
                            "target_lang_translations": {
                                "ru": "Трехпалая амфиума — это крупная саламандра, которую местные жители часто называют конголезским <w>угрём</w>."
                            }
                        },
                        {
                            "text": "Despite its snake-like appearance, the Congo <w>eel</w> is actually an aquatic amphibian.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свой змееподобный вид, конголезский <w>угорь</w> на самом деле является водным земноводным."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly Southern US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Амфиума (водная саламандра рода Amphiuma), часто называемая конголезским угрём."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амфиума",
                                "target_lang_sense_clarification": "земноводное"
                            },
                            {
                                "target_lang_word": "конголезский угорь",
                                "target_lang_sense_clarification": "местное название в США"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "557de51e-e728-3683-8bda-088eefd4bf7f",
                    "sense_definition": "A two-legged eel, also called the mud eel and lesser siren, Siren intermedia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "amphibian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lesser siren is a species of aquatic salamander commonly known as the mud <w>eel</w>.",
                            "target_lang_translations": {
                                "ru": "Малый сирен — это вид водной саламандры, обычно известный как грязевой <w>угорь</w>."
                            }
                        },
                        {
                            "text": "We found a two-legged <w>eel</w> hiding in the shallow, muddy waters of the swamp.",
                            "target_lang_translations": {
                                "ru": "Мы нашли двуногого <w>угря</w>, прячущегося на мелководье в мутной воде болота."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly Southern US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двупалый сирен или грязевой угорь (Siren intermedia)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средний сирен",
                                "target_lang_sense_clarification": "земноводное"
                            },
                            {
                                "target_lang_word": "грязевой угорь",
                                "target_lang_sense_clarification": "местное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3054226-78d4-30a9-9e69-cc470ae7c62a",
                    "sense_definition": "A leopard eel, also called the leopard siren and reticulated siren, Siren reticulata.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "amphibian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newly described reticulated siren is sometimes called the leopard <w>eel</w> due to its spotted pattern.",
                            "target_lang_translations": {
                                "ru": "Недавно описанный сетчатый сирен иногда называют леопардовым <w>угрём</w> из-за его пятнистого окраса."
                            }
                        },
                        {
                            "text": "The leopard <w>eel</w> is a large, fully aquatic salamander native to the southeastern United States.",
                            "target_lang_translations": {
                                "ru": "Леопардовый <w>угорь</w> — это крупная, полностью водная саламандра, обитающая на юго-востоке США."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly Southern US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сетчатый сирен (Siren reticulata), также называемый леопардовым угрём."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сетчатый сирен",
                                "target_lang_sense_clarification": "земноводное"
                            },
                            {
                                "target_lang_word": "леопардовый угорь",
                                "target_lang_sense_clarification": "обиходное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dece141-d48d-3c76-b326-b1bc25bf4749",
                    "sense_definition": "A rubber eel, Typhlonectes natans.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "amphibian",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rubber <w>eel</w> is actually a species of caecilian, a type of limbless amphibian.",
                            "target_lang_translations": {
                                "ru": "Резиновый <w>угорь</w> на самом деле является видом червяг, разновидностью безногих земноводных."
                            }
                        },
                        {
                            "text": "Aquarists often keep the rubber <w>eel</w> because of its unique, worm-like appearance.",
                            "target_lang_translations": {
                                "ru": "Аквариумисты часто держат резинового <w>угря</w> из-за его уникального червеобразного вида."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Водная червяга вида Typhlonectes natans."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "водная червяга",
                                "target_lang_sense_clarification": "безногое земноводное"
                            },
                            {
                                "target_lang_word": "резиновый угорь",
                                "target_lang_sense_clarification": "аквариумное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63fafebe-ec45-30b3-84b6-088bad732c44",
                    "sense_definition": "A vinegar eel, a roundworm of species Turbatrix aceti.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "worm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A vinegar <w>eel</w> is a harmless nematode that feeds on the bacteria found in fermenting vinegar.",
                            "target_lang_translations": {
                                "ru": "Уксусная <w>угрица</w> — это безвредная нематода, питающаяся бактериями, которые содержатся в бродящем уксусе."
                            }
                        },
                        {
                            "text": "Under the microscope, we could see the tiny vinegar <w>eel</w> thrashing around in the sample.",
                            "target_lang_translations": {
                                "ru": "Под микроскопом мы могли видеть, как крошечная уксусная <w>угрица</w> извивается в образце."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уксусная угрица, круглый червь вида Turbatrix aceti."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уксусная угрица",
                                "target_lang_sense_clarification": "нематода"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6102865c-59db-3fe9-8a53-ae458084b1a4",
                    "sense_definition": "To fish for eels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old fishermen would go <w>eeling</w> in the estuary during the dark autumn nights.",
                            "target_lang_translations": {
                                "ru": "Старые рыбаки отправлялись <w>ловить угрей</w> в лиман темными осенними ночами."
                            }
                        },
                        {
                            "text": "He spent his youth learning how to <w>eel</w> using traditional wicker traps.",
                            "target_lang_translations": {
                                "ru": "В юности он учился <w>ловить угрей</w> с помощью традиционных плетеных ловушек."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go eeling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ловить угрей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ловить угрей",
                                "target_lang_sense_clarification": "глагол"
                            },
                            {
                                "target_lang_word": "промышлять угря",
                                "target_lang_sense_clarification": "профессиональное"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b71e3c80-0e52-3b71-b2d7-0c1341dd0b63",
                    "sense_definition": "To move with a sinuous, twisting motion like that of an eel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
