                "senses": [
                    {
                        "sense_id": "5eb8a623-32ca-3b55-a2f6-7387ef392003",
                        "entry_id": "53a97663-86ec-3e42-9e47-1578753f5554",
                        "glosses": [
                            "Verkäufer auf Märkten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccf6c23d-1310-4fe2-be0e-c36137d697b7",
                                "sense_id": "5eb8a623-32ca-3b55-a2f6-7387ef392003",
                                "text": "„Nachdem zwei Fieranten ausgefallen sind, konnte Herr J. C. in der Folge seinen Standplatz behalten.“"
                            },
                            {
                                "example_id": "86f65b4c-5df2-4631-ba71-6067eb1a6b25",
                                "sense_id": "5eb8a623-32ca-3b55-a2f6-7387ef392003",
                                "text": "„Wir könnten wirklich Fieranten sein, Fieranten, die ihre Verkaufsware in Säcken auf dem Dach durch die Gegend karren und nun, weil sie kein Geld für den Gasthof haben, in der freien Landschaft nach einem Unterschlupf suchen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
