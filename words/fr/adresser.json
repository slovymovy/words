    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b36f25a-b53a-3853-8c14-ec3b9a3376ec",
                    "sense_definition": "Envoyer directement un courrier, un message ou formuler des paroles à l'intention de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé d'<w>adresser</w> une lettre de réclamation à la direction de l'hôtel."
                        },
                        {
                            "text": "Nous vous <w>adressons</w> nos meilleurs vœux de bonheur pour cette nouvelle année."
                        }
                    ],
                    "synonyms": [
                        "envoyer",
                        "expédier",
                        "transmettre"
                    ],
                    "antonyms": [
                        "recevoir"
                    ],
                    "common_phrases": [
                        "adresser une lettre",
                        "adresser ses vœux"
                    ]
                },
                {
                    "sense_id": "b26da2dc-02b9-3a3d-accf-1c63e63c77f8",
                    "sense_definition": "Parler directement à une personne ou recourir à ses compétences ou services.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur général s'<w>adresse</w> calmement à tous les employés réunis dans la salle."
                        },
                        {
                            "text": "Pour obtenir ces documents officiels, vous devez vous <w>adresser</w> au secrétariat principal."
                        }
                    ],
                    "synonyms": [
                        "parler",
                        "solliciter"
                    ]
                },
                {
                    "sense_id": "c3142c7d-539f-328e-822f-52a8aeb8b2dd",
                    "sense_definition": "Guider, orienter ou recommander quelqu'un vers une tierce personne ou un spécialiste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin généraliste a choisi d'<w>adresser</w> son patient à un cardiologue réputé."
                        },
                        {
                            "text": "Mon conseiller bancaire m'a <w>adressé</w> vers une agence plus spécialisée."
                        }
                    ],
                    "synonyms": [
                        "diriger",
                        "orienter",
                        "recommander"
                    ],
                    "common_phrases": [
                        "adresser un patient"
                    ]
                },
                {
                    "sense_id": "aecd10d2-90d8-3434-a873-209765dfc99a",
                    "sense_definition": "Désigner ou accéder à un emplacement précis de la mémoire d'un ordinateur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce microprocesseur moderne permet d'<w>adresser</w> directement plusieurs gigaoctets de mémoire vive."
                        },
                        {
                            "text": "Le système d'exploitation ne parvient plus à <w>adresser</w> cet espace de stockage défaillant."
                        }
                    ],
                    "common_phrases": [
                        "adresser la mémoire"
                    ]
                },
                {
                    "sense_id": "e1f61dc3-de3b-391e-b2f3-af7718dada6a",
                    "sense_definition": "Toucher droit et atteindre exactement l'endroit où l'on a visé.",
