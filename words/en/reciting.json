            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca1f3ebe-5f31-355b-8f54-059f3697ddd5",
                    "sense_definition": "present participle and gerund of <w>recite</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "recite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student is <w>reciting</w> a poem in front of the entire class.",
                            "target_lang_translations": {
                                "ru": "Ученик <w>декламирует</w> стихотворение перед всем классом."
                            }
                        },
                        {
                            "text": "She spent the whole afternoon <w>reciting</w> the multiplication tables to her younger brother.",
                            "target_lang_translations": {
                                "ru": "Она провела весь день, <w>рассказывая</w> таблицу умножения своему младшему брату."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "процесс произнесения чего-либо вслух по памяти или чтение текста перед аудиторией"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "декламировать",
                                "target_lang_sense_clarification": "выразительное чтение стихов или прозы"
                            },
                            {
                                "target_lang_word": "рассказывать",
                                "target_lang_sense_clarification": "произнесение заученного материала"
                            },
                            {
                                "target_lang_word": "читать наизусть",
                                "target_lang_sense_clarification": "воспроизведение текста по памяти"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "97c4f9fb-cc02-3fca-9acc-9e0017b697d2",
                    "sense_definition": "The act of repeating something aloud from memory.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reciting</w> of ancient prayers is a central part of the ceremony.",
                            "target_lang_translations": {
                                "ru": "<w>Чтение наизусть</w> древних молитв является центральной частью церемонии."
                            }
                        },
                        {
                            "text": "His <w>reciting</w> of the long list of names took nearly ten minutes.",
                            "target_lang_translations": {
                                "ru": "Его <w>чтение</w> длинного списка имен заняло почти десять минут."
                            }
                        }
                    ],
                    "synonyms": [
                        "recitation"
                    ],
                    "target_lang_definitions": {
                        "ru": "процесс или акт повторения чего-либо вслух по памяти"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чтение наизусть",
                                "target_lang_sense_clarification": "процесс воспроизведения текста по памяти"
                            },
                            {
                                "target_lang_word": "декламация",
                                "target_lang_sense_clarification": "искусство или процесс выразительного чтения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
