                "senses": [
                    {
                        "sense_id": "e344cedc-26e5-3c9e-8826-7f0b16b9d9a7",
                        "entry_id": "c5df2dc2-7378-3432-927b-6f61c25a01c0",
                        "glosses": [
                            "The part of the mind that we are not normally aware of."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "49411431-bd9a-4cd1-9a2e-57adc830fbc4",
                                "sense_id": "e344cedc-26e5-3c9e-8826-7f0b16b9d9a7",
                                "text": "A person can sometimes wake up knowing the solution to a problem that their subconscious has been working on."
                            },
                            {
                                "example_id": "5bdab599-f6c4-4053-a3de-d850d9f06713",
                                "sense_id": "e344cedc-26e5-3c9e-8826-7f0b16b9d9a7",
                                "text": "At a recent meeting of the Organisation for Human Brain Mapping, held in Brighton, England, they explained how brain-scanning has revealed differences in the ways that traumatised and healthy brains respond to the world. This enables researchers to peer into the subconscious of traumatised patients."
                            }
                        ]
                    }
                ],
