                                        "entry_id": "71ea26e6-9569-3633-b533-2fbb8c32b80f",
                                        "glosses": [
                                            "Synonyme d’entomologie."
                                        ],
                                        "tags": [
                                            "Moins courant"
                                        ],
                                        "examples": [
                                            {
