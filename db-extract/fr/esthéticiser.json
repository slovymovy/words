                ],
                "senses": [
                    {
                        "sense_id": "81dc8282-087b-3032-8b26-c15d56fdaa16",
                        "entry_id": "a34a9efa-9b61-39c5-93a7-f8c873daed71",
                        "glosses": [
                            "Donner un caractère esthétique à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9787b115-483a-4ec8-bf42-27384dc35bfd",
                                "sense_id": "81dc8282-087b-3032-8b26-c15d56fdaa16",
                                "text": "« Peut-on faire une belle exposition sur la guerre ? » demande-t-on, à propos de la tendance à « esthéticiser » l'exposition du matériel militaire dans les musées."
                            },
                            {
                                "example_id": "f76267cf-9cf5-4278-b469-0d61ab14d52b",
                                "sense_id": "81dc8282-087b-3032-8b26-c15d56fdaa16",
                                "text": "Nous assistons aujourd'hui à une grande transformation du même ordre sous la pression à la fois de la demande de beauté et d’esthétique et grâce aux innovations techniques qui permettent d’esthéticiser les milieux de vie : espaces publics, espaces commerciaux, espaces privés, espaces écologiquement reconstitués ou restaurés."
                            },
                            {
                                "example_id": "8713bf0e-d6eb-40f1-a961-690ddc59c4e3",
                                "sense_id": "81dc8282-087b-3032-8b26-c15d56fdaa16",
                                "text": "En ce sens, tout acte, toute chose, tout moment peut devenir un point remarquable de cette sorte, tout peut donc être « esthéticisé »."
                            }
                        ]
                    }
                ],
                "translations": [
