                                "target_senses": [
                                    {
                                        "sense_id": "64f3b34d-37ec-3c54-915d-45c8fa24ec79",
                                        "entry_id": "b47fa525-6308-3b75-8d37-45faf66f7fca",
                                        "glosses": [
                                            "Having a tendency to seek revenge when wronged, vengeful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e2a67cb-0880-4bc7-9549-c5a627e44878",
                                                "sense_id": "64f3b34d-37ec-3c54-915d-45c8fa24ec79",
                                                "text": "Lord Avonleigh was an angry rather than a vindictive man. Vindictiveness requires more energy of character than he possessed. Indeed, it may be questioned whether he would of himself have taken the violent measures of the preceding evening."
                                            },
                                            {
                                                "example_id": "ce41809e-bba6-4869-9269-fc5c9be50b60",
                                                "sense_id": "64f3b34d-37ec-3c54-915d-45c8fa24ec79",
                                                "text": "The vindictive mockery in her voice made his brain quiver."
                                            },
                                            {
                                                "example_id": "02e48538-62b2-420b-9c92-6aeb1415faf0",
                                                "sense_id": "64f3b34d-37ec-3c54-915d-45c8fa24ec79",
                                                "text": "The victors will exact vindictive penalties and the losers of course will undertake to pay, but none of them realizes that money is going to do the most extraordinary things to them when they begin upon that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "983340a5-6636-316e-95ed-5d87e9fd7007",
                                        "entry_id": "b47fa525-6308-3b75-8d37-45faf66f7fca",
                                        "glosses": [
                                            "Punitive."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
