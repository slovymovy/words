                        "cabinet d'avocat"
                    ]
                },
                {
                    "sense_id": "277880ea-dfe6-348e-9aa2-98475e44ca9f",
                    "sense_definition": "Fruit comestible de l'avocatier, à peau verte ou sombre et à chair onctueuse contenant un gros noyau.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour le déjeuner, j'ai préparé une salade avec des tomates et un <w>avocat</w> bien mûr."
