                        "sense_id": "99d9879e-932c-3080-ac75-adfaff399617",
                        "entry_id": "01a21d25-0dce-32bb-9481-680e3be902ed",
                        "glosses": [
                            "Fête en prolongation de la fête patronale, la semaine suivant la fête elle-même."
                        ],
                        "tags": [
                            "Lorraine"
                        ],
                        "examples": [
                            {
                                "example_id": "30a18859-e224-40f9-a4da-d67fcac7aeb9",
                                "sense_id": "99d9879e-932c-3080-ac75-adfaff399617",
                                "text": "Il fut un temps où les jeunes filles de Woippy, et de toute la région sans doute n'allaient guère au bal que pour la fête patronale, les relève-selles, la fête nationale, et à l'occasion de grandes et rares circonstances."
                            },
                            {
                                "example_id": "bc513234-3634-4369-aee9-855f252c32e1",
                                "sense_id": "99d9879e-932c-3080-ac75-adfaff399617",
                                "text": "Par contre les conscrits de l'année se regroupaient pour organiser la fête patronale, la tournée des rubans, les “ relève selle ”, principaux divertissements locaux de l'année."
                            },
                            {
                                "example_id": "d725c752-bda0-40b9-9821-68a715380d34",
                                "sense_id": "99d9879e-932c-3080-ac75-adfaff399617",
                                "text": "La grande saga de la fête patronale débutera le samedi 30 août et s'achèvera par le relève-selle une semaine après."
                            },
                            {
                                "example_id": "d6866795-307e-44f0-b19b-270586fda338",
                                "sense_id": "99d9879e-932c-3080-ac75-adfaff399617",
                                "text": "Relève-selle. – C’est aujourd’hui qu’a lieu le relève-selle de la fête patronale."
                            }
                        ]
                    }
