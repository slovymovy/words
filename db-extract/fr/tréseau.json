                "senses": [
                    {
                        "sense_id": "a2aea800-da88-3339-8285-3d43d07968a4",
                        "entry_id": "773f088b-fe5a-3d9a-9257-fd5f895d44ef",
                        "glosses": [
                            "Assemblage de trois gerbes ensemble, qu'on laisse sur le champ après qu'elles font liées, jusqu'à ce qu'elles aient été dîmées, champartées."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7b085402-cb7a-42af-ba16-54397cbded64",
                                "sense_id": "a2aea800-da88-3339-8285-3d43d07968a4",
                                "text": "Au matin de la Saint-Jacques 1455, les laboureurs traversant les champs, allaient engerber le seigle et dresser les trezeaux."
                            },
                            {
                                "example_id": "97ab4434-ef59-4547-be9a-0a635f6e38b8",
                                "sense_id": "a2aea800-da88-3339-8285-3d43d07968a4",
                                "text": "Le blé tombait en javelles & les gerbes dodues étaient embrassées comme des danseuses à l’aide d’un lien en sisal ou en lui, paille de seigle de l’année précédente, battues au fléau & récoltées sans machine pour ne pas casser la tige, puis bottelées en tréseaux, assemblages de trois à six gerbes, couronnées en cas de pluie d’une gerbe supplémentaire dont on disposait la paille en éventail."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f4fc74d-6db6-3764-b3de-c8c31b30ff1d",
                        "entry_id": "773f088b-fe5a-3d9a-9257-fd5f895d44ef",
                        "glosses": [
                            "Demi-quart d’once, ou un gros."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0a6b1b28-8f88-4603-8b2e-bc411ff842b9",
                                "sense_id": "7f4fc74d-6db6-3764-b3de-c8c31b30ff1d",
                                "text": "On achète la menue marchandise, comme le fil, la soie, au tréseau, on en prend un gros."
                            }
                        ]
                    }
