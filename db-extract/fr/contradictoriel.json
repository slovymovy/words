                        "sense_id": "ea0cc0f0-5f22-34a0-9260-8cacf703d24e",
                        "entry_id": "bcea4cf5-2df9-3de7-b074-420e03ec1fd4",
                        "glosses": [
                            "Basé sur l’opposition de choses considérées comme contradictoires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd7863fa-d432-4287-b64b-e172e78acc4e",
                                "sense_id": "ea0cc0f0-5f22-34a0-9260-8cacf703d24e",
                                "text": "Anti-psychanalyse et anti-politisme vont de pair : le maître n’apprécie pas plus le pluralisme contradictoriel de la psyché que le régime parlementaire."
                            },
                            {
                                "example_id": "72dde20b-bd3b-46d3-bea7-952b64f2b2f2",
                                "sense_id": "ea0cc0f0-5f22-34a0-9260-8cacf703d24e",
                                "text": "Puisque le principe d’union rassemble, la fonction contradictorielle rétablit la division, et le système qui se fermait s’ouvre."
                            },
                            {
                                "example_id": "a706a15d-d3a2-433f-9e84-b69699e19036",
                                "sense_id": "ea0cc0f0-5f22-34a0-9260-8cacf703d24e",
                                "text": "L’ambivalence traduite dans les tensions « contradictorielles » (Maffesoli) se révèle au fondement de la vie sociale."
                            }
                        ]
                    }
