                        "glosses": [
                            "een instelling voor de opvang en begeleiding van arme, verwaarloosde of ouderloze kinderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6818e440-63fe-4b40-a339-b6c93bf29d33",
                                "sense_id": "dfa9f18f-8791-3e17-9d24-8e5c09b9db9d",
                                "text": "TOETOLMIN, Ivan Vasiljevitsj (1751-1815). Russisch generaal, directeur van een opvoedingsgesticht in Moskou."
                            },
                            {
                                "example_id": "1f5021c1-8168-4430-88ef-3cdf2f5623ab",
                                "sense_id": "dfa9f18f-8791-3e17-9d24-8e5c09b9db9d",
                                "text": "Manson werd in 1934 geboren. Zijn moeder was nog een tiener en waarschijnlijk een prostituee. Toen hij acht was, werd hij naar een opvoedingsgesticht gestuurd. In de jaren 60 werd hij tot 10 jaar cel veroordeeld wegens fraude met cheques. Hij zou er toen zelf voor gepleit hebben om niet meer vrij te komen, omdat hij de gevangenis als zijn thuis beschouwde."
                            }
                        ]
                    }
