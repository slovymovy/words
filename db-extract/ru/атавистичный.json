                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a58624d-c1da-4572-971d-d675843a32db",
                        "source_entry_id": "a307d1bb-c6d1-37bb-8631-3372799dfc62",
                        "source_sense_id": "2724ca80-b98a-30bf-a9ae-fca451c43717",
                        "target_lang_word": "atavistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atavistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7316208-828f-3647-9e83-c935960e5daf",
                                        "entry_id": "d7cd14f3-244c-34b0-8fc4-fdddedf50fcf",
                                        "glosses": [
                                            "uralt und überholt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6453a3d0-f27e-4cfa-af39-4cec37b3d87e",
                                                "sense_id": "b7316208-828f-3647-9e83-c935960e5daf",
                                                "text": "„Die Fremdenfeindlichkeit ging so bald einher mit der atavistischen Neigung, den Boten für die überbrachte Nachricht verantwortlich zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff066a8b-c4ab-4806-b766-6cf2a3b72e04",
                        "source_entry_id": "a307d1bb-c6d1-37bb-8631-3372799dfc62",
                        "source_sense_id": "2724ca80-b98a-30bf-a9ae-fca451c43717",
                        "target_lang_word": "atavistisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atavistisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a6dc7c4f-f5e2-3c8d-8697-57208288762b",
                                        "entry_id": "5c162ec1-552a-33d5-ad47-25894353725d",
                                        "glosses": [
                                            "het atavisme betreffend of daarop berustend"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d877891c-0069-46a8-b418-5db2ecc1af8b",
                        "source_entry_id": "a307d1bb-c6d1-37bb-8631-3372799dfc62",
                        "source_sense_id": "2724ca80-b98a-30bf-a9ae-fca451c43717",
                        "target_lang_word": "atawistyczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atawistyczny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "3ca3909e-6dcc-374b-875e-a32188fa1910",
                                        "entry_id": "8d4997cc-7360-3244-ac23-08e9f5f39ead",
                                        "glosses": [
                                            "o cechach podobnych jak u odległych przodków"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bb3ed12-831e-4001-8065-7fb2864d2285",
                                                "sense_id": "3ca3909e-6dcc-374b-875e-a32188fa1910",
                                                "text": "Pani od biologii prosiła dzieci, by poszukały u siebie atawistycznych cech. Ja znalazłem chrząsteczki za uszami."
                                            },
                                            {
                                                "example_id": "87fa38a1-78f1-4bdd-8d38-eb19fb66c21c",
                                                "sense_id": "3ca3909e-6dcc-374b-875e-a32188fa1910",
                                                "text": "Lęk przed zachorowaniem – lub nozofobia – jest lękiem atawistycznym, podobnie jak strach przed śmiercią i szaleństwem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d97d7e9-7e06-4f28-8ab6-853b4edabef2",
                        "source_entry_id": "a307d1bb-c6d1-37bb-8631-3372799dfc62",
                        "source_sense_id": "2724ca80-b98a-30bf-a9ae-fca451c43717",
                        "target_lang_word": "atavique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atavique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37615727-76c6-362c-b5f4-bdfaceeac498",
                                        "entry_id": "5e219e42-0a96-3aea-af7c-ebeff5833510",
                                        "glosses": [
                                            "Qui se transmet par atavisme ; relatif à l’atavisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48fa7dca-e947-46df-952f-5473131cdd27",
                                                "sense_id": "37615727-76c6-362c-b5f4-bdfaceeac498",
                                                "text": "Des fautes comme les miennes, que je ne tente pas d’expliquer par l’influence des fatalités ataviques, et par les pernicieux effets d’une éducation si contraire à ma nature, ont besoin d’une expiation terrible, et cette expiation que j’ai choisie, elle est dans la confession publique de ma vie."
                                            },
                                            {
                                                "example_id": "a337d875-4a86-490d-b2a3-4daf42d4dc59",
                                                "sense_id": "37615727-76c6-362c-b5f4-bdfaceeac498",
                                                "text": "Nous autres du corps enseignant, sommes plus sensibles que quiconque à la conservation des qualités ataviques, qui ont fait la grandeur de la France."
                                            },
                                            {
                                                "example_id": "73746fcf-5dc6-4716-9ed9-0e38731c2364",
                                                "sense_id": "37615727-76c6-362c-b5f4-bdfaceeac498",
                                                "text": "Il éprouvait le besoin de se coucher sur la neige. Mais l’atavique et sûr instinct de sa conservation l’avertissait de ne pas s’abandonner à ce désir. — (James Oliver Curwood, Kazan, 1914, traduit de l’anglais par P. Gruyer et L. Postif, Hachette, 1937, page 45)"
                                            },
                                            {
                                                "example_id": "3833e25e-9e1a-463c-a55a-46c659b8f0c0",
                                                "sense_id": "37615727-76c6-362c-b5f4-bdfaceeac498",
                                                "text": "Ce remarquable comportement des anguilles et leur nostophilie (mémoire atavique d’un habitat ancestral) ont donné lieu à certaines théories des plus intéressantes ; […]"
                                            },
                                            {
                                                "example_id": "6e6dd609-b371-4027-b793-dae76f2169cc",
                                                "sense_id": "37615727-76c6-362c-b5f4-bdfaceeac498",
                                                "text": "Depuis, tous partis confondus – CAQ, PLQ, PQ et QS –, les chefs se bousculent pour dénoncer cette énième manifestation du mépris classique des élites anglo-canadiennes envers la présumée « intolérance » atavique des francophones pour les minorités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7914ed90-4de7-3588-89fe-696cd1464925",
                                        "entry_id": "5e219e42-0a96-3aea-af7c-ebeff5833510",
                                        "glosses": [
                                            "Ancestral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96075745-79b8-4f71-bcd0-40de866377a7",
                                                "sense_id": "7914ed90-4de7-3588-89fe-696cd1464925",
                                                "text": "Ils n’avaient d’autre ambition que celle de trouver leur place dans le village, se pliant au rythme atavique des normes établies et ne dérangeant rien de ce microcosme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
