                    {
                        "translation_id": "edada58d-4727-4605-911b-c998e6e7a50e",
                        "source_entry_id": "d7b49441-6094-37f6-ab62-b60e99a55532",
                        "source_sense_description": "any of various large insects of the order Mantodea",
                        "target_lang_word": "bidsprinkhaan",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bidsprinkhaan",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "00fe099a-a149-3fe4-8398-3400a7a63071",
                                        "entry_id": "72923fe5-a9d6-3e05-be9e-c3cd13601b26",
                                        "glosses": [
                                            "benaming voor insecten uit de orde Mantodea, roofdieren die hun prooi met de voorpoten vangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6767a77e-bae7-486a-9e86-8b5cfc7e463b",
                                                "sense_id": "00fe099a-a149-3fe4-8398-3400a7a63071",
                                                "text": "Bij de bidsprinkhaan begint het vrouwtje haar partner soms al tijdens de paring op te eten. Opmerkelijk is hierbij dat het mannetje in staat is om de paring voort te zetten nadat hij is onthoofd en half opgegeten"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "890e8e3e-efd4-4788-8eb9-ca62288664f6",
                        "source_entry_id": "d7b49441-6094-37f6-ab62-b60e99a55532",
                        "source_sense_description": "any of various large insects of the order Mantodea",
                        "target_lang_word": "mante",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84de7b1b-fef0-3155-84a0-238744dd5691",
                                        "entry_id": "69836d59-2dbf-38cd-ac34-47d93c0f4686",
                                        "glosses": [
                                            "Vêtement de femme, ample et sans manches, qui se porte par dessus les autres vêtements, par temps froids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea6d8093-2da6-4a5f-9ed7-c9feca9828ea",
                                                "sense_id": "84de7b1b-fef0-3155-84a0-238744dd5691",
                                                "text": "Il y avait dans ses vêtements des vestiges de magnificence. C’était de la soie usée, une mante propre, quoique passée, des dentelles soigneusement raccommodées ; enfin les haillons de l’opulence !"
                                            },
                                            {
                                                "example_id": "110cccd4-58bd-48af-923e-b33d3cd2cd96",
                                                "sense_id": "84de7b1b-fef0-3155-84a0-238744dd5691",
                                                "text": "Miette était couverte d’une grande mante brune à capuchon, qui lui tombait jusqu’aux pieds et l’enveloppait tout entière. On ne voyait que sa tête et ses mains."
                                            },
                                            {
                                                "example_id": "9152b261-0db0-4f59-b095-fa1bc48e4363",
                                                "sense_id": "84de7b1b-fef0-3155-84a0-238744dd5691",
                                                "text": "Ils grimpaient la côte en chantant par groupes de cinq ou six, le père en avant, la lanterne en main, les femmes enveloppées dans leurs grandes mantes brunes où les enfants se serraient et s’abritaient."
                                            },
                                            {
                                                "example_id": "5e92f8f5-9171-481e-a193-51ee5b212ff3",
                                                "sense_id": "84de7b1b-fef0-3155-84a0-238744dd5691",
                                                "text": "Enveloppée d’une mante de drap rose, Thérèse descendit avec Dechartre les degrés du perron."
                                            },
                                            {
                                                "example_id": "6a4b162f-10ea-40c3-94be-efd43f340bef",
                                                "sense_id": "84de7b1b-fef0-3155-84a0-238744dd5691",
                                                "text": "Prenez votre mante et partons, mon enfant..."
                                            },
                                            {
                                                "example_id": "0a924a44-f027-450d-85cc-1a10f810db0e",
                                                "sense_id": "84de7b1b-fef0-3155-84a0-238744dd5691",
                                                "text": "...prenez donc vite, vite, votre mante, alors, et enveloppez-vous bien. Fleur-de-Marie se hâta de jeter sur ses épaules une sorte de pelisse à capuchon en grosse étoffe de laine blanchâtre bordée d'un ruban de velours noir..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d044b63-df09-3c92-b25b-7881b99fd9d6",
                                        "entry_id": "69836d59-2dbf-38cd-ac34-47d93c0f4686",
                                        "glosses": [
                                            "Vêtement de ce genre que les dames portaient pendant les deuils de cour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b870cdc4-9e0d-3334-bfae-cd57a9874e6e",
                                        "entry_id": "69836d59-2dbf-38cd-ac34-47d93c0f4686",
                                        "glosses": [
                                            "Habit que portent quelques religieuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b365474f-f8f0-4804-af8b-621e318d6396",
                                                "sense_id": "b870cdc4-9e0d-3334-bfae-cd57a9874e6e",
                                                "text": "La première, à droite, en bas, par la mante de Sainte Cécile, d’autres par le corsage de Sainte Agnès […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e6c9cb8-8518-36f2-bcc5-fce6e9dc79bc",
                                        "entry_id": "69836d59-2dbf-38cd-ac34-47d93c0f4686",
                                        "glosses": [
                                            "Grande cape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bce907fc-6ee4-49d7-8c45-4bc006e6171c",
                                                "sense_id": "8e6c9cb8-8518-36f2-bcc5-fce6e9dc79bc",
                                                "text": "— Hélas ! non, dit Guillaume, car voici la mante de Jeanne ! Et il ramassa la cape de la jeune fille."
                                            },
                                            {
                                                "example_id": "c3e84057-925a-411f-b87c-3d78f1812574",
                                                "sense_id": "8e6c9cb8-8518-36f2-bcc5-fce6e9dc79bc",
                                                "text": "Si la nuit est sombre, il faut prendre garde de mettre le pied sur le ventre de quelque honorable hidalgo roulé dans sa mante, qui lui sert de vêtement, de lit et de maison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48c7270f-e940-355a-bb97-9ba2da1d51b2",
                                        "entry_id": "69836d59-2dbf-38cd-ac34-47d93c0f4686",
                                        "glosses": [
                                            "Élément qui recouvre quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69f760cb-db51-467f-9aa3-b7af6c25d7fe",
                                                "sense_id": "48c7270f-e940-355a-bb97-9ba2da1d51b2",
                                                "text": "Collant son visage aux vitres il tâcha, sans y parvenir, de percer l’ombre dont la mante immense couvrait les tranchées proches et des milliers d’hommes en alerte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e7e8cd8-812f-3b70-9182-c0d59387c595",
                                        "entry_id": "d73ef8b5-2d2e-331e-aaac-797e901062ef",
                                        "glosses": [
                                            "Insecte de l'ordre des mantoptères, dont une espèce s’appelle la mante religieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83d57a33-d000-41ea-9301-3dd230a648c9",
                                                "sense_id": "4e7e8cd8-812f-3b70-9182-c0d59387c595",
                                                "text": "Dans les débris des anciennes mines de fer de Schefferville, sur la Côte-Nord, une équipe de paléontologues a découvert, fossilisée, une espèce inconnue de mante qui vivait à l’époque des dinosaures."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mante",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa6793db-6876-34ea-bd19-be4ccb2717e2",
                                        "entry_id": "5d3e5580-7ae6-3a0e-a3ee-212008e39f0a",
                                        "glosses": [
                                            "Synonyme de diable de mer méditerranéen (poisson)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa034175-3b3f-37df-9983-a4947a255951",
                                        "entry_id": "5d3e5580-7ae6-3a0e-a3ee-212008e39f0a",
                                        "glosses": [
                                            "Synonyme de raie manta (poisson)."
                                        ],
                                        "tags": [],
