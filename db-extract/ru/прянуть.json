                            {
                                "example_id": "c6e08a4d-64ab-468f-890f-439a249a0d9f",
                                "sense_id": "8d6f389c-a963-3742-a5d9-ee2985527e3d",
                                "text": "Митя так и прянул опять с места."
                            },
                            {
                                "example_id": "569c089e-4c0f-4467-9b1d-4cbd56faef43",
                                "sense_id": "8d6f389c-a963-3742-a5d9-ee2985527e3d",
                                "text": "Конь прянул в сторону, вынес седока в боковую улицу…"
                            }
                        ]
                    },
                    {
                        "sense_id": "43da7ae4-620a-3723-948c-cecaa33462a3",
