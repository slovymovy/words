                    {
                        "form_id": "123fd41c-fc87-4494-bfa1-b9cad4efe5af",
                        "entry_id": "38af8f4e-2a82-3951-ad9c-1c6fa9e27f2f",
                        "tags": [
                            "singular",
                            "feminine",
                            "short-form"
                        ],
                        "form": "прецизио́нна"
                    },
                    {
                        "form_id": "d98c8f22-e60e-4b27-86a8-e56c4087c19b",
                        "entry_id": "38af8f4e-2a82-3951-ad9c-1c6fa9e27f2f",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "прецизио́нны"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b39cd597-9251-3b8c-be26-c266af4ea233",
                        "entry_id": "38af8f4e-2a82-3951-ad9c-1c6fa9e27f2f",
                        "glosses": [
                            "спец. обладающий высокой точностью или созданный с соблюдением высокой точности параметров; высокоточный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd3593ab-35b2-4b92-83dd-a5df800964f0",
                                "sense_id": "b39cd597-9251-3b8c-be26-c266af4ea233",
                                "text": "Прецизионный инструмент, который она употребляла по отношению к нему, казался в миг льнущего соприкосновения необычайно цепким и неторопливым."
                            },
                            {
                                "example_id": "89bce97f-d1d7-4a86-8f20-8e5b075662cf",
                                "sense_id": "b39cd597-9251-3b8c-be26-c266af4ea233",
                                "text": "Настройщик, так он именуется в штатном расписании, подсоединяет к очередному резистору сверхточный измерительный прибор — прецизионный мост, прикидывая, сколько ударов лазера ему потребуется, чтобы подогнать сопротивление к номиналу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28c767b2-a8f8-4e82-b744-7a121e316ec1",
                        "source_entry_id": "38af8f4e-2a82-3951-ad9c-1c6fa9e27f2f",
                        "source_sense_id": "b39cd597-9251-3b8c-be26-c266af4ea233",
                        "target_lang_word": "precision",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50bfdd86-d8dc-39a2-9ee2-9a53ae77b3ba",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "The state of being precise or exact; especially, both exact and accurate."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3389e6da-5aab-431e-b6ad-6775a2ec68a7",
                                                "sense_id": "50bfdd86-d8dc-39a2-9ee2-9a53ae77b3ba",
                                                "text": "Near-synonyms: exactitude, exactness; accuracy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "The ability of a measurement to be reproduced consistently."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09abd386-ef1e-43df-867e-b0f99be9b9cb",
                                                "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                                                "text": "Near-synonyms: repeatability; reproducibility"
                                            },
                                            {
                                                "example_id": "6e6e73d6-bc03-4c80-84a2-32167028acf7",
                                                "sense_id": "1c8f541c-4bd9-3adc-90d1-8f8996ad7cdf",
                                                "text": "The classic example of the difference between precision and accuracy is that in target practice, if the grouping is tight but the group is off-center, your precision is good but your accuracy needs calibration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67c38040-7559-3d64-8d19-6d8f8519acfa",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "The number of significant digits to which a value may be measured reliably."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee1836ab-8802-3fec-a480-5832f2e48484",
                                        "entry_id": "1031c8c8-8619-322b-b8fd-85b33d4af54d",
                                        "glosses": [
                                            "A bidding system that makes use of many artificial bids to describe a hand quite precisely."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "precision",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c3c913f-96ae-3ded-99e5-10ebde8e67b1",
                                        "entry_id": "2d24164d-f872-3eff-8044-5bfd0021350d",
                                        "glosses": [
                                            "Used for exact or precise measurement."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dda30d8-1e5e-4cc4-865c-7aed877a4a13",
                                                "sense_id": "9c3c913f-96ae-3ded-99e5-10ebde8e67b1",
                                                "text": "precision instruments"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "843fc213-ab3a-3cc2-a04f-51beac6b9d95",
                                        "entry_id": "2d24164d-f872-3eff-8044-5bfd0021350d",
                                        "glosses": [
                                            "Made, or characterized by accuracy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59bf21c0-fc12-498d-9727-d72cdd30bb56",
                                                "sense_id": "843fc213-ab3a-3cc2-a04f-51beac6b9d95",
                                                "text": "But there was nothing he could do about Villa's second when Agbonlahor crossed from the left and Bent finished with a precision volley."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d728f6b7-a732-4089-b132-fc83813361bd",
                        "source_entry_id": "38af8f4e-2a82-3951-ad9c-1c6fa9e27f2f",
                        "source_sense_id": "b39cd597-9251-3b8c-be26-c266af4ea233",
                        "target_lang_word": "precise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c94e522b-36e5-378b-9124-5c1be71f69a1",
                                        "entry_id": "a8da898d-ce42-3a60-baa1-81717bd49c13",
                                        "glosses": [
                                            "Both exact and accurate."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00adeaf9-c7d0-4d32-9027-a39c1e3ec2bb",
                                                "sense_id": "c94e522b-36e5-378b-9124-5c1be71f69a1",
                                                "text": "A memory is \"precise\" when the occurrences that would verify it are narrowly circumscribed: for instance, \"I met Jones\" is precise as compared to \"I met a man.\" A memory is \"accurate\" when it is both precise and true, i.e. in the above instance, if it was Jones I met."
                                            },
                                            {
                                                "example_id": "4b5c77b3-1687-4be1-8071-3cd46c0a3cb6",
                                                "sense_id": "c94e522b-36e5-378b-9124-5c1be71f69a1",
                                                "text": "Individually, some of these definitions fall into the common definitional trap of being overly precise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb57d31-8228-339a-98df-f950a1459ad1",
                                        "entry_id": "a8da898d-ce42-3a60-baa1-81717bd49c13",
                                        "glosses": [
                                            "Consistent, clustered close together, agreeing with each other (this does not mean that they cluster near the true, correct, or accurate value)."
                                        ],
                                        "tags": [
                                            "of data points"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe5b0ce8-d2a3-31fd-9a6c-ce396e7db219",
                                        "entry_id": "a8da898d-ce42-3a60-baa1-81717bd49c13",
                                        "glosses": [
                                            "Adhering too much to rules; prim or punctilious."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "precise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6de424d6-fea2-39a4-9064-5213819229fe",
                                        "entry_id": "15a845fb-6a9f-35d3-8d9e-29d00b4404d2",
                                        "glosses": [
                                            "To make or render precise; to specify."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "641de802-2e3a-490e-b3b1-8e717402add7",
                                                "sense_id": "6de424d6-fea2-39a4-9064-5213819229fe",
                                                "text": "This proposal for a new basic regulation is justified because there is a need to precise the objectives of the CFP."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
