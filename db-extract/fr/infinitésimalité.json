                        "glosses": [
                            "Nature ou qualité de ce qui est infinitésimal."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "23e8c723-8312-44a8-ba89-9db0fa87cdf3",
                                "sense_id": "67c7ab2f-d51f-310b-bf87-6485e1a07051",
                                "text": "Et cette infinitésimalité du produit individuel est aussi vraie de la production philosophique et littéraire que de la production industrielle, comme on va voir."
                            },
                            {
                                "example_id": "636b568f-f669-44ea-8f3a-d8d57acb5afc",
                                "sense_id": "67c7ab2f-d51f-310b-bf87-6485e1a07051",
                                "text": "L'action des doses infinitésimales, quelque incompréhensible qu'elle paraisse aux meilleurs esprits, eu égard à son intensité, et quel que puisse être le caractère d’infinitésimalité qu'on lui suppose, aura toujours un résultat positif."
                            }
                        ]
                    }
