                    {
                        "translation_id": "61dd0570-a3b5-4164-8dac-d6b0094f928d",
                        "source_entry_id": "90dce780-f5e8-366a-8f63-a7aef01cd4b1",
                        "source_sense_id": "db184376-b4fe-3437-8601-349fa4cad625",
                        "target_lang_word": "Schulz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schulz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d930844-6c2c-3fd3-87bc-7dc84a05b0f7",
                                        "entry_id": "81aeb553-5d9d-3593-a004-dee121ebbd18",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e6e3b29-23b0-41e2-b8d5-91534b552246",
                                                "sense_id": "0d930844-6c2c-3fd3-87bc-7dc84a05b0f7",
                                                "text": "Der Schulz soll heute die Nachtschicht übernehmen."
                                            },
                                            {
                                                "example_id": "841bdb99-2e71-4a51-8eec-71af67aab283",
                                                "sense_id": "0d930844-6c2c-3fd3-87bc-7dc84a05b0f7",
                                                "text": "Frau Saltzer geb. Schulz wird hiermit als Zeugin aufgerufen."
                                            },
                                            {
                                                "example_id": "95bd0f80-fc4a-489c-8dc8-bdaed0682373",
                                                "sense_id": "0d930844-6c2c-3fd3-87bc-7dc84a05b0f7",
                                                "text": "Schulzens haben mal wieder die dicksten Kürbisse im Kleingartenverein."
                                            },
                                            {
                                                "example_id": "c0f5e616-539f-4e72-a3b0-818d46fef5d4",
                                                "sense_id": "0d930844-6c2c-3fd3-87bc-7dc84a05b0f7",
                                                "text": "Frau Schulz ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "2bf29064-a62a-4c20-b75d-7a8802531ea5",
                                                "sense_id": "0d930844-6c2c-3fd3-87bc-7dc84a05b0f7",
                                                "text": "Herr Schulz wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "d76621da-2ade-4043-b0ea-e5301895d413",
                                                "sense_id": "0d930844-6c2c-3fd3-87bc-7dc84a05b0f7",
                                                "text": "Die Schulzens fliegen heute nach Kanada."
                                            },
                                            {
                                                "example_id": "d5e47be6-4c96-478e-b55c-c63bc9d91e59",
                                                "sense_id": "0d930844-6c2c-3fd3-87bc-7dc84a05b0f7",
                                                "text": "Der Schulz trägt nie die Pullover, die die Schulz ihm strickt."
                                            },
                                            {
                                                "example_id": "b44f5151-9a4e-4107-a270-04fd3f6a63fc",
                                                "sense_id": "0d930844-6c2c-3fd3-87bc-7dc84a05b0f7",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schulz kommt, geht der Herr Schulz.“"
                                            },
                                            {
                                                "example_id": "234ca5a9-d050-4204-b4b1-1c5a22376210",
                                                "sense_id": "0d930844-6c2c-3fd3-87bc-7dc84a05b0f7",
                                                "text": "Schulz kommt und geht."
                                            },
                                            {
                                                "example_id": "eadd87c3-1eac-4aa6-b910-c948c6247718",
                                                "sense_id": "0d930844-6c2c-3fd3-87bc-7dc84a05b0f7",
                                                "text": "Schulzens kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
