                "senses": [
                    {
                        "sense_id": "b6dbf2d5-d19c-3a98-88fc-46e79b73ed6f",
                        "entry_id": "dd13b2d3-3a80-37ae-9f34-0ac1aad69161",
                        "glosses": [
                            "ein (einklagbarer) Anspruch (Recht) darauf, existieren (leben) zu dürfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59a0ba3c-4303-456c-a104-389a175c64c5",
                                "sense_id": "b6dbf2d5-d19c-3a98-88fc-46e79b73ed6f",
                                "text": "„Auch hier stehen sich das Lebensrecht des Ungeborenen und die Interessen der Frau gegenüber und es ist möglich, dass das Lebensrecht des Föten dahinter zurücktritt.“"
                            },
                            {
                                "example_id": "5a94ac5a-598b-46ef-b6e4-a6d53c0c5c93",
                                "sense_id": "b6dbf2d5-d19c-3a98-88fc-46e79b73ed6f",
                                "text": "„Alle Tiere, die ehedem in Deutschland lebten, haben laut Naturschutzgesetz hier ein Lebensrecht, erklärt mir der Wolfsexperte einer Naturschutzorganisation. Dieses Lebensrecht aller Einheimischen birgt gewisse Unstimmigkeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
