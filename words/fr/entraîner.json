{
    "word_family": [
        "entraînement",
        "entraîneur",
        "entraîneuse",
        "traîner",
        "traîneau",
        "traînée"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ea8c77c-cd72-38fb-9227-18d250f5fe64",
                    "sense_definition": "Préparer quelqu'un à une pratique sportive ou physique par des exercices réguliers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sport_preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur <w>entraîne</w> les jeunes joueurs deux fois par semaine au gymnase."
                        },
                        {
                            "text": "Elle passe tout son temps libre à <w>entraîner</w> une équipe pour le tournoi régional."
                        }
                    ],
                    "synonyms": [
                        "former",
                        "exercer"
                    ],
                    "common_phrases": [
                        "entraîner une équipe",
                        "entraîner des athlètes"
                    ]
                },
                {
                    "sense_id": "5a8e7cca-c993-3879-aec7-b68b5dd94669",
                    "sense_definition": "Avoir pour conséquence ou résultat inévitable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "causality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision imprudente risque d'<w>entraîner</w> des conséquences graves pour notre avenir."
                        },
                        {
                            "text": "La violente tempête a <w>entraîné</w> des retards importants sur l'ensemble du réseau ferroviaire."
                        }
                    ],
                    "synonyms": [
                        "causer",
                        "provoquer",
                        "occasionner"
                    ],
                    "antonyms": [
                        "empêcher",
                        "éviter"
                    ],
                    "common_phrases": [
                        "entraîner des conséquences",
                        "entraîner des retards",
                        "entraîner des coûts"
                    ]
                },
                {
                    "sense_id": "fcb438bc-2bbf-367e-8dd5-6ddf39152702",
                    "sense_definition": "Emporter avec soi par un mouvement continu ou par une force mécanique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le courant violent de la rivière a <w>entraîné</w> plusieurs branches vers le lac."
                        },
                        {
                            "text": "Le puissant moteur électrique <w>entraîne</w> la roue principale de la machine."
                        }
                    ],
                    "synonyms": [
                        "emporter",
                        "charrier"
                    ],
                    "common_phrases": [
                        "entraîner les débris",
                        "se faire entraîner"
                    ]
                },
                {
                    "sense_id": "8c972bab-ed4b-3070-a775-b827520532b0",
                    "sense_definition": "Pousser quelqu'un à agir ou à aller quelque part, souvent par une vive influence ou persuasion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses camarades l'ont <w>entraîné</w> dans des aventures risquées contre son gré."
                        },
                        {
                            "text": "Par son discours très passionné, il a <w>entraîné</w> la foule vers le palais municipal."
                        }
                    ],
                    "synonyms": [
                        "inciter",
                        "pousser"
                    ],
                    "antonyms": [
                        "dissuader",
                        "retenir"
                    ],
                    "common_phrases": [
                        "entraîner dans sa chute",
                        "se laisser entraîner"
                    ]
                }
            ]
        }
    ]
}