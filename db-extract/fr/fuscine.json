                        "sense_id": "4afb4fec-a7dd-3459-ad7c-7b277446f59e",
                        "entry_id": "0ba0ed1b-938e-3418-a3df-478fa16d3767",
                        "glosses": [
                            "Pigment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b30c2f1a-f503-4f4b-927d-c421254d16c5",
                                "sense_id": "4afb4fec-a7dd-3459-ad7c-7b277446f59e",
                                "text": "L’extrémité de la corde avait été plongée dans la fuscine rouge afin que, pendant au côté du dernier de la cordée, elle laissât une trace comme de sang sur la candeur de la neige, permettant ainsi de retrouver le chemin de retour ; mais, si le temps se gâtait, les patrouilles couraient le risque de s'égarer."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc827edc-1da1-317b-8a3c-aded419eb017",
                        "entry_id": "0ba0ed1b-938e-3418-a3df-478fa16d3767",
                        "glosses": [
                            "Pigment noir de la rétine."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "b4dd9635-f60b-4b60-b01d-766b454a2bde",
                                "sense_id": "cc827edc-1da1-317b-8a3c-aded419eb017",
                                "text": "Le ton gris du fond peut être produit par une accumulation des granulations de fuscine des cellules épithéliales vers l'extrémité intérieure."
                            }
                        ]
                    }
