                ],
                "senses": [
                    {
                        "sense_id": "2b8a9d26-07f2-3459-bb98-af99cd1762dc",
                        "entry_id": "25005117-bbb7-344b-bb47-a724dd274da4",
                        "glosses": [
                            "im Winter gelegene Hälfte eines Studienjahres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c573a45-04c4-40e8-8d7c-ca3444b01439",
                                "sense_id": "2b8a9d26-07f2-3459-bb98-af99cd1762dc",
                                "text": "Er bewarb sich zum Wintersemester an der Universität für Medizin."
                            },
                            {
                                "example_id": "1b1af018-ac98-4efa-bb94-05890237640f",
                                "sense_id": "2b8a9d26-07f2-3459-bb98-af99cd1762dc",
                                "text": "„Von Lauenstein fahre ich zum Wintersemester nach Heidelberg.“"
                            },
                            {
                                "example_id": "bc0a95f4-b6d6-4baf-9b88-0b06f9e78638",
                                "sense_id": "2b8a9d26-07f2-3459-bb98-af99cd1762dc",
                                "text": "„Er hatte sich trotz Professor Alewyn entschieden, im Wintersemester an die Universität Göttingen zu wechseln.“"
                            },
                            {
                                "example_id": "e0ec3ec3-7b1f-4c14-a120-3bb0f282910c",
                                "sense_id": "2b8a9d26-07f2-3459-bb98-af99cd1762dc",
                                "text": "„Bis zum Beginn des Wintersemesters nahm ich noch einen Job in einer Imbissbude an, konnte nach zwei Tagen keine Bratwürste, egal, welche, vor allem aber keine halben Hähnchen mehr sehen.“"
                            },
                            {
                                "example_id": "8073642d-8f7b-4eb5-a95b-a3229c9f4022",
                                "sense_id": "2b8a9d26-07f2-3459-bb98-af99cd1762dc",
                                "text": "„Gutrater war im Wintersemester 1497/1498 Prokurator der rheinischen Nation an der Wiener Universität und wurde im Sommersemester 1500 (14. April) Rektor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
