                "senses": [
                    {
                        "sense_id": "9b9b30a4-287c-3493-8975-56b17ca86886",
                        "entry_id": "91ad4d81-61b1-33cc-804d-df52354caa5a",
                        "glosses": [
                            "Césurer une nouvelle fois, en modifiant la coupure."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e64863ef-873d-42d9-8510-e4da479df7c1",
                                "sense_id": "9b9b30a4-287c-3493-8975-56b17ca86886",
                                "text": "Normalement, si le sous-titre est bien fait (40 caractère par ligne maximum), même en augmentant le corps de la police sensiblement, ça devrait pas avoir à recésurer les lignes…"
                            },
                            {
                                "example_id": "417b2aa9-f0be-4867-98d2-f87fceb0e98f",
                                "sense_id": "9b9b30a4-287c-3493-8975-56b17ca86886",
                                "text": "Par contre, les lignes de 40 caractères peuvent s’approcher un peu trop du cadre, à cette taille-là. J’ai tendance à recésurer à 36 au lieu de 40, quand c’est possible."
                            }
                        ]
                    }
                ],
