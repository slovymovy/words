                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69835d84-fa97-4e30-a551-313985433751",
                                                "sense_id": "7604796e-373b-373f-acb4-ffa5356bbac3",
                                                "text": "Es stellte eine Dame dar, die, mit einem Pelzhut und einer Pelzboa versehen, aufrecht dasaß."
                                            }
                                        ],
