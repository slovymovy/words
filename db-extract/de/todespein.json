                "senses": [
                    {
                        "sense_id": "7fed562b-0793-3a69-9a57-320715bd7fc9",
                        "entry_id": "9eb945ec-8cf0-343d-9670-7ffbb1749366",
                        "glosses": [
                            "tödliche Qualen, Schmerzen"
