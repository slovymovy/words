                ],
                "translations": [
                    {
                        "translation_id": "a848c939-83fd-4b89-8d2b-80b02eaf1e41",
                        "source_entry_id": "71561256-200b-3cab-9e7e-7f59de0f5cf4",
                        "source_sense_id": "c4a44f7a-50a3-3e18-9785-2759f695f04e",
                        "source_sense_description": "van elektromagnetische straling, net buiten het gebied van het spectrum dat met het menselijk oog zichtbaar is",
                        "target_lang_word": "ultraviolett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultraviolett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "650a3b48-63c3-33d0-b9ff-3a3b7502001a",
                                        "entry_id": "271615cf-b0d2-38ce-ac27-79d30e94a12f",
                                        "glosses": [
                                            "zum Bereich der Ultraviolettstrahlung gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f7a499b-cabe-45ae-83d2-07d645b07568",
                                                "sense_id": "650a3b48-63c3-33d0-b9ff-3a3b7502001a",
                                                "text": "Das ultraviolette Licht ist für das menschliche Auge nicht sichtbar."
                                            },
                                            {
                                                "example_id": "7ac9f59a-e3b2-4826-aa86-d6c384ef4ef6",
                                                "sense_id": "650a3b48-63c3-33d0-b9ff-3a3b7502001a",
                                                "text": "Hellhäutige Zuwanderer wussten von den Gefahren wenig, während die Aborigines, die seit zehntausenden Jahren auf dem Inselkontinent lebten, schon durch ihre dunkle Hautpigmentierung auf extreme Sonnenintensität und ultraviolette Strahlung eingestellt waren."
                                            },
                                            {
                                                "example_id": "859c7bef-067a-4b09-ab93-3eee633c573d",
                                                "sense_id": "650a3b48-63c3-33d0-b9ff-3a3b7502001a",
                                                "text": "\"… Die im ultravioletten Licht sichtbar gewordenen Strukturen der Wolkendecke zeigen daher die Form eines in Richtung der Rotation liegenden Y.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2d4dadc-de22-49dd-bb73-65e85d9f0927",
                        "source_entry_id": "71561256-200b-3cab-9e7e-7f59de0f5cf4",
                        "source_sense_id": "c4a44f7a-50a3-3e18-9785-2759f695f04e",
                        "source_sense_description": "van elektromagnetische straling, net buiten het gebied van het spectrum dat met het menselijk oog zichtbaar is",
                        "target_lang_word": "ultraviolet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultraviolet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d879c0da-5643-37e7-ab32-b6562a697fcd",
                                        "entry_id": "f975b366-f393-3752-ac89-6c2867627185",
                                        "glosses": [
                                            "Of electromagnetic radiation beyond (higher in frequency than) light visible to the human eye; radiation with wavelengths from 380 to 10 nanometres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80d222e7-c087-45f7-91dc-3882a1ea1c48",
                                                "sense_id": "d879c0da-5643-37e7-ab32-b6562a697fcd",
                                                "text": "Micron said in a statement that it would bring extreme ultraviolet (EUV) technology to Japan, becoming the first semiconductor company to do so, and expected to invest up to 500 billion yen ($3.6 billion) with support from the Japanese government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8edba317-4a3b-3a02-b39e-fa43d9b09402",
                                        "entry_id": "f975b366-f393-3752-ac89-6c2867627185",
                                        "glosses": [
                                            "Relating to very high energies or very small distances or time spans."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "156e0a7f-1a02-459d-a28f-33e8abaf208f",
                                                "sense_id": "8edba317-4a3b-3a02-b39e-fa43d9b09402",
                                                "text": "A one-loop Feynman graph that represents a virtual process. In the limit in which the virtual process involves short distances or high momenta, one may find an ultraviolet divergence in the corresponding amplitude."
                                            },
                                            {
                                                "example_id": "99d6ca49-1b0a-410b-be2b-cbfc1e0d1ca4",
                                                "sense_id": "8edba317-4a3b-3a02-b39e-fa43d9b09402",
                                                "text": "Some have advocated the search for a new theory of quantum gravity, a theory which does not suffer from ultraviolet infinity problems."
                                            },
                                            {
                                                "example_id": "47b251d2-2fd3-4520-8e04-8c1f003163f0",
                                                "sense_id": "8edba317-4a3b-3a02-b39e-fa43d9b09402",
                                                "text": "Since current gravitational observations are insensitive to quantum effects, one may wonder why an ultraviolet completion of the gravity theory is needed if inflation, in fact, occurs several orders of magnitude below the Planck scale."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ultraviolet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46422cab-bab4-3c73-9b15-006727e7c461",
                                        "entry_id": "72d88ffd-e668-318b-8cd9-27bd0c2fd7e7",
                                        "glosses": [
                                            "Ultraviolet colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05805172-3f55-4c16-b732-8088dca2c647",
                        "source_entry_id": "71561256-200b-3cab-9e7e-7f59de0f5cf4",
                        "source_sense_id": "c4a44f7a-50a3-3e18-9785-2759f695f04e",
                        "source_sense_description": "van elektromagnetische straling, net buiten het gebied van het spectrum dat met het menselijk oog zichtbaar is",
                        "target_lang_word": "ultraviolet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ultraviolet",
