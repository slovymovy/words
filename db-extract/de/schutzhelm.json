                    {
                        "form_id": "dd38ef55-105e-4edb-96e4-450701f60410",
                        "entry_id": "e7fd4b21-3059-307f-8020-95036e3191c5",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Schutzhelm"
                    },
                    {
                        "form_id": "8a253782-a1a3-42b0-81df-280876a34c07",
                        "entry_id": "e7fd4b21-3059-307f-8020-95036e3191c5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schutzhelme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa1e8d77-650b-3105-bd49-e7ea1df9658c",
                        "entry_id": "e7fd4b21-3059-307f-8020-95036e3191c5",
                        "glosses": [
                            "Kopfbedeckung mit einer harten Schale und einer Polsterung zum Schutz des Kopfes vor Verletzungen (beispielsweise für Polizisten, Feuerwehrleute, Bauarbeiter, Fahrradfahrer, Motorradfahrer, Skifahrer oder Reiter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f88a218d-7a3e-45a0-bd2c-26cb51419cac",
                                "sense_id": "aa1e8d77-650b-3105-bd49-e7ea1df9658c",
                                "text": "„Ein guter Schutzhelm kann Verletzungen verhindern.“"
                            },
                            {
                                "example_id": "259b567f-b872-48ad-b1c4-abec2e1731f2",
                                "sense_id": "aa1e8d77-650b-3105-bd49-e7ea1df9658c",
                                "text": "Hätte er einen Schutzhelm getragen, wäre ihm die schwere Kopfverletzung beim Unfall erspart geblieben."
                            },
                            {
                                "example_id": "0f01e5f4-de1a-41c6-9c91-858ca21ca0b4",
                                "sense_id": "aa1e8d77-650b-3105-bd49-e7ea1df9658c",
                                "text": "„Gerade mal 18 Prozent aller Radler in Deutschland tragen einen Schutzhelm - obwohl er das Risiko einer schweren Gehirnverletzung deutlich senken kann. Besser also: aufsetzen“!"
                            },
                            {
                                "example_id": "6fce4428-269d-4f47-a01b-27691ad701e4",
                                "sense_id": "aa1e8d77-650b-3105-bd49-e7ea1df9658c",
                                "text": "„Wenn ein Schüler in ein Praktikum geht, dann muss er zum Beispiel auf einer Baustelle Sicherheitsschuhe und bei bestimmten Tätigkeiten einen Schutzhelm tragen.“"
                            },
                            {
                                "example_id": "3f34953a-17d5-4791-b81e-3997507c49c5",
                                "sense_id": "aa1e8d77-650b-3105-bd49-e7ea1df9658c",
                                "text": "„[…] jeder der vier Extrem-Bergsteiger hatte eine Kamera im Schutzhelm, samt Mikrophon und Kopfhörer.“"
                            },
                            {
                                "example_id": "e8079fe4-496c-463e-8b1b-0fd44e267ba4",
                                "sense_id": "aa1e8d77-650b-3105-bd49-e7ea1df9658c",
                                "text": "„Die Aargauer Kantonspolizei hat […] Sturmgewehre und Schutzhelme für die mobile Einsatzpolizei angeschafft.“"
                            },
                            {
                                "example_id": "7fd0fb27-9204-44b6-b7da-3cc08ee3e4a2",
                                "sense_id": "aa1e8d77-650b-3105-bd49-e7ea1df9658c",
                                "text": "„Polizisten stürmen mit Schutzhelmen und Kampfausrüstung auf die wütenden Studenten zu.“"
                            },
                            {
                                "example_id": "e9e3c29f-205b-40b0-81b6-080b7323ee96",
                                "sense_id": "aa1e8d77-650b-3105-bd49-e7ea1df9658c",
                                "text": "„Obwohl er einen Schutzhelm trug, erlitt er so schwere Verletzungen, dass er noch am Unfallort starb.“"
                            },
                            {
                                "example_id": "fcdff964-6ec9-40ff-974f-2ecc4be997a5",
                                "sense_id": "aa1e8d77-650b-3105-bd49-e7ea1df9658c",
                                "text": "[Der Gang] „ist kaum höher als einen Meter und so eng, dass man nur hintereinander kriechen kann. Schutzhelm und Taschenlampe sind Pflicht für diese Exkursion in die Geschichte.“"
                            },
                            {
                                "example_id": "1058efb4-a921-480c-9a48-a4e1b8a81c44",
                                "sense_id": "aa1e8d77-650b-3105-bd49-e7ea1df9658c",
                                "text": "„Wenn David Andrade mit einem Schutzhelm auf dem Kopf auf einem Hausdach in Los Angeles steht, dann strahlt er enorme positive Energie aus.“"
                            },
                            {
                                "example_id": "19aa92f1-3796-47e6-837f-2501a3bd6809",
                                "sense_id": "aa1e8d77-650b-3105-bd49-e7ea1df9658c",
                                "text": "„Mit Schutzhelmen und im Beisein weniger Besucher ist erstmals seit dem Brand in der Pariser Kathedrale Notre-Dame wieder eine Messe in dem Gotteshaus gefeiert worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aec76adb-7bae-4662-a308-385ad872911b",
                        "source_entry_id": "e7fd4b21-3059-307f-8020-95036e3191c5",
