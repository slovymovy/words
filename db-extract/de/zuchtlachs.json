                ],
                "senses": [
                    {
                        "sense_id": "4720a569-346d-3d97-9ff4-23482eaa1716",
                        "entry_id": "ba358787-5d1c-3ba0-bc95-d0d20f0d3f62",
                        "glosses": [
                            "Lachs, der aus einer Fischzucht stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "005e63e8-b41f-405d-ad73-97ea1e6a59d6",
                                "sense_id": "4720a569-346d-3d97-9ff4-23482eaa1716",
                                "text": "„Auch bei der Analyse von Zuchtlachs auf perfluorierte Alkylsubstanzen (PFAS) wurden nur niedrige Gehalte nachgewiesen.“"
                            },
                            {
                                "example_id": "ba1b05ae-9090-45c5-9205-0ff07734d42a",
                                "sense_id": "4720a569-346d-3d97-9ff4-23482eaa1716",
                                "text": "„Unter der Wasseroberfläche, nur durch wippende orangefarbene Bojen erkennbar, ist eine Meeresfarm verborgen. Keine Farm für Zuchtlachse, sondern für einen vielversprechenden pflanzlichen Rohstoff, der eine wichtige Rolle spielen soll bei der Transformation unserer Ernährung und Energiegewinnung: Meeresalgen.“"
                            },
                            {
                                "example_id": "ddfa5226-b473-4cc3-bb9b-2a0f54e89c81",
                                "sense_id": "4720a569-346d-3d97-9ff4-23482eaa1716",
                                "text": "„Millionen Zuchtlachse fliehen jährlich aus Aquafarmen und streuen ihr Erbgut in der Wildpopulation.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
