                    },
                    {
                        "translation_id": "0e6669d6-08f8-4e72-94f0-cb969f984dee",
                        "source_entry_id": "a656cad6-3315-3539-84d3-332235a3f7cd",
                        "source_sense_id": "ebbf1e52-148f-30aa-80ac-2ff0fef0ed91",
