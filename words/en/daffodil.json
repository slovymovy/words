{
    "word_family": [
        "daffodilly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa464c8c-54ef-3228-949d-9ba0d8c5d58f",
                    "sense_definition": "A bulbous plant with yellow flowers and a trumpet-shaped corona.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with bright yellow <w>daffodils</w> that bloomed early in the spring.",
                            "target_lang_translations": {
                                "ru": "Сад был полон ярко-жёлтых <w>нарциссов</w>, которые расцвели ранней весной."
                            }
                        },
                        {
                            "text": "She planted a row of <w>daffodils</w> along the path leading to the front door.",
                            "target_lang_translations": {
                                "ru": "Она посадила ряд <w>нарциссов</w> вдоль дорожки, ведущей к парадной двери."
                            }
                        }
                    ],
                    "synonyms": [
                        "narcissus"
                    ],
                    "common_phrases": [
                        "yellow daffodils"
                    ],
                    "target_lang_definitions": {
                        "ru": "Луковичное растение с жёлтыми цветками и коронкой в форме трубы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарци́сс",
                                "target_lang_sense_clarification": "ботаническое название растения или его цветок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7968ec97-6989-3195-a77a-8ed66d5003a9",
                    "sense_definition": "A brilliant yellow color.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist painted the walls in a soft shade of <w>daffodil</w> to brighten the room.",
                            "target_lang_translations": {
                                "ru": "Художник покрасил стены в нежный <w>нарциссовый</w> оттенок, чтобы сделать комнату светлее."
                            }
                        },
                        {
                            "text": "She wore a dress the color of a <w>daffodil</w> to the summer party.",
                            "target_lang_translations": {
                                "ru": "На летнюю вечеринку она надела платье <w>нарциссового</w> цвета."
                            }
                        }
                    ],
                    "synonyms": [
                        "yellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ярко-жёлтый цвет."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарци́ссовый цвет",
                                "target_lang_sense_clarification": "оттенок жёлтого цвета, напоминающий цветок нарцисса"
                            },
                            {
                                "target_lang_word": "ярко-жёлтый",
                                "target_lang_sense_clarification": "общее обозначение цвета"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "26823465-5001-3357-9bef-c1e00ad23b4b",
                    "sense_definition": "Of a brilliant yellow color.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen features <w>daffodil</w> curtains that let in plenty of light.",
                            "target_lang_translations": {
                                "ru": "На кухне висят <w>нарциссовые</w> занавески, которые пропускают много света."
                            }
                        },
                        {
                            "text": "He chose a <w>daffodil</w> ribbon to wrap the gift for his friend.",
                            "target_lang_translations": {
                                "ru": "Он выбрал <w>нарциссовую</w> ленту, чтобы упаковать подарок для своего друга."
                            }
                        }
                    ],
                    "synonyms": [
                        "yellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ярко-жёлтого цвета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарци́ссовый",
                                "target_lang_sense_clarification": "имеющий цвет нарцисса"
                            },
                            {
                                "target_lang_word": "ярко-жёлтый",
                                "target_lang_sense_clarification": "общее обозначение цвета"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3f64ce7a-5669-314b-bb64-eb418d4c5a08",
                    "sense_definition": "A female given name.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her parents decided to name their daughter <w>Daffodil</w> because they loved spring flowers.",
                            "target_lang_translations": {
                                "ru": "Родители решили назвать дочь <w>Даффодил</w>, потому что они любили весенние цветы."
                            }
                        },
                        {
                            "text": "I met a woman named <w>Daffodil</w> at the botanical garden yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера в ботаническом саду я встретил женщину по имени <w>Даффодил</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Даффодил",
                                "target_lang_sense_clarification": "транслитерация имени"
                            }
                        ]
                    }
                }
            ]
        }
    ]
