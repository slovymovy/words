                            "comment": "very casual usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В состоянии сильного алкогольного или наркотического опьянения.",
                        "zh": "（俚语）烂醉如泥的，处于极度吸毒或醉酒状态的。"
                    },
                    "translations": {
                        "ru": [
                            {
