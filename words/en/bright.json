{
    "word_family": [
        "brighten",
        "brightness",
        "brightly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "adda8f68-c5f5-358a-ba2f-a4b023262fc7",
                    "sense_definition": "Emitting a lot of light; visually dazzling or radiant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "light_intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sun was so <w>bright</w> that I had to wear sunglasses.",
                            "target_lang_translations": {
                                "ru": "Солнце было таким <w>ярким</w>, что мне пришлось надеть солнечные очки.",
                                "tr": "Güneş o kadar <w>parlaktı</w> ki güneş gözlüğü takmak zorunda kaldım."
                            }
                        },
                        {
                            "text": "A <w>bright</w> light shone from the lighthouse across the dark sea.",
                            "target_lang_translations": {
                                "ru": "<w>Яркий</w> свет маяка сиял сквозь тьму моря.",
                                "tr": "Karanlık denizin karşısındaki deniz fenerinden <w>parlak</w> bir ışık parıldıyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "shining",
                        "radiant",
                        "luminous",
                        "brilliant"
                    ],
                    "antonyms": [
                        "dark",
                        "dim"
                    ],
                    "common_phrases": [
                        "bright light",
                        "bright sun",
                        "bright star"
                    ],
                    "target_lang_definitions": {
                        "ru": "Излучающий много света; визуально ослепительный или сияющий.",
                        "tr": "Çok fazla ışık yayan; göz alıcı veya ışıl ışıl."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яркий",
                                "target_lang_sense_clarification": "об интенсивности света"
                            },
                            {
                                "target_lang_word": "ослепительный",
                                "target_lang_sense_clarification": "очень яркий, слепящий глаза"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "parlak",
                                "target_lang_sense_clarification": "ışık yoğunluğu hakkında"
                            },
                            {
                                "target_lang_word": "aydınlık",
                                "target_lang_sense_clarification": "ışıklı, bol ışık alan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15d63bee-21ba-3f35-b388-08747d906702",
                    "sense_definition": "Of a colour: strong and vivid; not pale or muted.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She likes to wear <w>bright</w> colors like yellow and orange.",
                            "target_lang_translations": {
                                "ru": "Ей нравится носить <w>яркие</w> цвета, такие как желтый и оранжевый.",
                                "tr": "Sarı ve turuncu gibi <w>canlı</w> renkler giymeyi sever."
                            }
                        },
                        {
                            "text": "The bird had <w>bright</w> blue feathers that stood out against the green leaves.",
                            "target_lang_translations": {
                                "ru": "У птицы были <w>яркие</w> синие перья, которые выделялись на фоне зеленых листьев.",
                                "tr": "Kuşun, yeşil yaprakların arasında göze çarpan <w>parlak</w> mavi tüyleri vardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "vivid",
                        "brilliant",
                        "bold"
                    ],
                    "antonyms": [
                        "pale",
                        "dull",
                        "muted"
                    ],
                    "common_phrases": [
                        "bright red",
                        "bright colors",
                        "bright green"
                    ],
                    "target_lang_definitions": {
                        "ru": "О цвете: сильный и насыщенный; не бледный и не приглушенный.",
                        "tr": "Renk için: güçlü ve canlı; soluk veya mat olmayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "яркий",
                                "target_lang_sense_clarification": "о цвете"
                            },
                            {
                                "target_lang_word": "насыщенный",
                                "target_lang_sense_clarification": "глубокий цвет"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "canlı",
                                "target_lang_sense_clarification": "renkler hakkında"
                            },
                            {
                                "target_lang_word": "parlak",
                                "target_lang_sense_clarification": "göze çarpan renk"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2d7105a-74f8-34a0-8f5b-42c47604f16d",
                    "sense_definition": "Reflecting a lot of light; having a shiny or polished surface.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "light_reflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight polished his armor until it was <w>bright</w> and gleaming.",
                            "target_lang_translations": {
                                "ru": "Рыцарь полировал свои доспехи, пока они не стали <w>блестящими</w> и сверкающими.",
                                "tr": "Şövalye zırhını <w>parlak</w> ve ışıl ışıl olana kadar parlattı."
                            }
                        },
                        {
                            "text": "She bought a new car with <w>bright</w> chrome wheels.",
                            "target_lang_translations": {
                                "ru": "Она купила новую машину с <w>блестящими</w> хромированными дисками.",
                                "tr": "<w>Parlak</w> krom jantları olan yeni bir araba satın aldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "shiny",
                        "gleaming",
                        "lustrous",
                        "polished"
                    ],
                    "antonyms": [
                        "dull",
                        "matte",
                        "tarnished"
                    ],
                    "common_phrases": [
                        "bright copper",
                        "bright metal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отражающий много света; имеющий блестящую или полированную поверхность.",
                        "tr": "Çok fazla ışık yansıtan; parlatılmış veya cilalı bir yüzeye sahip."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блестящий",
                                "target_lang_sense_clarification": "сверкающий, отражающий свет"
                            },
                            {
                                "target_lang_word": "сверкающий",
                                "target_lang_sense_clarification": "ярко блестящий"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "parlak",
                                "target_lang_sense_clarification": "ışığı yansıtan yüzey"
                            },
                            {
                                "target_lang_word": "ışıl ışıl",
                                "target_lang_sense_clarification": "parıldayan yüzey"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "230c1d46-b237-3346-8c17-774ab5341e6e",
                    "sense_definition": "Of weather or a period of time: sunny, clear, and free from clouds.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>bright</w> and sunny morning, perfect for a picnic.",
                            "target_lang_translations": {
                                "ru": "Это было <w>ясное</w> и солнечное утро, идеальное для пикника.",
                                "tr": "Piknik için mükemmel, <w>açık</w> ve güneşli bir sabahtı."
                            }
                        },
                        {
                            "text": "After the storm passed, the sky became <w>bright</w> and blue again.",
                            "target_lang_translations": {
                                "ru": "После того как шторм прошел, небо снова стало <w>ясным</w> и голубым.",
                                "tr": "Fırtına geçtikten sonra gökyüzü yeniden <w>açık</w> ve mavi oldu."
                            }
                        }
                    ],
                    "synonyms": [
                        "sunny",
                        "clear",
                        "fair"
                    ],
                    "antonyms": [
                        "cloudy",
                        "gloomy",
                        "overcast"
                    ],
                    "common_phrases": [
                        "bright morning",
                        "bright day",
                        "bright sky"
                    ],
                    "target_lang_definitions": {
                        "ru": "О погоде или периоде времени: солнечный, ясный и безоблачный.",
                        "tr": "Hava veya zaman dilimi için: güneşli, açık ve bulutsuz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ясный",
                                "target_lang_sense_clarification": "безоблачный"
                            },
                            {
                                "target_lang_word": "солнечный",
                                "target_lang_sense_clarification": "залитый солнцем"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "açık",
                                "target_lang_sense_clarification": "bulutsuz gökyüzü veya hava"
                            },
                            {
                                "target_lang_word": "güneşli",
                                "target_lang_sense_clarification": "bol güneşli hava"
                            },
                            {
                                "target_lang_word": "aydınlık",
                                "target_lang_sense_clarification": "ferah hava"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67537d7e-86ed-3cc7-aef0-e634f0968bb2",
                    "sense_definition": "Intelligent; quick to learn and understand things.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a very <w>bright</w> student who always gets top marks.",
                            "target_lang_translations": {
                                "ru": "Он очень <w>способный</w> студент, который всегда получает высшие оценки.",
                                "tr": "O, her zaman en yüksek notları alan çok <w>zeki</w> bir öğrencidir."
                            }
                        },
                        {
                            "text": "That was a <w>bright</w> idea to solve the problem so quickly.",
                            "target_lang_translations": {
                                "ru": "Это была <w>блестящая</w> идея — так быстро решить проблему.",
                                "tr": "Sorunu bu kadar çabuk çözmek <w>parlak</w> bir fikirdi."
                            }
                        }
                    ],
                    "synonyms": [
                        "smart",
                        "clever",
                        "intelligent",
                        "sharp",
                        "quick-witted"
                    ],
                    "antonyms": [
                        "stupid",
                        "slow",
                        "unintelligent"
                    ],
                    "common_phrases": [
                        "bright idea",
                        "bright student",
                        "bright kid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Умный; быстро обучающийся и понимающий вещи.",
                        "tr": "Zeki; olayları ve şeyleri çabuk öğrenen ve anlayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "способный",
                                "target_lang_sense_clarification": "одаренный, талантливый"
                            },
                            {
                                "target_lang_word": "смышлёный",
                                "target_lang_sense_clarification": "сообразительный"
                            },
                            {
                                "target_lang_word": "умный",
                                "target_lang_sense_clarification": "обладающий интеллектом"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zeki",
                                "target_lang_sense_clarification": "akıllı, kavrayışı yüksek"
                            },
                            {
                                "target_lang_word": "parlak",
                                "target_lang_sense_clarification": "üstün zekalı, başarılı zeka veya fikir"
                            },
                            {
                                "target_lang_word": "akıllı",
                                "target_lang_sense_clarification": "kavrayışlı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6d0cfa8-7ff5-3c8a-8db9-e61ccc7b3eee",
                    "sense_definition": "Full of hope and likely to be successful or prosperous.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "optimism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With her new degree, she has a <w>bright</w> future ahead of her.",
                            "target_lang_translations": {
                                "ru": "С её новым дипломом у неё впереди <w>светлое</w> будущее.",
                                "tr": "Yeni diplomasıyla önünde <w>parlak</w> bir gelecek var."
                            }
                        },
                        {
                            "text": "The company's prospects look <w>bright</w> after the recent merger.",
                            "target_lang_translations": {
                                "ru": "Перспективы компании выглядят <w>радужными</w> после недавнего слияния.",
                                "tr": "Son birleşmeden sonra şirketin geleceği <w>parlak</w> görünüyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "promising",
                        "optimistic",
                        "hopeful",
                        "favorable"
                    ],
                    "antonyms": [
                        "bleak",
                        "hopeless"
                    ],
                    "common_phrases": [
                        "bright future",
                        "bright prospects",
                        "look on the bright side"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный надежд и, вероятно, успешный или процветающий.",
                        "tr": "Umut dolu; başarılı veya parlak olma ihtimali yüksek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светлый",
                                "target_lang_sense_clarification": "о будущем"
                            },
                            {
                                "target_lang_word": "блестящий",
                                "target_lang_sense_clarification": "великолепный, многообещающий"
                            },
                            {
                                "target_lang_word": "радужный",
                                "target_lang_sense_clarification": "оптимистичный (о перспективах)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "parlak",
                                "target_lang_sense_clarification": "gelecek veya fırsatlar hakkında"
                            },
                            {
                                "target_lang_word": "aydınlık",
                                "target_lang_sense_clarification": "umut verici gelecek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78187688-df4f-3c0c-ab8f-fdde15a0cba5",
                    "sense_definition": "Cheerful, happy, and lively in manner or appearance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave me a <w>bright</w> smile when I walked into the room.",
                            "target_lang_translations": {
                                "ru": "Она одарила меня <w>сияющей</w> улыбкой, когда я вошел в комнату.",
                                "tr": "Odaya girdiğimde bana <w>ışıl ışıl</w> bir gülümseme verdi."
                            }
                        },
                        {
                            "text": "Despite the bad news, he tried to keep a <w>bright</w> and cheerful attitude.",
                            "target_lang_translations": {
                                "ru": "Несмотря на плохие новости, он старался сохранять <w>бодрый</w> и веселый настрой.",
                                "tr": "Kötü haberlere rağmen <w>neşeli</w> ve canlı bir tutum sergilemeye çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheerful",
                        "happy",
                        "merry",
                        "lively",
                        "jovial"
                    ],
                    "antonyms": [
                        "sad",
                        "gloomy",
                        "melancholy"
                    ],
                    "common_phrases": [
                        "bright smile",
                        "bright eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Веселый, счастливый и оживленный в манерах или внешнем виде.",
                        "tr": "Tavır veya görünüş olarak neşeli, mutlu ve canlı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сияющий",
                                "target_lang_sense_clarification": "излучающий радость"
                            },
                            {
                                "target_lang_word": "жизнерадостный",
                                "target_lang_sense_clarification": "бодрый, веселый"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "neşeli",
                                "target_lang_sense_clarification": "canlı ve mutlu"
                            },
                            {
                                "target_lang_word": "ışıl ışıl",
                                "target_lang_sense_clarification": "mutluluk saçan görünüş"
                            },
                            {
                                "target_lang_word": "güler yüzlü",
                                "target_lang_sense_clarification": "tavır ve ifadede"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5df0f64f-1980-3021-9159-d788f6e6236d",
                    "sense_definition": "Of sound: clear, resonant, and often high-pitched.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The trumpet has a <w>bright</w> tone that cuts through the rest of the orchestra.",
                            "target_lang_translations": {
                                "ru": "У трубы <w>звонкий</w> тембр, который прорезается сквозь остальной оркестр.",
                                "tr": "Trompetin, orkestranın geri kalanını yarıp geçen <w>berrak</w> bir tonu vardır."
                            }
                        },
                        {
                            "text": "Her voice was <w>bright</w> and clear as she sang the high notes.",
                            "target_lang_translations": {
                                "ru": "Её голос был <w>звонким</w> и чистым, когда она пела высокие ноты.",
                                "tr": "Yüksek notaları söylerken sesi <w>tiz</w> ve berraktı."
                            }
                        }
                    ],
                    "synonyms": [
                        "clear",
                        "resonant"
                    ],
                    "antonyms": [
                        "muffled",
                        "dull"
                    ],
                    "common_phrases": [
                        "bright tone",
                        "bright sound"
                    ],
                    "target_lang_definitions": {
                        "ru": "О звуке: чистый, резонирующий и часто высокий.",
                        "tr": "Ses için: net, tınlayan ve genellikle tiz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звонкий",
                                "target_lang_sense_clarification": "звучный, высокий"
                            },
                            {
                                "target_lang_word": "чистый",
                                "target_lang_sense_clarification": "без помех"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "berrak",
                                "target_lang_sense_clarification": "net ve temiz ses"
                            },
                            {
                                "target_lang_word": "tiz",
                                "target_lang_sense_clarification": "yüksek frekanslı net ses"
                            },
                            {
                                "target_lang_word": "canlı",
                                "target_lang_sense_clarification": "parlak tınlayan ses"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3c836e5c-b5cd-3340-b303-f1eebbe5a0e0",
                    "sense_definition": "In a bright manner; shiningly or vividly (often used in poetry or informal speech instead of 'brightly').",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "adverbial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The full moon shines <w>bright</w> in the night sky.",
                            "target_lang_translations": {
                                "ru": "Полная луна светит <w>ярко</w> в ночном небе.",
                                "tr": "Dolunay gece gökyüzünde <w>parlak bir şekilde</w> parıldıyor."
                            }
                        },
                        {
                            "text": "May your future shine <w>bright</w> and full of success.",
                            "target_lang_translations": {
                                "ru": "Пусть твое будущее сияет <w>ярко</w> и будет полно успеха.",
                                "tr": "Geleceğiniz <w>ışıl ışıl</w> ve başarılarla dolu olsun."
                            }
                        }
                    ],
                    "synonyms": [
                        "brightly"
                    ],
                    "antonyms": [
                        "dimly"
                    ],
                    "common_phrases": [
                        "shine bright",
                        "burn bright"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "flat adverb"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ярко; сияюще или живо (часто используется в поэзии или неформальной речи вместо 'brightly').",
                        "tr": "Parlak bir şekilde; ışıldayarak veya canlı bir biçimde."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ярко",
                                "target_lang_sense_clarification": "наречие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "parlak bir şekilde",
                                "target_lang_sense_clarification": "parlayarak"
                            },
                            {
                                "target_lang_word": "Işıl ışıl",
                                "target_lang_sense_clarification": "parıldayarak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "8f480a0d-7d81-35c5-a694-d7a3a70d4e6e",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "proper_noun",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Bright</w> has been our neighbor for twenty years.",
