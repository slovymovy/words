                "senses": [
                    {
                        "sense_id": "afa368b4-e6a6-33cf-8582-8930bddbd1e0",
                        "entry_id": "4a94fcb7-b4e3-305b-820d-9e39f69b9ba8",
                        "glosses": [
                            "biologiczny wskaźnik jakości środowiska, którym jest zwierzę lub roślina o dużej wrażliwości na działanie określonych czynników"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93669944-0da5-4c6c-80f3-d86e7e8ccd61",
                                "sense_id": "afa368b4-e6a6-33cf-8582-8930bddbd1e0",
                                "text": "Bioindykatorem do badania czystości wód wykorzystuje się dafnię, chlorellę, pałkę szerokolistną, gupika oraz pstrąg potokowego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c068fcd6-becc-463a-b418-e96693fdba75",
                        "source_entry_id": "4a94fcb7-b4e3-305b-820d-9e39f69b9ba8",
                        "source_sense_id": "afa368b4-e6a6-33cf-8582-8930bddbd1e0",
                        "target_lang_word": "bioindicator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bioindicator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6cecc524-dd5f-3bf1-bb0d-3db96e1c4893",
                                        "entry_id": "2fb2d445-0182-3d76-bda7-55f061bb82e4",
                                        "glosses": [
                                            "Any species that acts as a biological indicator of the health of an environment."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "818c544e-9e24-435f-8c17-2b49b7929374",
                        "source_entry_id": "4a94fcb7-b4e3-305b-820d-9e39f69b9ba8",
                        "source_sense_id": "afa368b4-e6a6-33cf-8582-8930bddbd1e0",
                        "target_lang_word": "bio-indicateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6725c094-6a5f-4705-bf42-a86c72d00160",
                        "source_entry_id": "4a94fcb7-b4e3-305b-820d-9e39f69b9ba8",
                        "source_sense_id": "afa368b4-e6a6-33cf-8582-8930bddbd1e0",
                        "target_lang_word": "biomarqueur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biomarqueur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dbd980b2-587e-32a3-802a-85cc9f7aa4d1",
                                        "entry_id": "9a5932ce-18bf-3095-87bb-b1d72135cace",
                                        "glosses": [
                                            "Marqueur biologique, le plus souvent une protéine, par opposition aux marqueurs chimiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39a3c4c6-3c33-47ef-a66b-396d08c24aa5",
                                                "sense_id": "dbd980b2-587e-32a3-802a-85cc9f7aa4d1",
                                                "text": "Plus exactement, la détection et le dosage des cytokines dans le sang, un biomarqueur inflammatoire, permettent de différencier les patients atteints de troubles bipolaires de ceux qui souffrent d’un trouble dépressif."
                                            },
                                            {
                                                "example_id": "c2f03a05-3ab8-4ac4-9eea-5a203d2c6096",
                                                "sense_id": "dbd980b2-587e-32a3-802a-85cc9f7aa4d1",
                                                "text": "Notre dénominateur commun est donc d'utiliser les biomarqueurs, la génomique et la génétique pour mieux individualiser les diagnostics et les traitements qui s'ensuivent."
                                            },
                                            {
                                                "example_id": "6d9cf533-443b-44c7-ae6a-941a4b698d4e",
                                                "sense_id": "dbd980b2-587e-32a3-802a-85cc9f7aa4d1",
                                                "text": "Il faut toutefois faire la différence entre « molécule organique » et « biosignature organique » ou « biomarqueur ». Les molécules organiques pourraient être un signe de vie, mais attention : en réalité, peu d’entre elles le sont. Nous appelons cela des biomarqueurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a74a365-a3b8-305b-8775-0e923e3d1dcf",
                                        "entry_id": "9a5932ce-18bf-3095-87bb-b1d72135cace",
                                        "glosses": [
                                            "Signe observable biologiquement, par oppositions aux signes psychologiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5fc486b-a827-46cd-8677-910eb4b9200c",
                                                "sense_id": "0a74a365-a3b8-305b-8775-0e923e3d1dcf",
                                                "text": "Un diagnostic psychiatrique est bien plus difficile à préciser que le diabète à la suite d'une glycémie élevée! […] Pourra-t-il y avoir un jour en psychiatrie des biomarqueurs déterminants?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "171218b7-e5d4-3d1a-8f49-07218668d8cf",
                                        "entry_id": "9a5932ce-18bf-3095-87bb-b1d72135cace",
                                        "glosses": [
                                            "Molécule organique spécifique produite par des organismes vivants, utilisée pour identifier des sources biologiques dans les échantillons géologiques."
                                        ],
                                        "tags": [
                                            "Géochimie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
