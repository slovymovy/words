                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4f4c25a-929c-4e99-a9d7-7d6eb1edeeab",
                                "sense_id": "29fda0e4-7843-3dfc-96e3-2740fc4de8a8",
                                "text": "Das Terzerol passte bequem in eine Jackentasche."
                            },
                            {
                                "example_id": "df540cc6-f492-470e-b62a-26cd054111ee",
                                "sense_id": "29fda0e4-7843-3dfc-96e3-2740fc4de8a8",
                                "text": "„Das Messer ergreifend, das neben ihm hinuntergefallen war, setzte er mit einem Sprung über den umgestürzten Baum hinweg und wollte sich eben auf seinen Angreifer werfen, als dieser ihm, ohne einen Zollbreit von seiner Stelle zu weichen, ein gespanntes Terzerol entgegenhielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
