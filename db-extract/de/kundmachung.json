                        "form": "die Kundmachungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b718e3ca-0359-3434-96f1-fcbf63bfb629",
                        "entry_id": "5967dbc8-02da-3e08-9026-41185d31b695",
                        "glosses": [
                            "öffentliche Bekanntgabe von bestimmten Informationen gegenüber einer ordnungsgemäßen Sache"
                        ],
                        "tags": [
                            "Austrian German",
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "26e7f97c-0da7-42e0-84d6-eb386aff8349",
                                "sense_id": "b718e3ca-0359-3434-96f1-fcbf63bfb629",
                                "text": "Die Verordnung zur Müllabfuhr wurde per Kundmachung im Amtsblatt verlautbart."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f49b3a9-2d64-4637-ac33-4ee56ef8da7a",
                        "source_entry_id": "5967dbc8-02da-3e08-9026-41185d31b695",
                        "source_sense_id": "b718e3ca-0359-3434-96f1-fcbf63bfb629",
                        "target_lang_word": "notice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "notice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dad80823-223b-332d-87af-cb51515f42b8",
                                        "entry_id": "c475706a-c2bb-3ec5-8f8e-853beae79f71",
                                        "glosses": [
                                            "The act of observing; perception."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "358966b2-8424-489b-8e95-6b4af6d2c850",
                                                "sense_id": "dad80823-223b-332d-87af-cb51515f42b8",
                                                "text": "He took no notice of the changes, and went on as though nothing had happened."
                                            },
                                            {
                                                "example_id": "c37bc58b-5516-43d6-a41b-0ac6be660d94",
                                                "sense_id": "dad80823-223b-332d-87af-cb51515f42b8",
                                                "text": "Athelstan Arundel walked home[…], foaming and raging. […] He walked the whole way, walking through crowds, and under the noses of dray-horses, carriage-horses, and cart-horses, without taking the least notice of them."
                                            },
                                            {
                                                "example_id": "fe72f1a8-0250-4c9f-bc24-7ad72cbcadef",
                                                "sense_id": "dad80823-223b-332d-87af-cb51515f42b8",
                                                "text": "How ready is envy to mingle with the notices which we take of other persons?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2731db61-555b-3246-a569-622dcb58d947",
                                        "entry_id": "c475706a-c2bb-3ec5-8f8e-853beae79f71",
                                        "glosses": [
                                            "A written or printed announcement."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a7983a-18bd-4667-b96d-4d0caf19765f",
                                                "sense_id": "2731db61-555b-3246-a569-622dcb58d947",
                                                "text": "Shall we post a notice about the new policy?"
                                            },
                                            {
                                                "example_id": "66f52d47-e930-44e0-ad0e-01c618eadad9",
                                                "sense_id": "2731db61-555b-3246-a569-622dcb58d947",
                                                "text": "A notice was attached to the building reminding the residents about the five hour water shortage that was happening today."
                                            },
                                            {
                                                "example_id": "60d74663-3c25-4f12-b746-57f2ce9bea11",
                                                "sense_id": "2731db61-555b-3246-a569-622dcb58d947",
                                                "text": "I always read the death notices in the paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a3e0341-9ffc-3203-a60c-371213ea9fdd",
                                        "entry_id": "c475706a-c2bb-3ec5-8f8e-853beae79f71",
                                        "glosses": [
                                            "A formal notification or warning."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85099c6c-ab60-4e53-9b99-0d222b5557f9",
                                                "sense_id": "5a3e0341-9ffc-3203-a60c-371213ea9fdd",
                                                "text": "The sidewalk adjacent to the damaged bridge stonework shall be closed until further notice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f10d6f65-9eff-31b5-80f5-4fc32c8a8bd5",
                                        "entry_id": "c475706a-c2bb-3ec5-8f8e-853beae79f71",
                                        "glosses": [
                                            "Advance notification of termination of employment, given by an employer to an employee or vice versa."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f85a66a2-ba16-4cd8-b459-ad3a3b67bea4",
                                                "sense_id": "f10d6f65-9eff-31b5-80f5-4fc32c8a8bd5",
                                                "text": "I gave her her mandatory two weeks' notice and sacked her."
                                            },
                                            {
                                                "example_id": "e15e7241-115f-4548-beb9-777d2981e842",
                                                "sense_id": "f10d6f65-9eff-31b5-80f5-4fc32c8a8bd5",
                                                "text": "I can't work here any longer. I'm giving notice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6837082-c785-3b79-aa04-e5a56d296ded",
                                        "entry_id": "c475706a-c2bb-3ec5-8f8e-853beae79f71",
                                        "glosses": [
                                            "A published critical review of a play or the like."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99033ea7-82d0-46a1-9c4c-c56f9cfd705d",
                                                "sense_id": "a6837082-c785-3b79-aa04-e5a56d296ded",
                                                "text": "The first-night audience, yes. The first-night reviewers, not exactly. The notices have so far been mixed, only The Financial Times having delivered itself of an unequivocal rave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa05893d-b4bf-38d1-96a4-ad486a956a32",
                                        "entry_id": "c475706a-c2bb-3ec5-8f8e-853beae79f71",
                                        "glosses": [
                                            "Prior notification."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b096480e-dd13-42b0-b694-56ca5a71c291",
                                                "sense_id": "aa05893d-b4bf-38d1-96a4-ad486a956a32",
                                                "text": "I don't mind if you want to change the venue; just give me some notice first, OK?"
                                            },
                                            {
                                                "example_id": "82961ab0-57d9-4b58-9c15-6acc36969d9a",
                                                "sense_id": "aa05893d-b4bf-38d1-96a4-ad486a956a32",
                                                "text": "I have been with your father and given him notice that the Duke of Cornwall and Regan his duchess will be here with him this night."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82e02193-763c-36c5-8d11-3875524f2ed0",
                                        "entry_id": "c475706a-c2bb-3ec5-8f8e-853beae79f71",
                                        "glosses": [
                                            "Attention; respectful treatment; civility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "notice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a64e047-d5ba-3049-b85e-7163cdac0bf3",
                                        "entry_id": "552877b8-67d0-3947-b22b-38473c99e8a6",
                                        "glosses": [
                                            "To remark upon; to mention."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0bd8b27-fd60-42a4-bdab-d6062b634cb3",
                                                "sense_id": "7a64e047-d5ba-3049-b85e-7163cdac0bf3",
                                                "text": "Numberless are the arguments […] that men have used morally and physically, to degrade the sex. I must notice a few."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c1a7345-f3f5-36a7-8bb4-7e3a66b942dd",
                                        "entry_id": "552877b8-67d0-3947-b22b-38473c99e8a6",
                                        "glosses": [
                                            "To become aware of; to observe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b47a856f-20b9-48fe-9c1e-ed31d8f9f118",
                                                "sense_id": "6c1a7345-f3f5-36a7-8bb4-7e3a66b942dd",
                                                "text": "Did you notice the flowers in her yard?"
                                            },
                                            {
                                                "example_id": "5b2f1183-183e-4543-b6d5-e5920b473bb1",
                                                "sense_id": "6c1a7345-f3f5-36a7-8bb4-7e3a66b942dd",
                                                "text": "So you punched out a window for ventilation. Was that before or after you noticed you were standing in a lake of gasoline?"
                                            },
                                            {
                                                "example_id": "c20d6b53-0e97-4514-adf1-bc66f883e70d",
                                                "sense_id": "6c1a7345-f3f5-36a7-8bb4-7e3a66b942dd",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across. Such pits are about the size of a bacterial cell. Closer examination showed that some of these pits did, indeed, contain bacteria, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a0bf56a-6d2d-38a6-8157-d2fafd664599",
                                        "entry_id": "552877b8-67d0-3947-b22b-38473c99e8a6",
                                        "glosses": [
                                            "To lavish attention upon; to treat (someone) favourably."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ed9351-6b68-4fa5-92da-555db21b0e96",
                                                "sense_id": "5a0bf56a-6d2d-38a6-8157-d2fafd664599",
                                                "text": "She would notice her; she would improve her; she would detach her from her bad acquaintance, and introduce her into good society; she would form her opinions and her manners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0f93517-e4aa-380b-bbea-4b351428c39d",
                                        "entry_id": "552877b8-67d0-3947-b22b-38473c99e8a6",
                                        "glosses": [
                                            "To be noticeable; to show."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8181d5f7-c61e-4468-8a8c-3bb2350bff20",
                                                "sense_id": "f0f93517-e4aa-380b-bbea-4b351428c39d",
                                                "text": "The blackness didn't notice so much when she was born; but it's unmistakeable now."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb301f42-576a-42c8-a1c2-3865b58f1fe9",
                        "source_entry_id": "5967dbc8-02da-3e08-9026-41185d31b695",
                        "source_sense_id": "b718e3ca-0359-3434-96f1-fcbf63bfb629",
                        "target_lang_word": "announcement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "announcement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "270cd55b-a471-3a9c-9ec5-c712222d05d2",
                                        "entry_id": "6b19a5ec-3949-37b6-a792-7bc57f21940b",
                                        "glosses": [
                                            "An act of announcing, or giving notice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4db82f24-0394-4e90-af27-f15c15170461",
                                                "sense_id": "270cd55b-a471-3a9c-9ec5-c712222d05d2",
                                                "text": "He raised his hand to make his announcement and said, \"Excuse me everyone, I have an announcement to make.\""
                                            },
                                            {
                                                "example_id": "cc69f6df-c7ea-44ac-8eea-6ea76f41a500",
                                                "sense_id": "270cd55b-a471-3a9c-9ec5-c712222d05d2",
                                                "text": "Where else in the world can you pre-order sushi and fondue on some of the trains, travel in family carriages equipped with mini-playgrounds, or use a request stop button at some small stations? Where else can you hear the announcement: \"The train at Platform 4 is ten minutes late due to an incident in another country,\" as I did once at the Swiss station of Spiez?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb782c23-2cfc-320c-8507-74b7bdf55019",
                                        "entry_id": "6b19a5ec-3949-37b6-a792-7bc57f21940b",
                                        "glosses": [
                                            "That which conveys what is announced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fed345d-aad2-411c-8c5c-4e12133a1063",
                                                "sense_id": "fb782c23-2cfc-320c-8507-74b7bdf55019",
                                                "text": "This announcement was made during the first training session."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdfd8ebc-9aed-38a2-a8b1-e56754ae36e9",
                                        "entry_id": "6b19a5ec-3949-37b6-a792-7bc57f21940b",
                                        "glosses": [
                                            "The content which is announced."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd1c62a1-7956-43bf-bc25-3df056a43231",
                                                "sense_id": "cdfd8ebc-9aed-38a2-a8b1-e56754ae36e9",
                                                "text": "The announcement implied that somebody needed a spare Toshiba charger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f5a9c9c-5b42-4ee4-a81e-f721ec8e1bdf",
                        "source_entry_id": "5967dbc8-02da-3e08-9026-41185d31b695",
