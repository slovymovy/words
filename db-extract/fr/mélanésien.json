                "senses": [
                    {
                        "sense_id": "bb9e5149-e3dd-369d-8866-3380603b47df",
                        "entry_id": "25636ccc-9343-3d58-8895-55d64b9ab3b3",
                        "glosses": [
                            "Habitant ou natif de la Mélanésie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "226566d9-c21d-4502-a480-cd2c020f569b",
                                "sense_id": "bb9e5149-e3dd-369d-8866-3380603b47df",
                                "text": "Enfin, seul un Mélanésien sur six et demi avait suivi des études secondaires ou supérieures contre un Européen sur deux."
                            },
                            {
                                "example_id": "1fe9fa0c-a050-4ced-a090-1ab2de9e6abb",
                                "sense_id": "bb9e5149-e3dd-369d-8866-3380603b47df",
                                "text": "Le Mélanésien, en effet, est resté pendant des millénaires (la remarque vaut également pour d’autres peuples) fondu dans son groupe et le monde physique environnant, sans avoir une conscience claire de lui-même et de son autonomie, parce que lui faisait défaut une représentation nette du corps."
                            }
                        ]
                    }
                ],
