                                        "entry_id": "cfe9cd53-0427-3dbf-86be-222ec079e9cf",
                                        "glosses": [
                                            "A long, slender ship propelled primarily by oars, whether having masts and sails or not; usually a rowed warship used in the Mediterranean from the 16th century until the modern era."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "704890f1-8b68-387a-ad45-8a6e14c4c74f",
                                        "entry_id": "cfe9cd53-0427-3dbf-86be-222ec079e9cf",
                                        "glosses": [
                                            "A light, open boat used on the Thames by customhouse officers, press gangs, and also for pleasure."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b1e2d94-2bb8-3dc7-b5a7-2b0a39b6efc2",
                                        "entry_id": "cfe9cd53-0427-3dbf-86be-222ec079e9cf",
                                        "glosses": [
                                            "One of the small boats carried by a man-of-war."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fc2f749-d20b-3f45-945c-27f5763ff838",
                                        "entry_id": "cfe9cd53-0427-3dbf-86be-222ec079e9cf",
                                        "glosses": [
                                            "The cookroom or kitchen and cooking apparatus of a vessel or aircraft; sometimes on merchant vessels called the caboose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "30760cb5-d52a-337a-89a1-a0b8e6560d20",
                                        "entry_id": "cfe9cd53-0427-3dbf-86be-222ec079e9cf",
                                        "glosses": [
                                            "An oblong oven or muffle with a battery of retorts; a gallery furnace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a843579f-392e-331f-859a-60de69b6ecb6",
                                        "entry_id": "cfe9cd53-0427-3dbf-86be-222ec079e9cf",
                                        "glosses": [
                                            "An oblong tray of wood or brass, with upright sides, for holding type which has been set, or is to be made up, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "483039cf-d6e3-462c-97c4-146eeaebca7c",
                                                "sense_id": "a843579f-392e-331f-859a-60de69b6ecb6",
                                                "text": "It was very nerve-racking. When I was finally able to write the story, I wrote it at the typewriter and never reread it until I had to edit the typos on the printer's galleys for the publication of the book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8050dcc4-afb7-3cea-860b-1bf64e80dc6c",
                                        "entry_id": "cfe9cd53-0427-3dbf-86be-222ec079e9cf",
                                        "glosses": [
                                            "A proof sheet taken from type while on a galley; a galley proof."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46b37338-fd63-3f0a-876f-04de45f91a00",
                                        "entry_id": "cfe9cd53-0427-3dbf-86be-222ec079e9cf",
                                        "glosses": [
                                            "A representation of a single-masted ship propelled by oars, with three flags and a basket."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53565aa1-08b1-4e43-890a-580ca2fb549c",
                        "source_entry_id": "8bdd6433-6686-3f6f-b420-529ff315ecb4",
                        "source_sense_id": "43873971-4e71-3f4b-bdce-c7ee699e85e1",
                        "source_sense_description": "die Küche auf einem Schiff",
                        "target_lang_word": "caboose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caboose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9794317f-6bcd-3a74-8a3f-3cb9e7680a2d",
                                        "entry_id": "8e54c177-24b3-3abf-aeae-20edc48985f4",
                                        "glosses": [
                                            "A small galley or cookhouse on the deck of a small vessel."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72a056c6-c4d3-3dd7-aa81-066c61ca27d1",
                                        "entry_id": "8e54c177-24b3-3abf-aeae-20edc48985f4",
                                        "glosses": [
                                            "A small sand-filled container used as an oven on board ship."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25c8e9b0-cd66-4231-a576-db6880b4c5ff",
                                                "sense_id": "72a056c6-c4d3-3dd7-aa81-066c61ca27d1",
                                                "text": "On the second day out, while sailing moderately on our course in the Gulf Stream, a sudden squall of wind struck the ship from the SW. and knocked her completely on her beam-ends, stove one of our boats, entirely destroyed two others, and threw down the cambouse."
                                            },
                                            {
                                                "example_id": "ea21afb1-85f4-4ef7-b8ba-ceba9dc39719",
                                                "sense_id": "72a056c6-c4d3-3dd7-aa81-066c61ca27d1",
                                                "text": "This stove is to be made in the form of a Franklin, but is to be furnished with an oven, and other means of cooking; its appearance is therefore more like that of the old fashioned caboose, than of a Franklin stove."
                                            },
                                            {
                                                "example_id": "64196d0a-994e-4c55-b1a3-c7f9343d984e",
                                                "sense_id": "72a056c6-c4d3-3dd7-aa81-066c61ca27d1",
                                                "text": "A tremendous billow, fringed with foam, swept over our deck, carrying the cook's caboose, cooking utensils and stove right overboard into the sea."
                                            },
                                            {
                                                "example_id": "7e03fa39-f0f5-4410-94ee-1aba9ad2dacd",
                                                "sense_id": "72a056c6-c4d3-3dd7-aa81-066c61ca27d1",
                                                "text": "The kitchens were kept separate because cooking was done in a caboose, a wooden box filled with sand and heated by a wood fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffa3ded9-a1d8-38bb-9c6a-b8fd957c3146",
                                        "entry_id": "8e54c177-24b3-3abf-aeae-20edc48985f4",
                                        "glosses": [
                                            "The last car on a freight train, consisting of cooking and sleeping facilities for the crew; a guard’s van."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d7f8dfd-cbc0-33bc-8aba-f8f0a46a5751",
                                        "entry_id": "8e54c177-24b3-3abf-aeae-20edc48985f4",
                                        "glosses": [
                                            "The buttocks."
                                        ],
                                        "tags": [
                                            "childish",
                                            "euphemistic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2a07d6e-793c-446c-8b32-24584bb038e9",
                                                "sense_id": "7d7f8dfd-cbc0-33bc-8aba-f8f0a46a5751",
                                                "text": "That's a pretty big caboose for a baby."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf198267-42aa-3de5-8850-3f60591a277c",
                                        "entry_id": "8e54c177-24b3-3abf-aeae-20edc48985f4",
                                        "glosses": [
                                            "The person or team in last place."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c317ed6f-b646-30bb-b3e7-bff9a02f603f",
                                        "entry_id": "8e54c177-24b3-3abf-aeae-20edc48985f4",
                                        "glosses": [
                                            "A youngest child who is born after a long gap in time."
                                        ],
                                        "tags": [
                                            "in-compounds",
                                            "informal",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13026ac3-4973-485d-bfb2-1c8aa9dfe420",
                                                "sense_id": "c317ed6f-b646-30bb-b3e7-bff9a02f603f",
                                                "text": "Jimmy was seven and had just finished first grade, so that made Nancy our caboose baby — our bonus child — our swan song."
                                            },
                                            {
                                                "example_id": "675ba159-00a0-44e4-877e-1ed45c8af906",
                                                "sense_id": "c317ed6f-b646-30bb-b3e7-bff9a02f603f",
                                                "text": "\"Caboose\" children, the late-born last offspring in the family, didn't suffer from this as much."
                                            },
                                            {
                                                "example_id": "4f73b794-edfa-4795-8c23-89384e02e159",
                                                "sense_id": "c317ed6f-b646-30bb-b3e7-bff9a02f603f",
                                                "text": "After looking back on her own experience, she thought of some ways parents could help ease the transition for their caboose kid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
