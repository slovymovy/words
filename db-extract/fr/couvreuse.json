                "senses": [
                    {
                        "sense_id": "ed8bd99e-1a8b-3b47-9bdf-93c21a439003",
                        "entry_id": "ae6abcb6-1f37-30cd-9dd3-409918c16710",
                        "glosses": [
                            "Celle qui fait les couvertures des bâtiments."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "aa0a7d2c-3dee-4ff3-9332-3d3cf049ebd7",
                                "sense_id": "ed8bd99e-1a8b-3b47-9bdf-93c21a439003",
                                "text": "La couvreuse est également… masseuse ! Une vie de « slasheuse », tout en équilibre."
                            },
                            {
                                "example_id": "0d1fd890-10e4-4b00-b38a-fe0ec99e7f9c",
                                "sense_id": "ed8bd99e-1a8b-3b47-9bdf-93c21a439003",
                                "text": "Maéva Parent, couvreuse-zingueuse et cheffe d’entreprise installée à Scaër (29), a reçu le prix « Professionnel de la reconversion » du concours organisé par le magazine spécialisé Artisans."
                            },
                            {
                                "example_id": "02ed9a74-82b9-47a8-8cbc-616f9501cac3",
                                "sense_id": "ed8bd99e-1a8b-3b47-9bdf-93c21a439003",
                                "text": "Habillée d’un simple t-shirt rose et d’une doudoune sans manches, la couvreuse ne rechigne pas à la tâche."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3aea213-775d-3982-930c-3b066cc27018",
                        "entry_id": "ae6abcb6-1f37-30cd-9dd3-409918c16710",
                        "glosses": [
                            "Officière chargée de garder la porte du temple."
                        ],
                        "tags": [
                            "Franc-maçonnerie"
                        ],
                        "examples": [
                            {
                                "example_id": "b11baef7-abfd-4a4a-9e1d-9ef3c66ce5ce",
                                "sense_id": "e3aea213-775d-3982-930c-3b066cc27018",
                                "text": "Alors ce mot de semestre… s’impatiente la sœur couvreuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "59cacf1e-ae4a-3a9e-965d-46daf811920a",
                        "entry_id": "ae6abcb6-1f37-30cd-9dd3-409918c16710",
                        "glosses": [
                            "Celle qui couvre de paille les chaises."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "628f59eb-2187-3ad3-812a-1b4470181998",
                        "entry_id": "ae6abcb6-1f37-30cd-9dd3-409918c16710",
                        "glosses": [
                            "Épouse d’un couvreur."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f446f14a-3e11-44ee-9d2a-285b4314bae5",
                                "sense_id": "628f59eb-2187-3ad3-812a-1b4470181998",
                                "text": "De même, en parlant de la femme d’un afficheur, d’un couvreur, d’un paveur, d’un tourneur, etc., on dit, l’afficheuse, la couvreuse, la paveuse, la tourneuse, etc., par la même analogie qu’on dit, la charbonnière, la perruquière, la chapelière, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9f58df5-98f1-356d-9e9c-077b70d20dc2",
                        "entry_id": "ae6abcb6-1f37-30cd-9dd3-409918c16710",
                        "glosses": [
                            "Machine servant à recouvrir les objets d’un film de plastique."
                        ],
                        "tags": [],
                        "examples": []
                    }
