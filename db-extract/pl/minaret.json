                        ]
                    },
                    {
                        "translation_id": "5020e5bd-e0c7-4934-88af-8dafc3dd8f72",
                        "source_entry_id": "9ec500ba-154c-34fa-9942-6b05a28497fc",
                        "source_sense_id": "e6231a4d-9461-31e1-8ece-693f4fe3ef14",
                        "target_lang_word": "Minarett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Minarett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                        "entry_id": "436f6be5-1baa-303b-b87a-24fa55fa4e0c",
                                        "glosses": [
                                            "Turm an oder bei einer Moschee, von dem aus (früher) der Muezzin fünfmal täglich zum Gebet ruft (und der in modernen Moscheen heutzutage nur noch der traditionellen Zierde dient)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0f7c7df-7098-44b1-bb5c-b9f6d9d784b2",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "Vom Minarett erklang der Ruf des Muezzins."
                                            },
                                            {
                                                "example_id": "61bffbc8-72d6-4313-902e-67e3951f8950",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Wir stiegen uns aufs Dach und sahen hinunter auf Damaskus mit seinen Minaretts und seinem Moscheegekuppel, und dies war es, was wir sahen:[…]“"
                                            },
                                            {
                                                "example_id": "6dd20105-affc-4dac-86ca-3271f1ab45df",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Vom nahen Minarett ertönt der Gesang des bärtigen Moslems, der dort Allah ehrt, und die zarten Wölkchen der Zigaretten kräuseln sich um die entschleierten Angesichter schwarzäugiger Türkinnen.“"
                                            },
                                            {
                                                "example_id": "70243c6c-81f1-4853-a67f-08d915b4a50f",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Die Grüppchen der Händler vermengen sich noch mit der Halqa (dem Zuschauerkreis) inmitten der umherstreichenden, einladenden Dampfschwaden aus den Küchen; das Minarett der Kutubiya wacht standhaft über die ewige Seligkeit der Toten und das getriebene Dasein der Lebenden.“"
                                            },
                                            {
                                                "example_id": "268f8f82-0af0-48d8-b405-7a1e65dcb35b",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Ein historisches Minarett in der irakischen Stadt Samarra ist nach Berichten von Augenzeugen durch eine Explosion beschädigt worden.“"
                                            },
                                            {
                                                "example_id": "908703ac-8b12-4579-9cc3-b8b455d50d97",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Der französische Außenminister Bernard Kouchner hat sich am Montag schockiert über das Ergebnis der Schweizer Volksabstimmung zum Bau von Minaretten gezeigt. \"Wenn man keine Minarette mehr bauen kann, dann bedeutet es, dass man eine Religion unterdrückt\", sagte Kouchner dem Sender […].“"
                                            },
                                            {
                                                "example_id": "0d730ec5-b19b-408d-b680-485b203c4499",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Die Schweizer hatten der Forderung nach einem Bauverbot für Minarette von zwei rechtspopulistischen Parteien am Sonntag mit mehr als 57 Prozent zugestimmt.“"
                                            },
                                            {
                                                "example_id": "fdff519d-b40b-4fda-a082-31ae2e1f2caa",
                                                "sense_id": "a03efc90-5777-34ab-87aa-bc637128c0f8",
                                                "text": "„Entscheidungen wie der Schweizer Volksentscheid gegen den Bau neuer Minarette schürten eine krankhafte Furcht vor dem Islam und Vorurteile gegen Fremde in Europa, zitierte die amtliche Nachrichtenagentur IRNA das Außenministerium in Teheran.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
