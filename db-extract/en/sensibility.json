    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8137bf4c-4f41-3055-90a7-a99414387143",
                "word": "sensibility",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a9d8b15c-fca0-4a60-8cf2-6fdf30658fd8",
                        "entry_id": "8137bf4c-4f41-3055-90a7-a99414387143",
                        "tags": [
                            "plural"
                        ],
                        "form": "sensibilities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3092d380-16fb-3b70-84c3-ed81fcbb0b58",
                        "entry_id": "8137bf4c-4f41-3055-90a7-a99414387143",
                        "glosses": [
                            "The ability to sense, feel or perceive; responsiveness to sensory stimuli; sensitivity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d604ac72-16b6-4a44-94dc-815a851be2ce",
                                "sense_id": "3092d380-16fb-3b70-84c3-ed81fcbb0b58",
                                "text": "The high sensibility of the divided ring electrometer renders this test really very easy […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "2adcbc05-9403-339f-bd1a-4197ab43c33d",
                        "entry_id": "8137bf4c-4f41-3055-90a7-a99414387143",
                        "glosses": [
                            "Emotional or artistic awareness; keen sensitivity to matters of feeling or creative expression."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e235b641-7c7a-43bf-9045-82d653e062ec",
                                "sense_id": "2adcbc05-9403-339f-bd1a-4197ab43c33d",
                                "text": "By poetic ethic I am speaking about the intention to act on, and incorporate into a narrative configuration, values and beliefs that promote a poetic ontology and a poetic sensibility."
                            },
                            {
                                "example_id": "9d0d0832-a093-4cce-a276-c7237ddebf80",
                                "sense_id": "2adcbc05-9403-339f-bd1a-4197ab43c33d",
                                "text": "“This man has just arrived to the leadership … But from what is apparent, this man has a high level of political sensibility, that is vastly different than the one who preceded him,” she told CNN."
                            }
                        ]
                    },
                    {
                        "sense_id": "b331068d-f188-3e3d-9a17-0f4d50c3b8a2",
                        "entry_id": "8137bf4c-4f41-3055-90a7-a99414387143",
                        "glosses": [
                            "Excessive emotional awareness; the fact or quality of being overemotional."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "834d4c43-6582-4395-baff-cf797f976963",
                                "sense_id": "b331068d-f188-3e3d-9a17-0f4d50c3b8a2",
                                "text": "People of sensibility have seldom good tempers."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b0664b1-e5d6-3dd1-9b08-92398345c7c6",
                        "entry_id": "8137bf4c-4f41-3055-90a7-a99414387143",
                        "glosses": [
                            "An acute awareness or feeling."
                        ],
                        "tags": [
                            "countable",
                            "in-plural",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0bd636c7-d7e2-4975-97a6-95b70ee784ae",
                                "sense_id": "4b0664b1-e5d6-3dd1-9b08-92398345c7c6",
                                "text": "I apologize if I offended your sensibilities, but that's the truth of the matter."
                            },
                            {
                                "example_id": "1826f560-ca43-4ffe-a210-d94ce46fbff4",
                                "sense_id": "4b0664b1-e5d6-3dd1-9b08-92398345c7c6",
                                "text": "However, given current sensibilities about individual privacy and data protection, the recording of oral data is becoming increasingly onerous for researchers[.]"
                            },
                            {
                                "example_id": "d8519769-6145-476a-b3df-601e6854b086",
                                "sense_id": "4b0664b1-e5d6-3dd1-9b08-92398345c7c6",
                                "text": "Many earnest consumers on the Right feel so legitimately embattled by the nonstop streaming feed of hate speech and psyoppery directed at them that they think they have no choice but to reconfigure their artistic sensibilities accordingly."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f439144-4f10-38b9-9951-0b2822ee6721",
                        "entry_id": "8137bf4c-4f41-3055-90a7-a99414387143",
                        "glosses": [
                            "The capacity to be perceived by the senses."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7074f53-59fb-4857-8982-658f85d3a77c",
                        "source_entry_id": "8137bf4c-4f41-3055-90a7-a99414387143",
                        "source_sense_description": "ability to sense; responsiveness to stimuli",
                        "target_lang_word": "Sensibilität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sensibilität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7503db9-3268-36c4-8516-aa5a5a5a0056",
                                        "entry_id": "30f0b3e1-58b0-3b0a-af4f-811b4cc146ad",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße empfindsame (sensible) Aufnahmebereitschaft für Signale der Umgebung und entsprechendes, reagierendes Verhalten zeigt"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0e7a1a4-1313-40c0-bf1f-f60c49263aa9",
                                                "sense_id": "b7503db9-3268-36c4-8516-aa5a5a5a0056",
                                                "text": "„Aber genau wie Schüchternheit ist Sensibilität eine Eigenschaft für sich, die manchmal – aber längst nicht immer – mit Introversion einhergeht.“"
                                            },
                                            {
                                                "example_id": "738374cd-6b7c-44c8-bc8c-2a5cf131d3d6",
                                                "sense_id": "b7503db9-3268-36c4-8516-aa5a5a5a0056",
                                                "text": "„Der Gleitschirmflieger benötigt Geschicklichkeit für das Aufziehen seines Segels, Sensibilität für das Schirmverhalten im Fluge und die Auf- und Abwindströmungen.“"
                                            },
                                            {
                                                "example_id": "4d67c267-8e57-45bb-829c-63ce50fbfd17",
                                                "sense_id": "b7503db9-3268-36c4-8516-aa5a5a5a0056",
                                                "text": "„Das Gefühl von Wachheit und Sensibilität trage sie durch das ganze Konzert.“"
                                            },
                                            {
                                                "example_id": "b58f2ec5-977a-428f-baa3-f2e967d0bcbf",
                                                "sense_id": "b7503db9-3268-36c4-8516-aa5a5a5a0056",
                                                "text": "„Dieser Mann hat Einfühlungsvermögen, Sensibilität, soziale Intelligenz und Kommunikationsfähigkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a9d4e225-5224-3a5d-a04b-4e3027041cf8",
                                        "entry_id": "30f0b3e1-58b0-3b0a-af4f-811b4cc146ad",
                                        "glosses": [
                                            "Empfindlichkeit für Reize und besonders auch Schmerz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "376bf71b-c8e8-4213-9a8f-ae513cf93cae",
                                                "sense_id": "a9d4e225-5224-3a5d-a04b-4e3027041cf8",
                                                "text": "„Unter somatoviszeraler Sensibilität versteht man alle Empfindungen, die durch Reizung der Sinnessensoren des Körpers mit Ausnahme der Sinnesorgane Auge, Ohr, Nase und Zunge ausgelöst werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8941b71c-846f-3054-882d-a51c2779cb8b",
                                        "entry_id": "30f0b3e1-58b0-3b0a-af4f-811b4cc146ad",
                                        "glosses": [
                                            "Empfindlichkeit des Filmmaterials für Licht"
                                        ],
                                        "tags": [
                                            "Fotografie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dca537c1-8439-474b-9de4-2c09ba1a29e4",
                                                "sense_id": "8941b71c-846f-3054-882d-a51c2779cb8b",
                                                "text": "„Die Empfindlichkeit kennzeichnet die Sensibilität des Sensors/Films gegenüber Lichteinfall.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
