                {
                    "sense_id": "e09c1765-d403-31d8-b940-dc21e0d4c3ad",
                    "sense_definition": "Forma gramatyczna (dopełniacz liczby pojedynczej lub mianownik liczby mnogiej) rzeczownika <w>zwłoka</w>, oznaczającego opóźnienie lub odroczenie działania.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Musimy działać natychmiast, bez żadnej zbędnej <zwłoki>.",
                            "target_lang_translations": {
