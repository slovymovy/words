        "ru-extract.jsonl": [
            {
                "entry_id": "fddff7ae-247e-307b-961f-e1ae860d193c",
                "word": "усиленно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "876f7d1d-2d1e-399d-97f5-79b0c0247479",
                        "entry_id": "fddff7ae-247e-307b-961f-e1ae860d193c",
                        "glosses": [
                            "наречие к усиленный; с большей, чем обычно, силой"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "f0581160-a2fe-43ab-925a-fa7dfb464ca0",
                                "sense_id": "876f7d1d-2d1e-399d-97f5-79b0c0247479",
                                "text": "У всех были возбужденные лица, все что-то говорили и усиленно жестикулировали."
                            }
                        ]
                    },
                    {
                        "sense_id": "a91503a2-1b38-3088-9909-77413883fecf",
                        "entry_id": "fddff7ae-247e-307b-961f-e1ae860d193c",
                        "glosses": [
                            "настойчиво, упорно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f19ed8-b7ac-4a47-9b79-72c75906f825",
                                "sense_id": "a91503a2-1b38-3088-9909-77413883fecf",
                                "text": "Парни помогли ей занести вещи в комнату общежития и едва отвязались от неё, поскольку она усиленно зазывала их к себе на ночлег."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f4ab35c-e89e-47ae-8d66-1127eb21846b",
                        "source_entry_id": "fddff7ae-247e-307b-961f-e1ae860d193c",
                        "source_sense_description": "с большей, чем обычно, силой",
                        "target_lang_word": "strenuously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strenuously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "591ac514-02da-3bbe-837d-98217f6d4595",
                                        "entry_id": "bc1d6bc6-9ef2-38e8-963e-096cfec40d32",
                                        "glosses": [
                                            "In a strenuous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61dad049-5ff8-45b0-b198-e08d0cc75ba8",
                                                "sense_id": "591ac514-02da-3bbe-837d-98217f6d4595",
                                                "text": "By my direction, however, the head of his unwieldy machine was so critically pointed that, feeling him foreright against the tender opening, a favourable motion from me met his timely thrust, by which the lips of it, strenuously dilated, gave way to his thus assisted impetuosity, so that we might both feel that he had gain'd a lodgement.",
                                                "translation": "Fanny Hill",
                                                "english": "Fanny Hill"
                                            },
                                            {
                                                "example_id": "0aab3bc4-f2dd-4117-9d5c-fd85bd6bc7d9",
                                                "sense_id": "591ac514-02da-3bbe-837d-98217f6d4595",
                                                "text": "Dorcas, faithful to her “young gentlemen,” denied strenuously that it could have been John’s voice she heard, and resolutely declared, in the teeth of everything, that it was Mr. Inglethorp who had been in the boudoir with her mistress."
                                            },
                                            {
                                                "example_id": "602520ce-4c69-469f-8f56-98a15557fd4e",
                                                "sense_id": "591ac514-02da-3bbe-837d-98217f6d4595",
                                                "text": "Not only did I oppose President George H.W. Bush on his China policy, I strenuously disagreed with Democratic President Bill Clinton on his trade and human rights policies toward China and Tibet as well. This was difficult because I otherwise greatly supported and admired his leadership."
                                            },
                                            {
                                                "example_id": "98cabb6a-889b-4f10-9c32-70d690cb4c11",
                                                "sense_id": "591ac514-02da-3bbe-837d-98217f6d4595",
                                                "text": "Journalists are strenuously objecting to the plan."
                                            },
                                            {
                                                "example_id": "924833eb-ed55-41c6-8e9c-50167718ae62",
                                                "sense_id": "591ac514-02da-3bbe-837d-98217f6d4595",
                                                "text": "[W]hen Chauvin’s trial for his alleged role in Floyd’s death begins, much of the argument will center instead on the autopsy details, most specifically whether fentanyl and underlying health conditions — not the police officer’s actions — stopped Floyd’s heart and lungs. Seven experts in toxicology, cardiology and illegal drug use consulted by The Washington Post largely disagreed with that idea, most of them strenuously."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16116851-7af4-47f3-8ccb-51a2a1d1f72b",
                        "source_entry_id": "fddff7ae-247e-307b-961f-e1ae860d193c",
