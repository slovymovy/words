                "translations": [
                    {
                        "translation_id": "ca8c40a8-b04c-430c-b5fd-78a6ace67cc5",
                        "source_entry_id": "277f7bee-e8e9-3f16-980a-5c646263f1e8",
                        "source_sense_id": "d01dfb20-e973-30a9-a1c5-258e2f490a29",
                        "source_sense_description": "Person, die menschliches Blut von freiwilligen Spendern trinkt",
                        "target_lang_word": "vampire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vampire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2ecb982-755a-3146-86f5-69c4107f37d8",
                                        "entry_id": "41b409ac-f6d5-37cf-a0d6-cb3805191013",
                                        "glosses": [
                                            "A mythological creature (usually humanoid and undead) said to feed on the blood or life energy of the living."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be52feca-2801-428c-8da4-119fa0d17128",
                                                "sense_id": "a2ecb982-755a-3146-86f5-69c4107f37d8",
                                                "text": "Bram Stoker's novel Dracula built on centuries-old stories of vampires and also encouraged new growth of the mythology."
                                            },
                                            {
                                                "example_id": "f2acaa9d-be55-4f59-8cc1-fb1b2515a277",
                                                "sense_id": "a2ecb982-755a-3146-86f5-69c4107f37d8",
                                                "text": "[I]n the Village of Medreyga in Hungary, certain dead Bodies (call'd there Vampyres) had kill'd several Persons by sucking out all their Blood: That Arnold Paul, an Heyduke, having kill'd four Persons after he was dead, his Body was taken up 40 Days after, which bled at the Nose, Mouth and Ears: That, according to Custom, they drove a Stake thro' his Heart, at which he gave horrid Groan, and lost a great deal of Blood. And that all such as have been tormented or kill'd by Vampyres, become Vampyres when they are dead."
                                            },
                                            {
                                                "example_id": "aa8c31ef-4485-4ff1-906e-53c44ecc2a21",
                                                "sense_id": "a2ecb982-755a-3146-86f5-69c4107f37d8",
                                                "text": "The universal belief is, that a person sucked by a vampyre becomes a vampyre himself, and sucks in his turn."
                                            },
                                            {
                                                "example_id": "713570ec-2967-498a-9ecd-8593478d503b",
                                                "sense_id": "a2ecb982-755a-3146-86f5-69c4107f37d8",
                                                "text": "From my laboratory in the Castle east\nTo the master bedroom, where the vampires feast\nThe ghouls all came from their humble abodes\nTo get a jolt from my electrodes\nThey did the Mash\nThey did the Monster Mash."
                                            },
                                            {
                                                "example_id": "2f6a2015-8778-4b75-a074-8bc7e3b57310",
                                                "sense_id": "a2ecb982-755a-3146-86f5-69c4107f37d8",
                                                "text": "I'm a vampire, baby, sucking blood from the earth / Well, I'm a vampire, baby, sell you twenty barrels worth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "362c818b-80de-3580-a066-7a50e94845e7",
                                        "entry_id": "41b409ac-f6d5-37cf-a0d6-cb3805191013",
                                        "glosses": [
                                            "A person with habits traditionally ascribed to (literal) vampires, such as heliophobia, being a night owl, having pale skin, and so on."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2212195-764a-4332-9e16-1db865f6fb20",
                                                "sense_id": "362c818b-80de-3580-a066-7a50e94845e7",
                                                "text": "Near-synonyms: heliophobe, goth"
                                            },
                                            {
                                                "example_id": "2782867d-d48b-44b4-80cb-f97336c50b81",
                                                "sense_id": "362c818b-80de-3580-a066-7a50e94845e7",
                                                "text": "Somehow I doubt that Kelly will want to go surfing with us — she's such a vampire that she might recoil from the sun, lol!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6f22c39-60c5-3dc6-a8d7-1efd2ac24f5c",
                                        "entry_id": "41b409ac-f6d5-37cf-a0d6-cb3805191013",
                                        "glosses": [
                                            "A person with the medical condition porphyria cutanea tarda, colloquially known as vampirism, with effects such as photosensitivity and brownish-red stained teeth."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59a05b01-de33-3a63-acb0-7c0b4b97ec5b",
                                        "entry_id": "41b409ac-f6d5-37cf-a0d6-cb3805191013",
                                        "glosses": [
                                            "A blood-sucking bat; vampire bat (Desmodus rotundus)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25727a71-5705-3d20-9b7e-6b3bd19cc833",
                                        "entry_id": "41b409ac-f6d5-37cf-a0d6-cb3805191013",
                                        "glosses": [
                                            "A person who drains one's time, energy, money, etc."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1464b3dc-80ab-4f22-91c5-5b6b527057c1",
                                                "sense_id": "25727a71-5705-3d20-9b7e-6b3bd19cc833",
                                                "text": "emotional vampire"
                                            },
                                            {
                                                "example_id": "99eaba96-7a66-4b0d-8e02-5e4d3a8f1a2b",
                                                "sense_id": "25727a71-5705-3d20-9b7e-6b3bd19cc833",
                                                "text": "You have to be careful what you tell her, because she's such a vampire for drama."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae9bff69-58db-320a-8010-e4364489d0e8",
                                        "entry_id": "41b409ac-f6d5-37cf-a0d6-cb3805191013",
                                        "glosses": [
                                            "A vamp: a seductive woman who exploits men."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bb0a808-c0f5-412a-8c4c-82634327fd3b",
                                                "sense_id": "ae9bff69-58db-320a-8010-e4364489d0e8",
                                                "text": "\"What followed this decision was exactly what we had expected: Mr. Fox, realizing that the public was tiring of Theda Bara in vampire roles, announced that he would star her in a production of Romeo and Juliet,\" she illustrated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57af88bc-8a82-371e-b769-4910e3b8723d",
                                        "entry_id": "41b409ac-f6d5-37cf-a0d6-cb3805191013",
                                        "glosses": [
                                            "A medical technician who works with patients' blood; especially, a phlebotomist."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7309c42e-b480-42a6-9b87-50bb63e2352d",
                                                "sense_id": "57af88bc-8a82-371e-b769-4910e3b8723d",
                                                "text": "Only one technician in the hospital lab, in all we have encountered, uses it. […] Eric makes no complaints other than those directed at the vampires. Brenda and I do."
                                            },
                                            {
                                                "example_id": "724c7465-6f67-49aa-830d-152ed26183e4",
                                                "sense_id": "57af88bc-8a82-371e-b769-4910e3b8723d",
                                                "text": "\"I draw blood from patients, and then I take it back to the lab and analyze it. Sometimes, the vampires do all the sticks, that is to say the lab assistants do all the blood collections.\" He grinned. \"We have our own language at the lab.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e222e4d-a188-30a4-b27e-38fdc274b6ad",
                                        "entry_id": "41b409ac-f6d5-37cf-a0d6-cb3805191013",
                                        "glosses": [
                                            "Synonym of anti-ship missile (ASM), particularly an incoming hostile one."
                                        ],
                                        "tags": [
                                            "US",
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0104e61-28e5-40a3-990b-1a9890f31e1d",
                                                "sense_id": "4e222e4d-a188-30a4-b27e-38fdc274b6ad",
                                                "text": "Vampire. Vampire. Vampire. Battle stations."
                                            }
                                        ]
                                    }
                                ]
                            },
