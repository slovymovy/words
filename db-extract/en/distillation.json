                        "cross_references": [
                            {
                                "target_word": "distillaat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "99fbadc3-a115-3db2-9298-69bae9f1fb00",
                                        "entry_id": "55252663-1638-327d-abd7-dff0732f7f48",
                                        "glosses": [
                                            "product wat ontstaat door distillatie (dampvorming product opvangen en dat laten condenseren)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "276faad6-e1f2-4f25-a404-349ac3e046f8",
                                                "sense_id": "99fbadc3-a115-3db2-9298-69bae9f1fb00",
                                                "text": "„Goed stoken kun je niet uit de boekjes leren. Juist de mondelinge overdracht is van belang. Door het vaak te doen, krijg je het in de vingers. Ik kan horen of de ketel goed brandt, voel of het koelingsysteem op de juiste temperatuur is, en ruik of er niet te veel bitters in het distillaat komen. Ik gebruik natuurlijk wel apparaten om daarmee het alcoholpercentage te bepalen, maar je moet het gevoel voor het vak niet kwijtraken."
                                            },
                                            {
                                                "example_id": "28827e9c-5f53-4965-ba15-8671f4e6ac90",
                                                "sense_id": "99fbadc3-a115-3db2-9298-69bae9f1fb00",
                                                "text": "Om het distillaat whisky te mogen noemen moet het minstens drie jaar op fust gelegen hebben. En dat kost geld; de commerciële whisky's worden dan ook onmiddellijk na drie jaar gebotteld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
