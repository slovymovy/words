                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0236fdaf-e8b5-4e3a-8f2b-6f133cd3cd18",
                        "source_entry_id": "41dbd6a2-83a4-348c-b06b-5f1bb33a3c1f",
                        "source_sense_id": "7917f47d-1ca5-3a9a-a578-e2d6e0d814b4",
                        "target_lang_word": "aasig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aasig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9cb6ecea-3a65-38f0-849e-7ec542184f10",
                                        "entry_id": "b61a0841-c8fc-3384-9281-5db07c4771bb",
                                        "glosses": [
                                            "wie Aas beschaffen; verwesend, faulig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d402a4c-e07e-4f16-a7dd-923212891379",
                                                "sense_id": "9cb6ecea-3a65-38f0-849e-7ec542184f10",
                                                "text": "Der aasige Gestank war kaum auszuhalten."
                                            },
                                            {
                                                "example_id": "7b624b82-f4c0-4596-80cd-77d31f505d91",
                                                "sense_id": "9cb6ecea-3a65-38f0-849e-7ec542184f10",
                                                "text": "„Der ‚Tropische Baum‘ soll aasig, faulig, klebrig sein, soll schillern in Giftgasen und Pestblasen […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21879824-ffb5-3215-ba49-a2c31372c538",
                                        "entry_id": "b61a0841-c8fc-3384-9281-5db07c4771bb",
                                        "glosses": [
                                            "widerlich, ekelerregend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aba0ce0c-b579-4779-ac22-8c5653b562b8",
                                                "sense_id": "21879824-ffb5-3215-ba49-a2c31372c538",
                                                "text": "„Er verkörpert die Faszination des Bösen amüsant und aasig.“"
                                            },
                                            {
                                                "example_id": "99327bf4-3b2f-4c47-8095-c32a98daeb5a",
                                                "sense_id": "21879824-ffb5-3215-ba49-a2c31372c538",
                                                "text": "„Während Hildegard Schmahl als glamouröse Dragonerlady eine starke Schulter sucht und von Hans Kremer aasig umgarnt wird, spreizt Katja Bürkle als fröhliches Flittchen einladend die Beine.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3c01e8cc-c833-35a1-b4aa-59bd7c59d9e3",
                                        "entry_id": "b61a0841-c8fc-3384-9281-5db07c4771bb",
                                        "glosses": [
                                            "schlimm, sehr"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8a1c77c-4315-4a4c-a8c0-5a71481bf27c",
                                                "sense_id": "3c01e8cc-c833-35a1-b4aa-59bd7c59d9e3",
                                                "text": "„Bitte, hier herein, Mr. Pickwick! Perker ist selbstverständlich zu Hause und wird Sie gleich empfangen. Aasig kalt“, setzte er verdrießlich hinzu."
                                            },
                                            {
                                                "example_id": "5843051c-b756-472c-8def-8e8398d8fc73",
                                                "sense_id": "3c01e8cc-c833-35a1-b4aa-59bd7c59d9e3",
                                                "text": "„»Die meisten Brände sind nachts«, berichtet Dieter. »Letzten Winter im Februar, nachts halb eins, spiegelglatt war’s draußen, aasig kalt und dann schlaftrunken die Leiter hoch, rauf aufs Dach.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07329a20-47bc-4d28-a760-906caf251b42",
                        "source_entry_id": "41dbd6a2-83a4-348c-b06b-5f1bb33a3c1f",
                        "source_sense_id": "7917f47d-1ca5-3a9a-a578-e2d6e0d814b4",
                        "target_lang_word": "ätzend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ätzend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8953234-864d-3c46-87bb-7ff71eb24d50",
                                        "entry_id": "f7d5fefd-da4e-3026-89b1-4803a44c68e8",
                                        "glosses": [
                                            "Oberflächen zerstörend, Gewebe zerstörend"
                                        ],
                                        "tags": [
                                            "Stoffeigenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3b6b12a-4290-4a7f-8f85-164305eb580c",
                                                "sense_id": "a8953234-864d-3c46-87bb-7ff71eb24d50",
                                                "text": "\"Als der Verkäufer das Gerät zur Ansicht übergeben hatte, war plötzlich ein Unbekannter hinzugekommen und hatte dem Computerbesitzer eine ätzende Flüssigkeit ins Gesicht gesprüht.\""
                                            },
                                            {
                                                "example_id": "374bfae6-781b-4751-b543-e78833642e49",
                                                "sense_id": "a8953234-864d-3c46-87bb-7ff71eb24d50",
                                                "text": "[Das aus Dieselfahrzeugen stammende] Stickstoffdioxid ist ein ätzendes Reizgas, es schädigt laut Umweltbundesamt das Schleimhautgewebe im gesamten Atemtrakt und reizt die Augen."
                                            },
                                            {
                                                "example_id": "4338acb5-247d-483b-bc2e-0211084db553",
                                                "sense_id": "a8953234-864d-3c46-87bb-7ff71eb24d50",
                                                "text": "Der ätzende Stoff lässt auch Tiere nicht kalt. Propanthiol-S-Oxid ist ein wirksamer Schutz der Zwiebel gegen hungrige Nager wie Ratten oder Wühlmäuse."
                                            },
                                            {
                                                "example_id": "2e930300-f8af-4b6b-b268-76ca09c19ed7",
                                                "sense_id": "a8953234-864d-3c46-87bb-7ff71eb24d50",
                                                "text": "Der Test zeigt, welche der Putzmittel das Fett am besten wegbringen – ohne Rückstände und ohne zu viele ätzende Inhaltsstoffe."
                                            },
                                            {
                                                "example_id": "279c1a8b-1de4-49a4-a5bc-b9a890e67242",
                                                "sense_id": "a8953234-864d-3c46-87bb-7ff71eb24d50",
                                                "text": "Das kann gefährlich sein: Das auslaufende Elektrolyt [von Batterien] ist ätzend und aggressiv. Kommt es mit der Haut in Kontakt, muss es sofort abgewaschen werden."
                                            },
                                            {
                                                "example_id": "e4ee9ce9-6d10-4cbf-b2b0-5292c5a0a0d4",
                                                "sense_id": "a8953234-864d-3c46-87bb-7ff71eb24d50",
                                                "text": "Die Speiseröhre ist ein Muskelschlauch, der die Nahrung in den Magen transportiert. Dort angekommen, wird sie mithilfe von Magensäften zersetzt, die stark ätzende Salzsäure enthalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ece7398e-43f4-30e1-8722-b1c2402ed2de",
                                        "entry_id": "f7d5fefd-da4e-3026-89b1-4803a44c68e8",
                                        "glosses": [
                                            "spöttisch-beleidigend, emotional verletzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d46fdc7-d0d7-48ec-8faf-50dbf668b8d2",
                                                "sense_id": "ece7398e-43f4-30e1-8722-b1c2402ed2de",
                                                "text": "\"Mehmet Scholl hat nach dem Portugal-Spiel viel zu ätzend gegen Mario Gomez gelästert.\""
                                            },
                                            {
                                                "example_id": "745b9d34-7abd-4486-abe9-ddb8997e0f90",
                                                "sense_id": "ece7398e-43f4-30e1-8722-b1c2402ed2de",
                                                "text": "In einer schriftlichen Erklärung aus dem Gefängnis in Silivri […] reagierte [der Journalist Deniz] Yücel auf Aussagen des türkischen Außenministers Mevlüt Cavusoglu mit ätzendem Sarkasmus."
                                            },
                                            {
                                                "example_id": "5a70c7e0-a691-4144-9c53-4260f8e014eb",
                                                "sense_id": "ece7398e-43f4-30e1-8722-b1c2402ed2de",
                                                "text": "Sigmund Freud reagierte ätzend selbst auf die kleinste Kritik an seiner Psychoanalyse."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9d93198b-c713-333c-ad9e-3ff067b05c2f",
                                        "entry_id": "f7d5fefd-da4e-3026-89b1-4803a44c68e8",
                                        "glosses": [
                                            "abscheulich, furchtbar"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "540bb860-8a6a-4e05-bf14-00d7bc450d7b",
                                                "sense_id": "9d93198b-c713-333c-ad9e-3ff067b05c2f",
                                                "text": "„Dein neuer Freund ist echt ätzend. Willst Du mit dem Idioten weiter zusammen bleiben?“"
                                            },
                                            {
                                                "example_id": "f690f74a-dcce-4f81-8c75-3ca644b8151f",
                                                "sense_id": "9d93198b-c713-333c-ad9e-3ff067b05c2f",
                                                "text": "Akne, Mitesser im Gesicht, wenn möglich noch eiternd, echt ätzend: Beinahe jeder Teenager leidet irgendwann an Akne, mehr oder weniger ausgeprägt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "274ae57e-31b4-3204-a8eb-d5633db67f4b",
                                        "entry_id": "f7d5fefd-da4e-3026-89b1-4803a44c68e8",
