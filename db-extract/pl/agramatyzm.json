                    {
                        "translation_id": "220d617f-8c5b-418a-b489-8ddce2effda0",
                        "source_entry_id": "80e42166-8a78-3f66-95b4-70ff3c1ec176",
                        "source_sense_id": "5fbbfb45-00fa-3982-b222-58d8a421df28",
                        "target_lang_word": "Agrammatismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agrammatismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6256dfdd-82a2-3e40-9dd5-993e0229954f",
                                        "entry_id": "9d300a6f-3ead-381e-b118-ba364de8dd2e",
                                        "glosses": [
                                            "spezielle Form der Aphasie (Sprachstörung), bei der die Verwendung der grammatischen Elemente (Deklination, Konjugation, Funktionswörter) gestört ist"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cdf161a-bd03-45f6-ae6c-5e5d8d8251a8",
                                                "sense_id": "6256dfdd-82a2-3e40-9dd5-993e0229954f",
                                                "text": "Agrammatismus gehört zum Erscheinungsbild der Broca-Aphasie."
                                            },
                                            {
                                                "example_id": "65940a1a-26d6-44ae-b00a-7ee1102d46ac",
                                                "sense_id": "6256dfdd-82a2-3e40-9dd5-993e0229954f",
                                                "text": "„Gelegentlich wird Agrammatismus als Bezeichnung für die Entwicklungsstörung grammatischer Fähigkeiten bei Kindern verwendet (→ Dysgrammatismus).“"
                                            },
                                            {
                                                "example_id": "64f9b670-bcf4-4df9-9e72-48a8da426b31",
                                                "sense_id": "6256dfdd-82a2-3e40-9dd5-993e0229954f",
                                                "text": "„Seit dieser Zeit haben Agrammatismus und Paragrammatismus nichts von ihrer faszinierenden Wirkung auf die Aphasieforschung, leider auch kaum etwas von der Rätselhaftigkeit ihrer Pathogenese eingebüßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d4d3068e-3a26-33ce-80e0-67fb49473c78",
                                        "entry_id": "9d300a6f-3ead-381e-b118-ba364de8dd2e",
                                        "glosses": [
                                            "grammatikalisch falsche Wortbildung, in der das Unvermögen, Wörter richtig zu verbinden, zum Ausdruck kommt"
                                        ],
                                        "tags": [
                                            "mit Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5442d399-e343-45dc-a62b-99d74b6914fb",
                                                "sense_id": "d4d3068e-3a26-33ce-80e0-67fb49473c78",
                                                "text": "Kurts Sprache strotzt nur so vor Agrammatismen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3bbf79e4-c7f2-4602-85ee-e6346389caf6",
                        "source_entry_id": "80e42166-8a78-3f66-95b4-70ff3c1ec176",
                        "source_sense_id": "5fbbfb45-00fa-3982-b222-58d8a421df28",
                        "target_lang_word": "аграмматизм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "аграмматизм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "91a6b9fb-bc02-38df-ac98-aaaff85be573",
                                        "entry_id": "edc6420d-7c7a-306d-b615-f3b15aae4a5c",
                                        "glosses": [
                                            "мед. нейропсихологическое нарушение, характерное потерей способности пользоваться грамматическим строем речи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58466890-ecf3-4215-8001-0046018fad2e",
                                                "sense_id": "91a6b9fb-bc02-38df-ac98-aaaff85be573",
                                                "text": "Часто расстройство речи носит характер особого аграмматизма, благодаря которому расстановка слов в фразе оказывается неправильной; нет согласования по родам и падежам, отсутствуют предлоги или даже сказуемое и тому подобное."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d7f66f7-d92e-3520-98bd-cf667b9d6a91",
                                        "entry_id": "edc6420d-7c7a-306d-b615-f3b15aae4a5c",
                                        "glosses": [
                                            "книжн. неграмотное выражение, грамматическая неправильность в устной и/или письменной речи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "289903dd-b8e0-42d5-b792-8ba7aeb00a23",
                                                "sense_id": "4d7f66f7-d92e-3520-98bd-cf667b9d6a91",
                                                "text": "Аграмматизм чаще всего проявляется в неверном выборе окончания, предлога или союза, в неоправданной инверсии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
