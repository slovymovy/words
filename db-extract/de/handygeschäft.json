                        "examples": [
                            {
                                "example_id": "734d882c-1230-455c-a6d1-170ed4bab264",
                                "sense_id": "507fa0a8-29e8-314f-99e1-00bb60268306",
                                "text": "„Lange dominierte Samsung das weltweite Handygeschäft, doch nun gerät der südkoreanische Hersteller immer stärker unter Druck.“"
                            },
                            {
                                "example_id": "30de2cbe-4d4b-4307-a0ec-148d70b21197",
                                "sense_id": "507fa0a8-29e8-314f-99e1-00bb60268306",
                                "text": "„Siemens will im Handygeschäft seinen Marktanteil von zuletzt zehn Prozent mindestens halten und damit zur weltweiten Nummer drei, Samsung, aufschließen.“"
                            },
                            {
                                "example_id": "74c70827-7614-48ec-b20c-b6950b620a93",
                                "sense_id": "507fa0a8-29e8-314f-99e1-00bb60268306",
                                "text": "„Microsoft übernimmt das Handygeschäft von Nokia.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
