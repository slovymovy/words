{
    "word_family": [
        "dulligheid",
        "verdullen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a2132d12-3df6-3ab0-9bcb-89bea94d916a",
                    "sense_definition": "Dwaas of zot; niet goed bij het verstand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij deed een <w>dul</w> voorstel waar niemand mee akkoord kon gaan.",
                            "target_lang_translations": {
                                "en": "He made a <w>foolish</w> proposal that no one could agree to."
                            }
                        },
                        {
                            "text": "Men versleet hem voor een <w>dulle</w> man vanwege zijn vreemde gedrag.",
                            "target_lang_translations": {
                                "en": "People took him for a <w>crazy</w> man because of his strange behavior."
                            }
                        }
                    ],
                    "synonyms": [
                        "dol"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Voornamelijk in oudere literatuur of dialecten gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Foolish, crazy, or out of one's mind."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "foolish",
                                "target_lang_sense_clarification": "silly or unwise"
                            },
                            {
                                "target_lang_word": "crazy",
                                "target_lang_sense_clarification": "insane or mad"
                            },
                            {
                                "target_lang_word": "mad",
                                "target_lang_sense_clarification": "mentally unstable or foolish"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d6863a4-6b44-3d32-ba6d-a43e6782f4d2",
                    "sense_definition": "Razend, woest of buiten zinnen van woede.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ziet, gonder, die <w>dulle</w> schapen vlieden en die dullere herderen bachten!",
                            "target_lang_translations": {
                                "en": "Look, over there, those <w>wild</w> sheep fleeing and those wilder shepherds behind them!"
                            }
                        },
                        {
                            "text": "De storm maakte de golven van de zee wild en <w>dul</w>.",
                            "target_lang_translations": {
                                "en": "The storm made the waves of the sea wild and <w>raging</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dol",
                        "amok"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Voornamelijk in historische of literaire contexten gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Furious, wild, or out of one's mind with anger."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "furious",
                                "target_lang_sense_clarification": "extremely angry"
                            },
                            {
                                "target_lang_word": "wild",
                                "target_lang_sense_clarification": "uncontrolled or raging"
                            },
                            {
                                "target_lang_word": "raging",
                                "target_lang_sense_clarification": "showing violent anger or force"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "441820b0-06cf-3d23-8626-6129c173a90f",
                    "sense_definition": "Een ronde knop aan de bovenkant van een vlaggenstok of mast.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op de <w>dul</w> van de vlaggenstok zit een meeuw.",
                            "target_lang_translations": {
                                "en": "A seagull is sitting on the <w>finial</w> of the flagpole."
                            }
                        },
                        {
                            "text": "De schilder klom omhoog om de houten <w>dul</w> goud te verven.",
                            "target_lang_translations": {
                                "en": "The painter climbed up to paint the wooden <w>truck</w> gold."
                            }
                        }
                    ],
                    "synonyms": [
                        "kloot",
                        "knop",
                        "mastknop",
                        "vlaggenstokknop"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk in specifieke maritieme of dialectale contexten gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A round knob at the top of a flagpole or mast."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flagpole finial",
                                "target_lang_sense_clarification": "decorative knob at the top of a flagpole"
                            },
                            {
                                "target_lang_word": "truck",
                                "target_lang_sense_clarification": "wooden cap or knob at the top of a mast or flagpole"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}