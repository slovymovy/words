                                                "example_id": "e6a278a2-bd82-42c5-96c5-6faeed00fb90",
                                                "sense_id": "aebd1b32-3dbb-3606-bdc6-1ed8f3c57608",
                                                "text": "Od 2000 roku najczęściej nadawanym imieniem męskim w Polsce jest Jakub."
                                            },
