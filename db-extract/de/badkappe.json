                "senses": [
                    {
                        "sense_id": "a11f305e-ef23-35f5-8a15-f844ac599bd8",
                        "entry_id": "c66a157c-0d34-38b3-9b5a-3634f16b863b",
                        "glosses": [
                            "enge Mütze aus Gummi, die man beim Schwimmen trägt, um die Haare zusammenzuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c976d4d8-047d-40bd-a642-297421f2a207",
                                "sense_id": "a11f305e-ef23-35f5-8a15-f844ac599bd8",
                                "text": "„Ene Badkappe durfte in keinem Badestuben-Inventar fehlen zu einer Zeit, als das Baden noch mehr in der Mode war, als in späterer Zeit und gegenwärtig.“"
                            },
                            {
                                "example_id": "0d7275e9-fa11-46cd-8ea9-fa2ade86c409",
                                "sense_id": "a11f305e-ef23-35f5-8a15-f844ac599bd8",
                                "text": "„Das ist ein wenig salzig aber man darf nicht einmal ein Köpfli hinein machen, und auch die Mannsbilder ohne lange Haare müssen eine Badkappe tragen.“"
                            },
                            {
                                "example_id": "eca93568-a0ee-4076-997a-026ff33a3973",
                                "sense_id": "a11f305e-ef23-35f5-8a15-f844ac599bd8",
                                "text": "„Rasch aus den Kleidern geschlüpft, die Badkappe über und schon umschmeichelt das feine Nass wohltuend unseren Körper.“"
                            },
                            {
                                "example_id": "1cae58ad-3838-4e4f-86f7-01cb1854d85e",
                                "sense_id": "a11f305e-ef23-35f5-8a15-f844ac599bd8",
                                "text": "„Das Badhaus ist wohlig mit warmem Wasser gefüllt. Die Fräulein entkleiden sich ungeniert, legen goldene Badkappen an und baden.“"
                            },
                            {
                                "example_id": "45ce46f3-0a8a-437a-b2d3-c271163c1643",
                                "sense_id": "a11f305e-ef23-35f5-8a15-f844ac599bd8",
                                "text": "„Einen eigentümlichen Gegensatz dazu bildeten sein eleganter Anzug und die neuen Stiefel mit Badkappen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
