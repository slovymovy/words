                                        "glosses": [
                                            "Ce qui réconforte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d846053e-4cb3-410d-a2c4-a3e9c5dea0e9",
                                                "sense_id": "f38daf39-ed9e-35ec-8e66-3f8b88d64a5b",
                                                "text": "Quand Olivier Émery était au fond du trou comme aujourd'hui, il n'avait plus aucun espoir et pressentait que tout était joué. Téléphoner à FIP ne servirait plus à rien, aucun réconfort ne lui parviendrait, […]."
                                            },
                                            {
                                                "example_id": "86762546-397f-4959-b81f-98278d99d59c",
                                                "sense_id": "f38daf39-ed9e-35ec-8e66-3f8b88d64a5b",
                                                "text": "Tout son réconfort est que… Voilà tout son réconfort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
