                    },
                    {
                        "form_id": "593088d5-cf9f-4086-b0db-2f1f64fe4df7",
                        "entry_id": "887a2392-82e5-3e84-b239-406bce8223c0",
                        "tags": [],
                        "form": "saqueboute"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dfb58361-7e1e-3675-88ac-84c214c24077",
                        "entry_id": "887a2392-82e5-3e84-b239-406bce8223c0",
                        "glosses": [
                            "Instrument de musique à vent, ancêtre du trombone, qui possédait notamment un pavillon plus étroit que les trombones actuels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e68898d-cde8-4603-bda6-67d27bf8cce7",
                                "sense_id": "dfb58361-7e1e-3675-88ac-84c214c24077",
                                "text": "La sacquebute, ou sacqueboute, se nomme également « trompette harmonique », parce qu’elle sert de basse dans toutes sortes de concerts, comme font le serpent et le fagot."
                            },
                            {
                                "example_id": "436fb198-3460-4b68-b1df-a75a11f369ff",
                                "sense_id": "dfb58361-7e1e-3675-88ac-84c214c24077",
                                "text": "D'une façon générale, sacqueboutes, vièles, rebecs pouvaient exécuter les teneurs et contreteneurs des motets profanes. ."
                            },
                            {
                                "example_id": "ea2e7004-79cc-4b93-95fa-9a4eaef047c8",
                                "sense_id": "dfb58361-7e1e-3675-88ac-84c214c24077",
                                "text": "En français du XVIᵉ siècle, sacquer veut dire tirer et bouter repousser. La sacqueboute est donc la forme initiale du trombone à coulisse."
                            },
                            {
                                "example_id": "69936ee1-7817-4725-92aa-f2655e169288",
                                "sense_id": "dfb58361-7e1e-3675-88ac-84c214c24077",
                                "text": "Ainsi, la première partie du concert, consacrée aux grandes pièces des XVIème et XVIIème siècles, sera jouée sur l’ancêtre du trombone, autrement dit la sacqueboute. Le nom de ce noble instrument illustre parfaitement le geste du musicien avec la coulisse, « sacquer » signifiant tirer vers soi et « bouter » pousser dans le sens opposé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
