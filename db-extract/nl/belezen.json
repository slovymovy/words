                "senses": [
                    {
                        "sense_id": "2eb937b0-9e61-346e-a796-b221e72089f4",
                        "entry_id": "fa11151d-6759-35af-9f58-8d8c0b6ad0ab",
                        "glosses": [
                            "well-read (well informed and knowledgeable because of extensive reading)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ac6a087-1412-4150-87bd-1f9767ee276b",
                                "sense_id": "2eb937b0-9e61-346e-a796-b221e72089f4",
                                "text": "Hij is een belezen man en kan over veel verschillende onderwerpen meepraten.",
                                "translation": "He is a well-read man and can discuss many different topics.",
                                "english": "He is a well-read man and can discuss many different topics."
                            },
                            {
                                "example_id": "a98349c2-a821-4b9b-a41c-56a92a6b5e5c",
                                "sense_id": "2eb937b0-9e61-346e-a796-b221e72089f4",
                                "text": "Ze is zeer belezen en heeft een brede kennis van literatuur.",
                                "translation": "She is very well-read and has a broad knowledge of literature.",
                                "english": "She is very well-read and has a broad knowledge of literature."
                            }
                        ]
                    },
                    {
                        "sense_id": "af819420-3e84-332d-9615-8a6401ac28ec",
                        "entry_id": "fa11151d-6759-35af-9f58-8d8c0b6ad0ab",
                        "glosses": [
                            "book-smart, erudite"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9ee149de-4378-4fff-9c3b-e419753a4e42",
                                "sense_id": "af819420-3e84-332d-9615-8a6401ac28ec",
                                "text": "De bibliothecaris is erg belezen en kent veel boeken uit zijn hoofd.",
                                "translation": "The librarian is very erudite and knows many books by heart.",
                                "english": "The librarian is very erudite and knows many books by heart."
                            }
                        ]
                    }
                ],
