                "senses": [
                    {
                        "sense_id": "ee28f54d-f3d3-391d-987a-e3e676211b77",
                        "entry_id": "82dec860-c4e7-3e12-9767-88bb1e357932",
                        "glosses": [
                            "Opération qui consiste à transformer les bobines de fils en ensouple pour le tissage. Cette opération est préalable et préparatoire du tissage et consiste à assembler les fils de chaînes parallèlement par portées, dans l’ordre qu’ils occuperont dans l'étoffe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e9828d-7971-4934-baec-39b1dc71cfb3",
                                "sense_id": "ee28f54d-f3d3-391d-987a-e3e676211b77",
                                "text": "La mère intronisée « chef de la teinture » combinait les couleurs et essayait les mélanges, tandis que Sarkis surveillait les opérations de bobinage, d’ourdissage et de collage."
                            },
                            {
                                "example_id": "bec4d27e-8cba-4c80-b1b8-664541e3a953",
                                "sense_id": "ee28f54d-f3d3-391d-987a-e3e676211b77",
                                "text": "L'ourdissage consiste à disposer les fils les uns à côté des autres sur une grande longueur afin d'en former une nappe sur une largeur déterminée. Cette nappe constituera la chaîne"
                            }
                        ]
                    },
                    {
                        "sense_id": "c5a3f664-e6f9-3724-b535-4da25d756a0b",
                        "entry_id": "82dec860-c4e7-3e12-9767-88bb1e357932",
                        "glosses": [
                            "Action de l’ouvrier, de l’ouvrière qui ourdit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e694e46-f1d6-4fdc-8994-396ee76e941e",
                                "sense_id": "c5a3f664-e6f9-3724-b535-4da25d756a0b",
                                "text": "Confectionner une ceinture fléchée peut prendre jusqu’à 700 heures, si on compte la cueillette des plantes servant à préparer les couleurs, la teinture de la laine, la préparation de la laine au rouet, l’ourdissage et la confection, incluant le vrillage des franges."
                            }
                        ]
