                    {
                        "sense_id": "c8de2ab9-8323-3fe0-b5c0-e683db62608a",
                        "entry_id": "3251e63f-3412-3dcc-89b8-659268609184",
                        "glosses": [
                            "żołnierz wojsk szturmowych"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c7c9975a-3b64-399c-ab0b-eae09db97366",
                        "entry_id": "3251e63f-3412-3dcc-89b8-659268609184",
                        "glosses": [
                            "żołnierz sił imperium w uniwersum „Gwiezdnych wojen”"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3963d994-e110-4daf-8678-68fa38b28562",
                                "sense_id": "c7c9975a-3b64-399c-ab0b-eae09db97366",
                                "text": "Gdy eskor­tu­jący ją wcześniej szturmowiec zda­wał raport, nadal czuła na ple­cach lufę bla­stera"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a6e4c78-a591-4a8a-bc92-ba8547c178e2",
                        "source_entry_id": "3251e63f-3412-3dcc-89b8-659268609184",
                        "source_sense_id": "c7c9975a-3b64-399c-ab0b-eae09db97366",
                        "target_lang_word": "stormtrooper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stormtrooper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e10ee60e-3af9-348d-9bb7-505a2616f2c9",
                                        "entry_id": "f783475a-9591-33b1-93a5-1a88c638e67f",
                                        "glosses": [
                                            "A soldier trained in special infiltration tactics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5736e25d-22bf-4bee-9064-71b87f950431",
                                                "sense_id": "e10ee60e-3af9-348d-9bb7-505a2616f2c9",
                                                "text": "Indeed, the infantry battle on the desolate ridgeline above Darwin would probably have seemed remarkably familiar to a World War I stormtrooper."
                                            },
                                            {
                                                "example_id": "63f2b6c3-c8e0-41ae-b8c6-594b847747d8",
                                                "sense_id": "e10ee60e-3af9-348d-9bb7-505a2616f2c9",
                                                "text": "As you'll recall, the idea of the stormtrooper arose from the effort to break out of the trench warfare of World War I."
                                            },
                                            {
                                                "example_id": "5f20a891-8877-4a41-8e91-3b264ed365fb",
                                                "sense_id": "e10ee60e-3af9-348d-9bb7-505a2616f2c9",
                                                "text": "When he came upon such a scene he went up to a stormtrooper to protest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cf2ec05-1544-3ae4-9c03-7e895955ebe3",
                                        "entry_id": "f783475a-9591-33b1-93a5-1a88c638e67f",
                                        "glosses": [
                                            "A member of the Sturmabteilung, a Nazi street militia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
