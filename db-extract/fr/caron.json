                "senses": [
                    {
                        "sense_id": "b9cbd842-633b-3e7b-b6c7-494034d09f4b",
                        "entry_id": "a35791ee-76d4-3c6d-aada-2ce812620ac6",
                        "glosses": [
                            "Signe typographique diacritique ‹ ◌̌ ›, utilisé dans l’écriture de certaines langues slaves (tchèque, slovaque, slovène), dans l’écriture de plusieurs langues à tons, et dans la transcription phonétique du chinois mandarin pinyin, pour les troisièmes tons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e2ee0b8-24c5-4d25-a63e-7d6b54ba52f1",
                                "sense_id": "b9cbd842-633b-3e7b-b6c7-494034d09f4b",
                                "text": "Ainsi, le caractère ‘j avec caron’ (langue tamasheq – arrêté 214-99 de la République du Niger) est codé par l’unique code U+01F0 sous sa forme minuscule."
                            }
                        ]
                    },
                    {
                        "sense_id": "49377779-b059-3932-9235-f8235eaa5182",
                        "entry_id": "a35791ee-76d4-3c6d-aada-2ce812620ac6",
                        "glosses": [
                            "Vieux papiers sales."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6d43b0ae-d892-4547-8368-064ccfec7bdc",
                                "sense_id": "49377779-b059-3932-9235-f8235eaa5182",
                                "text": "Les fabricants de carton et de papier achètent [aux chiffonniers] pour leur usage les carons, vieux papiers sales."
                            }
                        ]
                    },
                    {
                        "sense_id": "2164235b-7224-3b48-b46f-eeca40d564e9",
                        "entry_id": "a35791ee-76d4-3c6d-aada-2ce812620ac6",
                        "glosses": [
                            "Bande de lard sans maigre."
                        ],
                        "tags": [
                            "dated",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "beeb09f4-4f86-32f7-a717-8fa107dc28cd",
                        "entry_id": "a35791ee-76d4-3c6d-aada-2ce812620ac6",
                        "glosses": [
                            "Mélange d'orge et de blé semé sur un même terrain."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2f550ebe-47fe-4894-80ed-51544bd53fb1",
                                "sense_id": "beeb09f4-4f86-32f7-a717-8fa107dc28cd",
                                "text": "Cause d’Hugues d’Encausse, curé d’Estadens, contre Guil. Lapadon d’Estadens, qui fut condamné à payer la dîme en lin sur le pied de dix un; en blé, seigle, caron, avoine, sur le pied de 17 gerbes deux, en blé d’Espagne de dix un (23 juin)."
                            },
                            {
                                "example_id": "505d5678-3621-40de-b9b5-b291656c03ca",
                                "sense_id": "beeb09f4-4f86-32f7-a717-8fa107dc28cd",
                                "text": "Pour toutes les céréales « bled froment », « avoine », « caron », seigle « mixture », le commandeur prélèvera par tas de 17 gerbes, deux gerbes, l’une à titre de dîme, l’autre pour les prémisses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6130cd32-70d8-4255-bccb-13b6734c489f",
                        "source_entry_id": "a35791ee-76d4-3c6d-aada-2ce812620ac6",
                        "source_sense_description": "Signe diacritique",
                        "target_lang_word": "Hatschek",
