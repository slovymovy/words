                        "entry_id": "141ef641-71e0-3337-b534-2888d7f1268e",
                        "glosses": [
                            "during Roman times, a member of a tribe from Libya who were said to charm snakes and be immune to their venom"
                        ],
                        "tags": [
                            "historical",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "8d25db93-547e-403f-9731-4911739f4635",
                                "sense_id": "541cb44c-3ac0-3f5d-913a-a765c5515000",
                                "text": "Un Psylle, un de ces nombreux Africains charmeurs de serpents qui parcourent les rues d’Alexandrie, amusait les badauds.",
                                "translation": "A Psyllian, one of those many African snake charmers who covered the streets of Alexandria, amused the onlookers.",
                                "english": "A Psyllian, one of those many African snake charmers who covered the streets of Alexandria, amused the onlookers."
                            }
                        ]
                    },
                    {
                        "sense_id": "36453b4a-8e18-318d-b534-cfb99699cd18",
                        "entry_id": "141ef641-71e0-3337-b534-2888d7f1268e",
                        "glosses": [
                            "a snake charmer"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "7e053ad8-2c0f-4194-93d4-6fafeb791f15",
                                "sense_id": "36453b4a-8e18-318d-b534-cfb99699cd18",
                                "text": "« Oh! je le sais bien , répondit le psylle: Je l'ai senti en entrant dans la maison.»",
                                "translation": "\"Oh! I know that well,\" responded the snake charmer. \"I sensed it when I entered the house.\"",
                                "english": "\"Oh! I know that well,\" responded the snake charmer. \"I sensed it when I entered the house.\""
                            }
                        ]
                    }
