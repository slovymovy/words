                        "source_sense_id": "d0abb2b1-c1e0-37fe-bf83-1b7c1f332ded",
                        "target_lang_word": "Aufladung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufladung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de45c063-3b52-3e0b-b38e-23bf878e582f",
                                        "entry_id": "f1ea300c-75ea-3684-ab5d-e6936fe64508",
                                        "glosses": [
                                            "das Aufladen von Gegenständen auf einen LKW oder Anhänger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d00a97a-2dd8-4826-a5e7-2ec9d899a246",
                                                "sense_id": "de45c063-3b52-3e0b-b38e-23bf878e582f",
                                                "text": "Die Aufladung der Maschinenteile erfolgt mit einem Gabelstapler oder Kran"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e584d4a9-aea2-3495-872f-eada5a28dc12",
                                        "entry_id": "f1ea300c-75ea-3684-ab5d-e6936fe64508",
                                        "glosses": [
                                            "Zuführung von Strom, um etwas elektrisch aufzuladen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a6837ed-2e04-4e90-b941-17f147a328b1",
                                                "sense_id": "e584d4a9-aea2-3495-872f-eada5a28dc12",
                                                "text": "„Ionisierungsgerät - Gesamtheit aller Einrichtungen zur Luftionisation, um elektrostatische Aufladungen an bestimmten Teilen abzuführen. […] Aufladestab - Einrichtung zur gezielten elektrostatischen Aufladung von Werkstoffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "21689e80-d50a-31ed-b88e-8926fd213dca",
                                        "entry_id": "f1ea300c-75ea-3684-ab5d-e6936fe64508",
                                        "glosses": [
                                            "strömungstechnische Optimierung eines Verbrennungsmotors zur Leistungsoptimierung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6ec2de6-cb07-4bbf-8f1d-ac66a166dd03",
                                                "sense_id": "21689e80-d50a-31ed-b88e-8926fd213dca",
                                                "text": "„Bei der Aufladung wird die Ladungsmenge vergrößert, also die Dichte der Ansaugluft erhöht, somit der Füllungsverlust verkleinert und der Wirkungsgrad des Verbrennungsmotors verbessert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "24c73150-1c77-31e5-9607-b0d39d11e906",
                                        "entry_id": "f1ea300c-75ea-3684-ab5d-e6936fe64508",
                                        "glosses": [
                                            "der Zustand, aufgeladen zu sein; unter Spannung stehen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c278f8cd-bb6d-4fe7-858a-f4a1914a57eb",
                                                "sense_id": "24c73150-1c77-31e5-9607-b0d39d11e906",
                                                "text": "„Die am häufigsten stattfindende Form der unerwünschten Aufladung ist die Kontaktaufladung.“"
                                            },
                                            {
                                                "example_id": "520976dd-e93d-4b8b-b20d-de4c7a496e5d",
                                                "sense_id": "24c73150-1c77-31e5-9607-b0d39d11e906",
                                                "text": "„Statische Aufladung tritt auf, wenn Moleküle auf der Oberfläche eines Gegenstandes aufgeladen oder polarisiert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d692b40c-2cf7-3b66-b46a-4f301799751f",
                                        "entry_id": "f1ea300c-75ea-3684-ab5d-e6936fe64508",
                                        "glosses": [
                                            "bei Wertkarten einen Betrag auf das Konto für Verbindungen aufladen"
                                        ],
                                        "tags": [
                                            "Mobilfunk"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
