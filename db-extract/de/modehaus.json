                "senses": [
                    {
                        "sense_id": "4c4e8175-be69-3040-be95-6975b1c4ec31",
                        "entry_id": "79096a00-3f69-3aeb-b607-4bee6dc116bc",
                        "glosses": [
                            "Magasin d' habillement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c684664-8729-4620-b454-7b6370dd979a",
                                "sense_id": "4c4e8175-be69-3040-be95-6975b1c4ec31",
                                "text": "Dem Modehaus wird eine sehr gute Qualität sowie die größte Auswahl an Marken bescheinigt, die sich auch darin zeigt, dass die Kunden dort aktuelle Mode für die ganze Familie finden.",
                                "translation": "On reconnaît à ce magasin d'habillement une très bonne qualité ainsi que le plus grand choix de marques, ce qui se traduit également par le fait que les clients y trouvent une mode actuelle pour toute la famille."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc9bb40f-198c-3ff9-b66d-a9303868585e",
                        "entry_id": "79096a00-3f69-3aeb-b607-4bee6dc116bc",
                        "glosses": [
                            "Maison de couture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e12fe3d-b83d-4f43-aaaf-cd0762a5b80d",
                                "sense_id": "dc9bb40f-198c-3ff9-b66d-a9303868585e",
                                "text": "Modehaus „B“ macht das Design, vergibt die Aufträge für das Weben und Nähen sowie die Distribution an externe Firmen.",
                                "translation": "La maison de couture « B » s'occupe du design, sous-traite le tissage et la couture ainsi que la distribution à des entreprises externes."
                            }
                        ]
                    }
