                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b7ed67e-e6c7-4cd9-b0d1-ccea95a22145",
                                                "sense_id": "03ca215e-6857-354c-8cb9-0c6c6eac0f7f",
                                                "text": "Diese kleine Truhe ist mit Samt ausgeschlagen."
                                            },
                                            {
                                                "example_id": "4245558c-a38b-4987-b330-396896dad44b",
                                                "sense_id": "03ca215e-6857-354c-8cb9-0c6c6eac0f7f",
                                                "text": "Dieser Mantel ist mit Hermelin ausgeschlagen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "11b481e2-206e-371d-9635-fb712850439f",
                                        "entry_id": "767edf01-f777-3f91-8097-cad7dd20d72a",
                                        "glosses": [
                                            "etwas mit Hammerschlägen breit machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d895c9f0-dd4e-4399-b285-1f20d4267302",
                                                "sense_id": "11b481e2-206e-371d-9635-fb712850439f",
                                                "text": "Du musst das Gold ausschlagen, bis es millimeterdünne Plättchen sind."
                                            }
                                        ],
                                        "sense_index_json": "\"6a\""
                                    },
                                    {
                                        "sense_id": "da37b18a-0545-34b9-a879-53b03bef26a6",
                                        "entry_id": "767edf01-f777-3f91-8097-cad7dd20d72a",
                                        "glosses": [
