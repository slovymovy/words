                "senses": [
                    {
                        "sense_id": "3e5034b6-9a4c-341e-9d4f-4c7e1109433a",
                        "entry_id": "c9e0abea-d688-320d-bb15-357fb934c972",
                        "glosses": [
                            "einfache Transportfläche auf Rädern ohne eigenen Antrieb für Müll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1adb5f8-6230-487d-a624-8c760637c8a3",
                                "sense_id": "3e5034b6-9a4c-341e-9d4f-4c7e1109433a",
                                "text": "In vielen Innenstädten zieht die Stadtreinigung noch heute mit modernen Müllkarren umher und reinigt die Straßen, Mülleimer und Parkanlagen."
                            },
                            {
                                "example_id": "492bb4e2-00ea-4958-8123-7338d15d09dc",
                                "sense_id": "3e5034b6-9a4c-341e-9d4f-4c7e1109433a",
                                "text": "„Schulhof der höheren Bürgerschule mit den städtischen Müllkarren“"
                            },
                            {
                                "example_id": "b6b25c17-a8cb-4d09-bb03-9cce3524e81d",
                                "sense_id": "3e5034b6-9a4c-341e-9d4f-4c7e1109433a",
                                "text": "„Ein junger Mann mit einem Müllkarren und Plastikschutzweste winkt herüber.“"
                            },
                            {
                                "example_id": "dd8c7b36-a6ae-4cf1-9093-c50dd3dc13ce",
                                "sense_id": "3e5034b6-9a4c-341e-9d4f-4c7e1109433a",
                                "text": "„Außerdem wurden Geräte, wie Müllkarren, Schaufeln und Besen beschafft.“"
                            },
                            {
                                "example_id": "faeaca68-6542-4d1a-b526-52dff8e08848",
                                "sense_id": "3e5034b6-9a4c-341e-9d4f-4c7e1109433a",
                                "text": "„Und unser Komitee hat beschlossen, den anderen Teil für Müllkarren auszugeben.“"
                            },
                            {
                                "example_id": "487f452e-b757-4b7e-9b4e-7ed73ec7a89a",
                                "sense_id": "3e5034b6-9a4c-341e-9d4f-4c7e1109433a",
                                "text": "„Bentivegna hatte, als Straßenfeger verkleidet, den Sprengsatz in einer Müllkarre verborgen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3688c2b1-e942-3306-b309-e338600b9762",
                        "entry_id": "c9e0abea-d688-320d-bb15-357fb934c972",
                        "glosses": [
                            "umgangssprachlich bis Slang; oft abfällig vermülltes Automobil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b0108db-a4d0-4c17-8814-5a38a1970c28",
                                "sense_id": "3688c2b1-e942-3306-b309-e338600b9762",
                                "text": "Mancher Innenraum eines Autos wird durch den Besitzer so sehr mit Unrat gefüllt, das es wahrlich einer Müllkarre gleicht."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
