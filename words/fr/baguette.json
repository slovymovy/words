                {
                    "sense_id": "db10d9b1-2c17-3757-a76a-e4cf8e90962b",
                    "sense_definition": "Pain allongé, mince et croustillant, emblématique de la boulangerie française.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "aliment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque matin, je passe à la boulangerie pour acheter une <w>baguette</w> bien chaude."
                        },
                        {
                            "text": "Il coupe une tranche de <w>baguette</w> pour la tartiner de confiture."
                        }
                    ],
                    "synonyms": [
