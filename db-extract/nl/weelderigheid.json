                                            {
                                                "example_id": "b32b880f-0cde-4e3b-9166-e9079934b0de",
                                                "sense_id": "a500cc81-9382-3f03-b5f2-3727c41dc2cd",
                                                "text": "Near-synonyms: splendor, grandeur, grandness, decadence"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93c0441f-c151-36a1-a18b-efa5a6660d89",
                                        "entry_id": "fc0e6650-a52b-37ab-bea4-8b586e9767b3",
                                        "glosses": [
                                            "Something desirable but expensive and that one can live without."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45fe852a-2a94-4d7f-8286-a30f09a8c603",
                                                "sense_id": "93c0441f-c151-36a1-a18b-efa5a6660d89",
                                                "text": "“[…] We are engaged in a great work, a treatise on our river fortifications, perhaps? But since when did army officers afford the luxury of amanuenses in this simple republic? […]”"
                                            },
                                            {
                                                "example_id": "98c6caa5-a8b4-48ca-af2e-d64a715e7a99",
                                                "sense_id": "93c0441f-c151-36a1-a18b-efa5a6660d89",
                                                "text": "And with Millennial and Gen Z consumers accounting for a growing proportion of spending, the luxury market is increasingly sensitive to the social and environmental causes they identify with. […] With all this in mind, here are CNN Style’s best small luxuries for the conscientious gift giver: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3b97152-5baa-366d-af9f-05656efa62ab",
                                        "entry_id": "fc0e6650-a52b-37ab-bea4-8b586e9767b3",
                                        "glosses": [
                                            "Something that is pleasant and desirable but not necessary in life (whether expensive or not)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dce34214-0247-410d-a64a-e459a021e303",
                                                "sense_id": "f3b97152-5baa-366d-af9f-05656efa62ab",
                                                "text": "As the 1857 to Manchester Piccadilly rolls in, I scan the windows and realise there are plenty of spare seats, so I hop aboard. The train is a '221'+'220' combo to allow for social distancing - a luxury on an XC train as normally you're playing sardines, so I make the most of it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f985cb51-82db-3d8e-b4e6-04861e80a506",
                                        "entry_id": "fc0e6650-a52b-37ab-bea4-8b586e9767b3",
                                        "glosses": [
                                            "Lustfulness; sexual desire or attraction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b7c1e0f-4f00-4cca-aee0-166763b9b854",
                                                "sense_id": "f985cb51-82db-3d8e-b4e6-04861e80a506",
                                                "text": "Fie on sinnefull phantasie: Fie on Lust, and Luxurie:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "286a1308-c05d-3732-9217-af07faf43542",
                                        "entry_id": "fc0e6650-a52b-37ab-bea4-8b586e9767b3",
                                        "glosses": [
                                            "Copulation; the act or action of sex."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09ff2ff8-352e-4d97-8ac0-486d71fba97a",
                                                "sense_id": "286a1308-c05d-3732-9217-af07faf43542",
                                                "text": "Let not the Royall Bed of Denmark be / A Couch for Luxury and damned Incest."
                                            }
                                        ]
                                    }
                                ]
