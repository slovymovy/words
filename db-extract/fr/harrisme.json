                        "glosses": [
                            "Doctrine chrétienne protestante de William Wade Harris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f78df04-32e4-4390-9ee0-1be6cead273c",
                                "sense_id": "c1ce262b-5a8b-3e9c-88f0-d8c8e07ee63a",
                                "text": "Premier de ces prophètes d’aujourd’hui, Albert Atcho, […] se réclamait du harrisme."
                            },
                            {
                                "example_id": "4c37b13a-fa08-4142-b4e4-b426835a3592",
                                "sense_id": "c1ce262b-5a8b-3e9c-88f0-d8c8e07ee63a",
                                "text": "Après avoir végété pendant de nombreuses années, le harrisme orthodoxe connut, sitôt la dernière guerre mondiale, l’expansion qui l’a conduit à ce qu’il est aujourd’hui."
                            },
                            {
                                "example_id": "ebba3572-45c9-4c64-aad9-151a21e7b802",
                                "sense_id": "c1ce262b-5a8b-3e9c-88f0-d8c8e07ee63a",
                                "text": "La danse religieuse est plus sujette à caution et il y aurait danger de tomber dans le « negro spiritual » qui devient d’ailleurs la seule cérémonie des sectes pagano-chrétiennes du Harrisme, du Mat’huanisme."
                            }
                        ]
                    }
