                        "glosses": [
                            "A temple primarily dedicated to Athena or her Roman equivalent Minerva, especially that of Athens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5862c5f3-ca8d-4e7b-b390-519296c561d1",
                                "sense_id": "ebbafe59-6b51-3957-bef2-d622e3f260b1",
                                "text": "The Athenaea were built in form of Amphitheatres."
                            }
                        ]
                    },
                    {
                        "sense_id": "41b9f0ad-a6eb-3af1-96da-723436191b0d",
                        "entry_id": "f1107eac-5f5a-3236-82dd-9e3946f3fcc1",
                        "glosses": [
                            "Alternative form of athenaeum: a literary or scientific club, especially that of Boston."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "95f1142f-2c07-4541-a540-e0dfa1922caf",
                                "sense_id": "41b9f0ad-a6eb-3af1-96da-723436191b0d",
                                "text": "“O Grandfather, tell us all about that Indian Bible!” exclaimed Laurence. “I have seen it in the library of the Athenaeum; and the tears came into my eyes to think that there were no Indians left to read it.”"
                            },
                            {
                                "example_id": "ce620ef7-b5e0-4e11-ac2c-baaada223549",
                                "sense_id": "41b9f0ad-a6eb-3af1-96da-723436191b0d",
                                "text": "Among the prominent buildings is the Athenaeum, containing a reading-room and library."
                            }
                        ]
                    },
