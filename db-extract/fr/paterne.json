                ],
                "senses": [
                    {
                        "sense_id": "ae2fa73a-740b-3920-9087-010f5944e67f",
                        "entry_id": "053b6dfc-4f4c-3d12-8715-85be7b10b19a",
                        "glosses": [
                            "Qui affecte les manières bienveillantes et le ton protecteur d’un père."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93d31ee-4720-41da-b7e2-57fce68007da",
                                "sense_id": "ae2fa73a-740b-3920-9087-010f5944e67f",
                                "text": "Il me parla d’un ton paterne."
                            },
                            {
                                "example_id": "6559891a-c830-4a61-a94a-25dc25f0c7cd",
                                "sense_id": "ae2fa73a-740b-3920-9087-010f5944e67f",
                                "text": "Cet homme appartenait évidemment à l’Église, il n’annonçait pas plus de cinquante à cinquante-cinq ans, on ne pouvait pas avoir l’air plus paterne."
                            },
                            {
                                "example_id": "ad28c5d8-8601-4675-b938-ee88bdcc9203",
                                "sense_id": "ae2fa73a-740b-3920-9087-010f5944e67f",
                                "text": "Debout devant elle, il souriait d’un air paterne."
                            },
                            {
                                "example_id": "91078170-add0-47bd-8478-8243a57dad28",
                                "sense_id": "ae2fa73a-740b-3920-9087-010f5944e67f",
                                "text": "Bache surtout, gras et paterne, ses petits yeux tendres à demi noyés dans la neige des cheveux et de la grande barbe, parlait d’une façon lente, onctueuse, interminable, dès qu’il exposait ses idées."
                            },
                            {
                                "example_id": "45638d32-d838-4561-b240-4d98e5bc975d",
                                "sense_id": "ae2fa73a-740b-3920-9087-010f5944e67f",
                                "text": "(par animisme) Avais-je la Nausée? Non, ce n'était pas cela, la chambre avait son air paterne de tous les jours."
                            },
                            {
                                "example_id": "2ee45470-59bb-4bf0-88c4-b4771fa5744b",
                                "sense_id": "ae2fa73a-740b-3920-9087-010f5944e67f",
                                "text": "15 juin 1941 – Le Henri en question a été correct d’ailleurs. Il avait choisi la jovialité paterne."
                            }
                        ]
                    }
                ],
