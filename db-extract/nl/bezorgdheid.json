                ],
                "senses": [
                    {
                        "sense_id": "f04dd8d2-8abe-3e9e-8205-2fe95fbd5799",
                        "entry_id": "a2d4465c-1036-3b27-94f2-71dc6bfb534d",
                        "glosses": [
                            "bekommering wegens iets dat al of niet zal of kan gebeuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eacf1f36-0371-40cd-95a5-9f00e16b26e8",
                                "sense_id": "f04dd8d2-8abe-3e9e-8205-2fe95fbd5799",
                                "text": "Zij had me gevraagd om altijd een extra liter water mee te nemen, zodat ik nooit zonder zou komen. Ik was erg ontroerd door haar bezorgdheid, maar ook door haar praktische advies."
                            },
                            {
                                "example_id": "d9d3f6cb-08bd-48b9-86e9-988b75daf17e",
                                "sense_id": "f04dd8d2-8abe-3e9e-8205-2fe95fbd5799",
                                "text": "Dat zou hun allemaal plezier doen en het zou Ingeborgs bezorgdheid aan banden leggen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49cb2402-4e2a-4ac5-976a-edf38d4bb42e",
                        "source_entry_id": "a2d4465c-1036-3b27-94f2-71dc6bfb534d",
                        "source_sense_id": "f04dd8d2-8abe-3e9e-8205-2fe95fbd5799",
                        "target_lang_word": "Besorgnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besorgnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "144cc342-5d03-37a0-ae98-8a25e873de0f",
                                        "entry_id": "747af3e0-9885-3815-813a-15b95a51a044",
                                        "glosses": [
                                            "über eine längere Zeit andauerndes quälendes, bedrückendes Gefühl wegen bestimmter unangenehmer Erwartungen an die Zukunft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d86bcb9-9987-4dee-b693-50d037d5fa5c",
                                                "sense_id": "144cc342-5d03-37a0-ae98-8a25e873de0f",
                                                "text": "„International stießen die Drohungen Nordkoreas auf scharfe Kritik und lösten Besorgnis aus.“"
                                            },
                                            {
                                                "example_id": "1302e738-a48b-4ef1-a164-e9d7b44d6c90",
                                                "sense_id": "144cc342-5d03-37a0-ae98-8a25e873de0f",
                                                "text": "„Die sogenannte perfektionistische Besorgnis wird von der Wissenschaft mit klinischen Störungsbildern wie Essstörungen, Depression, Angst- und Zwangstörungen, sexuellen Funktionsstörungen und Selbstmordgedanken in Verbindung gebracht.“"
                                            },
                                            {
                                                "example_id": "8c352263-51d6-406f-8fce-2f355b64c738",
                                                "sense_id": "144cc342-5d03-37a0-ae98-8a25e873de0f",
                                                "text": "„Ich habe Sie nach Neuigkeiten gefragt, um die Besorgnis zu zerstreuen, die Ihr trübes und ernstes Gesicht bei mir erweckte.“"
                                            },
                                            {
                                                "example_id": "29609041-a53f-4aa1-b6b4-597106586d8a",
                                                "sense_id": "144cc342-5d03-37a0-ae98-8a25e873de0f",
                                                "text": "„Noch riskanter aber erschien, dass Besorgnis sich auch im Bürgertum breitzumachen begann.“"
                                            },
                                            {
                                                "example_id": "c4e478b3-d73a-4c05-b8ac-30b655af4932",
                                                "sense_id": "144cc342-5d03-37a0-ae98-8a25e873de0f",
                                                "text": "„2012 äußerte der Europarat seine »Besorgnis über jeden Versuch, die Mitgliedschaft in einer Einheit der Waffen-SS und die Kollaboration mit den Nazis zu rechtfertigen«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfa58531-5fb6-4a1b-aa79-20b7c887ceca",
                        "source_entry_id": "a2d4465c-1036-3b27-94f2-71dc6bfb534d",
                        "source_sense_id": "f04dd8d2-8abe-3e9e-8205-2fe95fbd5799",
                        "target_lang_word": "worry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cc11cd8-a2ca-3312-a646-7cc991ada4ca",
                                        "entry_id": "130ef716-0611-3497-ac6b-1327b051a6e5",
                                        "glosses": [
                                            "To be troubled; to give way to mental anxiety or doubt."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e9e1546-1bff-4c85-b4dd-90a364d24ff6",
                                                "sense_id": "0cc11cd8-a2ca-3312-a646-7cc991ada4ca",
                                                "text": "So you go along for a long time / And nothing seems to worry your mind / But what it adds up to / It's the side effect / That finally gets to you"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "593dd36e-d102-3dd0-a984-c99c46966a40",
                                        "entry_id": "130ef716-0611-3497-ac6b-1327b051a6e5",
                                        "glosses": [
                                            "Disturb the peace of mind of; afflict with mental agitation or distress; to exercise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ecd0999-c356-49fb-be7e-7d62079ca989",
                                                "sense_id": "593dd36e-d102-3dd0-a984-c99c46966a40",
                                                "text": "Your tone of voice worries me."
                                            },
                                            {
                                                "example_id": "0e27cd34-44d1-48c7-8dae-db43ac4fdc15",
                                                "sense_id": "593dd36e-d102-3dd0-a984-c99c46966a40",
                                                "text": "That worries the government, which fears that environmental activism could become the foundation for more general political opposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8f92b81-f7f2-3a83-8c5b-ad32b036ee5f",
                                        "entry_id": "130ef716-0611-3497-ac6b-1327b051a6e5",
                                        "glosses": [
                                            "To harass; to irritate or distress."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48cdffd4-aef1-49b7-9526-48a5ebc438c4",
                                                "sense_id": "f8f92b81-f7f2-3a83-8c5b-ad32b036ee5f",
                                                "text": "The President was worried into military action by persistent advisors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b589498c-c60b-3871-aabe-44da3200b11c",
                                        "entry_id": "130ef716-0611-3497-ac6b-1327b051a6e5",
                                        "glosses": [
                                            "To seize or shake by the throat, especially of a dog or wolf."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b021e9e2-15b1-40f9-8776-e91f56dbe2a2",
                                                "sense_id": "b589498c-c60b-3871-aabe-44da3200b11c",
                                                "text": "Your dog’s been worrying sheep again."
                                            },
                                            {
                                                "example_id": "a6d5903d-d459-4d69-b001-bbd77cc27301",
                                                "sense_id": "b589498c-c60b-3871-aabe-44da3200b11c",
                                                "text": "This is the Dog, that worried the Cat, that killed the Rat, that ate the Malt, that lay in the Houſe that Jack built."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d8e5fa1-8557-3bb7-81be-30bb335c1284",
                                        "entry_id": "130ef716-0611-3497-ac6b-1327b051a6e5",
                                        "glosses": [
                                            "To touch repeatedly; to fiddle with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21211eff-80b2-4ce5-8586-22c34578ba34",
                                                "sense_id": "8d8e5fa1-8557-3bb7-81be-30bb335c1284",
                                                "text": "Christian paced the caravan, worrying his beard."
                                            },
                                            {
                                                "example_id": "aa6f70ba-68a0-46f2-bdbb-69f7926bd72e",
                                                "sense_id": "8d8e5fa1-8557-3bb7-81be-30bb335c1284",
                                                "text": "So what if I wanted to touch my nose to the windshield? Who was it hurting? Why was it that he could repeatedly worry his change and bite his lower lip without the threat of punishment?"
                                            },
                                            {
                                                "example_id": "e5fd7ef6-23ce-4d2a-9abd-464f0215f6ad",
                                                "sense_id": "8d8e5fa1-8557-3bb7-81be-30bb335c1284",
                                                "text": "No stories, no arguments. He just worries his prayer beads."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc7ba904-e344-33af-b363-18521406ec6b",
                                        "entry_id": "130ef716-0611-3497-ac6b-1327b051a6e5",
                                        "glosses": [
                                            "To strangle."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be6c123d-cccd-4941-908e-b97f53a6bb5f",
                                                "sense_id": "cc7ba904-e344-33af-b363-18521406ec6b",
                                                "text": "We read (Law's Memor. Pref. lix.) that \"one John Brugh, a notorious warlock (wizard) in the parochin of Fossoquhy, by the space of thirty-six years, was worried at a stake and burned, 1643.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "worry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "182e9c1f-0b23-3860-8a56-f2e1b2f198c0",
                                        "entry_id": "35de140f-a3e1-3a68-9cef-ea2301fc27c7",
                                        "glosses": [
                                            "A strong feeling of anxiety."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f43a88c-6027-465f-8225-9b7c6fce0ab2",
                                                "sense_id": "182e9c1f-0b23-3860-8a56-f2e1b2f198c0",
                                                "text": "I'm afflicted by worry throughout the night."
                                            },
                                            {
                                                "example_id": "02cd96df-057e-47da-a368-edc1acad5c52",
                                                "sense_id": "182e9c1f-0b23-3860-8a56-f2e1b2f198c0",
                                                "text": "\"Worry never solved any problems. Only gives you ulcers.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e33985b-7744-3a68-a60b-b5a3348f0e6c",
                                        "entry_id": "35de140f-a3e1-3a68-9cef-ea2301fc27c7",
                                        "glosses": [
                                            "An instance or cause of such a feeling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2da2f7b7-3186-4711-b332-4270f83a48af",
                                                "sense_id": "4e33985b-7744-3a68-a60b-b5a3348f0e6c",
                                                "text": "My main worry is that I'll miss the train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3edf384a-2209-3c03-b920-27637e02c59b",
                                        "entry_id": "35de140f-a3e1-3a68-9cef-ea2301fc27c7",
                                        "glosses": [
                                            "A person who causes worry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb315a5b-0fbc-4a15-875a-9bbd221036eb",
                                                "sense_id": "3edf384a-2209-3c03-b920-27637e02c59b",
                                                "text": "They could never make him speak a word, although he was old enough, in short, he was a perfect worry night and day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df8e3530-84be-4515-b913-a73f527dbf0a",
                        "source_entry_id": "a2d4465c-1036-3b27-94f2-71dc6bfb534d",
                        "source_sense_id": "f04dd8d2-8abe-3e9e-8205-2fe95fbd5799",
                        "target_lang_word": "inquiétude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inquiétude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfb657d2-c7be-3162-954e-b009a474f8a5",
                                        "entry_id": "d2442b10-0949-3f4f-b338-27af6c0bbe49",
                                        "glosses": [
                                            "État d’une personne inquiète ou qui n’a pas le repos moral."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12cd31ef-b8cb-4b36-95b1-47ca9c6cebd7",
                                                "sense_id": "bfb657d2-c7be-3162-954e-b009a474f8a5",
                                                "text": "Petersen et Kellet, égarés pendant quarante-huit heures, causèrent les plus vives inquiétudes à leurs compagnons."
                                            },
                                            {
                                                "example_id": "7c91c1d5-d085-42f1-8df3-8590b0a7b61f",
                                                "sense_id": "bfb657d2-c7be-3162-954e-b009a474f8a5",
                                                "text": "A l'âge qu'il avait, le sommeil ne perd jamais ses droits, et, en dépit de ses préoccupations et des inquiétudes du lendemain, il dormit aussi bien que dormit le grand Condé, la veille de la bataille de Rocroy."
                                            },
                                            {
                                                "example_id": "5e887bf7-59c3-4326-90a8-e183450e1765",
                                                "sense_id": "bfb657d2-c7be-3162-954e-b009a474f8a5",
                                                "text": "Rentrée à la maison, ayant réussi à faire partager aux voisins son inquiétude, Mme Mirondeau les décida, […], à partir sans tarder à la recherche de son époux."
                                            },
                                            {
                                                "example_id": "4acfb411-729a-472e-a6a6-51056d022a23",
                                                "sense_id": "bfb657d2-c7be-3162-954e-b009a474f8a5",
                                                "text": "En mai 1925, Amundsen était parti en avion à la conquête du Pôle Nord, et la plus grande inquiétude régnait sur son sort."
                                            },
                                            {
                                                "example_id": "fe1686b9-ea8b-4919-9b7e-a9f30bdc434c",
                                                "sense_id": "bfb657d2-c7be-3162-954e-b009a474f8a5",
                                                "text": "— L’enfant dépérissait, la mère et la grand-mère se dévoraient d’inquiétude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1e67d60-804d-30f8-a6b6-d8bec140c491",
                                        "entry_id": "d2442b10-0949-3f4f-b338-27af6c0bbe49",
                                        "glosses": [
                                            "État de tourment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32128923-0c69-4758-bb8b-85516bc72619",
                                                "sense_id": "f1e67d60-804d-30f8-a6b6-d8bec140c491",
                                                "text": "Nous étions tous possédés d’une inquiétude lente qui nous faisait languir. Personne ne s’ennuyait, mais cette sensation poignante était cent fois pire que l’ennui. Il paraissait d’avance que cette nuit n’aurait pas de fin."
                                            },
                                            {
                                                "example_id": "9f1a5257-c7d9-4028-b0a2-8a8037b644e1",
                                                "sense_id": "f1e67d60-804d-30f8-a6b6-d8bec140c491",
                                                "text": "Mais l’ennui dense et profond de bourgeois du XIXᵉ siècle, stade élémentaire, mal élaboré de l’inquiétude métaphysique, vite et facilement converti en suicide individuel ou collectif, était-il préférable ? Le bovarysme fut un problème de masse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "002a81dd-8a7d-359b-8c15-467ca3d56701",
                                        "entry_id": "d2442b10-0949-3f4f-b338-27af6c0bbe49",
                                        "glosses": [
                                            "Inconstance d’humeur, amour du changement qui fait que l’on est toujours mécontent de l’état où l’on se trouve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56007df5-870e-4140-9be9-29ffecfebbf6",
                                                "sense_id": "002a81dd-8a7d-359b-8c15-467ca3d56701",
                                                "text": "Il essaya de se persuader qu’il était à l’aise et en sécurité ; mais bientôt, l’indéfinissable inquiétude de l’animal sociable, abandonné dans la solitude, le tourmenta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be0c167d-33d1-3f60-ac07-fde28f128121",
                                        "entry_id": "d2442b10-0949-3f4f-b338-27af6c0bbe49",
                                        "glosses": [
                                            "Manque de tranquillité, de repos physique."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cac071a-cde1-41f8-b711-b76c35c93474",
                                                "sense_id": "be0c167d-33d1-3f60-ac07-fde28f128121",
                                                "text": "Ce malade a passé la nuit dans une grande inquiétude, dans de grandes inquiétudes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d02165c8-0547-38a4-9c0d-f35d09fc5d27",
                                        "entry_id": "d2442b10-0949-3f4f-b338-27af6c0bbe49",
                                        "glosses": [
                                            "État de trouble, soit sentimental, soit intellectuel, fréquent dans la pathologie des obsédés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e86bdfb-8a91-34c1-b862-c9399b6bfe47",
                                        "entry_id": "d2442b10-0949-3f4f-b338-27af6c0bbe49",
                                        "glosses": [
                                            "Sorte de chaise à bascule en vogue aux XVIII^(ème) et XIX^(ème) siècles."
                                        ],
                                        "tags": [
                                            "Provence"
                                        ],
                                        "examples": [
