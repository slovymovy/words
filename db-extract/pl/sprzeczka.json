                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d1f98e0-1a16-4d58-947d-5c98193978f1",
                        "source_entry_id": "a8628464-24fe-3db7-9a2c-6e22ed8be386",
                        "source_sense_id": "c97cfffa-c55b-3e9d-99c1-ca1a7f40012b",
                        "target_lang_word": "quarrel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quarrel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "43298735-bcd1-3634-8c4d-6e120111159a",
                                        "entry_id": "dce41f8d-dd38-3084-abc9-8bbc3b2914aa",
                                        "glosses": [
                                            "A dispute or heated argument (especially one that is verbal)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1c947c5-b611-46fb-8170-872448380db9",
                                                "sense_id": "43298735-bcd1-3634-8c4d-6e120111159a",
                                                "text": "We got into a silly quarrel about what food to order."
                                            },
                                            {
                                                "example_id": "57276c55-7f5a-4ef7-96d5-8718950c43ae",
                                                "sense_id": "43298735-bcd1-3634-8c4d-6e120111159a",
                                                "text": "Quarrels would not last long, if the fault was only on one side."
                                            },
                                            {
                                                "example_id": "d6f7281c-1eb0-4e34-97ed-e450d49a4552",
                                                "sense_id": "43298735-bcd1-3634-8c4d-6e120111159a",
                                                "text": "But capital was proving difficult to raise; rumours were in the air that the G.W.R. and L.S.W.R. were about to patch up their quarrel, and the people of Southampton, who twelve months earlier had staged a torch-light procession to celebrate the passing of the D.N.S.R. Act, were increasingly loath to part with their cash."
                                            },
                                            {
                                                "example_id": "ac7b4e18-cd66-4cea-8639-dd30ba780138",
                                                "sense_id": "43298735-bcd1-3634-8c4d-6e120111159a",
                                                "text": "All quarrels halt at the grave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48740be1-2600-3080-9581-b18031e4049c",
                                        "entry_id": "dce41f8d-dd38-3084-abc9-8bbc3b2914aa",
                                        "glosses": [
                                            "Often preceded by a form of to have: a basis or ground of dispute or objection; a complaint; also, a feeling or situation of ill will and unhappiness caused by this."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc6f5319-960f-4690-b723-dfac328aa919",
                                                "sense_id": "48740be1-2600-3080-9581-b18031e4049c",
                                                "text": "A few customers in the shop had some quarrels with us, so we called for the manager."
                                            },
                                            {
                                                "example_id": "3ab6d617-2734-4491-b48d-a4e2b2652f03",
                                                "sense_id": "48740be1-2600-3080-9581-b18031e4049c",
                                                "text": "I have no quarrel with her; it’s her partner whom I dislike."
                                            },
                                            {
                                                "example_id": "f2c482fb-07d1-468c-953c-0cbfb72fd7f4",
                                                "sense_id": "48740be1-2600-3080-9581-b18031e4049c",
                                                "text": "I maruaile much my Lords what rage it is,\nThat moues my people whom I loue ſo deare,\nVnder a ſhow of quarrell good and iust,\nTo riſe againſt vs thus in mutinies, […]"
                                            },
                                            {
                                                "example_id": "405b1418-92e5-4072-a456-cf51ef537dd2",
                                                "sense_id": "48740be1-2600-3080-9581-b18031e4049c",
                                                "text": "You miſtake ſir I am ſure, no man hath any quarrell to me: my remembrance is very free and cleere from any image of offence done to any man."
                                            },
                                            {
                                                "example_id": "0355a3ca-e9eb-48ad-9449-faa1b82cea2b",
                                                "sense_id": "48740be1-2600-3080-9581-b18031e4049c",
                                                "text": "Therefore Herodias had a quarrel against him [John the Baptist], and would haue killed him, but ſhe could not."
                                            },
                                            {
                                                "example_id": "4f4642dd-c251-4424-8128-c39257aa3022",
                                                "sense_id": "48740be1-2600-3080-9581-b18031e4049c",
                                                "text": "I am sorry, with all my heart, to find you so resolute. We have never had any quarrel, to which I have been a party. But I have made the trial in homage to Christmas, and I'll keep my Christmas humour to the last. So A Merry Christmas, uncle!"
                                            },
                                            {
                                                "example_id": "53bcb917-73c7-42e4-826e-9ac8e279aca0",
                                                "sense_id": "48740be1-2600-3080-9581-b18031e4049c",
                                                "text": "The material is powerful, though more theatrical than realistic. The writing is good. On thinking the play over, however, I came up with a few quarrels with it, and I wonder if to some Rabe has not attempted to cover some weaknesses in construction with the sensationalism of shocking bloodshed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0add9a47-42a1-3cd6-b706-ab73bcfc7806",
                                        "entry_id": "dce41f8d-dd38-3084-abc9-8bbc3b2914aa",
                                        "glosses": [
                                            "A propensity to quarrel; quarrelsomeness."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c4077e5-d587-40be-bbda-61ce6c304643",
                                                "sense_id": "0add9a47-42a1-3cd6-b706-ab73bcfc7806",
                                                "text": "If I can faſten but one cup vpon him, / With that which he hath drunke to night already, / Hee'll be as full of quarrell and offence, / As my young miſtris dog:— [...]"
                                            },
                                            {
                                                "example_id": "48f4b233-24bd-42f1-8519-380977760665",
                                                "sense_id": "0add9a47-42a1-3cd6-b706-ab73bcfc7806",
                                                "text": "[A]ll beaſts and birds aſſembled; and forgetting their ſeuerall appetites; ſome of pray, ſome of game, ſome of quarrell, ſtood all ſociably together liſtening vnto the ayres and accords of the Harpe; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quarrel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52cf085f-910c-38d2-8d69-ee456da68a7b",
                                        "entry_id": "dd0b5364-12da-3819-9581-6a08614c7c45",
                                        "glosses": [
                                            "To argue fiercely; to contend; to squabble; to cease to be on friendly terms, to fall out."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af3975fa-de5a-494c-aa60-6befe63e392e",
                                                "sense_id": "52cf085f-910c-38d2-8d69-ee456da68a7b",
                                                "text": "[T]here is no doubt but the facture or framing of the inward parts, is as full of difference, as the outward, and in that, is the Cauſe Continent of many diſeaſes, which not be obſerued, they quarrell many times with the humors which are not in fault, the fault being in the very frame and Mechanicke of the parte, which cannot be remoued by medicine alteratiue, but muſt be accomodate and palliate by dyets and medicines familiar."
                                            },
                                            {
                                                "example_id": "42054028-79ca-4b53-b592-e325344d7197",
                                                "sense_id": "52cf085f-910c-38d2-8d69-ee456da68a7b",
                                                "text": "Nay, they [animals] feed quietly together while there is enough for them all: Quarrel onely when it begins to fail; and when 'tis ended, they ſcatter to ſeek out new encounters. Besides, thoſe called ſociable, quarrel in hunger and in luſt, as well as the others; [...]"
                                            },
                                            {
                                                "example_id": "da7450ff-1e17-45a9-a7d5-b44962ffd480",
                                                "sense_id": "52cf085f-910c-38d2-8d69-ee456da68a7b",
                                                "text": "I know, my dears, that when we recollect how patient and how mild he was; although he was a little, little child; we shall not quarrel easily among ourselves, and forget poor Tiny Tim in doing it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "915510eb-f36e-3ec3-85a2-8c2380d58441",
                                        "entry_id": "dd0b5364-12da-3819-9581-6a08614c7c45",
                                        "glosses": [
                                            "To find fault; to cavil."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc527715-87c6-4158-b935-83dcf448c9c4",
                                                "sense_id": "915510eb-f36e-3ec3-85a2-8c2380d58441",
                                                "text": "to quarrel with one’s lot"
                                            },
                                            {
                                                "example_id": "2df98efa-bb49-49f7-9fc0-06f00761ae49",
                                                "sense_id": "915510eb-f36e-3ec3-85a2-8c2380d58441",
                                                "text": "Be not too rigidly Cenſorious, / A ſtring may jarr in the beſt Maſters hand, / And the moſt skilfull Archer miſs his aim; / But in a Poem elegantly writ, / I will not quarrel with a ſlight miſtake, / Such as our Natures frailty may excuſe; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d768092-6776-384e-852b-cb506c4c8e9a",
                                        "entry_id": "dd0b5364-12da-3819-9581-6a08614c7c45",
                                        "glosses": [
                                            "Followed by at: to disagree with; to take offence."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f0a66e7-c367-3206-b46e-f57c17d0c90f",
                                        "entry_id": "dd0b5364-12da-3819-9581-6a08614c7c45",
                                        "glosses": [
                                            "To argue or squabble with (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "865e8a8b-5f77-4cd5-9087-bb95a421f779",
                                                "sense_id": "1f0a66e7-c367-3206-b46e-f57c17d0c90f",
                                                "text": "[T]hey would ſay [...] that I had quarrell'd / My brother purpoſely, thereby to finde / An apt pretext, to baniſh them my houſe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quarrel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d39c41d-3494-3fb6-9c8e-d46a45355611",
                                        "entry_id": "d4fdf03b-97a9-3ae4-ae77-4692864611d9",
                                        "glosses": [
                                            "An arrow or bolt for a crossbow or an arbalest (“a late, large type of crossbow”), traditionally with the head square in its cross section."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5558c074-bbb5-45fe-9c7b-7b95294df0f7",
                                                "sense_id": "4d39c41d-3494-3fb6-9c8e-d46a45355611",
                                                "text": "Twanged the ſtring, out flew the quarell long, / And through the ſubtile aire did ſinging pas, / It hit the knight the buckles rich among, / Wherewith his pretious girdle faſt'ned was, / It bruſed them and pearſt his hawberke ſtrong, / Some little blood downe trickled on the gras; [...]"
                                            },
                                            {
                                                "example_id": "be0e5821-be43-47cb-b90e-3990112c1dbc",
                                                "sense_id": "4d39c41d-3494-3fb6-9c8e-d46a45355611",
                                                "text": "Here be two arblasts, comrade, with windlaces and quarrells—to the barbican with you, and see you drive each bolt through a Saxon brain."
                                            },
                                            {
                                                "example_id": "2fd006e1-3a72-4879-8ef1-58cb1f9c550e",
                                                "sense_id": "4d39c41d-3494-3fb6-9c8e-d46a45355611",
                                                "text": "The small cross-bow, called the arbalet or arbalest, is said to have been invented by the Sicilians. It was carried by the foot-soldiers, and when used was charged with a quarrel or bar-bolt, that is, a small arrow with a flat head, one of which occasioned the death of Harold [Godwinson] at the battle of Hastings, [...]"
                                            },
                                            {
                                                "example_id": "428ca81b-c971-45f0-8a90-3bca0bc87861",
                                                "sense_id": "4d39c41d-3494-3fb6-9c8e-d46a45355611",
                                                "text": "\"What was that?\" he asked, as a hissing, sharp-drawn voice seemed to whisper in his ear. The steersman smiled, and pointed with his foot to where a short heavy cross-bow quarrel stuck quivering in the boards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9606ea6-0a2b-3621-92c0-93b0b28f6505",
                                        "entry_id": "d4fdf03b-97a9-3ae4-ae77-4692864611d9",
                                        "glosses": [
                                            "A diamond- or square-shaped piece of glass forming part of a lattice window."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfc8306d-d588-3797-9570-bad56171deab",
