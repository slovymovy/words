                        "examples": [
                            {
                                "example_id": "291f0840-1276-4bfb-bc92-fc73b65aac0e",
                                "sense_id": "3b5c16ed-d7ea-3e83-8852-a338f17ba4c6",
                                "text": "Ce conte recueilli de la tradition orale hispanique, qui met en scène un fastueux taureau truqué, est une étrange histoire, l’odyssée fantastique d’une Princesse que sa disgrâce amoureuse nous rend dès le début compatissable."
                            },
                            {
                                "example_id": "23fd791d-4d13-47b1-a3c9-93c7d352bdb8",
                                "sense_id": "3b5c16ed-d7ea-3e83-8852-a338f17ba4c6",
                                "text": "J’ai commencé vendredi soir en me cassant le petit doigt de pied (pas la peine de s’étendre sur les circonstances qui n’ont rien de compatissable)"
                            },
                            {
                                "example_id": "ca506dd5-7f42-4f42-b627-e4dd4566f546",
                                "sense_id": "3b5c16ed-d7ea-3e83-8852-a338f17ba4c6",
                                "text": "Elle est faite avec des vers d’antan, elle est bruyante et compatissable — elle est autobiographique."
                            }
                        ]
                    }
