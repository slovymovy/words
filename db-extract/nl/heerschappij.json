                        "sense_id": "2cf768cf-f052-3767-b7a5-12567c1146d8",
                        "entry_id": "159a6012-d0bb-3984-9897-bbe8bf81dbee",
                        "glosses": [
                            "geheel der dingen waarover iemands macht zich uitstrekt, waarover hij heerst (bewind uitoefent) en het daarbij horende gezag geniet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc1fd7da-47e5-4003-b157-87306ecc4fd5",
                                "sense_id": "2cf768cf-f052-3767-b7a5-12567c1146d8",
                                "text": "De partijen die drie maanden hebben gevochten om de heerschappij in de Somalische hoofdstad, Mogadishu, hebben gisternacht een wapenstilstandsakkoord getekend."
                            }
                        ]
                    },
                    {
                        "sense_id": "5dfd916f-07a4-3cca-8a1f-4efa2f484ffb",
                        "entry_id": "159a6012-d0bb-3984-9897-bbe8bf81dbee",
                        "glosses": [
                            "de opperbestuur van god"
                        ],
                        "tags": [],
