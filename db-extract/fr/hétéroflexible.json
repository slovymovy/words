                "senses": [
                    {
                        "sense_id": "d6f12f71-544d-31d4-949e-c2809214ca2c",
                        "entry_id": "3947f8e3-40e4-3596-8a80-cb4cad1f7c98",
                        "glosses": [
                            "Personne qui, sans être homosexuelle ou bisexuelle, peut se laisser tenter par une relation homosexuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "576d958c-6514-4bee-96b4-a436f8d7466a",
                                "sense_id": "d6f12f71-544d-31d4-949e-c2809214ca2c",
                                "text": "Le type genre hétéroflexible (avec un accent sur flexible) avance sa main droite et caresse la cuisse de Rasmus qui incline la tête en arrière, ferme les yeux, sourit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f87f402-18e6-4796-be6f-df2cdd37faf0",
                        "source_entry_id": "3947f8e3-40e4-3596-8a80-cb4cad1f7c98",
                        "source_sense_id": "d6f12f71-544d-31d4-949e-c2809214ca2c",
                        "target_lang_word": "heteroflexible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heteroflexible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81ac0ad9-57e0-3ace-9fb6-a02d40445e86",
                                        "entry_id": "0ad4a834-1658-3a0c-9bb3-e78c9aa6dd7e",
                                        "glosses": [
                                            "Primarily heterosexual, but open to taking part in a limited amount of homosexual activity."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f52eef6-5bd4-42ab-8add-5a4bbd295400",
                                                "sense_id": "81ac0ad9-57e0-3ace-9fb6-a02d40445e86",
                                                "text": "We are living at a time when youthful attitudes toward casual sexual encounters and pliable sexual boundaries have spawned a whole new vocabulary of sexuality (\"pansexual,\" \"ambisexual,\" \"polysexual,\" and \"heteroflexible,\" according to a"
                                            },
                                            {
                                                "example_id": "312445a7-feae-4c1b-889f-dd1cb874482a",
                                                "sense_id": "81ac0ad9-57e0-3ace-9fb6-a02d40445e86",
                                                "text": "It is a rejection of bisexuality since the inevitable question that comes up in bisexuality is one of preference, and the preference of the heteroflexible is quite clear. Here postmodern heterosexuals can envision indulging in homosexual sex."
                                            },
                                            {
                                                "example_id": "cbf69f3a-f59b-4521-9301-5eda647960f8",
                                                "sense_id": "81ac0ad9-57e0-3ace-9fb6-a02d40445e86",
                                                "text": "A “boi” describes a boyish gay guy or abiological female with a male presentation; and “heteroflexible” refers to a straight person with a queer mindset"
                                            },
                                            {
                                                "example_id": "220bda6f-bcc9-42e7-acbf-80942d0cd202",
                                                "sense_id": "81ac0ad9-57e0-3ace-9fb6-a02d40445e86",
                                                "text": "Dery describes Bowie as \"a reverse-drag queen: a heteroflexible straight man playing an exquisitely androgynous gay.\""
                                            },
                                            {
                                                "example_id": "7ab1232c-0c30-45ee-8da5-ea0d676bd48d",
                                                "sense_id": "81ac0ad9-57e0-3ace-9fb6-a02d40445e86",
                                                "text": "Let me start by saying that yes, people can be heteroflexible, homoflexible and bisexual."
                                            },
                                            {
                                                "example_id": "7901c909-9ea7-4004-9e01-cc18737f6651",
                                                "sense_id": "81ac0ad9-57e0-3ace-9fb6-a02d40445e86",
                                                "text": "If you know me, you might know I've bounced around a lot with my sexual orientation — from straight to heteroflexible to queer to \"I'm not going to label myself as anything, and I’ll just take things as they come\" — pun intended."
                                            }
                                        ]
                                    }
                                ]
                            },
