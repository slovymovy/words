                                        "glosses": [
                                            "A person who worries a great deal, especially unnecessarily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d71389b-79b5-4736-b5fd-8bf0445208af",
                                                "sense_id": "63fbe989-0d1d-34e1-b3e9-f10c49ee0a26",
                                                "text": "You are such a worrier! I'm sure everything will turn out all right."
