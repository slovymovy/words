                                            {
                                                "example_id": "67a26331-8e09-426b-9ec8-df2aa9c49de5",
                                                "sense_id": "4d4f5919-f769-3ff4-82ac-b7d4a2fa1af5",
                                                "text": "Die Insel Ibiza ist ein beliebtes Urlaubsziel."
                                            },
                                            {
                                                "example_id": "d7076812-e43b-4631-8636-6f1cf4cfc9fe",
                                                "sense_id": "4d4f5919-f769-3ff4-82ac-b7d4a2fa1af5",
                                                "text": "„Die Korruptionsjäger haben umfangreich geprüft, ob Straches öffentlich einsehbare Aussagen auf Ibiza strafbar waren.“"
                                            },
                                            {
                                                "example_id": "64e4d028-42a2-4838-a4b8-0120a2e4447c",
                                                "sense_id": "4d4f5919-f769-3ff4-82ac-b7d4a2fa1af5",
                                                "text": "„Etwa sieben Stunden dauern die Aufnahmen des Treffens mit Heinz-Christian Strache auf Ibiza.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
