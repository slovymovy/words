                },
                {
                    "sense_id": "ee4879e2-cce8-3be5-9aab-fc67ad58c465",
                    "sense_definition": "suchy, sypki i drobny śnieg utrudniający ślizg nart",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na stoku leżał zmarznięty <w>gips</w>, przez co zjeżdżanie na nartach sprawiało dużą trudność.",
                            "target_lang_translations": {
                                "ru": "На склоне лежал замерзший <w>«гипс»</w>, из-за чего катание на лыжах вызывало большие трудности."
                            }
                        },
                        {
                            "text": "Po takim tępym <w>gipsie</w> nie da się płynnie zjeżdżać, więc zrezygnowaliśmy z treningu.",
                            "target_lang_translations": {
                                "ru": "По такому <w>тупому снегу</w> невозможно плавно съезжать, поэтому мы отменили тренировку."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "narciarski"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сухой, сыпучий и «тупой» снег, затрудняющий скольжение лыж"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гипс",
