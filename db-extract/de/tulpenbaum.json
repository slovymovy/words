                "senses": [
                    {
                        "sense_id": "afc7d512-8a89-3634-9b0a-d45129b19746",
                        "entry_id": "5239bcf3-cf0c-3ad3-9be6-71bad90d7282",
                        "glosses": [
                            "bis 35 m hoher, (nur im Blüteninneren) gelb blühender nordamerikanischer Baum aus der Familie der Magnoliengewächse"
                        ],
                        "tags": [
                            "Liriodéndron tulipífera"
                        ],
                        "examples": [
                            {
                                "example_id": "46d2dbf6-ebdf-4747-a144-586da52a6408",
                                "sense_id": "afc7d512-8a89-3634-9b0a-d45129b19746",
                                "text": "Der Tulpenbaum liefert ein wertvolles Holz."
                            },
                            {
                                "example_id": "00ce54af-72aa-442a-8cb4-928596aa60f6",
                                "sense_id": "afc7d512-8a89-3634-9b0a-d45129b19746",
                                "text": "„Ahorn und Platanen wechselten ab, und dazwischen drängten sich allerlei Ziersträucher zusammen, aus denen hervor es buntfarbig blühte: Tulpenbaum und Goldregen und Schneeball und Akazie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b31c8b39-2bd0-3aa2-bdd9-2fe4bfddd643",
                        "entry_id": "5239bcf3-cf0c-3ad3-9be6-71bad90d7282",
                        "glosses": [
                            "volkstümlich für die frühblühende Tulpen-Magnolie"
                        ],
                        "tags": [
                            "Magnólia × soulangiána"
                        ],
                        "examples": [
                            {
                                "example_id": "9a7d98c2-9a50-4c91-bbbb-e01670f83fc5",
                                "sense_id": "b31c8b39-2bd0-3aa2-bdd9-2fe4bfddd643",
                                "text": "Nachbars Tulpenbaum blüht wieder schön."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
