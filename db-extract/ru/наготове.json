        "ru-extract.jsonl": [
            {
                "entry_id": "327774a3-d87c-3869-b57e-b935c6e3e702",
                "word": "наготове",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0b4cf867-fc3c-3dcb-8cac-7601f51f3e9b",
                        "entry_id": "327774a3-d87c-3869-b57e-b935c6e3e702",
                        "glosses": [
                            "в состоянии готовности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feba3b6e-25ec-46ee-866c-1f02c030c8a0",
                                "sense_id": "0b4cf867-fc3c-3dcb-8cac-7601f51f3e9b",
                                "text": "Мало ли что может случиться, и командир старался быть наготове."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0308359-a908-4410-94fc-3a60a53cdde2",
                        "source_entry_id": "327774a3-d87c-3869-b57e-b935c6e3e702",
                        "source_sense_id": "0b4cf867-fc3c-3dcb-8cac-7601f51f3e9b",
                        "target_lang_word": "prêt",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prêt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a80e9b9-c504-3a76-8570-ec44dfc3627b",
                                        "entry_id": "07d886c6-2a97-30ab-b22d-36ec4279a66f",
                                        "glosses": [
                                            "Qui est en état de faire, de dire, de recevoir, d’entendre quelque chose ; qui est disposé, préparé à quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1023e977-fe93-4755-90b5-9102132c92e0",
                                                "sense_id": "9a80e9b9-c504-3a76-8570-ec44dfc3627b",
                                                "text": "Le dîner est prêt."
                                            },
                                            {
                                                "example_id": "4a40baed-8f68-4401-85b8-e2bcff09785a",
                                                "sense_id": "9a80e9b9-c504-3a76-8570-ec44dfc3627b",
                                                "text": "Tenez-vous prêt pour partir dans deux heures."
                                            },
                                            {
                                                "example_id": "f1674cbe-4fce-4809-b0d3-ef0d594befd7",
                                                "sense_id": "9a80e9b9-c504-3a76-8570-ec44dfc3627b",
                                                "text": "Je suis prêt à vous entendre."
                                            },
                                            {
                                                "example_id": "2b95c41b-ca15-4d83-9273-7bac48378eca",
                                                "sense_id": "9a80e9b9-c504-3a76-8570-ec44dfc3627b",
                                                "text": "En sommes, tu restes alors tout près de lui, mais également tout prêt pour lui."
                                            },
                                            {
                                                "example_id": "87d4d8a4-6931-4980-a0cb-ade88ca8f97a",
                                                "sense_id": "9a80e9b9-c504-3a76-8570-ec44dfc3627b",
                                                "text": "C’est un homme qui n’est jamais prêt : C’est un homme qui est toujours en retard, qui n’a jamais fait à temps ses préparatifs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prêt",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "57c4a40a-f8a7-325d-99a7-23d64c5bb769",
                                        "entry_id": "db61e2c7-4bec-3aaa-8532-a9a10b98889c",
                                        "glosses": [
                                            "Action de prêter de l’argent, moyennant ou non des intérêts, ou autre chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9379cc27-edf2-43be-a8ab-97e92c7e1299",
                                                "sense_id": "57c4a40a-f8a7-325d-99a7-23d64c5bb769",
                                                "text": "Je ne vous donne pas ce livre, ce n’est qu’un prêt."
                                            },
                                            {
                                                "example_id": "8cef115c-64e0-48f0-bda2-ab5313dc57b4",
                                                "sense_id": "57c4a40a-f8a7-325d-99a7-23d64c5bb769",
                                                "text": "En Assyrie, en Égypte, l’intermédiarat existait, et, aussi, le prêt avec intérêt. Les paysans, manquant de blé, empruntaient des lingots d’or ou d’argent pour s’en procurer ; puis, quand il leur fallait rendre ces lingots, ils vendaient la récolte à perte, naturellement, à des trusteurs qui devinrent peu à peu maîtres du marché."
                                            },
                                            {
                                                "example_id": "dc93b794-30fd-430b-b63d-59d6d95a5ab5",
                                                "sense_id": "57c4a40a-f8a7-325d-99a7-23d64c5bb769",
                                                "text": "En 1545, l’évêque de Strasbourg interdit à ses ouailles de contracter des prêts hypothécaires chez des juifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5d3b973-8462-35ec-9762-e91573e610dd",
                                        "entry_id": "db61e2c7-4bec-3aaa-8532-a9a10b98889c",
                                        "glosses": [
                                            "Somme prêtée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2e2cddf-80d8-4826-91f0-e7c89d581b48",
                                                "sense_id": "b5d3b973-8462-35ec-9762-e91573e610dd",
                                                "text": "Un prêt considérable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3809359b-65ef-3acf-899a-b096050930b1",
                                        "entry_id": "db61e2c7-4bec-3aaa-8532-a9a10b98889c",
                                        "glosses": [
                                            "Somme allouée aux sous-officiers et aux soldats pour leurs menus besoins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba30cc70-5521-4257-a741-700df4496bc9",
                                                "sense_id": "3809359b-65ef-3acf-899a-b096050930b1",
                                                "text": "On paie le prêt tous les dix jours."
                                            },
                                            {
                                                "example_id": "39315975-9401-48a4-a3af-bfab4321e2d3",
                                                "sense_id": "3809359b-65ef-3acf-899a-b096050930b1",
                                                "text": "Prêt franc : Somme allouée aux sous-officiers et aux hommes dispensés de vivre à l’ordinaire, et qui leur sert non seulement comme argent de poche, mais aussi pour leur nourriture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
