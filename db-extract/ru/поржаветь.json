                        "examples": [
                            {
                                "example_id": "b64ccd25-549c-4021-94bc-0ce38972fdef",
                                "sense_id": "25d6f7a0-697b-3684-b198-5ec3e22421b4",
                                "text": "Дом потемнел, крыша поржавела, дверь в лавке, обитая железом, тяжёлая, выкрашенная в зелёный цвет, пожухла, или, как говорил глухой, «зашкорубла»; и сам старик Цыбукин потемнел как будто."
                            }
                        ]
                    }
