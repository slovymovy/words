                                "target_senses": [
                                    {
                                        "sense_id": "24beef04-c711-3e4e-890c-b7bdea9f1e72",
                                        "entry_id": "e2b1233d-6b81-3db9-842f-397a7d96f69e",
                                        "glosses": [
                                            "книжн., юр. тот, кто даёт гарантию в чём-либо, ручательство за кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b32d90fd-d43d-41a6-bf66-dc7ae0600c6f",
                                                "sense_id": "24beef04-c711-3e4e-890c-b7bdea9f1e72",
                                                "text": "Турецкие военные по конституции стали главными гарантами светскости государства."
                                            },
                                            {
                                                "example_id": "4d2bd512-7d3a-4ce4-913a-d95fbfb0579b",
                                                "sense_id": "24beef04-c711-3e4e-890c-b7bdea9f1e72",
                                                "text": "Банки, не желая потерять таких клиентов, стали гарантами наших внешнеторговых сделок и коммерческих операций."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcd7299b-449b-3a92-bb12-b025ea55486a",
                                        "entry_id": "e2b1233d-6b81-3db9-842f-397a7d96f69e",
                                        "glosses": [
                                            "разг. то же, что гарантия; залог чего-либо; условие, обеспечивающее существование чего-либо;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9372735-4cf5-4083-bbe1-771cf6538d55",
                                                "sense_id": "fcd7299b-449b-3a92-bb12-b025ea55486a",
                                                "text": "Мало того, снижение цены вообще не является гарантом увеличения продаж, особенно если недостаточно проработаны каналы сбыта или отсутствует продвижение."
                                            },
                                            {
                                                "example_id": "dfd337b6-58ad-4e11-95bd-66bb8917ea89",
                                                "sense_id": "fcd7299b-449b-3a92-bb12-b025ea55486a",
                                                "text": "Есть еще один гарант безопасности трубопроводов — масштабы нового строительства."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "524d6228-7122-3417-90a0-753c439b5ff2",
                                        "entry_id": "e2b1233d-6b81-3db9-842f-397a7d96f69e",
                                        "glosses": [
                                            "разг. то же, что гарант Конституции"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
