                    "synonyms": [
                        "melodie",
                        "wijs",
                        "deun"
                    ],
                    "target_lang_definitions": {
                        "en": "The melody or the tune of a song or piece of music.",
                        "ru": "Мелодия или мотив песни или музыкального произведения."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tune",
                                "target_lang_sense_clarification": "a melody or musical sequence"
                            },
                            {
                                "target_lang_word": "melody",
                                "target_lang_sense_clarification": "the principal part in a harmonic composition"
                            },
                            {
                                "target_lang_word": "air",
                                "target_lang_sense_clarification": "a simple tune or melody"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мотив",
                                "target_lang_sense_clarification": "мелодия или напев"
                            },
                            {
                                "target_lang_word": "мелодия",
                                "target_lang_sense_clarification": "последовательность звуков, образующая музыкальное целое"
                            },
                            {
