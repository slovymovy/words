{
    "word_family": [
        "afstoten",
        "afstoting",
        "stotelijk"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "402498e6-709c-3503-a7d3-6fdfbaeb81ea",
                    "sense_definition": "zeer onaantrekkelijk of weerzinwekkend om te zien",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "onaantrekkelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De knappe vrouw had een <w>afstotelijke</w> lelijke maar wel heel erg rijke man.",
                            "target_lang_translations": {
                                "en": "The beautiful woman had a <w>repulsively</w> ugly but very wealthy husband."
                            }
                        },
                        {
                            "text": "Hij vond het <w>afstotelijke</w> uiterlijk van het monster angstaanjagend.",
                            "target_lang_translations": {
                                "en": "He found the monster's <w>hideous</w> appearance terrifying."
                            }
                        }
                    ],
                    "synonyms": [
                        "afstotend",
                        "lelijk",
                        "stuitend",
                        "afschuwelijk"
                    ],
                    "antonyms": [
                        "aantrekkelijk",
                        "begerenswaardig"
                    ],
                    "common_phrases": [
                        "afstotelijke uiterlijk",
                        "afstotelijke man"
                    ],
                    "target_lang_definitions": {
                        "en": "extremely unattractive or repulsive to look at"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "repulsive",
                                "target_lang_sense_clarification": "causing intense distaste or disgust"
                            },
                            {
                                "target_lang_word": "hideous",
                                "target_lang_sense_clarification": "extremely ugly"
                            },
                            {
                                "target_lang_word": "revolting",
                                "target_lang_sense_clarification": "physically disgusting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d1ff1d4-9b46-3603-bb46-35f37207447e",
                    "sense_definition": "gevoelens van afkeer of walging opwekkend",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onaantrekkelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn gedrag was zo <w>afstotelijk</w> dat niemand meer met hem wilde praten.",
                            "target_lang_translations": {
                                "en": "His behavior was so <w>repellent</w> that no one wanted to talk to him anymore."
                            }
                        },
                        {
                            "text": "De geur in de verlaten fabriek was werkelijk <w>afstotelijk</w>.",
                            "target_lang_translations": {
                                "en": "The smell in the abandoned factory was truly <w>revolting</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "afstotend",
                        "stuitend",
                        "afschuwelijk"
                    ],
                    "antonyms": [
                        "aantrekkelijk"
                    ],
                    "common_phrases": [
                        "afstotelijk gedrag"
                    ],
                    "target_lang_definitions": {
                        "en": "arousing feelings of dislike, aversion, or disgust"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "repellent",
                                "target_lang_sense_clarification": "causing a feeling of strong dislike"
                            },
                            {
                                "target_lang_word": "off-putting",
                                "target_lang_sense_clarification": "unpleasant or unattractive in behavior or nature"
                            },
                            {
                                "target_lang_word": "loathsome",
                                "target_lang_sense_clarification": "causing hatred or disgust"
                            }
                        ]
                    }
                }
            ]
        }
    ]
