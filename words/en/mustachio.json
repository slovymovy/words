                    "sense_definition": "To adorn or cover with a mustache or a mark resembling one.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thick foam from the hot cocoa had <w>mustachioed</w> the child's upper lip.",
                            "target_lang_translations": {
                                "de": "Dicker Schaum von der heißen Schokolade hatte der Oberlippe des Kindes <w>einen Schnurrbart verpasst</w>."
                            }
                        },
                        {
                            "text": "A streak of black engine grease <w>mustachioed</w> the mechanic's face.",
                            "target_lang_translations": {
                                "de": "Ein Streifen schwarzer Motorschmiere <w>zierte</w> das Gesicht des Mechanikers <w>wie ein Schnurrbart</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Mit einem Schnurrbart oder einem schnurrbartähnlichen Fleck versehen oder bedecken."
                    },
