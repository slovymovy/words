                                    {
                                        "sense_id": "ee91857b-e8d3-316c-b487-1a6444527496",
                                        "entry_id": "38da193c-5def-311b-9b6a-dd44199b6741",
                                        "glosses": [
                                            "che finge di soffrire o una condizione di bisogno cercando poi di fare del male"
