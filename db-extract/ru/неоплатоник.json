                    {
                        "translation_id": "b620dcf4-3b94-4350-affb-f5c3eddacc9a",
                        "source_entry_id": "bfff6804-9ed6-3165-926a-7e424849067c",
                        "source_sense_id": "99beeb60-c2f4-3f56-aaf0-c876d8731b41",
                        "target_lang_word": "Neuplatoniker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neuplatoniker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b95649f-c661-3cf4-b727-ce20a07601a9",
                                        "entry_id": "dfb00a67-c90a-3eed-9c8a-f1c5178f7888",
                                        "glosses": [
                                            "Anhänger der philosophischen Strömung des Neuplatonismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "242017a1-26bb-4c7e-9db0-c4d7f8895a5c",
                                                "sense_id": "5b95649f-c661-3cf4-b727-ce20a07601a9",
                                                "text": "„Der wichtigste Neuplatoniker war Plotin (ca. 205–270), der in Alexandria Philosophie studierte, später jedoch nach Rom umzog.“"
                                            },
                                            {
                                                "example_id": "4a0a950d-84f6-47cf-b495-2d324b450253",
                                                "sense_id": "5b95649f-c661-3cf4-b727-ce20a07601a9",
                                                "text": "„Bei Aristoteles war die aporetische Methode eine Methode wirklicher Forschung gewesen. Bei den Alexandrinern und im wesentlichen auch bei den Neuplatonikern wurde sie zu einer Methode der Exegese.“"
                                            },
                                            {
                                                "example_id": "eea4c70a-1ce1-475a-96ff-9fe610db090d",
                                                "sense_id": "5b95649f-c661-3cf4-b727-ce20a07601a9",
                                                "text": "„Hier hingen am Munde eines Gemistho Plethon des Neuplatonikers, eines Marsiglio Ficino und Pico della Mirandola auch Deutsche, die dann als unschätzbares Gut Liebe und Kenntnis der griechischen Sprache mit nach Deutschland brachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "facafe84-b720-4126-ae44-fa4597923f2e",
                        "source_entry_id": "bfff6804-9ed6-3165-926a-7e424849067c",
