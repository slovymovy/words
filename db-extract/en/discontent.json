            {
                "entry_id": "697b33bc-1b82-3c3d-b3bf-f2a63eaa1265",
                "word": "discontent",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "deb53963-6722-400d-854d-11341f742a2c",
                        "entry_id": "697b33bc-1b82-3c3d-b3bf-f2a63eaa1265",
                        "tags": [
                            "plural"
                        ],
                        "form": "discontents"
