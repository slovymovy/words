                        "entry_id": "386c119f-7b72-35a1-aa41-d4a6748aa926",
                        "glosses": [
                            "разг. наполнить чем-либо, засовывая, всовывая внутрь"
                        ],
                        "tags": [
                            "что. и чего."
                        ],
                        "examples": [
                            {
                                "example_id": "0860d739-20b1-4bde-a522-788a3a068f50",
                                "sense_id": "c0170738-7f2d-3077-b44a-765b9c7772e8",
                                "text": "Насовать полный карман орехов."
                            },
                            {
                                "example_id": "5936df1a-a61c-43d2-9a84-5a8d2c328314",
                                "sense_id": "c0170738-7f2d-3077-b44a-765b9c7772e8",
                                "text": "Насовать целый чемодан шмоток."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9d60c7d-cf26-355e-9a07-a66d54599a76",
                        "entry_id": "386c119f-7b72-35a1-aa41-d4a6748aa926",
                        "glosses": [
                            "разг. всунуть кому-либо, засунуть внутрь чего-либо в каком-либо (обычно большом) количестве"
                        ],
                        "tags": [
                            "что. и чего., кому., куда., во что."
                        ],
                        "examples": [
                            {
                                "example_id": "19e8d42e-b15f-4ef8-b414-d2408bde178d",
                                "sense_id": "f9d60c7d-cf26-355e-9a07-a66d54599a76",
                                "text": "Насовать кому-либо ворох цветов."
                            },
                            {
                                "example_id": "f7a29f3f-0a6c-47dd-a62c-d396131293a9",
                                "sense_id": "f9d60c7d-cf26-355e-9a07-a66d54599a76",
                                "text": "Насовать кому-либо конфет."
                            },
                            {
