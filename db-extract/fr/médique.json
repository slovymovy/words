                    {
                        "sense_id": "bed6f2f0-4869-35cf-9cf2-ab6652ff8606",
                        "entry_id": "d09c0161-6e40-326d-b940-76394ea5286d",
                        "glosses": [
                            "Qui appartient aux Mèdes, ou aux Perses que les Grecs appelaient souvent Mèdes."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "f83d4687-2c69-4f68-8e4d-ae98d12807a8",
                                "sense_id": "bed6f2f0-4869-35cf-9cf2-ab6652ff8606",
                                "text": "Les guerres médiques, guerres que les Perses firent aux Grecs dans le cinquième siècle avant J.-C."
                            },
                            {
                                "example_id": "4b0598a7-032c-43f8-a5c4-19c11bd4327e",
                                "sense_id": "bed6f2f0-4869-35cf-9cf2-ab6652ff8606",
                                "text": "La première guerre médique, la seconde guerre médique."
                            },
                            {
                                "example_id": "c6af7ea1-c897-4526-81f5-5d6682a33a3a",
                                "sense_id": "bed6f2f0-4869-35cf-9cf2-ab6652ff8606",
                                "text": "La puissance ninivite s'écroula sous une invasion médique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83ec2561-84b2-4d10-8759-9a152ba8cd0d",
                        "source_entry_id": "d09c0161-6e40-326d-b940-76394ea5286d",
                        "source_sense_id": "bed6f2f0-4869-35cf-9cf2-ab6652ff8606",
                        "target_lang_word": "Median",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Median",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ddbf5b5-7449-3e4b-a762-43480612595b",
                                        "entry_id": "a1fa8345-6e93-3e98-89d0-2fa156b4d1e1",
                                        "glosses": [
                                            "Relating to Media or Medes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75366d69-a314-40eb-a87c-8677a3baec99",
                                                "sense_id": "1ddbf5b5-7449-3e4b-a762-43480612595b",
                                                "text": "Lucullus seeing certaine Median men at armes, which were in the front of Tigranes Army, heavily and unweildily armed, as in an iron prison, apprehended thereby an opinion, that he might easily defeat them[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6625356b-ff1f-3bfe-a2e0-a803486a560c",
                                        "entry_id": "a1fa8345-6e93-3e98-89d0-2fa156b4d1e1",
                                        "glosses": [
                                            "Of laws, rules etc.: unchanging, invariable."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab8db9e-77cc-45a0-89b7-5cd668ce6b53",
                                                "sense_id": "6625356b-ff1f-3bfe-a2e0-a803486a560c",
                                                "text": "‘This proceeding,’ interposed the president, ‘is by no means in accordance with the terms of the mulct or sentence, which is in its nature Median, and not to be altered or recalled.’"
                                            },
                                            {
                                                "example_id": "18c0d09c-8856-4d80-96bf-42fb878314ff",
                                                "sense_id": "6625356b-ff1f-3bfe-a2e0-a803486a560c",
                                                "text": "And if you venture to object to these Median laws, – as I am now doing, – you elicit a chorus of disapproval, and acquire some evil name."
                                            }
                                        ]
                                    }
                                ]
                            },
