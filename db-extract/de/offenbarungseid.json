                "senses": [
                    {
                        "sense_id": "73bb44d6-069f-3d38-83f4-654737d457fa",
                        "entry_id": "230cfc9c-2975-3c6d-b75d-c8472e7870a3",
                        "glosses": [
                            "Eid, bei dem der Schuldner auf Verlangen des Gläubigers erklärt, seine Vermögensverhältnisse korrekt dargelegt zu haben und seinen Zahlungsverpflichtungen nicht nachkommen zu können"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "70608aec-ef41-4ed2-a4ca-7684029c6173",
                                "sense_id": "73bb44d6-069f-3d38-83f4-654737d457fa",
                                "text": "Der frühere Mieter leistete den Offenbarungseid."
                            },
                            {
                                "example_id": "e70ad913-2d93-467e-b482-22c3b0656c63",
                                "sense_id": "73bb44d6-069f-3d38-83f4-654737d457fa",
                                "text": "„Am 26. Januar 1916 mussten die Behörden den Offenbarungseid leisten: Der Höchstpreis für den kommunalen Ankauf von Kartoffeln bei den Produzenten wurde von 2,75 auf vier Mark pro Zentner heraufgesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
