                        "sense_id": "62170d65-39ee-3b81-afbb-be85b158de07",
                        "entry_id": "513c2028-e1e7-3f67-9f4e-9258d679fdb3",
                        "glosses": [
                            "een niet te bevredigen verlangen of behoefte"
