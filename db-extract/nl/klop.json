                "translations": [
                    {
                        "translation_id": "0fc30c38-c774-464f-9fa8-a368362d4850",
                        "source_entry_id": "47b55272-0aa7-3375-9c1e-d1b1b2dd88eb",
                        "target_lang_word": "knock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c685ea6c-ff14-305c-b911-354cb03851ba",
                                        "entry_id": "2abaedbf-b13a-3010-9933-101582c84590",
                                        "glosses": [
                                            "An abrupt rapping sound, as from an impact of a hard object against wood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ce98406-8c90-4085-b0f1-09239432f158",
                                                "sense_id": "c685ea6c-ff14-305c-b911-354cb03851ba",
                                                "text": "It came to me, like a knock on the door / Erasing all that had gone before / Broken wings can be mended / But this love of ours, we've got to defend it"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67276905-f2a0-3877-9891-7bb3e6a6bf8e",
                                        "entry_id": "2abaedbf-b13a-3010-9933-101582c84590",
                                        "glosses": [
                                            "A sharp impact."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a451466-6c59-401c-bcfe-c103ba100579",
                                                "sense_id": "67276905-f2a0-3877-9891-7bb3e6a6bf8e",
                                                "text": "He took a knock on the head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73f1b9ea-9906-35b6-8d2e-5905c3951cc6",
                                        "entry_id": "2abaedbf-b13a-3010-9933-101582c84590",
                                        "glosses": [
                                            "A criticism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "617d532a-7797-421f-8118-6bf6ca8c79ed",
                                                "sense_id": "73f1b9ea-9906-35b6-8d2e-5905c3951cc6",
                                                "text": "Since forming in 2007 Mumford & Sons have hard-toured their way to a vast market for throaty folk that's strong on banjo and bass drum. They have released two enormous albums. But, wow, do they take some knocks back home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7efaab12-3124-33a2-8b0c-69d7216a001a",
                                        "entry_id": "2abaedbf-b13a-3010-9933-101582c84590",
                                        "glosses": [
                                            "A blow or setback."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39ac06b4-b2fe-4bec-a9a7-f13a6c3416f0",
                                                "sense_id": "7efaab12-3124-33a2-8b0c-69d7216a001a",
                                                "text": "\"Come on!\" cried Mr. Beaver, who was almost dancing with delight. \"Come and see! This is a nasty knock for the Witch! It looks as if her power was already crumbling.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad01ca78-8079-3ee9-89e4-39a741679710",
                                        "entry_id": "2abaedbf-b13a-3010-9933-101582c84590",
                                        "glosses": [
                                            "Preignition, a type of abnormal combustion occurring in spark ignition engines caused by self-ignition; also, the characteristic knocking sound associated with it."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6208fcd6-17f5-330e-9267-d7f413272bb2",
                                        "entry_id": "2abaedbf-b13a-3010-9933-101582c84590",
                                        "glosses": [
                                            "A batsman's innings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d2bcae4-83b6-45c5-b4a9-0c919e4af319",
                                                "sense_id": "6208fcd6-17f5-330e-9267-d7f413272bb2",
                                                "text": "He had a good knock and scored well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eb0e54c-e140-304a-990f-6ad6fefb37ff",
                                        "entry_id": "2abaedbf-b13a-3010-9933-101582c84590",
                                        "glosses": [
                                            "A ball hit into play, especially one that becomes a hit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31304b30-d2d9-4202-b7f9-97d997f51b47",
                                                "sense_id": "3eb0e54c-e140-304a-990f-6ad6fefb37ff",
                                                "text": "He played a slow but sure knock of 35."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72f41846-9867-3481-b05f-c573e2b8838e",
                                        "entry_id": "2abaedbf-b13a-3010-9933-101582c84590",
                                        "glosses": [
                                            "Synonym of hunger knock."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "knock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c00f700d-b633-3d7f-b930-5fb471950cb2",
                                        "entry_id": "c20f07ef-6170-3ff9-97ae-1948eefb9279",
                                        "glosses": [
                                            "To rap one's knuckles against something, especially wood."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1c944fe-62bb-4ac2-b15d-4198f65df8a8",
                                                "sense_id": "c00f700d-b633-3d7f-b930-5fb471950cb2",
                                                "text": "Knock on the door and find out if they’re home."
                                            },
                                            {
                                                "example_id": "a6f3d5ae-0d4f-41ab-bdf5-258f052d5995",
                                                "sense_id": "c00f700d-b633-3d7f-b930-5fb471950cb2",
                                                "text": "Then ſaid Evangeliſt, Keep that light in your eye, and go up directly thereto: ſo ſhalt thou ſee the Gate; at which, when thou knockeſt, it ſhall be told thee what thou ſhalt do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81c35f34-7272-3d5a-8021-c7d5a4bce922",
                                        "entry_id": "c20f07ef-6170-3ff9-97ae-1948eefb9279",
                                        "glosses": [
                                            "To strike for admittance; to rap upon, as a door."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bbcce3d-56f5-4c22-880f-1ab4ce10a0e1",
                                                "sense_id": "81c35f34-7272-3d5a-8021-c7d5a4bce922",
                                                "text": "Master, knock the door hard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9e24be7-e103-31d4-8aa7-97a2884e6d76",
                                        "entry_id": "c20f07ef-6170-3ff9-97ae-1948eefb9279",
                                        "glosses": [
                                            "To criticize verbally; to denigrate; to undervalue."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7871019-461c-458d-b537-79dbe6129bee",
                                                "sense_id": "f9e24be7-e103-31d4-8aa7-97a2884e6d76",
                                                "text": "Don’t knock it till you’ve tried it."
                                            },
                                            {
                                                "example_id": "879a05e9-ed75-4ea7-9e22-88168b9fd1bb",
                                                "sense_id": "f9e24be7-e103-31d4-8aa7-97a2884e6d76",
                                                "text": "And my friend, the reporter, could see nothing funny in this! Sent out on an assignment to write up a roaring, hilarious, brilliant joshing story of—but I will not knock a brother—let us go on with the story."
                                            },
                                            {
                                                "example_id": "3e33c6ca-4036-4f42-9dc2-a6796dfdee85",
                                                "sense_id": "f9e24be7-e103-31d4-8aa7-97a2884e6d76",
                                                "text": "A Judge must be respected, / A Judge you mustn't knock / Or else you'll be detected / And shoved into the dock."
                                            },
                                            {
                                                "example_id": "74df8084-d4de-41b4-873c-cf839e708092",
                                                "sense_id": "f9e24be7-e103-31d4-8aa7-97a2884e6d76",
                                                "text": "“And what do you care when some folks start knocking you? It’s a sign you getting some place.”"
                                            },
                                            {
                                                "example_id": "5ecd30b4-be3d-4d4c-bcf3-13381b56467a",
                                                "sense_id": "f9e24be7-e103-31d4-8aa7-97a2884e6d76",
                                                "text": "The pious have sometimes knocked the day [Thanksgiving] for its laughter, its late sleeping, its overeating."
                                            },
                                            {
                                                "example_id": "424b775d-3459-4856-bc2f-3bdeabc85532",
                                                "sense_id": "f9e24be7-e103-31d4-8aa7-97a2884e6d76",
                                                "text": "If you try to knock me, you'll get mocked / I'll stir-fry you in my wok"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "154765db-a324-3f30-96fe-117e5b94ee9f",
                                        "entry_id": "c20f07ef-6170-3ff9-97ae-1948eefb9279",
                                        "glosses": [
                                            "To kick a ball towards another player; to pass."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b4d3ce9-b93f-3421-a650-d35cf6b2c5aa",
                                        "entry_id": "c20f07ef-6170-3ff9-97ae-1948eefb9279",
                                        "glosses": [
                                            "To hit a ball into play."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da6eff12-b1b6-4414-8999-cd2e85c2581c",
                                                "sense_id": "6b4d3ce9-b93f-3421-a650-d35cf6b2c5aa",
                                                "text": "Despite enjoying more than their fair share of possession the visitors did not look like creating anything, with their lack of a killer ball painfully obvious as they harmlessly knocked the ball around outside the home side's box without ever looking like they would hurt them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88105a7c-fb1c-36e7-8b1c-c83c9c4a6832",
                                        "entry_id": "c20f07ef-6170-3ff9-97ae-1948eefb9279",
                                        "glosses": [
                                            "To impress forcibly or strongly; to astonish; to move to admiration or applause."
                                        ],
                                        "tags": [
                                            "British",
                                            "dated",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dde37456-4c45-33bc-90ed-4ec1c19b4df3",
                                        "entry_id": "c20f07ef-6170-3ff9-97ae-1948eefb9279",
                                        "glosses": [
                                            "To bump or impact."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d553e08-a951-4485-ab21-5f3830dd73b0",
                                                "sense_id": "dde37456-4c45-33bc-90ed-4ec1c19b4df3",
                                                "text": "I knocked against the table and bruised my leg."
                                            },
                                            {
                                                "example_id": "bf885be4-1b42-44e3-a6ef-8de0b8231cfe",
                                                "sense_id": "dde37456-4c45-33bc-90ed-4ec1c19b4df3",
                                                "text": "I accidentally knocked my drink off the bar."
                                            },
                                            {
                                                "example_id": "0263384f-608d-4461-958f-a8120a73a1e1",
                                                "sense_id": "dde37456-4c45-33bc-90ed-4ec1c19b4df3",
                                                "text": "\"The Silver Shoes,\" said the Good Witch, \"have wonderful powers. And one of the most curious things about them is that they can carry you to any place in the world in three steps, and each step will be made in the wink of an eye. All you have to do is to knock the heels together three times and command the shoes to carry you wherever you wish to go.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9be5b218-2993-353e-8b44-3df37dde51ad",
                                        "entry_id": "c20f07ef-6170-3ff9-97ae-1948eefb9279",
                                        "glosses": [
                                            "To have sex with."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96275f6b-b4f5-3d7d-aca9-8f6755b05e02",
                                        "entry_id": "c20f07ef-6170-3ff9-97ae-1948eefb9279",
                                        "glosses": [
                                            "To prosecute under the law; to arrest, imprison, etc."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfaf8658-bb47-4dd7-8dc9-47e8d15f54e8",
                                                "sense_id": "96275f6b-b4f5-3d7d-aca9-8f6755b05e02",
                                                "text": "The cops had busted us for selling hot designer bags up on Utica Avenue for some cat who figured we was too young to get knocked if we got caught, but two fat white po-pos said fuck how young we was, and threw us in a cell for damn near three days until they could contact Noojie to come get us out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4dd051e-8ea4-3c52-8bc4-bb85e656d17f",
                                        "entry_id": "c20f07ef-6170-3ff9-97ae-1948eefb9279",
                                        "glosses": [
                                            "To end play by declaring one's hand to have under a certain amount of deadwood."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
