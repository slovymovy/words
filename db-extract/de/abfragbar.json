                        "entry_id": "f51fbd2c-2f71-3b05-a762-2884162252bc",
                        "glosses": [
                            "so beschaffen, dass eine bestimmte Information abgerufen/erhalten werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "852e4643-0b30-4a60-ba5f-7ab6cff6d30e",
                                "sense_id": "6a3b6814-ff57-3a22-a949-70bfb58c1d9a",
                                "text": "„Kommt es dann doch zum Unfall, soll ab 2022 eine Art \"Black Box\" die wesentlichen Informationen unseres Fahrverhaltens speichern und anonym abfragbar machen.“"
                            },
                            {
                                "example_id": "ef217fa7-38c3-4dfb-ae74-6c0ddfc2a3b0",
                                "sense_id": "6a3b6814-ff57-3a22-a949-70bfb58c1d9a",
                                "text": "„Die morphologischen und funktionalanatomischen Daten sind hierarchisiert abgespeichert und direkt abfragbar.“"
                            }
                        ],
