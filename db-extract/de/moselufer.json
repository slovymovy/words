                "senses": [
                    {
                        "sense_id": "79291997-feaa-3e4e-a8f7-1fe0d19aa409",
                        "entry_id": "18fbba15-b334-39dc-876b-8f525d497621",
                        "glosses": [
                            "Ufer der Mosel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5a42948-11d5-4abb-baec-d2fe0fda7fd9",
                                "sense_id": "79291997-feaa-3e4e-a8f7-1fe0d19aa409",
                                "text": "„Beginnen wir unseren Spaziergang am Moselufer nur wenige Meter unterhalb der Balduinbrücke und gehen hinauf zur Altstadt.“"
                            },
                            {
                                "example_id": "52fafda7-e465-428e-a1d5-c17426be9eea",
                                "sense_id": "79291997-feaa-3e4e-a8f7-1fe0d19aa409",
                                "text": "„Die Abfälle des Randgebirges am linken Moselufer zeigen eine rote Erde.“"
                            },
                            {
                                "example_id": "7548f504-f864-486c-8a2d-66e05ac27261",
                                "sense_id": "79291997-feaa-3e4e-a8f7-1fe0d19aa409",
                                "text": "„Die Ruine stand direkt am Moselufer, und sie sah aus wie eine Kirche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
