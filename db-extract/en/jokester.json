                                ]
                            },
                            {
                                "target_word": "farceur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1917524-1086-333a-9478-f32f6d445bdc",
                                        "entry_id": "2ecd5e7e-3258-3a6b-bf99-181b602d216a",
                                        "glosses": [
                                            "Celui qui aime à faire ou à dire des choses bouffonnes ou à jouer des tours plaisants aux gens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0d30730-aae8-417e-8ed4-7edbec38d1ec",
                                                "sense_id": "d1917524-1086-333a-9478-f32f6d445bdc",
                                                "text": "Notre esprit est toujours comme à la merci d’un téléphoniste farceur […] qui lui branche la communication avec n’importe qui, n’importe quoi, se plaisant aux pires confusions, aux imbroglios les plus fâcheux, les plus déraisonnables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5e0dd54-f6eb-35e7-b210-9c02153ceb72",
                                        "entry_id": "2ecd5e7e-3258-3a6b-bf99-181b602d216a",
                                        "glosses": [
                                            "Celui qui cherche à en faire accroire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4898c44f-321a-42f3-9eeb-9aeb81601b13",
                                                "sense_id": "c5e0dd54-f6eb-35e7-b210-9c02153ceb72",
                                                "text": "Je n’ai aucune confiance en lui, c’est un farceur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56ed2535-2fbc-329f-a843-5a1477935865",
                                        "entry_id": "2ecd5e7e-3258-3a6b-bf99-181b602d216a",
                                        "glosses": [
                                            "Comédien qui ne joue que dans les farces. Se dit encore par mépris d’un acteur qui charge un rôle comique."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edfd206b-fe54-4cce-902e-4a6118f2bc55",
                                                "sense_id": "56ed2535-2fbc-329f-a843-5a1477935865",
                                                "text": "[…] la pauvre désolée ne trouvait plus rien qui l’égayât. En vain avait-on mandé des quatre coins du monde les plus fameux baladins, bateleurs, bouffons, turlupins, pîtres, grimaciers, grotesques et farceurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2105bd75-7115-4e98-9095-e3b9ba628152",
                        "source_entry_id": "7ae51b87-4b9d-3546-8c55-3573cd14a8fa",
                        "source_sense_description": "jester",
                        "target_lang_word": "bouffon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouffon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b16d037-603d-33ca-a844-70cd04591d24",
                                        "entry_id": "b95527fc-f845-3bc0-97d7-0b3602d876af",
                                        "glosses": [
                                            "Qualifie un genre théâtral du Moyen Âge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cf80c1d-b4c3-4db4-85ad-4f6f236f4b98",
                                                "sense_id": "5b16d037-603d-33ca-a844-70cd04591d24",
                                                "text": "Le drame bouffon, la farce, appartiennent plus en propre au moyen-âge, mais encore ici il y a un certain rapport de filiation entre les acteurs des tréteaux du moyen-âge et les derniers histrions de l’antiquité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dab7c2de-38e3-343c-b7af-89c09260dd8a",
                                        "entry_id": "b95527fc-f845-3bc0-97d7-0b3602d876af",
                                        "glosses": [
                                            "Qui fait rire par extrême ridicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ade34ac8-4bf6-44fa-b8f7-c54120ee7512",
                                                "sense_id": "dab7c2de-38e3-343c-b7af-89c09260dd8a",
                                                "text": "La veulerie des hommes de ce temps fut si grande que parfois la substitution du nouveau personnel à l’ancien prenait des allures bouffonnes."
                                            },
                                            {
                                                "example_id": "742e33b6-0c77-4dd2-93fc-eddcf340d376",
                                                "sense_id": "dab7c2de-38e3-343c-b7af-89c09260dd8a",
                                                "text": "L’humanité n’est pas simple, il faut en prendre son parti ; et toute tentative de simplification, d’unification, de réduction par le dehors sera toujours odieuse, ruineuse et sinistrement bouffonne."
                                            },
                                            {
                                                "example_id": "a02be883-2e14-406f-b20e-888fe76bba62",
                                                "sense_id": "dab7c2de-38e3-343c-b7af-89c09260dd8a",
                                                "text": "Feydeau raconte les bouffonnes exigences de la Censure théâtrale qui, par exemple, lui fait remplacer par un civil, dans une de ces pièces, un général péruvien."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bc73345-27d5-3329-9ab8-1e39c27b1b7e",
                                        "entry_id": "b95527fc-f845-3bc0-97d7-0b3602d876af",
                                        "glosses": [
                                            "Qualifie ce qui est comique dans les ouvrages de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7722a295-12ba-41b7-a498-f71fc24b670d",
                                                "sense_id": "7bc73345-27d5-3329-9ab8-1e39c27b1b7e",
                                                "text": "Le genre, le style bouffon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bouffon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7210aed4-ca0c-3136-8f11-15160abbaaca",
                                        "entry_id": "b9a5402f-f9dd-31e6-a325-9f7a1e350f56",
                                        "glosses": [
                                            "Personnage dont la fonction était d’amuser la cour des nobles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26e64f8b-6478-4629-b8ef-315127f3ff20",
                                                "sense_id": "7210aed4-ca0c-3136-8f11-15160abbaaca",
                                                "text": "C’était à cette partie du bonnet de Wamba que l’on avait cousu les sonnettes, et cette circonstance, aussi bien que la forme de sa coiffure et l’expression moitié folle, moitié futile de sa figure, servait à le désigner comme appartenant à la classe des bouffons domestiques, ou railleurs, qu’on nourrissait dans les maisons des riches pour chasser l’ennui de ces heures languissantes qu’ils étaient obligés de passer dans leurs châteaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02dfcbac-12ad-3f5b-8db6-880902b4fea1",
                                        "entry_id": "b9a5402f-f9dd-31e6-a325-9f7a1e350f56",
                                        "glosses": [
                                            "Personnage de théâtre dont l’emploi est de faire rire."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3084c0a8-18b2-43cf-a2a3-3729518ada28",
                                                "sense_id": "02dfcbac-12ad-3f5b-8db6-880902b4fea1",
                                                "text": "[…] la pauvre désolée ne trouvait plus rien qui l’égayât. En vain avait-on mandé des quatre coins du monde les plus fameux baladins, bateleurs, bouffons, turlupins, pîtres, grimaciers, grotesques et farceurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "311a9835-d34f-311d-bfaa-509a9ef95d26",
                                        "entry_id": "b9a5402f-f9dd-31e6-a325-9f7a1e350f56",
                                        "glosses": [
                                            "Personne qui prend à tâche de faire rire."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c42bce3-51ff-4e05-8db1-486d5586f2dd",
                                                "sense_id": "311a9835-d34f-311d-bfaa-509a9ef95d26",
                                                "text": "Cet acteur est un bouffon assez amusant."
                                            },
                                            {
                                                "example_id": "e56d0999-933e-4f70-869c-7bf47ee9105a",
                                                "sense_id": "311a9835-d34f-311d-bfaa-509a9ef95d26",
                                                "text": "C’est un excellent bouffon."
                                            },
                                            {
                                                "example_id": "917a8382-cfd5-4b9a-b8dd-7c2f7ae99d42",
                                                "sense_id": "311a9835-d34f-311d-bfaa-509a9ef95d26",
                                                "text": "Faire le personnage de bouffon."
                                            },
                                            {
                                                "example_id": "03000ed1-7b8c-48bd-a131-62df3a776672",
                                                "sense_id": "311a9835-d34f-311d-bfaa-509a9ef95d26",
                                                "text": "Il se plaît à faire le bouffon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5c40204-0447-3470-b4a2-c043fc486c11",
                                        "entry_id": "b9a5402f-f9dd-31e6-a325-9f7a1e350f56",
                                        "glosses": [
                                            "Personne stupide ou ridicule."
                                        ],
                                        "tags": [
                                            "offensive",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56e4cb48-86b9-4dba-8522-f18d4ad17a7a",
                                                "sense_id": "b5c40204-0447-3470-b4a2-c043fc486c11",
                                                "text": "J’avais fait le poireau de neuf heures du matin jusqu’à dix heures, avant que l'autre bouffon de dealer s’amène. Je l’imaginais qui devait prendre son petit déj’ peinard pendant que je me pelais le jonc à l’attendre."
                                            },
                                            {
                                                "example_id": "b6ea75c1-788a-41a3-a5ec-4873e1c51af0",
                                                "sense_id": "b5c40204-0447-3470-b4a2-c043fc486c11",
                                                "text": "[…] et Noémie ne cessa de chuchoter des nouvelles sérieuses ou fantaisistes qu'elle avait rapportées de Marseille. Une cité de barjaqueurs, de bouffons, de chapacans, de farfantiers, de glandouilleurs et autres bidonasses."
                                            },
                                            {
                                                "example_id": "c3c88035-7e41-4550-b57d-59e396a39ca9",
                                                "sense_id": "b5c40204-0447-3470-b4a2-c043fc486c11",
                                                "text": "N’importe quel clampin de bistrot, d’aède de comptoir a plus de talent et de sensibilité que ces bavasseurs glumeux, ces bouffons de l’art officiel, castrats du sérail de la bien-pensance, créatures de la gauche culturellement proprette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c76ae092-b024-3fb2-9a3b-756ecddd3281",
                                        "entry_id": "b9a5402f-f9dd-31e6-a325-9f7a1e350f56",
                                        "glosses": [
                                            "Genre, style bouffon, en parlant des ouvrages de l’esprit."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ed51408-4d41-4978-8bb4-5f9b50ac104c",
                                                "sense_id": "c76ae092-b024-3fb2-9a3b-756ecddd3281",
                                                "text": "Le bouffon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d848c732-3e4e-328e-ac76-ce73fbd3694e",
                                        "entry_id": "b9a5402f-f9dd-31e6-a325-9f7a1e350f56",
                                        "glosses": [
                                            "Peut désigner un fou aux échecs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef308528-cd0d-37c1-a68f-360c14b2acde",
                                        "entry_id": "b9a5402f-f9dd-31e6-a325-9f7a1e350f56",
                                        "glosses": [
                                            "Gourmand, personne qui ne pense qu’à manger."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fab7e7a2-f64c-41c7-bc38-586bd17b13d0",
                                                "sense_id": "ef308528-cd0d-37c1-a68f-360c14b2acde",
                                                "text": "Quel bouffon ! Tu viens de te taper trois sandwiches et t’as encore la dalle !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
