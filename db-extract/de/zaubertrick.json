                ],
                "senses": [
                    {
                        "sense_id": "fe449956-f134-36c6-89a1-9eacc35b57d6",
                        "entry_id": "8073aee8-5028-3451-b360-235bad867908",
                        "glosses": [
                            "illusionistischer Trick eines Zauberkünstlers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58439d5a-a18b-498f-9494-234ba2f33815",
                                "sense_id": "fe449956-f134-36c6-89a1-9eacc35b57d6",
                                "text": "Er beeindruckte die Kinder mit seinen Zaubertricks."
                            },
                            {
                                "example_id": "bbf13d3f-c98e-4241-99a4-34f04a5071fb",
                                "sense_id": "fe449956-f134-36c6-89a1-9eacc35b57d6",
                                "text": "„Mit unzähligen Zaubertricks begeistert derzeit ein Nutzer der Kurzvideoplattform Vine das Internet.“"
                            },
                            {
                                "example_id": "720cc886-1ff3-4a46-b6f9-8f57bccb3eff",
                                "sense_id": "fe449956-f134-36c6-89a1-9eacc35b57d6",
                                "text": "„Möglicherweise sollte sie zur Lösung des Rätsels bei einem tierischen Kollegen aus Barcelona nachfragen - im dortigen Zoo konnten Besucher einen Orang-Utan mit einem ähnlichen Zaubertrick nämlich nicht hereinlegen, wie die Reaktion des Tiers eindrucksvoll bewies.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f140e2e2-fe69-452d-975d-8af21676a662",
                        "source_entry_id": "8073aee8-5028-3451-b360-235bad867908",
                        "source_sense_id": "fe449956-f134-36c6-89a1-9eacc35b57d6",
                        "source_sense_description": "illusionistischer Trick eines Zauberkünstlers",
                        "target_lang_word": "conjuring trick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conjuring trick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "508a74a9-a259-3146-8439-739bea23edee",
                                        "entry_id": "50204926-baca-3413-8604-8be950344926",
                                        "glosses": [
                                            "A type of magic trick in which something is made to appear or disappear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bfa5043-aae6-4010-aba4-d0d5af60c294",
                                                "sense_id": "508a74a9-a259-3146-8439-739bea23edee",
                                                "text": "Instead, as literary scholar Kate Shanley has argued, American Indians are “a permanent ‘present absence’ in U.S. colonial imagination, an ‘absence’ that reinforces at every turn the conviction that Native peoples are indeed vanishing and that the conquest of Native lands is justified.” Literary imagination played a significant part in this conjuring trick, and scholars have identified the significance of works such as those by James Fenimore Cooper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
