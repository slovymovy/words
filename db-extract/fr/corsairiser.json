                "senses": [
                    {
                        "sense_id": "6053fcb2-14fc-3ee4-9535-8286e13c4a7f",
                        "entry_id": "6b67f409-ffd7-37a7-b634-29b2b62877b8",
                        "glosses": [
                            "Attaquer en tant que corsaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b4467d-3c64-42b8-8ab3-811b0e91c9d1",
                                "sense_id": "6053fcb2-14fc-3ee4-9535-8286e13c4a7f",
                                "text": "Monsieur le ministre, quelles propositions faites-vous, qui ne permettront pas au commerce de « pirater » ou de « corsairiser » - je vous laisse le choix du terme ! - l'avancée réelle que constitue l'irruption de la culture dans le droit international ?"
                            },
                            {
                                "example_id": "96c12a32-c12d-424b-a124-bc588d956a5d",
                                "sense_id": "6053fcb2-14fc-3ee4-9535-8286e13c4a7f",
                                "text": "J'ai bien essayé de corsairiser (c'est comme pirater, mais pour la bonne cause) le site de M6, mais la seule vidéo qui ne marche pas c'est celle qui te concerne."
                            },
                            {
                                "example_id": "698cdb04-f4ca-4c33-ae69-81d8f01a47e8",
                                "sense_id": "6053fcb2-14fc-3ee4-9535-8286e13c4a7f",
                                "text": "Va-t-elle les encercler, les corsairiser, les aspirer dans la grande fosse ?"
                            }
                        ]
                    }
