                "senses": [
                    {
                        "sense_id": "aaf2bc92-ee98-3b62-8144-bf73935c86da",
                        "entry_id": "d5582050-0bdf-3268-ba49-b326e119cdee",
                        "glosses": [
                            "Devenir exogame."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9f885b3-9848-4a0a-a454-034d7a1fba09",
                                "sense_id": "aaf2bc92-ee98-3b62-8144-bf73935c86da",
                                "text": "Par ailleurs, refusant de « s'exogamiser », la famille communautaire endogame refuserait le catholicisme, fondamentalement exogame."
                            },
                            {
                                "example_id": "39e3987a-3414-4f74-bc33-460c4afe9e9d",
                                "sense_id": "aaf2bc92-ee98-3b62-8144-bf73935c86da",
                                "text": "De ce point de vue le double meurtre des sœurs Papin révèle la violence qu’il y a à vouloir quitter sa famille, à vouloir s’inscrire dans une autre famille, à « s'exogamiser » en quelque sorte, à vouloir changer de parents, voire de mère, à prendre « belle-mère »."
                            }
                        ]
                    }
