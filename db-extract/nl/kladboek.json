                        "source_entry_id": "a85bdb73-d2c8-3375-b9a2-9c4ed5240400",
                        "target_lang_word": "cahier de brouillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
