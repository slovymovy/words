                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glanage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae6c768c-f139-3ae7-9b73-3f29affcb70c",
                                        "entry_id": "d9c69e38-13e5-3ab0-bd28-216593b42209",
                                        "glosses": [
                                            "Activité de récupération consistant à ramasser de manière artisanale les produits agricoles restants après une moisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb54c6f7-ebd0-4da4-a986-5deb5886a4e7",
                                                "sense_id": "ae6c768c-f139-3ae7-9b73-3f29affcb70c",
                                                "text": "À l’échelle de la population mondiale actuelle, le glanage, la cueillette, la chasse et la pêche sauvage ne peuvent se substituer à l’agriculture et devenir un mode d’alimentation à grande échelle sans mettre en danger les espèces."
                                            },
                                            {
                                                "example_id": "6a110209-0cd8-4b73-9da1-490fb2228417",
                                                "sense_id": "ae6c768c-f139-3ae7-9b73-3f29affcb70c",
                                                "text": "Mine de rien, 500 kilogrammes de fruits ont ainsi été ramassés au cours d’une quinzaine d’activités de glanage au cours des dernières semaines, selon ce que nous a expliqué Alix Fournier, chargée de projet chez Les Anges-Jardins, un projet visant une plus grande autonomie dans la région."
                                            },
                                            {
                                                "example_id": "c5443f47-39d8-4f8c-a8e0-de63771ec820",
                                                "sense_id": "ae6c768c-f139-3ae7-9b73-3f29affcb70c",
                                                "text": "Le 27 juillet 2012, le Téléjournal nous présentait un reportage d’Émilie Dubreuil sur le déchétarisme qui est une forme urbaine du glanage."
                                            },
                                            {
                                                "example_id": "a9a1a788-3349-4e2d-b634-ca0db2b66cbe",
                                                "sense_id": "ae6c768c-f139-3ae7-9b73-3f29affcb70c",
                                                "text": "Dans les pays vignobles, le glanage des vignes constitue le hallebotage."
                                            }
                                        ]
                                    }
                                ]
                            }
