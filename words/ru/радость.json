                    "semantic_group_id": "joy_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта новость принесла нам огромную <w>радость</w>.",
                            "target_lang_translations": {
                                "en": "This news brought us immense <w>joy</w>.",
                                "nl": "Dit nieuws bracht ons enorme <w>vreugde</w>.",
                                "pl": "Ta wiadomość przyniosła nam ogromną <w>radość</w>.",
                                "fr": "Cette nouvelle nous a apporté une immense <w>joie</w>.",
                                "de": "Diese Nachricht hat uns eine riesige <w>Freude</w> bereitet.",
                                "es": "Esta noticia nos trajo una inmensa <w>alegría</w>.",
                                "it": "Questa notizia ci ha portato un'immensa <w>gioia</w>.",
                                "tr": "Bu haber bize büyük bir <w>sevinç</w> getirdi.",
                                "cs": "Tato zpráva nám udělala obrovskou <w>radost</w>."
                            }
                        },
                        {
                            "text": "Дети прыгали от <w>радости</w>, когда увидели подарки.",
                            "target_lang_translations": {
                                "en": "The children jumped for <w>joy</w> when they saw the presents.",
                                "nl": "De kinderen sprongen op van <w>vreugde</w> toen ze de cadeautjes zagen.",
                                "pl": "Dzieci skakały z <w>radości</w>, kiedy zobaczyły prezenty.",
                                "fr": "Les enfants sautaient de <w>joie</w> en voyant les cadeaux.",
                                "de": "Die Kinder sprangen vor <w>Freude</w>, als sie die Geschenke sahen.",
                                "es": "Los niños saltaban de <w>alegría</w> al ver los regalos.",
                                "it": "I bambini saltavano dalla <w>gioia</w> quando hanno visto i regali.",
                                "tr": "Çocuklar hediyeleri görünce <w>sevinçten</w> havalara uçtu.",
                                "cs": "Děti skákaly <w>radostí</w>, když uviděly dárky."
                            }
                        }
                    ],
                    "common_phrases": [
