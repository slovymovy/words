                        "cross_references": [
                            {
                                "target_word": "Landtag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17c43edf-dcb4-3eb4-ac0e-306b98d5c547",
                                        "entry_id": "4a4f3f35-3920-3c4c-beaf-f944695ff7e8",
                                        "glosses": [
                                            "das Parlament eines Bundeslandes"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "793fbbbd-631b-47b6-85f9-f8c7255fd8a3",
                                                "sense_id": "17c43edf-dcb4-3eb4-ac0e-306b98d5c547",
                                                "text": "Der Haushalt wurde im Landtag verabschiedet."
                                            },
                                            {
                                                "example_id": "d364c099-5eae-470b-9b7b-52ee72eb68d4",
                                                "sense_id": "17c43edf-dcb4-3eb4-ac0e-306b98d5c547",
                                                "text": "Das Gesetz wurde im Landtag diskutiert."
                                            },
                                            {
                                                "example_id": "999ce05b-b57f-452e-bb8c-86fc619ec8e8",
                                                "sense_id": "17c43edf-dcb4-3eb4-ac0e-306b98d5c547",
                                                "text": "Sie ist seit nunmehr 10 Jahren Mitglied des Düsseldorfer Landtages."
                                            },
                                            {
                                                "example_id": "b4da268e-e877-4d0c-9cfe-3a9a3ccc6192",
                                                "sense_id": "17c43edf-dcb4-3eb4-ac0e-306b98d5c547",
                                                "text": "„Explosive Stimmung herrschte im Kieler Landtag.“"
                                            },
                                            {
                                                "example_id": "1dd79dbf-a0e7-4a76-9334-50e88bbedece",
                                                "sense_id": "17c43edf-dcb4-3eb4-ac0e-306b98d5c547",
                                                "text": "„Zum Regierungschef wählte ihn der niedersächsische Landtag dann am 28. Oktober 1998.“"
                                            },
                                            {
                                                "example_id": "7387ffff-ada2-4221-bdca-8b4e2b72814a",
                                                "sense_id": "17c43edf-dcb4-3eb4-ac0e-306b98d5c547",
                                                "text": "„Im Saarland wird schon im März ein neuer Landtag gewählt, Schleswig-Holstein und Nordrhein-Westfalen folgen im Mai.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "237e7451-fcaf-3343-90b5-692ba777ef3b",
                                        "entry_id": "4a4f3f35-3920-3c4c-beaf-f944695ff7e8",
                                        "glosses": [
                                            "das Abgeordnetenhaus eines Bundeslandes"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9cbfdcb-b554-44c4-bf9e-f834397e8121",
                                                "sense_id": "237e7451-fcaf-3343-90b5-692ba777ef3b",
                                                "text": "Das wurde im Tiroler Landtag so vorgetragen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "573bacac-009c-315b-9bad-7a83a5d7eabb",
