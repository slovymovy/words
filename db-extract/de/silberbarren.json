                ],
                "senses": [
                    {
                        "sense_id": "0758a33f-ad5d-3cc6-9db5-d7a64818be10",
                        "entry_id": "75f5294a-41b5-3f02-ade0-374520d65020",
                        "glosses": [
                            "Block aus Silber mit einem bestimmten Gewicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90a4f281-0e23-4ba9-afd6-ab7f7719d8bc",
                                "sense_id": "0758a33f-ad5d-3cc6-9db5-d7a64818be10",
                                "text": "„Obwohl der Marktpreis für Silberbarren seit der Umprägung der Goldmünzen erheblich gefallen ist, fiel er nicht bis auf den Münzpreis.“"
                            },
                            {
                                "example_id": "1da90f6e-018d-4c6e-b536-615ee806ab25",
                                "sense_id": "0758a33f-ad5d-3cc6-9db5-d7a64818be10",
                                "text": "„Nach dieser Unterhaltung ließ der Hämling Ho seinen Neffen, den Tausendschaftführer Ho, nach hinten den Befehl weiter geben, vierundzwanzig große Silberbarren herbeizuholen und in Speiseschachteln hinschaffen zu lassen.“"
                            },
                            {
                                "example_id": "878ae732-3290-4ada-8c23-d9ead8222352",
                                "sense_id": "0758a33f-ad5d-3cc6-9db5-d7a64818be10",
                                "text": "„Silberbarren konnten jederzeit zur Münzanstalt gebracht werden und wurden dort gegen geringe Gebühr in Münzen verwandelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
