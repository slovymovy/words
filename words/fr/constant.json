    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b1686e1-de7a-3100-9ce2-9f00eda2598b",
                    "sense_definition": "Qui demeure continuellement dans le même état, sans varier ni s'interrompre.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "stabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture roulait à une vitesse <w>constante</w> sur la route nationale."
                        },
                        {
                            "text": "Son succès est le fruit d'un effort <w>constant</w> depuis des années."
                        }
                    ],
                    "synonyms": [
                        "fixe",
                        "régulier",
                        "stable"
                    ],
                    "antonyms": [
                        "inconstant",
                        "variable"
                    ],
                    "common_phrases": [
                        "vitesse constante",
                        "effort constant"
                    ]
                },
                {
                    "sense_id": "ee305115-0b96-37c2-b6f9-1e31786ef4f0",
                    "sense_definition": "Qui fait preuve de persévérance, de fidélité ou de fermeté dans ses sentiments ou sa conduite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est resté <w>constant</w> dans ses principes malgré les pressions extérieures."
                        },
                        {
                            "text": "Elle éprouve pour lui un amour <w>constant</w> qui ne faiblit jamais."
                        }
                    ],
                    "antonyms": [
                        "inconstant"
                    ],
                    "common_phrases": [
                        "cœur constant",
                        "amour constant"
                    ]
                },
                {
                    "sense_id": "11511d8f-7f90-33e1-a2df-22d9644df9ef",
                    "sense_definition": "Qualifie des vents qui soufflent continuellement et régulièrement dans la même direction.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meteorologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les navigateurs profitent de ce vent <w>constant</w> pour traverser l'océan."
                        },
                        {
                            "text": "Dans cette région côtière souffle un vent <w>constant</w> venu de l'ouest."
                        }
                    ],
                    "synonyms": [
                        "régulier"
                    ],
                    "antonyms": [
                        "variable"
                    ],
                    "common_phrases": [
                        "vent constant"
                    ]
                },
                {
                    "sense_id": "276ff6ff-7113-3654-9fbe-7d3d6613141d",
                    "sense_definition": "Qui est indubitable, avéré ou universellement reconnu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "certitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est un fait <w>constant</w> que la situation financière de l'entreprise s'améliore."
                        },
                        {
                            "text": "L'avocat a démontré qu'il était <w>constant</w> que le contrat n'avait pas été respecté."
                        }
                    ],
                    "common_phrases": [
                        "fait constant"
                    ]
                }
            ]
        },
