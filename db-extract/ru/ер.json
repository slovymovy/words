                "senses": [
                    {
                        "sense_id": "20e4304e-282a-3d3b-9868-85ea70afd163",
                        "entry_id": "b76e0d55-d5ef-3fe8-9b87-bf13f60fa9bd",
                        "glosses": [
                            "устар. и лингв. название буквы «ъ»"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44cca524-22ea-4c8e-b1a9-7f5fd4fdccc0",
                                "sense_id": "20e4304e-282a-3d3b-9868-85ea70afd163",
                                "text": "И иже Ш ша К како Ъ ер Л люди Ы еры[.]"
                            },
                            {
                                "example_id": "f94410e6-4cda-4450-8e2e-3097a25e91aa",
                                "sense_id": "20e4304e-282a-3d3b-9868-85ea70afd163",
                                "text": "― «Ер», «еры», ― монотонно говорила десятница. ― Упали с горы, ― гудел, передразнивая, Васька."
                            },
                            {
                                "example_id": "beaa3988-d56f-4c4c-bc68-47ae22418e26",
                                "sense_id": "20e4304e-282a-3d3b-9868-85ea70afd163",
                                "text": "Ер (ъ) еры (ы) ― упал с горы. Ер, ять (ять) ― некому поднять. Ер, ю ― сам встаю… А и Б сидели на трубе."
                            }
                        ]
                    }
                ],
