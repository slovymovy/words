                        "source_entry_id": "638ad558-c8a8-37c3-8060-fae704972a22",
                        "source_sense_id": "0414800d-e71f-345d-84b2-5471616b4e21",
                        "source_sense_description": "katapultähnlicher Fingerhieb, Schnippen mit der Zeigefinger- oder Mittelfingerspitze gegen die Stirn",
                        "target_lang_word": "flick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5081539-5e81-3838-a8c1-fc6b949c81f6",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A short, quick movement, especially a brush, sweep, or flip."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1378383a-25e0-4155-8636-b26835aa16cb",
                                                "sense_id": "a5081539-5e81-3838-a8c1-fc6b949c81f6",
                                                "text": "He removed the speck of dust with a flick of his finger."
                                            },
                                            {
                                                "example_id": "ab0bef04-cefa-42c5-ae7c-4dc8e014d47b",
                                                "sense_id": "a5081539-5e81-3838-a8c1-fc6b949c81f6",
                                                "text": "She gave a disdainful flick of her hair and marched out of the room."
                                            },
                                            {
                                                "example_id": "20ac598a-fec7-4809-942e-6c59734071c7",
                                                "sense_id": "a5081539-5e81-3838-a8c1-fc6b949c81f6",
                                                "text": "On this occasion it was Nolan's deft flick that fooled West Ham's sleepy defenders Danny Gabbidon and Tomkins. The ball found its way to Best, who smashed in with confidence from the edge of the area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e698de1-645d-36a1-86cf-d51403fc7d8e",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A motion picture, movie, film; (in plural, usually preceded by \\\"the\\\") movie theater, cinema."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8b1df2c-6734-403c-a5d3-128edd5dbf17",
                                                "sense_id": "7e698de1-645d-36a1-86cf-d51403fc7d8e",
                                                "text": "My all-time favorite flick is \"Gone with the Wind.\""
                                            },
                                            {
                                                "example_id": "7adf0638-75ba-4e87-8908-9d488bc535e0",
                                                "sense_id": "7e698de1-645d-36a1-86cf-d51403fc7d8e",
                                                "text": "Want to go to the flicks tonight?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b930fa3-c718-3142-af7e-83fdba6f6223",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A cut that lands with the point, often involving a whip of the foible of the blade to strike at a concealed target."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92abe9d3-681b-388b-be0a-ec40162606bc",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A powerful underarm volley shot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d4b574c-5831-4b6a-b872-3fe719f05ce3",
                                                "sense_id": "92abe9d3-681b-388b-be0a-ec40162606bc",
                                                "text": "The fourth seed was dominating her 20-year-old opponent with a series of stinging groundstrokes and athletic drive-volleys, striking again in game five when Paszek flicked a forehand pick-up into the tramlines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47591ba2-40f0-3381-836b-08fa2717cfe4",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "The act of pressing a place on a touch screen device."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e69283b1-0255-3f20-9ffe-9b5379bff227",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A flitch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2bf7566-19c1-4d7f-ac8b-ddfe599cb825",
                                                "sense_id": "e69283b1-0255-3f20-9ffe-9b5379bff227",
                                                "text": "a flick of bacon"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54af4a0d-2289-3bc0-9bca-9ade5da952d5",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A unit of time, equal to 1/705,600,000 of a second"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "27b5f2f5-e9f9-332e-acc2-1690f8a9e570",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A chap or fellow; sometimes as a friendly term of address."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf190da-722b-4153-ba8e-3fecf2b20a08",
                                                "sense_id": "27b5f2f5-e9f9-332e-acc2-1690f8a9e570",
                                                "text": "'All that I have, dear old flick, is yours for the asking. What can I do?'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68fe37b9-4e0b-337f-b3d6-55180db0af0f",
                                        "entry_id": "85779af0-7173-378c-834e-eebcdb4c0d16",
                                        "glosses": [
                                            "A photo."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8510253f-b440-4533-8d9b-469af7b14e7c",
                                                "sense_id": "68fe37b9-4e0b-337f-b3d6-55180db0af0f",
                                                "text": "I was taking some flicks of the [p]arade […] and [someone] asked […] if I would like to take a picture of him[.]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a848ecd-ef81-3928-a398-a418c9b7044d",
                                        "entry_id": "336c45cc-7306-3962-9f7c-63e1d07a382a",
                                        "glosses": [
                                            "To move or hit (something) with a short, quick motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71e3fa09-7464-45a0-95e8-278256dfc500",
                                                "sense_id": "4a848ecd-ef81-3928-a398-a418c9b7044d",
                                                "text": "flick one's hair"
                                            },
                                            {
                                                "example_id": "e17f0dac-76b0-423d-9015-05b9a1c1700e",
                                                "sense_id": "4a848ecd-ef81-3928-a398-a418c9b7044d",
                                                "text": "to flick the dirt from boots"
                                            },
                                            {
                                                "example_id": "c16f5ee8-9ecf-4dec-9482-fc37d2cd1e0a",
                                                "sense_id": "4a848ecd-ef81-3928-a398-a418c9b7044d",
                                                "text": "Using her hands like windshield wipers, she tried to flick snow away from her mouth. When she clawed at her chest and neck, the crumbs maddeningly slid back onto her face. She grew claustrophobic."
                                            },
                                            {
                                                "example_id": "09aba925-9c68-4fc7-9051-ca6e352faf34",
                                                "sense_id": "4a848ecd-ef81-3928-a398-a418c9b7044d",
                                                "text": "the Queen, flicking the snuff off her sleeve[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f82c50b-0740-37f0-88ae-db2be62390aa",
                                        "entry_id": "336c45cc-7306-3962-9f7c-63e1d07a382a",
                                        "glosses": [
                                            "To pass by rapidly, so as not to be perceived clearly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "438659d6-48b0-4e49-be0b-312edc3de8a9",
                                                "sense_id": "6f82c50b-0740-37f0-88ae-db2be62390aa",
                                                "text": "Near-synonym: flit"
                                            },
                                            {
                                                "example_id": "a258670b-6830-495b-b6c1-f11658ec8624",
                                                "sense_id": "6f82c50b-0740-37f0-88ae-db2be62390aa",
                                                "text": "They were quiet for a time, watching the fields and lanes flick past."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
