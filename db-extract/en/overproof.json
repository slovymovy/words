                        "form": "overproofs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55ffcbe3-ed04-3fc0-b796-9492cb7e576d",
                        "entry_id": "2201bda2-2e01-394e-bcda-04f79072feba",
                        "glosses": [
                            "A spirit possessing a higher proportion of alcohol than proof spirit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c48ecf43-d88a-4970-934b-38f2599e9e4c",
                                "sense_id": "55ffcbe3-ed04-3fc0-b796-9492cb7e576d",
                                "text": "[E]ach degree of the hydrometer, when at or near proof, is about a quart in a hundred gallons stronger or weaker, as the hydrometer vibrates under or over the silver speck or sight on the index or upper stem; at the intermediate or strong overproofs, is about a pint in ditto; and at the low underproofs is about three pints in ditto."
                            },
                            {
                                "example_id": "f23469bb-900f-4e51-95ee-ff87b0c8aed9",
                                "sense_id": "55ffcbe3-ed04-3fc0-b796-9492cb7e576d",
                                "text": "Bustle, Jack, bustle. Show us the best—the very best—the over-proof that you keep for your own drinking, Jack!"
                            },
                            {
                                "example_id": "11db3672-f6c1-4b99-8e5f-25d2b53b08c5",
                                "sense_id": "55ffcbe3-ed04-3fc0-b796-9492cb7e576d",
                                "text": "At a Committee of the City of London Chess Club, held on the 18th of January, it was decided to set on foot three even tourneys. In these contests the competitors in each of the tourneys play upon even terms, and they all play together. Tournament No. 1 will be of the Pawn and move strength, and there will be included in the same the strongest members of the Pawn and two moves class. Tournament No. 2 will consist of the averae players of the last-named class, and to them will be added the overproofs of the Knight strength."
                            }
                        ]
                    }
                ],
