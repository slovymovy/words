                "senses": [
                    {
                        "sense_id": "4a300357-b491-3bd6-83f4-52ffb3ad4f7a",
                        "entry_id": "83089d23-29c9-38ba-b8da-54d9aa5352b1",
                        "glosses": [
                            "herzförmiges Ende eines Arms eines Ankers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "693cb163-da42-4973-be6e-0e06a8004e41",
                                "sense_id": "4a300357-b491-3bd6-83f4-52ffb3ad4f7a",
                                "text": "„Die Ankerpflüge verhakten sich an einem mit Tang bewachsenen Felsbrocken auf dem Grund, und langsam drehte sich die Glamour in den Wind.“"
                            },
                            {
                                "example_id": "c460f349-c355-4204-a6ca-b40e9c58914b",
                                "sense_id": "4a300357-b491-3bd6-83f4-52ffb3ad4f7a",
                                "text": "„Was wir in erster Euphorie nicht merken – der Ankerpflug fehlt, so dass es nach dem nächsten Ankermanöver fast zu einer Kollision mit einer Luxusyacht kommt.“"
                            },
                            {
                                "example_id": "952d3e6a-c929-45f9-b422-ff6acdb8b547",
                                "sense_id": "4a300357-b491-3bd6-83f4-52ffb3ad4f7a",
                                "text": "„Rüstlien, eine dünne Kette, welche den Anker beim Ankerarm mit dem Ankerpflug, nachdem der Anker vorher auf den Bug des Schiffes gebracht ist, nach der Rüste zu festhält, so wie die Perteurlien den Anker beim Ring am Kranbalken.“"
                            },
                            {
                                "example_id": "fe3ef55a-082f-4e41-a3d8-fabe36c79984",
                                "sense_id": "4a300357-b491-3bd6-83f4-52ffb3ad4f7a",
                                "text": "„Er dreht sich immer so, daß die Ankerpflüge nach unten kommen und sich so in dem Schnee festfressen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
