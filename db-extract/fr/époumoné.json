                        "examples": [
                            {
                                "example_id": "ef073429-0677-47d7-8fa2-0d1e4b501a8e",
                                "sense_id": "c54830de-be99-3664-8e64-20203a91603a",
                                "text": "Si le jeune forestier, agile, souple, vigoureux, parvenait à s’en tirer, le docteur Patak, avec ses jambes courtes, son ventre bedonnant, essoufflé, époumoné, ne pouvait éviter des chutes, qui obligeaient à lui venir en aide."
                            },
                            {
                                "example_id": "8c4fc828-703a-4316-b875-5aaccf20b38e",
                                "sense_id": "c54830de-be99-3664-8e64-20203a91603a",
                                "text": "Le rendu donnait un style wagnérien ([…]), spectacle fait de quelques passes immédiatement verticales, de nuques longues et de moustaches guerrières donnant aux courses époumonées une indéniable esthétique télévisuelle."
                            }
                        ]
                    }
