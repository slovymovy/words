    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1be27193-e61f-3937-8d8c-d177507439d4",
                    "sense_definition": "present participle and gerund of <w>twitch</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "twitch_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His right eyelid started <w>twitching</w> from stress and lack of sleep.",
                            "target_lang_translations": {
                                "de": "Sein rechtes Augenlid fing wegen Stress und Schlafmangel an zu <w>zucken</w>."
                            }
                        },
                        {
                            "text": "The cat sat by the window, nervously <w>twitching</w> its tail at the birds outside.",
                            "target_lang_translations": {
                                "de": "Die Katze saß am Fenster und ließ ihren Schwanz nervös <w>zucken</w>, während sie die Vögel draußen beobachtete."
                            }
                        }
                    ],
                    "synonyms": [
                        "jerking",
                        "spasming",
                        "quivering"
                    ],
                    "common_phrases": [
                        "twitching nose",
                        "twitching nervously",
                        "start twitching"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von twitch; zucken oder unwillkürlich zucken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zuckend",
                                "target_lang_sense_clarification": "als Partizip Präsens von zucken"
                            },
                            {
                                "target_lang_word": "zucken",
                                "target_lang_sense_clarification": "als Verbform / Gerundium"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "21c85bd3-8c7b-3889-8372-babb2926b583",
                    "sense_definition": "Moving with brief, sudden, involuntary jerks or spasms.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "twitch_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rubbed his tired, <w>twitching</w> eye after staring at the computer screen for hours.",
                            "target_lang_translations": {
                                "de": "Er rieb sich sein müdes, <w>zuckendes</w> Auge, nachdem er stundenlang auf den Computerbildschirm gestarrt hatte."
                            }
                        },
                        {
                            "text": "The dog was dreaming of running, its <w>twitching</w> paws moving gently against the rug.",
                            "target_lang_translations": {
                                "de": "Der Hund träumte vom Laufen, während sich seine <w>zuckenden</w> Pfoten sanft über den Teppich bewegten."
                            }
                        }
                    ],
                    "synonyms": [
                        "jerking",
                        "spasming",
                        "quivering"
                    ],
                    "common_phrases": [
                        "twitching eye",
                        "twitching muscle"
                    ],
                    "target_lang_definitions": {
                        "de": "Sich mit kurzen, plötzlichen und unwillkürlichen Bewegungen oder Krämpfen bewegend."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "zuckend",
                                "target_lang_sense_clarification": "plötzlich und unwillkürlich bewegend"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "76874afa-5f74-35ed-ad76-4c63367abec4",
                    "sense_definition": "A brief, sudden involuntary movement, jerk, or spasm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "twitch_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She noticed an odd <w>twitching</w> in her left thumb after lifting weights.",
                            "target_lang_translations": {
                                "de": "Sie bemerkte nach dem Gewichtheben ein seltsames <w>Zucken</w> in ihrem linken Daumen."
                            }
                        },
                        {
                            "text": "The constant <w>twitching</w> of his face revealed just how anxious he truly felt.",
                            "target_lang_translations": {
                                "de": "Das ständige <w>Zucken</w> in seinem Gesicht verriet, wie ängstlich er sich wirklich fühlte."
                            }
                        }
                    ],
                    "synonyms": [
                        "spasm",
                        "jerk",
                        "quiver",
                        "tremor"
                    ],
                    "common_phrases": [
                        "muscle twitching",
                        "involuntary twitching"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine kurze, plötzliche und unwillkürliche Bewegung, ein Ruck oder Muskelkrampf."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Zucken",
                                "target_lang_sense_clarification": "unwillkürliche Bewegung eines Muskels"
                            },
                            {
                                "target_lang_word": "das Augenzucken",
                                "target_lang_sense_clarification": "speziell bezogen auf das Augenlid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5db3449e-d5e4-3778-899c-01a410bd9bda",
                    "sense_definition": "The activity of traveling long distances to see rare birds that have been spotted.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "birdwatching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent most weekends <w>twitching</w> across the country to spot rare migratory species.",
                            "target_lang_translations": {
                                "de": "Er verbrachte die meisten Wochenenden mit <w>Twitching</w> im ganzen Land, um seltene Zugvogelarten zu erspähen."
                            }
                        },
                        {
                            "text": "Serious bird enthusiasts often distinguish casual birdwatching from dedicated <w>twitching</w>.",
                            "target_lang_translations": {
                                "de": "Ernsthafte Vogelbegeisterte unterscheiden oft normales Beobachten von gezieltem <w>Twitching</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "birdwatching",
                        "birding"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used especially in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Das gezielte Reisen über weite Strecken, um seltene, gesichtete Vögel zu beobachten (britischer Fachjargon)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Twitching",
                                "target_lang_sense_clarification": "gezielte Jagd nach seltenen Vögeln"
                            },
                            {
                                "target_lang_word": "die Vogelbeobachtung",
                                "target_lang_sense_clarification": "allgemeiner Begriff für das Beobachten von Vögeln"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f80c3608-9047-3342-bf96-78403a1ec868",
                    "sense_definition": "The practice of using a team of horses or oxen to pull logs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "logging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before modern tractors, the <w>twitching</w> of heavy timber out of the forest was done by draft horses.",
                            "target_lang_translations": {
                                "de": "Vor modernen Traktoren wurde das <w>Rücken</w> von schwerem Holz aus dem Wald von Zugpferden erledigt."
                            }
                        },
                        {
                            "text": "The old forester had decades of experience in the <w>twitching</w> and skidding of fallen trees.",
                            "target_lang_translations": {
                                "de": "Der alte Förster hatte jahrzehntelange Erfahrung im <w>Holzrücken</w> und Schleifen gefällter Bäume."
                            }
                        }
                    ],
                    "synonyms": [
                        "skidding",
                        "snaking"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "logging terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Das Ziehen von gefällten Baumstämmen aus dem Wald mithilfe von Zugtieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "das Rücken",
                                "target_lang_sense_clarification": "Transport von gefälltem Holz aus dem Wald"
                            },
                            {
                                "target_lang_word": "das Holzrücken",
                                "target_lang_sense_clarification": "forstwirtschaftlicher Begriff für das Bewegen von Baumstämmen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}