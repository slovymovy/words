                    }
                ],
                "senses": [
                    {
                        "sense_id": "b31cd457-9021-33c3-9ecc-db111bb8116a",
                        "entry_id": "6bbb4606-2cbc-3a54-aa0c-f36096b9eb9a",
                        "glosses": [
                            "een plaats of gebouw ingericht voor het verrichten van bepaald werk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "296755ac-0b90-4127-91f6-43ecc1efd312",
                                "sense_id": "b31cd457-9021-33c3-9ecc-db111bb8116a",
                                "text": "Zijn werkplaats was uitstekend ingericht voor het gieten van brons."
                            },
                            {
                                "example_id": "a9ad56fd-1ce2-4252-a2d7-f88b436c5132",
                                "sense_id": "b31cd457-9021-33c3-9ecc-db111bb8116a",
                                "text": "Ik heb haar gestolen uit de werkplaats van de miniatuurmaakster en heb haar al die jaren bij me gehouden."
                            },
                            {
                                "example_id": "5cdcf58c-0d21-4d92-aeb7-29a3bed83846",
                                "sense_id": "b31cd457-9021-33c3-9ecc-db111bb8116a",
                                "text": "'Nou, behalve dat ik haar weleens in haar kont heb geknepen en haar daarna in een hoek van de werkplaats staand heb geneukt in ruil voor een promotie, kan ik niets bedenken."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a575204-f31b-30a6-bd6f-474adf4f1a19",
                        "entry_id": "6bbb4606-2cbc-3a54-aa0c-f36096b9eb9a",
                        "glosses": [
                            "de stad of dorp waar iemand het werk verricht"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e7af6de-61ff-4f90-8369-02cf6075b731",
                        "source_entry_id": "6bbb4606-2cbc-3a54-aa0c-f36096b9eb9a",
                        "target_lang_word": "workplace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "workplace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67ff26d7-d7a3-3985-9fc5-507cffae0f9a",
                                        "entry_id": "3c1ab322-a000-3ffd-bb37-a4e6f2bf7799",
                                        "glosses": [
                                            "The place where someone works."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac00363e-4069-4886-9d73-74fb4805c489",
                                                "sense_id": "67ff26d7-d7a3-3985-9fc5-507cffae0f9a",
                                                "text": "Meronyms: workspace, workstation"
                                            },
                                            {
                                                "example_id": "53f0918b-6a6c-44cf-92c8-1908680cbd18",
                                                "sense_id": "67ff26d7-d7a3-3985-9fc5-507cffae0f9a",
                                                "text": "in the workplace"
                                            },
                                            {
                                                "example_id": "c48d0165-c01f-44e6-8dbd-ed24403abdc1",
                                                "sense_id": "67ff26d7-d7a3-3985-9fc5-507cffae0f9a",
                                                "text": "professionalism in the workplace"
                                            },
                                            {
                                                "example_id": "ec68e5cf-1c23-4956-97ab-5a4d96dcbda4",
                                                "sense_id": "67ff26d7-d7a3-3985-9fc5-507cffae0f9a",
                                                "text": "The catalyst was the introduction of the Health & Safety at Work Act in 1974. While it applied to all workplaces, it gradually brought about a sea change in the attitude towards death and injury. Accidents were no longer accepted as 'inevitable'."
                                            },
                                            {
                                                "example_id": "ec63470e-c88a-43c9-9c9c-597b2537ae5c",
                                                "sense_id": "67ff26d7-d7a3-3985-9fc5-507cffae0f9a",
                                                "text": "It [the West Midlands Rail Executive] also notes that some people are choosing to live further from their workplace and commute less often."
                                            },
                                            {
                                                "example_id": "9acd9b4c-83f6-4bdb-9458-3ad153e92b61",
                                                "sense_id": "67ff26d7-d7a3-3985-9fc5-507cffae0f9a",
                                                "text": "In a workplace where everyone wears company-branded jackets and attends the monthly team happy hour, the otrovert might go occasionally, but their sense of self is untouched by whether they participate or not."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bd3348f-4070-4f96-8eb2-bf207d1c0841",
                        "source_entry_id": "6bbb4606-2cbc-3a54-aa0c-f36096b9eb9a",
                        "target_lang_word": "workshop",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "workshop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c78124f5-fb0b-3f11-bedf-b30bf5c8b7b5",
                                        "entry_id": "daf4a046-ebac-3c05-9378-80e8e449df57",
                                        "glosses": [
                                            "A room, especially one which is not particularly large, used for manufacturing or other light industrial work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d7fc2cc-c1f4-4059-be23-29cdf5188df6",
                                                "sense_id": "c78124f5-fb0b-3f11-bedf-b30bf5c8b7b5",
                                                "text": "A gleam of sun shining through the unsashed window, and chequering the dark workshop with a broad patch of light, fell full upon him, as though attracted by his sunny heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2596f3c8-348a-3909-8ff7-a9d11e212cee",
                                        "entry_id": "daf4a046-ebac-3c05-9378-80e8e449df57",
                                        "glosses": [
                                            "A brief, intensive course of education for a small group, emphasizing interaction and practical problem solving."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf7acbc2-b73f-45a4-8587-37325afeb262",
                                                "sense_id": "2596f3c8-348a-3909-8ff7-a9d11e212cee",
                                                "text": "On any given Friday night at the Claremont Colleges, between 15 and 20 Jewish students gather to sing wordless melodies, dive into textual study of Talmud or James Baldwin, or hold workshops on antisemitism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33367a56-50f4-37a4-90ee-81998605e178",
                                        "entry_id": "daf4a046-ebac-3c05-9378-80e8e449df57",
                                        "glosses": [
                                            "An academic conference."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "workshop",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d13c3bf-b2e9-351f-9566-3f4791647c28",
                                        "entry_id": "8efcd7c6-603e-3d9e-8b39-298b22c92787",
                                        "glosses": [
                                            "To help a playwright revise a draft of (a play) by rehearsing it with actors and critiquing the results."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1577e373-782d-3d9d-94ae-d45291036045",
                                        "entry_id": "8efcd7c6-603e-3d9e-8b39-298b22c92787",
                                        "glosses": [
                                            "To work on or revise something, especially collaboratively, in a workshop."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7728d327-3494-46c6-bf78-2622f337fd16",
                                                "sense_id": "1577e373-782d-3d9d-94ae-d45291036045",
                                                "text": "Some in-class tutorial time was set aside for workshopping the entries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef33e593-66f4-3281-8517-79d6e7976ef0",
                                        "entry_id": "8efcd7c6-603e-3d9e-8b39-298b22c92787",
                                        "glosses": [
                                            "To improve through collaboration."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
