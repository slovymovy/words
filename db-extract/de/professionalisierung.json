                "senses": [
                    {
                        "sense_id": "81eb04b1-d74e-34dd-8fde-9de665e22b02",
                        "entry_id": "23e197b2-6ee0-3801-972d-f1b345c0fd59",
                        "glosses": [
                            "Entwicklung einer bestimmten Tätigkeit, bestimmter Leistungen zu einem anerkannten, spezialisierten Beruf, zu einer Profession"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fa5b415-33b2-45d9-bba8-710a5946dc40",
                                "sense_id": "81eb04b1-d74e-34dd-8fde-9de665e22b02",
                                "text": "„Die Erfindung des Radios setzte einen Prozess der Professionalisierung in Gang.“"
                            },
                            {
                                "example_id": "526c32f7-56f4-4458-8f82-7fdb6e5c388b",
                                "sense_id": "81eb04b1-d74e-34dd-8fde-9de665e22b02",
                                "text": "„Diese Seminararbeit befasst sich mit der Professionalisierung des Lehrerberufs.“"
                            },
                            {
                                "example_id": "3521afaa-d4a5-4c2c-8d20-6203fc79cef1",
                                "sense_id": "81eb04b1-d74e-34dd-8fde-9de665e22b02",
                                "text": "„Gerd Michelsen, der Herausgeber dieses Buches, will den Lesern einen Überblick verschaffen und einen Einstieg ermöglichen, er will einer weiteren Professionalisierung der Umweltberatung den Weg bereiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
