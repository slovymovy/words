                "senses": [
                    {
                        "sense_id": "c0443bd2-0c1f-37f4-8e15-63c94549a73d",
                        "entry_id": "c08c430e-4b40-332e-979f-79d2c82521cf",
                        "glosses": [
                            "Teil oder auch Gesamtheit der Landwirtschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00c7e2c7-abb4-4ab8-a9d0-9a15f1f46c13",
                                "sense_id": "c0443bd2-0c1f-37f4-8e15-63c94549a73d",
                                "text": "„Die Reisproduktion, der wichtigste Agrarzweig, kam in die Hände von pensionierten Offizieren oder Funktionären.“"
                            },
                            {
                                "example_id": "914ce8de-db4e-4e87-b724-ff318e4cc5e0",
                                "sense_id": "c0443bd2-0c1f-37f4-8e15-63c94549a73d",
                                "text": "„Nur langsam erholte sich der Agrarzweig und wuchs zu einem profitablen Wirtschaftssektor heran, in dem heute über 100 000 Menschen arbeiten.“"
                            },
                            {
                                "example_id": "4b6288a1-c4ad-4a93-a9c4-3425d9d3f904",
                                "sense_id": "c0443bd2-0c1f-37f4-8e15-63c94549a73d",
                                "text": "„Dieser Agrarzweig beansprucht über die Hälfte des bewässerbaren Landes und beschäftigt einen erheblichen Teil der Bevölkerung.“"
                            },
                            {
                                "example_id": "a175f6a5-0ce1-4480-aa75-5384dea64df9",
                                "sense_id": "c0443bd2-0c1f-37f4-8e15-63c94549a73d",
                                "text": "„Es gab zwar erfolgreich wirtschaftende arabische Industrie- und Agrarzweige während der Mandatszeit, aber in der Regel herrschten noch eine traditionelle Landwirtschaft und nur eine geringe Industrialisierung vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "78ecd397-4a17-3d58-8908-aafbfbb17388",
                        "entry_id": "c08c430e-4b40-332e-979f-79d2c82521cf",
                        "glosses": [
                            "Ausbildung mit landwirtschaftlicher Ausrichtung, zum Beispiel an einer (beruflichen) Schule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1d98c81-5a47-4410-b9d9-ba5634b725be",
                                "sense_id": "78ecd397-4a17-3d58-8908-aafbfbb17388",
                                "text": "„Arbeiten am neuen Gebäude für den Agrarzweig kommen zügig voran“"
                            },
                            {
                                "example_id": "c4c5d176-4f0f-49c5-b89b-d014cc323c24",
                                "sense_id": "78ecd397-4a17-3d58-8908-aafbfbb17388",
                                "text": "„Groß geworden ist er im Ortsteil Güttingen, auf dem Mettnau-Gymnasium machte er sein Abitur (Agrarzweig), danach absolvierte er eine Lehre als Landschaftsgärtner in Böhringen und Stuttgart.“"
                            },
                            {
                                "example_id": "93e7cddc-59ef-4dec-8996-362cce135b99",
                                "sense_id": "78ecd397-4a17-3d58-8908-aafbfbb17388",
                                "text": "„Nach seinen Worten hat die FOS in Kempten das gleiche Problem: Sie wollte einen neuen Agrarzweig einrichten, …“"
                            },
                            {
                                "example_id": "5ddbb29a-6177-41fd-aac4-deb324158447",
                                "sense_id": "78ecd397-4a17-3d58-8908-aafbfbb17388",
                                "text": "„Neue Räume für den Agrarzweig an der Landrat-Gruber-Schule entstehen.“"
                            },
                            {
                                "example_id": "43cc17c6-76fc-4a2a-8384-d4dd7bcb26e7",
                                "sense_id": "78ecd397-4a17-3d58-8908-aafbfbb17388",
                                "text": "„In Schönbrunn besteht auch ein Agrarzweig.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
