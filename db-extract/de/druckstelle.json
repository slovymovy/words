                    {
                        "form_id": "5b500e88-b26a-478f-93c0-5bdf4aa40de7",
                        "entry_id": "c39f4de8-68ee-3e2d-9b06-a0611b607d41",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Druckstellen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69f6f5fa-0fb6-318f-84aa-1151b4c21472",
                        "entry_id": "c39f4de8-68ee-3e2d-9b06-a0611b607d41",
                        "glosses": [
                            "Stelle an der Oberfläche, die durch Druck beschädigt ist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f83d116b-21ca-455f-bb6d-d648e073107a",
                                "sense_id": "69f6f5fa-0fb6-318f-84aa-1151b4c21472",
                                "text": "Werden Äpfel an Druckstellen braun, sollte die Stelle großflächig herausgeschnitten werden."
                            },
                            {
                                "example_id": "2d9face6-3e30-4358-9475-ffe75b45c7bb",
                                "sense_id": "69f6f5fa-0fb6-318f-84aa-1151b4c21472",
                                "text": "„Er ist schmal und lang und nicht mit Druckstellen verunstaltet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eb16f59d-96ab-3a14-b7ae-1e35099ef5e9",
                        "entry_id": "c39f4de8-68ee-3e2d-9b06-a0611b607d41",
                        "glosses": [
                            "Körperstelle, die länger einem mechanischen Druck, etwa beim Bettlägerigen, ausgesetzt ist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb883388-c454-4281-ae84-fac67b0a0134",
                                "sense_id": "eb16f59d-96ab-3a14-b7ae-1e35099ef5e9",
                                "text": "Medizin: In der Regel kommen Druckstellen an Körperbereichen vor, die einer erhöhten mechanischen Beanspruchung ausgesetzt sind und an denen der Knochen nur durch eine dünne Weichteilschicht bedeckt ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8506d12f-173a-3cdd-a942-c3a3241eaf29",
                        "entry_id": "c39f4de8-68ee-3e2d-9b06-a0611b607d41",
                        "glosses": [
                            "durch die Prothesenbasis bedingte Schädigung der Schleimhaut, deren Ursachen zu lange Prothesenränder und eine nicht passende Prothesenbasis sein können."
                        ],
                        "tags": [
                            "Zahnmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "de1c391f-f84f-4190-bc39-3c4a4acce1b6",
                                "sense_id": "8506d12f-173a-3cdd-a942-c3a3241eaf29",
                                "text": "Zahnmedizin: Die einzige Möglichkeit, um Druckstellen im Mund dauerhaft zu vermeiden, ist eine optimal angepasste Zahnprothese."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "2ada8eea-0b9e-381c-beea-135408a5a73e",
                        "entry_id": "c39f4de8-68ee-3e2d-9b06-a0611b607d41",
                        "glosses": [
                            "schmerzhafte Stelle auf der Haut in der Sattellage beim Pferd"
                        ],
                        "tags": [
                            "Tiermedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "6c1d693f-c2f6-441f-bbf5-e179602541d8",
                                "sense_id": "2ada8eea-0b9e-381c-beea-135408a5a73e",
                                "text": "Tiermedizin: Eine Druckstelle in der Gurtlage wird Gurtdruck genannt."
                            },
                            {
                                "example_id": "41240c58-0034-4fd9-a21b-dcc9827239d8",
                                "sense_id": "2ada8eea-0b9e-381c-beea-135408a5a73e",
                                "text": "Einige typische Ursachen von Druckstellen beim Pferd sind ein zu enger Sattel, der drückt, ein zu lockerer Sattel, der scheuert, Falten in der Satteldecke und ein ungleichmäßiger Druck durch schlechten Sitz des Reiters."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "a977b0d1-f377-3276-baaa-851f48661a13",
                        "entry_id": "c39f4de8-68ee-3e2d-9b06-a0611b607d41",
                        "glosses": [
                            "Bereich auf den gedruckt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "063ccdb2-6e48-466f-9eae-2e7a20a264a2",
                                "sense_id": "a977b0d1-f377-3276-baaa-851f48661a13",
                                "text": "Mithilfe von flexiblen Druckformen aus Fotopolymeren werden die lebensmittelunbedenklichen Wasserfarben auf die Druckstelle gepresst."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
