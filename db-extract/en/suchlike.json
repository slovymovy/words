                                            {
                                                "example_id": "bbcbf967-86d0-4779-a7a4-1c6a072b0da3",
                                                "sense_id": "1ce1e866-f564-38b6-8081-00a6db61172d",
                                                "text": "„Durch eine derartig vorbereitete Fläche soll ein – oft späteres – Kleben ermöglicht werden.“"
                                            },
                                            {
                                                "example_id": "80c924ee-1492-4aef-8dce-32b96d0bcfb0",
                                                "sense_id": "1ce1e866-f564-38b6-8081-00a6db61172d",
                                                "text": "„In Italien oder Frankreich wurde keine derartig scharfe Trennung vorgenommen.“"
                                            },
                                            {
                                                "example_id": "ab50a05e-e789-42b1-8ec3-75af3d7c7034",
                                                "sense_id": "1ce1e866-f564-38b6-8081-00a6db61172d",
                                                "text": "„Als Torwarttrainer wird in der Regel ein Trainerassistent bezeichnet, der dem hauptverantwortlichen Trainer im Bereich des Torwarttrainings assistiert. Viele professionelle Vereine in Mannschaftssportarten wie Eishockey, Fußball oder Handball verfügen über derartige Spezialisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "423461fb-6c83-4380-8307-672da53f36d9",
