                "senses": [
                    {
                        "sense_id": "b0e4ed88-07d5-3672-aa3f-f61c65e607de",
                        "entry_id": "4dcbed51-145b-3df9-a79f-034df263fecd",
                        "glosses": [
                            "Anfänger auf verschiedenen Gebieten der Informationstechnologie (insbesondere Internet-Kommunikation, elektronische Spiele)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f097f66-5bf3-4928-945e-94d82115af5a",
                                "sense_id": "b0e4ed88-07d5-3672-aa3f-f61c65e607de",
                                "text": "Bitte lass mir eine Chance, ich habe gerade erst angefangen, denn ich bin noch ein Newbie."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "799b770a-7c43-4184-b6dd-ca6eac2bb493",
                        "source_entry_id": "4dcbed51-145b-3df9-a79f-034df263fecd",
                        "source_sense_id": "b0e4ed88-07d5-3672-aa3f-f61c65e607de",
                        "target_lang_word": "newbie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "newbie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4a0c8bb-fd81-3557-b57c-585c51db487a",
                                        "entry_id": "d20c73df-b279-3ab3-9681-0881573bd249",
                                        "glosses": [
                                            "A newcomer, someone new to something."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "898b38a1-63d6-4f5e-aca7-2057722f9d17",
                                                "sense_id": "d4a0c8bb-fd81-3557-b57c-585c51db487a",
                                                "text": "He was a newbie to chemistry."
                                            },
                                            {
                                                "example_id": "5d638d75-4314-4ca2-9d9f-c131508cf3e1",
                                                "sense_id": "d4a0c8bb-fd81-3557-b57c-585c51db487a",
                                                "text": "We’ve included some other acts you already know so you’ll get a feel for what the newbies sound like."
                                            },
                                            {
                                                "example_id": "b95e1f6c-8faf-4da8-b858-d366cb3d9272",
                                                "sense_id": "d4a0c8bb-fd81-3557-b57c-585c51db487a",
                                                "text": "If you’re starting off skinny, you can probably get newbie gains for several months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "868cfa58-cc8d-352c-96d0-2a530acc5131",
                                        "entry_id": "d20c73df-b279-3ab3-9681-0881573bd249",
                                        "glosses": [
                                            "A new user or participant; someone who is extremely new and inexperienced (to a game or activity). A beginner."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d942ceb-524d-3b94-bb5b-45591d52308f",
                                        "entry_id": "d20c73df-b279-3ab3-9681-0881573bd249",
                                        "glosses": [
                                            "Anything recently introduced into a setting, especially something that replaces an older version."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b453107f-19d7-4793-8b37-b99dae93fb5a",
                                                "sense_id": "3d942ceb-524d-3b94-bb5b-45591d52308f",
                                                "text": "If you find that you would prefer using the new printer most of the time, while using the original only when needed, you can make the newbie the default printer for your system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3573592f-b86a-48ca-bb43-01b65199c011",
                        "source_entry_id": "4dcbed51-145b-3df9-a79f-034df263fecd",
                        "source_sense_id": "b0e4ed88-07d5-3672-aa3f-f61c65e607de",
                        "target_lang_word": "нуб",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нуб",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6adcfa2d-55c9-3d76-b55d-820d5fd3877f",
                                        "entry_id": "4811ef1f-e144-3d75-a01b-5b85836c0bdf",
                                        "glosses": [
                                            "разг., неол., сленг новый пользователь; приступающий к освоению тонкостей какой-либо технологии, преимущественно связанной с компьютерами и интернетом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75bccbe5-4922-451d-a9e5-46594ef0316e",
                                                "sense_id": "6adcfa2d-55c9-3d76-b55d-820d5fd3877f",
                                                "text": "Сообщения нуба, как правило, можно охарактеризовать словами «не в тему»."
                                            },
                                            {
                                                "example_id": "5d378961-87b0-4288-a432-9a14ae15957f",
                                                "sense_id": "6adcfa2d-55c9-3d76-b55d-820d5fd3877f",
                                                "text": "По общепринятой терминологии нубом называется новичок эхи/форума/имиджборда/etc., который, хотя и не знаком с основными законами и мемами своего нового местообитания, пытается прослыть «своим»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9848342-b34f-36b1-8d0e-77ef92277af4",
                                        "entry_id": "4811ef1f-e144-3d75-a01b-5b85836c0bdf",
                                        "glosses": [
                                            "разг., неол., игр., неодобр. плохой, неопытный игрок, новичок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3188ade6-e339-4448-afa5-c6aa29fc6d86",
                                                "sense_id": "b9848342-b34f-36b1-8d0e-77ef92277af4",
                                                "text": "Затем владелец твинка замораживает ему опыт и развлекается, раскладывая на бэттлграундах зелёных нубов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5d729cc-a01a-4672-ae92-b8746c7df1f8",
                        "source_entry_id": "4dcbed51-145b-3df9-a79f-034df263fecd",
                        "source_sense_id": "b0e4ed88-07d5-3672-aa3f-f61c65e607de",
                        "target_lang_word": "чайник",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чайник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0d64d869-183a-3b66-93cb-1718444cfa57",
                                        "entry_id": "145cf26e-80a0-3fbc-981e-fbf0cd7a7ba0",
                                        "glosses": [
                                            "предмет посуды; сосуд с носиком и ручкой, используемый для кипячения воды"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27ef89a9-1391-4c86-ac11-45875286a38c",
                                                "sense_id": "0d64d869-183a-3b66-93cb-1718444cfa57",
                                                "text": "Чайник со свистком."
                                            },
                                            {
                                                "example_id": "44ae8462-ae8e-46bc-a1f9-b595f5aec9f9",
                                                "sense_id": "0d64d869-183a-3b66-93cb-1718444cfa57",
                                                "text": "Электрический чайник."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "354ba652-32ff-3eef-bf4d-3260eef39a52",
                                        "entry_id": "145cf26e-80a0-3fbc-981e-fbf0cd7a7ba0",
                                        "glosses": [
                                            "предмет посуды; керамический сосуд с носиком и ручкой, используемый для заваривания чая"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e875c24-5eb0-49ff-b311-bfb89633c54b",
                                                "sense_id": "354ba652-32ff-3eef-bf4d-3260eef39a52",
                                                "text": "Смеркалось; на столе блистая // Шипел вечерний самовар, // Китайской чайник нагревая; // Под ним клубился легкой пар."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f19ca141-cbf6-38aa-aec6-37b2748fad94",
                                        "entry_id": "145cf26e-80a0-3fbc-981e-fbf0cd7a7ba0",
                                        "glosses": [
                                            "количество жидкости, равное объёму таких сосудов"
                                        ],
                                        "tags": [
                                            "чего."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d65d31d-5fe1-4dc4-aded-dc0e7883e089",
                                                "sense_id": "f19ca141-cbf6-38aa-aec6-37b2748fad94",
                                                "text": "Ресторан брал за фунт хлеба и чайник воды два рубля."
                                            },
                                            {
                                                "example_id": "daa1b4d3-1f19-47c8-b36e-ea10f574aebb",
                                                "sense_id": "f19ca141-cbf6-38aa-aec6-37b2748fad94",
                                                "text": "Она приносила кастрюлю манной каши и чайник кипятка .."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "чайник",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4cf34a44-866f-3538-954b-ec91f5d5439d",
                                        "entry_id": "f853cbcb-bc6b-3920-888b-2a725c92402e",
                                        "glosses": [
                                            "перен., разг., шутл. неопытный человек; новичок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d8a1e2b-aa94-484f-af3f-647da56a1ee2",
                                                "sense_id": "4cf34a44-866f-3538-954b-ec91f5d5439d",
                                                "text": "Ему, похоже, стало немного стыдно, что брать опасного вора идут какие-то «чайники», да к тому же связанные обязательством не пугать честных граждан."
                                            },
                                            {
                                                "example_id": "38270000-edf3-42fd-87be-7c352eaab9dd",
                                                "sense_id": "4cf34a44-866f-3538-954b-ec91f5d5439d",
                                                "text": "Чайниками курсантов называют потому, что они ещё не приняли присягу."
                                            },
                                            {
                                                "example_id": "b62fde2e-1323-4336-bbba-f70d65ff2473",
                                                "sense_id": "4cf34a44-866f-3538-954b-ec91f5d5439d",
                                                "text": "Его, как и всякого профессионала — а уж в ветеринарной магии он был достойный ученик Тарараха, — раздражали советы «чайника»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
