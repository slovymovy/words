                },
                {
                    "sense_id": "9d7914f8-6700-395e-aa35-c58f69774993",
                    "sense_definition": "laten zien dat men over bepaalde kwaliteiten of vaardigheden beschikt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tonen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe werknemer heeft zich in zijn proefperiode voldoende <w>bewezen</w>.",
                            "target_lang_translations": {
                                "en": "The new employee has sufficiently <w>proven</w> himself during his trial period.",
                                "ru": "Новый сотрудник достаточно хорошо <w>зарекомендовал себя</w> в течение испытательного срока."
                            }
                        },
                        {
                            "text": "Hij wilde zichzelf <w>bewijzen</w> door de moeilijkste opdracht aan te nemen.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>prove</w> himself by taking on the most difficult task.",
                                "ru": "Он хотел <w>проявить себя</w>, взявшись за самое сложное задание."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zich bewijzen"
                    ],
                    "target_lang_definitions": {
                        "en": "To show that one possesses certain qualities or skills through actions",
                        "ru": "Показывать наличие определенных качеств или способностей своими действиями"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "prove oneself",
                                "target_lang_sense_clarification": "to show one's worth or ability"
                            },
                            {
                                "target_lang_word": "show one's mettle",
                                "target_lang_sense_clarification": "to demonstrate ability in a difficult situation"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "проявлять себя",
                                "target_lang_sense_clarification": "показывать свои способности"
                            },
                            {
                                "target_lang_word": "зарекомендовать себя",
                                "target_lang_sense_clarification": "создать о себе определенное мнение"
                            },
                            {
                                "target_lang_word": "доказывать свою состоятельность",
                                "target_lang_sense_clarification": "подтверждать делом свои навыки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e2f47e6-7370-306d-b86b-493c1cf742be",
                    "sense_definition": "iemand een gunst of eer betonen",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verlenen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zou je mij een dienst kunnen <w>bewijzen</w> door dit pakketje te posten?",
                            "target_lang_translations": {
                                "en": "Could you <w>do</w> me a favor by posting this package?",
                                "ru": "Не могли бы вы <w>оказать</w> мне услугу и отправить эту посылку?"
                            }
                        },
                        {
                            "text": "Zij wilden de overleden koning de laatste eer <w>bewijzen</w>.",
                            "target_lang_translations": {
                                "en": "They wanted to <w>pay</w> their last respects to the deceased king.",
                                "ru": "Они хотели <w>отдать</w> последние почести покойному королю."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dienst bewijzen",
                        "eer bewijzen",
                        "gunst bewijzen"
                    ],
                    "target_lang_definitions": {
                        "en": "To perform a favor for someone or show them a specific honor",
                        "ru": "Оказывать кому-либо услугу или выражать почтение"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "do",
                                "target_lang_sense_clarification": "used with 'favor' or 'service'"
                            },
                            {
                                "target_lang_word": "pay",
                                "target_lang_sense_clarification": "used with 'respects' or 'tribute'"
                            },
                            {
                                "target_lang_word": "render",
                                "target_lang_sense_clarification": "to provide a service or honor formally"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "оказывать",
                                "target_lang_sense_clarification": "используется с существительными 'услуга' или 'честь'"
                            },
                            {
                                "target_lang_word": "отдавать",
                                "target_lang_sense_clarification": "используется в выражении 'отдавать дань уважения'"
                            }
                        ]
                    }
                }
            ]
        },
