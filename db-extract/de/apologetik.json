                ],
                "senses": [
                    {
                        "sense_id": "1a7496c6-b1ef-3e32-829f-a5ee0aa938c1",
                        "entry_id": "76eb373e-ef73-30aa-b814-406a4ac1e14c",
                        "glosses": [
                            "Verteidigung, Rechtfertigung einer Weltanschauung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "753fc202-7aee-437b-9501-12f974b30819",
                                "sense_id": "1a7496c6-b1ef-3e32-829f-a5ee0aa938c1",
                                "text": "Es ist sogar der Eindruck entstanden, von einem Bündnis der Elefanten, CDU und SPD also, sei mehr Veränderung zu erwarten als von der FDP, die so vieles blockiert. Über die bloße Apologetik der freien Marktwirtschaft ist sie nicht recht hinausgelangt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b08ff36f-8b54-3fd3-a791-97739e4b6d60",
                        "entry_id": "76eb373e-ef73-30aa-b814-406a4ac1e14c",
                        "glosses": [
                            "Rechtfertigung der christlichen Glaubenslehre"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "11c37e5f-2ae3-40df-ac65-ab5db6e3a6ba",
                                "sense_id": "b08ff36f-8b54-3fd3-a791-97739e4b6d60",
                                "text": "„In dieser klassischen Form der Apologetik wird nicht primär das Christentum verteidigt, sondern als ein logischer, vernunftgemäßer Glaube dargestellt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d919d4fc-0a00-4697-b841-e1240b67226e",
                        "source_entry_id": "76eb373e-ef73-30aa-b814-406a4ac1e14c",
                        "source_sense_id": "1a7496c6-b1ef-3e32-829f-a5ee0aa938c1",
                        "source_sense_description": "Verteidigung, Rechtfertigung einer Weltanschauung",
                        "target_lang_word": "apology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dff6dfa7-e3a0-330d-bf7d-b4e83f2985e3",
                                        "entry_id": "be433687-9c43-355c-b151-7b00af6673af",
                                        "glosses": [
                                            "An expression of remorse or regret for having said or done something that harmed another: an instance of apologizing (saying that one is sorry)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e440391a-1bb5-4616-8e47-eba142947025",
                                                "sense_id": "dff6dfa7-e3a0-330d-bf7d-b4e83f2985e3",
                                                "text": "What he said really hurt my feelings, but his apology sounded so sincere that I couldn't help but forgive him."
                                            },
                                            {
                                                "example_id": "4893a22b-2bc7-4b7a-a3b9-444e9778351e",
                                                "sense_id": "dff6dfa7-e3a0-330d-bf7d-b4e83f2985e3",
                                                "text": "The CEO made a public apology for the scandal, and promised full cooperation with the authorities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838813eb-a2fd-3d4a-b162-d4a88c90eb58",
                                        "entry_id": "be433687-9c43-355c-b151-7b00af6673af",
                                        "glosses": [
                                            "A formal justification, defence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe05163-bf41-4d36-adab-ee22ea223b6e",
                                                "sense_id": "838813eb-a2fd-3d4a-b162-d4a88c90eb58",
                                                "text": "the Apology of Socrates"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "331caa2c-c36a-364b-953f-1193c703dad1",
                                        "entry_id": "be433687-9c43-355c-b151-7b00af6673af",
                                        "glosses": [
                                            "Anything provided as a substitute; a makeshift."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6fb20be-5a51-4e83-91d0-2c57fa904da6",
                                                "sense_id": "331caa2c-c36a-364b-953f-1193c703dad1",
                                                "text": "a poor apology for a hotel room"
                                            },
                                            {
                                                "example_id": "89e11b3a-fa4f-47c9-bc75-3d1184d917fd",
                                                "sense_id": "331caa2c-c36a-364b-953f-1193c703dad1",
                                                "text": "[He] goes to work devising apologies for window curtains."
                                            },
                                            {
                                                "example_id": "3306ef70-97a8-428f-b31e-9e7b5eff570f",
                                                "sense_id": "331caa2c-c36a-364b-953f-1193c703dad1",
                                                "text": "The response to firing is remarkable, and though the 280 lb. pressure seems more in the nature of a reserve for emergencies than a continuous working figure, even with the present-day apology for coal it seldom fell below 250 lb., and could always be brought up to blowing-off point with little difficulty. To this liveliness of steaming the thermic syphons are doubtless the chief contributory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bbf21d5-5c0c-4500-9db7-4b2a22856303",
                        "source_entry_id": "76eb373e-ef73-30aa-b814-406a4ac1e14c",
                        "source_sense_id": "1a7496c6-b1ef-3e32-829f-a5ee0aa938c1",
                        "source_sense_description": "Verteidigung, Rechtfertigung einer Weltanschauung",
                        "target_lang_word": "apologia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apologia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e5eb47b-faf0-39ec-8550-6ef5107bd9b1",
                                        "entry_id": "3ac13585-470d-3c6e-996e-e15d1ecf59aa",
                                        "glosses": [
                                            "A written defense of a position or belief."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee946b17-a3af-42e4-ada8-790d0c9b0c05",
                                                "sense_id": "5e5eb47b-faf0-39ec-8550-6ef5107bd9b1",
                                                "text": "Although I've enumerated some of the academic traditions and debates that have animated this book, it is not my purpose to offer a full apologia in these brief pages."
                                            },
                                            {
                                                "example_id": "3a781a5e-0908-42f2-a0b1-ff40e0f8ef1f",
                                                "sense_id": "5e5eb47b-faf0-39ec-8550-6ef5107bd9b1",
                                                "text": "“Gone With the Wind” was published in 1936, and despite heroic efforts over the last seven decades to transform it into something else, the novel stands as an apologia for the Old South — […]"
                                            },
                                            {
                                                "example_id": "c62801d2-6efe-4324-8df0-285e2848da43",
                                                "sense_id": "5e5eb47b-faf0-39ec-8550-6ef5107bd9b1",
                                                "text": "The apologia his [Gabriel García Márquez] sons contribute at the beginning of the book is unconvincing, and their final excuse is particularly hard to swallow:[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "666d1d1f-e0b4-4cfb-95d8-6fdb9c77aeca",
                        "source_entry_id": "76eb373e-ef73-30aa-b814-406a4ac1e14c",
                        "source_sense_id": "1a7496c6-b1ef-3e32-829f-a5ee0aa938c1",
                        "source_sense_description": "Verteidigung, Rechtfertigung einer Weltanschauung",
                        "target_lang_word": "apologétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apologétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1c5de2b-03f3-3bd8-9ad3-a07a446096e3",
                                        "entry_id": "877529bc-f9fb-380d-8fa5-a583f8def63d",
                                        "glosses": [
                                            "Qui contient une apologie, défensif, justificatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6f6b312-58bf-4610-9b04-5ca9126e6ead",
                                                "sense_id": "c1c5de2b-03f3-3bd8-9ad3-a07a446096e3",
                                                "text": "Cette attitude violente parut soudainement décourager Jacques qui cependant entreprit un discours qui voulait être à la fois apologétique et pithiatique mais Dominique l’interrompit pour expliquer posément qu’elle n’acceptait d’hommages que platoniques et qu’il ne pouvait être question entre eux des viles et stercoraires réalisations de l’amour charnel."
                                            },
                                            {
                                                "example_id": "3592eef4-e95f-4dc1-8814-96d5bc8bb9ad",
                                                "sense_id": "c1c5de2b-03f3-3bd8-9ad3-a07a446096e3",
                                                "text": "L’idée d’écrire des romans apologétiques a quelque chose d’horrifiant à mes yeux. J’aimerais mieux ne plus jamais écrire que de fabriquer une œuvre d’imagination qui tende à prouver quoi que ce soit."
                                            },
                                            {
                                                "example_id": "e18f95a7-c012-4c21-ac58-36b8e26882a3",
                                                "sense_id": "c1c5de2b-03f3-3bd8-9ad3-a07a446096e3",
                                                "text": "Une étape des plus importantes dans cette direction est l’appel des radicaux à l’authenticité, le refus de la modernité, de l’islam apologétique moderniste et le retour de l’islam lui-même à la politique active."
                                            },
                                            {
                                                "example_id": "e2cefbb0-8333-4c7d-889e-38767eebe404",
                                                "sense_id": "c1c5de2b-03f3-3bd8-9ad3-a07a446096e3",
                                                "text": "Un Mémoire apologétique de sa conduite qu’il publia à cette occasion fut solidement réfuté par l’abbé Tharin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "apologétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3903988a-6026-375a-a6c8-a3529835a57b",
                                        "entry_id": "55cc8138-36f3-301d-81cf-12b846f34747",
                                        "glosses": [
                                            "Champ d’études théologique ou littéraire consistant en la défense systématique d’une position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd328b38-a783-4600-9647-bbeba758775f",
                                                "sense_id": "3903988a-6026-375a-a6c8-a3529835a57b",
                                                "text": "Ainsi, au milieu du pathos prétentieux qui a envahi, de nos jours, l’apologétique chrétienne, s’est conservée une école de solide doctrine, répudiant l’éclat, abhorrant le succès."
                                            },
                                            {
                                                "example_id": "fcb868c2-7728-4406-a060-b0e7c6c1d0e7",
                                                "sense_id": "3903988a-6026-375a-a6c8-a3529835a57b",
                                                "text": "J’avais poussé assez loin mon instruction religieuse et suivi des cours d’apologétique ; à toute objection dirigée contre les vérités révélées, je savais opposer un argument subtil : je n’en connaissais aucun qui les démontrât."
                                            },
                                            {
                                                "example_id": "46da1e76-0afb-413d-b06c-cee61f29d1fa",
                                                "sense_id": "3903988a-6026-375a-a6c8-a3529835a57b",
                                                "text": "Cette sorte d’apologétique n’est pas spéciale aux défendeurs des crimes papistes ici et parpaillots là : les fanatiques et les profiteurs des idéologies de nos jours ne mentent pas autrement."
                                            },
                                            {
                                                "example_id": "802bf553-b986-4fee-8085-5d0cb763c4ec",
                                                "sense_id": "3903988a-6026-375a-a6c8-a3529835a57b",
                                                "text": "Aucune civilisation n'a jamais échappé à l'apologétique de la femme, à part quelques rares sociétés de jeunes mâles guerriers et ardents, dont l'apothéose et le déclin ont été aussi rapides que brefs […],"
                                            },
                                            {
                                                "example_id": "c02df0a2-5951-4f92-a56d-eb95023df8aa",
                                                "sense_id": "3903988a-6026-375a-a6c8-a3529835a57b",
                                                "text": "La fameuse question de l’existence de Dieu : l’apologétique était une antique sottise qui n’engendrait que niaiseries."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3b57ca4-f800-4ac4-b8c3-ea4e1bb68257",
                        "source_entry_id": "76eb373e-ef73-30aa-b814-406a4ac1e14c",
                        "source_sense_id": "1a7496c6-b1ef-3e32-829f-a5ee0aa938c1",
                        "source_sense_description": "Verteidigung, Rechtfertigung einer Weltanschauung",
                        "target_lang_word": "apologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c833f8f0-1f6b-3b7a-84fe-fff7a945c069",
                                        "entry_id": "8fb6163f-f561-375a-a1fe-434516423793",
                                        "glosses": [
                                            "Paroles ou écrits destinés à justifier ou à défendre quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852bb901-d0c0-4f9d-a625-90a69ecc4467",
                                                "sense_id": "c833f8f0-1f6b-3b7a-84fe-fff7a945c069",
                                                "text": "Mme Surville n’a laissé sur son frère que quelques pages insignifiantes, une apologie froide, banale, où nous n'avons pas une seule note à prendre, pas un seul document à retenir."
                                            },
                                            {
                                                "example_id": "187747da-2b20-4fb8-b31b-25d6834c9fa4",
                                                "sense_id": "c833f8f0-1f6b-3b7a-84fe-fff7a945c069",
                                                "text": "Quelques jours plus tard, en réponse à une longue apologie du célibat et de la chasteté due à la plume de notre « Sphinx ariégeois » de plus en plus dégoûté de la vie, je répliquais :\n Toute femme est faite pour rivancher comme dit l'argot des barrières, et ensuite pour reproduire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
