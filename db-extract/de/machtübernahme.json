                ],
                "senses": [
                    {
                        "sense_id": "1bc6ad7a-2138-3a65-b35c-528a09c4f3f9",
                        "entry_id": "bdb3da79-3458-3c1a-a17c-58c2801e0471",
                        "glosses": [
                            "Übernahme einer Position, die es ermöglicht, in einem bestimmten Bereich Macht auszuüben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da0afad8-9615-4210-a426-ca3a9e9f9b39",
                                "sense_id": "1bc6ad7a-2138-3a65-b35c-528a09c4f3f9",
                                "text": "„Bereits in den ersten Tagen nach der Machtübernahme inhaftierten die neuen Machthaber unter Mithilfe österreichischer Anhänger rund 72.000 Menschen, insbesondere in Wien.“"
                            },
                            {
                                "example_id": "ac8ce029-eb8c-49ed-9db7-2f0060793f4b",
                                "sense_id": "1bc6ad7a-2138-3a65-b35c-528a09c4f3f9",
                                "text": "„Die Radikalen dagegen setzten auf eine notfalls gewaltsame Machtübernahme nach dem Beispiel der russischen Bolschewiki.“"
                            },
                            {
                                "example_id": "cc0a9837-a348-4302-81e0-1d4d9a7e09fd",
                                "sense_id": "1bc6ad7a-2138-3a65-b35c-528a09c4f3f9",
                                "text": "„Dass seine Arbeit bis heute als grundlegend gelten darf, zeigt die Haltbarkeit seiner Forschungen, die in der Neuauflage mit zwei neuen Unterkapiteln ergänzt wurden, und die weit über die Mechanismen der Machtübernahme hinaus reichen: Was sich in Österreich ereignete, trug zu einer Radikalisierung bei, die Terror und Unterdrückung forcierte und geradewegs in den Krieg mündete.“"
                            },
                            {
                                "example_id": "f22ae36a-5ba7-4fa0-95a5-b256ff0dad14",
                                "sense_id": "1bc6ad7a-2138-3a65-b35c-528a09c4f3f9",
                                "text": "„Am Abend des 30. Januar fand sich der junge Loewe in einem Bahnhofswartesaal in Frankfurt an der Oder wieder und hörte Hitlers Ansprache zum zwölften Jahrestag der Machtübernahme.“"
                            },
                            {
                                "example_id": "84e4f5db-64ab-4929-8052-7c31cd1199d4",
                                "sense_id": "1bc6ad7a-2138-3a65-b35c-528a09c4f3f9",
                                "text": "„Dies schürte die Angst vor einer Machtübernahme durch die Schwarzen, zumal viele Weiße aus dem Kongo in die Föderation geflüchtet waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
