                    {
                        "sense_id": "a6be6aa3-e5b3-30ae-9d5e-90f14f27ab34",
                        "entry_id": "83ce4ff9-d027-3182-888e-d45cc54e6c4e",
                        "glosses": [
                            "Procédé de la cabale juive, qui consiste à former des mots avec les initiales d’une phrase, ou à former des phrases avec des mots auxquels on donne pour initiale chacune les lettres d’un certain mot."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "98011700-d040-4b04-97f4-0950fde38dc0",
                                "sense_id": "a6be6aa3-e5b3-30ae-9d5e-90f14f27ab34",
                                "text": "Le critique Iulian Toma cite en particulier le notaricon, procédé par lequel on extrait d’un seul mot une phrase entière et le système de permutations de la thémoura."
                            }
                        ]
                    }
                ],
                "translations": [
