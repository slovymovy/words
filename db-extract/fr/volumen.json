                                        "sense_id": "e82c4d39-0c21-3a0f-957e-d24e82ea569c",
                                        "entry_id": "f5b70b2e-8285-3939-b7bd-61385a8cf2e5",
                                        "glosses": [
                                            "To draft; to write in rough outline."
