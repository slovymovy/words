                    "frequency": "High",
                    "semantic_group_id": "ereignis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bei dem schweren Bergunglück spielte sich vor den Augen der Retter ein furchtbares <w>Drama</w> ab."
