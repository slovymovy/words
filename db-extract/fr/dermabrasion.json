                "senses": [
                    {
                        "sense_id": "2e626fab-0821-3885-8a80-3ca650c2151b",
                        "entry_id": "bfad1975-4e0a-354e-af16-98a2748795db",
                        "glosses": [
                            "Abrasion de la peau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a47bc991-00b2-478f-9c4d-1834425c9463",
                                "sense_id": "2e626fab-0821-3885-8a80-3ca650c2151b",
                                "text": "Souffrant d’une fracture ouverte d’un tibia et de multiples dermabrasions, le trottinettiste a été secouru par les sapeurs-pompiers et une équipe du Samu 38 avant d’être conduit au CHU Grenoble-Alpes."
                            }
                        ]
                    },
                    {
                        "sense_id": "33996a7f-0623-31a2-acd4-c3512bf1c857",
                        "entry_id": "bfad1975-4e0a-354e-af16-98a2748795db",
                        "glosses": [
                            "Intervention chirurgicale retirant une couche de la peau dans un but thérapeutique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "031a96c1-c10b-43ca-85dc-bdd3d35209be",
                                "sense_id": "33996a7f-0623-31a2-acd4-c3512bf1c857",
                                "text": "Précédant souvent des interventions esthétiques plus radicales sur les signes de vieillissement cutané (dermabrasion, lifting, resurfacing), des matériaux de comblement, toujours plus nombreux, sont très fréquemment injectés en vue d’obtenir atténuation ou effacement des rides et dépressions ou remodelage de certaines parties du visage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9eb4fa52-9eda-4ac7-8bfa-e1963d28e3ad",
                        "source_entry_id": "bfad1975-4e0a-354e-af16-98a2748795db",
                        "source_sense_description": "Intervention chirurgicale",
                        "target_lang_word": "Dermabrasion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dermabrasion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bca61b0-0942-37bb-83b7-eef47c9e3f4e",
                                        "entry_id": "83286086-f7a5-3de4-82ee-484bf3354bb8",
                                        "glosses": [
                                            "Abschleifen der obersten Hautschichten zu therapeutischen oder kosmetischen Zwecken, meist um Narben zu entfernen"
                                        ],
                                        "tags": [
                                            "Kosmetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36008ed1-b347-48f2-a836-b103e34de9fc",
                                                "sense_id": "4bca61b0-0942-37bb-83b7-eef47c9e3f4e",
                                                "text": "„Paul mit seinem Riesennävus, befand der Professor damals, brauche umgehend eine Dermabrasion. Dabei wird die schwarze Haut mittels eines rotierenden Schleifsteins großflächig abgeschliffen. Das Verfahren wurde vor Jahrzehnten von Dermatologen in Kassel perfektioniert und galt lange Zeit in Deutschland als Mittel der Wahl bei der Nävusbehandlung. Dermabrasion wird oft als Technik benutzt, um Tattoos zu entfernen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
