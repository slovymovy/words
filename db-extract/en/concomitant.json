                        "form": "concomitants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47f2e285-7156-38c9-bc1f-c16a94d7fdcc",
                        "entry_id": "c2239306-29cf-3cb9-b0e0-02be584c4268",
                        "glosses": [
                            "Something happening or existing at the same time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b960bea-9512-40ea-844f-c104dec37588",
                                "sense_id": "47f2e285-7156-38c9-bc1f-c16a94d7fdcc",
                                "text": "The reflection, that but the next day was to transport her far from London, had, in chasing distrust, with its natural concomitants, restraint and reserve, given a sweet and placid composure to her demeanour."
                            },
                            {
                                "example_id": "b53ee29e-81cb-491f-86a4-b5e0dc20f8c3",
                                "sense_id": "47f2e285-7156-38c9-bc1f-c16a94d7fdcc",
                                "text": "It is also instructive to consider the relation of these dreams to anxiety dreams. In the dreams we have been discussing, a repressed wish has found a means of evading censorship—and the distortion which censorship involves. The invariable concomitant is that painful feelings are experienced in the dream."
                            },
                            {
                                "example_id": "dca6686b-1dca-41a7-988e-e5fb02d4384b",
                                "sense_id": "47f2e285-7156-38c9-bc1f-c16a94d7fdcc",
                                "text": "A major concomitant of the advent of diesel traction has been a vast increase in the amount of electrical equipment needing overhaul."
                            },
                            {
                                "example_id": "4ff2a37b-b46a-4fb8-9c74-0324f7ca44ec",
                                "sense_id": "47f2e285-7156-38c9-bc1f-c16a94d7fdcc",
                                "text": "The declining commitment to place is thus related not to mobility per se, but to a concomitant of mobility- the shorter duration of place relationships."
                            }
                        ]
                    },
                    {
                        "sense_id": "14d14abf-7610-3f7d-95d8-422f801a01f0",
                        "entry_id": "c2239306-29cf-3cb9-b0e0-02be584c4268",
                        "glosses": [
                            "An invariant homogeneous polynomial in the coefficients of a form, a covariant variable, and a contravariant variable."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2839d061-b9e1-4d40-aded-58f54dfebcd9",
                        "source_entry_id": "c2239306-29cf-3cb9-b0e0-02be584c4268",
                        "source_sense_description": "Something happening or existing at the same time",
                        "target_lang_word": "Begleiterscheinung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begleiterscheinung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "460813fd-23d2-3ef9-923e-32765ac3459b",
                                        "entry_id": "220a951f-e53e-383c-9d81-ffd3a9687d84",
                                        "glosses": [
                                            "Phänomen, das sich bei einem Vorgang/einer Handlung zusätzlich einstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d6294a-66a2-4767-a57c-2e4255b0767c",
                                                "sense_id": "460813fd-23d2-3ef9-923e-32765ac3459b",
                                                "text": "„Die Eigner des Schiffes betrachteten die Todesfälle und die Tatsache, dass das Leben so vieler Menschen zerstört wurde, als normale Begleiterscheinung eines zugegebenermaßen schmutzigen Geschäfts.“"
                                            },
                                            {
                                                "example_id": "fa13be83-df32-4500-8cf1-f08251ed282c",
                                                "sense_id": "460813fd-23d2-3ef9-923e-32765ac3459b",
                                                "text": "„Übergewicht und Fettleibigkeit wurden zu unübersehbaren Begleiterscheinungen moderner Wohlstandsgesellschaften.“"
                                            },
                                            {
                                                "example_id": "c663833d-b378-4241-ab3d-249bb479dfec",
                                                "sense_id": "460813fd-23d2-3ef9-923e-32765ac3459b",
                                                "text": "„Dieser sein Eintritt ins Regiment fiel so ziemlich mit dem Regierungsantritt Friedrich Wilhelms IV. zusammen, und wenn er dessen erwähnte, so hob er, sich selbst persiflierend, gerne hervor, ‚daß alles Große seine Begleiterscheinungen habe‘.“"
                                            },
                                            {
                                                "example_id": "a8363fb4-bf10-49cb-b78f-3cf744f8a1f7",
                                                "sense_id": "460813fd-23d2-3ef9-923e-32765ac3459b",
                                                "text": "„Der Sprechdurchfall kann dann auch beispielsweise eine Begleiterscheinung von ADHS oder ein Hinweis auf eine bipolare Störung sein.“"
                                            },
                                            {
                                                "example_id": "70a8b981-3caf-4b88-bd00-36b445996035",
                                                "sense_id": "460813fd-23d2-3ef9-923e-32765ac3459b",
                                                "text": "„Schnakenbisse sind eine unangenehme Begleiterscheinung des Sommers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
