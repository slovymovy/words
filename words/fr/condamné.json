                    "sense_definition": "Participe passé masculin singulier de <w>condamner</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a <w>condamné</w> le voleur à deux ans de prison ferme."
                        },
                        {
                            "text": "Le gouvernement a fermement <w>condamné</w> les violences survenues pendant la manifestation."
                        }
                    ]
