                "translations": [
                    {
                        "translation_id": "c4355ed5-11c0-4da2-8e17-652e326b06ea",
                        "source_entry_id": "1238affb-9658-304d-b8fe-ff5bd643a3ec",
                        "target_lang_word": "English",
