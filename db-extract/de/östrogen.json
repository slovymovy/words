                "senses": [
                    {
                        "sense_id": "11f1d015-644c-371f-a263-71fbc251466e",
                        "entry_id": "4db99a13-49ad-3afb-9297-41f9248cbba8",
                        "glosses": [
                            "Hormon, das für die weiblichen Eigenschaften einer Person verantwortlich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4146d9d4-fd56-4cfb-86ff-a59c48e2ef46",
                                "sense_id": "11f1d015-644c-371f-a263-71fbc251466e",
                                "text": "„Das Östrogen stimuliert das Wachstum der Brüste.“"
                            },
                            {
                                "example_id": "d5eaa37f-f48b-40ca-ae57-e27b52fdb165",
                                "sense_id": "11f1d015-644c-371f-a263-71fbc251466e",
                                "text": "„Das Östrogen bewirkt das Haarwachstum unter den Achseln und die Verbreiterung des Beckens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89bfdb06-5747-4233-9d0e-5c996d5759aa",
                        "source_entry_id": "4db99a13-49ad-3afb-9297-41f9248cbba8",
