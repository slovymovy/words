                                        "examples": [
                                            {
                                                "example_id": "6e9ee8fb-6255-4d52-9076-ea4146eb451d",
                                                "sense_id": "25758c8b-badc-3d38-9f77-9d058f37dab0",
                                                "text": "Râper le cheddar, réserver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0f09df7-8ced-31cb-952b-c7f3375ac116",
                                        "entry_id": "c72691a7-68d0-3567-9f84-bd1af472c931",
                                        "glosses": [
                                            "User la surface d’un corps avec l’espèce de lime appelée râpe, pour dégrossir cette surface, pour lui donner la forme qu’on veut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecc35015-142b-4aca-8c78-4c920395dd25",
                                                "sense_id": "f0f09df7-8ced-31cb-952b-c7f3375ac116",
                                                "text": "Râper un morceau de bois avant de le polir."
                                            },
                                            {
                                                "example_id": "db63d5d5-6657-4e39-94a6-30566591ee42",
                                                "sense_id": "f0f09df7-8ced-31cb-952b-c7f3375ac116",
                                                "text": "[…] et, après que l’on s’est râpé le dos sur le peigne à carder d’invraisemblables lits, il faut encore, dès l’aube, commencer de folles ascensions, à pied ou à dos de mulets […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beabe9e1-4be6-32e7-8259-2e885004b8d5",
                                        "entry_id": "c72691a7-68d0-3567-9f84-bd1af472c931",
                                        "glosses": [
                                            "Donner une sensation d’âpreté."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1aa1c009-914d-47ce-8f43-fec9374b1a6a",
                                                "sense_id": "beabe9e1-4be6-32e7-8259-2e885004b8d5",
                                                "text": "On but à larges goulées le vin rude qui vous râpait la gorge et chantait aux tempes ; à grandes bâfrées, on s’empiffra de viandes. Oui, jamais ne fut plus joyeux réveillon."
                                            }
                                        ]
                                    }
                                ]
