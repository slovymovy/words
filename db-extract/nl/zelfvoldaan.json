                ],
                "senses": [
                    {
                        "sense_id": "984a714b-38d6-3232-9964-18c5fc2f759e",
                        "entry_id": "e4ea28ef-ef95-3657-96b8-1556ebb8ff49",
                        "glosses": [
                            "wel heel erg tevreden zijn over jezelf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d3df3af-8ab3-4940-a192-9a0ec5bbbdc6",
                                "sense_id": "984a714b-38d6-3232-9964-18c5fc2f759e",
                                "text": "Met de EU gaat het de goede kant op, maar we moeten „extreem voorzichtig” zijn met optimisme en niet zelfvoldaan zijn, zei Tusk. Hij wees op de economische groei in alle lidstaten, de lagere werkloosheid en de financiële deal met Griekenland. Ook bejubelde hij de verkiezingsnederlaag van anti-Europese partijen en overwinningen van leiders die „100 procent pro-EU” zijn."
                            },
                            {
                                "example_id": "a7eca3a5-da96-49e2-9eea-3f11b0d59c4d",
                                "sense_id": "984a714b-38d6-3232-9964-18c5fc2f759e",
                                "text": "Kiezers zijn kortom niet gek. In Europa staan de dominosteentjes inmiddels opgelijnd: referendum in Italië en verkiezingen in Oostenrijk in december en volgend jaar verkiezingen in Frankrijk, Duitsland en Nederland. Hoog tijd dat de zelfvoldane politieke orde met een beter verhaal komt. Anders zet de opmars van de ’clowns’ onvermijdelijk door. Met alle niet-grappige gevolgen van dien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bb6e8b2-dea5-4148-b11e-c8e5916e491d",
                        "source_entry_id": "e4ea28ef-ef95-3657-96b8-1556ebb8ff49",
                        "source_sense_id": "984a714b-38d6-3232-9964-18c5fc2f759e",
                        "target_lang_word": "selbstgefällig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selbstgefällig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f4b0a5b-85a8-3b7b-88ac-daace293e446",
                                        "entry_id": "406d4e70-682f-3a4b-bac9-6d807fb98fb9",
                                        "glosses": [
                                            "sich selber sehr wichtig nehmend, oft damit verbunden, die eigenen Vorzüge deutlich und auf überhebliche Art zu betonen und dabei Verdienste anderer zu ignorieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e99fa71-bf4a-436a-9f92-f35400acb938",
                                                "sense_id": "6f4b0a5b-85a8-3b7b-88ac-daace293e446",
                                                "text": "„Er breitete seine Arme aus wie dereinst Jesus bei der Speisung der Armen und setzte sich dann mit einem selbstgefälligen Lächeln und über der Bauchwölbung gefalteten Händen wieder auf seinen Stuhl.“"
                                            },
                                            {
                                                "example_id": "6747f02e-dce9-4fdc-b8a6-9020838c4fcb",
                                                "sense_id": "6f4b0a5b-85a8-3b7b-88ac-daace293e446",
                                                "text": "„Der Gehweg wimmelte von Leuten – wie immer –, aber sie bewegten sich langsam, und die Leute in Washington – die selbstgefälligsten Menschen der Welt – hasteten an ihnen vorbei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
