                        "sense_id": "aa1bdb2e-c42f-312e-ab91-667348d0d24e",
                        "entry_id": "770cf9ce-406a-397a-af46-b05f2f2ba7d6",
                        "glosses": [
                            "hoed met brede zijkanten zodat het gezicht van de draagster tegen de zon (en mannelijke gluurders) werd beschermd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70232142-2dc5-410c-a156-a2905b7458a7",
                                "sense_id": "aa1bdb2e-c42f-312e-ab91-667348d0d24e",
                                "text": "Tussen de elegante dames in hun bonten pelisses, hun hoeden met wuivende veren, of met juwelen bezette tulbands, zitten twee jonge meisjes in eenvoudige donkere jurken en kleine luifelhoeden."
                            },
                            {
                                "example_id": "df8f749b-f326-42e2-8fe7-5efb2291a390",
                                "sense_id": "aa1bdb2e-c42f-312e-ab91-667348d0d24e",
                                "text": "Haar kleine gezicht is bleek en vermoeid binnen de grote luifelhoed; zij heeft zich stellig voorgenomen om niet naar binnen te kijken, maar haar arme jaloerse hart kan de verzoeking niet weerstaan."
                            }
                        ]
                    }
