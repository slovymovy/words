                                                "example_id": "77882977-aae1-4965-8e6f-590eb9906f55",
                                                "sense_id": "c297f3d0-e7dc-36c7-ae29-8617fa9ff332",
                                                "text": "aids-de-camp and orderly men"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
