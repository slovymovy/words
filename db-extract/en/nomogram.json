    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0f2707aa-a056-3a6c-9ea2-b5f2971ac0cd",
                "word": "nomogram",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "120391aa-0399-4128-8670-3d793343bb2a",
                        "entry_id": "0f2707aa-a056-3a6c-9ea2-b5f2971ac0cd",
                        "tags": [
                            "plural"
                        ],
                        "form": "nomograms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93ec27c5-b53a-334b-a41d-188774dad44b",
                        "entry_id": "0f2707aa-a056-3a6c-9ea2-b5f2971ac0cd",
                        "glosses": [
                            "A diagram in which the relationship between three variables is represented by a straight line or curve for each variable; the value of the third variable corresponding to particular values of the first two is obtained by drawing a straight line through the points on the first two curves that represent particular values of the first two variables and noting the point at which the line intersects the third line or curve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "476604d5-a195-44bb-bcf9-d90d7f2d467a",
                                "sense_id": "93ec27c5-b53a-334b-a41d-188774dad44b",
                                "text": "Cravalho et al. compared the agreement in obstruction measurements by the AG nomogram, passive urethral resistance relation (PURR), and the micturitional urethral pressure profile (MUPP) [20 ]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08551589-d1ef-4490-9bc9-b3ff1bb9dfa9",
                        "source_entry_id": "0f2707aa-a056-3a6c-9ea2-b5f2971ac0cd",
                        "source_sense_id": "93ec27c5-b53a-334b-a41d-188774dad44b",
                        "source_sense_description": "diagram in which the relationship between three variables is represented",
                        "target_lang_word": "nomogramme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nomogramme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5ef1f6f-2cac-3730-acc6-6038ea67c555",
                                        "entry_id": "d60c4f0e-fa44-35a9-9144-11f53699f896",
                                        "glosses": [
                                            "Outil graphique de calcul constitué de courbes graduées entre lesquelles on place une règle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1158a203-161f-4745-b58e-e122383535a6",
                                                "sense_id": "a5ef1f6f-2cac-3730-acc6-6038ea67c555",
                                                "text": "En 1891, d’Ocagne a donné le nom de « nomogramme » à tout graphique susceptible de servir ainsi au calcul, et il en a conçu beaucoup."
                                            },
                                            {
                                                "example_id": "9cd6f8bf-65bf-4bab-8872-0dee1b259672",
                                                "sense_id": "a5ef1f6f-2cac-3730-acc6-6038ea67c555",
                                                "text": "Aujourd’hui, ces transformations servent, par exemple, en électronique, pour construire tout sorte d’abaques et de nomogrammes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49977852-bfad-45b0-a54c-ddfe457a69d7",
                        "source_entry_id": "0f2707aa-a056-3a6c-9ea2-b5f2971ac0cd",
                        "source_sense_id": "93ec27c5-b53a-334b-a41d-188774dad44b",
                        "source_sense_description": "diagram in which the relationship between three variables is represented",
                        "target_lang_word": "abaque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abaque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "142eaa35-4651-3e8d-be10-aafe5378c395",
                                        "entry_id": "91ce34fe-21d7-3801-b5a3-e0e472a692ae",
                                        "glosses": [
                                            "Compteur à boules chinois pour le calcul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8affe80c-c9a7-4a5d-afc7-b04a9fc75726",
                                                "sense_id": "142eaa35-4651-3e8d-be10-aafe5378c395",
                                                "text": "Les nombres écrits sur le papier reproduisent alors les colonnes de l’abaque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20705f91-0582-38e3-a51f-30038d93a19c",
                                        "entry_id": "91ce34fe-21d7-3801-b5a3-e0e472a692ae",
                                        "glosses": [
                                            "Tailloir, partie supérieure d'un chapiteau de colonne sur laquelle porte l’architrave."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e939b96-3efa-3c73-b1c4-7216dba5e5b2",
                                        "entry_id": "91ce34fe-21d7-3801-b5a3-e0e472a692ae",
                                        "glosses": [
                                            "Tableau couvert de sable fin, sur lequel on traçait des nombres pour enseigner le calcul ou la géométrie."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31ce085d-b219-3762-ae74-57a4b75a9522",
                                        "entry_id": "91ce34fe-21d7-3801-b5a3-e0e472a692ae",
                                        "glosses": [
                                            "Diagramme ou graphique qui donne, par simple lecture, la solution approchée d’un problème numérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9466c79b-04e8-46ed-94f3-99e4c284e5bd",
                                                "sense_id": "31ce085d-b219-3762-ae74-57a4b75a9522",
                                                "text": "Par extension on nomma aussi abaques diverses tables de calcul, dont la plus célèbre est celle de Pythagore."
                                            },
                                            {
                                                "example_id": "b0f8c2dc-9356-4b21-a25f-7a8f095cba2d",
                                                "sense_id": "31ce085d-b219-3762-ae74-57a4b75a9522",
                                                "text": "L’abaque figuré ici comprend toutes les valeurs utiles pour n et D ; mais on a limité le graphique aux cotes comprises entre 100 et 200 millimètres pour T et F, valeurs d’ailleurs très usuelles ; […]."
                                            },
                                            {
                                                "example_id": "2128a4aa-291c-41a9-aea4-9c59ec37d7a6",
                                                "sense_id": "31ce085d-b219-3762-ae74-57a4b75a9522",
                                                "text": "On peut déterminer la température résultante en degrés Missenard (°M) à l'aide de l’abaque, figure 6.02.a (Tome I)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "377f5ca7-c4c9-3fd6-b490-39e4117decef",
                                        "entry_id": "91ce34fe-21d7-3801-b5a3-e0e472a692ae",
                                        "glosses": [
                                            "En logique, tableau servant à tirer les conséquences logiques de prémisses données."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "08dee2a7-7154-3b79-a116-7714212ce3fb",
                                        "entry_id": "91ce34fe-21d7-3801-b5a3-e0e472a692ae",
                                        "glosses": [
                                            "Table de jeu divisée en compartiments et se rapprochant de nos damiers, de nos échiquiers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
