                    },
                    {
                        "form_id": "9ef143f2-6c9e-4a7a-8df3-81240546f661",
                        "entry_id": "f84abb16-9c01-3943-8bea-88412f847021",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "génitales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13a2cf81-88f6-35cc-b65f-5c981cb83d22",
                        "entry_id": "f84abb16-9c01-3943-8bea-88412f847021",
                        "glosses": [
                            "Qui sert à la génération, à la reproduction biologique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1988146-8f23-4235-8f9b-6d4824d0bf5c",
                                "sense_id": "13a2cf81-88f6-35cc-b65f-5c981cb83d22",
                                "text": "La glande génitale est située dans le cœlome, et sans continuité avec les conduits génitaux ; une partie de la couronne pédieuse péribuccale est hectocotylisée, c'est-à-dire modifiée en organe d'accouplement, chez le mâle."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba820241-87bc-3869-813f-f7e47b3f46fc",
                        "entry_id": "f84abb16-9c01-3943-8bea-88412f847021",
                        "glosses": [
                            "Relatif aux organes de reproduction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "410a4a4e-a224-4e6c-8992-47f001c41ce1",
                                "sense_id": "ba820241-87bc-3869-813f-f7e47b3f46fc",
                                "text": "Nous avions à résoudre un double problème urinaire, un problème génital et un pariétal."
                            },
                            {
                                "example_id": "85cec2cf-b07c-4e47-a96c-1ecb25d3e476",
                                "sense_id": "ba820241-87bc-3869-813f-f7e47b3f46fc",
                                "text": "Les douleurs génitales ne trouvent pas toujours leur origine dans une atteinte viscérale de l’appareil reproducteur et il n’est pas rare d’être confronté à des algies pelviennes liées à une irritation nerveuse, parfois relativement éloignée de la zone douloureuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "411e6ecf-4df3-4dfd-befe-12583773c397",
                        "source_entry_id": "f84abb16-9c01-3943-8bea-88412f847021",
                        "source_sense_description": "qui sert à la génération",
                        "target_lang_word": "genital",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genital",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01830608-9fdb-3192-aded-a4227d24ae14",
                                        "entry_id": "198817c5-d669-3284-af95-18814c763c6b",
                                        "glosses": [
                                            "Of or relating to biological reproduction."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4c5b2e42-1d49-3666-8e21-cb6559d95c70",
                                        "entry_id": "198817c5-d669-3284-af95-18814c763c6b",
                                        "glosses": [
                                            "Of or relating to the genitalia."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f149922-001c-401e-953d-cceb50ea19c1",
                                                "sense_id": "4c5b2e42-1d49-3666-8e21-cb6559d95c70",
                                                "text": "In countless Hollywood movies we see the story of two soldiers or sailors on leave; for them the pursuit of women is simply a way of relieving a genital pressure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34dd4904-1844-3032-9fa7-77cb10bfcd22",
                                        "entry_id": "198817c5-d669-3284-af95-18814c763c6b",
                                        "glosses": [
                                            "Of or relating to psychosexual development during puberty."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "genital",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c124f6f8-a0eb-3635-8bfa-a52f48e3991e",
                                        "entry_id": "d849191d-783a-34ed-8b1f-8bc1be4d4bd7",
                                        "glosses": [
                                            "A genital organ."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c908204-e3c7-489a-9de3-c372f6268f2e",
                                                "sense_id": "c124f6f8-a0eb-3635-8bfa-a52f48e3991e",
                                                "text": "( b ) the masturbation [...] served as evidence that his genital was not injured (\"fixing feet\")"
                                            },
                                            {
                                                "example_id": "35226421-85d8-474c-94b9-cab607d74edc",
                                                "sense_id": "c124f6f8-a0eb-3635-8bfa-a52f48e3991e",
                                                "text": "David told of his fears of castration and his concern that his genital was not as large as another boy's on the ward, and perhaps would never be."
                                            },
                                            {
                                                "example_id": "e26206d5-f7e2-43d1-82c6-e4f0257ad79f",
                                                "sense_id": "c124f6f8-a0eb-3635-8bfa-a52f48e3991e",
                                                "text": "[…] the anxiety and distress that his genital was dirty, disgusting and dangerous to his mother (myself); the dread of the bad internalized penis and his own faeces and urine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
