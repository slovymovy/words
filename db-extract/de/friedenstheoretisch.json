                    {
                        "form_id": "58238233-d5f6-4a55-a27d-47bfaf277f8e",
                        "entry_id": "7f2265c7-c736-3a2a-88a6-b339505a7750",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind friedenstheoretisch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8479ab6d-d66b-3d34-a65d-e46e2043ace0",
                        "entry_id": "7f2265c7-c736-3a2a-88a6-b339505a7750",
                        "glosses": [
                            "in Bezug auf die Erforschung der Bedingungen und Grundlagen für dauerhaften Frieden zwischen Staaten, Völkern und Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "956ca089-e29f-4887-b317-6ffbcde517de",
                                "sense_id": "8479ab6d-d66b-3d34-a65d-e46e2043ace0",
                                "text": "„Unter friedenstheoretischen Gesichtspunkten ist es eine offene Frage, ob Frieden erst herrscht, wenn Gerechtigkeit herrscht.“"
                            },
                            {
                                "example_id": "26d51ac1-0d80-4e2a-a638-7ec9eba8c27d",
                                "sense_id": "8479ab6d-d66b-3d34-a65d-e46e2043ace0",
                                "text": "„Unter friedenstheoretischen Gesichtspunkten kommt dieser europäischen Friedenszone eine geradezu paradigmatische Bedeutung zu.“"
                            },
                            {
                                "example_id": "12e73790-d5e1-4b6a-a7e4-c72cbfd474aa",
                                "sense_id": "8479ab6d-d66b-3d34-a65d-e46e2043ace0",
                                "text": "„Wegen ihres rechtsmoralischen Charakters haben die friedenstheoretischen Prinzipien vor anderen politischen Erwägungen einen absoluten Vorrang.“"
                            },
