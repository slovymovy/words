                ],
                "senses": [
                    {
                        "sense_id": "68a2c997-e00f-3638-8c0a-8248914f2fdf",
                        "entry_id": "51ae4113-88b4-3416-8a05-eed96350fb36",
                        "glosses": [
                            "To invent a plausible but fanciful historical origin for something in order to rationalize mythology and legends."
                        ],
                        "tags": [
                            "ambitransitive",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "13be6b7d-24b3-4642-bc0a-d43dc3ec9d88",
                                "sense_id": "68a2c997-e00f-3638-8c0a-8248914f2fdf",
                                "text": "The legend of Semiramis was a euhemerised version of the story of Istar."
                            },
                            {
                                "example_id": "518c3c23-4e41-4e98-86d1-45280ca4297e",
                                "sense_id": "68a2c997-e00f-3638-8c0a-8248914f2fdf",
                                "text": "Confucian scholars frequently euhemerized the myths used to explain religious rituals to the public."
                            },
                            {
                                "example_id": "af903ede-63ce-4746-893e-3b804d6bb087",
                                "sense_id": "68a2c997-e00f-3638-8c0a-8248914f2fdf",
                                "text": "He did but extend to the New Testament the Euhemerising principles which Eichhorn had applied to the Old."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d2e38e5-755a-393d-b6fa-cc6dbde3b7e2",
                        "entry_id": "51ae4113-88b4-3416-8a05-eed96350fb36",
                        "glosses": [
                            "Synonym of deify: to actually create mythology and legends from ancient historical figures and events."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1dd049f3-6414-402b-9e4b-8908fa7352a5",
                                "sense_id": "2d2e38e5-755a-393d-b6fa-cc6dbde3b7e2",
                                "text": "The Yellow Emperor was perhaps euhemerized from a prehistoric tribal leader."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88521fde-57ac-4b13-bdc6-2460d14d11e2",
                        "source_entry_id": "51ae4113-88b4-3416-8a05-eed96350fb36",
                        "source_sense_description": "to explain or interpret something through euhemerism",
                        "target_lang_word": "évhémériser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évhémériser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36d10c71-5b99-3657-ae16-e78d190732d3",
                                        "entry_id": "998ae328-6ee6-363d-b39f-feb37dbb9cdd",
                                        "glosses": [
                                            "Interpréter (un récit religieux) comme provenant de personnages et d’évènements historiques."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a3887cd-505f-446f-b725-1ce03ff5a517",
                                                "sense_id": "36d10c71-5b99-3657-ae16-e78d190732d3",
                                                "text": "Mais évhémériser l’Ancien Testament, considérer la mythologie comme le reflet abîmé de la Révélation mosaïque, mène à une impasse."
                                            },
                                            {
                                                "example_id": "d87ed809-3fee-4537-97fa-4b59d54fc73c",
                                                "sense_id": "36d10c71-5b99-3657-ae16-e78d190732d3",
                                                "text": "Eric Shanower (qui a retiré tout surnaturel du récit) a du mal à \"évhémériser\" ce combat très mythique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dc622de-455a-3587-abc7-00fedf5ad46a",
                                        "entry_id": "998ae328-6ee6-363d-b39f-feb37dbb9cdd",
                                        "glosses": [
                                            "Étudier le phénomène par lequel un fait historique est devenu un mythe collectif dans une société donnée."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
