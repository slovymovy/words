        "ru-extract.jsonl": [
            {
                "entry_id": "29d93024-a840-3bb4-9d4d-551e162be103",
                "word": "эвакуированный",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3b79666e-387d-3564-a31b-51a9bd73e518",
                        "entry_id": "29d93024-a840-3bb4-9d4d-551e162be103",
                        "glosses": [
                            "о населении, учреждении, имуществе, оборудовании и т. п.: вывезенный, удалённый из опасной зоны, местности (в связи с войной или стихийным бедствием)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ec84c89e-9573-3cd7-a628-43708ac80bc1",
                        "entry_id": "29d93024-a840-3bb4-9d4d-551e162be103",
                        "glosses": [
                            "о местности: оставшийся (возникший, образовавшийся) после произведённой эвакуации"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e061bac-1d92-4dcf-a7ec-397d25c75a7c",
                                "sense_id": "ec84c89e-9573-3cd7-a628-43708ac80bc1",
                                "text": "Эвакуированная зона."
                            }
                        ]
                    },
                    {
                        "sense_id": "abccb592-3e10-3d06-afea-2074a63d76ed",
                        "entry_id": "29d93024-a840-3bb4-9d4d-551e162be103",
                        "glosses": [
                            "устар., научн."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d0e64c2-8253-4e12-b3b8-52ee01a42f25",
                                "sense_id": "abccb592-3e10-3d06-afea-2074a63d76ed",
                                "text": "Этот принцип [индукционных печей] позволил фирме Сименс построить печь, представляющую собой эвакуированный стеклянный высеребренный изнутри шар, в центре которого помещался тигель с нагреваемым веществом."
                            },
                            {
                                "example_id": "be83188e-232f-46be-ae8c-34453c0504f5",
                                "sense_id": "abccb592-3e10-3d06-afea-2074a63d76ed",
                                "text": "В 1913 году Шток и Штамм нагреванием в эвакуированной трубке превратили чистый, белый фосфор в красный."
                            }
                        ]
                    }
