                        "glosses": [
                            "kurzer Bericht von einer Reise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f30ca0cf-5f99-45c2-8ad1-4e8722a8d551",
                                "sense_id": "26e42bf1-d7ef-3ad2-b556-b400aad6b106",
                                "text": "„Tagsüber beschäftigte mich größtenteils das Ordnen und Ergänzen meiner Reisenotizen und Aquarellskizzen; und wenn ich des Schreibens, Malens und Lesens müde war, wanderte ich hinüber auf den zweiten Platz, wo eine indische Menagerie von Affen, Papageien, Waldtauben und andren Vögeln uns unerschöpfliche Unterhaltung bot.“"
                            },
                            {
                                "example_id": "6b21189f-3903-4cfd-808d-5a50f24422e7",
                                "sense_id": "26e42bf1-d7ef-3ad2-b556-b400aad6b106",
                                "text": "„Die Reisenotizen sind verschollen, zu einer Veröffentlichung kam es nie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
