                                        "glosses": [
                                            "Excellent, supérieur dans son genre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c35f66b0-e327-4292-9aff-9735d2671348",
                                                "sense_id": "bab8ce0e-a03c-3841-bc63-dc87eb75df5c",
                                                "text": "[…] François se dévoyait auprès des filles publiques, […]. On dit que ces professionnelles ont des charmes secrets, des recettes magiques pour exaspérer la volupté de leurs clients et leur procurer des extases sans pareilles […]."
                                            },
                                            {
                                                "example_id": "dc34c4b2-7292-461d-a595-226692af21ca",
                                                "sense_id": "bab8ce0e-a03c-3841-bc63-dc87eb75df5c",
                                                "text": "La seule fois que j’en aie goûté, j’en ai pris trois jours de migraine, des vomissements de bile verte, un dévoiement sans pareil."
                                            },
                                            {
                                                "example_id": "b3ae48aa-80b2-45c8-88a9-5e05eb3d2486",
                                                "sense_id": "bab8ce0e-a03c-3841-bc63-dc87eb75df5c",
                                                "text": "C’est un homme d’un sang-froid sans pareil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
