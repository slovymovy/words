                                            "mąka, białe granulki lub płatki skrobiowe otrzymane z manioku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08d34f80-eb40-4be6-8a6b-0d9e9a58a588",
                                                "sense_id": "c40050ec-d868-3d6c-a3b8-816df9eccd4a",
