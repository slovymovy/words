                        "examples": [
                            {
                                "example_id": "8c6c248d-e135-4331-9507-03ca39e76aa4",
                                "sense_id": "9e7d213a-6e24-3a60-8cd4-d394e61af08d",
                                "text": "Un type comme ça, ce n’est pas loin du peuple, enfin pas si loin que tout ça, ça ne devrait pas, en tout cas, si ça avait deux sous d’intelligence, de comprenotte..."
                            },
                            {
                                "example_id": "d4a726b5-49c8-403f-8a29-5d26a14db845",
                                "sense_id": "9e7d213a-6e24-3a60-8cd4-d394e61af08d",
                                "text": "Mettez-vous bien dans la comprenotte que la tante Anselme était tout ce que voudrez excepté une brave femme."
                            },
                            {
                                "example_id": "21573082-0205-4978-a864-873c29b860c6",
                                "sense_id": "9e7d213a-6e24-3a60-8cd4-d394e61af08d",
                                "text": "Née riche, elle n’a jamais seulement pu appréhender du bout de la comprenotte ce que pouvait signifier la détresse d’autrui, le besoin, ou même la simple valeur des êtres et des choses."
                            }
                        ]
                    }
