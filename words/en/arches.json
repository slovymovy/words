                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat <w>arches</w> its back when it feels threatened.",
                            "target_lang_translations": {
                                "ru": "Кошка <w>выгибает</w> спину, когда чувствует угрозу."
                            }
                        },
                        {
                            "text": "A beautiful rainbow <w>arches</w> across the sky after the storm.",
                            "target_lang_translations": {
                                "ru": "Красивая радуга <w>раскинулась дугой</w> по небу после грозы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "arches its back"
                    ],
                    "target_lang_definitions": {
                        "ru": "форма третьего лица единственного числа настоящего времени глагола arch (выгибать дугой, изгибаться)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгибает",
                                "target_lang_sense_clarification": "делает дугообразным"
                            },
                            {
                                "target_lang_word": "изгибается",
                                "target_lang_sense_clarification": "простирается дугой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "bdef6cb3-76cb-310a-8316-6ff5eca5fafe",
                    "sense_definition": "Arches National Park, a national park in Utah",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "We plan to visit <w>Arches</w> during our road trip through Utah.",
                            "target_lang_translations": {
                                "ru": "Мы планируем посетить парк <w>Арчес</w> во время нашей поездки по Юте."
                            }
                        },
                        {
                            "text": "The red rock formations in <w>Arches</w> are famous worldwide.",
                            "target_lang_translations": {
                                "ru": "Красные скальные образования в парке <w>Арчес</w> известны во всем мире."
                            }
