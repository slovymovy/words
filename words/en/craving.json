            "senses": [
                {
                    "sense_id": "593bd77a-7d5c-3899-8eac-8e938fa2c6f8",
                    "sense_definition": "The present participle and gerund of <w>crave</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is <w>craving</w> some peace and quiet after a long week.",
                            "target_lang_translations": {
                                "nl": "Hij is na een lange week <w>snakkend naar</w> wat rust en stilte.",
                                "cs": "Po dlouhém týdnu <w>touží po</w> troše klidu a ticha."
                            }
                        },
                        {
                            "text": "She is <w>craving</w> a change of scenery after living in the city for years.",
                            "target_lang_translations": {
                                "nl": "Ze is <w>verlangend naar</w> een andere omgeving nadat ze jaren in de stad heeft gewoond.",
                                "cs": "Poté, co roky žila ve městě, <w>touží po</w> změně prostředí."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Het onvoltooid deelwoord en gerundium van 'crave' (verlangen naar).",
                        "cs": "Přítomné příčestí a gerundium slovesa 'crave' (toužit po něčem)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "snakkend naar",
