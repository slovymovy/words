                "senses": [
                    {
                        "sense_id": "faf514ec-cd8b-3933-b768-c6a17228f5a6",
                        "entry_id": "904bc544-eb1f-3b13-a6ec-5bfeb893b51f",
                        "glosses": [
                            "Armee von/aus Spanien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe384bd2-2c98-47cb-9940-1b8e4de215c1",
                                "sense_id": "faf514ec-cd8b-3933-b768-c6a17228f5a6",
                                "text": "„Napoleon übertrug Soult den Oberbefehl über die Spanienarmee und befahl Joseph, nach Mortefontaine zu gehen und sich in Paris nicht blicken zu lassen.“"
                            },
                            {
                                "example_id": "58e2ddfc-c9f5-4ee1-bc62-5033bdb1250a",
                                "sense_id": "faf514ec-cd8b-3933-b768-c6a17228f5a6",
                                "text": "„Martius war ein römischer Ritter, der nach dem Tod der Scipio-Brüder den Oberbefehl über die römische Spanienarmee gegen die Karthager übernahm.“"
                            },
                            {
                                "example_id": "33e2a2e4-17ca-4ffe-81b6-b7ecf300a299",
                                "sense_id": "faf514ec-cd8b-3933-b768-c6a17228f5a6",
                                "text": "„Denn die römische Spanienarmee war zu dieser Zeit durch die langen Entbehrungen und Niederlagen völlig demoralisiert.“"
                            },
                            {
                                "example_id": "4542b517-b3cb-49df-a277-7fcc0c5baf3d",
                                "sense_id": "faf514ec-cd8b-3933-b768-c6a17228f5a6",
                                "text": "„Zwar landete Hannibals Bruder Mago mit einem Rest der karthagischen Spanienarmee bei Genua.“"
                            },
                            {
                                "example_id": "c63bd7c9-96d0-49ef-ac54-66b88397581a",
                                "sense_id": "faf514ec-cd8b-3933-b768-c6a17228f5a6",
                                "text": "„Der Vorteil, den er davon habe, bestehe darin, die Spanienarmee vollständig abziehen und nach Italien werfen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
