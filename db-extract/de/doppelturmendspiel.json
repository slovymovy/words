                "senses": [
                    {
                        "sense_id": "42b0a885-8ac9-3bd8-aff3-d1141d29be76",
                        "entry_id": "e3f881cd-634d-30df-af92-c24b6b17a422",
                        "glosses": [
                            "Endphase in einer Partie Schach, in der beide Spieler außer den Königen noch jeweils zwei Türme und eventuell Bauern auf dem Brett haben"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "e3812d87-9a37-4b72-bfee-d5e77fd73a77",
                                "sense_id": "42b0a885-8ac9-3bd8-aff3-d1141d29be76",
                                "text": "„Nach […] würde der König die Partie retten, wenn es sich um ein Doppelturmendspiel handelte.”"
                            },
                            {
                                "example_id": "d567d706-7915-4691-bde8-4cc36ef90cb1",
                                "sense_id": "42b0a885-8ac9-3bd8-aff3-d1141d29be76",
                                "text": "„Nach von beiden Spielern mit viel Unternehmungslust geführtem Kampf kam Kasparow beim Übergang in das Schwerfigurenspiel in klaren Vorteil und führte bald darauf ein leicht gewonnenes Doppelturmendspiel herbei.“ (Quelle: Süddeutsche Zeitung 1996, z. n. Uni Leipzig, Wortschatz-Lexikon)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
