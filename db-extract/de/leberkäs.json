                        "examples": [
                            {
                                "example_id": "f8f7b462-653e-4ba8-bac6-94eaf57d404e",
                                "sense_id": "df984838-81d3-3524-a83b-79a0e1c7277e",
                                "text": "„Die Männer verpflegen sich bei ihrem Arbeitseinsatz selbst. Gestern hatte Helmut Barthold einen Laib warmen Leberkäs, Wecken, Essiggurken und Getränke für alle ausgepackt.“"
                            },
                            {
                                "example_id": "df3569eb-60c2-4082-a7c4-7b50583e14d4",
                                "sense_id": "df984838-81d3-3524-a83b-79a0e1c7277e",
                                "text": "„Auch hatte ich mich für die Reise mit einer Portion Leberkäs versorgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
