                "senses": [
                    {
                        "sense_id": "ea063289-a5a6-3ed5-aa94-07b4af197df2",
                        "entry_id": "130d784b-aa7f-3919-9a3a-f08a7364584f",
                        "glosses": [
                            "Désir ou besoin psychique irrésistible, considéré comme irrationnel, et qui pousse à agir afin de moins se sentir angoissé ou en détresse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9b26ffdf-16bb-3008-b9e5-674c8adf7f1f",
                        "entry_id": "130d784b-aa7f-3919-9a3a-f08a7364584f",
                        "glosses": [
                            "Action de compulser des livres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbdb1174-50e3-40de-954d-330051155a19",
                                "sense_id": "9b26ffdf-16bb-3008-b9e5-674c8adf7f1f",
                                "text": "La compulsion des minutiers notariaux nous apporte donc d'utiles renseignements sur la répartition géographique des terres libres, et permet de mesurer, même de façon très approximative, l'importance des survivances allodiales dans le Bordelais d'Ancien Régime."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e566ce6-0b8f-3407-9d74-1584806d307f",
                        "entry_id": "130d784b-aa7f-3919-9a3a-f08a7364584f",
                        "glosses": [
