                        "glosses": [
                            "Qui porte des frisettes ou des frisottes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e08b9f9-e372-46f3-b244-d1979ae35df3",
                                "sense_id": "f7760a41-fa2f-3c62-8562-6ab549f5d6da",
                                "text": "— Miss Bell, n’est-ce pas cette jeune personne qui a l’air, avec ses cheveux jaunes frisottés, d’un petit chien d’appartement ?"
                            },
                            {
                                "example_id": "2a295f47-24fb-4bfe-a401-cea46943aa07",
                                "sense_id": "f7760a41-fa2f-3c62-8562-6ab549f5d6da",
                                "text": "Une grande fille maigre, masculine, à la tignasse sombre, frisottée, qu’elle ébouriffait encore d’un geste machinal quand il lui fallait se concentrer ou donner un avis."
                            }
                        ]
