                ],
                "senses": [
                    {
                        "sense_id": "eb3a4e39-1c66-3911-9132-fcce4de52d66",
                        "entry_id": "040494ad-8935-3a96-90b9-3b96a4a310a6",
                        "glosses": [
                            "to beat out, to knock out, to dislodge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceb70fb4-5d6b-4c00-a55a-8f524b8d00a4",
                                "sense_id": "eb3a4e39-1c66-3911-9132-fcce4de52d66",
                                "text": "выбива́ть проти́вника / неприя́теля",
                                "translation": "to dislodge the enemy",
                                "english": "to dislodge the enemy"
                            },
                            {
                                "example_id": "7ff2ac15-1a12-4754-b08b-9d991572a00a",
                                "sense_id": "eb3a4e39-1c66-3911-9132-fcce4de52d66",
                                "text": "выбива́ть око́нное стекло́",
                                "translation": "to smash a pane",
                                "english": "to smash a pane"
                            },
                            {
                                "example_id": "cff3e28b-6727-4535-93bf-26c90758fcd8",
                                "sense_id": "eb3a4e39-1c66-3911-9132-fcce4de52d66",
                                "text": "выбива́ть из седла́",
                                "translation": "to unseat, to unhorse, to cut the ground (out) from under, to throw someone from balance",
                                "english": "to unseat, to unhorse, to cut the ground (out) from under, to throw someone from balance"
                            },
                            {
                                "example_id": "b6ac7beb-3000-42e7-9f27-120af9691fac",
                                "sense_id": "eb3a4e39-1c66-3911-9132-fcce4de52d66",
                                "text": "выбива́ть пыль (из чего́-либо)",
                                "translation": "to beat the dust out of something",
                                "english": "to beat the dust out of something"
                            },
                            {
                                "example_id": "2de6bd1c-5505-4237-b6c0-259d5f5343a9",
                                "sense_id": "eb3a4e39-1c66-3911-9132-fcce4de52d66",
                                "text": "выбива́ть меда́ль",
                                "translation": "to strike a medal",
                                "english": "to strike a medal"
                            },
                            {
                                "example_id": "092188b0-81b8-4b2f-b038-9bd5fe954051",
                                "sense_id": "eb3a4e39-1c66-3911-9132-fcce4de52d66",
                                "text": "выбива́ть бараба́нную дробь",
                                "translation": "to beat a tattoo",
                                "english": "to beat a tattoo"
                            },
                            {
                                "example_id": "791f7aca-a177-4869-8d14-bc16acb532ba",
                                "sense_id": "eb3a4e39-1c66-3911-9132-fcce4de52d66",
                                "text": "выбива́ть кого́-либо из колеи́",
                                "translation": "to unsettle someone, to upset someone's routine",
                                "english": "to unsettle someone, to upset someone's routine"
                            },
                            {
                                "example_id": "4bd225d3-032a-4dba-a481-6c8527a3d488",
                                "sense_id": "eb3a4e39-1c66-3911-9132-fcce4de52d66",
                                "text": "выбива́ть дурь из головы́",
                                "translation": "to knock the nonsense out of someone",
                                "english": "to knock the nonsense out of someone"
                            }
                        ]
                    },
