                ],
                "senses": [
                    {
                        "sense_id": "8a2509ad-741b-3f9c-a8cc-09f021865a10",
                        "entry_id": "da953650-4eb4-396b-9840-4100d8d8d6c6",
                        "glosses": [
                            "Celui qui a bénéficié du piston pour accéder à un emploi, à un grade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de811def-75ef-40d8-83c6-2891c1706164",
                                "sense_id": "8a2509ad-741b-3f9c-a8cc-09f021865a10",
                                "text": "L’enseignement secondaire était bouché par des postulantes moins nombreuses que les primaires, mais mille fois plus pistonnées."
                            },
                            {
                                "example_id": "8fe070b5-1f72-4a39-9976-f9b161657bb3",
                                "sense_id": "8a2509ad-741b-3f9c-a8cc-09f021865a10",
                                "text": "Il avait trente ans. Il était pistonné. Il le serait toujours car il faisait le nécessaire ; et il avait épousé une femme qui louchait mais qui l’apparentait aux familles en place."
                            },
                            {
                                "example_id": "a5c13af3-6aaf-49f9-8b59-40adb93e23a8",
                                "sense_id": "8a2509ad-741b-3f9c-a8cc-09f021865a10",
                                "text": "Je n’ai certes pas été le plus grand pistonné de l’histoire des recrutements universitaires mais j’ai bénéficié d’un coup de pouce qui remet en cause toute idée d’égalité des chances entre les candidat(e)s pour le poste que j’ai obtenu."
                            },
                            {
                                "example_id": "c64aae31-d2ff-4af3-a40a-23ac31f03508",
                                "sense_id": "8a2509ad-741b-3f9c-a8cc-09f021865a10",
                                "text": "Les deux zigotos étaient les pistonnés de ce casting et Olivier Kader était le réalisateur en personne de ce spot.\nJean, toujours à genoux, les jambes douloureuses, assistait, impuissant, au trucage odieux de ce casting."
                            },
                            {
                                "example_id": "6c3b719b-a8d7-45eb-9e74-c27784c17ab8",
                                "sense_id": "8a2509ad-741b-3f9c-a8cc-09f021865a10",
                                "text": "Malheureusement, nos ressources ne sont pas illimitées et nous devons satisfaire en priorité les vieilles gloires, les pistonnés, les gens qui filent droit, les homosexuels de plus en plus influents, les suiveurs de la mode littéraire, etc."
                            }
                        ]
                    }
