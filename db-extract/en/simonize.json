                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4aec88da-09d4-4f91-87c5-b2ad51b07db8",
                                "sense_id": "82ccb3dd-ad34-394c-abd5-45d3272ae867",
                                "text": "Remember those days? The way Biff used to simonize that car? The dealer refused to believe there was eighty thousand miles on it."
                            },
                            {
                                "example_id": "8a48068f-ff73-4a86-b359-635ee28b05fa",
                                "sense_id": "82ccb3dd-ad34-394c-abd5-45d3272ae867",
                                "text": "Night after night I had to play rummy with Dr. Lutz, and on Sundays I helped him to watch and simonize his Auburn."
                            }
                        ]
                    }
