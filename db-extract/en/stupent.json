                        "examples": [
                            {
                                "example_id": "c8d9dca6-bdb0-4b49-b447-32b09a11184c",
                                "sense_id": "5baa18ae-7a69-380b-800e-0b18c9ce6320",
                                "text": "He stood there flabbergasted, stupent, as she walked out the door."
                            },
                            {
