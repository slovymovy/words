                        "sense_id": "5f1f8c33-f900-3b2a-98fc-ddff15e6c9fa",
                        "entry_id": "84c0b5dc-de9e-3c91-bbd9-c8f998533261",
                        "glosses": [
                            "een korte tijd geleden gebeurd of begonnen"
