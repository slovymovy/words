                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3443d68d-4209-4d0c-aaec-495d12169b73",
                                                "sense_id": "3e08f3c1-f77b-309c-b001-f95f5d59bcc0",
                                                "text": "Hinter dem Absatzzeichen ¶ beginnt der nächste Absatz des Textes."
                                            },
                                            {
                                                "example_id": "657002c4-d958-4f7f-8c5b-4bec3d0e75a1",
                                                "sense_id": "3e08f3c1-f77b-309c-b001-f95f5d59bcc0",
                                                "text": "In einem häufig gebrauchten Textprogramm enthält selbst ein vermeintlich leeres Textdokument doch immer zumindest ein Absatzzeichen; damit hat der Programmnutzer die unerlässliche Gelegenheit, immer ausgefeilt formatieren zu können, selbst wenn gar nichts zu formatieren da ist."
                                            }
                                        ],
