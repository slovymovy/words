                    {
                        "sense_id": "38adfb55-7b5b-3630-809a-f596627fd7eb",
                        "entry_id": "26964a9e-3cc5-31b4-a2ec-784558ba537f",
                        "glosses": [
                            "Sehschwäche, bei der nahe Objekte nur unscharf, weiter entfernte aber klarer gesehen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "928ef15d-e6d8-4ed6-aa07-cd9c41693d36",
                                "sense_id": "38adfb55-7b5b-3630-809a-f596627fd7eb",
                                "text": "„Eine leichte Weitsichtigkeit gilt bei Kleinkindern als normal.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "08cdc944-9081-3b98-b87f-dbdae761d4a8",
                        "entry_id": "26964a9e-3cc5-31b4-a2ec-784558ba537f",
                        "glosses": [
                            "Fähigkeit, zukünftige Entwicklungen (Chancen und Risiken) zu überblicken, frühzeitig zu erkennen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e2e3543-9ede-4bbf-8b4a-981dc183d4e8",
                                "sense_id": "08cdc944-9081-3b98-b87f-dbdae761d4a8",
                                "text": "„Bei so viel ökonomischer Weitsichtigkeit ziehen wir den Hut vor dem HSV-Vorstandsvorsitzenden Bernd Hoffmann, der unlängst erklärte, dass unter seiner Ägide keine ‚Preistreiberei‘ von Spielern akzeptiert werde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
