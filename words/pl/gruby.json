                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wymiary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyjściem na mróz ubierz <w>gruby</w> sweter.",
