                "senses": [
                    {
                        "sense_id": "8b1b9152-fdf5-3c2a-a4f4-158734a7e644",
                        "entry_id": "024cde71-392f-355d-88eb-5e9967a112bf",
                        "glosses": [
                            "Hétaïre, femmes se vendant qui contrastaient avec les viles prostituées et dont la valeur était socialement reconnue."
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "b0cc5f26-65b3-4560-85e8-b08e524f12f4",
                                "sense_id": "8b1b9152-fdf5-3c2a-a4f4-158734a7e644",
                                "text": "Der Einfluss der Hetären als Geliebte von bedeutenden Staatsmännern, Dichtern, Philosophen und Künstlern darf nicht unterschätzt werden. — L’influence des hétaïres en tant qu'amoureuse de nombreux hommes d’Etat, poètes, philosophes et artistes ne doit pas être sous-estimée."
                            }
                        ]
                    }
                ],
