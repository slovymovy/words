{
    "word_family": [
        "demand"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d2ee6808-a4d8-389e-bb9f-10ea938e7888",
                    "sense_definition": "Requiring a high level of effort, endurance, or skill.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete trained on the most <w>demanding</w> mountain trails.",
                            "target_lang_translations": {
                                "ru": "Спортсмен тренировался на самых <w>требующих усилий</w> горных тропах."
                            }
                        },
                        {
                            "text": "This job is physically <w>demanding</w> for new employees.",
                            "target_lang_translations": {
                                "ru": "Эта работа физически <w>напряжённая</w> для новых сотрудников."
                            }
                        }
                    ],
                    "synonyms": [
                        "challenging",
                        "taxing"
                    ],
                    "antonyms": [
                        "undemanding"
                    ],
                    "common_phrases": [
                        "physically demanding",
                        "demanding schedule"
                    ],
                    "target_lang_definitions": {
                        "ru": "Требующий больших усилий, выносливости или мастерства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "требующий усилий",
                                "target_lang_sense_clarification": "о задаче или работе, которая требует много сил"
                            },
                            {
                                "target_lang_word": "напряжённый",
                                "target_lang_sense_clarification": "о графике или деятельности, требующей полной отдачи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bbf199e-95f2-3049-adf4-a0e3c6f3c173",
                    "sense_definition": "Expecting high standards and difficult to satisfy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a very <w>demanding</w> boss who expects perfection.",
                            "target_lang_translations": {
                                "ru": "Она очень <w>требовательный</w> начальник, который ожидает совершенства."
                            }
                        },
                        {
                            "text": "The <w>demanding</w> customer asked for a full refund.",
                            "target_lang_translations": {
                                "ru": "Взыскательный <w>клиент</w> потребовал полного возврата денег."
                            }
                        }
                    ],
                    "synonyms": [
                        "exacting",
                        "strict"
                    ],
                    "antonyms": [
                        "undemanding"
                    ],
                    "common_phrases": [
                        "demanding boss",
                        "demanding customer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ожидающий высоких стандартов и трудноудовлетворимый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "требовательный",
                                "target_lang_sense_clarification": "о человеке, который предъявляет высокие требования к другим"
                            },
                            {
                                "target_lang_word": "взыскательный",
                                "target_lang_sense_clarification": "о человеке с высокими стандартами, которого трудно удовлетворить"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b02c3481-90b4-3fd3-91fe-b18c6e8b5b9c",
                    "sense_definition": "The present participle and gerund of <w>demand</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers are <w>demanding</w> better pay and safer conditions.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>требуют</w> лучшей оплаты и более безопасных условий."
                            }
                        },
                        {
                            "text": "He is <w>demanding</w> an explanation for the sudden change.",
                            "target_lang_translations": {
                                "ru": "Он <w>требует</w> объяснений внезапных перемен."
                            }
                        }
                    ],
                    "common_phrases": [
                        "demanding answers",
                        "demanding change"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола «требовать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "требующий",
                                "target_lang_sense_clarification": "активное действие по предъявлению требования"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}