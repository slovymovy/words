                ],
                "senses": [
                    {
                        "sense_id": "e39ea72d-d33f-3b6c-b7e5-3dc6ee1c5db2",
                        "entry_id": "98d5008e-627f-3141-bee2-195d4b51351b",
                        "glosses": [
                            "разг. имеющий привычку брыкаться, лягаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60383f67-ef01-4c3e-b14e-a8ed650d64bf",
                                "sense_id": "e39ea72d-d33f-3b6c-b7e5-3dc6ee1c5db2",
                                "text": "Иногда всё это напоминало мне сцену из сельской жизни, когда мужики никак не могут объездить брыкливую колхозную лошадь."
                            }
                        ]
                    },
                    {
                        "sense_id": "be4db022-0781-3b26-8c68-035d6b9cb93e",
                        "entry_id": "98d5008e-627f-3141-bee2-195d4b51351b",
                        "glosses": [
                            "перен. разг. непокорный, строптивый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6826b92d-fd7e-43cd-afed-c4d1c3dd48de",
                                "sense_id": "be4db022-0781-3b26-8c68-035d6b9cb93e",
                                "text": "Однако миллионер давно уже слышал о том, что хозяин этой остелери — человек характера независимого, грубоватого и брыкливого."
                            }
                        ]
                    }
