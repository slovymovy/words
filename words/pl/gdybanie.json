    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea26137c-f59a-3ae9-98af-9b07b3506082",
                    "sense_definition": "Rozważanie hipotetycznych sytuacji lub snucie bezowocnych przypuszczeń dotyczących przeszłości albo przyszłości.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spekulacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Szkoda czasu na bezsensowne <w>gdybanie</w>, bo decyzja została już podjęta.",
                            "target_lang_translations": {
                                "ru": "Жаль тратить время на бессмысленные <w>рассуждения «если бы да кабы»</w>, потому что решение уже принято."
                            }
                        },
                        {
                            "text": "Takie <w>gdybanie</w> o tym, co mogło się wydarzyć, w niczym nam teraz nie pomoże.",
                            "target_lang_translations": {
                                "ru": "Такие <w>пустые предположения</w> о том, что могло произойти, нам сейчас ничем не помогут."
                            }
                        }
                    ],
                    "synonyms": [
                        "spekulacja",
                        "domysły",
                        "przypuszczenia"
                    ],
                    "common_phrases": [
                        "bezsensowne gdybanie",
                        "szkoda czasu na gdybanie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "często używane w języku potocznym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рассмотрение гипотетических сценариев или бесплодные рассуждения о том, что могло или может произойти («если бы да кабы»)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассуждения «если бы да кабы»",
                                "target_lang_sense_clarification": "бесплодные гипотезы"
                            },
                            {
                                "target_lang_word": "гадание на кофейной гуще",
                                "target_lang_sense_clarification": "необоснованные предположения"
                            },
                            {
                                "target_lang_word": "пустые предположения",
                                "target_lang_sense_clarification": "домыслы о прошлом или будущем"
                            },
                            {
                                "target_lang_word": "досужие домыслы",
                                "target_lang_sense_clarification": "спекуляции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "650fb48f-cbb4-3a30-ba80-42ceb64f4b8a",
                    "sense_definition": "Rzeczownik odczasownikowy od: <w>gdybać</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "forma odczasownikowa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ciągłe <w>gdybanie</w> autora artykułu tylko rozmywa faktyczny obraz całej sytuacji.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>умствование</w> автора статьи лишь размывает реальную картину всей ситуации."
                            }
                        },
                        {
                            "text": "Zamiast skupić się na działaniu, pracownicy spędzili cały poranek na <w>gdybaniu</w>.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы сосредоточиться на действиях, сотрудники провели всё утро за <w>построением пустых догадок</w>."
                            }
                        }
                    ],
