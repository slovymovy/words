        "fr-extract.jsonl": [
            {
                "entry_id": "21558076-09c6-34ad-97e5-e663898e8ff8",
                "word": "porte-à-faux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1af57591-3784-463f-a52c-127301ce78e5",
                        "entry_id": "21558076-09c6-34ad-97e5-e663898e8ff8",
                        "tags": [],
                        "form": "porte à faux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd25d495-6789-3bdd-b49d-e2a90c1bb190",
                        "entry_id": "21558076-09c6-34ad-97e5-e663898e8ff8",
                        "glosses": [
                            "Impression d'instabilité ou manque de stabilité due à l’absence de soutien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4d523b3-ed19-429e-aa58-a902be562288",
                                "sense_id": "dd25d495-6789-3bdd-b49d-e2a90c1bb190",
                                "text": "Il semble que ce soit un porte-à-faux qui ait rendu cette construction instable."
                            },
                            {
                                "example_id": "229a9a3d-13fd-4e75-9d60-0041da111936",
                                "sense_id": "dd25d495-6789-3bdd-b49d-e2a90c1bb190",
                                "text": "Ce mur est hors d’aplomb, il est en porte-à-faux."
                            },
                            {
                                "example_id": "127c8762-c82b-417f-8f27-d94534aa6388",
                                "sense_id": "dd25d495-6789-3bdd-b49d-e2a90c1bb190",
                                "text": "Les loges de ce théâtre sont en porte-à-faux."
                            },
                            {
                                "example_id": "7e3ee663-bf56-49c9-9f1d-051b3d13c205",
                                "sense_id": "dd25d495-6789-3bdd-b49d-e2a90c1bb190",
                                "text": "Ma situation familiale rappelait celle de mon père : il s’était trouvé en porte-à-faux entre le scepticisme désinvolte de mon grand-père et le sérieux bourgeois de ma grand-mère."
                            },
                            {
                                "example_id": "14c8306d-7332-4206-80e4-45818fa2f506",
                                "sense_id": "dd25d495-6789-3bdd-b49d-e2a90c1bb190",
                                "text": "Pour des gens comme eux, une charrette ne représentait pas grand-chose. Elle était solide, bien que la mère la considérât comme une antiquité, mais à tomber en porte-à-faux sur une roue, elle se briserait sans doute."
                            },
                            {
                                "example_id": "52cefde2-2910-478f-8479-6603b7630405",
                                "sense_id": "dd25d495-6789-3bdd-b49d-e2a90c1bb190",
                                "text": "Il perçoit, gêné, l’inévitable porte-à-faux entre un catholique croyant, à plus forte raison un prêtre, et un incroyant que des traditions de famille ou de baptême rattachent au catholicisme, mais qui n’a jamais cru, et n’a même jamais pris la peine de se demander s’il croyait ou s’il ne croyait pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "93bb2b88-2afd-366e-9bae-ff11bd054ce7",
                        "entry_id": "21558076-09c6-34ad-97e5-e663898e8ff8",
                        "glosses": [
                            "Structure qui s’élance dans le vide en ne reposant que sur un point d’appui."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "66501bcf-f053-3116-ac33-7c3d73b3e53e",
                        "entry_id": "21558076-09c6-34ad-97e5-e663898e8ff8",
                        "glosses": [
                            "Distance entre l’extrémité avant (ou arrière) d'un véhicule sur roues (ou d’un attelage sur roues) et la position de son essieu le plus proche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b0f78d7-9435-426e-b65f-02e1ad53fca4",
                                "sense_id": "66501bcf-f053-3116-ac33-7c3d73b3e53e",
                                "text": "Sur un véhicule léger, comme la voiture, les porte-à-faux sont quasiment nuls, tandis que sur les poids lourds, ils sont plus importants."
                            },
                            {
                                "example_id": "19e160c9-ff8d-47d6-92da-9c5d5fec6da1",
                                "sense_id": "66501bcf-f053-3116-ac33-7c3d73b3e53e",
                                "text": "La scène […] montre un gros bus blanc en délicatesse dans un virage. La route est tellement pentue que son porte-à-faux avant racle quasiment contre le tarmac."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47f1f3aa-6075-46fa-9bf6-3d0a3539d908",
