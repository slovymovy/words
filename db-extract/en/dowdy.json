                    },
                    {
                        "sense_id": "6df7d0cb-6c54-324a-ad2a-066f2ae4c822",
                        "entry_id": "69e002fe-b1df-3e2e-b528-461924df0dcd",
                        "glosses": [
                            "Lacking stylishness or neatness; shabby."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02286d82-129e-4c76-a4a2-a279315f0894",
                                "sense_id": "6df7d0cb-6c54-324a-ad2a-066f2ae4c822",
                                "text": "[...she was] a perfect saint amongst women, but so dreadfully dowdy that she reminded one of a badly bound hymn-book."
                            },
                            {
                                "example_id": "a89851d5-2bf9-4f84-88c4-9fcae0794c8c",
                                "sense_id": "6df7d0cb-6c54-324a-ad2a-066f2ae4c822",
                                "text": "“Ha! Shagging a chair is quite odd.” “Its legs were very sexy. And I know how you are, so I expected a challenge. What did you turn into anyway?” “Oh, the dowdiest mortal woman. You should have seen it.” “Oh, I would have been all over that.” “I know!”"
                            }
                        ]
                    }
