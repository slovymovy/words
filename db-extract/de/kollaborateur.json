                    },
                    {
                        "form_id": "bf79a513-4f1e-4a7a-b5b2-6975361931f5",
                        "entry_id": "f9b0457a-3589-3097-b486-74ed0618513d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kollaborateure"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf50a094-2289-364e-b37b-a049ff797317",
                        "entry_id": "f9b0457a-3589-3097-b486-74ed0618513d",
                        "glosses": [
                            "jemand, der mit dem Feind zusammenarbeitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a96ad25d-f654-4598-8b05-d01fafa8e4e3",
                                "sense_id": "cf50a094-2289-364e-b37b-a049ff797317",
                                "text": "„Die Schwäche der Kollaborateure wurde offenkundig, als Arminius und Flavus im Jahre 16 bei einem Kriegszug an der Weser einander gegenüberstanden.“"
                            },
                            {
                                "example_id": "4d3de332-3b22-448b-b21f-dcf4069e2ec9",
                                "sense_id": "cf50a094-2289-364e-b37b-a049ff797317",
                                "text": "„Aus diesem Grund fällt der Populismus in jener Region auf fruchtbaren Boden, und als in Deutschland Hitlers Regime aufkommt, rekrutieren sich unter den Bewohnern Hindenburgs zahlreiche Kollaborateure.“"
                            },
                            {
                                "example_id": "a18fdb99-e774-41e8-a79e-8ebf9cbaf180",
                                "sense_id": "cf50a094-2289-364e-b37b-a049ff797317",
                                "text": "„Es gab zu viele weithin sichtbare Kollaborateure.“"
                            },
                            {
                                "example_id": "6bfae024-0bdf-4c04-8146-97cf7df8badd",
                                "sense_id": "cf50a094-2289-364e-b37b-a049ff797317",
                                "text": "„Später, nach dem Einmarsch der Aliierten, nahmen die Verfolgten und auch viele normale Franzosen ihre Rache, es gab eine regelrechte Jagd auf Kollaborateure.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd17a80f-40bc-48b1-a234-525d573a5bfb",
                        "source_entry_id": "f9b0457a-3589-3097-b486-74ed0618513d",
                        "source_sense_id": "cf50a094-2289-364e-b37b-a049ff797317",
                        "source_sense_description": "jemand, der mit dem Feind zusammenarbeitet",
                        "target_lang_word": "коллаборационист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "коллаборационист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8d8172b8-970f-3f14-898d-a5a66beb9cf2",
                                        "entry_id": "f786b9bf-1237-300f-a75e-ee7e3ec6eb08",
                                        "glosses": [
                                            "полит. тот, кто сотрудничает с оккупационными властями, идёт на службу к врагу на территории собственной страны"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52087269-7d93-4456-8526-24208b0eb613",
                                                "sense_id": "8d8172b8-970f-3f14-898d-a5a66beb9cf2",
                                                "text": "Но если ваш прадедушка «враждебный» ― например, был коллаборационистом и помогал японцам, ― то вас даже в армию не возьмут."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8f0334d-e34c-3891-9e6c-d0d661605e1f",
                                        "entry_id": "f786b9bf-1237-300f-a75e-ee7e3ec6eb08",
                                        "glosses": [
                                            "перен., неодобр. изменник, предатель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca4daf5-b24c-46d3-929a-6604791582fd",
                                                "sense_id": "b8f0334d-e34c-3891-9e6c-d0d661605e1f",
                                                "text": "Меня, вдумчивого принца-аналитика, любовно перебиравшего души своих людей, меня ― снизу ― сочли штрейкбрехером и коллаборационистом, а сверху ― лоботрясом с неуравновешенной психикой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
