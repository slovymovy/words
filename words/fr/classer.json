                        "classer par ordre"
                    ]
                },
                {
                    "sense_id": "fd07b537-4eb7-3b50-9462-d0d733aba2ac",
                    "sense_definition": "Mettre des papiers ou des fichiers en réserve dans un meuble ou un dossier pour les archiver.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La secrétaire doit <w>classer</w> les factures payées avant la fin de la semaine."
                        },
                        {
                            "text": "N'oublie pas de <w>classer</w> chaque contrat signé dans la bonne pochette."
                        }
                    ],
                    "synonyms": [
