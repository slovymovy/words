                    {
                        "translation_id": "86c7d07c-070f-4eb6-b0e5-b7290f6310ca",
                        "source_entry_id": "39799f20-a7c3-3b03-9894-7d3070cafd84",
                        "source_sense_id": "3b8794b3-5d45-3a02-95b8-1f5044362bd8",
                        "target_lang_word": "Auftraggeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auftraggeber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                        "entry_id": "649105dc-9511-3462-9a48-bee35e6a2be4",
                                        "glosses": [
                                            "Person, Firma oder auch Institution, die einen Auftrag erteilt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e7a934f-490f-4210-9b1d-1dc6f1731a9f",
                                                "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                                "text": "„Deshalb haben die vier Fahnder jetzt Klage gegen Gutachter H. eingereicht und auch seinem Auftraggeber, dem Land Hessen, den Streit erklärt.“"
                                            },
                                            {
                                                "example_id": "e917f320-89d2-4faf-8563-3294050049a7",
                                                "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                                "text": "„Nach mehrmaliger Umarbeitung fand das Werk die Zufriedenheit der Auftraggeber …“"
                                            },
                                            {
                                                "example_id": "7d8d4bd8-8fe2-41d7-bded-8785b676d863",
                                                "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                                "text": "„Auftraggeber war der in Paris ausgebildete und zu den führenden Gelehrten der Universität Löwen gehörende Grammatiker und Jurist Antonius Haneron.“"
                                            },
                                            {
                                                "example_id": "d029f9b8-c899-431f-b35a-7b07f1c7d82c",
                                                "sense_id": "ae30d5fb-73d1-3b7e-9607-bc4b42a0eabb",
                                                "text": "„Vom Gewölbe des Archivs geschützt, hatte er sich auf eine Beschäftigung zurückgezogen, die vermutlich nicht im Sinne seiner Auftraggeber lag, als sie ihm das Amt des Archivars zuerkannten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "db1c21c9-cea0-4fdb-ae52-48503d5e5eb4",
                        "source_entry_id": "39799f20-a7c3-3b03-9894-7d3070cafd84",
                        "source_sense_id": "3b8794b3-5d45-3a02-95b8-1f5044362bd8",
                        "target_lang_word": "Kommittent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "29790182-06d6-4937-888e-0bfa0fe5f9c8",
                        "source_entry_id": "39799f20-a7c3-3b03-9894-7d3070cafd84",
                        "source_sense_id": "3b8794b3-5d45-3a02-95b8-1f5044362bd8",
                        "target_lang_word": "commettant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commettant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c25c05f7-c014-336c-b8e7-8c69939e33d5",
                                        "entry_id": "4aa0e6f6-426a-3086-ba1c-906668159b90",
                                        "glosses": [
                                            "Celui qui charge un autre du soin de ses intérêts politiques ou privés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8be81421-968e-4776-a885-0e4b233c5c13",
                                                "sense_id": "c25c05f7-c014-336c-b8e7-8c69939e33d5",
                                                "text": "Jamais \"l'Ami du Peuple\" ne s'est élevé contre des hommes privés; jamais il n'a attaqué que des hommes publics, […], les mandataires du peuple qui oublient leurs devoirs pour trahir leurs commettants."
                                            },
                                            {
                                                "example_id": "555d31ba-085d-4c40-ae32-7222d62a300e",
                                                "sense_id": "c25c05f7-c014-336c-b8e7-8c69939e33d5",
                                                "text": "Mais il était candidat et en face de ses commettans, c'est-à-dire de ses juges; il devait faire bonne contenance."
                                            },
                                            {
                                                "example_id": "16855b7d-16a0-422e-a47b-b17f33e8be86",
                                                "sense_id": "c25c05f7-c014-336c-b8e7-8c69939e33d5",
                                                "text": "Je me gardai bien entendu de manquer à mes engagements mais je me refusai à plaider à la tribune la cause des bouilleurs de cru, quoi que me demandassent mes commettants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7f2d150-207d-337c-923f-a8c7c56fc6b7",
                                        "entry_id": "4aa0e6f6-426a-3086-ba1c-906668159b90",
                                        "glosses": [
                                            "Électeur ; citoyen par rapport à l'élu qui le représente."
                                        ],
                                        "tags": [
                                            "Systèmes électoraux"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10036449-858b-43e3-a41e-6aef04b1b4e2",
                                                "sense_id": "f7f2d150-207d-337c-923f-a8c7c56fc6b7",
                                                "text": "Ce sont les élus qui doivent avoir le dernier mot, car ce sont eux et elles qui sont redevables à leurs commettants."
                                            },
                                            {
                                                "example_id": "fdd85adc-f417-41ba-8e6d-c5be8f46f6a7",
                                                "sense_id": "f7f2d150-207d-337c-923f-a8c7c56fc6b7",
                                                "text": "Ils savent comment rester liés à leurs commettants (sans quoi ils ne seraient pas réélus) tout en développant une connaissance des rouages de cette antique (et fascinante) machine à digérer les débats de société et à produire des lois qu’est le Parlement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68b997af-6b95-305b-8925-67ade4d0467c",
                                        "entry_id": "4aa0e6f6-426a-3086-ba1c-906668159b90",
                                        "glosses": [
                                            "Entité pouvant être authentifiée par un système informatique ou en réseau."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
