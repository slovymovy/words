                        "glosses": [
                            "een tas die met behulp van riemen of magneten op de tank van een motorfiets gemonteerd wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b6fab55-fc2b-4086-9225-6b48e2d94d51",
                                "sense_id": "d280b43e-0241-3c91-8766-d6e2f6a39987",
                                "text": "Guus verplaatst zich op een motor van het merk Triumph Trophy 900, kleur donkerrood, kenteken MY-21-DB voorzien van twee zijkoffers in de kleur van de motor. Bovendien gebruikt Guus een tanktas met daarop een grote fietsbel bevestigd."
                            },
                            {
                                "example_id": "12de4c91-3d6b-4f3a-a3fc-144ba1f1747f",
                                "sense_id": "d280b43e-0241-3c91-8766-d6e2f6a39987",
                                "text": "Een 55-jarige Hagenaar werd woensdagmorgen, om tien voor 10 op heterdaad betrapt toen hij uit een motortas een paar handschoenen en twee halsdoeken wegnam. De motor stond geparkeerd op de Rietveltstraat toen een getuige omstreeks tien voor 10 zag dat de Hagenaar in de tanktas stond te voelen."
                            }
                        ]
                    }
