                                        "glosses": [
                                            "Appareil qui sert à mesurer l’acuité auditive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8ac4dc1-f2f2-43f1-985b-80ca010c552d",
                                                "sense_id": "506dac15-47c7-3b56-b3f4-49945f5d88ef",
                                                "text": "Il faut aussi vérifier l’état général de l’audiomètre et des transducteurs, l’état des connexions, et rechercher d’éventuels bruits parasites."
                                            }
