                    {
                        "sense_id": "d0b2809f-a268-3811-9890-8230e7fc2039",
                        "entry_id": "c1fe0f10-4f0d-39ee-82f8-3e8dc6a8a690",
                        "glosses": [
                            "Instrument à deux branches, avec lequel on mouche les chandelles, les bougies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf6f7f1c-346c-45e7-9a10-ad94009ba283",
                                "sense_id": "d0b2809f-a268-3811-9890-8230e7fc2039",
                                "text": "Mais Palmyre, ayant pris les mouchettes pour moucher la chandelle, la moucha si bas, qu’elle l’éteignit."
                            },
                            {
                                "example_id": "e25c867a-b83e-408f-a23d-6e297c8bb39a",
                                "sense_id": "d0b2809f-a268-3811-9890-8230e7fc2039",
                                "text": "Au premier tournant, et comme il allait entrer dans la seconde cave, sa vraie cave, la cave des bouteilles, il s’arrêta pour moucher la chandelle, ce qu’il fit avec les doigts, ayant oublié les mouchettes ; …"
                            }
                        ]
                    }
