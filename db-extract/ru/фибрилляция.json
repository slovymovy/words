                                "target_senses": [
                                    {
                                        "sense_id": "f72c74cd-890a-3744-98b3-37d60cfe9229",
                                        "entry_id": "04e18074-8174-3172-ae86-4c8ed9f7329e",
                                        "glosses": [
                                            "Succession de contractions irrégulières, rapides et non coordonnées des fibres musculaires du cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "391cfddc-57c9-438e-8a65-9d72201fda26",
                                                "sense_id": "f72c74cd-890a-3744-98b3-37d60cfe9229",
                                                "text": "Ainsi, il paraît logique d’anticoaguler les patients présentant une cardiopathie à haut risque de récidive embolique : prothèses valvulaires mécaniques, valvulopathies mitrales, infarctus du myocarde récent, cardiomyopathies dilatées, anévrysmes ventriculaires, fibrillation auriculaire non rhumatismale associée à un thrombus intracavitaire."
                                            },
                                            {
                                                "example_id": "b9899cdd-96d8-42b8-bf2f-358e234f553e",
                                                "sense_id": "f72c74cd-890a-3744-98b3-37d60cfe9229",
                                                "text": "La fibrillation auriculaire est le trouble du rythme soutenu le plus fréquent, particulièrement chez les sujets âgés ou porteurs de cardiopathie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
