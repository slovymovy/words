                "translations": [
                    {
                        "translation_id": "ea458390-357e-49fd-906b-06abf81eaed9",
                        "source_entry_id": "f33b775b-97d7-3e36-b2aa-97dfd301440c",
                        "source_sense_id": "1c24fba9-20eb-3d68-b060-dec2ed13845c",
                        "target_lang_word": "Feldscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feldscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b74e3e6-33f7-3e7e-bc6c-af420cd933a9",
                                        "entry_id": "e63a20f8-66d9-324a-9ef6-ab739f7169ac",
                                        "glosses": [
                                            "„militärischer Wundarzt (mit geringen Kenntnissen)“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ab6f427-bfb4-457d-b86b-895889916b12",
                                                "sense_id": "5b74e3e6-33f7-3e7e-bc6c-af420cd933a9",
                                                "text": "„Zu dieser Zeit der Karageorgewitsch war das ganze öffentliche Gesundheitswesen auf die Feldschere angewiesen…“"
                                            },
                                            {
                                                "example_id": "e1438a9e-44be-4c6a-a662-6e828d6c5789",
                                                "sense_id": "5b74e3e6-33f7-3e7e-bc6c-af420cd933a9",
                                                "text": "„Dort hantierte ein halbes Dutzend Feldscher mit Messern und Sägen.“"
                                            },
                                            {
                                                "example_id": "dad5e628-15df-41c6-b9f0-e436e2319377",
                                                "sense_id": "5b74e3e6-33f7-3e7e-bc6c-af420cd933a9",
                                                "text": "„Der Feldscher, ein alter, ergrauter, ehrenwerter Kerl, ist überrascht, als er den anscheinend so schwer Kranken kreuzfidel und puppenlustig vorfindet.“"
                                            },
                                            {
                                                "example_id": "ce50886e-1350-4c59-a59e-5e13892a049e",
                                                "sense_id": "5b74e3e6-33f7-3e7e-bc6c-af420cd933a9",
                                                "text": "„Auf der Treppe begegnete er einem Militärarzt mit einer Zigarre im Munde, hinter dem ein Feldscher herkam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abf8cb46-9381-4510-9700-0153643b8609",
                        "source_entry_id": "f33b775b-97d7-3e36-b2aa-97dfd301440c",
                        "source_sense_id": "1c24fba9-20eb-3d68-b060-dec2ed13845c",
