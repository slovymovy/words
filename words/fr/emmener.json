                {
                    "sense_id": "393b278e-eeb6-3492-bf8e-777815ddf6cb",
                    "sense_definition": "Prendre quelqu'un ou un animal avec soi et le conduire d'un lieu à un autre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les matins, elle <w>emmène</w> ses enfants à l'école avant d'aller travailler.",
                            "target_lang_translations": {
                                "en": "Every morning she <w>takes</w> her children to school before going to work.",
                                "ru": "Каждое утро она <w>отводит</w> детей в школу, прежде чем идти на работу.",
                                "nl": "Elke ochtend <w>brengt</w> zij haar kinderen naar school voordat zij naar haar werk gaat.",
                                "de": "Jeden Morgen <w>bringt</w> sie ihre Kinder zur Schule, bevor sie zur Arbeit geht.",
                                "pl": "Każdego ranka <w>odprowadza</w> dzieci do szkoły, zanim pójdzie do pracy.",
                                "it": "Ogni mattina <w>porta</w> i figli a scuola prima di andare al lavoro.",
                                "cs": "Každé ráno vodí své děti do školy, než jde do práce.",
                                "tr": "Her sabah işe gitmeden önce çocuklarını okula <w>götürür</w>.",
                                "es": "Todas las mañanas <w>lleva</w> a sus hijos al colegio antes de ir al trabajo.",
                                "zh": "每天早上，她上班前都要先把孩子<w>送</w>到学校。"
                            }
                        },
                        {
                            "text": "Nous pouvons t'<w>emmener</w> à la gare si tu n'as pas de voiture.",
                            "target_lang_translations": {
                                "en": "We can <w>take</w> you to the station if you don't have a car.",
                                "ru": "Мы можем <w>отвезти</w> тебя на вокзал, если у тебя нет машины.",
                                "nl": "Wij kunnen je naar het station <w>brengen</w> als je geen auto hebt.",
                                "de": "Wir können dich zum Bahnhof <w>mitnehmen</w>, wenn du kein Auto hast.",
                                "pl": "Możemy cię <w>zawieźć</w> na dworzec, jeśli nie masz samochodu.",
                                "it": "Possiamo <w>portarti</w> alla stazione se non hai la macchina.",
                                "cs": "Můžeme tě <w>odvézt</w> na nádraží, pokud nemáš auto.",
                                "tr": "Araban yoksa seni istasyona <w>götürebiliriz</w>.",
                                "es": "Podemos <w>llevarte</w> a la estación si no tienes coche.",
                                "zh": "如果你没有车，我们可以<w>送</w>你去车站。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conduire",
                        "mener"
                    ],
                    "common_phrases": [
                        "emmener en voyage",
                        "emmener à la gare"
                    ],
                    "target_lang_definitions": {
                        "en": "To take someone or an animal with you and lead them from one place to another.",
                        "ru": "Взять с собой человека или животное и отвести их из одного места в другое.",
                        "nl": "Iemand of een dier meenemen en naar een andere plaats brengen.",
                        "de": "Eine Person oder ein Tier mit sich nehmen und von einem Ort zu einem anderen bringen.",
                        "pl": "Zabrać ze sobą człowieka lub zwierzę i zaprowadzić je z jednego miejsca do drugiego.",
                        "it": "Portare con sé una persona o un animale e condurli da un luogo a un altro.",
                        "cs": "Vzít někoho nebo zvíře s sebou a dovést je z jednoho místa na jiné.",
                        "tr": "Bir kişiyi ya da hayvanı yanınızda götürüp bir yerden başka bir yere yönlendirmek.",
                        "es": "Llevar a una persona o un animal consigo y conducirlos de un lugar a otro.",
                        "zh": "把某人或某动物带在身边，并引领其从一个地方到另一个地方。"
                    },
