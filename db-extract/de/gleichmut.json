                    {
                        "form_id": "0b4c5a24-6e6c-4da9-903a-5e06c3a11ee0",
                        "entry_id": "bd596d90-6d9b-3869-902e-7371a7c62360",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Gleichmut"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2df0bb00-7c33-3a14-8832-427f2e0dde48",
                        "entry_id": "bd596d90-6d9b-3869-902e-7371a7c62360",
                        "glosses": [
                            "durch äußere und innere Einflüsse nicht aus dem Gleichgewicht zu bringende Gemütsverfassung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "082313dc-8e48-498c-aa60-5faaefcab9ef",
                                "sense_id": "2df0bb00-7c33-3a14-8832-427f2e0dde48",
                                "text": "Die Kultivierung von Gleichmut ist nicht zu verwechseln mit der Etablierung von Gleichgültigkeit."
                            },
                            {
                                "example_id": "e6b7ae8e-eaca-45a0-9600-5c85acee5c8b",
                                "sense_id": "2df0bb00-7c33-3a14-8832-427f2e0dde48",
                                "text": "„Auf seinen zwei vorangegangenen Reisen hatte sich Cook derlei Widrigkeiten in der Regel mit Gleichmut gestellt und im Umgang mit Matrosen und Einheimischen eine strenge, aber gerechte Hand bewiesen.“"
                            },
                            {
                                "example_id": "d1b91e3a-e680-4855-94f9-181f739b1f6b",
                                "sense_id": "2df0bb00-7c33-3a14-8832-427f2e0dde48",
                                "text": "„Der Seeräuber hatte mit diplomatischem Gleichmut zugehört.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c313e65-a247-48ab-ac3c-1c271de07369",
                        "source_entry_id": "bd596d90-6d9b-3869-902e-7371a7c62360",
                        "source_sense_id": "2df0bb00-7c33-3a14-8832-427f2e0dde48",
                        "source_sense_description": "durch äußere und innere Einflüsse nicht aus dem Gleichgewicht zu bringende Gemütsverfassung",
                        "target_lang_word": "equanimity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equanimity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b30645b4-d06b-39e6-8eb3-a30d64aa3c55",
                                        "entry_id": "dc9a907f-f532-3614-93e8-fe0cbea54e35",
                                        "glosses": [
                                            "The state of being calm, stable and composed, especially under stress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e01080b-1a88-49fa-9b6d-76b3227a281d",
                                                "sense_id": "b30645b4-d06b-39e6-8eb3-a30d64aa3c55",
                                                "text": "No doubt you are right, my best of friends, there would be far less suffering amongst mankind, if men—and God knows why they are so fashioned—did not employ their imaginations so assiduously in recalling the memory of past sorrow, instead of bearing their present lot with equanimity."
                                            },
                                            {
                                                "example_id": "1467e559-8235-44b3-9741-b84e68f25e7c",
                                                "sense_id": "b30645b4-d06b-39e6-8eb3-a30d64aa3c55",
                                                "text": "In the very heart of the herd the din was terrific. It was almost dizzying in its effect. I paused and smiled reassuringly at Maud, for I had recovered my equanimity sooner than she."
                                            },
                                            {
                                                "example_id": "4a33a3f1-1709-4c63-97ea-4f7c17f2e0bf",
                                                "sense_id": "b30645b4-d06b-39e6-8eb3-a30d64aa3c55",
                                                "text": "Few people are capable of expressing with equanimity opinions which differ from the prejudices of their social environment."
                                            },
                                            {
                                                "example_id": "f3eea239-528d-4aeb-8fc8-8ce7ec701184",
                                                "sense_id": "b30645b4-d06b-39e6-8eb3-a30d64aa3c55",
                                                "text": "We find Hudson himself, a vision of unwavering equanimity, admitting that as a child he didn’t dare mention his acting dreams for fear they would be dismissed as “sissy stuff”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7dc57df7-3023-4121-875e-a84849ee8b00",
                        "source_entry_id": "bd596d90-6d9b-3869-902e-7371a7c62360",
                        "source_sense_id": "2df0bb00-7c33-3a14-8832-427f2e0dde48",
                        "source_sense_description": "durch äußere und innere Einflüsse nicht aus dem Gleichgewicht zu bringende Gemütsverfassung",
                        "target_lang_word": "stoicism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stoicism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40b2df25-aed5-31a2-a005-d04ea5caa94f",
                                        "entry_id": "13a897c1-006c-3b33-8550-68813af399c7",
                                        "glosses": [
                                            "A school of philosophy popularized during the Roman Empire that emphasized reason as a means of understanding the natural state of things, or logos, and as a means of freeing oneself from emotional distress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b541760b-2f40-310d-839b-b16991868daf",
                                        "entry_id": "13a897c1-006c-3b33-8550-68813af399c7",
                                        "glosses": [
                                            "A real or pretended indifference to pleasure or pain; insensibility; impassiveness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf8f39ac-771a-456d-ba80-0549918a8f8c",
                                                "sense_id": "b541760b-2f40-310d-839b-b16991868daf",
                                                "text": "Jones’ sad eyes betray a pervasive pain his purposefully spare dialogue only hints at, while the perfectly cast Brolin conveys hints of playfulness and warmth while staying true to the craggy stoicism at the character’s core."
                                            },
                                            {
                                                "example_id": "39925f7d-3d2a-4f9c-b58b-eb62c652b614",
                                                "sense_id": "b541760b-2f40-310d-839b-b16991868daf",
                                                "text": "Although very distant from the lives of her subjects – she never went to school and had only the most fleeting experiences of being on equal terms with anyone – she grew into a much respected figure, admired for her stoicism and diligence"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
