                                                "sense_id": "17b33d13-baba-3e45-bff3-752394c5d8a2",
                                                "text": "Scaramanga hatte seine Waffe im Anschlag, doch Bond blieb völlig gelassen."
                                            },
                                            {
                                                "example_id": "e77782f4-3b9c-4a73-893e-73fb4acb2c25",
                                                "sense_id": "17b33d13-baba-3e45-bff3-752394c5d8a2",
                                                "text": "Das Model blickt gelassen in die Kamera."
                                            },
                                            {
                                                "example_id": "c9ecfb8d-05d7-406f-94d8-7307300d65ae",
                                                "sense_id": "17b33d13-baba-3e45-bff3-752394c5d8a2",
                                                "text": "Der Angeklagte nahm das Urteil gelassen auf."
                                            },
                                            {
                                                "example_id": "a24cfd3e-b2a2-4c53-a61b-4619265b73b4",
                                                "sense_id": "17b33d13-baba-3e45-bff3-752394c5d8a2",
                                                "text": "„Du sprichst ein großes Wort gelassen aus.“ (Goethe, Torquato Tasso)"
                                            }
