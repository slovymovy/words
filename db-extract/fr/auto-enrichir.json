                ],
                "senses": [
                    {
                        "sense_id": "3bf39d6e-0ce2-36a0-b692-c098e26afd2b",
                        "entry_id": "631e00bb-1ed3-3d03-a66f-460729cc1f8e",
                        "glosses": [
                            "Enrichir naturellement, sans avoir besoin d’intervenir."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "37807028-c0a6-4ff4-b63d-aad5fb5dbb9e",
                                "sense_id": "3bf39d6e-0ce2-36a0-b692-c098e26afd2b",
                                "text": "Qui plus est, ce qui caractérise un système expert par rapport à une banque de données standard, est sa faculté d’auto-enrichir sa banque de données de base en fonction des nouveaux cas présentés."
                            },
                            {
                                "example_id": "3bf58e5b-411c-4a56-a03f-f5df881671fe",
                                "sense_id": "3bf39d6e-0ce2-36a0-b692-c098e26afd2b",
                                "text": "Leur intérêt pour la recherche pédagogique est cependant considérable, lorsqu'il s'agit de systèmes prévus pour s’auto-enrichir à chaque passage d’un apprenant."
                            }
                        ]
                    }
