                "senses": [
                    {
                        "sense_id": "0ab11cab-7891-3d63-9f80-b0ca4c8acbe7",
                        "entry_id": "a7a74180-5415-31b3-bb44-6966a630575b",
                        "glosses": [
                            "zob. na skutek"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "19df7ba6-8a23-4c71-a043-efd5ecb43348",
                                "sense_id": "0ab11cab-7891-3d63-9f80-b0ca4c8acbe7",
                                "text": "Wskutek czołowego zderzenia samochodu ciężarowego z autem osobowym na trasie drogi krajowej nr 7 koło Olsztynka zginęły trzy osoby. Wśród ofiar śmiertelnych znalazł się kierowca samochodu osobowego i dwóch jego pasażerów."
                            },
                            {
                                "example_id": "bf7faa6d-9ccf-4b92-b686-cdb3e5de9608",
                                "sense_id": "0ab11cab-7891-3d63-9f80-b0ca4c8acbe7",
                                "text": "Inigo wzruszył ramionami. Wskutek tego ruchu coś srebrzystego wystrzeliło mu z rękawa; była to starannie ukształtowana klinga, wyściełana z jednej strony i ustawiająca się wzdłuż kantu dłoni."
                            },
                            {
                                "example_id": "5aac1dc8-4373-441e-aa40-e503cf8d9b83",
                                "sense_id": "0ab11cab-7891-3d63-9f80-b0ca4c8acbe7",
                                "text": "Wskutek działania mocnego prądu wody w kilku miejscach te zabezpieczenia znalazły się bliżej koryta, zostały dosłownie odepchnięte na środek potoku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76b802b9-696a-4268-b40a-ca49ebf6f52a",
                        "source_entry_id": "a7a74180-5415-31b3-bb44-6966a630575b",
                        "source_sense_id": "0ab11cab-7891-3d63-9f80-b0ca4c8acbe7",
                        "target_lang_word": "on account of",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on account of",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6ecba6a-0886-3504-ae7e-6b79bf722d79",
                                        "entry_id": "eb4f1975-438e-3d90-a082-e691b6731ad7",
                                        "glosses": [
                                            "On behalf of the (monetary) account of; (idiomatic, originally figurative) for the sake of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7559a031-88bf-4166-94a6-a83fb47b9fce",
                                                "sense_id": "f6ecba6a-0886-3504-ae7e-6b79bf722d79",
                                                "text": "[…] and His Imperial Majesty further agrees to pay to the British Government the sum of Three Millions of dollars, on account of debts due to British subjects by some of the said Hong merchants (or Cohong), who have become insolvent, and who owe very large sums of money to subjects of Her Britannic Majesty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42b0ce0f-f43f-37dd-9620-33742f2b4d76",
                                        "entry_id": "eb4f1975-438e-3d90-a082-e691b6731ad7",
                                        "glosses": [
                                            "Because of, due to, owing to."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88c672f9-6889-4866-bace-67b400aa3437",
                                                "sense_id": "42b0ce0f-f43f-37dd-9620-33742f2b4d76",
                                                "text": "The rebuilding of damaged stations is proceeding slowly, on account of the shortage of building materials and the pressing needs of housing, but steady progress is being made."
                                            },
                                            {
                                                "example_id": "e1aafb49-9242-4f24-ad27-d0f6b7fdcaea",
                                                "sense_id": "42b0ce0f-f43f-37dd-9620-33742f2b4d76",
                                                "text": "‘My brother,[…], is at Radley, on account of my parents thinking it a bad idea to have us both at the same school.’\n‘On account of your being twins?’ said Adrian.\n‘Right, on account of my mother OD-ing on fertility drugs.[…]’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "on account of",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57a78a83-7010-30a4-a5a0-eaedc8432541",
                                        "entry_id": "009f998b-df91-3875-9912-3645e29814ec",
                                        "glosses": [
                                            "On account of the fact that: because, since."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9ba5c37-bfe7-4dbc-b5e9-3320664c98df",
                                                "sense_id": "57a78a83-7010-30a4-a5a0-eaedc8432541",
                                                "text": "[…] I had a pretty good notion of the weather conditions generally, on account of I was out in them."
                                            },
                                            {
                                                "example_id": "99be971b-ead9-421b-a68a-dd3689be3903",
                                                "sense_id": "57a78a83-7010-30a4-a5a0-eaedc8432541",
                                                "text": "Truth is I was the kind of fellow who people would run away from when they seen me coming on account of I was so full of facts and names and places and families I had to tell about."
                                            },
                                            {
                                                "example_id": "36d62895-6644-4ff0-80f9-b15b97d46f88",
                                                "sense_id": "57a78a83-7010-30a4-a5a0-eaedc8432541",
                                                "text": "After that, I resumed walking, on account of it involves little contact with strangers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46b1c342-d0e3-42a1-8877-c58ecf9c94c4",
                        "source_entry_id": "a7a74180-5415-31b3-bb44-6966a630575b",
                        "source_sense_id": "0ab11cab-7891-3d63-9f80-b0ca4c8acbe7",
                        "target_lang_word": "owing to",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "owing to",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68dd94e2-18ce-3d35-b130-922703f7c1d5",
                                        "entry_id": "6b557af1-6282-360c-a34a-3a036e6396df",
                                        "glosses": [
                                            "Because of, on account of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b0313ab-3dd2-4236-ab29-6fe8af295700",
                                                "sense_id": "68dd94e2-18ce-3d35-b130-922703f7c1d5",
                                                "text": "I gave up my job as a typist owing to repetitive strain injury."
                                            },
                                            {
                                                "example_id": "eb786a5e-fd04-4299-8497-870fed561f03",
                                                "sense_id": "68dd94e2-18ce-3d35-b130-922703f7c1d5",
                                                "text": "It’s all owing to your precious caution that they got hold of it. If you had let me burn it, and taken my word that it was gone, it would have been a heap of ashes behind the fire, instead of being whole and sound, inside of my great-coat."
                                            },
                                            {
                                                "example_id": "99dd56ac-55d9-4798-a60e-80665821abdc",
                                                "sense_id": "68dd94e2-18ce-3d35-b130-922703f7c1d5",
                                                "text": "Owing to the TB I connected breathing with joy, and owing to the gloom of the ward I connected joy with light, and owing to my irrationality I related light on the walls to light inside me."
                                            },
                                            {
                                                "example_id": "74645fef-cf4b-489a-b369-cb70ba5602d9",
                                                "sense_id": "68dd94e2-18ce-3d35-b130-922703f7c1d5",
                                                "text": "\"Owing to the ongoing conflict, all rail services are subject to change on a short notice,\" warns the European Rail Timetable at the end of its short entry on the general state of Ukraine's railways."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
