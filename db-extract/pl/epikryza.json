                                            "A Roman census in Egypt related to the determination of liability for poll tax."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "epicrisis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa0dbc16-9f78-33e5-9307-60ae558378d4",
