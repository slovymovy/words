        "nl-extract.jsonl": [
            {
                "entry_id": "d5b6b4a5-578e-3faa-8b86-8af097ed0ba0",
                "word": "gerust",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea0fbc33-4bc2-32ce-89a2-bfc19e29eb18",
                        "entry_id": "d5b6b4a5-578e-3faa-8b86-8af097ed0ba0",
                        "glosses": [
                            "zonder angst of zorg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feccace1-fa21-40cd-9270-d7dc8de9e5fa",
                                "sense_id": "ea0fbc33-4bc2-32ce-89a2-bfc19e29eb18",
                                "text": "Na dat gesprek was hij in een heel wat gerustere stemming dan voorheen."
                            },
                            {
                                "example_id": "97b287e6-4319-4ea1-bfdf-64aef332e4df",
                                "sense_id": "ea0fbc33-4bc2-32ce-89a2-bfc19e29eb18",
                                "text": "`Onze gasten kunnen gerust slapen in de wetenschap dat hun vertrekken duchtig worden bewaakt; zei Montebello. `Om zich toegang te verschaffen tot de bovenverdiepingen dient men te passeren tussen de hybride verschijningsvorm van de angst en het verraderlijk spinnende poesje dat voor raadselen stelt, die respectievelijk staan voor het weinig realistische zelfbeeld van de man en het wezen van de vrouw, als u het mij toestaat u te amuseren met mijn dilettantisme op het gebied van de symboliek."
                            },
                            {
                                "example_id": "28130e36-7dd7-4d65-a17b-11c316fad114",
                                "sense_id": "ea0fbc33-4bc2-32ce-89a2-bfc19e29eb18",
                                "text": "Ex heeft vertrouwen in de toekomst van het Boijmans. \"Ik laat het museum en depot met een gerust hart achter\", zegt hij."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99ba0dd6-699f-4a0d-8b29-df4c4ec9a2aa",
                        "source_entry_id": "d5b6b4a5-578e-3faa-8b86-8af097ed0ba0",
                        "source_sense_id": "ea0fbc33-4bc2-32ce-89a2-bfc19e29eb18",
                        "target_lang_word": "calm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "calm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f437f1a4-ca3a-3763-90ff-7db951f3e88a",
                                        "entry_id": "5f4a0d53-539d-39d9-bc75-d2da3f4200e8",
                                        "glosses": [
                                            "Peaceful, quiet, especially free from anger and anxiety."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2272024a-37d6-3fb1-bded-6c156104b30f",
                                        "entry_id": "5f4a0d53-539d-39d9-bc75-d2da3f4200e8",
                                        "glosses": [
                                            "Free of noise and disturbance."
                                        ],
                                        "tags": [
                                            "of a place or situation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f4ba3f9-4135-4b5c-a1bb-5c077798df46",
                                                "sense_id": "2272024a-37d6-3fb1-bded-6c156104b30f",
                                                "text": "Calm is the morn without a sound,\n⁠Calm as to suit a calmer grief,\n⁠And only thro’ the faded leaf\nThe chestnut pattering to the ground: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0ed3259-8237-3deb-8727-ed6a19cad7d7",
                                        "entry_id": "5f4a0d53-539d-39d9-bc75-d2da3f4200e8",
                                        "glosses": [
                                            "with few or no waves on the surface; not rippled."
                                        ],
                                        "tags": [
                                            "of water"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f598ebc-80f1-3b5c-b07f-a70bf5c1d823",
                                        "entry_id": "5f4a0d53-539d-39d9-bc75-d2da3f4200e8",
                                        "glosses": [
                                            "Without wind or storm."
                                        ],
                                        "tags": [
                                            "of weather"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "calm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ff239a5-de95-3b4c-af91-3423edb6eed7",
                                        "entry_id": "8a5b6f49-7137-373d-8e02-1fa51a4c3ab8",
                                        "glosses": [
                                            "The state of being calm; peacefulness; absence of worry, anger, fear or other strong negative emotion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10c61a1-f1ad-4332-a008-d518363a3e78",
                                                "sense_id": "7ff239a5-de95-3b4c-af91-3423edb6eed7",
                                                "text": "Calm on the seas, and silver sleep,\n⁠And waves that sway themselves in rest,\n⁠And dead calm in that noble breast\nWhich heaves but with the heaving deep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f838e1f-b56e-32e3-be32-97b28b538987",
                                        "entry_id": "8a5b6f49-7137-373d-8e02-1fa51a4c3ab8",
                                        "glosses": [
                                            "The state of being calm; absence of noise and disturbance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18970b2a-3dec-3114-9933-d0fcd7b5ad1c",
                                        "entry_id": "8a5b6f49-7137-373d-8e02-1fa51a4c3ab8",
                                        "glosses": [
                                            "The absense of wind; a period of time without wind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ff85e55-b1c5-4200-bd48-e59ae8dab87c",
                                                "sense_id": "18970b2a-3dec-3114-9933-d0fcd7b5ad1c",
                                                "text": "The wind ceased, and there was a great calm."
                                            },
                                            {
                                                "example_id": "8121ed18-1697-45fa-97b5-3c592400a998",
                                                "sense_id": "18970b2a-3dec-3114-9933-d0fcd7b5ad1c",
                                                "text": "It was a calm ; so, forming a tandem of three boats, we commenced the slow business of towing the trophy to the Pequod."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "calm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acaf06bd-daa5-3e2d-ae89-1de6ec4d3776",
                                        "entry_id": "33ed1cdd-f2cb-3aba-9668-c1926ded2f69",
