                                "target_senses": [
                                    {
                                        "sense_id": "6d2abe89-0b25-31c1-8015-63e7e79bef43",
                                        "entry_id": "ce856cdd-ba4a-398a-9252-6882e7d218d9",
                                        "glosses": [
                                            "A phaneritic, intrusive igneous rock characterized by a predominance of plagioclase feldspar."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13eb9a7b-87bc-4a5b-b2f9-c6c8b0b6f95b",
                                                "sense_id": "6d2abe89-0b25-31c1-8015-63e7e79bef43",
                                                "text": "The second, or Labrador series is characterized, as already remarked, by the predominance of great beds of anorthosite, composed chiefly of triclinic feldspars […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "359426af-f829-42b0-82b3-feedf9d8a19d",
                        "source_entry_id": "0fc684bd-9f22-39bb-b89c-d69983422d0a",
                        "source_sense_id": "f5049b44-5898-32d8-8611-e960d4d6c85c",
                        "source_sense_description": "magmatisches Tiefengestein, das reich an Plagioklas ist und als dekoratives Baumaterial verwendet wird",
                        "target_lang_word": "anorthosite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anorthosite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7b03300e-aac1-3329-94b2-c3398b69d8ff",
                                        "entry_id": "bb626952-6936-3a88-9ecc-c0427a108c00",
                                        "glosses": [
                                            "Roche plutonique de structure phanéritique, composée principalement de feldspath plagioclase (90-100 %), avec 0 à 10 % de composants mafiques tels que le pyroxène, l'ilménite, la magnétite et l'olivine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "319f70f1-c457-4dcc-ba24-ca9b8e5cae14",
                                                "sense_id": "7b03300e-aac1-3329-94b2-c3398b69d8ff",
                                                "text": "Au point de vue géologique nous remarquerons que l’anorthosite est très-répandue sur le Saguenay, entre Chicoutimi et le lac Saint-Jean."
                                            },
                                            {
                                                "example_id": "1a5204c6-9b89-419e-a59b-1c8fc0d55166",
                                                "sense_id": "7b03300e-aac1-3329-94b2-c3398b69d8ff",
                                                "text": "En voyant ces granites, ces gneiss, ces micaschistes, en arrêtant mes yeux sur les trapp, sur les expansions porphyriques qui les recouvraient, en admirant les reflets soyeux et irisés des cristaux qui tapissent les anorthosites labradoriennes, je ne pouvais m’empêcher de penser aux minéraux précieux que ces formations recèlent toujours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
