                        "examples": [
                            {
                                "example_id": "69ea8e60-7c21-4f09-ae81-5431078a2398",
                                "sense_id": "5f2a40a3-cb50-369a-b928-fd05ee390322",
                                "text": "Saki : II faisait voltiger et revoltiger des feuilles : L'anaconda ne riait pas."
                            },
                            {
                                "example_id": "d08f0c7e-fe3a-43ce-a179-86d7e3373efe",
                                "sense_id": "5f2a40a3-cb50-369a-b928-fd05ee390322",
                                "text": "C'est vrai que lorsque la lipo arrive au bout de ses forces, il est aisé d'envie de la recharger de suite, pour revoltiger tout de suite."
                            }
                        ]
