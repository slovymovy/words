                "senses": [
                    {
                        "sense_id": "dc8ce056-1ad5-3503-b904-51bfe4b4a029",
                        "entry_id": "aef4a6ef-2b22-340a-be20-437a01a99da3",
                        "glosses": [
                            "Wort für einen Sachverhalt, der Grusel hervorruft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2103d0b-8883-4270-99e5-388f125dc75f",
                                "sense_id": "dc8ce056-1ad5-3503-b904-51bfe4b4a029",
                                "text": "„Das Gruselwort für den deutschen Wurstkonsumenten lautet übrigens Separatorenfleisch, das tatsächlich in vielen Supermarktprodukten zu finden ist.“"
                            },
                            {
                                "example_id": "a9494f27-e5cb-43c4-b026-b084ca65a990",
                                "sense_id": "dc8ce056-1ad5-3503-b904-51bfe4b4a029",
                                "text": "„Im Übermut spricht Isidor das verführerische Gruselwort dreimal aus und erfährt erst bei der weiteren Lektüre, dass er zu Nebelschwaden zerfällt, wenn er nicht zügig einen Geist befreit.“"
                            },
                            {
                                "example_id": "12e8a845-ad25-4a0f-bdc6-874f11324cf7",
                                "sense_id": "dc8ce056-1ad5-3503-b904-51bfe4b4a029",
                                "text": "„Und auch MP3, das Gruselwort der Popkollegen, das für die datenreduzierte und zumeist kostenlose Übertragung von Soundfiles (= Musikdateien) steht, ist für die offenbar Spitzweg’schen Enzyklopäden, aus denen sich der ideale Klassikkonsument im Käuferprofil zu rekrutieren scheint, schon allein wegen der verminderten Tonqualität indiskutabel.“"
                            },
                            {
                                "example_id": "a67e31db-a766-4d56-a49c-6544e41f3cff",
                                "sense_id": "dc8ce056-1ad5-3503-b904-51bfe4b4a029",
                                "text": "„Es ist längst Zeit, das, was in der Goodwill-Sprache des Sozialstaats „Förderung der Migrantenkultur“ heißt, aus der Pflicht zu befreien, sozialtherapeutisch zu sein. Wenn Menschen „nichtdeutscher Herkunft“, so das Gruselwort, in Deutschland Theater machen, dann nicht als verlängerter Arm der Integrationsbeauftragten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
