        "fr-extract.jsonl": [
            {
                "entry_id": "896847d2-8ce3-37b8-98bc-dd46b5e148fe",
                "word": "quadrivium",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7f108f64-6647-3834-875e-0ca50e3a77de",
                        "entry_id": "896847d2-8ce3-37b8-98bc-dd46b5e148fe",
                        "glosses": [
                            "Partie de l’enseignement du Moyen Âge qui comprenait l’arithmétique, la musique, la géométrie et l’astronomie réunies sous le nom des quatre arts mathématiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47a3e7d6-6589-479f-9a4a-62d81d45c782",
                                "sense_id": "7f108f64-6647-3834-875e-0ca50e3a77de",
                                "text": "Son homologue européen maîtrisait le trivium (grammaire, rhétorique et logique) ainsi que le quadrivium (musique, géométrie, astronomie et arithmétique)."
                            },
                            {
                                "example_id": "cc206a42-acf6-4839-8145-4e78367696b3",
                                "sense_id": "7f108f64-6647-3834-875e-0ca50e3a77de",
                                "text": "Ils m’ont enseigné le quadrivium et je suis devenu docteur en philosophie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8368636e-290f-47b8-bfb0-21631c63669b",
                        "source_entry_id": "896847d2-8ce3-37b8-98bc-dd46b5e148fe",
                        "source_sense_id": "7f108f64-6647-3834-875e-0ca50e3a77de",
                        "target_lang_word": "quadrivium",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadrivium",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "779180cc-d78d-39da-bc23-6d5c81c0c3e9",
                                        "entry_id": "1ae6856f-2914-3ad0-9882-032168c89e6c",
                                        "glosses": [
                                            "The higher division of the seven liberal arts in the Middle Ages, composed of geometry, astronomy, arithmetic, and music."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bfbbaa9-58de-4010-a831-6fb5f57cfa6a",
                                                "sense_id": "779180cc-d78d-39da-bc23-6d5c81c0c3e9",
                                                "text": "As to the nature of his studies, there can be no doubt that he [Dante] went through the trivium (grammar, dialectic, rhetoric) and the quadrivium (arithmetic, music, geometry, and astronomy) of the then ordinary university course."
                                            },
                                            {
                                                "example_id": "9a6ccd7f-5e17-47ce-a34a-4b8bf8601a9f",
                                                "sense_id": "779180cc-d78d-39da-bc23-6d5c81c0c3e9",
                                                "text": "The riddle of existence is the college curriculum that was laid before the Pharaohs, that was taught in the groves by Plato, that formed the trivium and quadrivium, and is to-day laid before the freedmen’s sons by Atlanta University."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
