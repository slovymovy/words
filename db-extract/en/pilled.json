                        "examples": [
                            {
                                "example_id": "dcbdc96d-c1b1-4ff9-8491-f8e2c0ea5507",
                                "sense_id": "4f8d006b-6e2b-3735-8835-64c9e9d4f531",
                                "text": "Remember when I was bumming around Chelsea on the purple hearts! The chicks there thought I was God's gift to their little bohemia. A real devil. ‘I'm pilled to the gills,’ I'd tell them and their little eyes would grow as big as plates."
                            },
                            {
                                "example_id": "e04199d5-a763-4c73-bd3f-bd3f01b29337",
                                "sense_id": "4f8d006b-6e2b-3735-8835-64c9e9d4f531",
                                "text": "I never give these randy bastards a second glance when I'm dancing because when I'm pilled sex is too slow and anyway my legs are like rubber and I feel like I can out-dance anyone."
                            }
                        ]
                    },
