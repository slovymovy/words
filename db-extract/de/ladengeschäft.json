                "senses": [
                    {
                        "sense_id": "22698816-c4aa-32be-9a32-224e9633601b",
                        "entry_id": "c4377a05-021e-30ec-b40e-b1a5e2f30caa",
                        "glosses": [
                            "in einem Ladenlokal betriebenes Geschäft des Einzelhandels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b43bbe59-a062-41a8-a8c0-131231853b61",
                                "sense_id": "22698816-c4aa-32be-9a32-224e9633601b",
                                "text": "Das Ladengeschäft ist normalerweise ab zehn für Kunden geöffnet."
                            },
                            {
                                "example_id": "b1df6e71-c9bf-4a96-aba5-c655ece4f3e4",
                                "sense_id": "22698816-c4aa-32be-9a32-224e9633601b",
                                "text": "„An diesem Morgen war der Schwiegersohn Tschen Djing-dji aus dem Ladengeschäfte gekommen, um Kleidungsstücke zu holen.“"
                            },
                            {
                                "example_id": "ed505b7f-8b56-4979-81f2-40542c0eb923",
                                "sense_id": "22698816-c4aa-32be-9a32-224e9633601b",
                                "text": "„Die Eigentümer des ursprünglich kleinen, altmodischen Ladengeschäfts hatten auf den steten Strom an Touristen reagiert, und so war die Bäckerei heute mehr ein großes Café, mit einem weiteren Raum, in dem Live-Übertragungen von Sport-Events gezeigt wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
