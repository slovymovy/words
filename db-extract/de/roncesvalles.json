                                        "entry_id": "e8ccf62c-d5ef-3f6d-8143-fc933755c804",
                                        "glosses": [
                                            "Commune d’Espagne, située dans la Communauté de Navarre siège d’une célèbre bataille entre les Carolingiens et les Vascons où l'arrière-garde de l'armée de Charlemagne, conduite par Roland, y fut battue et mise en déroute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60748959-ca89-44b3-877f-e542907ce570",
                                                "sense_id": "9261ffea-a250-36fe-9934-aa1c43ec48b6",
                                                "text": "Le col de Roncevaux, situé à une cinquantaine de kilomètres au nord de Pampelune, correspond à l'ancien passage axial d'Ibañeta à 1 066 m d'altitude, voie de passage naturel utilisée depuis la préhistoire pour accéder à la péninsule Ibérique."
                                            }
                                        ]
                                    }
                                ]
                            }
