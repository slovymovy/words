                                        "glosses": [
                                            "mit voller Zustimmung, ohne Gegenstimmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0e2794a-270e-4f20-b3a5-95cd0f337af6",
                                                "sense_id": "3ab5738d-aa33-36aa-891a-f1d09eb321ed",
                                                "text": "„Am vergangenen Donnerstag hat der NSA-Untersuchungsausschuss des Bundestags einstimmig die Befragung Snowdens beschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b2574eb-2216-3f10-b9db-cea03ae3cb92",
                                        "entry_id": "c06008e4-de9b-3860-af7c-47a9d65189e8",
                                        "glosses": [
                                            "aus nur einer Stimme bestehend"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d0420f8-e4fd-497e-9b7e-20614f3ff3f6",
                                                "sense_id": "3b2574eb-2216-3f10-b9db-cea03ae3cb92",
                                                "text": "„Dieses Ausnahme-Ensemble beeindruckt durch die Interpretation sowohl von einstimmigen und vor allem mehrstimmigen liturgischen Gesängen der orthodoxen Kirche, als auch von russischer und weißrussischer Musikliteratur.“"
                                            }
