                                        "glosses": [
                                            "Material which has been ejected, especially from a volcano or an impact crater."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b7eadb-9dfa-4141-9076-ed50458c3f73",
                                                "sense_id": "cd9c3e00-189f-35c7-8021-69e5b7581e8d",
                                                "text": "Distal ejecta are, by definition, those ejecta that occur at considerable distances from the source crater (>5 crater radii from the crater rim; see, e.g., Melosh 1989). They either consist of (usually fine-grained) rock and mineral fragments or are of glassy consistency."
                                            }
