                "word_linkages": []
            },
            {
                "entry_id": "7fe8ee0f-306e-3bdd-97ea-dff76a2ffe65",
                "word": "cochonne",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3ec04e1d-9b01-4742-b458-d12744968146",
                        "entry_id": "7fe8ee0f-306e-3bdd-97ea-dff76a2ffe65",
                        "tags": [
                            "plural"
                        ],
                        "form": "cochonnes"
                    },
                    {
                        "form_id": "e1bd4da8-d3af-4e2e-b04d-5237bdd34cf9",
                        "entry_id": "7fe8ee0f-306e-3bdd-97ea-dff76a2ffe65",
                        "tags": [
                            "masculine"
                        ],
                        "form": "cochon"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a76dacde-3b01-3e56-929b-1a7b1d14ff66",
                        "entry_id": "7fe8ee0f-306e-3bdd-97ea-dff76a2ffe65",
                        "glosses": [
                            "Femelle du cochon."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a1e1414c-c61d-4c04-aea8-ea1b0d582493",
                                "sense_id": "a76dacde-3b01-3e56-929b-1a7b1d14ff66",
                                "text": "Je soutenais avec lui qu’il n’y avait pas de mère de famille plus touchante dans sa maternité que la cochonne blanche et rose allaitant ses douze enfants."
                            }
                        ]
                    },
                    {
                        "sense_id": "9ac302a8-00ec-3437-8c8e-67c63ba71060",
                        "entry_id": "7fe8ee0f-306e-3bdd-97ea-dff76a2ffe65",
                        "glosses": [
                            "Femme particulièrement sale."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "4e544d41-c195-43fb-83e1-d7a1290f3337",
                                "sense_id": "9ac302a8-00ec-3437-8c8e-67c63ba71060",
                                "text": "Mais quand même, Lolo, c’est une petite cochonne ! Parce que Lolo, elle a beau avoir cinq ans, elle n’est pas propre !"
                            },
                            {
                                "example_id": "acc75cec-1310-46f7-ac3c-4c294b55fc2e",
                                "sense_id": "9ac302a8-00ec-3437-8c8e-67c63ba71060",
                                "text": "Mᵐᵉ V est une grosse cochonne et je ne dis pas ça gratuitement ou méchamment. Mais une personne qui laisse échapper une louche complète de sauce aux tomates dans la cuisine et qui ne se penche même pas pour ramasser son dégât […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "936467b9-3d10-3c6a-84e0-74ff04ee2705",
                        "entry_id": "7fe8ee0f-306e-3bdd-97ea-dff76a2ffe65",
                        "glosses": [
                            "Femme portée sur le sexe mais aussi homme -généralement gay- porté sur le sexe."
                        ],
                        "tags": [
                            "figuratively",
                            "offensive",
                            "pejorative",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "4f30a8c5-9400-4b0e-a6cf-959954335a80",
                                "sense_id": "936467b9-3d10-3c6a-84e0-74ff04ee2705",
                                "text": "La petite cochonne sortit ma bite qu’elle avala aussitôt. Une sensation de chaleur me pénétra, j’oubliai la forêt, les fœtus et même les sangliers."
                            },
                            {
                                "example_id": "dfde5b4e-2bd7-4384-bf87-cbd9bc5a5ace",
                                "sense_id": "936467b9-3d10-3c6a-84e0-74ff04ee2705",
                                "text": "J'ai toujours voulu être une petite cochonne comme pédé."
                            },
                            {
                                "example_id": "2dfd1338-b194-464d-990e-0e098343bef8",
                                "sense_id": "936467b9-3d10-3c6a-84e0-74ff04ee2705",
                                "text": "Nora regardait Capucine se trémousser sur les genoux du majordome avec une moue dégoûtée.\n— Tu fais une belle cochonne, ma Capu, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "c7bf3770-9681-3583-a3a9-146cd243aff5",
                        "entry_id": "7fe8ee0f-306e-3bdd-97ea-dff76a2ffe65",
                        "glosses": [
                            "Femme faisant preuve d’indécence."
                        ],
                        "tags": [
                            "figuratively",
                            "offensive",
                            "pejorative",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "e08e327b-1b4a-43e8-aa16-203ad1dbaa65",
                                "sense_id": "c7bf3770-9681-3583-a3a9-146cd243aff5",
                                "text": "Habille-toi un peu, grosse cochonne, tu es indécente !"
                            },
                            {
                                "example_id": "4cf50972-d225-4a14-9867-99b8496e8faf",
                                "sense_id": "c7bf3770-9681-3583-a3a9-146cd243aff5",
                                "text": "Si encore tu portais un slip… grosse cochonne !"
                            }
                        ]
                    },
                    {
                        "sense_id": "1b6bb015-f5ac-3540-a92f-4e3a0049c94d",
                        "entry_id": "7fe8ee0f-306e-3bdd-97ea-dff76a2ffe65",
                        "glosses": [
                            "Femme ayant de mauvaises manières."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "9ba90cf8-ea9e-4fbc-a417-0e05f4cb63cd",
                                "sense_id": "1b6bb015-f5ac-3540-a92f-4e3a0049c94d",
                                "text": "Grosse cochonne, Vous pétez devant Jésus, Vous aurez le cul cousu."
                            }
                        ]
                    }
                ],
