{
    "word_family": [
        "contender",
        "contention",
        "contentious"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a523a28-7eb5-34c3-b15b-c4ff12e23e1e",
                    "sense_definition": "To state or assert a position strongly as part of an argument.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "argumentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The defense lawyers <w>contend</w> that their client was not even in the city when the crime occurred.",
                            "target_lang_translations": {
                                "ru": "Адвокаты защиты <w>утверждают</w>, что их подзащитного даже не было в городе, когда произошло преступление."
                            }
                        },
                        {
                            "text": "Many critics <w>contend</w> that the new policy will actually increase costs rather than reduce them.",
                            "target_lang_translations": {
                                "ru": "Многие критики <w>заявляют</w>, что новая политика на самом деле приведет к росту расходов, а не к их сокращению."
                            }
                        }
                    ],
                    "synonyms": [
                        "assert",
                        "aver",
                        "dispute"
                    ],
                    "antonyms": [
                        "concede",
                        "deny"
                    ],
                    "common_phrases": [
                        "contend that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердо заявлять или отстаивать свою позицию в рамках спора или аргументации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утверждать",
                                "target_lang_sense_clarification": "уверенно высказывать мнение"
                            },
                            {
                                "target_lang_word": "заявлять",
                                "target_lang_sense_clarification": "официально или открыто высказывать позицию"
                            },
                            {
                                "target_lang_word": "настаивать",
                                "target_lang_sense_clarification": "упорно доказывать свою правоту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2ae4876-ecbe-3ce0-a284-1002519b39c3",
                    "sense_definition": "To struggle to surmount or deal with a difficulty or obstacle.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rescue team had to <w>contend</w> with freezing temperatures and heavy snow throughout the night.",
                            "target_lang_translations": {
                                "ru": "Спасателям пришлось <w>бороться</w> с минусовой температурой и сильным снегопадом на протяжении всей ночи."
                            }
                        },
                        {
                            "text": "Small businesses often have to <w>contend</w> with many challenges during their first year of operation.",
                            "target_lang_translations": {
                                "ru": "Малому бизнесу часто приходится <w>справляться</w> со множеством трудностей в течение первого года работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "struggle",
                        "strive"
                    ],
                    "antonyms": [
                        "surrender",
                        "yield"
                    ],
                    "common_phrases": [
                        "contend with challenges",
                        "contend with difficulties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прилагать усилия для преодоления трудностей или решения проблем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "противостоять трудностям или обстоятельствам"
                            },
                            {
                                "target_lang_word": "справляться",
                                "target_lang_sense_clarification": "преодолевать препятствия"
                            },
                            {
                                "target_lang_word": "сталкиваться",
                                "target_lang_sense_clarification": "иметь дело с проблемами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33196e38-a400-31e6-b76d-d69e6b288aaf",
                    "sense_definition": "To compete with others in a struggle for power or victory.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "competition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Three main candidates will <w>contend</w> for the leadership of the party in the upcoming election.",
                            "target_lang_translations": {
                                "ru": "Три основных кандидата будут <w>бороться</w> за лидерство в партии на предстоящих выборах."
                            }
                        },
                        {
                            "text": "The two athletes will <w>contend</w> for the gold medal in the final race tomorrow.",
                            "target_lang_translations": {
                                "ru": "Завтра в финальном забеге два атлета будут <w>соперничать</w> за золотую медаль."
                            }
                        }
                    ],
                    "synonyms": [
                        "vie",
                        "contest",
                        "fight",
                        "combat"
                    ],
                    "antonyms": [
                        "cooperate",
                        "collaborate"
                    ],
                    "common_phrases": [
                        "contend for power",
                        "contend for the title"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соревноваться с другими в борьбе за власть, победу или награду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соперничать",
                                "target_lang_sense_clarification": "быть конкурентом в борьбе за что-либо"
                            },
                            {
                                "target_lang_word": "бороться",
                                "target_lang_sense_clarification": "активно состязаться за победу"
                            },
                            {
                                "target_lang_word": "претендовать",
                                "target_lang_sense_clarification": "заявлять права на победу или титул"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f474fca1-82e0-368a-9940-1a3c1eaee9e2",
                    "sense_definition": "To engage in a heated debate or verbal dispute.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "argumentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholars continue to <w>contend</w> about the true meaning of the ancient text.",
                            "target_lang_translations": {
                                "ru": "Ученые продолжают <w>спорить</w> об истинном значении древнего текста."
                            }
                        },
                        {
                            "text": "It is useless to <w>contend</w> about such trivial matters when we have more important work to do.",
                            "target_lang_translations": {
                                "ru": "Бесполезно <w>препираться</w> по таким пустякам, когда у нас есть более важная работа."
                            }
                        }
                    ],
                    "synonyms": [
                        "dispute",
                        "debate",
                        "litigate"
                    ],
                    "antonyms": [
                        "agree",
                        "concur"
                    ],
                    "common_phrases": [
                        "contend about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в жаркой дискуссии или словесном споре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спорить",
                                "target_lang_sense_clarification": "вести дискуссию или дебаты"
                            },
                            {
                                "target_lang_word": "дискутировать",
                                "target_lang_sense_clarification": "обсуждать спорный вопрос"
                            },
                            {
                                "target_lang_word": "препираться",
                                "target_lang_sense_clarification": "спорить по пустякам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}