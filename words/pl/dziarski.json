                    "sense_definition": "pełen energii, wigoru i pewności siebie, wykazujący dużo sił witalnych",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "energia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mimo podeszłego wieku mój dziadek to wciąż niezwykle <w>dziarski</w> staruszek.",
                            "target_lang_translations": {
                                "ru": "Несмотря на преклонный возраст, мой дедушка всё ещё необычайно <w>бодрый</w> старик."
                            }
                        },
                        {
                            "text": "Do pokoju wszedł <w>dziarski</w> młodzieniec z szerokim uśmiechem na twarzy.",
                            "target_lang_translations": {
                                "ru": "В комнату вошёл <w>бравый</w> юноша с широкой улыбкой на лице."
                            }
                        }
                    ],
                    "synonyms": [
