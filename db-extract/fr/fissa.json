                                ]
                            },
                            {
                                "target_word": "stat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a745b85f-c6eb-39ed-b7ed-712042db8178",
                                        "entry_id": "ed7897a0-d5e7-3e92-a131-6affd4360bcc",
                                        "glosses": [
                                            "Clipping of photostat."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bbda010-1f41-4f99-9373-41cac2bd22eb",
                                                "sense_id": "a745b85f-c6eb-39ed-b7ed-712042db8178",
                                                "text": "These Poloroids ^([sic]) are then enlarged by a stat camera or a copier with an enlarging feature, colored electrographically, transferred to acetate pieces, and fused or sewn together into quilts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "daf73ce9-1cfb-381a-a7d1-b3e2b975d6c6",
                                        "entry_id": "8c2c0b5d-ae08-346a-8547-4c8ee3809f80",
                                        "glosses": [
                                            "Clipping of photostat."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14da2436-6ee6-4b55-9101-6e0fcaa2d30b",
                                                "sense_id": "daf73ce9-1cfb-381a-a7d1-b3e2b975d6c6",
                                                "text": "These overlays were then statted using a screen of etched glass to break up the solid black into small rows of black dots. A different sized screen was used to create a different sized dot for each percentage."
                                            }
                                        ]
