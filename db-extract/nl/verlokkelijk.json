                "senses": [
                    {
                        "sense_id": "8750795f-a736-31f3-a5cb-169ff255db25",
                        "entry_id": "39887277-2c28-3af9-9b7d-bf948824a195",
                        "glosses": [
                            "iets dat zeer aantrekkelijk lijkt, maar misschien toch niet zo goed is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05d4d433-5fe1-4809-9315-c344744adf15",
                                "sense_id": "8750795f-a736-31f3-a5cb-169ff255db25",
                                "text": "Met gelikte brochures en gladde keukentafelgesprekken werden klanten verleid in te stappen. Voorgespiegelde vergezichten waren zo verlokkelijk dat sommigen hun hypotheek verhoogden. Er werd 3,2 miljoen ingelegd."
                            },
                            {
                                "example_id": "85420bfb-8cc0-4851-9d7d-0516112137ee",
                                "sense_id": "8750795f-a736-31f3-a5cb-169ff255db25",
                                "text": "Aanzwellende orgels, smachtende koortjes en prikkelende drums vormen de stuwende basis voor McMorrows vocale glijvluchten. McMorrow heeft een verlokkelijke stem waar veel schakeringen van smachten, kermen en hunkeren in doorklinken. Soms valt hij over de rand van het sentiment, zoals bij Gold, de enige wanklank op de nieuwe cd. Voor het overige is Post Tropical een mooi afgewogen, rijk avontuur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9fbf306-3f42-40d5-b7c3-157ea3758770",
                        "source_entry_id": "39887277-2c28-3af9-9b7d-bf948824a195",
                        "source_sense_id": "8750795f-a736-31f3-a5cb-169ff255db25",
