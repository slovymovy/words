                                            {
                                                "example_id": "d99b014c-49f9-4034-a0ef-2d771577ae3a",
                                                "sense_id": "22db1e7a-784d-3849-8a10-85069e08302c",
                                                "text": "La succession a lieu par parentèles, groupes de personnes issues d'un auteur commun."
                                            },
                                            {
                                                "example_id": "84d52850-0f56-4726-ab52-a3812d0332e7",
                                                "sense_id": "22db1e7a-784d-3849-8a10-85069e08302c",
                                                "text": "La recherche en parentèle a été employée pour la première fois dans une autre affaire qui a défrayé la chronique : le meurtre d’Élodie Kulik."
                                            },
                                            {
                                                "example_id": "8e6a0219-e0b6-4ee0-a97f-4a6cc33ee078",
                                                "sense_id": "22db1e7a-784d-3849-8a10-85069e08302c",
                                                "text": "La recherche par ADN de parentèle, qui permet d'identifier un suspect en passant par le profil génétique d'un ascendant ou descendant direct présent dans le FNAEG, a également échoué."
