                },
                {
                    "sense_id": "5147a9d5-b1f3-3717-bb07-82d126a655fa",
                    "sense_definition": "Popular or successful.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "popularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new fashion style is very <w>big</w> right now in Europe.",
