                                    {
                                        "sense_id": "65dce5bc-4d4d-31db-b839-0155e4ec9dcc",
                                        "entry_id": "7b1ad68b-a5c0-3dc6-b9f7-71ef661f7a1b",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de prospérer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d85c45-adbd-496b-93ac-c801dc3fb7eb",
                                                "sense_id": "65dce5bc-4d4d-31db-b839-0155e4ec9dcc",
                                                "text": "Vous souhaitez que la misère prospère, car la misère, c’est votre fonds de commerce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b82288c-e5c5-3512-94ef-20864f390e2e",
                                        "entry_id": "7b1ad68b-a5c0-3dc6-b9f7-71ef661f7a1b",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif de prospérer."
                                        ],
