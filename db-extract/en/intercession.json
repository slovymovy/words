                                "target_senses": [
                                    {
                                        "sense_id": "0a5a42fd-328d-312f-b4d4-a7af046f547b",
                                        "entry_id": "31d7b911-1e43-311c-b184-d966d47b838d",
                                        "glosses": [
                                            "Bemühung zugunsten einer anderen Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5997199c-461c-4b86-8fe1-d3f41db782d6",
                                                "sense_id": "0a5a42fd-328d-312f-b4d4-a7af046f547b",
                                                "text": "„Die Fürsprache eines Landtagsabgeordneten, so hoffte sie, würde vielleicht Eindruck machen und den Vater umstimmen.“"
                                            },
                                            {
                                                "example_id": "66f35227-5dc4-4e5e-867e-1ff4b805689e",
                                                "sense_id": "0a5a42fd-328d-312f-b4d4-a7af046f547b",
                                                "text": "„Die vier Männer Tschö Dan und Genossen hätten wiederholt Fürsprache gesucht und gebeten, sie maßvoll zu behandeln.“"
                                            },
                                            {
                                                "example_id": "3a9afec0-5ca3-4a8c-aab0-0d3265f8ec8b",
                                                "sense_id": "0a5a42fd-328d-312f-b4d4-a7af046f547b",
                                                "text": "„Dabei zeigte sie mir die Papiere einer anderen Dame, der sie ihre Fürsprache zugesagt hatte; aber sie versprach mir, sie mir zu opfern, und sie hielt Wort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
