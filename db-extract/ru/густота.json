                                "target_senses": [
                                    {
                                        "sense_id": "33c3f760-61fe-3b92-8572-498d458d15fa",
                                        "entry_id": "e9c004a2-d326-3928-bbe1-6d9d3c39066b",
                                        "glosses": [
                                            "The property of being thick (in dimension)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11b24e5f-d3b3-3128-a329-e8785bc1b96f",
                                        "entry_id": "e9c004a2-d326-3928-bbe1-6d9d3c39066b",
                                        "glosses": [
                                            "A measure of how thick (in dimension) something is."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a55e6c78-77cf-4832-acd7-13defdbf181b",
                                                "sense_id": "11b24e5f-d3b3-3128-a329-e8785bc1b96f",
                                                "text": "The thickness of the Earth's crust varies from two to 70 kilometres."
                                            },
                                            {
                                                "example_id": "56474037-beb2-4a55-a0cb-e7fa75708300",
                                                "sense_id": "11b24e5f-d3b3-3128-a329-e8785bc1b96f",
                                                "text": "Guitar picks come in different thicknesses."
                                            },
                                            {
                                                "example_id": "fa0a8c71-88ae-4281-8930-8ea8d40cb223",
                                                "sense_id": "11b24e5f-d3b3-3128-a329-e8785bc1b96f",
                                                "text": "The newest form of gold created in a lab is the thickness of two atoms, according to a new study. It’s only 0.47 nanometers thick, which is one million times thinner than a human finger nail."
                                            },
                                            {
                                                "example_id": "96a63d84-f21e-4de6-accb-2bf01dfc4ef1",
                                                "sense_id": "11b24e5f-d3b3-3128-a329-e8785bc1b96f",
                                                "text": "Whether made by a small business or a household name like Scotch, washi tape comes in countless colors, patterns and thicknesses and can be used for just as many adhesive-related projects, from decorating envelopes and empty jars to creating section dividers and adhering photos/ephemera in journals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d3342c4-15c3-3b8b-bbc8-0ebf3ef65aa9",
                                        "entry_id": "e9c004a2-d326-3928-bbe1-6d9d3c39066b",
                                        "glosses": [
                                            "A layer."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ba4e055-e130-4982-addf-7823230344b5",
                                                "sense_id": "4d3342c4-15c3-3b8b-bbc8-0ebf3ef65aa9",
                                                "text": "We upholstered the seat with three thicknesses of cloth to make it more comfortable to sit on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3622e0a6-44b1-3aa8-a78f-927a4116988f",
                                        "entry_id": "e9c004a2-d326-3928-bbe1-6d9d3c39066b",
                                        "glosses": [
                                            "The quality of being thick (in consistency)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69a15a29-0332-47b3-bedf-cf89846c6176",
                                                "sense_id": "3622e0a6-44b1-3aa8-a78f-927a4116988f",
                                                "text": "Whip the cream until it reaches a good thickness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9b3b942-4618-3521-9688-27b7a3bc7d9a",
                                        "entry_id": "e9c004a2-d326-3928-bbe1-6d9d3c39066b",
                                        "glosses": [
                                            "The property of being thick (slow to understand)."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61615d38-d598-306e-b665-8dec00eca484",
                                        "entry_id": "e9c004a2-d326-3928-bbe1-6d9d3c39066b",
                                        "glosses": [
                                            "The minimum number of planar subgraphs which a given graph can decompose into."
                                        ],
