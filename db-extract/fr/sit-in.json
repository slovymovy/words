                "senses": [
                    {
                        "sense_id": "824f2da3-bb24-3a05-9f33-8ed74073757a",
                        "entry_id": "7789e173-4486-3fc5-880e-54202b020c7c",
                        "glosses": [
                            "Manifestation consistant à s’asseoir sur la voie publique à un endroit bien précis."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "90f4a3c6-d7b8-4c0a-9dc0-5596520577aa",
                                "sense_id": "824f2da3-bb24-3a05-9f33-8ed74073757a",
                                "text": "Mais la mise au bloc de Mohammed suffirait-elle à dissuader les autres de prolonger leur sit-in ?",
                                "translation": "Alain Demouzon, Monsieur Abel, 1979, section Dimanche 9 septembre, 9 heures du matin"
                            },
                            {
                                "example_id": "7a611316-8438-4c8a-aa79-38e703e1ef84",
                                "sense_id": "824f2da3-bb24-3a05-9f33-8ed74073757a",
                                "text": "Une autre forme de l'opposition étudiante est représentée par les teach-ins, sit-ins, love-ins bien connus."
                            },
                            {
                                "example_id": "4d47fee2-ea11-42de-a101-ac5f17070d1b",
                                "sense_id": "824f2da3-bb24-3a05-9f33-8ed74073757a",
                                "text": "Le sit-in qui se tient depuis le dimanche 20 février à la Kasbah n’est pas sans rappeler celui qui a eu lieu il y a un mois, au même endroit, et qui a réuni des manifestants de tout le pays."
                            }
                        ]
                    }
                ],
