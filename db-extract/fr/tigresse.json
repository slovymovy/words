                        ],
                        "form": "tigresses"
                    },
                    {
                        "form_id": "e89a4bbd-1ca2-4190-be80-5b5e95790f6a",
                        "entry_id": "c7d3292b-a25d-3051-87fc-e4654782da28",
                        "tags": [
                            "masculine"
                        ],
                        "form": "tigre"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fadc7a4-1838-3b3f-8050-610f8fcc51b1",
                        "entry_id": "c7d3292b-a25d-3051-87fc-e4654782da28",
                        "glosses": [
                            "Femelle du tigre."
                        ],
                        "tags": [
                            "Félinologie"
                        ],
                        "examples": [
                            {
                                "example_id": "83b4d487-19d7-4e05-ac11-f87bab78981a",
                                "sense_id": "6fadc7a4-1838-3b3f-8050-610f8fcc51b1",
                                "text": "Pour Mogambo, un tigreau représente un obstacle entre lui et sa femelle, un gêneur, voire une proie bonne à dévorer. La tigresse le sait, elle a défendu ses petits."
                            }
                        ]
                    },
                    {
                        "sense_id": "04f798be-be68-3dd8-a9c0-4c1b53adafbc",
                        "entry_id": "c7d3292b-a25d-3051-87fc-e4654782da28",
                        "glosses": [
                            "Femme violente."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "081f1f27-b764-4a1c-a695-e09c72093354",
                                "sense_id": "04f798be-be68-3dd8-a9c0-4c1b53adafbc",
                                "text": "Voilà une tigresse ! s’écria celle-ci, lui rendant enfin sa liberté. Allez vous-en, pour l’amour de Dieu, et cachez votre maudite figure ! Quelle folie de révéler devant lui ces griffes !"
                            }
                        ]
                    },
                    {
                        "sense_id": "e24dcd5d-f65f-3d02-b69c-1b3e0294219e",
                        "entry_id": "c7d3292b-a25d-3051-87fc-e4654782da28",
                        "glosses": [
                            "Femme très sensuelle et très attirante."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "206c034d-ab30-428f-a77f-2795ad73bcd7",
                                "sense_id": "e24dcd5d-f65f-3d02-b69c-1b3e0294219e",
                                "text": "J’ai un corps de tigresse ; saurez-vous m’apprivoiser ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96d5059a-055e-499d-88ef-1daa4ae125fb",
                        "source_entry_id": "c7d3292b-a25d-3051-87fc-e4654782da28",
                        "source_sense_description": "Femelle du tigre",
                        "target_lang_word": "Tigerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tigerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "577b55bc-068a-3f5b-a720-9325062b7319",
                                        "entry_id": "e9077549-927a-3816-ae4c-e814afea6ab5",
                                        "glosses": [
                                            "weiblicher Tiger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e37baa1-10c5-43bd-9bc6-74bb8c53044b",
                                                "sense_id": "577b55bc-068a-3f5b-a720-9325062b7319",
                                                "text": "„In Indien ist eine Tigerin, die zuvor vier Menschen getötet und gefressen haben soll, bei einem Unfall getötet worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "860cb292-1ecb-459c-8b84-fd34e9172291",
                        "source_entry_id": "c7d3292b-a25d-3051-87fc-e4654782da28",
                        "source_sense_description": "Femelle du tigre",
                        "target_lang_word": "tigress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tigress",
