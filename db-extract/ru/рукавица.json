                                    {
                                        "sense_id": "21c4e3b9-09c0-3109-8ebe-d0be8b44eef2",
                                        "entry_id": "6855d2af-ac75-3f1c-b18d-6a092f53daaf",
                                        "glosses": [
                                            "Machine, formée d’un assemblage de plusieurs poulies, qui sert à élever et à descendre des poids considérables."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "note": "Les mécaniciens emploient généralement ce mot au masculin",
                                        "examples": [
                                            {
                                                "example_id": "3f14f5ff-0606-4ffc-a3c7-5d2337fdad1c",
                                                "sense_id": "21c4e3b9-09c0-3109-8ebe-d0be8b44eef2",
                                                "text": "Lever un fardeau avec une moufle, avec des moufles."
                                            },
                                            {
                                                "example_id": "86a794fe-0bf5-4c8a-882e-6806f722c3fc",
                                                "sense_id": "21c4e3b9-09c0-3109-8ebe-d0be8b44eef2",
                                                "text": "Le système d est le moufle d’Archimède : P agit sur deux cordes ; chacune d’elles porte ½P, mais l’une de ces cordes agit de la même manière sur deux autres et ainsi de suite, de sorte que l’équilibre est maintenu par une charge égale à ⅛P."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6b24e8b-01ef-33c9-b2a8-f875236443c7",
                                        "entry_id": "6855d2af-ac75-3f1c-b18d-6a092f53daaf",
                                        "glosses": [
                                            "Pour un appareil de levage, treuil ou palan, la moufle est la pièce qui est équipée d'une ou plusieurs poulies et à laquelle est accroché le crochet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4229dc06-f926-4a18-b5e3-39150c188d73",
                                                "sense_id": "a6b24e8b-01ef-33c9-b2a8-f875236443c7",
                                                "text": "Pour limiter la puissance installée, ce palan, ce treuil est équipé d’un mouflage à deux brins (une poulie dans la moufle), à 4 (2 poulies), 6 (3 poulies) , ou à 8 brins (4 poulies) etc. suivant la capacité de levage prévue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a56ec5a9-a9fb-34e8-9dc1-b331891898c7",
                                        "entry_id": "6855d2af-ac75-3f1c-b18d-6a092f53daaf",
                                        "glosses": [
                                            "Barre de fer noyée dans la maçonnerie d’une maison et qui sert à empêcher l’écartement de deux murs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1b26c05-8dee-3b32-8122-32109b7e220d",
                                        "entry_id": "6855d2af-ac75-3f1c-b18d-6a092f53daaf",
                                        "glosses": [
                                            "Gant épais de cuir ou de laine où il n’y a pas de séparation pour les doigts, excepté pour le pouce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed11bea-0fa6-403d-81bf-e0a783286e81",
                                                "sense_id": "f1b26c05-8dee-3b32-8122-32109b7e220d",
                                                "text": "J’enfonçai aussi mes mains dans les moufles jusqu’aux coudes."
                                            },
                                            {
                                                "example_id": "ad20e869-aa66-4a07-8492-363c11dcc2c9",
                                                "sense_id": "f1b26c05-8dee-3b32-8122-32109b7e220d",
                                                "text": "J'ai des moufles islandaises, mais Evans n'en a point, et je l'entends grommeler entre les dents ; apitoyé sur son sort , je lui passe une de mes moufles, qui s'adapte également aux deux mains, chaque moufle étant munie de deux pouces."
                                            },
                                            {
                                                "example_id": "dd2df513-6e9a-4193-a50d-f2eeb61b7353",
                                                "sense_id": "f1b26c05-8dee-3b32-8122-32109b7e220d",
                                                "text": "J’ai préparé mes moufles ; notre pilote des glaces en a fait autant."
                                            },
                                            {
                                                "example_id": "d1233ca6-36fe-4f64-872c-4e47d3e4910d",
                                                "sense_id": "f1b26c05-8dee-3b32-8122-32109b7e220d",
                                                "text": "– Ils me demandent de faire des gants à trois doigts pour les petits lépreux de Djakarta. C’est tout la Croix-Rouge ça ! Vous croyez pas que j’aurais plus vite fait de faire des moufles ?\n– Entre nous Thérèse, une bonne paire de chaussettes et hop ! Oh ! On dit de ces bêtises parfois…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "moufle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c415af3-6a87-33e2-a04c-f471801b47a4",
                                        "entry_id": "b28c3cc2-cc1b-3b20-b799-469ab7174b8f",
                                        "glosses": [
                                            "Récipient de terre dont on se sert pour exposer des corps à l’action du feu, sans que la flamme y touche directement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f3d875d-957e-4425-9ad8-dfff31ec1aad",
                                                "sense_id": "9c415af3-6a87-33e2-a04c-f471801b47a4",
                                                "text": "Lorsque le moufle est froid, démoufler avec précaution, surtout si les pièces ne sont pas de dépouille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68493410-0fd0-380e-8a2e-a67d964c2e58",
                                        "entry_id": "b28c3cc2-cc1b-3b20-b799-469ab7174b8f",
                                        "glosses": [
                                            "Four utilisé pour différentes opérations en particulier certains recuits du verre ou pour certaine poterie."
                                        ],
                                        "tags": [
                                            "Vitrerie",
                                            "Céramique"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "moufle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6da4e83d-7c9b-32b9-8a2e-53e3b6f2b059",
                                        "entry_id": "83a9a4ab-36e4-3831-b7f9-fcb70b3625d1",
                                        "glosses": [
                                            "Gros visage rond."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "moufle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9dc3080-a980-3174-b451-9263eea47407",
                                        "entry_id": "c41e3ac4-219c-3bf8-88b5-f54dfc94b158",
                                        "glosses": [
                                            "Moelleux en parlant du pain."
                                        ],
                                        "tags": [
                                            "Sud-Ouest",
                                            "Limousin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a12742bc-e422-4938-b0c6-d1aee524bf15",
                                                "sense_id": "b9dc3080-a980-3174-b451-9263eea47407",
                                                "text": "En parlant du pain , moufle signifie tendre."
                                            },
                                            {
                                                "example_id": "346a8297-1827-40ad-9d3b-a89ac75173ff",
                                                "sense_id": "b9dc3080-a980-3174-b451-9263eea47407",
                                                "text": "L'un aime mieux un pain “moufle”. Ou bien il préfère peut-être un pain à croûte très dure ; dans ce cas il lui faut un \"pistolet\" ou un \"bton\"."
                                            }
                                        ]
                                    }
                                ]
                            },
