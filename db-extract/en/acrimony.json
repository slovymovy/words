                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acrimonie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b8f0731-a982-3869-8bb9-9031c198f0c4",
                                        "entry_id": "9debca34-e7b6-3e83-bb21-5913e74b89cb",
                                        "glosses": [
                                            "Agressivité verbale due à une mauvaise humeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a701664-2157-4c64-a238-e3cc03a92b2e",
                                                "sense_id": "3b8f0731-a982-3869-8bb9-9031c198f0c4",
                                                "text": "Cet homme est désagréable, car il ne sait pas parler sans acrimonie (humeur agressive)."
                                            },
                                            {
                                                "example_id": "bb7e1f51-14ed-4bd3-986e-b826366bf200",
                                                "sense_id": "3b8f0731-a982-3869-8bb9-9031c198f0c4",
                                                "text": "Il y a de l’acrimonie dans son caractère, dans ses discours."
                                            },
                                            {
                                                "example_id": "bfced674-40e8-4156-bc1e-daddb8420ad7",
                                                "sense_id": "3b8f0731-a982-3869-8bb9-9031c198f0c4",
                                                "text": "Réclamer avec acrimonie."
                                            },
                                            {
                                                "example_id": "84360f7f-88b4-460f-944f-b20186244e4a",
                                                "sense_id": "3b8f0731-a982-3869-8bb9-9031c198f0c4",
                                                "text": "Je constate que vous n’avez aucune acrimonie contre moi. J’aurais été désolée que vous en eussiez."
                                            },
                                            {
                                                "example_id": "0333565d-9a08-445f-857f-176cd31bb797",
                                                "sense_id": "3b8f0731-a982-3869-8bb9-9031c198f0c4",
                                                "text": "On décèle, dans la position de Howard, une certaine acrimonie, voire une acrimonie certaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33f3fb26-0e37-3ee3-8dbc-068bc323b778",
                                        "entry_id": "9debca34-e7b6-3e83-bb21-5913e74b89cb",
                                        "glosses": [
                                            "Disposition à l’âcreté."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce1dd8a1-c2a3-40ea-932e-76ddf761ac91",
                                                "sense_id": "33f3fb26-0e37-3ee3-8dbc-068bc323b778",
                                                "text": "Les médecins ont disputé longtemps sur l’acrimonie des humeurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8a0724b-eac0-48ff-8799-02c8fc2705db",
                        "source_entry_id": "dce07cee-53ca-3014-8e1e-360e4fe0c15d",
