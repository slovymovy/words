                    {
                        "translation_id": "86cd8269-807f-4f59-938f-0d2a3d0e5751",
                        "source_entry_id": "e74bfd09-a6e5-3689-b184-47afab555f7f",
                        "source_sense_id": "7bef677b-161d-3528-bd81-4ec9de092d8c",
