                "senses": [
                    {
                        "sense_id": "ef2892f3-e7da-3e7d-b551-6f8348d9142a",
                        "entry_id": "bb017af5-8753-3e0d-a249-c7498cd9a3ec",
                        "glosses": [
                            "Donner un caractère gaussien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c712e656-b5d1-401f-b0eb-4b10910c22d4",
                                "sense_id": "ef2892f3-e7da-3e7d-b551-6f8348d9142a",
                                "text": "Notre deuxième méthode, basée sur une transformée stabilisatrice de variance (VST), permet de gaussianiser et stabiliser un processus poissonien filtré."
                            },
                            {
                                "example_id": "b3c61cef-ba42-4627-81dc-e22f8431c6a5",
                                "sense_id": "ef2892f3-e7da-3e7d-b551-6f8348d9142a",
                                "text": "De plus, les dépendances des composantes de x dans le modèle nécessitent de gaussianiser chaque composante indépendamment."
                            },
                            {
                                "example_id": "e6d6abf7-b8ab-4082-ba20-6fab8d55dde6",
                                "sense_id": "ef2892f3-e7da-3e7d-b551-6f8348d9142a",
                                "text": "Il nous faut donc trouver une transformée plus performante, c'est pourquoi, il peut être utile de gaussianiser le bruit dans le domaine des ondelettes."
                            }
                        ]
                    }
