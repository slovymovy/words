                        "tags": [
                            "Lire la note en bas de page concernant les variantes orthographiques"
                        ],
                        "form": "vermicel"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f12591a-7acf-3215-b8dd-bdcb6b31bb39",
                        "entry_id": "70e25dfe-f68a-3c2b-b941-426e78892388",
                        "glosses": [
                            "Sorte de pâte passée à la filière, mince et longue, que l’on met dans le potage, ou qui sert à confectionner des plats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceff644d-1cd0-43de-8ef2-5f83108c2b6f",
                                "sense_id": "5f12591a-7acf-3215-b8dd-bdcb6b31bb39",
                                "text": "Quand il déjeunait avec nous\nIl dévorait d’un coup\nSa soup’ au vermicelle"
                            }
                        ]
                    },
                    {
                        "sense_id": "90f2d312-3133-3de0-b543-e521979df241",
                        "entry_id": "70e25dfe-f68a-3c2b-b941-426e78892388",
                        "glosses": [
                            "Potage fait avec cette pâte."
                        ],
                        "tags": [
                            "broadly",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "c6b275a0-772f-4d2c-a73c-f36b57bfed4e",
                                "sense_id": "90f2d312-3133-3de0-b543-e521979df241",
                                "text": "Une assiette de vermicelle."
                            },
                            {
                                "example_id": "00df3687-4a2e-42a0-aafd-fa8daab4d3ce",
                                "sense_id": "90f2d312-3133-3de0-b543-e521979df241",
                                "text": "Vermicelle au gras, au maigre, au lait."
                            }
                        ]
                    },
                    {
                        "sense_id": "e617367a-3d07-3d0b-ac60-374b48951082",
                        "entry_id": "70e25dfe-f68a-3c2b-b941-426e78892388",
                        "glosses": [
                            "Dessert à base de purée de châtaignes pressée sur un biscuit croquant, servi dans un petit pot."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "65fbda08-d25c-316f-a93f-d2d95b7687e7",
                        "entry_id": "70e25dfe-f68a-3c2b-b941-426e78892388",
                        "glosses": [
                            "Toutes sortes de choses ayant une forme fine et courte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5eaaa3d-274c-4f84-8b0e-3a9af531296a",
                                "sense_id": "65fbda08-d25c-316f-a93f-d2d95b7687e7",
                                "text": "… au milieu placer une boule de glace vanille, une de fraise, une de chocolat, napper de chocolat fondu, décorer de chantilly, parsemer de vermicelle de chocolat servir aussitôt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e4b535f-cc31-492e-842f-da98a9d28024",
                        "source_entry_id": "70e25dfe-f68a-3c2b-b941-426e78892388",
                        "source_sense_description": "sorte de pâte",
                        "target_lang_word": "vermicelli",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermicelli",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37404a37-47d6-368f-af9a-6ecdfe6143e9",
                                        "entry_id": "dae67d37-e29a-316a-91c3-fcbcbabc282b",
                                        "glosses": [
                                            "Long, slender pasta, similar to spaghetti, only thinner."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7e50abb-878e-4a84-96d9-0b08e34a4e4b",
                                                "sense_id": "37404a37-47d6-368f-af9a-6ecdfe6143e9",
                                                "text": "They talked of the experiments of Dr. Darwin, (I speak not of what the Doctor really did, or said that he did, but, as more to my purpose, of what was then spoken of as having been done by him,) who preserved a piece of vermicelli in a glass case, till by some extraordinary means it began to move with voluntary motion."
                                            },
                                            {
                                                "example_id": "f9148a62-8a31-4e44-9507-614e1694f65a",
                                                "sense_id": "37404a37-47d6-368f-af9a-6ecdfe6143e9",
                                                "text": "A favourite old cookbook (and a pile of parsley to use up) inspire this simple salsa verde – parsley, anchovies, capers, olives – in a fairytale tangle of vermicelli[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb5f3ff4-130c-3069-9285-fdb223d3e33b",
                                        "entry_id": "dae67d37-e29a-316a-91c3-fcbcbabc282b",
                                        "glosses": [
                                            "Any type of long, thin noodles, as in rice vermicelli."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e82afe-8f6e-493a-9a3a-183853a793ab",
                                                "sense_id": "fb5f3ff4-130c-3069-9285-fdb223d3e33b",
                                                "text": "Super-thin rice noodles, or vermicelli, are de rigueur here, but as with pad thai the secret is all in the preparation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33a10fbb-4ecf-3572-be11-367cc8b82454",
                                        "entry_id": "dae67d37-e29a-316a-91c3-fcbcbabc282b",
                                        "glosses": [
                                            "Chocolate sprinkles."
                                        ],
                                        "tags": [
                                            "UK",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
