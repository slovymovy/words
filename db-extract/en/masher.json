                ],
                "senses": [
                    {
                        "sense_id": "77505c59-91c0-35ca-aec1-48288b081f16",
                        "entry_id": "80582024-51f2-3497-b868-7e420bf779ee",
                        "glosses": [
                            "A fashionable man."
                        ],
                        "tags": [
                            "dated",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "21d1f511-7bfb-4b8a-8c2c-256f81c79072",
                                "sense_id": "77505c59-91c0-35ca-aec1-48288b081f16",
                                "text": "For in this quality of “clubbable,” and the value now put upon it, lies the whole secret of change in our fast men, mashers, and men about town."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddbded10-258f-32d5-a121-942d54d93781",
                        "entry_id": "80582024-51f2-3497-b868-7e420bf779ee",
                        "glosses": [
                            "A man who makes often unwelcome advances to women, as in a subway."
                        ],
                        "tags": [
                            "Australia",
                            "Canada",
                            "US",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "50942010-ec18-4782-b452-7d87a974091c",
                                "sense_id": "ddbded10-258f-32d5-a121-942d54d93781",
                                "text": "\"Oh, gee!\" remarked the Girl from Sieber-Mason's, glancing up with the most capable coolness. \"Ain't there any way to ever get rid of you mashers? I've tried everything from eating onions to using hatpins. Be on your way, Freddie.\""
                            },
                            {
                                "example_id": "0ffba68a-57f9-49d5-8c83-b067020a7be8",
                                "sense_id": "ddbded10-258f-32d5-a121-942d54d93781",
                                "text": "\"Mama! Do you think that I'd allow a common masher-- Now, really Mama! I have my standards where men are concerned...\""
                            }
                        ]
                    }
                ],
