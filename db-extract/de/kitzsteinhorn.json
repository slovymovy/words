                "senses": [
                    {
                        "sense_id": "01a2162d-1d5a-3233-b12c-f010e6ea41ab",
                        "entry_id": "280a2747-0174-3c1c-bed9-359babe4d444",
                        "glosses": [
                            "Berg bei Kaprun (im österreichischen Bundesland Salzburg), der zu der in den Hohen Tauern gelegenen Glocknergruppe gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3975724f-7061-4b94-8436-14861ec5d678",
                                "sense_id": "01a2162d-1d5a-3233-b12c-f010e6ea41ab",
                                "text": "„Weitere Lawinenunfälle gab es am Kitzsteinhorn in Kaprun, in der Kreuzeckgruppe in Kärnten und am Hintertuxer Gletscher in Tirol.“"
                            },
                            {
                                "example_id": "61ac72e5-a41c-4025-9e77-2b97521efb07",
                                "sense_id": "01a2162d-1d5a-3233-b12c-f010e6ea41ab",
                                "text": "„Es sind Welten, die am Fuss des Kitzsteinhorns bei Kaprun aufeinandertreffen.“"
                            },
                            {
                                "example_id": "32d86fd8-a589-49fb-b81f-cb940a83615a",
                                "sense_id": "01a2162d-1d5a-3233-b12c-f010e6ea41ab",
                                "text": "„Als Bürgermeister von Kaprun im Pinzgau hatte er die Idee, das Kitzsteinhorn zu erschließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
