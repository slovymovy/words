        "fr-extract.jsonl": [
            {
                "entry_id": "07509326-acda-37f0-ad1d-eb7f0e407731",
                "word": "Ponant",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "06dac6bb-51cd-3e1f-b813-0f9888679f08",
                        "entry_id": "07509326-acda-37f0-ad1d-eb7f0e407731",
                        "glosses": [
                            "Étang relié à la mer Méditerranée, situé au sud des départements du Gard et de l'Hérault."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a77266c0-9bbe-40cd-a44e-02099333f1eb",
                                "sense_id": "06dac6bb-51cd-3e1f-b813-0f9888679f08",
                                "text": "Chaque matin, armée de glacières et de serviettes, la famille se réunissait d’abord sur la rive du Ponant (lac relié à la Méditerranée et appartenant à la commune de La Grande-Motte) avant de migrer pour moitié, quelques heures plus tard, vers la vraie plage du Grand Travers."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "965203cf-9876-30ec-b705-cd050abb7872",
                "word": "ponant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8f649205-e201-41fe-93e1-7c7430081709",
                        "entry_id": "965203cf-9876-30ec-b705-cd050abb7872",
                        "tags": [
                            "plural"
                        ],
                        "form": "ponants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "47f300f1-226b-3698-ae9e-053d6d52fdf5",
                        "entry_id": "965203cf-9876-30ec-b705-cd050abb7872",
                        "glosses": [
                            "Occident, partie du monde qui est au couchant du Soleil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed4244da-da98-4e5a-b19b-b1c20d4a0892",
                                "sense_id": "47f300f1-226b-3698-ae9e-053d6d52fdf5",
                                "text": "Des éclairs d’orage zébraient l’horizon au ponant."
                            },
                            {
                                "example_id": "78b45b8b-a03d-4a43-b6fc-8da9cc7c74db",
                                "sense_id": "47f300f1-226b-3698-ae9e-053d6d52fdf5",
                                "text": "Depuis le levant jusqu’au ponant."
                            },
                            {
                                "example_id": "ca5ecb0b-4c1c-416c-9635-95d240f42745",
                                "sense_id": "47f300f1-226b-3698-ae9e-053d6d52fdf5",
                                "text": "Il se leva un vent du ponant."
                            }
                        ]
                    },
                    {
                        "sense_id": "b267569c-6d8f-3b9c-9e2f-dd54966a6cfa",
                        "entry_id": "965203cf-9876-30ec-b705-cd050abb7872",
                        "glosses": [
                            "Il désigne aussi, en France, l’océan, par opposition à la Méditerranée."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "fd7e2f20-6efb-4e62-8613-fcab434e8ce9",
                                "sense_id": "b267569c-6d8f-3b9c-9e2f-dd54966a6cfa",
                                "text": "Vice-amiral du ponant."
                            },
                            {
                                "example_id": "dead59dd-576f-4074-b78e-561d495ba06f",
                                "sense_id": "b267569c-6d8f-3b9c-9e2f-dd54966a6cfa",
                                "text": "L’escadre du ponant."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d359cdc-9e55-3d61-a97a-1cdd533e418e",
                        "entry_id": "965203cf-9876-30ec-b705-cd050abb7872",
                        "glosses": [
                            "Vent d’ouest soufflant en mer Méditerranée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49f890f4-cd8e-424c-aee8-24dc1fdbf5e8",
                                "sense_id": "9d359cdc-9e55-3d61-a97a-1cdd533e418e",
                                "text": "– Tramontane, sirocco, libeccio, ponant et mistral. Ce n’est tout de même pas difficile ! s’emporta Viola. Il n’y a que cinq vents qui soufflent ici."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef551e21-9cde-4ee0-a69c-bf2b0b9ef782",
                        "source_entry_id": "965203cf-9876-30ec-b705-cd050abb7872",
