                    "frequency": "Low",
                    "semantic_group_id": "modal_official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Завтра <w>имеет</w> быть важное заседание совета директоров.",
                            "target_lang_translations": {
