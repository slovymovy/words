            "senses": [
                {
                    "sense_id": "6ae09b0b-df3d-3139-a83d-30f441d8d4b1",
                    "sense_definition": "de waargenomen toestand of de feitelijke gang van zaken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er werd naar <w>bevind</w> van zaken geoordeeld dat hij er niets mee te maken had.",
                            "target_lang_translations": {
                                "en": "Based on the <w>findings</w> of the case, it was judged that he had nothing to do with it."
                            }
                        },
                        {
                            "text": "De arts handelde naar <w>bevind</w> van zaken nadat hij de patiënt grondig had onderzocht.",
                            "target_lang_translations": {
                                "en": "The doctor acted according to the <w>circumstances</w> after he had thoroughly examined the patient."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevinding",
                        "waarneming",
                        "toestand"
                    ],
                    "common_phrases": [
                        "naar bevind van zaken"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "voornamelijk nog gebruikt in de vaste uitdrukking 'naar bevind van zaken'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the observed state or the actual course of events, primarily used in formal or legal contexts"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finding",
                                "target_lang_sense_clarification": "the result of an investigation or observation"
                            },
                            {
                                "target_lang_word": "circumstances",
                                "target_lang_sense_clarification": "the facts or conditions connected with an event"
                            },
                            {
                                "target_lang_word": "state of affairs",
                                "target_lang_sense_clarification": "a situation or set of circumstances"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1cb24852-9191-3e98-a454-8cebb365b4eb",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>bevinden</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bevind</w> mij momenteel in een lastige situatie waar ik niet makkelijk uitkom.",
                            "target_lang_translations": {
                                "en": "I <w>find myself</w> currently in a difficult situation that I cannot easily get out of."
                            }
                        },
                        {
                            "text": "Op dit moment <w>bevind</w> ik mij midden in het drukke centrum van de stad.",
                            "target_lang_translations": {
                                "en": "At this moment I <w>am</w> in the middle of the busy city center."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bevind mij"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first person singular present tense of 'bevinden' (to be located/find oneself)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "am",
                                "target_lang_sense_clarification": "first person singular of 'to be'"
                            },
                            {
                                "target_lang_word": "find myself",
                                "target_lang_sense_clarification": "to be in a particular place or situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f02e02a-b456-390c-a8c0-85b77254940f",
                    "sense_definition": "de tweede persoon enkelvoud tegenwoordige tijd van <w>bevinden</w> bij inversie",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waar <w>bevind</w> je je op dit moment precies?",
                            "target_lang_translations": {
                                "en": "Where <w>are</w> you exactly at this moment?"
                            }
                        },
                        {
                            "text": "In welke kamer <w>bevind</w> jij je nu voor het online gesprek?",
                            "target_lang_translations": {
                                "en": "In which room <w>are</w> you now for the online conversation?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bevind je je"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "tweede persoon enkelvoud bij inversie"
                        }
                    ],
                    "target_lang_definitions": {
