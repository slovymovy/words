{
    "word_family": [
        "fringy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eaaf8db8-41e3-33b4-a5a3-fb6e068e6ebb",
                    "sense_definition": "Hair hanging over the forehead, usually cut straight across.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "hair_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to cut a <w>fringe</w> to change her hairstyle.",
                            "target_lang_translations": {
                                "ru": "Она решила выстричь <w>чёлку</w>, чтобы изменить прическу.",
                                "zh": "她决定剪个<w>刘海</w>来改变发型。"
                            }
                        },
                        {
                            "text": "Her long <w>fringe</w> was getting in her eyes, so she pinned it back.",
                            "target_lang_translations": {
                                "ru": "Её длинная <w>чёлка</w> лезла в глаза, поэтому она заколола её назад.",
                                "zh": "她那长长的<w>刘海</w>总是遮住眼睛，所以她把它别到了后面。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bangs"
                    ],
                    "common_phrases": [
                        "cut a fringe",
                        "long fringe",
                        "side fringe"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British/Commonwealth English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Волосы, свисающие на лоб, обычно подстриженные прямо.",
                        "zh": "垂在额头前的头发，通常剪成平齐状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чёлка",
                                "target_lang_sense_clarification": "прическа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刘海",
                                "target_lang_sense_clarification": "发型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "560dd055-7030-33f3-8a10-f6d9239593a7",
                    "sense_definition": "A decorative border of hanging threads, cords, or strips, often attached to the edge of clothing, rugs, or curtains.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old lamp had a shade with a gold <w>fringe</w> around the bottom.",
                            "target_lang_translations": {
                                "ru": "У старой лампы был абажур с золотой <w>бахромой</w> по нижнему краю.",
                                "zh": "那盏旧灯的灯罩底部有一圈金色的<w>流苏</w>。"
                            }
                        },
                        {
                            "text": "She wore a leather jacket with a long <w>fringe</w> on the sleeves.",
                            "target_lang_translations": {
                                "ru": "На ней была кожаная куртка с длинной <w>бахромой</w> на рукавах.",
                                "zh": "她穿了一件袖子上带有长<w>流苏</w>的皮夹克。"
                            }
                        }
                    ],
                    "synonyms": [
                        "edge"
                    ],
                    "common_phrases": [
                        "silk fringe",
                        "gold fringe",
                        "leather fringe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративный край из свисающих нитей, шнуров или полосок, часто прикрепляемый к краю одежды, ковров или штор.",
                        "zh": "装饰性的边缘，由悬垂的线、绳或条状物组成，常用于服装、地毯或窗帘的边缘。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бахрома",
                                "target_lang_sense_clarification": "украшение из нитей"
                            },
                            {
                                "target_lang_word": "кайма",
                                "target_lang_sense_clarification": "край, окантовка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流苏",
                                "target_lang_sense_clarification": "装饰性垂饰"
                            },
                            {
                                "target_lang_word": "穗子",
                                "target_lang_sense_clarification": "边缘装饰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdb13ac7-60cf-37d7-8c31-b38dd9202ea4",
                    "sense_definition": "The outer edge or periphery of an area, city, or group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "periphery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They built a new shopping centre on the <w>fringe</w> of the town.",
                            "target_lang_translations": {
                                "ru": "Они построили новый торговый центр на <w>окраине</w> города.",
                                "zh": "他们在城镇的<w>边缘</w>建了一个新的购物中心。"
                            }
                        },
                        {
                            "text": "He lives on the <w>fringe</w> of the forest, far from the busy city centre.",
                            "target_lang_translations": {
                                "ru": "Он живёт на <w>краю</w> леса, далеко от шумного центра города.",
                                "zh": "他住在森林的<w>边缘</w>，远离繁忙的市中心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outskirts",
                        "periphery",
                        "edge"
                    ],
                    "antonyms": [
                        "center"
                    ],
                    "common_phrases": [
                        "on the fringe",
                        "urban fringe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешний край или периферия района, города или группы.",
                        "zh": "地区、城市或群体的外缘或周边地带。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окраина",
                                "target_lang_sense_clarification": "города или местности"
                            },
                            {
                                "target_lang_word": "периферия",
                                "target_lang_sense_clarification": "отдаленная часть"
                            },
                            {
                                "target_lang_word": "край",
                                "target_lang_sense_clarification": "предел, граница"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "边缘",
                                "target_lang_sense_clarification": "地带或区域"
                            },
                            {
                                "target_lang_word": "郊区",
                                "target_lang_sense_clarification": "城市外围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6537dae-933d-3e0d-9929-34cf5a63926a",
                    "sense_definition": "A group of people with extreme or unconventional views, existing on the periphery of a larger community.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "periphery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These radical ideas are supported only by a small <w>fringe</w> of the party.",
                            "target_lang_translations": {
                                "ru": "Эти радикальные идеи поддерживает лишь небольшая <w>маргинальная часть</w> партии.",
                                "zh": "这些激进思想只得到党内一小部分<w>边缘群体</w>的支持。"
                            }
                        },
                        {
                            "text": "The movement started as a <w>fringe</w> group but has gained mainstream attention.",
                            "target_lang_translations": {
                                "ru": "Движение начиналось как <w>маргинальная</w> группа, но привлекло внимание широкой общественности.",
                                "zh": "这场运动起初只是一个<w>边缘群体</w>，但现在已经引起了主流社会的关注。"
                            }
                        }
                    ],
                    "antonyms": [
                        "mainstream"
                    ],
                    "common_phrases": [
                        "lunatic fringe",
                        "fringe group"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей с крайними или нетрадиционными взглядами, существующая на периферии большего сообщества.",
                        "zh": "持极端或非传统观点，存在于主流社会边缘的群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маргиналы",
                                "target_lang_sense_clarification": "люди вне мейнстрима"
                            },
                            {
                                "target_lang_word": "крайние течения",
                                "target_lang_sense_clarification": "радикальные группы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "边缘群体",
                                "target_lang_sense_clarification": "非主流人群"
                            },
                            {
                                "target_lang_word": "激进派",
                                "target_lang_sense_clarification": "持极端观点者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1e39f87-3e1a-3e6f-ae8f-6caeb611f7bc",
                    "sense_definition": "Non-mainstream or experimental theatre and art.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "periphery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every summer, thousands of tourists visit the city for the <w>Fringe</w> festival.",
                            "target_lang_translations": {
                                "ru": "Каждое лето тысячи туристов посещают город ради фестиваля <w>Фриндж</w>.",
                                "zh": "每年夏天，成千上万的游客来到这座城市参加<w>边缘艺术</w>节。"
                            }
                        },
                        {
                            "text": "Many famous actors started their careers performing in the <w>fringe</w>.",
                            "target_lang_translations": {
                                "ru": "Многие известные актёры начинали свою карьеру, выступая в <w>альтернативном театре</w>.",
                                "zh": "许多著名演员都是从<w>边缘艺术</w>表演开始他们的职业生涯的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Edinburgh Fringe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Некоммерческий или экспериментальный театр и искусство.",
                        "zh": "非主流或实验性的戏剧与艺术。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "альтернативное искусство",
                                "target_lang_sense_clarification": "экспериментальное творчество"
                            },
                            {
                                "target_lang_word": "Фриндж",
                                "target_lang_sense_clarification": "название фестивалей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "先锋艺术",
                                "target_lang_sense_clarification": "实验性创作"
                            },
                            {
                                "target_lang_word": "边缘艺术",
                                "target_lang_sense_clarification": "非商业性艺术"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6c0a80ec-a5ab-3408-8662-255570a4134d",
                    "sense_definition": "Not part of the mainstream; unconventional, alternative, or peripheral.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "periphery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The festival showcases <w>fringe</w> artists who experiment with new styles.",
                            "target_lang_translations": {
                                "ru": "Фестиваль представляет <w>альтернативных</w> художников, экспериментирующих с новыми стилями.",
                                "zh": "该艺术节展示了那些尝试新风格的<w>边缘</w>艺术家。"
                            }
                        },
                        {
                            "text": "He is interested in <w>fringe</w> science that is not accepted by most researchers.",
                            "target_lang_translations": {
                                "ru": "Он интересуется <w>альтернативной</w> наукой, которую не признает большинство исследователей.",
                                "zh": "他对大多数研究人员不认可的<w>边缘</w>科学很感兴趣。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alternative",
                        "nonmainstream",
                        "marginal"
                    ],
                    "antonyms": [
                        "mainstream",
                        "conventional"
                    ],
                    "common_phrases": [
                        "fringe benefits",
                        "fringe theatre"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не являющийся частью мейнстрима; нетрадиционный, альтернативный или периферийный.",
                        "zh": "非主流的；非传统的、替代性的或边缘的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маргинальный",
                                "target_lang_sense_clarification": "не общепринятый"
                            },
                            {
                                "target_lang_word": "альтернативный",
                                "target_lang_sense_clarification": "иной, нетрадиционный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "边缘的",
                                "target_lang_sense_clarification": "非主流的"
                            },
                            {
                                "target_lang_word": "非主流的",
                                "target_lang_sense_clarification": "非传统的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e152b4b-7978-3a11-b45a-b5ea925773d4",
                    "sense_definition": "To form a border around something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tall palm trees <w>fringe</w> the white sandy beach.",
                            "target_lang_translations": {
                                "ru": "Высокие пальмы <w>окаймляют</w> белый песчаный пляж.",
                                "zh": "高大的棕榈树<w>环绕</w>着白色的沙滩。"
                            }
                        },
                        {
                            "text": "The dark clouds were <w>fringed</w> with golden light from the setting sun.",
                            "target_lang_translations": {
                                "ru": "Тёмные облака были <w>окаймлены</w> золотым светом заходящего солнца.",
                                "zh": "乌云被落日的金光<w>镶边</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "edge"
                    ],
                    "common_phrases": [
                        "fringed with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образовывать кайму или границу вокруг чего-либо.",
                        "zh": "在某物周围形成边缘或界限。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окаймлять",
                                "target_lang_sense_clarification": "окружать каймой"
                            },
                            {
                                "target_lang_word": "обрамлять",
                                "target_lang_sense_clarification": "создавать рамку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "环绕",
                                "target_lang_sense_clarification": "形成边缘"
                            },
                            {
                                "target_lang_word": "镶边",
                                "target_lang_sense_clarification": "装饰边缘"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}