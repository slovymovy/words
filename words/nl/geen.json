                    "sense_definition": "Gebruikt voor een zelfstandig naamwoord in het enkelvoud om aan te geven dat er niet één exemplaar van is; het tegenovergestelde van 'een'.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "negation_article",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb <w>geen</w> idee hoe dit werkt.",
                            "target_lang_translations": {
                                "ru": "У меня <w>нет</w> идей, как это работает.",
                                "en": "I have <w>no</w> idea how this works.",
                                "pl": "Nie mam <w>zielonego</w> pojęcia, jak to działa.",
                                "de": "Ich habe <w>keine</w> Ahnung, wie das funktioniert.",
                                "fr": "Je n'ai <w>aucune</w> idée de comment cela fonctionne.",
                                "it": "Non ho <w>nessuna</w> idea di come funzioni.",
                                "cs": "Nemám <w>žádnou</w> představu, jak to funguje.",
                                "tr": "Bunun nasıl çalıştığı hakkında <w>hiçbir</w> fikrim yok.",
                                "es": "No tengo <w>ninguna</w> idea de cómo funciona esto."
                            }
                        },
                        {
                            "text": "Dat is <w>geen</w> probleem voor mij.",
                            "target_lang_translations": {
                                "ru": "Это <w>не</w> проблема для меня.",
                                "en": "That is <w>no</w> problem for me.",
                                "pl": "To dla mnie <w>żaden</w> problem.",
                                "de": "Das ist <w>kein</w> Problem für mich.",
                                "fr": "Ce n'est <w>pas un</w> problème pour moi.",
                                "it": "Questo non è <w>un</w> problema per me.",
                                "cs": "To pro mě <w>není</w> problém.",
                                "tr": "Bu benim için bir sorun <w>değil</w>.",
                                "es": "Eso <w>no</w> es un problema para mí."
                            }
                        },
                        {
                            "text": "Hij is <w>geen</w> leraar, maar een student.",
                            "target_lang_translations": {
                                "ru": "Он <w>не</w> учитель, а студент.",
                                "en": "He is <w>not a</w> teacher, but a student.",
