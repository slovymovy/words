                                        "entry_id": "825a1f0c-2756-37f5-905e-dd2b078906eb",
                                        "glosses": [
                                            "Wholly; completely; entirely."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b217c9f7-1be7-4fb0-b3a8-2f5f2961d8c0",
                                                "sense_id": "c8deb913-96fa-3781-acc2-1ed69226f3e8",
                                                "text": "I refute those allegations outright."
                                            },
                                            {
                                                "example_id": "a268399d-8fc5-400d-8bb1-91bd7113b0c1",
                                                "sense_id": "c8deb913-96fa-3781-acc2-1ed69226f3e8",
                                                "text": "Special facilities frequently are provided to enable visiting photographers to get the best results, whereas in the past cameras were sometimes banned outright."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87d493d8-8232-3023-b70d-9e1a3dd24339",
                                        "entry_id": "825a1f0c-2756-37f5-905e-dd2b078906eb",
                                        "glosses": [
                                            "Openly and without reservation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "315cbdf2-b544-4134-8add-03bb459af53b",
                                                "sense_id": "87d493d8-8232-3023-b70d-9e1a3dd24339",
                                                "text": "I have just responded outright to that question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f83f6164-dbb9-30e6-b10c-c1ccf3aecc1d",
                                        "entry_id": "825a1f0c-2756-37f5-905e-dd2b078906eb",
                                        "glosses": [
                                            "At once."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a28c6625-01f9-4b31-82fe-95096c583711",
                                                "sense_id": "f83f6164-dbb9-30e6-b10c-c1ccf3aecc1d",
                                                "text": "Two people died outright and one more later."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57e276fa-1e56-3efa-ba26-064cfe6c6d3b",
                                        "entry_id": "825a1f0c-2756-37f5-905e-dd2b078906eb",
                                        "glosses": [
                                            "With no outstanding conditions."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f26449e6-b02f-47e8-a77f-36b7fd70a036",
                                                "sense_id": "57e276fa-1e56-3efa-ba26-064cfe6c6d3b",
                                                "text": "I have bought the house outright."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b901e49-6a3e-3542-b128-a26cd741e71f",
                                        "entry_id": "825a1f0c-2756-37f5-905e-dd2b078906eb",
                                        "glosses": [
                                            "Blatantly; inexcusably; unambiguously."
