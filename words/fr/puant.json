                {
                    "sense_id": "c5e6906a-ad56-3e31-a712-5f7bb3dda04e",
                    "sense_definition": "Nom donné à certains petits carnivores réputés pour leur sécrétion fétide, comme le putois ou la mouffette.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien s'est fait arroser par un <w>puant</w> au fond des bois.",
                            "target_lang_translations": {
                                "en": "The dog got sprayed by a <w>skunk</w> deep in the woods.",
                                "ru": "В глубине леса собаку обрызгал <w>скунс</w>.",
                                "de": "Der Hund wurde tief im Wald von einem <w>Stinktier</w> besprüht.",
                                "es": "El perro fue rociado por una <w>mofeta</w> en lo más profundo del bosque.",
                                "zh": "狗在林子深处被一只<w>臭鼬</w>喷了一身。"
                            }
                        },
                        {
                            "text": "On aperçoit parfois un <w>puant</w> traverser furtivement la route à la tombée de la nuit.",
                            "target_lang_translations": {
                                "en": "One sometimes glimpses a <w>polecat</w> sneaking across the road at nightfall.",
                                "ru": "С наступлением сумерек иногда можно заметить, как <w>хорёк</w> украдкой перебегает дорогу.",
                                "de": "Man sieht bei Einbruch der Nacht manchmal einen <w>Iltis</w> heimlich über die Straße huschen.",
                                "es": "Al anochecer, a veces se ve un <w>turón</w> cruzar furtivamente la carretera.",
                                "zh": "天黑时，人们有时会看见一只<w>鼬</w>悄悄穿过马路。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "désigne traditionnellement le putois ou la mouffette"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Traditionally used name for small carnivores such as the polecat or skunk, known for their foul secretion.",
                        "ru": "Название мелких хищных зверьков, выделяющих зловонный секрет, например хорька или скунса.",
                        "de": "Sammelbezeichnung für kleine Raubtiere wie Iltis oder Stinktier, die für ihr übel riechendes Sekret bekannt sind.",
                        "es": "Nombre dado a ciertos pequeños carnívoros conocidos por su secreción fétida, como el turón o la mofeta.",
                        "zh": "泛指一类以能分泌恶臭液体而闻名的小型食肉动物，如鼬和臭鼬。"
                    },
