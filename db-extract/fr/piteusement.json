        "fr-extract.jsonl": [
            {
                "entry_id": "0d6d6f30-9e12-341e-9b17-d6eb4b7d772e",
                "word": "piteusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "89e88c07-3a79-3aa0-90ec-7f402bd3029a",
                        "entry_id": "0d6d6f30-9e12-341e-9b17-d6eb4b7d772e",
                        "glosses": [
                            "De manière à exciter la pitié."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ab00af19-ac5c-423d-8bde-c9d94cd0497b",
                                "sense_id": "89e88c07-3a79-3aa0-90ec-7f402bd3029a",
                                "text": "Le sénat…. Dont plus de la moitié piteusement étale\nUne indigne curée aux vautours de Pharsale,"
                            },
                            {
                                "example_id": "1e6d5c72-0dc2-4364-ab10-bc2f97d74fb9",
                                "sense_id": "89e88c07-3a79-3aa0-90ec-7f402bd3029a",
                                "text": "On ne parle plus ici de la Pologne que fort piteusement ; on dit que tout y est perdu,"
                            }
                        ]
                    },
                    {
                        "sense_id": "4407a25b-76fb-38db-9e20-a79cb58aba9e",
                        "entry_id": "0d6d6f30-9e12-341e-9b17-d6eb4b7d772e",
                        "glosses": [
                            "De manière ridicule, s’emploie pour un chagrin."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "7a5a6794-c38a-43d0-a96b-d45dca0f22bd",
                                "sense_id": "4407a25b-76fb-38db-9e20-a79cb58aba9e",
                                "text": "Nous suivons la lutte avec nos jumelles. Mais elle est courte : les deux taubes, rompant le fer, rentre piteusement dans leurs lignes."
                            },
                            {
                                "example_id": "17570da9-8ca4-4650-b815-f79cbf012a69",
                                "sense_id": "4407a25b-76fb-38db-9e20-a79cb58aba9e",
                                "text": "La méchante déesse Iris,\nAyant donc cette forme pris,\n Se mit piteusement à dire\nCes mots qui ne sont pas pour rire,"
                            },
                            {
                                "example_id": "0febb2b3-451a-4e37-a158-a65570863af2",
                                "sense_id": "4407a25b-76fb-38db-9e20-a79cb58aba9e",
                                "text": "« Attends… attends ! s’écria piteusement le docteur. Quel diable d’homme !… Un instant encore !… J’ai les jambes raides… mes articulations ne fonctionnent plus… »"
                            }
                        ]
                    }
                ],
