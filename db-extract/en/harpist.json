                                            {
                                                "example_id": "040a12b6-bed3-4ddc-813c-d263193769e4",
                                                "sense_id": "32644bb1-13b4-3865-aeba-b776ff8511a7",
                                                "text": "Er ist Harfenist bei den Berliner Philharmonikern."
                                            },
                                            {
                                                "example_id": "24213120-1bf2-4821-8638-5a8cf1dbb962",
                                                "sense_id": "32644bb1-13b4-3865-aeba-b776ff8511a7",
                                                "text": "„Georg Friedrich Händel hat zwar nur ein Konzert für Harfe geschrieben. Harfenist Xavier de Maistre widmet sich auf Händel (Sony) dennoch ausschließlich dem barocken Könner, der in London als Opernunternehmer auch einmal pleiteging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a8c9885-678c-4dca-82c7-ed42d952b567",
                        "source_entry_id": "5316e2ad-011b-3204-b2f1-f2a672f977bd",
