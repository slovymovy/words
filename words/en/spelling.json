                {
                    "sense_id": "68d98b93-4f69-3f1e-8a69-b5d5a87a650c",
                    "sense_definition": "The choice of a specific note name among equivalent pitches in music notation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music_notation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The correct <w>spelling</w> of the chord depends on the key of the piece.",
                            "target_lang_translations": {
