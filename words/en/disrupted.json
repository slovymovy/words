                        "interrupted",
                        "disturbed"
                    ],
                    "antonyms": [
                        "ordered",
                        "organized"
                    ],
                    "common_phrases": [
                        "disrupted service",
                        "disrupted flow"
                    ],
                    "target_lang_definitions": {
