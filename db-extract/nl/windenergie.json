                                                "sense_id": "d24a4e86-c900-3970-9746-9ea7b8d8cb66",
                                                "text": "Schon vor Hunderten von Jahren nutzte der Mensch die Windenergie mit Windmühlen und Segelschiffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d8d1eb33-f0db-3c0c-8658-215a1465eb42",
                                        "entry_id": "0c1bd7c6-2465-3de0-a95a-0e64d0fd57d7",
                                        "glosses": [
                                            "Erzeugung von elektrischem Strom aus Windkraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1571c911-581f-4129-9103-da37eee237e1",
                                                "sense_id": "d8d1eb33-f0db-3c0c-8658-215a1465eb42",
                                                "text": "„Zumindest werde eine von der Stadt favorisierte Fläche zur Gewinnung von Windenergie wohl deutlich kleiner ausfallen müssen als geplant, heißt es.“"
                                            },
                                            {
                                                "example_id": "a370445c-dd0f-49f7-9c39-ca5e150ebb4b",
                                                "sense_id": "d8d1eb33-f0db-3c0c-8658-215a1465eb42",
                                                "text": "Bei Erfüllung des Ausbauziels von Windrädern mit 2 Prozent der Landesflächen würde die Windenergie immer noch weniger Flächen beanspruchen, als etwa Straßen, die aktuell 2,6 Prozent des Landes unter Asphalt begraben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
