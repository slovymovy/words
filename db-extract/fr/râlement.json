                "senses": [
                    {
                        "sense_id": "fc7c738e-1749-34f8-bdf5-a2dd60175f5a",
                        "entry_id": "55feee88-274a-308c-8d57-1a36024fa288",
                        "glosses": [
                            "Action de râler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12fd85fb-07d3-46c3-a217-d253ada664f2",
                                "sense_id": "fc7c738e-1749-34f8-bdf5-a2dd60175f5a",
                                "text": "L’ours marin a une sorte d’affreux râlement tel que le bruit des récifs où il cherche sa proie."
                            },
                            {
                                "example_id": "049c74c5-e35e-4df0-9055-0d7670ed1a47",
                                "sense_id": "fc7c738e-1749-34f8-bdf5-a2dd60175f5a",
                                "text": "Le râle marque l’espèce de son qui sort de la poitrine d’un malade à l’agonie ; le râlement exprime le râler. Un moribond a le râle, et il est en proie au râlement."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e860420-623f-337a-bd02-006037ffd706",
                        "entry_id": "55feee88-274a-308c-8d57-1a36024fa288",
                        "glosses": [
                            "Cri de la panthère, du tigre, du daim, du faon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ad35527-f95c-4e01-a34c-4b1ac7126ceb",
                                "sense_id": "5e860420-623f-337a-bd02-006037ffd706",
                                "text": "Bientôt des grondements sourds, comme un tonnerre lointain, couvrirent presque les râlements stridents de la panthère : le lion et le tigre, Judas et Caïn, lui répondaient du fond du théâtre, où étaient leurs cages…"
                            }
                        ]
                    }
