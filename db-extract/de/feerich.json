                "senses": [
                    {
                        "sense_id": "079b5dcc-5e41-3c28-b4c8-2453af0ecd1e",
                        "entry_id": "a8999432-2e17-3fa8-9cf9-e99b88e1d223",
                        "glosses": [
                            "schöne, meist gute, liebe männliche Märchengestalt"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e6f282d0-757f-4e18-a549-5bf3f550e07e",
                                "sense_id": "079b5dcc-5e41-3c28-b4c8-2453af0ecd1e",
                                "text": "„Aufgedeckt! Die Zahnfee ist in Wirklichkeit ein Feerich!!“"
                            },
                            {
                                "example_id": "3a663faa-40c7-4b2c-b553-c35a87cbdd76",
                                "sense_id": "079b5dcc-5e41-3c28-b4c8-2453af0ecd1e",
                                "text": "„Er löste sich in rosa Glitzerstaub auf und Nathaniel schnaubte. Immerhin hatte der Feerich recht damit behalten, dass er die Prinzessin treffen würde.“"
                            },
                            {
                                "example_id": "64b5e807-7456-4294-be10-aff99ecdb619",
                                "sense_id": "079b5dcc-5e41-3c28-b4c8-2453af0ecd1e",
                                "text": "„Wenn der Leser bisher an weibliche Feen, nicht an männliche Feeriche geglaubt hat, so ist das seine eigene Schuld, oder – ein Autor hat das Recht, gegen seine Leser grob zu sein, da jedenfalls der animus iniuriandi fehlt – seine eigene Dummheit.“"
                            },
                            {
                                "example_id": "ab3047c6-846d-4da9-beed-79626ceceb29",
                                "sense_id": "079b5dcc-5e41-3c28-b4c8-2453af0ecd1e",
                                "text": "„Nur wenige Feen und Feeriche waren noch unterwegs und tanzten engelgleich durch die Äste.“"
                            },
                            {
                                "example_id": "c9e6b995-44d6-42c2-8f1f-9b511268f661",
                                "sense_id": "079b5dcc-5e41-3c28-b4c8-2453af0ecd1e",
                                "text": "„Wer sagt, dass es keine Feeriche gibt, hat einfach zu wenig Fantasie!“"
                            },
                            {
                                "example_id": "2164948f-f132-4ae2-946c-1c74e0c15ac2",
                                "sense_id": "079b5dcc-5e41-3c28-b4c8-2453af0ecd1e",
                                "text": "„Bin ich wirklich um die halbe Welt gefahren, um am sinnlosen Geschwafel eines Feerichs zu scheitern?“"
                            },
                            {
                                "example_id": "53a27da0-0a1b-4442-b8b1-fa8d2351c3ac",
                                "sense_id": "079b5dcc-5e41-3c28-b4c8-2453af0ecd1e",
                                "text": "„Er hatte statt ‚ich bin dein Feerich‘ ‚ich bin dein Fähnrich‘ verstanden und ihn gleich in die Küche gejagt.“"
                            },
                            {
                                "example_id": "d01ece30-b6cb-4d2b-8aa1-3eb942ce454a",
                                "sense_id": "079b5dcc-5e41-3c28-b4c8-2453af0ecd1e",
                                "text": "„Es war Shay, ein Feerich mit dunkelbraunem, verwuscheltem Haar und dem beständigen Schatten eines Dreitagebartes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
