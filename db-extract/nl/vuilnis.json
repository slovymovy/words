                        "entry_id": "a8da8094-0a39-3d06-bcfd-78c7e55729c4",
                        "glosses": [
                            "materiaal dat weggeworpen wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8246cc5c-a6ab-4436-82c2-a5d5d175baf8",
                                "sense_id": "d3cc8a75-1b69-36d1-9886-855bb3b37000",
                                "text": "'s Woensdags wordt het vuilnis opgehaald."
                            },
                            {
                                "example_id": "dfe80747-15d1-4d94-93da-5603b35e8b05",
                                "sense_id": "d3cc8a75-1b69-36d1-9886-855bb3b37000",
                                "text": "Het gaat om de afvalbakken in de Texelsestraat, schrijft regionale omroep Rijnmond. Daar worden elke dag volle vuilniszakken naast gezet. \"Ratten zijn dol op etensresten uit de zakken\", zegt een woordvoerder van de gemeente. \"Daarom is het belangrijk om vuilnis altijd in de afvalbak te gooien.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8c2d2a3-73db-4977-a60d-032fdac82e89",
                        "source_entry_id": "a8da8094-0a39-3d06-bcfd-78c7e55729c4",
                        "source_sense_id": "d3cc8a75-1b69-36d1-9886-855bb3b37000",
                        "source_sense_description": "materiaal dat weggeworpen wordt",
                        "target_lang_word": "Müll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a6c8537-7b23-3307-beda-7698d062bd6e",
                                        "entry_id": "eb4bb5b2-1f7a-3ac4-9654-5a7862ab831e",
                                        "glosses": [
                                            "gemischte Abfälle, wertlose Abfallmischung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58439a12-b349-44b6-bfdb-39e1a06bb57c",
                                                "sense_id": "7a6c8537-7b23-3307-beda-7698d062bd6e",
                                                "text": "Müll entsteht erst dadurch, dass verschiedene Abfälle zusammengeworfen werden und dann wegen ihrer gegenseitigen Verschmutzung nur noch schwer verwertbar sind."
                                            },
                                            {
                                                "example_id": "ddc0e66b-f6fd-46c7-8ae9-f444a43d5ad2",
                                                "sense_id": "7a6c8537-7b23-3307-beda-7698d062bd6e",
                                                "text": "„Wirklich sah ich sie, schon halb von Müll bedeckt, im Ascheneimer liegen, und dieser Anblick flößte mir Unbehagen ein.“"
                                            },
                                            {
                                                "example_id": "c6d53f62-7b42-4130-a985-e2d5fb54f893",
                                                "sense_id": "7a6c8537-7b23-3307-beda-7698d062bd6e",
                                                "text": "„Ich habe zum Beispiel wie andere Kinder auch im Park meinen Müll einfach in die Gegend geworfen.“"
                                            },
                                            {
                                                "example_id": "ec616455-671b-45d3-9e8a-333334bedc53",
                                                "sense_id": "7a6c8537-7b23-3307-beda-7698d062bd6e",
                                                "text": "„Er roch immer noch nach Müll, den er bis kurz davor aus den Mülldeponien des Ortes entfernt hatte, aber das schien ihn nicht zu stören.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "de660a3b-8505-3547-959d-97a6e24ebe1e",
                                        "entry_id": "eb4bb5b2-1f7a-3ac4-9654-5a7862ab831e",
                                        "glosses": [
                                            "Unsinn"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "745faee3-8460-418c-998d-70447bc658f0",
                                                "sense_id": "de660a3b-8505-3547-959d-97a6e24ebe1e",
                                                "text": "Er redet nur noch Müll."
                                            },
                                            {
                                                "example_id": "a44dd9d1-623c-43bb-9660-6c00f3413a8b",
                                                "sense_id": "de660a3b-8505-3547-959d-97a6e24ebe1e",
                                                "text": "Sein Posteingang ist voller Müll."
                                            }
