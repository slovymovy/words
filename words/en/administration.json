{
    "word_family": [
        "administer",
        "administrator",
        "administrative",
        "administratively"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6519d1d6-163e-3046-a639-646e8ac31a79",
                    "sense_definition": "The process or activity of running a business, organization, or government; the act of managing duties and responsibilities.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "management_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is responsible for the day-to-day <w>administration</w> of the charity.",
                            "target_lang_translations": {
                                "ru": "Она отвечает за повседневное <w>управление</w> благотворительной организацией.",
                                "zh": "她负责这家慈善机构的日常<w>管理</w>工作。"
                            }
                        },
                        {
                            "text": "A degree in business <w>administration</w> can open many doors for your career.",
                            "target_lang_translations": {
                                "ru": "Диплом в области делового <w>администрирования</w> может открыть многие двери для вашей карьеры.",
                                "zh": "工商<w>管理</w>学位能为你的职业发展打开许多大门。"
                            }
                        }
                    ],
                    "synonyms": [
                        "management",
                        "direction",
                        "supervision",
                        "governance"
                    ],
                    "common_phrases": [
                        "business administration",
                        "public administration",
                        "day-to-day administration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или деятельность по управлению бизнесом, организацией или государственными делами; выполнение управленческих обязанностей.",
                        "zh": "管理企业、组织或政府的过程或活动；履行管理职责和日常事务的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "управление",
                                "target_lang_sense_clarification": "процесс руководства"
                            },
                            {
                                "target_lang_word": "администрирование",
                                "target_lang_sense_clarification": "выполнение административных функций"
                            },
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "направление деятельности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "管理",
                                "target_lang_sense_clarification": "管理企业、机构或政府事务的过程"
                            },
                            {
                                "target_lang_word": "行政管理",
                                "target_lang_sense_clarification": "偏正式，指行政方面的管理工作"
                            },
                            {
                                "target_lang_word": "行政工作",
                                "target_lang_sense_clarification": "常用于专业或学位名称，如工商管理"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5399fa8-0959-3ae7-88f5-4b17ccb09d78",
                    "sense_definition": "The group of people who manage an organization, or the government of a country under a specific leader.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "management_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university <w>administration</w> decided to update the campus security policy.",
                            "target_lang_translations": {
                                "ru": "<w>Администрация</w> университета решила обновить политику безопасности кампуса.",
                                "zh": "大学<w>校方</w>决定更新校园安全政策。"
                            }
                        },
                        {
                            "text": "Voters are waiting to see how the new <w>administration</w> will handle the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Избиратели ждут, чтобы увидеть, как новая <w>администрация</w> справится с экономическим кризисом.",
                                "zh": "选民正等着看新<w>政府</w>将如何应对经济危机。"
                            }
                        }
                    ],
                    "synonyms": [
                        "management"
                    ],
                    "common_phrases": [
                        "school administration",
                        "university administration",
                        "current administration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, управляющих организацией, или правительство страны во главе с конкретным лидером.",
                        "zh": "负责管理某个组织的一群人，或某位特定领导人领导下的一国政府。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "администрация",
                                "target_lang_sense_clarification": "руководящий орган"
                            },
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "начальство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "校方",
                                "target_lang_sense_clarification": "学校、大学等机构的行政负责人或行政方面"
                            },
                            {
                                "target_lang_word": "管理层",
                                "target_lang_sense_clarification": "组织中的管理人员或领导层"
                            },
                            {
                                "target_lang_word": "政府",
                                "target_lang_sense_clarification": "指某位领导人任内的政府"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dcbe050-f2b6-3871-94aa-128294c38ee4",
                    "sense_definition": "The act of giving or applying something to someone, such as medicine, a test, or a formal oath.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse carefully recorded the time of the drug's <w>administration</w>.",
                            "target_lang_translations": {
                                "ru": "Медсестра тщательно записала время <w>введения</w> лекарства.",
                                "zh": "护士仔细记录了药物<w>施用</w>的时间。"
                            }
                        },
                        {
                            "text": "Proper <w>administration</w> of justice is essential for a fair and safe society.",
                            "target_lang_translations": {
                                "ru": "Надлежащее <w>отправление</w> правосудия необходимо для справедливого и безопасного общества.",
                                "zh": "公正的<w>司法执行</w>对于建设公平而安全的社会至关重要。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "administration of justice",
                        "oral administration",
                        "drug administration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по предоставлению или применению чего-либо, например лекарства, теста или официальной присяги.",
                        "zh": "把某物给予或施加给某人的行为，例如药物、测试或正式誓言的施用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "введение",
                                "target_lang_sense_clarification": "лекарства"
                            },
                            {
                                "target_lang_word": "отправление",
                                "target_lang_sense_clarification": "правосудия или обязанностей"
                            },
                            {
                                "target_lang_word": "применение",
                                "target_lang_sense_clarification": "использование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "施用",
                                "target_lang_sense_clarification": "多指药物等的给予或使用"
                            },
                            {
                                "target_lang_word": "施行",
                                "target_lang_sense_clarification": "多指司法、制度、程序等的实行"
                            },
                            {
                                "target_lang_word": "司法执行",
                                "target_lang_sense_clarification": "用于司法语境，指对司法的执行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5392c2a9-f1d7-39e4-aee1-4101d6ee3a2f",
                    "sense_definition": "A legal process in which an insolvent company is managed by an independent administrator to pay off debts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The retail chain went into <w>administration</w> after failing to secure a new loan.",
                            "target_lang_translations": {
                                "ru": "Розничная сеть перешла под <w>внешнее управление</w> после того, как не смогла получить новый кредит.",
                                "zh": "这家连锁零售企业在未能获得新贷款后进入了<w>破产托管</w>程序。"
                            }
                        },
                        {
                            "text": "Thousands of employees lost their jobs when the company was put into <w>administration</w>.",
                            "target_lang_translations": {
                                "ru": "Тысячи сотрудников потеряли работу, когда в компании было введено <w>внешнее управление</w>.",
                                "zh": "公司被置于<w>破产托管</w>之下时，数千名员工失去了工作。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go into administration",
                        "put into administration"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическая процедура, при которой неплатежеспособная компания управляется независимым администратором для погашения долгов.",
                        "zh": "一种法律程序：无力偿债的公司由独立管理人接管经营，以清偿债务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внешнее управление",
                                "target_lang_sense_clarification": "процедура банкротства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "破产托管",
                                "target_lang_sense_clarification": "英国英语中常见，指资不抵债公司由独立管理人接管的破产程序"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d7f9ffdb-e928-3c40-9283-ecfc77f48705",
                    "sense_definition": "The executive branch of a government, typically referring to the President and their staff in the United States.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "management_body",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The <w>Administration</w> has released a statement regarding the new foreign policy.",
                            "target_lang_translations": {
                                "ru": "<w>Администрация</w> выпустила заявление касательно новой внешней политики.",
                                "zh": "<w>政府</w>已就新的外交政策发布了一份声明。"
                            }
                        },
                        {
                            "text": "Members of the <w>Administration</w> met with congressional leaders this morning.",
                            "target_lang_translations": {
                                "ru": "Члены <w>Администрации</w> встретились с лидерами Конгресса сегодня утром.",
                                "zh": "<w>政府</w>成员今天上午会见了国会领导人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнительная ветвь власти, обычно относящаяся к Президенту и его аппарату (в США).",
                        "zh": "政府的行政部门，通常指美国的总统及其幕僚班子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Администрация",
                                "target_lang_sense_clarification": "правительство США"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "政府",
                                "target_lang_sense_clarification": "通常指美国总统及其幕僚所代表的行政当局"
                            },
                            {
                                "target_lang_word": "行政当局",
                                "target_lang_sense_clarification": "较正式，强调行政当局"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}