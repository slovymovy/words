                                                "example_id": "e2497941-64f6-4849-8921-8ec6580315cc",
                                                "sense_id": "c05c904e-5fa8-34c0-a94e-a5a7271c9f6c",
                                                "text": "to bail water out of a boat"
                                            },
                                            {
                                                "example_id": "be17f4d3-c69d-4dc4-85ba-8e8a9c7b99a4",
                                                "sense_id": "c05c904e-5fa8-34c0-a94e-a5a7271c9f6c",
                                                "text": "we had hard work to reach our haven, having to bail out the water with my straw hat."
                                            },
                                            {
                                                "example_id": "2569109a-7b0d-4bc4-abc4-c08bc3ad9f53",
                                                "sense_id": "c05c904e-5fa8-34c0-a94e-a5a7271c9f6c",
                                                "text": "‘Bail out! bail out!’ yelled Job, ‘or we shall founder.’ I seized a large tin bowl with a handle to it, which was fixed under one of the seats, and the three of us bailed away for dear life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ef81639-0168-3d2b-af06-4b9089fcca97",
                                        "entry_id": "6fb58263-70ce-3415-9486-420e78c42c98",
                                        "glosses": [
                                            "To remove water from (a boat) by scooping it out."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4692e6f-23d2-41f4-adb5-d962b177098b",
                                                "sense_id": "9ef81639-0168-3d2b-af06-4b9089fcca97",
                                                "text": "to bail a boat"
                                            },
                                            {
                                                "example_id": "4e467c2a-9304-41d2-8b8e-73858d330bb7",
                                                "sense_id": "9ef81639-0168-3d2b-af06-4b9089fcca97",
                                                "text": "By the help of a small bucket and our hats we bailed her out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebcfb44b-fb7b-380f-b861-d6e3fa592a17",
                                        "entry_id": "6fb58263-70ce-3415-9486-420e78c42c98",
                                        "glosses": [
                                            "To set free; to deliver; to release."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f3b09f-86ff-4044-bfb9-5ee007971feb",
                                                "sense_id": "ebcfb44b-fb7b-380f-b861-d6e3fa592a17",
                                                "text": "Ne none there was to reskue her, ne none to baile."
                                            }
                                        ]
