                        ],
                        "form": "vrijhandeltje"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bbaf6629-1cc9-3624-95d5-3616cb0b6637",
                        "entry_id": "411adaa1-d62b-30eb-93dd-61a57fd43e9a",
                        "glosses": [
                            "vrije handel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0254d07-ea41-4fe8-8a5b-de591527bda2",
                                "sense_id": "bbaf6629-1cc9-3624-95d5-3616cb0b6637",
                                "text": "Regeringen, in de Verenigde Staten en elders, beperken de vrijhandel, ondermijnen de onafhankelijkheid van de centrale bank, laten begrotingstekorten oplopen en schroeven het klimaatbeleid terug. Precies níét wat de meeste economen verstandig vinden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ac0a3fc-ee3c-41ff-af40-690196850132",
                        "source_entry_id": "411adaa1-d62b-30eb-93dd-61a57fd43e9a",
                        "source_sense_id": "bbaf6629-1cc9-3624-95d5-3616cb0b6637",
                        "target_lang_word": "Freihandel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freihandel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33f4e5e2-35cd-377e-ac91-0d5ea0a409fe",
                                        "entry_id": "9e00c7c0-5106-37ce-b9b9-63f45b80b4ca",
                                        "glosses": [
                                            "Handel zwischen Staaten ohne Handelshemmnisse (Zölle, Im- oder Exportverbote und anderes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4924d94-6708-4af9-a263-3acc5d2c06a1",
                                                "sense_id": "33f4e5e2-35cd-377e-ac91-0d5ea0a409fe",
                                                "text": "„Und selbst die Franzosen kann der Gesandte Leopolds davon überzeugen, dass ein Deal, der unter formaler Leitung Belgiens den Freihandel garantiert, nicht den Pariser Interessen widerspricht.“"
                                            },
                                            {
                                                "example_id": "f1ab3abc-0828-479c-a681-df8461dd3bcd",
                                                "sense_id": "33f4e5e2-35cd-377e-ac91-0d5ea0a409fe",
                                                "text": "„Ein Zollverein – also ein deutscher Wirtschaftsraum, in dem Freihandel herrscht – würde jedem Bürger das Leben bereichern, denn ohne Zölle würde es sich für auswärtige Händler endlich lohnen, Konsumgüter von überall auf der Welt bis auf den letzten abgelegenen Bauernhof zu verschicken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "177556ab-7517-4566-99e3-79c5707eb878",
                        "source_entry_id": "411adaa1-d62b-30eb-93dd-61a57fd43e9a",
                        "source_sense_id": "bbaf6629-1cc9-3624-95d5-3616cb0b6637",
                        "target_lang_word": "free trade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "free trade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08e20299-a3d6-358b-94cd-8d11437d9c80",
                                        "entry_id": "9ce13764-b6df-3f74-bad3-b84316c6a2f6",
                                        "glosses": [
                                            "International trade without government interference, especially from tariffs or duties on imports."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9bd7984-af03-4a8c-b703-a52979cbaa07",
                                                "sense_id": "08e20299-a3d6-358b-94cd-8d11437d9c80",
                                                "text": "Near-synonyms: freedom of trade, economic freedom"
                                            },
                                            {
                                                "example_id": "5a9ea745-5017-4cb0-8607-8c579c49ae21",
                                                "sense_id": "08e20299-a3d6-358b-94cd-8d11437d9c80",
                                                "text": "Hidden behind thickets of acronyms and gorse bushes of detail, a new great game is under way across the globe.[…]The current power play consists of an extraordinary range of countries simultaneously sitting down to negotiate big free trade and investment agreements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8c37bd8-2a51-4ea0-8155-ef277357999a",
                        "source_entry_id": "411adaa1-d62b-30eb-93dd-61a57fd43e9a",
                        "source_sense_id": "bbaf6629-1cc9-3624-95d5-3616cb0b6637",
                        "target_lang_word": "libre-échange",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "libre-échange",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f91034d5-d6ba-3f12-a741-80d14721e9b3",
                                        "entry_id": "74221ac2-86f4-35bd-b94d-972ba0df52bb",
                                        "glosses": [
                                            "Système d’après lequel les transactions commerciales entre les nations doivent être affranchies de prohibitions et de taxes élevées."
                                        ],
                                        "tags": [
                                            "Économie politique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dc6eca8-837a-4fea-9b7e-1ed354064492",
                                                "sense_id": "f91034d5-d6ba-3f12-a741-80d14721e9b3",
                                                "text": "Au cœur du modèle néolibéral, le libre-échange sans précaution a accru le phénomène des délocalisations."
                                            },
                                            {
                                                "example_id": "7bbfa495-a484-4eb0-bf83-e0f9625bc76c",
                                                "sense_id": "f91034d5-d6ba-3f12-a741-80d14721e9b3",
                                                "text": "Son gouvernement est divisé entre les partisans d’un maintien dans une union douanière et d’un alignement réglementaire avec l’Europe, et les avocats d’une rupture nette qui rendrait possible la négociation en solo d’accords de libre-échange qu’ils présentent comme mirifiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0589d909-d855-34fe-ba95-ab2828fea837",
                                        "entry_id": "74221ac2-86f4-35bd-b94d-972ba0df52bb",
                                        "glosses": [
                                            "Système dans lequel aucun frein n’empêche la circulation d’une chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "166e74a0-50a7-437d-afe8-4da46bae28fc",
                                                "sense_id": "0589d909-d855-34fe-ba95-ab2828fea837",
                                                "text": "Il n’y a plus d’intelligence ni d’efficacité possible hors du libre-échange des savoirs et des savoir-faire."
                                            }
                                        ]
                                    }
                                ]
                            },
