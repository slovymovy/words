                "senses": [
                    {
                        "sense_id": "856e5d3c-c43c-373b-93db-f219a5b5f3d4",
                        "entry_id": "b13702cb-72b6-382e-8e7c-1c197e37bb2c",
                        "glosses": [
                            "Défaire (quelque chose qui avait été confectionné)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "690d3f25-f513-46cd-bd59-e2cdc2d7cccd",
                                "sense_id": "856e5d3c-c43c-373b-93db-f219a5b5f3d4",
                                "text": "En fait non c'est l'inverse : il faut déconfectionner méticuleusement chaque chemise avant de reconfectionner un nouveau vêtement."
                            },
                            {
                                "example_id": "653a6d6d-5d12-4409-bf3d-dfb48d9a67d6",
                                "sense_id": "856e5d3c-c43c-373b-93db-f219a5b5f3d4",
                                "text": "De même lorsque vous déconfectionnez un objet bleu, vous avez la possibilité d'apprendre la version orange de la recette."
                            },
                            {
                                "example_id": "17cd9a98-cffa-48d5-8029-39736a51018b",
                                "sense_id": "856e5d3c-c43c-373b-93db-f219a5b5f3d4",
                                "text": "L'avantage de pouvoir déconfectionner c'est de pouvoir trouver un plan bleu qui te permettra donc de fabriquer des trucs bleus plus performants."
                            },
                            {
                                "example_id": "b80be469-3d17-4ab1-a026-78000733b7c1",
                                "sense_id": "856e5d3c-c43c-373b-93db-f219a5b5f3d4",
                                "text": "Envoi direct des ressources/objets à déconfectionner par les guildies en fonction de ses demandes."
                            }
                        ]
                    }
                ],
