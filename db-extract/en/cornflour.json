                        "entry_id": "02a00d7d-451a-381e-854b-f236b8520a7a",
                        "glosses": [
                            "A flour for baking and cooking that is ground from corn (maize)."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
