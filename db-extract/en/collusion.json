                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75cbabee-7cc6-457c-9ea4-cf89289bc4c3",
                        "source_entry_id": "37a8361d-9945-3182-a1eb-3475240352bb",
                        "source_sense_description": "conspiracy",
                        "target_lang_word": "samenzwering",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "samenzwering",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "e70239fe-738b-308c-b57c-04201b013b1c",
                                        "entry_id": "fce5b0e0-1092-3c30-b87c-9dfbb8f25fd6",
                                        "glosses": [
                                            "een geheime poging een onwettelijke daad te organiseren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8ff7838-7dfb-4141-b110-69178d8be659",
                                                "sense_id": "e70239fe-738b-308c-b57c-04201b013b1c",
                                                "text": "Er was een samenzwering om de president te vermoorden."
                                            },
                                            {
                                                "example_id": "f539617c-32c6-44df-80ff-78162becb4f2",
                                                "sense_id": "e70239fe-738b-308c-b57c-04201b013b1c",
                                                "text": "De commissie-Warren concludeerde dat Oswald het in zijn eentje had gedaan. Aanvankelijk overtuigde dat een meerderheid van de Amerikaanse bevolking, maar dat duurde niet lang. De lawine van waanzin die de moord ontketende, heeft tot gevolg gehad dat een ruime meerderheid van de Amerikaanse bevolking zeker meent te weten dat Kennedy het slachtoffer is geworden van een reusachtige samenzwering, wellicht de grootste en meest complexe uit de menselijke geschiedenis, en dat al het bewijsmateriaal op geniale wijze is vervalst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99b8f331-a350-4187-a710-54b98c48df09",
                        "source_entry_id": "37a8361d-9945-3182-a1eb-3475240352bb",
                        "source_sense_description": "conspiracy",
                        "target_lang_word": "samenspanning",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "samenspanning",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d2c754cb-6add-356c-a565-ed88e24711cc",
                                        "entry_id": "956bd818-28fa-3a5e-b3aa-e06f68d18401",
                                        "glosses": [
                                            "het samenbrengen van een groep mensen voor het maken van geheime, verradelijke plannen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272598a0-7f86-4043-a3c0-9baab25e25ef",
                                                "sense_id": "d2c754cb-6add-356c-a565-ed88e24711cc",
                                                "text": "Matteüs kon niet accepteren dat de Messias zo gemakkelijk door die schandalige samenspanning van een van zijn discipelen met de priesters werd verraden."
                                            },
                                            {
                                                "example_id": "c56d3622-83b4-4dbb-8464-1e72b595911f",
                                                "sense_id": "d2c754cb-6add-356c-a565-ed88e24711cc",
                                                "text": "Daarnaast werd Lai december vorig jaar al veroordeeld tot een maandenlange celstraf omdat hij een herdenking van de Chinese studentenopstand in 1989 bijwoonde. Er loopt bovendien nog een aanklacht tegen hem vanwege de nationale veiligheidswet die in 2020 werd ingevoerd in Hongkong om dissidenten aan te pakken. Formeel wordt Lai verdacht van 'samenspanning met buitenlandse machten'."
                                            },
                                            {
                                                "example_id": "487b5cb6-79e7-47a0-8d7b-5d96eac3790c",
                                                "sense_id": "d2c754cb-6add-356c-a565-ed88e24711cc",
                                                "text": "De Duitse federale politie heeft op het vliegveld in München een man opgepakt op verdenking van landverraad en samenspanning met een medewerker van de Duitse inlichtingendienst (BND). Arthur E., zoals de man is geïdentificeerd, werd afgelopen weekend gearresteerd toen hij uit de Verenigde Staten kwam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45fa9cf3-d404-4da9-889d-ec024aa6ba96",
                        "source_entry_id": "37a8361d-9945-3182-a1eb-3475240352bb",
                        "source_sense_description": "conspiracy",
