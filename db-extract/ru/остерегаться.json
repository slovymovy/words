                                "text": "остерега́йтесь воро́в!",
                                "translation": "beware of pickpockets!",
                                "english": "beware of pickpockets!"
                            },
                            {
                                "example_id": "4c144acb-2322-4bd9-b8b7-9d001f85f7f3",
                                "sense_id": "3c40dee5-e872-3961-a7d6-7db6eaa6f38a",
                                "text": "остерега́йтесь дешёвых подде́лок",
                                "translation": "beware of cheap imitations",
                                "english": "beware of cheap imitations"
