                    ]
                },
                {
                    "sense_id": "116adba2-7a14-38ac-a654-7dc684af2b19",
                    "sense_definition": "Provoquer la contraction soudaine et involontaire de muscles ou d'une partie du corps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physiologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'effet de la douleur, le patient <w>crispe</w> les mâchoires."
                        },
                        {
                            "text": "Il tente de maîtriser sa colère, mais il <w>crispe</w> les poings sous la table."
                        }
                    ],
                    "synonyms": [
                        "contracter",
                        "raidir",
                        "tendre"
                    ],
                    "antonyms": [
                        "décrisper",
