                ],
                "senses": [
                    {
                        "sense_id": "7af47e1f-2556-31db-9307-ce591efadb3b",
                        "entry_id": "951190a5-4f66-39f6-9225-e8cd7f82b64f",
                        "glosses": [
                            "das Wissen, das jemand von Sprache/Sprachen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f54e8672-73d1-4869-8432-7de0b69c8039",
                                "sense_id": "7af47e1f-2556-31db-9307-ce591efadb3b",
                                "text": "„S 27 hat sich so umfangreiches Sprachwissen angeeignet und kann bis heute mühelos Sätze bilden.“"
                            },
                            {
                                "example_id": "1a2e52db-db58-4e34-abca-1cb1d138d5ac",
                                "sense_id": "7af47e1f-2556-31db-9307-ce591efadb3b",
                                "text": "„Dafür braucht es Sprachwissen, Sprachgefühl, Achtung vor den jeweiligen Sprachen gepaart mit Toleranz und Einsicht in die Strukturiertheit von Sprache auch nach Gruppen und Verwendungsdomänen.“"
                            },
                            {
                                "example_id": "a950b48c-db21-496c-9081-d358cf8ed2f8",
                                "sense_id": "7af47e1f-2556-31db-9307-ce591efadb3b",
                                "text": "„Doch neben fundiertem Sprachwissen seien auch ein hohes Maß an Allgemeinbildung, Kreativität und kulturelle Kompetenz von ausdrücklicher Bedeutung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
