                "senses": [
                    {
                        "sense_id": "a4fd8914-46ea-3ea7-907a-96673a1fd8fc",
                        "entry_id": "e6540927-a64b-3bd3-b2fc-4c81c4be9661",
                        "glosses": [
                            "с высокой яркостью, излучащий много света"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ee09a94-3470-4374-88ba-6b7de6a357fb",
                                "sense_id": "a4fd8914-46ea-3ea7-907a-96673a1fd8fc",
                                "text": "Посёлок был погружен в ночную темень, лишь одно окно ярко светилось."
                            }
                        ]
                    },
                    {
                        "sense_id": "43fbdf91-b760-314a-9d08-25a4d0758d1a",
                        "entry_id": "e6540927-a64b-3bd3-b2fc-4c81c4be9661",
                        "glosses": [
                            "перен. отчётливо, очевидно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac9867d-ab25-44d0-9a5c-96d82e25df85",
                                "sense_id": "43fbdf91-b760-314a-9d08-25a4d0758d1a",
                                "text": "Чернобыльская катастрофа ярко высветила недостатки атомной отрасли."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffd48ebb-11de-36c2-8121-911ddfd9a9f6",
                        "entry_id": "e6540927-a64b-3bd3-b2fc-4c81c4be9661",
                        "glosses": [
                            "перен. впечатляюще"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8d62903-554a-41bc-81d4-e0cc047d13ef",
                                "sense_id": "ffd48ebb-11de-36c2-8121-911ddfd9a9f6",
                                "text": "Эмоционально и ярко выступил перед школьниками преподаватель из МИФИ."
                            },
                            {
                                "example_id": "d26b84c9-466e-4512-b150-f16a39719d5e",
                                "sense_id": "ffd48ebb-11de-36c2-8121-911ddfd9a9f6",
                                "text": "Очень ярко выступила на всероссийских соревнованиях сборная Владивостока."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2377171-ffd5-4462-a9d4-c27fcd52f648",
                        "source_entry_id": "e6540927-a64b-3bd3-b2fc-4c81c4be9661",
                        "target_lang_word": "luminously",
