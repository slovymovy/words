                "senses": [
                    {
                        "sense_id": "baaec36b-b351-31bd-8ae1-9ddbae9883a0",
                        "entry_id": "0b8d18e2-b720-3eee-a9c0-f5508d8bd9b8",
                        "glosses": [
                            "ein Zusatz zu einer Arznei oder einem Impfstoff, der die Wirkung unterstützt"
                        ],
                        "tags": [
                            "Pharmakologie"
                        ],
                        "examples": [
                            {
                                "example_id": "463e86cb-0227-4f2f-be0d-a948758eb71b",
                                "sense_id": "baaec36b-b351-31bd-8ae1-9ddbae9883a0",
                                "text": "Das ist nicht der Wirkstoff, sondern ein Adjuvans."
                            },
                            {
                                "example_id": "57deac57-62d6-406c-b8b1-2a583ba8cb71",
                                "sense_id": "baaec36b-b351-31bd-8ae1-9ddbae9883a0",
                                "text": "Ein Beispiel für eine arzneiliche Wirkverbesserung durch Adjuvantien stellt etwa der Einsatz von Penetrationsbeschleunigern dar, wie dem Dimethylsulfoxid (DMSO) in manchen Arzneimitteln zur Anwendung auf der Haut. Durch das beschleunigte Eindringen des Arzneistoffes werden höhere Wirkspiegel im Gewebe erreicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5829a75-0ec2-4dd4-966d-924ae152e659",
