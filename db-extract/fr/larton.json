                        "examples": [
                            {
                                "example_id": "dcfc6200-b18f-460f-9dfe-b16202ae42bb",
                                "sense_id": "e4affaed-f484-3594-b60b-3bd678ce7288",
                                "text": "- Eh mais! c'est du pain, du très bon pain de deuxième qualité.\n- Vous voulez dire du larton brutal, reprit Gavroche, calme et froidement dédaigneux. Du pain blanc, garçon! du larton savonné! je régale. — (Victor Hugo, Les Misérables : Le petit Gavroche)"
                            },
                            {
                                "example_id": "b06917f6-843c-47ee-9123-8872f789a05e",
                                "sense_id": "e4affaed-f484-3594-b60b-3bd678ce7288",
                                "text": "T’as pas d’mec. Ça, c’est bath! Merci.\nTout d’mêm’, dis pas niort au persil.\nSans lui, bonsoir la bagu’naud’ ronde!\nMoi, j’ suis birbass’, j’ai besoin de l’larton."
                            },
                            {
                                "example_id": "53c604b7-747f-4453-81f5-6a3597dd406b",
                                "sense_id": "e4affaed-f484-3594-b60b-3bd678ce7288",
                                "text": "La tortillade est la même pour la quantité, mais le pivoi est plus chenu, le larton un peu plus savonné que lago, et la batouse à limaces plus chenue aussi."
                            }
                        ]
                    }
