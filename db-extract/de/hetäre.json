                "senses": [
                    {
                        "sense_id": "fa71b519-5e77-32c3-b2d1-c29ed43316c0",
                        "entry_id": "e0fefd05-0843-3ed4-b8b3-5114c735c26f",
                        "glosses": [
                            "käufliche Frau, die im Gegensatz zu einer Dirne als hoch gebildet galt und sozial anerkannt war"
                        ],
                        "tags": [
                            "Griechisches Altertum"
                        ],
                        "examples": [
                            {
                                "example_id": "70fd7ec7-6086-482a-a6fe-f2929f250f4e",
                                "sense_id": "fa71b519-5e77-32c3-b2d1-c29ed43316c0",
                                "text": "Der Einfluss der Hetären als Geliebte von bedeutenden Staatsmännern, Dichtern, Philosophen und Künstlern darf nicht unterschätzt werden."
                            },
                            {
                                "example_id": "a534f7c2-251b-4ea0-aa15-2e7d1a4b3cc3",
                                "sense_id": "fa71b519-5e77-32c3-b2d1-c29ed43316c0",
                                "text": "Aspasia, Thaïs und Frine waren berühmte Hetären im Alten Athen."
                            },
                            {
                                "example_id": "e37423be-d6a9-4e8f-ba01-fbad84d658c9",
                                "sense_id": "fa71b519-5e77-32c3-b2d1-c29ed43316c0",
                                "text": "„Polen hat seine Hetären auch jetzt noch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31c3b411-4803-4592-9d5b-da1465d50e45",
                        "source_entry_id": "e0fefd05-0843-3ed4-b8b3-5114c735c26f",
                        "source_sense_id": "fa71b519-5e77-32c3-b2d1-c29ed43316c0",
                        "target_lang_word": "hetaera",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hetaera",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a144b92-19e4-32d7-8fc8-60360b78c587",
                                        "entry_id": "f1cb92b7-d8ef-3fe6-a12d-d16f8662e168",
                                        "glosses": [
                                            "A highly cultivated hired female companion who would entertain upper-class male clients and might perform sex acts for them."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbf3823e-a9fe-4245-b4ae-a8056fb30014",
                                                "sense_id": "8a144b92-19e4-32d7-8fc8-60360b78c587",
                                                "text": "But of course our friend is only a shallow twentieth-century reproduction of the great hetairae of the past, the type to which she belongs without knowing it, Lais, Charis and the rest..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79a464d2-ad0a-3298-9642-876db63fd190",
                                        "entry_id": "f1cb92b7-d8ef-3fe6-a12d-d16f8662e168",
                                        "glosses": [
                                            "A mistress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a273c83d-ce05-472d-8c61-4f3213d558fc",
                                                "sense_id": "79a464d2-ad0a-3298-9642-876db63fd190",
                                                "text": "Woman is dethroned as the primary and supreme sex, debased into inseminable hetaera."
                                            },
                                            {
                                                "example_id": "6f255246-1ba2-4d8d-ad7b-0eb71efccbf6",
                                                "sense_id": "79a464d2-ad0a-3298-9642-876db63fd190",
                                                "text": "Christ appeared, only to reveal himself as the naked god Pan. Ballet of hetaerae and houris, choreography by Italo Castaldi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f3af289-d369-4df8-9541-d64aea59854c",
                        "source_entry_id": "e0fefd05-0843-3ed4-b8b3-5114c735c26f",
                        "source_sense_id": "fa71b519-5e77-32c3-b2d1-c29ed43316c0",
                        "target_lang_word": "hétaïre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hétaïre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9295d299-6760-36ef-951b-8f35b9695114",
                                        "entry_id": "acfe1b4d-a1b3-3616-b5c9-26d74db8de51",
                                        "glosses": [
                                            "Femme éduquée et de haut niveau social qui offre compagnie et services sexuels, souvent de manière non ponctuelle."
                                        ],
                                        "tags": [
                                            "Ancient-Greek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe9d1e5f-f4d5-465a-8384-9fccb53ebacf",
                                                "sense_id": "9295d299-6760-36ef-951b-8f35b9695114",
                                                "text": "J’ai songé que si Périclès avait été maire de Paris quand je suis arrivé en France, il aurait sûrement envoyé gare de Lyon une hétaïre pour m’accueillir, vêtue d’une espèce de chemise de nuit, pieds nus."
                                            },
                                            {
                                                "example_id": "58798903-116c-463c-b328-7c9caa46ca74",
                                                "sense_id": "9295d299-6760-36ef-951b-8f35b9695114",
                                                "text": "Nous sommes nés par un acte érotique et à travers une femme, et c’est par un acte érotique et à travers une femme qu’il nous faudra mourir, à travers l’hétaïre de la mort qui est l’antinomie et le complément suprême de la Mère… Quand nous mourrons, nous naissons à rebours…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2546860-e408-3d3c-b484-154c6b4a19d5",
                                        "entry_id": "acfe1b4d-a1b3-3616-b5c9-26d74db8de51",
                                        "glosses": [
                                            "Femme vénale, qui fait profession du commerce charnel, courtisane."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ea779b4-6a1f-4ca3-ab65-3d54cd7a0e4f",
                                                "sense_id": "f2546860-e408-3d3c-b484-154c6b4a19d5",
                                                "text": "Louise Bacalona est une des ces dames dont la chambre à coucher a autant de visites qu’un caravansérail. M. Prud’homme dit à son fils : c’est une hétaïre."
                                            },
                                            {
                                                "example_id": "21f5faf3-b11b-4c93-a5c3-bb59991cdeee",
                                                "sense_id": "f2546860-e408-3d3c-b484-154c6b4a19d5",
                                                "text": "Un homme, monsieur le Curé, à qui on aurait donné le bon Dieu sans confession et qui se débauchait avec des hétaïres."
                                            },
                                            {
                                                "example_id": "ab481c2e-56d8-44f5-b092-1d1afbc77633",
                                                "sense_id": "f2546860-e408-3d3c-b484-154c6b4a19d5",
                                                "text": "Elles vont du putanat prolétarien à l’émerveillement de l’hétaïre haut cotée, jouant des fesses dans le velours et dans la soie."
                                            },
                                            {
                                                "example_id": "43c7b140-e0a8-4da2-a1bc-7db9b107b80e",
                                                "sense_id": "f2546860-e408-3d3c-b484-154c6b4a19d5",
                                                "text": "En effet, après le coït, les hommes les plus rudes pleuraient comme des enfants entre les cuisses en sueur des hétaïres, et pour une promesse de plaisir ils étaient capables de vendre la République."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
