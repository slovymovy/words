                        "entry_id": "e614ed76-14c9-31cb-910a-e2db6d77d00f",
                        "glosses": [
                            "A colourless organic compound, CH₃CHO, occurring widely in nature and being produced on a large scale in industry."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
