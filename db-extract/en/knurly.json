                        "glosses": [
                            "Gnarled or knotty; hard and misshapen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d1ea31-b35b-4a07-bdf6-76a85a88dcf8",
                                "sense_id": "74d1aad1-2635-372b-93f2-d54b07d84025",
                                "text": "It seems too much like a great tree, beautiful, symmetrical, and full of leaves, but raised or desired only for fruit, yet bearing little, and some of that little not of good quality, but knurly or bitter."
                            },
                            {
                                "example_id": "61567109-0f7c-460b-a3ec-0b72d47a47d7",
                                "sense_id": "74d1aad1-2635-372b-93f2-d54b07d84025",
                                "text": "\"Well, I swow!\" ejaculated the Cap'n, rubbing his knurly forefinger under his nose, and glancing first at the parrots and then at the lady."
                            }
                        ]
                    }
