                ],
                "senses": [
                    {
                        "sense_id": "9428b063-b113-35d6-a5b1-70a2c8834f71",
                        "entry_id": "8f6c6ba1-603a-38b5-8619-11faa392a187",
                        "glosses": [
                            "Abdeckung eines Gebäudes, gedeckt mit Stroh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97649ccc-0a87-4bbf-8452-df04d8a942db",
                                "sense_id": "9428b063-b113-35d6-a5b1-70a2c8834f71",
                                "text": "„Typisch für die Region sind kleine Holzhäuser mit steilen Stroh- oder Schindeldächern, bunten Fensterrahmen und kunstvollen Schnitzereien.“"
                            },
                            {
                                "example_id": "69b92742-8757-4b5f-b117-59d5eae1a629",
                                "sense_id": "9428b063-b113-35d6-a5b1-70a2c8834f71",
                                "text": "„Strohdächer, in die der Blitz gefahren war, qualmten und dampften heftig unter den Regenfluten.“"
                            },
                            {
                                "example_id": "2c4145cb-c2ef-4e05-9b23-0d2c37ac27ed",
                                "sense_id": "9428b063-b113-35d6-a5b1-70a2c8834f71",
                                "text": "„Ruth Holland starrte durch den Stacheldraht zu dem hinüber, was drüben war: einer Wiese, Äckern, ein paar Bäumen, einem Bauernhaus mit einem Strohdach und, ferner, auf einem Hügel, einem weißen, niedrigen Hause mit einem Garten.“"
                            },
                            {
                                "example_id": "7e8ba53e-061e-4930-ad5a-faffc4b3224c",
                                "sense_id": "9428b063-b113-35d6-a5b1-70a2c8834f71",
                                "text": "„Doch es gab auch viele kleine Bauernhöfe und Hütten, sowohl dicht nebeneinander wie verstreut, mit Lehmwänden und Strohdächern und Hühnern davor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
