                ],
                "translations": [
                    {
                        "translation_id": "3adea814-5788-4737-a888-49f644d4b6b7",
                        "source_entry_id": "7047fde1-c8c9-3738-9469-e52278f011e1",
                        "source_sense_id": "b32f2a8a-f1fb-3c45-a524-5a09e7070b31",
