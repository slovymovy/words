                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14483b28-9631-41ac-9e49-48fb469cfc48",
                        "source_entry_id": "ee6a7b08-5f91-39e3-b416-567f3624cf10",
                        "target_lang_word": "trots",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trots",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "fbaa450f-143a-33e4-93eb-a03e06e55f43",
                                        "entry_id": "3a7ff3b8-eb5f-36e8-837f-33a65373221b",
                                        "glosses": [
                                            "erg blij met wat men (bereikt) heeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dfd48b8-b1ae-47cf-a5d7-987ece4ad84f",
                                                "sense_id": "fbaa450f-143a-33e4-93eb-a03e06e55f43",
                                                "text": "In 1989 nam Henriroux de zaak over. 'We zijn trots op onze geschiedenis, maar proberen altijd vooruit te denken', zegt hij. Henriroux opende een hotel en een tweede restaurant waar je goed kunt eten tegen redelijke prijzen."
                                            },
                                            {
                                                "example_id": "52add71d-e23a-4410-baca-f3be587887b9",
                                                "sense_id": "fbaa450f-143a-33e4-93eb-a03e06e55f43",
                                                "text": "De zelfverzekerde toon in haar stem maakte mij op dat moment de trotste vader van de wereld, maar zou zij ook trots op mij zijn? Ik betwijfelde het."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75094190-898b-330d-94f6-9266640247cf",
                                        "entry_id": "3a7ff3b8-eb5f-36e8-837f-33a65373221b",
                                        "glosses": [
                                            "vervuld van eigen grootheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9947d7ad-5f96-44fe-94bd-7db6f72406f3",
                                                "sense_id": "75094190-898b-330d-94f6-9266640247cf",
                                                "text": "Jullie moeten ons, trotse Grieken, lenen zonder voorwaarden op te leggen (en of we ooit terugbetalen, moeten jullie maar afwachten"
                                            },
                                            {
                                                "example_id": "aad15d34-9049-4e88-8cbc-b0c5cb4f9f91",
                                                "sense_id": "75094190-898b-330d-94f6-9266640247cf",
                                                "text": "Natuurlijk zijn ze in Assen onverminderd trots op 'hun' Harry. Gastconservator Albert Haar noemt hem graag een icoon voor Drenthe, een voorbeeld voor de provinciale jeugd. Maar Muskee was natuurlijk meer dan dat. Met zijn muziek en zijn dwarsheid was hij een exponent van de anarchie van de jaren zestig. Die levenshouding bracht hem fans in heel Nederland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "132e564f-a0c8-33ea-a62b-0702ab750b58",
                                        "entry_id": "3a7ff3b8-eb5f-36e8-837f-33a65373221b",
                                        "glosses": [
                                            "verwaand, hoogmoedig, hovaardig, hooghartig"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": []
                                    }
                                ]
