                                    {
                                        "sense_id": "334ad5e3-9319-3aca-89f2-f245bbf72db9",
                                        "entry_id": "08dffddf-c803-39f5-8a57-0d23e32a2dcd",
                                        "glosses": [
                                            "den Kolonialismus vertretend, auf der Grundlage von Kolonialismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c41ac03a-f5a3-4d0b-80a2-9fd0cf634aa6",
                                                "sense_id": "334ad5e3-9319-3aca-89f2-f245bbf72db9",
                                                "text": "„Er widersetzte sich den Forderungen der örtlichen Führung nach Mitsprache bei den Entscheidungen der Zionistischen Kommission und legte eine Haltung an den Tag, die arrogant, fast kolonialistisch war: Weizmann kam aus London und beanspruchte für sich, das gesamte jüdische Volk zu vertreten.“"
                                            },
                                            {
                                                "example_id": "75c2ff8f-7b22-45f8-8c39-ce916b53ef40",
                                                "sense_id": "334ad5e3-9319-3aca-89f2-f245bbf72db9",
                                                "text": "„‚Primitive‘ waren demzufolge wie die Kinder, was weitverbreiteten kolonialistischen, auch von Verwoerd geteilten, Annahmen entsprach, wobei Krueger behauptete, ‚Primitive‘ seien stärker gefühlsgeleitet, Zivilisierte verstandesorientiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
