                "senses": [
                    {
                        "sense_id": "8fc40e51-3107-39f3-bbf9-ace4382fad3b",
                        "entry_id": "950db1ab-c890-3298-991b-72a092a1b259",
                        "glosses": [
                            "het kloppen van het hart"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3bb3afa6-ffc5-36a5-a610-44125055bc16",
                        "entry_id": "950db1ab-c890-3298-991b-72a092a1b259",
                        "glosses": [
                            "het ritme waarmee het hart klopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b82228e1-325e-44d6-9253-70130f479172",
                                "sense_id": "3bb3afa6-ffc5-36a5-a610-44125055bc16",
                                "text": "Oscar voelde zijn hartslag toenemen, net alsof hij op de uitkijk zat."
                            },
                            {
                                "example_id": "c6fa217d-2596-464d-93c5-9ad3e008089b",
                                "sense_id": "3bb3afa6-ffc5-36a5-a610-44125055bc16",
                                "text": "Er gebeurden rare dingen in me wanneer we daar achter een paar struiken stonden en elkaar streelden zonder dat ze ook maar één keer mijn handen weghaalde. Het was niet alleen dat mijn hartslag toenam en ik een erectie kreeg, het was alsof ik werd opgepompt als een autoband en elk moment kon ontploffen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e7cd12a-fc23-4de3-a23e-5574e64c51f3",
                        "source_entry_id": "950db1ab-c890-3298-991b-72a092a1b259",
                        "target_lang_word": "Herzschlag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herzschlag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d11edcec-4d41-36c6-831a-69bd67ffb9ae",
                                        "entry_id": "fb5434ac-f3c4-343a-ad16-e70dfb3993c7",
                                        "glosses": [
                                            "Herzinfarkt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2dabe47-a9c6-4705-967e-13e6dc00460f",
                                                "sense_id": "d11edcec-4d41-36c6-831a-69bd67ffb9ae",
                                                "text": "„Dem aber geht die Scheidung so nah, daß er unmittelbar nach ihrer Abreise am Herzschlag stirbt.“"
                                            },
                                            {
                                                "example_id": "cea8e605-9b45-40eb-9353-37bbbf6a393f",
                                                "sense_id": "d11edcec-4d41-36c6-831a-69bd67ffb9ae",
                                                "text": "„Ich bekam fast einen Herzschlag, da das Wasser, das von den Gletschern kam, entsetzlich kalt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b95dfa05-6e09-3c07-89de-fa18bf28c9d7",
                                        "entry_id": "fb5434ac-f3c4-343a-ad16-e70dfb3993c7",
                                        "glosses": [
                                            "Kontraktion der Herzmuskulatur; der Schlag des Herzens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b7116c-2456-43f7-a24d-74e00db22663",
                                                "sense_id": "b95dfa05-6e09-3c07-89de-fa18bf28c9d7",
                                                "text": "„Jeder Herzschlag des Patienten wird analysiert und bei Auftreten von Herzrhythmusstörungen das entsprechende EKG gespeichert.“"
                                            },
                                            {
                                                "example_id": "b9f18f25-28e1-4a11-86af-0c7ba6f81ce8",
                                                "sense_id": "b95dfa05-6e09-3c07-89de-fa18bf28c9d7",
                                                "text": "„Das Plastikarmband misst alle fünf Sekunden Körpertemperatur und Herzschlag und sendet die Daten ans elterliche Smartphone.“"
                                            },
                                            {
                                                "example_id": "08b5ead6-1f8a-42c9-a90a-103d69f5b25c",
                                                "sense_id": "b95dfa05-6e09-3c07-89de-fa18bf28c9d7",
                                                "text": "„Dann wurde Helena blaß, und ihr Herzschlag setzte einen Moment aus.“"
                                            },
                                            {
                                                "example_id": "84ef3e3b-fbfe-44e6-a2cc-e430a2ac355c",
                                                "sense_id": "b95dfa05-6e09-3c07-89de-fa18bf28c9d7",
                                                "text": "„Die Sonne brannte schräg vom Himmel, und die Hitze nahm mit jedem Herzschlag zu.“"
                                            },
                                            {
                                                "example_id": "d94361ea-663b-4efa-8014-59aa522b69e6",
                                                "sense_id": "b95dfa05-6e09-3c07-89de-fa18bf28c9d7",
                                                "text": "„Meine Rippen sortierten sich nach jedem Herzschlag neu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "716a82ec-36e1-41e7-8c60-653d8fc58f44",
                        "source_entry_id": "950db1ab-c890-3298-991b-72a092a1b259",
                        "target_lang_word": "heartbeat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heartbeat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cffc9b25-19fc-3136-a981-76bbace5d466",
                                        "entry_id": "b3bdd23b-92a4-32ba-9231-3d29b0e8386a",
                                        "glosses": [
                                            "One pulsation of the heart; especially an irregular one, hence the emotion which causes it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d827a72-8fee-46c4-bae9-30fcc28c73f9",
                                                "sense_id": "cffc9b25-19fc-3136-a981-76bbace5d466",
                                                "text": "The policeman waited for a heartbeat in vain."
                                            },
                                            {
                                                "example_id": "7f216787-3c6a-4f7d-b18b-4f2a1a34484f",
                                                "sense_id": "cffc9b25-19fc-3136-a981-76bbace5d466",
                                                "text": "He alone gives me such heartbeats."
                                            },
                                            {
                                                "example_id": "1459f046-f15e-48d5-9672-3d3ac9674ffa",
                                                "sense_id": "cffc9b25-19fc-3136-a981-76bbace5d466",
                                                "text": "Both CRT-Ds and ICDs are implanted under the skin, in the patient’s upper chest area. The devices have wires called leads that attach to the heart and regulate the rhythm of the muscle. Defibrillators help patients with bradycardia – a slow heartbeat – by pacing the heartbeat and those with tachycardia – a fast heartbeat – by delivering shocks that reset heartbeats to normal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cf9a0f7-df4a-3cd2-8a84-fba1b8e29198",
                                        "entry_id": "b3bdd23b-92a4-32ba-9231-3d29b0e8386a",
                                        "glosses": [
                                            "The rhythm at which a heart pulsates, a cardiac indicator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "538ca423-875f-44f7-8110-413f9f74e3fe",
                                                "sense_id": "7cf9a0f7-df4a-3cd2-8a84-fba1b8e29198",
                                                "text": "If your heartbeat doesn't normalize soon, consult a doctor!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8b10e8d-354b-3589-b89b-f7a0be9e6951",
                                        "entry_id": "b3bdd23b-92a4-32ba-9231-3d29b0e8386a",
                                        "glosses": [
                                            "A driving impulse or vital force; the vital center of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d807fc65-ea4e-46ad-b912-ceb58c2a1194",
                                                "sense_id": "a8b10e8d-354b-3589-b89b-f7a0be9e6951",
                                                "text": "Music is the heartbeat of the people."
                                            },
                                            {
                                                "example_id": "01915a5a-7179-4b6b-8797-afae9f5737d3",
                                                "sense_id": "a8b10e8d-354b-3589-b89b-f7a0be9e6951",
                                                "text": "Dream Body Recovery is just one of countless recovery houses that have cropped up in Miami, which has become the heartbeat of the B.B.L. boom in the United States. The average price of a B.B.L. nationwide is around $5,000, according to the American Society of Plastic Surgeons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54c0a052-9317-3899-8b91-98d034b9bda8",
                                        "entry_id": "b3bdd23b-92a4-32ba-9231-3d29b0e8386a",
                                        "glosses": [
                                            "A very short space of time; an instant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b3e10a1-cc7a-4f38-a751-7c2a529f1eb5",
                                                "sense_id": "54c0a052-9317-3899-8b91-98d034b9bda8",
                                                "text": "The ambulance arrived in a heartbeat."
                                            },
                                            {
                                                "example_id": "52d7ccfa-496d-4156-a9ee-383a4f8e95d3",
                                                "sense_id": "54c0a052-9317-3899-8b91-98d034b9bda8",
                                                "text": "Cause I love you more than life Take a bullet for you I swear, I swear In a heartbeat"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e8cc09c-af29-3e37-87d7-e70ca484b004",
                                        "entry_id": "b3bdd23b-92a4-32ba-9231-3d29b0e8386a",
                                        "glosses": [
                                            "A periodic signal generated by hardware or software to indicate normal operation or to synchronize other parts of a system."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
