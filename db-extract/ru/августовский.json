                                            {
                                                "example_id": "8b4dcdbd-2534-4fb4-8cdc-26fa67f3061a",
                                                "sense_id": "c9d41e12-3725-3be9-a984-e946e8f0b92c",
                                                "text": "Holonyms: calendar year; year"
                                            },
                                            {
                                                "example_id": "a7d9ad9a-4b6d-4c6c-9813-e77bdf946da5",
                                                "sense_id": "c9d41e12-3725-3be9-a984-e946e8f0b92c",
                                                "text": "The day was cool and snappy for August, and the Rise all green with a lavish nature. Now we plunged into a deep shade with the boughs lacing each other overhead, and crossed dainty, rustic bridges over the cold trout-streams, the boards giving back the clatter of our horses' feet:[…]."
                                            },
                                            {
                                                "example_id": "21388af5-d5c8-4984-8d5e-80a210202b01",
                                                "sense_id": "c9d41e12-3725-3be9-a984-e946e8f0b92c",
                                                "text": "Trump’s July 8 announcement of a 50% tariff on copper imports beginning August 1 sent prices surging 13% in one day, up to a record high of $5.69 per pound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b658cf96-a960-376d-ad9a-fdc490e4b84f",
                                        "entry_id": "641a6612-1938-3bee-a0f1-f9681ab7133a",
                                        "glosses": [
                                            "A female given name from English derived from the month (of birth)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e32250-88d4-4c4e-b419-c14987a23c7d",
                                                "sense_id": "b658cf96-a960-376d-ad9a-fdc490e4b84f",
                                                "text": "August, Charis named her, because that's when she was born. Warm breezes, baby powder, languorous heat, the smell of mown hay. Such a soft name. Too soft for her daughter, who has added an a. Augusta, she is now — a very different resonance. Marble statues, Roman noses, tight-lipped commanding mouths."
                                            },
                                            {
                                                "example_id": "520eff1b-6ad7-4401-b19f-adc07a79a95d",
                                                "sense_id": "b658cf96-a960-376d-ad9a-fdc490e4b84f",
                                                "text": "AUGUST[ 2017]: [Mark] Zuckerberg and [Priscilla] Chan's second daughter, August, is born."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "August",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cdbf33c-c34b-3149-879c-9dcfd7eb889e",
                                        "entry_id": "4e4391de-a5dc-3580-96f7-c9f624d13c26",
                                        "glosses": [
                                            "A male given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18fbae2a-564b-4676-9d10-5225ccba329d",
                                                "sense_id": "9cdbf33c-c34b-3149-879c-9dcfd7eb889e",
                                                "text": "Thirteen year old August is the eldest; he begins to pull the kite downward. Like his sister and brother, June and July, he has been named after the month in which he was born."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36646946-c931-3d2e-ba41-c7b9e7b66c4c",
                                        "entry_id": "4e4391de-a5dc-3580-96f7-c9f624d13c26",
                                        "glosses": [
                                            "A surname from Latin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "067a1b28-40c1-358a-b70b-578a7e5585bc",
                                        "entry_id": "4e4391de-a5dc-3580-96f7-c9f624d13c26",
                                        "glosses": [
                                            "A census-designated place in San Joaquin County, California, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
