                "senses": [
                    {
                        "sense_id": "c98b8447-7cba-38ed-94e1-881367cfd0cc",
                        "entry_id": "0b00bf62-60f1-3977-a1ba-7fa8b7c7d451",
                        "glosses": [
                            "weibliche Person, die ein Museum besucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a1daab4-0a9e-4fa8-af4a-859e82dfc51c",
                                "sense_id": "c98b8447-7cba-38ed-94e1-881367cfd0cc",
                                "text": "„Eine weitere Museumsbesucherin berichtete später im norwegischen Rundfunksender NTB, sie habe einen Mann mit einer schwarzen Maske gesehen, der eine Sicherheitsbedienstete zu Boden gezwungen habe.“"
                            },
                            {
                                "example_id": "d2896429-3512-425e-9054-713415e2d7e6",
                                "sense_id": "c98b8447-7cba-38ed-94e1-881367cfd0cc",
                                "text": "„Das scharfe Auge einer Museumsbesucherin für stilistische Ähnlichkeiten hat in New York zur Entdeckung eines Kunstwerks geführt, das bisher allein dem Titel nach bekannt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
