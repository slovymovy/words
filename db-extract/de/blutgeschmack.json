                                "example_id": "b9cf9870-5338-4446-9185-a10d7142247b",
                                "sense_id": "715970c1-849f-392e-8ae7-147d13c124b6",
                                "text": "„Die Schuhe des Jungen schlappten hinter ihm her. Blutgeschmack im Mund.“"
                            },
                            {
                                "example_id": "a34d20a3-4392-48a0-b7b5-c639bd60a295",
                                "sense_id": "715970c1-849f-392e-8ae7-147d13c124b6",
                                "text": "„Man kommt von einem gewonnenen Kampf, schweißdurchtränkt, mit Blutgeschmack im Mund, im Rauschzustand, aber trotzdem von dem Wunsch erfüllt, weiterzumachen.“"
                            }
