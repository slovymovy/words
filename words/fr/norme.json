                    "frequency": "High",
                    "semantic_group_id": "standard_technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet appareil électroménager est conforme à la <w>norme</w> européenne en vigueur et garantit une sécurité optimale."
                        },
                        {
                            "text": "L'entreprise a dû adapter ses usines pour respecter les nouvelles <w>normes</w> environnementales."
                        }
                    ],
                    "synonyms": [
                        "standard"
                    ],
                    "common_phrases": [
