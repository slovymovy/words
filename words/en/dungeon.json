{
    "word_family": [
        "donjon"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a7b457e-686b-3c31-a867-0507ac492d72",
                    "sense_definition": "An underground prison or vault, typically built underneath a castle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "prison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight was locked away in a dark <w>dungeon</w> beneath the castle walls.",
                            "target_lang_translations": {
                                "ru": "Рыцарь был заперт в темном <w>подземелье</w> под стенами замка."
                            }
                        },
                        {
                            "text": "Year after year he lay patiently in a <w>dungeon</w> waiting for his rescue.",
                            "target_lang_translations": {
                                "ru": "Год за годом он терпеливо лежал в <w>темнице</w>, ожидая своего спасения."
                            }
                        }
                    ],
                    "synonyms": [
                        "oubliette",
                        "cell"
                    ],
                    "common_phrases": [
                        "castle dungeon",
                        "dark dungeon",
                        "underground dungeon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подземная тюрьма или сводчатое помещение, обычно расположенное под замком."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подземелье",
                                "target_lang_sense_clarification": "подземное помещение"
                            },
                            {
                                "target_lang_word": "темница",
                                "target_lang_sense_clarification": "устаревшее или поэтическое название тюрьмы"
                            },
                            {
                                "target_lang_word": "каземат",
                                "target_lang_sense_clarification": "одиночная камера в крепости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ef6ebad-03d4-39c9-90b1-0ea36cde9f7d",
                    "sense_definition": "In games, an area inhabited by enemies, containing story objectives, treasure, and bosses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our party entered the <w>dungeon</w> to defeat the dragon and claim the gold.",
                            "target_lang_translations": {
                                "ru": "Наша группа вошла в <w>подземелье</w>, чтобы победить дракона и забрать золото."
                            }
                        },
                        {
                            "text": "The final <w>dungeon</w> in this game is incredibly difficult to complete.",
                            "target_lang_translations": {
                                "ru": "Финальный <w>данж</w> в этой игре невероятно сложно пройти."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dungeon crawl",
                        "final dungeon"
                    ],
                    "target_lang_definitions": {
                        "ru": "В играх — локация, населенная врагами, содержащая цели сюжета, сокровища и боссов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подземелье",
                                "target_lang_sense_clarification": "игровая локация"
                            },
                            {
                                "target_lang_word": "данж",
                                "target_lang_sense_clarification": "игровой сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3393f291-50b7-3de7-be76-068baa5e57b8",
                    "sense_definition": "The main tower of a motte or castle; a keep or donjon.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lord retreated to the <w>dungeon</w> of the castle during the siege.",
                            "target_lang_translations": {
                                "ru": "Лорд отступил в <w>донжон</w> замка во время осады."
                            }
                        },
                        {
                            "text": "Historians studied the architecture of the medieval <w>dungeon</w> tower.",
                            "target_lang_translations": {
                                "ru": "Историки изучали архитектуру средневековой <w>главной башни</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "keep",
                        "donjon"
                    ],
                    "common_phrases": [
                        "castle dungeon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Главная башня средневекового замка; донжон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "донжон",
                                "target_lang_sense_clarification": "главная башня замка"
                            },
                            {
                                "target_lang_word": "главная башня",
                                "target_lang_sense_clarification": "архитектурный элемент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0b5c4a1-d206-3458-bbd1-f9002c396c9c",
                    "sense_definition": "A room dedicated to sadomasochistic sexual activity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sexual_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The club features a private <w>dungeon</w> for its members.",
                            "target_lang_translations": {
                                "ru": "В клубе есть частное <w>подземелье</w> для его членов."
                            }
                        },
                        {
                            "text": "They spent the evening in a specially equipped <w>dungeon</w>.",
                            "target_lang_translations": {
                                "ru": "Они провели вечер в специально оборудованном <w>данжене</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещение, предназначенное для садомазохистских сексуальных практик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подземелье",
                                "target_lang_sense_clarification": "тематическое помещение"
                            },
                            {
                                "target_lang_word": "данжен",
                                "target_lang_sense_clarification": "сленг в БДСМ-культуре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5db34e4a-8a16-3535-8511-ead778e5513f",
                    "sense_definition": "The low area between two drumlins.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geologist pointed out the <w>dungeon</w> formed between the two glacial hills.",
                            "target_lang_translations": {
                                "ru": "Геолог указал на <w>низину</w>, образовавшуюся между двумя ледниковыми холмами."
                            }
                        },
                        {
                            "text": "Water often collects in the <w>dungeon</w> during the rainy season.",
                            "target_lang_translations": {
                                "ru": "В сезон дождей во <w>впадине</w> часто скапливается вода."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Низменная область между двумя друмлинами (ледниковыми холмами)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "низина",
                                "target_lang_sense_clarification": "географическое углубление"
                            },
                            {
                                "target_lang_word": "впадина",
                                "target_lang_sense_clarification": "между холмами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5febe2a3-4a28-328c-a701-ff92a76104e3",
                    "sense_definition": "A shrewd or clever person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a regular <w>dungeon</w> when it comes to business negotiations.",
                            "target_lang_translations": {
                                "ru": "Он настоящий <w>умница</w>, когда дело доходит до деловых переговоров."
                            }
                        },
                        {
                            "text": "The old man was known as a <w>dungeon</w> for his sharp wit.",
                            "target_lang_translations": {
                                "ru": "Старик был известен как светлая <w>голова</w> благодаря своему острому уму."
                            }
                        }
                    ],
                    "synonyms": [
                        "shrewd"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily used in certain regional dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проницательный или умный человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умница",
                                "target_lang_sense_clarification": "очень способный человек"
                            },
                            {
                                "target_lang_word": "голова",
                                "target_lang_sense_clarification": "о мудром, сообразительном человеке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dc8f7271-a950-3028-a4b2-318df94d42d1",
                    "sense_definition": "To imprison someone in a dungeon.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "imprisonment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tyrant decided to <w>dungeon</w> his enemies rather than execute them.",
                            "target_lang_translations": {
                                "ru": "Тиран решил <w>заточить в подземелье</w> своих врагов, а не казнить их."
                            }
                        },
                        {
                            "text": "They were accused of <w>dungeoning</w> and gagging the people without trial.",
                            "target_lang_translations": {
                                "ru": "Их обвинили в том, что они <w>бросали в темницы</w> и затыкали рты людям без суда."
                            }
                        }
                    ],
                    "synonyms": [
                        "imprison",
                        "incarcerate"
                    ],
                    "antonyms": [
                        "release",
                        "free"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заточить кого-либо в подземелье или тюрьму."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заточить",
                                "target_lang_sense_clarification": "поместить в темницу"
                            },
                            {
                                "target_lang_word": "бросить в подземелье",
                                "target_lang_sense_clarification": "лишить свободы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}