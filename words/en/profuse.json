                                "target_lang_sense_clarification": "чрезмерно богатый или расточительный"
                            },
                            {
                                "target_lang_word": "чрезмерный",
                                "target_lang_sense_clarification": "слишком обильный"
                            }
                        ]
                    }
                }
            ]
        },
        {
