                                        "glosses": [
                                            "Art und Weise, von der eine Sache betrachtet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c056d8d4-4445-4b54-8897-465fb1801d96",
                                                "sense_id": "4a39eeb6-c734-3fc8-a94a-90372523bfe7",
                                                "text": "Aus meiner Perspektive betrachtet stellt sich der Vorgang anders dar."
                                            },
                                            {
                                                "example_id": "1ef247e1-13b2-4f86-98fd-f8a77aac5ff3",
                                                "sense_id": "4a39eeb6-c734-3fc8-a94a-90372523bfe7",
                                                "text": "„Kein anderer Erdteil wurde aus europäischer Perspektive so eng mit einem einzigen Topos verbunden.“"
                                            },
                                            {
                                                "example_id": "aa51b0a8-5e23-45ac-b4ad-6aa8b0352bd2",
                                                "sense_id": "4a39eeb6-c734-3fc8-a94a-90372523bfe7",
                                                "text": "„Doch Kultur existiert aus der Perspektive der Verfasser nur auf einer Seite.“"
                                            },
                                            {
                                                "example_id": "bce193fb-b7bb-46c1-8026-e51ef5cd7297",
                                                "sense_id": "4a39eeb6-c734-3fc8-a94a-90372523bfe7",
                                                "text": "„Ich berichte im folgenden aus der Perspektive des Hochschullehrers in Erinnerung an die Vorgänge der damaligen Jahre.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
