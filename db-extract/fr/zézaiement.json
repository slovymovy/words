        "fr-extract.jsonl": [
            {
                "entry_id": "f615b343-a7b4-3a8b-b16c-6cb932d8ed79",
                "word": "zézaiement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cce8a79b-c76f-4c44-9eba-f38d67d6d1f2",
                        "entry_id": "f615b343-a7b4-3a8b-b16c-6cb932d8ed79",
                        "tags": [
                            "plural"
                        ],
                        "form": "zézaiements"
                    },
                    {
                        "form_id": "d26bd486-3c6c-4336-bfd3-84c58aacf3c8",
                        "entry_id": "f615b343-a7b4-3a8b-b16c-6cb932d8ed79",
                        "tags": [],
                        "form": "zézayement"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "82b746a8-10d4-3d93-8fdd-3bfaf5981d0c",
                        "entry_id": "f615b343-a7b4-3a8b-b16c-6cb932d8ed79",
                        "glosses": [
                            "Fait de zézayer, vice de prononciation par lequel on donne aux sons \\\\ʒ, s\\\\ (j ou s) le son \\\\z\\\\ (z)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2ec9a0a-b12d-4493-b602-bb43ab68f74e",
                                "sense_id": "82b746a8-10d4-3d93-8fdd-3bfaf5981d0c",
                                "text": "Le désespoir de sa vie était qu’affligé d’un zézaiement un peu enfantin, il n’avait pu, dans la magistrature debout, remplir son mérite, car il se piquait d’être un grand orateur."
                            },
                            {
                                "example_id": "9a64c5a3-12a6-4a6b-9718-e02539d5cc7d",
                                "sense_id": "82b746a8-10d4-3d93-8fdd-3bfaf5981d0c",
                                "text": "Elle avait deux ans de moins que moi et parlait encore avec un zézaiement qui me faisait sentir toute la supériorité que j’avais sur elle."
                            },
                            {
                                "example_id": "5073b7d2-1280-4926-850b-ac51e2baee17",
                                "sense_id": "82b746a8-10d4-3d93-8fdd-3bfaf5981d0c",
                                "text": "N'ayez crainte ! répliqua Pepette qui, malgré ses airs de colosse, avait une petite voix et un très léger zézaiement."
                            },
                            {
                                "example_id": "ef8c2aa0-aa2b-4c92-b57e-ccdceb133f9f",
                                "sense_id": "82b746a8-10d4-3d93-8fdd-3bfaf5981d0c",
                                "text": "Ça fait que les Ritals qui mettent un peu le nez hors de leurs ghettos de Ritals se débrouillent vite fait avec le français. Mais, aussi longtemps puissent-ils vivre, ils seront quand même toujours trahis par le zézaiement. Rien à faire, ils zozotent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec09205f-81b1-49ab-9d9b-838e976bc447",
                        "source_entry_id": "f615b343-a7b4-3a8b-b16c-6cb932d8ed79",
                        "source_sense_id": "82b746a8-10d4-3d93-8fdd-3bfaf5981d0c",
                        "target_lang_word": "Lispeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lispeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee63c8cf-7df7-3132-ad63-c1fba27be2e7",
                                        "entry_id": "2440a21d-001a-3d9a-874d-02ea86299cfd",
                                        "glosses": [
                                            "fehlerhaftes Sprechen durch Platzierung der Zunge an den Schneidezähnen"
                                        ],
                                        "tags": [
                                            "Sprechen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcdbe263-5e8a-4e2b-819b-db4e8446a79a",
                                                "sense_id": "ee63c8cf-7df7-3132-ad63-c1fba27be2e7",
                                                "text": "„Lispeln und Stottern sind wohl die häufigsten Sprachfehler.“"
                                            },
                                            {
                                                "example_id": "b95f9199-5814-48f2-9b22-dbe1bf66d105",
                                                "sense_id": "ee63c8cf-7df7-3132-ad63-c1fba27be2e7",
                                                "text": "„Seit frühester Jugend quälte ihn das Lispeln, er hatte eine überlange Zunge, die im Mund unruhig umherfuhr und neugierig auch an ungeeigneten Buchstabenfolgen wie die Zunge einer giftigen Schlange den Weg nach draußen suchte, dann aber jedesmal erschrocken in die Höhle zurückfloh.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c094718d-8033-48bd-9cb5-fda52c387e05",
                        "source_entry_id": "f615b343-a7b4-3a8b-b16c-6cb932d8ed79",
                        "source_sense_id": "82b746a8-10d4-3d93-8fdd-3bfaf5981d0c",
                        "target_lang_word": "lisp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lisp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "590d569b-13bf-3bfa-9c66-7a0e48452780",
                                        "entry_id": "e427dac2-9d26-3b73-97b4-c3d89fb62cb6",
                                        "glosses": [
                                            "The act or a habit of lisping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "294f5b33-79a9-4333-8c8c-0063662e5843",
                                                "sense_id": "590d569b-13bf-3bfa-9c66-7a0e48452780",
                                                "text": "He used to have a terrible lisp before going to a speech therapist."
                                            },
                                            {
                                                "example_id": "22c613d8-89bc-413b-9a80-488de248308b",
                                                "sense_id": "590d569b-13bf-3bfa-9c66-7a0e48452780",
                                                "text": "It's common for children to speak with a lisp."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lisp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e68d6f64-8d9b-3c8d-8bb1-697a5c465146",
                                        "entry_id": "28918997-65d3-3876-9425-c0701ed8e66f",
                                        "glosses": [
                                            "To pronounce the consonant ‘s’ imperfectly; to give ‘s’ and ‘z’ the sounds of ‘th’ (/θ/, /ð/). This is a speech impediment common among children."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43a3a9ac-f6c7-4a70-b22a-8b7b1464a614",
                                                "sense_id": "e68d6f64-8d9b-3c8d-8bb1-697a5c465146",
                                                "text": "Until the age of 10, Dominic would lisp, but this was fixed by a speech therapist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77c1e787-979b-36bf-9b7c-89ee2bb9fedc",
                                        "entry_id": "28918997-65d3-3876-9425-c0701ed8e66f",
                                        "glosses": [
                                            "To speak with imperfect articulation; to mispronounce, such as a child learning to talk."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "387a57eb-77d3-4060-82ed-5e4fbe368628",
                                                "sense_id": "77c1e787-979b-36bf-9b7c-89ee2bb9fedc",
                                                "text": "As yet a Child, nor yet a Fool to Fame, / I liſp'd in Numbers, for the Numbers came."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e5d2523-07ff-3a18-8b82-cad1dbfe92c8",
                                        "entry_id": "28918997-65d3-3876-9425-c0701ed8e66f",
                                        "glosses": [
                                            "To speak hesitatingly and with a low voice, as if afraid."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a47edd0e-fc42-4fa8-9c37-46f9efebf891",
                                                "sense_id": "3e5d2523-07ff-3a18-8b82-cad1dbfe92c8",
                                                "text": "Lest when my lisping, guilty tongue should halt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02eb60f4-d755-38be-a3bd-347efbf9a726",
                                        "entry_id": "28918997-65d3-3876-9425-c0701ed8e66f",
                                        "glosses": [
                                            "to express by the use of simple, childlike language."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84fd658f-af04-4ea9-b814-f385fb6ae927",
                                                "sense_id": "02eb60f4-d755-38be-a3bd-347efbf9a726",
                                                "text": "But the fashion spreads deeper and wider; the village is infected and the village green; Amelias and Claras sweep your rooms and cook your dinners, gentle Sophias milk your cows, and if you ask a pretty smiling girl at a cottage door to tell you her name, the rosy lips lisp out Caroline."
                                            },
                                            {
                                                "example_id": "701cd4c9-0b8e-4439-9e7f-6cc50a9fe1ed",
                                                "sense_id": "02eb60f4-d755-38be-a3bd-347efbf9a726",
                                                "text": "to speak unto them after their own capacity, and to lisp the words unto them , according as the babes and children of that age might sound them againagain"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "320f58dd-69a0-3c3d-8574-6344dc66b82f",
                                        "entry_id": "28918997-65d3-3876-9425-c0701ed8e66f",
                                        "glosses": [
                                            "To speak with reserve or concealment; to utter timidly or confidentially."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd0c8884-396f-4c75-a1a6-e9c1ff3d9d0a",
                                                "sense_id": "320f58dd-69a0-3c3d-8574-6344dc66b82f",
                                                "text": "to lisp treason"
                                            },
                                            {
                                                "example_id": "47226b30-8aa4-4a4b-a919-fcbd2436cde8",
                                                "sense_id": "320f58dd-69a0-3c3d-8574-6344dc66b82f",
                                                "text": "\"You have done well, sir,\" said Delwood, calmly, as he placed double the amount of Mrs. Santon's bribe in the Signor's hand; \"you have done well, sir; and mark my words,—gold can never relieve a guilty conscience! Go, sir, and see that you lisp not a syllable of this to any one.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
