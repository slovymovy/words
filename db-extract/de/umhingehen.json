                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d65c933-d47c-34ef-b379-931cc501ea10",
                        "entry_id": "88a9dce1-67d2-3a14-9587-0ac4e090acf4",
                        "glosses": [
                            "hinübergehen"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "acfc7fea-0d18-4de5-b173-18f01f817f4d",
                                "sense_id": "3d65c933-d47c-34ef-b379-931cc501ea10",
                                "text": "„Soll i ummigeh’n und ’n frag’n, ob er an Führer braucht?“"
                            },
                            {
                                "example_id": "b38606fa-5e43-4b3a-91b9-594d693c6215",
                                "sense_id": "3d65c933-d47c-34ef-b379-931cc501ea10",
                                "text": "„In währenddem so kimmt da Hies und a de oann Gon Kreuzweg, wo’s auf Anzing ummegeht.“"
                            },
                            {
                                "example_id": "5b57feda-ca5d-42ac-9fc9-985a2b6f7341",
                                "sense_id": "3d65c933-d47c-34ef-b379-931cc501ea10",
                                "text": "„Enter der Doana stengan schen Bloama, Dirndl, wannsd ummigehst, bringst man oa hoama!“"
                            },
                            {
                                "example_id": "e8c3db67-9085-418c-826b-5cb810508fbb",
                                "sense_id": "3d65c933-d47c-34ef-b379-931cc501ea10",
                                "text": "„Weil wenn’s recht hoaß is und er is ned dahoam, dann geh i mit da Giaßkanna in sein Gartn ume, do hod er nämlich a Wasserleitung, und dann hol i mein Schnee als Wasser wieder uma.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2c704456-9c6c-33e3-81ad-2f1349c613d1",
                        "entry_id": "88a9dce1-67d2-3a14-9587-0ac4e090acf4",
                        "glosses": [
                            "vorübergehen (Not, Schmerz, Krankheit)"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d7c8a1e-06ca-4ed7-b1c9-6812e874bd03",
                        "source_entry_id": "88a9dce1-67d2-3a14-9587-0ac4e090acf4",
                        "source_sense_id": "3d65c933-d47c-34ef-b379-931cc501ea10",
                        "source_sense_description": "bairisch: hinübergehen",
                        "target_lang_word": "hinübergehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hinübergehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10a6cec9-565f-3b03-99b6-20147c54c4e6",
                                        "entry_id": "78f3fef9-c1d6-3111-a9eb-a8ac2c5f61ec",
                                        "glosses": [
                                            "sich nach dort drüben, auf die gegenüberliegende Seite begeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df8905d1-7096-409b-84b1-e6554887548e",
                                                "sense_id": "10a6cec9-565f-3b03-99b6-20147c54c4e6",
                                                "text": "„Er ist hinübergegangen, um Scheschoka beim Packen zu helfen.“"
                                            },
                                            {
                                                "example_id": "9567a12f-dfe6-41fc-9512-15f9313311a9",
                                                "sense_id": "10a6cec9-565f-3b03-99b6-20147c54c4e6",
                                                "text": "„Vielleicht sollte sie einfach hinübergehen und ihn fragen, anstatt sich verrückt zu machen und in die absurdesten Vermutungen zu verfallen.“"
                                            },
                                            {
                                                "example_id": "85af3729-fed3-44d2-9a7f-99664be347b4",
                                                "sense_id": "10a6cec9-565f-3b03-99b6-20147c54c4e6",
                                                "text": "„Missmutig ging ich hinüber zu den Kisten, holte mir eine und begann, die Birnen an den unteren Ästen zu pflücken.“"
                                            },
                                            {
                                                "example_id": "822cc410-ebdc-4b04-a400-c846a91dfcab",
                                                "sense_id": "10a6cec9-565f-3b03-99b6-20147c54c4e6",
                                                "text": "„In den Externsteinen bei Paderborn finden wir noch Reste einer Mysterienstätte, wo damalige Menschen zur Einweihung unter anderem über eine 40 Meter hohe Steigleiterbrücke ohne Furcht hinübergehen mussten.“"
                                            },
                                            {
                                                "example_id": "c372ac3c-ba63-4766-a8ac-7293ebede22a",
                                                "sense_id": "10a6cec9-565f-3b03-99b6-20147c54c4e6",
                                                "text": "„Adenauer und de Gaulle gelang es, die abgrundtiefen Gräben der frühen Nachkriegszeit zwischen beiden Ländern so weit zuzuschütten, dass man vorsichtig wieder hinübergehen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb24f77c-d384-3882-b4b0-459e27da18fe",
                                        "entry_id": "78f3fef9-c1d6-3111-a9eb-a8ac2c5f61ec",
                                        "glosses": [
                                            "aufhören zu leben"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71b7828d-243b-45db-8eff-8c71b0214b19",
                                                "sense_id": "bb24f77c-d384-3882-b4b0-459e27da18fe",
                                                "text": "Wäre das passiert, wäre er wohl hinübergegangen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc01f002-061f-4049-a18c-97dc38a308fd",
                        "source_entry_id": "88a9dce1-67d2-3a14-9587-0ac4e090acf4",
                        "source_sense_id": "2c704456-9c6c-33e3-81ad-2f1349c613d1",
                        "source_sense_description": "bairisch: vorübergehen (Not, Schmerz, Krankheit)",
                        "target_lang_word": "vorübergehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorübergehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cf51f15-fad7-30be-afe7-011c8045d496",
                                        "entry_id": "a70c3d55-895c-33d4-a52e-60ab6a67fdc0",
                                        "glosses": [
                                            "sich auf etwas/jemanden zubewegen und gleich wieder entfernen; an/vor etwas oder jemandem vorbeigehen"
                                        ],
                                        "tags": [
                                            "konkret",
                                            "Grundbedeutung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cd5f781-8757-4171-8293-1c7d4bccd2a9",
                                                "sense_id": "6cf51f15-fad7-30be-afe7-011c8045d496",
                                                "text": "Das ganze Dorf ging an dem Sarg vorüber."
                                            },
                                            {
                                                "example_id": "638fcf7d-e1a7-4e25-8573-a32b0ade3e04",
                                                "sense_id": "6cf51f15-fad7-30be-afe7-011c8045d496",
                                                "text": "Sie war über Jahre täglich an dem alten Haus vorübergegangen und nie hatte sie etwas Auffälliges bemerkt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6935a0ff-d1ae-3e53-a446-a5d7519199e1",
                                        "entry_id": "a70c3d55-895c-33d4-a52e-60ab6a67fdc0",
                                        "glosses": [
                                            "(ein Ereignis oder relevanten Umstand absichtlich oder unabsichtlich) nicht beachten, ignorieren, nicht zur Kenntnis nehmen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10dd8cb9-c7b0-4b84-a039-ab57aa9ca463",
                                                "sense_id": "6935a0ff-d1ae-3e53-a446-a5d7519199e1",
                                                "text": "An diesen Fakten / an den Ergebnissen dieser Forschungen kann man nicht einfach vorübergehen."
                                            },
                                            {
                                                "example_id": "7185483e-8bcb-42e6-8960-88a1a64597a1",
                                                "sense_id": "6935a0ff-d1ae-3e53-a446-a5d7519199e1",
                                                "text": "An diesen Fakten ist man einfach vorübergegangen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d5238514-17aa-38ff-9841-e44656858782",
                                        "entry_id": "a70c3d55-895c-33d4-a52e-60ab6a67fdc0",
                                        "glosses": [
                                            "sich ereignen mit Betonung auf die Endlichkeit des Ereignisses und das Einwirken auf die Lebensumstände; vergehen, zu Ende kommen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6740a40-0772-4964-85c0-431ecde6ee50",
                                                "sense_id": "d5238514-17aa-38ff-9841-e44656858782",
                                                "text": "Die Schmerzen werden bald vorübergehen."
                                            },
                                            {
                                                "example_id": "869dc9da-81e2-423d-872b-2799b1d19f00",
                                                "sense_id": "d5238514-17aa-38ff-9841-e44656858782",
                                                "text": "Die Jahre gingen vorüber."
                                            },
                                            {
                                                "example_id": "b766c3ba-1cad-40af-85c8-971300d35a51",
                                                "sense_id": "d5238514-17aa-38ff-9841-e44656858782",
                                                "text": "So ein Regenschauer geht schnell vorüber."
                                            },
                                            {
                                                "example_id": "6edec844-4861-4182-bb0b-ff5d1b1b0880",
                                                "sense_id": "d5238514-17aa-38ff-9841-e44656858782",
                                                "text": "Ich will diese Gelegenheit nicht ungenutzt vorübergehen lassen."
                                            },
                                            {
                                                "example_id": "85bf9825-0b0c-42c0-967c-29697258129e",
                                                "sense_id": "d5238514-17aa-38ff-9841-e44656858782",
                                                "text": "Der Stress der monatelangen Erbschaftszwistigkeiten ging an niemandem spurlos vorüber."
                                            },
                                            {
                                                "example_id": "10be98e7-42f6-402b-bfa1-02595a59b9f4",
                                                "sense_id": "d5238514-17aa-38ff-9841-e44656858782",
                                                "text": "Die Jahre waren nicht ohne Spuren (zu hinterlassen) an ihm vorübergegangen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
