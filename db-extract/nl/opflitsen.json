                        "examples": [
                            {
                                "example_id": "22e88e85-1cb9-4ce6-912b-67a8084311e4",
                                "sense_id": "4c6493fc-098d-3018-a5bd-0db6db5180b4",
                                "text": "Sinds 1 januari staan er langs de invalswegen naar het centrum camera's. Die fotograferen elk nummerbord. Wie een te oude auto heeft, ziet een paar honderd meter verder een rode 'nee' opflitsen: de milieuzone is verboden gebied."
                            },
                            {
                                "example_id": "43bc8775-b7ca-4795-b913-b2b114666aaa",
                                "sense_id": "4c6493fc-098d-3018-a5bd-0db6db5180b4",
                                "text": "Een nieuwe file, een korte. Net als ik weer op wil trekken, zie ik verderop het bord boven de snelweg opflitsen: 70. Nou dan weet je het wel. 70 wordt 50 en eenmaal in dat stadium sukkel je met nog hooguit 15 km op de teller onder het bord door. De ballonvaart glipt langzaam door mijn vingers heen. Ik voel het. Zweethanden."
                            },
                            {
                                "example_id": "7eb91a66-7fce-4f9a-ad9e-e7ad74d5ad3f",
                                "sense_id": "4c6493fc-098d-3018-a5bd-0db6db5180b4",
                                "text": "Met de ‘Guardian Angel app’, te downloaden op de site van www.dus.be kunnen jongeren hun smartphone in allerlei fluokleuren en patronen laten opflitsen. De smartphone moeten ze dan wel op een veilige en zichtbare manier aan het lichaam bevestigen."
                            }
                        ]
                    }
