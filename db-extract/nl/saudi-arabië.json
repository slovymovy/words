                "senses": [
                    {
                        "sense_id": "0222b549-b7bd-3cdd-bf25-b673b911dff0",
                        "entry_id": "c8327fc2-887a-3e8e-89fe-5e529d2df2b9",
                        "glosses": [
                            "land in het zuidwesten van Azië"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "834ff2a3-97f0-41d3-bbad-7f322b31dc00",
                                "sense_id": "0222b549-b7bd-3cdd-bf25-b673b911dff0",
                                "text": "In Saudi-Arabië groeien planten die bij het klimaat passen."
                            },
                            {
                                "example_id": "3ef409ff-82f9-4a43-bb29-1a71252bc1e6",
                                "sense_id": "0222b549-b7bd-3cdd-bf25-b673b911dff0",
                                "text": "Het land is in werkelijkheid boeiender dan het Saudi-Arabië uit de reisgids."
                            }
                        ]
                    },
                    {
                        "sense_id": "64e5fdb1-056e-35a2-87a9-2b359ea87c78",
                        "entry_id": "c8327fc2-887a-3e8e-89fe-5e529d2df2b9",
                        "glosses": [
                            "het soevereine 'Koninkrijk Saudi-Arabië' (Arabisch: المملكة العربية السعودية al-Mamlakah al-`Arabīyah as-Su`ūdiyah) die het onder 1. genoemde gebied omvat; in figuurlijke betekenis ook: zij die als vertegenwoordigers van dit land optreden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68edf325-4919-473e-b690-b7bcd872fffd",
                                "sense_id": "64e5fdb1-056e-35a2-87a9-2b359ea87c78",
                                "text": "Saudi-Arabië is lid van de Verenigde Naties."
                            },
                            {
                                "example_id": "533de961-4176-46ed-9e60-71e07b1f912f",
                                "sense_id": "64e5fdb1-056e-35a2-87a9-2b359ea87c78",
                                "text": "Het Saudi-Arabië van twee jaar geleden was een zeer sterk elftal."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "307d9505-4282-4a46-b7f2-59b4d16856e4",
                        "source_entry_id": "c8327fc2-887a-3e8e-89fe-5e529d2df2b9",
                        "source_sense_id": "0222b549-b7bd-3cdd-bf25-b673b911dff0",
                        "source_sense_description": "en 2., land en staat in Azië",
                        "target_lang_word": "Saudi-Arabien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saudi-Arabien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43fb4539-3627-3bb0-9fc0-55cbe84596c0",
                                        "entry_id": "5e2dd629-ba46-364b-b963-e48798e3480e",
                                        "glosses": [
                                            "Staat auf der Arabischen Halbinsel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0e56bf5-0214-4f33-8b2e-847c545e40db",
                                                "sense_id": "43fb4539-3627-3bb0-9fc0-55cbe84596c0",
                                                "text": "In Saudi-Arabien herrscht vorwiegend heißes und trockenes Klima."
                                            },
                                            {
                                                "example_id": "5dbdc4d8-3a91-4f20-9742-e82babf8607b",
                                                "sense_id": "43fb4539-3627-3bb0-9fc0-55cbe84596c0",
                                                "text": "Riad ist die Hauptstadt von Saudi-Arabien."
                                            },
                                            {
                                                "example_id": "af5f2ef2-465f-40a8-b697-63c00e24dad2",
                                                "sense_id": "43fb4539-3627-3bb0-9fc0-55cbe84596c0",
                                                "text": "Das heutige Saudi-Arabien könnte einem Mitteleuropäer unfrei erscheinen."
                                            },
                                            {
                                                "example_id": "af9b0833-0e76-4c71-a9bd-3c8e196e2262",
                                                "sense_id": "43fb4539-3627-3bb0-9fc0-55cbe84596c0",
                                                "text": "„Saudi-Arabien muss seine Strategie in der Region sowie seine Bündnispolitik überdenken und an die neuen komplexeren und wechselhaften Strukturen anpassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a104d18b-3745-45d0-94b6-a1215cb03c1c",
