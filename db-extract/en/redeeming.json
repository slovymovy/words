                "senses": [
                    {
                        "sense_id": "b42ed35d-4352-3a7b-8500-7c89c59df397",
                        "entry_id": "c7d4e7cc-c149-35db-b1cd-f79b17054e22",
                        "glosses": [
                            "zum Ausgleich eines Fehlers oder Mangels: wettmachend, verbessernd, positiv, ausgleichend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5188c91a-1aaa-4f84-a965-293b3a52f0cd",
                                "sense_id": "b42ed35d-4352-3a7b-8500-7c89c59df397",
                                "text": "[…] Langella's role in The Box could easily win an Oscar for best 10-minute performance in a film with no other redeeming feature.",
                                "translation": "Langellas Rolle in The Box könnte einen Oscar für die beste 10-minütige Leistung in einem Film gewinnen, der keinen einzigen weiteren Lichtblick hat."
                            },
                            {
                                "example_id": "3feb37b6-ca4c-4cd8-adf7-a32a2b6ae666",
                                "sense_id": "b42ed35d-4352-3a7b-8500-7c89c59df397",
                                "text": "The redeeming moment is an exchange at a dragon hunter's tavern. Old timer: „Ishmael, isn't it?“ Ishmael: „You can call me that.“",
                                "translation": "Der [für alles Schlechte] \"ausgleichende\" Moment ist ein Gespräch in der Taverne eines Drachenjägers. Veteran: „Ismael, oder?“ Ismael: „Du kannst mich so nennen.“"
                            },
                            {
                                "example_id": "05e8d16a-5088-48d6-931f-69aac9b19951",
                                "sense_id": "b42ed35d-4352-3a7b-8500-7c89c59df397",
                                "text": "I think she [Sarah Churchill] was madly in love with John Churchill – it was a real love affair between them. Perhaps that’s her only redeeming quality.",
                                "translation": "Ich glaube, sie [Sarah Churchill] war unsterblich in John Churchill verliebt - es war eine echte Liebesbeziehung zwischen ihnen. Vielleicht ist das ihre [charakterlich] einzige positive Eigenschaft."
                            },
                            {
                                "example_id": "9bc9ed60-ac9c-4fff-ad18-b3f4e62deeda",
                                "sense_id": "b42ed35d-4352-3a7b-8500-7c89c59df397",
                                "text": "Having lived in a smoker-friendly country for awhile, I have to agree with the restrictions, as it has no redeeming qualities and is an irritant and health hazard.",
                                "translation": "Nachdem ich eine Zeitlang in einem raucherfreundlichen Land gelebt habe, muss ich den Einschränkungen zustimmen, da es nichts Gutes daran gibt und ein Reiz- und Gesundheitsrisiko darstellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "37a70477-be9b-3bf7-968e-43e9548f1dbb",
                        "entry_id": "c7d4e7cc-c149-35db-b1cd-f79b17054e22",
                        "glosses": [
                            "Menschen errettend vor der Sünde, dem Teufel, dem Bösen, ...: erlösend, heilbringend, rettend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a9f4bdb-5718-4cf8-88df-b5e78b4bff16",
                                "sense_id": "37a70477-be9b-3bf7-968e-43e9548f1dbb",
                                "text": "But above all, as in the Potters, there is the final redeeming grace of love.",
                                "translation": "Aber vor allem, wie bei den Potters, gibt es die letzte erlösende Gnade der Liebe."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
