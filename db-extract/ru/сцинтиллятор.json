                    {
                        "translation_id": "9e1c34ae-39ca-47d6-af35-a5ed3ea5cf40",
                        "source_entry_id": "cd8a01be-2920-31bf-b0f9-f1615355d277",
                        "source_sense_id": "0777dee9-cf81-3c90-b5f1-87c07652ad71",
                        "target_lang_word": "Szintillator",
