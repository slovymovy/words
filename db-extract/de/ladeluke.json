                    {
                        "sense_id": "75d26c91-0fbe-3d06-bfb0-890415e6ebfc",
                        "entry_id": "e638e83d-34f5-3853-8c91-7766e40fbe28",
                        "glosses": [
                            "Luke, durch die Fracht ein- oder ausgeladen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b5566cf-87fc-480c-b0ef-63557eca4301",
                                "sense_id": "75d26c91-0fbe-3d06-bfb0-890415e6ebfc",
                                "text": "„Wir beide standen bei den Ladeluken und wippten ein Fass Teer, das auf Deck stand, und übergaben es den Männern auf dem Floß, wobei wir ihnen herzlich Erfolg für ihr Unternehmen wünschten.“"
                            },
                            {
                                "example_id": "d4c5dd68-2aa2-4dff-ad3a-bc51cd555385",
                                "sense_id": "75d26c91-0fbe-3d06-bfb0-890415e6ebfc",
                                "text": "„Nach weiterem Nachfragen gab der [Beschwerdeführer] an, sie wären einmal angehalten worden, worauf der Schlepper und die Polizei die Ladeluke des Lkws geöffnet hätten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
