                                "target_senses": [
                                    {
                                        "sense_id": "a575ce13-488b-3b6b-8ef5-8df2cd67913e",
                                        "entry_id": "5cc0ece5-b0dc-39be-bf4a-439845d8bc7b",
                                        "glosses": [
                                            "een aanspreektitel voor een man"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "664b70a2-6f3b-4851-8166-11d6440114a0",
                                                "sense_id": "a575ce13-488b-3b6b-8ef5-8df2cd67913e",
                                                "text": "Mijnheer, wilt u dit nog even ondertekenen?"
                                            },
                                            {
                                                "example_id": "835fa3de-7d3e-4e2d-bbf2-88c64a034c1b",
                                                "sense_id": "a575ce13-488b-3b6b-8ef5-8df2cd67913e",
                                                "text": "Toen mijnheer Oortman twee jaar geleden stierf, zeiden de mensen in Assendelft dat hij brouwerijen had voortgebracht."
                                            },
                                            {
                                                "example_id": "5d161c1d-ed4f-46c3-8321-d72d4c41dbed",
                                                "sense_id": "a575ce13-488b-3b6b-8ef5-8df2cd67913e",
                                                "text": "'Deze heeft mijnheer betaald,' zegt ze met bewondering in haar stem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4834e7e-59b4-33d4-8a5f-9adc535c878b",
                                        "entry_id": "5cc0ece5-b0dc-39be-bf4a-439845d8bc7b",
                                        "glosses": [
                                            "de heer des huizes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26ec6e35-8076-496f-8e39-f3be1a9fe1ca",
                                                "sense_id": "e4834e7e-59b4-33d4-8a5f-9adc535c878b",
                                                "text": "'Omdat mijnheer Brandt een herder uit de stad is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff4986b0-3576-3744-aae2-9e16d4d59e4d",
                                        "entry_id": "5cc0ece5-b0dc-39be-bf4a-439845d8bc7b",
                                        "glosses": [
                                            "een titel voor marineofficieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d48017-d5e0-4049-a378-3be5c1123292",
                                                "sense_id": "ff4986b0-3576-3744-aae2-9e16d4d59e4d",
                                                "text": "Ik ben aanwezig, mijnheer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
