                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b778616-729c-3615-883c-a64e7c59528b",
                        "entry_id": "0824eb7d-5dd6-38fa-9994-00b640653c58",
                        "glosses": [
                            "Petite ride."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97f640e4-6bd2-4937-aace-d1b9b8bffc50",
                                "sense_id": "6b778616-729c-3615-883c-a64e7c59528b",
                                "text": "Il était fatigué et cela expliquait peut-être la réapparition d’une ridule auprès de son sourcil gauche."
                            },
                            {
                                "example_id": "0d75425f-d7a2-4983-b5fd-c4f469cbba73",
                                "sense_id": "6b778616-729c-3615-883c-a64e7c59528b",
                                "text": "Alors, un sourire, franchement insoutenable, pointa sur le visage jaune, fendillé de ridules et dont les lèvres, malgré le proche albuplast, réussirent à articuler, par bribes."
                            },
                            {
                                "example_id": "910e030e-e977-481e-ae33-23b658db183a",
                                "sense_id": "6b778616-729c-3615-883c-a64e7c59528b",
                                "text": "Il ne fit pas de bruit, se contentant d’observer son frère. Il avait vieilli. Quelques ridules flétrissaient sa peau à l’angle de ses paupières ainsi qu’au coin des lèvres. Le haut de son crâne commençait même à se déplumer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbd1df4f-8e5f-4aab-a30a-7cc51f53f79d",
                        "source_entry_id": "0824eb7d-5dd6-38fa-9994-00b640653c58",
                        "source_sense_id": "6b778616-729c-3615-883c-a64e7c59528b",
                        "target_lang_word": "Fältchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fältchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd8f4d7-baed-3403-a708-34c790532924",
                                        "entry_id": "9a1fe8d5-90b3-3216-8489-d6bcde84ea07",
                                        "glosses": [
                                            "eine leichte, kleine Falte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41d0b66b-8ce6-4716-9ca7-831cea8f2f4c",
                                                "sense_id": "4dd8f4d7-baed-3403-a708-34c790532924",
                                                "text": "„Sie senkte das Glas; ein Wölkchen von getäuschter Erwartung und Trauer lagerte sich unter den blonden Locken, die schönen Bogen der Brau’n zogen sich zusammen und ließen ein kaum merkliches Fältchen des Unmuts sehen.“"
                                            },
                                            {
                                                "example_id": "8351a052-cf8d-48d7-8015-65e6996a9687",
                                                "sense_id": "4dd8f4d7-baed-3403-a708-34c790532924",
                                                "text": "„Feine Fältchen spannten sich über ihren Nasenrücken.“"
                                            },
                                            {
                                                "example_id": "a10a5b8d-79fd-4ef3-b02c-0fa3b2a6a194",
                                                "sense_id": "4dd8f4d7-baed-3403-a708-34c790532924",
                                                "text": "„Durch die Arbeit im Garten hat sie einen frischen Teint, aber an den Augen zeigen sich immer mehr kleine Fältchen.“"
                                            },
                                            {
                                                "example_id": "b67720d3-a4f2-4e42-8e6a-de8ecdbadb7b",
                                                "sense_id": "4dd8f4d7-baed-3403-a708-34c790532924",
                                                "text": "„Als sie an der Zigarette zog, sah ich ein paar Fältchen um ihren Mund, die ich noch nie gesehen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
