                                "target_senses": [
                                    {
                                        "sense_id": "c87ab08f-1e88-306d-9277-9e1c128e13ae",
                                        "entry_id": "2f682eb1-3de9-3cd8-885b-726fc8709213",
                                        "glosses": [
                                            "A collection of (usually) organized information in a regular structure, usually but not necessarily in a machine-readable format accessible by a computer."
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc0f0624-7434-4d48-b589-338d69457d26",
                                                "sense_id": "c87ab08f-1e88-306d-9277-9e1c128e13ae",
                                                "text": "I have a database of all my contacts in my personal organizer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0228b038-ae02-38f6-a623-72af11ae77b2",
                                        "entry_id": "2f682eb1-3de9-3cd8-885b-726fc8709213",
                                        "glosses": [
                                            "A set of tables and other objects (queries, reports, forms) in the form of a structured data set."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "728cddf6-739f-4b49-9667-0f7b0ff80b9d",
                                                "sense_id": "0228b038-ae02-38f6-a623-72af11ae77b2",
                                                "text": "The \"books\" database will have three tables, and the \"customers\" database will have two tables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02a3ef72-3375-3916-8b7b-7bc0694cafd7",
                                        "entry_id": "2f682eb1-3de9-3cd8-885b-726fc8709213",
                                        "glosses": [
                                            "A software program (application) for storing, retrieving and manipulating such a structured data set."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29f43af8-706c-44f5-bf77-cf8ba96611fb",
                                                "sense_id": "02a3ef72-3375-3916-8b7b-7bc0694cafd7",
                                                "text": "Which database do you use: MySQL or Oracle?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "765a155d-caa8-382b-9e11-233e91d42487",
                                        "entry_id": "2f682eb1-3de9-3cd8-885b-726fc8709213",
                                        "glosses": [
                                            "A combination of such data sets and the programs for using them."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "metonymically"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "database",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27ff7300-f982-3697-b19e-a942b0d5f78b",
                                        "entry_id": "848309d6-aea2-34d0-9a30-657b9ec751e6",
                                        "glosses": [
                                            "To enter (data) into a database."
                                        ],
