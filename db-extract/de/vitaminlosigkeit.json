                ],
                "senses": [
                    {
                        "sense_id": "66ad2548-b892-327c-9274-337f00b112d7",
                        "entry_id": "f709131f-ec72-38d2-ad38-9cf214867f7f",
                        "glosses": [
                            "Eigenschaft, sehr wenig bis gar keine Vitamine zu enthalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab71194c-fab1-4765-9cb3-96d44979e574",
                                "sense_id": "66ad2548-b892-327c-9274-337f00b112d7",
                                "text": "„Es wird sich also bei Erkrankungen in der Praxis eher um Vitaminarmut als um Vitaminlosigkeit handeln.“"
                            },
                            {
                                "example_id": "de7e859e-a137-429e-bfb2-edea808e4188",
                                "sense_id": "66ad2548-b892-327c-9274-337f00b112d7",
                                "text": "„So kann je nach Ausgangsprodukt und Erhitzungsgrad sich ein Endprodukt ergeben, das von noch gut nachweisbarem Vitamingehalt zu Vitaminlosigkeit schwankt.“"
                            },
                            {
                                "example_id": "b04dec54-ded0-4eda-bd95-f530eff0058e",
                                "sense_id": "66ad2548-b892-327c-9274-337f00b112d7",
                                "text": "„Nach der Vitaminlosigkeit der letzten Monate schien es uns wie ein Märchen. Wir aßen lange und viel, ich viel zu viel!“"
                            },
                            {
                                "example_id": "c7f85f2b-3eef-4127-be3f-e71ddcfed5ed",
                                "sense_id": "66ad2548-b892-327c-9274-337f00b112d7",
                                "text": "„Es handelt sich darum, ob eine Vitaminlosigkeit der Margarine für die Ernährung nachteilige Folgen nach sich zieht.“"
                            },
                            {
                                "example_id": "5790b64f-9ba0-4ea9-80e3-1f9f7796fc45",
                                "sense_id": "66ad2548-b892-327c-9274-337f00b112d7",
                                "text": "„Will man das zweifache Problem der Unterwertigkeit der Mehleiweißsubstanz und der Vitaminlosigkeit des Mehles lösen, dann erscheint es vorteilhafter und einfacher, dem Mehl biologisch hochwertige Eiweißstoffe und stark vitaminhaltige Substanzen künstlich zuzusetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
