                ],
                "senses": [
                    {
                        "sense_id": "7f824972-7de7-3d44-b20f-a99d1934ad98",
                        "entry_id": "875d336d-01ae-3f17-9510-4ebe0d266b85",
                        "glosses": [
                            "The act of mystifying or the condition of being mystified."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fafe9527-bcd3-40be-9f97-937cf62595f8",
                                "sense_id": "7f824972-7de7-3d44-b20f-a99d1934ad98",
                                "text": "But soon one notices, first in ones and twos, and then in larger groups, men who are very much alive at this hour in the morning, the sorters for the Caledonian, and Edinburgh sections of the \"Down Special\"; mail is piled high on the platforms, and the postal men glance occasionally towards the platform intermediate signals. By this time the calling-on arm is pulled off, and a few minutes later in comes the train, unannounced by the loud-speakers, to the mystification of many travellers."
                            },
                            {
                                "example_id": "6d9a2e0c-0223-4eb9-990b-e844b6a6830d",
                                "sense_id": "7f824972-7de7-3d44-b20f-a99d1934ad98",
                                "text": "For a structuralist like Edmund Leach, the structure is the meaning. Genesis, for example, is about incest taboos; all the rest is noise and mystification."
                            }
                        ]
                    },
                    {
                        "sense_id": "93cfc641-bd9b-3979-989d-99380caa01f6",
                        "entry_id": "875d336d-01ae-3f17-9510-4ebe0d266b85",
                        "glosses": [
                            "A mystifying thing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44bced15-ffa0-49b3-a374-74da4cf62c69",
                        "source_entry_id": "875d336d-01ae-3f17-9510-4ebe0d266b85",
                        "source_sense_description": "act of being mystified",
                        "target_lang_word": "Verblüffung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verblüffung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                        "entry_id": "fe4f308a-6251-3978-8e8d-63c77bdfbda2",
                                        "glosses": [
                                            "das Verblüfftsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0403c31-c752-48a0-b339-3d001ad4f91f",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Die Verblüffung stand ihm ins Gesicht geschrieben."
                                            },
                                            {
                                                "example_id": "6562d9b7-2fd2-477b-873e-984916cc22cd",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Sie schien die Verblüffung ihres Angestellten nicht zu verstehen."
                                            },
                                            {
                                                "example_id": "b973adfb-e8b1-40b6-b0c3-60953aa0a2e2",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Weil er von der Feier bereits wusste, musste er seine Verblüffung vorheucheln."
                                            },
                                            {
                                                "example_id": "158271fb-c364-4b4f-8d91-98b0a9a320f9",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Zu ihrer großen Verblüffung stellte sie fest, dass zu diesem Begriff kein Eintrag im Wörterbuch existierte."
                                            },
                                            {
                                                "example_id": "d71fdd03-8cda-4ea1-86d4-0d6479d9eff9",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "„Es fiel mir nicht schwer, ihr Freude zu machen durch eine große Verblüffung über die völlige Auffrischung ihres Haushalts.“"
                                            },
                                            {
                                                "example_id": "ef427031-dff6-46b9-b440-55449c833fd7",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "„Milde Verblüffung steht in Lampes Gesicht, als er den Digestor gründlich mustert.“"
                                            },
                                            {
                                                "example_id": "41160c7a-85d5-4001-b3d8-11653d15bed2",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "„Eine Minute verging in allgemeiner Verblüffung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8eca281c-ff59-4160-b82b-8a4984b06793",
                        "source_entry_id": "875d336d-01ae-3f17-9510-4ebe0d266b85",
