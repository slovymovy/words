            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4616bce3-a79c-3fa0-a4fa-45b5b9016684",
                    "sense_definition": "een klein voorwerp van grote waarde of emotionele betekenis",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kostbaar voorwerp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>kleinood</w> werd zorgvuldig opgeborgen in een fluwelen doosje.",
                            "target_lang_translations": {
                                "en": "The <w>jewel</w> was carefully stored in a velvet box."
                            }
                        },
                        {
                            "text": "Zij beschouwt de oude ring van haar grootmoeder als een kostbaar <w>kleinood</w>.",
                            "target_lang_translations": {
                                "en": "She considers her grandmother's old ring a precious <w>treasure</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "juweel",
                        "sieraad",
                        "kostbaarheid"
                    ],
                    "common_phrases": [
                        "kostbaar kleinood"
                    ],
                    "target_lang_definitions": {
                        "en": "a small object of great value or emotional significance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "jewel",
                                "target_lang_sense_clarification": "a precious or valuable object"
                            },
                            {
                                "target_lang_word": "gem",
                                "target_lang_sense_clarification": "something prized for its beauty or worth"
                            },
                            {
                                "target_lang_word": "treasure",
                                "target_lang_sense_clarification": "a highly valued object"
                            },
                            {
                                "target_lang_word": "trinket",
                                "target_lang_sense_clarification": "a small ornament, often of sentimental value"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c4d2221-be9a-33e0-a881-3e6f52f489db",
                    "sense_definition": "een officieel versiersel of draagteken behorend bij een ridderorde",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "onderscheiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koning speldde het <w>kleinood</w> van de orde op de borst van de veteraan.",
                            "target_lang_translations": {
                                "en": "The king pinned the <w>insignia</w> of the order onto the veteran's chest."
                            }
                        },
                        {
                            "text": "Bij de ceremonie droeg hij het <w>kleinood</w> aan een lint om zijn hals.",
                            "target_lang_translations": {
                                "en": "At the ceremony, he wore the <w>decoration</w> on a ribbon around his neck."
                            }
                        }
                    ],
                    "synonyms": [
                        "insigne",
                        "onderscheidingsteken",
                        "versiersel"
                    ],
                    "common_phrases": [
                        "kleinood van de orde"
                    ],
                    "target_lang_definitions": {
                        "en": "an official decoration or badge belonging to an order of knighthood"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "insignia",
                                "target_lang_sense_clarification": "a badge or distinguishing mark of military or knightly rank"
                            },
                            {
                                "target_lang_word": "decoration",
                                "target_lang_sense_clarification": "a medal or badge conferred as an honor"
                            },
                            {
                                "target_lang_word": "badge",
                                "target_lang_sense_clarification": "a distinctive emblem of an organization or order"
                            }
                        ]
                    }
                }
            ]
        }
    ]
