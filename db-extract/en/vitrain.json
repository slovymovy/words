                        ],
                        "examples": [
                            {
                                "example_id": "8dc14f02-6157-4883-a65b-f9e597ca1de1",
                                "sense_id": "a6cd0c54-a337-381c-9c21-ed0f6dc2f287",
                                "text": "The caking behaviour of vitrain and clarain could be improved after the coal has been picked out."
                            },
                            {
                                "example_id": "5c5c4c6c-aeed-4755-a91b-98a440bafcbb",
                                "sense_id": "a6cd0c54-a337-381c-9c21-ed0f6dc2f287",
                                "text": "In order to measure relatively accurately the activation energy of coal, and to exclude the disturbance from coal samples, the hand-picked banded vitrains in bright coal are adopted as experimental samples (Table 1)."
                            },
                            {
                                "example_id": "11e6ff7c-d3ee-4a11-b796-77038d16f996",
                                "sense_id": "a6cd0c54-a337-381c-9c21-ed0f6dc2f287",
                                "text": "Thus, it may be concluded that a lower viscosity of plastic vitrain grains facilitates pores to grow and coalesce and grains to stick to one another to create intergrain pores."
                            }
                        ]
                    }
