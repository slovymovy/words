                    },
                    {
                        "translation_id": "19c0123d-1ee9-49fd-9e91-bdc53ccd6d12",
                        "source_entry_id": "17e20c19-a27b-309f-8728-a233059c8627",
                        "source_sense_id": "372484fa-d5f8-3301-bc2b-c8528de95994",
                        "source_sense_description": "bar connecting the beam to the sole",
                        "target_lang_word": "Bruststück",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bruststück",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d1a4a24-bc77-37a2-8d16-765ab56623c6",
                                        "entry_id": "f37c2b66-f919-32de-88cf-8df77433ea3d",
                                        "glosses": [
                                            "von Knochen und Sehnen befreites Stück Fleisch aus der Brust des Tieres"
                                        ],
                                        "tags": [
                                            "oft von Geflügel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b5bdef4-d634-4864-a060-f75a41696175",
                                                "sense_id": "9d1a4a24-bc77-37a2-8d16-765ab56623c6",
                                                "text": "„Es existiert auch eine Variante mit Rindfleisch, bei der das Bruststück bevorzugt wird.“"
                                            },
                                            {
                                                "example_id": "6687ef60-acf9-4b15-956e-eee944a68559",
                                                "sense_id": "9d1a4a24-bc77-37a2-8d16-765ab56623c6",
                                                "text": "„Die Bruststücke werden, wenn sie halb gar sind, herausgenommen und beiseite gestellt.“"
                                            },
                                            {
                                                "example_id": "281b0fbc-2f5f-4bd0-8213-d0df8af2383a",
                                                "sense_id": "9d1a4a24-bc77-37a2-8d16-765ab56623c6",
                                                "text": "„Die Bruststücke des Schneehuhns in zwei Hälften teilen, mit Salz und Pfeffer würzen, kurz in der Pfanne beidseitig bis zur leichten Bräune anbraten.“"
                                            },
                                            {
                                                "example_id": "30cfe8bf-63a0-4cb0-a096-0f34fb95dfa7",
                                                "sense_id": "9d1a4a24-bc77-37a2-8d16-765ab56623c6",
                                                "text": "„Wer in kleineren Gruppen isst, kann auch einzelne Keulen oder Bruststücke kaufen.“"
                                            },
                                            {
                                                "example_id": "d23485d4-8346-4828-96e0-f94ff37b154d",
                                                "sense_id": "9d1a4a24-bc77-37a2-8d16-765ab56623c6",
                                                "text": "„Es muss nicht immer eine ganze Gans sein, die zu den Feiertagen in den Backofen kommt. Auch Keulen oder Bruststücke von der Ente aus guter Tierhaltung sind bezahlbar und ein preiswerter Weihnachtsgenuss.“"
                                            },
                                            {
                                                "example_id": "190bde44-4659-45c8-989f-17a4d3cc9473",
                                                "sense_id": "9d1a4a24-bc77-37a2-8d16-765ab56623c6",
                                                "text": "[…] „das Bruststück ist viel schneller gar als die Keulen und wird deshalb in der Regel etwas trocken.“"
                                            },
                                            {
                                                "example_id": "0c3d90b3-6e65-4ad7-b49b-241c82ae266b",
                                                "sense_id": "9d1a4a24-bc77-37a2-8d16-765ab56623c6",
                                                "text": "„Wenn die Bruststücke perfekt gegart sind, brauchen die Keulen noch ein wenig länger.“"
                                            },
                                            {
                                                "example_id": "73a0d5ec-47b3-4fc5-9160-5da4da1f6bbb",
                                                "sense_id": "9d1a4a24-bc77-37a2-8d16-765ab56623c6",
                                                "text": "„Francisco Mari vom Evangelischen Entwicklungsdienst weiß, welchen Weg die restlichen Hünchenteile nehmen, wenn das Bruststück für deutsche Verbraucher herausgetrennt ist: »In der Statistik können sie ganz genau sehen, was wird exportiert. Das sind zu 80% Hühnchenteile, ohne Brust und fast ohne Schenkel.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8bb09b19-66ee-3ea9-9063-a209b6e21343",
                                        "entry_id": "f37c2b66-f919-32de-88cf-8df77433ea3d",
                                        "glosses": [
                                            "Darstellung des Kopfes mit dem Großteil des Oberkörpers"
                                        ],
                                        "tags": [
                                            "bei Gemälden, Skulpturen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7207be7-b13d-4062-bcc6-8a0ec8343d9d",
                                                "sense_id": "8bb09b19-66ee-3ea9-9063-a209b6e21343",
                                                "text": "„Swift ist hier nach dem Porträttypus des Bruststücks dargestellt, sie trägt ein weißes T-Shirt, ihre Haare sind offen und die Haarspitzen blau gefärbt.“"
                                            },
                                            {
                                                "example_id": "4211dd21-ca1b-4fab-99a4-3bcd1f48b6c3",
                                                "sense_id": "8bb09b19-66ee-3ea9-9063-a209b6e21343",
                                                "text": "„Während seines ganzen Schaffens malte Diego Rivera zahlreiche Selbstporträts. Diese zeigten ihn meist als Bruststück, Schulterstück oder Kopfbild.“"
                                            },
                                            {
                                                "example_id": "4c6637ab-1b87-4863-a570-19f90d821117",
                                                "sense_id": "8bb09b19-66ee-3ea9-9063-a209b6e21343",
                                                "text": "„Porträt des Vaters, Bruststück mit leicht nach rechts gedrehtem Profil. Öl/Lw 67x55 cm.“"
                                            },
                                            {
                                                "example_id": "7ccf704e-0e07-4e0f-bc6f-8a3c46e0c053",
                                                "sense_id": "8bb09b19-66ee-3ea9-9063-a209b6e21343",
                                                "text": "„Bildnis des J. E. Kregel. Nach 1709. Auf Leinwand, in Oel, 61,5 : 62,5 cm messend. Bruststück ähnlich dem Georg Bose'schen Bilde.“"
                                            },
                                            {
                                                "example_id": "10d33968-1bbb-4055-98b0-993e2b0eb212",
                                                "sense_id": "8bb09b19-66ee-3ea9-9063-a209b6e21343",
                                                "text": "„In diesem Gemälde hat Monet den Koch Paul Antoine Graff porträtiert. Es zeigt als Bruststück den Kopf und den Oberkörper des in seiner weißen Berufskleidung mit typischer Kochmütze dargestellten Mannes.“"
                                            },
                                            {
                                                "example_id": "e7e0ceba-92a3-45ea-bf4b-373299047206",
                                                "sense_id": "8bb09b19-66ee-3ea9-9063-a209b6e21343",
                                                "text": "„Im Januar und März 1845 folgte der Guss der Arme, am 11. Oktober 1845 der des Bruststückes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "896f3628-43e3-3894-874e-d127e3747801",
                                        "entry_id": "f37c2b66-f919-32de-88cf-8df77433ea3d",
                                        "glosses": [
                                            "Teil des Stethoskops, des auf den Körper des Patienten gelegt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe6511a7-f3e8-409f-8364-4f64c6c8db3e",
                                                "sense_id": "896f3628-43e3-3894-874e-d127e3747801",
                                                "text": "„Das Bruststück wird auf die Stelle gelegt, die abgehört werden soll.“"
                                            },
                                            {
                                                "example_id": "51409dee-11f5-4fb2-b7d4-aaceb377f755",
                                                "sense_id": "896f3628-43e3-3894-874e-d127e3747801",
                                                "text": "„Das Bruststück des konventionellen Stethoskops hat zwei Seiten.“"
                                            },
                                            {
                                                "example_id": "5b3aef5d-f790-4ce9-932a-b7311f9694a6",
                                                "sense_id": "896f3628-43e3-3894-874e-d127e3747801",
                                                "text": "„Im Bruststück befindet sich die Membran, die durch akustische Wellen in Schwingungen versetzt wird.“"
                                            },
                                            {
                                                "example_id": "f761e197-60a6-4b83-8be7-a318b51683d8",
                                                "sense_id": "896f3628-43e3-3894-874e-d127e3747801",
                                                "text": "„Zum Auskultieren wird das Bruststück mit leichtem Druck aufgesetzt“ […]."
                                            },
                                            {
                                                "example_id": "b83950c8-3892-4651-ad74-f994bfdf41fe",
                                                "sense_id": "896f3628-43e3-3894-874e-d127e3747801",
                                                "text": "„Im Bruststück befindet sich eine Membran, die die akustischen Wellen aufnimmt, dadurch selbst in Schwingungen versetzt wird und diese an die Luftsäule im Stethoskop-Schlauch weitergibt.“"
                                            },
                                            {
                                                "example_id": "66db7bdc-db72-41f8-903a-2671b647ebeb",
                                                "sense_id": "896f3628-43e3-3894-874e-d127e3747801",
                                                "text": "„Zu den Methoden gehören etwa das Auflegen des kalten Bruststücks eines Stethoskops, arterielle Kontraktion mit einem Blutdruckmessgerät oder Auslösen von Reflexen mit einem Perkussionshammer.“"
                                            },
                                            {
                                                "example_id": "80d16b39-2dfc-4fe3-abae-0b592829c542",
                                                "sense_id": "896f3628-43e3-3894-874e-d127e3747801",
                                                "text": "„Das Ergebnis: Die Stethoskope waren ähnlich stark belastet wie Teile der Hände der Ärzte. Und zwar sowohl mit normalen Bakterien als auch mit multiresistenten Keimen. Das betraf vor allem die Membran am Bruststück des Stethoskops.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6a660340-cedf-333f-904b-eaf31224286b",
                                        "entry_id": "f37c2b66-f919-32de-88cf-8df77433ea3d",
                                        "glosses": [
                                            "Teil einer Rüstung, die den Oberkörper schützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02ab9e8a-98e6-4db9-ae45-09c2d8dfcc47",
                                                "sense_id": "6a660340-cedf-333f-904b-eaf31224286b",
                                                "text": "„Um 1370 setzte sich schließlich der Brustpanzer (Bruststück) durch.“"
                                            },
                                            {
                                                "example_id": "b59f1c75-fe3f-4cc1-9cb2-1a1db3c3a1bc",
                                                "sense_id": "6a660340-cedf-333f-904b-eaf31224286b",
                                                "text": "„Karl der Große rechts neben ihm ist mit einer Ritterrüstung und einer Puffhose gewandet, das Bruststück ist geriffelt.“"
                                            },
                                            {
                                                "example_id": "e4a0c0ad-81fb-433d-b217-5c95bb40f374",
                                                "sense_id": "6a660340-cedf-333f-904b-eaf31224286b",
                                                "text": "„Die Reiter hatten, nachdem der Kürass Ende des 17. Jahrhunderts und Anfang des 18. Jahrhunderts außer Gebrauch gewesen war, 1715 wieder Bruststücke erhalten.“"
                                            },
                                            {
                                                "example_id": "f2c56075-0f8b-4c65-b410-33e7fc3b0cf2",
                                                "sense_id": "6a660340-cedf-333f-904b-eaf31224286b",
                                                "text": "„Es war ein metallischer Klang zu vernehmen und quer über das Bruststück der Rüstung des anderen Kriegers zog sich eine Delle.“"
                                            },
                                            {
                                                "example_id": "825c5e8e-304d-484e-b974-1a0d310e9b39",
                                                "sense_id": "6a660340-cedf-333f-904b-eaf31224286b",
                                                "text": "„Die Unterſuchung erſtreckte sich beſonders darauf, ob das Pferd auch zum Kriegsdienſt tauglich, und das Bruſtſtück der Rüſtung ſchußfeſt ſei, was man durch einen Piſtolenſchuß näher prüfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
