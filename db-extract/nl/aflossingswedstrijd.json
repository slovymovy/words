                        "glosses": [
                            "wedstrijd waarbij verschillende leden van een team om de beurt een deel van de afstand afleggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc307b7a-dd49-4bb9-85ee-c8de18987040",
                                "sense_id": "bf6ab58e-6b0f-3593-b73b-c49163a73875",
                                "text": "Rianne de Vries eindigde als tweede in de B-finale, goed voor een zesde plaats op deze afstand. Jorien ter Mors kwam er in de kwartfinales niet aan te pas en meldde zich vervolgens af voor de aflossingswedstrijd."
                            },
                            {
                                "example_id": "96651b50-8c68-453b-bc86-a839498d5d7a",
                                "sense_id": "bf6ab58e-6b0f-3593-b73b-c49163a73875",
                                "text": "Kamminga richt zich nu op de overige onderdelen: morgen staat ze aan de start van de 1.000 meter en de aflossingswedstrijd, volgende week komt ze in actie bij het wegtoernooi."
                            }
                        ]
