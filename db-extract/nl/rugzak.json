                                                "example_id": "b6879965-d887-4ffd-b6ff-93c10edba299",
                                                "sense_id": "daefe52e-bf9c-3597-9981-0c4348a263e0",
                                                "text": "Pojemność plecaka zazwyczaj określa się w litrach"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
