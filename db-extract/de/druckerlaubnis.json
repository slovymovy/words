                "senses": [
                    {
                        "sense_id": "f3061b5b-fc53-37cb-af6e-ba4a32262a91",
                        "entry_id": "23273d07-f516-3d91-88c3-5e1f48ba31ea",
                        "glosses": [
                            "Genehmigung durch eine damit beauftragte Stelle/einen Zensor, ein Schriftwerk in Druck zu geben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c581a3d-d557-4a1c-a78b-fe7370b75ad7",
                                "sense_id": "f3061b5b-fc53-37cb-af6e-ba4a32262a91",
                                "text": "„Nur die Druckerlaubnis des Zensors, die in russischer Sprache auf dem Titelblatt abgedruckt war, konnte er entziffern.“"
                            },
                            {
                                "example_id": "9d9ba292-930f-47e0-931d-002c201fd90b",
                                "sense_id": "f3061b5b-fc53-37cb-af6e-ba4a32262a91",
                                "text": "„1940 vollendete Pater Pierre sein Hauptwerk »Der Mensch im Kosmos«, erhielt allerdings keine kirchliche Druckerlaubnis.“"
                            },
                            {
                                "example_id": "2c1f06de-5c8b-4e81-aa7f-9a1d09855223",
                                "sense_id": "f3061b5b-fc53-37cb-af6e-ba4a32262a91",
                                "text": "„Als das Büchlein in Deutschland erscheint, wird es von der Militärzensur wegen fehlender Druckerlaubnis verboten und kursiert in mehreren illegalen Nachdrucken und Abschriften, sogar in Form eines Kettenbriefs.“"
                            },
                            {
                                "example_id": "b444c7e7-3308-4696-8638-8201a1aa69ac",
                                "sense_id": "f3061b5b-fc53-37cb-af6e-ba4a32262a91",
                                "text": "„Am 1. März erhielt er die Druckerlaubnis der venetianischen Behörde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c9ab3eea-d942-3f26-ae45-95713a690a8c",
                        "entry_id": "23273d07-f516-3d91-88c3-5e1f48ba31ea",
                        "glosses": [
                            "Zustimmung des Autors und/oder Verlegers, ein Schriftwerk in Druck zu geben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6620aa8a-e597-4cc7-819a-a42328ed83ac",
                                "sense_id": "c9ab3eea-d942-3f26-ae45-95713a690a8c",
                                "text": "Nach Durchsicht der Korrekturfahnen mochte er die erbetene Druckerlaubnis nicht mehr verweigern."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
