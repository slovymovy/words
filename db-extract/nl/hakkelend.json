                "senses": [
                    {
                        "sense_id": "7e2706cf-6766-38ae-adc5-bc6d938c3421",
                        "entry_id": "8ae7304c-22d5-37e9-9332-9018206cc8ef",
                        "glosses": [
                            "onhandig, ongemakkelijk, stotterend pratend of optredend"
