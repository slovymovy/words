                "forms": [
                    {
                        "form_id": "fadc79d1-4523-4924-83c4-24efcc80940d",
                        "entry_id": "1273bfa6-e07a-3467-9415-49d19f640417",
                        "tags": [
                            "plural"
                        ],
                        "form": "sédentarités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eda629db-d3dd-3d1e-b869-12135a8fec9f",
                        "entry_id": "1273bfa6-e07a-3467-9415-49d19f640417",
                        "glosses": [
                            "Qualité d’être sédentaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "566772cd-0caf-45c9-80bf-84bffcf0576c",
                                "sense_id": "eda629db-d3dd-3d1e-b869-12135a8fec9f",
                                "text": "Finalement, c’est de son chien Milou qu’il [Tintin] est le plus proche, à cela près que Milou ne rêve que de paresseuse sédentarité et peste contre l’humeur aventureuse de son maître."
                            },
                            {
                                "example_id": "dcae9111-5731-4fd6-ac69-d5ff7d54e61d",
                                "sense_id": "eda629db-d3dd-3d1e-b869-12135a8fec9f",
                                "text": "Son grand corps est long, encore mince bien que la sédentarité inhérente à son métier l’ait quelque peu empâté."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4c98c15-0a2d-3f0c-91b0-a181b385e9ca",
                        "entry_id": "1273bfa6-e07a-3467-9415-49d19f640417",
                        "glosses": [
                            "Mode de vie dans un lieu d’habitation fixe."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d68aae67-4727-3722-901e-1970c6234610",
                        "entry_id": "1273bfa6-e07a-3467-9415-49d19f640417",
                        "glosses": [
                            "Fait de rester trop sédentaire, en ne se déplaçant pas assez, en tant que problème de santé publique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fcb5770-de77-4b5f-a4f1-8172ba124b59",
                                "sense_id": "d68aae67-4727-3722-901e-1970c6234610",
                                "text": "La sédentarité et l'inactivité physique engendrent nombre d'effets dommageables sur la santé."
                            },
                            {
                                "example_id": "51c440fb-4ef7-4d7e-bf68-55e42c555ba7",
                                "sense_id": "d68aae67-4727-3722-901e-1970c6234610",
                                "text": "Maël Dec est chargé d’études à l’Observatoire national de l’activité physique et de la sédentarité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3adca4fc-04f8-4f73-94b2-c820972d5d17",
                        "source_entry_id": "1273bfa6-e07a-3467-9415-49d19f640417",
                        "target_lang_word": "Sesshaftigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5aa2b83a-18e6-4dfc-bbe2-c2b305950abf",
                        "source_entry_id": "1273bfa6-e07a-3467-9415-49d19f640417",
                        "target_lang_word": "Bewegungsmangel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bewegungsmangel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44d8fea5-d1f6-32ea-9269-2b98bf999d68",
                                        "entry_id": "3b877b2c-d04e-3f14-be41-e6e1cc34d3e5",
                                        "glosses": [
                                            "zu geringe körperliche Aktivität; dauerhaft bewegungsarmer Lebensstil, der in der Regel zu negativen Auswirkungen auf Gesundheit, Körperhaltung und Muskulatur führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7027dfe-35e4-401b-a351-a3c4fbeaddeb",
                                                "sense_id": "44d8fea5-d1f6-32ea-9269-2b98bf999d68",
                                                "text": "Bewegungsmangel gilt als eine der Ursachen für Zivilisationskrankheiten."
                                            },
                                            {
                                                "example_id": "4547f828-6418-4019-90a9-6bc1731504f5",
                                                "sense_id": "44d8fea5-d1f6-32ea-9269-2b98bf999d68",
                                                "text": "„Die durch Bewegungsmangel begünstigten Arthrosen gehören zu den häufigsten Gründen, warum ältere Menschen ins Pflegeheim müssen.“"
                                            },
                                            {
                                                "example_id": "986581c9-fa6a-4466-900e-203437072a87",
                                                "sense_id": "44d8fea5-d1f6-32ea-9269-2b98bf999d68",
                                                "text": "„Der über mehrere Jahrzehnte ablaufende Entstehungsprozess dieser Erkrankungen wird durch Risikofaktoren wie Bewegungsmangel begünstigt und beeinflusst die Funktion unterschiedlicher Zielzellen negativ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afbddc47-370f-43e7-9f27-768bdd1f0929",
                        "source_entry_id": "1273bfa6-e07a-3467-9415-49d19f640417",
                        "target_lang_word": "sedentism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sedentism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01714490-5827-3d6f-b90c-d1e699e3a93f",
                                        "entry_id": "c605fdcf-6103-3fc2-9d83-6a5dfefc6df9",
                                        "glosses": [
                                            "The practice of living in one place for a long time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd02c491-d6df-4125-9a63-cebaa420974b",
                                                "sense_id": "01714490-5827-3d6f-b90c-d1e699e3a93f",
                                                "text": "Where sedentism does occur amongst hunters and gatherers it seems generally to be related to a number of recurrent features."
                                            },
                                            {
                                                "example_id": "8899fafc-bcd5-429b-a77a-ddf457c42ddc",
                                                "sense_id": "01714490-5827-3d6f-b90c-d1e699e3a93f",
                                                "text": "The implicit correlations between mobility, sedentism, complexity, and progressive evolutionary change are so interwoven and all pervasive as to be all but impossible to disentangle in adaptationist theory."
                                            },
                                            {
                                                "example_id": "920602a3-f3c9-4358-b228-6508181952b4",
                                                "sense_id": "01714490-5827-3d6f-b90c-d1e699e3a93f",
                                                "text": "Assuming sedentism made children less costly, as is often said to be true, our theory predicts a shift toward increased fertility, increased child mortality, decreased food per capita, and increased regional population."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d41a953e-c0c6-4bb2-9d21-b396739c367f",
