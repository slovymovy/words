                "forms": [
                    {
                        "form_id": "bd0779eb-0b27-4007-a1c8-b4e9d49df031",
                        "entry_id": "a825a8fb-538e-3b5b-bd5b-006a2ec36621",
                        "tags": [
                            "plural"
                        ],
                        "form": "fracs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99b5efc8-4eed-3414-a8dc-c34d96509743",
                        "entry_id": "a825a8fb-538e-3b5b-bd5b-006a2ec36621",
                        "glosses": [
                            "Vêtement en drap noir que les hommes portent dans une cérémonie, une soirée et qui se termine en deux longues basques dites queue de morue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d46a335-5130-43e3-b1a2-b847c4d7c313",
                                "sense_id": "99b5efc8-4eed-3414-a8dc-c34d96509743",
                                "text": "[…] cette caressante poésie femelle a pour auteur un petit ambitieux, serré dans son frac, à tournure de diplomate, rêvant une influence politique, aristocrate à en puer, musqué, prétentieux."
                            },
                            {
                                "example_id": "8bf82df0-553c-4aac-ba4a-4be148ac3f03",
                                "sense_id": "99b5efc8-4eed-3414-a8dc-c34d96509743",
                                "text": "Entends-tu, Potapitch ? — dit-elle à un petit vieillard orné d’une cravate blanche étalée sur un frac, et d’un crâne déplumé, son majordome, qu’elle avait emmené avec ses bagages."
                            },
                            {
                                "example_id": "8e3e63ff-3806-41e2-8a09-14c992e4afe9",
                                "sense_id": "99b5efc8-4eed-3414-a8dc-c34d96509743",
                                "text": "Dans la salle à manger […], une douzaine de petites tables égaillées, nappées de grosses toiles basque, rassurèrent mon insociabilité. Point de beurre en coquilles, point de maître d’hôtel en frac noir-verdâtre, point de porte-bouquets parcimonieux comportant une anthémis, une anémone fatiguée, un brin de mimosa."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ceab518e-9545-4f25-b9c2-fae0f9c570c6",
                        "source_entry_id": "a825a8fb-538e-3b5b-bd5b-006a2ec36621",
                        "source_sense_id": "99b5efc8-4eed-3414-a8dc-c34d96509743",
                        "target_lang_word": "Frack",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frack",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac76d468-e087-3270-b177-1e69763c0144",
                                        "entry_id": "4f8a854c-d6c9-3e4c-8037-df8460d2097b",
                                        "glosses": [
                                            "festliche (schwarze) Männerjacke, die vorne nur bis zur Taille reicht und hinten charakteristische lange Schöße hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ad6ed4d-edcb-4102-9c8c-f009dec6a7ca",
                                                "sense_id": "ac76d468-e087-3270-b177-1e69763c0144",
                                                "text": "„Der Frack ist frisch gebügelt, die Fliege sitzt fest am weißen Hemdkragen, der Zylinder liegt vor ihm auf dem Armaturenbrett seines Autos.“"
                                            },
                                            {
                                                "example_id": "5dc4214c-4389-4d84-9193-b5e1f3bc517e",
                                                "sense_id": "ac76d468-e087-3270-b177-1e69763c0144",
                                                "text": "„Hinter der Bühne herrscht ein emsiges Hin und Her. Einige Musiker räumen ihre Instrumente in die Koffer, andere ziehen sich vor den geöffneten Transportkästen um und hängen ihre Fräcke und Kleider hinein.“"
                                            },
                                            {
                                                "example_id": "6bc508a1-7070-478e-8af3-94801f3491c3",
                                                "sense_id": "ac76d468-e087-3270-b177-1e69763c0144",
                                                "text": "„Er trug einen blauen Frack, ein Ordenskreuz um den Hals und einen Stern auf der linken Brustseite.“"
                                            },
                                            {
                                                "example_id": "0dd03303-1ccb-44f9-a0a3-581b2fe6ee61",
                                                "sense_id": "ac76d468-e087-3270-b177-1e69763c0144",
                                                "text": "„Aber es war ein Diener mit einer Laterne aus dem 18. Jahrhundert da, der mich eine Treppe hinunter (die Stufen waren mit hübschen Teppichen belegt) in eine Kellerwohnung führte, wo ich von einem richtigen Butler im Frack und mit weißen Handschuhen empfangen wurde, der mir den Mantel abnahm und der Gesellschaft meinen Namen verkündete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
