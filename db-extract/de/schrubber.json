                        "entry_id": "a1c24cc7-31ce-34b5-bc15-ca9c60582ada",
                        "glosses": [
                            "besenartiges Reinigungsgerät mit harten Borsten (eine Art Bürste mit Besenstiel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f02ac48-9abe-4524-b6a1-0a7915b64866",
                                "sense_id": "90d24c23-4f38-349a-b4e1-c8a321d151ff",
                                "text": "Ein Schrubber ist gut für die gründliche Reinigung des Fußbodens."
                            },
                            {
                                "example_id": "24f44e3c-14a9-4ba0-9898-8f9d562c5c93",
                                "sense_id": "90d24c23-4f38-349a-b4e1-c8a321d151ff",
                                "text": "Mit der einen Hand stützte sie sich auf den Schrubber, mit der anderen massierte sie ihren Rücken, der ganz steif geworden war vom vielen Bücken und schmerzte."
                            },
                            {
                                "example_id": "f097d770-c9a6-4508-89c6-5e0fd646bcc2",
                                "sense_id": "90d24c23-4f38-349a-b4e1-c8a321d151ff",
                                "text": "Und dann haben sie Streit miteinander bekommen, und seine Mutter hat ihm eins mit dem Schrubber übergezogen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
