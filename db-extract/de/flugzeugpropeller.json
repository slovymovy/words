                "senses": [
                    {
                        "sense_id": "d5a14ad0-03ee-33d4-b794-0619b0aa8d59",
                        "entry_id": "adec22b8-4357-3b67-bd1d-4872599d8cce",
                        "glosses": [
                            "Propeller, der bei einem Flugzeug für den Vortrieb sorgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8f4ec16-c0e7-469c-87d6-1d5a7240a64f",
                                "sense_id": "d5a14ad0-03ee-33d4-b794-0619b0aa8d59",
                                "text": "„Wie Boomerangs schleudert der Flugzeugpropeller seine Rotorblätter in die Tiefe - so scheint es zumindest auf der Videoaufnahme.“"
                            },
                            {
                                "example_id": "f3c4f8ca-b8f9-47c7-9cb4-5c835389e139",
                                "sense_id": "d5a14ad0-03ee-33d4-b794-0619b0aa8d59",
                                "text": "„Die Erkenntnisse können helfen, nicht nur künftige Flugzeugpropeller zu verbessern, sondern auch Hubschrauberrotoren und Windkraftanlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
