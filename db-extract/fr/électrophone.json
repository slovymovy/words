                "senses": [
                    {
                        "sense_id": "65849eb2-1101-3b61-9cc6-5af8e4bc9fa6",
                        "entry_id": "72b795b5-0e76-3518-8ef7-cef5183da8a3",
                        "glosses": [
                            "Appareil électrique capable de restituer un enregistrement sonore réalisé sur disque vinyle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e3bfbd1-29bf-493a-baee-4b3c058b0823",
                                "sense_id": "65849eb2-1101-3b61-9cc6-5af8e4bc9fa6",
                                "text": "Plus loin, après une porte capitonnée, des rayonnages superposés, faisant le coin, contiendraient des coffrets et des disques, à côté d’un électrophone fermé dont on n’apercevrait que quatre boutons d’acier guilloché, et que surmonterait une gravure représentant le Grand Défilé de la fête du Carrousel."
                            },
                            {
                                "example_id": "bd5bb8f0-28b6-4456-966a-c0e0811fac79",
                                "sense_id": "65849eb2-1101-3b61-9cc6-5af8e4bc9fa6",
                                "text": "Il existe peu de classes, actuellement, qui n’ont pas la possibilité d’utiliser un électrophone car son emploi est très ancien et son prix de revient relativement peu élevé."
                            }
                        ]
                    },
                    {
