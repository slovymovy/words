    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                    "sense_definition": "A person who performs labor for a living, especially manual or industrial labor.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory <w>worker</w> finished his shift and went home to rest.",
                            "target_lang_translations": {
                                "ru": "Заводской <w>рабочий</w> закончил свою смену и пошел домой отдыхать."
                            }
                        },
                        {
                            "text": "Every <w>skilled</w> <w>worker</w> in this company receives a fair salary and health benefits.",
                            "target_lang_translations": {
                                "ru": "Каждый квалифицированный <w>работник</w> в этой компании получает справедливую зарплату и медицинскую страховку."
                            }
                        }
                    ],
                    "synonyms": [
                        "proletarian"
                    ],
                    "antonyms": [
                        "employer",
                        "manager",
                        "boss",
                        "idler"
                    ],
                    "common_phrases": [
                        "skilled worker",
                        "factory worker",
                        "social worker",
                        "office worker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, занимающийся физическим или промышленным трудом для заработка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рабочий",
                                "target_lang_sense_clarification": "человек, занимающийся физическим трудом на производстве"
                            },
                            {
                                "target_lang_word": "работник",
                                "target_lang_sense_clarification": "общий термин для любого занятого трудом человека"
                            },
                            {
                                "target_lang_word": "трудящийся",
                                "target_lang_sense_clarification": "человек, живущий своим трудом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de39e866-8ea3-3fd0-8c54-2ae731a05a99",
                    "sense_definition": "A non-reproductive member of a colony of social insects, such as an ant or a bee.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>worker</w> <w>bee</w> spends its entire life collecting nectar for the hive.",
                            "target_lang_translations": {
                                "ru": "<w>Рабочая пчела</w> проводит всю свою жизнь, собирая нектар для улья."
                            }
                        },
                        {
                            "text": "The colony depends on each <w>worker</w> to find food and protect the queen.",
                            "target_lang_translations": {
                                "ru": "Колония зависит от каждой <w>рабочей особи</w> в поиске пищи и защите королевы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "worker bee",
                        "worker ant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неразмножающаяся особь в колонии общественных насекомых, таких как муравьи или пчелы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рабочая особь",
                                "target_lang_sense_clarification": "биологический термин для насекомых"
                            },
                            {
                                "target_lang_word": "рабочая пчела",
                                "target_lang_sense_clarification": "пчела, выполняющая работы в улье"
                            },
                            {
                                "target_lang_word": "рабочий",
                                "target_lang_sense_clarification": "сокращенное название рабочей особи насекомого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d27498dd-084d-3449-b21c-77e2a1a762d2",
                    "sense_definition": "A background process or thread that performs a specific task within a computer program.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The application uses a <w>service</w> <w>worker</w> to handle data synchronization in the background.",
                            "target_lang_translations": {
                                "ru": "Приложение использует сервис-<w>воркер</w> для синхронизации данных в фоновом режиме."
                            }
                        },
                        {
                            "text": "This FTP client spawns a separate <w>worker</w> for each file to be uploaded.",
                            "target_lang_translations": {
                                "ru": "Этот FTP-клиент создает отдельный <w>рабочий поток</w> для каждого загружаемого файла."
                            }
                        }
                    ],
                    "common_phrases": [
                        "service worker",
                        "background worker",
                        "worker thread"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фоновый процесс или поток, выполняющий определенную задачу в компьютерной программе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воркер",
                                "target_lang_sense_clarification": "профессиональный жаргон в IT"
                            },
                            {
                                "target_lang_word": "рабочий поток",
                                "target_lang_sense_clarification": "технический термин в программировании"
                            },
                            {
                                "target_lang_word": "обработчик",
                                "target_lang_sense_clarification": "процесс, выполняющий фоновые задачи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}