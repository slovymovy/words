                {
                    "sense_id": "3f7d9f24-09f2-3bc9-9a44-0cfd81f15a77",
                    "sense_definition": "A judge's private chamber, where cases may be heard in camera.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "room",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge decided to hear the sensitive evidence in <w>camera</w>.",
                            "target_lang_translations": {
                                "ru": "Судья решил заслушать конфиденциальные показания в <w>закрытом режиме</w>.",
                                "nl": "De rechter besloot het gevoelige bewijsmateriaal <w>achter gesloten deuren</w> te horen.",
                                "pl": "Sędzia zdecydował o przesłuchaniu wrażliwych dowodów <w>przy drzwiach zamkniętych</w>.",
                                "de": "Der Richter entschied, die sensiblen Beweise unter <w>Ausschluss der Öffentlichkeit</w> anzuhören.",
                                "fr": "Le juge a décidé d'entendre les preuves sensibles à <w>huis clos</w>.",
                                "it": "Il giudice ha deciso di ascoltare le prove sensibili in <w>camera di consiglio</w>.",
                                "cs": "Soudce se rozhodl vyslechnout citlivé důkazy s <w>vyloučením veřejnosti</w>.",
                                "tr": "Yargıç, hassas delilleri <w>kapalı oturumda</w> dinlemeye karar verdi.",
                                "es": "El juez decidió escuchar las pruebas confidenciales en <w>privado</w>."
                            }
                        },
                        {
                            "text": "Legal proceedings held in <w>camera</w> are not open to the public.",
                            "target_lang_translations": {
                                "ru": "Судебные разбирательства, проводимые в <w>закрытом режиме</w>, закрыты для публики.",
                                "nl": "Gerechtelijke procedures die <w>in camera</w> worden gehouden, zijn niet toegankelijk voor het publiek.",
                                "pl": "Postępowania sądowe prowadzone <w>przy drzwiach zamkniętych</w> nie są jawne dla publiczności.",
                                "de": "Gerichtsverfahren, die <w>nichtöffentlich</w> durchgeführt werden, sind für die Allgemeinheit geschlossen.",
                                "fr": "Les procédures judiciaires menées à <w>huis clos</w> ne sont pas ouvertes au public.",
                                "it": "I procedimenti legali tenuti a <w>porte chiuse</w> non sono aperti al pubblico.",
