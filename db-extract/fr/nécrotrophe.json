                    {
                        "sense_id": "8446b239-669e-3b84-8a59-3d27a8740b5c",
                        "entry_id": "3f1cb1e1-67be-3ba5-aaba-95dbced5fc9c",
                        "glosses": [
                            "Qualifie un organisme vivant qui croît sur les végétaux en saprophyte, en détruisant les cellules vivantes de la plante hôte."
                        ],
                        "tags": [
                            "Agronomie"
                        ],
                        "examples": [
                            {
                                "example_id": "4d53be2a-62e9-4279-8ba3-71a6cf2396b4",
                                "sense_id": "8446b239-669e-3b84-8a59-3d27a8740b5c",
                                "text": "Comme pour la dégradation des parois cellulaires on retrouve ici une stratégie différente, selon qu’on a affaire à des champignons biotrophes ou nécrotrophes."
                            },
                            {
                                "example_id": "0839a291-c0ca-473e-9093-ba5d52b9a030",
                                "sense_id": "8446b239-669e-3b84-8a59-3d27a8740b5c",
                                "text": "Quand à l’agent pathogène fongique nécrotrophe Sclerotinia sclerotiorum, qui a une gamme extrêmement large d’hôtes (plus de 400 espèces), a été inoculé à des plants de tabac renfermant ces transgènes, les plants habituellement sensibles sont devenus très tolérants et, dans la plupart des cas, totalement résistants."
                            }
                        ]
                    }
                ],
