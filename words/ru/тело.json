    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a4d9d501-ee1c-3a8e-beac-78f437112df7",
                    "sense_definition": "Организм человека или животного в его внешних, физических проявлениях; физическая оболочка живого существа.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "organism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгой тренировки у спортсмена болело всё <w>тело</w>.",
                            "target_lang_translations": {
                                "en": "After a long workout, the athlete's whole <w>body</w> ached.",
                                "zh": "经过长时间的训练，运动员全身的<w>身体</w>都在疼。"
                            }
                        },
                        {
                            "text": "Врач измерил температуру <w>тела</w> пациента.",
                            "target_lang_translations": {
                                "en": "The doctor measured the patient's <w>body</w> temperature.",
                                "zh": "医生测量了病人的<w>身体</w>温度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "организм",
                        "плоть"
                    ],
                    "antonyms": [
                        "душа"
                    ],
                    "common_phrases": [
                        "части тела",
                        "температура тела",
                        "всём теле",
                        "дрожать всем телом",
                        "язык тела"
                    ],
                    "target_lang_definitions": {
                        "en": "The physical structure of a person or an animal, including the bones, flesh, and organs.",
                        "zh": "人或动物的生理结构，包括骨骼、肌肉和器官。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "body",
                                "target_lang_sense_clarification": "physical structure"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "身体",
                                "target_lang_sense_clarification": "指人的生理结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84a3fb81-184a-376f-a8e6-926a3ba527e0",
                    "sense_definition": "Часть организма человека или животного, включающая грудь, спину и живот, но без головы и конечностей.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "organism_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он надел шерстяной свитер прямо на голое <w>тело</w>.",
                            "target_lang_translations": {
                                "en": "He put the wool sweater directly on his bare <w>body</w>.",
                                "zh": "他直接把羊毛衫穿在光着的<w>躯干</w>上。"
                            }
                        },
                        {
                            "text": "Боксёр пропустил сильный удар в <w>тело</w> и согнулся от боли.",
                            "target_lang_translations": {
                                "en": "The boxer took a hard blow to the <w>body</w> and doubled over in pain.",
                                "zh": "拳击手被重重地击中了<w>躯干</w>，疼得弯下了腰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "туловище",
                        "торс",
                        "корпус",
                        "стан"
                    ],
                    "common_phrases": [
                        "на голое тело",
                        "верхняя часть тела",
                        "удар в тело"
                    ],
                    "target_lang_definitions": {
                        "en": "The main part of a human or animal body, excluding the head, arms, and legs.",
                        "zh": "人或动物躯干的主要部分，不包括头部和四肢。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "torso",
                                "target_lang_sense_clarification": "anatomy"
                            },
                            {
                                "target_lang_word": "body",
                                "target_lang_sense_clarification": "trunk/torso"
                            },
                            {
                                "target_lang_word": "trunk",
                                "target_lang_sense_clarification": "anatomy"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "躯干",
                                "target_lang_sense_clarification": "解剖学上的躯干"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d174f573-7a16-330b-a57f-2a0c04b7911e",
                    "sense_definition": "Любой отдельный материальный предмет в пространстве, имеющий форму, объём и массу.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Луна — это небесное <w>тело</w>, которое вращается вокруг Земли.",
                            "target_lang_translations": {
                                "en": "The Moon is a celestial <w>body</w> that orbits the Earth.",
                                "zh": "月球是绕着地球旋转的<w>天体</w>。"
                            }
                        },
                        {
                            "text": "Врач аккуратно удалил инородное <w>тело</w> из глаза пациента.",
                            "target_lang_translations": {
                                "en": "The doctor carefully removed the foreign <w>body</w> from the patient's eye.",
                                "zh": "医生小心地从病人眼中取出了<w>异物</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "небесное тело",
                        "инородное тело",
                        "твёрдое тело",
                        "жидкое тело"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "physics"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A material object in space that has form, volume, and mass.",
                        "zh": "空间中具有形状、体积和质量的物质对象。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "body",
                                "target_lang_sense_clarification": "physics/astronomy"
                            },
                            {
                                "target_lang_word": "object",
                                "target_lang_sense_clarification": "material thing"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "物体",
                                "target_lang_sense_clarification": "泛指物质对象"
                            },
                            {
                                "target_lang_word": "天体",
                                "target_lang_sense_clarification": "指宇宙中的星体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d3a93c3-cf59-3f15-bbfa-c9528cc6f6e8",
                    "sense_definition": "Мёртвый организм человека или животного; останки умершего.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "corpse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Спасатели обнаружили <w>тело</w> пропавшего туриста в горах.",
                            "target_lang_translations": {
                                "en": "Rescuers found the <w>body</w> of the missing tourist in the mountains.",
                                "zh": "救援人员在山上发现了失踪游客的<w>尸体</w>。"
                            }
                        },
                        {
                            "text": "Родственники приехали в морг на опознание <w>тела</w>.",
                            "target_lang_translations": {
                                "en": "Relatives arrived at the morgue to identify the <w>body</w>.",
                                "zh": "亲属们来到停尸房辨认<w>尸体</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "труп"
                    ],
                    "common_phrases": [
                        "опознание тела",
                        "бездыханное тело",
                        "выдача тела"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "euphemism"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The dead body of a human or animal.",
                        "zh": "人或动物死亡后的遗体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "body",
                                "target_lang_sense_clarification": "corpse"
                            },
                            {
                                "target_lang_word": "corpse",
                                "target_lang_sense_clarification": "dead body"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尸体",
                                "target_lang_sense_clarification": "死亡后的遗体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07538fcc-36fc-3f42-a7a2-ffd4449469d4",
                    "sense_definition": "Часть пространства, ограниченная со всех сторон замкнутой поверхностью.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Шар и куб — это простейшие геометрические <w>тела</w>.",
                            "target_lang_translations": {
                                "en": "The sphere and the cube are the simplest geometric <w>solids</w>.",
                                "zh": "球体和立方体是最简单的几何<w>立体</w>。"
                            }
                        },
                        {
                            "text": "На уроке математики мы учились вычислять объём сложного <w>тела</w>.",
                            "target_lang_translations": {
                                "en": "In math class, we learned how to calculate the volume of a complex <w>solid</w>.",
                                "zh": "在数学课上，我们学习了如何计算复杂<w>立体</w>的体积。"
                            }
                        }
                    ],
                    "synonyms": [
                        "геометрическое тело"
                    ],
                    "common_phrases": [
                        "объём тела",
                        "тело вращения"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "geometry"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A three-dimensional object bounded by surfaces.",
                        "zh": "由表面包围的三维几何对象。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "solid",
                                "target_lang_sense_clarification": "geometry"
                            },
                            {
                                "target_lang_word": "geometric solid",
                                "target_lang_sense_clarification": "geometry"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "立体",
                                "target_lang_sense_clarification": "几何学中的三维图形"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0b76d4e-d262-3dd1-a5fd-e57c7b6309e7",
                    "sense_definition": "Основная, главная часть чего-либо (документа, финансового обязательства, конструкции или органа).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "main_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Заёмщик обязан сначала выплатить проценты, а затем <w>тело</w> кредита.",
                            "target_lang_translations": {
                                "en": "The borrower must first pay the interest, and then the <w>principal</w> of the loan.",
                                "zh": "借款人必须先偿还利息，然后再偿还贷款的<w>本金</w>。"
                            }
                        },
                        {
                            "text": "В <w>теле</w> письма необходимо кратко изложить суть вашего предложения.",
                            "target_lang_translations": {
                                "en": "In the <w>body</w> of the letter, you need to briefly outline the essence of your proposal.",
                                "zh": "在信件的<w>正文</w>中，你需要简要说明你的提议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "содержимое"
                    ],
                    "antonyms": [
                        "заголовок"
                    ],
                    "common_phrases": [
                        "тело кредита",
                        "тело письма",
                        "тело цикла",
                        "тело матки"
                    ],
                    "target_lang_definitions": {
                        "en": "The main or central part of something (e.g., a document, loan, or structure).",
                        "zh": "事物（如文档、贷款或结构）的主要或核心部分。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "body",
                                "target_lang_sense_clarification": "main part of text"
                            },
                            {
                                "target_lang_word": "principal",
                                "target_lang_sense_clarification": "finance/loan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正文",
                                "target_lang_sense_clarification": "文档的主要内容"
                            },
                            {
                                "target_lang_word": "本金",
                                "target_lang_sense_clarification": "金融贷款中的核心金额"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b5f27b8-b5e5-3e66-a326-917730849445",
                    "sense_definition": "Материальное начало в человеке, противопоставляемое духовному миру и душе.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Монахи старались усмирить своё <w>тело</w> строгим постом и молитвами.",
                            "target_lang_translations": {
                                "en": "The monks tried to subdue their <w>flesh</w> with strict fasting and prayers.",
                                "zh": "僧侣们试图通过严格的禁食和祈祷来克制自己的<w>肉体</w>。"
                            }
                        },
                        {
                            "text": "Говорят, что в здоровом <w>теле</w> — здоровый дух.",
                            "target_lang_translations": {
                                "en": "They say that a healthy mind is in a healthy <w>body</w>.",
                                "zh": "人们常说，健康的<w>身体</w>里才有健康的灵魂。"
                            }
                        }
                    ],
                    "synonyms": [
                        "плоть",
                        "бренная оболочка"
                    ],
                    "antonyms": [
                        "душа",
                        "разум"
                    ],
                    "common_phrases": [
                        "душа и тело",
                        "грешное тело"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "philosophy"
                        },
                        {
                            "trait_type": "form",
                            "comment": "religion"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The physical aspect of a person, as opposed to the spirit or soul.",
                        "zh": "人的生理层面，与精神或灵魂相对。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "body",
                                "target_lang_sense_clarification": "vs soul"
                            },
                            {
                                "target_lang_word": "flesh",
                                "target_lang_sense_clarification": "religious/philosophical"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肉体",
                                "target_lang_sense_clarification": "与灵魂相对的生理层面"
                            }
                        ]
                    }
                }
            ]
