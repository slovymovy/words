                    {
                        "sense_id": "110ef704-aa79-3ee8-a763-5b5c53f82e53",
                        "entry_id": "24098be9-8289-3e1f-842f-5f39b144c369",
                        "glosses": [
                            "Qualifie l’état premier de l’enfant, quand il n’a pas encore eu l’expérience d’objets extérieurs à lui-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9de36745-591f-4853-94ed-ae49614f63e6",
                                "sense_id": "110ef704-aa79-3ee8-a763-5b5c53f82e53",
                                "text": "Repartons du postulat de base que tout enfant qui vient au monde n’a ni conscience de lui-même ni de son environnement, qu’il a « tout à apprendre ». Il est au stade anobjectal (premier mois de la vie)."
                            }
                        ]
                    },
                    {
                        "sense_id": "15fa3493-c4ba-3758-b957-d444fbf7c74f",
                        "entry_id": "24098be9-8289-3e1f-842f-5f39b144c369",
                        "glosses": [
                            "Qui se focalise sur soi-même sans lien extérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b01a201-c8e1-4a3a-8867-f27c6ff0a44e",
                                "sense_id": "15fa3493-c4ba-3758-b957-d444fbf7c74f",
                                "text": "[…] l’auto-érotisme sera défini comme le mode de satisfaction du stade narcissique. Le narcissisme primaire perdra, de ce fait, son caractère de relation spéculaire à un objet interne, pour devenir quasi synonyme d’état « anobjectal »."
                            }
                        ]
                    }
