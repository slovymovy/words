                ],
                "senses": [
                    {
                        "sense_id": "9862c91c-40a2-3229-ba9b-210cc5b61398",
                        "entry_id": "46fda5a0-7cee-3f60-b158-2317ad46e516",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8237dc61-5297-4deb-a8a0-401a2b2b7aa6",
                                "sense_id": "9862c91c-40a2-3229-ba9b-210cc5b61398",
                                "text": "Frau Hauck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d00a38ad-00f0-4765-a04c-3e6856f2d8ae",
                                "sense_id": "9862c91c-40a2-3229-ba9b-210cc5b61398",
                                "text": "Herr Hauck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "46d4b778-c24e-403a-81db-a64ff934689b",
                                "sense_id": "9862c91c-40a2-3229-ba9b-210cc5b61398",
                                "text": "Die Haucks fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "4128a7ee-6ad2-4ed3-9d6f-2a18a8f6b3a3",
                                "sense_id": "9862c91c-40a2-3229-ba9b-210cc5b61398",
                                "text": "Der Hauck trägt nie die Pullover, die die Hauck ihm strickt."
                            },
                            {
                                "example_id": "f0a2bc56-ce2f-452f-9f3a-ee0c0bc72aaa",
                                "sense_id": "9862c91c-40a2-3229-ba9b-210cc5b61398",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hauck kommt, geht der Herr Hauck.“"
                            },
                            {
                                "example_id": "a63688cc-5bbb-4c6f-bd02-9ce27cb6831d",
                                "sense_id": "9862c91c-40a2-3229-ba9b-210cc5b61398",
                                "text": "Hauck kommt und geht."
                            },
                            {
                                "example_id": "5cc6430d-a91d-4dcb-bdb0-f06a67fd0d53",
                                "sense_id": "9862c91c-40a2-3229-ba9b-210cc5b61398",
                                "text": "Haucks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
