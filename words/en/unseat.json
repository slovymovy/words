                    "frequency": "Middle",
                    "semantic_group_id": "depose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The opposition party hopes to <w>unseat</w> the prime minister in the upcoming election."
                        },
                        {
                            "text": "She campaigned tirelessly to <w>unseat</w> the incumbent mayor after years of controversy."
                        }
                    ],
                    "synonyms": [
                        "depose",
                        "oust",
                        "overthrow"
                    ],
                    "antonyms": [
