                        ],
                        "examples": [
                            {
                                "example_id": "3c5efbd3-70de-47e1-8a27-f5fb4093227a",
                                "sense_id": "b8db879a-c79d-34ad-9026-0e7ad1fe27dc",
                                "text": "Pannenkoek: dan krijg je dat. Nooit eerder was Marco zo beledigd en heel Nederland voelde met hem mee. Een voormalige held vergelijk je niet met een kindertraktatie. Klootzak: oké. Zakkenwasser: moet kunnen. Prutser, nietsnut, hufter, dombo — alles is beter dan iemand die zijn stinkende best doet uit te maken voor een bruin en plat gerecht bestaande uit meel, melk, ei en een snufje zout."
                            }
                        ]
                    }
