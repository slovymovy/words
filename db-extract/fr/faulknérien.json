                "senses": [
                    {
                        "sense_id": "a0d47c45-3b66-34c2-903e-64b413373e2c",
                        "entry_id": "371b86ce-eb63-344d-87ff-ebbe9d22fef2",
                        "glosses": [
                            "Propre ou relatif à William Faulkner et son œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f384c0b-97cc-4303-8563-88344533e040",
                                "sense_id": "a0d47c45-3b66-34c2-903e-64b413373e2c",
                                "text": "Le thème faulknérien de la création de grands domaines « sudistes », présent dès 1947 dans \"Noé\" avec ses nombreuses figures de dynastes constituant domaines et « duchés », continuera à hanter Giono jusqu’à la fin de sa vie."
                            },
                            {
                                "example_id": "3bbb15c2-9114-4bd5-8bb6-937c5d25ffc6",
                                "sense_id": "a0d47c45-3b66-34c2-903e-64b413373e2c",
                                "text": "L’autre questionnement du texte faulknérien approfondi par Romano touche au temps."
                            },
                            {
                                "example_id": "3abb694c-7389-4284-9a2d-d0487ef02194",
                                "sense_id": "a0d47c45-3b66-34c2-903e-64b413373e2c",
                                "text": "Mathieu Belezi pilote un carambolage faulknérien des transgressions contemporaines."
                            }
                        ]
                    }
