                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30e1b258-a9ed-4744-b51d-8d078b939b0d",
                                                "sense_id": "d1154afa-0437-33f0-bb4c-560f292b9fa8",
                                                "text": "Hem werd het spijbelen op hardhandige wijze voorgoed afgeleerd."
                                            },
                                            {
                                                "example_id": "0b05c645-a9b3-43c7-8d63-58f0a922702d",
                                                "sense_id": "d1154afa-0437-33f0-bb4c-560f292b9fa8",
                                                "text": "Haar wijsheid lijkt te maken te hebben met het afleren van je angsten, een wijsheid die ontstaat als je de eindigheid van het leven aanvaardt.'Je doet erg je best, hè?' zegt Bibi. Ze staart naar de grond."
                                            }
                                        ]
