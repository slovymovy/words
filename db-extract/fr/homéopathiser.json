                "senses": [
                    {
                        "sense_id": "93208f4e-81dc-3b30-8902-08ed01a25a52",
                        "entry_id": "0c1dbc26-2222-3085-8c39-296857fb13c0",
                        "glosses": [
                            "Considérer d’un point de vue lié à l’homéopathie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b7a57ba-452d-4f8d-9e6d-2e45d9f7f7aa",
                                "sense_id": "93208f4e-81dc-3b30-8902-08ed01a25a52",
                                "text": "Que pouvons-nous faire d’autre sur cette terre que d’essayer d’homéopathiser le mal?"
                            },
                            {
                                "example_id": "7b12531a-78aa-4f32-9b8f-4b6f0e2792ea",
                                "sense_id": "93208f4e-81dc-3b30-8902-08ed01a25a52",
                                "text": "Et le présentéisme dionysien est une forme de sagesse s'employant à homéopathiser la mort, à s’accorder à l’intensité du moment vécu et, par là, à lutter contre l’angoisse du temps qui passe."
                            }
                        ]
                    }
