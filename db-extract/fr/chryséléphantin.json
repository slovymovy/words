                                        "entry_id": "cc37e335-acb6-33be-8216-a3565c67d41a",
                                        "glosses": [
                                            "Made of gold and ivory."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94c9ecee-f638-42c0-a036-67b7639eac91",
                                                "sense_id": "554343c1-bc0a-322e-9eda-790267c0604b",
                                                "text": "I drew near and perceived that the light came from a precious stone as big as an ostrich egg, set at the upper end of the alcove upon a little chryselephantine couch of ivory and gold; and this jewel, blazing like the sun, cast its rays wide and side."
                                            }
                                        ]
