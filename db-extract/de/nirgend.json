                "forms": [],
                "senses": [
                    {
                        "sense_id": "a644754c-fd54-3c8f-bd39-580cd7935b50",
                        "entry_id": "af9e5a4b-551a-35d5-b9fd-c5764aaa46cc",
                        "glosses": [
                            "Variante de nirgends : nulle part."
                        ],
                        "tags": [
                            "alt-of",
                            "dated",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "f84bf545-97e6-4bd6-9f75-830e6ab5a996",
                                "sense_id": "a644754c-fd54-3c8f-bd39-580cd7935b50",
                                "text": "Der jetzt offene Graben ist talseitig in Trockenbauweise gemauert und hangseitig teilweise durch den Felsen geschlagen, führt aber fast nirgend Wasser.",
                                "translation": "Le fossé, maintenant ouvert, est muré en pierres sèches côté aval et excavé partiellement dans la roche côté amont, mais ne conduit de l’eau presque nulle part."
                            },
                            {
                                "example_id": "1996a14d-784c-4d6d-9cd6-4933c66df492",
                                "sense_id": "a644754c-fd54-3c8f-bd39-580cd7935b50",
                                "text": "Man wird nirgend Schaden tun noch verderben auf meinem ganzen heiligen Berge; denn das Land ist voll Erkenntnis des Herrn, wie Wasser das Meer bedeckt.",
                                "translation": "On ne veut détruire ou corrompre nulle part sur toute ma sainte montagne ; car le pays est rempli de la connaissance du Seigneur, comme les eaux recouvrent la mer."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff913a14-66a4-3086-9f52-aff22a1a0d6b",
                        "entry_id": "af9e5a4b-551a-35d5-b9fd-c5764aaa46cc",
                        "glosses": [
                            "Variante de nirgends : en aucune manière."
                        ],
                        "tags": [
                            "alt-of",
                            "dated",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "cd2bc24c-f7bf-468c-80ea-695be798a517",
                                "sense_id": "ff913a14-66a4-3086-9f52-aff22a1a0d6b",
                                "text": "Zudem behaupte ich nirgend, dass die Serben während der Jugoslawienkriege kein einziges Verbrechen verübten.",
                                "translation": "D’ailleurs, je ne prétends en aucune manière que les Serbes n’ont pas commis le moindre crime pendant les guerres de Yougoslavie."
                            }
                        ]
                    }
                ],
