                "senses": [
                    {
                        "sense_id": "ae8162a1-32ee-379e-805d-1307dd6f25c7",
                        "entry_id": "f0b46981-8069-3c34-bcb0-bd56569c8e2c",
                        "glosses": [
                            "odnoszący się do torfu, zrobiony z torfu, zawierający torf, tworzący złoże torfu"
                        ],
                        "tags": [],
