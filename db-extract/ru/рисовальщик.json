                                        "entry_id": "3055d845-d132-325d-91e1-67140e4a500c",
                                        "glosses": [
                                            "A person who prepares technical drawings and plans."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "762db734-2d5d-3292-aa84-3f74c7c2a883",
                                        "entry_id": "3055d845-d132-325d-91e1-67140e4a500c",
                                        "glosses": [
                                            "A person who prepares drafts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a61aa4b-6184-4b7b-8f64-d5fab86cd0ad",
                                                "sense_id": "762db734-2d5d-3292-aa84-3f74c7c2a883",
                                                "text": "It is highly improbable that the drafter of the notice ever visualised the form that heavy vehicles of the future would take, but the comprehensive wording still covers modern types."
                                            },
                                            {
                                                "example_id": "bb55f636-3552-4f95-9e96-7587e31cd26d",
                                                "sense_id": "762db734-2d5d-3292-aa84-3f74c7c2a883",
                                                "text": "Departmental drafters have done their best to explain in the June report what's happened, but obviously can't write about the politics that led to Golborne being dropped. Instead, they refer to the Government's Union Connectivity Review [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "488bc035-a2f7-3e43-9cb5-77f6bfbcaf86",
                                        "entry_id": "3055d845-d132-325d-91e1-67140e4a500c",
                                        "glosses": [
                                            "A person who writes a legislative bill."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
