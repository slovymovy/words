    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5e200025-842c-3969-a07c-8063df0f23cf",
                    "sense_definition": "postać biblijna ze Starego Testamentu, symbol niezawinionego cierpienia i niezłomnej wiary",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biblia",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "I Pan przywrócił <w>Hioba</w> do dawnego stanu, gdyż modlił się on za swych przyjaciół.",
                            "target_lang_translations": {
                                "en": "And the Lord restored <w>Job</w> to his former state, for he had prayed for his friends."
                            }
                        },
                        {
                            "text": "Żona <w>Hioba</w> wcale go nie wspierała w ciężkich chwilach próby.",
                            "target_lang_translations": {
                                "en": "<w>Job's</w> wife did not support him at all during his difficult moments of trial."
                            }
                        }
                    ],
                    "synonyms": [
                        "Job"
                    ],
                    "common_phrases": [
                        "Księga Hioba"
                    ],
                    "target_lang_definitions": {
                        "en": "a biblical figure from the Old Testament, a symbol of innocent suffering and unwavering faith"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Job",
                                "target_lang_sense_clarification": "biblical figure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca442fcf-9724-350a-8713-9340a45de5db",
                    "sense_definition": "rzadkie imię męskie pochodzenia semickiego",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "imie",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mój znajomy ma na imię <w>Hiob</w>, co często wzbudza zdziwienie innych ludzi.",
                            "target_lang_translations": {
                                "en": "My friend's name is <w>Job</w>, which often arouses surprise in other people."
                            }
                        },
                        {
                            "text": "Rodzice postanowili nadać swojemu synowi tradycyjne imię <w>Hiob</w>.",
                            "target_lang_translations": {
                                "en": "The parents decided to give their son the traditional name <w>Job</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Job"
                    ],
                    "target_lang_definitions": {
                        "en": "a rare male given name of Semitic origin"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Job",
                                "target_lang_sense_clarification": "male given name"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f8634c9-71e7-3a95-abca-b2b3b4f3f79c",
                    "sense_definition": "człowiek dotknięty wielkimi nieszczęściami, cierpiący bez własnej winy",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kto pocieszy współczesnych <w>hiobów</w>, którzy stracili cały dobytek w wyniku powodzi?",
                            "target_lang_translations": {
                                "en": "Who will comfort modern <w>Jobs</w> who have lost all their possessions as a result of the flood?"
                            }
                        },
                        {
                            "text": "Po serii osobistych tragedii czuł się jak prawdziwy <w>hiob</w>.",
                            "target_lang_translations": {
                                "en": "After a series of personal tragedies, he felt like a real <w>Job</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nieborak",
                        "nieszczęśnik"
                    ],
                    "target_lang_definitions": {
                        "en": "a person afflicted by great misfortunes, suffering through no fault of their own"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Job",
                                "target_lang_sense_clarification": "person suffering great misfortune"
                            }
                        ]
                    }
                }
            ]
        }
    ]
