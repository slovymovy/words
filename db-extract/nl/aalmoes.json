                ],
                "senses": [
                    {
                        "sense_id": "b198d3dd-1129-33ac-ad4a-e344ae66beee",
                        "entry_id": "b1a13cb6-ce8f-33d0-9bfd-f36a2fee0806",
                        "glosses": [
                            "Almosen, Scherflein"
                        ],
                        "tags": [],
