                                "target_senses": [
                                    {
                                        "sense_id": "f050e3cf-f146-3365-aba4-bea1f71f86db",
                                        "entry_id": "880ce7f1-feab-3a1a-bfdb-1dd383f3c704",
                                        "glosses": [
                                            "Petite pièce métallique collée sur la face externe de la dent, elles permettent avec l'aide d'un fil d'acier de cerclage de remettre les dents dans l'alignement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f2f97c0-18de-4452-807c-182404c337b3",
                                                "sense_id": "f050e3cf-f146-3365-aba4-bea1f71f86db",
                                                "text": "Mais le procédé peut également être utilisé pour les traitements par appareillage fixe que ce soit avec des brackets vestibulaires (Insignia®) ou des brackets linguaux (Incognito®, Win®) qui sont alors entièrement individualisés pour le patient, livrés au praticien avec deux gouttières de collage indirect ainsi que toute la séquence des fils orthodontiques réalisés sur mesure par des robots plieurs"
                                            }
                                        ]
