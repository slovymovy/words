                "senses": [
                    {
                        "sense_id": "eedb0bbe-769f-33be-976d-d1187a7a23e9",
                        "entry_id": "40780cd3-9cac-36b0-bdea-c8926c1d07b2",
                        "glosses": [
                            "Alternative form of adonise."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "a6deedfb-32a1-48fa-9af6-09ac7f9839cd",
                                "sense_id": "eedb0bbe-769f-33be-976d-d1187a7a23e9",
                                "text": "both male and female Adonise their tails in this manner, which gives them a remarkable appearance amongst all other birds."
                            },
                            {
                                "example_id": "145eb37f-043a-4edf-b6f7-18c46fff6cb7",
                                "sense_id": "eedb0bbe-769f-33be-976d-d1187a7a23e9",
                                "text": "He next tootled for half an hour upon a one-keyed flute, and then proceeded to Adonise. Notwithstanding all that some writers have said about a physical aristocracy, — an air of refinement,— which is perceptible under the veriest rags, I am entirely of the opinion, with Bob Acres in the Rivals, that dress \"does make a difference.\""
                            },
                            {
                                "example_id": "2cf5fde7-5d56-42d2-b8cf-754e158c9c6d",
                                "sense_id": "eedb0bbe-769f-33be-976d-d1187a7a23e9",
                                "text": "And more — in the course of your acquaintauce with the Tantrums, you must have noticed, of a cold evening, when Tantrum desired to \" Adonise,\" that he might be intensely agreeable to all beholders, and \" lovelily dreadful\" to the ladies, that \"that razor\" would cut his chin in defiance of all he could do to the contrary;"
                            },
                            {
                                "example_id": "3e61f2b8-b118-4e45-b83f-be5bf1e91459",
                                "sense_id": "eedb0bbe-769f-33be-976d-d1187a7a23e9",
                                "text": "You swear — you reprobate, so you do — when your bootmaker seeks to Adonise your instep, or the pine you patronized over night quarrels with your coffee in the morning."
                            }
                        ]
                    }
