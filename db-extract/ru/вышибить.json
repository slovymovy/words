                "senses": [
                    {
                        "sense_id": "d4aaaf27-e256-3550-8a1e-23c96969cac5",
                        "entry_id": "4ec5fb05-d27a-367a-b0bd-73475066a85a",
                        "glosses": [
                            "разг. резким толчком выбить откуда-либо"
