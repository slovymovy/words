                                        "glosses": [
                                            "Staatsbürgerin Russlands oder Angehörige des russischen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7b349bd-4df7-4043-b720-f358edf94708",
                                                "sense_id": "8e7e6155-6087-37d8-a064-14a2e7bad659",
                                                "text": "Meine Großmutter mütterlicherseits ist eine Russin."
                                            },
                                            {
                                                "example_id": "082d9625-79ab-4557-8d04-12c814aa3b7a",
                                                "sense_id": "8e7e6155-6087-37d8-a064-14a2e7bad659",
                                                "text": "„Das zerfurchte Gesicht drehte sich einen Augenblick zu der jungen Russin und dann zurück.“"
                                            }
                                        ],
