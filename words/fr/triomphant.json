            "senses": [
                {
                    "sense_id": "3bc93efa-aa53-38b4-823c-67912ad7c8fe",
                    "sense_definition": "Personne qui s'enorgueillit de son triomphe ou de sa victoire.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune homme prenait une posture arrogante, agissant en véritable <w>triomphant</w> devant ses rivaux."
