                "senses": [
                    {
                        "sense_id": "3c5b323f-2745-31d7-bcbb-b1d37214e6fc",
                        "entry_id": "8e6217ac-c77e-3ba1-8687-33c9e84a5982",
                        "glosses": [
                            "nog onzeker, in afwachting van een besluit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "891bf736-4697-486c-a019-086c21aeeb09",
                                "sense_id": "3c5b323f-2745-31d7-bcbb-b1d37214e6fc",
                                "text": "Het grote debat over de biografie - over de toelaatbaarheid en het nut van het gebruik van biografische gegevens bij de analyse van het werk en andersom - was nog onbeslist."
                            }
                        ]
                    },
                    {
                        "sense_id": "71e8112f-8c19-3160-860b-f90cf7fa52c2",
                        "entry_id": "8e6217ac-c77e-3ba1-8687-33c9e84a5982",
                        "glosses": [
                            "zonder winnaar of verliezer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae71010e-d9db-4cd0-8209-3947e80db186",
                                "sense_id": "71e8112f-8c19-3160-860b-f90cf7fa52c2",
                                "text": "Het werd een strijd met povere resultaten, met een slag op de Doggersbank in augustus 1781 met admiraal Zoutman, een slag die gevierd werd als overwinning, maar in werkelijkheid onbeslist was en veel materiële schade opleverde."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d5b7119-f2fd-3ef5-83e7-d1ce92e664c3",
                        "entry_id": "8e6217ac-c77e-3ba1-8687-33c9e84a5982",
                        "glosses": [
                            "zonder winnaar of verliezer",
                            "in gelijkspel, remise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed5d899b-a79e-4c1d-8a51-d56b24bb9462",
                                "sense_id": "4d5b7119-f2fd-3ef5-83e7-d1ce92e664c3",
                                "text": "Het werd een strijd met povere resultaten, met een slag op de Doggersbank in augustus 1781 met admiraal Zoutman, een slag die gevierd werd als overwinning, maar in werkelijkheid onbeslist was en veel materiële schade opleverde."
                            },
                            {
                                "example_id": "131800ec-184d-4cf8-9675-4ddcc7be69b2",
                                "sense_id": "4d5b7119-f2fd-3ef5-83e7-d1ce92e664c3",
                                "text": "De Brabantse derby tussen RKC en NAC eindigde na een leuk duel onbeslist, 2-2."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e1d7063-f48a-316d-b3e5-1aa9ac743265",
                        "entry_id": "8e6217ac-c77e-3ba1-8687-33c9e84a5982",
                        "glosses": [
                            "besluiteloos, aarzelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ab7762b-632c-4e79-9449-d18a609300b2",
                                "sense_id": "8e1d7063-f48a-316d-b3e5-1aa9ac743265",
                                "text": "Ze zaten hand in hand tegen mekaar, onbeslist, en praatten met tussenpozen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a9b9c8f-fa67-41bd-a9a9-a3b40e187f6c",
                        "source_entry_id": "8e6217ac-c77e-3ba1-8687-33c9e84a5982",
                        "source_sense_id": "3c5b323f-2745-31d7-bcbb-b1d37214e6fc",
                        "source_sense_description": "nog onzeker, in afwachting van een besluit",
                        "target_lang_word": "unentschlossen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unentschlossen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                        "entry_id": "910d435a-119e-33fa-95cf-d3fdb8b1ae1e",
                                        "glosses": [
                                            "unsicher, wie etwas zu beurteilen oder was zu tun ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f029c6-90f5-414b-8b9e-8d847eead76e",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Nur ein knappes Viertel sieht darin kein Problem, der Rest zeigt sich unentschlossen.“"
                                            },
                                            {
                                                "example_id": "8f76c919-426a-4ce2-bf89-451707b39cf4",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Einige Wähler mögen noch unentschlossen sein, und mancher ist so frei, gar nicht zur Wahl zu gehen.“"
                                            },
                                            {
                                                "example_id": "a42def9b-8c63-4126-981c-1a4ebafe9d0a",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Vier von sieben Personen waren unentschlossen (50 %) hinsichtlich der wahrgenommenen Schlaflosigkeit.“"
                                            },
                                            {
                                                "example_id": "963460e9-a495-436c-be39-ccbb526eaf3b",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Gerade wenn sie es mit einem so unentschlossenen Kunden wie Herrn Kunze zu tun hat, kann sich alles immer wieder neu verändern.“"
                                            },
                                            {
                                                "example_id": "b1ea9f0f-0798-4c06-bcc7-123d775948d0",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Wäre ich wirklich so unentschlossen gewesen, wie ich wohl den Eindruck gemacht hatte, dann wäre dieser Kauf nie zustande gekommen.“"
                                            },
                                            {
                                                "example_id": "da4686b0-9c09-4bec-87d6-06d1c03e49cf",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Ein ebenso großer Anteil ist zwar noch unentschlossen, zurück zu weniger Homeoffice will aber kaum ein Unternehmen, heißt es in der am Donnerstag veröffentlichten Studie.“"
                                            },
                                            {
                                                "example_id": "18ff0f17-9704-4220-9d3c-1b38dc78317f",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Die Freien Wähler hingegen sind noch unentschlossen und fordern Antworten auf ‚viele offene Fragen‘.“"
                                            },
                                            {
                                                "example_id": "f9fc1622-7b87-4a29-813a-8ccd5fb4974f",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Allerdings sind viele Franzosen noch unentschlossen, wem sie bei der Präsidentschaftswahl ihre Stimme geben sollen.“"
                                            },
                                            {
                                                "example_id": "4843711f-37d8-4d94-9e3d-7a338d573b7e",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Lediglich fünf Prozent lehnten diese Aussage stark ab, neun Prozent lehnten ab und 18 Prozent antworteten unentschlossen mit ‚teils/teils‘.“"
                                            },
                                            {
                                                "example_id": "cfa207e3-83a0-4f7e-98c8-7002f4eb283c",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Doch der Inhalt ist so lückenhaft und unentschlossen, dass die Anschuldigung kippen könnte.“"
                                            },
                                            {
                                                "example_id": "9ca94bba-2d4c-44df-97f8-05dfeea290a4",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Sollten unsere unentschlossenen Ministerpräsidenten also nicht vielleicht in Washington nachfragen, was genau die dortigen Ärzte Trump verabreicht haben?“"
                                            },
                                            {
                                                "example_id": "45d61aae-cf25-4bc0-8852-62eb189cb643",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Doch sicher sein kann man sich nicht; die Zahl der unentschlossenen Wähler ist groß.“"
                                            },
                                            {
                                                "example_id": "8854d39b-b2fe-4888-9d56-4b3e69804f4a",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Hilfsorganisationen übten scharfe Kritik an der unentschlossenen Haltung der G20-Staaten, die Probleme konkret anzugehen.“"
                                            },
                                            {
                                                "example_id": "bd236d20-ed31-405d-bd0f-bb57a25f74bc",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Die Finanzmärkte reagierten eher unentschlossen auf die Botschaften vom ‚Superdonnerstag‘ mit EZB-Sitzung und amerikanischen Inflationszahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10988e1e-7c8d-40b1-a509-1f7c3f37cd43",
                        "source_entry_id": "8e6217ac-c77e-3ba1-8687-33c9e84a5982",
                        "source_sense_id": "71e8112f-8c19-3160-860b-f90cf7fa52c2",
                        "source_sense_description": "zonder winnaar of verliezer",
                        "target_lang_word": "unentschieden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unentschieden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "988b5ff0-7240-37bb-bb55-5e7f7abbabf7",
                                        "entry_id": "935178b3-5471-3760-a962-41fd999d38b0",
                                        "glosses": [
                                            "einen Gleichstand, also gleiche Anzahl an Punkten, Treffern, Körben etc. (es gibt keinen Sieger und Verlierer), habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0001ad6f-3368-4fb0-a861-0f78a18ea8a9",
                                                "sense_id": "988b5ff0-7240-37bb-bb55-5e7f7abbabf7",
                                                "text": "Die Partie Deutschland gegen Italien endete unentschieden 1:1."
                                            },
                                            {
                                                "example_id": "a1e62a2d-eb84-482a-81e4-1e170dad5922",
                                                "sense_id": "988b5ff0-7240-37bb-bb55-5e7f7abbabf7",
                                                "text": "Ist der Spielstand eines Spiels, welches zwingend einen Sieger benötigt, am Ende der regulären Spielzeit unentschieden und sehen die Wettbewerbsbestimmungen keine abweichende Regelung vor, so wird das Spiel unmittelbar mit der Verlängerung fortgesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9b7ab7f-2040-3f86-af6c-302184b9b4b0",
                                        "entry_id": "935178b3-5471-3760-a962-41fd999d38b0",
                                        "glosses": [
                                            "sich nicht entscheiden könnend; in der Schwebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5924698d-e254-46a8-80d7-fd3520a2b978",
                                                "sense_id": "b9b7ab7f-2040-3f86-af6c-302184b9b4b0",
                                                "text": "Ich bin noch unentschieden, ob ich den Job annehmen soll oder nicht."
                                            },
                                            {
                                                "example_id": "08009d95-0de8-4a01-995a-f49a466453d4",
                                                "sense_id": "b9b7ab7f-2040-3f86-af6c-302184b9b4b0",
                                                "text": "Am Sonntag wird gewählt, und es gibt viele, die noch unentschieden sind und sich fragen: Soll man das Kreuz auf dem Wahlschein getreu seiner Überzeugung machen – oder strategisch vorgehen?"
                                            },
                                            {
                                                "example_id": "f456aac5-5edc-45e5-a42c-444a2d17f4d5",
                                                "sense_id": "b9b7ab7f-2040-3f86-af6c-302184b9b4b0",
                                                "text": "Benvolio kommt der Intrige auf die Spur, aber der verwöhnte junge Mann ist derartig unentschieden, dass er sich nicht einmal zu veritablem Liebeskummer durchringen kann."
                                            },
                                            {
                                                "example_id": "5163550a-3ff6-4053-9ac9-e58c781542ea",
                                                "sense_id": "b9b7ab7f-2040-3f86-af6c-302184b9b4b0",
                                                "text": "[…] die Frage, ob Autismus eine Krankheit oder ein Charakterzug ist, bleibt vorerst unentschieden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa539e20-8277-4978-839c-477d1fe33399",
                        "source_entry_id": "8e6217ac-c77e-3ba1-8687-33c9e84a5982",
                        "source_sense_id": "4d5b7119-f2fd-3ef5-83e7-d1ce92e664c3",
                        "source_sense_description": "besluiteloos, aarzelend",
                        "target_lang_word": "unentschlossen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unentschlossen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                        "entry_id": "910d435a-119e-33fa-95cf-d3fdb8b1ae1e",
                                        "glosses": [
                                            "unsicher, wie etwas zu beurteilen oder was zu tun ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f029c6-90f5-414b-8b9e-8d847eead76e",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Nur ein knappes Viertel sieht darin kein Problem, der Rest zeigt sich unentschlossen.“"
                                            },
                                            {
                                                "example_id": "8f76c919-426a-4ce2-bf89-451707b39cf4",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Einige Wähler mögen noch unentschlossen sein, und mancher ist so frei, gar nicht zur Wahl zu gehen.“"
                                            },
                                            {
                                                "example_id": "a42def9b-8c63-4126-981c-1a4ebafe9d0a",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Vier von sieben Personen waren unentschlossen (50 %) hinsichtlich der wahrgenommenen Schlaflosigkeit.“"
                                            },
                                            {
                                                "example_id": "963460e9-a495-436c-be39-ccbb526eaf3b",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Gerade wenn sie es mit einem so unentschlossenen Kunden wie Herrn Kunze zu tun hat, kann sich alles immer wieder neu verändern.“"
                                            },
                                            {
                                                "example_id": "b1ea9f0f-0798-4c06-bcc7-123d775948d0",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Wäre ich wirklich so unentschlossen gewesen, wie ich wohl den Eindruck gemacht hatte, dann wäre dieser Kauf nie zustande gekommen.“"
                                            },
                                            {
                                                "example_id": "da4686b0-9c09-4bec-87d6-06d1c03e49cf",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Ein ebenso großer Anteil ist zwar noch unentschlossen, zurück zu weniger Homeoffice will aber kaum ein Unternehmen, heißt es in der am Donnerstag veröffentlichten Studie.“"
                                            },
                                            {
                                                "example_id": "18ff0f17-9704-4220-9d3c-1b38dc78317f",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Die Freien Wähler hingegen sind noch unentschlossen und fordern Antworten auf ‚viele offene Fragen‘.“"
                                            },
                                            {
                                                "example_id": "f9fc1622-7b87-4a29-813a-8ccd5fb4974f",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Allerdings sind viele Franzosen noch unentschlossen, wem sie bei der Präsidentschaftswahl ihre Stimme geben sollen.“"
                                            },
                                            {
                                                "example_id": "4843711f-37d8-4d94-9e3d-7a338d573b7e",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Lediglich fünf Prozent lehnten diese Aussage stark ab, neun Prozent lehnten ab und 18 Prozent antworteten unentschlossen mit ‚teils/teils‘.“"
                                            },
                                            {
                                                "example_id": "cfa207e3-83a0-4f7e-98c8-7002f4eb283c",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Doch der Inhalt ist so lückenhaft und unentschlossen, dass die Anschuldigung kippen könnte.“"
                                            },
                                            {
                                                "example_id": "9ca94bba-2d4c-44df-97f8-05dfeea290a4",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Sollten unsere unentschlossenen Ministerpräsidenten also nicht vielleicht in Washington nachfragen, was genau die dortigen Ärzte Trump verabreicht haben?“"
                                            },
                                            {
                                                "example_id": "45d61aae-cf25-4bc0-8852-62eb189cb643",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Doch sicher sein kann man sich nicht; die Zahl der unentschlossenen Wähler ist groß.“"
                                            },
                                            {
                                                "example_id": "8854d39b-b2fe-4888-9d56-4b3e69804f4a",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Hilfsorganisationen übten scharfe Kritik an der unentschlossenen Haltung der G20-Staaten, die Probleme konkret anzugehen.“"
                                            },
                                            {
                                                "example_id": "bd236d20-ed31-405d-bd0f-bb57a25f74bc",
                                                "sense_id": "c1cfe126-003d-3a64-9d60-712d9ef4828e",
                                                "text": "„Die Finanzmärkte reagierten eher unentschlossen auf die Botschaften vom ‚Superdonnerstag‘ mit EZB-Sitzung und amerikanischen Inflationszahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0aec572-a8d7-482a-acc9-87b914e73fe4",
                        "source_entry_id": "8e6217ac-c77e-3ba1-8687-33c9e84a5982",
                        "source_sense_id": "4d5b7119-f2fd-3ef5-83e7-d1ce92e664c3",
