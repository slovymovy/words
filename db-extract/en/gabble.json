                        ],
                        "form": "gabbling"
                    },
                    {
                        "form_id": "2ec5f548-a808-422b-a143-6bd3da962faf",
                        "entry_id": "3c2b39d7-3714-36c2-915c-112099f36d9e",
                        "tags": [
                            "participle",
