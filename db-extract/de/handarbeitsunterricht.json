                "senses": [
                    {
                        "sense_id": "1ecc2ea5-8659-3a24-a002-a621946d815a",
                        "entry_id": "e7248e13-1179-396f-b690-2529e3b5fcab",
                        "glosses": [
                            "Unterricht(-sfach), in dem man die Herstellung von manuell gefertigten, meist textilen Gegenständen lernt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c5f0b1-e7ac-4941-9193-6a3fe03e0627",
                                "sense_id": "1ecc2ea5-8659-3a24-a002-a621946d815a",
                                "text": "„In der siebten Klasse in der Realschule hatten wir zum ersten Mal Handarbeitsunterricht.“"
                            },
                            {
                                "example_id": "171c7ed3-366d-4c1d-95c4-f73c5152e3a2",
                                "sense_id": "1ecc2ea5-8659-3a24-a002-a621946d815a",
                                "text": "„Hier konnte ich anwenden, was ich bei meiner Mutter und im Handarbeitsunterricht in der Schule gelernt hatte.“"
                            },
                            {
                                "example_id": "c4c9032a-ebba-43f1-8249-2dcbb3e7442b",
                                "sense_id": "1ecc2ea5-8659-3a24-a002-a621946d815a",
                                "text": "„Natürlich spielte ich auch mit Puppen, aber schon in der Schule hasste ich den damals für Mädchen üblichen Handarbeitsunterricht, ich hätte viel lieber einen Werkunterricht besucht, als mich mit Strick- und Häkelnadeln herumzuschlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
