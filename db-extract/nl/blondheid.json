                            {
                                "example_id": "fe5cfcb5-f57e-4c5e-90e7-bbd3afa56fda",
                                "sense_id": "2b77c861-b183-399d-8ea7-b5923b0c6ef1",
                                "text": "Blonde mensen zijn blond dankzij één verandering in de drie miljard ‘letters’ in de erfelijke code. Alleen de haarkleur verandert daardoor, verder niets. Niet de oogkleur en zeker ook niet het verstand. De letter bepaalt niet alle blondheid, maar in Europa wel veel."
                            },
                            {
                                "example_id": "5d37c6ff-c6a9-40a5-909d-15799f7c97bd",
                                "sense_id": "2b77c861-b183-399d-8ea7-b5923b0c6ef1",
                                "text": "En inderdaad, het is die kwetsbaarheid, die doorschijnende blondheid, de indruk dat ze het nooit lang zal redden als ze tegen de wind in moet lopen, die Naomi Watts zo’n ideale actrice maakt voor het thriller- en horrorgenre waarin ze tot nu toe excelleert."
                            },
                            {
                                "example_id": "9cbbd3f2-9000-4ddd-ba93-420d3402d7b1",
                                "sense_id": "2b77c861-b183-399d-8ea7-b5923b0c6ef1",
                                "text": "Maar ik zet door, ik ben hier voor onderzoek naar de stand van de blondheid. Die is zwaar gedevalueerd, zie ik. Blond, dat staat niet meer voor spannend of slim maar voor sloom want dure kapper, dus rijk en verwend."
                            }
                        ]
