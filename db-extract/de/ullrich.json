                ],
                "senses": [
                    {
                        "sense_id": "7d1438a4-6fca-33db-b1d4-2e01cad0cc19",
                        "entry_id": "0876fda7-0506-36db-8f9a-390284b879e2",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b2682e9-4153-404e-890d-215d0bf2b3d6",
                                "sense_id": "7d1438a4-6fca-33db-b1d4-2e01cad0cc19",
                                "text": "Frau Ullrich ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1a7abbfd-c265-48d7-9ccb-30d46b40a1ce",
                                "sense_id": "7d1438a4-6fca-33db-b1d4-2e01cad0cc19",
                                "text": "Herr Ullrich wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7f29c993-5c65-4a9b-86ed-719430e45843",
                                "sense_id": "7d1438a4-6fca-33db-b1d4-2e01cad0cc19",
                                "text": "Die Ullrichs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "15bddba0-52fa-4a62-8097-f6d895ca6511",
                                "sense_id": "7d1438a4-6fca-33db-b1d4-2e01cad0cc19",
                                "text": "Der Ullrich trägt nie die Schals, die die Ullrich ihm strickt."
                            },
                            {
                                "example_id": "325a77d4-a56a-430a-94a7-495fdb836751",
                                "sense_id": "7d1438a4-6fca-33db-b1d4-2e01cad0cc19",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ullrich kommt, geht der Herr Ullrich.“"
                            },
                            {
                                "example_id": "23d13439-c300-4330-ae97-5a344002c978",
                                "sense_id": "7d1438a4-6fca-33db-b1d4-2e01cad0cc19",
                                "text": "Ullrich kommt und geht."
                            },
                            {
                                "example_id": "76c2263e-63e2-4b69-a3e5-5b35c746657f",
                                "sense_id": "7d1438a4-6fca-33db-b1d4-2e01cad0cc19",
                                "text": "Ullrichs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
