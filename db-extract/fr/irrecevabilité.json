                "senses": [
                    {
                        "sense_id": "c17f48cc-acc4-3d83-ada6-d1280e5790d1",
                        "entry_id": "55038c9f-29eb-3824-8ef3-015f2b14824e",
                        "glosses": [
                            "Qualité de ce qui n’est pas recevable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f4b0897-d6dc-400c-8aad-87acc0895943",
                                "sense_id": "c17f48cc-acc4-3d83-ada6-d1280e5790d1",
                                "text": "Élections, irrecevabilité du pouvoir non ratifié."
                            },
                            {
                                "example_id": "ab499955-a6b7-40b1-b66b-ac49f7a70f58",
                                "sense_id": "c17f48cc-acc4-3d83-ada6-d1280e5790d1",
                                "text": "Nouveau pourvoi, irrecevabilité du moyen."
                            },
                            {
                                "example_id": "50d54577-3525-44b3-9888-58cc328a9d16",
                                "sense_id": "c17f48cc-acc4-3d83-ada6-d1280e5790d1",
                                "text": "Située dans le raisonnement du juge administratif à une étape antérieure à celle de l’examen du bien-fondé de la prétention, l’irrecevabilité est régulièrement distinguée par les auteurs de l’incompétence du juge administratif."
                            },
                            {
                                "example_id": "52ebc843-5146-42e5-a50f-fcbd6ab8f446",
                                "sense_id": "c17f48cc-acc4-3d83-ada6-d1280e5790d1",
                                "text": "En défense, l’administration va d’abord chercher à pointer les irrecevabilités éventuelles dont peut être entachée la requête du contribuable."
                            }
                        ]
                    }
                ],
