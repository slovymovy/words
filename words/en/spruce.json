{
    "word_family": [
        "sprucely",
        "spruceness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17e12614-8a9a-3824-aaac-1d0e7147835b",
                    "sense_definition": "Any of various large coniferous evergreen trees from the genus Picea, found in northern temperate and boreal regions.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spruce_tree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest was filled with tall <w>spruce</w> trees that stayed green even in the middle of winter.",
                            "target_lang_translations": {
                                "ru": "Лес был полон высоких <w>елей</w>, которые оставались зелеными даже в середине зимы."
                            }
                        },
                        {
                            "text": "We decided to plant a young <w>spruce</w> in the backyard to provide some privacy from the neighbors.",
                            "target_lang_translations": {
                                "ru": "Мы решили посадить молодую <w>елочку</w> на заднем дворе, чтобы немного отгородиться от соседей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spruce tree",
                        "spruce forest",
                        "blue spruce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое из различных крупных хвойных вечнозеленых деревьев рода Picea, встречающихся в северных умеренных и бореальных регионах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ель",
                                "target_lang_sense_clarification": "хвойное дерево"
                            },
                            {
                                "target_lang_word": "ёлка",
                                "target_lang_sense_clarification": "разговорное название дерева"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da00108c-5269-34f0-8449-c2ee46903be6",
                    "sense_definition": "The light-colored wood obtained from a spruce tree, often used for paper or construction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spruce_tree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The acoustic guitar was crafted with a solid <w>spruce</w> top to produce a bright and clear sound.",
                            "target_lang_translations": {
                                "ru": "Акустическая гитара была изготовлена с верхней декой из цельной <w>ели</w> для получения яркого и чистого звука."
                            }
                        },
                        {
                            "text": "They used high-quality <w>spruce</w> for the structural beams of the new log cabin.",
                            "target_lang_translations": {
                                "ru": "Они использовали высококачественную <w>ель</w> для несущих балок нового сруба."
                            }
                        }
                    ],
                    "common_phrases": [
                        "solid spruce",
                        "spruce timber"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светлая древесина, получаемая из ели, часто используемая для производства бумаги или в строительстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ель",
                                "target_lang_sense_clarification": "древесина"
                            },
                            {
                                "target_lang_word": "еловый",
                                "target_lang_sense_clarification": "сделанный из ели"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe8f108f-2ea4-3d66-93df-a77c439230a1",
                    "sense_definition": "To make something or someone look neater, cleaner, or more attractive.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tidy_up",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>spruce</w> up the living room before the guests arrive for the party.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>привести в порядок</w> гостиную до прихода гостей на вечеринку."
                            }
                        },
                        {
                            "text": "He decided to <w>spruce</w> himself up by wearing his best suit for the job interview.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>прихорошиться</w>, надев свой лучший костюм на собеседование."
                            }
                        }
                    ],
                    "synonyms": [
                        "neaten",
                        "prettify",
                        "titivate"
                    ],
                    "common_phrases": [
                        "spruce up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести что-либо или кого-либо в более аккуратный, чистый или привлекательный вид."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приводить в порядок",
                                "target_lang_sense_clarification": "делать аккуратнее"
                            },
                            {
                                "target_lang_word": "прихорашиваться",
                                "target_lang_sense_clarification": "о внешности человека"
                            },
                            {
                                "target_lang_word": "приукрашивать",
                                "target_lang_sense_clarification": "улучшать вид"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "281c6f22-a44c-3348-908f-5dfb6fe9a231",
                    "sense_definition": "Neat, clean, and stylish in appearance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>spruce</w> young lieutenant looked very professional in his perfectly pressed black uniform.",
                            "target_lang_translations": {
                                "ru": "<w>Щеголеватый</w> молодой лейтенант выглядел очень профессионально в своей идеально выглаженной черной форме."
                            }
                        },
                        {
                            "text": "He always kept a <w>spruce</w> appearance, even when he was just working in his small garden.",
                            "target_lang_translations": {
                                "ru": "Он всегда сохранял <w>опрятный</w> вид, даже когда просто работал в своем маленьком саду."
                            }
                        }
                    ],
                    "antonyms": [
                        "scruffy",
                        "untidy"
                    ],
                    "common_phrases": [
                        "spruce appearance",
                        "look spruce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аккуратный, чистый и стильный на вид."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нарядный",
                                "target_lang_sense_clarification": "красиво одетый"
                            },
                            {
                                "target_lang_word": "щеголеватый",
                                "target_lang_sense_clarification": "щегольской"
                            },
                            {
                                "target_lang_word": "элегантный",
                                "target_lang_sense_clarification": "изысканный"
                            },
                            {
                                "target_lang_word": "опрятный",
                                "target_lang_sense_clarification": "чистый и аккуратный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3f99db32-ab3e-3bc7-85bc-33fcc0236085",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Spruce</w> has lived in this neighborhood for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Спрус</w> живет в этом районе уже более сорока лет."
                            }
                        },
                        {
                            "text": "The local library was named after the philanthropist Sarah <w>Spruce</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа Сары <w>Спрус</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Спрус",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64833609-1636-3861-bc34-b56c88a9e369",
                    "sense_definition": "The name of several places in the United States, such as a community in Michigan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through <w>Spruce</w>, Michigan, on their way to the northern lakes.",
                            "target_lang_translations": {
                                "ru": "Они проезжали через <w>Спрус</w>, штат Мичиган, по пути к северным озерам."
                            }
                        },
                        {
                            "text": "The small town of <w>Spruce</w> is known for its quiet atmosphere and friendly residents.",
                            "target_lang_translations": {
                                "ru": "Маленький городок <w>Спрус</w> известен своей спокойной атмосферой и дружелюбными жителями."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название нескольких мест в США, например, общины в штате Мичиган."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Спрус",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}