                        "examples": [
                            {
                                "example_id": "2e88a503-93be-4654-85db-ef28cb966b39",
                                "sense_id": "4db807ee-46d2-3a4b-8c83-28f8ef51ab07",
                                "text": "Glatte Wände sehen alles und verzeihen nichts. So hat sich eine weitere Entwicklung aufgetan, die den Tod der Raufaser kompensieren soll."
                            },
                            {
                                "example_id": "6e14c459-9d66-449d-8068-4c2d4a504400",
                                "sense_id": "4db807ee-46d2-3a4b-8c83-28f8ef51ab07",
                                "text": "Ich erschlage das Biest mit einem Rupi-Kaur-Gedichtband, Blut auf Raufaser, meins, ihrs. Der Mensch ist schlecht, die Welt geht unter. Und schuld ist allein die Mücke."
                            }
                        ]
                    }
