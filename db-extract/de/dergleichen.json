                                "sense_id": "2478c808-72de-32c5-8a4b-ab37939d5864",
                                "text": "Mörder, Totschläger und dergleichen",
                                "translation": "murderers, manslaughterers and suchlike",
                                "english": "murderers, manslaughterers and suchlike"
                            }
                        ]
