                        "glosses": [
                            "Ellipsis of Shiba Inu."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "b4335dd6-9fcd-4bbe-92a6-27ce14419b6f",
                                "sense_id": "35df4e66-0958-347f-b9d3-593f484eec0a",
                                "text": "“There’s nothing wrong with your dog,” she said. “Then why was he wailing like that? I’ve never heard an animal make such a god-awful noise.” “It’s just something that shibas do,” Dr. Cho replied. “Get used to it. He was probably happy to see you. Had you been away for a while?”"
                            },
                            {
                                "example_id": "0f61ae8a-c4cc-4dc6-b409-44d0f1b80dbe",
                                "sense_id": "35df4e66-0958-347f-b9d3-593f484eec0a",
                                "text": "Niimi and coworkers (1999) have found that golden retrievers and shibas predictably differ in terms of their expression of short allele and shibas expressing the long D₄ allele more often (see Neural and Physiological Substrates in Volume 2, Chapter 5)."
                            },
                            {
                                "example_id": "184e44d5-ee59-4974-b679-368a92e6d6e5",
                                "sense_id": "35df4e66-0958-347f-b9d3-593f484eec0a",
                                "text": "Some shibas have red fur."
                            }
                        ]
                    }
                ],
