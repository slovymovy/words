                    "frequency": "Middle",
                    "semantic_group_id": "agriculture_sol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers agricoles ont dû <w>drainer</w> un terrain inondé avant de commencer les travaux de construction."
                        },
                        {
                            "text": "Il est indispensable de <w>drainer</w> le sol après ces fortes pluies pour protéger les plantations."
                        }
                    ],
