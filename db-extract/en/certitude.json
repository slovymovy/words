                                        "entry_id": "23c13184-120d-36d7-a919-b28a6bcbd100",
                                        "glosses": [
                                            "το να είναι κανείς βέβαιος για κάτι, να μην έχει αμφιβολίες"
                                        ],
                                        "tags": [],
