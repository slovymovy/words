                    },
                    {
                        "sense_id": "204092f2-387a-334a-9280-b10a2604e7f1",
                        "entry_id": "843264d3-1229-3ea4-a95e-a7f4d2a6b751",
                        "glosses": [
                            "militärische Auseinandersetzung am Persischen Golf",
                            "in den Jahren 1990/91, zwischen dem Irak einerseits und Kuwait, den USA und weiteren Verbündeten andererseits"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcef2f77-d450-46c4-9955-927309389dd4",
                                "sense_id": "204092f2-387a-334a-9280-b10a2604e7f1",
                                "text": "„Nach dem zweiten Golfkrieg verpflichtete 1991 die UN-Resolution 687 den Irak seine Massenvernichtungswaffen zu zerstören.“"
                            },
                            {
                                "example_id": "18b1fede-23e4-4a58-b3df-7157a62760b2",
                                "sense_id": "204092f2-387a-334a-9280-b10a2604e7f1",
                                "text": "„Offiziell unterstützte Pakistan während des Golfkriegs die kuwaitische Seite.“"
                            }
                        ],
