                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "attack_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The man was arrested after he tried to <w>assault</w> a police officer during the protest.",
                            "target_lang_translations": {
                                "ru": "Мужчина был арестован после того, как попытался <w>напасть</w> на полицейского во время протеста.",
                                "zh": "那名男子在抗议期间试图<w>袭击</w>一名警官后被捕。",
                                "tr": "Adam, protesto sırasında bir polis memuruna <w>saldırmaya</w> çalıştıktan sonra tutuklandı.",
                                "de": "Der Mann wurde festgenommen, nachdem er während des Protests versucht hatte, einen Polizisten <w>tätlich anzugreifen</w>."
                            }
                        },
                        {
                            "text": "The smell of smoke began to <w>assault</w> the senses as they got closer to the fire.",
                            "target_lang_translations": {
                                "ru": "Запах дыма начал <w>атаковать</w> органы чувств, когда они приблизились к огню.",
                                "zh": "当他们靠近火源时，烟味开始<w>冲击</w>着他们的感官。",
                                "tr": "Yangına yaklaştıkça duman kokusu duyuları <w>zorlamaya</w> başladı.",
                                "de": "Der Brandgeruch begann die Sinne zu <w>überwältigen</w>, als sie dem Feuer näher kamen."
                            }
                        }
                    ],
                    "synonyms": [
                        "attack",
                        "strike"
                    ],
                    "antonyms": [
                        "defend"
                    ],
                    "common_phrases": [
                        "assault the senses",
                        "physically assault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически нападать на кого-либо или что-либо с большой силой",
                        "zh": "指以暴力或强力对某人或某物进行身体攻击",
                        "tr": "Birine veya bir şeye fiziksel olarak ya da büyük bir güçle saldırmak",
                        "de": "Jemanden oder etwas körperlich oder mit großer Wucht angreifen"
