{
    "word_family": [
        "moated"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb707f09-71a7-3f73-b707-38f2ed0eb197",
                    "sense_definition": "A deep, wide defensive ditch, normally filled with water, surrounding a fortified habitation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fortification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The castle was protected by a deep <w>moat</w> filled with dark water.",
                            "target_lang_translations": {
                                "ru": "Замок был защищен глубоким <w>рвом</w>, наполненным темной водой."
                            }
                        },
                        {
                            "text": "The soldiers lowered the drawbridge to cross the <w>moat</w> and enter the fortress.",
                            "target_lang_translations": {
                                "ru": "Солдаты опустили подъемный мост, чтобы пересечь <w>ров</w> и войти в крепость."
                            }
                        }
                    ],
                    "synonyms": [
                        "fosse"
                    ],
                    "common_phrases": [
                        "castle moat",
                        "deep moat",
                        "water-filled moat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокий и широкий оборонительный ров, обычно заполненный водой, окружающий укрепленное поселение или замок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ров",
                                "target_lang_sense_clarification": "оборонительная канава вокруг замка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd468ec3-285c-344d-b2a0-569b4260a507",
                    "sense_definition": "An aspect of a business which makes it more defensible from competitors, such as a strong brand or unique technology.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "business strategy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company has a wide <w>moat</w> because of its unique patents and loyal customer base.",
                            "target_lang_translations": {
                                "ru": "У компании широкий <w>экономический ров</w> благодаря уникальным патентам и лояльной клиентской базе."
                            }
                        },
                        {
                            "text": "Investors look for businesses with a sustainable <w>moat</w> to ensure long-term profitability.",
                            "target_lang_translations": {
                                "ru": "Инвесторы ищут предприятия с устойчивым <w>конкурентным преимуществом</w>, чтобы обеспечить долгосрочную прибыльность."
                            }
                        }
                    ],
                    "common_phrases": [
                        "economic moat",
                        "sustainable moat",
                        "wide moat"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in business and finance contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкурентное преимущество бизнеса, которое делает его более защищенным от конкурентов (например, сильный бренд или уникальная технология)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экономический ров",
                                "target_lang_sense_clarification": "конкурентное преимущество компании"
                            },
                            {
                                "target_lang_word": "защитный барьер",
                                "target_lang_sense_clarification": "в бизнесе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9215374-f03a-3a70-95f4-851663427c1d",
                    "sense_definition": "A circular lowland between a resurgent dome and the walls of the caldera surrounding it.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The volcanic <w>moat</w> was filled with ash and debris after the last eruption.",
                            "target_lang_translations": {
                                "ru": "Вулканический <w>ров</w> был заполнен пеплом и обломками после последнего извержения."
                            }
                        },
                        {
                            "text": "Geologists studied the sediment layers found within the caldera <w>moat</w>.",
                            "target_lang_translations": {
                                "ru": "Геологи изучали слои отложений, найденные внутри <w>рва</w> кальдеры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "caldera moat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кольцевая низменность между возрождающимся куполом и стенками окружающей его кальдеры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ров",
                                "target_lang_sense_clarification": "в геологии, внутри кальдеры"
                            },
                            {
                                "target_lang_word": "кольцевой ров",
                                "target_lang_sense_clarification": "геологическая структура"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b859cdf-463c-3706-bda6-ca522bd7dd6b",
                    "sense_definition": "A clear ring outside the eyewall of a tropical cyclone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "meteorology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The satellite imagery showed a distinct <w>moat</w> between the primary and secondary eyewalls.",
                            "target_lang_translations": {
                                "ru": "Спутниковые снимки показали отчетливую <w>безветренную зону</w> между основной и вторичной стенами глаза."
                            }
                        },
                        {
                            "text": "A <w>moat</w> often forms during an eyewall replacement cycle in intense hurricanes.",
                            "target_lang_translations": {
                                "ru": "<w>Зона затишья</w> часто образуется во время цикла замены стены глаза в интенсивных ураганах."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чистое кольцо за пределами стены глаза тропического циклона."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ров",
                                "target_lang_sense_clarification": "в метеорологии, зона в циклоне"
                            },
                            {
                                "target_lang_word": "безветренная зона",
                                "target_lang_sense_clarification": "между стенами глаза урагана"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4d1be18-90dd-34cd-8ebc-ebfe06975bff",
                    "sense_definition": "A hill or mound.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "topography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient ruins were situated atop a small <w>moat</w> overlooking the valley.",
                            "target_lang_translations": {
                                "ru": "Древние руины были расположены на вершине небольшого <w>холма</w> с видом на долину."
                            }
                        },
                        {
                            "text": "They climbed the grassy <w>moat</w> to get a better view of the surrounding countryside.",
                            "target_lang_translations": {
                                "ru": "Они взобрались на травянистую <w>насыпь</w>, чтобы лучше рассмотреть окрестности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Холм или насыпь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "холм",
                                "target_lang_sense_clarification": "диалектное значение"
                            },
                            {
                                "target_lang_word": "насыпь",
                                "target_lang_sense_clarification": "возвышенность"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "deb0fb03-e205-34ef-871d-b085a3479c82",
                    "sense_definition": "To surround a place with a moat for defense.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king decided to <w>moat</w> the manor to protect it from invaders.",
                            "target_lang_translations": {
                                "ru": "Король решил <w>обнести рвом</w> поместье, чтобы защитить его от захватчиков."
                            }
                        },
                        {
                            "text": "The engineers worked for months to <w>moat</w> the entire perimeter of the city.",
                            "target_lang_translations": {
                                "ru": "Инженеры работали месяцами, чтобы <w>окружить рвом</w> весь периметр города."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окружать место рвом для защиты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружать рвом",
                                "target_lang_sense_clarification": "для обороны"
                            },
                            {
                                "target_lang_word": "обносить рвом",
                                "target_lang_sense_clarification": "создавать защитную канаву"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a7fec955-1124-3e0e-ae01-6b72247f6b85",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after the philanthropist Thomas <w>Moat</w>.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь филантропа Томаса <w>Моута</w>."
                            }
                        },
                        {
                            "text": "Mr. <w>Moat</w> has lived in this village for over forty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Моут</w> живет в этой деревне уже более сорока лет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Моут",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}