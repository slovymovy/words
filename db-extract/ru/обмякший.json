                "senses": [
                    {
                        "sense_id": "915e8a20-8e87-3f6e-a295-ae4a6c347f4c",
                        "entry_id": "0278abc4-c49e-38da-9ce6-a76f9f5cf7f0",
                        "glosses": [
                            "действ. прич. прош. вр. от обмякнуть"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "0441b131-4731-4c28-964f-c9aa15e0ce2a",
                                "sense_id": "915e8a20-8e87-3f6e-a295-ae4a6c347f4c",
                                "text": "После всплеска эмоций тот сидел обмякший, расслабленный, выражение лица у него было недовольно-брюзгливым."
                            },
                            {
                                "example_id": "3e018859-1950-4f7f-be8a-cf6bc69cdacd",
                                "sense_id": "915e8a20-8e87-3f6e-a295-ae4a6c347f4c",
                                "text": "Можно было принять за горбунью — потом лишь разглядел, что за плечами не горб, а обмякший, будто котомка, туристский рюкзак."
                            }
                        ]
                    }
