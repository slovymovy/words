                "senses": [
                    {
                        "sense_id": "9add284d-083a-3ab8-8419-eb459f2f7de7",
                        "entry_id": "fc21be23-1c12-36b1-9a50-287a6db8dc8a",
                        "glosses": [
                            "abgegrenzter Bereich in einer Stadt, in dem Prostitution und andere Arten des Sexgewerbes präsent sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64022d0e-e5c0-4392-bca4-e7059b5ec154",
                                "sense_id": "9add284d-083a-3ab8-8419-eb459f2f7de7",
                                "text": "Die Reeperbahn in Hamburg ist ein weltbekanntes Rotlichtviertel."
                            },
                            {
                                "example_id": "66a69a6c-dc71-4376-9182-5def121dca83",
                                "sense_id": "9add284d-083a-3ab8-8419-eb459f2f7de7",
                                "text": "„Das Rotlichtviertel, die Wallen, fällt nämlich sicher nicht unter das Prinzip ›Doe maar gewoon‹, sei normal.“"
                            },
                            {
                                "example_id": "0926bddd-d498-46d8-aa8c-f63e550775e9",
                                "sense_id": "9add284d-083a-3ab8-8419-eb459f2f7de7",
                                "text": "„Sadie leitet einen erneuten Umzug in die Wege, diesmal ins Rotlichtviertel von Fell's Point.“"
                            },
                            {
                                "example_id": "345412fa-754f-4b60-a91c-e454915211d1",
                                "sense_id": "9add284d-083a-3ab8-8419-eb459f2f7de7",
                                "text": "„Wie jede Messestadt hat auch Frankfurt in der Nähe des Hauptbahnhofs ein großes und höchst lebendiges Rotlichtviertel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
