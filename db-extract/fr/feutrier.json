                        "sense_id": "e3b1ba20-f66c-395f-9635-1ea7b89dcd7f",
                        "entry_id": "8a3dd30e-46f5-3e89-b5aa-2a4d12ea55fa",
                        "glosses": [
                            "Personne qui fait, qui prépare le feutre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "559038e2-a741-462c-a604-4a5d66557458",
                                "sense_id": "e3b1ba20-f66c-395f-9635-1ea7b89dcd7f",
                                "text": "« Il faut exactement 0,25 gramme au centimètre cube pour chaque touche », précise l’artisan d’art, qui fabrique lui-même les petits cubes de poils, mélange de lapin et de lièvre fourni par son feutrier breton, quand le lavage n’a pas permis de sauver les originaux."
                            },
                            {
                                "example_id": "38262d61-99c6-4f0f-9fb2-6511356cbac4",
                                "sense_id": "e3b1ba20-f66c-395f-9635-1ea7b89dcd7f",
                                "text": "Ce fût le cas de Jalade, devenu feutrer en chef de la cour, tenu pour un honnête homme, mais qui n’était qu’un faussaire ayant fréquenté au moins à quatre reprises les geôles du royaume."
                            },
                            {
                                "example_id": "de3fad58-e655-4a95-8661-e4af3bbe68e0",
                                "sense_id": "e3b1ba20-f66c-395f-9635-1ea7b89dcd7f",
                                "text": "Accord en Parlement entre le duc de Bourbon, chambrier de France, et plusieurs chapeliers et feutriers de Paris au sujet de housses confisquées par les sergents et officiers du duc."
                            }
                        ]
                    }
