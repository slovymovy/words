                "senses": [
                    {
                        "sense_id": "93825554-34ac-3d49-9b5b-8768a8478da3",
                        "entry_id": "5019f1ca-3956-3029-8281-355ddf31ad25",
                        "glosses": [
                            "een stem die een kiezer uitbrengt uit onvrede met de huidige machthebbers en niet zo zeer omdat hij het beleid van de gekozene ondersteunt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62563d56-4a85-4800-a436-2e61aa239c4b",
                                "sense_id": "93825554-34ac-3d49-9b5b-8768a8478da3",
                                "text": "Vooral in kleine dorpen op het platteland zijn mensen ontevreden. In de Auvergne, in het centrum van Frankrijk, werd vroeger op traditionele partijen gestemd. Maar dat is veranderd. Nu brengen de meeste kiezers er een proteststem uit."
                            },
                            {
                                "example_id": "920dd2fb-883d-4529-a99e-f38db53cfa62",
                                "sense_id": "93825554-34ac-3d49-9b5b-8768a8478da3",
                                "text": "In tegenstelling tot bij voorgaande verkiezingen werden de Zweden-Democraten een realistische optie. Een stem op de partij was niet langer per definitie een proteststem, maar zou weleens tot ander beleid kunnen leiden."
                            }
                        ]
                    }
