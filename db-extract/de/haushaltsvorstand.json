                "senses": [
                    {
                        "sense_id": "b4d2b6c6-105e-39ec-8b96-d7c28e874638",
                        "entry_id": "1af8b402-59a3-3e0f-8e78-e0544900c6a4",
                        "glosses": [
                            "diejenige Person in einer zusammenlebenden Gruppe mit gemeinsamem Wirtschaften, die zum Großteil der Einkünfte beiträgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42ddde74-fa82-4174-9ec4-8ef9aabc2296",
                                "sense_id": "b4d2b6c6-105e-39ec-8b96-d7c28e874638",
                                "text": "„Als Halter aller in einem Haushalt oder in einem Betrieb gehaltenen Hunde gilt der Haushaltsvorstand oder Betriebsinhaber.“"
                            },
                            {
                                "example_id": "107fbd3c-3953-4642-a6c7-6054e076d2a0",
                                "sense_id": "b4d2b6c6-105e-39ec-8b96-d7c28e874638",
                                "text": "„Zu den Familienmitgliedern zählen v.a. der Haushaltsvorstand, der Ehegatte, die Kinder und ggf. weitere Angehörige.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
