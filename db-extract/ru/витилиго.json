                                        "entry_id": "a7bf098e-3ac5-3924-8f82-ba84db6ece98",
                                        "glosses": [
                                            "The patchy loss of skin pigmentation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dec10710-30e5-4fc7-bba5-2704da0cd618",
                                                "sense_id": "7c5f8d12-4e00-3211-a9a4-32d8b4e583b6",
                                                "text": "In the weeks that followed, I began to notice other people with vitiligo. On the streets, in the stores, in their cars. My God, they were everywhere!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5f30c62-122a-3aac-93b6-1380d2954c21",
