                "senses": [
                    {
                        "sense_id": "922b8241-7c8a-3b8d-a61e-fb083d35851a",
                        "entry_id": "27f06240-0464-3698-8a81-0833f07a271b",
                        "glosses": [
                            "Sportler, der sich auf Kurzstrecken spezialisiert hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c0564a3-471c-4144-a5dd-0b4d870460dc",
                                "sense_id": "922b8241-7c8a-3b8d-a61e-fb083d35851a",
                                "text": "Mein Freund ist ein großartiger Kurzstreckenläufer."
                            },
                            {
                                "example_id": "5909bff2-0694-4d38-8ee0-86dd3cd179b9",
                                "sense_id": "922b8241-7c8a-3b8d-a61e-fb083d35851a",
                                "text": "„Und dann nimmt er einen Anlauf, der Hauptmann Albisbrunner, und rennt wie ein Kurzstreckenläufer zwischen den beiden Reihen durch.“"
                            },
                            {
                                "example_id": "d8921c0b-9c02-4534-bfc8-47d89ea6f94f",
                                "sense_id": "922b8241-7c8a-3b8d-a61e-fb083d35851a",
                                "text": "„Derice Bannock ist einer der besten Kurzstreckenläufer Jamaikas und träumt von nichts mehr, als sich für die Olympischen Spiele in Seoul zu qualifizieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
