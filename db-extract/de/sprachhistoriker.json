                "senses": [
                    {
                        "sense_id": "82d19c62-7c68-3194-9278-96ba5d0ce35c",
                        "entry_id": "9342202c-5324-3cb6-be9b-068e6d2bfb85",
                        "glosses": [
                            "Wissenschaftler, der sich mit der Erforschung und Darstellung der Geschichte von Sprache/Sprachen beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93c80a9-eab9-4488-9ee4-4cf394485bef",
                                "sense_id": "82d19c62-7c68-3194-9278-96ba5d0ce35c",
                                "text": "„Wir sind gespannt, was Sprachhistoriker in 100 Jahren über diesen hochmoralischen Abschnitt deutscher Sprachgeschichte schreiben werden.“"
                            },
                            {
                                "example_id": "a8203159-63e8-4a61-9e13-3cd375d56a85",
                                "sense_id": "82d19c62-7c68-3194-9278-96ba5d0ce35c",
                                "text": "„Das ist sicherlich für Sprachhistoriker und Grammatiker gleichermaßen fruchtbar.“"
                            },
                            {
                                "example_id": "f2ec2b53-b515-4434-9ecf-5d9283daa592",
                                "sense_id": "82d19c62-7c68-3194-9278-96ba5d0ce35c",
                                "text": "„Zwei Ursprungsmythen kennen die Sprachhistoriker: Einerseits schreibt man das Wort einem äußerst geschwätzigen Bader aus Jena zu.“"
                            },
                            {
                                "example_id": "231c8b9b-6a6c-4122-ac81-f6a0d158e54b",
                                "sense_id": "82d19c62-7c68-3194-9278-96ba5d0ce35c",
                                "text": "„Wir haben uns deswegen nach Rücksprache mit Sprachhistorikern entschieden, den Cahnschen Text buchstabengetreu in lateinische Buchstaben zu übertragen und keine moderne hochdeutsche Übersetzung vorzulegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
