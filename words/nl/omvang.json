{
    "word_family": [
        "omvangen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56acb919-84d2-33de-bb89-7f6af829d0f8",
                    "sense_definition": "De grootte of de mate waarin iets zich uitstrekt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grootte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>omvang</w> van de schade na de storm was veel groter dan verwacht.",
                            "target_lang_translations": {
                                "en": "The <w>extent</w> of the damage after the storm was much greater than expected."
                            }
                        },
                        {
                            "text": "Ondanks de beperkte <w>omvang</w> van het onderzoek hebben we al interessante resultaten geboekt.",
                            "target_lang_translations": {
                                "en": "Despite the limited <w>scale</w> of the study, we have already achieved interesting results."
                            }
                        }
                    ],
                    "synonyms": [
                        "grootte"
                    ],
                    "common_phrases": [
                        "beperkte omvang",
                        "enorme omvang",
                        "omvang van de schade"
                    ],
                    "target_lang_definitions": {
                        "en": "The size, scale, or extent to which something stretches or exists."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "extent",
                                "target_lang_sense_clarification": "the degree or scale of something"
                            },
                            {
                                "target_lang_word": "size",
                                "target_lang_sense_clarification": "the physical dimensions or magnitude"
                            },
                            {
                                "target_lang_word": "scale",
                                "target_lang_sense_clarification": "the relative size or extent of something"
                            },
                            {
                                "target_lang_word": "scope",
                                "target_lang_sense_clarification": "the range or extent of an area or subject"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49ca55d8-a72f-3c0d-86e7-b3700b8e4efc",
                    "sense_definition": "De afstand rondom een voorwerp of figuur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afmeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boom heeft een <w>omvang</w> van meer dan drie meter.",
                            "target_lang_translations": {
                                "en": "The tree has a <w>circumference</w> of more than three meters."
                            }
                        },
                        {
                            "text": "Je kunt de <w>omvang</w> meten door een lint om de stam te leggen.",
                            "target_lang_translations": {
                                "en": "You can measure the <w>girth</w> by placing a tape around the trunk."
                            }
                        }
                    ],
                    "common_phrases": [
                        "omvang meten"
                    ],
                    "target_lang_definitions": {
                        "en": "The distance around an object or figure."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "circumference",
                                "target_lang_sense_clarification": "the distance around something circular"
                            },
                            {
                                "target_lang_word": "girth",
                                "target_lang_sense_clarification": "the measurement around the middle of something, like a tree or person"
                            },
                            {
                                "target_lang_word": "perimeter",
                                "target_lang_sense_clarification": "the continuous line forming the boundary of a closed geometric figure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c74896b7-3424-3c97-a533-d464da34cd10",
                    "sense_definition": "Het bereik van tonen dat een stem of instrument kan voortbrengen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "muziek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze zangeres heeft een indrukwekkende <w>omvang</w> van drie octaven.",
                            "target_lang_translations": {
                                "en": "This singer has an impressive <w>range</w> of three octaves."
                            }
                        },
                        {
                            "text": "De vocalen <w>omvang</w> van het koor is zeer breed.",
                            "target_lang_translations": {
                                "en": "The vocal <w>range</w> of the choir is very wide."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vocalen omvang"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The range of tones that a voice or instrument can produce."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "range",
                                "target_lang_sense_clarification": "the distance between the lowest and highest notes"
                            },
                            {
                                "target_lang_word": "compass",
                                "target_lang_sense_clarification": "the full range or scope of a voice or instrument"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6ab1d643-9d52-3fc0-9daf-bb82b53cf36a",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>omvangen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>omvang</w> het probleem in zijn geheel.",
                            "target_lang_translations": {
                                "en": "I <w>encompass</w> the problem in its entirety."
                            }
                        },
                        {
                            "text": "Wanneer ik de situatie <w>omvang</w>, zie ik pas de risico's.",
                            "target_lang_translations": {
                                "en": "Only when I <w>grasp</w> the situation do I see the risks."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'omvangen' (to encompass or embrace)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "encompass",
                                "target_lang_sense_clarification": "to surround and have or hold within"
                            },
                            {
                                "target_lang_word": "embrace",
                                "target_lang_sense_clarification": "to include or contain as a constituent part"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}