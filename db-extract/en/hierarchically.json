                        "entry_id": "05b61616-1dca-3b5e-9ca8-517c4235f6f0",
                        "glosses": [
                            "Of, relating to, or arranged in a hierarchy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d6011c-8652-48fe-a78e-a78e1c774730",
                                "sense_id": "f51f87a0-add0-361e-aafc-769989d04125",
                                "text": "Unlike, say, botany or zoology, or even in a thesaural structure of a knowledge database, where the syntactical and semantic relationships between concepts is often highly ordered (e.g. hierarchically, cohyponymically), the central concepts and meanings in the field of management are more consensually negotiated."
                            }
                        ]
                    },
                    {
                        "sense_id": "815bc309-19a6-32e8-b842-c87be0853172",
                        "entry_id": "05b61616-1dca-3b5e-9ca8-517c4235f6f0",
                        "glosses": [
                            "Pertaining to a transitive relation between objects by which they may be ordered into a hierarchy."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69e396f9-88d5-4963-ae01-8bf294936715",
                        "source_entry_id": "05b61616-1dca-3b5e-9ca8-517c4235f6f0",
                        "source_sense_description": "of or relating to a hierarchy",
                        "target_lang_word": "hiérarchiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hiérarchiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7480cfe0-657d-310e-bac5-5137d51f5e4f",
                                        "entry_id": "fc1099bb-69bb-381c-a027-d190fff45f85",
                                        "glosses": [
                                            "D’une manière hiérarchique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a8f3fc-28ce-4321-8ae4-6e1c6c179b5c",
                                                "sense_id": "7480cfe0-657d-310e-bac5-5137d51f5e4f",
                                                "text": "Pendant l'absence du lieutenant Hobson et du sergent Long, le commandement du fort revenait hiérarchiquement au caporal Joliffe, […]."
                                            },
                                            {
                                                "example_id": "e9d60bae-182c-41b4-81c9-d59f65a486be",
                                                "sense_id": "7480cfe0-657d-310e-bac5-5137d51f5e4f",
                                                "text": "Une bureaucratie manie beaucoup de petits papiers, éventuellement des armes. Elle est surtout un groupe d'hommes hiérarchiquement organisés. C'est à l'équilibre psychique des hommes qui composent cette machine centrale qu'on doit s'intéresser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0f956b2-b0e5-48d9-a0c5-79b4d073fe2f",
                        "source_entry_id": "05b61616-1dca-3b5e-9ca8-517c4235f6f0",
                        "source_sense_description": "of or relating to a hierarchy",
                        "target_lang_word": "hierarchisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hierarchisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3163466-fd6b-31da-ab98-b753bfda7c75",
                                        "entry_id": "37f67527-3dbf-3b32-a51c-04c82c1463c3",
                                        "glosses": [
                                            "der Hierarchie entsprechend; die Hierarchie betreffend, zu ihr gehörig, auf ihr beruhend; streng gegliedert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c986edec-afa4-48dc-9f44-b8db6f2cdc8c",
                                                "sense_id": "e3163466-fd6b-31da-ab98-b753bfda7c75",
                                                "text": "Die katholische Kirche ist hierarchisch strukturiert; unter „Hierarchie“ versteht man dabei die feste Struktur, gemäß der die Kirche durch geweihte Amtsträger geführt wird."
                                            },
                                            {
                                                "example_id": "aafbe2e0-1681-4442-a14b-6596aa4d359e",
                                                "sense_id": "e3163466-fd6b-31da-ab98-b753bfda7c75",
                                                "text": "Obwohl sie streng hierarchisch organisiert sind, leben die Jesuiten nicht in Klöstern, sondern in offenen Häusern und Kollegien."
                                            },
                                            {
                                                "example_id": "61cd3126-a443-46e7-9d17-3db6c7c966fc",
                                                "sense_id": "e3163466-fd6b-31da-ab98-b753bfda7c75",
                                                "text": "Aber patriarchalische Gesellschaften sind hierarchisch geformte Gesellschaften, die ständig Gewaltopfer produzieren, männliche wie weibliche."
                                            },
                                            {
                                                "example_id": "8edada1b-baba-41ba-aa88-19bf2782f951",
                                                "sense_id": "e3163466-fd6b-31da-ab98-b753bfda7c75",
                                                "text": "Sie habe die Machtverhältnisse als Kausalbeziehungen gedacht und diese wiederum hierarchisch, in der Form einer Pyramide von oben nach unten angeordnet."
                                            },
                                            {
                                                "example_id": "19ffcb56-bc5c-4ae5-ba07-80d654abc34b",
                                                "sense_id": "e3163466-fd6b-31da-ab98-b753bfda7c75",
                                                "text": "Die Aufbauorganisation bildet das – meistens hierarchische – Gerüst einer Organisation (z. B. einer Behörde oder eines Unternehmens)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
