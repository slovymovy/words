                "senses": [
                    {
                        "sense_id": "4b6085f6-d6d3-3b5f-acd7-26987de1f9b8",
                        "entry_id": "165a2fcc-a252-385f-86a8-0ccb6f0dc468",
                        "glosses": [
                            "glazen bak met water waarin onderwaterflora en -fauna gehouden wordt met de bedoeling vissen, lagere dieren en/of planten te verzorgen, te tonen en/of te kweken."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4c51f40-8b32-403c-884f-132f7a652996",
                                "sense_id": "4b6085f6-d6d3-3b5f-acd7-26987de1f9b8",
                                "text": "Neem gerust een kijkje naar mijn aquarium vol goudvissen."
                            },
                            {
                                "example_id": "66998d55-cc0f-4dff-b581-1be1ae323dc0",
                                "sense_id": "4b6085f6-d6d3-3b5f-acd7-26987de1f9b8",
                                "text": "Artis is beroemd om zijn aquariums."
                            },
                            {
                                "example_id": "7d006997-a9ee-4e5c-add2-8d5f6779c705",
                                "sense_id": "4b6085f6-d6d3-3b5f-acd7-26987de1f9b8",
                                "text": "Hij beweegt zich door het appartement als een vis in een aquarium waar te weinig zuurstof in zit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7507f326-6f4a-4b55-a959-3f3627a925fe",
                        "source_entry_id": "165a2fcc-a252-385f-86a8-0ccb6f0dc468",
                        "source_sense_id": "4b6085f6-d6d3-3b5f-acd7-26987de1f9b8",
                        "source_sense_description": "een bak met water waarin onderwaterflora en -fauna gehouden wordt.",
                        "target_lang_word": "Aquarium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aquarium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5273ea82-4943-31d8-925b-f3f0c7855483",
                                        "entry_id": "0b8e7723-d0be-337a-a2a8-5ef3bfa0e1da",
                                        "glosses": [
                                            "Behälter mit Wasser zur Haltung und Beobachtung von Wassertieren und -pflanzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74a86196-ce64-4e2b-b7d5-27eb40f5c367",
                                                "sense_id": "5273ea82-4943-31d8-925b-f3f0c7855483",
                                                "text": "Fernsehen mag er nicht, er schaut lieber stundenlang den Fischen in seinem Aquarium zu."
                                            },
                                            {
                                                "example_id": "99c6825c-f7c0-48b1-8c71-e3c9a358548d",
                                                "sense_id": "5273ea82-4943-31d8-925b-f3f0c7855483",
                                                "text": "„Ich streifte die Aquarien mit einem letzten Blick.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fadbe216-de16-3a9f-9c6e-57c302a751e1",
                                        "entry_id": "0b8e7723-d0be-337a-a2a8-5ef3bfa0e1da",
                                        "glosses": [
                                            "Gebäude, Ausstellung mit mehreren Aquarien^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79374b05-f9c6-4576-9d38-05f953cb0e3b",
                                                "sense_id": "fadbe216-de16-3a9f-9c6e-57c302a751e1",
                                                "text": "Wir liefen stundenlang durch das Aquarium und bestaunten die bunten Fische."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
