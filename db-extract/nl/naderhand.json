                        "examples": [
                            {
                                "example_id": "9da9cb83-07dd-46cd-91c8-cefa11c4ecd7",
                                "sense_id": "0453db45-64e3-3d67-bb27-446ba7d5d6f4",
                                "text": "Ze zijn naderhand nog een biertje gaan drinken."
