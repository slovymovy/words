                    ]
                },
                {
                    "sense_id": "e0dcf93f-19d8-36f5-82dd-e42c3dc0a2c0",
                    "sense_definition": "Se tenir serré et collé avec affection ou pour chercher du réconfort contre quelqu'un ou quelque chose.",
