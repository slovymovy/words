                        "glosses": [
                            "Wissenschaftler, der sich mit der Umwelt und den Auswirkungen menschlicher Tätigkeiten auf die Umwelt beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7557c7eb-8569-474a-b2dc-b6ca379eaf03",
                                "sense_id": "3aa4aa06-c4a0-3410-bbf8-6e7f80c1e237",
                                "text": "„Seit Ende des 20. Jahrhunderts haben sich verschiedene eigenständige Studiengänge zum Umweltwissenschaftler entwickelt. Als Umweltwissenschaftler werden jedoch auch Wissenschaftler bezeichnet, die nicht entsprechende Studiengänge absolviert haben, aber zum Beispiel im Bereich Ökologie tätig sind.“"
                            }
