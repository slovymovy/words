                ],
                "senses": [
                    {
                        "sense_id": "cdefc9fd-2b00-3634-973d-418d37506f9c",
                        "entry_id": "ba4f09c3-d4f3-3443-a357-8fa806943322",
                        "glosses": [
                            "Cesser de bufferiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fbe38bf-eaaa-49ab-bdd5-867bee581af8",
                                "sense_id": "cdefc9fd-2b00-3634-973d-418d37506f9c",
                                "text": "Mais on a très rarement besoin de débufferiser les I/O."
                            },
                            {
                                "example_id": "48aa5052-f381-4fe6-b084-8680995c8194",
                                "sense_id": "cdefc9fd-2b00-3634-973d-418d37506f9c",
                                "text": "Ca signifie que si tu comptes dessus dans le codage, y compris celui du code réutilisable, tu imposes à tout ré-utilisateur futur de 'débufferiser' les flux."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aa4c7cf-41fd-328b-96b4-7a507baff938",
                        "entry_id": "ba4f09c3-d4f3-3443-a357-8fa806943322",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07fba6ec-02d9-4a2e-963e-b9da3940c1b0",
                                "sense_id": "6aa4c7cf-41fd-328b-96b4-7a507baff938",
                                "text": "Celui de gauche pour “débufferiser” un peu … en gros casser la dynamique du buffer et son côté trop droit avant d’attaquer une fuzz, par exemple !"
                            },
                            {
                                "example_id": "fdf58780-44cc-4750-b622-84dbe1169dd9",
                                "sense_id": "6aa4c7cf-41fd-328b-96b4-7a507baff938",
                                "text": "Ma GCB95 (même True Bypassée et débufferisée) ne m'ayant jamais vraiment plu, j'ai fait l'acquisition d'une Crybaby Thomas Organ de 1969, made in Sepulveda avec inducteur TDK."
                            }
                        ]
                    }
                ],
