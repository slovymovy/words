                        "glosses": [
                            "Retirer ce qui entoure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62bce3df-b694-4b0d-b066-09b379705fc2",
                                "sense_id": "a0e7ef63-ef04-312c-998a-84345b81a765",
                                "text": "Au fond, on lui reprochait surtout de se laisser dominer par son entourage ; il ne s’agissait donc que de le désentourer."
                            },
                            {
                                "example_id": "05486e8d-dd1d-4400-84a6-c3ca5a39b190",
                                "sense_id": "a0e7ef63-ef04-312c-998a-84345b81a765",
                                "text": "On l’entoure, on l’entourera, ne pouvez-vous pas la désentourer, lui parler, lui faire parler sans cesse de moi, de mon attachement bien sincère pour elle ?"
                            },
                            {
                                "example_id": "0d707e4d-4610-44b7-b79f-034a688cdea5",
                                "sense_id": "a0e7ef63-ef04-312c-998a-84345b81a765",
                                "text": "Il y a déjà même un peu d’encombrement,et j’ai idée que je ne ferais pas trop mal de commencer à me désentourer."
                            }
                        ]
                    }
