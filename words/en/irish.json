                                "zh": "<w>艾里什</w>先生现在要在办公室见你。"
                            }
                        },
                        {
                            "text": "I went to school with a girl named Sarah <w>Irish</w>.",
                            "target_lang_translations": {
                                "ru": "Я учился в школе с девочкой по имени Сара <w>Айриш</w>.",
                                "zh": "我上学时有个叫莎拉·<w>艾里什</w>的女孩。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "originating as an ethnonym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая от названия этнической группы.",
                        "zh": "源自民族名称的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Айриш",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艾里什",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6ddfa3c0-861c-3b83-8984-e9f91fed291e",
