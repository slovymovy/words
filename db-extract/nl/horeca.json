                        "entry_id": "cb941546-20cc-3cc5-826c-0cb4a449586b",
                        "glosses": [
                            "de bedrijfstak die alle eet- en drinkgelegenheden en hotels omvat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b6e0674-6ddd-46d2-b7f7-9116f9bb2e0f",
                                "sense_id": "b7fc5dea-ccb0-3511-8d0e-532b07f39ba3",
                                "text": "De horeca is voor het overgrote deel rookvrij geworden."
                            },
                            {
                                "example_id": "030ce0db-176c-4518-8586-e08de2a66d48",
                                "sense_id": "b7fc5dea-ccb0-3511-8d0e-532b07f39ba3",
                                "text": "Het was een groot feest in Deventer: Deventer kan zijn geluk niet op na bekerwinst Go Ahead Eagles: 'We gaan Europa in!' De horeca in het centrum van Deventer had al eerder afgesproken om middernacht te sluiten. Vanaf toen stroomde de binnenstad dan ook grotendeels leeg."
                            },
                            {
                                "example_id": "64439e6b-c03a-44c1-9963-8d3c69ac2e99",
                                "sense_id": "b7fc5dea-ccb0-3511-8d0e-532b07f39ba3",
                                "text": "\"Een zwarte dag voor de horeca\", zegt chef-kok Rik van de Laar over het overlijden van Boer. Hij begon op 16-jarige leeftijd in De Librije, het eerste en bekendste restaurant van Boer, werkte er zeven jaar en runt inmiddels twee restaurants in Den Haag."
                            }
                        ]
                    }
