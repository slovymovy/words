                    }
                ],
                "senses": [
                    {
                        "sense_id": "327d164d-864a-3e0e-b787-9a1803a8f88d",
                        "entry_id": "c0ee86d4-0b4d-3813-9b9a-448fd5ff383c",
                        "glosses": [
                            "Grand quadrupède à dents mamelonnées, qui a beaucoup de rapport avec l’éléphant et qu’on ne connaît que par ses ossements trouvés en terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f47cc2-1c0f-4e3a-96a5-0d7baa8a12cb",
                                "sense_id": "327d164d-864a-3e0e-b787-9a1803a8f88d",
                                "text": "Allez voir au cabinet d’histoire naturelle le mastodonte ou dinothérium gigantœum, merveilleux fossile avec des os et des barres d’airain, qui doit être pour le moins le behemot de la Bible."
                            },
                            {
                                "example_id": "f5674a05-ab59-4784-a3ea-9356ecbd97b8",
                                "sense_id": "327d164d-864a-3e0e-b787-9a1803a8f88d",
                                "text": "Lorsqu'on est aux abois,\npas mieux qu'un mastodonte\nPour cacher son émoi\net étouffer sa honte !"
                            }
                        ]
                    },
                    {
                        "sense_id": "90d8a751-c9bc-3fe7-8ac8-f583ebbf352e",
                        "entry_id": "c0ee86d4-0b4d-3813-9b9a-448fd5ff383c",
                        "glosses": [
                            "Personne d’un fort embonpoint ou chose de taille énorme."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e0b5b058-2595-4e29-8261-e4a65952243c",
                                "sense_id": "90d8a751-c9bc-3fe7-8ac8-f583ebbf352e",
                                "text": "Quel mastodonte !"
                            }
                        ]
                    },
                    {
                        "sense_id": "906a9ef3-0696-3b42-9599-9caf0d0f8d7d",
                        "entry_id": "c0ee86d4-0b4d-3813-9b9a-448fd5ff383c",
                        "glosses": [
                            "Entreprise, société, personne physique ou morale extrêmement importante dans sa spécialité."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "bbb77775-1f0d-4ba8-86d1-f4a542a2ba41",
                                "sense_id": "906a9ef3-0696-3b42-9599-9caf0d0f8d7d",
                                "text": "Une compétition de grande envergure s’est engagée entre les mastodontes des réseaux et tous les acteurs de la chaîne numérique pour savoir qui captera à la fois les nouveaux abonnés mobiles et les consommateurs des services qui y seront proposés."
                            },
                            {
                                "example_id": "6d965c69-cb5c-4b76-83d3-161793f27eeb",
                                "sense_id": "906a9ef3-0696-3b42-9599-9caf0d0f8d7d",
                                "text": "Sur Twitch, il y a les mastodontes du streaming."
                            },
                            {
                                "example_id": "7bae54db-d71f-4aab-9d60-daca1c357885",
                                "sense_id": "906a9ef3-0696-3b42-9599-9caf0d0f8d7d",
                                "text": "Pas de front antioccidental non plus sur le plan géopolitique. Ni même un front uni du tout : les deux mastodontes du groupe, l’Inde et la Chine, s’affrontent régulièrement sur la frontière himalayenne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14b32894-0e43-4db1-ae5c-fbc149085c11",
                        "source_entry_id": "c0ee86d4-0b4d-3813-9b9a-448fd5ff383c",
                        "source_sense_id": "327d164d-864a-3e0e-b787-9a1803a8f88d",
                        "source_sense_description": "Quadrupède préhistorique",
                        "target_lang_word": "Mastodon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mastodon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e966d38-fbf8-32e6-986f-b69f7b5c1dca",
                                        "entry_id": "60546c31-a186-3773-bb93-24a0d2240ee6",
                                        "glosses": [
                                            "ausgestorbene, tertiäre Elefantenart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aceee29f-9505-410b-8976-4900c99c075c",
                                                "sense_id": "6e966d38-fbf8-32e6-986f-b69f7b5c1dca",
                                                "text": "Mastodonten kennt man nur als Fossilien."
                                            },
                                            {
                                                "example_id": "14edde81-40dc-4928-8175-c08d56822e52",
                                                "sense_id": "6e966d38-fbf8-32e6-986f-b69f7b5c1dca",
                                                "text": "„Binnen weniger Jahrhunderte waren Mammut, Mastodon und Säbelzahntiger ausgetilgt.“"
                                            },
                                            {
                                                "example_id": "20d94f13-1ed0-47e0-8481-49d066915c13",
                                                "sense_id": "6e966d38-fbf8-32e6-986f-b69f7b5c1dca",
                                                "text": "„Das Dunkel, das über dem Mastodon lag, reizte Pécuchets Begierde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5750054a-6810-4624-97c2-f43d22c3c4e8",
                        "source_entry_id": "c0ee86d4-0b4d-3813-9b9a-448fd5ff383c",
                        "source_sense_id": "327d164d-864a-3e0e-b787-9a1803a8f88d",
                        "source_sense_description": "Quadrupède préhistorique",
                        "target_lang_word": "mastodon",
                        "target_lang_code": "en",
