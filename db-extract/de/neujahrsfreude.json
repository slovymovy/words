                "senses": [
                    {
                        "sense_id": "b5fec6a1-707c-3d0b-87da-c4e2d3a884f4",
                        "entry_id": "354d2d11-0f71-3727-bdcf-84a9c1873dd4",
                        "glosses": [
                            "Freude über den Beginn eines neuen Jahres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cc91968-8397-4264-bf26-db44c86109a0",
                                "sense_id": "b5fec6a1-707c-3d0b-87da-c4e2d3a884f4",
                                "text": "„Es ist uns und wird ihm nun eine ganz besondere Neujahrsfreude sein, daß Sie es uns anbieten.“"
                            },
                            {
                                "example_id": "af59032c-f383-4c30-b0e3-0b74c89db9d4",
                                "sense_id": "b5fec6a1-707c-3d0b-87da-c4e2d3a884f4",
                                "text": "„Niemand aber wußte, was sie Schönes erblickt hatte, in welchem Glanze sie mit der Großmutter zur Neujahrsfreude eingegangen war!“"
                            },
                            {
                                "example_id": "27f1fa29-57a1-4ece-bdeb-e737d0aa4f10",
                                "sense_id": "b5fec6a1-707c-3d0b-87da-c4e2d3a884f4",
                                "text": "„Hinzu kommt eine geradezu bleierne Müdigkeit, die mich lähmt und von allzu großer Neujahrsfreude abhält.“"
                            },
                            {
                                "example_id": "27b16247-d920-4923-ac8f-ad904b8e5573",
                                "sense_id": "b5fec6a1-707c-3d0b-87da-c4e2d3a884f4",
                                "text": "„Als ich um 8 Uhr zum Stationshause hinabstieg, überraschte mich dort, als besondere Neujahrsfreude, der Besuch eines alten Freundes, des Herrn von Rautenfeld aus Riga.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
