                                "sense_id": "d485e850-37bf-3819-a8ed-361c3af98159",
                                "text": "Het eidooiertje was perfect voor de kleine portie saus.",
                                "translation": "The small egg yolk was perfect for the little portion of sauce.",
                                "english": "The small egg yolk was perfect for the little portion of sauce."
                            },
                            {
                                "example_id": "4895dda9-1732-4898-a99d-583b8ba8db02",
                                "sense_id": "d485e850-37bf-3819-a8ed-361c3af98159",
                                "text": "De eidooiers geven de pasta een rijke en romige textuur.",
                                "translation": "The egg yolks give the pasta a rich and creamy texture.",
                                "english": "The egg yolks give the pasta a rich and creamy texture."
