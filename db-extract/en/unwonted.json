                    {
                        "sense_id": "ecd891a6-a955-3ccc-8748-ea46fea0ea57",
                        "entry_id": "a636cb42-86a0-3a40-a89f-386031909ded",
                        "glosses": [
                            "ungewohnt"
                        ],
                        "tags": [
                            "attributiv"
                        ],
                        "examples": [
                            {
                                "example_id": "b706be02-321b-406e-bd11-fd33f07cfaac",
                                "sense_id": "ecd891a6-a955-3ccc-8748-ea46fea0ea57",
                                "text": "‘Let’s go,’ he said, with unwonted enthusiasm.",
                                "translation": "„Lass uns gehen,“ sagte er, mit ungewohnter Begeisterung."
                            }
                        ],
                        "sense_index_json": "\"1\""
