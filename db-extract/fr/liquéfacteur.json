                "senses": [
                    {
                        "sense_id": "94ed7c5b-a458-391d-8d76-7eb7c122c925",
                        "entry_id": "e9a48903-6f98-3559-9b2c-a780e8eee866",
                        "glosses": [
                            "Appareil permettant de liquéfier un gaz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ae020b-32ad-4c1d-8d9d-c39f8a77d147",
                                "sense_id": "94ed7c5b-a458-391d-8d76-7eb7c122c925",
                                "text": "Avec l’aide de Lacaze, il construisit, en 1949, un premier liquéfacteur d’hydrogène de conception originale, suivi en 1952 d’un liquéfacteur d’hélium."
                            },
                            {
                                "example_id": "8dc1afb1-ad6e-4b0e-ab9f-c1a8daa33468",
                                "sense_id": "94ed7c5b-a458-391d-8d76-7eb7c122c925",
                                "text": "L’un des plus gros purificateurs et liquéfacteurs d’hélium jamais conçus vient d’être livré par Air Liquide à la société Ras Gas et à son partenaire Exxon, au Qatar."
                            },
                            {
                                "example_id": "2a848d9c-df70-49ac-aaf2-790c14b22421",
                                "sense_id": "94ed7c5b-a458-391d-8d76-7eb7c122c925",
                                "text": "Avec un coût de 1,236 milliards de Fbu, le Centre national d’insémination artificielle (CNIA) dispose d’un liquéfacteur moderne pour produire de l’azote liquide. Entre autres pour une meilleure conservation des semences agro-pastorales."
                            }
                        ]
                    }
