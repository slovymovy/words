                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8724ab5-be39-4ad6-9b90-4b1f135f5af4",
                                "sense_id": "21f8ba06-c2b4-381a-9a5d-c1f87085d21e",
                                "text": "„Schon sah er sich von einer Händlerschar umringt, die in lebhaftem Kauderwelsch auf ihn einschwatzte und aus allerlei Verstecken der Gewänder ihm bunte Glas- und Korallenketten, Glücksamulette und billigen Schmuck anbot.“"
                            },
                            {
                                "example_id": "7cef61c8-3a24-466c-9bd9-8799a4bfce11",
                                "sense_id": "21f8ba06-c2b4-381a-9a5d-c1f87085d21e",
                                "text": "„Im abschließenden Kreativteil stellt jeder sein eigenes Schwert oder Glücksamulett her.“"
                            }
                        ],
