    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e56bfe5a-338e-3218-b8b5-2f15e9b6fb4d",
                    "sense_definition": "Имеет большое значение, существенно, заслуживает внимания.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "significance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нам очень <важно> успеть на этот поезд.",
                            "target_lang_translations": {
                                "en": "It is very <important> for us to catch this train.",
                                "zh": "我们赶上这趟火车非常<w>重要</w>。"
                            }
                        },
                        {
                            "text": "Для здоровья <важно> пить много воды.",
                            "target_lang_translations": {
                                "en": "It is <important> for health to drink plenty of water.",
                                "zh": "多喝水对健康很<w>重要</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "очень важно",
                        "жизненно важно",
                        "не так важно",
                        "чрезвычайно важно"
                    ],
                    "target_lang_definitions": {
                        "en": "Having great significance, essential, or worthy of attention.",
                        "zh": "指具有重大意义、本质或值得关注。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "it is important",
                                "target_lang_sense_clarification": "predicative phrase used to express necessity or significance"
                            },
                            {
                                "target_lang_word": "importantly",
                                "target_lang_sense_clarification": "adverb indicating significance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重要",
                                "target_lang_sense_clarification": "表示某事具有重大意义或必要性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30dba1d4-08a6-3402-979e-3cac42181cbe",
                    "sense_definition": "С достоинством, величаво, горделиво.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Толстый кот <важно> прошёл через всю комнату.",
                            "target_lang_translations": {
                                "en": "The fat cat walked <grandly> across the entire room.",
                                "zh": "那只胖猫<w>傲慢地</w>穿过了整个房间。"
                            }
                        },
                        {
                            "text": "Чиновник <важно> кивнул головой в знак согласия.",
                            "target_lang_translations": {
                                "en": "The official nodded <importantly> in agreement.",
                                "zh": "官员<w>庄重地</w>点头表示同意。"
                            }
                        }
                    ],
                    "synonyms": [
                        "горделиво",
                        "напыщенно",
                        "спесиво"
                    ],
                    "antonyms": [
                        "скромно",
                        "униженно"
                    ],
                    "common_phrases": [
                        "важно ходить",
                        "важно выглядеть",
                        "важно кивать"
                    ],
                    "target_lang_definitions": {
                        "en": "In a manner showing dignity, pride, or self-importance.",
                        "zh": "以一种表现出尊严、自豪或自命不凡的方式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grandly",
                                "target_lang_sense_clarification": "in a majestic or imposing manner"
                            },
                            {
                                "target_lang_word": "importantly",
                                "target_lang_sense_clarification": "with an air of self-importance"
                            },
                            {
                                "target_lang_word": "pompously",
                                "target_lang_sense_clarification": "in an affectedly grand or self-important manner"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "傲慢地",
                                "target_lang_sense_clarification": "表现出一种自命不凡的态度"
                            },
                            {
                                "target_lang_word": "庄重地",
                                "target_lang_sense_clarification": "表现出一种威严或严肃的态度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed72181c-1aff-32fc-9e0e-503c8691933c",
                    "sense_definition": "Хорошо, отлично.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дела у него идут <важно>, жаловаться не на что.",
                            "target_lang_translations": {
                                "en": "Things are going <great> for him, there is nothing to complain about.",
                                "zh": "他最近过得<w>很好</w>，没什么可抱怨的。"
                            }
                        },
                        {
                            "text": "Мы <важно> погуляли вчера вечером в парке.",
                            "target_lang_translations": {
                                "en": "We had a <great> walk in the park last night.",
                                "zh": "我们昨晚在公园里<w>很好</w>地散了散步。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Very well, excellent (colloquial or archaic usage).",
                        "zh": "非常好，极好（口语或古语用法）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "great",
                                "target_lang_sense_clarification": "colloquial synonym for very well"
                            },
                            {
                                "target_lang_word": "splendidly",
                                "target_lang_sense_clarification": "archaic or formal synonym for excellently"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "很好",
                                "target_lang_sense_clarification": "表示状态极佳"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "52e17457-af49-3286-b8ff-f790365fd8fb",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>важный</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "significance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его решение было <важно> для всей команды.",
                            "target_lang_translations": {
                                "en": "His decision was <important> for the whole team.",
                                "zh": "他的决定对整个团队来说很<w>重要</w>。"
                            }
                        },
                        {
                            "text": "Лицо директора было строго и <важно>.",
                            "target_lang_translations": {
                                "en": "The director's face was stern and <self-important>.",
                                "zh": "主任的表情既严肃又<w>庄重</w>。"
                            }
                        }
                    ],
                    "traits": [
