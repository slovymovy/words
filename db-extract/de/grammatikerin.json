                "senses": [
                    {
                        "sense_id": "96de8acb-2114-3db1-a4e7-a94ef149fe40",
                        "entry_id": "e84c1e56-d7c9-3b1d-993c-36ec14f1296d",
                        "glosses": [
                            "Forscherin, Wissenschaftlerin, die sich mit Grammatik/Grammatiken oder Ausschnitten davon befasst, sie erforscht, beschreibt und/oder lehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f0053be-4b60-4755-b11e-4d013c3289cf",
                                "sense_id": "96de8acb-2114-3db1-a4e7-a94ef149fe40",
                                "text": "„Als Sprachkennerinen werden Agallis oder Amagallis, die Grammatikerin von Corcyra, und Kleopatra, die Königin von Aegypten, die mit Arabern, Aegyptern, Hebräern, Griechen, Syrern und Medern in ihren Sprachen verkehrte, erwähnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f1541fc-a615-4e3f-95b8-1a105eb94e19",
                        "source_entry_id": "e84c1e56-d7c9-3b1d-993c-36ec14f1296d",
                        "source_sense_id": "96de8acb-2114-3db1-a4e7-a94ef149fe40",
                        "source_sense_description": "Wissenschaftlerin, die sich mit Grammatik beschäftigt",
                        "target_lang_word": "grammarian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grammarian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b4ef5c0-d010-333b-9166-39c6724f79ab",
                                        "entry_id": "9fe033eb-89b4-3e81-a911-0cde3e388e35",
                                        "glosses": [
                                            "A person who studies grammar, either scientifically or (traditionally) unscientifically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b633d818-bd93-41a5-988b-745587dd35ba",
                                                "sense_id": "3b4ef5c0-d010-333b-9166-39c6724f79ab",
                                                "text": "Huddleston and Pullum are well-known grammarians of the 21st century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8f3902-0fae-3178-97ef-2f1da14bd5c8",
                                        "entry_id": "9fe033eb-89b4-3e81-a911-0cde3e388e35",
                                        "glosses": [
                                            "A person who pedantically critiques the grammar of others' speech or writing, especially when unscientifically and misguidedly."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d7e98da-7b7f-4588-b3d7-773a54009a34",
                                                "sense_id": "5f8f3902-0fae-3178-97ef-2f1da14bd5c8",
                                                "text": "They spent hours disabusing the misinformed rants of various armchair grammarians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b930fa4e-6c7e-428f-882a-e21eba84d95b",
                        "source_entry_id": "e84c1e56-d7c9-3b1d-993c-36ec14f1296d",
                        "source_sense_id": "96de8acb-2114-3db1-a4e7-a94ef149fe40",
                        "source_sense_description": "Wissenschaftlerin, die sich mit Grammatik beschäftigt",
                        "target_lang_word": "grammairienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grammairienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2eb61f19-3db0-34d0-abdc-17663a5d467e",
                                        "entry_id": "4069fae0-51a6-3af8-90fc-199f4e1c32be",
                                        "glosses": [
                                            "Celle qui s’est spécialisée dans l’étude de la grammaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aed03678-823e-453d-9c52-6674ab1f69a1",
                                                "sense_id": "2eb61f19-3db0-34d0-abdc-17663a5d467e",
                                                "text": "Et ses compétences, acquises Cruz, grâce à l’enseignement d’Abraham Barzilaï, sont reconnues et lui permettent de vivre : elle est désormais une exégète et une grammairienne compétente."
                                            },
                                            {
                                                "example_id": "2f765e75-15a9-4c20-928e-c99eefe83ee6",
                                                "sense_id": "2eb61f19-3db0-34d0-abdc-17663a5d467e",
                                                "text": "La langue n’a pu être ni masculinisée, ni féminisée sur décision d’un groupe de grammairiens, car la langue n’est pas une création de grammairiens — ni de grammairiennes. Ce ne sont pas les recommandations institutionnelles qui créent la langue, mais l’usage des locuteurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1618365f-02c4-3229-ae7c-3cb8c3d2a2fc",
                                        "entry_id": "4069fae0-51a6-3af8-90fc-199f4e1c32be",
                                        "glosses": [
                                            "Celle qui s’adonnait à l’étude ou à l’enseignement des lettres en général."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
