                ],
                "senses": [
                    {
                        "sense_id": "16c06591-26d7-37ca-a968-c6cfb4f137ee",
                        "entry_id": "4622a94d-251d-3d99-9a71-4e9e23e4765e",
                        "glosses": [
                            "Gesamtheit dessen, was man in einer Schule lernen kann beziehungsweise gelernt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b50c68e-47aa-4c5d-b6cd-be1ffc4c8dfb",
                                "sense_id": "16c06591-26d7-37ca-a968-c6cfb4f137ee",
                                "text": "„Huxleys Vater war Mathematiklehrer gewesen und hatte ständig in der Klemme gesessen, weshalb er dem Sohn keine über zwei Jahre Grundschule hinausgehende Schulbildung finanzieren konnte.“"
                            },
                            {
                                "example_id": "f1b722b8-5969-4996-9a21-327f49ad964e",
                                "sense_id": "16c06591-26d7-37ca-a968-c6cfb4f137ee",
                                "text": "„Seine Fragestellung umfaßte den Einfluß des Kindergartens, der Volksschule und des Familienmilieus auf die Entwicklung der Artikulation, wobei die Schulbildung der Eltern die Variable bildete.“"
                            },
                            {
                                "example_id": "34f1864d-492d-4f54-9a76-55fb360d3067",
                                "sense_id": "16c06591-26d7-37ca-a968-c6cfb4f137ee",
                                "text": "„Wenn man die Qualität des pakistanischen Bildungssystems berücksichtigt, wird schnell klar, dass nur ein kleiner Teil der Bevölkerung überhaupt eine qualitativ akzeptable Schulbildung erhält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
