            "senses": [
                {
                    "sense_id": "0112bacf-a8f3-3442-82e4-6b8bec61ee90",
                    "sense_definition": "Saveur fondamentale caractéristique des substances ou aliments amers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le café noir a une légère <w>amertume</w> que beaucoup de personnes apprécient particulièrement le matin."
                        },
                        {
                            "text": "Ce fruit sauvage n'est consommé qu'après un long trempage destiné à réduire son <w>amertume</w>."
                        }
                    ],
                    "synonyms": [
                        "âpreté"
                    ],
                    "antonyms": [
                        "douceur"
                    ],
                    "common_phrases": [
                        "goût d'amertume",
                        "amertume persistante"
                    ]
                },
                {
                    "sense_id": "378b51a7-ee9b-3067-a91f-7f2308558ebe",
                    "sense_definition": "Sentiment de tristesse mêlé de regret ou de ressentiment causé par une déception.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après l'échec inattendu de son projet, il a parlé de la situation avec une grande <w>amertume</w>."
                        },
                        {
                            "text": "Elle a quitté son ancien travail sans aucune <w>amertume</w>, prête à commencer une nouvelle carrière."
                        }
                    ],
                    "synonyms": [
                        "rancœur",
                        "ressentiment"
                    ],
                    "antonyms": [
                        "sérénité",
                        "joie"
                    ],
                    "common_phrases": [
                        "avec amertume",
                        "plein d'amertume"
                    ]
                },
                {
                    "sense_id": "78fa3002-bd60-3c34-bf0c-6bd1af9b1316",
                    "sense_definition": "Caractère blessant, dur ou acrimonieux présent dans un discours ou un écrit.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>amertume</w> de ses critiques a profondément blessé les jeunes artistes de la troupe."
                        },
                        {
                            "text": "On sentait une pointe d'<w>amertume</w> dans la réponse ironique qu'il a adressée au journaliste."
