                "senses": [
                    {
                        "sense_id": "1ec2da8c-d32b-3b90-9ca0-160893fdc5d2",
                        "entry_id": "0dec3db7-9f24-3cc9-8dfc-5b1867e8f2bd",
                        "glosses": [
                            "Vaterrolle"
                        ],
                        "tags": [
                            "nur in den festen Wendungen „an oder bei jemandem (die) Vaterstelle vertreten/einnehmen”"
                        ],
                        "examples": [
                            {
                                "example_id": "d9b98d41-8f31-49d0-9116-2ae43c541756",
                                "sense_id": "1ec2da8c-d32b-3b90-9ca0-160893fdc5d2",
                                "text": "„André wächst behütet in der Familie von Gabrielles Schwester Hélène und ihrem Mann Léon mit ihren fröhlichen Töchtern auf – und doch bleibt die Vaterstelle leer.“"
                            },
                            {
                                "example_id": "64d8bc11-c3c5-48fc-9a96-3a282dfc2c58",
                                "sense_id": "1ec2da8c-d32b-3b90-9ca0-160893fdc5d2",
                                "text": "„‘Unsere Familiensituation war damals nicht einfach.’ Sex mit seiner Frau habe er nur sporadisch gehabt, dafür viel Stress, auch mit deren Tochter Pauline, an der er von klein auf Vaterstelle vertreten habe, so Hagen H.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
