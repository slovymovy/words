                "senses": [
                    {
                        "sense_id": "c22cb69c-22eb-3d06-818d-1e4dd070a67e",
                        "entry_id": "4d3899e8-7b04-3d53-a3c0-504436fac723",
                        "glosses": [
                            "organähnlich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4fde320-6148-4b9f-b50a-5dd1cfd2a5aa",
                                "sense_id": "c22cb69c-22eb-3d06-818d-1e4dd070a67e",
                                "text": "„Mikroinvasive ADK zeigen nur in einem Teil der Fälle eindeutig invasive atypische Epithelnester, in der Regel an der Basis, die sich vom organoid imponierenden ACIS ablösen und mit einer desmoplastischen Stromareaktion einhergehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ea055eb2-3840-3666-a4d8-546230b9a236",
                        "entry_id": "4d3899e8-7b04-3d53-a3c0-504436fac723",
                        "glosses": [
                            "Typ von Pflanzengallen, bei dem ganze Pflanzenorgane an der Entstehung beteiligt waren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "524d6fd3-a986-462b-aa69-612f6385fa41",
                                "sense_id": "ea055eb2-3840-3666-a4d8-546230b9a236",
                                "text": "„Die äußeren Teile der Eichenrose stellen eine organoide Galle dar, während die eigentliche Galle eine histioide ist […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
