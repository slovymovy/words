                "senses": [
                    {
                        "sense_id": "ff98622a-6b75-3928-b3b2-c3d446b14a6f",
                        "entry_id": "be0ad2f5-73d6-3419-9fe0-94119d3fbe3d",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de retraverser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b95900-64b1-4f61-810f-65688979bf72",
                                "sense_id": "ff98622a-6b75-3928-b3b2-c3d446b14a6f",
                                "text": "Traverser mes peurs, les re-traverser."
                            },
                            {
                                "example_id": "e7346161-58d0-42fd-839c-abcf2fec2b6a",
                                "sense_id": "ff98622a-6b75-3928-b3b2-c3d446b14a6f",
                                "text": "Quand, corps à corps et seuls dans le noir, à la poupe d’un vaporetto, nous re-traversâmes le lac alangui, je pensais qu’elle était peut-être la femme de ma vie."
                            },
                            {
                                "example_id": "a9121ff9-04f2-42c8-9a4a-5a1651f4fcb8",
                                "sense_id": "ff98622a-6b75-3928-b3b2-c3d446b14a6f",
                                "text": "Pendant que nous re-traversions machinalement Palerme, elle me dit à mi-voix et avec une timidité extraordinaire de sa part : (…)"
                            }
                        ]
                    }
