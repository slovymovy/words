    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2ea665f8-94d2-3e18-b94a-55346a3145ba",
                    "sense_definition": "simple past and past participle of <w>abate</w>",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The storm finally <w>abated</w> after several hours of heavy rain.",
                            "target_lang_translations": {
                                "zh": "几小时的暴雨过后，风暴终于<w>减弱</w>了。"
                            }
                        },
                        {
                            "text": "His anger <w>abated</w> once he heard the full explanation.",
                            "target_lang_translations": {
                                "zh": "听完完整的解释后，他的怒气<w>平息</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指强度、程度或力量减弱、缓和或平息。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "减弱",
                                "target_lang_sense_clarification": "指力量、强度或影响力的降低。"
                            },
                            {
                                "target_lang_word": "缓和",
                                "target_lang_sense_clarification": "指紧张局势或情绪的平复。"
                            },
                            {
                                "target_lang_word": "平息",
                                "target_lang_sense_clarification": "指风暴、骚乱或强烈情绪的停止。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d8405607-092e-3ba8-86a1-aa9f12567bda",
                    "sense_definition": "feeling less proud or confident",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He returned home <w>abated</w> after his public failure.",
                            "target_lang_translations": {
                                "zh": "在公开场合遭遇失败后，他<w>气馁</w>地回到了家。"
                            }
                        },
                        {
                            "text": "The once arrogant leader stood <w>abated</w> before the crowd.",
                            "target_lang_translations": {
                                "zh": "那位曾经傲慢的领导者在人群面前显得十分<w>谦卑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "humbled",
                        "subdued"
                    ],
                    "antonyms": [
                        "proud",
                        "arrogant"
                    ],
                    "target_lang_definitions": {
                        "zh": "指因挫折而变得谦卑、气馁或自信心受损。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "气馁",
                                "target_lang_sense_clarification": "指因失败而失去信心或锐气。"
                            },
                            {
                                "target_lang_word": "谦卑",
                                "target_lang_sense_clarification": "指因受挫而变得不再傲慢。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed3e2236-d002-3818-9dc5-395bc47cfc41",
                    "sense_definition": "having the background cut away to create a relief pattern",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stone carving featured an <w>abated</w> background to highlight the floral design.",
                            "target_lang_translations": {
                                "zh": "这件石雕采用了<w>减地</w>处理的背景，以突出花卉图案。"
                            }
                        },
                        {
                            "text": "The metal plate was <w>abated</w> to make the inscription stand out clearly.",
                            "target_lang_translations": {
                                "zh": "金属板经过<w>减地</w>处理，使铭文清晰地凸显出来。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指通过切除背景部分以形成浮雕效果。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "减地",
                                "target_lang_sense_clarification": "雕刻中把底子凿低以突出主体的工艺"
                            }
                        ]
                    }
                }
            ]
        }
    ]
