                "senses": [
                    {
                        "sense_id": "471c1c72-8676-3017-909d-4920f1454f1f",
                        "entry_id": "b138b726-fba0-3230-916a-b60952a21816",
                        "glosses": [
                            "устар. доброжелательный в отношении к кому-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27233f70-7970-46ed-b49b-55903079b71f",
                                "sense_id": "471c1c72-8676-3017-909d-4920f1454f1f",
                                "text": "Человек этот благорасположен ко мне и пользуется между литераторами большим авторитетом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57ca7be1-4c61-4234-85d3-80780a9c4157",
