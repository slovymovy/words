                        "examples": [
                            {
                                "example_id": "b72b0fcc-cf15-4552-b805-081268a58f0a",
                                "sense_id": "1b4556d2-ab95-3e57-87cf-1455952616fc",
                                "text": "Der Großpapa arbeitet wieder einmal fleißig im Garten."
                            },
                            {
                                "example_id": "17c49889-24fe-4de1-b4b0-433478784ee6",
                                "sense_id": "1b4556d2-ab95-3e57-87cf-1455952616fc",
                                "text": "Hab keine Angst vor meinem Großpapa, er ist sehr nett."
                            },
                            {
                                "example_id": "c77e4b37-7b95-4bf2-a8b1-0c6398d97e59",
                                "sense_id": "1b4556d2-ab95-3e57-87cf-1455952616fc",
                                "text": "„Irgendwann, mitten in der Nacht, wachte Großpapa auf, da der Gestank im Schlafzimmer unerträglich war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
