                "senses": [
                    {
                        "sense_id": "4a06b502-c46b-33ed-a1ca-b70405f6196e",
                        "entry_id": "026b53d2-c4af-332a-b283-f6bdc56fad98",
                        "glosses": [
                            "physische Auseinandersetzung feindlicher Gruppen, bei der Schutzwälle aus Gegenständen des alltäglichen Lebens errichtet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78d4ca38-39f8-48ed-bf9e-8d021e75b84e",
                                "sense_id": "4a06b502-c46b-33ed-a1ca-b70405f6196e",
                                "text": "„Arbeiter und Bürger erringen in den Barrikadenkämpfen im März 1848 erstaunliche Erfolge.“"
                            },
                            {
                                "example_id": "be65011a-fbf1-419e-8497-a41d6f8b206e",
                                "sense_id": "4a06b502-c46b-33ed-a1ca-b70405f6196e",
                                "text": "„Allerdings hatte sie in den letzten fünf bis sechs Monaten eine Menge aufregender Vorfälle erlebt: Marius Versuch den Großvater umzustimmen, Marius' Rückkehr aus einem Barrikadenkampfe, Marius' gefährliche Krankheit, Marius' Versöhnung mit dem Großvater, Marius' Verlobung mit einem armen, Marius Verlobung mit einem reichen Mädchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
