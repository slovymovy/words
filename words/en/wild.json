                {
                    "sense_id": "6d2f0d8f-0c10-3520-8708-6c2dd8cfc5d1",
                    "sense_definition": "An area of uncultivated or uninhabited land.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nature_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent their vacation exploring the <w>wilds</w> of northern Canada.",
                            "target_lang_translations": {
                                "ru": "Свой отпуск они провели, исследуя <w>дикие места</w> северной Канады."
                            }
