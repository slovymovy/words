            "senses": [
                {
                    "sense_id": "448f2e6a-2e57-330c-8269-b0fc5847c8e2",
                    "sense_definition": "One who means or intends something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agent_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher described humans as individual <w>meaners</w> who create social reality through their intentions.",
                            "target_lang_translations": {
                                "ru": "Философ описывал людей как индивидуальных <w>создателей смыслов</w>, которые творят социальную реальность через свои намерения."
                            }
                        },
                        {
                            "text": "In this linguistic theory, the speaker is viewed as a <w>meaner</w> of specific messages.",
                            "target_lang_translations": {
                                "ru": "В этой лингвистической теории говорящий рассматривается как <w>источник смысла</w> конкретных сообщений."
                            }
                        }
                    ],
                    "synonyms": [
