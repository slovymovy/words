{
    "word_family": [
        "kieren"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c694e8a-f70c-3122-a9a4-0954c215b831",
                    "sense_definition": "een smalle opening, vaak tussen een deur of raam en het kozijn",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De deur stond op een <w>kier</w>, waardoor ik precies kon zien wie er in de kamer was.",
                            "target_lang_translations": {
                                "en": "The door was <w>ajar</w>, which allowed me to see exactly who was in the room."
                            }
                        },
                        {
                            "text": "Er kwam een koude tocht door de <w>kier</w> van het oude raam naar binnen.",
                            "target_lang_translations": {
                                "en": "A cold draft came in through the <w>crack</w> in the old window."
                            }
                        }
                    ],
                    "synonyms": [
                        "spleet",
                        "opening"
                    ],
                    "common_phrases": [
                        "op een kier",
                        "door een kier"
                    ],
                    "target_lang_definitions": {
                        "en": "a narrow opening, often between a door or window and its frame"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crack",
                                "target_lang_sense_clarification": "a narrow opening, especially in a door or window"
                            },
                            {
                                "target_lang_word": "ajar",
                                "target_lang_sense_clarification": "specifically used to describe a door that is slightly open"
                            },
                            {
                                "target_lang_word": "chink",
                                "target_lang_sense_clarification": "a small narrow opening or beam of light"
                            },
                            {
                                "target_lang_word": "crevice",
                                "target_lang_sense_clarification": "a narrow crack or fissure in a surface"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e0daa65b-75c7-3a22-a87c-641d3f56fc96",
                    "sense_definition": "de eerste persoon enkelvoud tegenwoordige tijd van <w>kieren</w>",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kier</w> het raam een klein beetje om wat frisse lucht binnen te laten.",
                            "target_lang_translations": {
                                "en": "I <w>crack</w> the window a little bit to let some fresh air in."
                            }
                        },
                        {
                            "text": "Als ik de deur op een klein beetje <w>kier</w>, kan de kat zelf naar buiten gaan.",
                            "target_lang_translations": {
                                "en": "If I <w>leave</w> the door <w>ajar</w> a little, the cat can go outside by itself."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the first-person singular present tense of the verb 'kieren' (to leave slightly open)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crack",
                                "target_lang_sense_clarification": "to open something slightly"
                            },
                            {
                                "target_lang_word": "leave ajar",
                                "target_lang_sense_clarification": "to keep a door or window slightly open"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ed7fabc-ccb7-321b-a9cc-bff92e06f50f",
                    "sense_definition": "de gebiedende wijs van <w>kieren</w>",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kier</w> de deur even zodat we kunnen horen of de baby al wakker is geworden.",
                            "target_lang_translations": {
                                "en": "<w>Crack</w> the door for a moment so we can hear if the baby has woken up yet."
                            }
                        },
                        {
                            "text": "<w>Kier</w> dat raam niet te ver, want het begint buiten hard te regenen.",
                            "target_lang_translations": {
                                "en": "Don't <w>open</w> that window too far, because it's starting to rain hard outside."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the imperative form of the verb 'kieren' (to leave slightly open)"
                    },
                    "translations": {
