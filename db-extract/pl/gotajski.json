                                        "examples": [
                                            {
                                                "example_id": "cc320c8d-4ec4-4d76-b51e-545f56ded1dd",
                                                "sense_id": "53f91e15-e23b-3c4c-a555-50f93e81dabc",
                                                "text": "Řekla jí, že žádný Bároš ben Dardanel nebyl a není, a ačkoliv existence gothajského almanachu jí byla naprosto neznámá, jakož i slovo »ben«, znamenající syna a nikoliv dceru — vysvětlila jí, že predikát »ben Dardanel« má asi takovou cenu jako »rytíř Papuč z Kopyta«."
                                            }
                                        ]
