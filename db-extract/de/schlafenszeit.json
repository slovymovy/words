                "senses": [
                    {
                        "sense_id": "07b1f4c6-80c4-3525-97f0-c62aa94fecff",
                        "entry_id": "f2929650-95ba-34a4-9c16-6347a8142ef1",
                        "glosses": [
                            "Zeit, schlafen zu gehen"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "39369237-427b-4387-a34a-a59ca0e73075",
                                "sense_id": "07b1f4c6-80c4-3525-97f0-c62aa94fecff",
                                "text": "Ihr müsst nun ins Bett gehen, es ist Schlafenszeit!"
                            },
                            {
                                "example_id": "16bc7ba9-3ef7-4ad3-80cb-7506c1b95ab6",
                                "sense_id": "07b1f4c6-80c4-3525-97f0-c62aa94fecff",
                                "text": "„Als es Schlafenszeit war, sagte die Haushälterin im Hinausgehen zu mir, sie werde wiederkommen.“"
                            },
                            {
                                "example_id": "5e87aaae-215c-4e84-867d-03ec8c093705",
                                "sense_id": "07b1f4c6-80c4-3525-97f0-c62aa94fecff",
                                "text": "„Ari hielt seine Hand und sah ihn an, lächelte, wenn der Kleine die Augen öffnete, und wiederholte, dass nun Schlafenszeit sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7541012-f596-4281-a530-b2f70cd0c399",
                        "source_entry_id": "f2929650-95ba-34a4-9c16-6347a8142ef1",
                        "source_sense_id": "07b1f4c6-80c4-3525-97f0-c62aa94fecff",
                        "source_sense_description": "Plural selten: Zeit, schlafen zu gehen",
                        "target_lang_word": "bedtime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bedtime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6253461a-3a44-30da-a4ba-5469b412d63f",
                                        "entry_id": "e615136b-bff8-3a51-9d2d-902ceaa09b3e",
                                        "glosses": [
                                            "The time or hour at which one retires to bed in order to sleep."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2795b48-e2f8-4f9d-89a7-82fee38f4737",
                                                "sense_id": "6253461a-3a44-30da-a4ba-5469b412d63f",
                                                "text": "I read every evening, sometimes late into the night, with the help of kerosene lamps, often secretly, past my bedtime."
                                            },
                                            {
                                                "example_id": "d6f4707a-eaa0-4686-8364-10acc61f28bd",
                                                "sense_id": "6253461a-3a44-30da-a4ba-5469b412d63f",
                                                "text": "Irregular bedtimes may disrupt healthy brain development in young children, according to a study of intelligence and sleeping habits.\nGoing to bed at a different time each night affected girls more than boys, but both fared worse on mental tasks than children who had a set bedtime, researchers found."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
