                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f1586a7-edc1-3478-986c-6e115009e22f",
                        "entry_id": "7519779a-55a5-3433-9ecf-17f1ace6c1a6",
                        "glosses": [
                            "het ernstig nadenken over iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f4f150-49be-43be-a5fd-313b4074c9e9",
                                "sense_id": "0f1586a7-edc1-3478-986c-6e115009e22f",
                                "text": "De oude boodschap klinkt toch als nieuw omdat ze deze verpakt in prikkelende dialogen, waarbij ze op geestige, eerlijke wijze alle hoeken van haar gedachtegang afloopt en de toeschouwer verleidt mee te denken. Door de wisselbaden van woede, overpeinzingen, humor en ontroering kan ze de meest naïeve of prekerige gedachtenspinsels verkopen."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a453b5f-57fa-35fe-9992-0e10cefca6ea",
                        "entry_id": "7519779a-55a5-3433-9ecf-17f1ace6c1a6",
                        "glosses": [
                            "datgene wat overdacht wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ac01d5-9a90-44dc-acdd-0318e8957670",
                                "sense_id": "0a453b5f-57fa-35fe-9992-0e10cefca6ea",
                                "text": "Er is maar zoveel dat een mens voor een dier kan verdragen en het geloei kon er echt niet meer bij. Ik kreeg er een ijskoude stomp van in de maag en het leek wel alsof dat gevoel omhoogschoot naar mijn hoofd en mijn gedachten alle kanten op vlogen. Dat het snor zit met de verdoofde slacht, was een overpeinzing die niet bij me opkwam."
                            },
                            {
                                "example_id": "1729cfe5-3359-481f-8e5e-905226ad0c9b",
                                "sense_id": "0a453b5f-57fa-35fe-9992-0e10cefca6ea",
                                "text": "Top secret is het nog. Zelfs hun mede-onderhandelaars mochten de overpeinzingen niet horen. De keuze is ook een moeilijke. Blijven ze in de Kamer, dan kunnen ze fracties leiden. Een niet te onderschatten taak in een coalitie met 76 zetels."
                            }
                        ]
                    }
                ],
