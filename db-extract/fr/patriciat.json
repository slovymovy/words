        "fr-extract.jsonl": [
            {
                "entry_id": "21e42db3-3ecb-336d-bffe-2458b421769d",
                "word": "patriciat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4684e63d-a31b-4d3e-b21a-9468a7bdaf03",
                        "entry_id": "21e42db3-3ecb-336d-bffe-2458b421769d",
                        "tags": [
                            "plural"
                        ],
                        "form": "patriciats"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d6e7fee-0f37-3c89-9884-34c098ea9713",
                        "entry_id": "21e42db3-3ecb-336d-bffe-2458b421769d",
                        "glosses": [
                            "Ordre des patriciens chez les anciens romains."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "b4714cad-af56-471f-b149-8b2493df97ca",
                                "sense_id": "5d6e7fee-0f37-3c89-9884-34c098ea9713",
                                "text": "Au sein du patriciat, rallié en grande majorité au nouvel état de choses, il restait un petit clan irréductible dont le chef était Claudius Appius […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "d86d0aea-2246-3b96-91e6-9a7142761af1",
                        "entry_id": "21e42db3-3ecb-336d-bffe-2458b421769d",
                        "glosses": [
                            "À partir de Constantin, dignité de patrice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e0b713f-ad19-4761-95c5-879cae222580",
                                "sense_id": "d86d0aea-2246-3b96-91e6-9a7142761af1",
                                "text": "On ne parvenait ordinairement au patriciat qu’après avoir passé par les plus grandes charges, comme celle de consul, de préfet du prétoire, de préfet de la ville."
                            }
                        ]
                    },
                    {
                        "sense_id": "c692bb80-1415-35ca-9bee-d30bf5b3084e",
                        "entry_id": "21e42db3-3ecb-336d-bffe-2458b421769d",
                        "glosses": [
                            "Ordre des nobles dans les gouvernements modernes où ils sont appelés les patriciens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0b74a1f-03aa-4e4d-bf27-ea8c10680428",
                                "sense_id": "c692bb80-1415-35ca-9bee-d30bf5b3084e",
                                "text": "Je n’ai pas vu votre ville de Genève […] là, point de noblesse, mais un patriciat ; qui, sans être onéreux à personne, maintient le lustre des bonnes familles."
                            },
                            {
                                "example_id": "7e192908-471f-48bd-9907-10d1f14367eb",
                                "sense_id": "c692bb80-1415-35ca-9bee-d30bf5b3084e",
                                "text": "Fortune et participation continue à la gestion des affaires municipales sont bien les deux éléments qui caractérisent le patriciat."
                            },
                            {
                                "example_id": "c2fdf05d-9fe3-4cab-940c-b1a79f0c9dd4",
                                "sense_id": "c692bb80-1415-35ca-9bee-d30bf5b3084e",
                                "text": "Peu savent qu’à côté de cette bourgeoisie marchande subsiste, d’une part, une vieille noblesse datant du Saint-Empire, de l’autre, un patriciat issu des petites villes, magistrats, officiers, administrateurs, possesseurs de noms bien connus eux aussi dans l’histoire des Pays-Bas."
                            }
                        ]
                    }
                ],
