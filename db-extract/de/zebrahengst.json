                        "glosses": [
                            "Zebra männlichen Geschlechts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87bf5318-5095-46f2-921b-d0a3198db963",
                                "sense_id": "13a12a92-7e00-3f11-ba59-430c54fee793",
                                "text": "„Die Jäger zogen von dannen und sahen einen ungeheuren Wildreichtum, daß jedem Weidmann das Herz im Leibe hüpfte. An hundert Zebras und Gnus ästen in voller Eintracht – ein schöner Zebrahengst sicherte, wieherte und warnte.“"
                            },
                            {
                                "example_id": "db39f64e-fd15-411b-8aa3-f0e32850bf22",
                                "sense_id": "13a12a92-7e00-3f11-ba59-430c54fee793",
                                "text": "„Paaren sich ein Zebrahengst und eine Eselstute, kommt ein Zebresel, Zesel oder Zonkey heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
