    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "06e19b08-d9bd-3cf3-a722-39592ba9b175",
                    "sense_definition": "Au moment où, à l'époque où.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Appelez-moi <w>quand</w> vous arriverez à la gare."
                        },
                        {
                            "text": "Les enfants jouent dehors <w>quand</w> le soleil brille."
                        }
                    ],
                    "synonyms": [
                        "lorsque"
                    ]
                },
                {
                    "sense_id": "ad5fcbb4-481d-3352-b963-5132318cc2d6",
                    "sense_definition": "Alors que, tandis que ; marque une opposition ou un contraste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il refuse d'admettre son erreur <w>quand</w> toutes les preuves montrent le contraire."
                        },
                        {
                            "text": "Certains pays manquent d'eau <w>quand</w> d'autres gaspillent cette ressource précieuse chaque jour."
                        }
                    ]
                },
                {
                    "sense_id": "807ffc66-a0b0-31ac-a4b6-e2a67863a5b3",
                    "sense_definition": "Même si ; s'emploie principalement avec le conditionnel pour exprimer une concession.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "concession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Quand</w> je le voudrais de tout mon cœur, je ne le pourrais pas."
                        },
                        {
                            "text": "Nous partirons immédiatement, <w>quand</w> nous devrions affronter cette tempête terrible."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "tournure littéraire et vieillie sans l'adverbe même"
                        }
                    ]
                },
                {
                    "sense_id": "3cb20196-7ec3-39c6-87e3-fb2d6f65f3da",
                    "sense_definition": "En même temps que.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "simultaneite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Si tu veux, nous partirons <w>quand</w> eux pour faire la route ensemble."
                        },
                        {
                            "text": "Ne t'inquiète pas, j'arriverai au bureau <w>quand</w> toi, vers neuf heures."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Lyonnais, Autunois, Occitanie"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "f1b53aa2-b2ec-3eac-bb47-901c111fcf55",
                    "sense_definition": "À quel moment, dans une interrogation directe ou indirecte.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "interrogation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Quand</w> est-ce que le train pour Lyon doit arriver ?"
                        },
                        {
                            "text": "Dis-moi <w>quand</w> tu seras prêt pour commencer la réunion."
                        }
                    ],
                    "common_phrases": [
                        "quand est-ce que"
                    ]
                },
                {
                    "sense_id": "ccbb56b1-4348-302d-90ad-c13516d9bb55",
                    "sense_definition": "Quel moment, précédé d'une préposition.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "prepositionnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis <w>quand</w> habitez-vous dans ce charmant quartier historique ?"
                        },
                        {
                            "text": "Pour <w>quand</w> prévoyez-vous la livraison définitive de notre commande ?"
                        }
                    ],
                    "common_phrases": [
                        "depuis quand",
                        "jusqu'à quand",
                        "pour quand"
                    ]
                }
            ]
        }
    ]
}