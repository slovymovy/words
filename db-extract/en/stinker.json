    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "adb68a76-d8b6-3810-b30c-575d8eae96c0",
                "word": "stinker",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "0b51361f-dc80-45bd-b35c-cdd1734e2b65",
                        "entry_id": "adb68a76-d8b6-3810-b30c-575d8eae96c0",
                        "tags": [
                            "plural"
                        ],
                        "form": "stinkers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f07eade-0452-374d-ba08-878a74aa670a",
                        "entry_id": "adb68a76-d8b6-3810-b30c-575d8eae96c0",
                        "glosses": [
                            "One who stinks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17f34cd9-e8f8-4e35-b4d9-fe9622590474",
                                "sense_id": "7f07eade-0452-374d-ba08-878a74aa670a",
                                "text": "Skunks are the worst stinkers in the animal kingdom."
                            }
                        ]
                    },
                    {
                        "sense_id": "42c5c806-d107-3ec2-b590-6c670eb86af0",
                        "entry_id": "adb68a76-d8b6-3810-b30c-575d8eae96c0",
                        "glosses": [
                            "A contemptible person or thing."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "920e1202-9804-4f34-b74b-dbceee61a2d9",
                                "sense_id": "42c5c806-d107-3ec2-b590-6c670eb86af0",
                                "text": "\"Stop squallin', you little stinker!\" She struck the child with her open hand across the face."
                            },
                            {
                                "example_id": "19383c8a-61c9-4769-98c0-fdf3d4f8651e",
                                "sense_id": "42c5c806-d107-3ec2-b590-6c670eb86af0",
                                "text": "\"But it's far worse for me,\" said Edmund, \"because you'll at least have a room of your own and I shall have to share a bedroom with that record stinker, Eustace.\""
                            },
                            {
                                "example_id": "97bb013b-eefd-4750-9b7a-7767f843db90",
                                "sense_id": "42c5c806-d107-3ec2-b590-6c670eb86af0",
                                "text": "Never be a stinker, because if you are, though you may flourish for a time like a green bay tree, sooner or later retribution will overtake you."
                            },
                            {
                                "example_id": "ab7ef2e7-a339-4514-844c-fca6467945cb",
                                "sense_id": "42c5c806-d107-3ec2-b590-6c670eb86af0",
                                "text": "When you are colonized by dangerous bacteria their presence in your body does no damage. You become a reservoir for those little stinkers."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9daa7cb-9eb5-321a-8346-f356045c68a5",
                        "entry_id": "adb68a76-d8b6-3810-b30c-575d8eae96c0",
                        "glosses": [
                            "Something difficult (e.g. a given puzzle) or unpleasant (e.g. negative review, nasty letter)."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9615cc1f-3e69-479f-b398-e65386f1149c",
                                "sense_id": "e9daa7cb-9eb5-321a-8346-f356045c68a5",
                                "text": "Today's crossword is a stinker."
                            },
                            {
                                "example_id": "8f53cc08-bdff-4e98-82fa-45ddbd3df651",
                                "sense_id": "e9daa7cb-9eb5-321a-8346-f356045c68a5",
                                "text": "I number several authors among my acquaintance […] and they invariably become all of a doodah when they read a stinker in the press about their latest effort."
                            },
                            {
                                "example_id": "20a82afe-c9b5-4095-b30f-d76b0be6a100",
                                "sense_id": "e9daa7cb-9eb5-321a-8346-f356045c68a5",
                                "text": "I sat there seething with fury. And after I had seethed for a bit I rose from my chair, took pen in hand and wrote Bobbie a stinker. […] I accused her in set terms of giving me the heave-ho in order that she could mercenarily marry a richer man. I called her a carrot-topped Jezebel whom I was thankful to have got out of my hair. I... Oh, I can't remember what else I said but, as I say, it was a stinker."
                            }
                        ]
                    },
                    {
                        "sense_id": "debdfb4d-8d55-3ef2-949f-45528156f338",
                        "entry_id": "adb68a76-d8b6-3810-b30c-575d8eae96c0",
                        "glosses": [
                            "Something of poor quality."
                        ],
                        "tags": [
                            "British",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d68ef226-85f7-45de-b1da-4c14200e6a23",
                                "sense_id": "debdfb4d-8d55-3ef2-949f-45528156f338",
                                "text": "The barely-released stinker Dark Tide continues Stockwell’s fetishistic pattern, coming alive whenever it’s paddling among the sharks off the South African coast and settling in for a long snooze once it gets back on the boat or reaches dry land."
                            },
                            {
                                "example_id": "9d00d92b-7a4a-4ad9-8abd-02c77cefd9d6",
                                "sense_id": "debdfb4d-8d55-3ef2-949f-45528156f338",
                                "text": "Steven Pinker, Rational Thinker: His new book is a stinker. [title]"
                            },
                            {
                                "example_id": "080f1985-067c-4fc2-9e94-d0502b572281",
                                "sense_id": "debdfb4d-8d55-3ef2-949f-45528156f338",
                                "text": "Now it’s over, let’s come out and say it: The Rings of Power was a stinker [title]"
                            }
                        ]
                    },
                    {
                        "sense_id": "16a093c0-66dc-399e-9ec1-49169fe91c36",
                        "entry_id": "adb68a76-d8b6-3810-b30c-575d8eae96c0",
