                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4c8600f7-35d8-3d11-acd8-d46245bbb72d",
                                        "entry_id": "07f41b9b-2a1b-307d-a2a9-7b678102e2db",
                                        "glosses": [
                                            "door schakelen overgaan naar een lagere versnelling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3b874ea-f8c9-4197-a214-d2e9653e384f",
                                                "sense_id": "4c8600f7-35d8-3d11-acd8-d46245bbb72d",
                                                "text": "Sneller, afstand houden, terugschakelen, daar kun je inhalen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afbde008-9d27-3a22-80c4-2d294327ae29",
                                        "entry_id": "07f41b9b-2a1b-307d-a2a9-7b678102e2db",
                                        "glosses": [
                                            "terugkeren naar een oude situatie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0399d778-ceb7-48f7-af3a-fc647a5dadd4",
                                                "sense_id": "afbde008-9d27-3a22-80c4-2d294327ae29",
                                                "text": "Na het (opnieuw) wegvallen van de zondag geblesseerd geraakte spits Donyell Malen lijkt terugschakelen naar twee spitsen een serieuze optie. \"Zou kunnen. Ik hou veel van positiewisselingen. Dan maakt het eigenlijk niet uit in welke opstelling je speelt.\""
                                            },
                                            {
                                                "example_id": "5f2b75b3-37ad-4ac9-b31c-297dd9a48338",
                                                "sense_id": "afbde008-9d27-3a22-80c4-2d294327ae29",
                                                "text": "De datum waarop de scholen weer terugschakelen naar reguliere lesdagen is nog niet zeker. Dat zou mogelijk al kunnen op 2 juni (1 juni valt op Tweede Pinksterdag). In dat geval kunnen scholen, afhankelijk van de vakantieregio, nog vier tot zes weken les op de 'oude manier' geven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
