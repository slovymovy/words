                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4481bc55-f54e-3772-bfa8-4f202099f757",
                                        "entry_id": "6e2db8f5-2b29-3d22-8c03-776f213f59e8",
                                        "glosses": [
                                            "Unable to walk properly because of a problem with one's feet or legs."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82b68a80-86ab-480a-a371-221264389003",
                                                "sense_id": "4481bc55-f54e-3772-bfa8-4f202099f757",
                                                "text": "With the years, this horse has little by little gone lame."
                                            },
                                            {
                                                "example_id": "32e99ab8-1071-446c-870e-33b7f85df424",
                                                "sense_id": "4481bc55-f54e-3772-bfa8-4f202099f757",
                                                "text": "Alone, alone, to where he sits,\nThe Shadow cloak’d from head to foot\nWho keeps the keys of all the creeds,\n⁠I wander, often falling lame,\nAnd looking back to whence I came,\nOr on to where the pathway leads; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "242f7be8-3839-37f8-9551-df07d3c846ed",
                                        "entry_id": "6e2db8f5-2b29-3d22-8c03-776f213f59e8",
                                        "glosses": [
                                            "Unable to walk properly because of a problem with one's feet or legs.",
                                            "That cannot be moved properly."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8938e8e0-ddff-3c2c-bc62-5461a1242bf4",
                                        "entry_id": "6e2db8f5-2b29-3d22-8c03-776f213f59e8",
                                        "glosses": [
                                            "Unable to walk properly because of a problem with one's feet or legs.",
                                            "Physically disabled."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3aa18c7-11b1-46ac-af25-4844e100df9a",
                                                "sense_id": "8938e8e0-ddff-3c2c-bc62-5461a1242bf4",
                                                "text": "a lame man"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a52c8e21-6bfc-3d4a-96ea-5813e311cb4d",
                                        "entry_id": "6e2db8f5-2b29-3d22-8c03-776f213f59e8",
                                        "glosses": [
                                            "Hobbling; limping; inefficient; imperfect."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e6c118f-f822-462f-bc6b-7154df9676a5",
                                                "sense_id": "a52c8e21-6bfc-3d4a-96ea-5813e311cb4d",
                                                "text": "a lame endeavour"
                                            },
                                            {
                                                "example_id": "8fa9bed4-eba0-477f-8095-49beca9166f9",
                                                "sense_id": "a52c8e21-6bfc-3d4a-96ea-5813e311cb4d",
                                                "text": "O, most lame and impotent conclusion![…]"
                                            },
                                            {
                                                "example_id": "1be25de2-0075-4920-bbe8-529cb78f6f80",
                                                "sense_id": "a52c8e21-6bfc-3d4a-96ea-5813e311cb4d",
                                                "text": "It is the remark of an ingenious writer, should a barbarous Indian, who had never seen a palace or a ship, view their separate and disjointed parts, and observe the pillars, doors, windows, cornices and turrets of the one, or the prow and stern, the ribs and masts, the ropes and shrouds, the sails and tackle of the other, he would be able to form but a very lame and dark idea of either of those excellent and useful inventions."
                                            },
                                            {
                                                "example_id": "29ec9d3c-63bf-42f1-99cb-4f10bff71aab",
                                                "sense_id": "a52c8e21-6bfc-3d4a-96ea-5813e311cb4d",
                                                "text": "The ی consonant is our English y[…] It is really a sad mistake for us, who possess this useful consonant, to adopt the lame expedient to which other languages are forced to have recourse, namely, the use of the vowel i, with or without the diaresis over it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1009265e-8852-3fae-878a-de9ebc793d9c",
                                        "entry_id": "6e2db8f5-2b29-3d22-8c03-776f213f59e8",
                                        "glosses": [
                                            "Unconvincing or unbelievable."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9077ba0d-21db-4b56-86ff-1feb327a03a9",
                                                "sense_id": "1009265e-8852-3fae-878a-de9ebc793d9c",
                                                "text": "He had a really lame excuse for missing the birthday party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "577ce378-2ca2-3f59-8687-d2c936ea2776",
                                        "entry_id": "6e2db8f5-2b29-3d22-8c03-776f213f59e8",
                                        "glosses": [
                                            "Uncool, uninteresting, or unfunny."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25a65478-4b87-4c59-8e7c-4ed8ed9f8b32",
                                                "sense_id": "577ce378-2ca2-3f59-8687-d2c936ea2776",
                                                "text": "He kept telling these extremely lame jokes all night."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lame",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97edc334-98e5-3f99-958f-cd03ab7e1971",
                                        "entry_id": "352ebdb6-1e5b-3f13-8f84-64a646a385ba",
                                        "glosses": [
                                            "To cause (a person or animal) to become lame."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13712899-eb89-4744-bfd4-7640b0499f45",
                                                "sense_id": "97edc334-98e5-3f99-958f-cd03ab7e1971",
                                                "text": "And if you don't want to lame your horse, you must look sharp and get them [stones stuck in hooves] out quickly."
                                            },
                                            {
                                                "example_id": "f3729633-f70b-48d7-b0a8-d6f4b84587eb",
                                                "sense_id": "97edc334-98e5-3f99-958f-cd03ab7e1971",
                                                "text": "Now her soul felt lamed in itself. It was her hope that was struck."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
