                ],
                "senses": [
                    {
                        "sense_id": "232794ee-e6bf-3283-bb02-e8a6cd64b8f0",
                        "entry_id": "59dce82c-9347-3c01-ad7a-45883539c877",
                        "glosses": [
                            "heel erg vermoeid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2ffd5aa-f9ca-4360-af6f-db39aaee7a1d",
                                "sense_id": "232794ee-e6bf-3283-bb02-e8a6cd64b8f0",
                                "text": "Hij is doodmoe van het harde werken."
                            },
                            {
                                "example_id": "d84f214f-f1a3-4c45-ab7e-6f4dcf43edba",
                                "sense_id": "232794ee-e6bf-3283-bb02-e8a6cd64b8f0",
                                "text": "Ze namen Sint mee om de oude man dadelijk te verzorgen. Maar Pietje ging met het kruikje naar het paard. En al was hij doodmoe van de tocht, in drie dagen en nachten sliep hij niet om het paard ieder uur zijn toverdrank te kunnen geven."
                            },
                            {
                                "example_id": "539eef16-f77e-4121-9c05-93f56e51a6cb",
                                "sense_id": "232794ee-e6bf-3283-bb02-e8a6cd64b8f0",
                                "text": "Eindelijk kwamen we doodmoe maar opgelucht in het dal aan. Meteen liep ik naar mijn tent die onder het gewicht van de sneeuw voor de helft bleek te zijn ingestort. Zonder een hap te eten en met mijn kleren nog aan viel ik meteen in slaap."
                            }
                        ]
                    }
