                    "frequency": "Middle",
                    "semantic_group_id": "mecanisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pilote vérifie soigneusement le tableau de <w>commande</w> avant le décollage."
                        },
                        {
                            "text": "Ce bouton assure la <w>commande</w> à distance de l'appareil de climatisation."
