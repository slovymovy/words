                "senses": [
                    {
                        "sense_id": "c99c6b90-28bd-3fa0-bc9b-edeeb78d63a5",
                        "entry_id": "8c6c7904-d79c-3b0f-b3eb-0399d440aefe",
                        "glosses": [
                            "Produire une immunoprécipitation."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "33e62b00-8eb6-49e7-9dfd-2ad313fad8cb",
                                "sense_id": "c99c6b90-28bd-3fa0-bc9b-edeeb78d63a5",
                                "text": "En fait, j’immunoprécipite ma protéine qui taguée V5 par l’Ac anti V5 grâce au système de protéine G sépharose."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b473124-d6a6-37fb-89e1-cc7c0a146e36",
                        "entry_id": "8c6c7904-d79c-3b0f-b3eb-0399d440aefe",
                        "glosses": [
                            "Subir une immunoprécipitation."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6e84f3d5-2f51-41f2-846a-b53d8d290d7f",
                                "sense_id": "3b473124-d6a6-37fb-89e1-cc7c0a146e36",
                                "text": "La protéine c-mip immunoprécipite avec le complexe p50/p65/IκBα et empêche la dégradation de IκBα et par conséquent la libération du dimère NFκB et sa translocation nucléaire."
                            }
                        ]
                    }
