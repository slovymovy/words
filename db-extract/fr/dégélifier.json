                            {
                                "example_id": "f04830ba-1baa-40ba-bdbd-5dd9224eeb0a",
                                "sense_id": "afd53aee-1757-3b20-a620-891e397e2744",
                                "text": "J’ai une question sur l’insert framboise. J’aimerais le \"dégélifier\" au maximum mais qu’il se tienne encore car il était trop dense à mon goût."
                            },
                            {
                                "example_id": "f0003db7-43fe-4ef1-b91c-18b2dd07c1ac",
                                "sense_id": "afd53aee-1757-3b20-a620-891e397e2744",
                                "text": "Votre miel est sous forme de gel, il faut le dégélifier en plaçant le miel dans un bain marie à 35°C."
                            },
                            {
                                "example_id": "bd9f7d5f-7c88-488e-913d-e2b547570b24",
                                "sense_id": "afd53aee-1757-3b20-a620-891e397e2744",
                                "text": "Si vous n’arrivez pas à « dégélifier » la lessive, ajoutez un peu d’eau chaude et mélangez."
                            },
                            {
                                "example_id": "e5b015b3-0f68-4ea2-ab4e-b418210845f1",
                                "sense_id": "afd53aee-1757-3b20-a620-891e397e2744",
                                "text": "Reprenant l’expérience du gonflement d’une seule cellule sous anaérobiose, il est possible de penser que le protoplasme vivant utilise son énergie à se déshydrater, à se dégélifier."
                            }
                        ]
                    },
