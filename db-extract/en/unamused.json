                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c26ad92a-06f7-4e87-822c-97188049cac0",
                                "sense_id": "9bf3a7b1-38e2-3a26-bcef-d80052b6200d",
                                "text": "I cracked a joke, but she was unamused."
                            },
                            {
                                "example_id": "273ef46e-3856-4cd1-a1bd-6b6a6294625b",
                                "sense_id": "9bf3a7b1-38e2-3a26-bcef-d80052b6200d",
                                "text": "Claire, however, sat looking profoundly unamused by her family’s spirited, italicized conversations."
                            }
                        ]
