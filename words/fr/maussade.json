{
    "word_family": [
        "maussadement",
        "maussaderie"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "84723bdb-fbec-3d2f-bcab-56b9f8f8e2bc",
                    "sense_definition": "Se dit d'un temps ou d'un ciel gris, couvert et pluvieux, dépourvu de clarté.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "meteo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le temps reste particulièrement <w>maussade</w> aujourd'hui, avec de la pluie et un vent froid.",
                            "target_lang_translations": {
                                "en": "The weather remains particularly <w>dreary</w> today, with rain and a cold wind.",
                                "ru": "Погода сегодня по-прежнему особенно <w>пасмурная</w>: идёт дождь и дует холодный ветер.",
                                "de": "Das Wetter bleibt heute besonders <w>trüb</w>, mit Regen und kaltem Wind.",
                                "es": "El tiempo sigue especialmente <w>desapacible</w> hoy, con lluvia y viento frío.",
                                "zh": "今天天气仍然特别<w>阴沉</w>，有雨，还刮着冷风。"
                            }
                        },
                        {
                            "text": "Sous ce ciel <w>maussade</w>, les promeneurs se font rares dans les allées du parc.",
                            "target_lang_translations": {
                                "en": "Under this <w>dreary</w> sky, walkers are scarce along the park's paths.",
                                "ru": "Под этим <w>пасмурным</w> небом в аллеях парка гуляющих почти не встретишь.",
                                "de": "Unter diesem <w>trüben</w> Himmel sind in den Alleen des Parks nur wenige Spaziergänger unterwegs.",
                                "es": "Bajo este cielo <w>encapotado</w>, apenas se ven paseantes por los senderos del parque.",
                                "zh": "在这片<w>阴沉</w>的天空下，公园的小路上散步的人寥寥无几。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gris",
                        "sombre",
                        "pluvieux"
                    ],
                    "antonyms": [
                        "beau"
                    ],
                    "common_phrases": [
                        "temps maussade",
                        "ciel maussade",
                        "journée maussade"
                    ],
                    "target_lang_definitions": {
                        "en": "Describes grey, overcast and rainy weather or sky, lacking brightness.",
                        "ru": "Об облачном, сером и дождливом небе или погоде, без солнечного света.",
                        "de": "Beschreibt einen grauen, bewölkten und regnerischen Himmel oder ein solches Wetter, dem es an Helligkeit fehlt.",
                        "es": "Dicho del tiempo o del cielo gris, cubierto de nubes y lluvioso, sin claridad.",
                        "zh": "形容灰色、阴云密布并伴有雨、缺乏光亮的天气或天空。"
                    },
                    "translations": {
