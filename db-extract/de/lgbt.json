                "senses": [
                    {
                        "sense_id": "b4511bd6-ebb4-3ad5-9e62-1b69adb3636f",
                        "entry_id": "2ccbb266-1284-3724-af45-0e34efda2650",
                        "glosses": [
                            "Sammelbezeichnung für Lesben, Schwule, Bisexuelle und Transsexuelle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c7f197f-af89-45f6-a0a0-847a85680455",
                                "sense_id": "b4511bd6-ebb4-3ad5-9e62-1b69adb3636f",
                                "text": "Das Kürzel LGBT wird heute international verstanden."
                            },
                            {
                                "example_id": "4798f11e-03f6-477a-9a4a-0cbcd0aeef89",
                                "sense_id": "b4511bd6-ebb4-3ad5-9e62-1b69adb3636f",
                                "text": "„Während hier für dasselbe Jahr 47 gewalttätige Angriffe mit rassistischem Hintergrund gezählt wurden, waren es 118 gewalttätige Angriffe auf LGBT Menschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dac829e-a8ca-44b8-96c4-55bf2a2ff345",
                        "source_entry_id": "2ccbb266-1284-3724-af45-0e34efda2650",
                        "source_sense_id": "b4511bd6-ebb4-3ad5-9e62-1b69adb3636f",
                        "source_sense_description": "Sammelbezeichnung für Lesben, Schwule, Bisexuelle und Transsexuelle",
                        "target_lang_word": "LGBT",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "LGBT",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdaee70c-c9eb-397e-b0a2-28bb3d9f42c6",
                                        "entry_id": "63af7f1b-1bd5-3c2f-8041-ed922d4b911e",
                                        "glosses": [
                                            "Being lesbian, gay, bisexual, or transgender, or relating to these groups as a collective."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5638108-1987-47f7-babf-b54dff4c5ddb",
                                                "sense_id": "cdaee70c-c9eb-397e-b0a2-28bb3d9f42c6",
                                                "text": "This differential treatment in both the community of culture and mainstream white LGBT community may lead some LGBT people of colour to experience varying degrees of visibility and invisibility within these communities, and their identity as a^([sic]) LGBT person may change depending on the cultural context."
                                            },
                                            {
                                                "example_id": "9b884c4a-d216-49c9-8901-3bb5844c7f24",
                                                "sense_id": "cdaee70c-c9eb-397e-b0a2-28bb3d9f42c6",
                                                "text": "In a restaurant in Changsha, the capital of central China's Hunan province, Hu Mingliang and Sun Wenlin exchanged their wedding rings, and received blessings from over 200 friends, relatives, as well as LGBT rights activists from around the country."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "LGBT",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a8d0b7ac-ed20-3b1c-a107-d0922c73d170",
                                        "entry_id": "4fedef13-85c8-388c-9ea7-b6acf4ed554b",
                                        "glosses": [
                                            "A member of the LGBT community."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba9e585e-6da4-48f2-898a-33cd04b60be3",
                                                "sense_id": "a8d0b7ac-ed20-3b1c-a107-d0922c73d170",
                                                "text": "An applicant may exceptionally be able to demonstrate a well-founded fear of persecution even if a law criminalizing LGBT is no longer enforced, […]"
                                            },
                                            {
                                                "example_id": "a6603f1c-e6cb-4ef7-835d-b2e252041a23",
                                                "sense_id": "a8d0b7ac-ed20-3b1c-a107-d0922c73d170",
                                                "text": "Further evidence of the political weakness of LGBT is that they are not concentrated enough to be a majority of voters, or even a minority of influence in any state or city."
                                            },
                                            {
                                                "example_id": "191f869e-3838-491d-b81f-2f6f711b8f55",
                                                "sense_id": "a8d0b7ac-ed20-3b1c-a107-d0922c73d170",
                                                "text": "In many cities you will find a neighborhood where the population density of LGBT is higher than it is in other parts of the city."
                                            },
                                            {
                                                "example_id": "043f49dd-0755-47aa-9df8-ff4cb59ce2fb",
                                                "sense_id": "a8d0b7ac-ed20-3b1c-a107-d0922c73d170",
                                                "text": "Allies can point this out when they discern that a^([sic]) LGBT is being asked to serve in an expert capacity and ask questions like, \"How comfortable do you feel being asked to assume the role of representative for all LGBTs?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "713dffcf-6d3d-3295-baa6-a9f39a832ae0",
                                        "entry_id": "4fedef13-85c8-388c-9ea7-b6acf4ed554b",
                                        "glosses": [
                                            "A sandwich named after the sexuality-gender term, composed of lettuce, guacamole or avocado, bacon, tomato. A variant of the BLT."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25aa8750-9909-4d0d-8bef-c89a62fd0256",
                                                "sense_id": "713dffcf-6d3d-3295-baa6-a9f39a832ae0",
                                                "text": "Whether it’s LGBT sandwiches in an era where schools in Birmingham are facing protests for teaching LGBTQ rights, or Nike promoting the fight against police brutality in the age of Trump, brands are tapping into this sense of millennial grievance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59cae034-4485-4d7f-9161-252ff44961fc",
                        "source_entry_id": "2ccbb266-1284-3724-af45-0e34efda2650",
                        "source_sense_id": "b4511bd6-ebb4-3ad5-9e62-1b69adb3636f",
                        "source_sense_description": "Sammelbezeichnung für Lesben, Schwule, Bisexuelle und Transsexuelle",
                        "target_lang_word": "LGBT",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "LGBT",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "51a2fb30-4422-3b2b-b696-7a9c286aa5b1",
                                        "entry_id": "94154531-3522-3118-b48e-db6aa828c30f",
                                        "glosses": [
                                            "Appartenant ou relatif à la communauté des personnes homosexuelles, bisexuelles ou transgenres."
                                        ],
                                        "tags": [
                                            "LGBTQ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4df6085-6ce7-4bd8-85b5-8a7af4fb34aa",
                                                "sense_id": "51a2fb30-4422-3b2b-b696-7a9c286aa5b1",
                                                "text": "Sos Homophobie, l’Inter-LGBT, Act Up-Paris, le CGLBT de Paris-Ile de France, Tapages ont ainsi dénoncé les attaques des militants nationalistes à l’encontre des militants LGBT, en rappelant que ces événements se déroulent au moment même où la Fédération de Russie prend la présidence du Conseil de l’Europe."
                                            },
                                            {
                                                "example_id": "30b3044f-07fd-495b-85fa-5267f4f58509",
                                                "sense_id": "51a2fb30-4422-3b2b-b696-7a9c286aa5b1",
                                                "text": "Pour la première fois en décembre 2009, le ministère des Sports a reçu certaines associations LGBT, dont SOS homophobie."
                                            },
                                            {
                                                "example_id": "0018d2a3-983e-478b-a94d-e45d1ce75292",
                                                "sense_id": "51a2fb30-4422-3b2b-b696-7a9c286aa5b1",
                                                "text": "Durant la seconde moitié des années 1990, on assiste à un foisonnement sans précédent de groupes LGBT : des Centres gais et lesbiens (CGL ou CGLBT) ouvrent leurs portes dans la plupart des grandes villes et des associations étudiantes se créent dans les universités."
                                            },
                                            {
                                                "example_id": "a513e90e-4de6-4919-9dab-cda95591a243",
                                                "sense_id": "51a2fb30-4422-3b2b-b696-7a9c286aa5b1",
                                                "text": "La question des droits rejoint la revendication plus large de l'égalité pleine et entière, principal moteur de l'activisme LGBT."
                                            },
                                            {
                                                "example_id": "ee283ea1-3447-4d55-a633-4e79ab069d1a",
                                                "sense_id": "51a2fb30-4422-3b2b-b696-7a9c286aa5b1",
                                                "text": "Osons le dire : au sein de minorités sexuelles, les femmes prennent le pouvoir. Elles le font plutôt par la bisexualité que par l'homosexualité. Le drapeau arc-en-ciel ne doit pas nous cacher que le bloc historique LGBT est passé en matridominance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "LGBT",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de9f0704-da88-3299-91e0-beceda26381f",
                                        "entry_id": "87c68af2-cb43-39e0-a1ab-3dadc5a8c7a5",
                                        "glosses": [
                                            "Personne qui est homosexuelle, bisexuelle, ou transgenre."
                                        ],
                                        "tags": [
                                            "LGBTQ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "353434b9-b810-4481-9274-1928e4e85a5e",
                                                "sense_id": "de9f0704-da88-3299-91e0-beceda26381f",
                                                "text": "Les minorités ethniques et religieuses, ainsi que les LGBT font face à des comportements discriminatoires de grande ampleur."
                                            },
                                            {
                                                "example_id": "ae2022dc-c638-4a53-ad22-5e9a4e128d5d",
                                                "sense_id": "de9f0704-da88-3299-91e0-beceda26381f",
                                                "text": "Bien qu'un certain flou et de profonds désaccords subsistent dans ce domaine, la présente publication entend démontrer qu'une bonne part du droit international vise à protéger les jeunes LGBT contre les brimades homophobes et transphobes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
