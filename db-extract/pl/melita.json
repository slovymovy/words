                ],
                "senses": [
                    {
                        "sense_id": "fc5facbb-34da-3d7c-9662-4552981d98fd",
                        "entry_id": "20cd64ed-fa39-3f8f-8d9a-b6e9ed9ab9ca",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cb480a12-0e7f-4235-ab80-7961a7086961",
                                "sense_id": "fc5facbb-34da-3d7c-9662-4552981d98fd",
                                "text": "Mam na imię Melita i jestem pszczelarką oraz piernikarką z Torunia."
                            },
                            {
                                "example_id": "88323896-6900-4363-9396-c441754494cc",
                                "sense_id": "fc5facbb-34da-3d7c-9662-4552981d98fd",
                                "text": "Melita to rzadkie imię żeńskie w Polsce."
                            },
                            {
                                "example_id": "71cd6c2c-4852-4dd8-a359-bc4b5cdf095d",
                                "sense_id": "fc5facbb-34da-3d7c-9662-4552981d98fd",
                                "text": "10 marca przypadają imieniny Melity i Melisy."
                            },
                            {
                                "example_id": "5d35ba3a-b56a-400c-82ac-08b2e0ba0e6f",
                                "sense_id": "fc5facbb-34da-3d7c-9662-4552981d98fd",
                                "text": "Ambroży poślubił Melitę dopiero po skończeniu studiów."
                            },
                            {
                                "example_id": "416a7f3c-a81a-47c6-b79f-2c1189d5e71d",
                                "sense_id": "fc5facbb-34da-3d7c-9662-4552981d98fd",
                                "text": "W lipcu minionego roku byliśmy z ciocią Melitą w Muzeum Pszczelarstwa w Swarzędzu."
                            },
                            {
                                "example_id": "93290c88-4026-45bb-8e23-92f35f52e8fe",
                                "sense_id": "fc5facbb-34da-3d7c-9662-4552981d98fd",
                                "text": "Pani Melito, proszę nas jutro odwiedzić."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
