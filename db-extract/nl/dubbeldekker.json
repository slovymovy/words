                    {
                        "sense_id": "00a4ac10-9f81-3840-b5bb-02d4fcfea24e",
                        "entry_id": "19684d66-ce09-3ab4-a47a-bb321a4dc4d3",
                        "glosses": [
                            "een vliegtuig met twee evenwijdige vleugels boven elkaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "203e90a1-90dd-44cd-8af5-36d2c68604db",
                                "sense_id": "00a4ac10-9f81-3840-b5bb-02d4fcfea24e",
                                "text": "Tussen de beide wereldoorlogen waren dubbeldekkers erg in zwang."
                            }
                        ]
                    },
                    {
                        "sense_id": "1d076d3f-ac86-3c6e-bbbf-7de5dfa01419",
                        "entry_id": "19684d66-ce09-3ab4-a47a-bb321a4dc4d3",
                        "glosses": [
                            "bus of trein met twee niveaus waarin passagiers vervoerd kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43633b3f-a995-4425-b98e-7fd134f83e3e",
                                "sense_id": "1d076d3f-ac86-3c6e-bbbf-7de5dfa01419",
                                "text": "In Londen rijden veel dubbeldekkers."
                            },
                            {
                                "example_id": "2bf5c43a-e50e-4748-b1ba-0ec707dca33c",
                                "sense_id": "1d076d3f-ac86-3c6e-bbbf-7de5dfa01419",
                                "text": "De NS gebruikt steeds meer dubbeldekkers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7e2a1aa-2775-4677-a489-a962358d3ccd",
                        "source_entry_id": "19684d66-ce09-3ab4-a47a-bb321a4dc4d3",
                        "target_lang_word": "Doppeldecker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doppeldecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ccc9700-01df-3177-954d-a8a24dee7441",
                                        "entry_id": "70c888bd-c1c4-3734-9a00-5c10efcad5dd",
                                        "glosses": [
                                            "ein Flugzeug mit zwei übereinander liegenden Flügeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "638121b6-6e95-45b9-996d-74856046f4cc",
                                                "sense_id": "5ccc9700-01df-3177-954d-a8a24dee7441",
                                                "text": "Ich bin mit einem Doppeldecker geflogen."
                                            },
                                            {
                                                "example_id": "85d8d7ef-fe03-4fb5-a12b-07c8b9e3dc5a",
                                                "sense_id": "5ccc9700-01df-3177-954d-a8a24dee7441",
                                                "text": "„In großer Höhe drehte ein Doppeldecker einen Looping nach dem andern und weit draußen übte die Marine Schießen.“"
                                            },
                                            {
                                                "example_id": "38e12bc7-f778-4799-8e19-38d345bfaaae",
                                                "sense_id": "5ccc9700-01df-3177-954d-a8a24dee7441",
                                                "text": "„Er machte seinen Pilotenschein und kaufte sich später einen Doppeldecker, einen Zweisitzer, und unternahm sogar mit seiner Tochter Geneviève Rundflüge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "542020c2-2c9b-3139-a535-4c7e194af63f",
                                        "entry_id": "70c888bd-c1c4-3734-9a00-5c10efcad5dd",
                                        "glosses": [
                                            "Kurzform für einen Omnibus mit zwei Stockwerken, siehe Doppeldeckerbus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c84b6042-929b-4e47-8af4-18dd6e48ac51",
                                                "sense_id": "542020c2-2c9b-3139-a535-4c7e194af63f",
                                                "text": "Ich bin mit einem Doppeldecker mitgefahren."
                                            },
                                            {
                                                "example_id": "6b064d8c-fc2d-4608-95af-eaa38f91a198",
                                                "sense_id": "542020c2-2c9b-3139-a535-4c7e194af63f",
                                                "text": "In London haben wir mit einem Doppeldecker eine Stadtrundfahrt gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f35fbe9e-10a8-3775-9915-5bc59659ad08",
                                        "entry_id": "70c888bd-c1c4-3734-9a00-5c10efcad5dd",
                                        "glosses": [
                                            "Kurzform für eine Straßenbahn mit zwei Stockwerken."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7e0eb3-ffe6-45d1-be11-ddc9b57c7349",
                                                "sense_id": "f35fbe9e-10a8-3775-9915-5bc59659ad08",
                                                "text": "Der Doppeldecker fuhr in den neu verlegten Schienen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e244fb3e-6274-4f34-b1f6-6dc631cf35f8",
                        "source_entry_id": "19684d66-ce09-3ab4-a47a-bb321a4dc4d3",
                        "target_lang_word": "biplane",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biplane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82379dfa-f698-3217-abe0-862b65cda09e",
                                        "entry_id": "83060f49-084f-3854-b84c-403e3d4e280b",
                                        "glosses": [
                                            "Composed of, or relating to, two planes (flat surfaces extending infinitely in all directions)."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c735ccb2-3efe-4f61-9e84-8b234b02fc24",
                                                "sense_id": "82379dfa-f698-3217-abe0-862b65cda09e",
                                                "text": "biplane angiography"
                                            },
                                            {
                                                "example_id": "5595bbac-4c1f-4239-ab8c-ec3baf25b759",
                                                "sense_id": "82379dfa-f698-3217-abe0-862b65cda09e",
                                                "text": "The left apical 4-chamber image is used for one measurement and for a “biplane” estimate (that averages values from orthogonal planes), either the right parasternal long-axis image (the authors' preference) or the left apical 2-chamber view (shown here) is also measured. […] Either a biplane (Simpson) method of discs or a 3D volumetric rendering is used for LV volume measurements in human echocardiography laboratories."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3b81d24-c93c-39fa-b9a5-3cb2fc5bcad7",
                                        "entry_id": "83060f49-084f-3854-b84c-403e3d4e280b",
                                        "glosses": [
                                            "Having, or consisting of, two superposed planes, aerocurves, etc."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "184e3e58-1df0-4217-bf6d-3bf368666490",
                                                "sense_id": "b3b81d24-c93c-39fa-b9a5-3cb2fc5bcad7",
                                                "text": "a biplane rudder"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "biplane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbbb147d-78d9-3605-9fd3-745f9f2af750",
                                        "entry_id": "d3f35c97-6744-3336-bdc1-314140bd8f1d",
                                        "glosses": [
                                            "An airplane that has two main wings, one above the other and supported by struts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "biplane",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a93258c4-eb02-3b47-99d7-8eb6aa32a4c2",
                                        "entry_id": "25a4efdd-aebe-3497-bc83-57529c364cde",
                                        "glosses": [
                                            "To fly in a biplane."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fc05c4c-b8ed-40cb-94b8-aaa1cdc5e084",
                                                "sense_id": "a93258c4-eb02-3b47-99d7-8eb6aa32a4c2",
                                                "text": "For an unforgettable experience, try llama trekking along a gentle trail in the White River National Forest, […] There also are sky-high balloon rides, biplaning, hang gliding, paragliding and plenty of wilderness paths for hiking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fec1c251-72c5-4e75-b46f-4be3f35ac501",
                        "source_entry_id": "19684d66-ce09-3ab4-a47a-bb321a4dc4d3",
                        "target_lang_word": "biplan",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biplan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "567cd1ba-b867-3ae3-adaa-5a0b52b351b7",
                                        "entry_id": "78dba3e2-d951-3d80-bcdb-77fc4a9275e3",
                                        "glosses": [
                                            "Avion pourvu de deux paires d'ailes, l'une au-dessus de l'autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48881fbf-11ff-4eff-a2c7-a07769b1a0b7",
                                                "sense_id": "567cd1ba-b867-3ae3-adaa-5a0b52b351b7",
                                                "text": "Un groupe de biplans allemands, dans le but de dominer les cataractes et les usines, essayait de se maintenir au zénith en une phalange serrée que les Jaunes s’acharnaient à vouloir disperser."
                                            },
                                            {
                                                "example_id": "5b4ad5d7-7673-4e15-ae46-17ff58852d60",
                                                "sense_id": "567cd1ba-b867-3ae3-adaa-5a0b52b351b7",
                                                "text": "Nous avons fait comme un saut de mouton, puis j'ai arraché, avec le plus d'énergie peut-être qu'auparavant, le « manche à balai ». A cet instant notre biplan se trouva dans une position beaucoup plus normale, et fila d'un trait."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "biplan",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1346554f-e70c-357d-8970-438eb4cd97d0",
                                        "entry_id": "6d332d2c-e5ef-3cf2-83a0-1754687a8f45",
                                        "glosses": [
                                            "Qui a deux faces parallèles entre elles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be3fb1b3-b918-4ddd-b7d2-2e50241a393d",
                                                "sense_id": "1346554f-e70c-357d-8970-438eb4cd97d0",
                                                "text": "Chez les mammifères, les vertèbres sont biplanes, sans cavité où peuvent se placer les coussinets. Les coussinets deviennent donc également biplans et sont appelés disques intervertébraux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
