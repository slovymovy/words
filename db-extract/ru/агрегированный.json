                        "sense_id": "8193025c-da08-394a-84ec-9547e14fc172",
                        "entry_id": "77dce557-258e-3db4-8dda-5cf8528adafd",
                        "glosses": [
                            "страд. прич. прош. вр. от агрегировать"
                        ],
                        "tags": [
                            "participle"
