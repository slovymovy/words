                "senses": [
                    {
                        "sense_id": "28f0fd7f-a3ce-3e20-bec1-9e59ef6c9b2d",
                        "entry_id": "932a2878-a4cc-3a30-8b9a-e9aea9554ac7",
                        "glosses": [
                            "Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1941341a-b205-4924-a676-6215b057fff9",
                                "sense_id": "28f0fd7f-a3ce-3e20-bec1-9e59ef6c9b2d",
                                "text": "Frau Slowe ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0544c17f-1181-4dbb-bb71-1714e6a88360",
                                "sense_id": "28f0fd7f-a3ce-3e20-bec1-9e59ef6c9b2d",
                                "text": "Herr Slowe wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "33fade3a-f4c6-4612-87e4-d611f01ce165",
                                "sense_id": "28f0fd7f-a3ce-3e20-bec1-9e59ef6c9b2d",
                                "text": "Die Slowes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5656dda9-7672-44ce-ad11-2b293e297b2b",
                                "sense_id": "28f0fd7f-a3ce-3e20-bec1-9e59ef6c9b2d",
                                "text": "Der Slowe trägt nie die Schals, die die Slowe ihm strickt."
                            },
                            {
                                "example_id": "b8c2e8be-52f0-4f90-ae4e-d58c0de512a5",
                                "sense_id": "28f0fd7f-a3ce-3e20-bec1-9e59ef6c9b2d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Slowe kommt, geht der Herr Slowe.“"
                            },
                            {
                                "example_id": "9ba67669-ffe6-4d1d-b465-0734055ec99b",
                                "sense_id": "28f0fd7f-a3ce-3e20-bec1-9e59ef6c9b2d",
                                "text": "Slowe kommt und geht."
                            },
                            {
                                "example_id": "5d225781-262a-4125-ba20-5b6baa63460b",
                                "sense_id": "28f0fd7f-a3ce-3e20-bec1-9e59ef6c9b2d",
                                "text": "Slowes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
