                                        "sense_id": "881a9a00-5e1b-3933-8d17-950b9896a82c",
                                        "entry_id": "881f4388-b5c4-339a-b0f6-5ce853c5a279",
                                        "glosses": [
                                            "Monnaie de Thaïlande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95ad908f-6ed0-43fb-87d0-67e790d27d6b",
                                                "sense_id": "881a9a00-5e1b-3933-8d17-950b9896a82c",
                                                "text": "Le baht est divisé en 100 satang."
                                            },
                                            {
                                                "example_id": "40b205be-9641-44ad-967c-cd21a91d6e96",
                                                "sense_id": "881a9a00-5e1b-3933-8d17-950b9896a82c",
                                                "text": "Dans les rues, les pilules de cette drogue de synthèse se vendent pour 20 bahts, soit 0,50 €."
                                            },
                                            {
                                                "example_id": "329b6eea-17f4-4338-b263-13eb8de5f61b",
                                                "sense_id": "881a9a00-5e1b-3933-8d17-950b9896a82c",
                                                "text": "Moyennant quatre cents bahts, ceux qui le désiraient pouvaient assister à un dîner-spectacle avec des « danses traditionnelles thaïes » ; le rendez-vous était fixé à vingt heures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
