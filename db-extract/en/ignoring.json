                "senses": [
                    {
                        "sense_id": "b68ca31e-ffc5-3e38-ad9d-466080297f14",
                        "entry_id": "5a688b7c-934f-3b45-b602-fc95b12f76d9",
                        "glosses": [
                            "The act by which something is ignored."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f13f5c12-6ace-4b3d-af8c-ffeafb730dd6",
                                "sense_id": "b68ca31e-ffc5-3e38-ad9d-466080297f14",
                                "text": "Employ two revokes, two trumpings of your partner's best card and two ignorings of a call — all in the same hand!"
                            },
                            {
                                "example_id": "19031584-549e-4e59-ab10-98c6594d12a7",
                                "sense_id": "b68ca31e-ffc5-3e38-ad9d-466080297f14",
                                "text": "We ignore various far-fetched possibilities, as hard-headed detectives should. But S does not ignore them. S is by profession a sceptical epistemologist. He never ignores much of anything. If it is our own ignorings that matter, then we are wrong, because S never knew much of anything."
                            }
                        ]
                    }
                ],
