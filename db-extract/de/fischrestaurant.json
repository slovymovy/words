                "senses": [
                    {
                        "sense_id": "412e670d-7b4e-3ba6-b5a9-46d0e214de3d",
                        "entry_id": "ad767855-b3ab-3bca-a900-503e086fa83b",
                        "glosses": [
                            "Gastronomiebetrieb, in dem vor allem Wasserlebewesen zum Essen angeboten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dad2d3d1-36a5-42a3-a1bf-a8e23b6d155f",
                                "sense_id": "412e670d-7b4e-3ba6-b5a9-46d0e214de3d",
                                "text": "„Sasha Obama bessert ihr Taschengeld mit einem Ferienjob in einem Fischrestaurant auf.“"
                            },
                            {
                                "example_id": "d70c0332-4ac1-4839-ae19-3bde3d290ee2",
                                "sense_id": "412e670d-7b4e-3ba6-b5a9-46d0e214de3d",
                                "text": "„Am Nachmittag auf dem Nachhauseweg wird er die Ausbeute an eines der Fischrestaurants verkaufen.“"
                            },
                            {
                                "example_id": "4c819e92-201e-4768-a0ec-c561f1946c83",
                                "sense_id": "412e670d-7b4e-3ba6-b5a9-46d0e214de3d",
                                "text": "„Ich blieb vor einem Fischrestaurant in der avenue de Clichy stehen und studierte die ausgehängte Speisekarte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
