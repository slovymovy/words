                "senses": [
                    {
                        "sense_id": "1831560f-b701-3e92-a3ea-5b28034f56ae",
                        "entry_id": "d6cc2a16-9ed5-33ab-bccf-78dae29a61f9",
                        "glosses": [
                            "weibliche Person, die mit Bus, Bahn, Schiff oder Flugzeug reist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "560510b0-3db3-4413-8460-ffca40c75a1d",
                                "sense_id": "1831560f-b701-3e92-a3ea-5b28034f56ae",
                                "text": "Jede Passagierin muss vor Beginn der Reise ihre Fahrkarte lösen."
                            },
                            {
                                "example_id": "96602d2f-e225-4d39-a928-6e734e3c49e0",
                                "sense_id": "1831560f-b701-3e92-a3ea-5b28034f56ae",
                                "text": "„Am Wochenende wurde bei einer 83-jährigen Passagierin der Westerdam aus den USA das Coronavirus nachgewiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05d7f96b-364d-4c2c-8050-a63b556b9e4c",
                        "source_entry_id": "d6cc2a16-9ed5-33ab-bccf-78dae29a61f9",
                        "source_sense_id": "1831560f-b701-3e92-a3ea-5b28034f56ae",
                        "source_sense_description": "weibliche Person, die mit Bus, Bahn, Schiff oder Flugzeug reist",
                        "target_lang_word": "passenger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "passenger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "815c4891-ab32-32d7-89a9-5c9c5f68e59b",
                                        "entry_id": "59ea4021-d14d-3c0e-9756-2a7bb7d7788a",
                                        "glosses": [
                                            "One who rides or travels in a vehicle, but who does not operate it and is not a member of the crew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4baa3d5-47dd-40fe-8741-43fe2bb3476d",
                                                "sense_id": "815c4891-ab32-32d7-89a9-5c9c5f68e59b",
                                                "text": "It is never possible to settle down to the ordinary routine of life at sea until the screw begins to revolve. There is an hour or two, after the passengers have embarked, which is disquieting and fussy."
                                            },
                                            {
                                                "example_id": "bf4a98df-bb7b-4294-96f6-ff81618c4559",
                                                "sense_id": "815c4891-ab32-32d7-89a9-5c9c5f68e59b",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails. Local trains would use side-by-side rails to roll alongside intercity trains and allow passengers to switch trains by stepping through docking bays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aec3b8ea-7148-35fb-a4db-51ede5d540c0",
                                        "entry_id": "59ea4021-d14d-3c0e-9756-2a7bb7d7788a",
                                        "glosses": [
                                            "Somebody in a team who does not do their fair share of the work."
                                        ],
                                        "tags": [
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3e9216e2-e2b8-3530-a6bd-6d3691c0983f",
                                        "entry_id": "59ea4021-d14d-3c0e-9756-2a7bb7d7788a",
                                        "glosses": [
                                            "A young hunting bird that can fly and is taken while it is still in its first year."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11003639-7fa3-3b2c-8ffd-60f3147006b5",
                                        "entry_id": "59ea4021-d14d-3c0e-9756-2a7bb7d7788a",
                                        "glosses": [
                                            "A migratory bird, a bird of passage."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc9e863a-c3ec-46b2-b1a8-823dbb0439bd",
                                                "sense_id": "11003639-7fa3-3b2c-8ffd-60f3147006b5",
                                                "text": "Meander, thou my faithfull Counſellor,\nDeclare the cauſe of my conceiued griefe,\nWhich is (God knowes) about that Tamburlaine:\nThat like a Foxe in midſt of harueſt time,\nDooth pray vppon my flockes of Passengers: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb47ba80-b39e-334b-8696-277b3a647c5d",
                                        "entry_id": "59ea4021-d14d-3c0e-9756-2a7bb7d7788a",
                                        "glosses": [
                                            "A passer-by; a wayfarer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efee63f6-4f97-4bf9-90f8-f3783f9b61ac",
                                                "sense_id": "fb47ba80-b39e-334b-8696-277b3a647c5d",
                                                "text": "These are my mates, that make their wills their law, / Have some unhappy passenger in chase."
                                            },
                                            {
                                                "example_id": "5c61df4c-bca7-4418-b2d4-48856313679b",
                                                "sense_id": "fb47ba80-b39e-334b-8696-277b3a647c5d",
                                                "text": "[The boys] have taken possession of the turnpike road to play the before-mentioned games, to the serious inconvenience of the passengers, one of whom, a woman, was yesterday knocked down by a nurr which struck her in the head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bebc9c7-5bca-3a17-92e9-a619a9e297b7",
                                        "entry_id": "59ea4021-d14d-3c0e-9756-2a7bb7d7788a",
                                        "glosses": [
                                            "A ship carrying passengers, a ferryboat."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afbd9f19-4176-3d09-8651-625323c87154",
                                        "entry_id": "59ea4021-d14d-3c0e-9756-2a7bb7d7788a",
