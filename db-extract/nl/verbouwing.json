                "senses": [
                    {
                        "sense_id": "bb878bcf-7973-391e-8904-3fafa2ab58d6",
                        "entry_id": "a54d7275-15e0-3497-b80e-15aa205cc384",
                        "glosses": [
                            "een bouwkundige wijziging aan een bestaand gebouw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46edd97f-f02a-4827-b86d-5c6b53793ee9",
                                "sense_id": "bb878bcf-7973-391e-8904-3fafa2ab58d6",
                                "text": "De klusser deed de ene na de andere verbouwing aan zijn huis."
                            },
                            {
                                "example_id": "94563af7-5683-430f-b4fe-b733f67e950b",
                                "sense_id": "bb878bcf-7973-391e-8904-3fafa2ab58d6",
                                "text": "Station Groningen is vanaf vandaag ruim twee maanden grotendeels onbereikbaar. De verbouwing van het Hoofdstation van Groningen gaat een nieuwe fase in. Daardoor rijden er tot en met 12 juli minder treinen en is er dit weekend helemaal geen treinverkeer mogelijk."
                            }
                        ]
                    }
