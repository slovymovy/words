                "senses": [
                    {
                        "sense_id": "d6c95e78-a0be-3ee7-929f-f697beee0401",
                        "entry_id": "139edc97-d1cf-3061-bb33-6698912190ca",
                        "glosses": [
                            "Gebundenheit an den Standort im eigenen Biotop, zum Beispiel als Muschel auf dem Felsen oder Parasit auf dem Wirt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "428c26ed-db01-4735-9289-f1b29f895461",
                                "sense_id": "d6c95e78-a0be-3ee7-929f-f697beee0401",
                                "text": "„Aber die Echinodermen weisen außer ihrer Radiärsymmetrie noch andere Eigenschaften auf, die auf eine einstmalige Sessilität hinweisen. Dazu gehört das Vorhandensein eines Schutzpanzers und der den Mund umkränzenden Fangarme, die offenbar erst sekundär zu recht mangelhaften Bewegungsorganen umgestaltet wurden.“"
                            },
                            {
                                "example_id": "e04718b1-b939-4fc7-89c2-088be8d5ce79",
                                "sense_id": "d6c95e78-a0be-3ee7-929f-f697beee0401",
                                "text": "„Um eine Wirkung der plasmodiziden Mittel auf die Plasmodien zu ermöglichen, ist es nötig, sie aus dem Zustand der Sessilität, in dem sie für die Mittel nicht erreichbar sind, zum Übertritt in das strömende Blut zu veranlassen.“ (1919)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
