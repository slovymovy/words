                "senses": [
                    {
                        "sense_id": "e28d10d6-d2b6-3899-8c19-4e69e4f0259c",
                        "entry_id": "0d179ec5-b34f-3145-adbc-5d89d06ee284",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0293e2f3-9b6f-4fe2-9d11-79e57654c652",
                                "sense_id": "e28d10d6-d2b6-3899-8c19-4e69e4f0259c",
                                "text": "Frau Buckow ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "927204ad-3bb2-4ea8-b82f-dfb287950197",
                                "sense_id": "e28d10d6-d2b6-3899-8c19-4e69e4f0259c",
                                "text": "Herr Buckow wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4b882374-7af6-40c5-9d8f-75f764e98aa3",
                                "sense_id": "e28d10d6-d2b6-3899-8c19-4e69e4f0259c",
                                "text": "Die Buckows fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d838f530-822f-4ac1-b31a-73d99571df63",
                                "sense_id": "e28d10d6-d2b6-3899-8c19-4e69e4f0259c",
                                "text": "Der Buckow trägt nie die Schals, die die Buckow ihm strickt."
                            },
                            {
                                "example_id": "18949019-7b6c-431e-ae74-e802088f9a96",
                                "sense_id": "e28d10d6-d2b6-3899-8c19-4e69e4f0259c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Buckow kommt, geht der Herr Buckow.“"
                            },
                            {
                                "example_id": "4f71b78f-b84c-4573-8ac5-7be7b6772b2c",
                                "sense_id": "e28d10d6-d2b6-3899-8c19-4e69e4f0259c",
                                "text": "Buckow kommt und geht."
                            },
                            {
                                "example_id": "f5594543-7256-4a4b-b99a-e39ee05d3e69",
                                "sense_id": "e28d10d6-d2b6-3899-8c19-4e69e4f0259c",
                                "text": "Buckows kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
