                            {
                                "target_word": "rating",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fafcf08-1d70-3d1d-8c72-0bbe25c8b7da",
                                        "entry_id": "a9451cb9-b153-3103-b799-55dc7f4adc49",
                                        "glosses": [
                                            "A position on a scale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c773af1c-93de-39da-a21d-7b79435c10ce",
                                        "entry_id": "a9451cb9-b153-3103-b799-55dc7f4adc49",
                                        "glosses": [
                                            "An evaluation of status, especially of financial status."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf117604-6c7f-4300-9e6d-5a1868eaa51a",
                                                "sense_id": "c773af1c-93de-39da-a21d-7b79435c10ce",
                                                "text": "They have a poor credit rating."
                                            },
                                            {
                                                "example_id": "4fd93ad1-d27d-45e0-990d-2f84c9a54dab",
                                                "sense_id": "c773af1c-93de-39da-a21d-7b79435c10ce",
                                                "text": "A self-proclaimed source of mediation and unbiased ratings of millions of businesses across the country, the BBB receives the majority of its revenue from membership fees paid by hundreds of thousands of companies. […] But through its months-long investigation of the BBB, CNNMoney found that this rating system – a key part of what the organization’s reputation is built on – is seriously flawed, with more than 100 companies in hot water with government agencies receiving A ratings"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c25ef28f-0e8e-36e0-9160-bb5a0befe0bb",
                                        "entry_id": "a9451cb9-b153-3103-b799-55dc7f4adc49",
                                        "glosses": [
                                            "A number, letter, or other mark that refers to the ability of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "819a9041-a138-45da-ac0c-d42babe8b4cd",
                                                "sense_id": "c25ef28f-0e8e-36e0-9160-bb5a0befe0bb",
                                                "text": "He has a high chess rating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecbae473-883a-3147-b611-56ee0d7d483f",
                                        "entry_id": "a9451cb9-b153-3103-b799-55dc7f4adc49",
                                        "glosses": [
                                            "A quantitative measure of the audience of a television program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7defb149-4247-4c61-9542-215d13c3c1bf",
                                                "sense_id": "ecbae473-883a-3147-b611-56ee0d7d483f",
                                                "text": "A rating, at best, is an indication of how many people saw what you gave them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "512578c8-b0f1-3e35-a4b8-93ab785448d7",
                                        "entry_id": "a9451cb9-b153-3103-b799-55dc7f4adc49",
                                        "glosses": [
                                            "A seaman in a warship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80b73dca-d7f5-4e0c-8f02-59cc43f67a84",
                                                "sense_id": "512578c8-b0f1-3e35-a4b8-93ab785448d7",
                                                "text": "Some 400 Russian ratings are living in the western French port, awaiting delivery of their controversial new command-and-control ship, the Vladivostok."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94ca7e70-d7e5-311e-9c48-f635699a7c1a",
                                        "entry_id": "a9451cb9-b153-3103-b799-55dc7f4adc49",
                                        "glosses": [
                                            "An enlisted seaman not a commissioned officer or warrant officer."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cdd5b3d-7a22-449f-9489-6b408b2fa84a",
                                                "sense_id": "94ca7e70-d7e5-311e-9c48-f635699a7c1a",
                                                "text": "In the Royal Navy the ratings, in order, are: ordinary seaman, able seaman, leading seaman, petty officer and chief petty officer."
                                            },
                                            {
                                                "example_id": "2152dc91-b8b2-4dbe-bbf1-6ed9029721bf",
                                                "sense_id": "94ca7e70-d7e5-311e-9c48-f635699a7c1a",
                                                "text": "Fifty officers and seven hundred and fifty ratings from the two British ships were picked up by the Japanese, together with the survivors from the Pope"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8ee8ae2-47c7-452d-ac1b-16d73815b3ad",
                        "source_entry_id": "eeb51bfc-5bd8-33cc-9d00-eff5d30a691b",
                        "source_sense_id": "fbf2d2b9-7e02-3654-b898-489fa0bfdc3e",
                        "source_sense_description": "Einschätzung, Bewertung eines Unternehmens durch Externe",
                        "target_lang_word": "рейтинг",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рейтинг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a578a0e6-a2cc-34a5-8bde-d2c2a2e0a373",
                                        "entry_id": "eb84eb85-a4fd-3864-9fbb-2ed9d41266e9",
                                        "glosses": [
                                            "числовой или порядковый показатель, отображающий уровень, важность, значимость, компетентность или популярность определённого объекта или явления, рассчитанный или определяемый по определённой специальной методике"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4057605d-47f6-44e3-966d-8c793aa58c1b",
                                                "sense_id": "a578a0e6-a2cc-34a5-8bde-d2c2a2e0a373",
                                                "text": "Узнав о том, что рейтинг его заведения опустился на два пункта в списке грандов ресторанного дела, Бернар Луазо покончил с собой."
                                            },
                                            {
                                                "example_id": "d61eb5da-e198-43d0-b947-88f3c7cbb32d",
                                                "sense_id": "a578a0e6-a2cc-34a5-8bde-d2c2a2e0a373",
                                                "text": "Год назад всех нас предупредили, что зачисление в 10-й класс будет по рейтингу (имеются на этот счёт какие-то документы местного масштаба)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a5959b1-8a9e-3003-ab3a-dc35d455c9f7",
                                        "entry_id": "eb84eb85-a4fd-3864-9fbb-2ed9d41266e9",
                                        "glosses": [
                                            "полит. числовой или порядковый показатель, отображающий популярность определённого объекта или явления, определяемый путём опроса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59cf28dd-cf5e-4360-bb34-4ad8436ec99e",
                                                "sense_id": "7a5959b1-8a9e-3003-ab3a-dc35d455c9f7",
                                                "text": "Электоральный рейтинг КПРФ стойко удерживается на уровне выше 20 процентов, в то время как с рейтингом партии власти происходит нечто странное."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "175b51f8-f9d1-3fa2-a271-2d256ef1617e",
                                        "entry_id": "eb84eb85-a4fd-3864-9fbb-2ed9d41266e9",
                                        "glosses": [
                                            "фин. числовой, порядковый или условный показатель, отображающий инвестиционную привлекательность, рассчитанный или определяемый по определённой специальной методике"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f3c3fa-ecc6-437c-8783-45b93ce8aacc",
                                                "sense_id": "175b51f8-f9d1-3fa2-a271-2d256ef1617e",
                                                "text": "Если в арсенале президента — силовой ресурс и поддержка населения (77 процентов опрошенных в июле компанией «РОМИР-Мониторинг» высказываются за пересмотр итогов приватизации), то бизнес может апеллировать лишь к инвестиционным рейтингам и серьёзным колебаниям фондового рынка."
                                            },
                                            {
                                                "example_id": "60537fe2-af03-418a-b53b-61d01e4744a3",
                                                "sense_id": "175b51f8-f9d1-3fa2-a271-2d256ef1617e",
                                                "text": "— История с наездом на «ЮКОС» сильно подорвала экономические рейтинги России на Западе."
                                            },
                                            {
                                                "example_id": "533cd31d-93a8-45e7-a08c-e87ddc0d248a",
                                                "sense_id": "175b51f8-f9d1-3fa2-a271-2d256ef1617e",
                                                "text": "Управляющие компании обязали до 50 % своих активов вкладывать в корпоративные ценные бумаги казахстанских эмитентов, до 30 % вкладывать за границей (10 % — в облигации международных финансовых организаций, 10 % — в бумаги с рейтингом „А“ и 10 % — в бумаги с рейтингом „AA“)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f764ca6b-1043-3429-898b-50f410bf14b7",
                                        "entry_id": "eb84eb85-a4fd-3864-9fbb-2ed9d41266e9",
                                        "glosses": [
                                            "перен. то же, что популярность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e3d4cc8-6934-4d47-8ae7-2edd34b28e03",
                                                "sense_id": "f764ca6b-1043-3429-898b-50f410bf14b7",
                                                "text": "Для начала она получила нетрудное задание — бегать по лесу и поднимать среди встречного зверья рейтинг нового директора леса."
                                            },
                                            {
                                                "example_id": "6fff9987-7006-4abd-b4ed-15e3c5ab813c",
                                                "sense_id": "f764ca6b-1043-3429-898b-50f410bf14b7",
                                                "text": "Как счастливо повезло пятому (культурному) телеканалу, который сразу напал на «золотую жилу» и стал набирать рейтинг в сравнении с другими: задел ностальгическую струну телезрителя."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73dec4d0-5daf-3265-a102-0a4678a2c210",
                                        "entry_id": "eb84eb85-a4fd-3864-9fbb-2ed9d41266e9",
                                        "glosses": [
                                            "перен. то же, что уровень"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49660463-2440-41ba-9802-93ae5ab84596",
                                                "sense_id": "73dec4d0-5daf-3265-a102-0a4678a2c210",
                                                "text": "И это намного опаснее, чем терять рейтинг доверия у народа."
                                            },
                                            {
                                                "example_id": "03625ee5-9cac-4a6c-ab29-73acf6c7c05b",
                                                "sense_id": "73dec4d0-5daf-3265-a102-0a4678a2c210",
                                                "text": "Как правило, рейтинги продаж у маленьких и больших книжных магазинов сильно отличаются."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3073507a-4d09-31df-9097-0fa13d26fc1a",
                                        "entry_id": "eb84eb85-a4fd-3864-9fbb-2ed9d41266e9",
                                        "glosses": [
                                            "список наиболее популярных фильмов, песен, компаний, деятелей и т. д., расположенных в порядке значения рейтинга [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ea0c5e3-6c07-4159-9e78-b76015bf29ce",
                                                "sense_id": "3073507a-4d09-31df-9097-0fa13d26fc1a",
                                                "text": "По государственному рейтингу я, похоже, вообще не попадаю в официальную таблицу."
                                            },
                                            {
                                                "example_id": "64295158-b2a6-4773-afb9-dd1321c20ca2",
                                                "sense_id": "3073507a-4d09-31df-9097-0fa13d26fc1a",
                                                "text": "Знаю, что сегодня можно купить любое место в любом рейтинге."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "рейтинг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4eb74ae7-b575-3af0-a9b0-a3fb2b110461",
                                        "entry_id": "f924d8b2-7594-34bc-a6d4-c2ad17af853f",
                                        "glosses": [
                                            "эвф. от половой член"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37a776a4-233c-4788-85e3-842f40bdc2cf",
                                                "sense_id": "4eb74ae7-b575-3af0-a9b0-a3fb2b110461",
                                                "text": "Мой милёнок — демократ, — // Лысоват, да жидковат! // А достанет рейтинг свой, — // Не мужчина, а герой!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
