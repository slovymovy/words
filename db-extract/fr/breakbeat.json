                "senses": [
                    {
                        "sense_id": "fef7bbc9-ad61-3a9b-b8b6-97583398922a",
                        "entry_id": "47e8d68d-6cc4-3053-bbd6-df63e71ebdcf",
                        "glosses": [
                            "Modèle rythmique issu de la musique funk caractérisé par des rythmes binaires très syncopés et l’utilisation de la polyrythmie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad6e02a1-f8b5-4b96-a407-38ce9cf07a7e",
                                "sense_id": "fef7bbc9-ad61-3a9b-b8b6-97583398922a",
                                "text": "Discophile, sélectionneur de chansons, expert dans leur transition en direct, compositeur, le DJ devient également instrumentiste, en détournant l’usage de ses platines pour réaliser des breakbeats et des scratchs."
                            }
                        ]
                    },
                    {
                        "sense_id": "c27196ef-adf6-343d-bd22-f0baff422c4c",
                        "entry_id": "47e8d68d-6cc4-3053-bbd6-df63e71ebdcf",
                        "glosses": [
                            "Famille de genres musicaux qui font usage de ce type de rythmique, par exemple le hip hop, le drum and bass ou encore le trip hop."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "d7ea4d99-c9e9-42c1-a4e6-6e92c1eb197b",
                                "sense_id": "c27196ef-adf6-343d-bd22-f0baff422c4c",
                                "text": "Le festival des Giboulées poursuit son chemin avec cette soirée consacrée au breakbeat."
                            }
                        ]
                    }
                ],
