                "senses": [
                    {
                        "sense_id": "ef5dacda-fc21-3a9d-af44-cb33785c1b40",
                        "entry_id": "601aa76b-c869-3681-b6e5-63170a033118",
                        "glosses": [
                            "Teilgebiet der Grammatik, das sich mit dem Aufbau von Wörtern aus Morphemen befasst, besonders mit Flexion und Wortbildung; oft werden auch die Wortarten eingeschlossen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cc541ba-1ec6-4523-b578-f82808bfd82a",
                                "sense_id": "ef5dacda-fc21-3a9d-af44-cb33785c1b40",
                                "text": "Die Morphemik ist ein Teilgebiet der Grammatik."
                            },
                            {
                                "example_id": "50644eb4-0df2-4469-8d2d-2c951909121a",
                                "sense_id": "ef5dacda-fc21-3a9d-af44-cb33785c1b40",
                                "text": "„Nach traditioneller Auffassung beschreibt die Morphemik die Arten und Formen der Wörter (…).“"
                            },
                            {
                                "example_id": "6369c234-285d-4990-9664-3e7d8237f8ea",
                                "sense_id": "ef5dacda-fc21-3a9d-af44-cb33785c1b40",
                                "text": "„Die Morphemik hat die Aufgabe, die kleinsten Sprachzeichen, d.h. die kleinsten Einheiten mit Bedeutung, zu ermitteln und ihre strukturellen Eigenschaften anzugeben.“"
                            },
                            {
                                "example_id": "52db6e29-78b1-4398-a812-7504f1f0fb19",
                                "sense_id": "ef5dacda-fc21-3a9d-af44-cb33785c1b40",
                                "text": "„Mit einer solchen Erklärung würden wir aber ausweichen in eine höhere Ebene sprachlicher Struktur, in die Morphemik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
