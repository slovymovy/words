                "senses": [
                    {
                        "sense_id": "202c7e11-3306-320f-a6aa-8b8c92139877",
                        "entry_id": "4e2252ee-0d3e-3839-8994-9f92005f4fed",
                        "glosses": [
                            "Wohnung, die in einer Stadt liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13e369ac-d818-46f6-858f-547f09c997be",
                                "sense_id": "202c7e11-3306-320f-a6aa-8b8c92139877",
                                "text": "„Im Müllerkämmerchen hingegen umgibt uns ein Brausen, das dem des Mühlenwehrs neben der einstigen Stadtwohnung der Großeltern ähnelt.“"
                            },
                            {
                                "example_id": "7a99e34a-c282-4080-9501-b7d9f42ca2df",
                                "sense_id": "202c7e11-3306-320f-a6aa-8b8c92139877",
                                "text": "„Als Einstein mit seiner Frau Elsa im Herbst 1932 von diesem Haus in die Stadtwohnung zurückkehrte, soll er zu ihr gesagt haben, sie möge sich das schöne Heim noch einmal gut anschauen, wahrscheinlich würden sie es nicht wiedersehen.“"
                            },
                            {
                                "example_id": "3d96e961-86b2-4ae2-b043-54c3c48477fb",
                                "sense_id": "202c7e11-3306-320f-a6aa-8b8c92139877",
                                "text": "„Um ihren Mann völlig zu beruhigen, gibt die Marquise sogar ihre Stadtwohnung auf und mietet sich bei den Stiftsdamen von Saint-Aure ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
