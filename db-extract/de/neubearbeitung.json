                "senses": [
                    {
                        "sense_id": "55b7b300-497c-3344-8097-8420cc9f89f2",
                        "entry_id": "e9e32392-b530-3572-94f9-88127c1fc038",
                        "glosses": [
                            "Bearbeitung eines bereits vorhandenen Werkes, um neue Aspekte/Erkenntnisse zu berücksichtigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3abaea4-e4ff-48b2-bc02-a3d37f85f862",
                                "sense_id": "55b7b300-497c-3344-8097-8420cc9f89f2",
                                "text": "„Auf der Grundlage aller dieser kritischen Anregungen und nicht zuletzt der unermüdlichen Unterstützung des Verlages Birkhäuser habe ich eine Neubearbeitung des Materials in Angriff genommen, die nicht mehr allein den linguistischen, sondern jetzt verstärkt, und dies zu gleichen Teilen, den botanischen Aspekten der Etyma gerecht zu werden versucht.“"
                            },
                            {
                                "example_id": "99e08ddb-8bf9-4bd8-a510-89cb60885df5",
                                "sense_id": "55b7b300-497c-3344-8097-8420cc9f89f2",
                                "text": "„Wenn eine Neubearbeitung des Rechtschreibdudens geplant ist, ermittelt die Redaktion mit modernen computerlinguistischen Methoden, welche Wörter seit der letzten Auflage neu in das Korpus gekommen sind und welche davon am häufigsten nachgewiesen werden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "202d3ecc-a636-3932-87e4-7f2048cd4ef0",
                        "entry_id": "e9e32392-b530-3572-94f9-88127c1fc038",
                        "glosses": [
                            "überarbeitete Version eines Werkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0303fe4-1d84-475d-b7e4-d4a5e3ef2a6b",
                                "sense_id": "202d3ecc-a636-3932-87e4-7f2048cd4ef0",
                                "text": "Die Neubearbeitung ist vor Kurzem erschienen."
                            },
                            {
                                "example_id": "c527babe-a06e-410b-b74c-9ed7c0feccff",
                                "sense_id": "202d3ecc-a636-3932-87e4-7f2048cd4ef0",
                                "text": "„Wie das im Falle von Neubearbeitungen gern geschieht, werden nicht selten bei Verlagswechsel gleichzeitig Titel oder Untertitel verändert.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
