                ],
                "senses": [
                    {
                        "sense_id": "d7562c2d-6cd9-3beb-b4ff-824f91890d5a",
                        "entry_id": "a3bf8543-8764-33f6-8ceb-3af2566d5d43",
                        "glosses": [
                            "etwas oder jemand, das Bäume schädigt"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9defe23a-c45b-4c33-9d2f-9ce45220ce67",
                                "sense_id": "d7562c2d-6cd9-3beb-b4ff-824f91890d5a",
                                "text": "Man wird ihn darum nicht als einen Baumfeind ansprechen dürfen, eher als jemanden, der Zweige für den Kult abhaut, so wie der Druide Misteln schnitt (s. 6e)."
                            },
                            {
                                "example_id": "14539019-38d3-4ed6-8c77-da075a7f768a",
                                "sense_id": "d7562c2d-6cd9-3beb-b4ff-824f91890d5a",
                                "text": "Ganz in der Nähe kann man die Kalliprinoseiche in ihrer verkrüppelten, strauchartigen Variante sehen, die ihre kümmerliche Form dem Baumfeind Nr l , der Ziege, verdankt (Fembrun-Dothan, Plants 19)."
                            },
                            {
                                "example_id": "93191858-af58-40ac-8611-268a32bffe9d",
                                "sense_id": "d7562c2d-6cd9-3beb-b4ff-824f91890d5a",
                                "text": "Wie aber der Waldboden vertorft und ein schlechter Wärmeleiter wird, wächst die „merzlota\", der gefrorene Boden, empor und die Tundra gewinnt dem Wald Boden ab. Der zweite gefährliche Baumfeind ist der Wind."
                            },
                            {
                                "example_id": "3b54e4de-31cb-4d19-a24f-e3e41169c71c",
                                "sense_id": "d7562c2d-6cd9-3beb-b4ff-824f91890d5a",
                                "text": "Der Pilz ist auf Obstbäumen, Sorbus-Arten und Esche sehr häufig und stellt einen gefährlichen Baumfeind dar. Er erzeugt eine Weissfäule."
                            },
                            {
                                "example_id": "fee8c5ee-c687-4df7-ae88-c55b8668134c",
                                "sense_id": "d7562c2d-6cd9-3beb-b4ff-824f91890d5a",
                                "text": "In manchen Jahren sind die Raupen in ungeheuren Mengen vorhanden und werden dann auch wohl den meisten Laubbäumen der Wälder und Parks, auch den Rosen, gefährlich. Wir sind bei diesem Baumfeind leider meist darauf angewiesen, den Kampf blos mit der Raupe aufnehmen zu können; […]"
                            },
                            {
                                "example_id": "7e3a2c0c-95f9-446f-ad37-3943d9f032af",
                                "sense_id": "d7562c2d-6cd9-3beb-b4ff-824f91890d5a",
                                "text": "Der Hallimasch, ein gefährlicher Baumfeind. Unter allen grösseren Pilzen ist unstreitig der Hallimasch (Armillaria mellea) einer der gefährlichsten Schädiger der Forsten und Parkanlagen, […]"
                            },
                            {
                                "example_id": "ac4e1953-e6a2-4b2f-acc8-1ff11b678cdc",
                                "sense_id": "d7562c2d-6cd9-3beb-b4ff-824f91890d5a",
                                "text": "Ihren großen Nutzen kann man dadurch bestätigen, daß sie einen Baumfeind bekämpfen, welches sie nicht thun würden, wenn sie Baumfeinde wären."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
