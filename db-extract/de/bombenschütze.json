                "senses": [
                    {
                        "sense_id": "3e3e1f44-601c-30e0-aa20-5c8fb657054c",
                        "entry_id": "23b97ee0-2f57-397e-aba7-6d40f22c2584",
                        "glosses": [
                            "Schütze, der im Flugzeug die Bomben auslöst"
                        ],
                        "tags": [
                            "Luftwaffe"
                        ],
                        "examples": [
                            {
                                "example_id": "55e414a4-44c3-4a3d-9949-f6ce77099c5a",
                                "sense_id": "3e3e1f44-601c-30e0-aa20-5c8fb657054c",
                                "text": "„Freddy, der Bombenschütze, hatte Sorgen wegen seines Nachwuchses.“"
                            },
                            {
                                "example_id": "5df826ea-6d39-44ea-8ceb-5f822baa90ae",
                                "sense_id": "3e3e1f44-601c-30e0-aa20-5c8fb657054c",
                                "text": "„Der Bombenschütze – etwa 24 Jahre alt, eigentlich hatte er Baseballspieler werden wollen – nahm die Aioi-Brücke in der Stadtmitte von Hiroshima ins Visier, den Richtpunkt des Angriffs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bac15d8c-1635-4426-a3bb-4d0c56402af0",
                        "source_entry_id": "23b97ee0-2f57-397e-aba7-6d40f22c2584",
                        "source_sense_id": "3e3e1f44-601c-30e0-aa20-5c8fb657054c",
                        "source_sense_description": "Luftwaffe: Schütze, der im Flugzeug die Bomben auslöst",
                        "target_lang_word": "bombardier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bombardier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21e4c8b3-42a1-348c-8184-7c39ac6dc673",
                                        "entry_id": "138e0713-3d6c-3603-bf2d-5e31c99eb6a9",
                                        "glosses": [
                                            "A bomber crew member who sights and releases bombs."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "641d2590-230e-4189-b882-5e2025188e0b",
                                                "sense_id": "21e4c8b3-42a1-348c-8184-7c39ac6dc673",
                                                "text": "The bombardier then checked the gyroscopic stabilization of the bombsight and clutched in the electrical motor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6612c8b8-6ec7-3a78-9196-fbabaa51882a",
                                        "entry_id": "138e0713-3d6c-3603-bf2d-5e31c99eb6a9",
                                        "glosses": [
                                            "A non-commissioned officer rank in artillery, equivalent to corporal. Abbreviated Bdr."
                                        ],
                                        "tags": [
                                            "British",
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50509599-d5da-47c3-b19a-00429f386532",
                                                "sense_id": "6612c8b8-6ec7-3a78-9196-fbabaa51882a",
                                                "text": "Wikipedia: Bombardier (Bdr) and Lance Bombardier (LBdr or L/Bdr) are British Army ranks used in the Royal Artillery and Royal Horse Artillery instead of (respectively) Corporal and Lance Corporal. In the Canadian Forces, the Artillery Branch uses the ranks of Master Bombardier and Bombardier instead of Master Corporal and Corporal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "977fa304-ad31-3c75-a58f-3bfcdb056ecd",
                                        "entry_id": "138e0713-3d6c-3603-bf2d-5e31c99eb6a9",
                                        "glosses": [
                                            "An artilleryman; a gunner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93a470c7-5bd2-4d0f-873c-0953c2c8706f",
                                                "sense_id": "977fa304-ad31-3c75-a58f-3bfcdb056ecd",
                                                "text": "[…] the officer to whom the command was deputed, to the amusement of a German bombardier, ordered one of the largest cannons to be placed under the gate of a fortress […]"
                                            },
                                            {
                                                "example_id": "363b242a-8ec2-4089-961c-11c001c096cd",
                                                "sense_id": "977fa304-ad31-3c75-a58f-3bfcdb056ecd",
                                                "text": "He has known for ages why a sturdy bombardier rides alongside the officer at the head of each battery, and why he is given a special name."
                                            },
                                            {
                                                "example_id": "3b331038-e498-4e4d-91ae-3fc4eeb75a2d",
                                                "sense_id": "977fa304-ad31-3c75-a58f-3bfcdb056ecd",
                                                "text": "In 1687, with notorious effects, Morosini attacked Athens: the Turks were using the Parthenon as a powder-store, and the German bombardiers blew it up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b10d5d8e-d94f-3928-af84-e9f4bf018c26",
                                        "entry_id": "138e0713-3d6c-3603-bf2d-5e31c99eb6a9",
                                        "glosses": [
                                            "A bombardier beetle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
