                        "glosses": [
                            "Remplacer la page d’accueil d’un site Web par une autre page pour le pirater."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22d3c47f-c372-4386-bb62-36671c42275d",
                        "source_entry_id": "a38d1654-0391-396f-9768-fc60c3d10655",
                        "source_sense_id": "8487d26f-6c18-3a27-961f-f2646b11a244",
                        "target_lang_word": "deface",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deface",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25ee7324-e0e2-3461-9609-197574c3e134",
                                        "entry_id": "7f74f5ff-db75-301b-85cf-7f16548e8bfc",
                                        "glosses": [
                                            "To damage or vandalize something, especially a surface, in a visible or conspicuous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e202854-0da8-4fcd-b29b-f439a0df3171",
                                                "sense_id": "25ee7324-e0e2-3461-9609-197574c3e134",
                                                "text": "1869: George Eliot, The Legend of Jubal\nThat wondrous frame where melody began / Lay as a tomb defaced that no eye cared to scan."
                                            },
                                            {
                                                "example_id": "911a69b0-66ef-492f-8357-d34c7f4f4ac7",
                                                "sense_id": "25ee7324-e0e2-3461-9609-197574c3e134",
                                                "text": "After the painting was defaced a decade ago, it went viral and has been a tourist attraction ever since."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38291874-46ee-387e-b082-14b167a27ba0",
                                        "entry_id": "7f74f5ff-db75-301b-85cf-7f16548e8bfc",
                                        "glosses": [
                                            "To void or devalue; to nullify or degrade the face value of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "987bbf74-9ae2-4614-9bc6-5ea69b557f1b",
                                                "sense_id": "38291874-46ee-387e-b082-14b167a27ba0",
                                                "text": "He defaced the I.O.U. notes by scrawling \"void\" over them."
                                            },
                                            {
                                                "example_id": "fd89c87b-a1fe-4ac5-b62d-6f52f61f8bf5",
                                                "sense_id": "38291874-46ee-387e-b082-14b167a27ba0",
                                                "text": "1776: Adam Smith, The Wealth of Nations\nOne-and-twenty worn and defaced shillings, however, were considered as equivalent to a guinea, which perhaps, indeed, was worn and defaced too, but seldom so much so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "500c71b4-08da-3d5f-a1ae-3d1e543d7c4a",
                                        "entry_id": "7f74f5ff-db75-301b-85cf-7f16548e8bfc",
                                        "glosses": [
                                            "To alter a coat of arms or a flag by adding an element to it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "854fa931-71f6-416d-9528-07c4ffa94ce2",
                                                "sense_id": "500c71b4-08da-3d5f-a1ae-3d1e543d7c4a",
                                                "text": "You get the Finnish state flag by defacing the national flag with the state coat of arms placed in the middle of the cross."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
