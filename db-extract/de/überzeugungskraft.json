                "senses": [
                    {
                        "sense_id": "bcd5f243-4f5e-3664-83ac-f81061c59d55",
                        "entry_id": "0613443b-3c66-306b-8fae-7209dfd28aa5",
                        "glosses": [
                            "die Fähigkeit oder Eigenschaft, jemanden von sich selbst oder etwas anderem zu überzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a2cec32-774a-4774-8b1b-a6faccd350f2",
                                "sense_id": "bcd5f243-4f5e-3664-83ac-f81061c59d55",
                                "text": "Das Argument hat selbst nach hunderten von Jahren nicht an Überzeugungskraft verloren."
                            },
                            {
                                "example_id": "fc4c63c7-9663-4251-b18d-164c096956d2",
                                "sense_id": "bcd5f243-4f5e-3664-83ac-f81061c59d55",
                                "text": "Ihre Überzeugungskraft hilft ihr in ihrem Beruf."
                            },
                            {
                                "example_id": "9b090922-9bc4-44d0-a6b4-8c59b928bfcd",
                                "sense_id": "bcd5f243-4f5e-3664-83ac-f81061c59d55",
                                "text": "„Ihre Überzeugungskraft am Rednerpult ist ihr großer Trumpf.“"
                            },
                            {
                                "example_id": "5268549b-32ab-436e-af16-f38bb6b4a154",
                                "sense_id": "bcd5f243-4f5e-3664-83ac-f81061c59d55",
                                "text": "„Dabei atmete er so hektisch, dass seinen Worten jegliche Überzeugungskraft fehlte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
