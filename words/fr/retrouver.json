{
    "word_family": [
        "trouver",
        "trouvaille",
        "retrouvailles",
        "introuvable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eff8063f-c8ce-3683-868a-30cde213599b",
                    "sense_definition": "Trouver de nouveau ce que l'on avait égaré ou perdu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "retrouver_objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai enfin <w>retrouvé</w> mes clés sous le canapé du salon."
                        },
                        {
                            "text": "Il espère <w>retrouver</w> son portefeuille avant la fin de la journée."
                        }
                    ],
                    "synonyms": [
                        "récupérer"
                    ],
                    "antonyms": [
                        "égarer",
                        "perdre"
                    ],
                    "common_phrases": [
                        "retrouver ses clés",
                        "retrouver son chemin"
                    ]
                },
                {
                    "sense_id": "8d05302b-1b6d-3562-a95c-1c67578e1178",
                    "sense_definition": "Rejoindre quelqu'un à un endroit convenu ou revoir une personne connue après une séparation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "retrouver_personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous allons nous <w>retrouver</w> devant le cinéma à dix-huit heures."
                        },
                        {
                            "text": "Je suis très content de <w>retrouver</w> mes amis d'enfance pendant les vacances."
                        }
                    ],
                    "synonyms": [
                        "rejoindre",
                        "revoir"
                    ],
                    "antonyms": [
                        "quitter"
                    ],
                    "common_phrases": [
                        "se retrouver au café",
                        "retrouver des amis"
                    ]
                },
                {
                    "sense_id": "d8b574a2-da5b-3c0b-899c-74aa65908d41",
                    "sense_definition": "Se rappeler une information, une idée ou un fait que l'on avait oublié.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "retrouver_memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai son nom sur le bout de la langue, mais je ne le <w>retrouve</w> plus."
                        },
                        {
                            "text": "Après un moment de réflexion, elle a <w>retrouvé</w> le titre du livre."
                        }
                    ],
                    "synonyms": [
                        "se rappeler",
                        "se remémorer"
                    ],
                    "antonyms": [
                        "oublier"
                    ],
                    "common_phrases": [
                        "retrouver la mémoire",
                        "retrouver un nom"
                    ]
                },
                {
                    "sense_id": "2cc6362c-1ef7-33d7-bd00-33d60f2a4909",
                    "sense_definition": "Être ou aboutir dans une situation ou un lieu de manière inattendue ou involontaire.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "se_retrouver_situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs erreurs dans ses calculs, il s'est <w>retrouvé</w> sans un sou."
                        },
                        {
                            "text": "En tournant dans cette rue étroite, nous nous sommes <w>retrouvés</w> face à la mer."
                        }
                    ],
                    "synonyms": [
                        "finir"
                    ],
                    "common_phrases": [
                        "se retrouver seul",
                        "se retrouver bloqué"
                    ]
                },
                {
                    "sense_id": "3b55f526-b885-3570-beaf-8f4bbac88f1f",
                    "sense_definition": "Parvenir à s'orienter, à identifier des repères ou à comprendre une organisation complexe.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "se_retrouver_orientation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il y a tellement de dossiers sur ce bureau que je ne m'y <w>retrouve</w> plus du tout."
                        },
                        {
                            "text": "La carte n'est pas claire et nous avons du mal à nous <w>retrouver</w> dans cette immense gare."
                        }
                    ],
                    "synonyms": [
                        "s'orienter",
                        "se repérer"
                    ],
                    "antonyms": [
                        "s'égarer",
                        "se perdre"
                    ],
                    "common_phrases": [
                        "s'y retrouver"
                    ]
                },
                {
                    "sense_id": "b66c4fd9-3747-3019-9d8a-905483a1ba77",
                    "sense_definition": "Reconnaître ou discerner une qualité, une ressemblance ou un trait familier chez quelqu'un ou dans une œuvre.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "retrouver_reconnaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce regard déterminé, on <w>retrouve</w> le caractère fort de son grand-père."
                        },
                        {
                            "text": "Les lecteurs habituels ne <w>retrouvent</w> plus le style de l'auteur dans son dernier roman."
                        }
                    ],
                    "synonyms": [
                        "reconnaître"
                    ]
                }
            ]
        }
    ]
}