                ],
                "senses": [
                    {
                        "sense_id": "9ae981b5-3db1-35b0-bf1c-4fc7cf0a7572",
                        "entry_id": "488753fe-f295-303a-ab5c-df7e0b7a7ef8",
                        "glosses": [
                            "eine italienische Rotweinrebe, die in Südtirol und im Trentino angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72e98dcf-6e74-4323-b730-be1e5e6705d1",
                                "sense_id": "9ae981b5-3db1-35b0-bf1c-4fc7cf0a7572",
                                "text": "„Auf den Trestern vergoren, ergibt die tiefrote Traube des Lagreins einen ebenso dunklen wie schweren Wein.“"
                            },
                            {
                                "example_id": "932c9efb-1775-42ae-8d05-ef8e7b91f75d",
                                "sense_id": "9ae981b5-3db1-35b0-bf1c-4fc7cf0a7572",
                                "text": "„Lagrein ist eine italienische Rotweintraube, die in Südtirol und im Trentino angebaut wird.“"
                            },
                            {
                                "example_id": "b164a46b-c374-4f88-a8d0-f930322b14df",
                                "sense_id": "9ae981b5-3db1-35b0-bf1c-4fc7cf0a7572",
                                "text": "„Aus der heimischen roten Traube Lagrein werden ein robuster Rotwein mit Brombeeraroma, der sogenannte „Scuro“ (Dunkel) und ein duftender Rosé (Kretzer) bereitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "30c4fd1e-947d-311e-a597-fea9972cddef",
                        "entry_id": "488753fe-f295-303a-ab5c-df7e0b7a7ef8",
                        "glosses": [
                            "ein Wein, der aus Trauben der unter [1] genannten Rotweinrebe hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ba3fd8b-f5a1-494f-a500-2f59815c44b4",
                                "sense_id": "30c4fd1e-947d-311e-a597-fea9972cddef",
                                "text": "Gestern Abend haben wir einen vollmundigen Lagrein getrunken."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
