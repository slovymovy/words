                        "examples": [
                            {
                                "example_id": "122ce12b-ce01-42f6-aa02-32d36a546fe7",
                                "sense_id": "31aa50db-8e8b-360e-9395-48df073eca80",
                                "text": "„Dann schob er das Messer zurück in die Lederscheide und steckte es in die Jackentasche.“"
                            },
                            {
                                "example_id": "1fd52f35-a773-4e6e-b61c-93b294dfccbf",
                                "sense_id": "31aa50db-8e8b-360e-9395-48df073eca80",
                                "text": "„Bannon schob das Messer wieder in die Lederscheide und zündete den Joint an.“"
                            },
                            {
                                "example_id": "58f7f6dc-b307-4850-b5c6-0e6f5d6c3a49",
                                "sense_id": "31aa50db-8e8b-360e-9395-48df073eca80",
                                "text": "„Er zog eine speckige Lederscheide hervor, die er sich um den linken Fußknöchel schnürte.“"
                            },
                            {
                                "example_id": "b0fc3de3-1101-4816-94da-a70df5ac8e74",
                                "sense_id": "31aa50db-8e8b-360e-9395-48df073eca80",
                                "text": "„Sie fühlte die alte Lederscheide des Crysmessers an ihrem Körper und erinnerte sich an die ganze Kette der Bene-Gesserit-Verhaltensweisen, auf die sie hier gestoßen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
