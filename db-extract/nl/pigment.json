                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pigment",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c31fd551-0169-3811-b905-c49c86fd7544",
                                        "entry_id": "e8921bdc-7810-34bb-a0aa-7d7b863606b2",
                                        "glosses": [
                                            "Substance colorante généralement insoluble et se fixant à la surface du support sur lequel on l’applique."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acaac018-aecf-420b-9bd7-c3511f1b044b",
                                                "sense_id": "c31fd551-0169-3811-b905-c49c86fd7544",
                                                "text": "L'impossibilité de la diquaternisation du pigment à diméthyl-aniline dans le cas des colorants azoïques a été démontrée par A. I. Kiprianov."
                                            },
                                            {
                                                "example_id": "f49a4221-625f-4134-80a1-0105aeab422b",
                                                "sense_id": "c31fd551-0169-3811-b905-c49c86fd7544",
                                                "text": "Les pigments sont des poudres, généralement broyées très finement avant d'être mises en suspension dans un liant (ou médium), liquide, plus ou moins fluide, ou visqueux, pour obtenir les peintures, les enduits, ou les encres."
                                            },
                                            {
                                                "example_id": "9eb59c1e-02f1-415d-b93d-a65c53c9e618",
                                                "sense_id": "c31fd551-0169-3811-b905-c49c86fd7544",
                                                "text": "Ah bien sûr, les spécialistes peuvent nous parler de longueurs d'onde ou de pigments, mais la personne lambda qui peinture son salon n'est pas spécialiste, et elle est quand même capable de reconnaître ces couleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f20b446b-9c44-3bc6-b2a6-1c296588d2e3",
                                        "entry_id": "e8921bdc-7810-34bb-a0aa-7d7b863606b2",
                                        "glosses": [
                                            "Molécule responsable de la couleur des tissus et liquides biologiques (e.g. peau, sang, pétales, feuilles)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fdd719b-884d-4592-b090-583ff59edec9",
                                                "sense_id": "f20b446b-9c44-3bc6-b2a6-1c296588d2e3",
                                                "text": "Les mélanines sont les principaux pigments chez l’être humain ; on les retrouve dans la peau, les cheveux et les yeux."
                                            },
                                            {
                                                "example_id": "ec0e562e-a7ad-4c65-a3d0-3ba9d380bf56",
                                                "sense_id": "f20b446b-9c44-3bc6-b2a6-1c296588d2e3",
                                                "text": "L’hémoglobine est le pigment responsable de la couleur rouge du sang."
                                            },
                                            {
                                                "example_id": "2fd9e6ee-d41f-4932-b077-a4c64b4c8d15",
                                                "sense_id": "f20b446b-9c44-3bc6-b2a6-1c296588d2e3",
                                                "text": "Les caroténoïdes sont les pigments qui présentent la plus grande diversité parmi les produits naturels. En 2004, plus de 700 étaient décrits."
                                            },
                                            {
                                                "example_id": "4f9be711-f2d1-4c25-8c03-cca5aeafa843",
                                                "sense_id": "f20b446b-9c44-3bc6-b2a6-1c296588d2e3",
                                                "text": "La chlorophylle est le pigment vert de la feuille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac2922c8-1ca4-34e4-9a88-35011e753ebd",
                                        "entry_id": "e8921bdc-7810-34bb-a0aa-7d7b863606b2",
                                        "glosses": [
                                            "Liqueur douce et riche composée de vin très épicé et adouci par le miel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdb18826-26ca-4296-b038-1235c0d2fc90",
                                                "sense_id": "ac2922c8-1ca4-34e4-9a88-35011e753ebd",
                                                "text": "Oswald, mettez en perce le baril de notre vin le plus vieux ; servez sur la table le meilleur hydromel, l’ale la plus forte, le plus riche morat, le cidre le plus mousseux, les pigments les plus odorants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
