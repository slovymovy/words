                    }
                ],
                "senses": [
                    {
                        "sense_id": "825d946a-c4dc-3ab3-b5af-279c41db3712",
                        "entry_id": "f9cd1b31-013d-36be-bd43-37ae83866d5d",
                        "glosses": [
                            "Abelmoschus moschatus Medik., roślina jednoroczna o wyprostowanych pędach o wysokości jednego metra i żółtych kwiatach, stosowana jako roślina ozdobna, warzywo i zioło"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3f31b99-d3f4-4667-a9b7-cc9c6036fe0b",
                                "sense_id": "825d946a-c4dc-3ab3-b5af-279c41db3712",
                                "text": "Na parapecie pięknie rozkwitła nam okra zasadzona w doniczce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ac6743a0-8483-38d8-8e7b-7b605e3fe2fe",
                        "entry_id": "f9cd1b31-013d-36be-bd43-37ae83866d5d",
                        "glosses": [
                            "niedojrzały owoc okry (1.1) używany jako jarzyna"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e0dd5a-fe62-491c-b20d-d2644a7bd43a",
                                "sense_id": "ac6743a0-8483-38d8-8e7b-7b605e3fe2fe",
                                "text": "Na greckim targowisku kupiliśmy kilogram okry."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "1dac321c-65c2-33cb-b21b-651d89fae196",
                        "entry_id": "f9cd1b31-013d-36be-bd43-37ae83866d5d",
                        "glosses": [
                            "danie z okry (1.2)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6a6751f-bcdd-489a-818f-903bd23031f9",
                                "sense_id": "1dac321c-65c2-33cb-b21b-651d89fae196",
                                "text": "Dzisiaj na obiad przyrządzimy okrę w pomidorach."
                            },
                            {
                                "example_id": "45487869-4b03-494c-bef0-0ad037ed28bc",
                                "sense_id": "1dac321c-65c2-33cb-b21b-651d89fae196",
                                "text": "Kiedy jest okazja do świętowania, jak zdanie egzaminu czy ukończenie eseju, schodzą, żeby zjeść musakę, okrę, taramosalatę, łatę jagnięcą czy ośmiornicę przy drewnianych, lakierowanych stołach, które wyglądają, jakby przyniesiono je tu prosto ze starego żaglowca"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cb16b12-2b24-4bae-8bab-2b451ffc53dd",
                        "source_entry_id": "f9cd1b31-013d-36be-bd43-37ae83866d5d",
                        "source_sense_id": "825d946a-c4dc-3ab3-b5af-279c41db3712",
                        "target_lang_word": "okra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "okra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4530c235-c68f-3b4c-843d-2d7a483420ce",
                                        "entry_id": "6b20e5b8-4707-3b0d-abe2-067a51d17f0d",
                                        "glosses": [
                                            "The edible immature mucilaginous seed pod (properly, capsule) of the Abelmoschus esculentus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d2f2aef-d702-4be7-9da3-cefd752941f5",
                                                "sense_id": "4530c235-c68f-3b4c-843d-2d7a483420ce",
                                                "text": "...as a food easy of digestion may well be admitted likewise the young Ocra an agreeable Food as well for the species as individual, dressed variously according to pleasure..."
                                            },
                                            {
                                                "example_id": "fb3de661-b757-4897-8d34-09d15ba5c4dc",
                                                "sense_id": "4530c235-c68f-3b4c-843d-2d7a483420ce",
                                                "text": "Select young okra, wash thoroughly, remove the stems, and wipe the okra dry."
                                            },
                                            {
                                                "example_id": "1c2bafa0-4714-4601-a817-1b9861d10bc0",
                                                "sense_id": "4530c235-c68f-3b4c-843d-2d7a483420ce",
                                                "text": "Wash and dry okra, remove stems, and slice in one-inch rounds. (If using frozen okra, do not wash.) Heat two tablespoons oil in a heavy saucepan other than black iron. Saute okra in oil and vinegar, stirring often until ropiness is gone."
                                            },
                                            {
                                                "example_id": "8b361097-0134-46b9-bb5e-c55da77698ba",
                                                "sense_id": "4530c235-c68f-3b4c-843d-2d7a483420ce",
                                                "text": "I hated cooking okra because it was so slimy when you first start."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04d50039-9175-3750-aad0-f7596defd395",
                                        "entry_id": "6b20e5b8-4707-3b0d-abe2-067a51d17f0d",
                                        "glosses": [
                                            "The flowering mallow plant Abelmoschus esculentus itself, now commonly grown in the tropics and warmer parts of the temperate zones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02b042a1-ebd5-4c59-a0da-363abd74ff91",
                                                "sense_id": "04d50039-9175-3750-aad0-f7596defd395",
                                                "text": "Ocra, this has a round green stem, which rises straight up to ten or twelve foot high."
                                            },
                                            {
                                                "example_id": "5077ec52-1b65-4dc6-b8e3-71106d6868f3",
                                                "sense_id": "04d50039-9175-3750-aad0-f7596defd395",
                                                "text": "Okra does not do well in tight, waterlogged soils, but will tolerate a soil pH range of from 6.0 to 7.5."
                                            },
                                            {
                                                "example_id": "71e39f9b-51bb-479e-b6a3-468eb2bc62d5",
                                                "sense_id": "04d50039-9175-3750-aad0-f7596defd395",
                                                "text": "We planted some truck crops like watermelons and okra, which was risky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc279724-e6ae-4ae4-8c4b-21474bfe5b63",
                        "source_entry_id": "f9cd1b31-013d-36be-bd43-37ae83866d5d",
                        "source_sense_id": "825d946a-c4dc-3ab3-b5af-279c41db3712",
                        "target_lang_word": "gombo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gombo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7148fd6-5af1-31c3-8925-a3a3fb1aa59f",
                                        "entry_id": "d475f296-df5f-3cdc-b54a-45821bc3e878",
                                        "glosses": [
                                            "Plante à fleurs herbacée annuelle ou bisannuelle tropicale du genre Abelmoschus, de la famille des Malvaceae (Malvacées). Il s'agit en particulier de Abelmoschus callei et de Abelmoschus esculentus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7fccb8-7db7-4ba0-a539-1c647acb1199",
                                                "sense_id": "e7148fd6-5af1-31c3-8925-a3a3fb1aa59f",
                                                "text": "M. Landrin transmet des échantillons d'un nouveau papier.... obtenu avec les fibres d'un végétal très répandu aux colonies et dans les pays chauds, le gombo […] Il fournit ensuite des fruits comestibles qui ne sont pas à dédaigner ; enfin de sa graine il est facile d'extraire une huile qui, si elle ne peut être employée aux usages culinaires, trouverait au moins une application dans l'industrie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0bddc8b-5550-3654-b974-e19e5943bdec",
                                        "entry_id": "d475f296-df5f-3cdc-b54a-45821bc3e878",
                                        "glosses": [
                                            "Son jeune fruit immature consommé comme légume."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f99f78f-7819-4e1d-93f7-bae31a68b5cc",
                                                "sense_id": "a0bddc8b-5550-3654-b974-e19e5943bdec",
                                                "text": "Nous n’avons, pour notre compte, aucun entraînement pour le potage au gombo ; mais cela n’empêche pas que ce brouet verdâtre et filant ne soit en grande réputation en Amérique, et surtout aux Antilles, où la ketmie-gombo est cultivée comme plante potagère… elle est aujourd’hui acclimatée en Algérie."
                                            },
                                            {
                                                "example_id": "8c9138d1-e820-4b7e-9bee-99e3d0eb8ba7",
                                                "sense_id": "a0bddc8b-5550-3654-b974-e19e5943bdec",
                                                "text": "Il est probable qu’Ife, et toute la région de la forêt tropicale ouest-africaine en général, prospéra grâce à la technologie de fusion du fer qui pouvait produire des outils en fer comme la houe et, à son tour, produire de nombreuses récoltes d’aliments tels que le gombo, l’igname, les dattes, l’huile de palme et le poisson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8a8116f-3b1a-32f1-963b-698e0b022ad9",
                                        "entry_id": "d475f296-df5f-3cdc-b54a-45821bc3e878",
                                        "glosses": [
                                            "Pourboire, pot-de-vin, honoraires."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc6dadee-1271-3e21-9e3b-5982e7016d0e",
                                        "entry_id": "d475f296-df5f-3cdc-b54a-45821bc3e878",
                                        "glosses": [
                                            "Ragout originaire de la Louisiane."
                                        ],
                                        "tags": [
                                            "Louisiane"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f289932e-b94f-4956-ae3a-a399d486e8f9",
                                                "sense_id": "bc6dadee-1271-3e21-9e3b-5982e7016d0e",
                                                "text": "Et parce qu’il fait faim à cette heure-là, vous pourrez aussi découvrir le gombo, une sorte de ragoût typique de la Louisiane composé de crustacés et de divers légumes."
                                            },
                                            {
                                                "example_id": "6d680894-5a26-4998-8fc4-5eee5849d47f",
                                                "sense_id": "bc6dadee-1271-3e21-9e3b-5982e7016d0e",
                                                "text": "Le plat emblématique de la Louisiane est le gombo, dont le nom vient de la plante appelée okra en Louisiane."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e6826e1-ce68-4ff7-bcad-7e5d8f156767",
