                },
                {
                    "sense_id": "de3c1b33-a541-35cd-9b4a-8bfdbe43bc1c",
                    "sense_definition": "someone who foolishly overvalues someone else and defers to them, regardless of gender",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obsequious person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a total <w>simp</w> for that celebrity and defends everything they do online.",
                            "target_lang_translations": {
                                "ru": "Он настоящий <w>фанатик</w> этой знаменитости и защищает всё, что она делает в сети."
                            }
                        },
                        {
                            "text": "The politician's supporters were called <w>simps</w> for their blind loyalty.",
                            "target_lang_translations": {
                                "ru": "Сторонников политика называли <w>подпевалами</w> за их слепую преданность."
                            }
