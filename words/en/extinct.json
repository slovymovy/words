{
    "word_family": [
        "extinction",
        "extinctive",
        "extinguish",
        "extinguisher"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5c6e0ff0-cb71-3234-9f1c-d93b4e406242",
                    "sense_definition": "Of an animal or plant species, a family, or a group of people: having died out completely and no longer in existence.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are worried that many rare species will become <w>extinct</w> if we do not protect their habitat.",
                            "target_lang_translations": {
                                "ru": "Ученые обеспокоены тем, что многие редкие виды <w>вымрут</w>, если мы не защитим их среду обитания.",
                                "zh": "科学家们担心，如果我们不保护栖息地，许多稀有物种将会<w>灭绝</w>。"
                            }
                        },
                        {
                            "text": "Dinosaurs have been <w>extinct</w> for millions of years, but we can still study their fossils.",
                            "target_lang_translations": {
                                "ru": "Динозавры являются <w>вымершими</w> уже миллионы лет, но мы все еще можем изучать их окаменелости.",
                                "zh": "恐龙已经<w>灭绝</w>数百万年了，但我们仍然可以研究它们的化石。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vanished",
                        "lost",
                        "gone"
                    ],
                    "antonyms": [
                        "extant",
                        "living",
                        "nonextinct"
                    ],
                    "common_phrases": [
                        "become extinct",
                        "nearly extinct",
                        "extinct species"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относится к видам животных или растений, семьям или группам людей: полностью вымершие и более не существующие.",
                        "zh": "指动物或植物物种、家族或群体：完全死亡，不再存在。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымерший",
                                "target_lang_sense_clarification": "о видах, семьях или группах"
                            },
                            {
                                "target_lang_word": "исчезнувший",
                                "target_lang_sense_clarification": "переставший существовать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灭绝",
                                "target_lang_sense_clarification": "指物种完全消失"
                            },
                            {
                                "target_lang_word": "绝迹",
                                "target_lang_sense_clarification": "指不再有踪迹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d39e245a-1aed-3560-9c55-f3c069961693",
                    "sense_definition": "Of a geological feature, especially a volcano: no longer active or likely to erupt again.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers climbed to the top of the <w>extinct</w> volcano to see the beautiful view.",
                            "target_lang_translations": {
                                "ru": "Альпинисты поднялись на вершину <w>потухшего</w> вулкана, чтобы насладиться прекрасным видом.",
                                "zh": "徒步旅行者爬上了那座<w>死</w>火山的顶峰，去欣赏美丽的景色。"
                            }
                        },
                        {
                            "text": "Unlike an active one, an <w>extinct</w> volcano has not erupted in thousands of years.",
                            "target_lang_translations": {
                                "ru": "В отличие от действующего, <w>потухший</w> вулкан не извергался тысячи лет.",
                                "zh": "与活火山不同，<w>死</w>火山已经几千年没有喷发过了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inactive",
                        "dormant"
                    ],
                    "antonyms": [
                        "active"
                    ],
                    "common_phrases": [
                        "extinct volcano"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относится к геологическим объектам, особенно к вулканам: более не активный и вряд ли извергнется снова.",
                        "zh": "指地质特征，特别是火山：不再活跃或不太可能再次喷发。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потухший",
                                "target_lang_sense_clarification": "о вулкане"
                            },
                            {
                                "target_lang_word": "неактивный",
                                "target_lang_sense_clarification": "геологический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "死",
                                "target_lang_sense_clarification": "指火山不再活动"
                            },
                            {
                                "target_lang_word": "休眠",
                                "target_lang_sense_clarification": "指火山处于静止状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f35a824-45ee-3f60-988a-64dce7237463",
                    "sense_definition": "Of customs, laws, titles, or organizations: no longer in use, valid, or existing; defunct.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The noble title became <w>extinct</w> when the last member of the family died without an heir.",
                            "target_lang_translations": {
                                "ru": "Дворянский титул <w>упразднился</w>, когда последний член семьи умер, не оставив наследника.",
                                "zh": "当家族最后一名成员去世且没有继承人时，这个贵族头衔就<w>废除</w>了。"
                            }
                        },
                        {
                            "text": "Many ancient traditions are now <w>extinct</w> in the modern world.",
                            "target_lang_translations": {
                                "ru": "Многие древние традиции в современном мире уже <w>исчезли</w>.",
                                "zh": "许多古老的传统在现代世界中已经<w>消失</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "defunct",
                        "obsolete",
                        "discontinued",
                        "outdated"
                    ],
                    "antonyms": [
                        "active",
                        "extant"
                    ],
                    "common_phrases": [
                        "become extinct",
                        "now extinct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относится к обычаям, законам, титулам или организациям: более не используемый, недействительный или несуществующий.",
                        "zh": "指习俗、法律、头衔或组织：不再使用、无效或不存在；已废除。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упразднённый",
                                "target_lang_sense_clarification": "о законах или титулах"
                            },
                            {
                                "target_lang_word": "вышедший из употребления",
                                "target_lang_sense_clarification": "об обычаях"
                            },
                            {
                                "target_lang_word": "устаревший",
                                "target_lang_sense_clarification": "неактуальный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "废除",
                                "target_lang_sense_clarification": "指法律或制度不再有效"
                            },
                            {
                                "target_lang_word": "过时",
                                "target_lang_sense_clarification": "指习俗不再流行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5c61daa-01d5-3ab3-bb44-55f449b54a25",
                    "sense_definition": "Of a fire or light: no longer burning or shining; extinguished.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "light_fire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The campfire was <w>extinct</w> by morning, leaving only cold grey ashes behind.",
                            "target_lang_translations": {
                                "ru": "К утру костер <w>погас</w>, оставив после себя лишь холодный серый пепел.",
                                "zh": "到早上时篝火已经<w>熄灭</w>了，只剩下冰冷的灰色灰烬。"
                            }
                        },
                        {
                            "text": "He noticed that the street lamps were <w>extinct</w> due to the power failure.",
                            "target_lang_translations": {
                                "ru": "Он заметил, что уличные фонари <w>погасли</w> из-за сбоя в электросети.",
                                "zh": "他注意到由于停电，路灯都<w>熄灭</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extinguished",
                        "quenched",
                        "out"
                    ],
                    "antonyms": [
                        "alight",
                        "burning"
                    ],
                    "common_phrases": [
                        "not yet extinct"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "More commonly expressed as 'extinguished' or 'out' in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относится к огню или свету: более не горящий и не светящийся; погасший.",
                        "zh": "指火或光：不再燃烧或发光；熄灭。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потухший",
                                "target_lang_sense_clarification": "об огне или свете"
                            },
                            {
                                "target_lang_word": "погасший",
                                "target_lang_sense_clarification": "о пламени или лампе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "熄灭",
                                "target_lang_sense_clarification": "指火或灯光停止燃烧或发光"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9e7af9e-eed7-3bb8-9e68-8470663bdfa8",
                    "sense_definition": "Of feelings, spirits, or a state of affairs: suppressed, quenched, or having come to an end.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All hope for a peaceful resolution seemed <w>extinct</w> after the negotiations failed.",
                            "target_lang_translations": {
                                "ru": "Всякая надежда на мирное решение казалась <w>угасшей</w> после провала переговоров.",
                                "zh": "谈判失败后，和平解决的所有希望似乎都<w>破灭</w>了。"
                            }
                        },
                        {
                            "text": "The old man felt that his passion for life was nearly <w>extinct</w>.",
                            "target_lang_translations": {
                                "ru": "Старик чувствовал, что его страсть к жизни почти <w>угасла</w>.",
                                "zh": "老人感到他对生活的热情几乎<w>消逝</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quenched",
                        "suppressed",
                        "vanished"
                    ],
                    "antonyms": [
                        "active",
                        "living"
                    ],
                    "common_phrases": [
                        "nearly extinct"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used figuratively"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относится к чувствам, духу или положению дел: подавленный, угасший или подошедший к концу.",
                        "zh": "指情感、精神或事态：被压制、平息或已结束。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угасший",
                                "target_lang_sense_clarification": "о чувствах или надежде"
                            },
                            {
                                "target_lang_word": "исчезнувший",
                                "target_lang_sense_clarification": "о состоянии духа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "消逝",
                                "target_lang_sense_clarification": "指情感或希望逐渐消失"
                            },
                            {
                                "target_lang_word": "破灭",
                                "target_lang_sense_clarification": "指希望或梦想彻底终结"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f4fcf0e-96d7-3873-9042-2c5940801e57",
                    "sense_definition": "To <w>extinguish</w>; to put an end to something completely or to destroy it.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law <w>extincted</w> the rights previously held by the local landowners.",
                            "target_lang_translations": {
                                "ru": "Новый закон <w>упразднил</w> права, которыми ранее обладали местные землевладельцы.",
                                "zh": "新法律<w>废除</w>了当地土地所有者先前拥有的权利。"
                            }
                        },
                        {
                            "text": "They sought to <w>extinct</w> all traces of the rebellion before it could spread.",
                            "target_lang_translations": {
                                "ru": "Они стремились <w>искоренить</w> все следы восстания, прежде чем оно успеет распространиться.",
                                "zh": "他们试图在叛乱蔓延之前<w>根除</w>其所有痕迹。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extinguish",
                        "annihilate",
                        "destroy",
                        "abolish"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The verb form is rarely used in modern English; 'extinguish' is preferred."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Погасить; полностью положить конец чему-либо или уничтожить это.",
                        "zh": "熄灭；彻底终结某事或将其摧毁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упразднять",
                                "target_lang_sense_clarification": "права или законы"
                            },
                            {
                                "target_lang_word": "искоренять",
                                "target_lang_sense_clarification": "следы или восстания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "废除",
                                "target_lang_sense_clarification": "指取消权利或法律"
                            },
                            {
                                "target_lang_word": "根除",
                                "target_lang_sense_clarification": "指彻底消除痕迹或叛乱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "82b434fa-7c63-3120-b4b9-2c79df8806a5",
                    "sense_definition": "The state or action of becoming <w>extinct</w>; extinction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>extinct</w> of the species puzzled the biologists for decades.",
                            "target_lang_translations": {
                                "ru": "Внезапное <w>вымирание</w> вида озадачивало биологов на протяжении десятилетий.",
                                "zh": "该物种的突然<w>灭绝</w>让生物学家们困惑了几十年。"
                            }
                        },
                        {
                            "text": "He feared the <w>extinct</w> of his family's long-standing reputation.",
                            "target_lang_translations": {
                                "ru": "Он боялся <w>исчезновения</w> многолетней репутации своей семьи.",
                                "zh": "他担心他家族长期以来的声誉会<w>消亡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extinction",
                        "annihilation"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "The noun form is now replaced by 'extinction'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или процесс становления вымершим; вымирание.",
                        "zh": "变得灭绝的状态或行为；灭绝。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымирание",
                                "target_lang_sense_clarification": "процесс исчезновения вида"
                            },
                            {
                                "target_lang_word": "исчезновение",
                                "target_lang_sense_clarification": "утрата репутации или рода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灭绝",
                                "target_lang_sense_clarification": "指物种消失的过程"
                            },
                            {
                                "target_lang_word": "消亡",
                                "target_lang_sense_clarification": "指家族或声誉的消失"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}