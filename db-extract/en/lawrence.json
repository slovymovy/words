                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d81d99a2-6f17-46cd-a350-e6352b390cda",
                                "sense_id": "dfdc8767-3b7f-3b12-93ef-4c17beea09d3",
                                "text": "\"My name is Richard Lawrence.\"\nCandice thought he had a storybook name. Like Lawrence of Arabia, she said, but what she always called him was Ricky. Just a jump away from Tricky Dicky."
                            }
                        ]
