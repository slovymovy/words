            {
                "entry_id": "6e3b4da4-d461-3c1f-ba4e-c1e59d380dc8",
                "word": "bonhomie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bf7e3de8-da68-4657-8352-d54a82cfdc26",
                        "entry_id": "6e3b4da4-d461-3c1f-ba4e-c1e59d380dc8",
                        "tags": [
                            "plural"
                        ],
                        "form": "bonhomies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8655cdfb-4996-3286-8a8c-c7955ea65c38",
                        "entry_id": "6e3b4da4-d461-3c1f-ba4e-c1e59d380dc8",
                        "glosses": [
                            "A friendly, good-natured, pleasant manner; an affable and approachable disposition; friendliness."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "4b6fae74-986e-4780-9cd5-aaf302fd4a00",
                                "sense_id": "8655cdfb-4996-3286-8a8c-c7955ea65c38",
                                "text": "His ungainly person and awkward manners were against him with men accustomed to the graces of society, and he was not sufficiently at home to give play to his humor and to that bonhomie which won the hearts of all who knew him."
                            },
                            {
                                "example_id": "7501c1e4-5784-4b72-a455-bfb6bca2c52b",
                                "sense_id": "8655cdfb-4996-3286-8a8c-c7955ea65c38",
                                "text": "[T]he unknown Arlo Guthrie takes the stage, ending up in the movie, and – through sheer bonhomie – selling a million copies of Alice's Restaurant."
                            },
                            {
                                "example_id": "ede118ce-ab2d-4020-9049-de26bb32bcba",
                                "sense_id": "8655cdfb-4996-3286-8a8c-c7955ea65c38",
                                "text": "While Mr. Romney was used to being the man in charge, as a former CEO, governor, and presidential nominee, Mr. Curtis has spent the last seven years in Congress quietly developing a reputation for bipartisan bonhomie."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca31c1ce-92d9-3a2b-a005-4d28349858ab",
                        "entry_id": "6e3b4da4-d461-3c1f-ba4e-c1e59d380dc8",
                        "glosses": [
                            "An atmosphere of friendliness and good cheer."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
