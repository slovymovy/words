                "senses": [
                    {
                        "sense_id": "c7e5c356-c338-3543-943c-00b7aedaaad0",
                        "entry_id": "fbcf6b65-1b6c-32d7-970c-bde7eeea501e",
                        "glosses": [
                            "kleiner Himmelskörper im Sonnensystem mit einer Umlaufbahn um die Sonne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d57f4c1c-4f06-492b-bb0b-acdcde63626b",
                                "sense_id": "c7e5c356-c338-3543-943c-00b7aedaaad0",
                                "text": "„Gelangt ein Meteoroid ohne in der Atmosphäre vollständig zu verglühen auf die Erdoberfläche, bezeichnet man ihn als Meteorit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "113dd683-6321-40f2-9caa-6e93d328b3cb",
                        "source_entry_id": "fbcf6b65-1b6c-32d7-970c-bde7eeea501e",
                        "source_sense_id": "c7e5c356-c338-3543-943c-00b7aedaaad0",
                        "source_sense_description": "kleiner Himmelskörper im Sonnensystem mit einer Umlaufbahn um die Sonne",
                        "target_lang_word": "meteoroid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meteoroid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d5892a6-e355-3463-9869-51d6172e6e95",
                                        "entry_id": "76fddf78-cdcc-3af6-8750-b3e10ddfba9a",
                                        "glosses": [
                                            "A relatively small (sand- to boulder-sized) fragment of debris in a star system that produces a meteor when it hits the atmosphere"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61f76f9f-8851-4abb-b2ab-c93d815e78e3",
                        "source_entry_id": "fbcf6b65-1b6c-32d7-970c-bde7eeea501e",
                        "source_sense_id": "c7e5c356-c338-3543-943c-00b7aedaaad0",
                        "source_sense_description": "kleiner Himmelskörper im Sonnensystem mit einer Umlaufbahn um die Sonne",
                        "target_lang_word": "météoroïde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "météoroïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04e0c40a-fce6-3135-a8c9-6fecf85143d2",
                                        "entry_id": "8c8da172-96d9-30a4-8a45-936cd3f397d8",
                                        "glosses": [
                                            "Petit objet céleste, conventionnellement entre 30 microns et 1 mètre, provenant de la désintégration d’un astéroïde ou d’un noyau cométaire, et appelé météorite lorsqu’il s’écrase sur un corps céleste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c39028c-8db8-466f-89be-63eac70cf0f9",
                                                "sense_id": "04e0c40a-fce6-3135-a8c9-6fecf85143d2",
                                                "text": "L'intensité de la lumière dépend de la violence du choc, et par conséquent de la direction relative du météoroïde avant le choc."
                                            },
                                            {
                                                "example_id": "47bd7ddf-be09-4eb2-992b-5b9ca70059f4",
                                                "sense_id": "04e0c40a-fce6-3135-a8c9-6fecf85143d2",
                                                "text": "En plus des astéroïdes, le système solaire est peuplé d’innombrables corps de dimension plus réduite, de moins d’un mètre de diamètre pour se fixer les idées, appelés météoroïdes. Étant donné leur faible dimension, ces corps sont totalement invisibles depuis la Terre."
                                            },
                                            {
                                                "example_id": "79338b8a-87f2-4b26-9019-ab8d48e03ec4",
                                                "sense_id": "04e0c40a-fce6-3135-a8c9-6fecf85143d2",
                                                "text": "L'orbite du météoroïde autour du Soleil est tout à fait donnée quand on connait ces trois choses : le temps de l'entrée dans l'air, la direction du mouvement et la vitesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
