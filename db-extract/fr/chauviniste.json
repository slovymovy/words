                "senses": [
                    {
                        "sense_id": "d4611f27-00dc-3692-af59-01224a613b8e",
                        "entry_id": "ee73ac7d-5d59-3851-b7a7-1f3193c1e5b3",
                        "glosses": [
                            "Qui a rapport au chauvinisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e23ea49e-7d1c-4535-84c8-f55b56fc0b8d",
                                "sense_id": "d4611f27-00dc-3692-af59-01224a613b8e",
                                "text": "Les Américains qui n'ont pas encore visité l'Europe, seront bien forcés, après une promenade dans les sections étrangères [de l'exposition de Philadelphie], de revenir de leur idée chauviniste, à savoir que le Yankee est un être universel, supérieur à tous les autres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6c3f53e-bafc-4250-aba5-37a50fd27285",
                        "source_entry_id": "ee73ac7d-5d59-3851-b7a7-1f3193c1e5b3",
