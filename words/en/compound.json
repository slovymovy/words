{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8cff67b8-ebce-370d-9a58-167eacec7375",
                    "sense_definition": "A substance formed by chemical bonding of two or more elements in definite proportions by weight.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chemistry_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water is a chemical <w>compound</w> of hydrogen and oxygen.",
                            "target_lang_translations": {
                                "ru": "Вода — это химическое <w>соединение</w> водорода и кислорода.",
                                "tr": "Su, hidrojen ve oksijenin kimyasal bir <w>bileşiğidir</w>.",
                                "zh": "水是氢和氧的化学<w>化合物</w>。"
                            }
                        },
                        {
                            "text": "Salt is a common <w>compound</w> found in nature.",
                            "target_lang_translations": {
                                "ru": "Соль — это распространенное <w>соединение</w>, встречающееся в природе.",
                                "tr": "Tuz, doğada yaygın olarak bulunan bir <w>bileşiktir</w>.",
                                "zh": "盐是自然界中常见的一种<w>化合物</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chemical compound",
                        "organic compound"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical (Chemistry)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, образованное химическим связыванием двух или более элементов в определенных весовых пропорциях.",
                        "tr": "İki veya daha fazla elementin belirli ağırlık oranlarında kimyasal olarak bağlanmasıyla oluşan madde.",
                        "zh": "由两种或多种元素按一定重量比例化学结合而成的物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соединение",
                                "target_lang_sense_clarification": "химическое"
                            },
                            {
                                "target_lang_word": "химическое соединение",
                                "target_lang_sense_clarification": "полный термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bileşik",
                                "target_lang_sense_clarification": "kimyasal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "化合物",
                                "target_lang_sense_clarification": "化学物质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "240fb016-8f5f-3805-b2b9-000127cde76d",
                    "sense_definition": "A group of buildings situated close together, often enclosed by a barrier or wall.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "place_enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The embassy <w>compound</w> is guarded by soldiers day and night.",
                            "target_lang_translations": {
                                "ru": "<w>Территория</w> посольства охраняется солдатами день и ночь.",
                                "tr": "Büyükelçilik <w>yerleşkesi</w> gece gündüz askerler tarafından korunmaktadır.",
                                "zh": "大使馆<w>大院</w>日夜都有士兵守卫。"
                            }
                        },
                        {
                            "text": "They live in a secure <w>compound</w> just outside the city center.",
                            "target_lang_translations": {
                                "ru": "Они живут в охраняемом жилом <w>комплексе</w> прямо за центром города.",
                                "tr": "Şehir merkezinin hemen dışında güvenli bir <w>sitede</w> yaşıyorlar.",
                                "zh": "他们住在市中心外一个安全的<w>园区</w>里。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "military compound",
                        "prison compound",
                        "gated compound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа зданий, расположенных близко друг к другу, часто огороженная стеной или забором.",
                        "tr": "Birbirine yakın inşa edilmiş, genellikle bir çit veya duvarla çevrili binalar grubu, yerleşke.",
                        "zh": "一组彼此靠近的建筑物，通常由围栏或墙壁包围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплекс",
                                "target_lang_sense_clarification": "группа зданий"
                            },
                            {
                                "target_lang_word": "огороженная территория",
                                "target_lang_sense_clarification": "участок земли"
                            },
                            {
                                "target_lang_word": "компаунд",
                                "target_lang_sense_clarification": "жилой комплекс, часто для иностранцев"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yerleşke",
                                "target_lang_sense_clarification": "bina grubu veya tesis"
                            },
                            {
                                "target_lang_word": "siteler grubu",
                                "target_lang_sense_clarification": "etrafı çevrili alan"
                            },
                            {
                                "target_lang_word": "kompleks",
                                "target_lang_sense_clarification": "korunaklı bina topluluğu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大院",
                                "target_lang_sense_clarification": "围墙内的建筑群"
                            },
                            {
                                "target_lang_word": "园区",
                                "target_lang_sense_clarification": "特定功能的建筑群"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab2e57c6-1ddc-3ee8-a49f-4df880c9c7da",
                    "sense_definition": "Anything made by combining several things.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mixture_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air we breathe is a <w>compound</w> of various gases.",
                            "target_lang_translations": {
                                "ru": "Воздух, которым мы дышим, представляет собой <w>смесь</w> различных газов.",
                                "tr": "Soluduğumuz hava çeşitli gazların bir <w>karışımıdır</w>.",
                                "zh": "我们呼吸的空气是多种气体的<w>混合物</w>。"
                            }
                        },
                        {
                            "text": "His character was a curious <w>compound</w> of arrogance and insecurity.",
                            "target_lang_translations": {
                                "ru": "Его характер был любопытным <w>сочетанием</w> высокомерия и неуверенности.",
                                "tr": "Onun karakteri, kibir ve güvensizliğin ilginç bir <w>kombinasyonuydu</w>.",
                                "zh": "他的性格是傲慢与不安的奇特<w>结合体</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mixture",
                        "blend",
                        "combination",
                        "mix"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо, созданное путем соединения нескольких вещей.",
                        "tr": "Birden fazla şeyin birleştirilmesiyle oluşturulan her türlü şey, karışım.",
                        "zh": "由多种事物组合而成的任何东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смесь",
                                "target_lang_sense_clarification": "комбинация веществ"
                            },
                            {
                                "target_lang_word": "сочетание",
                                "target_lang_sense_clarification": "комбинация качеств или свойств"
                            },
                            {
                                "target_lang_word": "сплав",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karışım",
                                "target_lang_sense_clarification": "genel kombinasyon"
                            },
                            {
                                "target_lang_word": "bileşim",
                                "target_lang_sense_clarification": "unsurların bir araya gelmesi"
                            },
                            {
                                "target_lang_word": "kombinasyon",
                                "target_lang_sense_clarification": "farklı niteliklerin birleşimi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混合物",
                                "target_lang_sense_clarification": "多种成分的组合"
                            },
                            {
                                "target_lang_word": "结合体",
                                "target_lang_sense_clarification": "多种特质的融合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b30de0c-5cd7-3df4-b115-b6f2ef15bdb6",
                    "sense_definition": "A word that consists of more than one stem.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English, the word 'notebook' is a <w>compound</w>.",
                            "target_lang_translations": {
                                "ru": "В английском языке слово 'notebook' — это <w>сложное слово</w>.",
                                "tr": "İngilizcede 'notebook' kelimesi bir <w>birleşik sözcüktür</w>.",
                                "zh": "在英语中，单词“notebook”是一个<w>复合词</w>。"
                            }
                        },
                        {
                            "text": "German is famous for its long <w>compounds</w>.",
                            "target_lang_translations": {
                                "ru": "Немецкий язык славится своими длинными <w>сложными словами</w>.",
                                "tr": "Almanca, uzun <w>birleşik kelimeleriyle</w> ünlüdür.",
                                "zh": "德语以其长<w>复合词</w>而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compound word"
                    ],
                    "common_phrases": [
                        "compound noun"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical (Linguistics)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово, состоящее из более чем одной основы.",
                        "tr": "Birden fazla gövde veya kelimeden oluşan sözcük.",
                        "zh": "由一个以上词根组成的词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложное слово",
                                "target_lang_sense_clarification": "лингвистика"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "birleşik kelime",
                                "target_lang_sense_clarification": "dil bilgisi"
                            },
                            {
                                "target_lang_word": "birleşik sözcük",
                                "target_lang_sense_clarification": "dil bilgisi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复合词",
                                "target_lang_sense_clarification": "语言学"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c3a1577c-32e1-3ec7-aecd-af0cb4685aa8",
                    "sense_definition": "Composed of two or more parts or elements; not simple.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "adjective_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>compound</w> sentence contains at least two independent clauses.",
                            "target_lang_translations": {
                                "ru": "<w>Сложносочинённое</w> предложение содержит как минимум два независимых простых предложения.",
                                "tr": "<w>Birleşik</w> bir cümle en az iki bağımsız yan cümle içerir.",
                                "zh": "一个<w>复合</w>句至少包含两个独立分句。"
                            }
                        },
                        {
                            "text": "He suffered a <w>compound</w> fracture in his leg while skiing.",
                            "target_lang_translations": {
                                "ru": "Он получил <w>открытый</w> перелом ноги во время катания на лыжах.",
                                "tr": "Kayak yaparken bacağında <w>açık</w> bir kırık oluştu.",
                                "zh": "他滑雪时腿部遭受了<w>开放性</w>骨折。"
                            }
                        }
                    ],
                    "synonyms": [
                        "composite"
                    ],
                    "antonyms": [
                        "simple"
                    ],
                    "common_phrases": [
                        "compound fracture",
                        "compound sentence",
                        "compound leaf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из двух или более частей или элементов; не простой.",
                        "tr": "İki veya daha fazla parçadan veya elementten oluşan; basit olmayan, birleşik.",
                        "zh": "由两个或多个部分或元素组成；非简单的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сложный",
                                "target_lang_sense_clarification": "составной, не простой"
                            },
                            {
                                "target_lang_word": "составной",
                                "target_lang_sense_clarification": "из частей"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "birleşik",
                                "target_lang_sense_clarification": "birden fazla parçadan oluşan"
                            },
                            {
                                "target_lang_word": "bileşik",
                                "target_lang_sense_clarification": "karmaşık veya çok parçalı"
                            },
                            {
                                "target_lang_word": "açık",
                                "target_lang_sense_clarification": "kırıklar için (açık kırık)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复合的",
                                "target_lang_sense_clarification": "由多部分组成"
                            },
                            {
                                "target_lang_word": "复杂的",
                                "target_lang_sense_clarification": "非简单的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "103a0812-54b4-307e-9b86-8b7e7ad25fa1",
                    "sense_definition": "To make a difficult situation or negative feeling worse.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "verb_worsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His refusal to apologize only <w>compounded</w> the problem.",
                            "target_lang_translations": {
                                "ru": "Его отказ извиняться лишь <w>усугубил</w> проблему.",
                                "tr": "Özür dilemeyi reddetmesi sorunu sadece daha da <w>kötüleştirdi</w>.",
                                "zh": "他拒绝道歉只会<w>加剧</w>问题。"
                            }
                        },
                        {
                            "text": "Severe weather <w>compounded</w> the misery of the refugees.",
                            "target_lang_translations": {
                                "ru": "Суровая погода <w>усугубила</w> страдания беженцев.",
                                "tr": "Çetin hava koşulları mültecilerin ızdırabını daha da <w>derinleştirdi</w>.",
                                "zh": "恶劣的天气<w>加剧</w>了难民的苦难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "make matters worse"
                    ],
                    "common_phrases": [
                        "compound the problem",
                        "compound the issue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать трудную ситуацию или негативное чувство еще хуже.",
                        "tr": "Zor bir durumu veya olumsuz bir duyguyu daha da kötüleştirmek, katmerleştirmek.",
                        "zh": "使困难的情况或负面情绪变得更糟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усугублять",
                                "target_lang_sense_clarification": "делать хуже"
                            },
                            {
                                "target_lang_word": "осложнять",
                                "target_lang_sense_clarification": "делать сложнее"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kötüleştirmek",
                                "target_lang_sense_clarification": "durumu zorlaştırmak"
                            },
                            {
                                "target_lang_word": "derinleştirmek",
                                "target_lang_sense_clarification": "sorunu artırmak"
                            },
                            {
                                "target_lang_word": "katmerlemek",
                                "target_lang_sense_clarification": "sorun veya sıkıntıyı büyütmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加剧",
                                "target_lang_sense_clarification": "使情况恶化"
                            },
                            {
                                "target_lang_word": "恶化",
                                "target_lang_sense_clarification": "使问题更严重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2434e8e-127f-3c33-9e4b-5d597cc2e6d1",
                    "sense_definition": "To calculate interest on both the principal sum and the accumulated interest.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The interest on this savings account <w>compounds</w> monthly.",
                            "target_lang_translations": {
                                "ru": "Проценты по этому сберегательному счету <w>капитализируются</w> ежемесячно.",
                                "tr": "Bu tasarruf hesabının faizi aylık olarak <w>bileşik faiz getirir</w>.",
                                "zh": "这个储蓄账户的利息按月<w>复利</w>计算。"
                            }
                        },
                        {
                            "text": "Credit card debt can grow quickly because the interest <w>compounds</w>.",
                            "target_lang_translations": {
                                "ru": "Долг по кредитной карте может быстро расти, потому что начисляются <w>сложные проценты</w>.",
                                "tr": "Kredi kartı borcu hızlı bir şekilde büyüyebilir çünkü faiz <w>bileşik olarak katlanır</w>.",
                                "zh": "信用卡债务增长很快，因为利息会<w>复利</w>计算。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "compound interest"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical (Finance)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начислять проценты как на основную сумму, так и на накопленные проценты.",
                        "tr": "Hem anapara hem de birikmiş faiz üzerinden faiz hesaplamak.",
                        "zh": "对本金和已累积的利息同时计算利息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начислять сложные проценты",
                                "target_lang_sense_clarification": "финансы"
                            },
                            {
                                "target_lang_word": "капитализировать",
                                "target_lang_sense_clarification": "о процентах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bileşik faiz getirmek",
                                "target_lang_sense_clarification": "finans"
                            },
                            {
                                "target_lang_word": "bileşik olarak katlanmak",
                                "target_lang_sense_clarification": "faiz için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复利",
                                "target_lang_sense_clarification": "金融计算"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "303be380-77ba-370f-a713-2a5e2107cbf8",
                    "sense_definition": "To form a mixture by combining different elements or ingredients.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_mix",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pharmacist <w>compounded</w> the medicine specially for the patient.",
                            "target_lang_translations": {
                                "ru": "Фармацевт <w>изготовил</w> лекарство специально для пациента.",
                                "tr": "Eczacı ilacı hasta için özel olarak <w>hazırladı</w>.",
                                "zh": "药剂师为该患者专门<w>配制</w>了药物。"
                            }
                        },
                        {
                            "text": "Various ingredients were <w>compounded</w> to create the new flavor.",
                            "target_lang_translations": {
                                "ru": "Различные ингредиенты были <w>смешаны</w> для создания нового вкуса.",
                                "tr": "Yeni lezzeti oluşturmak için çeşitli malzemeler <w>karıştırıldı</w>.",
                                "zh": "各种成分被<w>混合</w>在一起以创造出新的口味。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mix",
                        "combine",
                        "blend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образовывать смесь, соединяя различные элементы или ингредиенты.",
                        "tr": "Farklı elementleri veya bileşenleri bir araya getirerek bir karışım veya ilaç hazırlamak.",
                        "zh": "通过结合不同的元素或成分来形成混合物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смешивать",
                                "target_lang_sense_clarification": "соединять ингредиенты"
                            },
                            {
                                "target_lang_word": "составлять",
                                "target_lang_sense_clarification": "рецепт или лекарство"
                            },
                            {
                                "target_lang_word": "изготавливать",
                                "target_lang_sense_clarification": "лекарство"
                            }
