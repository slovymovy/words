                    {
                        "translation_id": "1b96c368-58a3-4578-83e4-13aed8802faa",
                        "source_entry_id": "325af7e3-c4e7-32fd-84f9-9bb5760b1262",
                        "source_sense_description": "relating to an ellipse or its mathematical definition",
                        "target_lang_word": "elliptique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elliptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de2dea7a-0821-3fa7-b445-60a16c195186",
                                        "entry_id": "37a00635-2138-3c3d-8562-1fae2d3d2db8",
                                        "glosses": [
                                            "Qui renferme une ellipse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6f5f1fa-c35e-4901-a920-9ffefd10e4e5",
                                                "sense_id": "de2dea7a-0821-3fa7-b445-60a16c195186",
                                                "text": "Autant pour moi est une locution de modestie, avec un brin d’autodérision. Elle est elliptique et signifie : « Je ne suis pas meilleur qu'un autre, j'ai autant d'erreurs que vous à mon service : autant pour moi. »"
                                            },
                                            {
                                                "example_id": "00643ae3-fd40-4acd-b354-34481be6ab50",
                                                "sense_id": "de2dea7a-0821-3fa7-b445-60a16c195186",
                                                "text": "L’écriture elliptique, presque envoûtante, de Marguerite Duras transporte le lecteur dans des régions inconnues, ce qui provoque une sensation de malaise."
                                            },
                                            {
                                                "example_id": "770e7365-f91b-4781-a521-d18872684407",
                                                "sense_id": "de2dea7a-0821-3fa7-b445-60a16c195186",
                                                "text": "Ailleurs, [les pierres tombales] s’étaient résorbées, contractant encore l’elliptique inscription latine, introduisant un caprice de plus dans la disposition de ces caractères abrégés, rapprochant deux lettres d’un mot dont les autres avaient été démesurément distendues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4eba0ff-5dcf-3e8d-89ae-fc7222829f96",
                                        "entry_id": "37a00635-2138-3c3d-8562-1fae2d3d2db8",
                                        "glosses": [
                                            "Qui a la forme de l’ellipse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebef6a2c-303e-425b-81fd-499a73a38929",
                                                "sense_id": "b4eba0ff-5dcf-3e8d-89ae-fc7222829f96",
                                                "text": "L'appareil enrouleur est de différents types: la commande se fait soit à filet croisé, soit à crémaillère, soit par roues elliptiques et excentriques."
                                            },
                                            {
                                                "example_id": "c1738792-5486-40d9-a430-34828b565aad",
                                                "sense_id": "b4eba0ff-5dcf-3e8d-89ae-fc7222829f96",
                                                "text": "Et il y a aussi Chiron, découvert très récemment et dont l'orbite fortement elliptique se situe entre celles de Saturne et d'Uranus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "305a9deb-cf26-3b1e-9e1d-609c8e024fc0",
                                        "entry_id": "37a00635-2138-3c3d-8562-1fae2d3d2db8",
                                        "glosses": [
                                            "Concis, condensé, succinct."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a6edf2d-1cf4-4628-80ff-57300457be9a",
                                                "sense_id": "305a9deb-cf26-3b1e-9e1d-609c8e024fc0",
                                                "text": "D’un geste elliptique, le cousin évoqua des contrées lointaines."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elliptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5269dec5-54f4-3cec-aa7c-95f0fe2f43b3",
                                        "entry_id": "ec0fcfd1-ea65-30cf-8981-09d0dc6c1832",
                                        "glosses": [
                                            "Simulateur-ergomètre elliptique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec6d4ca5-748f-4e1e-a099-d5c39abc4e05",
                        "source_entry_id": "325af7e3-c4e7-32fd-84f9-9bb5760b1262",
                        "source_sense_description": "relating to an ellipse or its mathematical definition",
                        "target_lang_word": "elliptisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elliptisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53e6c0c3-725d-3e78-b2d0-50bf44e8fece",
                                        "entry_id": "8614ee22-ff88-3b75-a9a9-e01aadb84058",
                                        "glosses": [
                                            "in Form einer Ellipse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b830c95f-a181-490e-9783-dc76e1ab2753",
                                                "sense_id": "53e6c0c3-725d-3e78-b2d0-50bf44e8fece",
                                                "text": "Eine originelle Lösung sind elliptische Visitenkarten."
                                            },
                                            {
                                                "example_id": "528060f1-b971-4ce1-b807-a75a7793d9b1",
                                                "sense_id": "53e6c0c3-725d-3e78-b2d0-50bf44e8fece",
                                                "text": "„Am nächsten Tag hatte er, trotz seiner Kopfschmerzen, eine lange Unterredung im elliptisch geformten Arbeitszimmer des Präsidenten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4ce85537-8b2d-321a-8ef3-8b7f14f29489",
                                        "entry_id": "8614ee22-ff88-3b75-a9a9-e01aadb84058",
                                        "glosses": [
                                            "syntaktisch notwendige Satzteile auslassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0d07e05-a6b6-460f-8e1f-3f29d3f58b9d",
                                                "sense_id": "4ce85537-8b2d-321a-8ef3-8b7f14f29489",
                                                "text": "Comics weisen häufig einen elliptischen Sprachstil auf."
                                            },
                                            {
                                                "example_id": "f0326682-1474-42ae-bc27-b9a5cfd84a4c",
                                                "sense_id": "4ce85537-8b2d-321a-8ef3-8b7f14f29489",
                                                "text": "„Wegen der elliptischen Ausdrucksweise der syntaxarmen Runeneinschriften bleibt oft unklar, in welcher Beziehung die genannten Personen (Frauen und Männer) zueinander gestanden haben, ob sich Schenker, Besitzer, Hersteller oder Runenritzer nennen.“"
                                            },
                                            {
                                                "example_id": "82f38bfc-cc8a-43b1-86c1-1033e37b7753",
                                                "sense_id": "4ce85537-8b2d-321a-8ef3-8b7f14f29489",
                                                "text": "„All diese Texte sind gerade deshalb elliptisch formuliert, weil, was sprachlich scheinbar fehlt, aus der visuellen Gestaltung und Umgebung hervorgeht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
