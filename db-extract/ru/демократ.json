                                        "glosses": [
                                            "Démocratique, qui relève de la démocratie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ac0adbe-6964-4981-b992-9d4689ffe84e",
                                                "sense_id": "fd67e928-a809-344f-80b9-9599a3ad4c8c",
