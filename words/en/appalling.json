                            },
                            {
                                "target_lang_word": "beroerd",
                                "target_lang_sense_clarification": "Iets dat erg slecht of onvoldoende is."
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极差",
                                "target_lang_sense_clarification": "形容质量或表现处于极低水平。"
                            },
                            {
                                "target_lang_word": "糟糕透顶",
                                "target_lang_sense_clarification": "形容情况或表现非常糟糕。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
