                    },
                    {
                        "translation_id": "baccae0b-395b-4084-9757-eab34923f41e",
                        "source_entry_id": "71958e89-a963-3a7b-8667-fa60736b2d85",
                        "source_sense_id": "28816adf-8764-3768-a46d-a5c5902b9c54",
                        "target_lang_word": "subject matter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subject matter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2188d737-79e1-3a4f-8852-86620774b2c4",
                                        "entry_id": "a0607c79-7b5f-3dea-802d-7dc838cc0b7e",
                                        "glosses": [
                                            "The matter or thought presented for consideration in some statement or discussion; that which is made the object of thought or study."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fc9ea18-dc5b-4963-badb-2b25b609fcbb",
                                                "sense_id": "2188d737-79e1-3a4f-8852-86620774b2c4",
                                                "text": "The appearance of the book is as unattractive as its subject-matter. It has been reproduced from typescript by photolithography, as many theses are in these days of expensive printing; but the copy photographed has been carelessly typed on a machine with a defective spacing-mechanism and a number of damaged characters; to make matters worse, the typist has failed to keep the type clean."
                                            },
                                            {
                                                "example_id": "d124babe-cdf4-4779-8c9a-f8172b0b34d0",
                                                "sense_id": "2188d737-79e1-3a4f-8852-86620774b2c4",
                                                "text": "When it was released in 2005, Brokeback Mountain entered the collective consciousness in a way that is vanishingly rare for a film with queer subject matter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aaa192a8-1659-4cba-9c50-5762d98b4ba8",
                        "source_entry_id": "71958e89-a963-3a7b-8667-fa60736b2d85",
                        "source_sense_id": "28816adf-8764-3768-a46d-a5c5902b9c54",
                        "target_lang_word": "sujets",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sujets",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e52f600a-0be2-3e8a-9f31-0009da6500b9",
                                        "entry_id": "579f2b16-0436-35d7-a28a-00f9719fd000",
                                        "glosses": [
                                            "Masculin pluriel de sujet."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38cffb8c-41a4-470c-9be4-29042897328f",
                                                "sense_id": "e52f600a-0be2-3e8a-9f31-0009da6500b9",
                                                "text": "Il faut user de beaucoup de précautions, soit pour cémenter, soit pour décémenter les lames des manches de ces sortes de couteaux, sujets à se fendre ou à se casser par la trop grande chaleur, ou de la lame, ou de la soie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sujets",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad5127fa-a888-3e94-82ca-e7bfef526d72",
                                        "entry_id": "841b8c8c-7d04-3bdd-94c7-0878837f8b02",
                                        "glosses": [
                                            "Pluriel de sujet."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7337e758-ce40-46c5-9830-3359cb8f8234",
                                                "sense_id": "ad5127fa-a888-3e94-82ca-e7bfef526d72",
                                                "text": "Un objet n’« afforde » pas la même chose en fonction des sujets (et même, pour un sujet identique, il peut ne pas afforder de la même manière selon le contexte) : dans un jeu vidéo, un joueur expérimenté ne comprend pas les objets de la même manière qu’un novice (le premier saura que la tortue est également portable et peut servir d’arme, alors que le second n’en comprendra qu’une menace), tout comme deux joueurs expérimentés peuvent ne pas les comprendre identiquement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8142e78a-212e-4915-993b-9e7ff798bb8a",
                        "source_entry_id": "71958e89-a963-3a7b-8667-fa60736b2d85",
                        "source_sense_id": "28816adf-8764-3768-a46d-a5c5902b9c54",
