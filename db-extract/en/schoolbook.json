                    {
                        "translation_id": "8672803e-cc19-411d-862d-5c8e5f9c9f6a",
                        "source_entry_id": "87d213b8-fd3b-3016-aee6-0bf262edd9ec",
                        "source_sense_id": "f20837ae-7604-3e43-bf78-7d0c09202d35",
