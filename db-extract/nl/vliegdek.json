                                "sense_id": "99697ee6-f8c0-38c0-bd0f-844f528e3807",
                                "text": "Het vliegdekje van het vliegdekschip is uitgerust met geavanceerde apparatuur voor vliegoperaties.",
                                "translation": "The flight deck of the aircraft carrier is equipped with advanced equipment for flight operations.",
                                "english": "The flight deck of the aircraft carrier is equipped with advanced equipment for flight operations."
                            },
                            {
                                "example_id": "b217a515-e0d0-4361-b102-5573238724fb",
                                "sense_id": "99697ee6-f8c0-38c0-bd0f-844f528e3807",
                                "text": "Tijdens de landing moeten de vliegtuigen veilig landen op het bewegende vliegdek.",
                                "translation": "During landing, the airplanes must safely land on the moving flight deck.",
                                "english": "During landing, the airplanes must safely land on the moving flight deck."
