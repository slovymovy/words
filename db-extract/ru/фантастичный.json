                    }
                ],
                "senses": [
                    {
                        "sense_id": "ae07289e-0940-30ee-ab1a-3b0dffcda4a5",
                        "entry_id": "99d86730-8a78-3bec-9d78-ef9d1289bd59",
                        "glosses": [
                            "то же, что фантастический"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0521af87-c59f-49e3-b1e3-260fe00196c1",
                                "sense_id": "ae07289e-0940-30ee-ab1a-3b0dffcda4a5",
                                "text": "Если, например, видит необходимость быть фантастичным, оригинальным, понеобыденнее, то фантазия его, самая глупая и неестественная, слагается из заранее принятых и давно уже́ опошлившихся форм."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20405136-117b-4091-9946-05b9c61eb600",
                        "source_entry_id": "99d86730-8a78-3bec-9d78-ef9d1289bd59",
                        "source_sense_id": "ae07289e-0940-30ee-ab1a-3b0dffcda4a5",
                        "target_lang_word": "fantastic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fantastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13935912-4cec-344c-ad69-fc0b6dbc363f",
                                        "entry_id": "be82cb03-1793-39b8-a505-adabe33f79b7",
                                        "glosses": [
                                            "Wonderful; marvelous; excellent; extraordinarily good or great (used especially as an intensifier)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc012c8e-07d5-4f65-885c-0e04d055fd64",
                                                "sense_id": "13935912-4cec-344c-ad69-fc0b6dbc363f",
                                                "text": "\"I had a simply fantastic vacation, and I can't wait to tell you all about it!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9edaafd-089b-32bd-a938-e932a59de410",
                                        "entry_id": "be82cb03-1793-39b8-a505-adabe33f79b7",
                                        "glosses": [
                                            "Existing in or constructed from fantasy; of or relating to fantasy; fanciful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e364d8a-b0ba-4337-bcd6-43a22a6b8ab2",
                                                "sense_id": "b9edaafd-089b-32bd-a938-e932a59de410",
                                                "text": "He told fantastic stories of dragons and goblins."
                                            },
                                            {
                                                "example_id": "e761d26d-98bc-44f0-86c3-a9b32139df4e",
                                                "sense_id": "b9edaafd-089b-32bd-a938-e932a59de410",
                                                "text": "His fantastic post-college plans had all collapsed within a year of graduation."
                                            },
                                            {
                                                "example_id": "507bcc24-5a15-48a8-8da4-1580272484d6",
                                                "sense_id": "b9edaafd-089b-32bd-a938-e932a59de410",
                                                "text": "She had a fantastic view of her own importance that none of her colleagues shared."
                                            },
                                            {
                                                "example_id": "b77289d4-910c-4739-b9e2-1356ff2afb4d",
                                                "sense_id": "b9edaafd-089b-32bd-a938-e932a59de410",
                                                "text": "At the base of the whole process by which divinities and demons were created, and rites for their propitiation and placation established, lay Fear - fear stimulating the imagination to fantastic activity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f63e263e-3eb2-310d-b5f8-22571536d7f1",
                                        "entry_id": "be82cb03-1793-39b8-a505-adabe33f79b7",
                                        "glosses": [
                                            "Not believable; implausible; seemingly only possible in fantasy."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee9d5d48-037a-4dc7-829a-5734bbd1d66f",
                                                "sense_id": "f63e263e-3eb2-310d-b5f8-22571536d7f1",
                                                "text": "And indeed, when in the writings of Paracelſus I meet with ſuch Phantaſtick and Un-intelligible Diſcourſes as that Writer often puzzels and tyres his Reader with, father'd upon ſuch excellent Experiments, as though he ſeldom clearly teaches, I often find he knew ; me thinks the Chymiſts, in their ſearches after truth, are not unlike the Navigators of Solomons Tarſhiſh Fleet, who brought home from their long and tedious Voyages, not only Gold, and Silver, and Ivory, but Apes and Peacocks too ; For ſo the Writings of ſeveral (for I ſay not, all) of your Hermetick Philoſophers preſent us, together with divers Subſtantial and noble Experiments, Theories, which either like Peacocks feathers make a great ſhew, but are neither ſolid nor uſeful ; or elſe like Apes, if they have ſome appearance of being rational, are blemiſh'd with ſome abſurdity or other, that when they are Attentively conſider'd, makes them appear Ridiculous."
                                            },
                                            {
                                                "example_id": "16c4de4c-1786-4688-9bbf-cdbf1a2c58d8",
                                                "sense_id": "f63e263e-3eb2-310d-b5f8-22571536d7f1",
                                                "text": "Since 1 part in 100,000 would imply that one could put a Shuttle up each day for 300 years expecting to lose only one, we could properly ask \"What is the cause of management's fantastic faith in the machinery?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04a3a993-ce86-334a-b417-685358846bda",
                                        "entry_id": "be82cb03-1793-39b8-a505-adabe33f79b7",
                                        "glosses": [
                                            "Resembling fantasies in irregularity, caprice, or eccentricity; irregular; grotesque."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "126ab851-c36d-4690-a299-1bfa3864bd39",
                                                "sense_id": "04a3a993-ce86-334a-b417-685358846bda",
                                                "text": "There at the foot of yonder nodding beech, / That wreathes its old fantastic roots so high."
                                            },
                                            {
                                                "example_id": "b478165c-a15d-4f04-984f-e30c08747108",
                                                "sense_id": "04a3a993-ce86-334a-b417-685358846bda",
                                                "text": "[…]This round of green, this orb of flame,\nFantastic beauty; such as lurks\n⁠In some wild Poet, when he works\nWithout a conscience or an aim."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fantastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "700d9d55-3817-3681-a2f8-cec6d146e4a1",
                                        "entry_id": "2ff5854e-6238-360c-a4ee-94a799c4850e",
                                        "glosses": [
                                            "A fanciful or whimsical person."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "47723659-3454-4185-8710-db51929a48c1",
                        "source_entry_id": "99d86730-8a78-3bec-9d78-ef9d1289bd59",
                        "source_sense_id": "ae07289e-0940-30ee-ab1a-3b0dffcda4a5",
                        "target_lang_word": "fantastisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fantastisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "511ae90b-c3b0-3a5e-9920-d1fb167e4c30",
                                        "entry_id": "bb4faeb3-cc40-3483-9ddc-a44ecf22ff47",
                                        "glosses": [
                                            "von der Fantasie erzeugt (oder so scheinen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10b8f1c2-17fd-4589-b7b0-f63eee4d6cd0",
                                                "sense_id": "511ae90b-c3b0-3a5e-9920-d1fb167e4c30",
                                                "text": "Was da erzählt wird, ist fantastisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da7fef6a-a951-30cf-b6d8-7139d0cec6a0",
                                        "entry_id": "bb4faeb3-cc40-3483-9ddc-a44ecf22ff47",
                                        "glosses": [
                                            "(in begeisterten Äußerungen) sehr gut, toll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df9dde4-7327-47d3-bf16-c9c816eeb06a",
                                                "sense_id": "da7fef6a-a951-30cf-b6d8-7139d0cec6a0",
                                                "text": "Du bist befördert worden? Das ist ja fantastisch!"
                                            },
                                            {
                                                "example_id": "61cb80ae-24d7-4a89-a6d0-622cd7ca11e2",
                                                "sense_id": "da7fef6a-a951-30cf-b6d8-7139d0cec6a0",
                                                "text": "„Für Planetenforscher sind die Saturnringe mehr als nur ein fantastisches Kunstwerk der Natur.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "020ec3fe-7329-3bcd-872e-2aa97d9a4477",
                                        "entry_id": "bb4faeb3-cc40-3483-9ddc-a44ecf22ff47",
                                        "glosses": [
                                            "veraltet, von Wahnvorstellungen erzeugt: verrückt, träumerisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe6e029-5078-4631-b93b-080ea70c33f9",
                                                "sense_id": "020ec3fe-7329-3bcd-872e-2aa97d9a4477",
                                                "text": "Der Kerl redet fantastisch, ob er verrückt ist?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a195d2de-2717-4503-9e25-6a81ab25b4df",
                        "source_entry_id": "99d86730-8a78-3bec-9d78-ef9d1289bd59",
                        "source_sense_id": "ae07289e-0940-30ee-ab1a-3b0dffcda4a5",
                        "target_lang_word": "fantastique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fantastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "386502b5-1745-333c-9e0f-8013746775b4",
                                        "entry_id": "a00132be-822d-3008-a07f-4a2c7c295854",
                                        "glosses": [
                                            "Qui tient de la fantaisie, de l’imagination, qui ne correspond pas à la réalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdec8c2e-051a-454a-9e5e-f2482b53b01d",
                                                "sense_id": "386502b5-1745-333c-9e0f-8013746775b4",
                                                "text": "Au cours de ses fantastiques aventures, le doigt enchanteur est doté de plusieurs vies et subit des métamorphoses ; il sait aussi devenir prothèse et se dédoubler en une barre rigide pour glisser sur la guitare jouée à plat : la « lap steel guitare »."
                                            },
                                            {
                                                "example_id": "de5dd5ef-2489-4f8a-b9dd-429ad3081a4c",
                                                "sense_id": "386502b5-1745-333c-9e0f-8013746775b4",
                                                "text": "[…], tout ce désordre fantastique et grimaçant au milieu des ténèbres et de l'humidité froide qui tombe comme un suaire, laisse dans le cœur et dans les nerfs un long sentiment d'horreur."
                                            },
                                            {
                                                "example_id": "6f190a07-8211-4674-9583-92396f674fd2",
                                                "sense_id": "386502b5-1745-333c-9e0f-8013746775b4",
                                                "text": "Les lampes furent éteintes, et la salle, illuminée par la flamme livide du brandevin, prit un aspect fantastique."
                                            },
                                            {
                                                "example_id": "e2556580-9815-4694-a13e-5a3904bdc8fc",
                                                "sense_id": "386502b5-1745-333c-9e0f-8013746775b4",
                                                "text": "Des hauteurs de Bon-Secours on distingue, dans la brume, la glorieuse cathédrale comme un dreadnought à l'ancre, comme une caravelle fantastique dominant une flotte enfumée."
                                            },
                                            {
                                                "example_id": "6b37433c-cafa-4341-aee3-37c353abe575",
                                                "sense_id": "386502b5-1745-333c-9e0f-8013746775b4",
                                                "text": "[…], nous avons pu encore admirer les falaises de la côte Nord ; découpées en architectures fantastiques, elles se dressent parfois en à-pics de 600 mètres de hauteur."
                                            },
                                            {
                                                "example_id": "9d862609-6e83-48ef-aa28-a2955b0e6118",
                                                "sense_id": "386502b5-1745-333c-9e0f-8013746775b4",
                                                "text": "[…], mais le navire imperturbable cingle vers l'immensité polaire, se glisse parmi les icebergs fantastiques qui dérivent en tournoyant cauteleusement, évités de justesse, en vain menaçants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfe212fb-956e-32a6-aa88-5aee1719f2e4",
                                        "entry_id": "a00132be-822d-3008-a07f-4a2c7c295854",
                                        "glosses": [
                                            "Qui est invraisemblable à force de fantaisie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a551f50-4a1d-410c-b764-866d2539c2ac",
                                                "sense_id": "bfe212fb-956e-32a6-aa88-5aee1719f2e4",
                                                "text": "C'est toute une poésie populaire que cette création monstrueuse et fantastique qui se forme dans l'esprit des hommes d'après la création véritable; […]."
                                            },
                                            {
                                                "example_id": "875de055-0c6d-4371-99df-9420e6e0407a",
                                                "sense_id": "bfe212fb-956e-32a6-aa88-5aee1719f2e4",
                                                "text": "Cette entrée fracassante et guillerette de Jamel au petit matin est un fantastique réveil matin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06d0a179-ba5d-34a8-82e0-0c923d53582c",
                                        "entry_id": "a00132be-822d-3008-a07f-4a2c7c295854",
                                        "glosses": [
                                            "Sujet à des imaginations chimériques ; bizarre ; capricieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7db313bb-546a-4f02-9ecc-6e56318a7416",
                                                "sense_id": "06d0a179-ba5d-34a8-82e0-0c923d53582c",
                                                "text": "… Amour fist le coup qui me rendit fantastique"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef4e8edc-7e85-3410-9653-db4d1f8f8ab3",
                                        "entry_id": "a00132be-822d-3008-a07f-4a2c7c295854",
                                        "glosses": [
                                            "Qui tient du genre ou du registre fantastique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4664e0b3-a0a1-497e-ac40-dc81462acd6f",
                                                "sense_id": "ef4e8edc-7e85-3410-9653-db4d1f8f8ab3",
                                                "text": "Mieux vaudrait dire qu’avec des moyens qui lui sont propres le texte fantastique construit d’abord une aire normative qu’il cherche ensuite à défaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fantastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a294e3d-d356-35d5-85e6-8424d806e355",
                                        "entry_id": "47737320-8321-3bb3-8375-f4811297f318",
                                        "glosses": [
                                            "Registre et genre littéraire, où un élément surnaturel fait irruption dans un univers préalablement perçu comme réaliste par le lecteur, suscitant ainsi le doute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b0e286a-b986-43bc-990b-90362398414c",
                                                "sense_id": "4a294e3d-d356-35d5-85e6-8424d806e355",
                                                "text": "Le fantastique a été à la mode à l’époque du romantisme."
                                            },
                                            {
                                                "example_id": "711f9905-b9f0-4804-b1a5-0ac683b7e23d",
                                                "sense_id": "4a294e3d-d356-35d5-85e6-8424d806e355",
                                                "text": "Telle est la portée mythique du fantastique visuel et du fantastique naturel caractérisés par leur impact sur la vue."
                                            }
                                        ]
                                    }
                                ]
                            },
