                            {
                                "target_word": "pivot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b26bfa6-daee-3ff4-b0f8-5eef06dea19d",
                                        "entry_id": "c3bb2186-d98e-39a3-9b93-6983a0500cfa",
                                        "glosses": [
                                            "To turn on an exact spot."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a4e9e74-967a-304b-b550-d8b5bf46c639",
                                        "entry_id": "c3bb2186-d98e-39a3-9b93-6983a0500cfa",
                                        "glosses": [
                                            "To make a sudden or swift change in strategy, policy, etc.",
                                            "To change the direction of a business, usually in response to changes in the market."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc2ce8d1-f072-4fd5-b4bd-5a3484ef7d20",
                                                "sense_id": "2a4e9e74-967a-304b-b550-d8b5bf46c639",
                                                "text": "Mr. Shah’s new business has signed up 25 New York City hotels and raised $1.5 million from angel investors and $3 million from a seed round. Yet three months into his new project, he has had to pivot again, realizing that his best customers are large businesses, not individuals."
                                            },
                                            {
                                                "example_id": "5e1ac1b5-203b-4277-a4b6-b15cffa375a9",
                                                "sense_id": "2a4e9e74-967a-304b-b550-d8b5bf46c639",
                                                "text": "“Entrepreneurs usually have some inkling about a problem they can solve,” he said. “But typically they’re not exactly right. So if you survive long enough, you pivot and pivot and pivot and find what sticks.”"
                                            },
                                            {
                                                "example_id": "d40de7a7-4708-4900-9264-89258d1d12f0",
                                                "sense_id": "2a4e9e74-967a-304b-b550-d8b5bf46c639",
                                                "text": "It was a fairly common strategy for startups in our space, but we were pivoting so frequently that it didn't quite work for us—if Nick found someone on Monday, by Friday we'd usually pivoted away from that sector so that it made no longer sense, and the advisor share paperwork we'd asked the lawyers to draw up would be left unfiled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7da04ff9-52ac-3609-9a14-d5287b3bce96",
                                        "entry_id": "c3bb2186-d98e-39a3-9b93-6983a0500cfa",
                                        "glosses": [
                                            "To make a sudden or swift change in strategy, policy, etc.",
                                            "To shift a political candidate's messaging during a general election to reflect plans and values more moderate than those advocated during the primary."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
