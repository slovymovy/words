                "translations": [
                    {
                        "translation_id": "75a93719-cb8a-457f-91be-4112cffc9e4f",
                        "source_entry_id": "5f040bf4-688d-3743-b4d6-ec24aa55cf99",
                        "source_sense_id": "faf75dec-cac4-31a6-a4e9-fbe1b9d2267a",
                        "target_lang_word": "oily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d840c03-50c4-3c17-ade1-c506a5895376",
                                        "entry_id": "c568d4a3-ecba-358a-bb1a-a6b001ba7e6e",
                                        "glosses": [
                                            "Covered with or containing oil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b75a3db-7f82-4565-a94b-1e02c4de93a8",
                                                "sense_id": "2d840c03-50c4-3c17-ade1-c506a5895376",
                                                "text": "oily machinery;   oily rags;   oily fish;   oily cooking"
                                            },
                                            {
                                                "example_id": "c698ab4e-16c1-4014-90b1-e3229ac09413",
                                                "sense_id": "2d840c03-50c4-3c17-ade1-c506a5895376",
                                                "text": "His clothes were apt to look oily and smell of eating-houses."
                                            },
                                            {
                                                "example_id": "d1952268-77fc-41e7-9cb1-acca4fc463d5",
                                                "sense_id": "2d840c03-50c4-3c17-ade1-c506a5895376",
                                                "text": "[…] overdressed young men of enigmatic appearance, with oily thick hair, shifty eyes, and hands covered with cheap rings, swaggered about smoking cigarettes and talking in loud, ostentatious voices."
                                            },
                                            {
                                                "example_id": "2c650696-9b96-4aeb-9f9d-53dc28b75ad1",
                                                "sense_id": "2d840c03-50c4-3c17-ade1-c506a5895376",
                                                "text": "Dyes listed with the word “lake” indicate the dye is a fat-soluble version, meaning it can dissolve in oily foods or drinks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07cbfe8-2943-30db-a342-87a4d410bd85",
                                        "entry_id": "c568d4a3-ecba-358a-bb1a-a6b001ba7e6e",
                                        "glosses": [
                                            "Resembling oil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a5549cc-cd51-40c2-9329-a8404fc5a29e",
                                                "sense_id": "a07cbfe8-2943-30db-a342-87a4d410bd85",
                                                "text": "oily swells;   oily seas"
                                            },
                                            {
                                                "example_id": "36a19697-27fa-4ca2-adb4-28233a38c888",
                                                "sense_id": "a07cbfe8-2943-30db-a342-87a4d410bd85",
                                                "text": "There were no breakers and no waves, for not a breath of wind was stirring. Only a slight oily swell rose and fell like a gentle breathing, and showed that the eternal sea was still moving and living."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fce99a7-d50e-3e5c-8cfd-c863eadf655b",
                                        "entry_id": "c568d4a3-ecba-358a-bb1a-a6b001ba7e6e",
                                        "glosses": [
                                            "Excessively friendly or polite but insincere."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5320ae45-b4e5-4c0b-8a10-174ad4f69237",
                                                "sense_id": "7fce99a7-d50e-3e5c-8cfd-c863eadf655b",
                                                "text": "Near-synonyms: slick, buttery; smarmy"
                                            },
                                            {
                                                "example_id": "b173d1ab-df53-4ec4-8039-111a1b232029",
                                                "sense_id": "7fce99a7-d50e-3e5c-8cfd-c863eadf655b",
                                                "text": "[…] for I want that glib and oyly Art,\nTo ſpeake and purpoſe not, ſince what I well entend\nIle do’t before I ſpeake, […]"
                                            },
                                            {
                                                "example_id": "9ce3d846-0b8b-4b7f-85ea-fac932708772",
                                                "sense_id": "7fce99a7-d50e-3e5c-8cfd-c863eadf655b",
                                                "text": "Mr. Carker the Manager, sly of manner, sharp of tooth, soft of foot, watchful of eye, oily of tongue, cruel of heart, nice of habit, sat with a dainty stedfastness and patience at his work, as if he were waiting at a mouse’s hole."
                                            },
                                            {
                                                "example_id": "78a4a9f6-daa3-4ffd-8fb4-4bac2e783241",
                                                "sense_id": "7fce99a7-d50e-3e5c-8cfd-c863eadf655b",
                                                "text": "‘He had an inflexible will beneath all that oily kindness which passed for spiritual […]’"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "oily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d701b94-e884-3360-972a-3728cfc2ee07",
                                        "entry_id": "2fc2dfba-3d00-34a6-b825-4efb799679a1",
                                        "glosses": [
                                            "A marble with an oily lustre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21b8a777-b70c-488a-bd6f-637845d6b87e",
                                                "sense_id": "7d701b94-e884-3360-972a-3728cfc2ee07",
                                                "text": "Lustered (also called lusters, rainbows, oilies, and pearls)."
                                            },
                                            {
                                                "example_id": "852a04c4-2ae2-4e53-b24c-c3363093a3ed",
                                                "sense_id": "7d701b94-e884-3360-972a-3728cfc2ee07",
                                                "text": "But marbles are not only used to play games: they are also traded. In this market, the value of the different kinds of marbles (oilies, emperors, etc.) is determined by local supply and demand and not by the price of the marbles […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "887a347b-6263-30ef-9c65-764cf4873390",
                                        "entry_id": "2fc2dfba-3d00-34a6-b825-4efb799679a1",
                                        "glosses": [
                                            "Oilskins. (waterproof garment)"
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5912d229-09df-48a3-b20a-0dac01e731d1",
                        "source_entry_id": "5f040bf4-688d-3743-b4d6-ec24aa55cf99",
                        "source_sense_id": "faf75dec-cac4-31a6-a4e9-fbe1b9d2267a",
                        "target_lang_word": "greasy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greasy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e143670-35af-370e-bddc-b8d1ccf33114",
                                        "entry_id": "8733cd8f-d07a-3fe0-baab-aa1d89ee9656",
                                        "glosses": [
                                            "Having a slippery surface; having a surface covered with grease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78ef2230-229e-40ee-bb4f-755fcef9664f",
                                                "sense_id": "4e143670-35af-370e-bddc-b8d1ccf33114",
                                                "text": "a greasy mineral"
                                            },
                                            {
                                                "example_id": "cf44b38e-00ba-4f5e-a3ce-dd0c44e370b6",
                                                "sense_id": "4e143670-35af-370e-bddc-b8d1ccf33114",
                                                "text": "[…] mechanic slaves\nWith greasy aprons, rules, and hammers, shall\nUplift us to the view […]"
                                            },
                                            {
                                                "example_id": "a570064f-376a-4040-a42e-b10544fba18c",
                                                "sense_id": "4e143670-35af-370e-bddc-b8d1ccf33114",
                                                "text": "it was in the garage that Alec worked, […] doing mysterious greasy things. Grease blackened his hairy legs; grease had turned his white canvas shoes black; grease blackened his hands even beyond the wrist; grease made his short working trousers black and stiff. Yet he had the gift, which Mr Biswas admired, of being able to hold a cigarette between greasy fingers and greasy lips without staining it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7a35c7d-f07a-3305-ac70-e335c7052174",
                                        "entry_id": "8733cd8f-d07a-3fe0-baab-aa1d89ee9656",
                                        "glosses": [
                                            "Containing a lot of grease or fat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95f9b478-fc43-4c87-bcd7-e69bc41f149b",
                                                "sense_id": "f7a35c7d-f07a-3305-ac70-e335c7052174",
                                                "text": "c. 1795, Margaret Taylor, Mrs. Taylor’s Family Companion: or The Whole Art of Cookery Display’d, London: W. Lane, “To fry flat Fish,” p. 37,\nBefore you dish them up, lay them upon a drainer before the fire sloping, for two or three minutes, which will prevent their eating greasy."
                                            },
                                            {
                                                "example_id": "a63e3bdf-f3ca-4e21-b740-44277873621b",
                                                "sense_id": "f7a35c7d-f07a-3305-ac70-e335c7052174",
                                                "text": "With a skin full of alcohol and a probable overwhelming desire for a greasy kebab, I had evidently got myself into such a state that I was unable to locate the correct door to the fast food shop."
                                            },
                                            {
                                                "example_id": "a9b25f84-2ad4-49f7-8bf3-8612a8504d9d",
                                                "sense_id": "f7a35c7d-f07a-3305-ac70-e335c7052174",
                                                "text": "Nigel and Richard Bertinet go for butter. Jamie and Nigella both opt for olive oil, and Garten uses a mixture, spreading the bread generously with butter, then topping it with garlic and herbs in olive oil. Oil, to my taste, simply makes the bread seem greasy: it's great for dipping, but it doesn't seem to soak into the bread in the same way as butter – I've probably just got hopelessly rich Anglo-Saxon tastes, but for me, it's butter all the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5212e0dc-20b8-339e-a0da-8b87b4df1724",
                                        "entry_id": "8733cd8f-d07a-3fe0-baab-aa1d89ee9656",
                                        "glosses": [
                                            "Shady, sketchy, dodgy, detestable, unethical."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb69c675-8b31-4287-8c93-807a509438d2",
                                                "sense_id": "5212e0dc-20b8-339e-a0da-8b87b4df1724",
