            "senses": [
                {
                    "sense_id": "406ac735-4d60-3775-8f79-14cb586fa597",
                    "sense_definition": "A deep-fried piece of dough, often toroidal in shape, typically sweetened or filled with cream or jam.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I bought a fresh <w>doughnut</w> from the bakery this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром я купил в пекарне свежий <w>по́нчик</w>."
                            }
                        },
                        {
                            "text": "She enjoyed eating a chocolate <w>doughnut</w> with her coffee.",
                            "target_lang_translations": {
                                "ru": "Она с удовольствием съела шоколадный <w>по́нчик</w> с кофе."
                            }
