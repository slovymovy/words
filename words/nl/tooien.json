                            }
                        },
                        {
                            "text": "Rode veren <w>tooiden</w> zijn hoofd tijdens het traditionele festival.",
                            "target_lang_translations": {
                                "en": "Red feathers <w>graced</w> his head during the traditional festival."
                            }
                        }
                    ],
                    "synonyms": [
                        "sieren"
                    ],
                    "common_phrases": [
                        "het hoofd tooien"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be present on something or someone as a decoration or ornament."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adorn",
                                "target_lang_sense_clarification": "to be an ornament on something"
                            },
                            {
                                "target_lang_word": "grace",
                                "target_lang_sense_clarification": "to add beauty or honor by being present"
                            },
                            {
                                "target_lang_word": "decorate",
                                "target_lang_sense_clarification": "to serve as a decoration"
                            }
