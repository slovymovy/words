                        "glosses": [
                            "Person, die sich mit der Bestimmung, systematischen Einteilung und Beschreibung von Obstarten und -sorten beschäftigt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b136a37a-8012-4dd1-95f0-6074ec724acd",
                                "sense_id": "fe9fca8b-ba8b-339b-b264-0cb9cfaee762",
                                "text": "A. F. A. Diel gilt als der größte Pomologe seiner Zeit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
