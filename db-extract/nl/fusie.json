                                    },
                                    {
                                        "sense_id": "7bbe00ef-4a05-32db-9049-72c964789b63",
                                        "entry_id": "0bb35456-a527-313e-8fb7-cc5cd3db84a2",
                                        "glosses": [
                                            "The act of merging separate things, or the result thereof.",
                                            "The act of melting or liquefying something by heating it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec1da3ff-7bca-4cbb-b62b-65f46d233a29",
                                                "sense_id": "7bbe00ef-4a05-32db-9049-72c964789b63",
                                                "text": "This Cryſtal is a pellucid fiſſile Stone, clear as Water or Cryſtal of the Rock, and without Colour; enduring a red Heat without loſing its tranſparency, and in a very ſtrong Heat calcining without Fuſion."
                                            },
                                            {
                                                "example_id": "b83b69f3-5d22-4e5b-aebc-cb41394d55eb",
                                                "sense_id": "7bbe00ef-4a05-32db-9049-72c964789b63",
                                                "text": "From a vault in the green-blue ice, more or less perfectly formed each summer, the torrent issues, which represents the natural drainage of the valley, derived partly from land-springs, partly from fusion of the ice."
                                            },
                                            {
                                                "example_id": "83b93d3f-3b62-41f4-ac1f-7180e04121d1",
                                                "sense_id": "7bbe00ef-4a05-32db-9049-72c964789b63",
                                                "text": "The upper limit of temperature is determined by the point at which fusion of the ore takes place, or often, for practical purposes, the temperature at which the ore softens and agglomerates."
                                            },
                                            {
                                                "example_id": "691e7c96-a5a9-4ddf-b460-bba7110a8701",
                                                "sense_id": "7bbe00ef-4a05-32db-9049-72c964789b63",
                                                "text": "Below the temperature of fusion of the solid phase, the growth rate of the solid/ liquid interface at low undercooling is affected mainly by undercooling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba772ac5-bc1a-36b8-8553-d1ac4ec64677",
