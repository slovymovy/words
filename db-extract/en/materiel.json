                "senses": [
                    {
                        "sense_id": "c24696bc-cddf-3a04-ba96-d27c095e4d63",
                        "entry_id": "3c9d006e-cffb-3ec0-9b1e-7df24e3bc82f",
                        "glosses": [
                            "Military equipment, apparatus, and supplies."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b9cdba8d-5bee-4d3a-9ac5-50af99d42567",
                                "sense_id": "c24696bc-cddf-3a04-ba96-d27c095e4d63",
                                "text": "Instead, it was a 1941 Volkswagen Kübelwagen Type 82, the first acquisition in a collection of war matériel begun 10 years ago by Mr. Coffman, a refrigeration service technician from Marengo, Ill."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42644177-eb8a-4769-a728-cd0f1fa95d1d",
                        "source_entry_id": "3c9d006e-cffb-3ec0-9b1e-7df24e3bc82f",
                        "source_sense_id": "c24696bc-cddf-3a04-ba96-d27c095e4d63",
                        "source_sense_description": "military equipment, apparatus and supplies",
                        "target_lang_word": "matériel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matériel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5abc9e65-2022-3dfb-a9c7-695e4125d4e6",
                                        "entry_id": "5cc27ed0-7df9-3076-8484-63f38a0c2fcf",
                                        "glosses": [
                                            "Qui est formé de matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15e5f595-3f1f-459f-a123-e75f8728c7a9",
                                                "sense_id": "5abc9e65-2022-3dfb-a9c7-695e4125d4e6",
                                                "text": "Les substances, les choses matérielles."
                                            },
                                            {
                                                "example_id": "820a2a8f-cc5d-41de-826b-25a27398d631",
                                                "sense_id": "5abc9e65-2022-3dfb-a9c7-695e4125d4e6",
                                                "text": "Il faut penser aux architectures matérielle et logicielle."
                                            },
                                            {
                                                "example_id": "a94bc343-8e5e-4b75-b80a-de9aa1691343",
                                                "sense_id": "5abc9e65-2022-3dfb-a9c7-695e4125d4e6",
                                                "text": "Le Pince est un matériel technique"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00756b1f-624b-3f91-8e1d-cb4c035e966e",
                                        "entry_id": "5cc27ed0-7df9-3076-8484-63f38a0c2fcf",
                                        "glosses": [
                                            "Qui a rapport à la matière, qui tient de la matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ace4841c-15e0-4561-932f-e038367314e5",
                                                "sense_id": "00756b1f-624b-3f91-8e1d-cb4c035e966e",
                                                "text": "Suivant quelques philosophes, les actions des animaux sont purement mécaniques et matérielles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddf2817f-593c-36d1-9e12-cf9bfd920e51",
                                        "entry_id": "5cc27ed0-7df9-3076-8484-63f38a0c2fcf",
                                        "glosses": [
                                            "Qui ne s’attache guère qu’aux choses de la matière."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9ad8f9-4d00-49f5-b674-408b16b34af2",
                                                "sense_id": "ddf2817f-593c-36d1-9e12-cf9bfd920e51",
                                                "text": "Lorsqu’on trouve chaque jour les repas tout préparés, on finit par oublier la nécessité qui force de les prendre. On ne s'aperçoit pas de la chaîne que d'autres portent pour vous, et l'on en vient même à s'étonner qu'il y ait au monde des gens assez matériels pour s'occuper de pareils détails !."
                                            },
                                            {
                                                "example_id": "9c16e834-5c55-4b9a-b598-afa1fb5675f9",
                                                "sense_id": "ddf2817f-593c-36d1-9e12-cf9bfd920e51",
                                                "text": "La lutte des intérêts matériels et des principes moraux, de l’utilité et du devoir, du matérialisme et du spiritualisme, se représente ici avec une nouvelle force, et sous un point de vue encore plus important."
                                            },
                                            {
                                                "example_id": "eb5c15ab-975c-4a2f-bcce-c1a9a6743e17",
                                                "sense_id": "ddf2817f-593c-36d1-9e12-cf9bfd920e51",
                                                "text": "Il est à peine besoin de faire remarquer que, vu la quantité de taxes et redevances auxquelles on les assujettissait […], les juifs se trouvaient dans une situation matérielle précaire."
                                            },
                                            {
                                                "example_id": "1b47a588-e29c-4b0c-8722-7a82178bf58b",
                                                "sense_id": "ddf2817f-593c-36d1-9e12-cf9bfd920e51",
                                                "text": "Faux matériel, Celui qui est commis innocemment et sans intention coupable ; par opposition à faux formel, Celui que l’on commet sciemment et à mauvaise intention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c96f0749-4ef3-34f3-a7bf-c98940046c14",
                                        "entry_id": "5cc27ed0-7df9-3076-8484-63f38a0c2fcf",
                                        "glosses": [
                                            "Dans l’ancienne philosophie scolastique, signifiait qui est opposé à formel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd44e8b4-6fd3-4723-aba3-4a4c9b884070",
                                                "sense_id": "c96f0749-4ef3-34f3-a7bf-c98940046c14",
                                                "text": "La cause matérielle doit être distinguée de la cause formelle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "matériel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5d388a93-7f52-36a8-9334-235b9070901f",
                                        "entry_id": "17760efb-d106-307f-b758-f3a5766a0b81",
                                        "glosses": [
                                            "Ensemble des objets de toute nature qui sont employés à quelque service public, par opposition à personnel, qui s’entend de toutes les personnes attachées à ce même service. Ensemble des matériaux et des outils nécessaires à une fabrication, une conception, une création, ou une production."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d661e6d-7133-48e4-9cf7-13e02abcc56a",
                                                "sense_id": "5d388a93-7f52-36a8-9334-235b9070901f",
                                                "text": "Je reçus de France un important matériel, un nouveau cinématographe, cadeau de mon ami Pierre Albaran, et un phonographe envoyé par Jean Borotra, le champion de tennis."
                                            },
                                            {
                                                "example_id": "fb5a82c7-bc6b-44f9-8f69-458f3a017020",
                                                "sense_id": "5d388a93-7f52-36a8-9334-235b9070901f",
                                                "text": "Une campagne de crowdfunding a d’ailleurs été lancée. Le but est de réunir la maximum de dons pour aider les clubs de sauvetage côtier de Nouvelle-Aquitaine à acquérir du matériel et développer la formation des jeunes MNS."
                                            },
                                            {
                                                "example_id": "c24e5d24-9fbc-4a69-bde9-3f4f7458840b",
                                                "sense_id": "5d388a93-7f52-36a8-9334-235b9070901f",
                                                "text": "Le matériel d’une armée : Les bagages, les munitions, les pièces d’artillerie, etc., par opposition aux troupes qui composent l’armée."
                                            },
                                            {
                                                "example_id": "77359bed-5afd-4533-bab1-e22334e4c3ca",
                                                "sense_id": "5d388a93-7f52-36a8-9334-235b9070901f",
                                                "text": "Le débarquement du matériel exigera beaucoup de temps."
                                            },
                                            {
                                                "example_id": "b570b3df-6dba-450e-9e4e-b2aa3fad943e",
                                                "sense_id": "5d388a93-7f52-36a8-9334-235b9070901f",
                                                "text": "L’ennemi a perdu tout son matériel."
                                            },
                                            {
                                                "example_id": "66b460ed-2c19-4242-88d0-3b1d83699f1b",
                                                "sense_id": "5d388a93-7f52-36a8-9334-235b9070901f",
                                                "text": "Matériel de siège."
                                            },
                                            {
                                                "example_id": "0835222e-0785-4087-b545-65f177528a58",
                                                "sense_id": "5d388a93-7f52-36a8-9334-235b9070901f",
                                                "text": "Matériel de sport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8719ca5-c9c7-3edd-9064-c1306383ba80",
                                        "entry_id": "17760efb-d106-307f-b758-f3a5766a0b81",
                                        "glosses": [
                                            "Un bien implicitement non organique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4e50573-6415-4b97-a044-0aaa4a3949a9",
                                                "sense_id": "e8719ca5-c9c7-3edd-9064-c1306383ba80",
                                                "text": "(Chez un botaniste) Vendez vous du matériel ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12f34558-ef99-3e73-9b26-019fabd35db3",
                                        "entry_id": "17760efb-d106-307f-b758-f3a5766a0b81",
                                        "glosses": [
                                            "Corps d’armée spécialisé dans la logistique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc9f078b-a799-3945-b645-3549cd4ab789",
                                        "entry_id": "17760efb-d106-307f-b758-f3a5766a0b81",
                                        "glosses": [
                                            "Substantif de l’adjectif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e1ea184-d782-4063-96b2-dde11fdce613",
                                                "sense_id": "fc9f078b-a799-3945-b645-3549cd4ab789",
                                                "text": "Distinguer le matériel du formel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec718f80-170a-3722-af2f-1edd3e9b6200",
                                        "entry_id": "17760efb-d106-307f-b758-f3a5766a0b81",
                                        "glosses": [
                                            "Ensemble des éléments physiques employés pour le traitement des données, par opposition au logiciel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27343430-d135-4894-9d8e-1ad1a6f8fa9e",
                                                "sense_id": "ec718f80-170a-3722-af2f-1edd3e9b6200",
                                                "text": "Cette carte graphique c'est du bon matériel !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f367dbfe-acf0-4aa1-ae7f-c40fe66b75f3",
                        "source_entry_id": "3c9d006e-cffb-3ec0-9b1e-7df24e3bc82f",
