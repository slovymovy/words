                "senses": [
                    {
                        "sense_id": "bfcf23c7-bf39-3625-a774-0696414d38e4",
                        "entry_id": "b8bca543-cd7f-300b-8b06-a6a24e76f57f",
                        "glosses": [
                            "vertrocknete Frucht vom Vorjahr, die noch an der Mutterpflanze hängt"
                        ],
                        "tags": [
                            "Gartenbau"
                        ],
                        "examples": [
                            {
                                "example_id": "71b6758b-7175-4a88-9928-d90b886062fb",
                                "sense_id": "bfcf23c7-bf39-3625-a774-0696414d38e4",
                                "text": "Fruchtmumien sollten im Winter von Obstbäumen entfernt werden."
                            },
                            {
                                "example_id": "1c2acd11-7734-4113-8418-dfcaeda2c26f",
                                "sense_id": "bfcf23c7-bf39-3625-a774-0696414d38e4",
                                "text": "„Bleibt bei Blühbeginn weniger als durchschnittlich eine Fruchtmumie pro Baum, treten bei Süßkirschen keine Ertragsverluste durch Blütenbefall und Fruchtholzbefall auf.“"
                            },
                            {
                                "example_id": "f1b3660e-c3f5-4ba7-8bc3-6a3951462d61",
                                "sense_id": "bfcf23c7-bf39-3625-a774-0696414d38e4",
                                "text": "„Entfernen Sie vor der ersten Behandlung außerdem alle Fruchtmumien und schneiden Sie verkrüppelte Triebspitzen ab.“"
                            },
                            {
                                "example_id": "b61977fd-c105-4fa9-a298-23b85545a19e",
                                "sense_id": "bfcf23c7-bf39-3625-a774-0696414d38e4",
                                "text": "„Kurz vor der Lese kann man große Veränderungen bei den Früchten sehen. Diese fallen ein und werden zu Fruchtmumien, in denen der Pilz überwintern kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
