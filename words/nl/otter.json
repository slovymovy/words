{
    "word_family": [
        "otteren",
        "visotter",
        "zeeotter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8636fbf0-17e7-3e53-8d46-9bed27fa2451",
                    "sense_definition": "Een in het water levend zoogdier met een dichte, bruine vacht en zwempoten, behorend tot de marterachtigen (Lutra lutra).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zoogdieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>otter</w> zwemt geruisloos door het heldere water van de rivier.",
                            "target_lang_translations": {
                                "en": "The <w>otter</w> swims silently through the clear water of the river."
                            }
                        },
                        {
                            "text": "Omdat <w>otters</w> grote woongebieden hebben en de dieren veel trekken, is de <w>otter</w> geholpen met goede ecologische verbindingszones.",
                            "target_lang_translations": {
                                "en": "Because <w>otters</w> have large habitats and migrate a lot, the <w>otter</w> is helped by good ecological corridors."
                            }
                        }
                    ],
                    "synonyms": [
                        "visotter"
                    ],
                    "common_phrases": [
                        "de europese otter",
                        "een zwemmende otter"
                    ],
                    "target_lang_definitions": {
                        "en": "An aquatic mammal with dense, brown fur and webbed feet, belonging to the mustelid family (Lutra lutra)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "otter",
                                "target_lang_sense_clarification": "general term for the semi-aquatic mammal"
                            },
                            {
                                "target_lang_word": "European otter",
                                "target_lang_sense_clarification": "the specific species Lutra lutra"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54a38e45-3abe-3de2-a5ac-86da9c55726e",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>otteren</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>otter</w> de hele middag langs de waterkant.",
                            "target_lang_translations": {
                                "en": "I <w>mess around</w> along the water's edge all afternoon."
                            }
                        },
                        {
                            "text": "Als ik zo doorga, <w>otter</w> ik mezelf nog helemaal uitgeput.",
                            "target_lang_translations": {
                                "en": "If I keep going like this, I will <w>exhaust</w> myself completely from messing around."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of the verb 'otteren' (to mess around in water, to behave like an otter)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mess around in water",
                                "target_lang_sense_clarification": "first-person singular present tense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2328b35-611f-3c7a-9fab-1cdbfe6a6700",
                    "sense_definition": "Gebiedende wijs van <w>otteren</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Otter</w> niet zo onhandig in het water!",
                            "target_lang_translations": {
                                "en": "Don't <w>splash around</w> so clumsily in the water!"
                            }
                        },
                        {
                            "text": "Kom op, <w>otter</w> eens een beetje door!",
                            "target_lang_translations": {
                                "en": "Come on, <w>get a move on</w> in the water!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb 'otteren' (to mess around in water, to behave like an otter)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mess around in water",
                                "target_lang_sense_clarification": "imperative form"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}