                            },
                            {
                                "target_lang_word": "смотреть запоем",
                                "target_lang_sense_clarification": "о сериалах или фильмах"
                            },
                            {
                                "target_lang_word": "уйти в загул",
                                "target_lang_sense_clarification": "о разгульном поведении"
                            }
                        ]
