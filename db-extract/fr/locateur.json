                                "target_senses": [
                                    {
                                        "sense_id": "a2733104-d2da-3833-948f-82abd51f8e4c",
                                        "entry_id": "b15cf953-aab7-368b-8952-5df593a71dde",
                                        "glosses": [
                                            "Person, die eine Sache mietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0da1661-3352-435e-9bc5-f204ab582870",
                                                "sense_id": "a2733104-d2da-3833-948f-82abd51f8e4c",
                                                "text": "Der Vermieter vermietet dem Mieter eine Wohnung."
                                            },
                                            {
                                                "example_id": "bbe71921-d8db-401c-b800-bf4a3c4ce8d3",
                                                "sense_id": "a2733104-d2da-3833-948f-82abd51f8e4c",
                                                "text": "Der neue Mieter der Immobilie ist ein netter, alter Herr."
                                            },
                                            {
                                                "example_id": "644d16be-3be9-4476-bc9f-135cd5d62aa3",
                                                "sense_id": "a2733104-d2da-3833-948f-82abd51f8e4c",
                                                "text": "Der Mieter ist mit der Miete in Rückstand."
                                            },
                                            {
                                                "example_id": "1820fe4f-599c-4c3d-8244-109faed81e06",
                                                "sense_id": "a2733104-d2da-3833-948f-82abd51f8e4c",
                                                "text": "„Und die Preise steigen nach dem Auszug des alten Mieters oft so stark, dass Alleinerziehende und Familien sich den Einzug nicht leisten können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
