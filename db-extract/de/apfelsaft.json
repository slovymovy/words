                                                "example_id": "8eea7a59-d1d6-4b33-bced-0420def43fcc",
                                                "sense_id": "b0aecdb6-f015-3c12-835c-d0144448dd30",
                                                "text": "Op warme dagen drink ik graag appelsap."
                                            },
                                            {
                                                "example_id": "c79d36d6-279c-450e-9446-0a4c2b39ccdf",
                                                "sense_id": "b0aecdb6-f015-3c12-835c-d0144448dd30",
                                                "text": "Hierna pakte ze een pak appelsap en schonk wat voor zichzelf in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14b28031-2802-3fcd-a4b2-875a1dc9d4fb",
                                        "entry_id": "2d37d0ed-9df9-3f91-819f-a57974be1b42",
                                        "glosses": [
                                            "/ een zekere voorraad van [1], zoals een pak of fles"
                                        ],
                                        "tags": [
                                            "feminine",
                                            "masculine"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72a7f446-89de-4d6b-aa3d-b15290a34c1b",
                                                "sense_id": "14b28031-2802-3fcd-a4b2-875a1dc9d4fb",
                                                "text": "De appelsap is op, ik ga even een nieuw pak halen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
