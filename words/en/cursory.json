{
    "word_family": [
        "cursorily",
        "cursoriness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cd929191-9ab7-3a5d-89b9-fce4e77ac1a4",
                    "sense_definition": "Done quickly and without thorough attention to detail; hasty or superficial.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "cursory_quick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave the report a <w>cursory</w> glance before rushing out to catch his morning train.",
                            "target_lang_translations": {
                                "de": "Er warf einen <w>flüchtigen</w> Blick auf den Bericht, bevor er hinausstürmte, um seinen morgendlichen Zug zu erwischen."
                            }
                        },
                        {
                            "text": "Even a <w>cursory</w> examination of the budget reveals several major arithmetic errors.",
                            "target_lang_translations": {
                                "de": "Selbst eine <w>oberflächliche</w> Prüfung des Haushalts offenbart mehrere grobe Rechenfehler."
                            }
                        }
                    ],
                    "synonyms": [
                        "hasty",
                        "superficial",
                        "fleeting",
                        "quick"
                    ],
                    "antonyms": [
                        "thorough",
                        "meticulous",
                        "exhaustive"
                    ],
                    "common_phrases": [
                        "cursory glance",
                        "cursory examination",
                        "cursory look",
                        "cursory review"
                    ],
                    "target_lang_definitions": {
                        "de": "Schnell und ohne genaue Aufmerksamkeit auf Details durchgeführt; flüchtig oder oberflächlich."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "flüchtig",
                                "target_lang_sense_clarification": "schnell, nicht genau hinsehend"
                            },
                            {
                                "target_lang_word": "oberflächlich",
                                "target_lang_sense_clarification": "nicht gründlich, nur das Äußere erfassend"
                            },
                            {
                                "target_lang_word": "kursorisch",
                                "target_lang_sense_clarification": "bildungssprachlich für schnell überfliegend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f134075-ea9b-3350-a96d-e257649bd0f5",
                    "sense_definition": "Lacking proper care or methodical attention; careless, desultory, or slipshod.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cursory_quick",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cursory</w> inspection of the building failed to detect serious structural weaknesses.",
                            "target_lang_translations": {
                                "de": "Die <w>nachlässige</w> Inspektion des Gebäudes konnte schwerwiegende strukturelle Schwachstellen nicht aufdecken."
                            }
                        },
                        {
                            "text": "Her <w>cursory</w> research relied only on unverified articles found on social media.",
                            "target_lang_translations": {
                                "de": "Ihre <w>oberflächliche</w> Recherche stützte sich lediglich auf ungeprüfte Artikel aus den sozialen Medien."
                            }
                        }
                    ],
                    "synonyms": [
                        "careless",
                        "slapdash",
                        "slipshod",
                        "negligent"
                    ],
                    "antonyms": [
                        "diligent",
                        "painstaking",
                        "rigorous"
                    ],
                    "common_phrases": [
                        "cursory inspection",
                        "cursory check"
                    ],
                    "target_lang_definitions": {
                        "de": "Mangelnd an Sorgfalt oder methodischer Aufmerksamkeit; nachlässig, unachtsam oder liederlich."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "nachlässig",
                                "target_lang_sense_clarification": "ohne die gebotene Sorgfalt"
                            },
                            {
                                "target_lang_word": "oberflächlich",
                                "target_lang_sense_clarification": "nicht gründlich oder sorgfältig genug"
                            },
                            {
                                "target_lang_word": "schlampig",
                                "target_lang_sense_clarification": "umgangssprachlich für unordentlich, ungenau"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02d9fd2d-4385-373c-be16-40a624718c6a",
                    "sense_definition": "Constantly moving about; not fixed or stationary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naturalists documented the habits of several <w>cursory</w> animals roaming across the plains.",
                            "target_lang_translations": {
                                "de": "Die Naturforscher dokumentierten die Gewohnheiten mehrerer <w>umherstreifender</w> Tiere, die durch die Ebenen zogen."
                            }
                        },
                        {
                            "text": "Unlike rooted plants, these small organisms maintain a <w>cursory</w> existence along the riverbed.",
                            "target_lang_translations": {
                                "de": "Anders als verwurzelte Pflanzen führen diese kleinen Organismen ein <w>nicht ortsfestes</w> Dasein entlang des Flussbettes."
                            }
                        }
                    ],
                    "synonyms": [
                        "mobile",
                        "moving"
                    ],
                    "antonyms": [
                        "stationary",
                        "fixed"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English except in archaic or specialized descriptions."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ständig in Bewegung; umherziehend, nicht ortsfest oder stationär."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "umherstreifend",
                                "target_lang_sense_clarification": "in ständiger Bewegung, nicht sesshaft"
                            },
                            {
                                "target_lang_word": "nicht ortsfest",
                                "target_lang_sense_clarification": "ständig den Ort wechselnd"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}