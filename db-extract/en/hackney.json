                    },
                    {
                        "sense_id": "e1b481cd-79c7-350f-8105-53a9837e118f",
                        "entry_id": "24731a5b-cdb7-3aa7-996c-366489018664",
                        "glosses": [
                            "Inferior writing; literary hackwork."
                        ],
                        "tags": [
                            "archaic",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "55387e38-1138-4aad-b0ba-91a25934a969",
                                "sense_id": "e1b481cd-79c7-350f-8105-53a9837e118f",
                                "text": "Not that the existence of Grub street is to be doubted: it was, indeed, a grim actuality, and many a garreter realised by experience\nHow unhappy's the fate\nTo live by one's pate\nAnd to be forced to write hackney for bread."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60d720bf-de14-490a-b8ad-eaf49c8736ab",
                        "source_entry_id": "24731a5b-cdb7-3aa7-996c-366489018664",
                        "source_sense_description": "ordinary horse",
                        "target_lang_word": "Gaul",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gaul",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b1ecf1a-a766-32c3-a99e-caca36025d70",
                                        "entry_id": "24e2fb89-ddd8-3ac1-867b-bd4cde4825b4",
                                        "glosses": [
                                            "minderwertiges Pferd"
                                        ],
                                        "tags": [
                                            "abschätzig"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4155be82-22a7-4644-be63-a6bbfabd6b34",
                                                "sense_id": "2b1ecf1a-a766-32c3-a99e-caca36025d70",
                                                "text": "Guck dir den Gaul an!"
                                            },
                                            {
                                                "example_id": "a384751f-aaca-4d3c-8af9-da145ceb491b",
                                                "sense_id": "2b1ecf1a-a766-32c3-a99e-caca36025d70",
                                                "text": "Für den lahmen Gaul ist mir der Kaufpreis zu hoch."
                                            },
                                            {
                                                "example_id": "bda411c2-847f-47b6-80cc-c50fdf10b2d0",
                                                "sense_id": "2b1ecf1a-a766-32c3-a99e-caca36025d70",
                                                "text": "„Ein Cowboy braucht dringend einen neuen Gaul und geht zu einem Pferdehändler.“"
                                            },
                                            {
                                                "example_id": "ddf47974-8cde-4419-9b6d-41e12cfb2224",
                                                "sense_id": "2b1ecf1a-a766-32c3-a99e-caca36025d70",
                                                "text": "„Mit diesen Worten nahm er seine gewichtige Reitpeitsche, mit der er wirklich einst einen Damhirsch zu Boden geschlagen, von der Wand, steckte eine gewaltige Pistole in seine lange Rocktasche und bestieg seinen Gaul.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d1495191-cb98-397e-9a01-34527b0e7c1e",
                                        "entry_id": "24e2fb89-ddd8-3ac1-867b-bd4cde4825b4",
                                        "glosses": [
                                            "Pferd"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a69a075-5c0c-452c-a206-056407325a70",
                                                "sense_id": "d1495191-cb98-397e-9a01-34527b0e7c1e",
                                                "text": "„Es gab gar diplomatische Verwicklungen, als John Major 1993 zu seinem 50. Geburtstag vom Präsidenten Turkmenistans einen Gaul geschenkt bekam (SPIEGEL 36/1997).“"
                                            },
                                            {
                                                "example_id": "7de0eacf-4593-4162-a41e-7be7e81d861c",
                                                "sense_id": "d1495191-cb98-397e-9a01-34527b0e7c1e",
                                                "text": "„Er kam dann stets mit zwei Gäulen im Schlepptau und konnte sich bei meinem Vater mit Heu versorgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3dc42541-fbd0-47fb-b806-34ed4656d5dd",
                        "source_entry_id": "24731a5b-cdb7-3aa7-996c-366489018664",
                        "source_sense_description": "ordinary horse",
                        "target_lang_word": "Klepper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klepper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9cda8a6-673f-384d-ad71-9b84bba632f1",
                                        "entry_id": "453d28b2-8a06-3ee2-baff-fdf64a13f9a6",
                                        "glosses": [
                                            "minderwertiges, heruntergewirtschaftetes Pferd"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd0a58c4-2816-435a-9ec8-07c53ed59f50",
                                                "sense_id": "f9cda8a6-673f-384d-ad71-9b84bba632f1",
                                                "text": "„Der Klepper war völlig von Sinnen - das war er, und das ist die lautere Wahrheit, und er wußte ganz und gar nicht mehr, was er tat.“"
                                            },
                                            {
                                                "example_id": "74bd78f8-718a-400e-91b4-412d8d4c7742",
                                                "sense_id": "f9cda8a6-673f-384d-ad71-9b84bba632f1",
                                                "text": "„Wie ist es möglich, daß die Zeit so rasch verrinnt; denn sie dauerte weniger als einen Augenblick, und dabei waren die Pferde alte Klepper.“"
                                            },
                                            {
                                                "example_id": "037b4582-cd70-4254-ab70-307778c2dcc8",
                                                "sense_id": "f9cda8a6-673f-384d-ad71-9b84bba632f1",
                                                "text": "„Noch einmal warf er einen Blick über die liebliche Gegend, als wollte er seine Erbitterung kräftigen, und gab dann seinem Klepper den Sporn.“"
                                            },
                                            {
                                                "example_id": "f5ad8307-ec15-418c-b0ad-ea69e37f7cb7",
                                                "sense_id": "f9cda8a6-673f-384d-ad71-9b84bba632f1",
                                                "text": "„Und blickt man dem Alten auf dem Klepper im Vordergrund ins irre Auge, beginnt einem das Herz schneller zu schlagen, als wolle es, wenn schon nicht dem letzten Tag der Welt, dann doch dem eigenen letzten Schlag entgegenpochen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "44798002-42e7-3582-9106-776e84ee5628",
                                        "entry_id": "453d28b2-8a06-3ee2-baff-fdf64a13f9a6",
                                        "glosses": [
                                            "wasserdichter Mantel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "311d660d-21b0-4fde-9e2a-733b976e76f9",
                                                "sense_id": "44798002-42e7-3582-9106-776e84ee5628",
                                                "text": "Bei Regenwetter ist ein Klepper sehr nützlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b931469e-8d40-4d27-84bf-d5dcd3e2e1b0",
                        "source_entry_id": "24731a5b-cdb7-3aa7-996c-366489018664",
                        "source_sense_description": "horse used to ride or drive",
                        "target_lang_word": "haquenée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haquenée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b785eb36-a2fe-3d4f-b45e-5bf97f5dbc4f",
                                        "entry_id": "26d04ba8-4dd8-376c-95db-ad216feb9b89",
                                        "glosses": [
                                            "Cheval ou jument de moyenne taille, que montaient autrefois les dames et qui allait ordinairement l’amble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69c88c10-3b4a-4ae7-91ab-0e70138078b2",
                                                "sense_id": "b785eb36-a2fe-3d4f-b45e-5bf97f5dbc4f",
                                                "text": "Un écuyer tenait en main deux chevaux ; l’un des deux était le cheval noir du comte ; l’autre était une haquenée blanche qui m’était destinée."
                                            },
                                            {
                                                "example_id": "e81b9f08-db30-4a88-8c7e-864b9b627db7",
                                                "sense_id": "b785eb36-a2fe-3d4f-b45e-5bf97f5dbc4f",
                                                "text": "La pauvre Angélique, un peu rétablie, fut forcée de se remettre à cheval sur l'unique haquenée que possédait le ménage."
                                            },
                                            {
                                                "example_id": "0802f0b2-82d3-45db-8193-15c35ed3ff89",
                                                "sense_id": "b785eb36-a2fe-3d4f-b45e-5bf97f5dbc4f",
                                                "text": "Sigognac se voyait tel qu’il s’était quelquefois apparu en rêve, acteur et spectateur d’une action imaginaire se passant dans son château rebâti et orné par les habiles architectes du songe pour recevoir une infante adorée arrivant sur une haquenée blanche."
                                            },
                                            {
                                                "example_id": "933bea2a-76fd-470b-855e-830cd96b4951",
                                                "sense_id": "b785eb36-a2fe-3d4f-b45e-5bf97f5dbc4f",
                                                "text": "— Thérèse, dis-je, on sonne. Donnez-moi ma cravate et allez ouvrir ; ou bien allez ouvrir et, avec l’aide du ciel, vous me donnerez ensuite ma cravate. Mais ne restez pas ainsi, je vous prie, entre ma commode et notre porte comme une haquenée, si j’ose dire, entre deux selles."
                                            },
                                            {
                                                "example_id": "8ed29073-e0ec-4c1e-a7b0-4dc2d5521680",
                                                "sense_id": "b785eb36-a2fe-3d4f-b45e-5bf97f5dbc4f",
                                                "text": "Ce n'était plus de l'équitation mais du transport. On leur éduquait des haquenées qui allaient l’amble dans un curieux roulis dont on se demande aujourd'hui comment ces braves dames n'avaient pas, au bout d'une demi-heure, les plus affreux maux de mer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5afb1740-36ca-39b5-9574-e768946e37ea",
                                        "entry_id": "26d04ba8-4dd8-376c-95db-ad216feb9b89",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "683004ec-f48e-4216-9401-23010ecb9613",
                                                "sense_id": "5afb1740-36ca-39b5-9574-e768946e37ea",
                                                "text": "Mon âme, haquenée boiteuse des fatigues du jour, repose maintenant sur la litière dorée des songes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebf9a5b0-5744-33da-9898-dcae142c1ba2",
                                        "entry_id": "26d04ba8-4dd8-376c-95db-ad216feb9b89",
                                        "glosses": [
                                            "Grande femme mal faite et dégingandée."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81111ec3-100c-4151-9707-a3573fa70a19",
                                                "sense_id": "ebf9a5b0-5744-33da-9898-dcae142c1ba2",
                                                "text": "Une grande haquenée, sans poitrine ni cuisses, qui jetait en entrant dans un salon un regard tout autour de la tête et par ce simple moyen attirait à elle la foule des imbéciles et des vaniteux, qui se ruinent pour des femmes qui ne peuvent pas se déshabiller."
                                            },
                                            {
                                                "example_id": "e3285142-feb3-4e7a-8be5-eafb555664fd",
                                                "sense_id": "ebf9a5b0-5744-33da-9898-dcae142c1ba2",
                                                "text": "Sans cesse elle hochait son visage un peu d’une haquenée délicate, comme pour le dégager d’une belle chenille de soie, qui descendue en cascade du béguin sur l’épaule la couvrait d’une pèlerine, juste assez pesante pour empêcher qu’on ne s’envolât."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
