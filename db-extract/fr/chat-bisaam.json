                    {
                        "sense_id": "54382574-883e-31d8-8667-85202f9e5147",
                        "entry_id": "7dfc9adf-a993-308e-ae87-35711a33f28c",
                        "glosses": [
                            "Autre nom de la genette tigrine ou genette à grandes taches d’Afrique du Sud, Genetta tigrina (Schreber, 1776)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "ca4822cc-4a32-4a80-bf7e-77a79d537d69",
                                "sense_id": "54382574-883e-31d8-8667-85202f9e5147",
                                "text": "Le troisième est le Chat bisaam de Vosmaër [Arnout Vosmaer (1720-1799)], viverra tigrina, Gmel., à tort décrit, dans la première édition de ce Dictionnaire, comme appartenant au genre des chats, et figuré pl. A. 22, fig. a. M. Cuvier fait observer que le mot hollandais qui correspond à chat musqué est bisaam katjé, ce qui indique un rapport avec la genette, dont l’odeur est forte, quoique sa poche ne soit pas développée autant que celle des civettes : il remarque aussi que sa description offre une ressemblance si frappante avec celle de la genette, qu’il affirmeroit presque l’identité du bisaam avec elle. Ce bisaam (du Cap de Bonne-Espérance) est, selon Vosmaër, à peu près de la grandeur du chat domestique. La couleur dominante par tout le corps est le gris cendré clair rehaussé de taches brunes."
                            },
                            {
                                "example_id": "97dc6bc9-daaf-4e15-9917-8193f218188d",
                                "sense_id": "54382574-883e-31d8-8667-85202f9e5147",
                                "text": "chat-bisaam, subst. mas. (chabizaame), t. d’hist. nat., quadrupède d’Afrique, du genre du chat [c’est en fait une civette]."
                            }
                        ]
                    }
