                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The motorcyclist managed to <w>thread</w> <w>through</w> the heavy traffic with ease.",
                            "target_lang_translations": {
                                "ru": "Мотоциклисту удалось с легкостью <w>пробраться</w> сквозь плотный поток машин."
