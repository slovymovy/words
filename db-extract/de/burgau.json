                    }
                ],
                "senses": [
                    {
                        "sense_id": "83ede7d0-ccc2-39a1-9b60-895954bd3bab",
                        "entry_id": "2d3227fe-7ac4-3e04-bc94-cd70c4a889a6",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cac2902-0dcd-4aff-8971-681d7f9a7738",
                                "sense_id": "83ede7d0-ccc2-39a1-9b60-895954bd3bab",
                                "text": "Frau Burgau ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2d2a17f7-a5b0-4313-a0ff-1f53282bdd75",
                                "sense_id": "83ede7d0-ccc2-39a1-9b60-895954bd3bab",
                                "text": "Herr Burgau wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "31e778bb-6f8f-4f50-8753-62ec3ad0a2f7",
                                "sense_id": "83ede7d0-ccc2-39a1-9b60-895954bd3bab",
                                "text": "Die Burgaus fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "5ca311e6-cba3-4b74-801b-562e96ff0be1",
                                "sense_id": "83ede7d0-ccc2-39a1-9b60-895954bd3bab",
                                "text": "Der Burgau trägt nie die Schals, die die Burgau ihm strickt."
                            },
                            {
                                "example_id": "e7c0dd72-2e36-46f0-907e-a79b1e6d3c19",
                                "sense_id": "83ede7d0-ccc2-39a1-9b60-895954bd3bab",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Burgau kommt, geht der Herr Burgau.“"
                            },
                            {
                                "example_id": "d9d2ff65-b67d-4b46-8cc8-0f2780b0ab29",
                                "sense_id": "83ede7d0-ccc2-39a1-9b60-895954bd3bab",
                                "text": "Burgau kommt und geht."
                            },
                            {
                                "example_id": "83f5e937-977b-4310-9b0e-f2db5d90f0e2",
                                "sense_id": "83ede7d0-ccc2-39a1-9b60-895954bd3bab",
                                "text": "Burgaus kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
