                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9ca7d6e-e9f5-48f0-85ec-8229a526a530",
                        "source_entry_id": "3d3d7340-1fbd-3c84-8c14-b43a06337606",
                        "source_sense_id": "e9a22bdf-23f4-39e8-9b1a-ccfe36c89ee1",
                        "source_sense_description": "to say or declare",
                        "target_lang_word": "мо́лвить",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мо́лвить",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d8aabec5-e9d5-3f2f-af8c-075d440d86df",
                                        "entry_id": "147e7c4c-1f7d-3c16-a970-e957ef267a5b",
                                        "glosses": [
                                            "устар. говорить (сказать); произносить (произнести)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87ff5415-66a2-402b-aee7-cc0fac50112c",
                                                "sense_id": "d8aabec5-e9d5-3f2f-af8c-075d440d86df",
                                                "text": "Не умеет ни одеться, ни молвить, как должно галантому, ни шпаги пониже спустить, ни о дамских говорить уборах, да думает ещё, что это и не надобно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c230b25-3b7d-4f18-9f40-f960d3d13c6d",
                        "source_entry_id": "3d3d7340-1fbd-3c84-8c14-b43a06337606",
                        "source_sense_id": "e9a22bdf-23f4-39e8-9b1a-ccfe36c89ee1",
                        "source_sense_description": "to say or declare",
                        "target_lang_word": "промо́лвить",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "промо́лвить",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4046141a-ba7b-36bf-9923-0c1a3472ccf1",
                                        "entry_id": "e1b62340-6b5d-3975-921f-744fe3075f26",
                                        "glosses": [
                                            "сказать, проговорить; произнести"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61e69a7e-57c5-4b51-8dac-5ef7465dcb5b",
                                                "sense_id": "4046141a-ba7b-36bf-9923-0c1a3472ccf1",
                                                "text": "Я от слёз слова промолвить не мог."
                                            },
                                            {
                                                "example_id": "65940e50-12d5-41d2-a1cc-d44e0f65e613",
                                                "sense_id": "4046141a-ba7b-36bf-9923-0c1a3472ccf1",
                                                "text": "— Эротида! — едва промолвил ротмистр. Чуть внятное прощай повторилось."
                                            },
                                            {
                                                "example_id": "5b9805eb-ff8c-41de-8e86-dda26e873d1e",
                                                "sense_id": "4046141a-ba7b-36bf-9923-0c1a3472ccf1",
                                                "text": "— Ох, нет, барин, — промолвила она озабоченным шёпотом, — не переводи́те меня в больницу, не трогайте меня."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
