                "senses": [
                    {
                        "sense_id": "30c8a3a5-cda3-36c7-b1c3-72d6554f25ed",
                        "entry_id": "45be07ef-bb0c-3904-b166-7e353866c43a",
                        "glosses": [
                            "besonders angesehenes Senatsmitglied, das bei Abstimmungen als Erster seine Stimme abgeben konnte"
                        ],
                        "tags": [
                            "historical",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f1eb97b1-25e0-488b-a139-a4beb7c4aff3",
                                "sense_id": "30c8a3a5-cda3-36c7-b1c3-72d6554f25ed",
                                "text": "Die Prinzipes waren entweder alle Senatsmitglieder, nur die aktiven unter ihnen oder ganz besonders hervorgehobene Individuen, alle Bedeutungen kommen, wenn auch selten, in Texten vor."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "29ad4d73-e8db-3233-bc52-358164b7a1b6",
                        "entry_id": "45be07ef-bb0c-3904-b166-7e353866c43a",
                        "glosses": [
                            "Titel römischer Kaiser als Inhaber der höchsten Zivilgewalt"
                        ],
                        "tags": [
                            "historical",
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "4888ec37-0db9-45f0-be53-8f21fc70908b",
                                "sense_id": "29ad4d73-e8db-3233-bc52-358164b7a1b6",
                                "text": "„Die Rede von der wiederhergestellten Republik funktionierte, weil viele Menschen, zermürbt von den Bürgerkriegen, daran glauben wollten und sich von der höchst kunstvollen Propaganda des Prinzeps in Form von Inschriften, Bauten und Stauen beeindrucken ließen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
