                    "sense_id": "534c177a-bc60-315f-88c3-4053ca66b8b0",
                    "sense_definition": "overdreven dol of idolaat op iets of iemand worden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affectie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij begon langzaam te <w>verzotten</w> op die oude klassieke auto's.",
                            "target_lang_translations": {
                                "en": "He slowly started <w>to grow crazy about</w> those old classic cars."
                            }
                        },
                        {
                            "text": "Zij is helemaal <w>verzot</w> op chocolade en kan er geen dag zonder.",
                            "target_lang_translations": {
