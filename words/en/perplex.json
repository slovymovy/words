{
    "word_family": [
        "perplexed",
        "perplexing",
        "perplexity",
        "perplexedly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "58049438-4494-32bf-90e7-446815dfbe29",
                    "sense_definition": "To cause someone to feel baffled, confused, or uncertain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_confusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex instructions for the new software continue to <w>perplex</w> even the most experienced users.",
                            "target_lang_translations": {
                                "ru": "Сложные инструкции к новому программному обеспечению продолжают <w>озадачивать</w> даже самых опытных пользователей.",
                                "pl": "Złożone instrukcje nowego oprogramowania wciąż <w>wprawiają w zakłopotanie</w> nawet najbardziej doświadczonych użytkowników."
                            }
                        },
                        {
                            "text": "His sudden change in behavior began to <w>perplex</w> his friends who knew him well.",
                            "target_lang_translations": {
                                "ru": "Его внезапная перемена в поведении начала <w>сбивать с толку</w> его друзей, которые хорошо его знали.",
                                "pl": "Jego nagła zmiana zachowania zaczęła <w>dezorientować</w> przyjaciół, którzy dobrze go znali."
                            }
                        }
                    ],
                    "synonyms": [
                        "puzzle",
                        "baffle",
                        "confuse",
                        "bewilder",
                        "mystify"
                    ],
                    "antonyms": [
                        "clarify",
                        "enlighten",
                        "explain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводить кого-либо в замешательство, недоумение или вызывать чувство неуверенности.",
                        "pl": "Powodować, że ktoś czuje się zdezorientowany, zmieszany lub niepewny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озадачивать",
                                "target_lang_sense_clarification": "приводить в состояние недоумения"
                            },
                            {
                                "target_lang_word": "сбивать с толку",
                                "target_lang_sense_clarification": "заставлять потерять нить рассуждений"
                            },
                            {
                                "target_lang_word": "приводить в недоумение",
                                "target_lang_sense_clarification": "вызывать сильное удивление и непонимание"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wprawiać w zakłopotanie",
                                "target_lang_sense_clarification": "powodować uczucie zmieszania"
                            },
                            {
                                "target_lang_word": "dezorientować",
                                "target_lang_sense_clarification": "pozbawiać jasności myślenia"
                            },
                            {
                                "target_lang_word": "zbić z tropu",
                                "target_lang_sense_clarification": "sprawić, że ktoś traci pewność siebie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1873d49-bd38-3a4f-b1b0-9e29290ef4c2",
                    "sense_definition": "To make something complicated, intricate, or difficult to understand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adding unnecessary legal jargon will only <w>perplex</w> the issue further for the jury.",
                            "target_lang_translations": {
                                "ru": "Добавление ненужного юридического жаргона только сильнее <w>запутает</w> этот вопрос для присяжных.",
                                "pl": "Dodanie niepotrzebnego żargonu prawniczego tylko bardziej <w>zagmatwa</w> tę sprawę dla ławy przysięgłych."
                            }
                        },
                        {
                            "text": "The author tried not to <w>perplex</w> the plot with too many minor characters.",
                            "target_lang_translations": {
                                "ru": "Автор старался не <w>усложнять</w> сюжет слишком большим количеством второстепенных персонажей.",
                                "pl": "Autor starał się nie <w>komplikować</w> fabuły zbyt dużą liczbą drugoplanowych postaci."
                            }
                        }
                    ],
                    "synonyms": [
                        "complicate",
                        "entangle",
                        "muddle"
                    ],
                    "antonyms": [
                        "simplify",
                        "unravel"
                    ],
                    "common_phrases": [
                        "perplex the issue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо сложным, запутанным или трудным для понимания.",
                        "pl": "Czynić coś skomplikowanym, zawiłym lub trudnym do zrozumienia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запутывать",
                                "target_lang_sense_clarification": "делать вопрос или ситуацию сложной"
                            },
                            {
                                "target_lang_word": "усложнять",
                                "target_lang_sense_clarification": "делать более трудным для разрешения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "komplikować",
                                "target_lang_sense_clarification": "czynić coś trudniejszym"
                            },
                            {
                                "target_lang_word": "zagmatwać",
                                "target_lang_sense_clarification": "uczynić coś niejasnym lub zawiłym"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65b2366c-78bd-3244-8c24-fdc303ae8a5f",
                    "sense_definition": "To plague, vex, or cause minor torment to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise from the street would <w>perplex</w> his mind during his evening studies.",
                            "target_lang_translations": {
                                "ru": "Постоянный шум с улицы <w>беспокоил</w> его ум во время вечерних занятий.",
                                "pl": "Ciągły hałas z ulicy <w>niepokoił</w> go podczas wieczornej nauki."
                            }
                        },
                        {
                            "text": "She did not wish to <w>perplex</w> her host with her many dietary requirements.",
                            "target_lang_translations": {
                                "ru": "Она не хотела <w>изводить</w> хозяина своими многочисленными диетическими требованиями.",
                                "pl": "Nie chciała <w>dokuczać</w> gospodarzowi swoimi licznymi wymaganiami dietetycznymi."
                            }
                        }
                    ],
                    "synonyms": [
                        "vex",
                        "plague",
                        "torment",
                        "trouble"
                    ],
                    "antonyms": [
                        "soothe",
                        "please"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is primarily found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Досаждать, изводить или причинять мелкие мучения (устаревшее).",
                        "pl": "Dokuczać, niepokoić lub sprawiać komuś drobne kłopoty (przestarzałe)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изводить",
                                "target_lang_sense_clarification": "мучить или досаждать"
                            },
                            {
                                "target_lang_word": "беспокоить",
                                "target_lang_sense_clarification": "тревожить или доставлять неудобства"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niepokoić",
                                "target_lang_sense_clarification": "zakłócać spokój"
                            },
                            {
                                "target_lang_word": "dokuczać",
                                "target_lang_sense_clarification": "sprawiać przykrość"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b37222bc-4c96-3210-8227-42757671f8dc",
                    "sense_definition": "Intricate, complicated, or difficult to follow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "complexity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher presented a <w>perplex</w> theory that few in the audience could grasp.",
                            "target_lang_translations": {
                                "ru": "Философ представил <w>запутанную</w> теорию, которую немногие в аудитории смогли понять.",
                                "pl": "Filozof przedstawił <w>zawiłą</w> teorię, którą niewielu słuchaczy było w stanie zrozumieć."
                            }
                        },
                        {
                            "text": "They found themselves lost in a <w>perplex</w> maze of narrow city streets.",
                            "target_lang_translations": {
                                "ru": "Они обнаружили, что заблудились в <w>сложном</w> лабиринте узких городских улиц.",
                                "pl": "Zgubili się w <w>skomplikowanym</w> labiryncie wąskich miejskich uliczek."
                            }
                        }
                    ],
                    "synonyms": [
                        "intricate",
                        "complex",
                        "involved"
                    ],
                    "antonyms": [
                        "simple",
                        "clear"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The adjective form is largely replaced by 'perplexing' in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запутанный, сложный или трудный для понимания (устаревшее).",
                        "pl": "Zawiły, skomplikowany lub trudny do zrozumienia (przestarzałe)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запутанный",
                                "target_lang_sense_clarification": "сложный для следования или понимания"
                            },
                            {
                                "target_lang_word": "сложный",
                                "target_lang_sense_clarification": "состоящий из множества переплетенных деталей"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zawiły",
                                "target_lang_sense_clarification": "trudny do zrozumienia"
                            },
                            {
                                "target_lang_word": "skomplikowany",
                                "target_lang_sense_clarification": "mający wiele elementów"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e3828b9b-bc55-3201-b719-7619d09f8e6a",
                    "sense_definition": "A state of difficulty or a puzzling situation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loss of funding created a significant <w>perplex</w> for the research team.",
                            "target_lang_translations": {
                                "ru": "Внезапная потеря финансирования создала значительное <w>затруднение</w> для исследовательской группы.",
                                "pl": "Nagła utrata finansowania stworzyła znaczący <w>kłopot</w> dla zespołu badawczego."
                            }
                        },
                        {
                            "text": "He faced a great <w>perplex</w> when forced to choose between his career and his family.",
                            "target_lang_translations": {
                                "ru": "Он столкнулся с большой <w>дилеммой</w>, когда был вынужден выбирать между карьерой и семьей.",
                                "pl": "Stanął przed wielkim <w>dylematem</w>, gdy musiał wybierać między karierą a rodziną."
                            }
                        }
                    ],
                    "synonyms": [
                        "difficulty",
                        "dilemma",
                        "puzzle"
                    ],
                    "antonyms": [
                        "solution",
                        "certainty"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The noun form is rare; 'perplexity' is the standard modern term."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние затруднения или загадочная ситуация (устаревшее).",
                        "pl": "Stan trudności lub zagadkowa sytuacja (przestarzałe)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затруднение",
                                "target_lang_sense_clarification": "трудная ситуация"
                            },
                            {
                                "target_lang_word": "недоумение",
                                "target_lang_sense_clarification": "состояние растерянности"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kłopot",
                                "target_lang_sense_clarification": "trudna sytuacja"
                            },
                            {
                                "target_lang_word": "dylemat",
                                "target_lang_sense_clarification": "trudny wybór"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}