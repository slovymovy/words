                    ]
                },
                {
                    "sense_id": "0c4119f7-e7e9-322d-be27-f5754e39dcc6",
                    "sense_definition": "Utiliser, employer des notions, des idées ou des formes linguistiques avec aisance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce brillant philosophe sait <w>manipuler</w> des concepts abstraits avec une remarquable clarté."
                        },
                        {
                            "text": "Elle <w>manipule</w> plusieurs registres de langue selon le public auquel elle s'adresse."
