                    {
                        "translation_id": "d35ae839-df11-4565-aa69-dd15a9a9a409",
                        "source_entry_id": "66f2de37-2937-34cc-be5f-b4856795a985",
                        "source_sense_description": "act or process of transferring possession of land",
                        "target_lang_word": "inféodation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inféodation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be6edabd-3fad-37ee-8b68-144ebe4af1f2",
                                        "entry_id": "de3cf5a6-ee0b-3457-a364-9703e40e29a3",
                                        "glosses": [
                                            "Acte par lequel le seigneur aliénait une terre et la donnait pour être tenue de lui en fief."
                                        ],
                                        "tags": [
                                            "Droit féodal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dffba43-47ce-48ed-8ef2-a516e054cd0a",
                                                "sense_id": "be6edabd-3fad-37ee-8b68-144ebe4af1f2",
                                                "text": "Mon bureau est couvert de titres, d'actes d'inféodation, de brevets, de charges portant noblesse; …. — (Julie de Quérangal, Philippe de Morvelle, Revue des Deux Mondes, T.2,4, 1833)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bee310a9-08cd-3aa0-b79a-f5e3d7968078",
                                        "entry_id": "de3cf5a6-ee0b-3457-a364-9703e40e29a3",
                                        "glosses": [
                                            "Soumission à une autorité."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fab9f493-3fcf-46a9-980c-7a2740a2f0f4",
                                                "sense_id": "bee310a9-08cd-3aa0-b79a-f5e3d7968078",
                                                "text": "Les seigneurs, […] que la prudence de Henri II avait à peine réduits à une espèce d’inféodation à la Couronne, avaient maintenant repris leur ancienne licence dans toute son étendue, …."
                                            },
                                            {
                                                "example_id": "f986ff9e-cc52-4d39-aa0f-3be80e65ac26",
                                                "sense_id": "bee310a9-08cd-3aa0-b79a-f5e3d7968078",
                                                "text": "Autre exemple : Pompeo a placé les Houtis sur la liste des terroristes, alors que cette population chiite essaie surtout de se défendre contre l’inféodation' du Yémen à l’Arabie saoudite."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
