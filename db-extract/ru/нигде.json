                    {
                        "translation_id": "9504d034-98f0-4769-a321-579361624d10",
                        "source_entry_id": "19bfeebf-1642-31d5-bbc4-0978ef47207f",
                        "source_sense_id": "b68fb090-57d3-3981-8833-287d0ace0842",
                        "target_lang_word": "in nessun posto",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "64ba71ee-c4a8-40a1-a650-1e0aa567b414",
                        "source_entry_id": "19bfeebf-1642-31d5-bbc4-0978ef47207f",
                        "source_sense_id": "b68fb090-57d3-3981-8833-287d0ace0842",
                        "target_lang_word": "nirgendwo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nirgendwo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5a93fb-c8ed-3904-8d84-29b223c69bc3",
                                        "entry_id": "19f9b637-81c7-3fe9-9019-8d879fbc27e3",
                                        "glosses": [
                                            "an keinem Ort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf355826-9558-45e4-8d84-e9c21634c736",
                                                "sense_id": "5a5a93fb-c8ed-3904-8d84-29b223c69bc3",
                                                "text": "Nirgendwo kann man seine Ruhe haben!"
                                            },
                                            {
                                                "example_id": "4070ae7d-dd26-4bbd-b214-11d6c79bf021",
                                                "sense_id": "5a5a93fb-c8ed-3904-8d84-29b223c69bc3",
                                                "text": "Ich habe meinen Geldbeutel überall gesucht, aber nirgendwo gefunden."
                                            },
                                            {
                                                "example_id": "6de8a9f2-d14e-42a4-a63e-f7c81fda64e5",
                                                "sense_id": "5a5a93fb-c8ed-3904-8d84-29b223c69bc3",
                                                "text": "„Sie sind »schollengebunden«, das heißt, sie dürfen nirgendwo anders hinziehen, müssen für ihre kümmerlichen Äcker dem Grafen Frondienst leisten und ihn sogar bei allen familiären Veränderungen, etwa Heiraten, um Erlaubnis fragen.“"
                                            },
                                            {
                                                "example_id": "c6ceb28e-d2b6-463b-99b8-37bd04715cd2",
                                                "sense_id": "5a5a93fb-c8ed-3904-8d84-29b223c69bc3",
                                                "text": "„Nirgendwo sind Investoren aus dem In- und Ausland so aktiv.“"
                                            },
                                            {
                                                "example_id": "36eb950a-2d75-4493-8f54-15a4f6a59776",
                                                "sense_id": "5a5a93fb-c8ed-3904-8d84-29b223c69bc3",
                                                "text": "Nirgendwo in der westlichen Welt gibt es so viele Waffen [wie in Amerika], nirgendwo sonst werden so viele Morde begangen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d9effe5-ef6e-43e4-80ae-e3696d48d6b9",
                        "source_entry_id": "19bfeebf-1642-31d5-bbc4-0978ef47207f",
                        "source_sense_id": "b68fb090-57d3-3981-8833-287d0ace0842",
                        "target_lang_word": "nirgends",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nirgends",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce2bb2d8-d23e-3955-b72c-64be788387e5",
                                        "entry_id": "30930d73-9211-38ac-ad96-caebfa769430",
                                        "glosses": [
                                            "an keinem Ort, nirgendwo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee87f73c-b4a1-40cd-9c91-633a55c0bc7d",
                                                "sense_id": "ce2bb2d8-d23e-3955-b72c-64be788387e5",
                                                "text": "Ich suche seit zwei Stunden meine Brille, aber ich kann sie nirgends finden."
                                            },
                                            {
                                                "example_id": "1d34bed1-4a77-4e10-877c-51052e0d5d83",
                                                "sense_id": "ce2bb2d8-d23e-3955-b72c-64be788387e5",
                                                "text": "Er wollte am liebsten nirgends auffallen."
                                            },
                                            {
                                                "example_id": "0b615d3a-c137-47ed-9ce0-677e1e6fb7e7",
                                                "sense_id": "ce2bb2d8-d23e-3955-b72c-64be788387e5",
                                                "text": "Leider ist dieser Artikel nirgends erhältlich."
                                            },
                                            {
                                                "example_id": "76cab074-54b1-45f1-86c5-f16a6197f14d",
                                                "sense_id": "ce2bb2d8-d23e-3955-b72c-64be788387e5",
                                                "text": "„Dann darf ich nirgends mehr spielen, und immerzu fallen Bomben auf meinen Kopf.“"
                                            },
                                            {
                                                "example_id": "81257ebf-ba2d-4270-b963-4442130d4532",
                                                "sense_id": "ce2bb2d8-d23e-3955-b72c-64be788387e5",
                                                "text": "„Bewacht wird die Zufahrt von zwei Wärtern in Tarnuniform, von denen einer auf einem Holzturm achtgibt, dass der Wald nirgends brennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3caed953-2b12-44c1-9408-033950b1aab7",
                        "source_entry_id": "19bfeebf-1642-31d5-bbc4-0978ef47207f",
                        "source_sense_id": "b68fb090-57d3-3981-8833-287d0ace0842",
                        "target_lang_word": "nergens",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nergens",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f5dd9a2a-5b5e-3b05-af79-36efa9096c18",
                                        "entry_id": "f49f4b77-72e5-3634-9fef-f58991c98c6c",
                                        "glosses": [
                                            "op geen enkele plaats"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d7a5777-f01c-4e0b-a3b3-71abe93a7fe8",
                                                "sense_id": "f5dd9a2a-5b5e-3b05-af79-36efa9096c18",
                                                "text": "Dat zul je nergens aantreffen."
                                            },
                                            {
                                                "example_id": "98a90b57-7e87-49e1-803e-19e3d23fedf2",
                                                "sense_id": "f5dd9a2a-5b5e-3b05-af79-36efa9096c18",
                                                "text": "Ze besloten zich vanaf een plateau in een meertje te storten. In werkelijkheid kunnen ze alleen maar wadend in de troebele poel hun dood tegemoet zijn gelopen - een nabij ravijn is nergens te bekennen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f31bea95-1131-3e43-9837-bc06a2c3aadd",
                                        "entry_id": "f49f4b77-72e5-3634-9fef-f58991c98c6c",
                                        "glosses": [
                                            "als locatief deel van een samengesteld voornaamwoordelijk bijwoord vervangt het een ontkennend voornaamwoord als niets of niks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a70ca814-e478-4275-93d8-c28a837f251d",
                                                "sense_id": "f31bea95-1131-3e43-9837-bc06a2c3aadd",
                                                "text": "Hij praatte over niets => hij praatte nergens over."
                                            },
                                            {
                                                "example_id": "a4902348-2212-428c-991a-efb348794b01",
                                                "sense_id": "f31bea95-1131-3e43-9837-bc06a2c3aadd",
                                                "text": "Hij maakte zich nergens druk om, al helemaal niet over morgen en was een echte hippie met zijn geliefde hasjpijp in zijn mond."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b90dcee-1723-42a0-9b6c-eb200c54d62b",
                        "source_entry_id": "19bfeebf-1642-31d5-bbc4-0978ef47207f",
