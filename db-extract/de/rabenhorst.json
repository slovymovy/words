                "senses": [
                    {
                        "sense_id": "4ec7d438-b22a-3b36-ad95-febc8b95ec4e",
                        "entry_id": "fee438e6-1955-3911-b79a-1f038add0854",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "962cd330-d3b7-4a18-9a9b-9ed6e3ac92bd",
                                "sense_id": "4ec7d438-b22a-3b36-ad95-febc8b95ec4e",
                                "text": "Frau Rabenhorst ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "806ce2d2-e00d-4ae5-a4da-2797a161b69d",
                                "sense_id": "4ec7d438-b22a-3b36-ad95-febc8b95ec4e",
                                "text": "Herr Rabenhorst wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "829c99ae-6bfc-4136-87e6-32e59bf0541d",
                                "sense_id": "4ec7d438-b22a-3b36-ad95-febc8b95ec4e",
                                "text": "Die Rabenhorsts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "dcb737e2-e43b-4e6b-9793-34bc3722cf62",
                                "sense_id": "4ec7d438-b22a-3b36-ad95-febc8b95ec4e",
                                "text": "Der Rabenhorst trägt nie die Schals, die die Rabenhorst ihm strickt."
                            },
                            {
                                "example_id": "d3b0f20c-296b-4d30-ba27-680b30191c4e",
                                "sense_id": "4ec7d438-b22a-3b36-ad95-febc8b95ec4e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rabenhorst kommt, geht der Herr Rabenhorst.“"
                            },
                            {
                                "example_id": "49e56176-c5d7-43bc-8af2-be05669d6866",
                                "sense_id": "4ec7d438-b22a-3b36-ad95-febc8b95ec4e",
                                "text": "Rabenhorst kommt und geht."
                            },
                            {
                                "example_id": "f16e130d-7de7-429b-af03-271ea360009f",
                                "sense_id": "4ec7d438-b22a-3b36-ad95-febc8b95ec4e",
                                "text": "Rabenhorsts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
