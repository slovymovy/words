                ],
                "senses": [
                    {
                        "sense_id": "0da8d7c0-10fa-3360-90f7-2b449f24d25f",
                        "entry_id": "951a64a1-9117-31f4-89f0-6ac286235afa",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2773e96-0d53-4e50-8d01-1ee34ca223a5",
                                "sense_id": "0da8d7c0-10fa-3360-90f7-2b449f24d25f",
                                "text": "Frau Denk ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9b22807a-e8e9-41ca-8ddf-edee95cbe73e",
                                "sense_id": "0da8d7c0-10fa-3360-90f7-2b449f24d25f",
                                "text": "Herr Denk wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9ad48ded-7b3d-4d66-b0cb-26736d56b1ef",
                                "sense_id": "0da8d7c0-10fa-3360-90f7-2b449f24d25f",
                                "text": "Die Denks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7ac38373-a43f-4209-99f0-9228fd3e5151",
                                "sense_id": "0da8d7c0-10fa-3360-90f7-2b449f24d25f",
                                "text": "Der Denk trägt nie die Schals, die die Denk ihm strickt."
                            },
                            {
                                "example_id": "cd0fb2c0-b781-40c9-9530-d10a22309df7",
                                "sense_id": "0da8d7c0-10fa-3360-90f7-2b449f24d25f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Denk kommt, geht der Herr Denk.“"
                            },
                            {
                                "example_id": "c5565acb-46fc-4d80-bec9-0a58d94a45ec",
                                "sense_id": "0da8d7c0-10fa-3360-90f7-2b449f24d25f",
                                "text": "Denk kommt und geht."
                            },
                            {
                                "example_id": "96cbaace-f0f6-41bf-a771-8e0d45b87639",
                                "sense_id": "0da8d7c0-10fa-3360-90f7-2b449f24d25f",
                                "text": "Denks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
