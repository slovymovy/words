            "pos": "verb",
            "senses": [
                {
                    "sense_id": "82624a19-792f-316e-88a3-cd9fd2785785",
                    "sense_definition": "To find out something definitely or to discover the truth about a situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "discovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>ascertain</w> the cause of the accident before we can fix the problem."
                        },
                        {
                            "text": "As soon as we <w>ascertain</w> the facts, we will inform the public."
                        }
                    ],
                    "synonyms": [
                        "determine",
                        "discover",
                        "find out",
                        "work out"
                    ],
                    "common_phrases": [
