                {
                    "sense_id": "abbd7b70-ccee-3763-b95a-433c50793c6e",
                    "sense_definition": "Qui est bizarre, insolite ou inattendu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "étrangeté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est une <w>drôle</w> d'idée de sortir sans manteau en plein hiver.",
                            "target_lang_translations": {
                                "en": "It's a <w>strange</w> idea to go out without a coat in the middle of winter.",
                                "ru": "Это <w>странная</w> идея — выходить без пальто посреди зимы.",
                                "nl": "Het is een <w>rare</w> idee om midden in de winter zonder jas naar buiten te gaan.",
                                "de": "Es ist eine <w>komische</w> Idee, mitten im Winter ohne Mantel hinauszugehen.",
                                "pl": "To <w>dziwny</w> pomysł, żeby wychodzić bez płaszcza w środku zimy.",
                                "it": "È una <w>strana</w> idea uscire senza cappotto in pieno inverno.",
                                "cs": "Je to <w>divný</w> nápad vyjít ven bez kabátu uprostřed zimy.",
                                "tr": "Kışın ortasında paltosuz dışarı çıkmak <w>garip</w> bir fikir.",
                                "es": "Es una idea <w>extraña</w> salir sin abrigo en pleno invierno.",
                                "zh": "大冬天不穿外套出门，这个想法真<w>奇怪</w>。"
                            }
                        },
                        {
                            "text": "J'ai entendu un <w>drôle</w> de bruit venant du grenier au milieu de la nuit.",
                            "target_lang_translations": {
                                "en": "I heard a <w>strange</w> noise coming from the attic in the middle of the night.",
                                "ru": "Посреди ночи я услышал доносившийся с чердака <w>странный</w> шум.",
                                "nl": "Midden in de nacht hoorde ik een <w>vreemd</w> geluid van zolder komen.",
                                "de": "Mitten in der Nacht hörte ich ein <w>merkwürdiges</w> Geräusch vom Dachboden.",
                                "pl": "W środku nocy usłyszałem dochodzący ze strychu <w>dziwny</w> dźwięk.",
                                "it": "Nel mezzo della notte ho sentito un rumore <w>strano</w> provenire dal solaio.",
                                "cs": "Uprostřed noci jsem z půdy slyšel <w>podivný</w> zvuk.",
                                "tr": "Gecenin ortasında çatı katından <w>garip</w> bir ses duydum.",
                                "es": "En medio de la noche oí un <w>extraño</w> ruido que venía del desván.",
                                "zh": "半夜里，我听到阁楼传来一种<w>奇怪</w>的声音。"
                            }
                        }
