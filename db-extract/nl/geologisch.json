                                "target_senses": [
                                    {
                                        "sense_id": "bb6157c4-13b1-324e-b330-b565ff55634b",
                                        "entry_id": "00779216-abf9-36ea-81ea-7815c5562da2",
                                        "glosses": [
                                            "Synonym of geologic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2a88c5d-0b8c-4f27-95ad-0b11683ad521",
                                                "sense_id": "bb6157c4-13b1-324e-b330-b565ff55634b",
                                                "text": "Phoenix and Lubbock are both caught in severe drought, and it is going to get much worse. We may see many such [dust] storms in the decades ahead, along with species extinctions, radical disturbance of ecosystems, and intensified social conflict over land and water. Welcome to the Anthropocene, the epoch when humans have become a major geological and climatic force."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "904cce10-b237-450b-8701-a3fe2fa19b72",
                        "source_entry_id": "7b237384-427a-30bc-9164-17a50f67eafc",
                        "source_sense_id": "470196d4-064c-3035-8556-64bf5c066edf",
                        "source_sense_description": "op de geologie betrekking hebbend",
                        "target_lang_word": "géologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cd8176a-a474-36d8-9843-24ae04b14420",
                                        "entry_id": "f4986968-239b-3caa-be68-4fb783ba33d5",
                                        "glosses": [
                                            "Qui concerne la géologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e8293ab-8919-4fc4-8f29-3a296ef0e8f8",
                                                "sense_id": "6cd8176a-a474-36d8-9843-24ae04b14420",
                                                "text": "[…], le sol, on le voit, s’était absolument modifié. Il était évident que quelque convulsion géologique y avait semé ces blocs énormes."
                                            },
                                            {
                                                "example_id": "0e7eb154-5134-4c68-aefe-0f3ed635ed7e",
                                                "sense_id": "6cd8176a-a474-36d8-9843-24ae04b14420",
                                                "text": "Nous avons vu que le squelette géologique de Chausey était entièrement granitique, …."
                                            },
                                            {
                                                "example_id": "46340fbc-b208-4259-8602-fa0f65abb8ea",
                                                "sense_id": "6cd8176a-a474-36d8-9843-24ae04b14420",
                                                "text": "Ces montagnes, en raison de leur constitution géologique, sont plus que n’importe quelles autres soumises à l’influence de l’érosion."
                                            },
                                            {
                                                "example_id": "0ca93911-27a7-45fa-98da-758c89ee16c8",
                                                "sense_id": "6cd8176a-a474-36d8-9843-24ae04b14420",
                                                "text": "Il avait établi le catalogue des champignons de toute la région, par aires géologiques préférentielles."
                                            },
                                            {
                                                "example_id": "3e60485c-0dac-4a46-b915-ced7ca3d7d78",
                                                "sense_id": "6cd8176a-a474-36d8-9843-24ae04b14420",
                                                "text": "Depuis 1968, le BRGM s’est vu confier la mission de réaliser les cartes géologiques de la France. Trois échelles sont disponibles et chacune possède sa propre utilité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
