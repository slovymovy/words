                ],
                "senses": [
                    {
                        "sense_id": "b7977bf3-c892-3744-b0c3-470199fe81f7",
                        "entry_id": "3b676b70-c604-3d80-907d-38045aa1da80",
                        "glosses": [
                            "Person, die gezwungen ist, sich außerhalb ihrer Heimat aufzuhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fdac85c-d0a3-44f5-9e03-3d9a5e3568f3",
                                "sense_id": "b7977bf3-c892-3744-b0c3-470199fe81f7",
                                "text": "„Noch kann sie nicht nachempfinden, was es heißt, Emigrant zu sein, ein Heimatloser unter lauter Inländern.“"
                            },
                            {
                                "example_id": "625856e0-5cbc-4b10-a510-0f0299603209",
                                "sense_id": "b7977bf3-c892-3744-b0c3-470199fe81f7",
                                "text": "„Benoit ist der Abenteurer-Dichter schlechthin, ist Outsider, Anarch und ewig Heimatloser, zum kleineren Teil mythologische Reminiszenz an Odysseus – im 20. Jahrhundert die zentrale mythologische Referenz- und Identifikationsfigur.“"
                            },
                            {
                                "example_id": "3db53db4-62ad-4898-acff-999452565c80",
                                "sense_id": "b7977bf3-c892-3744-b0c3-470199fe81f7",
                                "text": "„Die Bahnhöfe sind nicht nur die elenden Wartesäle für übermüdete, erschöpfte Reisende; sie sind die Heimat der Heimatlosen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e46a564b-78d3-4c03-85ad-a5cbbabdd9bb",
                        "source_entry_id": "3b676b70-c604-3d80-907d-38045aa1da80",
                        "source_sense_id": "b7977bf3-c892-3744-b0c3-470199fe81f7",
                        "source_sense_description": "Person, die gezwungen ist, sich außerhalb ihrer Heimat aufzuhalten",
                        "target_lang_word": "réfugié",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réfugié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "143d091b-48d9-348c-867d-3a8f4fe5a35e",
                                        "entry_id": "14cb02a0-6429-37c7-afb3-4be46b2e7e00",
                                        "glosses": [
                                            "Personne qui a quitté son pays ou sa région pour fuir un danger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3015114f-5855-403c-b9c7-81403bfa15d7",
                                                "sense_id": "143d091b-48d9-348c-867d-3a8f4fe5a35e",
                                                "text": "16 mai, 10 heures. — Une section dont l'effectif est au complet, vient de quitter par ordre du commandement un secteur menacé et se dirige vers l'Aisne par la route de Terron-les-Poix, vers un probable point de ralliement. Les hommes marchent un par un derrière leur chef, au milieu des colonnes interminables des réfugiés."
                                            },
                                            {
                                                "example_id": "8460f754-310e-405f-8214-3b4b3ddf5edb",
                                                "sense_id": "143d091b-48d9-348c-867d-3a8f4fe5a35e",
                                                "text": "Les États signataires s’engagent à ne pas refouler un réfugié et lui accorder un asile provisoire en attendant de trouver un État disposé à le recevoir."
                                            },
                                            {
                                                "example_id": "038ccf0e-1b64-42cb-b046-9686eda07725",
                                                "sense_id": "143d091b-48d9-348c-867d-3a8f4fe5a35e",
                                                "text": "En Franche-Comté, les réfugiés trouvèrent une législation à peu près aussi tracassière que celle qu'ils avaient connu en France."
                                            },
                                            {
                                                "example_id": "f6d2d284-cc93-4592-ab72-b4032bce820a",
                                                "sense_id": "143d091b-48d9-348c-867d-3a8f4fe5a35e",
                                                "text": "Après ce voyage pénible et plein d'angoisse, l'accueil est un peu confus, mais correct. Les Charentais donnent l'impression de ne pas savoir très bien comment ils vont pouvoir absorber tous ces réfugiés. Les maires sont continuellement bombardés de messages du préfet, annonçant l'arrivée de nouveaux trains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c23003ef-9f4b-3cb5-9647-33ab7845054f",
                                        "entry_id": "14cb02a0-6429-37c7-afb3-4be46b2e7e00",
                                        "glosses": [
                                            "Calviniste que la Révocation de l’Édit de Nantes fit sortir de France."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "réfugié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd146da8-accb-307c-89ae-14c987de526f",
