                ],
                "senses": [
                    {
                        "sense_id": "9ddae290-e656-3d5d-9d75-ad604775bd18",
                        "entry_id": "cb465953-bcff-3ffb-bc72-b6644e5fbcd7",
                        "glosses": [
                            "Sacraliser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8332565-da89-4473-a7c3-76799153e43e",
                                "sense_id": "9ddae290-e656-3d5d-9d75-ad604775bd18",
                                "text": "Veut-elle resacraliser une aventure assez banale de notre siècle en la hissant à la dignité légendaire ?"
                            },
                            {
                                "example_id": "d5175d2e-93b9-41d2-b858-99a3e30a6041",
                                "sense_id": "9ddae290-e656-3d5d-9d75-ad604775bd18",
                                "text": "Le pamphlet doit donc resacraliser les icônes."
                            },
                            {
                                "example_id": "762105f4-dfa9-475c-aa55-3101fa77e162",
                                "sense_id": "9ddae290-e656-3d5d-9d75-ad604775bd18",
                                "text": "Ainsi, A. S Byatt semble resacraliser par l’appropriation du factuel ce qui a été désacralisé par son personnage, et qui relève de l’ordre du fictionnel."
                            }
                        ]
                    }
                ],
