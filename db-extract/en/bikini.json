                    {
                        "translation_id": "411e3913-9ad4-4698-9634-020a27b2f856",
                        "source_entry_id": "cbce6b09-e853-3735-a206-fb24abd1673a",
                        "source_sense_description": "bathing suit",
                        "target_lang_word": "bikini",
