                    "target_lang_definitions": {
                        "ru": "Сокращение от слова \"episode\" (эпизод, серия), часто используемое в названиях файлов или списках сериалов.",
                        "zh": "episode（集、单集）的缩写，常用于电视剧文件名或节目单中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серия",
                                "target_lang_sense_clarification": "часть сериала"
                            },
                            {
                                "target_lang_word": "эпизод",
                                "target_lang_sense_clarification": "часть сериала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "集",
                                "target_lang_sense_clarification": "电视剧的单集"
                            },
                            {
                                "target_lang_word": "E",
                                "target_lang_sense_clarification": "用于文件名或序号表示“集”"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ee2074d-5944-34bf-aa45-8a821c981922",
                    "sense_definition": "A failing grade given to a student in school, usually ranking below D.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was very disappointed to receive an <w>E</w> on his math exam.",
                            "target_lang_translations": {
                                "ru": "Он был очень расстроен, получив <w>E</w> за экзамен по математике.",
                                "zh": "数学考试得了个 <w>E等</w>，他感到非常失望。"
                            }
                        },
                        {
                            "text": "If you get an <w>E</w> in this subject, you will have to take the class again.",
                            "target_lang_translations": {
                                "ru": "Если ты получишь <w>E</w> по этому предмету, тебе придется проходить курс заново.",
                                "zh": "如果你这门课拿到 <w>E等</w>，就必须重修。"
                            }
