                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4fcabdb2-a90c-4f53-8746-ddf03b44b711",
                        "entry_id": "45505f33-0297-3fb8-91e1-21aafd2492e6",
                        "tags": [
                            "plural",
