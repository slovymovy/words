                                        "examples": [
                                            {
                                                "example_id": "08b40b05-4fa8-4d4d-ba49-9e78378f8bfb",
                                                "sense_id": "bc73bd39-1cf2-3a5d-9ce6-e21f155cb05b",
                                                "text": "La Shahbanou d’Iran Sa Majesté l’Impératrice Farah Pahlavi."
                                            },
                                            {
                                                "example_id": "04dc70cc-34a3-4d0e-9161-7451584a9cbd",
                                                "sense_id": "bc73bd39-1cf2-3a5d-9ce6-e21f155cb05b",
                                                "text": "En dehors du chauffeur, il n’y avait certainement à bord que le chah et la chahbanou."
