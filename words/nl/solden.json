{
    "word_family": [
        "solde",
        "sollen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b7fcc51-e8e6-3c6a-bf8b-e2e35e056d5a",
                    "sense_definition": "De periode waarin winkels hun producten tegen sterk verlaagde prijzen verkopen, meestal aan het einde van een seizoen.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "uitverkoop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de <w>solden</w> kun je kleding kopen met grote kortingen.",
                            "target_lang_translations": {
                                "fr": "Pendant les <w>soldes</w>, on peut acheter des vêtements avec de grandes réductions."
                            }
                        },
                        {
                            "text": "Veel mensen wachten op de <w>solden</w> om een nieuwe winterjas aan te schaffen.",
                            "target_lang_translations": {
                                "fr": "Beaucoup de gens attendent les <w>soldes</w> pour s'acheter un nouveau manteau d'hiver."
                            }
                        }
                    ],
                    "synonyms": [
                        "koopjesperiode",
                        "uitverkoop",
                        "seizoenopruiming"
                    ],
                    "common_phrases": [
                        "tijdens de solden",
                        "de solden beginnen"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in België (Vlaanderen)"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "La période durant laquelle les magasins vendent leurs produits à prix fortement réduits, généralement à la fin d'une saison."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "soldes",
                                "target_lang_sense_clarification": "période de réductions de prix"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45d4fede-23ec-3cd0-a149-d774b34e4650",
                    "sense_definition": "De goederen die tegen een verlaagde prijs worden aangeboden, of de verkoopactie zelf.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitverkoop",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De winkelier biedt zijn resterende wintercollectie aan in de <w>solden</w>.",
                            "target_lang_translations": {
                                "fr": "Le commerçant propose le reste de sa collection d'hiver en <w>soldes</w>."
                            }
                        },
                        {
                            "text": "Zij heeft een prachtige jurk op de kop getikt in de <w>solden</w>.",
                            "target_lang_translations": {
                                "fr": "Elle a déniché une magnifique robe pendant les <w>soldes</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "koopjes",
                        "opruiming"
                    ],
                    "common_phrases": [
                        "in de solden"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in België (Vlaanderen)"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Les marchandises proposées à prix réduit, ou l'action de vente elle-même."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "soldes",
                                "target_lang_sense_clarification": "marchandises à prix réduit"
                            },
                            {
                                "target_lang_word": "promotions",
                                "target_lang_sense_clarification": "articles à prix réduit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "917f3857-325b-37c8-863e-f07cc2168944",
                    "sense_definition": "Het meervoud van het zelfstandig naamwoord <w>solde</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten ontvingen hun wekelijkse <w>solden</w> te laat door administratieve problemen.",
                            "target_lang_translations": {
                                "fr": "Les soldats ont reçu leurs <w>soldes</w> hebdomadaires trop tard en raison de problèmes administratifs."
                            }
                        },
                        {
                            "text": "In oude documenten stonden de betaalde <w>solden</w> nauwkeurig opgeschreven.",
                            "target_lang_translations": {
                                "fr": "Dans les documents anciens, les <w>soldes</w> payées étaient méticuleusement consignées."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Le pluriel du nom 'solde' (la paye d'un militaire)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "soldes",
                                "target_lang_sense_clarification": "payes des militaires"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6b8a747d-bac6-37fc-8a8e-b197fbef7b81",
                    "sense_definition": "De meervoudsvorm van de verleden tijd van het werkwoord <w>sollen</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij <w>solden</w> vroeger vaak met die oude lappenpop op de speelplaats.",
                            "target_lang_translations": {
                                "fr": "Autrefois, nous <w>malmenions</w> souvent cette vieille poupée de chiffon dans la cour de récréation."
                            }
                        },
                        {
                            "text": "Zij merkten niet dat de pesters met hen <w>solden</w> tijdens de pauze.",
                            "target_lang_translations": {
                                "fr": "Ils ne se rendaient pas compte que les harceleurs se <w>jouaient</w> d'eux pendant la récréation."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verleden tijd meervoud"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "La forme plurielle du passé du verbe 'sollen' (mener la vie dure, malmener)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "malmenions",
                                "target_lang_sense_clarification": "imparfait de malmener (nous)"
                            },
                            {
                                "target_lang_word": "malmenaient",
                                "target_lang_sense_clarification": "imparfait de malmener (ils/elles)"
                            },
                            {
                                "target_lang_word": "jouions avec",
                                "target_lang_sense_clarification": "imparfait de jouer avec (quelqu'un/quelque chose)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
