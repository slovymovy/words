                "senses": [
                    {
                        "sense_id": "eddb9a93-030f-31d1-8430-11ff8b8d08c2",
                        "entry_id": "86f591d5-8b39-3c92-bf45-2b270a7f7992",
                        "glosses": [
                            "großes Gefäß oder Tank für die Aufbewahrung oder den Transport von Speise- oder Industrieöl"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ebabeac-4261-4781-8367-126033acfb5c",
                                "sense_id": "eddb9a93-030f-31d1-8430-11ff8b8d08c2",
                                "text": "„Die erste Ernte ist in der Ölzisterne.“"
                            },
                            {
                                "example_id": "f62f0f29-132a-4a3d-9190-492902e70a8f",
                                "sense_id": "eddb9a93-030f-31d1-8430-11ff8b8d08c2",
                                "text": "„Allerdings basiert das Wagenmodell auf der Wagenserie Za 8131-8140 mit gegenüber dem Vorbild kürzerer Ölzisterne bzw. Wagenlänge!“"
                            },
                            {
                                "example_id": "fbb92f61-1e79-4c7b-a647-851d505aff86",
                                "sense_id": "eddb9a93-030f-31d1-8430-11ff8b8d08c2",
                                "text": "„Der Name des Ortes bedeutet „Ölzisterne“ und in der Tat sind die zahlreichen Olivenbäume in und um die Ortschaft charakteristisch für die Landschaft.“"
                            },
                            {
                                "example_id": "5f6508d7-5d5d-4032-a379-298f42db4086",
                                "sense_id": "eddb9a93-030f-31d1-8430-11ff8b8d08c2",
                                "text": "„Die grösste Herausforderung war deshalb die Einbindung der neuen Holzfeuerung in die beiden bestehenden Dampfsysteme mit vier verbleibenden Dampfkesseln, und dies während des laufenden Betriebs. Der Wechsel wurde innerhalb weniger Monate vollzogen: Im März 2016 begann der Rückbau der alten Ölzisterne, in deren Auffangwanne das neue Holzheizwerk Ende Dezember 2016 den ersten Dampf produzierte.“"
                            },
                            {
                                "example_id": "7e1f8fb6-4988-4655-a96d-e1ee5ab47077",
                                "sense_id": "eddb9a93-030f-31d1-8430-11ff8b8d08c2",
                                "text": "„Unter dem Haus, acht Meter tief in den Fels gehauen, befand sich die Ölzisterne; in ihr lagerte das Öl als Vorrat für Jahre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
