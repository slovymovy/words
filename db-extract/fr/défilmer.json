                "senses": [
                    {
                        "sense_id": "8917c2db-1e0e-3482-97b4-610ea429f207",
                        "entry_id": "3f59b4b6-6732-30e9-ba6a-570dff646a87",
                        "glosses": [
                            "Enlever le film (la pellicule) qui avait été posé sur quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f12c2c8-972b-49a4-8a87-f51e4849c9d4",
                                "sense_id": "8917c2db-1e0e-3482-97b4-610ea429f207",
                                "text": "C’est une des raisons pour lesquelles j’ai fait défilmer les vitres de mes voitures officielles."
                            },
                            {
                                "example_id": "b84f3e81-a806-4e04-bf67-f615f29676e1",
                                "sense_id": "8917c2db-1e0e-3482-97b4-610ea429f207",
                                "text": "Déposer le rôti gélifié au centre et rouler serré ; défilmer à nouveau, déposer dans un plat de présentation et masquer d’un bon centimètre de pulpe de pommes de terre passée au tamis."
                            },
                            {
                                "example_id": "4e78c878-33a4-4428-bde3-9d52bc338840",
                                "sense_id": "8917c2db-1e0e-3482-97b4-610ea429f207",
                                "text": "Couteau spécialement étudié pour couper les films adhésifs de protection sur les véhicules et pour défilmer les palettes."
                            }
                        ]
                    }
                ],
