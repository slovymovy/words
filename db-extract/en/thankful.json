                                    {
                                        "sense_id": "55a13d1f-cfd1-373b-b5b0-5594589c316b",
                                        "entry_id": "03266343-4b60-37ef-a08f-fb0791547a51",
                                        "glosses": [
                                            "erkentelijk voor ontvangen hulp"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46972f7a-0992-43e5-8cd8-c4d59824941f",
                                                "sense_id": "55a13d1f-cfd1-373b-b5b0-5594589c316b",
                                                "text": "Hij kreeg een briefje van de dankbare begunstigde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c67f8d91-805c-3440-bfc2-d1d6797ad125",
                                        "entry_id": "03266343-4b60-37ef-a08f-fb0791547a51",
                                        "glosses": [
                                            "de moeite lonend"
                                        ],
                                        "tags": [
                                            "van zaken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83c7ec62-e316-442c-b033-67e8c58a9775",
                                                "sense_id": "c67f8d91-805c-3440-bfc2-d1d6797ad125",
                                                "text": "Meehelpen met het wikiwoordenboek is een dankbare bezigheid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dankbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "74a3865d-2e48-3a92-9cd1-77114969e2ca",
                                        "entry_id": "fc504a94-cdea-39de-9161-0c394c7f1370",
                                        "glosses": [
                                            "erkentelijk voor ontvangen hulp"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e2df56-f462-42b2-831c-03cbd4412f73",
                                                "sense_id": "74a3865d-2e48-3a92-9cd1-77114969e2ca",
                                                "text": "Alles draait in dienst in Baptistenkerk om het thema dankbaarheid. Of het nu het gebed, de preek, een klein toneelspel of de tekst van psalmen, gezangen en liederen, is, alles daat erom dat mensen in het leven dankbaar moeten zijn."
                                            },
                                            {
                                                "example_id": "42c99a54-8569-4602-bab8-e336419c5dfe",
                                                "sense_id": "74a3865d-2e48-3a92-9cd1-77114969e2ca",
                                                "text": "'Gijs, jij bent een enorme steun geweest voor deze familie het afgelopen jaar, daar ben ik je eeuwig dankbaar voor.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0afcfc0c-6194-3837-b419-430489ce1e82",
                                        "entry_id": "fc504a94-cdea-39de-9161-0c394c7f1370",
                                        "glosses": [
                                            "bereid aangeboden hulp te aanvaarden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0c8bc61-0c5e-485f-a7e7-dbe2cedabe1f",
                                                "sense_id": "0afcfc0c-6194-3837-b419-430489ce1e82",
                                                "text": "Hij maakte dankbaar gebruik van het aanbod."
                                            },
                                            {
                                                "example_id": "618e6fbd-d735-47f3-9059-f87537b1413a",
                                                "sense_id": "0afcfc0c-6194-3837-b419-430489ce1e82",
                                                "text": "Artsen weten al eeuwen dat dit effect bestaat, al heette het vroeger anders: in een psychologietekstboek uit 1787 werd het omschreven onder de noemer 'Het effect van verbeelding op het lichaam'. Menig ouder maakt er dankbaar gebruik van, dat effect van verbeelding op het lichaam."
                                            },
                                            {
                                                "example_id": "cd05436e-e6d7-44c5-85cb-863efbd6de7f",
                                                "sense_id": "0afcfc0c-6194-3837-b419-430489ce1e82",
                                                "text": "'Je krijgt een dak boven je hoofd, en daar mogen we God dankbaar voor zijn' Omdat ze bang is dat de anderen die herinneringen op haar gezicht kunnen zien, staart Nella naar haar bord."
                                            },
                                            {
                                                "example_id": "46f81141-a73c-4ae2-9901-a2375ebcbbb7",
                                                "sense_id": "0afcfc0c-6194-3837-b419-430489ce1e82",
                                                "text": "Ik vond het mooi om te zien dat ze mijn situatie begreep en een onderscheid kon maken tussen hoofd- en bijzaak. Ik zou vaak dankbaar aan haar advies terugdenken als ik weer eens met een nog volle fles bij een riviertje aankwam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55484244-0fb4-4072-a4a0-dfee44391646",
                        "source_entry_id": "35f2c263-0d0b-3a8d-a3a6-7161e69256de",
