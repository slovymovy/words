{
    "word_family": [
        "objectively",
        "objectivity",
        "objectiveness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2325e80f-b46b-3d2d-9aaf-e330bf625923",
                    "sense_definition": "Based on real facts and not influenced by personal beliefs, feelings, or prejudices.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to remain completely <w>objective</w> when judging your own children.",
                            "target_lang_translations": {
                                "ru": "Трудно оставаться полностью <w>объективным</w>, когда судишь о собственных детях.",
                                "zh": "在评价自己的孩子时，很难做到完全<w>客观</w>。"
                            }
                        },
                        {
                            "text": "The jury must look at the <w>objective</w> evidence rather than listening to rumors.",
                            "target_lang_translations": {
                                "ru": "Присяжные должны рассматривать <w>объективные</w> доказательства, а не слушать слухи.",
                                "zh": "陪审团必须查看<w>客观</w>证据，而不是听信传言。"
                            }
                        }
                    ],
                    "synonyms": [
                        "unbiased",
                        "impartial",
                        "neutral",
                        "factual",
                        "dispassionate",
                        "detached",
                        "fair-minded"
                    ],
                    "antonyms": [
                        "subjective"
                    ],
                    "common_phrases": [
                        "be objective",
                        "objective criteria",
                        "objective assessment",
                        "objective reality",
                        "objective view"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на реальных фактах, не зависящий от личного мнения, чувств или предубеждений.",
                        "zh": "基于事实，不受个人信念、情感或偏见影响的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объективный",
                                "target_lang_sense_clarification": "непредвзятый"
                            },
                            {
                                "target_lang_word": "беспристрастный",
                                "target_lang_sense_clarification": "справедливый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "客观",
                                "target_lang_sense_clarification": "不带个人偏见"
                            },
                            {
                                "target_lang_word": "公正",
                                "target_lang_sense_clarification": "公平且不偏袒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89f6cec0-1026-3383-adc9-03bca5a832e9",
                    "sense_definition": "Relating to the grammatical case of a noun or pronoun used as the object of a verb or preposition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the sentence \"She saw him,\" the pronoun \"him\" is in the <w>objective</w> case.",
                            "target_lang_translations": {
                                "ru": "В предложении «She saw him» местоимение «him» стоит в <w>объектном</w> падеже.",
                                "zh": "在句子“She saw him”中，代词“him”处于<w>宾格</w>。"
                            }
                        },
                        {
                            "text": "English pronouns change their form when they are <w>objective</w> rather than subjective.",
                            "target_lang_translations": {
                                "ru": "Английские местоимения меняют свою форму, когда они <w>объектные</w>, а не субъектные.",
                                "zh": "英语代词在作<w>宾格</w>而非主格时会改变形式。"
                            }
                        }
                    ],
                    "antonyms": [
                        "subjective"
                    ],
                    "common_phrases": [
                        "objective case",
                        "objective pronoun"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к грамматическому падежу существительного или местоимения, выступающего в роли дополнения.",
                        "zh": "指名词或代词在句中作宾语时的语法格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объектный",
                                "target_lang_sense_clarification": "грамматический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宾格",
                                "target_lang_sense_clarification": "语法术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9602c504-d133-3465-a1df-c9dccc8aee11",
                    "sense_definition": "Something that you plan to do or achieve; a specific goal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our main <w>objective</w> is to improve customer satisfaction by the end of the year.",
                            "target_lang_translations": {
                                "ru": "Наша главная <w>цель</w> — повысить удовлетворенность клиентов к концу года.",
                                "zh": "我们的主要<w>目标</w>是在年底前提高客户满意度。"
                            }
                        },
                        {
                            "text": "The team worked hard to meet the sales <w>objectives</w> set by the manager.",
                            "target_lang_translations": {
                                "ru": "Команда усердно работала, чтобы достичь <w>целей</w> по продажам, поставленных менеджером.",
                                "zh": "团队努力工作以实现经理设定的销售<w>目标</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "goal",
                        "aim",
                        "target",
                        "purpose"
                    ],
                    "common_phrases": [
                        "main objective",
                        "achieve an objective",
                        "meet an objective",
                        "strategic objective",
                        "business objective"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что планируется сделать или достичь; конкретная цель.",
                        "zh": "计划要做或要实现的事情；具体目标。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цель",
                                "target_lang_sense_clarification": "намерение, стремление"
                            },
                            {
                                "target_lang_word": "задача",
                                "target_lang_sense_clarification": "то, что нужно выполнить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "目标",
                                "target_lang_sense_clarification": "想要达到的境地"
                            },
                            {
                                "target_lang_word": "目的",
                                "target_lang_sense_clarification": "想要达到的结果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b327458-2f49-361b-b837-11835724d499",
                    "sense_definition": "The lens in a microscope, telescope, or camera that is closest to the object being observed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should clean the <w>objective</w> carefully to ensure a clear image.",
                            "target_lang_translations": {
                                "ru": "Следует осторожно чистить <w>объектив</w>, чтобы обеспечить четкое изображение.",
                                "zh": "你应该小心清洁<w>物镜</w>以确保图像清晰。"
                            }
                        },
                        {
                            "text": "The microscope has a high-power <w>objective</w> for viewing tiny details.",
                            "target_lang_translations": {
                                "ru": "Микроскоп оснащен мощным <w>объективом</w> для рассмотрения мельчайших деталей.",
                                "zh": "这台显微镜配有高倍<w>物镜</w>，用于观察微小细节。"
                            }
                        }
                    ],
                    "synonyms": [
                        "objective lens"
                    ],
                    "common_phrases": [
                        "microscope objective",
                        "camera objective"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "optics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Линза в микроскопе, телескопе или камере, расположенная ближе всего к наблюдаемому объекту.",
                        "zh": "显微镜、望远镜或照相机中靠近被观察物体的透镜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объектив",
                                "target_lang_sense_clarification": "оптика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "物镜",
                                "target_lang_sense_clarification": "光学仪器部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b15eff20-af1c-34aa-b249-6baeb6f47c8c",
                    "sense_definition": "The objective case; a noun or pronoun used as an object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pronoun \"whom\" is the <w>objective</w> form of \"who\".",
                            "target_lang_translations": {
                                "ru": "Местоимение «whom» — это <w>объектная</w> форма местоимения «who».",
                                "zh": "代词“whom”是“who”的<w>宾格</w>形式。"
                            }
                        },
                        {
                            "text": "In modern English, the <w>objective</w> is often identical to the subjective for regular nouns.",
                            "target_lang_translations": {
                                "ru": "В современном английском языке <w>объектный падеж</w> часто совпадает с субъектным для обычных существительных.",
                                "zh": "在现代英语中，普通名词的<w>宾格</w>形式通常与主格相同。"
                            }
                        }
                    ],
                    "synonyms": [
                        "objective case"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объектный падеж; форма существительного или местоимения, используемая в качестве дополнения.",
                        "zh": "宾格；用作宾语的名词或代词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объектный падеж",
                                "target_lang_sense_clarification": "грамматическая категория"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宾格",
                                "target_lang_sense_clarification": "语法形式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}