                ],
                "senses": [
                    {
                        "sense_id": "71b51ccf-771d-3143-88cb-4b7f789d6ff7",
                        "entry_id": "88489ac0-b3cf-3b3f-b7ec-6c6109c78e1a",
                        "glosses": [
                            "The act of burying a dead body; burial."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "05dee7ba-feee-4c4f-8853-3609679dafbb",
                                "sense_id": "71b51ccf-771d-3143-88cb-4b7f789d6ff7",
                                "text": "In a chamber tomb at Milatos, Mr. Evans discovered in 1899 a painted larnax or sarcophagus, on which there is figured a great Mycenæan body shield, although not of the usual figure-of-eight shape. A false neck vase, however, that belongs almost certainly to the same interment is, in shape and design, similar to one found at Muliana in company with two late bronze broadswords, and bronze brooches like those found at Thunder Hill."
                            },
                            {
                                "example_id": "02a7e69e-11d9-4a6b-bf9a-949b40722bc5",
                                "sense_id": "71b51ccf-771d-3143-88cb-4b7f789d6ff7",
                                "text": "She was to be given a state funeral, followed by interment at Arlington National Cemetery."
                            },
                            {
                                "example_id": "38d2f170-9c55-4640-b6f2-6d3ebdb663f9",
                                "sense_id": "71b51ccf-771d-3143-88cb-4b7f789d6ff7",
                                "text": "The jaw indicates the beginning of a long tradition of the interment of dogs with people, which reveals a deep attachment between some people and canids."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dad55668-65ec-4fcb-bc05-f2f1d30f4257",
                        "source_entry_id": "88489ac0-b3cf-3b3f-b7ec-6c6109c78e1a",
                        "source_sense_id": "71b51ccf-771d-3143-88cb-4b7f789d6ff7",
                        "source_sense_description": "The act of burying a dead body; burial",
                        "target_lang_word": "begrafenis",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "begrafenis",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "aa9de851-15ee-3eab-9eea-404ce9595cfe",
                                        "entry_id": "e63ddbbc-b8f5-3ecf-9de9-b708dca67836",
                                        "glosses": [
                                            "ceremonie waarbij een overledene in een kist aan de aarde wordt toevertrouwd, de ceremonie wanneer de laatste eer aan iemand wordt gegeven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1921bc2d-37b8-4288-8c0b-fc6af92f93e7",
                                                "sense_id": "aa9de851-15ee-3eab-9eea-404ce9595cfe",
                                                "text": "Een crematie wordt tegenwoordig meestal ook een begrafenis genoemd."
                                            },
                                            {
                                                "example_id": "d4a78fb1-671a-4da8-b923-03d8c706a61c",
                                                "sense_id": "aa9de851-15ee-3eab-9eea-404ce9595cfe",
                                                "text": "Op dinsdagochtend was de begrafenis in de kleine zaal van rouwcentrum Zeisspoor in Geleen. Een handjevol vrienden van mijn ouders, mensen uit de buurt, de bakker was er, en een aantal keurig geklede heren op de achterste rij."
                                            },
                                            {
                                                "example_id": "77e038b6-0d98-4ed3-9bed-7f802a11ee37",
                                                "sense_id": "aa9de851-15ee-3eab-9eea-404ce9595cfe",
                                                "text": "Tijdens de begrafenis heb ik de longen uit mijn lijf gehuild."
                                            },
                                            {
                                                "example_id": "4289337d-62d6-420f-9f47-d3fe8dad6060",
                                                "sense_id": "aa9de851-15ee-3eab-9eea-404ce9595cfe",
                                                "text": "‘Daar staan we dan, Tal. ’ Hij haalde zijn schouders op. ‘Duo Mislukt, gespecialiseerd in begrafenissen en rouwmissen.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cb3c99d-86d5-4881-982f-3328e995f0ae",
                        "source_entry_id": "88489ac0-b3cf-3b3f-b7ec-6c6109c78e1a",
                        "source_sense_id": "71b51ccf-771d-3143-88cb-4b7f789d6ff7",
                        "source_sense_description": "The act of burying a dead body; burial",
                        "target_lang_word": "teraardebestelling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teraardebestelling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "bc0d9e66-9183-3112-89cc-e948ed42b97a",
                                        "entry_id": "c2e63c09-d800-391a-8cf4-182d1c1514ad",
                                        "glosses": [
                                            "een vorm van lijkbezorging waarbij iemand die overleden is begraven wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa7d642-4c4e-4983-bf36-9a9090cfa6a8",
                                                "sense_id": "bc0d9e66-9183-3112-89cc-e948ed42b97a",
                                                "text": "Maar wat willen families zich dan herinneren? Duidelijke afspraken zijn nodig, beseft ook Tombeur. ‘De uitvaart, de teraardebestelling, de koffietafel? Foto’s van het lichaam? Dat zijn moeilijke afwegingen die families moeten maken. Verder blijf ik op de achtergrond. Ik maak dat ik onopgemerkt aanwezig ben. Ik neem dus geen foto’s met flits.’"
                                            },
                                            {
                                                "example_id": "0626b65f-0bf4-4ca3-905f-2a587f33e9a5",
                                                "sense_id": "bc0d9e66-9183-3112-89cc-e948ed42b97a",
                                                "text": "Medewerkers van de uitvaartverzorger zullen alles in goede banen leiden. Ik wil er nadrukkelijk op wijzen dat de teraardebestelling op Het Lentfert in besloten kring zal plaatshebben\", zegt Holterman."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "915baa74-b2b3-475f-81bb-ff2d2c28e2f9",
                        "source_entry_id": "88489ac0-b3cf-3b3f-b7ec-6c6109c78e1a",
                        "source_sense_id": "71b51ccf-771d-3143-88cb-4b7f789d6ff7",
                        "source_sense_description": "The act of burying a dead body; burial",
                        "target_lang_word": "Beerdigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beerdigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d14a000-7db1-35a8-a1a1-e2dc0b8b3aa3",
                                        "entry_id": "4a40d89e-c62f-3305-a9b5-d78f8c8f9126",
                                        "glosses": [
                                            "meist feierliche Beisetzung der sterblichen Überreste eines Toten in der Erde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b72b3df-7da8-455e-a184-9b9602df4d74",
                                                "sense_id": "3d14a000-7db1-35a8-a1a1-e2dc0b8b3aa3",
                                                "text": "Die Beerdigung ist für 11 Uhr angesetzt."
                                            },
                                            {
                                                "example_id": "fb60952f-b735-49d5-8e4a-d9b858d654bc",
                                                "sense_id": "3d14a000-7db1-35a8-a1a1-e2dc0b8b3aa3",
                                                "text": "„Die Beerdigung findet in extravaganter Atmosphäre in New York statt.“"
                                            },
                                            {
                                                "example_id": "514815eb-9c3f-4aaf-8138-0e865255e81a",
                                                "sense_id": "3d14a000-7db1-35a8-a1a1-e2dc0b8b3aa3",
                                                "text": "„Der Beerdigung schloss sich ein Leichenschmaus im Dorfgasthof an.“"
                                            },
                                            {
                                                "example_id": "dd8c291f-7266-49e0-9f98-60adfb55612d",
                                                "sense_id": "3d14a000-7db1-35a8-a1a1-e2dc0b8b3aa3",
                                                "text": "„Dann ging ich zurück und besprach die Beerdigung meines Vaters.“"
                                            },
                                            {
                                                "example_id": "c4ed9ffe-421d-4bad-9b82-e1bc599225ac",
                                                "sense_id": "3d14a000-7db1-35a8-a1a1-e2dc0b8b3aa3",
                                                "text": "„Ich erinnere mich, dass wir bei der Beerdigung meines Großvaters viel gelacht haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
