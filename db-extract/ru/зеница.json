                                "target_senses": [
                                    {
                                        "sense_id": "46b8e6fb-929d-3cc4-8d7d-20573fe58492",
                                        "entry_id": "56e73b8f-9557-3e28-85ed-fef67275d238",
                                        "glosses": [
                                            "czarna, okrągła plamka na tęczówce oka, będąca w rzeczywistości rozszerzającym się i zwężającym otworem regulującym dopływ światła do wnętrza oka"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32882302-807d-44b9-a31a-01786999dc7e",
                                                "sense_id": "46b8e6fb-929d-3cc4-8d7d-20573fe58492",
                                                "text": "Rzymianki używały wyciągu z pokrzyku jako kosmetyku rozszerzającego źrenice i nadającego im blask."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "3d1f4f14-77d5-3967-aa1b-642c5cd6e35a",
                                        "entry_id": "56e73b8f-9557-3e28-85ed-fef67275d238",
                                        "glosses": [
                                            "wzrok, oko"
                                        ],
                                        "tags": [
                                            "literary",
