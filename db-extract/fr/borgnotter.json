                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27fca833-1504-43d5-bf9b-eab0af0b2816",
                                "sense_id": "5773f70a-dab5-3398-9b4b-7a02d3f188b9",
                                "text": "Je n’osais pas trop borgnotter le Prince à cet instant, picorer sur son visage ses réactions."
                            },
                            {
                                "example_id": "25147a6c-088a-4af6-a63f-83cdc9ef1b2b",
                                "sense_id": "5773f70a-dab5-3398-9b4b-7a02d3f188b9",
                                "text": "Il borgnottait à l’intérieur de son crâne des pensées informes, fatigué à crever, quand ça l’avait mordu : « La Lola comment a-t-elle trouvé la villa sur la Marne ? »"
                            }
                        ]
                    }
