                ],
                "senses": [
                    {
                        "sense_id": "6532cf3d-d9a0-3e86-83c7-656625621bf7",
                        "entry_id": "936a5fcf-36bd-3a84-ab91-ccaaf5bc9c44",
                        "glosses": [
                            "Antrieb eines Kraftfahrzeugs, der aus einer Kombination von zwei verschiedenartigen Motoren besteht. Einer davon ist derzeit ein Elektromotor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22e5928f-8eb4-48e8-bba6-a603a0d35e96",
                                "sense_id": "6532cf3d-d9a0-3e86-83c7-656625621bf7",
                                "text": "„Schon vor zehn Jahren, etwas früher sogar als Toyota, brachte Honda das erste Auto mit benzinelektrischem Hybridantrieb nach Europa und Nordamerika.“"
                            },
                            {
                                "example_id": "9d56e2d6-8d25-4d58-bae0-fbeabc6d7baa",
                                "sense_id": "6532cf3d-d9a0-3e86-83c7-656625621bf7",
                                "text": "„Des Weiteren bietet der Hybridantrieb den Vorteil, dass Tauchzeiten sehr viel länger ausfallen können als bei Ubooten mit Dieselgenerator.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
