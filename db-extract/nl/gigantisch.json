                                "target_senses": [
                                    {
                                        "sense_id": "6ef3ec37-b87d-3ed0-9e3a-a5c103f106aa",
                                        "entry_id": "f0eb1e3a-8a7e-3425-8cdb-6949e9a541a1",
                                        "glosses": [
                                            "Huge, gigantic, very large."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1b6c134-5640-4579-958b-19a07656048f",
                                                "sense_id": "6ef3ec37-b87d-3ed0-9e3a-a5c103f106aa",
                                                "text": "Then everybody once more knelt, and soon the blessing was pronounced. The choir and the clergy trooped out slowly, […], down the nave to the western door. […] At a seemingly immense distance the surpliced group stopped to say the last prayer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39d04976-b77e-3dd9-8593-60027cf73ff6",
                                        "entry_id": "f0eb1e3a-8a7e-3425-8cdb-6949e9a541a1",
                                        "glosses": [
                                            "Supremely good."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "254fd7ff-4a00-33ad-a774-2e568344aad6",
                                        "entry_id": "f0eb1e3a-8a7e-3425-8cdb-6949e9a541a1",
                                        "glosses": [
                                            "Major; to a great degree."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d221fbf-7788-4d55-a5e7-797678b33649",
                                                "sense_id": "254fd7ff-4a00-33ad-a774-2e568344aad6",
                                                "text": "The gallant young Indian dandies at home on furlough—immense dandies these—chained and moustached—driving in tearing cabs […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "immense",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aafd14d-6302-3ecf-bf40-9db4f717cf71",
                                        "entry_id": "8b36f04a-4c37-3b74-88ff-388d399eb7ee",
                                        "glosses": [
                                            "Immense extent or expanse; immensity."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53a5d50e-0d56-48e4-bf61-2b3b90b410be",
                                                "sense_id": "6aafd14d-6302-3ecf-bf40-9db4f717cf71",
                                                "text": "The half of Asia is my prison-house,\nMyriads of convicts lost in its Immense—\nI look with terror to my crowning day."
                                            },
                                            {
                                                "example_id": "93d99b44-4928-4937-80c8-8245ba1fa958",
                                                "sense_id": "6aafd14d-6302-3ecf-bf40-9db4f717cf71",
                                                "text": "The events that took place in the immenses of the former USSR three years ago remind one about ancient rule of everyday life which is equally applicable both to daily routine and to politics: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
