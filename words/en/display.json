                    "common_phrases": [
                        "fireworks display",
                        "acrobatic display",
                        "public display"
                    ],
                    "target_lang_definitions": {
                        "ru": "публичное выступление, шоу или зрелище, предназначенное для развлечения или информирования",
                        "tr": "Eğlendirmek veya bilgilendirmek amacıyla yapılan halka açık gösteri veya sunum.",
                        "zh": "旨在娱乐或告知公众的公开表演、展示或奇观"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шоу",
                                "target_lang_sense_clarification": "зрелищное действо"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "спектакль или зрелище"
                            },
                            {
                                "target_lang_word": "показ",
                                "target_lang_sense_clarification": "демонстрация чего-либо"
                            },
                            {
                                "target_lang_word": "зрелище",
                                "target_lang_sense_clarification": "предмет наблюдения"
                            }
                        ],
                        "tr": [
