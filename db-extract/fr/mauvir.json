                "senses": [
                    {
                        "sense_id": "787aa790-3657-3b0b-b606-e70755dd70b9",
                        "entry_id": "54d23757-b493-37d1-9435-99e8711919b4",
                        "glosses": [
                            "Devenir mauve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72fe749e-5b08-4c93-a27c-66349c7d0934",
                                "sense_id": "787aa790-3657-3b0b-b606-e70755dd70b9",
                                "text": "Sans faire de pause malgré la fatigue, je vais chercher de l’eau, je me lave, me change, je prépare mon couchage entre des poutres qui me protègeront des courants d’air, j’enfile les chaussons trempés, mes pieds nus mauvissent."
                            },
                            {
                                "example_id": "327ea9da-d870-494d-b711-76c68179359b",
                                "sense_id": "787aa790-3657-3b0b-b606-e70755dd70b9",
                                "text": "Comme les hirondelles, les escargots sont de retour, quand les iris mauvissent !"
                            },
                            {
                                "example_id": "4f69b6ee-f27e-4fdd-b7cd-48491242da97",
                                "sense_id": "787aa790-3657-3b0b-b606-e70755dd70b9",
                                "text": "Les grappes généreuses mauvissent tandis que les abeilles s'enivrent de sucre."
                            }
                        ]
                    }
                ],
