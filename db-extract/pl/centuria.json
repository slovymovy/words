                        "form": "centurie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "774ee8d6-fc31-3b65-a989-15485182e8c0",
                        "entry_id": "5e51951a-b3f0-3b1f-a441-184b7a62fd34",
                        "glosses": [
                            "najmniejsza jednostka taktyczna w armii starożytnego Rzymu, część legionu, pierwotnie tworzona z centurii (1.2)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "308e04f8-32ee-4ab8-bc03-4efaa6d82b3b",
                                "sense_id": "774ee8d6-fc31-3b65-a989-15485182e8c0",
                                "text": "Na skutek reform wojskowych Mariusza etatowa liczebność centurii podniesiona została do 100 żołnierzy (nadal dwie centurie tworzyły manipuł). W czasach cesarstwa kohorta legionowa składała się z 6 centurii po 80 żołnierzy każda"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f0914bcf-4eca-36b2-b985-8afdfd8d384b",
                        "entry_id": "5e51951a-b3f0-3b1f-a441-184b7a62fd34",
                        "glosses": [
                            "jednostka podziału ludności w starożytnym Rzymie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bcb1f3a-2b13-47f2-a99d-7fbabcbc22e2",
                                "sense_id": "f0914bcf-4eca-36b2-b985-8afdfd8d384b",
                                "text": "Obywatele dysponujący majątkiem o wartości ponad 100 tys. sesterców tworzyli bowiem 18 centurii jeźdźców (equites), obok których było 175 centurii pieszych"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "8aeba563-1dd8-3c6c-a852-002fd83a8b6b",
                        "entry_id": "5e51951a-b3f0-3b1f-a441-184b7a62fd34",
                        "glosses": [
                            "Centaurium Hill rodzaj roślin z rodziny goryczkowatych"
                        ],
                        "tags": [
                            "syst."
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "d8c50c72-f886-33d3-865a-bc800555af52",
                        "entry_id": "5e51951a-b3f0-3b1f-a441-184b7a62fd34",
                        "glosses": [
                            "roślina z rodzaju centuria (1.3)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eacc7f8-0136-4142-b823-1c08ea8ee3f0",
                                "sense_id": "d8c50c72-f886-33d3-865a-bc800555af52",
                                "text": "Powiązane w pęczki, wisiały dziurawce, centurie i jakieś zioła nieznane, a pożyteczne, zbierane z zachowaniem zielarskich tajników, przepisów dziedziczonych po matkach i babkach a to na nowiu, a to z samego rana, a to w południe"
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "ca277578-bd72-3afb-9b19-4b6e7fc7b841",
                        "entry_id": "5e51951a-b3f0-3b1f-a441-184b7a62fd34",
                        "glosses": [
                            "sto, setka, stulecie"
                        ],
                        "tags": [
                            "literary",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "241236b1-83ce-40e6-9e75-e0737ea10f9d",
                                "sense_id": "ca277578-bd72-3afb-9b19-4b6e7fc7b841",
                                "text": "\"Centurie Magdeburskie\" (łac. Centuriae Magdeburgienses) uważane są za pierwszą próbę spisania obszernej historii Kościoła z punktu widzenia reformacji"
                            }
                        ],
                        "sense_index_json": "\"1.5\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3c25914-37bb-4a4b-b112-377dfdc30573",
                        "source_entry_id": "5e51951a-b3f0-3b1f-a441-184b7a62fd34",
                        "source_sense_id": "774ee8d6-fc31-3b65-a989-15485182e8c0",
                        "target_lang_word": "century",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "century",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A period of one hundred consecutive years; often specifically a numbered period with conventional start and end dates, e.g., the twentieth century, which stretches from (strictly) 1901 through 2000, or (informally) 1900 through 1999. The first century AD was from 1 to 100."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14d25e3-0f4a-47b6-8734-d821de03e50e",
                                                "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                                "text": "Holonyms: kiloannum, kiloyear, millennium < terasecond < mega-annum, megayear < petasecond < giga-annum, gigayear < exasecond < zettasecond < yottasecond < ronnasecond < quettasecond"
                                            },
                                            {
                                                "example_id": "13331c5e-ad52-49f1-8743-5a1e174d78bc",
                                                "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                                "text": "Meronyms: quectosecond < rontosecond < yoctosecond < zeptosecond < attosecond < femtosecond < picosecond < nanosecond < microsecond < millisecond < centisecond < decisecond < second < decasecond < minute < hectosecond < kilosecond < microcentury (humorous) < hour < day < week < megasecond < fortnight < month < year < gigasecond"
                                            },
                                            {
                                                "example_id": "53a0d8dd-1a7a-448b-a087-bb5ea76588f3",
                                                "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                                "text": "He stood transfixed before the unaccustomed view of London at night time, a vast panorama which reminded him […] of some wood engravings far off and magical, in a printshop in his childhood. They dated from the previous century and were coarsely printed on tinted paper, with tinsel outlining the design."
                                            },
                                            {
                                                "example_id": "0894d216-295c-45ca-9dad-aa2ad228b363",
                                                "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            },
                                            {
                                                "example_id": "943e6b5c-93ea-4055-8b45-44b6448c601c",
                                                "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                                "text": "In 16th and 17th century Britain, for example, women’s alopecia was sometimes interpreted as retribution for sins, including adultery."
                                            },
                                            {
                                                "example_id": "a435d9ed-615c-42ab-b09a-6a6ddaacea9e",
                                                "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                                "text": "But in fact the antinomy of exceptionalism and assimilationism has been there all along, and otherwise puzzling decisions from the nineteenth and twentieth centuries become readily understandable when seen as moments when assimilationism was ascendant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffadd5ad-329b-3e6f-b380-2b63a1ebcbae",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A unit in ancient Roman army, originally of one hundred army soldiers as part of a cohort, later of more varied sizes (but typically containing sixty to seventy or eighty) soldiers or other men (guards, police, firemen), commanded by a centurion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74409a12-ca8e-43aa-aef6-307a960afbd6",
                                                "sense_id": "ffadd5ad-329b-3e6f-b380-2b63a1ebcbae",
                                                "text": "Holonyms: maniple, cohort, legion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fabe0b50-2f3d-3420-a67e-fbe5efc4f73e",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A political division of ancient Rome, meeting in the Centuriate Assembly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "566dabb7-df8d-39e5-941e-174bd199a473",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A hundred things of the same kind; a hundred."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6359776f-2c53-4c8f-b448-e1b3dd2c16b5",
                                                "sense_id": "566dabb7-df8d-39e5-941e-174bd199a473",
                                                "text": "'tis the subject of whole books: I might cite a century of authors pro and con."
                                            },
                                            {
                                                "example_id": "67d653db-c8bd-4cd0-b185-4f4d8c411442",
                                                "sense_id": "566dabb7-df8d-39e5-941e-174bd199a473",
                                                "text": "Hamilton reached his century 14 years after securing his maiden pole in the Canadian Grand Prix in 2007, which he went on to win to take the first step on the road to becoming Formula One's most successful driver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "451b0668-d19d-3e14-af36-86f5d976f66e",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A hundred runs scored either by a single player in one innings, or by two players in a partnership."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34994bf2-027d-4616-9fd8-a48e80d5ec9c",
                                                "sense_id": "451b0668-d19d-3e14-af36-86f5d976f66e",
                                                "text": "He has scored 44 limited-overs centuries."
                                            },
                                            {
                                                "example_id": "60709835-4f9f-473c-8309-eedcfda5be6a",
                                                "sense_id": "451b0668-d19d-3e14-af36-86f5d976f66e",
                                                "text": "They put on a century stand to help their team recover from 57–4 to 198–4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "491cdf4a-9edb-3dff-85dd-c45196bdbc1d",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A score of one hundred points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd84832-2878-44ef-8d90-c07e608c4a30",
                                                "sense_id": "491cdf4a-9edb-3dff-85dd-c45196bdbc1d",
                                                "text": "That was his tenth professional century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55d28aca-c5bc-3179-9db6-e4fafe2c15ff",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A race a hundred units (as meters, kilometres, miles) in length."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3490c16-d914-3639-8fab-5ddf530ec59d",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A banknote in the denomination of one hundred dollars."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84f1e9aa-d247-4013-94f5-fec36c672391",
                        "source_entry_id": "5e51951a-b3f0-3b1f-a441-184b7a62fd34",
                        "source_sense_id": "f0914bcf-4eca-36b2-b985-8afdfd8d384b",
                        "target_lang_word": "century",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "century",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A period of one hundred consecutive years; often specifically a numbered period with conventional start and end dates, e.g., the twentieth century, which stretches from (strictly) 1901 through 2000, or (informally) 1900 through 1999. The first century AD was from 1 to 100."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14d25e3-0f4a-47b6-8734-d821de03e50e",
                                                "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                                "text": "Holonyms: kiloannum, kiloyear, millennium < terasecond < mega-annum, megayear < petasecond < giga-annum, gigayear < exasecond < zettasecond < yottasecond < ronnasecond < quettasecond"
                                            },
                                            {
                                                "example_id": "13331c5e-ad52-49f1-8743-5a1e174d78bc",
                                                "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                                "text": "Meronyms: quectosecond < rontosecond < yoctosecond < zeptosecond < attosecond < femtosecond < picosecond < nanosecond < microsecond < millisecond < centisecond < decisecond < second < decasecond < minute < hectosecond < kilosecond < microcentury (humorous) < hour < day < week < megasecond < fortnight < month < year < gigasecond"
                                            },
                                            {
                                                "example_id": "53a0d8dd-1a7a-448b-a087-bb5ea76588f3",
                                                "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                                "text": "He stood transfixed before the unaccustomed view of London at night time, a vast panorama which reminded him […] of some wood engravings far off and magical, in a printshop in his childhood. They dated from the previous century and were coarsely printed on tinted paper, with tinsel outlining the design."
                                            },
                                            {
                                                "example_id": "0894d216-295c-45ca-9dad-aa2ad228b363",
                                                "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            },
                                            {
                                                "example_id": "943e6b5c-93ea-4055-8b45-44b6448c601c",
                                                "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                                "text": "In 16th and 17th century Britain, for example, women’s alopecia was sometimes interpreted as retribution for sins, including adultery."
                                            },
                                            {
                                                "example_id": "a435d9ed-615c-42ab-b09a-6a6ddaacea9e",
                                                "sense_id": "302d9532-7fd0-3dd2-b415-347d59e4c3f5",
                                                "text": "But in fact the antinomy of exceptionalism and assimilationism has been there all along, and otherwise puzzling decisions from the nineteenth and twentieth centuries become readily understandable when seen as moments when assimilationism was ascendant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffadd5ad-329b-3e6f-b380-2b63a1ebcbae",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A unit in ancient Roman army, originally of one hundred army soldiers as part of a cohort, later of more varied sizes (but typically containing sixty to seventy or eighty) soldiers or other men (guards, police, firemen), commanded by a centurion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74409a12-ca8e-43aa-aef6-307a960afbd6",
                                                "sense_id": "ffadd5ad-329b-3e6f-b380-2b63a1ebcbae",
                                                "text": "Holonyms: maniple, cohort, legion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fabe0b50-2f3d-3420-a67e-fbe5efc4f73e",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A political division of ancient Rome, meeting in the Centuriate Assembly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "566dabb7-df8d-39e5-941e-174bd199a473",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A hundred things of the same kind; a hundred."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6359776f-2c53-4c8f-b448-e1b3dd2c16b5",
                                                "sense_id": "566dabb7-df8d-39e5-941e-174bd199a473",
                                                "text": "'tis the subject of whole books: I might cite a century of authors pro and con."
                                            },
                                            {
                                                "example_id": "67d653db-c8bd-4cd0-b185-4f4d8c411442",
                                                "sense_id": "566dabb7-df8d-39e5-941e-174bd199a473",
                                                "text": "Hamilton reached his century 14 years after securing his maiden pole in the Canadian Grand Prix in 2007, which he went on to win to take the first step on the road to becoming Formula One's most successful driver."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "451b0668-d19d-3e14-af36-86f5d976f66e",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A hundred runs scored either by a single player in one innings, or by two players in a partnership."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34994bf2-027d-4616-9fd8-a48e80d5ec9c",
                                                "sense_id": "451b0668-d19d-3e14-af36-86f5d976f66e",
                                                "text": "He has scored 44 limited-overs centuries."
                                            },
                                            {
                                                "example_id": "60709835-4f9f-473c-8309-eedcfda5be6a",
                                                "sense_id": "451b0668-d19d-3e14-af36-86f5d976f66e",
                                                "text": "They put on a century stand to help their team recover from 57–4 to 198–4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "491cdf4a-9edb-3dff-85dd-c45196bdbc1d",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A score of one hundred points."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bd84832-2878-44ef-8d90-c07e608c4a30",
                                                "sense_id": "491cdf4a-9edb-3dff-85dd-c45196bdbc1d",
                                                "text": "That was his tenth professional century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55d28aca-c5bc-3179-9db6-e4fafe2c15ff",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A race a hundred units (as meters, kilometres, miles) in length."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3490c16-d914-3639-8fab-5ddf530ec59d",
                                        "entry_id": "7d578400-5f47-3523-aabc-09d721e88cda",
                                        "glosses": [
                                            "A banknote in the denomination of one hundred dollars."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
