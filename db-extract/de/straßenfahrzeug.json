                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d975e55-3f71-4601-82e9-827aea3bb6c3",
                                "sense_id": "b049d2ca-8f33-3bdb-aace-cb0863b75cb8",
                                "text": "„Das ist der teuerste Ferrari und das teuerste Straßenfahrzeug aller Zeiten.“"
                            },
                            {
                                "example_id": "6dbbd293-2855-44bc-b384-127fb18695dc",
                                "sense_id": "b049d2ca-8f33-3bdb-aace-cb0863b75cb8",
                                "text": "„Als verkehrsunsicher eingestuft werden mußten mit 0,1 Prozent immerhin noch 393 Straßenfahrzeuge.“"
                            },
                            {
                                "example_id": "8de83e96-0d2d-4590-bc4d-82ff3505aba2",
                                "sense_id": "b049d2ca-8f33-3bdb-aace-cb0863b75cb8",
                                "text": "„Mit dem bei Ferrari gefertigten, doppelt aufgeladenen 3,8-Liter-V8-Benziner mit 580 PS und 730 Newtonmeter aus dem hierzulande nicht mehr angebotenen Quattroporte GTS wird der Levante Trofeo zum stärksten je in Serie produzierten Straßenfahrzeug von Maserati.“"
                            }
                        ],
