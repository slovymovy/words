                ],
                "translations": [
                    {
                        "translation_id": "232f0451-142d-49d7-87ee-95b56b888547",
                        "source_entry_id": "75efc754-19a4-3275-a02d-984733605665",
                        "source_sense_id": "c74b76c1-88c7-314f-8ff1-8de1310a977a",
                        "target_lang_word": "jocular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jocular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62a32177-a74f-32b3-9fa5-ad0b8cb2f380",
                                        "entry_id": "ddcd4dd0-ae68-3ae6-8d0b-4e4a1c914c39",
                                        "glosses": [
                                            "Humorous, amusing or joking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "719d0367-4d78-4d39-a974-c5293d0927a1",
                                                "sense_id": "62a32177-a74f-32b3-9fa5-ad0b8cb2f380",
                                                "text": "He was in a jocular mood all day."
                                            },
                                            {
                                                "example_id": "190cccab-e148-430b-bfa9-d6cc3e8493e9",
                                                "sense_id": "62a32177-a74f-32b3-9fa5-ad0b8cb2f380",
                                                "text": "All we had was a short and jocular conversation."
                                            },
                                            {
                                                "example_id": "f9d788de-3344-4661-b746-6910bbc3b866",
                                                "sense_id": "62a32177-a74f-32b3-9fa5-ad0b8cb2f380",
                                                "text": "From the tone of the speaker, the last words might be understood to be jocular."
                                            },
                                            {
                                                "example_id": "0bcd438f-9be4-49e1-aec6-9252da80aab5",
                                                "sense_id": "62a32177-a74f-32b3-9fa5-ad0b8cb2f380",
                                                "text": "Sometimes he would notice it, pat it, call it half-mocking, half-jocular names, and so make it caper with extraordinary delight."
                                            },
                                            {
                                                "example_id": "f3463400-29b5-46c5-b194-9d096f72f5e8",
                                                "sense_id": "62a32177-a74f-32b3-9fa5-ad0b8cb2f380",
                                                "text": "Then papa began to get very tired of Jones, and fidgeted and finally said, with jocular irony, that Jones had better stay all night, they could give him a shake-down."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a778a0d-c97d-4797-ba0a-5ae64951d39f",
                        "source_entry_id": "75efc754-19a4-3275-a02d-984733605665",
                        "source_sense_id": "c74b76c1-88c7-314f-8ff1-8de1310a977a",
                        "target_lang_word": "mischievous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mischievous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05db5f34-92eb-3cd9-a24c-47c47725992f",
                                        "entry_id": "b4472258-05c8-3e8d-8362-56405e9d80f2",
                                        "glosses": [
                                            "Causing mischief; injurious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc099fac-7041-48b4-994f-1c26cfdeebba",
                                                "sense_id": "05db5f34-92eb-3cd9-a24c-47c47725992f",
                                                "text": "...; that good and bad actions at present are naturally rewarded and punished, not only as beneficial and mischievous to society, but also as virtuous and civious; ..."
                                            },
                                            {
                                                "example_id": "be47f12e-0fb4-49ef-b1d3-5e95c2b009db",
                                                "sense_id": "05db5f34-92eb-3cd9-a24c-47c47725992f",
                                                "text": "On the whole, therefore, he concludes that the point of indulgence at which these self-passions or self-affections begin to be mischievous to the individual coincides with that at which they begin to be mischievous to society; ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dfae8ee-006f-3ade-a276-b8a4c7524f68",
                                        "entry_id": "b4472258-05c8-3e8d-8362-56405e9d80f2",
                                        "glosses": [
                                            "Troublesome, cheeky, badly behaved, impish, naughty, disobedient; showing a fondness for causing trouble in a playful way and liking to have fun by playing harmless tricks on people or doing things they are not supposed to do."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cda5968-7a76-42a0-8948-365f3edb89f6",
                                                "sense_id": "0dfae8ee-006f-3ade-a276-b8a4c7524f68",
                                                "text": "Matthew had a twin brother called Edward, who was always mischievous and badly behaved."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b99abe7f-6205-45be-bec3-5603965b3c26",
                        "source_entry_id": "75efc754-19a4-3275-a02d-984733605665",
                        "source_sense_id": "c74b76c1-88c7-314f-8ff1-8de1310a977a",
                        "target_lang_word": "playful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "playful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c39b799c-710d-3966-a1fd-abce876fdec1",
                                        "entry_id": "5a4df08d-b931-33b6-97c4-a93441fd2639",
                                        "glosses": [
                                            "liking play, prone to play frequently, such as a child or kitten; rather sportive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c3b7d2c-b364-4947-b43c-cfe133f1300a",
                                                "sense_id": "c39b799c-710d-3966-a1fd-abce876fdec1",
                                                "text": "Actually, we are pretty playful in our romantic life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bee3bf4d-478d-39e0-af96-85ef085baeb3",
                                        "entry_id": "5a4df08d-b931-33b6-97c4-a93441fd2639",
                                        "glosses": [
                                            "funny, humorous, jesting, frolicsome, frisky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ebba7bd-bf0f-4ca5-9e6f-ccc7c72aaa39",
                                                "sense_id": "bee3bf4d-478d-39e0-af96-85ef085baeb3",
                                                "text": "John is a playful fellow."
                                            },
                                            {
                                                "example_id": "4550e39a-b557-42f4-980d-03d15858c3c8",
                                                "sense_id": "bee3bf4d-478d-39e0-af96-85ef085baeb3",
                                                "text": "A party hat is a playful conical hat people wear at parties."
                                            },
                                            {
                                                "example_id": "b278282f-7d16-4502-b2fc-66c4c2181f4c",
                                                "sense_id": "bee3bf4d-478d-39e0-af96-85ef085baeb3",
                                                "text": "Why this already very fast train should be speeded up still further, when none of the other more easily timed S.R. West of England trains has a single minute pared from its schedule, is unexplained - unless this is a playful dig at the Western Region, most of whose expresses, by reason of additional stops, will be decelerated from the same date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8086900b-981b-36ff-b11c-d146fad14304",
                                        "entry_id": "5a4df08d-b931-33b6-97c4-a93441fd2639",
                                        "glosses": [
                                            "fun, recreational, not serious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a58092c9-f1a4-4fbe-a8ce-019845ffc242",
                                                "sense_id": "8086900b-981b-36ff-b11c-d146fad14304",
                                                "text": "A brainteaser is a playful puzzle posed as a test of intelligence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9f55a34-6904-377e-850a-8021e8a2ee5e",
                                        "entry_id": "5a4df08d-b931-33b6-97c4-a93441fd2639",
                                        "glosses": [
                                            "experimental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "799565b3-5665-4928-825d-7c9c6d0f4f98",
                                                "sense_id": "a9f55a34-6904-377e-850a-8021e8a2ee5e",
                                                "text": "He was a rather playful artist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
