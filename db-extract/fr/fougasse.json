                "entry_id": "dc0c9fe4-8f22-35bb-810b-b7f70ccacbac",
                "word": "fougasse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5be325c5-f368-4188-b76e-954e02dd02eb",
                        "entry_id": "dc0c9fe4-8f22-35bb-810b-b7f70ccacbac",
                        "tags": [
