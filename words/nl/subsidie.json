{
    "word_family": [
        "subsidiëren",
        "subsidiair"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09d4322b-a62c-3e1d-b288-2a41a938c092",
                    "sense_definition": "Financiële steun van de overheid om kosten te verlagen of activiteiten te stimuleren.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "financiële steun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid verstrekt een <w>subsidie</w> voor het verduurzamen van woningen.",
                            "target_lang_translations": {
                                "zh": "政府为房屋节能改造提供了一项<w>补贴</w>。"
                            }
                        },
                        {
                            "text": "Veel culturele instellingen zijn afhankelijk van een jaarlijkse <w>subsidie</w>.",
                            "target_lang_translations": {
                                "zh": "许多文化机构都依赖于每年的<w>资助</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "toelage",
                        "steun",
                        "bijdrage"
                    ],
                    "common_phrases": [
                        "subsidie aanvragen",
                        "subsidie ontvangen"
                    ],
                    "target_lang_definitions": {
                        "zh": "政府为降低成本或鼓励特定活动而提供的财政支持。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "补贴",
                                "target_lang_sense_clarification": "指政府或机构为特定目的提供的财政补助。"
                            },
                            {
                                "target_lang_word": "资助",
                                "target_lang_sense_clarification": "指提供资金以支持某项事业或活动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d53a9e22-bedf-39c9-96f3-a0652c78656f",
                    "sense_definition": "Hulp of ondersteuning in algemene zin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financiële steun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn werk was een grote <w>subsidie</w> voor het succes van het project.",
                            "target_lang_translations": {
                                "zh": "他的工作对该项目的成功提供了巨大的<w>支持</w>。"
                            }
                        },
                        {
                            "text": "De organisatie bood <w>subsidie</w> aan de slachtoffers van de ramp.",
                            "target_lang_translations": {
                                "zh": "该组织向灾民提供了<w>援助</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hulp",
                        "steun",
                        "bijstand"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "In deze algemene betekenis is het woord verouderd."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一般意义上的帮助或支持。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "援助",
                                "target_lang_sense_clarification": "指在困难时提供的帮助或支持。"
                            },
                            {
                                "target_lang_word": "支持",
                                "target_lang_sense_clarification": "指对某人或某事物的赞同与协助。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}