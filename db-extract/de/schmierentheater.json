                "senses": [
                    {
                        "sense_id": "a9972f04-cfc3-359d-9090-dbb4e64daca2",
                        "entry_id": "fad99a80-e3f8-3b30-afc2-310ae935dc1e",
                        "glosses": [
                            "Theaterstück oder -aufführung mit äußerst niedrigem Niveau, primitives Theater oder auch schlechte Wanderbühne"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "19075ffb-8764-42e1-948c-ccf50c1f6a6e",
                                "sense_id": "a9972f04-cfc3-359d-9090-dbb4e64daca2",
                                "text": "„Vor allem in der Zeit der aufstrebenden bürgerlichen Stadttheater und Staatstheater im 19. Jahrhundert wurden die Wanderbühnen mit ihren beschränkteren Mitteln und ihrer altmodischen Spielweise als Schmierentheater abqualifiziert.“"
                            },
                            {
                                "example_id": "ed2a1734-741b-4ffe-888d-68227a3cf7e3",
                                "sense_id": "a9972f04-cfc3-359d-9090-dbb4e64daca2",
                                "text": "„Der Vorsitzende der CSU-Landesgruppe im Bundestag, Michael Glos, bezeichnete die rot-grüne Kritik an der Mehrwertsteuererhöhung mit Blick auf Eichels Ankündigung als billiges Schmierentheater.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
