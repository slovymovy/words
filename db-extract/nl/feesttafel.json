                    {
                        "sense_id": "f9a58be0-b4f3-356a-99e8-19e58cf33464",
                        "entry_id": "746073de-6f91-3203-abe0-fb8644ec1d5b",
                        "glosses": [
                            "tafel waaraan de bezoekers van een feest kunnen plaatsnemen om te praten, te drinken en te eten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7acff8ba-52b9-49e4-a687-26e7a0330b1e",
                                "sense_id": "f9a58be0-b4f3-356a-99e8-19e58cf33464",
                                "text": "Enige tijd later begon ze om de grote feesttafel, die Gwenhwyfars huwelijksgeschenk aan Arthur was geweest, heen te lopen."
                            },
                            {
                                "example_id": "fd949ad9-3cab-4b1c-8506-dbbb479f9afe",
                                "sense_id": "f9a58be0-b4f3-356a-99e8-19e58cf33464",
                                "text": "'Het was aardig van mijn schoonvader om deze grote ronde feesttafel te sturen,' zei hij, 'maar er is geen kamer in Caerleon die er groot genoeg voor is."
                            },
                            {
                                "example_id": "c6faebd2-f618-44ce-925c-ee563147f5d0",
                                "sense_id": "f9a58be0-b4f3-356a-99e8-19e58cf33464",
                                "text": "Gwenhwyfar spande haar gehele lichaam, opdat ze niet weer zou gaan huilen; alle ogen waren op hen gericht, en zeer zeker was het al schandaal genoeg dat de Koning aan zijn eigen feesttafel vastte."
                            }
                        ]
                    },
