                    {
                        "sense_id": "5e61a5c9-6247-3fb0-bb0f-05e9fa508efb",
                        "entry_id": "39865378-e698-3640-bcd3-3b395fa2fb9a",
                        "glosses": [
                            "ein sich von Aas ernährender Vogel"
                        ],
                        "tags": [
                            "speziell Ornithologie"
                        ],
                        "examples": [
                            {
                                "example_id": "658523e2-c291-4835-be5b-cbcad44d2270",
                                "sense_id": "5e61a5c9-6247-3fb0-bb0f-05e9fa508efb",
                                "text": "„Diese Türme wurden auf Bergen errichtet, um die Toten aufzubahren und den Aasvögeln zu überlassen.“"
                            },
                            {
                                "example_id": "c1af5315-5db0-4771-aa92-00f618608d9e",
                                "sense_id": "5e61a5c9-6247-3fb0-bb0f-05e9fa508efb",
                                "text": "„Zuvor scheuchte man die Aasvögel mit Gewehrschüssen davon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
