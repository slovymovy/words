                "senses": [
                    {
                        "sense_id": "790b7f96-8db9-3cfc-9931-c4f8979ad35c",
                        "entry_id": "28b3ec36-ef4d-334f-9dac-d78e8ec85299",
                        "glosses": [
                            "Luft in der Wüste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ce71c54-da7d-4786-acb9-170ea2a9a632",
                                "sense_id": "790b7f96-8db9-3cfc-9931-c4f8979ad35c",
                                "text": "„Denn während ich seinem Ursprung trotz seines Geruchs in der Meinung nachgespürt hatte, es handele sich um einen zumindest indirekten Hinweis auf den Weg nach draußen, musste ich nun klar erkennen, dass diese faulige Ausdünstung keinerlei Beimengung oder sonstige Verbindung zu der sauberen libyschen Wüstenluft besaß.“"
                            },
                            {
                                "example_id": "a630f256-40bd-454a-add5-c1aa793a7e09",
                                "sense_id": "790b7f96-8db9-3cfc-9931-c4f8979ad35c",
                                "text": "„Cyprian wiederum lebte zufrieden mit Helen Eddy in Palm Springs und atmete die Wüstenluft, die angeblich gegen alle erdenklichen Leiden half.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
