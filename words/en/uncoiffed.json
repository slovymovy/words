{
    "word_family": [
        "coif",
        "coiffure",
        "coiffed"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0dc98716-b5f9-3935-8f7f-4af0905b95ab",
                    "sense_definition": "Having hair that is not styled or arranged neatly.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hair_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked into the room with <w>uncoiffed</w> hair after a long day at the beach.",
                            "target_lang_translations": {
                                "pl": "Weszła do pokoju z <w>nieuczesanymi</w> włosami po długim dniu na plaży."
                            }
                        },
                        {
                            "text": "The model looked effortlessly chic despite her <w>uncoiffed</w> appearance.",
                            "target_lang_translations": {
                                "pl": "Modelka wyglądała szykownie bez wysiłku, mimo swojego <w>rozczochranego</w> wyglądu."
                            }
                        }
                    ],
                    "synonyms": [
                        "disheveled",
                        "messy",
                        "untidy"
                    ],
                    "antonyms": [
                        "coiffed",
                        "groomed",
                        "styled"
                    ],
                    "common_phrases": [
                        "uncoiffed hair"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający włosy, które nie są ułożone lub uczesane w schludny sposób."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nieuczesany",
                                "target_lang_sense_clarification": "najbardziej bezpośrednie określenie braku starannej fryzury"
                            },
                            {
                                "target_lang_word": "rozczochrany",
                                "target_lang_sense_clarification": "wskazuje na nieład we włosach, często w sposób naturalny lub po aktywności"
                            },
                            {
                                "target_lang_word": "potargany",
                                "target_lang_sense_clarification": "często używane w kontekście włosów zmierzwionych przez wiatr lub po długim dniu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98e36c33-405c-370b-a48f-5682a663639c",
                    "sense_definition": "Simple past and past participle of <w>uncoif</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>uncoiffed</w> his hair after removing the tight cap.",
                            "target_lang_translations": {
                                "pl": "Po zdjęciu ciasnej czapki <w>rozczesał</w> włosy."
                            }
                        },
                        {
                            "text": "The stylist <w>uncoiffed</w> the elaborate design before the final photo shoot.",
                            "target_lang_translations": {
                                "pl": "Stylista <w>rozpuścił</w> skomplikowaną fryzurę przed finałową sesją zdjęciową."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb uncoif."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Czas przeszły i imiesłów czasu przeszłego czasownika 'uncoif' (rozczesać, rozpuścić włosy)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozczesał",
                                "target_lang_sense_clarification": "czynność polegająca na rozluźnieniu lub rozczesaniu wcześniej ułożonej fryzury"
                            },
                            {
                                "target_lang_word": "rozpuścił",
                                "target_lang_sense_clarification": "w kontekście zdjęcia upięcia lub nakrycia głowy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}