                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tandem",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aec788ae-d98c-307d-a7d2-79f5c52cb1fb",
                                        "entry_id": "bf097729-a97a-39ca-bf8e-2fd12cc2137f",
                                        "glosses": [
                                            "Voiture attelée de deux chevaux en flèche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b91f86b7-1247-4a5c-9dad-ee471df03d23",
                                                "sense_id": "aec788ae-d98c-307d-a7d2-79f5c52cb1fb",
                                                "text": "Un tandem que Steiner conduisait, avec un laquais derrière, immobile, les bras croisés (…) le banquier, allongeant un fouet immense, lançait les deux chevaux, attelés en flèche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebd7dfaf-4926-3c03-9eb2-a5c672ec6ca2",
                                        "entry_id": "bf097729-a97a-39ca-bf8e-2fd12cc2137f",
                                        "glosses": [
                                            "Bicyclette à deux personnes, placées l’une derrière l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd2d2ec4-5ccd-467c-be16-c138b877e4f9",
                                                "sense_id": "ebd7dfaf-4926-3c03-9eb2-a5c672ec6ca2",
                                                "text": "Rien de changé depuis 1936, les femmes se heurtent toujours à la phallocratie du tandem. On place définitivement l'homme à l'avant et la femme à l'arrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6c6962f-2f17-3046-8f9b-a944f3125f17",
                                        "entry_id": "bf097729-a97a-39ca-bf8e-2fd12cc2137f",
                                        "glosses": [
                                            "Association de deux personnes, de deux groupes travaillant à une œuvre commune ; binôme ; duo ; couple."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e049bfa6-8b4e-4c3e-ae4a-2a025a22e459",
                                                "sense_id": "d6c6962f-2f17-3046-8f9b-a944f3125f17",
                                                "text": "En 1977, quatre nouveaux satellites mis au point par le tandem franco-germanique doivent être lancés."
                                            },
                                            {
                                                "example_id": "1d700a4c-e037-4332-8ab9-24c59c45cf0d",
                                                "sense_id": "d6c6962f-2f17-3046-8f9b-a944f3125f17",
                                                "text": "Les hommes travaillaient en tandem, chacun conscient de sa tâche grâce aux séances d'entraînement mensuelles."
                                            },
                                            {
                                                "example_id": "219981e5-5014-45fc-85d8-bd3976bb10e7",
                                                "sense_id": "d6c6962f-2f17-3046-8f9b-a944f3125f17",
                                                "text": "Julie Girard participe aux ateliers virtuels de perlage en compagnie de sa fille Alyss Saint-Pierre. En plus d’en faire un moment mère-fille, le tandem y voit une parfaite occasion pour découvrir un autre pan de sa culture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "418d43be-e59b-39dc-82c7-e8967adb1058",
                                        "entry_id": "bf097729-a97a-39ca-bf8e-2fd12cc2137f",
                                        "glosses": [
                                            "Ensemble de deux personnes ou groupes indissociables et travaillant de concert ou en antagonisme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d170102e-444e-42fc-acea-9e98b432aa09",
                                                "sense_id": "418d43be-e59b-39dc-82c7-e8967adb1058",
                                                "text": "Ceux qui s'intéressent à la vie politique ne peuvent tout simplement pas saisir l'ensemble du processus sans comprendre le fonctionnement du tandem politiciens/journalistes politiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
