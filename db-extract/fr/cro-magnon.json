                    {
                        "sense_id": "2ce3390a-82b8-34f2-a78d-711cd2befb21",
                        "entry_id": "588b6dae-4d12-3882-a3ed-548d49e1e62d",
                        "glosses": [
                            "Grotte, lieu-dit des Eyzies de Tayac (Dordogne, France) où fut découvert un fossile d'homme préhistorique représentant de l’espèce Homo sapiens, datant du Paléolithique supérieur (entre 40,000 et 10,000 ans avant notre ère)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bf74508-bbce-4dcd-975e-7431b7d6bc2c",
                                "sense_id": "2ce3390a-82b8-34f2-a78d-711cd2befb21",
                                "text": "La grotte de Cro-Magnon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4dfba3f-665f-4f49-b54a-8ecde0c62f52",
                        "source_entry_id": "588b6dae-4d12-3882-a3ed-548d49e1e62d",
                        "source_sense_id": "2ce3390a-82b8-34f2-a78d-711cd2befb21",
