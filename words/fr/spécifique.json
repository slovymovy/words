            "senses": [
                {
                    "sense_id": "bf5a27eb-f689-35ff-8380-3c3af83617ce",
                    "sense_definition": "Médicament ou remède approprié pour guérir une maladie déterminée.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
