                    {
                        "sense_id": "4e0a9526-c494-3fa6-b2fc-792b7bc63c29",
                        "entry_id": "c9ddf724-00a4-346c-afc7-c809f5137430",
                        "glosses": [
                            "weibliche Person, die jemanden/etwas bewundert, hochschätzt; Bewunderin, Verehrerin"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
