                        "entry_id": "2be7c4a5-edd5-3dca-9147-e2542a45e6aa",
                        "glosses": [
                            "One that is cast."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f64d3461-c9b9-4599-9444-174d7bb0324e",
                                "sense_id": "2b6329c2-cd9c-3231-95c8-79d7490f8223",
                                "text": "[…] ſhift for themselves, and ſeek out new habitations; ſuch caſtlings might in their waudring throughout the South Sea (moſt of the Oriental Iſlands being formerly inhabited by their Off-ſpring) fall with the coaſt of Peru, […]"
                            }
                        ]
