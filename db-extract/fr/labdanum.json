                ],
                "senses": [
                    {
                        "sense_id": "6c63d6d3-57bb-3abe-b5bc-41fee9b03ba7",
                        "entry_id": "f2332400-ed74-3c5a-9830-f361133e0274",
                        "glosses": [
                            "Résine de la gomme produite par les feuilles du ciste Cistus ladaniferus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "588be689-4cea-4bcb-874c-a5c1a2f105b0",
                                "sense_id": "6c63d6d3-57bb-3abe-b5bc-41fee9b03ba7",
                                "text": "Le labdanum est utilisé en parfumerie et en médecine, pour ses propriétés hémostatiques, cicatrisantes et antirides."
                            },
                            {
                                "example_id": "30edc990-a460-4e97-b9de-389a64bd259c",
                                "sense_id": "6c63d6d3-57bb-3abe-b5bc-41fee9b03ba7",
                                "text": "De la plante de ciste on peut également extraire le labdanum, gomme obtenue en plongeant les rameaux dans de l’eau bouillante avec ajout de carbonate de sodium."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51fbcf12-9cc2-44cc-8af8-486c4d54314f",
                        "source_entry_id": "f2332400-ed74-3c5a-9830-f361133e0274",
                        "source_sense_id": "6c63d6d3-57bb-3abe-b5bc-41fee9b03ba7",
                        "source_sense_description": "résine tirée de la gomme du ciste",
                        "target_lang_word": "Labdanum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b4d83bc7-ab83-419b-a8aa-2d9cf01e45e7",
                        "source_entry_id": "f2332400-ed74-3c5a-9830-f361133e0274",
                        "source_sense_id": "6c63d6d3-57bb-3abe-b5bc-41fee9b03ba7",
                        "source_sense_description": "résine tirée de la gomme du ciste",
                        "target_lang_word": "labdanum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "labdanum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f1e8b93-6b6c-3972-be9b-17b4ea229e65",
                                        "entry_id": "a06aaf46-0846-37ce-a3c6-df56c3039c9e",
                                        "glosses": [
                                            "A sticky brown resin obtained from species of rockrose, used mainly in perfume."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b6aac14-1589-4ec2-ba1d-f5530e9c9a25",
                                                "sense_id": "7f1e8b93-6b6c-3972-be9b-17b4ea229e65",
                                                "text": "Your onely way to make a good pomander, is this. Take an ownce of the pureſt garden mould, clenſed and ſteeped ſeauen daies in change of motherleſſe roſe water, then take the beſt Labdanum, Benioine, both Storaxes, amber greece, and Ciuet, and muſke, incorporate them together, and work them into what form you pleaſe; this, if your breath bee not to valiant, will make you ſmell as ſweete as my Ladies dogge."
                                            },
                                            {
                                                "example_id": "20790938-2a42-4219-b8e7-1b484e28d6b4",
                                                "sense_id": "7f1e8b93-6b6c-3972-be9b-17b4ea229e65",
                                                "text": "Aromatics were used, too, especially in necromancy, and an old recipe of that sort comprises Musk, Myrrh, Frankincense, Red Storax, Mastick, Olibanum, Saffron, Benzoin and Labdanum."
                                            },
                                            {
                                                "example_id": "3e2a1ae8-2038-4a00-a51f-5efd54048e74",
                                                "sense_id": "7f1e8b93-6b6c-3972-be9b-17b4ea229e65",
                                                "text": "(A chypre perfume is usually built with oak moss, patchouli and labdanum, an absolute of a dark, thick-smelling Mediterranean bush.)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
