                                            {
                                                "example_id": "a9e7b7b6-eec1-43df-8996-0000534c1df3",
                                                "sense_id": "df61988f-7c59-3ee4-aedc-46e70fdd8374",
                                                "text": "„Günter Dach (* 27. August 1915 in Berlin; † 25. Juli 2010 in Berlin) war ein deutscher Politiker (CDU).“"
