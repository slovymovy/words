                    {
                        "sense_id": "3d8a7cea-32c8-33b1-9fb3-90e8a8ca7b82",
                        "entry_id": "1186b4a0-5f44-37ac-9f43-bf05c3101eb0",
                        "glosses": [
                            "pre-Adamite"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "3232f2ba-e99a-4c61-8ef7-930b8813b5d7",
                                "sense_id": "3d8a7cea-32c8-33b1-9fb3-90e8a8ca7b82",
                                "text": "Certains fondent l’idée qu’il y eut d’autres hommes créés avant Adam, les préadamites, dont on aurait la trace dans les peuples qui n’ont pas connu la révélation, comme les peuples d’Amérique."
                            }
                        ]
                    },
                    {
                        "sense_id": "831a4c59-154e-3168-9180-daf0524113fb",
                        "entry_id": "1186b4a0-5f44-37ac-9f43-bf05c3101eb0",
                        "glosses": [
                            "Christian sectarian who believes that mankind existed before Adam"
                        ],
                        "tags": [
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "37aa9538-997b-4e5b-b3d5-1b81d12d9a67",
                                "sense_id": "831a4c59-154e-3168-9180-daf0524113fb",
                                "text": "La doctrine professée par les préadamites affirme qu’Adam ne serait pas le premier homme mais seulement le premier Juif."
                            }
                        ]
                    }
                ],
