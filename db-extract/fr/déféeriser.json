                ],
                "senses": [
                    {
                        "sense_id": "f0a8bc5c-2f78-367b-9e90-62b61d64a3c8",
                        "entry_id": "a3319fc7-e5c1-3426-9940-9325b7ae3c83",
                        "glosses": [
                            "Faire perdre son caractère féérique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd660038-0d91-40d8-abf8-dbbb5cb0b61d",
                                "sense_id": "f0a8bc5c-2f78-367b-9e90-62b61d64a3c8",
                                "text": "Heurtés par les outrances spectaculaires de l’industrie du divertissement, ces mêmes auteurs se sont pourtant employés à déféeriser la féerie, tantôt en lui conférant une dignité littéraire, tantôt en l’assombrissant voire en la vidant de tout merveilleux."
                            },
                            {
                                "example_id": "7e7c859a-a56d-4c6d-b9d6-e70c00b1be32",
                                "sense_id": "f0a8bc5c-2f78-367b-9e90-62b61d64a3c8",
                                "text": "Le chocolat brise l’artifice, fait resurgir le naturel, déféerise la femme pour la rendre enfin accessible !"
                            },
                            {
                                "example_id": "134c2822-9825-4d7f-a67e-67cb5fddb741",
                                "sense_id": "f0a8bc5c-2f78-367b-9e90-62b61d64a3c8",
                                "text": "Ce qui déféerise et désillusionise, est par là-même dément, – le monde n'est ni plus ni moins que Féerie."
                            }
                        ]
                    }
                ],
