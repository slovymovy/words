                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c140ff3-dd0e-399f-bfb2-a6cf87464296",
                                        "entry_id": "f1558782-d312-3978-8f81-0ff62414d09f",
                                        "glosses": [
                                            "A slender, straight, sharply pointed sword (double-edged, single-edged or edgeless), designed predominantly for thrusting; used during the Renaissance period of Europe for civilian duelling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92e5631f-42d0-43c8-8e56-9c17bf9d169d",
                                                "sense_id": "8c140ff3-dd0e-399f-bfb2-a6cf87464296",
                                                "text": "[…] In his lawless fit,\nBehind the arras hearing something stir,\nWhips out his rapier, cries ‘A rat, a rat!’\nAnd in this brainish apprehension kills\nThe unseen good old man."
                                            },
                                            {
                                                "example_id": "a0948e60-fb3c-437e-bc1f-eed02d556bc4",
                                                "sense_id": "8c140ff3-dd0e-399f-bfb2-a6cf87464296",
                                                "text": "The man beside him with the earrings and the big black case proceeded to unlock it. He took out of it two long Italian rapiers, with splendid steel hilts and blades, which he planted point downwards in the lawn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rapier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91a0c58f-c51b-322f-bb93-7400b9c0e9e0",
                                        "entry_id": "7e85fb9a-f81a-3c27-b6e7-a038cd6bb985",
                                        "glosses": [
                                            "Extremely sharp."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
