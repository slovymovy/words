                "senses": [
                    {
                        "sense_id": "ad25dc96-59b9-3b9b-8562-4eefd46fb32a",
                        "entry_id": "1f3105c6-be9d-39ce-91d4-47d5d6b20ac7",
                        "glosses": [
                            "Ein Ausgabemedium auf grafischen Oberflächen für durchlaufende Listen von Informationen"
                        ],
                        "tags": [
                            "Nachrichten- und Unterhaltungselektronik"
                        ],
                        "examples": [
                            {
                                "example_id": "c2d1c040-73e8-4460-8d13-78af8308a4a2",
                                "sense_id": "ad25dc96-59b9-3b9b-8562-4eefd46fb32a",
                                "text": "„Das Web Item Ticker erzeugt eine durchlaufende Liste von Informationen von dem zugeordneten Dataprovider und ist sehr hilfreich, wenn Sie die Aufmerksamkeit auf statistische Übersichten lenken möchten.“"
                            },
                            {
                                "example_id": "24d61d2d-8b74-473a-81c7-8053875950c0",
                                "sense_id": "ad25dc96-59b9-3b9b-8562-4eefd46fb32a",
                                "text": "„Immer noch sagen Journalisten, es sei gerade eine brandaktuelle Meldung ‚über den Ticker gekommen‘. Dabei tickt der Computer gar nicht mehr. Anders als der Fernschreiber, der jahrzehntelang das wichtigste und schnellste Instrument für Datenübertragung (nicht nur in den Zeitungsredaktionen) war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a9643d16-e991-31a9-8c32-822ad62a362d",
                        "entry_id": "1f3105c6-be9d-39ce-91d4-47d5d6b20ac7",
                        "glosses": [
                            "jemand, der Drogen kauft und verkauft; Drogendealer, Drogenhändler"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60cb35ea-a4d6-45ec-9f18-3ba4afea1aa5",
                        "source_entry_id": "1f3105c6-be9d-39ce-91d4-47d5d6b20ac7",
                        "source_sense_id": "ad25dc96-59b9-3b9b-8562-4eefd46fb32a",
                        "target_lang_word": "ticker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ticker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a27acf34-0f8a-3ed0-a55e-6a30b9416980",
                                        "entry_id": "d736c213-3d91-3dfd-9b13-9075e49e222f",
                                        "glosses": [
                                            "One who makes a tick mark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59bb2eb2-535d-4ecc-8df8-eae73614ccc9",
                                                "sense_id": "a27acf34-0f8a-3ed0-a55e-6a30b9416980",
                                                "text": "A teacher now is a typist, a printer, a laboratory assistant, a designer of work sheets and booklets, a form-filler, a ticker of boxes and a sender of returns to faculty heads, to head teachers, to education authorities and to the Ministers […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb6b917-857a-30c7-b5b8-3c005795e5c8",
                                        "entry_id": "d736c213-3d91-3dfd-9b13-9075e49e222f",
                                        "glosses": [
                                            "A measuring or reporting device, particularly one which makes a ticking sound as the measured events occur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66db9645-8931-49fa-877c-a2aa679b5ff1",
                                                "sense_id": "dfb6b917-857a-30c7-b5b8-3c005795e5c8",
                                                "text": "The ticker was showing an increased rate of flow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4611415-acbd-3f83-9d57-4dbb8c3b960a",
                                        "entry_id": "d736c213-3d91-3dfd-9b13-9075e49e222f",
                                        "glosses": [
                                            "A ticker tape, either the traditional paper kind or a scrolling message on a screen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c81fafb-60c8-4a36-9f7d-24c5c40666cd",
                                                "sense_id": "a4611415-acbd-3f83-9d57-4dbb8c3b960a",
                                                "text": "I checked the prices on the ticker one last time before placing the trade."
                                            },
                                            {
                                                "example_id": "8e213afa-0916-40af-9a0c-23a129916d68",
                                                "sense_id": "a4611415-acbd-3f83-9d57-4dbb8c3b960a",
                                                "text": "To my surprise, the ticker showed that the deal had already gone through."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bff471f0-df2b-3b08-8e51-aa672caca29c",
                                        "entry_id": "d736c213-3d91-3dfd-9b13-9075e49e222f",
                                        "glosses": [
                                            "A heart, especially a human one."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2533f067-a4cc-47f2-aefd-639dcffc965c",
                                                "sense_id": "bff471f0-df2b-3b08-8e51-aa672caca29c",
                                                "text": "My ticker gave out and I had to go to the hospital for surgery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4548dd8b-9e90-3336-a131-dafed8ef1a13",
                                        "entry_id": "d736c213-3d91-3dfd-9b13-9075e49e222f",
                                        "glosses": [
                                            "A watch (timepiece)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b0cdf15-c6b2-4101-900c-51794d1067b9",
                                                "sense_id": "4548dd8b-9e90-3336-a131-dafed8ef1a13",
                                                "text": "A right nice ticker it was. Real gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c36ccf45-cb9f-3e41-8415-445db3024664",
                                        "entry_id": "d736c213-3d91-3dfd-9b13-9075e49e222f",
                                        "glosses": [
                                            "A birdwatcher who aims to see (and tick off on a list) as many bird species as possible."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eb1eb18c-cfdd-3a97-a916-95ba742a6386",
                                        "entry_id": "d736c213-3d91-3dfd-9b13-9075e49e222f",
                                        "glosses": [
                                            "A beer drinker who aims to try as many different beers as possible and keeps a record of all the beers they have drunk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df6dbce8-9f95-43be-8041-7aaffacff35d",
                                                "sense_id": "eb1eb18c-cfdd-3a97-a916-95ba742a6386",
                                                "text": "My weekday visit found a great mix of luncheoners, locals and real ale tickers."
                                            },
                                            {
                                                "example_id": "b65cc497-2a4f-4f0f-a2e7-d68a87b2ba79",
                                                "sense_id": "eb1eb18c-cfdd-3a97-a916-95ba742a6386",
                                                "text": "This book has not been written with the goal of pleasing beer geeks, tickers, fetishists, raters or advocates."
                                            },
                                            {
                                                "example_id": "8205fa34-42cd-4db4-9acd-abd15724501e",
                                                "sense_id": "eb1eb18c-cfdd-3a97-a916-95ba742a6386",
                                                "text": "Today's tickers are equipped with smartphones with downloaded apps like Untappd. I've seen tickers peruse beer lists for new beers they haven't tried."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
