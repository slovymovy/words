                "entry_id": "e17ed71b-945d-32ff-913f-63a8d4d48156",
                "word": "diagnostician",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "64b38898-ef94-4084-a0b9-6f51d325998f",
                        "entry_id": "e17ed71b-945d-32ff-913f-63a8d4d48156",
