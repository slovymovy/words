                                "target_senses": [
                                    {
                                        "sense_id": "cb23acfe-eb29-3806-922a-91dab98e96f4",
                                        "entry_id": "55f03671-1ac4-3a4e-9c22-44bcd3a2bc22",
                                        "glosses": [
                                            "To make weaker or less strong."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d9d6f71-cc16-4970-ad33-6f6044355d7f",
                                                "sense_id": "cb23acfe-eb29-3806-922a-91dab98e96f4",
