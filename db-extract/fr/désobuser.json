                        "tags": [],
                        "examples": [
                            {
                                "example_id": "862bf2fc-a204-40c5-904a-d079c9d3c53f",
                                "sense_id": "39db1bc7-f5c9-3bf5-a4e9-76d2e2c692c4",
                                "text": "La superficie totale à désobuser (non compris les bois) était de 451.000 hectares."
                            },
