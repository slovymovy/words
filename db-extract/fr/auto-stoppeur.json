                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "374aaaad-e4a2-4666-be1b-3a8302398d89",
                                                "sense_id": "ed206545-d187-3b12-ad80-53ee1ef0c333",
                                                "text": "An der Autobahnauffahrt warteten zwei Tramper auf eine passende Mitfahrgelegenheit."
                                            },
                                            {
                                                "example_id": "f4bd7c53-f3fc-42ce-9602-4235405038b6",
                                                "sense_id": "ed206545-d187-3b12-ad80-53ee1ef0c333",
                                                "text": "„Wir nehmen den Tramper mit und erzählen ihm, dass wir gerade von der heiligen Quelle kämen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
