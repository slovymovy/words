                "senses": [
                    {
                        "sense_id": "5bdfbc27-e65e-3ecc-8602-f8b48eba1f33",
                        "entry_id": "a3aabd13-2baa-31b6-bb7b-00cef768761a",
                        "glosses": [
                            "West-Germaanse taal bestaande uit een groep niet-gestandaardiseerde dialecten die in het noorden van Duitsland en het noordoosten van Nederland gesproken worden en die niet hebben deelgenomen aan de Hoogduitse klankverschuiving"
                        ],
                        "tags": [
                            "linguistics",
                            "no-plural"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "37ea1d1a-067c-3137-a1ab-51d9935cd011",
                        "entry_id": "a3aabd13-2baa-31b6-bb7b-00cef768761a",
                        "glosses": [
                            "West-Nederduits, d.i. de dialecten die gesproken worden in de westelijke helft van het Nederduitse/Nedersaksische taalgebied"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "faf0a21d-e0ba-4c1e-b6c7-5bd9472e3c1d",
                        "source_entry_id": "a3aabd13-2baa-31b6-bb7b-00cef768761a",
                        "source_sense_id": "5bdfbc27-e65e-3ecc-8602-f8b48eba1f33",
                        "source_sense_description": "een in Noord-Duitsland en Nederland gesproken West-Germaanse taal zonder Hoogduitse klankverschuiving",
                        "target_lang_word": "Niederdeutsch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niederdeutsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0470730-c093-3079-a351-49bc40c87a77",
                                        "entry_id": "36de1bea-a6d7-3e0e-8eef-ac5112ffaa3a",
                                        "glosses": [
                                            "auf das Altsächsische zurückgehende germanische Sprache der niederen Lande (nördlichen Landesteile)"
                                        ],
                                        "tags": [
                                            "besonders in der Sprachtheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba024e67-443d-428f-9e2e-fb5f687f7fbb",
                                                "sense_id": "d0470730-c093-3079-a351-49bc40c87a77",
                                                "text": "„Zu unterscheiden sind eine Frühzeit bis in die Mitte des 14. Jahrhunderts, eine klassische Epoche etwa zwischen 1350 und 1550 sowie die sich bis zum Ende des 17. Jahrhunderts erstreckende Spätzeit, eine Phase des Niederganges des Niederdeutschen - und zugleich des wachsenden Streites um seinen Wert.“"
                                            },
                                            {
                                                "example_id": "f2ae9879-ae46-4d86-a272-bdacfa329dea",
                                                "sense_id": "d0470730-c093-3079-a351-49bc40c87a77",
                                                "text": "„Die Florenz-Chronik wurde ins Niederdeutsche übersetzt […].“"
                                            },
                                            {
                                                "example_id": "748fe851-557d-4448-8cf5-da92f61e1b9b",
                                                "sense_id": "d0470730-c093-3079-a351-49bc40c87a77",
                                                "text": "„Als das Niederdeutsche von einer Weltprache zu einer Mundart des Deutschen verkam, gab es den Genitiv wie alle anderen Mundarten auf.“"
                                            },
                                            {
                                                "example_id": "de934962-1919-4d71-980d-1f719d464a52",
                                                "sense_id": "d0470730-c093-3079-a351-49bc40c87a77",
                                                "text": "„Abgelöst wurde das Niederdeutsche in Berlin durch Sprachformen, die aus dem Obersächsischen übernommen wurden.“"
                                            },
                                            {
                                                "example_id": "7eb918ba-1d0d-4bfb-a3ae-777843cc3c46",
                                                "sense_id": "d0470730-c093-3079-a351-49bc40c87a77",
                                                "text": "„Dagegen blieb das Altsächsische – die sprachliche Vorstufe des heutigen Niederdeutsch – von diesen Lautwandelprozessen unberührt, sodass auch heute im Platt noch immer Schipp (vgl. eng. ship; ndl. Schip), Appel (vgl. eng. apple), Tiet, dat und maken gesprochen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4af66fde-4ac7-3e1f-9309-04f680b2e002",
                                        "entry_id": "36de1bea-a6d7-3e0e-8eef-ac5112ffaa3a",
                                        "glosses": [
                                            "Sammelbezeichnung für die Mundarten der niederen Lande (nördlichen Landesteile); norddeutsche Dialekte der niederdeutschen Sprache"
                                        ],
                                        "tags": [
                                            "besonders in der Gegenwart"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "475c71f2-3583-44f0-9543-5100adf0e3b6",
                                                "sense_id": "4af66fde-4ac7-3e1f-9309-04f680b2e002",
                                                "text": "Niederdeutsch bezeichnet die Dialekte, die nördlich einer Linie gesprochen werden, die grob von Aachen über Kassel und Wittenberg reicht."
                                            },
                                            {
                                                "example_id": "af7df859-de3b-4439-aa30-7e7bd711f27d",
                                                "sense_id": "4af66fde-4ac7-3e1f-9309-04f680b2e002",
                                                "text": "„Abgelöst wurde das Niederdeutsche in Berlin durch Sprachformen, die aus dem Obersächsischen übernommen wurden.“"
                                            },
                                            {
                                                "example_id": "2a7bffed-92b1-4cc1-8dc6-7553f95a70b5",
                                                "sense_id": "4af66fde-4ac7-3e1f-9309-04f680b2e002",
                                                "text": "„Dagegen blieb das Altsächsische – die sprachliche Vorstufe des heutigen Niederdeutsch – von diesen Lautwandelprozessen unberührt, sodass auch heute im Platt noch immer Schipp (vgl. eng. ship; ndl. Schip), Appel (vgl. eng. apple), Tiet, dat und maken gesprochen wird.“"
                                            },
                                            {
                                                "example_id": "1fe7d125-6f2f-4f9d-8420-9bda7d27a318",
                                                "sense_id": "4af66fde-4ac7-3e1f-9309-04f680b2e002",
                                                "text": "„Strüber hat ihre Einschätzung der Lage des Niederdeutschen in einem Text auf blass-gelbem Papier zusammengefasst: »Das Plattdeutsche ist heute in seiner Existenz bedroht, wie so vieles Schöne und Wesentliche in unserer Umwelt.«.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
