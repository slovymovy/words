{
    "word_family": [
        "squanderer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "15b3a7bd-64b7-3b66-957d-f5e59f7f87d0",
                    "sense_definition": "To spend money, time, or resources in a wasteful or careless way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "waste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>squander</w> your time on things that do not matter.",
                            "target_lang_translations": {
                                "ru": "Не <w>растрачивайте</w> своё время на вещи, которые не имеют значения."
                            }
                        },
                        {
                            "text": "The team <w>squandered</w> their lead in the final minutes of the game.",
                            "target_lang_translations": {
                                "ru": "Команда <w>растранжирила</w> своё преимущество в последние минуты игры."
                            }
                        }
                    ],
                    "synonyms": [
                        "waste",
                        "lavish",
                        "splurge",
                        "throw away"
                    ],
                    "common_phrases": [
                        "squander money",
                        "squander opportunity",
                        "squander time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тратить деньги, время или ресурсы неразумным или небрежным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растрачивать",
                                "target_lang_sense_clarification": "тратить ресурсы, силы или время неразумно"
                            },
                            {
                                "target_lang_word": "транжирить",
                                "target_lang_sense_clarification": "разговорное, о нерасчётливой трате денег"
                            },
                            {
                                "target_lang_word": "разбазаривать",
                                "target_lang_sense_clarification": "разговорное, тратить не по-хозяйски или зря"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b19b473c-a786-331d-a165-06f3ac07553f",
                    "sense_definition": "To cause to separate and move in different directions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scatter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind <w>squandered</w> the dry leaves across the empty field.",
                            "target_lang_translations": {
                                "ru": "Ветер <w>развеял</w> сухие листья по пустому полю."
                            }
                        },
                        {
                            "text": "The general tried to rally his <w>squandered</w> troops after the surprise attack.",
                            "target_lang_translations": {
                                "ru": "Генерал пытался собрать своих <w>рассеянных</w> солдат после внезапной атаки."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять что-либо разделиться и двигаться в разных направлениях; рассеивать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассеивать",
                                "target_lang_sense_clarification": "заставлять разлетаться или расходиться в разные стороны"
                            },
                            {
                                "target_lang_word": "разбрасывать",
                                "target_lang_sense_clarification": "размещать или разносить что-либо по разным местам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}