                    },
                    {
                        "translation_id": "9fbac815-b46c-4496-80f6-e74d846fc474",
                        "source_entry_id": "4e3a732f-5688-3963-8627-2f6348a7b226",
                        "source_sense_description": "The property of being unpleasant or disagreeable",
                        "target_lang_word": "onaangenaamheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onaangenaamheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c9b6cf7a-d192-3d1e-90fc-a2764e44d4c9",
                                        "entry_id": "032fbc7e-083f-399d-bf16-0db535b46815",
                                        "glosses": [
                                            "vermogen een negatief gevoel te veroorzaken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5015d3d9-dd3c-4655-ada2-700f2e82f5c7",
                                                "sense_id": "c9b6cf7a-d192-3d1e-90fc-a2764e44d4c9",
                                                "text": "Justitie moet snel kunnen straffen en de straf moet als onaangenaam worden ervaren. Nu ontbreekt het zowel aan snelheid als onaangenaamheid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee01230-66cd-3108-841f-11b66ccbfe86",
                                        "entry_id": "032fbc7e-083f-399d-bf16-0db535b46815",
                                        "glosses": [
                                            "iets wat een negatief gevoel veroorzaakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd9d65f1-4d0c-404c-bb92-5ed533e239c8",
                                                "sense_id": "aee01230-66cd-3108-841f-11b66ccbfe86",
                                                "text": "De reeks atoomproeven, de beslissing de dienstplicht af te schaffen, de kandidatuur van Jean-Claude Trichet voor het presidentschap van de nieuwe Europese centrale bank, het waren evenzovele verrassingen voor een onthutste Duitse kanselier die dit allemaal onvoorbereid over zich heen moest laten gaan. Na de laatste onaangenaamheid, de onduidelijkheid over de Frankfurtse ambtstermijn van Duisenberg, sloten Chirac en Kohl in Avignon overigens uitbundig vrede."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b0ab60d-5deb-4226-9141-5dea5385f240",
                        "source_entry_id": "4e3a732f-5688-3963-8627-2f6348a7b226",
                        "source_sense_description": "The property of being unpleasant or disagreeable",
                        "target_lang_word": "zerpte",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "511b5bff-3896-4160-a509-589eee562c09",
                        "source_entry_id": "4e3a732f-5688-3963-8627-2f6348a7b226",
                        "source_sense_description": "The property of being unpleasant or disagreeable",
                        "target_lang_word": "Unannehmlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unannehmlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                        "entry_id": "8f3cad81-f8c9-3cd7-841d-d38844303c34",
                                        "glosses": [
                                            "unangenehme Sache, Ärgernis"
                                        ],
                                        "tags": [
                                            "abstract"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37537714-f80c-43e5-9007-22d1febfe541",
                                                "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                                "text": "„Ist der Schnelltest positiv, hat der Fahrer noch keine rechtlichen Folgen, wohl aber Unannehmlichkeiten zu befürchten.“"
                                            },
                                            {
                                                "example_id": "4985ce0e-206e-4c66-8d15-e7a7ce62c554",
                                                "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                                "text": "Dieser Plan bereitet erhebliche Unannehmlichkeiten."
                                            },
                                            {
                                                "example_id": "f49dfe7a-48b3-426b-8aa8-c30b6f3ab3a7",
                                                "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                                "text": "Ich würde gerne heute Nachmittag vorbeischauen, wenn es Ihnen keine Unannehmlichkeiten bereitet."
                                            },
                                            {
                                                "example_id": "5631eb5e-5a03-4d73-b6ca-76d0aa521caf",
                                                "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                                "text": "„Ich erinnerte mich, daß mir die gleiche Unannehmlichkeit unter ähnlichen Umständen in Köln zugestoßen war.“"
                                            },
                                            {
                                                "example_id": "87af7359-c9a8-4afc-be5f-d3be2b772d2d",
                                                "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                                "text": "„Im Oktober 1759 entschuldigt er Bodmer gegenüber sein langes Schweigen mit Unannehmlichkeiten in seiner Arbeitssituation.“"
                                            },
                                            {
                                                "example_id": "d58da87b-add1-448c-b80c-76efbfcec68b",
                                                "sense_id": "847e2156-05b8-3cef-9846-4dfb7903485b",
                                                "text": "„Wohl trafen sie mancherlei Unannehmlichkeiten, wie Einkommensteuerformulare, Alkoholknappheit und junge Männer, deren Väter sie gekannt hatte, und die ihr ungedeckte Schecks gaben – aber all das war schnell vergessen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
