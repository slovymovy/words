                "senses": [
                    {
                        "sense_id": "98a873e9-6942-3da3-b8d0-78ec805350f6",
                        "entry_id": "3c181ea4-6286-321a-a732-c96f3156fe5a",
                        "glosses": [
                            "Pâturage d’altitude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a44b8ee-b7c2-470a-b9a6-7458216a38d0",
                                "sense_id": "98a873e9-6942-3da3-b8d0-78ec805350f6",
                                "text": "Lʼemplacement du chalet doit se raisonner en fonction de la configuration générale de lʼalpage."
                            },
                            {
                                "example_id": "ba44008b-d25a-42bd-902e-7a15589e238f",
                                "sense_id": "98a873e9-6942-3da3-b8d0-78ec805350f6",
                                "text": "Sur les alpages de Miage et du Truc, 54 microtoponymes ont été relevés dont 22 mentionnés sur la carte IGN série bleue au 1/25 000ᵉ Saint-Gervais - Les Bains (3531 est)."
                            },
                            {
                                "example_id": "21982df4-32d3-42f2-bf97-2cdb43a0bf3f",
                                "sense_id": "98a873e9-6942-3da3-b8d0-78ec805350f6",
                                "text": "L'été, les troupeaux de vaches d’Abondance regardent tranquillement passer les randonneurs et les vététistes dans les alpages et les sentiers."
                            }
                        ]
                    },
                    {
                        "sense_id": "c23218c1-832b-3504-8388-b936e8444098",
                        "entry_id": "3c181ea4-6286-321a-a732-c96f3156fe5a",
                        "glosses": [
                            "Période estivale passée par un troupeau à pâturer en altitude."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5883253d-340e-4e6f-82e5-ce02d8849117",
                                "sense_id": "c23218c1-832b-3504-8388-b936e8444098",
                                "text": "En octobre, après l’alpage, les génisses redescendent dans la vallée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a6e63c5-7494-48ec-9baa-f4358e868a3e",
                        "source_entry_id": "3c181ea4-6286-321a-a732-c96f3156fe5a",
                        "source_sense_id": "98a873e9-6942-3da3-b8d0-78ec805350f6",
                        "source_sense_description": "Pâturage d’altitude",
                        "target_lang_word": "Alm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00c86969-dccb-322d-abff-9f80e1ee52c5",
                                        "entry_id": "310b9d74-ba2d-3f49-955a-b7c05bb645d9",
                                        "glosses": [
                                            "Bergweide oder Bergwiese, auf der im Sommer Weidewirtschaft, gegebenenfalls auch Gastronomie und Bewirtung betrieben wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91227d3a-c9e0-4d19-a449-8022ed1e5b49",
                                                "sense_id": "00c86969-dccb-322d-abff-9f80e1ee52c5",
                                                "text": "Der Hirte führte seine Schafe und Lämmer auf die Alm hinaus, um sie grasen zu lassen."
                                            },
                                            {
                                                "example_id": "594fc3de-20d7-4f60-ae03-24ee986dba84",
                                                "sense_id": "00c86969-dccb-322d-abff-9f80e1ee52c5",
                                                "text": "„Da gab's dann bald mehr Diskos als Kühe in den Dörfern, in den Landgasthöfen sprudelten die Whirlpools, und die Sennerinnen wurden mit dem Paragleiter auf die Alm geflogen.“"
                                            },
                                            {
                                                "example_id": "ab4cd08b-4efc-4aec-9170-3db8ab8d6705",
                                                "sense_id": "00c86969-dccb-322d-abff-9f80e1ee52c5",
                                                "text": "„Mit zwei Wanderstöcken in den Fäusten spaziert sie an einem Sommertag im Jahr 2020 bedächtig über grüne Almen zur Wallfahrtskapelle Maria Birkenstein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1463813c-b4b3-429b-9cfd-a3c94a4b9b18",
                        "source_entry_id": "3c181ea4-6286-321a-a732-c96f3156fe5a",
