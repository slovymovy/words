            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02c3a793-e25f-3493-9599-4c7a72574b59",
                    "sense_definition": "Личное название человека, которое даётся ему при рождении.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Меня зовут Анна, а как ваше <w>имя</w>?",
                            "target_lang_translations": {
                                "en": "My name is Anna, and what is your <w>name</w>?",
                                "zh": "我叫安娜，请问你的<w>名字</w>是什么？"
                            }
                        },
                        {
                            "text": "В официальных документах нужно писать полное <w>имя</w>.",
                            "target_lang_translations": {
                                "en": "In official documents, you must write your full <w>name</w>.",
                                "zh": "在正式文件中必须填写全<w>名</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "моё имя",
                        "полное имя",
                        "имя и фамилия",
                        "красивое имя"
                    ],
                    "target_lang_definitions": {
                        "en": "A personal name given to a human at birth.",
                        "zh": "人出生时被赋予的个人称呼。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "name",
                                "target_lang_sense_clarification": "personal identifier"
                            },
                            {
                                "target_lang_word": "first name",
                                "target_lang_sense_clarification": "given name"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "名字",
                                "target_lang_sense_clarification": "个人称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "876ee725-dc49-3bfb-8d58-8c0d1ed4d509",
                    "sense_definition": "Указание на то, в честь кого назван объект (обычно используется в названиях учреждений, улиц, парков).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы встретились у входа в парк <w>имени</w> Горького.",
                            "target_lang_translations": {
                                "en": "We met at the entrance to the park <w>named after</w> Gorky.",
                                "zh": "我们在高尔基公园的入口处见面，该公园以高尔基的<w>名</w>字命名。"
                            }
                        },
                        {
                            "text": "Центральная библиотека носит <w>имя</w> известного писателя.",
                            "target_lang_translations": {
                                "en": "The central library bears the <w>name</w> of a famous writer.",
                                "zh": "中央图书馆以一位著名作家的<w>名</w>字命名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "парк имени",
                        "улица имени",
                        "завод имени",
                        "носить имя"
                    ],
                    "target_lang_definitions": {
                        "en": "An indication of the person in whose honor an object is named.",
                        "zh": "指代以某人名义命名的机构、街道或公园。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "name",
                                "target_lang_sense_clarification": "commemoration/in honor of"
                            },
                            {
                                "target_lang_word": "named after",
                                "target_lang_sense_clarification": "phrase used for 'имени'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "名",
                                "target_lang_sense_clarification": "以……之名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e88a0a36-4629-3fcc-8f94-bac0c2f16da0",
                    "sense_definition": "Известность, общественная оценка чьих-либо качеств или достоинств.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот учёный имеет мировое <w>имя</w> в науке.",
                            "target_lang_translations": {
                                "en": "This scientist has a worldwide <w>name</w> in science.",
                                "zh": "这位科学家在科学界享有世界级的<w>名</w>声。"
                            }
                        },
                        {
                            "text": "Он боялся потерять своё честное <w>имя</w> из-за скандала.",
                            "target_lang_translations": {
                                "en": "He was afraid of losing his good <w>name</w> because of the scandal.",
                                "zh": "他担心因为丑闻而失去自己的清白<w>名</w>声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "репутация",
                        "слава"
                    ],
                    "antonyms": [
                        "неизвестность"
                    ],
                    "common_phrases": [
