                                "sense_id": "b12258dc-ad5b-31e6-b742-7c93de37bb30",
                                "text": "Caractères typiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "c26885c6-91cc-31df-842b-991e86a55307",
                        "entry_id": "dc5cd529-f406-38d9-84be-d3f0f4bb8960",
                        "glosses": [
                            "Symbolique, allégorique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce4dce15-e559-40d8-8da7-f050b8b04744",
                                "sense_id": "c26885c6-91cc-31df-842b-991e86a55307",
                                "text": "Le sens typique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bff158f9-9b26-451c-8fe4-cdc864d482c9",
                        "source_entry_id": "dc5cd529-f406-38d9-84be-d3f0f4bb8960",
