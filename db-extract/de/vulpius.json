                            {
                                "example_id": "e09bd65a-6fd0-4486-befd-ce686fb8c424",
                                "sense_id": "72816b71-7f6c-3af1-a131-2c1cd9521ab3",
                                "text": "Christian August Vulpius wurde am 23. Januar 1762 in Weimar geboren und starb am 26. Juni 1827 ebendort. Er war ein deutscher Schriftsteller."
                            },
                            {
                                "example_id": "b90b9dba-d3e1-4f14-90cf-736fde0f3455",
                                "sense_id": "72816b71-7f6c-3af1-a131-2c1cd9521ab3",
                                "text": "Es ist sehr die Frage, wem Goethe mehr verdankt, der Stein oder der Vulpius."
                            }
                        ],
