{
    "word_family": [
        "charioteer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c5cb54f-3449-371b-abe4-57de28c52eed",
                    "sense_definition": "A two-wheeled, horse-drawn cart used in ancient warfare, racing, and processions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wheeled vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient warriors charged across the dusty field in a heavy <w>chariot</w>.",
                            "target_lang_translations": {
                                "ru": "Древние воины ринулись через пыльное поле на тяжелой <w>колеснице</w>."
                            }
                        },
                        {
                            "text": "Spectators cheered as each fast <w>chariot</w> completed another lap around the Roman arena.",
                            "target_lang_translations": {
                                "ru": "Зрители ликовали, когда очередная быстрая <w>колесница</w> завершала круг по римской арене."
                            }
                        }
                    ],
                    "synonyms": [
                        "car"
                    ],
                    "common_phrases": [
                        "chariot race",
                        "horse-drawn chariot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двухколесная конная повозка, использовавшаяся в древности для военных действий, гонок и торжественных процессий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колесница",
                                "target_lang_sense_clarification": "древняя боевая или гоночная повозка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b7b732a-03e1-3fbc-9d54-43f0d66afb65",
                    "sense_definition": "A light four-wheeled carriage used historically for ceremonial occasions or pleasure traveling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wheeled vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The noble family rode through town in an ornate <w>chariot</w> draped with velvet.",
                            "target_lang_translations": {
                                "ru": "Знатная семья ехала по городу в богато украшенной <w>карете</w>, задрапированной бархатом."
                            }
                        },
                        {
                            "text": "The museum displays a royal <w>chariot</w> preserved from the eighteenth century.",
                            "target_lang_translations": {
                                "ru": "В музее представлена королевская <w>карета</w>, сохранившаяся с восемнадцатого века."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to historical carriage types"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкая четырехколесная повозка, использовавшаяся в прошлые эпохи для церемоний или прогулочных поездок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карета",
                                "target_lang_sense_clarification": "парадная или прогулочная повозка"
                            },
                            {
                                "target_lang_word": "экипаж",
                                "target_lang_sense_clarification": "конная повозка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a97f3bf3-a491-3cec-9555-9273910a6259",
                    "sense_definition": "The rook in the game of chess or similar traditional board games.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He protected his king by sliding his <w>chariot</w> along the rank.",
                            "target_lang_translations": {
                                "ru": "Он защитил своего короля, передвинув <w>ладью</w> по горизонтали."
                            }
                        },
                        {
                            "text": "In Chinese chess, the piece that moves like a rook is often called a <w>chariot</w>.",
                            "target_lang_translations": {
                                "ru": "В китайских шахматах фигура, которая ходит как ладья, часто называется <w>колесницей</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ладья в шахматах или аналогичных традиционных настольных играх (например, в сянци)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ладья",
                                "target_lang_sense_clarification": "шахматная фигура"
                            },
                            {
                                "target_lang_word": "колесница",
                                "target_lang_sense_clarification": "фигура в восточных шахматах (сянци)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "07c88c89-aaea-3653-a6d7-7ef16e1e23a4",
                    "sense_definition": "To ride or travel in a chariot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mythical hero <w>charioted</w> through the open clouds toward the golden palace.",
                            "target_lang_translations": {
                                "ru": "Мифический герой <w>мчался на колеснице</w> сквозь облака к золотому дворцу."
                            }
                        },
                        {
                            "text": "Statues depicted victorious kings <w>charioting</w> over the lands of their enemies.",
                            "target_lang_translations": {
                                "ru": "Статуи изображали победоносных царей, <w>едущих на колесницах</w> по землям своих врагов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rare and literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ехать или путешествовать на колеснице."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ехать на колеснице",
                                "target_lang_sense_clarification": "передвигаться на колеснице"
                            },
                            {
                                "target_lang_word": "мчаться на колеснице",
                                "target_lang_sense_clarification": "быстро нестись на колеснице"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3981f948-982f-3209-814f-27062e2f3dda",
                    "sense_definition": "To convey or transport someone by, or as if by, a chariot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A team of white horses <w>charioted</w> the general into the festive city.",
                            "target_lang_translations": {
                                "ru": "Упряжка белых коней <w>везла на колеснице</w> полководца в праздничный город."
                            }
                        },
                        {
                            "text": "The poem describes how a gentle wind <w>chariots</w> the autumn leaves away.",
                            "target_lang_translations": {
                                "ru": "В поэме описывается, как легкий ветерок <w>уносит</w> осенние листья."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary and uncommon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Везти, транспортировать кого-либо на колеснице или подобно ей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "везти на колеснице",
                                "target_lang_sense_clarification": "транспортировать на колеснице"
                            },
                            {
                                "target_lang_word": "уносить",
                                "target_lang_sense_clarification": "в переносном значении, о ветре и т. п."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}