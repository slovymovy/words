                {
                    "sense_id": "91cc89f0-c693-32a4-94b6-57bf7b1ce651",
                    "sense_definition": "A period of time lasting approximately four weeks or 30 days.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went on holiday for two <w>months</w>.",
                            "target_lang_translations": {
                                "ru": "Мы ездили в отпуск на два <w>месяца</w>.",
                                "tr": "İki <w>aylığına</w> tatile gittik.",
                                "nl": "We gingen voor twee <w>maanden</w> op vakantie.",
                                "pl": "Pojechaliśmy na urlop na dwa <w>miesiące</w>.",
                                "de": "Wir sind für zwei <w>Monate</w> in den Urlaub gefahren.",
                                "fr": "Nous sommes partis en vacances pendant deux <w>mois</w>.",
                                "it": "Siamo andati in vacanza per due <w>mesi</w>.",
                                "cs": "Jeli jsme na dovolenou na dva <w>měsíce</w>.",
                                "es": "Nos fuimos de vacaciones por dos <w>meses</w>."
                            }
                        },
                        {
                            "text": "The project will be finished in a <w>month</w>.",
                            "target_lang_translations": {
                                "ru": "Проект будет закончен через <w>месяц</w>.",
                                "tr": "Proje bir <w>ay</w> içinde bitirilecek.",
                                "nl": "Het project zal binnen een <w>maand</w> klaar zijn.",
                                "pl": "Projekt zostanie ukończony za <w>miesiąc</w>.",
                                "de": "Das Projekt wird in einem <w>Monat</w> abgeschlossen sein.",
                                "fr": "Le projet sera terminé dans un <w>mois</w>.",
                                "it": "Il progetto sarà finito tra un <w>mese</w>.",
                                "cs": "Projekt bude dokončen za <w>měsíc</w>.",
                                "es": "El proyecto estará terminado en un <w>mes</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a month ago",
                        "in a month",
                        "for a month"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период времени, длящийся примерно четыре недели или 30 дней.",
                        "tr": "Yaklaşık dört hafta veya 30 gün süren zaman dilimi.",
                        "nl": "Een periode van ongeveer vier weken of 30 dagen.",
                        "pl": "Okres czasu trwający około czterech tygodni lub 30 dni.",
                        "de": "Ein Zeitraum von ungefähr vier Wochen oder 30 Tagen.",
                        "fr": "Une période de temps d'une durée d'environ quatre semaines ou 30 jours.",
                        "it": "Un periodo di tempo della durata di circa quattro settimane o 30 giorni.",
                        "cs": "Časové období trvající přibližně čtyři týdny nebo 30 dní.",
                        "es": "Un período de tiempo que dura aproximadamente cuatro semanas o 30 días."
