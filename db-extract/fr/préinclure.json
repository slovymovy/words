                "senses": [
                    {
                        "sense_id": "e9092ae0-6910-396a-959d-c48833d95624",
                        "entry_id": "23787723-7160-37e2-9903-a3d9f190a346",
                        "glosses": [
                            "Inclure au départ."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83bd2983-b105-4cc0-a76e-f605710e2964",
                                "sense_id": "e9092ae0-6910-396a-959d-c48833d95624",
                                "text": "La présente invention concerne un procédé de fabrication permettant de préinclure un capteur de réseau de fibres dans un fil magnétique."
                            },
                            {
                                "example_id": "61ff1638-913e-4d4e-b82d-901bb9a09b76",
                                "sense_id": "e9092ae0-6910-396a-959d-c48833d95624",
                                "text": "Sachant que la phmétrie sera pathologique dans 1 cas sur 5, il faut prévoir de préinclure 500 patients pour 90 patients définitivement inclus."
                            },
                            {
                                "example_id": "e3efd262-6919-4cdb-bd31-8af29f2c11df",
                                "sense_id": "e9092ae0-6910-396a-959d-c48833d95624",
                                "text": "Nous avons donc décidé de préinclure ces fonctions de base et de donner aux utilisateurs la possibilité d’installer des fonctionnalités supplémentaires de leur choix en fonction de leurs besoins."
                            }
                        ]
                    }
