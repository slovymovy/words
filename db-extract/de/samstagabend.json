                ],
                "senses": [
                    {
                        "sense_id": "e8ff531f-7fde-3a97-839d-81f608a0b0f1",
                        "entry_id": "87fcd5f3-3c78-3329-b4fd-ab3a8c76ff51",
                        "glosses": [
                            "der Abend eines Samstages"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2d0e66e-27d9-49bf-96bb-ca6c1ec893b5",
                                "sense_id": "e8ff531f-7fde-3a97-839d-81f608a0b0f1",
                                "text": "Für Samstagabend ist eine große Feier bei den Nachbarn geplant."
                            },
                            {
                                "example_id": "eef223cc-3031-4788-a4a0-282ed62b8063",
                                "sense_id": "e8ff531f-7fde-3a97-839d-81f608a0b0f1",
                                "text": "Samstagabende sind dem geselligen Beisammensein mit der Familie vorbehalten."
                            },
                            {
                                "example_id": "d2f59013-a56a-4040-8dfd-abf1ea0f1ae8",
                                "sense_id": "e8ff531f-7fde-3a97-839d-81f608a0b0f1",
                                "text": "„Es war Samstagabend und daher herrschte Stimmung in der Kommune.“"
                            },
                            {
                                "example_id": "7816e71c-edb5-408a-82b3-ad2f285086b1",
                                "sense_id": "e8ff531f-7fde-3a97-839d-81f608a0b0f1",
                                "text": "„Es war der Samstagabend vor meinem eigentlichen Termin am Wochenbeginn.“"
                            },
                            {
                                "example_id": "ea12fc32-0572-4946-9fc6-3070e6ba196d",
                                "sense_id": "e8ff531f-7fde-3a97-839d-81f608a0b0f1",
                                "text": "„Die Kleider der Frauen waren für eine Feier am Samstagabend nicht besonders festlich, manche wirkten für Kostas auf den ersten Blick wie Nachthemden.“"
                            },
                            {
                                "example_id": "969c8c26-0440-4924-b847-a5a674d0aba6",
                                "sense_id": "e8ff531f-7fde-3a97-839d-81f608a0b0f1",
                                "text": "„Am Samstagabend verließ mich seine Tochter mit einer traurigeren Miene als sonst und wandte das Gesicht ab, als ich ihr einen Kuß geben wollte, mit dem ich sie doch nur meiner Beständigkeit zu versichern suchte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
