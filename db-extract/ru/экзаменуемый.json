                        "sense_id": "46248479-9981-30fe-8deb-334562d07490",
                        "entry_id": "115b22a9-cd44-3d44-9c88-77932d854bd8",
                        "glosses": [
                            "тот, кто сдал, сдает или готовится к сдаче экзамена"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3edae462-af23-4ccc-b2bc-01c0662806f4",
                                "sense_id": "46248479-9981-30fe-8deb-334562d07490",
                                "text": "А экзаменуемый имеет право прерваться лишь на секунду, чтобы сделать глоток воды."
                            },
                            {
                                "example_id": "2af5c9cf-2387-4051-8190-099a3c0f75db",
                                "sense_id": "46248479-9981-30fe-8deb-334562d07490",
                                "text": "Достаточно случаев, когда экзаменуемый погибал вместе с экзаменатором."
                            }
                        ]
                    }
