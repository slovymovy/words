                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98e8ea67-faf1-44b8-b556-50d401489dc4",
                                "sense_id": "ec254dbb-9ebd-3482-9932-028f3d76e4fa",
                                "text": "„Hanja zog eine silberne Pillendose aus der Tasche und warf sich ein paar Pfefferminzpastillen in den Mund.“"
                            },
                            {
                                "example_id": "184eac55-d363-4b7a-a2c1-2817ce435045",
                                "sense_id": "ec254dbb-9ebd-3482-9932-028f3d76e4fa",
                                "text": "„Auf dem Rückweg ordnete Griessel die Fläschchen in den Taschen noch einmal neu. Ging dann erst auf die Toilette und trank eine. Zögerte einen Augenblick und trank noch eine. Steckte sich vier Pfefferminzpastillen in den Mund, lutschte einen Moment darauf herum und verteilte den Speichel im Mund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
