                        "sense_id": "a0e1e395-9cf6-3722-ba4c-aa11eaad473e",
                        "entry_id": "77c21ea7-a32d-34ee-8faa-92378fea3252",
                        "glosses": [
                            "betrekking hebbend op de processen die in een vulkaan plaatsvinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bf27cc6-c97f-42a3-a0ed-cb51ed09db1f",
                                "sense_id": "a0e1e395-9cf6-3722-ba4c-aa11eaad473e",
                                "text": "De vulkanische activiteit van Vesuvius wordt nauwgezet in de gaten gehouden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c3e2702-2d54-4d8d-a2f4-21f598189c0d",
                        "source_entry_id": "77c21ea7-a32d-34ee-8faa-92378fea3252",
                        "source_sense_id": "a0e1e395-9cf6-3722-ba4c-aa11eaad473e",
                        "source_sense_description": "betrekking hebbend op de processen die in een vulkaan plaatsvinden",
                        "target_lang_word": "vulkanisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vulkanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7595c77e-02dd-372d-bb1b-df2ba2d3e505",
                                        "entry_id": "f7b0fc17-ce0c-3dcf-8aed-c4b1ef556024",
                                        "glosses": [
                                            "auf Vulkanismus beruhend, von Vulkanen gebildet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c7858ba-09b2-459e-a6d0-c9fede7df89b",
                                                "sense_id": "7595c77e-02dd-372d-bb1b-df2ba2d3e505",
                                                "text": "Weder Streiks noch die Terroranschläge des 11. September bewirkten, was vulkanischem Feinstaub in der Stratosphäre gelang: Europa erlebt einen flugzeuglosen Himmel."
                                            },
                                            {
                                                "example_id": "c94f7292-5b45-4bbb-be79-bad4861f6b6f",
                                                "sense_id": "7595c77e-02dd-372d-bb1b-df2ba2d3e505",
                                                "text": "Kommt man gegen Vicenza, so steigen wieder Hügel von Norden nach Süden auf, sie sind vulkanisch, sagt man, und schließen die Ebene."
                                            },
                                            {
                                                "example_id": "9fca3277-6fb3-454a-8a9a-38b08de51618",
                                                "sense_id": "7595c77e-02dd-372d-bb1b-df2ba2d3e505",
                                                "text": "„Weiterhin gehört zum Nimbus der vulkanische Ursprung des Berges; er unterstreicht die bereits aus der geographischen Lage resultierende Synthese der Elemente Feuer und Eis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19211025-f1aa-32a6-ab83-0e07211e1158",
                                        "entry_id": "f7b0fc17-ce0c-3dcf-8aed-c4b1ef556024",
                                        "glosses": [
                                            "zu Gefühlsausbrüchen neigend, aufbrausend, leidenschaftlich bewegt"
                                        ],
                                        "tags": [
                                            "figurativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "768ad8e5-f954-421d-9342-f4a8f93c89a5",
                                                "sense_id": "19211025-f1aa-32a6-ab83-0e07211e1158",
                                                "text": "Ein Höchstgenuss fürs Auge, ein Triumph der Malkunst: Gelbgraue Gesichter, rosafarbene Schatten, Gewänder, die aus flüssiger Lava zu sein scheinen, derart vulkanisch vibrierend ist die Malerei El Grecos."
                                            },
                                            {
                                                "example_id": "2e39ff22-7a93-4331-a8e0-609b3a48d654",
                                                "sense_id": "19211025-f1aa-32a6-ab83-0e07211e1158",
                                                "text": "Das sammelt eine Wolke von Melancholie auf ihrer Stirne: denn dass das Scheinen Nothwendigkeit ist, hassen solche Naturen mehr als den Tod; und eine solche andauernde Erbitterung darüber macht sie vulkanisch und bedrohlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
