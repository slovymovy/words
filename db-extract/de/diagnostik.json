                "senses": [
                    {
                        "sense_id": "cf86dd1e-73d4-3e37-a316-f50f29efec74",
                        "entry_id": "52a8fec3-6e2c-3c0e-974d-419bcb1f016d",
                        "glosses": [
                            "Lehre von der Erkennung/Bestimmung (insbesondere von Krankheiten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b43eae81-f907-4125-8df0-5e18cf1d0d20",
                                "sense_id": "cf86dd1e-73d4-3e37-a316-f50f29efec74",
                                "text": "„Ob in Brennstoffzellen, zur medizinischen Diagnostik oder Produktion neuer Materialien und Energieträger — Katalysatoren haben ein enormes Einsatzpotenzial.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64e1ab4f-57f3-4234-be15-0e9f8e17022b",
                        "source_entry_id": "52a8fec3-6e2c-3c0e-974d-419bcb1f016d",
                        "source_sense_id": "cf86dd1e-73d4-3e37-a316-f50f29efec74",
                        "source_sense_description": "Medizin: Lehre von der Erkennung/Bestimmung (insbesondere von Krankheiten)",
                        "target_lang_word": "diagnostics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diagnostics",
