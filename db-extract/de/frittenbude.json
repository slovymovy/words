                    {
                        "sense_id": "ab2c18ec-3d5b-394b-9896-a5afbce6b870",
                        "entry_id": "4c6eea93-3a5e-3c90-89ce-7532fb7bfa16",
                        "glosses": [
                            "ein Verkaufsstand, an dem man kleine Zwischenmahlzeiten und Getränke, vorwiegend Pommes frites, Würstchen und Ähnliches zum Mitnehmen kaufen kann"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "3152fbce-9115-48a8-9014-86e84872872e",
                                "sense_id": "ab2c18ec-3d5b-394b-9896-a5afbce6b870",
                                "text": "Wenn in der Fabrik Mittagspause ist, macht die Frittenbude gegenüber immer einen hohen Umsatz."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2049287c-71b5-462e-9c07-832696e154ac",
                        "source_entry_id": "4c6eea93-3a5e-3c90-89ce-7532fb7bfa16",
                        "source_sense_id": "ab2c18ec-3d5b-394b-9896-a5afbce6b870",
                        "target_lang_word": "chippy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chippy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c8e8400-7a16-347d-a839-d007f5709385",
                                        "entry_id": "0051f8e5-85d2-308a-a356-53493f2f433e",
                                        "glosses": [
                                            "A carpenter."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad14704d-d8d0-4d5c-8c67-e8a2be100c1e",
                                                "sense_id": "3c8e8400-7a16-347d-a839-d007f5709385",
                                                "text": "Then, when ah wis apprenticed as a chippy wi a Gorgie builder, ah goes along tae Telford College tae dae ma national certificate modules in joinery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "477768ff-c1fa-36a2-8a9a-f1b434f31fb4",
                                        "entry_id": "0051f8e5-85d2-308a-a356-53493f2f433e",
                                        "glosses": [
                                            "A prostitute or promiscuous woman."
                                        ],
                                        "tags": [
                                            "US",
                                            "Western",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ed1e455-2d21-4286-b936-11ee1cb93813",
                                                "sense_id": "477768ff-c1fa-36a2-8a9a-f1b434f31fb4",
                                                "text": "I manage to pick up a living in spite of the damn chippies. I don't see why the hell they don't go into the business regular and make something out of it, instead of loving free."
                                            },
                                            {
                                                "example_id": "3081548d-0c6b-429e-9012-f660d07380ec",
                                                "sense_id": "477768ff-c1fa-36a2-8a9a-f1b434f31fb4",
                                                "text": "Don't worry chippy, nobodys gonna hurtya. Maybe fuckya a little[…]"
                                            },
                                            {
                                                "example_id": "7505667b-53f8-473b-896e-4f367227a9c7",
                                                "sense_id": "477768ff-c1fa-36a2-8a9a-f1b434f31fb4",
                                                "text": "$80 for a chippy? I can get a goddamn horse for $50!"
                                            },
                                            {
                                                "example_id": "de8df3db-ce82-471a-bd5b-5c7ebbb8ad9e",
                                                "sense_id": "477768ff-c1fa-36a2-8a9a-f1b434f31fb4",
                                                "text": "I give the pictures of the wife and the lawn boy to the husband. I give the pictures of the husband and the chippy to the wife."
                                            },
                                            {
                                                "example_id": "f1456fbc-e092-453c-8181-bda6f5ceb242",
                                                "sense_id": "477768ff-c1fa-36a2-8a9a-f1b434f31fb4",
                                                "text": "Canby hints that, even with chippies, sexual intercourse was rare; even putting aside his complete lack of regard for the chippy as an actual human being, however, this passage makes clear that whatever did occur with these chippies may not have been as consensual as he presumed.⁷²"
                                            },
                                            {
                                                "example_id": "bc4042ae-5503-4f48-9b59-a8234d98777c",
                                                "sense_id": "477768ff-c1fa-36a2-8a9a-f1b434f31fb4",
                                                "text": "When Victor Laszlo leads the demoralized French in the “Marseilles^([sic – meaning Marseillaise]),” and even Yvonne, the chippy who is sleeping with a Nazi officer, joins in, the stoniest intellectual collapses in tears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86eee3b6-84df-32b2-a84c-91989ca6a3f9",
                                        "entry_id": "0051f8e5-85d2-308a-a356-53493f2f433e",
                                        "glosses": [
                                            "A fish-and-chip shop."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdbc6cc8-fb4e-467a-9483-682e7e2cf2fc",
                                                "sense_id": "86eee3b6-84df-32b2-a84c-91989ca6a3f9",
                                                "text": "Huge queues form outside the Chippy, often stretching back to the Coop and beyond."
                                            },
                                            {
                                                "example_id": "66012423-8c21-415a-97de-37aa7d05844a",
                                                "sense_id": "86eee3b6-84df-32b2-a84c-91989ca6a3f9",
                                                "text": "Albert was flabbergasted. Yer really buyin′ a chippy?” Tom smiled whilst nodding his head. “That′s me plan.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b5bd348-df41-39e8-b260-25efaa91c18f",
                                        "entry_id": "0051f8e5-85d2-308a-a356-53493f2f433e",
                                        "glosses": [
                                            "The youngest member of a team or group, normally someone whose voice has not yet deepened, talking like a chipmunk."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e9ac905c-c0d6-301e-8569-7657001ad09b",
                                        "entry_id": "0051f8e5-85d2-308a-a356-53493f2f433e",
                                        "glosses": [
                                            "A potato chip."
                                        ],
                                        "tags": [
                                            "New-Zealand"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e6e1d573-7e57-3248-88da-967ce2b27caa",
                                        "entry_id": "0051f8e5-85d2-308a-a356-53493f2f433e",
                                        "glosses": [
                                            "A chiptune."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56eb3074-7078-33e0-bff9-ceaa54d099c1",
                                        "entry_id": "0051f8e5-85d2-308a-a356-53493f2f433e",
                                        "glosses": [
                                            "A chipping sparrow."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fb60b5e-5745-46cd-8a74-5940d224298b",
                                                "sense_id": "56eb3074-7078-33e0-bff9-ceaa54d099c1",
                                                "text": "In due time a nest-full of little chippies appear to be nourished with insectiverous^([sic]) food from a parental beak until fledged and able to look after themselves."
                                            },
                                            {
                                                "example_id": "ef332dbb-5995-438e-b843-562ece2cdfec",
                                                "sense_id": "56eb3074-7078-33e0-bff9-ceaa54d099c1",
                                                "text": "Surely no young chippy was ever so stout and so emphatic as this bird.\nThe funny part of it all is that the starling appears to make the chippies do whatever it pleases."
                                            },
                                            {
                                                "example_id": "0e80bec7-418f-4280-b2ea-1e5f2a84085f",
                                                "sense_id": "56eb3074-7078-33e0-bff9-ceaa54d099c1",
                                                "text": "How early in the season does the chippy appear and where does it spend the winter?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23094b4b-784f-3e88-93ad-5999dc3ac3e7",
                                        "entry_id": "0051f8e5-85d2-308a-a356-53493f2f433e",
                                        "glosses": [
                                            "An occasional drug habit, less than addiction."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chippy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9d125b2-30fa-3e01-8d11-5f4a2164a0f5",
                                        "entry_id": "e9fc0362-52f3-3289-818c-25cab7bdf065",
                                        "glosses": [
                                            "Ill-tempered, disagreeable."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "164fad7e-d18e-44db-9185-4efd7bc5c1ed",
                                                "sense_id": "f9d125b2-30fa-3e01-8d11-5f4a2164a0f5",
                                                "text": "To sit in solemn silence in a dull, dark dock, / In a pestilential prison, with a life-long lock, / Awaiting the sensation of a short, sharp shock, / From a cheap and chippy chopper on a big black block!"
                                            },
                                            {
                                                "example_id": "01eb523d-2c7a-421f-87e6-388679d5419c",
                                                "sense_id": "f9d125b2-30fa-3e01-8d11-5f4a2164a0f5",
                                                "text": "There was something so irksome about Barry Groom that he had a fascination: you longed for him to annoy you again. He was incredibly chippy, was that the thing?—all his longings came out as a kind of disdain for what he longed for."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c044f87a-173c-3fa6-917c-b7a2cc2e86a8",
                                        "entry_id": "e9fc0362-52f3-3289-818c-25cab7bdf065",
                                        "glosses": [
                                            "Involving violence or unfair play."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5e9dbcb-dea8-4084-8d2e-fbcb0ef0e8da",
                                                "sense_id": "c044f87a-173c-3fa6-917c-b7a2cc2e86a8",
                                                "text": "2007, Canadian Interuniversity Sport, cisport.ca,\nThe University of Lethbridge Pronghorns and University of Saskatchewan Huskies battled to a 1-1 draw in a chippy Canada West men’s soccer affair that saw the teams combine for 33 fouls and five yellow cards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4166da14-872e-3332-a3da-7d03de50d075",
                                        "entry_id": "e9fc0362-52f3-3289-818c-25cab7bdf065",
                                        "glosses": [
                                            "Tending to form chips when cut, rather than larger, more usable pieces of wood."
                                        ],
                                        "tags": [
                                            "of wood"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c2fc509-75a3-36ef-88ba-041b9d1a5a79",
                                        "entry_id": "e9fc0362-52f3-3289-818c-25cab7bdf065",
                                        "glosses": [
                                            "As dry as a chip of wood."
