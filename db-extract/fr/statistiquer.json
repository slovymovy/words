                "senses": [
                    {
                        "sense_id": "68705ec5-84dd-30fa-bdf1-bd86a594366b",
                        "entry_id": "775ba932-6589-3bde-b2d1-4058a12f30ee",
                        "glosses": [
                            "Faire des statistiques, présenter sous forme de statistiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a7e203b-4eb8-45db-b098-1876b7b27686",
                                "sense_id": "68705ec5-84dd-30fa-bdf1-bd86a594366b",
                                "text": "Presque à l'issue des élections communales, l'auteur s'est attelé à cette besogne effrayante de statistiquer les résultats électoraux."
                            },
                            {
                                "example_id": "f9f4c2fa-05fe-4baa-a71c-14e9949b741e",
                                "sense_id": "68705ec5-84dd-30fa-bdf1-bd86a594366b",
                                "text": "Les statisticiens doivent certainement être en train de statistiquer là-dessus."
                            },
                            {
                                "example_id": "918303d3-dc84-44c6-918b-7701354d19e6",
                                "sense_id": "68705ec5-84dd-30fa-bdf1-bd86a594366b",
                                "text": "Le moindre cacographe est membre d’une société savante, et ceux qui ne savent rien ou ne peuvent pas écrire comptent les fontaines de Paris, examinent les couleurs des numéros que le préfet impose aux maisons, et se prétendent occupés de statistique ; car la statistique est devenue à la mode, et c’est une position que de statistiquer."
                            }
                        ]
                    }
