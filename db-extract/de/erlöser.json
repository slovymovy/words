                    {
                        "form_id": "e441e6d4-a738-463d-b685-a3d18a7fc8d0",
                        "entry_id": "3a41e82f-6729-3aa2-9212-6e731cd58b54",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Erlöser"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f0573379-d8f0-3a75-9ee8-951e58cc46c9",
                        "entry_id": "3a41e82f-6729-3aa2-9212-6e731cd58b54",
                        "glosses": [
                            "(männliche^☆) Person, die jemanden von etwas befreit/erlöst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "347324c7-2fda-4a4a-ad4a-97ad70489075",
                                "sense_id": "f0573379-d8f0-3a75-9ee8-951e58cc46c9",
                                "text": "Ewald erschien uns als Erlöser."
                            },
                            {
                                "example_id": "9c073a6c-b3d2-49fe-9cdd-f1c79e18f90b",
                                "sense_id": "f0573379-d8f0-3a75-9ee8-951e58cc46c9",
                                "text": "„Es umgab sie wie ein roter Wind und leuchtete hinter ihr wie ein riesiger mittelalterlicher Komet, der einen Weltuntergang ankündigt oder die Geburt eines späten Erlösers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "975106f8-2dc2-353f-9a92-0cd14bdf3e41",
                        "entry_id": "3a41e82f-6729-3aa2-9212-6e731cd58b54",
                        "glosses": [
                            "Jesus Christus als Messias und Sohn Gottes, der die Menschen von allem Negativen befreien soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de99b81c-27df-403b-818e-c8aecb8962e7",
                                "sense_id": "975106f8-2dc2-353f-9a92-0cd14bdf3e41",
                                "text": "„Schon zweihundert Jahre vor Christi Geburt hatten andere Propheten verkündet, der versprochene Messias werde der Erlöser der ganzen Welt sein.“"
                            },
                            {
                                "example_id": "256616f0-1dad-4319-b6bf-d0ddef410572",
                                "sense_id": "975106f8-2dc2-353f-9a92-0cd14bdf3e41",
                                "text": "„Jemandem, der alles vergöttlicht, konnte diese Statue sehr leicht als Abbild unseres Erlösers erscheinen, denn der Bildhauer hatte den Kopf mit einer Art Heiligenschein umgeben, mit dem die Bildhauer und Maler die Heiligen darstellen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc9bb352-0668-4289-abeb-6851db5edf60",
                        "source_entry_id": "3a41e82f-6729-3aa2-9212-6e731cd58b54",
                        "source_sense_id": "f0573379-d8f0-3a75-9ee8-951e58cc46c9",
                        "source_sense_description": "männliche Person, die jemanden von etwas befreit/erlöst",
                        "target_lang_word": "redeemer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "redeemer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1f5fc87-f990-349d-a13b-0135abcbd552",
                                        "entry_id": "efdf475f-b72b-3251-8b09-ffd2717593a9",
                                        "glosses": [
                                            "One who redeems; one who provides redemption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4bfe3c6-3486-450b-88df-3fc9517fc555",
                                                "sense_id": "c1f5fc87-f990-349d-a13b-0135abcbd552",
                                                "text": "However there is little doubt that Virgil did - in that very sad age of the world, an age of \"misery and massacre,\" and in common with thousands of others - look for the coming of a great 'redeemer.'"
                                            },
                                            {
                                                "example_id": "aa91576c-75c6-49aa-8b9a-5b22d5c10008",
                                                "sense_id": "c1f5fc87-f990-349d-a13b-0135abcbd552",
                                                "text": "But these seekers, too, are saved - by virtue of the inherited symbolic aids of society, the rites of passage, the grace-yielding sacraments, given to mankind of old by the redeemers and handed down through millenniums."
                                            },
                                            {
                                                "example_id": "72bc3094-253f-469c-bc47-e234b3255da0",
                                                "sense_id": "c1f5fc87-f990-349d-a13b-0135abcbd552",
                                                "text": "With no experience in management, little knowledge of life in Scottish football, a dressing room to gut and replace, Gerrard is now cast in the role of Rangers' great redeemer. Whatever fate befalls him, this will not be dull."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02ffb6df-b83a-492f-96ba-336baa9b4c79",
                        "source_entry_id": "3a41e82f-6729-3aa2-9212-6e731cd58b54",
                        "source_sense_id": "f0573379-d8f0-3a75-9ee8-951e58cc46c9",
