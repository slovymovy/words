        "nl-extract.jsonl": [
            {
                "entry_id": "7fb3c817-66f9-3aa9-98d3-061adbc10156",
                "word": "patriciër",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ac09ede4-8c65-42af-a3e5-ef1d1ee9b8b3",
                        "entry_id": "7fb3c817-66f9-3aa9-98d3-061adbc10156",
                        "tags": [
                            "plural"
                        ],
                        "form": "patriciërs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "95bd4230-95df-3d27-a4d8-6614e7816c53",
                        "entry_id": "7fb3c817-66f9-3aa9-98d3-061adbc10156",
                        "glosses": [
                            "aanzienlijk persoon, burger, rijke koopman, regent, hoewel het niet om een adellijk persoon gaat is de persoon wel meestal afkomstig uit bepaalde families"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "253c1e10-065c-4b9b-9aba-bc1748f382d3",
                                "sense_id": "95bd4230-95df-3d27-a4d8-6614e7816c53",
                                "text": "‘Hij gedraagt zich als een patriciër die zichzelf presenteert als een tribuun, aanhanger van een ongegeneerd populisme.’ ‘Hij heeft minder charisma dan wijlen John Kennedy en minder principes dan oud-premier Pierre Mendès France.’"
                            },
                            {
                                "example_id": "1b4f44bb-cc5d-4387-ba96-b2d451071bae",
                                "sense_id": "95bd4230-95df-3d27-a4d8-6614e7816c53",
                                "text": "De autobiografie is een uiteraard subjectieve maar volledig waarheidsgetrouwe en op naspeurbare feiten gebaseerde beschrijving van het leven van de onechte zoon van een Venetiaanse actrice en waarschijnlijk een patriciër, die ondanks zijn wat obscure afkomst dankzij zijn intelligentie, lef, nieuwsgierigheid, uiterlijk en aanpassingsvermogen in contact kwam met hertogen, koningen, keizerinnen en pausen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e9e40a0a-be43-42fa-b4c4-91f94312fbe0",
                        "source_entry_id": "7fb3c817-66f9-3aa9-98d3-061adbc10156",
                        "source_sense_id": "95bd4230-95df-3d27-a4d8-6614e7816c53",
                        "source_sense_description": "aanzienlijk persoon, burger, rijke koopman, regent, ...",
                        "target_lang_word": "patrician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patrician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36deb2e9-0db2-374e-862e-b3a54284b907",
                                        "entry_id": "e8a0fa85-5c9e-3d92-a170-c47849ccfc21",
                                        "glosses": [
                                            "A member of any of the families constituting the populus Romanus, or body of Roman citizens, before the development of the plebeian order; later, one who, by right of birth or by special privilege conferred, belonged to the senior class of Romans, who, with certain property, had by right a seat in the Roman Senate."
                                        ],
                                        "tags": [
                                            "Ancient-Rome"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "246e593a-1f80-49fc-b742-43bd5bf3d004",
                                                "sense_id": "36deb2e9-0db2-374e-862e-b3a54284b907",
                                                "text": "Noble Patricians, Patrons of my right, / Defend the iuſtice of my Cauſe with Armes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cfd8379-0e29-3c79-84b0-39f8d8c5e39a",
                                        "entry_id": "e8a0fa85-5c9e-3d92-a170-c47849ccfc21",
                                        "glosses": [
                                            "A person of high birth; a nobleman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5057f7d5-c605-368e-a702-7b9cf3a88eb1",
                                        "entry_id": "e8a0fa85-5c9e-3d92-a170-c47849ccfc21",
                                        "glosses": [
                                            "One familiar with the works of the Christian Fathers; one versed in patristic lore or life."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "patrician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ca43aca-a7a2-3eec-bb61-9ee28dbcaff0",
                                        "entry_id": "ce170f4e-e044-37bb-b0a4-b2bb317c50a4",
                                        "glosses": [
                                            "Of or pertaining to the Roman patres (“fathers”) or senators, or patricians."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a909348-6fba-4b7b-804b-e8c7305643ee",
                                                "sense_id": "6ca43aca-a7a2-3eec-bb61-9ee28dbcaff0",
                                                "text": "[…] I ſee\nTh’ Inſulting Tyrant prancing o’er the Field\nStrow’d with Rome’s Citizens, and drench’d in Slaughter,\nHis Horſe’s Hoofs wet with Patrician Blood."
                                            },
                                            {
                                                "example_id": "64bacf9f-0ff1-4834-90d9-0d776af08feb",
                                                "sense_id": "6ca43aca-a7a2-3eec-bb61-9ee28dbcaff0",
                                                "text": "The cognomen was first used in patrician families, who were distinguished from the plebeians by their three names."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6a6fef0-3c40-364e-8729-b7535f7cab67",
                                        "entry_id": "ce170f4e-e044-37bb-b0a4-b2bb317c50a4",
                                        "glosses": [
                                            "Of or pertaining to a person of high birth; noble; not plebeian; aristocratic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff34af2a-1e0e-4cc8-b1a4-64f9e56ce835",
                                                "sense_id": "c6a6fef0-3c40-364e-8729-b7535f7cab67",
                                                "text": "born in the patrician file of society"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02ee923-2033-312a-aae5-28ce03161116",
                                        "entry_id": "ce170f4e-e044-37bb-b0a4-b2bb317c50a4",
                                        "glosses": [
                                            "Characteristic of or appropriate to a person of high birth; classy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c249cfba-bd1b-49b4-b6b1-27e721abe7f7",
                                                "sense_id": "e02ee923-2033-312a-aae5-28ce03161116",
                                                "text": "Hanks' taste in projects and directors is undoubtedly patrician and with a few exceptions like 1993's Philadelphia, the first mainstream film about the Aids crisis, rarely provocative"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4807efa6-5be5-31c5-9792-11f7febece3f",
                                        "entry_id": "ce170f4e-e044-37bb-b0a4-b2bb317c50a4",
                                        "glosses": [
                                            "Politically active to help people in lower classes, especially in a patronizing or condescending way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b199f786-7274-454e-9bcd-ac3d4f217afe",
                                                "sense_id": "4807efa6-5be5-31c5-9792-11f7febece3f",
                                                "text": "It will speed the shrivelling of the patrician “one nation” Tories, who tried to curb the extremes of Thatcherism and ended by providing its veils."
                                            },
                                            {
                                                "example_id": "9c5ac34c-1c26-4870-8aac-05277c414177",
                                                "sense_id": "4807efa6-5be5-31c5-9792-11f7febece3f",
                                                "text": "Saint-Simon was certainly a radical, and hostile to inherited privilege, but his bourgeois 'socialism' was of a patrician kind. Science, being a firm and certain kind of knowledge, a 'religion of Newton' or 'cult of Reason' essentially plays the key role in his grand scheme for social engineering."
                                            },
                                            {
                                                "example_id": "141befb6-cf09-4545-91ae-d4c9c968266a",
                                                "sense_id": "4807efa6-5be5-31c5-9792-11f7febece3f",
                                                "text": "Where Ruskin's patrician socialism sought to create better conditions and 'higher' aspirations for the 'Workmen and Labourers of Great Britain', Sickert painted his working- and lower-middle-class subjects as if history, in the advance of mass culture and popular democracy, were on their side."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca2dd44c-5d22-4d69-8ec7-62fd8a80d1ab",
                        "source_entry_id": "7fb3c817-66f9-3aa9-98d3-061adbc10156",
                        "source_sense_id": "95bd4230-95df-3d27-a4d8-6614e7816c53",
                        "source_sense_description": "aanzienlijk persoon, burger, rijke koopman, regent, ...",
                        "target_lang_word": "patricien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patricien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1826d281-6f3b-3639-ab24-e16ef39cf296",
                                        "entry_id": "97e81732-f5ee-3b21-8296-4021a1db2edb",
                                        "glosses": [
                                            "Relatif à la noblesse romaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3435d4a6-68a8-48db-ab9e-2c34dcb46efd",
                                                "sense_id": "1826d281-6f3b-3639-ab24-e16ef39cf296",
                                                "text": "Peu à peu, le despote ne respectant plus les prétendus droits de ses covainqueurs , ceux-ci se révolteront, le chasseront et proclameront le despotisme collectif, c'est-à-dire une république patricienne, dans laquelle quelques familles gouverneront."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21183aa5-b37a-30a5-80cc-9fd8101a3c24",
                                        "entry_id": "97e81732-f5ee-3b21-8296-4021a1db2edb",
                                        "glosses": [
                                            "Noble, aristocratique, quelle que soit la culture ou l’époque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4473abe-d9a4-4d8c-b6b0-1439fd78df00",
                                                "sense_id": "21183aa5-b37a-30a5-80cc-9fd8101a3c24",
                                                "text": "Le ressentiment de l’orgueil patricien a fait peser sur sa mort comme sur sa vie un implacable silence."
                                            },
                                            {
                                                "example_id": "d28d5ffe-4a58-41f1-9151-f49bc4e269a7",
                                                "sense_id": "21183aa5-b37a-30a5-80cc-9fd8101a3c24",
                                                "text": "familles patriciennes, familles nobles dans certains États modernes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "patricien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1eeb21e2-b2ff-30ae-bb92-1d997430d8b5",
                                        "entry_id": "32e2423c-3115-3f6a-9318-a74e5c36090f",
                                        "glosses": [
                                            "Romain appartenant à un ordre de citoyens que leur naissance distinguait des autres à Rome, et qui furent longtemps seuls admissibles aux grandes magistratures."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "191e0dc3-ad44-4a6d-a227-eb2c94700bf3",
                                                "sense_id": "1eeb21e2-b2ff-30ae-bb92-1d997430d8b5",
                                                "text": "Les patriciens, patricii, étaient, ainsi que le mot l’indique, ceux qui étaient issus d’un pater par les liens de la parenté, en d’autres termes, les membres des gentes."
                                            },
                                            {
                                                "example_id": "61f482e3-90a4-4a3f-9b1f-dfaaffa5e831",
                                                "sense_id": "1eeb21e2-b2ff-30ae-bb92-1d997430d8b5",
                                                "text": "Dans les premiers temps de la république romaine, nul ne pouvait être consul s’il n’était patricien. — Clodius était patricien et se fit plébéien."
                                            },
                                            {
                                                "example_id": "8a011e7b-ef2b-41c3-bb0f-4afaa14240fa",
                                                "sense_id": "1eeb21e2-b2ff-30ae-bb92-1d997430d8b5",
                                                "text": "Les luttes des patriciens et des plébéiens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6cf9cc5-f14e-3c30-8ccb-bdc0c4fdfbb5",
                                        "entry_id": "32e2423c-3115-3f6a-9318-a74e5c36090f",
                                        "glosses": [
                                            "Noble romain ou italien."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bdda2791-f40b-4056-823e-304da0654228",
                                                "sense_id": "d6cf9cc5-f14e-3c30-8ccb-bdc0c4fdfbb5",
                                                "text": "Les patriciens de Sienne, de Bologne."
                                            },
                                            {
                                                "example_id": "21d2a010-c07c-4614-b017-63faa068a4c9",
                                                "sense_id": "d6cf9cc5-f14e-3c30-8ccb-bdc0c4fdfbb5",
                                                "text": "Une patricienne italienne peut ripoliner la façade de son présidentiel époux, et tenter, en vain, de dissimuler sa confondante vulgarité d’activiste, sa vraie nature pointe toujours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bb5798a-41ba-3ba4-a16b-2b7d4ea1083f",
                                        "entry_id": "32e2423c-3115-3f6a-9318-a74e5c36090f",
                                        "glosses": [
                                            "Noble, aristocrate de quelque pays que ce soit."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e6d013e-0152-4c4e-b827-0af3b85004de",
                                                "sense_id": "1bb5798a-41ba-3ba4-a16b-2b7d4ea1083f",
                                                "text": "Les patriciens commencèrent la Révolutions, les plébéiens l’achevèrent."
                                            },
                                            {
                                                "example_id": "18220226-8078-4693-968f-a4809162b5c8",
                                                "sense_id": "1bb5798a-41ba-3ba4-a16b-2b7d4ea1083f",
                                                "text": "Il avait tout l’orgueil d’un patricien."
                                            }
                                        ]
                                    }
                                ]
                            },
