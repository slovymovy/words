                ],
                "translations": [
                    {
                        "translation_id": "771b67df-f3a1-46d8-958e-94088f586ee3",
                        "source_entry_id": "55603777-f191-3934-b520-f62e60f3cbdc",
                        "source_sense_description": "Fainéant",
                        "target_lang_word": "Faulenzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faulenzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "158c104b-27ff-388d-b373-c8a83f67ce89",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "eine faule Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a7f2623-8713-45a3-89d6-ae6469fd9d4a",
                                                "sense_id": "158c104b-27ff-388d-b373-c8a83f67ce89",
                                                "text": "„Will dieser Faulenzer etwa den ganzen Tag im Bett bleiben?“"
                                            },
                                            {
                                                "example_id": "f148d6ce-b2b1-4990-949e-97eb522be881",
                                                "sense_id": "158c104b-27ff-388d-b373-c8a83f67ce89",
                                                "text": "„Dabei war Paris einmal die Stadt der Boheme und der Langschläfer, der großen Denker an Café-Tischen und der Faulenzer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6efab29e-5ec9-326f-ab04-b9f51d46bc95",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Unterlage, um auf unliniertem Blatt gerade schreiben zu können"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6c76b3c-5c6f-4d03-aef1-4ba36c430ac4",
                                                "sense_id": "6efab29e-5ec9-326f-ab04-b9f51d46bc95",
                                                "text": "„V. erklärte, er benötige zur Abfassung des Testamentes Papier und einen »Faulenzer«, worauf Dechant R. noch angab, wo Papier und Faulenzer zu finden seien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "425c4d44-898c-3a9b-a0ea-b50f49bfd1d2",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Leine als Hilfe beim Segelbergen, die vom Mast zum Baum gespannt ist"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0a44abe-82f6-481a-86e2-ac9ac6d3ef40",
                                                "sense_id": "425c4d44-898c-3a9b-a0ea-b50f49bfd1d2",
                                                "text": "Der Faulenzer ist die vom Mast zum Baum gespannte Leine, die verhindern soll, dass ein Segel während des Bergens über Bord geht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0be80a08-2c51-3967-a5fc-e1ad18ff0076",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Übersetzung eines fremdsprachigen Textes"
                                        ],
                                        "tags": [
                                            "Schülersprache ab 1900"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0f1085f9-7272-3024-8564-e8516c9ea509",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Strich über den Buchstaben m und n, der anzeigt, dass dieser Buchstabe als doppelt geschrieben gelten soll"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f2a45d25-ac07-3142-841e-41e2f63eb52b",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Hilfsmittel für Berechnungen, etwa Rechenschieber oder Buch mit Tabellen für Umrechnungen oder für Ähnliches"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "1582b448-be8e-390b-b7be-86f8e9df0208",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Schraube am Hinterrad eines Fahrrads, die das Aufsteigen erleichtert"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "70092dc5-e734-30ee-905b-d3ee00def9e1",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "bequeme Sitzgelegenheit, etwa Lehnstuhl, Couch oder Liegestuhl"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "d065b2cd-0207-3781-b749-d15424d8952d",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Etui, in dem verschiedene Schreibutensilien wie Stifte, Lineal, Radiergummi oder Tintenpatronen ungeordnet aufbewahrt werden"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e7de56-4193-4df3-bca6-644f1df34159",
                                                "sense_id": "d065b2cd-0207-3781-b749-d15424d8952d",
                                                "text": "„Beim Herausgehen aus der Klasse musste sie ohnedies am Platz von Chris vorbei. Der war so ins Gespräch mit Paul vertieft, dass sie den zusammengefalteten Zettel unbemerkt in den Faulenzer stecken konnte, der noch offen auf dem Tisch lag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "22eda61d-0d24-3e24-99ea-efc003118f73",
                                        "entry_id": "dbbdcf32-a847-3aba-98d9-ff10103b7e52",
                                        "glosses": [
                                            "Metallgestell mit Kippfunktion, in das ein Bembel gestellt wird, damit man ihn bequem so weit kippen kann, dass das Einschenken des Inhalts in Gläser mühelos möglich ist"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eeedaa5-595a-4bc9-8647-9c4cb6dbb277",
                                                "sense_id": "22eda61d-0d24-3e24-99ea-efc003118f73",
                                                "text": "„Zum Glück brauchte er nicht nachzubestellen, denn sofort füllte ihm der Schankmeister aus dem Bembel, der im Faulenzer stand, nach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9f1e3543-af3e-4785-871c-c2466ee1d616",
                        "source_entry_id": "55603777-f191-3934-b520-f62e60f3cbdc",
                        "source_sense_description": "Fainéant",
                        "target_lang_word": "Faulpelz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faulpelz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                        "entry_id": "e4b9f6a3-daaf-350b-9687-26414efe40e9",
                                        "glosses": [
                                            "Person, die träge / faul ist und keine Lust hat, zu arbeiten / sich anzustrengen"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc89fdc6-3e7b-4f7c-a2aa-14a43d18b963",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "Unser Sohn ist ein kleiner Faulpelz."
                                            },
                                            {
                                                "example_id": "4df2924b-e556-4746-888b-a0b2cc56fda8",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "„Wenn du weiter so ein Faulpelz bist wirst du die Schule nie schaffen!“"
                                            },
                                            {
                                                "example_id": "1c59cd71-1b4c-4afd-9c74-3cde9294b3ff",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "[André Rauch:] „Als Gymnasiast war ich ein Faulpelz.“"
                                            },
                                            {
                                                "example_id": "031a54ac-ba7c-475e-8651-ee1fd4837b30",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "[André Rauch:] „Wenn Sie mir heute sagen, du bist faul, Sie sind faul, dann sage ich mir, er behandelt mich als Faulpelz, weil ich nicht tue, was er von mir will. Jemand der faul ist, nimmt sich seine Freiheit.“"
                                            },
                                            {
                                                "example_id": "47f31c3f-7c80-4013-97da-bee8321055fb",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "„Ich war nie ein Nationalist“, versicherte er mir glaubhaft, „doch ich lasse es mir nicht gefallen, dass ich als Andalusier zum Faulpelz abgestempelt werde, der sich angeblich den ganzen Tag sonnt und das katalanische Geld versäuft.“"
                                            },
                                            {
                                                "example_id": "88f65ee7-973a-438f-be07-d6462eacbc62",
                                                "sense_id": "dfaf8a66-5105-3c39-8e0a-e5268a29b63c",
                                                "text": "Wer als Salafist auf sich hält, trägt Rauschebart. Wer zu faul zum Rasieren ist, auch. Nur verbinden die meisten mit Rauschebartträgern derzeit eher Islamisten als Faulpelze."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
