                    {
                        "sense_id": "6e7a1809-30ac-37a6-8e70-1e295c9dcfb5",
                        "entry_id": "f54b27ab-4cd4-3919-a1c9-9dd699b634fc",
                        "glosses": [
                            "Stadt in der Süd-Schweiz am Lago Maggiore"
