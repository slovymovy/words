                "senses": [
                    {
                        "sense_id": "ac6239c2-194c-3f82-b4c5-fcdbc413e58e",
                        "entry_id": "2be62198-9ee1-3495-bf5c-a7e642a0e659",
                        "glosses": [
                            "Donner un caractère jaune à, rendre jaune."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff2769fc-ed01-4be0-a3be-d6966a975b51",
                                "sense_id": "ac6239c2-194c-3f82-b4c5-fcdbc413e58e",
                                "text": "Oui j'ai tendance à jauniser la peau mais que veux-tu, asiatitude oblige"
                            },
                            {
                                "example_id": "6bb45e37-ea26-40ab-9624-e6894d2eeded",
                                "sense_id": "ac6239c2-194c-3f82-b4c5-fcdbc413e58e",
                                "text": "Si une image peut être quelque fois améliorée en post traitement, je trouve quand même dommage de toujours vouloir tout corriger : éclaircir, assombrir, jauniser, bleuiser, verdiser et merdiser, afin de faire croire qu'on est un faiseur de chef-d'œuvres."
                            },
                            {
                                "example_id": "1a04f041-5cd8-4079-a820-c71fb9513004",
                                "sense_id": "ac6239c2-194c-3f82-b4c5-fcdbc413e58e",
                                "text": "Et tu vas la \"jauniser\" celle-là?"
                            }
                        ]
                    }
