                ],
                "senses": [
                    {
                        "sense_id": "41435bfe-0b07-3d17-a6ea-4f21a811250d",
                        "entry_id": "709b96f2-85e3-311c-9a2f-388c501a7364",
                        "glosses": [
                            "(traditionell in der griechischen, türkischen, arabischen sowie balkanischen Küche zubereitetes) Auflaufgericht mit den Hauptzutaten Hackfleisch, Kartoffeln und Auberginen beziehungsweise Zucchini"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c30fc97-f9c4-44b4-b263-e516a3e987b9",
                                "sense_id": "41435bfe-0b07-3d17-a6ea-4f21a811250d",
                                "text": "„Es ist immer gut, wenn man sich mit der Frage: ‚Was mache ich damit?‘ direkt an den Verkäufer wendet, auch wenn man Kochbücher mit Rezepten für griechische Dolmas (gefüllte Weinblätter) oder Moussaka (Aubergineneintopf) oder Hammelspieße besitzt.“"
                            },
                            {
                                "example_id": "0cbe472e-e67f-4889-96f4-c9b3a946f414",
                                "sense_id": "41435bfe-0b07-3d17-a6ea-4f21a811250d",
                                "text": "„Nur, da ist nichts außer festgefügter Masse, von der Konsistenz her einer Moussaka gut vergleichbar.“"
                            },
                            {
                                "example_id": "d3a647ec-ae83-43b7-afc2-e1089a3014aa",
                                "sense_id": "41435bfe-0b07-3d17-a6ea-4f21a811250d",
                                "text": "„Besonders beliebt ist das Moussaka der griechischen Küche.“"
                            },
                            {
                                "example_id": "f0973dfb-3d55-4427-899f-8d732bcee8cf",
                                "sense_id": "41435bfe-0b07-3d17-a6ea-4f21a811250d",
                                "text": "„Aber auch die bekannten traditionellen Rezepte kommen zur Geltung: Moussakas, Sarmadakia, Imam, Keftedakia a lá Smyrna u. viele andere haben einen hohen Anteil am kavaliotischen Tisch.“"
                            },
                            {
                                "example_id": "d26055af-51f5-432d-bfb5-9e530780b8d7",
                                "sense_id": "41435bfe-0b07-3d17-a6ea-4f21a811250d",
                                "text": "„Und fährt fort mit der Zubereitung des Moussakas.“"
                            },
                            {
                                "example_id": "80b5f307-a8fa-41f7-a7f0-9d01f3d02581",
                                "sense_id": "41435bfe-0b07-3d17-a6ea-4f21a811250d",
                                "text": "„Vom urdeutschen Hackbraten über Buletten-Variationen aller Art bis hin zu Chili con Carne, Bolognese-Soße und Moussaka findet sich Hackfleisch auf den Speisekarten der Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
