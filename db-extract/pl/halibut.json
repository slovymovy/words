                        "entry_id": "f76e94f6-a22d-3c77-a376-1eb56b1e1fa4",
                        "glosses": [
                            "Hippoglossus hippoglossus, drapieżna ryba morska z rodziny flądrowatych o szerokim otworze gębowym"
