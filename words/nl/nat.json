                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er lag veel <w>nat</w> op de vloer na de lekkage.",
                            "target_lang_translations": {
                                "en": "There was a lot of <w>liquid</w> on the floor after the leak.",
                                "ru": "После протечки на полу было много <w>жидкости</w>.",
                                "pl": "Po wycieku na podłodze było dużo <w>wilgoci</w>.",
                                "de": "Nach dem Leck lag viel <w>Nässe</w> auf dem Boden.",
                                "fr": "Il y avait beaucoup de <w>liquide</w> sur le sol après la fuite.",
                                "it": "C'era molto <w>liquido</w> sul pavimento dopo la perdita.",
                                "cs": "Po úniku vody bylo na podlaze hodně <w>tekutiny</w>.",
                                "tr": "Sızıntıdan sonra yerde çok fazla <w>sıvı</w> vardı.",
                                "es": "Había mucho <w>líquido</w> en el suelo después de la fuga."
                            }
                        },
                        {
                            "text": "De gasten kregen een natje en een droogje, wat betekent dat er drank en eten was.",
                            "target_lang_translations": {
                                "en": "The guests received a <w>drink</w> and a snack, which means there was food and drink.",
                                "ru": "Гостям предложили <w>выпивку</w> и закуску, что означает, что были еда и напитки.",
                                "pl": "Goście dostali <w>coś do picia</w> i przekąskę, co oznacza, że było jedzenie i picie.",
                                "de": "Die Gäste bekamen Speis und <w>Trank</w>, was bedeutet, dass es Essen und Trinken gab.",
                                "fr": "Les invités ont eu de quoi boire et manger, ce qui signifie qu'il y avait de la <w>boisson</w> et de la nourriture.",
                                "it": "Gli ospiti hanno ricevuto da <w>bere</w> e da mangiare, il che significa che c'erano cibo e bevande.",
                                "cs": "Hosté dostali najíst a <w>napít</w>, což znamená, že tam bylo jídlo a pití.",
                                "tr": "Misafirlere yiyecek ve <w>içecek</w> ikram edildi, bu da yiyecek ve içecek bir şeyler olduğu anlamına gelir.",
                                "es": "Los invitados recibieron <w>bebida</w> y comida, lo que significa que había comida y bebida."
                            }
                        }
