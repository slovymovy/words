                ],
                "senses": [
                    {
                        "sense_id": "26952e60-8982-30bd-92b0-d60d4ccfa942",
                        "entry_id": "ba9787c8-fa30-3b4b-9cd9-b92a438a70e8",
                        "glosses": [
                            "To cause to be in love."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "1b27843d-268e-4a56-ad4f-3a5f12c52ddf",
                                "sense_id": "26952e60-8982-30bd-92b0-d60d4ccfa942",
                                "text": "Me-thought I was enamoured of an Asse."
                            },
                            {
                                "example_id": "f3174e44-e1d1-4743-a3b4-014439f6f64c",
                                "sense_id": "26952e60-8982-30bd-92b0-d60d4ccfa942",
                                "text": "By Phœbus, here's a moſt neate fine ſtreete; is't not? I proteſt to thee, I am enamord of this ſtreete now, more then of halfe the ſtreetes of Rome, againe; tis ſo polite, and terſe; [...]"
                            },
                            {
                                "example_id": "528c8115-a6ec-4c11-9146-35e4f1d2408b",
                                "sense_id": "26952e60-8982-30bd-92b0-d60d4ccfa942",
                                "text": "He was offered a chair in the university and a course abroad. But he hesitated. There was a girl of whom he became enamored, so he contemplated marriage and political activity."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a14499a-2639-326a-b1f2-bd65dd3bacc4",
                        "entry_id": "ba9787c8-fa30-3b4b-9cd9-b92a438a70e8",
                        "glosses": [
                            "To captivate."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "81359db6-7481-408b-adb8-345f52280290",
                                "sense_id": "8a14499a-2639-326a-b1f2-bd65dd3bacc4",
                                "text": "Passionately enamoured of this shadow of a dream."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9c669b0-74c9-4c65-ae0c-dc5b74db16ff",
