                "senses": [
                    {
                        "sense_id": "1f796bc2-d22f-388f-b495-c104e1611ca0",
                        "entry_id": "8595fa3d-232b-3577-94a9-bdb1865d1474",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64c37a97-6290-47ac-b25f-bf9d27ea4aba",
                                "sense_id": "1f796bc2-d22f-388f-b495-c104e1611ca0",
                                "text": "Frau Schühle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "99515759-9592-41dd-b7bb-f4a0eedff4ae",
                                "sense_id": "1f796bc2-d22f-388f-b495-c104e1611ca0",
                                "text": "Herr Schühle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e810f894-aa93-42f1-9f80-91eb374e5b2c",
                                "sense_id": "1f796bc2-d22f-388f-b495-c104e1611ca0",
                                "text": "Die Schühles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "bd3ef528-49f8-4cdc-8591-3afb34cc77aa",
                                "sense_id": "1f796bc2-d22f-388f-b495-c104e1611ca0",
                                "text": "Der Schühle trägt nie die Schals, die die Schühle ihm strickt."
                            },
                            {
                                "example_id": "12293bab-9142-499d-9f7c-57051eee99a2",
                                "sense_id": "1f796bc2-d22f-388f-b495-c104e1611ca0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schühle kommt, geht der Herr Schühle.“"
                            },
                            {
                                "example_id": "b14229a2-1bca-47c2-91fa-d3cbe35e5344",
                                "sense_id": "1f796bc2-d22f-388f-b495-c104e1611ca0",
                                "text": "Schühle kommt und geht."
                            },
                            {
                                "example_id": "35572153-69ca-4bc8-b605-fc91eb753014",
                                "sense_id": "1f796bc2-d22f-388f-b495-c104e1611ca0",
                                "text": "Schühles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
