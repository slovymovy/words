                        ],
                        "examples": [
                            {
                                "example_id": "69188e15-ce67-4fec-93d5-288d0fdc7dab",
                                "sense_id": "4ebf569b-6ca5-33e1-afc1-1f14efd6343f",
                                "text": "It has been suggested that Mikel Jollett formed the Airborne Toxic Event driven by a cunning masterplan that involved combining the best bits of the Strokes, Arcade Fire and the Killers, to catapult the band from suburban Los Angeles to global indie-rock domination."
                            },
                            {
                                "example_id": "727683db-23e5-4165-9804-d0b536254ab6",
                                "sense_id": "4ebf569b-6ca5-33e1-afc1-1f14efd6343f",
                                "text": "The rail options in this first phase concentrate on developing major stations. Edinburgh Waverley's masterplan moves forward [...], and Transport Scotland will review capacity at Glasgow Central to find short-term ways of allowing longer and perhaps more frequent trains to run. A masterplan beckons too for Inverness, in line with long-standing local wishes."
                            }
                        ]
                    }
                ],
