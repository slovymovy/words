                        "sense_id": "9f42c5bc-646f-3187-bc9c-8afb1d45343a",
                        "entry_id": "fe4ed018-c578-36ae-814d-68238d017d52",
                        "glosses": [
                            "der Komplex aus Desoxyribonukleinsäure und Proteinen, aus dem die Chromosomen bestehen"
                        ],
                        "tags": [
                            "Genetik",
                            "Zytologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6ed4beb2-d501-4cb1-a421-6b9fb5eedcbe",
                                "sense_id": "9f42c5bc-646f-3187-bc9c-8afb1d45343a",
                                "text": "„Grundbausteine des Chromatins sind feine fädige, etwa 10 nm dicke Stränge, die Nukleotidfilamente oder Chromonemen, die ihrerseits zu eine Überstruktur, der 30-nm-Chromatinfibrille, aufgeknäuelt sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
