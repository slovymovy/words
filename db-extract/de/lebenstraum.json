                "senses": [
                    {
                        "sense_id": "82005b70-312d-3229-b7bf-e94e407c91f0",
                        "entry_id": "3dccc2c2-1bbd-3213-9648-8fb39c6fc2bf",
                        "glosses": [
                            "Wunschvorstellung, die eine Person als einen Höhepunkt in ihrem Leben erfüllt haben möchte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38c8b1d0-4242-492f-b426-0df467b0e1f0",
                                "sense_id": "82005b70-312d-3229-b7bf-e94e407c91f0",
                                "text": "„In der Lübecker Kneipe hat Grass sicher noch eine ganze Weile glückselig seinen erfüllten Lebenstraum gefeiert.“"
                            },
                            {
                                "example_id": "959e0092-d23f-4af1-afa4-5238412d7837",
                                "sense_id": "82005b70-312d-3229-b7bf-e94e407c91f0",
                                "text": "„Zuvor hatte ihr schon der frühe Tod des Vaters einen Lebenstraum genommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
