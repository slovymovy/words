                        "glosses": [
                            "Accuser en retour, en réponse à une accusation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d58204-85e5-485b-a14f-bf7ba0653d2e",
                                "sense_id": "034c480b-49b9-3ac8-a8da-ddb3f37d795f",
                                "text": "Dans ce deuxième cas, le défenseur peut utiliser la norme NA pour contre-accuser l'agresseur qui utilisait la norme NF contre le défendeur ou pour contre-accuser un tiers (par exemple, le juge) ;"
                            },
                            {
                                "example_id": "06124dbf-b90c-4c0f-a363-27f853872d1e",
                                "sense_id": "034c480b-49b9-3ac8-a8da-ddb3f37d795f",
                                "text": "Faut-il contre-accuser, en demandant quel pourcentage régne dans les Facultés de Sciences ou les Instituts — en France comme à l'étranger d'ailleurs — d'attaches avec l'industrie, et cela sans que l'Etat y regagne par le détour d'une chère patente?"
                            }
                        ]
                    }
