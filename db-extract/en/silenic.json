                        "examples": [
                            {
                                "example_id": "e81de10a-6a22-44a1-b74b-8e2f3d9eb34c",
                                "sense_id": "ff5ef9e2-6057-3d23-83bc-eb2aa9ffb7d4",
                                "text": "The juxtaposition of the mask and the silenic face not only invites but also necessitates their complementary interpretation."
                            },
                            {
                                "example_id": "11f80870-9ef5-4ef0-af05-7ae80f1dcca6",
                                "sense_id": "ff5ef9e2-6057-3d23-83bc-eb2aa9ffb7d4",
                                "text": "Like Silenus, the comically monstrous box contained good advice and wisdom, its drunken exterior belying its profound interior. As the tale's initial metaphor, this comparison characterizes the story that follows as one, that, like its Silenic exemplum, appears to be one thing on the outside and another on the inside."
                            }
                        ]
