                "senses": [
                    {
                        "sense_id": "ae62a051-c1f7-301a-b0c8-125bb8992e8e",
                        "entry_id": "94c8bae1-9c9a-3845-a3f3-9bd57e89b763",
                        "glosses": [
                            "Störung der Wahrnehmung äußerer Reize"
