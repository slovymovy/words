                        "sense_id": "07bedb7f-a7a6-3212-9b32-24d896ffc737",
                        "entry_id": "2b7d97bc-1287-3d13-a918-0be4533eff86",
                        "glosses": [
                            "Artisane qui fait les bâts et les harnais des chevaux et des bêtes de somme."
                        ],
                        "tags": [
                            "Métier",
                            "Bourrellerie"
                        ],
                        "examples": [
                            {
                                "example_id": "306dc2cd-7718-41f5-8e2e-430662339b87",
                                "sense_id": "07bedb7f-a7a6-3212-9b32-24d896ffc737",
                                "text": "Sous l’œil de leur professeure, Myriam Vanden Daele, bourrelière professionnelle, ils sont une dizaine à découper, perforer, lisser ou plutôt “abat-carrer” le cuir comme le dit un vrai bourrelier, pour lui donner vie sous forme de harnais, de ceintures ou de selles."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6c4a23c-873c-34c0-8dd5-4bde09e2d5f3",
                        "entry_id": "2b7d97bc-1287-3d13-a918-0be4533eff86",
                        "glosses": [
                            "Épouse d’un bourrelier."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c30eac3e-8c0a-45d9-aec1-7915328c446c",
                                "sense_id": "c6c4a23c-873c-34c0-8dd5-4bde09e2d5f3",
                                "text": "La mère de Charles, la bourrelière, leur avait amené le petit, puisqu’ils voulaient bien se charger de le conduire à l’oncle, chez lequel il devait rester toute la semaine."
                            }
                        ]
                    }
                ],
