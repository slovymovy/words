                "senses": [
                    {
                        "sense_id": "65e4ec46-a168-3b63-9fb2-69db9842f36b",
                        "entry_id": "85f7fec4-cd81-3058-a751-29f95c066469",
                        "glosses": [
                            "joiner's"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9643e39b-d46f-4e86-9ac8-c5cae8965490",
                                "sense_id": "65e4ec46-a168-3b63-9fb2-69db9842f36b",
                                "text": "столя́рная мастерска́я",
                                "translation": "joiner's shop",
                                "english": "joiner's shop"
                            },
                            {
                                "example_id": "f1de0b42-8744-4b79-aca4-9fc25ebcb3c8",
                                "sense_id": "65e4ec46-a168-3b63-9fb2-69db9842f36b",
                                "text": "столя́рное ремесло́; столя́рное де́ло",
                                "translation": "joinery; joiner's work",
                                "english": "joinery; joiner's work"
                            },
                            {
                                "example_id": "13d22e32-9c66-44f6-bfa5-4678f0d16cbe",
                                "sense_id": "65e4ec46-a168-3b63-9fb2-69db9842f36b",
                                "text": "столя́рный верста́к",
                                "translation": "joiner's bench",
                                "english": "joiner's bench"
                            },
                            {
                                "example_id": "cc77cfe9-44a4-47f0-8058-7606f6596c13",
                                "sense_id": "65e4ec46-a168-3b63-9fb2-69db9842f36b",
                                "text": "столя́рный клей",
                                "translation": "joiner's glue",
                                "english": "joiner's glue"
                            },
                            {
                                "example_id": "a7ca8525-994e-436d-b6a5-30d7749c09de",
                                "sense_id": "65e4ec46-a168-3b63-9fb2-69db9842f36b",
                                "text": "столя́рные изде́лия",
                                "translation": "woodwork; finish",
                                "english": "woodwork; finish"
                            },
                            {
                                "example_id": "10506489-cfc8-4691-b2c5-0d87bf1fb55f",
                                "sense_id": "65e4ec46-a168-3b63-9fb2-69db9842f36b",
                                "text": "Днём он продолжа́л занима́ться свои́м столя́рным ремесло́м, кото́рое ему́ доставля́ло де́ньги, ну́жные для его́ содержа́ния, а ве́чером учи́лся ра́зным частя́м матема́тики, меха́ники, архитекту́ре, перспекти́ве, рисова́нию.",
                                "translation": "Vladimir Odoyevsky",
                                "english": "Vladimir Odoyevsky"
                            }
                        ]
