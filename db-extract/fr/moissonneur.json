                "senses": [
                    {
                        "sense_id": "e3b808b6-644c-35a8-9e2a-e7e418649877",
                        "entry_id": "132360df-1a4c-3a2a-ab0c-64e6776de60f",
                        "glosses": [
                            "Celui qui moissonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85812ca3-7731-4dcd-a9df-f7935eb1a954",
                                "sense_id": "e3b808b6-644c-35a8-9e2a-e7e418649877",
                                "text": "Un bon critère pour apprécier le coût d’une moissonneuse McCormick consiste à présenter son prix en nombre de journées de travail d’un moissonneur journalier."
                            },
                            {
                                "example_id": "65dce58b-13b4-4458-87a6-92c244923e90",
                                "sense_id": "e3b808b6-644c-35a8-9e2a-e7e418649877",
                                "text": "Depuis longtemps ont disparu les convois de moissonneurs qui faux en main, remontaient les plaines de Russie du Sud au Nord, récoltant au passage les céréales d’Igor Karénine, ou ceux des Bretons moissonnant dans l’Île-de-France."
                            },
                            {
                                "example_id": "476b97eb-d2e0-455b-b5f6-5b34b8a6bf05",
                                "sense_id": "e3b808b6-644c-35a8-9e2a-e7e418649877",
                                "text": "Donc, Booz dans la nuit dormait parmi les siens ;\nPrès des meules, qu’on eût prises pour des décombres,\nLes moissonneurs couchés faisaient des groupes sombres ;\nEt ceci se passait dans des temps très anciens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f0204ee-991c-4f47-8cf6-03a72790a945",
                        "source_entry_id": "132360df-1a4c-3a2a-ab0c-64e6776de60f",
                        "source_sense_id": "e3b808b6-644c-35a8-9e2a-e7e418649877",
                        "target_lang_word": "Erntearbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erntearbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cdd08338-1060-37c1-a20c-10a064082e59",
                                        "entry_id": "a9961909-9492-311a-a46c-95f266ca02e7",
                                        "glosses": [
                                            "Person, die beim Einsammeln einer Ernte mithilft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c4b37ae-3723-4732-a5e9-a9dd759f637f",
                                                "sense_id": "cdd08338-1060-37c1-a20c-10a064082e59",
                                                "text": "„Den Aufbruchstimmung verbreitenden Methoden der Arbeiterbewegung hatten sie keine überzeugende Alternative entgegenzusetzen. Und so machten sich die Bewohner Tel Avivs die landwirtschaftlichen Ideale der nationalen Erneuerung zu Eigen und schmückten ihre vier Wände mit pseudo-biblischen Szenen — Erntearbeitern, tanzenden Mädchen und Flöte spielenden Schäfern —, alles gemalt auf bunte Fliesen aus Wien.“"
                                            },
                                            {
                                                "example_id": "27a8d837-d288-44ad-8ba5-da8ff8ad7ea1",
                                                "sense_id": "cdd08338-1060-37c1-a20c-10a064082e59",
                                                "text": "„Er stellte Bier her aus den Blättern des Gamander und gab es den Erntearbeitern anstelle von Apfelwein zu trinken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
