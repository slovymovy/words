                                        "entry_id": "9293ef2f-7d74-3d09-861d-cb0f0bb5281a",
                                        "glosses": [
                                            "verdediger van de leer van het christendom in de 2e en 3e eeuw tegen de aanklachten vanwege het paganisme en het jodendom"
                                        ],
                                        "tags": [],
