                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2a87c912-ed3d-40a2-85b2-66c8db2f94cc",
                                "sense_id": "d585d30d-2e59-3c98-9db1-27c565397de2",
                                "text": "Medieval wills often contained bequests to pay for the singing of special (non-perpetual) masses on the testator's behalf. These obits, as they were called, combined alms for the poor with masses for the dead."
