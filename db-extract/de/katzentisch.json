                        ],
                        "form": "die Katzentische"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "52548d38-ac74-33ba-9529-167f693f8eca",
                        "entry_id": "0a0a4a47-60d4-397c-a7c8-5129cf910b6e",
                        "glosses": [
                            "ein Tisch für Kinder oder unwichtige Gäste; im Restaurant ein Tisch, der abseits steht"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "c0f18f52-0511-4976-a2b8-62f446fd53f4",
                                "sense_id": "52548d38-ac74-33ba-9529-167f693f8eca",
                                "text": "Da müssen wir wohl mit dem Katzentisch vorliebnehmen."
                            },
                            {
                                "example_id": "341aa4e8-64d2-4aba-9a03-29e801236f8d",
                                "sense_id": "52548d38-ac74-33ba-9529-167f693f8eca",
                                "text": "„Die Herrschaften wurden an den Tisch plaziert, mich führte der Agafari zu einem Katzentisch, der direkt dahinter aufgebaut war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1667b0bb-75a2-3f1a-a18d-af30b357d7f9",
                        "entry_id": "0a0a4a47-60d4-397c-a7c8-5129cf910b6e",
                        "glosses": [
                            "Ausschluss von jemandem oder etwas, ohne Mitspracherecht"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "2302027c-a356-4184-9cac-0e5bc9ab85a4",
                                "sense_id": "1667b0bb-75a2-3f1a-a18d-af30b357d7f9",
                                "text": "Deutschland scheint […] aktuell von Frankreich an den Katzentisch der transatlantischen Beziehungen verdrängt worden zu sein."
                            },
                            {
                                "example_id": "6868acb7-2d23-4381-b9a8-ac083cbf3b5e",
                                "sense_id": "1667b0bb-75a2-3f1a-a18d-af30b357d7f9",
                                "text": "Kinder- und Jugendbücher sind längst keine Sparte am Katzentisch mehr. Jedes zehnte Buch, das in Deutschland erscheint, ist für junge Leser und Leserinnen geschrieben."
                            },
                            {
                                "example_id": "02a45017-cd7f-4c16-b374-b63b6dcea313",
                                "sense_id": "1667b0bb-75a2-3f1a-a18d-af30b357d7f9",
                                "text": "[SPD-Chef Sigmar Gabriel:] „Es geht [den Leuten um D. Trump] um ein echtes Rollback in die alten schlechten Zeiten, in denen Frauen an den Herd oder ins Bett gehörten, Schwule in den Knast und Gewerkschaften höchstens an den Katzentisch.“"
                            },
                            {
                                "example_id": "fe6cc581-9ae7-4a6f-b179-a70c567c29a3",
                                "sense_id": "1667b0bb-75a2-3f1a-a18d-af30b357d7f9",
                                "text": "Die BRIC-Staaten gehören nach Ansicht Steinmeiers nicht mehr an den Katzentisch, sondern an den Konferenztisch."
                            },
                            {
                                "example_id": "0577732b-cb25-4ca6-a1b7-dab8410381c2",
                                "sense_id": "1667b0bb-75a2-3f1a-a18d-af30b357d7f9",
                                "text": "Die Aufmerksamkeit des Padrone [des Restaurants Al Pino] kann […] sehr variieren, gegenüber großen Runden spendabel aufgelegter Geschäftspartner fühlte man sich als maßvoll tafelndes Trio schnell wie am Katzentisch."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fe29455-68b8-4628-9ebb-56563f25d4e3",
                        "source_entry_id": "0a0a4a47-60d4-397c-a7c8-5129cf910b6e",
                        "source_sense_id": "52548d38-ac74-33ba-9529-167f693f8eca",
                        "source_sense_description": "ein Tisch für Kinder oder unwichtige Gäste; auch: im Restaurant ein Tisch, der abseits steht",
                        "target_lang_word": "side table",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "side table",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17edbc79-0b7e-3c33-851d-24f9563ae455",
                                        "entry_id": "a3ddd346-e8c0-3e22-9193-9147630c0433",
                                        "glosses": [
                                            "A small table intended to be placed beside a larger piece of furniture, such as a bed or sofa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf82df7b-df47-4bbd-b32f-6e55f2e0c09b",
                                                "sense_id": "17edbc79-0b7e-3c33-851d-24f9563ae455",
                                                "text": "Upon the infinitely wise countrywoman’s suggestion, she goose-penned, from the edge of her bed, on a side table with cabriole legs, a love letter and took five minutes to reread it in a languorous but loud voice […]"
                                            },
                                            {
                                                "example_id": "7548047f-a610-4be9-ad24-6965d8cc8717",
                                                "sense_id": "17edbc79-0b7e-3c33-851d-24f9563ae455",
                                                "text": "For his own soiree, Kane went for somewhat more conventional decorations: on a side table, Apothia candles glimmered like fireflies, guarding a taxidermied owl, while masses of delphiniums, hydrangeas, lilacs and old Dutch roses perfumed the air."
                                            },
                                            {
                                                "example_id": "3adec537-a839-4746-9932-56c133c6b58a",
                                                "sense_id": "17edbc79-0b7e-3c33-851d-24f9563ae455",
                                                "text": "Lachlan rose to fetch a coffee pot from the side table and idly Holly wondered how those legs coped with the unroominess of canoes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
