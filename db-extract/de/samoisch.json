                                "target_senses": [
                                    {
                                        "sense_id": "c3de140d-df34-3f99-aed8-457b8c8d67e5",
                                        "entry_id": "ef1851ae-c2a9-314d-ae2f-fc36260ce069",
                                        "glosses": [
                                            "Ayant un rapport, un lien avec les îles Samoa, leurs habitants, leur culture ou leur langue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3edf734c-2d43-44b0-a232-ed8e04b80ac5",
                                                "sense_id": "c3de140d-df34-3f99-aed8-457b8c8d67e5",
                                                "text": "Fiame Naomi Mata'afa, première femme en passe de prendre la tête du gouvernement samoan, a été «investie» lundi première ministre lors d'une cérémonie improvisée dans les jardins du Parlement, après que l'accès du bâtiment lui eut été interdit par le pouvoir sortant, selon un journaliste de l'AFP sur place."
                                            },
                                            {
                                                "example_id": "5b94b132-77af-43e5-83aa-dfe115062c67",
                                                "sense_id": "c3de140d-df34-3f99-aed8-457b8c8d67e5",
                                                "text": "Ce flanker, international samoan (5 sélections), est passé par l’Espagne au sein de l’équipe de Valladolid (2018-2019) avant de rejoindre une province australienne, puis les Natal Sharks de Durban (2022)."
                                            },
                                            {
                                                "example_id": "20e7244f-7c57-48d5-b3f2-5fddf22e7de8",
                                                "sense_id": "c3de140d-df34-3f99-aed8-457b8c8d67e5",
                                                "text": "C’est d’abord le deuxième ligne samoan Iosefa Tekori, 38 ans et véritable leader spirituel du groupe, qui annonce à ses partenaires de vestiaire son intention de prendre sa retraite."
                                            }
                                        ]
                                    }
