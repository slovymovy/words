                "senses": [
                    {
                        "sense_id": "4d3f9b43-3f77-3a2d-856a-0046d0dbf720",
                        "entry_id": "5129189f-26a8-3859-a5b9-002c53c0f4a1",
                        "glosses": [
                            "Geschwindigkeit von Objekten, die sich schneller bewegen, als sich der Schall im gleichen Medium fortpflanzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e984f509-64e1-4f66-9b00-ec3093613d54",
                                "sense_id": "4d3f9b43-3f77-3a2d-856a-0046d0dbf720",
                                "text": "Beim Erreichen der Überschallgeschwindigkeit entsteht eine Druckwelle am Bug des Fahrzeugs, die als ein heftiger Knall wahrgenommen werden kann. Dadurch wurde der Begriff geprägt, die \"Schallmauer\" werde durchbrochen."
                            }
                        ],
                        "sense_index_json": "\"1\""
