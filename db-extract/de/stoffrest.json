                "senses": [
                    {
                        "sense_id": "5beed7ea-7a02-358f-8fbe-e6c34d34fce8",
                        "entry_id": "4b2969bf-adaa-38d5-afb7-4760bb80ffa5",
                        "glosses": [
                            "übrig gebliebener/erhalten gebliebener Teil eines Stückes Stoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08bc6783-cd48-4f25-9078-23fad90251d0",
                                "sense_id": "5beed7ea-7a02-358f-8fbe-e6c34d34fce8",
                                "text": "„Leider haben sich Stoffreste und Lederarbeiten nur in den seltensten Fällen in unserem Boden erhalten.“"
                            },
                            {
                                "example_id": "36aacf93-aa8e-4ec4-9aec-d7a08d943b1c",
                                "sense_id": "5beed7ea-7a02-358f-8fbe-e6c34d34fce8",
                                "text": "„Zu Tante Dagmars Geburtstag fabrizierte Renate aus Stoffresten ein Nadelkissen.“"
                            },
                            {
                                "example_id": "dcfe42e7-28ec-48f2-bbfb-ec41de62a3bc",
                                "sense_id": "5beed7ea-7a02-358f-8fbe-e6c34d34fce8",
                                "text": "„In den Papiermühlen wurden die Stoffreste gesäubert, zerhackt und gewässert, bis ein Faserbrei entstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
