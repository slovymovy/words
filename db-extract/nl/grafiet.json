                                        "sense_id": "8a8eb8f8-ac1a-3bbb-a7e9-bfb56c220918",
                                        "entry_id": "ca98151d-e442-353a-9089-ebf26ff4689e",
                                        "glosses": [
                                            "Graphite-reinforced plastic, a composite plastic made with graphite fibers noted for lightweight strength and stiffness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5909807-b5cc-4472-8e76-5b7988ca8e26",
                                                "sense_id": "8a8eb8f8-ac1a-3bbb-a7e9-bfb56c220918",
                                                "text": "Modern tennis racquets are made of graphite, fibreglass and other man-made materials."
                                            }
                                        ]
