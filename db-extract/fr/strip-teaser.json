                "senses": [
                    {
                        "sense_id": "726407af-81dd-3410-a203-dac0e0aef936",
                        "entry_id": "b1211fef-22f0-370b-a207-f8bd6f77a432",
                        "glosses": [
                            "Variante orthographique de stripteaser."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3a94f502-c067-459e-a81d-bd22a18a1a5e",
                                "sense_id": "726407af-81dd-3410-a203-dac0e0aef936",
                                "text": "Les filles dansent, strip-teasent, embrassent Karla."
                            },
                            {
                                "example_id": "0d4dd011-9b13-41f5-a417-8f08f9bd88e0",
                                "sense_id": "726407af-81dd-3410-a203-dac0e0aef936",
                                "text": "Pourquoi vous croyez que les strip-teaseuses strip-teasent, que l’alcool coule à flots, que ça couche à tout va ?"
                            },
                            {
                                "example_id": "690cbbc8-68bc-4cf6-9562-8ea37ed24fa3",
                                "sense_id": "726407af-81dd-3410-a203-dac0e0aef936",
                                "text": "Ils confusent du sentiment, se foutent à poil pour réussir, se « strip-teasent » pour exister."
                            }
                        ]
                    }
