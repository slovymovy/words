                "senses": [
                    {
                        "sense_id": "e5e3a4ce-b21b-3769-8ece-9e5167e1ab4c",
                        "entry_id": "f6926bfd-a0cd-339a-8f79-7c19ec79ee9e",
                        "glosses": [
                            "der Vorgang sich in eine Fotoaufnahme hineinzudrängen und sie dadurch zu verderben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "784925e9-a4d4-46d9-abb0-18141211ffed",
                                "sense_id": "e5e3a4ce-b21b-3769-8ece-9e5167e1ab4c",
                                "text": "„Die berühmteste Fotobombe ist allerdings die Queen. Die englische Königin stellte sich angeblich ungefragt lächelnd in den Hintergrund, als vor einigen Wochen die australische Hockeyspielerin Jayde Taylor in Glasgow ein Selfie von sich und ihrer Freundin Brooke Peris schießen wollte.“"
                            },
                            {
                                "example_id": "ebcf50c5-45fd-4df8-b4c1-6511742a3cfd",
                                "sense_id": "e5e3a4ce-b21b-3769-8ece-9e5167e1ab4c",
                                "text": "„Ich grinste in die Kamera – zu meiner Mom –, während ein Typ auf dem Gehsteig hinter mir eine Fotobombe machte und die Zunge seitlich aus dem Mund streckte.“"
                            },
                            {
                                "example_id": "9fd646dc-577e-4aee-9673-d07bb49c5f47",
                                "sense_id": "e5e3a4ce-b21b-3769-8ece-9e5167e1ab4c",
                                "text": "„Sein Freund habe ihm gesagt, die Fotobombe sei eine Erinnerung daran, dass Menschen und Schildkröten nebeneinander existieren können.“"
                            },
                            {
                                "example_id": "dafda3bf-65d6-4824-a1c0-edc76581eaa6",
                                "sense_id": "e5e3a4ce-b21b-3769-8ece-9e5167e1ab4c",
                                "text": "„Wer eine gute Fotobombe abliefern will, muss sich etwas einfallen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eda17631-2cf1-4d0f-92b0-e5038e91ef9e",
                        "source_entry_id": "f6926bfd-a0cd-339a-8f79-7c19ec79ee9e",
                        "source_sense_id": "e5e3a4ce-b21b-3769-8ece-9e5167e1ab4c",
                        "source_sense_description": "der Vorgang sich in eine Fotoaufnahme hineinzudrängen und sie dadurch zu verderben",
                        "target_lang_word": "photobomb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photobomb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0265ab9d-37eb-3704-891a-0a4df20387b8",
                                        "entry_id": "d6a0ca0b-93b3-3e8f-ae10-255215e65207",
                                        "glosses": [
                                            "To unexpectedly appear in a photograph, especially so as to ruin the picture."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "086f3300-af79-4eec-9be5-db34d73c01e4",
                                                "sense_id": "0265ab9d-37eb-3704-891a-0a4df20387b8",
                                                "text": "Edmonton Eskimos fans taunt a Calgary Stampeders mascot who photobombed their group photo. [image caption]"
                                            },
                                            {
                                                "example_id": "e2c6fb6b-84b5-4a28-991a-b2f7f516f3a5",
                                                "sense_id": "0265ab9d-37eb-3704-891a-0a4df20387b8",
                                                "text": "Modern Familys Eric Stonestreet snuck into a few snapshots too, photobombing' some of the other celebs and making funny faces."
                                            },
                                            {
                                                "example_id": "44b58b73-e2e6-4eeb-8d58-21a97a5ba271",
                                                "sense_id": "0265ab9d-37eb-3704-891a-0a4df20387b8",
                                                "text": "Or you could just grab a beer from a side street cafe and photobomb the fountain pictures of unsuspecting tourists."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "photobomb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9b0c063-56de-331f-a095-883b8af31d32",
                                        "entry_id": "8e4b8de7-55d0-36e7-8f57-02e8f76021fd",
                                        "glosses": [
                                            "An act of photobombing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fc151e8-b5cf-475a-9d39-9f0b19cb6bc0",
                                                "sense_id": "d9b0c063-56de-331f-a095-883b8af31d32",
                                                "text": "His^([sic]) person who uploaded the video, who appears to be Ellis' father, wrote in his description that the photobomb was not the only surprise welcome they staged that day."
                                            },
                                            {
                                                "example_id": "12f70de4-8b7f-4fc2-9626-dbc6f9b61e91",
                                                "sense_id": "d9b0c063-56de-331f-a095-883b8af31d32",
                                                "text": "Twitter was also filled with comments about the Queen photobomb."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65b2e717-8613-3dd4-b4d6-58c3aaf185cb",
                                        "entry_id": "8e4b8de7-55d0-36e7-8f57-02e8f76021fd",
                                        "glosses": [
                                            "A photo containing someone or something that is photobombing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21202da7-af9f-4e13-8c75-53857d7a2404",
                                                "sense_id": "65b2e717-8613-3dd4-b4d6-58c3aaf185cb",
                                                "text": "Athletes are celebrated just for competing. Russian gymnast Anna Pavlova, who recorded an imperfect 0.00 for one of her vault attempts, could try to land a photobomb of herself mugging in the background of all those photos that will be taken of Phelps lugging around his gold."
                                            },
                                            {
                                                "example_id": "c64e8bab-c785-4c4c-8004-8e1223497b3f",
                                                "sense_id": "65b2e717-8613-3dd4-b4d6-58c3aaf185cb",
                                                "text": "Today, the photo can be labelled a photobomb, which implies a narrative of surreptitious sabotage, connects the stingray to a whole tribe of obnoxious pranksters, and makes the ray look like his smile might contain a hint of frat-boyish dissolution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
