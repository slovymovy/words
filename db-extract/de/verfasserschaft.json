                            {
                                "example_id": "7c96a77e-da61-44fd-a16e-e5a9877d98e6",
                                "sense_id": "004ce1bf-d56c-3a61-82d6-eac6a14f08f6",
                                "text": "„Den Beweis für seine Verfasserschaft erblickte der Berichterstatter darin, daß sein Schlafzimmer mit großen Gemälden nach öbszönen Szenen der ›Justine‹ behängt war.“"
                            },
                            {
                                "example_id": "383d03b3-3787-42f7-a7bb-5d12c1c19524",
                                "sense_id": "004ce1bf-d56c-3a61-82d6-eac6a14f08f6",
                                "text": "„Dazu muss es erst ein Habitus gewordenes Verständnis von Verfasserschaft geben, und das ist erst im Werden.“"
                            }
                        ],
