                            {
                                "example_id": "afa020b1-f5c3-4ebc-8b3a-a83eeb1228a8",
                                "sense_id": "ba2342f5-ba7e-3888-abcf-b609704df4c6",
                                "text": "Korpschef Akerboom van de politie pleitte gisteren voor het houden van grote gezamenlijke evenementen en een verbod op gevaarlijk consumentenvuurwerk:"
                            },
                            {
                                "example_id": "c85a0ba4-ed4a-410e-a16d-6a99971dfc68",
                                "sense_id": "ba2342f5-ba7e-3888-abcf-b609704df4c6",
                                "text": "De vuurwerkbranche is tegen een verbod op consumentenvuurwerk. De Belangenvereniging Pyrotechniek Nederland (BPN) vindt dat niet al het vuurwerk over één kam geschoren moet worden. Legaal consumentenvuurwerk is niet hetzelfde illegaal vuurwerk als cobra's en nitraten. Woordvoerder Marcel Teunissen: \"Dat is vuurwerk voor professionals. Mensen denken ten onrechte dat ze er wel mee om kunnen gaan. Dat is gevaarlijk\"."
                            }
                        ]
