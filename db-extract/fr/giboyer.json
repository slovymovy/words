                "senses": [
                    {
                        "sense_id": "944f10e8-31a4-3349-bd62-37e07f230f65",
                        "entry_id": "1c1cdc1f-97a9-3eb0-a898-d9a709d7ffbf",
                        "glosses": [
                            "Chasser, prendre du gibier."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9c70f0ab-2ef0-4f4f-a5c5-16183dba1ace",
                                "sense_id": "944f10e8-31a4-3349-bd62-37e07f230f65",
                                "text": "Là-bas, dans le comté de Curry, les aut’ gars, pour ainsi dire que je les tuais quand on giboyait l’ours."
                            },
                            {
                                "example_id": "3a675494-07f6-4b69-82f6-197358906930",
                                "sense_id": "944f10e8-31a4-3349-bd62-37e07f230f65",
                                "text": "Le roi des animaux se mit un jour en tête\n De giboyer. Il célébrait sa fête.\n Le gibier du lion, ce ne sont pas moineaux,\n Mais bons et beaux sangliers, daims et cerfs bons et beaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d5aca3b5-b7bc-4c7d-9ad1-952eba49daa4",
                        "source_entry_id": "1c1cdc1f-97a9-3eb0-a898-d9a709d7ffbf",
                        "source_sense_id": "944f10e8-31a4-3349-bd62-37e07f230f65",
                        "target_lang_word": "pirschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pirschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a60ff7a6-2e1c-3f50-90c4-f36a55677846",
                                        "entry_id": "fec42c2d-8b2c-3f2d-8a72-ba4894ff848b",
                                        "glosses": [
                                            "schleichen, sich auf dem Weg zu einem gejagten Tier möglichst geräuschlos vorwärtsbewegen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5bcea4c-0bf2-4326-bfc8-7fabcd3bd52f",
                                                "sense_id": "a60ff7a6-2e1c-3f50-90c4-f36a55677846",
                                                "text": "„Wir pirschten vorsichtig auf allen Vieren vorwärts und erkannten, ca. 60m vor uns, eine nicht führende Geiß, also eine Schmalgeiß.“"
                                            },
                                            {
                                                "example_id": "5c282ef1-ebad-499f-9d57-0084aaf53b49",
                                                "sense_id": "a60ff7a6-2e1c-3f50-90c4-f36a55677846",
                                                "text": "„Das Ganze ist Glückssache und dem Pirschen auf Rothwild in einem fremden Walde nicht unähnlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "88997db8-4ec9-36fa-8ce8-3ed4a871d122",
                                        "entry_id": "fec42c2d-8b2c-3f2d-8a72-ba4894ff848b",
                                        "glosses": [
                                            "sich heimlich und möglichst geräuschlos bewegen"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9519f7fc-ce4e-47e7-9270-2f1f7c67cd87",
                                                "sense_id": "88997db8-4ec9-36fa-8ce8-3ed4a871d122",
                                                "text": "Er pirschte mit entsicherter Waffe näher an den Wagen."
                                            },
                                            {
                                                "example_id": "471c3c21-d10d-434d-95ef-b17f3aa56795",
                                                "sense_id": "88997db8-4ec9-36fa-8ce8-3ed4a871d122",
                                                "text": "In aller Frühe pirscht sie sich heimlich aus dem Hotel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
