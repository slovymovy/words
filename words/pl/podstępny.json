                    "frequency": "Middle",
                    "semantic_group_id": "dzialanie_zjawisko",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarz wyjaśnił, że ta infekcja to bardzo <w>podstępna</w> choroba bez wczesnych objawów.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что эта инфекция — очень <w>коварная</w> болезнь без ранних симптомов."
                            }
                        },
                        {
                            "text": "Przeciwnik przygotował <w>podstępny</w> plan, aby przejąć kontrolę nad firmą.",
                            "target_lang_translations": {
                                "ru": "Противник подготовил <w>коварный</w> план, чтобы захватить контроль над компанией."
                            }
                        }
