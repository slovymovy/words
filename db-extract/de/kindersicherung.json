                ],
                "senses": [
                    {
                        "sense_id": "04918397-ed94-339e-91a2-333d0d57861c",
                        "entry_id": "9b95f1d7-284e-36b6-863e-8d355ec4b1f3",
                        "glosses": [
                            "Vorrichtung in Autos oder an Gegenständen, um Kinder vor Gefahren zu schützen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95b5b7f9-5dab-4f2a-8fcc-f7f2e52b9b82",
                                "sense_id": "04918397-ed94-339e-91a2-333d0d57861c",
                                "text": "„Runddeckelbehälter sind eigentlich nur in 770 l und 1100 l erhältlich und müssen seit einigen Jahren mit einer Kindersicherung versehen werden, die das unbeabsichtigte Zuschieben verhindern soll.“"
                            },
                            {
                                "example_id": "9f14cea7-7543-4911-8631-0ddf34f00c4e",
                                "sense_id": "04918397-ed94-339e-91a2-333d0d57861c",
                                "text": "„Zur Serienausstattung gehören sieben Airbags, ESP, Tagfahrlicht, elektrisch einstell- und beheizbare Außenspiegel, eine elektrische Feststellbremse, ein Berganfahrassistent sowie eine Kindersicherung und elektrische Fensterheber.“"
                            },
                            {
                                "example_id": "f1e2e292-730e-4f2f-8137-6d433f4aea49",
                                "sense_id": "04918397-ed94-339e-91a2-333d0d57861c",
                                "text": "„Die Eltern, so seine Diagnose, hätten die Kugel im Gewehrlauf übersehen, zudem habe offenbar die Kindersicherung versagt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
