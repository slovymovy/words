                    {
                        "translation_id": "a6ce0a11-5817-44b8-a026-951e578ff0fa",
                        "source_entry_id": "2de7a980-cb1d-3a76-b47c-69dfd8a953d7",
                        "source_sense_description": "Fratercula arctica",
                        "target_lang_word": "macareux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
