                                "example_id": "2602b859-21cb-4947-ade7-23b3df4ec457",
                                "sense_id": "d481acb2-493e-3528-af77-800e1a769ac8",
                                "text": "Io jest pokryty wulkanami, z których wiele jest obecnie aktywnych"
                            },
                            {
                                "example_id": "03a2a803-f67f-49cd-857f-bc5ef26e4556",
                                "sense_id": "d481acb2-493e-3528-af77-800e1a769ac8",
                                "text": "Cztery największe księżyce Jowisza (Kallisto, Europa, Ganimedes, Io) to tzw. księżyce galileuszowe, odkryte przez Galileusza."
                            },
                            {
                                "example_id": "a9fe101d-daf1-47b3-b633-fa8e0909d9ed",
                                "sense_id": "d481acb2-493e-3528-af77-800e1a769ac8",
                                "text": "Io jest wielokrotnie wspominana w literaturze i filmach science fiction oraz w grach komputerowych"
                            },
                            {
                                "example_id": "810bfa2a-ff8e-4b2f-8dec-0f57c3e681ef",
                                "sense_id": "d481acb2-493e-3528-af77-800e1a769ac8",
                                "text": "Na Io występują zorze polarne"
                            }
                        ],
                        "sense_index_json": "\"3.1\""
