                                        "sense_id": "d49fcfbf-00b0-34f2-9213-da930fd0a763",
                                        "entry_id": "7a83f89b-7790-3025-8b0e-84e12e9f5332",
                                        "glosses": [
                                            "An evaporite mineral made of anhydrous calcium sulfate."
                                        ],
