                "senses": [
                    {
                        "sense_id": "6e739fd8-78e7-3ac5-9a03-8d9492c4cebd",
                        "entry_id": "e1720f26-27bc-3d47-bdae-c01b585cab06",
                        "glosses": [
                            "Flugzeug, das dem Transport von Material und Gütern dient"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "2e644f1a-f68b-4863-897e-8b8c7c700247",
                                "sense_id": "6e739fd8-78e7-3ac5-9a03-8d9492c4cebd",
                                "text": "[COVID-19-Pandemie:] „Als der weltweite Flugverkehr zum Erliegen kam, charterte das WFP zahlreiche Transportflugzeuge und wurde zeitweise zur weltgrößten Fluggesellschaft.“"
                            },
                            {
                                "example_id": "4a076f60-ecdc-4406-b475-644cbca7eb63",
                                "sense_id": "6e739fd8-78e7-3ac5-9a03-8d9492c4cebd",
                                "text": "[Antarktis:] „Ein- bis zweimal wöchentlich fliegt zwischen Mitte November und Anfang März eine vierstrahliges russisches Transportflugzeug des Typs Iljuschin Il-76 in gut fünf Stunden die 4200 Kilometer zur Eispiste der Novo Airbase in unmittelbarer Nähe der russischen Station Novolazarevskaya.“"
                            },
                            {
                                "example_id": "387bd90c-7b2f-4cfa-b6db-c8a3a4f47884",
                                "sense_id": "6e739fd8-78e7-3ac5-9a03-8d9492c4cebd",
                                "text": "„Am Donnerstagabend sind von Hohn in Schleswig-Holstein zwei Transportflugzeuge vom Typ Transall C-160 in Richtung Mali gestartet.“"
                            },
                            {
                                "example_id": "2e6f46fe-8c01-4fb0-93d1-46b8d6c5f910",
                                "sense_id": "6e739fd8-78e7-3ac5-9a03-8d9492c4cebd",
                                "text": "„22. Feb. 1947 – In Tschungking stürzt ein zweimotoriges Transportflugzeug der chinesischen Luftwaffe ab. Dabei kommen alle 21 Insassen ums Leben.“"
                            },
                            {
                                "example_id": "89af65db-dbf4-424a-bfa8-c1acfe5c10c0",
                                "sense_id": "6e739fd8-78e7-3ac5-9a03-8d9492c4cebd",
                                "text": "„Ein Transportflugzeug ist auf der indonesischen Insel Sumatra kurz nach dem Start abgestürzt und in Flammen aufgegangen. Offenbar kamen dabei mindestens 72 Menschen ums Leben.“"
                            },
                            {
                                "example_id": "2e583372-348a-471e-bfc6-db0ec1be379d",
                                "sense_id": "6e739fd8-78e7-3ac5-9a03-8d9492c4cebd",
                                "text": "„13. Sep.1997 – Windhuk: 33 Menschen sterben bei der Kollision eines Bundeswehr-Jets mit einem Transportflugzeug der US-Luftwaffe vor Westafrika.“"
                            },
                            {
                                "example_id": "1f80abf6-d8ea-4e23-a5ee-6362a368b85a",
                                "sense_id": "6e739fd8-78e7-3ac5-9a03-8d9492c4cebd",
                                "text": "„6. Feb. 1993 – Ein deutsches Transportflugzeug mit für Sarajewo bestimmten Hilfsgütern an Bord wird über Kroatien beschossen und schwer beschädigt. Ein Soldat wird verletzt.“"
                            },
                            {
                                "example_id": "79f17b79-0583-4b3f-85aa-3757266f9b01",
                                "sense_id": "6e739fd8-78e7-3ac5-9a03-8d9492c4cebd",
                                "text": "„Douglas C-47 – […] Das Transportflugzeug bestach […] durch Zuverlässigkeit und Robustheit.“"
                            },
                            {
                                "example_id": "53fbf739-d025-4326-90dc-b8495f2897c8",
                                "sense_id": "6e739fd8-78e7-3ac5-9a03-8d9492c4cebd",
                                "text": "„Wegen Problemen mit dem Propellersystem verweigert die Bundeswehr vorerst die Abnahme von zwei weiteren Transportflugzeugen des Typs A400M.“"
                            },
                            {
                                "example_id": "cfb5e0ab-7c98-45c3-98ea-ba634d89920a",
                                "sense_id": "6e739fd8-78e7-3ac5-9a03-8d9492c4cebd",
                                "text": "„Immerhin kaufte Russland bis 2015 acht Transportflugzeuge An-140 und sollte in den darauffolgenden fünf Jahren noch 20 An-140 dazu kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
