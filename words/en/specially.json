                                "ru": "Поезд ждет <w>специально</w> высокопоставленного дипломата.",
                                "nl": "De trein wacht <w>speciaal</w> op een hooggeplaatste diplomaat.",
                                "pl": "Pociąg czeka <w>specjalnie</w> na dyplomatę wysokiej rangi.",
                                "de": "Der Zug wartet <w>speziell</w> auf einen hochrangigen Diplomaten.",
                                "fr": "Le train attend <w>spécialement</w> un diplomate de haut rang.",
                                "it": "Il treno sta aspettando <w>appositamente</w> un diplomatico di alto rango.",
                                "cs": "Vlak čeká <w>speciálně</w> na vysoce postaveného diplomata.",
                                "tr": "Tren, üst düzey bir diplomat için <w>özel olarak</w> bekliyor.",
                                "es": "El tren está esperando <w>específicamente</w> a un diplomático de alto rango.",
                                "zh": "这列火车正在<w>特地</w>等候一位高级外交官。"
                            }
                        }
