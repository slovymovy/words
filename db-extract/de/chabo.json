                "senses": [
                    {
                        "sense_id": "6373912e-9fc7-301d-8a7a-c096ad6b303e",
                        "entry_id": "92f8c420-8fca-3e76-af42-77451f4dec72",
                        "glosses": [
                            "boy; guy; bloke"
                        ],
                        "tags": [
                            "masculine",
                            "regional",
                            "slang",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "ba3af8d2-721d-4831-b195-8883dacc2cb6",
                                "sense_id": "6373912e-9fc7-301d-8a7a-c096ad6b303e",
                                "text": "Chabo check's, kein Gewinn, nimm es hin"
                            },
                            {
                                "example_id": "1b950b98-5b4f-4120-9184-e86b2f8901e0",
                                "sense_id": "6373912e-9fc7-301d-8a7a-c096ad6b303e",
                                "text": "Chabos wissen wer der Babo ist",
                                "translation": "Boys know who the boss is",
                                "english": "Boys know who the boss is"
                            },
                            {
                                "example_id": "a81780f4-5e88-4c11-89e3-d33cded833b9",
                                "sense_id": "6373912e-9fc7-301d-8a7a-c096ad6b303e",
                                "text": "Du starrst misch an, Aldä, und du guckst gefährlisch, abbä sadoma ährlisch, seh isch aus als wär isch en Chabo der Angst hat vorn Chabo der böse guckt?",
                                "translation": "You're staring at me, mate, and you're looking threateningly, but tell me honestly, do I look like I'd be a guy who'd be scared of a guy who looks at me menacingly?",
                                "english": "You're staring at me, mate, and you're looking threateningly, but tell me honestly, do I look like I'd be a guy who'd be scared of a guy who looks at me menacingly?"
                            }
                        ]
                    }
