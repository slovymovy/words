                    {
                        "form_id": "c00e7e45-3f18-4d1d-b59d-8a106dd687b5",
                        "entry_id": "f58c7841-e55f-3a9e-a9df-d7db90696371",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Exaktheit"
                    },
                    {
                        "form_id": "4d1747cf-8ea0-4acc-b14e-0bc832b0c157",
                        "entry_id": "f58c7841-e55f-3a9e-a9df-d7db90696371",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Exaktheit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                        "entry_id": "f58c7841-e55f-3a9e-a9df-d7db90696371",
                        "glosses": [
                            "(meist angestrebte) weitgehende Vollständigkeit und Fehlerfreiheit einer Ausführung, Wiedergabe oder Herstellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53b9087b-f8fd-413a-9acb-3aee8785c712",
                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                "text": "Bei der Deckenbemalung des Ballsaales in unserem Schloss hat Oliver mit größter Exaktheit gearbeitet."
                            },
                            {
                                "example_id": "09e7849c-8e05-456f-aa5d-9a00445affcf",
                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                "text": "Streng genommen kann in den Fällen einer nicht idealen Exaktheit überhaupt nicht von Exaktheit schlechthin, sondern nur von mehr oder weniger großer Exaktheit gesprochen werden."
                            },
                            {
                                "example_id": "5f3025b1-70d2-48d1-b980-d69d73bd211b",
                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                "text": "Eine möglichst große empirische Exaktheit der Abbildung war für die Seeleute lebensnotwendig."
                            },
                            {
                                "example_id": "ddadf9d9-d7c9-4a04-bfca-2de0fdc996e3",
                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                "text": "Nur wenn eine möglichst hohe Exaktheit objektiv benötigt wird, erscheint der damit einhergehende höhere Aufwand sinnvoll."
                            },
                            {
                                "example_id": "26218a96-1903-4a26-baef-fba8464f872a",
                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                "text": "Die Deutschen sind bekannt für ihre Ordnung und Exaktheit."
                            },
                            {
                                "example_id": "15e1a9b2-aede-4644-a56b-fc0690ebeae1",
                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                "text": "Ich machte Übersetzungen, langsam, aber genau, Wort für Wort, mit möglichst großer Exaktheit und Gewissenhaftigkeit."
                            },
                            {
                                "example_id": "0b3b5400-b5c5-4705-938b-65bfcbfc98f1",
                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                "text": "Diese Umschreibung zeichnet sich sicherlich nicht durch besondere Exaktheit aus."
                            },
                            {
                                "example_id": "e76fbe38-8ac0-4070-b56f-3baafd536e31",
                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                "text": "Die soziologische Voraussicht zeichnet sich heute und überhaupt durch eine sehr geringe Exaktheit aus."
                            },
                            {
                                "example_id": "587b6c8d-3a5b-438e-9a72-9fb951668f45",
                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                "text": "Die Singvögel können nur mit mäßiger Exaktheit (±12°) eine Schallquelle lokalisieren."
                            },
                            {
                                "example_id": "5e3bb9f0-9af9-4532-b1c3-040879bb6c2b",
                                "sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                                "text": "Exaktheit ist eine theorie- und modellinterne Eigenschaft. Sie findet in den Anwendungen auf die reale Erfahrung ihre Grenze."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                        "entry_id": "f58c7841-e55f-3a9e-a9df-d7db90696371",
                        "glosses": [
                            "Eindeutigkeit einer Darstellung oder Erkenntnis"
                        ],
                        "tags": [
                            "Naturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "9d6f6afb-f92e-4352-8c43-c8ab80d1fb5b",
                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                "text": "Exaktheit ist eine theorie- und modellinterne Eigenschaft. Sie findet in den Anwendungen auf die reale Erfahrung ihre Grenze."
                            },
                            {
                                "example_id": "24378f10-2368-48ce-9f5e-d8e33f68f7ee",
                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                "text": "Kompromisslos exakt im Sinne einer totalen Übereinstimmung können nur Idealwissenschaften sein, weil sie ausschließlich mit Abstraktem arbeiten, das sich völlig identisch bleibt (ideale Exaktheit)."
                            },
                            {
                                "example_id": "d2ccc74f-2e34-4ea0-9e2a-c0c3bdbca441",
                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                "text": "Der Gegensatz zwischen der mathematischen Exaktheit der theoretischen Naturgesetze und den mit Messunsicherheiten behafteten experimentellen Daten ist grundlegend."
                            },
                            {
                                "example_id": "67349eca-375e-4606-b702-96ddc3bc6b71",
                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                "text": "Es zeichnet einen gebildeten Geist aus, sich mit jenem Grad an Genauigkeit zufrieden zu geben, den die Natur der Dinge zulässt, und nicht dort Exaktheit zu suchen, wo nur Annäherung möglich ist. (Aristoteles)"
                            },
                            {
                                "example_id": "6ae301ef-df5b-4790-817a-ea632e4a54b2",
                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                "text": "Bei der Anwendung einer Theorie auf konkrete Situationen gehen die Exaktheit der Aussagen verloren –, nur die Aussagen der Theorie selbst können exakt sein."
                            },
                            {
                                "example_id": "f007a351-1502-469f-a303-53e48280cc2a",
                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                "text": "Oft werden bei der Himmelsmechanik die Exaktheit ihrer Aussagen und das überraschend hohe Maß der Übereinstimmung zwischen Theorie und Wirklichkeit rühmend hervorgehoben."
                            },
                            {
                                "example_id": "85fb0dd8-bd93-41ab-8343-d4696313615d",
                                "sense_id": "c47e0399-e45a-35af-9de7-c022646067c0",
                                "text": "Neue Entdeckungen ließen bei den Physikern Zweifel an der Exaktheit der eigenen Grundlagen aufkommen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0110b749-caf4-4e0f-92a9-ed6a751d64b2",
                        "source_entry_id": "f58c7841-e55f-3a9e-a9df-d7db90696371",
                        "source_sense_id": "9fadada2-b60d-352c-8615-b715062ccde2",
                        "target_lang_word": "exactness",
