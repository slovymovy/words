                    {
                        "translation_id": "bd264cc4-0c39-4805-be67-ec47f2b51c20",
                        "source_entry_id": "2ce20ff4-eeee-3b09-a572-f5d4b3f078b9",
                        "source_sense_id": "b29334c6-2aa2-35c7-bcab-5d10eed1586d",
                        "target_lang_word": "stoïque",
                        "target_lang_code": "fr",
