                ],
                "senses": [
                    {
                        "sense_id": "c00fac3c-942f-370b-9240-d605d3ea250c",
                        "entry_id": "987fed98-d78c-34fe-9bd6-5de63c69dc97",
                        "glosses": [
                            "Narcissisme, égoïsme, égocentrisme, tendance à tout rapporter à soi."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e33e5910-e243-4b32-9b14-6ba99a1943bc",
                                "sense_id": "c00fac3c-942f-370b-9240-d605d3ea250c",
                                "text": "En vérité, j’étais rassurée de ne pas terminer en meilleure position et même si j’étais heureuse d’être reconnue comme une jolie fille, j’évitais tout nombrilisme ou grosse tête."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a335c6b-20fd-44bf-9021-15f2b8130b59",
                        "source_entry_id": "987fed98-d78c-34fe-9bd6-5de63c69dc97",
                        "source_sense_id": "c00fac3c-942f-370b-9240-d605d3ea250c",
                        "target_lang_word": "Nabelschau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nabelschau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a094bcce-408a-3658-bc58-a80e40f6564d",
                                        "entry_id": "6797559b-57d8-30fe-948d-2a3b1e0ef220",
                                        "glosses": [
                                            "übertriebene Beschäftigung mit sich selbst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6afa2739-35b8-4fe0-af5e-6a018640fd1b",
                                                "sense_id": "a094bcce-408a-3658-bc58-a80e40f6564d",
                                                "text": "„In der aufgeheizten Berliner Atmosphäre, so schildert es einer der damaligen Hauptakteure, habe »die deutsche Nabelschau ihre Apotheose« erlebt. Libyen hat den Glauben an die Berechenbarkeit und Verlässlichkeit der deutschen Außenpolitik tief erschüttert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13c9dd13-c4f1-4e67-8d25-5b85ffdb12a9",
                        "source_entry_id": "987fed98-d78c-34fe-9bd6-5de63c69dc97",
                        "source_sense_id": "c00fac3c-942f-370b-9240-d605d3ea250c",
                        "target_lang_word": "navel-gazing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "navel-gazing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68556260-eab0-3ec2-9824-e078412fa753",
                                        "entry_id": "efefcf1b-01a9-3825-bd1e-2c698865d4d1",
                                        "glosses": [
                                            "Contemplation of one's navel as an aid to meditation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b78ec0b0-90c5-4726-9558-edb8c3aa3ac5",
                                                "sense_id": "68556260-eab0-3ec2-9824-e078412fa753",
                                                "text": "Forget incense and the lotus position, forget notions of \"getting rid of thoughts\" or \"navel gazing,\" meditation is, more broadly and more helpfully for most people, getting to know our minds and hearts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a52ed46b-048e-3f6e-92e8-fe7d8b994f18",
                                        "entry_id": "efefcf1b-01a9-3825-bd1e-2c698865d4d1",
                                        "glosses": [
                                            "Excessive focus on oneself; self-indulgent introspection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8edfe41a-e777-4f9c-8c64-859fba995982",
                                                "sense_id": "a52ed46b-048e-3f6e-92e8-fe7d8b994f18",
                                                "text": "To whom, except to the author, could these narcissistic navel-gazings be of interest?"
                                            },
                                            {
                                                "example_id": "ff1f49af-d7ea-42cf-9269-74eb8005b12d",
                                                "sense_id": "a52ed46b-048e-3f6e-92e8-fe7d8b994f18",
                                                "text": "I believe that the Opposition, devoid of any argument of any weight in the debate, determined to have Parliament engage in a trivial navel-gazing exercise regarding who said what to whom, rather than to focus on the issue of whether or not members accept the sworn evidence of an honourable member of the House."
                                            },
                                            {
                                                "example_id": "b36162f2-a3fc-4ee1-b0ff-3e8f25e85ab4",
                                                "sense_id": "a52ed46b-048e-3f6e-92e8-fe7d8b994f18",
                                                "text": "[Alvin Ward] Gouldner goes further in his reply to his critics (1974), who predictably accused him of (advocating) narcissicism, pathological navel-gazing, egoistic subjectivism and the rest. In response, he writes: “The ridicule of ‘navel-gazing’ expresses an uneasiness with all efforts at self-knowing and self-reflection. It is false consciousness’s effort to protect itself from change” (1973:124)."
                                            },
                                            {
                                                "example_id": "0060c739-7658-49f3-9a90-04fb6ab0fbce",
                                                "sense_id": "a52ed46b-048e-3f6e-92e8-fe7d8b994f18",
                                                "text": "There is a final, internal aesthetic twist to these navel-gazings: translation is an enjoyable occupation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2a7ab77-f477-33ec-8aa6-a72fa77ea883",
                                        "entry_id": "efefcf1b-01a9-3825-bd1e-2c698865d4d1",
                                        "glosses": [
                                            "(Disproportionate) concentration on a single issue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "sometimes",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "622efb11-7bfc-4093-bc66-f845213060ed",
                                                "sense_id": "c2a7ab77-f477-33ec-8aa6-a72fa77ea883",
                                                "text": "In spite of efforts by the government to focus public attention on the economy and to turn Canadians away from constitutional navel gazing to the outward challenges of the global economy, it was the election of Bill Clinton to the American presidency that set the mood for political change at home."
                                            }
                                        ]
                                    }
                                ]
                            },
