                        "examples": [
                            {
                                "example_id": "d8274b5d-dd68-47eb-b7b1-cd4f65afdd5a",
                                "sense_id": "f819901f-6943-3102-83b8-edc552c26b74",
                                "text": "„Er überhäuft sie mit Wohltaten - Autos, Schmuck, Kleider, Reisen... Angeblich hat sie sogar hier und da... ...diverse Bargeldreserven angelegt.“"
                            },
                            {
                                "example_id": "8d301850-ea39-4155-acee-29d9cdb6d71e",
                                "sense_id": "f819901f-6943-3102-83b8-edc552c26b74",
                                "text": "„›Ist das ihr Wagen?‹, fragt er mit kalter Stimme, und ich schwöre mir insgeheim, dass dieser unangenehme Zeitgenosse ganz bestimmt nicht meine Bargeldreserve bekommen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
