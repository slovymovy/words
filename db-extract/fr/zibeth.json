                                "target_senses": [
                                    {
                                        "sense_id": "38950668-020e-3204-9a24-47ef15f05c69",
                                        "entry_id": "3eae3522-26bf-32d0-bdf5-83e9999accae",
                                        "glosses": [
                                            "The large Indian civet (Viverra zibetha)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a62850d-530d-477b-ba48-b4270885d998",
                                                "sense_id": "38950668-020e-3204-9a24-47ef15f05c69",
                                                "text": "1797, Unnamed translator, Georges-Louis Leclerc, Comte de Buffon, Buffon's Natural History, Volume 7, J. S. Barr, page 119,\nCertain it is, that our zibet bears a ẛtronger reẛemblance to the muẛk animal than to the civet, and conẛequently they may be conẛidered as the ẛame ẛpecies."
                                            },
                                            {
                                                "example_id": "cffbae60-edcb-49ba-be48-16f38cf9ea1c",
                                                "sense_id": "38950668-020e-3204-9a24-47ef15f05c69",
                                                "text": "1807, Thomas Bewick, Ralph Beilby, A General History of Quadrupeds, 5th Edition, T. Bewick and S. Hodgson, page 273,\nThe perfume of the Zibet is peculiarly violent and piercing, beyond that of either the Civet or the Genet."
                                            },
                                            {
                                                "example_id": "7d825f1a-f6a9-4d50-bebe-e5ed2179dca0",
                                                "sense_id": "38950668-020e-3204-9a24-47ef15f05c69",
                                                "text": "1863, Cassell's Popular Natural History, Volume 1, Cassell, Petter and Galpin, page 366,\nThe zibet is comparatively stout, the neck short and thick, and the breast full and distended. The head is regularly attenuated and wedge-shaped in the rasse; in the zibet it is swelled, rounded, and bulging before the ears, and then contracted very abruptly to a short muzzle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a3f629c-ef65-4469-a366-69c11d566fd1",
                        "source_entry_id": "c536048a-c271-3eda-9431-1fa0749daff6",
                        "source_sense_id": "1fe69143-ac37-3517-8221-6b9b256eb4c8",
