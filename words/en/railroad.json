{
    "word_family": [
        "railroader",
        "railroading"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b002d95-57c9-398f-9602-b3ab44ef5484",
                    "sense_definition": "A system of tracks, trains, and stations used for transporting people and goods.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "transport_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>railroad</w> connects the industrial city to the port.",
                            "target_lang_translations": {
                                "ru": "<w>Железная дорога</w> соединяет промышленный город с портом.",
                                "zh": "<w>铁路</w>连接着工业城市和港口。"
                            }
                        },
                        {
                            "text": "We decided to travel across the country by <w>railroad</w>.",
                            "target_lang_translations": {
                                "ru": "Мы решили путешествовать по стране по <w>железной дороге</w>.",
                                "zh": "我们决定通过<w>铁路</w>横跨全国。"
                            }
                        }
                    ],
                    "synonyms": [
                        "railway"
                    ],
                    "common_phrases": [
                        "railroad track",
                        "railroad station",
                        "build a railroad"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Система путей, поездов и станций, используемая для перевозки людей и грузов.",
                        "zh": "用于运输人员和货物的轨道、列车和车站系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "железная дорога",
                                "target_lang_sense_clarification": "инфраструктура и транспортная система"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铁路",
                                "target_lang_sense_clarification": "基础设施和交通系统"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78745fdc-6c00-355a-bcbc-fb6a050ab4ff",
                    "sense_definition": "A company that owns or operates a system of trains and tracks.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transport_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather worked for the <w>railroad</w> for forty years.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка проработал на <w>железной дороге</w> сорок лет.",
                                "zh": "我祖父在<w>铁路部门</w>工作了四十年。"
                            }
                        },
                        {
                            "text": "The <w>railroad</w> announced a new schedule for the summer.",
                            "target_lang_translations": {
                                "ru": "<w>Железнодорожная компания</w> объявила новое расписание на лето.",
                                "zh": "<w>铁路公司</w>公布了夏季新时刻表。"
                            }
                        }
                    ],
                    "synonyms": [
                        "railway",
                        "rail company",
                        "train company"
                    ],
                    "common_phrases": [
                        "work for the railroad"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Компания, которая владеет или управляет системой поездов и путей.",
                        "zh": "拥有或运营列车和轨道系统的公司。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "железная дорога",
                                "target_lang_sense_clarification": "организация или место работы"
                            },
                            {
                                "target_lang_word": "железнодорожная компания",
                                "target_lang_sense_clarification": "юридическое лицо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铁路公司",
                                "target_lang_sense_clarification": "运营铁路的商业实体"
                            },
                            {
                                "target_lang_word": "铁路部门",
                                "target_lang_sense_clarification": "作为工作单位或组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a8b6ab2-b5dd-3928-b640-5c229a68f9da",
                    "sense_definition": "A procedure or process conducted too quickly and without fairness or proper consideration.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "coercion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyers argued that the trial was a <w>railroad</w> designed to secure a quick conviction.",
                            "target_lang_translations": {
                                "ru": "Адвокаты утверждали, что этот суд был <w>фарсом</w>, призванным обеспечить быстрое осуждение.",
                                "zh": "律师们辩称，这场审判是一场旨在快速定罪的<w>草率行事</w>。"
                            }
                        },
                        {
                            "text": "Critics called the sudden vote a <w>railroad</w> of the democratic process.",
                            "target_lang_translations": {
                                "ru": "Критики назвали это внезапное голосование <w>попранием</w> демократического процесса.",
                                "zh": "批评人士称这次突如其来的投票是对民主程序的<w>强行通过</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процедура или процесс, проводимые слишком быстро и без справедливости или должного рассмотрения.",
                        "zh": "一种进行得过于仓促且缺乏公平性或适当考虑的程序或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "произвол",
                                "target_lang_sense_clarification": "несправедливое действие"
                            },
                            {
                                "target_lang_word": "фарс",
                                "target_lang_sense_clarification": "о судебном процессе или голосовании"
                            },
                            {
                                "target_lang_word": "протаскивание",
                                "target_lang_sense_clarification": "быстрое принятие решения в обход правил"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草率行事",
                                "target_lang_sense_clarification": "指过程不公正"
                            },
                            {
                                "target_lang_word": "强行通过",
                                "target_lang_sense_clarification": "指在决策中排除异议"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eaade1ce-81f4-3ac1-854a-bd30ab061e19",
                    "sense_definition": "To force a decision, law, or action to happen quickly and unfairly, often by preventing opposition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "coercion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee <w>railroaded</w> the bill through without allowing any debate.",
                            "target_lang_translations": {
                                "ru": "Комитет <w>протащил</w> законопроект, не допустив никаких дебатов.",
                                "zh": "委员会在不允许任何辩论的情况下<w>强行通过</w>了该法案。"
                            }
                        },
                        {
                            "text": "He felt he was <w>railroaded</w> into signing the contract before he could read it.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что его <w>принудили</w> подписать контракт до того, как он смог его прочитать.",
                                "zh": "他感到自己被<w>胁迫</w>在阅读合同前就签了字。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "railroad through",
                        "railroad into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить принять решение, закон или действие быстро и несправедливо, часто путем предотвращения оппозиции.",
                        "zh": "通过阻止反对意见等手段，强行快速且不公平地推动某项决定、法律或行动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протаскивать",
                                "target_lang_sense_clarification": "о законах или решениях"
                            },
                            {
                                "target_lang_word": "принуждать",
                                "target_lang_sense_clarification": "заставлять кого-то сделать что-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "强行通过",
                                "target_lang_sense_clarification": "指法案或决策"
                            },
                            {
                                "target_lang_word": "胁迫",
                                "target_lang_sense_clarification": "指强迫某人做某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3cc0081-2f6a-3d44-809e-49df5122f75d",
                    "sense_definition": "To transport goods or people using a train system.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "transport_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy equipment was <w>railroaded</w> to the construction site.",
                            "target_lang_translations": {
                                "ru": "Тяжелое оборудование было <w>доставлено по железной дороге</w> на строительную площадку.",
                                "zh": "重型设备通过<w>铁路运输</w>到了施工现场。"
                            }
                        },
                        {
                            "text": "Farmers <w>railroaded</w> their cattle to the markets in the east.",
                            "target_lang_translations": {
                                "ru": "Фермеры <w>отправляли по железной дороге</w> свой скот на рынки востока.",
                                "zh": "农民们通过<w>铁路运输</w>将牲畜运往东部市场。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Перевозить товары или людей, используя систему поездов.",
                        "zh": "使用铁路系统运输货物或人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перевозить по железной дороге",
                                "target_lang_sense_clarification": "транспортировка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铁路运输",
                                "target_lang_sense_clarification": "通过铁路进行物流"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "db8ddce6-1888-3d9a-ad23-0e401f243d0e",
                    "sense_definition": "A place name used for several towns in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We drove through the small borough of <w>Railroad</w> in Pennsylvania.",
                            "target_lang_translations": {
                                "ru": "Мы проехали через маленький городок <w>Рейлрод</w> в Пенсильвании.",
                                "zh": "我们开车穿过了宾夕法尼亚州的一个叫<w>雷尔罗德</w>的小镇。"
                            }
                        },
                        {
                            "text": "He was surprised to find a town named <w>Railroad</w> on the map.",
                            "target_lang_translations": {
                                "ru": "Он удивился, обнаружив на карте город под названием <w>Рейлрод</w>.",
                                "zh": "他惊讶地发现地图上有一个叫<w>雷尔罗德</w>的城镇。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название, используемое для нескольких городов в Соединенных Штатах.",
                        "zh": "美国多个城镇的地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Рейлрод",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雷尔罗德",
                                "target_lang_sense_clarification": "地名音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}