    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "11a458f5-8f30-3ffb-9125-5d1b2a2b0646",
                    "sense_definition": "Extremely large; greatly exceeding the common size, extent, or degree.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The elephant is an <w>enormous</w> animal that lives in Africa and Asia.",
                            "target_lang_translations": {
                                "ru": "Слон — это <w>огромное</w> животное, обитающее в Африке и Азии.",
                                "tr": "Fil, Afrika ve Asya'da yaşayan <w>kocaman</w> bir hayvandır.",
                                "zh": "大象是一种生活在非洲和亚洲的<w>巨大</w>动物。"
                            }
                        },
                        {
                            "text": "She felt <w>enormous</w> pressure to finish the important project on time.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала <w>огромное</w> давление, стремясь закончить важный проект вовремя.",
                                "tr": "Önemli projeyi zamanında bitirmek için <w>muazzam</w> bir baskı hissetti.",
                                "zh": "为了按时完成这个重要项目，她感到<w>极大</w>的压力。"
                            }
                        }
                    ],
                    "synonyms": [
                        "huge",
                        "gigantic",
                        "humongous",
                        "massive",
                        "tremendous",
                        "immense",
                        "vast"
                    ],
                    "antonyms": [
                        "tiny"
                    ],
                    "common_phrases": [
                        "enormous amount",
                        "enormous pressure",
                        "enormous success",
                        "enormous potential",
                        "enormous impact"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно большой; значительно превышающий обычный размер, объем или степень.",
                        "tr": "Son derece büyük; yaygın boyut, kapsam veya dereceyi büyük ölçüde aşan.",
                        "zh": "极其巨大；远远超过通常的大小、程度或范围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огромный",
                                "target_lang_sense_clarification": "самый общий и употребительный вариант"
                            },
                            {
                                "target_lang_word": "громадный",
                                "target_lang_sense_clarification": "синоним слова «огромный», часто используется для описания физических размеров"
                            },
                            {
                                "target_lang_word": "гигантский",
                                "target_lang_sense_clarification": "исполинский, превышающий все обычные меры"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kocaman",
                                "target_lang_sense_clarification": "fiziksel boyutlar için en yaygın kullanım"
                            },
                            {
                                "target_lang_word": "devasa",
                                "target_lang_sense_clarification": "çok büyük, dev boyutlarda olan"
                            },
                            {
                                "target_lang_word": "muazzam",
                                "target_lang_sense_clarification": "etkileyici veya soyut büyüklükler için (örn. başarı, baskı)"
                            },
                            {
                                "target_lang_word": "çok büyük",
                                "target_lang_sense_clarification": "genel ve nötr kullanım"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巨大",
                                "target_lang_sense_clarification": "最通用，用于描述物理尺寸或抽象程度"
                            },
                            {
                                "target_lang_word": "庞大",
                                "target_lang_sense_clarification": "强调规模宏大，常用于组织、体系或数量"
                            },
                            {
                                "target_lang_word": "极大",
                                "target_lang_sense_clarification": "强调程度极高，常用于抽象概念如压力、潜力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4709110-1a92-34bd-b58e-1a4da324dc70",
                    "sense_definition": "Exceedingly wicked; atrocious or outrageous.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historian described the <w>enormous</w> crimes committed by the ancient tyrant.",
                            "target_lang_translations": {
                                "ru": "Историк описал <w>чудовищные</w> преступления, совершенные древним тираном.",
                                "tr": "Tarihçi, antik tiran tarafından işlenen <w>korkunç</w> suçları tanımladı.",
                                "zh": "历史学家描述了那位古代暴君所犯下的<w>滔天</w>罪行。"
                            }
