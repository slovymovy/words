{
    "word_family": [
        "wywierać",
        "wywarcie",
        "wrzeć"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc5ffae2-d561-337e-bb21-e69e3a0f1ba8",
                    "sense_definition": "spowodować powstanie określonego odczucia, opinii lub reakcji w kimś",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "oddziaływanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego nowe wystąpienie na konferencji <w>wywarło</w> ogromne wrażenie na wszystkich obecnych gościach.",
                            "target_lang_translations": {
                                "ru": "Его новое выступление на конференции <w>произвело</w> огромное впечатление на всех присутствующих гостей."
                            }
                        },
                        {
                            "text": "Mam nadzieję, że podczas rozmowy kwalifikacyjnej <w>wywrzesz</w> jak najlepszy wpływ na komisję.",
                            "target_lang_translations": {
                                "ru": "Надеюсь, что во время собеседования ты <w>окажешь</w> наилучшее влияние на комиссию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wywrzeć wrażenie",
                        "wywrzeć wpływ"
                    ],
                    "target_lang_definitions": {
                        "ru": "произвести определенное впечатление, оказать влияние или вызвать реакцию у кого-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "произвести",
                                "target_lang_sense_clarification": "впечатление"
                            },
                            {
                                "target_lang_word": "оказать",
                                "target_lang_sense_clarification": "влияние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "409f0f4a-cef8-31ec-b8d0-a80980b89f80",
                    "sense_definition": "skierować działanie siły lub zastosować przymus psychiczny, nacisk wobec kogoś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oddziaływanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dyrektor próbował <w>wywrzeć</w> nacisk na pracownikach, aby zgodzili się na nowe warunki.",
                            "target_lang_translations": {
                                "ru": "Директор пытался <w>оказать</w> давление на сотрудников, чтобы они согласились на новые условия."
                            }
                        },
                        {
                            "text": "Rząd postanowił <w>wywrzeć</w> presję dyplomatyczną na sąsiedni kraj w celu uniknięcia kryzysu.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>оказать</w> дипломатическое давление на соседнюю страну с целью избежать кризиса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wywrzeć nacisk",
                        "wywrzeć presję"
                    ],
                    "target_lang_definitions": {
                        "ru": "оказать психологическое давление, принуждение или применить физическую силу по отношению к кому-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оказать",
                                "target_lang_sense_clarification": "давление, нажим"
                            },
                            {
                                "target_lang_word": "надавить",
                                "target_lang_sense_clarification": "принудить к чему-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e088590-5ede-3d83-8078-777b2af92995",
                    "sense_definition": "wrząc, wygotować się lub odparować w całości",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gotowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zostawił garnek na małym ogniu tak długo, aż wszystka woda zupełnie <w>wywarła</w>.",
                            "target_lang_translations": {
                                "ru": "Он оставил кастрюлю на медленном огне так надолго, что вся вода полностью <w>выкипела</w>."
                            }
                        },
                        {
                            "text": "Płyn w naczyniu powoli <w>wywrze</w>, jeśli zapomnisz na czas wyłączyć kuchenkę.",
                            "target_lang_translations": {
                                "ru": "Жидкость в посуде медленно <w>выкипит</w>, если ты забудешь вовремя выключить плиту."
                            }
                        }
                    ],
                    "synonyms": [
                        "wygotować"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "znaczenie rzadkie, przestarzałe"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "полностью выкипеть или испариться при кипении (устар.)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выкипеть",
                                "target_lang_sense_clarification": "о жидкости при кипении"
                            },
                            {
                                "target_lang_word": "вывариться",
                                "target_lang_sense_clarification": "испариться при варке"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}