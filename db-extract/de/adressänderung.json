                ],
                "senses": [
                    {
                        "sense_id": "deeb4303-028a-3160-b054-3d6456c7450f",
                        "entry_id": "46dd0fca-cf0a-3e28-b049-fbd688c36419",
                        "glosses": [
                            "Änderung der (postalischen) Erreichbarkeit einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76e5f0dc-b099-429d-8d51-a8c73a978ccf",
                                "sense_id": "deeb4303-028a-3160-b054-3d6456c7450f",
                                "text": "Durch dieses Aufkleberverfahren werden bei häufigen Adressänderungen die Kosten für den Bürger reduziert, weil nicht jeweils ein neuer Personalausweis beantragt werden muss."
                            },
                            {
                                "example_id": "777ebcf3-217d-4896-8b3a-f187df63c69d",
                                "sense_id": "deeb4303-028a-3160-b054-3d6456c7450f",
                                "text": "Sie ist zuständig für die Anmeldung von Neuzuzügen, von ihr werden auch sämtliche Wegzüge, Adressänderungen oder andere Änderungen bezüglich der Personalien einer Einwohnerin und/oder eines Einwohners bearbeitet."
                            },
                            {
                                "example_id": "67ae3051-ecf8-4124-9401-92d495ce1d72",
                                "sense_id": "deeb4303-028a-3160-b054-3d6456c7450f",
                                "text": "Privatkunden zahlen für die Adressänderung im Inland am Schalter oder am Telefon veranlasst 42 Franken oder online 30 Franken."
                            },
                            {
                                "example_id": "7a936d1c-212f-4cfa-8c3a-fe99d30d56a3",
                                "sense_id": "deeb4303-028a-3160-b054-3d6456c7450f",
                                "text": "Wer Studienbeihilfe bezieht, muss eine Adressänderung grundsätzlich innerhalb von 14 Tagen bei der Studienbeihilfenbehörde melden. Die Meldung der Adressänderung kann schriftlich als formloser Brief oder persönlich durchgeführt werden."
                            },
                            {
                                "example_id": "990f0935-5cf1-4fef-acf8-16f7430c59eb",
                                "sense_id": "deeb4303-028a-3160-b054-3d6456c7450f",
                                "text": "Adressänderungen des Hauptwohnsitzes können von uns nur dann entgegengenommen werden, wenn Sie diese bereits beim zuständigen Meldeamt (Magistrat oder Gemeindeamt) durchgeführt haben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
