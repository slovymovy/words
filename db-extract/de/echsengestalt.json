                "senses": [
                    {
                        "sense_id": "1e5cd41e-a462-3477-93cd-5846129566e7",
                        "entry_id": "7276378e-f4a7-32d7-b56f-5c0a9ddae3c7",
                        "glosses": [
                            "Figur, die echsenartig aussieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7f8d570-7c6d-4089-bbcb-ac71591b3bbf",
                                "sense_id": "1e5cd41e-a462-3477-93cd-5846129566e7",
                                "text": "„Ich konnte den Blick nicht lösen: Ein Dämon sperrte den Rachen auf, eine funkelnde Echsengestalt trug eine Fahne, ein Fisch flog am Himmel, und ein Schwein im Gewand einer Nonne spielte Harfe.“"
                            },
                            {
                                "example_id": "6570c952-d555-4e74-9440-c535f590b3c0",
                                "sense_id": "1e5cd41e-a462-3477-93cd-5846129566e7",
                                "text": "„Dabei hätte eigentlich alles ganz anders kommen sollen, denn George Lucas hatte die späteren Kultfiguren in der allerersten Fassung des Drehbuchs von 1974 nicht so entworfen, wie wir sie kennen: Luke war in der ‚The Star Wars‘ betitelten Geschichte ein alter Jedi-Veteran und bereits General, Annikin hieß ‚Starkiller‘ und Han Solo war ein über zwei Meter großes Alien in Echsengestalt!“"
                            },
                            {
                                "example_id": "eb77b43a-8960-4fe7-bd11-a02badfda47f",
                                "sense_id": "1e5cd41e-a462-3477-93cd-5846129566e7",
                                "text": "„Er warf einen nachdenklichen Blick zu der Echsengestalt ihres furchtbaren Feindes.“"
                            },
                            {
                                "example_id": "0cfa3ff3-db53-43b8-9e49-85cfc3655977",
                                "sense_id": "1e5cd41e-a462-3477-93cd-5846129566e7",
                                "text": "„Das Ornament zeigt fein gerippte, in sich verschlungene Ranken, die geflügelte Drachen- oder Echsengestalten durchziehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
