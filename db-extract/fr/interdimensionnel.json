                        "glosses": [
                            "Entre plusieurs dimensions."
                        ],
                        "tags": [
                            "Science-fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "0dfd070e-ea5c-42e0-9a9b-4fc46d5eb6ed",
                                "sense_id": "0dadb577-56b9-39c5-81af-975d77723f8d",
                                "text": "Ong's Hat est une ville fantôme américaine, l'une des premières sur les théories du complot selon lesquelles un portail interdimensionnel pour un autre monde existe. On y aurait mené des expériences sur la physique quantique et la théorie du chaos."
                            }
                        ]
                    }
