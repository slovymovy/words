                ],
                "senses": [
                    {
                        "sense_id": "b68dc2f3-7f68-37c9-af41-635d8ad6cb52",
                        "entry_id": "c3c2d4f0-33f3-31b9-9cbb-5a79184c88e4",
                        "glosses": [
                            "биол. биологический вид, род и т. п., распространённый в относительно ограниченном ареале"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8609fae-8926-403c-9467-08681475e690",
                                "sense_id": "b68dc2f3-7f68-37c9-af41-635d8ad6cb52",
                                "text": "На Дальнем Востоке России живёт ещё один вид свиристелей — свиристель амурский, или японский. Последнее название не оправдано — весь гнездовой ареал птицы находится в пределах России — она наш эндемик."
                            },
                            {
                                "example_id": "33e75f45-07b9-4ce5-a428-2d3415631b01",
                                "sense_id": "b68dc2f3-7f68-37c9-af41-635d8ad6cb52",
                                "text": "Капская флора, состоящая на 70 % из эндемиков, привлекает ботаников всего мира."
                            },
                            {
                                "example_id": "86763d11-178e-4696-98c6-c491561fd5bb",
                                "sense_id": "b68dc2f3-7f68-37c9-af41-635d8ad6cb52",
                                "text": "Всего здесь насчитывается более двухсот видов растений, большинство из которых эндемики, их можно встретить только в этой пустыне."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22ef86c9-2eae-496c-9056-5e79bb60857c",
                        "source_entry_id": "c3c2d4f0-33f3-31b9-9cbb-5a79184c88e4",
                        "source_sense_id": "b68dc2f3-7f68-37c9-af41-635d8ad6cb52",
                        "target_lang_word": "endemic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "endemic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9526418-f729-340f-b46a-f310125053dd",
                                        "entry_id": "b6d61c3f-9d31-3720-a72a-035ae1bc32d8",
                                        "glosses": [
                                            "Native to a particular area or culture; originating where it occurs."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d00490e-0fd4-40db-8f02-eb3fb7e1b9b0",
                                                "sense_id": "a9526418-f729-340f-b46a-f310125053dd",
                                                "text": "The endemic religion of Easter Island arrived with the Polynesian settlers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeb3ef71-efac-344d-8770-bcb9b507a8e5",
                                        "entry_id": "b6d61c3f-9d31-3720-a72a-035ae1bc32d8",
                                        "glosses": [
                                            "Peculiar to a particular area or region; not found in other places."
                                        ],
                                        "tags": [
                                            "especially",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eacb5370-54d3-4e93-b0c9-ac0c77a82ede",
                                                "sense_id": "eeb3ef71-efac-344d-8770-bcb9b507a8e5",
                                                "text": "Kangaroos are endemic to Australia."
                                            },
                                            {
                                                "example_id": "23c5993a-b8b6-4930-a26c-5128d01319c3",
                                                "sense_id": "eeb3ef71-efac-344d-8770-bcb9b507a8e5",
                                                "text": "[…] a continental northern Alaskan element, including a series of endemic species and disjuncts that have survived the Pleistocene glaciation in northern Alaska and thus represent relicts of the much warmer Tertiary […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d24beb9-5f86-3685-ab9e-fe4d2b618208",
                                        "entry_id": "b6d61c3f-9d31-3720-a72a-035ae1bc32d8",
                                        "glosses": [
                                            "Prevalent in a particular area or region, persistent within a population."
                                        ],
                                        "tags": [
                                            "especially",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f09880d-7f09-4627-bc2b-800ee222a673",
                                                "sense_id": "3d24beb9-5f86-3685-ab9e-fe4d2b618208",
                                                "text": "Malaria is endemic to the tropics."
                                            },
                                            {
                                                "example_id": "c4f856b1-949b-4fa3-ac10-fd560e508c90",
                                                "sense_id": "3d24beb9-5f86-3685-ab9e-fe4d2b618208",
                                                "text": "1998, Gillian Catriona Ramchand, Deconstructing the Lexicon, in Miriam Butt and Wilhelm Geuder, eds. “The Projection of Arguments”\nThese problems are endemic to the theory of thematic roles as currently conceived, because the classification it implies simply does not correspond to legitimate linguistic semantic definitions."
                                            },
                                            {
                                                "example_id": "558aed8a-4189-441a-926d-8592a32121f1",
                                                "sense_id": "3d24beb9-5f86-3685-ab9e-fe4d2b618208",
                                                "text": "In a country where corruption is endemic, no evidence has been presented that Ms Yingluck took any money from the rice scheme, which in 2012 and 2013 cost Thailand billions of dollars. But a state-appointed committee last year ordered her to pay the fine, finding she was to blame, even though it was government policy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "endemic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "625e31bd-031b-3be6-b759-79c49a573ae4",
                                        "entry_id": "72abfac7-c571-385f-acec-5f6fcbb99841",
                                        "glosses": [
                                            "An individual or species that is endemic to a region."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f544d3a9-d904-4b41-ab16-072ea88e7f18",
                                                "sense_id": "625e31bd-031b-3be6-b759-79c49a573ae4",
                                                "text": "The species that appeared as a consequence were endemics; that is, they were found nowhere else in the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "156b8b47-e881-34a9-949c-b83fa45e8433",
                                        "entry_id": "72abfac7-c571-385f-acec-5f6fcbb99841",
                                        "glosses": [
                                            "A disease affecting a number of people simultaneously, so as to show a distinct connection with certain localities."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
