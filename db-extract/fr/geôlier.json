                    },
                    {
                        "form_id": "04982601-c58d-4ac8-b33c-4c602b349059",
                        "entry_id": "4c86b413-492a-3507-89a8-92d1e4510daa",
                        "tags": [
                            "rare"
                        ],
                        "form": "géôlier"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c42f83f6-bfec-39c7-9209-3140ee90d38b",
                        "entry_id": "4c86b413-492a-3507-89a8-92d1e4510daa",
                        "glosses": [
                            "Celui qui garde les prisonniers."
                        ],
                        "tags": [
                            "Prison"
                        ],
                        "examples": [
                            {
                                "example_id": "94b00e48-a474-4978-b011-08465baa9441",
                                "sense_id": "c42f83f6-bfec-39c7-9209-3140ee90d38b",
                                "text": "[…] puis mon geôlier m’enferma dans une petite pièce obscure. C’était un cachot, presque un placard, où la lumière du jour n’entrait jamais."
                            },
                            {
                                "example_id": "58fbc146-cab7-4199-8143-00787c6bdfca",
                                "sense_id": "c42f83f6-bfec-39c7-9209-3140ee90d38b",
                                "text": "Dès lors, je ne fus plus pour elle un protecteur, mais un geôlier; ma chambre cessa d'être un asile, et devint une prison."
                            }
                        ]
                    },
                    {
                        "sense_id": "1634f335-4e02-3394-b544-a643b3154708",
                        "entry_id": "4c86b413-492a-3507-89a8-92d1e4510daa",
                        "glosses": [
                            "Le concierge de la prison."
                        ],
                        "tags": [
                            "Prison"
                        ],
                        "examples": [
                            {
                                "example_id": "b31efcc0-5698-4826-84cd-ad20622a8a52",
                                "sense_id": "1634f335-4e02-3394-b544-a643b3154708",
                                "text": "Dans les prisons de Nantes\nY’avait un prisonnier\nPersonne ne vint le voir\nQue la fille du geôlier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e3e7616-fead-4885-a09f-d01e7119bbf7",
                        "source_entry_id": "4c86b413-492a-3507-89a8-92d1e4510daa",
                        "target_lang_word": "Gefängniswärter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gefängniswärter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "535df3b1-ee3b-37d0-8c77-41624995c553",
                                        "entry_id": "48bb14e2-7643-3760-824e-ee62d3377e24",
                                        "glosses": [
                                            "Mitglied des Sicherheitspersonals eines Gefängnisses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85b14b04-2af4-494d-93c1-f06b475ad81c",
                                                "sense_id": "535df3b1-ee3b-37d0-8c77-41624995c553",
                                                "text": "Sie überwältigten die Gefängniswärter und letztendlich gelang ihnen die Flucht."
                                            },
                                            {
                                                "example_id": "3388ac2d-507a-4e0f-8594-a0a39b194461",
                                                "sense_id": "535df3b1-ee3b-37d0-8c77-41624995c553",
                                                "text": "„Nie im Leben hätte ich der Zärtlichkeit, die sich in meinem Herzen angesammelt hatte, vor diesem Gorilla von einem Gefängniswärter, der hinter uns stand, Ausdruck verleihen können.“"
                                            },
                                            {
                                                "example_id": "14f8d788-3c7b-4c30-bd54-da35bb60c673",
                                                "sense_id": "535df3b1-ee3b-37d0-8c77-41624995c553",
                                                "text": "„Den Grund für all diese Veränderungen kann ich nicht nennen, aber ich weiß, dass der Gefängniswärter, als er das Tor hinter uns schloss, sagte, dass dies bis zum Ende des Krieges unser Zuhause sein würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e077f62a-6f42-43f8-b674-fcc5463a7a58",
                        "source_entry_id": "4c86b413-492a-3507-89a8-92d1e4510daa",
                        "target_lang_word": "jailer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jailer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39c88bcb-0418-364c-86b0-feff510a5e6a",
                                        "entry_id": "de1a3a47-49b4-3d51-8d04-78845ece0441",
                                        "glosses": [
                                            "One who enforces confinement in a jail or prison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c6409cc-323b-47d5-b161-3f5bcfde8223",
                                                "sense_id": "39c88bcb-0418-364c-86b0-feff510a5e6a",
                                                "text": "Sometimes some of the ejected ministers preached to them privately, and now and then the jailer allowed Mr. H. to go out in the night to preach to them, and administer the Lord's Supper."
                                            },
                                            {
                                                "example_id": "637423a9-08cd-4a0f-b46b-ff63979bd357",
                                                "sense_id": "39c88bcb-0418-364c-86b0-feff510a5e6a",
                                                "text": "But the next morning came, and my coffee was brought by her mother; the next, and the next, by the under jailers; and Angiola continued grievously ill."
                                            },
                                            {
                                                "example_id": "0f8b6026-2c45-4105-8525-14805739aa86",
                                                "sense_id": "39c88bcb-0418-364c-86b0-feff510a5e6a",
                                                "text": "The jailer was also roused by the earthquake and came to the outer door; he was perhaps a soldier, or at least had something of Roman discipline, giving him presence of mind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f693b7d4-b2a5-4ee1-970c-d438794a7ab3",
                        "source_entry_id": "4c86b413-492a-3507-89a8-92d1e4510daa",
                        "target_lang_word": "gaoler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gaoler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7554e3a-1df7-3466-a44e-adef55952c32",
                                        "entry_id": "ceca60ff-7270-3a3f-b7c8-77382792cead",
                                        "glosses": [
                                            "Dated spelling of jailer."
                                        ],
                                        "tags": [
                                            "Commonwealth"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c5eb389-b0f6-463f-a875-ad58b6b881db",
                                                "sense_id": "e7554e3a-1df7-3466-a44e-adef55952c32",
                                                "text": "The Grange is not a prison, Ellen, and you are not my gaoler."
                                            },
                                            {
                                                "example_id": "c8a22c87-cea2-4821-a612-6c865496dff1",
                                                "sense_id": "e7554e3a-1df7-3466-a44e-adef55952c32",
                                                "text": "One very important section of the denizens of Darkest England are the criminals and the semi-criminals. They are more or less predatory, and are at present shepherded by the police and punished by the gaoler."
                                            },
                                            {
                                                "example_id": "17472d1a-8a96-4994-b395-290ce8ce05c3",
                                                "sense_id": "e7554e3a-1df7-3466-a44e-adef55952c32",
                                                "text": "A gaoler struck him, pushing him back in place in the hopeless, helpless line of prisoners."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71b2ee8a-634d-44c4-abce-4bceb48b5adc",
