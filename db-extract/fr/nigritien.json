                        "entry_id": "7d55d431-3aa1-3536-9514-9a9b8b98cd74",
                        "glosses": [
                            "Relatif à la Nigritie ou à ses habitants, les Nigritiens."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "bee44e94-d699-4bc6-8199-00a8b89b30d8",
                                "sense_id": "2edf5b71-80e4-35ae-9138-2061b9b64d59",
                                "text": "Physiquement, ils ressemblent aux Somalis, et, de fait, ils sont hamites comme eux. Toutefois, leur type paraît mêlé d’éléments nigritiens."
                            },
                            {
                                "example_id": "8b8ddf2d-f1f6-4242-8fd5-c86ec5af2463",
                                "sense_id": "2edf5b71-80e4-35ae-9138-2061b9b64d59",
                                "text": "Pourtant, au dire de Nachtigal, rares sont autour du Tchad les agglomérations nigritiennes."
                            },
                            {
                                "example_id": "bb8bf109-0794-4bff-82c1-697088991cc4",
                                "sense_id": "2edf5b71-80e4-35ae-9138-2061b9b64d59",
                                "text": "Il fut reçu à Masrena, le 3 juillet 1852, par le sultan, en grande pompe nigritienne."
                            }
                        ]
                    }
