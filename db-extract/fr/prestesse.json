        "fr-extract.jsonl": [
            {
                "entry_id": "440b278b-027f-3d55-8402-038e35ca901f",
                "word": "prestesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0ee99e7a-7c9d-45d3-ac37-690d484a5979",
                        "entry_id": "440b278b-027f-3d55-8402-038e35ca901f",
                        "tags": [
                            "plural"
                        ],
                        "form": "prestesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "727cc232-7478-3a86-a022-cdd641f163f8",
                        "entry_id": "440b278b-027f-3d55-8402-038e35ca901f",
                        "glosses": [
                            "Promptitude, agilité, vivacité."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a860c39e-899a-40fe-9273-5a4148dc620a",
                                "sense_id": "727cc232-7478-3a86-a022-cdd641f163f8",
                                "text": "Pille-miche tira la voiture par le timon, et Marche-à-terre la poussa par une des roues avec une telle prestesse que Francine se trouva dans la grange et sur le point d’y rester enfermée, avant d’avoir eu le temps de réfléchir à sa situation."
                            },
                            {
                                "example_id": "003dd4cf-36bc-4f59-bc9b-1a847fb54a37",
                                "sense_id": "727cc232-7478-3a86-a022-cdd641f163f8",
                                "text": "Joliffe le déshabillait, le tournait, le retournait avec prestesse, tout en disant :…."
                            },
                            {
                                "example_id": "dcbf7272-bbd5-4405-bc93-966165bc6985",
                                "sense_id": "727cc232-7478-3a86-a022-cdd641f163f8",
                                "text": "Était-ce l’effet de sa prestesse ou de sa dextérité, toujours est-il que le garçon captura un écureuil au sommet d’un arbre."
                            },
                            {
                                "example_id": "0d7a15a2-388f-4067-9edb-0000d9f44728",
                                "sense_id": "727cc232-7478-3a86-a022-cdd641f163f8",
                                "text": "Avec une agilité et une prestesse qui tenaient du prodige, elle tournoyait, voltigeait, cabriolait, tromblon au poing."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc9f656b-c727-3614-b249-ef4fa37f82a3",
                        "entry_id": "440b278b-027f-3d55-8402-038e35ca901f",
                        "glosses": [
                            "Promptitude en parlant de l’esprit et des choses qui en dépendent."
                        ],
                        "tags": [
                            "dated",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1097f37e-8500-461e-8543-3bdae474e0e9",
                                "sense_id": "dc9f656b-c727-3614-b249-ef4fa37f82a3",
                                "text": "Et le lendemain même de cette conversation (la simplicité n'exclut pas la prestesse) Mme Balizard prenait l'express de Paris, très simplement."
                            },
                            {
                                "example_id": "e12192dd-c7c1-4e4c-a57b-f300d4a73f34",
                                "sense_id": "dc9f656b-c727-3614-b249-ef4fa37f82a3",
                                "text": "Ailleurs, des gouvernants, bien intentionnés pour la plupart, mais limités, ayant à leur actif — parfois — la prestesse d'entournures que donne l'usage du monde, tel M. de Bulow en Allemagne. Insuffisant."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
