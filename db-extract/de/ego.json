                    {
                        "form_id": "e1c6d19c-a76e-46a3-8023-f65d0472884e",
                        "entry_id": "81a9a8ce-b8bb-3c62-8261-b9054e497855",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Ego"
                    },
                    {
                        "form_id": "acad2f36-1878-4020-a3e3-eb00583ba076",
                        "entry_id": "81a9a8ce-b8bb-3c62-8261-b9054e497855",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Egos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43d82852-bf57-3335-9029-c871955773a6",
                        "entry_id": "81a9a8ce-b8bb-3c62-8261-b9054e497855",
                        "glosses": [
                            "das Ich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06ae5d51-9bf1-470e-9c65-0a35ca0b1b39",
                                "sense_id": "43d82852-bf57-3335-9029-c871955773a6",
                                "text": "„Ist es mir gewiß und schon durch transzendentale Klärung verständlich, daß meine Seele eine Selbstobjektivierung meines transzendentalen Ego ist, so weist nun auch die fremde Seele auf ein und nun ein fremdes transzendentales Ego zurück, […]“"
                            },
                            {
                                "example_id": "7be8c257-9592-4575-b5e6-67b6c95bde63",
                                "sense_id": "43d82852-bf57-3335-9029-c871955773a6",
                                "text": "„Er umfaßt schließlich, selbst wider Willen, auch das Ego, das als letztes nicht bezwungenes Objekt übrigbleibt.“"
                            },
                            {
                                "example_id": "7be3151f-7111-450d-9bd8-df8b2296c8dc",
                                "sense_id": "43d82852-bf57-3335-9029-c871955773a6",
                                "text": "„Die Überwindung des Egos wird beispielsweise in der indischen Tradition u. a. dargestellt als Kette abgeschlagener Dämonen- oder Menschenköpfe, die die Göttin Kali um ihren Hals trägt, zum Zeichen, daß sie sich von ihnen befreit hat.“"
                            },
                            {
                                "example_id": "a186e7f2-482c-4442-abd9-39d6e85ad4db",
                                "sense_id": "43d82852-bf57-3335-9029-c871955773a6",
                                "text": "„In Anbetracht von Ernests Ego und aufbrausender Art und Gertrudes Intoleranz gegenüber jedem, der es wagte, ihr zu widersprechn, war es nur eine Frage der Zeit gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "462e7c35-89e6-38bf-9aa7-c54ef444e397",
                        "entry_id": "81a9a8ce-b8bb-3c62-8261-b9054e497855",
                        "glosses": [
                            "das Bild, das eine Person von sich selber hat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "829df98b-ab0e-4a38-bc20-68138dd6934c",
                                "sense_id": "462e7c35-89e6-38bf-9aa7-c54ef444e397",
                                "text": "„Die Überwindung des Egos wird beispielsweise in der indischen Tradition u. a. dargestellt als Kette abgeschlagener Dämonen- oder Menschenköpfe, die die Göttin Kali um ihren Hals trägt, zum Zeichen, daß sie sich von ihnen befreit hat.“"
                            },
                            {
                                "example_id": "741a5d93-cca7-4f49-84f4-a5ca416da33f",
                                "sense_id": "462e7c35-89e6-38bf-9aa7-c54ef444e397",
                                "text": "„Es habe fette Gewinne gegeben, große Egos und viel Testosteron.“"
                            },
                            {
                                "example_id": "e85fe1f3-40d3-4545-bd6f-8ca4d562bc44",
                                "sense_id": "462e7c35-89e6-38bf-9aa7-c54ef444e397",
                                "text": "„Mit gestärktem Ego und den schweren Teigteilen in der Hand machte ich mich auf die Suche nach einem ordentlichen Kaffee.“"
                            },
                            {
                                "example_id": "b96e0995-474e-4cc3-b89e-3f7dd9afa19f",
                                "sense_id": "462e7c35-89e6-38bf-9aa7-c54ef444e397",
                                "text": "„Da würde das Ego beider Damen jaulen, da liefe ja nun wirklich was verkehrt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48f1024c-d261-4a6f-9166-3d9f389dc247",
                        "source_entry_id": "81a9a8ce-b8bb-3c62-8261-b9054e497855",
                        "source_sense_id": "43d82852-bf57-3335-9029-c871955773a6",
                        "source_sense_description": "wissenschaftlich: das Ich",
                        "target_lang_word": "ego",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ego",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66fa48f6-57a5-377c-b77c-1aeb2c9b94b3",
                                        "entry_id": "f2466e7b-7d27-31c8-b9ad-f01c96001d9b",
                                        "glosses": [
                                            "The self, especially with a sense of self-importance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb688b43-05ab-4602-911b-3ab97371f80d",
                                                "sense_id": "66fa48f6-57a5-377c-b77c-1aeb2c9b94b3",
                                                "text": "When every thought absorbs your attention completely, when you are so identified with the voice in your head and the emotions that accompany it that you lose yourself in every thought and every emotion, then you are totally identified with form and therefore in the grip of ego. Ego is a conglomeration of recurring thought forms and conditioned mental-emotional patterns that are invested with a sense of I, a sense of self."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dc6ec39-89c9-39ba-83e2-a1c29ce2c7c7",
                                        "entry_id": "f2466e7b-7d27-31c8-b9ad-f01c96001d9b",
                                        "glosses": [
                                            "The most central part of the mind, which mediates with one's surroundings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bbe6ef2-0799-400f-afce-57d280dd0c88",
                                                "sense_id": "8dc6ec39-89c9-39ba-83e2-a1c29ce2c7c7",
                                                "text": "In the well adjusted person the ego is the executive of the personality and is governed by the reality principle."
                                            },
                                            {
                                                "example_id": "996f0bbc-9721-4f1b-840f-646fe6159680",
                                                "sense_id": "8dc6ec39-89c9-39ba-83e2-a1c29ce2c7c7",
                                                "text": "‘Everything begins with “I”, you mean. Which is ego,’ said Tom, placing an ankle behind his ear, ‘not id.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb042854-c8eb-3071-a520-e2c58428f538",
                                        "entry_id": "f2466e7b-7d27-31c8-b9ad-f01c96001d9b",
                                        "glosses": [
                                            "A person's self-esteem and opinion of themselves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df45d3f5-630f-4294-ba48-7c4f58bf5720",
                                                "sense_id": "bb042854-c8eb-3071-a520-e2c58428f538",
                                                "text": "Too many gay people \"come out\" publicly, yet fail to achieve truly healthy egos. They \"adjust\" to being less than whole or integrated persons."
                                            },
                                            {
                                                "example_id": "4c328083-448b-4af4-a331-5092ba3ec3ea",
                                                "sense_id": "bb042854-c8eb-3071-a520-e2c58428f538",
                                                "text": "My columns in the early days of the Labour government often featured John Prescott, who was in charge of transport as part of a mega-department created to match his ego."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f836272b-db8f-3895-b29c-3e5fa493494a",
                                        "entry_id": "f2466e7b-7d27-31c8-b9ad-f01c96001d9b",
                                        "glosses": [
                                            "The individual from whose point of view a family tree or pedigree chart is drawn, or the reference point from whom kinship terminology is relative. (Used without the definite article the.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2102aaa-c6a8-4c17-953b-9f8c1cd76638",
                                                "sense_id": "f836272b-db8f-3895-b29c-3e5fa493494a",
                                                "text": "the cousin of ego on the father's side"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30264740-7482-4bd4-81cd-2e3e61febd15",
                        "source_entry_id": "81a9a8ce-b8bb-3c62-8261-b9054e497855",
