                "senses": [
                    {
                        "sense_id": "03284b2c-62b0-3221-9d0c-56a6e03d7d29",
                        "entry_id": "684e1fb7-17cd-3038-a956-60fd37a42cda",
                        "glosses": [
                            "Arrêter de suivre sur Twitter (ou un autre réseau social)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd96f675-e772-4b5d-aee6-788b06d40f8a",
                                "sense_id": "03284b2c-62b0-3221-9d0c-56a6e03d7d29",
                                "text": "Désolée, je vais \"défollower\" tout le monde, puis \"refollower\" au fur et à mesure car je m’y perds."
                            },
                            {
                                "example_id": "6b1bb73c-d878-41c7-b273-66bfc595f06d",
                                "sense_id": "03284b2c-62b0-3221-9d0c-56a6e03d7d29",
                                "text": "En réalité, il s’avère que ce sont les photos des utilisateurs qui posent problème lorsque vous affichez les listes de personnes à follower ou défollower."
                            },
                            {
                                "example_id": "553176e9-1a93-48ff-aef5-f3a98dd23819",
                                "sense_id": "03284b2c-62b0-3221-9d0c-56a6e03d7d29",
                                "text": "Pourquoi suivre quelqu’un si c'est pour le défollower ensuite ?"
                            }
                        ]
                    }
