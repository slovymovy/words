            {
                "entry_id": "21bf380e-42d8-3b43-b072-80bf9dc6ad92",
                "word": "viandeux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "81777225-6a2d-4798-9af3-422aa0872195",
                        "entry_id": "21bf380e-42d8-3b43-b072-80bf9dc6ad92",
                        "tags": [
                            "feminine"
                        ],
                        "form": "viandeuse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eaec903c-64d4-3126-af4e-06b89ebf2f67",
                        "entry_id": "21bf380e-42d8-3b43-b072-80bf9dc6ad92",
                        "glosses": [
                            "Chasseur qui cherche avant tout à rapporter le maximum de gibier : équivalent de viandard en France."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "e4d991ee-5b5c-464c-a4e5-f04d1cbadb72",
                                "sense_id": "eaec903c-64d4-3126-af4e-06b89ebf2f67",
                                "text": "Les chasseurs québécois ont un petit côté viandeux: ils aiment rapporter du gibier."
                            },
                            {
                                "example_id": "fc2320fd-5395-4475-a488-9036fef86548",
                                "sense_id": "eaec903c-64d4-3126-af4e-06b89ebf2f67",
                                "text": "Quand le gouvernement va fermer la chasse au chevreuil, ben vous ferez comme moé^([sic]) les Viandeux: VOTRE STEAK, VOUS IREZ L'ACHETER A L'ÉPICERIE PIS POUR LA CHASSE... VOUS SECHEREZ!!!!!"
                            }
                        ]
                    },
                    {
                        "sense_id": "71235cb2-48ff-3bcd-9277-62fce073524d",
                        "entry_id": "21bf380e-42d8-3b43-b072-80bf9dc6ad92",
                        "glosses": [
                            "Amateur de viande."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "cadb13c1-95d3-443e-b44e-acf859dcd080",
                                "sense_id": "71235cb2-48ff-3bcd-9277-62fce073524d",
                                "text": "Nous, collectif de citoyens, déposons plainte contre le Gang des Viandeux. Nous l’accusons de détourner de la nourriture pour sa propre consommation et ce, en très grande quantité."
                            },
                            {
                                "example_id": "2ad403de-437d-4104-8160-9b8374a7379d",
                                "sense_id": "71235cb2-48ff-3bcd-9277-62fce073524d",
                                "text": "Où s’arrêtera la criminalisation des viandeux ? Même les bouchers se cachent."
                            }
                        ]
                    }
                ],
