    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f7fc0e1f-b8ed-3567-887d-7c9f36b15e7a",
                    "sense_definition": "To strike or collide with something.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "collision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I accidentally <w>bonked</w> my head against the low ceiling while walking into the attic.",
                            "target_lang_translations": {
                                "ru": "Я случайно <w>ударился</w> головой о низкий потолок, когда заходил на чердак."
                            }
                        },
                        {
                            "text": "The two bumper cars <w>bonked</w> together, making the children laugh with delight.",
                            "target_lang_translations": {
                                "ru": "Две машинки на аттракционе <w>стукнулись</w> друг о друга, заставив детей смеяться от восторга."
                            }
                        }
                    ],
                    "synonyms": [
                        "bump",
                        "hit",
                        "knock"
                    ],
                    "common_phrases": [
                        "bonk your head"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage for hitting something"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удариться или столкнуться с чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
