                            {
                                "target_word": "skyrocket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cddd2c79-b3f6-345a-8f8d-ad4411ef1b1c",
                                        "entry_id": "df8d311a-896b-396d-a1ea-e78c81f5c860",
                                        "glosses": [
                                            "To rise or increase suddenly and extremely; to shoot up; to surge or spike."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02a3e2d3-960a-429f-a581-f98ac0955cc0",
                                                "sense_id": "cddd2c79-b3f6-345a-8f8d-ad4411ef1b1c",
                                                "text": "The shortage caused prices to skyrocket."
                                            },
                                            {
                                                "example_id": "e743e88b-9d9c-4e66-8516-a8c7a01c36ff",
                                                "sense_id": "cddd2c79-b3f6-345a-8f8d-ad4411ef1b1c",
                                                "text": "Athletes' use of herbal supplements has skyrocketed in the past two decades. At the top of the list of popular herbs are echinacea and ginseng, whereas garlic, St. John's wort, soybean, ephedra and others are also surging in popularity or have been historically prevalent."
                                            },
                                            {
                                                "example_id": "57da9b3e-281e-4115-9bd3-50663d58638c",
                                                "sense_id": "cddd2c79-b3f6-345a-8f8d-ad4411ef1b1c",
                                                "text": "A new study finds that the number of Americans being diagnosed with opioid addiction continues to skyrocket, but still very few receive any treatment."
                                            },
                                            {
                                                "example_id": "8156dccd-997e-4a5c-ba18-f1b12b526200",
                                                "sense_id": "cddd2c79-b3f6-345a-8f8d-ad4411ef1b1c",
                                                "text": "Executives from three hospitals across the country detailed their dire fiscal conditions on a conference call Saturday hosted by the American Hospital Association. This may force some to close their doors just as the need for care skyrockets amid the pandemic."
                                            },
                                            {
                                                "example_id": "2ced3600-232c-4bde-95f4-1e4b9ac6b317",
                                                "sense_id": "cddd2c79-b3f6-345a-8f8d-ad4411ef1b1c",
                                                "text": "Her career skyrocketed to new heights with the debut of her years-long Las Vegas residencies."
                                            },
                                            {
                                                "example_id": "965fe13e-b3d3-49ef-b030-94b654ed5d8f",
                                                "sense_id": "cddd2c79-b3f6-345a-8f8d-ad4411ef1b1c",
                                                "text": "The cost of keeping historic machinery operational has skyrocketed."
                                            },
                                            {
                                                "example_id": "d77ba310-c19d-456b-8c92-874533a20b36",
                                                "sense_id": "cddd2c79-b3f6-345a-8f8d-ad4411ef1b1c",
                                                "text": "Every percentage point on a mortgage rate makes a big difference for that monthly payment. But a persistent lack of homes on the market is continuing to push up home prices, which climbed in September for the 15th consecutive month, according to NAR data — on top of skyrocketing home insurance costs in some markets."
                                            },
                                            {
                                                "example_id": "8e1a3dd7-7bff-488d-ad04-42dc31a3679f",
                                                "sense_id": "cddd2c79-b3f6-345a-8f8d-ad4411ef1b1c",
                                                "text": "Said differently, your guac and your avocado toast could skyrocket if 25% tariffs are levied on Mexico."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ae2f7bd-9f76-3868-a6ee-133160514386",
                                        "entry_id": "df8d311a-896b-396d-a1ea-e78c81f5c860",
                                        "glosses": [
                                            "To cause to increase suddenly and extremely."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7440eb1-2d06-4f26-af76-b5ee85162b82",
                                                "sense_id": "2ae2f7bd-9f76-3868-a6ee-133160514386",
                                                "text": "This is an area you'll have to work out in precise detail, as it's the area most likely to skyrocket your costs—or, without careful planning, leave you with thirsty guests."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
