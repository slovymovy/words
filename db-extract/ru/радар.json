                ],
                "senses": [
                    {
                        "sense_id": "10dba511-b9f6-3547-bdf5-ad2a19fa905b",
                        "entry_id": "90edd0ad-ea9c-3bca-9cec-2d562ea7f96c",
                        "glosses": [
                            "то же, что радиолокатор; устройство для обнаружения и определения местонахождения объектов в пространстве по отражённым от них радиоволнам"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0538fbd1-acb8-4afa-99ad-81dabe806da0",
                                "sense_id": "10dba511-b9f6-3547-bdf5-ad2a19fa905b",
                                "text": "В 7.02 радары зарегистрировали появление самолётов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59e25239-cbcc-47ac-ab58-dd90949b04d1",
                        "source_entry_id": "90edd0ad-ea9c-3bca-9cec-2d562ea7f96c",
                        "source_sense_id": "10dba511-b9f6-3547-bdf5-ad2a19fa905b",
                        "target_lang_word": "radar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6315b6-2c4c-3997-af38-09d883ce6413",
                                        "entry_id": "880ff2ca-044e-3f42-aeab-0fa03df4e6a6",
                                        "glosses": [
                                            "A method of detecting distant objects and determining their position, velocity, or other characteristics by analysis of sent radio waves (usually microwaves) reflected from their surfaces."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffb71531-7b82-4045-b13f-4b1b9863d829",
                                                "sense_id": "1c6315b6-2c4c-3997-af38-09d883ce6413",
                                                "text": "They were able to find the enemy fleet using radar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63610109-2d01-30e8-ae38-98f5b1365b17",
                                        "entry_id": "880ff2ca-044e-3f42-aeab-0fa03df4e6a6",
                                        "glosses": [
                                            "A type of system using such a method, differentiated by platform, configuration, frequency, power, and other technical attributes."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "036315e9-7d72-4692-b709-2ed72a8c8490",
                                                "sense_id": "63610109-2d01-30e8-ae38-98f5b1365b17",
                                                "text": "The Ministry of Defence funded the development of an entirely new radar and improved avionics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3f06aa4-dbf9-3f25-b8f3-8ca40917ef29",
                                        "entry_id": "880ff2ca-044e-3f42-aeab-0fa03df4e6a6",
                                        "glosses": [
                                            "An installation or instance of such a system or of the transmitting and receiving apparatus."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e67b08b9-9339-498f-b89a-ec965ee4b175",
                                                "sense_id": "a3f06aa4-dbf9-3f25-b8f3-8ca40917ef29",
                                                "text": "Each of these aircraft has been upgraded with a new radar and a more powerful engine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6ec849a-3c0a-3ac6-a2af-bcf524694657",
                                        "entry_id": "880ff2ca-044e-3f42-aeab-0fa03df4e6a6",
                                        "glosses": [
                                            "A superior ability to detect something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f984beab-162b-45a0-9d97-f40b862c03fb",
                                                "sense_id": "d6ec849a-3c0a-3ac6-a2af-bcf524694657",
                                                "text": "His sensitive radar for hidden alliances keeps him out of trouble."
                                            },
                                            {
                                                "example_id": "a0d4229c-cd54-49ac-a3b8-41d5ec8fbda8",
                                                "sense_id": "d6ec849a-3c0a-3ac6-a2af-bcf524694657",
                                                "text": "It came inside 50 minutes and moments later Cavani should have had a 12th. Pogba and Shaw combined before the left-back's cross teed up the striker but his radar was awry."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "radar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a0dd1f5-bcd9-3812-8d42-476b2f28874d",
                                        "entry_id": "6e8dd7bd-b765-309b-939a-1f988672e85d",
                                        "glosses": [
                                            "To scan with radar, or as if with radar."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6459971-35e3-482c-805f-198bb09dff02",
                                                "sense_id": "9a0dd1f5-bcd9-3812-8d42-476b2f28874d",
                                                "text": "He radars you while he's sitting in his patrol vehicle under a bridge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
