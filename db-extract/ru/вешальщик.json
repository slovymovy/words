                "senses": [
                    {
                        "sense_id": "e6c0a1a3-d809-3340-812b-01658716787a",
                        "entry_id": "f282739f-b226-312d-9e59-ea8182a11ac8",
                        "glosses": [
                            "разг. тот, кто работает на вешалке, в гардеробе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8552876-088e-4b8d-955c-72a8b6144dfc",
                                "sense_id": "e6c0a1a3-d809-3340-812b-01658716787a",
                                "text": "Вешальщик, заваленный шубами, отказывался их больше брать: «Нету местов»."
                            },
                            {
                                "example_id": "5b265f4e-81d2-4986-b809-2300e8df59e4",
                                "sense_id": "e6c0a1a3-d809-3340-812b-01658716787a",
                                "text": "Васин вешальщик орёт за своим барьером: ¶ ― Пущай, ― говорит, ― этот паразит в другой раз со своей вешалкой приходит."
                            }
                        ]
                    }
                ],
