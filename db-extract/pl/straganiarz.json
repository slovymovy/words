                        ],
                        "examples": [
                            {
                                "example_id": "632bb057-c7ce-42e4-88d7-eb2dba931b29",
                                "sense_id": "597219df-4716-39ed-b7bc-f36d4b96e1f8",
                                "text": "Ten nasz znajomy straganiarz zawsze wybiera mi fajne pomidorki."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
