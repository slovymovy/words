                                    {
                                        "sense_id": "41506ecc-ac06-351c-8c3d-57f608d23bd6",
                                        "entry_id": "62ff3ead-6381-3463-a8d8-dd18acaba30e",
                                        "glosses": [
                                            "The ordinal form of the number nineteen."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d4b364c-cd28-4d3b-8376-dd97f4716d43",
                                                "sense_id": "41506ecc-ac06-351c-8c3d-57f608d23bd6",
                                                "text": "Images of Dutchness in American visual culture and literature during the nineteenth century differed radically between portrayals of the Netherlands Dutch and those of the American Dutch."
                                            },
                                            {
                                                "example_id": "f06c6bf1-41c8-4aa9-8548-9d685562f7f1",
                                                "sense_id": "41506ecc-ac06-351c-8c3d-57f608d23bd6",
                                                "text": "Fortunately, this paper does not consist of 13 pages. Otherwise, in the nineteenth century, over 15% of Americans would drop this essay without a second thought, 45% would consider throwing it away, and the remaining 40% would not be influenced by whether the paper had 13 pages or not and would have a fighting chance of actually making it to the end (Lachenmeyer 92)."
                                            },
                                            {
                                                "example_id": "7a29f5bd-dce9-475e-b51b-f4b3cd92250d",
                                                "sense_id": "41506ecc-ac06-351c-8c3d-57f608d23bd6",
                                                "text": "But in fact the antinomy of exceptionalism and assimilationism has been there all along, and otherwise puzzling decisions from the nineteenth and twentieth centuries become readily understandable when seen as moments when assimilationism was ascendant."
                                            }
                                        ]
                                    }
                                ]
