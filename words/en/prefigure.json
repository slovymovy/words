{
    "word_family": [
        "prefiguration",
        "prefigurative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87e3063f-bf15-3a0e-8f55-e30d7a241b80",
                    "sense_definition": "To show, imagine, or suggest something in advance; to represent beforehand.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "foreshadowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The early sketches clearly <w>prefigure</w> the grand themes of his later paintings."
                        },
                        {
                            "text": "Economic changes during that era seemed to <w>prefigure</w> modern globalization."
                        }
                    ],
                    "synonyms": [
                        "foreshadow",
                        "presage",
                        "portend"
                    ],
                    "common_phrases": [
                        "prefigure the future",
                        "prefigure modern developments"
                    ]
                },
                {
                    "sense_id": "bc11b119-0d15-366c-8f15-1bbd86f76ec0",
                    "sense_definition": "To foresee or predict what will happen.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "foreshadowing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Few commentators could <w>prefigure</w> how deeply the crisis would impact ordinary families."
                        },
                        {
                            "text": "The author attempted to <w>prefigure</w> the political challenges of the coming century."
                        }
                    ],
                    "synonyms": [
                        "forereckon"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7bf9ac20-cd06-3eb1-a55f-9f4654164dc7",
                    "sense_definition": "An early indication, model, or harbinger that represents something to come.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scholars often view this ancient text as a remarkable <w>prefigure</w> of modern democratic ideas."
                        },
                        {
                            "text": "In theological studies, the historical figure is analyzed as a symbolic <w>prefigure</w> of the savior."
                        }
                    ],
                    "common_phrases": [
                        "a prefigure of"
                    ]
                }
            ]
        }
    ]
}