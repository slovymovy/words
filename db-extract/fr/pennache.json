                            {
                                "example_id": "5e5bcbf3-900a-4736-b9b4-8978c5ec34c0",
                                "sense_id": "2471cd84-8fe4-3423-bdc7-d5311a8e89c0",
                                "text": "Les chefs de guerre, le tomahawk à la main, le pennache en tête, les bras et la poitrine teints de sang, prennent la gauche."
                            },
                            {
                                "example_id": "9a2a7e36-d6b7-43b3-bd8f-1c40467d5397",
                                "sense_id": "2471cd84-8fe4-3423-bdc7-d5311a8e89c0",
                                "text": "Le nom celtique est alaud, d’où nous avons formé aloue, puis alouette ; apparemment que les soldats de la Légion nommée Alauda, portoient sur leur casque un pennache qui avoit quelque rapport avec celui de l’alouette huppée."
                            }
                        ]
