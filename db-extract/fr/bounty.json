                                "target_senses": [
                                    {
                                        "sense_id": "a4720ccb-1f8d-359d-a3e2-8a06bc4a6149",
                                        "entry_id": "f9e1a9a2-9097-39a7-9c54-7c6f5d73ff16",
                                        "glosses": [
                                            "Alternative letter-case form of Oreo."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3a5bcf4-335c-4e8d-b1b4-69c4ca08145b",
                                                "sense_id": "a4720ccb-1f8d-359d-a3e2-8a06bc4a6149",
                                                "text": "The young woman said, \"Well, actually we do have one minority student.\"\nThe young man chimed in, \"Yeah, but he's an oreo.\"\n\"An oreo?\" I asked. \"Please define the term oreo.\"\n\"You know,\" the young man said. \"Black on the outside, and white in the middle.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
