                "senses": [
                    {
                        "sense_id": "ec62a8d3-3f9d-31f6-9e45-77de3bb84c70",
                        "entry_id": "a9367f80-6b7b-3062-bde8-e06436b84856",
                        "glosses": [
                            "über der Mitte einer Straßenkreuzung an Drahtseilen befestigte Ampel mit roten und grünen Kreissegmenten und einem Zeiger, der die jeweilige Rot- beziehungsweise Grünphase signalisierte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6879445e-fa6a-42c0-a339-d4c4fa15b342",
                                "sense_id": "ec62a8d3-3f9d-31f6-9e45-77de3bb84c70",
                                "text": "„Mit dem Ausbau der Georgstraße 1963 und dem damit einhergehenden Aufbau moderner Signalanlagen verschwand die Heuerampel.“"
                            },
                            {
                                "example_id": "e1ec6624-523a-48a4-9164-6349070a0af5",
                                "sense_id": "ec62a8d3-3f9d-31f6-9e45-77de3bb84c70",
                                "text": "„Auf der Kreuzung von Jahn- und Werrestraße sowie Lübbertor und Mindener Straße stand in den 1960er-Jahren eine Heuerampel.“"
                            },
                            {
                                "example_id": "6ec59d97-df50-43b1-ae30-501d85b93efa",
                                "sense_id": "ec62a8d3-3f9d-31f6-9e45-77de3bb84c70",
                                "text": "„Den Verkehr regelte für einige Jahre eine Zeigerampel, die damals moderne Heuerampel, eine von vieren in Detmold.“"
                            },
                            {
                                "example_id": "48fce6a8-27ad-48de-beda-88e0fe0366a5",
                                "sense_id": "ec62a8d3-3f9d-31f6-9e45-77de3bb84c70",
                                "text": "„Die unabhängige Variable ist die Art der Verkehrsregelung - etwa der Vergleich von Heuerampeln mit den jetzt üblichen Ampeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
