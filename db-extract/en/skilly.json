                        "examples": [
                            {
                                "example_id": "0808a724-4fcc-4c14-b148-92f0126d78a3",
                                "sense_id": "41aa7b21-d1a5-34aa-bfbb-1130e40eb26e",
                                "text": "“I would be given for supper six ounces of bread and ‘three parts of skilly.’ ‘Three parts’ means three-quarters of a pint, and ‘skilly’ is a fluid concoction of three quarts of oatmeal stirred into three buckets and a half of hot water.”"
                            },
                            {
                                "example_id": "028bad1e-5a30-4c10-b4d8-5160a927b69c",
                                "sense_id": "41aa7b21-d1a5-34aa-bfbb-1130e40eb26e",
                                "text": "Of course unlike the officers we never got fresh bread, we got what came from barrels stored in the lower peak and under the steward's padlock. Pantiles baked brick hard, mouldy oats for skilly, dried peas for soup, embalmed pork and beef more fat and bone than meat."
                            }
                        ]
                    }
