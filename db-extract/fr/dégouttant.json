                "senses": [
                    {
                        "sense_id": "218979cd-9993-306b-92cc-8e54c4b57bcf",
                        "entry_id": "92f2a3e4-0627-339c-874a-83071dc55d12",
                        "glosses": [
                            "Qui dégoutte, c’est-à-dire qui coule goutte à goutte, qui dégouline."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b06813ef-10bc-4f77-ad9b-db3d3ccdf578",
                                "sense_id": "218979cd-9993-306b-92cc-8e54c4b57bcf",
                                "text": "Ces hommes ont des mœurs à eux, des femmes à eux, un langage à eux, langage mystérieux, rempli d’images funestes, de métaphores dégouttantes de sang."
                            },
                            {
                                "example_id": "e12f4ce8-d6e8-426b-8871-55e7b42ef4da",
                                "sense_id": "218979cd-9993-306b-92cc-8e54c4b57bcf",
                                "text": "Rien qui fût humain, en somme, car pour le bras, libre encore, et dégouttant par ses blessures, il évoquait plutôt l'idée d'une pince de homard."
                            },
                            {
                                "example_id": "aeacbaa9-c8d9-4d03-b56f-81104e9e13e6",
                                "sense_id": "218979cd-9993-306b-92cc-8e54c4b57bcf",
                                "text": "Les uns écrasent leur pinceau dégouttant de rouge sur le nez d’un souverain, d’autres chamarrent de couleurs voyantes les robes des princesses."
                            },
                            {
                                "example_id": "81b0f699-9593-4590-9dfc-b0dabd8461b0",
                                "sense_id": "218979cd-9993-306b-92cc-8e54c4b57bcf",
                                "text": "Au dehors, il pleuvait et il retrouva avec effroi les grands feuillages rouillés et dégouttants qui battaient sa fenêtre."
                            }
                        ]
                    }
                ],
