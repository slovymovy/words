                    "sense_id": "34161088-8ac1-364d-9ed3-a44a39b19476",
                    "sense_definition": "Het periodiek verliezen en vernieuwen van veren, haar of huid door dieren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Onze hond begint flink te <w>ruien</w> nu het warmer weer wordt.",
                            "target_lang_translations": {
                                "en": "Our dog is starting to <w>shed</w> heavily now that the weather is getting warmer."
                            }
                        },
                        {
                            "text": "Deze vogels hebben dit jaar nog niet <w>geruid</w>.",
                            "target_lang_translations": {
                                "en": "These birds have not <w>moulted</w> yet this year."
                            }
                        }
                    ],
