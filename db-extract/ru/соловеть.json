                "senses": [
                    {
                        "sense_id": "231f3d4a-e9bb-3e03-a098-8f6685cf0aae",
                        "entry_id": "6840b610-b1db-3f37-be1a-80abfb9fff6b",
                        "glosses": [
                            "cтановиться соловым или более соловым"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "23be9976-b103-3060-8a15-a0cd8b7d2e4f",
                        "entry_id": "6840b610-b1db-3f37-be1a-80abfb9fff6b",
                        "glosses": [
                            "разг. становиться мутным, невыразительным при опьянении, болезни (о взгляде, взоре)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd743a6a-3c03-459b-bcd7-0bb25976572a",
                                "sense_id": "23be9976-b103-3060-8a15-a0cd8b7d2e4f",
                                "text": "И чем обильней валил дым и вспыхивала огнём бумага, тем больше соловели золотушные Петькины глаза."
                            }
                        ]
                    },
                    {
                        "sense_id": "21626bcd-940b-382e-a407-f97f2573b51e",
                        "entry_id": "6840b610-b1db-3f37-be1a-80abfb9fff6b",
                        "glosses": [
                            "разг. становиться вялым, сонным от усталости, опьянения (о человеке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3d3baae-b054-47df-a36f-9597eb1b69ba",
                                "sense_id": "21626bcd-940b-382e-a407-f97f2573b51e",
                                "text": "Насытившись же, она игнорировала свой духовный мир, потому что соловела и временно уже ничего больше не желала."
                            }
                        ]
                    }
