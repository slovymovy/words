                        "examples": [
                            {
                                "example_id": "d53dd5f1-6878-4f66-b5f3-ae30f33ef9ac",
                                "sense_id": "3ade67ed-e686-3177-a651-6508b6978d1e",
                                "text": "The first list includes the generally accepted families of the neogaean—or new world—birds, embracing both those peculiar to America and those found in the old world […]"
                            },
                            {
                                "example_id": "5b407534-98d1-412a-8bc9-0ef46b0288e9",
                                "sense_id": "3ade67ed-e686-3177-a651-6508b6978d1e",
                                "text": "We are quite satisfied that such a characteristic and deviating plant of the tribe of the Bromeae is placed in a distinct genus, which is at the same time quite in accordance with its curious neogaean distribution."
                            },
                            {
                                "example_id": "c9c69ebb-c24f-4212-91d9-1e6dd4d9efeb",
                                "sense_id": "3ade67ed-e686-3177-a651-6508b6978d1e",
                                "text": "The study of many specimens belonging to both gerontogaean and neogaean species of the group has shown me […] the best characteristics to distinguish the different species […]"
                            }
                        ]
                    }
