                        "glosses": [
                            "Faire passer un examen audiométrique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afafe642-9bcc-4747-b837-29d7acb07929",
                                "sense_id": "2f89dcc9-a498-343e-86cb-08b95629a7e2",
                                "text": "J'ai fait pipi dans un bocal (mention spéciale à l'infirmier qui devant la file d'attente qui s'allongeait a eu cette heureuse formule \"ça va être miction impossible\"), j'ai été saigné, audiométrisé, tympannogramisé, électrocartographié, ophtalmisé puis ausculté."
                            },
                            {
                                "example_id": "9c080a4c-b39a-4795-9a09-a9cad4f095e8",
                                "sense_id": "2f89dcc9-a498-343e-86cb-08b95629a7e2",
                                "text": "On peut dire que les travailleurs, qui ont été audiométrisés, présentent des traumatismes du bruit."
                            }
                        ]
                    }
