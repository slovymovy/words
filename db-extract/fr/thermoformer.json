                        "glosses": [
                            "Donner une forme par thermoformage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e600639-8a86-4921-85d3-d4c7d8b43f5d",
                                "sense_id": "60f74b64-a793-3465-b316-b4d685e5897f",
                                "text": "Des essais ont été menés en France pour thermoformer des barquettes biodégradables à partir d’amidon de manioc."
                            },
                            {
                                "example_id": "dbd459ac-afd5-4ae0-814e-ac1e3a03e587",
                                "sense_id": "60f74b64-a793-3465-b316-b4d685e5897f",
                                "text": "Pour thermoformer les tubes en plastique sans qu’ils s’affaissent, on les remplit de sable et on bouche les extrémités (à gauche)."
                            }
                        ]
                    }
