                                        "sense_id": "a92d6aab-8420-323a-afd9-97bd6277f949",
                                        "entry_id": "6b77b01c-a135-30cf-8b32-bd5029bfc0b8",
                                        "glosses": [
                                            "Qui reproduit les maximes, les principes de telle ou telle doctrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54af2c27-b129-45e6-aa99-045521016917",
                                                "sense_id": "a92d6aab-8420-323a-afd9-97bd6277f949",
                                                "text": "Avis doctrinal."
                                            },
                                            {
                                                "example_id": "c14f25a0-bec9-4dc2-8dfc-0801f874725a",
                                                "sense_id": "a92d6aab-8420-323a-afd9-97bd6277f949",
                                                "text": "Jugement doctrinal."
                                            },
                                            {
                                                "example_id": "a9df6a7c-972b-4457-88b1-3c519e4f7d78",
                                                "sense_id": "a92d6aab-8420-323a-afd9-97bd6277f949",
                                                "text": "Exposition doctrinale."
                                            },
                                            {
                                                "example_id": "c283adce-f0c3-45bd-9908-d26936fb6690",
                                                "sense_id": "a92d6aab-8420-323a-afd9-97bd6277f949",
                                                "text": "Les universités donnaient des avis doctrinaux sur les livres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6c42897-4a48-3721-8e59-c27e1114ec7b",
                                        "entry_id": "6b77b01c-a135-30cf-8b32-bd5029bfc0b8",
                                        "glosses": [
                                            "Relatif à une pensée directrice."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30c956a9-4240-46cb-9f14-067a82ad2a82",
                                                "sense_id": "c6c42897-4a48-3721-8e59-c27e1114ec7b",
                                                "text": "Ce changement de cap, après l'engagement pris par Londres en 2010 de le réduire d'ici la mi-décennie 2020, est justifié par une \"gamme croissante de menaces technologiques et doctrinales\", selon le document."
                                            },
                                            {
                                                "example_id": "a34933bd-2abe-406c-b2f9-0c5ed389187b",
                                                "sense_id": "c6c42897-4a48-3721-8e59-c27e1114ec7b",
                                                "text": "Les courants doctrinaux actuels laissent à penser que le processus séquencé n’est pas définitivement enterré par le développement des marchés globaux."
                                            }
                                        ]
                                    }
                                ]
