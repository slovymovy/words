                    {
                        "sense_id": "84de383e-e461-3850-beeb-290eb4dad3ef",
                        "entry_id": "8eb62126-6b8e-3a5b-a171-57c1ede7bb32",
                        "glosses": [
                            "gedeeld door één miljoen"
