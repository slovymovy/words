                        ],
                        "examples": [
                            {
                                "example_id": "2df5bbd6-11a0-41f5-ae03-14455372776a",
                                "sense_id": "faf4ab24-0e70-3f03-bf35-a6421b30b560",
                                "text": "„Mann, bist du ein Bünzli! Nur weil da so eine kleine, blöde Verbotstafel steht, wirst du zur Memme! Nun fahr doch einfach durch. Stell dich doch nicht so an!“, fauchte mich Friedel von der Seite an."
                            }
                        ]
                    }
