{
    "word_family": [
        "shelf",
        "shelving"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3ccbe74-0b66-3e00-9994-6430fa6ca9d9",
                    "sense_definition": "To install shelves in a room or piece of furniture.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We plan to <w>shelve</w> the entire study to create more storage space for books.",
                            "target_lang_translations": {
                                "ru": "Мы планируем <w>оборудовать полками</w> весь кабинет, чтобы создать больше места для хранения книг."
                            }
                        },
                        {
                            "text": "It is expensive to <w>shelve</w> a large library with custom-made wood.",
                            "target_lang_translations": {
                                "ru": "Дорого <w>оборудовать полками</w> большую библиотеку деревом, сделанным на заказ."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устанавливать полки в комнате или предмете мебели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оборудовать полками",
                                "target_lang_sense_clarification": "процесс установки полок в помещении"
                            },
                            {
                                "target_lang_word": "стеллажировать",
                                "target_lang_sense_clarification": "установка стеллажей или полок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b22bbb3-1a02-3c6b-a64d-71b15831c512",
                    "sense_definition": "To place items, especially books, onto a shelf.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The librarian asked the volunteers to <w>shelve</w> the new arrivals by author name.",
                            "target_lang_translations": {
                                "ru": "Библиотекарь попросил волонтеров <w>расставить по полкам</w> новые поступления по фамилиям авторов."
                            }
                        },
                        {
                            "text": "After reading, please <w>shelve</w> the books back in their proper places.",
                            "target_lang_translations": {
                                "ru": "После прочтения, пожалуйста, <w>поставьте книги обратно на полки</w> на их места."
                            }
                        }
                    ],
                    "antonyms": [
                        "deshelve",
                        "unshelve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставить предметы, особенно книги, на полку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расставлять по полкам",
                                "target_lang_sense_clarification": "упорядочивание книг или предметов"
                            },
                            {
                                "target_lang_word": "ставить на полку",
                                "target_lang_sense_clarification": "размещение предмета на полке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "623def43-5825-383c-b0a4-449620bfee84",
                    "sense_definition": "To postpone or stop working on a project or plan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "postponement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company decided to <w>shelve</w> the project due to a lack of funding.",
                            "target_lang_translations": {
                                "ru": "Компания решила <w>отложить</w> проект из-за нехватки финансирования."
                            }
                        },
                        {
                            "text": "Management had to <w>shelve</w> the new marketing plan until next year.",
                            "target_lang_translations": {
                                "ru": "Руководству пришлось <w>отложить</w> новый маркетинговый план до следующего года."
                            }
                        }
                    ],
                    "synonyms": [
                        "mothball",
                        "pigeonhole",
                        "table"
                    ],
                    "target_lang_definitions": {
                        "ru": "Откладывать или прекращать работу над проектом или планом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откладывать в долгий ящик",
                                "target_lang_sense_clarification": "идиоматическое выражение для отсрочки"
                            },
                            {
                                "target_lang_word": "замораживать",
                                "target_lang_sense_clarification": "приостановка проекта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f9f16e1-4ff4-3316-a003-0c2292ee8d05",
                    "sense_definition": "To slope or incline downwards.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beach <w>shelves</w> gently into the water, making it safe for children.",
                            "target_lang_translations": {
                                "ru": "Пляж <w>полого спускается</w> в воду, что делает его безопасным для детей."
                            }
                        },
                        {
                            "text": "The rocky path <w>shelves</w> down toward the riverbank.",
                            "target_lang_translations": {
                                "ru": "Каменистая тропа <w>полого спускается</w> к берегу реки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь наклон или спускаться вниз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полого спускаться",
                                "target_lang_sense_clarification": "о ландшафте или дне водоема"
                            },
                            {
                                "target_lang_word": "идти под уклон",
                                "target_lang_sense_clarification": "о рельефе местности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07f9405a-fd76-394b-b9ec-147733a91406",
                    "sense_definition": "A flat, horizontal ledge on a cliff or mountain.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The climber found a narrow <w>shelf</w> to rest on halfway up the cliff.",
                            "target_lang_translations": {
                                "ru": "Альпинист нашел узкий <w>уступ</w>, чтобы отдохнуть на полпути вверх по скале."
                            }
                        },
                        {
                            "text": "A small <w>shelf</w> of rock provided the only shelter from the wind.",
                            "target_lang_translations": {
                                "ru": "Небольшой каменный <w>уступ</w> стал единственным укрытием от ветра."
                            }
                        }
                    ],
                    "synonyms": [
                        "ledge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоский горизонтальный выступ на скале или горе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уступ",
                                "target_lang_sense_clarification": "выступ на скале или горе"
                            },
                            {
                                "target_lang_word": "карниз",
                                "target_lang_sense_clarification": "узкий горизонтальный выступ"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}