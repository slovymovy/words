                "senses": [
                    {
                        "sense_id": "24d46b08-32b0-39a1-84b1-ee82f750cf17",
                        "entry_id": "3519388a-513c-39dc-93c7-f2c7f419069c",
                        "glosses": [
                            "Front, die im Osten eines Gebietes verläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "905da73e-0abe-465b-9c21-bcffe6605930",
                                "sense_id": "24d46b08-32b0-39a1-84b1-ee82f750cf17",
                                "text": "„Die Ostfront war im Ersten Weltkrieg der Hauptschauplatz der Kriegshandlungen der Mittelmächte Deutschland und Österreich-Ungarn mit Russland. Das Kriegsgebiet umfasste große Teile Osteuropas und reichte nach dem Kriegseintritt Rumäniens 1916 schließlich vom Baltikum bis zum Schwarzen Meer.“"
                            },
                            {
                                "example_id": "26bce6a3-8728-4e5b-b763-960d14acb3a9",
                                "sense_id": "24d46b08-32b0-39a1-84b1-ee82f750cf17",
                                "text": "„Ich hatte einen polnischen Großvater, der auf den Namen Tarkowski hörte und während des Zweiten Weltkrieges Zwangsarbeiter in Deutschland war; ich habe einen deutschen Großvater, der Botta hieß und zur selben Zeit für die Wehrmacht an der Ostfront kämpfte.“"
                            },
                            {
                                "example_id": "1756f1ca-e51d-4e9f-b378-7b7a35ce9b54",
                                "sense_id": "24d46b08-32b0-39a1-84b1-ee82f750cf17",
                                "text": "„An der türkischen Ostfront erzielte Kemal unterdessen die ersten militärischen Erfolge.“"
                            },
                            {
                                "example_id": "3c562e07-b7b5-484e-b93a-07ce1ef5b0c4",
                                "sense_id": "24d46b08-32b0-39a1-84b1-ee82f750cf17",
                                "text": "„Alles, was die Tochter des Klempners zu berichten wußte, war, daß ihr Mann nicht nach Kreta, sondern an die Ostfront beordert worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7708fe51-4f46-3c38-b851-2b3477391394",
                        "entry_id": "3519388a-513c-39dc-93c7-f2c7f419069c",
                        "glosses": [
                            "östliche Stirnseite eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edea9a14-7d0f-4fbd-bb1f-158caaed1f17",
                                "sense_id": "7708fe51-4f46-3c38-b851-2b3477391394",
                                "text": "„Das 20. Jahrhundert sah vor allem die Ausweitung des Kapitols auf den Kapitolkomplex: Abgeordnetenbüros, die Library of Congress und der Supreme Court zogen aus dem Kapitol aus und in angrenzende neue Gebäude. Im Kapitol selbst rückte die Ostfront einige Meter nach vorne.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
