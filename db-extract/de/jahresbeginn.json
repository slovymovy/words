                ],
                "senses": [
                    {
                        "sense_id": "fe18083d-a639-303b-b0be-9c3353c23b77",
                        "entry_id": "c08cdaf0-a299-3bb1-87b0-4845ffaaeed1",
                        "glosses": [
                            "Début d'année, début de l'année."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69ae8a15-2c49-4324-bffd-9814f83277f4",
                                "sense_id": "fe18083d-a639-303b-b0be-9c3353c23b77",
                                "text": "Seit Jahresbeginn fällt der Index nahezu täglich, von 1076 bis zuletzt auf 415 Punkte.",
                                "translation": "Depuis le début de l'année, l'indice chute presque quotidiennement, passant de 1076 à 415 points dernièrement."
                            },
                            {
                                "example_id": "54cdb670-d0c6-4a6a-a52e-fdc74a7193ac",
                                "sense_id": "fe18083d-a639-303b-b0be-9c3353c23b77",
                                "text": "In Italien trägt man zum Jahresbeginn rote Unterwäsche, verspeist Linsen mit Cotechino, einer Schweinswurst, oder mit Zampone, gefülltem Schweinsfuß.",
                                "translation": "En Italie, on porte des sous-vêtements rouges en début d'année, on mange des lentilles avec du cotechino, une saucisse de porc, ou du zampone, un pied de porc farci."
                            }
                        ]
                    }
                ],
