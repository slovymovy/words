{
    "word_family": [
        "Willkür",
        "Willkürakt",
        "Willkürherrschaft",
        "unwillkürlich"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dad6a1bb-2be2-3a7f-bf91-49f4325958b5",
                    "sense_definition": "Ohne sachliche Begründung und nur dem eigenen Gutdünken folgend; ungerechtfertigt oder herrisch handelnd.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ungerechtfertigt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Bürger protestierten gegen die <w>willkürliche</w> Verhaftung des bekannten Journalisten."
                        },
                        {
                            "text": "Seine Entscheidungen wirkten auf die Mitarbeiter oft völlig <w>willkürlich</w> und ungerecht."
                        }
                    ],
                    "synonyms": [
                        "diktatorisch"
                    ],
                    "common_phrases": [
                        "eine willkürliche Entscheidung",
                        "willkürliche Verhaftungen"
                    ]
                },
                {
                    "sense_id": "8d9df2f5-6d15-3bb9-9082-2323d1b8f4c4",
                    "sense_definition": "Frei nach Belieben oder zufällig gewählt; ohne feste Regel oder zwingende Notwendigkeit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zufällig",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Reihenfolge der Namen auf dieser Liste war rein <w>willkürlich</w> gewählt worden."
                        },
                        {
                            "text": "Wir trafen eine <w>willkürliche</w> Auswahl aus den zahlreichen Bewerbungen für die Stelle."
                        }
                    ],
                    "synonyms": [
                        "arbiträr"
                    ],
                    "common_phrases": [
                        "eine willkürliche Auswahl",
                        "eine willkürliche Reihenfolge"
                    ]
                },
                {
                    "sense_id": "89ec0415-cefd-3cc0-a880-ab2709be0f4a",
                    "sense_definition": "Durch den eigenen Willen steuerbar; bewusst herbeigeführt (besonders bei Körperfunktionen oder Bewegungen).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "willentlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Manche Muskeln im menschlichen Körper können wir nicht <w>willkürlich</w> steuern."
                        },
                        {
                            "text": "Ein Lidschlag kann ein Reflex oder eine <w>willkürliche</w> Bewegung der Augen sein."
                        }
                    ],
                    "synonyms": [
                        "willentlich",
                        "bewusst"
                    ],
                    "antonyms": [
                        "unwillkürlich"
                    ],
                    "common_phrases": [
                        "eine willkürliche Bewegung"
                    ]
                },
                {
                    "sense_id": "4f569c82-c599-39bd-869e-a0d4d2061e4f",
                    "sense_definition": "Sprachwissenschaft: nicht auf einer natürlichen Ähnlichkeit zwischen Zeichen und Bezeichnetem beruhend.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "arbiträr",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Beziehung zwischen dem Wort und dem bezeichneten Gegenstand ist rein <w>willkürlich</w>."
                        },
                        {
                            "text": "In der Sprachwissenschaft gilt die Verbindung von Lautform und Bedeutung als <w>willkürlich</w>."
                        }
                    ],
                    "synonyms": [
                        "arbiträr"
                    ],
                    "common_phrases": [
                        "ein willkürliches Zeichen"
                    ]
                }
            ]
        }
    ]
}