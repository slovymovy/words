                    {
                        "translation_id": "a5b2b42c-b67b-4ab4-877c-037847c9f3df",
                        "source_entry_id": "a8ded6f8-8a67-3770-aed0-5817aa790d77",
                        "source_sense_id": "a847f457-ffa9-3fa5-b6e1-8742ac8fa69e",
                        "source_sense_description": "aanwezigheid",
                        "target_lang_word": "Anwesenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anwesenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd5c84c9-8391-366e-a04e-4de9e7a97f32",
                                        "entry_id": "5820ad2e-1c21-3b21-9afb-4a61ed06d74c",
                                        "glosses": [
                                            "der Zustand des körperlichen und/oder geistigen Zugegen-Seins"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "341743d6-038d-4018-87c8-498bc42c55cf",
                                                "sense_id": "dd5c84c9-8391-366e-a04e-4de9e7a97f32",
                                                "text": "Sie glänzte schon durch ihre bloße Anwesenheit."
                                            },
                                            {
                                                "example_id": "d4259b11-98d4-4472-be98-54f91e280da8",
                                                "sense_id": "dd5c84c9-8391-366e-a04e-4de9e7a97f32",
                                                "text": "„Während Block redete, vergaß Markus die Anwesenheit Rowes völlig; erst als sein Partner seinen Vortrag beendete, fiel ihm der Vorstandsvorsitzende und Investor wieder ein.“"
                                            },
                                            {
                                                "example_id": "a3540c04-9ca4-45d5-a19b-468ab0ffe722",
                                                "sense_id": "dd5c84c9-8391-366e-a04e-4de9e7a97f32",
                                                "text": "„In ganz Paris ging das Gerücht von der Anwesenheit des weißen Wilden um und erreichte auch die Zeitungen.“"
                                            },
                                            {
                                                "example_id": "7b451855-1256-4d11-ae0a-cd465b8da8d1",
                                                "sense_id": "dd5c84c9-8391-366e-a04e-4de9e7a97f32",
                                                "text": "„Als Kardinal Anton Gruscha die Initiative ergriff, ordnete Franz Joseph I. am 18. April 1896 dem Kultusministerium die Bereitstellung der Geldmittel an; die Grundsteinlegung erfolgte am 10. Oktober 1896 in seiner Anwesenheit.“"
                                            },
                                            {
                                                "example_id": "30fa38df-5f7d-45aa-b53f-02e6c00fd223",
                                                "sense_id": "dd5c84c9-8391-366e-a04e-4de9e7a97f32",
                                                "text": "„Er bot an, mir einen Diener mitzuschicken auf die Suche nach meiner Schwester, doch ich wollte nicht, dass zu viele Leute von meiner Anwesenheit erfuhren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e22da27b-469b-4764-82f9-b4ceb9a66cf7",
                        "source_entry_id": "a8ded6f8-8a67-3770-aed0-5817aa790d77",
