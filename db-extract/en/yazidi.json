                                        "sense_id": "88c7f4d7-4e9a-3e3c-a34f-fd1e694d7f71",
                                        "entry_id": "0992ef81-d7d7-313c-b0b3-7e4ecf70d02e",
                                        "glosses": [
                                            "variante de Yazidi, membre d’une communauté kurde d’Irak pratiquant le yézidisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "512da407-4ebe-4e98-90e5-b226285a4048",
                                                "sense_id": "88c7f4d7-4e9a-3e3c-a34f-fd1e694d7f71",
                                                "text": "Les Yézidis sont considérés par les djihadistes comme des « adorateurs du diable »."
                                            },
                                            {
                                                "example_id": "b9ab51c9-44c8-4d5b-a71a-7fc5ac186a9d",
                                                "sense_id": "88c7f4d7-4e9a-3e3c-a34f-fd1e694d7f71",
                                                "text": "Des milliers de Yézidis, une minorité religieuse kurdophone, ont été tués ou capturés par les hommes de l’EI."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8625742b-27fc-472e-8e97-1bc3823504ae",
                        "source_entry_id": "ca23c210-33fc-3078-84bd-572eddf26a75",
                        "source_sense_id": "059110db-fba6-3109-bea8-abf021bf6db2",
                        "source_sense_description": "member of a Kurdish-speaking people of northern Iraq, whose religion is Yazidism",
                        "target_lang_word": "Yézidie",
