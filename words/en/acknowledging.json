    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7b288bb0-7f08-3892-b7de-499ad2ac8661",
                    "sense_definition": "Present participle and gerund of <w>acknowledge</w>.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are writing this letter for the purpose of <w>acknowledging</w> receipt of your application.",
                            "target_lang_translations": {
                                "ru": "Мы пишем это письмо с целью <w>подтверждения</w> получения вашей заявки.",
                                "nl": "Wij schrijven deze brief ter <w>bevestiging</w> van de ontvangst van uw sollicitatie."
                            }
                        },
                        {
                            "text": "He walked right past me without even <w>acknowledging</w> my presence.",
                            "target_lang_translations": {
                                "ru": "Он прошел прямо мимо меня, даже не <w>заметив</w> моего присутствия.",
                                "nl": "Hij liep me straal voorbij zonder zelfs mijn aanwezigheid <w>op te merken</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "acknowledging receipt",
                        "acknowledging the fact",
                        "acknowledging a mistake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола acknowledge.",
                        "nl": "Onvoltooid deelwoord en gerundium van acknowledge."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтверждать",
                                "target_lang_sense_clarification": "сообщать о получении чего-либо"
                            },
                            {
                                "target_lang_word": "признавать",
                                "target_lang_sense_clarification": "соглашаться с фактом или истиной"
                            },
                            {
                                "target_lang_word": "замечать",
                                "target_lang_sense_clarification": "обращать внимание на чье-то присутствие"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "erkennen",
                                "target_lang_sense_clarification": "toegeven of accepteren als waarheid"
                            },
                            {
                                "target_lang_word": "bevestigen",
                                "target_lang_sense_clarification": "de ontvangst van iets melden"
                            },
                            {
                                "target_lang_word": "opmerken",
                                "target_lang_sense_clarification": "laten merken dat je iemands aanwezigheid ziet"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f69570ae-bb28-39ea-be8e-f2383163a86d",
                    "sense_definition": "Serving to notice, recognize, or show awareness of someone or something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager gave an <w>acknowledging</w> nod to the employee who entered the room.",
                            "target_lang_translations": {
                                "ru": "Менеджер сделал <w>приветственный</w> кивок вошедшему сотруднику.",
                                "nl": "De manager gaf een <w>begroetend</w> knikje aan de medewerker die de kamer binnenkwam."
                            }
                        },
                        {
                            "text": "She flashed a brief, <w>acknowledging</w> smile before returning to her work.",
                            "target_lang_translations": {
                                "ru": "Она одарила его быстрой <w>приветливой</w> улыбкой, прежде чем вернуться к работе.",
                                "nl": "Ze gaf een korte, <w>begripvolle</w> glimlach voordat ze weer aan het werk ging."
                            }
                        }
                    ],
                    "common_phrases": [
                        "acknowledging nod",
                        "acknowledging smile",
                        "acknowledging glance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служащий для выражения внимания, узнавания или осознания чьего-либо присутствия.",
                        "nl": "Dienend om iemands aanwezigheid op te merken, te herkennen of te begroeten."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приветственный",
                                "target_lang_sense_clarification": "выражающий приветствие или узнавание (о жесте)"
                            },
                            {
                                "target_lang_word": "понимающий",
                                "target_lang_sense_clarification": "выражающий понимание или осведомленность"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "bevestigend",
                                "target_lang_sense_clarification": "blijk gevend van herkenning of begrip"
                            },
                            {
                                "target_lang_word": "begroetend",
                                "target_lang_sense_clarification": "ter herkenning of als groet"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0b5ac26-1e62-3a2c-abdc-720fabb30bd0",
                    "sense_definition": "The act of admitting, recognizing, or accepting something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His sudden <w>acknowledging</w> of the truth surprised everyone in the meeting.",
                            "target_lang_translations": {
                                "ru": "Его внезапное <w>признание</w> правды удивило всех на собрании.",
                                "nl": "Zijn plotselinge <w>erkenning</w> van de waarheid verraste iedereen in de vergadering."
                            }
                        },
                        {
                            "text": "The <w>acknowledging</w> of one's own faults is often the hardest part of personal growth.",
                            "target_lang_translations": {
                                "ru": "<w>Признание</w> собственных ошибок часто является самой сложной частью личностного роста.",
                                "nl": "Het <w>erkennen</w> van je eigen fouten is vaak het moeilijkste onderdeel van persoonlijke groei."
                            }
                        }
                    ],
                    "synonyms": [
                        "acknowledgement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по признанию, принятию или подтверждению чего-либо.",
                        "nl": "De handeling van het toegeven, erkennen of aanvaarden van iets."
                    },
                    "translations": {
