                    {
                        "sense_id": "2ff6f453-921d-3c82-9c77-c1af8025f77b",
                        "entry_id": "f0d4491b-e7ce-3db7-bab3-f4834c4bab21",
                        "glosses": [
                            "Stelle, an der sich ein Weg gabelt"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "e66f0ff9-f907-4047-888f-e4337fa758f4",
                                "sense_id": "2ff6f453-921d-3c82-9c77-c1af8025f77b",
                                "text": "„An der Wegscheide blieb Bob einen Augenblick stehen, als besänne er sich, wohin er gehen solle; da fuhr wieder das Stacheleisen auf seinen Rücken nieder.“"
                            },
                            {
                                "example_id": "011d7001-809f-4130-8865-d0fee83cb40b",
                                "sense_id": "2ff6f453-921d-3c82-9c77-c1af8025f77b",
                                "text": "„Schließlich hatte er so viele Wegscheiden hinter sich gebracht, daß er keine Ahnung mehr hatte, welcher Weg nach dem Reich des Dänenkönigs führte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
