                "entry_id": "59449b0a-ecf4-3a2b-89c6-1752d50cb8dd",
                "word": "sentencieusement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5a8bf355-5067-349d-b8bb-a675e0af4bbb",
                        "entry_id": "59449b0a-ecf4-3a2b-89c6-1752d50cb8dd",
                        "glosses": [
                            "D’une manière sentencieuse."
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "34e0fc3c-c36b-40bf-b609-7985f64edf8c",
                                "sense_id": "5a8bf355-5067-349d-b8bb-a675e0af4bbb",
                                "text": "Les sentences sont un grand ornement de l'histoire, pourvu qu'elles n'y soient pas proposées sentencieusement"
                            },
                            {
                                "example_id": "6d1fced9-c93c-4db4-899f-52f21e006322",
                                "sense_id": "5a8bf355-5067-349d-b8bb-a675e0af4bbb",
                                "text": "Le maréchal de Villeroy faisait remarquer au roi [enfant] cette multitude prodigieuse, et sentencieusement lui disait : Voyez, mon maître, voyez tout ce peuple, cette affluence, ce nombre de peuple immense, tout cela est à vous"
                            },
                            {
                                "example_id": "0a1a72fe-a44d-478f-89e9-97d70c7edb85",
                                "sense_id": "5a8bf355-5067-349d-b8bb-a675e0af4bbb",
                                "text": "Les Indiens se vengent toujours, capitaine, dit sentencieusement le vieux chasseur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a722b0d-3b27-42a3-8ccb-bb6f9a089f71",
                        "source_entry_id": "59449b0a-ecf4-3a2b-89c6-1752d50cb8dd",
                        "source_sense_id": "5a8bf355-5067-349d-b8bb-a675e0af4bbb",
                        "target_lang_word": "sententiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sententiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28a86d9d-dfc7-34a6-a6e8-ba3b0048f201",
                                        "entry_id": "2e3fd57c-9884-3bee-ae08-64648f4f3b48",
                                        "glosses": [
                                            "In a sententious manner, concisely, pithily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce88b5bc-ebec-4440-ac4c-c2f329964611",
                                                "sense_id": "28a86d9d-dfc7-34a6-a6e8-ba3b0048f201",
                                                "text": "\"We shall see to-morrow,\" said the doctor. \"We shall,\" replied Lady Anne, very sententiously."
                                            },
                                            {
                                                "example_id": "fd2a3b1c-cc35-4099-b088-2f63a75ea8c6",
                                                "sense_id": "28a86d9d-dfc7-34a6-a6e8-ba3b0048f201",
                                                "text": "\"It 's an ill wind dat blows nowhar, — dat ar a fact,\" said Sam, sententiously, giving an additional hoist to his pantaloons, and adroitly substituting a long nail in place of a missing suspender-button, with which effort of mechanical genius he seemed highly delighted."
                                            },
                                            {
                                                "example_id": "760c1cae-d0c7-4a13-b3e5-8d82c088a013",
                                                "sense_id": "28a86d9d-dfc7-34a6-a6e8-ba3b0048f201",
                                                "text": "He became very cool and collected all at once. ‘I am not such a fool as I look, quoth Plato to his disciples,’ he said sententiously, emptied his glass with great resolution, and we rose."
                                            }
                                        ]
                                    }
                                ]
                            }
