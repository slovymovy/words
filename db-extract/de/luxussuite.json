                "senses": [
                    {
                        "sense_id": "488c6f37-d842-3ee9-890f-6b89f87fdb20",
                        "entry_id": "f241f66c-c8cd-38f4-83b6-cd15ff4827a3",
                        "glosses": [
                            "luxuriöse Nutzungseinheit in einem Gebäude"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35c01b8a-5014-4109-8a06-edbb5399761b",
                                "sense_id": "488c6f37-d842-3ee9-890f-6b89f87fdb20",
                                "text": "„Im Vergleich zu meiner Gefängniszelle wirkt meine Wohnung wie eine Luxussuite.“"
                            },
                            {
                                "example_id": "07802b0f-a68f-49a2-a06c-2907d097e83d",
                                "sense_id": "488c6f37-d842-3ee9-890f-6b89f87fdb20",
                                "text": "„Mehr als einmal hatte er einen spartanisch eingerichteten Unterschlupf in Alexandria oder Beirut hinter sich gelassen, von wo aus er einen Monat oder länger einen Al-Qaida-Terroristen oder einen Muslimbruder beschattet oder überwacht hatte, und hatte für sich eine Luxussuite im Palais de la Méditerranée gebucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
