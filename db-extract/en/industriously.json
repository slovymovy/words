                            }
                        ]
                    },
                    {
                        "translation_id": "b46b74fa-5854-4ef8-9cef-dd4a88b3d593",
                        "source_entry_id": "154b4538-7b81-3bf6-9a07-0c3241c0dfe5",
                        "source_sense_id": "366e17a0-165a-3a9a-8959-8eec4599acdd",
                        "source_sense_description": "industrious manner",
                        "target_lang_word": "старательно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "старательно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6917ac88-3de4-32fe-988d-922ecabdba8f",
                                        "entry_id": "3427b310-319d-3493-a1f5-1bcb6e5ed5f9",
                                        "glosses": [
                                            "наречие к старательный, со старанием"
                                        ],
                                        "tags": [
                                            "adverb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c14cfdbc-9cc2-486e-ac86-ded08ff0d670",
                                                "sense_id": "6917ac88-3de4-32fe-988d-922ecabdba8f",
                                                "text": "Дети хором старательно читали стихи, громче всех с выражением орала воспитательница."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "831a874a-a2f3-40d6-9711-a139726ea231",
                        "source_entry_id": "154b4538-7b81-3bf6-9a07-0c3241c0dfe5",
                        "source_sense_id": "366e17a0-165a-3a9a-8959-8eec4599acdd",
                        "source_sense_description": "industrious manner",
                        "target_lang_word": "прилежно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "прилежно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d3300c37-be54-3744-baa5-c6011d148cc3",
                                        "entry_id": "de7a544a-8123-318a-8194-934366e686eb",
                                        "glosses": [
                                            "усердно, старательно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02aaba4c-ea32-4ac1-9296-c33582da996a",
                                                "sense_id": "d3300c37-be54-3744-baa5-c6011d148cc3",
                                                "text": "Дни его проходили однообразно; но он не скучал, хотя никого не видел; он прилежно и внимательно занимался хозяйством, ездил верхом по окрестностям, читал."
                                            },
                                            {
                                                "example_id": "8092a968-7a49-422f-b1d7-75c336584ee7",
                                                "sense_id": "d3300c37-be54-3744-baa5-c6011d148cc3",
                                                "text": "Она училась так прилежно, что скоро могла понимать французские книги, разговоры и даже выучилась немного говорить по-французски."
                                            },
                                            {
                                                "example_id": "db2188ce-e0fb-450c-8505-8f0a25e40caa",
                                                "sense_id": "d3300c37-be54-3744-baa5-c6011d148cc3",
                                                "text": "В воротах его опять встретил дворник, прилежно наблюдавший всё его прощание с Ярославом Ильичом, и ещё издали сделал ему какой-то пригласительный знак."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
