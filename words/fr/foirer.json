    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3654fe9-6f86-3641-9f04-503024dcc38a",
                    "sense_definition": "Rater complètement quelque chose, ne pas réussir une tâche ou un projet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "echec",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai complètement <w>foiré</w> mon examen de mathématiques hier matin.",
                            "target_lang_translations": {
                                "en": "I completely <w>flunked</w> my maths exam yesterday morning.",
                                "ru": "Вчера утром я полностью <w>провалил</w> экзамен по математике.",
                                "de": "Gestern Morgen habe ich meine Mathematikklausur total <w>vermasselt</w>.",
                                "es": "Ayer por la mañana <w>fastidié</w> por completo mi examen de matemáticas.",
                                "zh": "我昨天早上的数学考试彻底<w>考砸</w>了。"
                            }
                        },
                        {
                            "text": "Si tu ne prépares pas cette réunion, tu risques de <w>foirer</w> ta présentation devant toute l'équipe.",
                            "target_lang_translations": {
                                "en": "If you don't prepare for this meeting, you risk <w>botching</w> your presentation in front of the whole team.",
                                "ru": "Если ты не подготовишься к этому совещанию, ты рискуешь <w>запороть</w> презентацию перед всей командой.",
                                "de": "Wenn du dich nicht auf diese Besprechung vorbereitest, riskierst du, deine Präsentation vor dem ganzen Team zu <w>vermasseln</w>.",
                                "es": "Si no te preparas para esta reunión, corres el riesgo de <w>estropear</w> tu presentación ante todo el equipo.",
                                "zh": "如果你不为这次会议做准备，就可能在整个团队面前把演示<w>搞砸</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rater",
                        "louper"
                    ],
                    "antonyms": [
                        "réussir"
                    ],
                    "common_phrases": [
                        "foirer un examen",
                        "foirer son coup"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To fail completely at something, such as an exam, task or project.",
                        "ru": "Полностью провалить что-либо, не справиться с экзаменом, заданием или проектом.",
                        "de": "Eine Prüfung, Aufgabe oder ein Vorhaben völlig verderben.",
                        "es": "Fracasar por completo en algo, como un examen, una tarea o un proyecto.",
                        "zh": "彻底搞砸某件事，没能成功完成任务、考试或计划。"
                    },
