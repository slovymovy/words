                    "synonyms": [
                        "unique",
                        "singular",
                        "discrete"
                    ],
                    "antonyms": [
                        "generic",
                        "overall",
                        "widespread"
                    ],
                    "common_phrases": [
                        "specific area",
                        "specific region"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специальный, отличительный или уникальный для конкретного предмета или области."
