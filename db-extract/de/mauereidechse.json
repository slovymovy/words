                ],
                "senses": [
                    {
                        "sense_id": "30a53d45-a358-35de-b7c3-860b88aae3ff",
                        "entry_id": "13767c09-8d9c-3aad-a033-7950faade8c0",
                        "glosses": [
                            "Eidechse aus der Familie der Lacertinae und der Ordnung der Schuppenkriechtiere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84d45908-db8d-4946-bc9e-57c6ca5111ba",
                                "sense_id": "30a53d45-a358-35de-b7c3-860b88aae3ff",
                                "text": "„Mauereidechsen können wie alle einheimischen Eidechsen bei akuter Gefahr ihren Schwanz an vorgebildeten Bruchstellen abwerfen.“"
                            },
                            {
                                "example_id": "dcc6e40f-43c2-45c0-a042-c7ab723d605b",
                                "sense_id": "30a53d45-a358-35de-b7c3-860b88aae3ff",
                                "text": "„In unserem Gebiet kommt die Mauereidechse ausschließlich auf trockenem und steinigem, der Sonne leicht zugänglichem Gelände vor, besonders an Felswänden, losen Geröllhalden und in lichten, trockenen Buchenwäldern.“"
                            },
                            {
                                "example_id": "a0224524-5fe5-40bc-8607-2a85cc62a000",
                                "sense_id": "30a53d45-a358-35de-b7c3-860b88aae3ff",
                                "text": "Auch in der Umgebung will man für ökologischen Ausgleich sorgen, da das Bahnareal heute ein wertvoller Lebensraum von Mauereidechsen und verschiedenen Insektenarten ist."
                            },
                            {
                                "example_id": "85569a62-fdab-4c24-bf4e-6304dcd41ef3",
                                "sense_id": "30a53d45-a358-35de-b7c3-860b88aae3ff",
                                "text": "„Die Mauereidechse war Reptil des Jahres 2011.“"
                            },
                            {
                                "example_id": "86012845-5425-481f-8d10-71cbadf6434e",
                                "sense_id": "30a53d45-a358-35de-b7c3-860b88aae3ff",
                                "text": "„In Weinbergen und an Bahntrassen vor allem im Süden Deutschlands sind die Mauereidechsen zu Hause, doch die Modernisierung des Weinanbaus und der Rückgang von Trockenmauern sorgen für einen teilweise dramatischen Habitatschwund.“"
                            },
                            {
                                "example_id": "58a4617d-4ef2-43c4-8323-e3ea60636a62",
                                "sense_id": "30a53d45-a358-35de-b7c3-860b88aae3ff",
                                "text": "„In Anpassung an die Lebensweise der Mauereidechse in Mauern und Felsspalten ist ihr Körperbau schlank und abgeflacht“"
                            },
                            {
                                "example_id": "6f3e0204-d628-40fc-bae8-268f38033fbd",
                                "sense_id": "30a53d45-a358-35de-b7c3-860b88aae3ff",
                                "text": "„Mauereidechsen sind sowohl auf visuelle als auch auf chemische Signale angewiesen, um mit Artgenossen zu kommunizieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
