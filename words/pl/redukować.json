{
    "word_family": [
        "redukcja",
        "redukcyjny",
        "reduktor"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67f6e9a2-656e-3d13-85de-11c67a169549",
                    "sense_definition": "powodować zmniejszenie rozmiaru, ilości, jakości, wartości lub intensywności czegoś",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "zmniejszanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Firma musi <w>redukować</w> koszty produkcji, aby utrzymać się na rynku.",
                            "target_lang_translations": {
                                "ru": "Фирма должна <w>сокращать</w> производственные расходы, чтобы удержаться на рынке."
                            }
                        },
                        {
                            "text": "Należy <w>redukować</w> zbędne wydatki w domowym budżecie.",
                            "target_lang_translations": {
                                "ru": "Следует <w>сокращать</w> лишние расходы в семейном бюджете."
                            }
                        }
                    ],
                    "synonyms": [
                        "zmniejszać",
                        "obniżać",
                        "ograniczać",
                        "skracać",
                        "pomniejszać",
                        "uszczuplać"
                    ],
                    "common_phrases": [
                        "redukować koszty",
                        "redukować wydatki"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывать уменьшение размера, количества, качества, стоимости или интенсивности чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокращать",
                                "target_lang_sense_clarification": "уменьшать количество или объем чего-либо"
                            },
                            {
                                "target_lang_word": "снижать",
                                "target_lang_sense_clarification": "делать ниже, уменьшать уровень или интенсивность"
                            },
                            {
                                "target_lang_word": "уменьшать",
                                "target_lang_sense_clarification": "делать меньше по размеру или количеству"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5183a5b-499a-3e06-bfda-d168cc39b267",
                    "sense_definition": "zwalniać pracowników z pracy w ramach restrukturyzacji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zwalnianie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zarząd zdecydował się <w>redukować</w> zatrudnienie w dziale marketingu.",
                            "target_lang_translations": {
                                "ru": "Руководство решило <w>сокращать</w> штат в отделе маркетинга."
                            }
                        },
                        {
                            "text": "W obliczu kryzysu przedsiębiorstwo musiało <w>redukować</w> liczbę etatów.",
                            "target_lang_translations": {
                                "ru": "Перед лицом кризиса предприятие было вынуждено <w>сокращать</w> количество рабочих мест."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwalniać",
                        "usuwać"
                    ],
                    "common_phrases": [
                        "redukować zatrudnienie",
                        "redukować etaty"
                    ],
                    "target_lang_definitions": {
                        "ru": "увольнять сотрудников с работы в рамках реструктуризации"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокращать",
                                "target_lang_sense_clarification": "увольнять сотрудников в рамках оптимизации штата"
                            },
                            {
                                "target_lang_word": "увольнять",
                                "target_lang_sense_clarification": "прекращать трудовые отношения с работником"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58df0a1d-e9a9-3f67-bf41-51a3e2cd6577",
                    "sense_definition": "w chemii: przeprowadzać reakcję polegającą na przyłączaniu elektronów, odbieraniu tlenu lub przyłączaniu wodoru",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Węgiel potrafi <w>redukować</w> tlenki metali do czystych pierwiastków.",
                            "target_lang_translations": {
                                "ru": "Углерод способен <w>восстанавливать</w> оксиды металлов до чистых элементов."
                            }
                        },
                        {
                            "text": "Podczas elektrolizy można <w>redukować</w> jony metali na katodzie.",
                            "target_lang_translations": {
                                "ru": "Во время электролиза можно <w>восстанавливать</w> ионы металлов на катоде."
                            }
                        }
                    ],
                    "synonyms": [
                        "odtleniać"
                    ],
                    "target_lang_definitions": {
                        "ru": "в химии: проводить реакцию, заключающуюся в присоединении электронов, отнятии кислорода или присоединении водорода"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восстанавливать",
                                "target_lang_sense_clarification": "химический процесс присоединения электронов или водорода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23a5434f-e06d-3430-bcc6-2882d4d5f443",
                    "sense_definition": "stawać się mniejszym lub mniej licznym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zmniejszanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zapotrzebowanie na ten produkt zaczęło <w>redukować</w> się wraz ze zmianą trendów.",
                            "target_lang_translations": {
                                "ru": "Спрос на этот продукт начал <w>сокращаться</w> вместе с изменением трендов."
                            }
                        },
                        {
                            "text": "Z czasem ryzyko błędu powinno <w>redukować</w> się dzięki lepszemu szkoleniu.",
                            "target_lang_translations": {
                                "ru": "Со временем риск ошибки должен <w>уменьшаться</w> благодаря лучшему обучению."
                            }
                        }
                    ],
                    "synonyms": [
                        "zmniejszać się",
                        "ograniczać się",
                        "pomniejszać się",
                        "uszczuplać się"
                    ],
                    "target_lang_definitions": {
                        "ru": "становиться меньше или менее многочисленным"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокращаться",
                                "target_lang_sense_clarification": "становиться меньше по количеству или объему"
                            },
                            {
                                "target_lang_word": "уменьшаться",
                                "target_lang_sense_clarification": "становиться меньше в размерах или степени"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}