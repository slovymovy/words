                    "semantic_group_id": "object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De schutter raakte de houten <w>vogel</w> precies in het midden.",
                            "target_lang_translations": {
                                "en": "The marksman hit the wooden <w>bird</w> right in the middle.",
                                "ru": "Стрелок попал в деревянную <w>птицу</w> прямо в середину.",
                                "pl": "Strzelec trafił drewnianego <w>ptaka</w> dokładnie w środek.",
                                "de": "Der Schütze traf den hölzernen <w>Vogel</w> genau in der Mitte.",
                                "fr": "Le tireur a touché l'<w>oiseau</w> en bois pile au milieu.",
                                "it": "L'arciere ha colpito l'<w>uccello</w> di legno esattamente nel mezzo.",
                                "cs": "Střelec zasáhl dřevěného <w>ptáka</w> přesně do středu.",
                                "tr": "Nişancı ahşap <w>kuşu</w> tam ortasından vurdu.",
                                "es": "El tirador le dio al <w>pájaro</w> de madera justo en el centro."
                            }
                        },
                        {
                            "text": "Tijdens het dorpsfeest schieten de leden van de vereniging op de <w>vogel</w>.",
                            "target_lang_translations": {
                                "en": "During the village festival, the members of the association shoot at the <w>bird</w>.",
                                "ru": "Во время деревенского праздника члены клуба стреляют по <w>птице</w>.",
                                "pl": "Podczas festynu wiejskiego członkowie stowarzyszenia strzelają do <w>kura</w>.",
                                "de": "Während des Dorffestes schießen die Vereinsmitglieder auf den <w>Vogel</w>.",
                                "fr": "Pendant la fête du village, les membres de l'association tirent sur l'<w>oiseau</w>.",
                                "it": "Durante la festa del paese, i membri dell'associazione sparano all'<w>uccello</w>.",
                                "cs": "Během vesnických slavností střílejí členové spolku na <w>ptáka</w>.",
                                "tr": "Köy şenliği sırasında dernek üyeleri <w>hedefe</w> ateş ederler.",
                                "es": "Durante la fiesta del pueblo, los miembros de la asociación disparan al <w>pájaro</w>."
                            }
                        }
