{
    "word_family": [
        "flicker"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e454e45e-fbce-3409-83f6-3cc5955f8fd6",
                    "sense_definition": "Shining unsteadily or varying rapidly in brightness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could barely read our books by the <w>flickering</w> light of the old candle.",
                            "target_lang_translations": {
                                "ru": "Мы едва могли читать книги при <w>мерцающем</w> свете старой свечи."
                            }
                        },
                        {
                            "text": "The <w>flickering</w> screen of the television made my eyes hurt after a few hours.",
                            "target_lang_translations": {
                                "ru": "От <w>мигающего</w> экрана телевизора через несколько часов у меня разболелись глаза."
                            }
                        }
                    ],
                    "synonyms": [
                        "twinkling",
                        "fluttering",
                        "wavering"
                    ],
                    "antonyms": [
                        "steady",
                        "constant"
                    ],
                    "common_phrases": [
                        "flickering light",
                        "flickering candle",
                        "flickering screen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светящийся неустойчиво или быстро меняющий яркость; мерцающий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерцающий",
                                "target_lang_sense_clarification": "о свете, экране, пламени"
                            },
                            {
                                "target_lang_word": "колышущийся",
                                "target_lang_sense_clarification": "о пламени свечи"
                            },
                            {
                                "target_lang_word": "мигающий",
                                "target_lang_sense_clarification": "о лампе или экране"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9f3beea9-3944-36a8-9b1f-c19971931a58",
                    "sense_definition": "A short, uncertain, or weak burst of a feeling, light, or activity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even after the acrimonious breakup, she still felt <w>flickerings</w> of love for him.",
                            "target_lang_translations": {
                                "ru": "Даже после мучительного расставания она все еще чувствовала <w>проблески</w> любви к нему."
                            }
                        },
                        {
                            "text": "There were faint <w>flickerings</w> of hope that the lost hikers would be found safe.",
                            "target_lang_translations": {
                                "ru": "Были слабые <w>проблески</w> надежды на то, что заблудившихся туристов найдут целыми и невредимыми."
                            }
                        }
                    ],
                    "synonyms": [
                        "glimmers",
                        "sparks",
                        "flashes"
                    ],
                    "common_phrases": [
                        "flickerings of hope",
                        "flickerings of doubt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая, неуверенная или слабая вспышка чувства, света или активности; проблески."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проблески",
                                "target_lang_sense_clarification": "о надежде, чувствах"
                            },
                            {
                                "target_lang_word": "искорки",
                                "target_lang_sense_clarification": "о чувствах, интересе"
                            },
                            {
                                "target_lang_word": "мерцание",
                                "target_lang_sense_clarification": "слабый свет или проявление чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47fb0128-a376-308b-8ffa-323c4b999c23",
                    "sense_definition": "Present participle and gerund of <w>flicker</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The campfire was <w>flickering</w> gently in the cool night breeze.",
                            "target_lang_translations": {
                                "ru": "Костер тихонько <w>мерцал</w> на прохладном ночном ветру."
                            }
                        },
                        {
                            "text": "I noticed a shadow <w>flickering</w> across the window just before the lights went out.",
                            "target_lang_translations": {
                                "ru": "Я заметил тень, <w>мелькнувшую</w> в окне как раз перед тем, как погас свет."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола flicker (мерцать, колыхаться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерцающий",
                                "target_lang_sense_clarification": "в процессе мерцания"
                            },
                            {
                                "target_lang_word": "колышущийся",
                                "target_lang_sense_clarification": "о пламени или тени"
                            },
                            {
                                "target_lang_word": "мелькающий",
                                "target_lang_sense_clarification": "о тенях или свете"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}