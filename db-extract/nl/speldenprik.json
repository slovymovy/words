                "senses": [
                    {
                        "sense_id": "2b987d1f-707e-3ce8-86e2-700c3d125ff4",
                        "entry_id": "8d51b354-29ed-38dd-9f34-faabdc53fac7",
                        "glosses": [
                            "gaatjes gemaakt door een speld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "157d1c81-f4fb-4655-b140-9d7bfba623a9",
                                "sense_id": "2b987d1f-707e-3ce8-86e2-700c3d125ff4",
                                "text": "Haar bleke gezicht had de karakteristieke gelaatstrekken zoals ze die altijd van haar hadden gekend, maar nu was het met speldenprikken doorweven, was het niet-doorbloede vlees van haar lippen en oogleden tot leven gekomen en glom het als vers geslacht weefsel."
                            }
                        ]
                    },
                    {
                        "sense_id": "988348ae-00b2-32c8-9020-845029191bdd",
                        "entry_id": "8d51b354-29ed-38dd-9f34-faabdc53fac7",
                        "glosses": [
                            "kleine prikjes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "191a294f-c9cd-4286-a786-05abd7b19e0b",
                                "sense_id": "988348ae-00b2-32c8-9020-845029191bdd",
                                "text": "Zefods lucht begon op te raken, en het beetje dat hij nog overhad verspreidde zich met speldenprikjes en getintel door zijn longen."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3f4c8be-6b30-340c-9bac-092bcd4a7d8b",
                        "entry_id": "8d51b354-29ed-38dd-9f34-faabdc53fac7",
                        "glosses": [
                            "kleine plagerij, kleine hatelijkheid"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0c2562b5-2e23-49cf-bf2c-31d368de1cc2",
                                "sense_id": "a3f4c8be-6b30-340c-9bac-092bcd4a7d8b",
                                "text": "` Michiko; klinkt het als ze de veranda op stapt. Ze verstijft, beducht voor de kleine hatelijkheden en speldenprikken waarmee haar tante haar overlaadt. 'Roer de soep. Met een houten lepel, langzaam en over de bodem, zodat alles loskomt. Denk je dat je dat kunt?'"
                            },
                            {
                                "example_id": "02bc1b61-f402-4951-b07d-a40d78d1040e",
                                "sense_id": "a3f4c8be-6b30-340c-9bac-092bcd4a7d8b",
                                "text": "Hoewel hij geen partijen bij naam noemde, waren de speldenprikken aan het adres van toekomstig coalitiepartners VVD en D66 nauwelijks verholen. \"Vrijheid is niet lekker doen wat je wilt, maar een opdracht die een verantwoordelijkheid inhoudt\", zei hij."
                            }
                        ]
                    }
                ],
