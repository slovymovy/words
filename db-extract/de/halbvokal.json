                ],
                "senses": [
                    {
                        "sense_id": "86709519-9c9a-313e-9ddf-a81d422b32b9",
                        "entry_id": "224221ee-ee87-364b-a277-a5d3df70307f",
                        "glosses": [
                            "Laut, der phonetisch gesehen weder den Vokalen noch den Konsonanten eindeutig zugeordnet werden kann und nicht in silbentragender Position, also nicht als Silbenkern verwendet wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8422b3f-90bb-4b72-a22c-6bace41c436e",
                                "sense_id": "86709519-9c9a-313e-9ddf-a81d422b32b9",
                                "text": "Die wichtigsten Halbvokale im Deutschen sind die Laute [i̯, ʊ̯]."
                            },
                            {
                                "example_id": "d20fe335-ffdf-49f1-a8e9-8024ea396472",
                                "sense_id": "86709519-9c9a-313e-9ddf-a81d422b32b9",
                                "text": "In dem Wort „Nation“ ([na't͡si̯oːn]) steht der Buchstabe „i“ nicht für einen Vokal in silbentragender Position, da der Laut [oː] diese Funktion innehat. Damit befindet sich das „i“ in der Position des Silbenrandes und ist ein Halbvokal. Dieser Halbvokal wird meist mit [i̯], manchmal aber auch mit [j] transkribiert, da seine Aussprache der des palatalen Frikativs [j] (wie in „jung“ = [jʊŋ]) entspricht."
                            },
                            {
                                "example_id": "03ef04a7-3552-4521-8d03-48de6a6e2ecc",
                                "sense_id": "86709519-9c9a-313e-9ddf-a81d422b32b9",
                                "text": "Laut Crystal (1993: 152 f.) handelt es sich dagegen phonetisch gesehen um Vokale, phonologisch um Konsonanten. Die Bezeichnung Halbvokal, seltener Halbkonsonant, behebt das Dilemma terminologisch."
                            },
                            {
                                "example_id": "9d3e4a0c-1233-464a-a67b-d0d620abc878",
                                "sense_id": "86709519-9c9a-313e-9ddf-a81d422b32b9",
                                "text": "„Dieser Verlust ist wahrscheinlich vor Konsonant eingetreten, während der betreffende Laut (Halbvokal, Nasal, Liquida) bei vokalischem Anlaut des folgenden Wortes erhalten blieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94fcaf36-a83f-4955-96ab-8ad613da116f",
                        "source_entry_id": "224221ee-ee87-364b-a277-a5d3df70307f",
                        "source_sense_id": "86709519-9c9a-313e-9ddf-a81d422b32b9",
                        "target_lang_word": "glide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                        "entry_id": "7cebde08-75e5-335b-b82e-ae819456da9c",
                                        "glosses": [
                                            "To move softly, smoothly, or effortlessly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e99af96-d036-43f5-aec0-e0d27c1598b6",
                                                "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                                "text": "The river glideth at his own sweet will:"
                                            },
                                            {
                                                "example_id": "107c0741-19cd-47d4-adb5-587cacc21218",
                                                "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                                "text": "It is odd how easily the common-places of morality or of sentiment glide off in conversation. Well, they are \"exceedingly helpful,\" and so Lord Avonleigh found them."
                                            },
                                            {
                                                "example_id": "126f4aed-cffa-4fad-8ebc-81c71a4def0c",
                                                "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                                "text": "The water over which the boats glided was black and smooth, rising into huge foamless billows, the more terrible because they were silent."
                                            },
                                            {
                                                "example_id": "187ceac6-f2ce-4a45-ae44-678a405c5957",
                                                "sense_id": "0075f6c0-21ab-3564-9e61-fd556b9d421d",
                                                "text": "But it was 37-year-old Giggs who looked like a care-free teenager as he glided across the pitch he knows so well to breathtaking effect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c9d5b32-1d76-3a08-925b-d345a36e7039",
                                        "entry_id": "7cebde08-75e5-335b-b82e-ae819456da9c",
                                        "glosses": [
                                            "To fly unpowered, as of an aircraft. Also relates to gliding birds and flying fish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "022507fa-3c3d-40db-85d2-04867e856d90",
                                                "sense_id": "9c9d5b32-1d76-3a08-925b-d345a36e7039",
                                                "text": "The tide was out, and we drew up amid the strong bracing smell of seaweed, with gulls screeching, wheeling around, and gliding on the wind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f357a393-8dc0-309d-a7d6-d78f2282d84c",
                                        "entry_id": "7cebde08-75e5-335b-b82e-ae819456da9c",
                                        "glosses": [
                                            "To cause to glide."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9389a0b-a587-351c-b292-7a646b56b138",
                                        "entry_id": "7cebde08-75e5-335b-b82e-ae819456da9c",
                                        "glosses": [
                                            "To pass with a glide, as the voice."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
