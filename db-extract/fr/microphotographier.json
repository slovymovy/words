                "senses": [
                    {
                        "sense_id": "62515a6e-29c1-3724-a20c-d445e2cb5dfa",
                        "entry_id": "03675c97-7580-3ed1-b85c-dd8081450dbd",
                        "glosses": [
                            "Réaliser des images de très petite taille sur microfilms ou microfiches en général aux fins d’archivage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2520d8f-5e64-462f-9dc7-98fc15d06330",
                                "sense_id": "62515a6e-29c1-3724-a20c-d445e2cb5dfa",
                                "text": "L'Institut Drouin a pu microphotographier intégralement cette inestimable documentation et en conserve les films dans ces voûtes à Montréal."
                            },
                            {
                                "example_id": "b9f08257-d360-410d-95a6-c94d356a264b",
                                "sense_id": "62515a6e-29c1-3724-a20c-d445e2cb5dfa",
                                "text": "L'optique de l'appareil à microphotographier devra s'y prendre en plusieurs fois pour couvrir chaque plan."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc58ff5b-a501-3984-b264-9b7f0979e926",
                        "entry_id": "03675c97-7580-3ed1-b85c-dd8081450dbd",
                        "glosses": [
                            "Photographier une image vue au microscope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "160befe0-5b2b-4aed-b000-0b3ffded1123",
                                "sense_id": "fc58ff5b-a501-3984-b264-9b7f0979e926",
                                "text": "Nous tenons à remercier ici M. le Professeur lonescu-Mihaesti qui a bien voulu microphotographier nos coupes et nous donner son précieux avis."
                            }
                        ]
                    }
