            {
                "entry_id": "a252e578-5884-3389-adf3-f9f038c54b7b",
                "word": "mescaline",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "343538fd-fb9e-4038-9216-359437db6bde",
                        "entry_id": "a252e578-5884-3389-adf3-f9f038c54b7b",
