                                                "sense_id": "2328ca00-5c7e-3cf8-b9ee-cfe9b40fb64e",
                                                "text": "The school is not in a position to provide day-care after 4:00 pm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61cc6a30-551f-3a82-95e8-579e7174c537",
                                        "entry_id": "3fd74e47-1ba3-3395-be64-9c6dd2fc1731",
                                        "glosses": [
                                            "A place on the playing field, together with a set of duties, assigned to a player."
                                        ],
                                        "tags": [],
