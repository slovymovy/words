                    }
                ],
                "senses": [
                    {
                        "sense_id": "ffc81f90-f6a4-3ff4-88c5-5a336aac4ced",
                        "entry_id": "ebdbf02d-c112-3abe-89ef-51cd21b3ac25",
                        "glosses": [
                            "A dark green mineral resembling serpentine, being a mixed silicate of magnesium, iron and aluminium."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e19fa30c-f1c3-4a36-ac89-9d5183c5d8ab",
                                "sense_id": "ffc81f90-f6a4-3ff4-88c5-5a336aac4ced",
                                "text": "They have been heated enough to impart a delicate blue-green hue, which is because of the abundance of the ‘low-grade’ metamorphic mineral, chlorite."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf887142-b512-369e-8e59-59496809bb04",
                        "entry_id": "ebdbf02d-c112-3abe-89ef-51cd21b3ac25",
                        "glosses": [
                            "Any salt of chlorous acid."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61261ef8-6fb3-4941-a523-3bfac9ee65bc",
                        "source_entry_id": "ebdbf02d-c112-3abe-89ef-51cd21b3ac25",
