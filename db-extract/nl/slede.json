                                "target_senses": [
                                    {
                                        "sense_id": "3d7cb13d-1270-3bcc-a192-2160434fabd6",
                                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                                        "glosses": [
                                            "Someone who wipes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd2c7fea-6f0a-4e0a-94e1-b680d349353a",
                                                "sense_id": "3d7cb13d-1270-3bcc-a192-2160434fabd6",
                                                "text": "So, Willy, let you and me be wipers / Of scores out with all men — especially pipers!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a39556c-b342-34d7-ab10-f295a99204f6",
                                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                                        "glosses": [
                                            "Something, such as a towel, that is used for wiping."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bdfc7ac-0fbb-37ef-99a9-8e1155c413b9",
                                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                                        "glosses": [
                                            "Something, such as a windscreen wiper, that is designed for wiping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e60cc8-0f1f-49b4-93e6-569c1e3aaced",
                                                "sense_id": "7bdfc7ac-0fbb-37ef-99a9-8e1155c413b9",
                                                "text": "Using her hands like windshield wipers, she tried to flick snow away from her mouth. When she clawed at her chest and neck, the crumbs maddeningly slid back onto her face. She grew claustrophobic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efb5c520-7052-3a02-bc79-f6e5395899d9",
                                        "entry_id": "fddda58d-2292-3acb-a30f-4193557fe354",
                                        "glosses": [
