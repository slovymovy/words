        "fr-extract.jsonl": [
            {
                "entry_id": "4c1687e5-4346-3101-8d99-bc2b4eaed0ce",
                "word": "droitement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a2ba8ae3-72a5-3904-994f-f8eea843880c",
                        "entry_id": "4c1687e5-4346-3101-8d99-bc2b4eaed0ce",
                        "glosses": [
                            "D’une manière droite, équitable, avec droiture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59ce86fc-9673-4106-af80-3f5f1a81ae9d",
                                "sense_id": "a2ba8ae3-72a5-3904-994f-f8eea843880c",
                                "text": "Agir, penser, juger droitement."
                            },
                            {
                                "example_id": "063312d6-2b11-418c-a04c-330f4c375792",
                                "sense_id": "a2ba8ae3-72a5-3904-994f-f8eea843880c",
                                "text": "L'homme juge droitement, lorsque, sentant ses jugements variables de leur nature, il leur donne pour règle les vérités éternelles."
                            },
                            {
                                "example_id": "84adc115-092d-4e39-b134-d8582013f3a2",
                                "sense_id": "a2ba8ae3-72a5-3904-994f-f8eea843880c",
                                "text": "Ceux qui mettent la vertu trop haut […] ne doivent pas se vanter d’aller droitement, sous prétexte qu’ils semblent chercher une régularité plus scrupuleuse."
                            },
                            {
                                "example_id": "1a287af0-ed12-45e1-bc65-17aa5afd6aa0",
                                "sense_id": "a2ba8ae3-72a5-3904-994f-f8eea843880c",
                                "text": "Le gouvernorat, où ils allèrent tout droitement, s’était lui aussi étoffé. Un toit de bardeaux couvrait les pièces principales en prévision des pluies imminentes."
                            }
                        ]
                    }
                ],
