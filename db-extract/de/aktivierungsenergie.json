                    {
                        "sense_id": "96a33bf2-c77f-3617-88d8-f96783a8ebdc",
                        "entry_id": "a10ce1e1-9f19-31cb-81b3-80b204e67355",
                        "glosses": [
                            "die Energie, die man zwei Reaktionspartnern zuführen muss, damit eine Reaktion eintritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17e0a01d-7cf2-42e9-bce5-13fa9339d750",
                                "sense_id": "96a33bf2-c77f-3617-88d8-f96783a8ebdc",
                                "text": "„Obwohl der Betrag an Aktivierungsenergie für gegebene Reaktionen unterschiedlich hoch liegt, ist die Aktivierungsenergie, verglichen mit der Änderung der freien Energie im Laufe der Gesamtreaktion, häufig gering.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fc43ffd-1242-4455-8ff0-373bf97adb91",
                        "source_entry_id": "a10ce1e1-9f19-31cb-81b3-80b204e67355",
                        "source_sense_id": "96a33bf2-c77f-3617-88d8-f96783a8ebdc",
                        "source_sense_description": "Energie, die man zwei Reaktionspartnern zuführen muss, damit eine Reaktion eintritt",
                        "target_lang_word": "activation energy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "activation energy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6166fe63-af9b-37d8-9de6-c7a8bd9c2af3",
                                        "entry_id": "993760c8-73cf-344a-9b96-c2411a329246",
                                        "glosses": [
                                            "The energy required to initiate a reaction. For example, the flame from the fuse of a firecracker provides a small initial amount of energy, after which the explosive reaction proceeds by itself, releasing a considerably larger quantity of energy. A small push given to a stable but top-heavy object may cause it to fall over; the potential energy released during the fall was present in the system all along but could not be realized as long as the object was upright and balanced."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
