    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "27b79f08-421e-3ae0-9d10-52824ade7c6c",
                    "sense_definition": "Lijkend op een zak of herinnerend aan de vorm van een zak, vaak met betrekking tot kleding die ruim en vormloos valt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat <w>zakkige</w> jasje staat hem helemaal niet omdat het veel te groot is.",
                            "target_lang_translations": {
                                "en": "That <w>baggy</w> jacket doesn't suit him at all because it is much too big."
                            }
                        },
                        {
                            "text": "Zij draagt graag een <w>zakkig</w> model broek voor meer comfort tijdens het werk.",
                            "target_lang_translations": {
                                "en": "She likes to wear a <w>shapeless</w> style of trousers for more comfort during work."
                            }
                        }
                    ],
                    "synonyms": [
                        "vormloos",
                        "lubberig",
                        "wijd"
                    ],
                    "antonyms": [
                        "nauwsluitend",
                        "getailleerd"
                    ],
                    "common_phrases": [
                        "zakkig model",
                        "zakkig jasje",
                        "zakkige kleding"
                    ],
                    "target_lang_definitions": {
                        "en": "Resembling a bag or reminiscent of the shape of a bag, often referring to clothing that fits loosely and without form."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "baggy",
                                "target_lang_sense_clarification": "loose-fitting clothing"
                            },
                            {
                                "target_lang_word": "shapeless",
                                "target_lang_sense_clarification": "lacking a definite form"
                            },
                            {
                                "target_lang_word": "saggy",
                                "target_lang_sense_clarification": "hanging loosely or heavily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fd2f085-c8bc-3dc0-a97a-87ea1e9d0841",
                    "sense_definition": "Zich op een sullige, vervelende of karakterloze manier gedragend.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat kan hij toch <w>zakkige</w> opmerkingen maken als hij zijn zin niet krijgt.",
                            "target_lang_translations": {
                                "en": "He can make such <w>pathetic</w> remarks when he doesn't get his way."
                            }
                        },
                        {
                            "text": "Ik vond zijn <w>zakkige</w> gedrag tijdens de vergadering erg storend voor het team.",
                            "target_lang_translations": {
                                "en": "I found his <w>lame</w> behavior during the meeting very disruptive to the team."
                            }
                        }
                    ],
                    "synonyms": [
                        "sullig",
                        "flauw",
                        "karakterloos"
                    ],
                    "antonyms": [
                        "pittig",
                        "krachtig"
                    ],
                    "common_phrases": [
                        "zakkige opmerkingen",
                        "zakkig gedrag"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Behaving in a dull, annoying, or spineless manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pathetic",
                                "target_lang_sense_clarification": "miserably inadequate or spineless"
                            },
                            {
                                "target_lang_word": "lame",
                                "target_lang_sense_clarification": "uninspiring or dull behavior"
                            },
                            {
                                "target_lang_word": "wimpish",
                                "target_lang_sense_clarification": "lacking character or strength"
                            }
                        ]
                    }
                }
            ]
