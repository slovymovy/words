                "senses": [
                    {
                        "sense_id": "fafae338-1789-3edf-a08e-428932b01caa",
                        "entry_id": "794b4159-835e-333b-929b-88316ed824af",
                        "glosses": [
                            "für Geschirr, insbesondere Teller, Tassen, Kochgeschirr aus Aluminiumblech"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "18fb33c5-eb7c-4348-a2cb-9ad20124e720",
                                "sense_id": "fafae338-1789-3edf-a08e-428932b01caa",
                                "text": "Mein Hund frisst immer aus dem Blechnapf."
                            },
                            {
                                "example_id": "53a04d54-5cad-4ce7-a346-ffef3321a93d",
                                "sense_id": "fafae338-1789-3edf-a08e-428932b01caa",
                                "text": "Ausgebeulte Blechnäpfe sind ein Sinnbild von Ärmlichkeit."
                            },
                            {
                                "example_id": "d50c45dc-24a3-4c81-bf40-f07b1abbf799",
                                "sense_id": "fafae338-1789-3edf-a08e-428932b01caa",
                                "text": "In Blechnäpfen bewahre ich die Nägel und Schrauben auf."
                            },
                            {
                                "example_id": "e705625a-8344-4872-967a-9a4501235657",
                                "sense_id": "fafae338-1789-3edf-a08e-428932b01caa",
                                "text": "„Am Ende habe nicht sie den Blechnapf gerettet, sondern der Blechnapf sie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf97e05d-c876-3208-8a9d-183f3d33fcb9",
                        "entry_id": "794b4159-835e-333b-929b-88316ed824af",
