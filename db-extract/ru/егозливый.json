                    {
                        "form_id": "7c91da7f-f788-4de9-81e1-3b949dacf605",
                        "entry_id": "00e32edc-067e-35d5-ad65-fbc5b7f29e36",
                        "tags": [
                            "comparative"
                        ],
                        "form": "егозли́вее"
                    },
                    {
                        "form_id": "c7f29c0b-3c95-4c33-af07-8a6dafcea598",
                        "entry_id": "00e32edc-067e-35d5-ad65-fbc5b7f29e36",
                        "tags": [
