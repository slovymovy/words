                "entry_id": "a51d856e-5ea5-3afc-9005-3abbd2b71db3",
                "word": "deontologie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "edf4bd4d-8a80-3d9b-b1b8-acaf98c47ea8",
                        "entry_id": "a51d856e-5ea5-3afc-9005-3abbd2b71db3",
                        "glosses": [
                            "een ethische stroming, die uitgaat van absolute gedragsregels, vaak, maar niet altijd, gesteld als normen. (plichtethiek)"
                        ],
