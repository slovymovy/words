                "senses": [
                    {
                        "sense_id": "3c27e474-433c-35c1-8c8f-42f493d83a1b",
                        "entry_id": "0f483cbe-9daa-344b-bb86-2066be96d9df",
                        "glosses": [
                            "Kopf eines Fischs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a768fc3-5cf1-46be-a60b-3977b99b35bb",
                                "sense_id": "3c27e474-433c-35c1-8c8f-42f493d83a1b",
                                "text": "„›Nimmst du dieses widerliche Zeug? Einen Fischkopf oder zwei?‹ sagt sie und lässt den Schöpflöffel malerisch hängen.“"
                            },
                            {
                                "example_id": "071d520c-ecee-44ce-a205-ec1eefd4ffd2",
                                "sense_id": "3c27e474-433c-35c1-8c8f-42f493d83a1b",
                                "text": "„Abs Katze erschien, hockte sich hin wie eine Eule und belauerte ihn. Er gab ihr einen Fischkopf; sie öffnete den Schlund mit den rasiermesserscharfen Zähnen, packte anmutig den Kopf und schlich die Reling entlang wieder zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e06e96ea-000d-4a52-93ac-493ac33cb975",
                        "source_entry_id": "0f483cbe-9daa-344b-bb86-2066be96d9df",
