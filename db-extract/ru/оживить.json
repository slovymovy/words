                "senses": [
                    {
                        "sense_id": "45a85d9e-3711-31b4-a6ee-7bd7cd927c53",
                        "entry_id": "6ab4a618-2935-3454-b8f5-3a3911a1b78c",
                        "glosses": [
                            "вновь сделать живым; возвратить к жизни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c6c4d5e-7ef9-4f97-8ec0-2ff50c44c117",
                                "sense_id": "45a85d9e-3711-31b4-a6ee-7bd7cd927c53",
                                "text": "Перестань только крушиться, перестань плакать: слезы наши не оживят батюшки."
                            }
                        ]
                    },
                    {
                        "sense_id": "2075c6fb-ce0d-38e5-af54-74f1eb47d388",
                        "entry_id": "6ab4a618-2935-3454-b8f5-3a3911a1b78c",
                        "glosses": [
                            "перен. восстановить что-либо забытое или утраченное"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9f0cca40-39e2-3ded-b76f-a1c81793bc4a",
                        "entry_id": "6ab4a618-2935-3454-b8f5-3a3911a1b78c",
                        "glosses": [
                            "перен. восстановить физические или душевные силы, взбодрить"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "09f74f00-81bc-389e-a138-7d9d50c09235",
                        "entry_id": "6ab4a618-2935-3454-b8f5-3a3911a1b78c",
                        "glosses": [
                            "перен. сделать более энергичным, придать живость, весёлость, бодрость"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b0a97404-81b7-3b17-9019-751335b3eced",
                        "entry_id": "6ab4a618-2935-3454-b8f5-3a3911a1b78c",
                        "glosses": [
                            "перен. сделать более красивым, привлекательным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "925b5bb0-b526-4347-b033-7f276d040394",
                                "sense_id": "b0a97404-81b7-3b17-9019-751335b3eced",
                                "text": "Серое, невыразительное строение попытались хоть как-то оживить по фасаду «революционными» барельефами."
                            }
                        ]
                    }
