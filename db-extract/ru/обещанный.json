                "translations": [
                    {
                        "translation_id": "6eabcf61-2181-4724-8835-f9cf275816ba",
                        "source_entry_id": "6458b591-40bc-3613-b54f-176b813127f2",
                        "source_sense_id": "01680f76-541f-3bf0-a825-b46fa6bc419f",
                        "target_lang_word": "promis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a679e29a-0033-3ce1-be4d-28d70cb34e8d",
                                        "entry_id": "29d39d73-b030-3d7b-ae46-b18f0a7c1a6d",
                                        "glosses": [
                                            "Qui fait l’objet d'une promesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dca9014-e6e9-436c-9469-271d9b48633b",
                                                "sense_id": "a679e29a-0033-3ce1-be4d-28d70cb34e8d",
                                                "text": "C’est chose promise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8cca193-86ff-3d3a-8270-885863a2ccd8",
                                        "entry_id": "29d39d73-b030-3d7b-ae46-b18f0a7c1a6d",
                                        "glosses": [
                                            "Fiancé."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "529acdff-3a79-4d54-93b3-ec355988c208",
                                                "sense_id": "e8cca193-86ff-3d3a-8270-885863a2ccd8",
                                                "text": "Il ne savait pas que Rosalie était promise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "promis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eb4fb143-8580-32c0-a43e-a7d457ce2970",
                                        "entry_id": "90c9b97d-2735-34d3-84db-28faf08e315f",
                                        "glosses": [
                                            "Fiancé."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe167754-84e0-401f-a790-1d15dd31d82e",
                                                "sense_id": "eb4fb143-8580-32c0-a43e-a7d457ce2970",
                                                "text": "D’elle-même elle lui prit le bras, comme font les promis le soir, dans l’avenue."
                                            },
                                            {
                                                "example_id": "5e34b228-172b-4fbe-92f0-7f06cbc224a8",
                                                "sense_id": "eb4fb143-8580-32c0-a43e-a7d457ce2970",
                                                "text": "Assise, le dos las, les mains ouvertes, je reste là comme une bonne : une promise poyaudine, qui vient de lire la lettre de son « pays » parti sous les drapeaux n’a pas les yeux plus déserts, la pensée plus gourde que moi…"
                                            },
                                            {
                                                "example_id": "e583902c-6ee5-42ba-bbbb-e236ed329b23",
                                                "sense_id": "eb4fb143-8580-32c0-a43e-a7d457ce2970",
                                                "text": "Louise se fiança à un couvreur ; je la surpris un jour dans la cuisine, gauchement assise sur les genoux d’un homme roux ; elle avait une peau blanchâtre et lui des joues rubicondes ; sans savoir pourquoi, je me sentis triste ; pourtant on approuvait son choix : bien qu’ouvrier, son promis pensait bien."
                                            },
                                            {
                                                "example_id": "46a0ef70-0889-43df-b025-f9f4680df3e9",
                                                "sense_id": "eb4fb143-8580-32c0-a43e-a7d457ce2970",
                                                "text": "Leur exploit accompli, ils ramassaient un brandon du foyer à l’agonie, et l’offraient, tout juste éteint, à leur promise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "promis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0ecabe9-f1fb-3023-a5d7-cefce5c8cae4",
                                        "entry_id": "614fe75f-4761-37ed-b5fd-eb59691a1984",
                                        "glosses": [
                                            "Participe passé masculin de promettre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "618c2bce-27f8-4420-9ca3-3015deda4f91",
                                                "sense_id": "d0ecabe9-f1fb-3023-a5d7-cefce5c8cae4",
                                                "text": "Il a promis de parler sans aucune faveur, animosité ni acceptions de personne."
                                            },
                                            {
                                                "example_id": "fae20e6b-2e50-49ff-8044-208687600f52",
                                                "sense_id": "d0ecabe9-f1fb-3023-a5d7-cefce5c8cae4",
                                                "text": "Après avoir profondément médité sur ces questions, je me promis, en revenant, de les dégosiller à mon grand écrivain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b285410-19e5-314e-b7a1-7be96f617029",
                                        "entry_id": "614fe75f-4761-37ed-b5fd-eb59691a1984",
                                        "glosses": [
                                            "Première personne du singulier du passé simple de promettre."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
