                                                "example_id": "04f87872-3851-4918-aae3-f436300eae5d",
                                                "sense_id": "de6b27fe-0ce3-3438-bdda-6f7e208297f1",
                                                "text": "Também os surtos de rubéola e sarampo registrados em 2006 no País têm relação com grupos não vacinados, diz o ministério."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
