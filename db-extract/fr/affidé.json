                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "256bc8ed-16b3-42c1-8339-b6b1ded7c235",
                        "entry_id": "7576c913-8969-3cbd-9342-91dd31354747",
                        "tags": [
                            "plural"
                        ],
                        "form": "affidés"
                    },
                    {
                        "form_id": "4991ca89-0ebd-4192-904f-f84b03f1b4e9",
                        "entry_id": "7576c913-8969-3cbd-9342-91dd31354747",
                        "tags": [
                            "feminine"
                        ],
                        "form": "affidée"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "73f6bd2f-e29e-3334-9c4a-93194a578552",
                        "entry_id": "7576c913-8969-3cbd-9342-91dd31354747",
                        "glosses": [
                            "Personne, peuple, etc., à qui l’on se fie, sur qui l’on peut compter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d65dc0f3-e497-4028-8283-4d9b166881f5",
                                "sense_id": "73f6bd2f-e29e-3334-9c4a-93194a578552",
                                "text": "[…] la poussée chiite de l’Iran et de ses affidés palestinien et libanais."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a9509a4-aeb0-3343-b15d-1cd81e1d86d5",
                        "entry_id": "7576c913-8969-3cbd-9342-91dd31354747",
                        "glosses": [
                            "Homme de main."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5a1a9e2d-8b37-49c0-b11a-cbc5dd8c0669",
                                "sense_id": "7a9509a4-aeb0-3343-b15d-1cd81e1d86d5",
                                "text": "Son petit-fils Guy d’Arces, plus connu sous le nom de Livarot , tua Schomberg dans ce fameux duel de trois contre trois, qui eut lieu le 27 avril 1578 , entre les mignons d’Henri III et les affidés de la maison de Lorraine."
                            },
                            {
                                "example_id": "da4cf1d4-434b-4714-9d0c-bccd5e9d727a",
                                "sense_id": "7a9509a4-aeb0-3343-b15d-1cd81e1d86d5",
                                "text": "Depuis Mexico, je suivais pas à pas la caravane, j’avais corrompu leur guide chef, le Babillard, ancien affidé à moi ; […]"
                            },
                            {
                                "example_id": "6e61b4a1-fbd5-42c2-ad7d-cc0810559e90",
                                "sense_id": "7a9509a4-aeb0-3343-b15d-1cd81e1d86d5",
                                "text": "Il avait paru de charmante humeur, surtout depuis qu’un affidé venu à franc étrier s’était incliné en lui remettant un pli."
                            },
                            {
                                "example_id": "5987d8f0-e57c-4b20-b5a4-db07e123fd76",
                                "sense_id": "7a9509a4-aeb0-3343-b15d-1cd81e1d86d5",
                                "text": "La Chine dépense beaucoup d’argent pour acheter des votes afin que les projets qu’elle met de l’avant soient adoptés ou ceux qui la défavorisent rejetés. Elle ou ses affidés ont souvent des positions de leadership dans ces organisations."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acf81aba-f7f1-473a-9dc4-73bfd5aa9f5d",
                        "source_entry_id": "7576c913-8969-3cbd-9342-91dd31354747",
                        "target_lang_word": "Komplize",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Komplize",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5441cba7-9f17-39e2-95df-c09769d88e2a",
                                        "entry_id": "7955c81c-ff53-3fbc-a203-b4c8f32f85e6",
                                        "glosses": [
                                            "an einer Straftat Beteiligter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d97e8d-909b-451e-afac-3dbeaeeb376d",
                                                "sense_id": "5441cba7-9f17-39e2-95df-c09769d88e2a",
                                                "text": "Egon Olsen und seine Komplizen Kjeld und Benny haben manches auf dem Kerbholz."
                                            },
                                            {
                                                "example_id": "cf37721a-c1c4-4f80-896e-dc0b8e866ca4",
                                                "sense_id": "5441cba7-9f17-39e2-95df-c09769d88e2a",
                                                "text": "Der Mieter soll der 37-jährige Komplize des Trios gewesen sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c927c249-dda9-48a9-9acb-387655012ba6",
                        "source_entry_id": "7576c913-8969-3cbd-9342-91dd31354747",
                        "target_lang_word": "Handlanger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handlanger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad61cdf-1e38-3873-b0ea-fd1872134297",
                                        "entry_id": "17a6ea31-49d6-38b0-831a-ec567459685c",
                                        "glosses": [
                                            "ungelernte Hilfskraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c87b7058-8e02-40aa-a453-53c2ae548cdd",
                                                "sense_id": "5ad61cdf-1e38-3873-b0ea-fd1872134297",
                                                "text": "\"Was/wer steckt dahinter? Investmentbankster Goldman-Sachs, im Einklang mit IWF, EZB und deren ausführenden Handlanger der Politik. Interessant zu wissen: Frühere EU- Politiker wie Papademos, Samaras, Simitis aber auch Monti und Prodi (Italien) und Draghi (EZB) standen (stehen auch noch heute?) in Lohn und Brot von Goldman-Sachs. Ein Schelm, der Böses denkt.\""
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                        "entry_id": "17a6ea31-49d6-38b0-831a-ec567459685c",
                                        "glosses": [
                                            "\\\"die Absichten oder Aufträge eines Anderen ausführende und erfüllende Person\\"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbcd5e93-27e3-4cb5-bc7a-975a55afc688",
                                                "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                                "text": "\"Polier kommt von Polieren und welcher Maurer oder Handlanger hätte seinem Polier nicht gerne schon einmal die Fresse poliert.\""
                                            },
                                            {
                                                "example_id": "4afc4b16-87f1-42b5-af52-1e113e76efcd",
                                                "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                                "text": "„Dann wieder: Die Polen hätten bloß als Handlanger der Russen gehandelt, das Ziel sei Sibirien.“"
                                            },
                                            {
                                                "example_id": "8dbbd451-90d0-45c5-888c-7281b704e27e",
                                                "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                                "text": "„Es bildet sich eine Gruppe als Handlanger der nie erscheinenden Befehlsgeber.“"
                                            },
                                            {
                                                "example_id": "de637129-af77-4158-bbd4-ab1c6b07af52",
                                                "sense_id": "e06de9e8-8f44-3f9b-bc03-bc3efddf96ca",
                                                "text": "„Deshalb wurden die ehemaligen Produzenten von Massenvernichtungswaffen zu Handlangern der Massenunterhaltung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
