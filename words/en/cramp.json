{
    "word_family": [
        "cramped",
        "cramping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ddefc67-52eb-3bbd-98bb-d80e5c2c3a1d",
                    "sense_definition": "A painful, involuntary contraction of a muscle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The swimmer had to stop because of a sudden leg <w>cramp</w>.",
                            "target_lang_translations": {
                                "zh": "那个游泳的人因为腿突然<w>抽筋</w>，只好停了下来。"
                            }
                        },
                        {
                            "text": "He suffered a painful <w>cramp</w> in his calf during the race.",
                            "target_lang_translations": {
                                "zh": "比赛时，他的小腿疼得<w>抽筋</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "leg cramp",
                        "muscle cramp"
                    ],
                    "target_lang_definitions": {
                        "zh": "肌肉发生疼痛性、不自主的收缩。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抽筋",
                                "target_lang_sense_clarification": "肌肉不自主地疼痛性收缩"
                            },
                            {
                                "target_lang_word": "肌肉痉挛",
                                "target_lang_sense_clarification": "较正式的医学或书面说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80c4510e-2d77-3976-8bf9-aac56c348590",
                    "sense_definition": "A metal tool used to hold objects tightly together during construction or carpentry.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use a <w>cramp</w> to hold the wooden boards in place while the glue dries.",
                            "target_lang_translations": {
                                "zh": "趁胶水变干时，用<w>夹具</w>把木板固定住。"
                            }
                        },
                        {
                            "text": "The carpenter tightened the <w>cramp</w> to secure the frame.",
                            "target_lang_translations": {
                                "zh": "木匠拧紧了<w>夹具</w>，以固定框架。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种金属工具，用于在建筑或木工中把物体紧紧固定在一起。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "夹具",
                                "target_lang_sense_clarification": "木工或施工中用来夹紧、固定物体的工具"
                            },
                            {
                                "target_lang_word": "夹钳",
                                "target_lang_sense_clarification": "用于夹紧固定的工具，常见通称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3bfbd5b-4b49-3bd5-8b36-b2a739d9e766",
                    "sense_definition": "Something that restricts or prevents free movement or development.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lack of funding acts as a <w>cramp</w> on the growth of the small business.",
                            "target_lang_translations": {
                                "zh": "资金不足成了这家小企业发展的<w>阻碍</w>。"
                            }
                        },
                        {
                            "text": "Strict rules can be a <w>cramp</w> on creativity.",
                            "target_lang_translations": {
                                "zh": "严格的规定可能成为创造力的<w>束缚</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "restraint",
                        "shackle",
                        "hindrance"
                    ],
                    "target_lang_definitions": {
                        "zh": "限制或妨碍自由行动、发展的一种事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阻碍",
                                "target_lang_sense_clarification": "阻碍发展、行动或进步的事物"
                            },
                            {
                                "target_lang_word": "束缚",
                                "target_lang_sense_clarification": "强调对自由发展或表达的压制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3287de8f-e0ed-3418-8d0a-8c38bdfb7387",
                    "sense_definition": "A curved wooden form used to shape the upper part of a boot.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shoemaker placed the leather over the <w>cramp</w> to shape the boot.",
                            "target_lang_translations": {
                                "zh": "鞋匠把皮革套在<w>靴楦</w>上给靴子定型。"
                            }
                        },
                        {
                            "text": "Each size of boot requires a specific <w>cramp</w> for proper shaping.",
                            "target_lang_translations": {
                                "zh": "每种尺寸的靴子都需要特定的<w>靴楦</w>才能正确定型。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种弯曲的木制模型，用于给靴子上部塑形。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "靴楦",
                                "target_lang_sense_clarification": "制靴时用来给靴面上部塑形的木制楦具"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac7e24a2-5655-3dae-8955-fd924693a1d9",
                    "sense_definition": "To experience a painful, involuntary muscle contraction.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My feet often <w>cramp</w> after a long day of walking.",
                            "target_lang_translations": {
                                "zh": "走了一整天后，我的脚常常会<w>抽筋</w>。"
                            }
                        },
                        {
                            "text": "If you do not stretch, your muscles might <w>cramp</w> during exercise.",
                            "target_lang_translations": {
                                "zh": "如果你不做拉伸，运动时肌肉可能会<w>抽筋</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "发生疼痛性、不自主的肌肉收缩。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抽筋",
                                "target_lang_sense_clarification": "肌肉发生抽搐、痉挛"
                            },
                            {
                                "target_lang_word": "痉挛",
                                "target_lang_sense_clarification": "较正式说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b964690f-fcb1-36c6-ba96-270aa86704ef",
                    "sense_definition": "To restrict or prevent someone from acting freely or expressing themselves.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't let his negative attitude <w>cramp</w> your style.",
                            "target_lang_translations": {
                                "zh": "别让他的消极态度<w>束缚</w>你的发挥。"
                            }
                        },
                        {
                            "text": "The small office space really <w>cramps</w> my ability to work efficiently.",
                            "target_lang_translations": {
                                "zh": "狭小的办公空间确实<w>限制</w>了我的工作效率。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cramp style"
                    ],
                    "target_lang_definitions": {
                        "zh": "限制或妨碍某人自由行动或表达自己。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "限制",
                                "target_lang_sense_clarification": "限制某人的自由行动、发挥或表达"
                            },
                            {
                                "target_lang_word": "束缚",
                                "target_lang_sense_clarification": "强调妨碍风格、发挥或个性表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d214a29-2c92-3821-89f7-d4a9ce545ebb",
                    "sense_definition": "To cause someone to suffer from muscle spasms or pain.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold water began to <w>cramp</w> his legs while he was swimming.",
                            "target_lang_translations": {
                                "zh": "他游泳时，冰冷的水开始让他的腿<w>抽筋</w>。"
                            }
                        },
                        {
                            "text": "Tight shoes can <w>cramp</w> your toes and cause discomfort.",
                            "target_lang_translations": {
                                "zh": "太紧的鞋会让你的脚趾<w>抽筋</w>，引起不适。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使某人肌肉痉挛或疼痛。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使抽筋",
                                "target_lang_sense_clarification": "使身体部位因疼痛性痉挛而抽动"
                            },
                            {
                                "target_lang_word": "使痉挛",
                                "target_lang_sense_clarification": "使肌肉发生痉挛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c5496ba-e426-32f5-abbc-203f38c8b89f",
                    "sense_definition": "To hold or fix something in a specific position.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>cramp</w> the wheels against the curb when parking on a hill.",
                            "target_lang_translations": {
                                "zh": "在坡道上停车时，你应该把车轮<w>顶住</w>路缘石。"
                            }
                        },
                        {
                            "text": "The mechanic had to <w>cramp</w> the metal parts together to weld them.",
                            "target_lang_translations": {
                                "zh": "机械师不得不先把金属部件<w>夹紧</w>在一起再进行焊接。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "把某物固定在特定位置。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "固定",
                                "target_lang_sense_clarification": "把东西固定在某个位置不动"
                            },
                            {
                                "target_lang_word": "夹紧",
                                "target_lang_sense_clarification": "用力夹住或压住使其不移动"
                            },
                            {
                                "target_lang_word": "顶住",
                                "target_lang_sense_clarification": "使其顶住某处而不移动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55cefa5a-24a9-3052-8962-9399cfdc89f2",
                    "sense_definition": "To fasten or secure items using a metal clamp.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a tool to <w>cramp</w> the two beams together firmly.",
                            "target_lang_translations": {
                                "zh": "他用工具把两根梁牢牢地<w>夹紧</w>在一起。"
                            }
                        },
                        {
                            "text": "The workers <w>cramped</w> the iron bars to the stone foundation.",
                            "target_lang_translations": {
                                "zh": "工人们把铁条<w>夹固</w>在石基上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用金属夹具把物件扣紧或固定。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "夹紧",
                                "target_lang_sense_clarification": "用金属夹或夹具把物件夹牢"
                            },
                            {
                                "target_lang_word": "夹固",
                                "target_lang_sense_clarification": "用夹具固定住"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2d19961-3e79-3e19-81ef-24fb7443a4a1",
                    "sense_definition": "To bind or join things together securely.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The structure was <w>cramped</w> together with heavy bolts to ensure stability.",
                            "target_lang_translations": {
                                "zh": "为了确保稳定，这个结构用沉重的螺栓<w>牢固连接</w>在一起。"
                            }
                        },
                        {
                            "text": "The parts were <w>cramped</w> into a single unit.",
                            "target_lang_translations": {
                                "zh": "这些部件被<w>紧固连接</w>成一个整体。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "把若干物体牢固地捆住或连接在一起。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "牢固连接",
                                "target_lang_sense_clarification": "把多个东西牢固地连在一起"
                            },
                            {
                                "target_lang_word": "紧固连接",
                                "target_lang_sense_clarification": "强调连接得很紧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1770eb6-8fd1-3274-af1e-7a87af0fa66b",
                    "sense_definition": "To shape leather using a specific wooden form.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artisan began to <w>cramp</w> the leather for the new boots.",
                            "target_lang_translations": {
                                "zh": "工匠开始用楦子给新靴子的皮革<w>定型</w>。"
                            }
                        },
                        {
                            "text": "It takes great skill to <w>cramp</w> the material correctly.",
                            "target_lang_translations": {
                                "zh": "要把这种材料正确<w>定型</w>，需要很高的技巧。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "用特定的木制模型给皮革塑形。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "定型",
                                "target_lang_sense_clarification": "用特定木楦给皮革塑形"
                            },
                            {
                                "target_lang_word": "上楦",
                                "target_lang_sense_clarification": "制靴语境中，用楦子塑形"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "96fc4c16-e6b7-37c5-833b-2262f32732ff",
                    "sense_definition": "Narrow or restricted in space.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old house had a very <w>cramp</w> hallway that was difficult to walk through.",
                            "target_lang_translations": {
                                "zh": "那座老房子的走廊非常<w>狭窄</w>，很难通行。"
                            }
                        },
                        {
                            "text": "His <w>cramp</w> handwriting was very difficult for the teacher to read.",
                            "target_lang_translations": {
                                "zh": "他那种<w>过于紧密</w>的字迹，老师很难辨认。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is now rare; 'cramped' is preferred."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "空间狭窄或受到限制的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "狭窄",
                                "target_lang_sense_clarification": "空间狭小、受限制"
                            },
                            {
                                "target_lang_word": "过于紧密",
                                "target_lang_sense_clarification": "排列过密、显得局促"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "059fe8c1-fa24-36c4-b465-9c4bcf458a64",
                    "sense_definition": "A family name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The researcher's name is Dr. <w>Cramp</w>.",
                            "target_lang_translations": {
                                "zh": "那位研究员名叫<w>克兰普</w>博士。"
                            }
                        },
                        {
                            "text": "Mr. <w>Cramp</w> is the new head of the department.",
                            "target_lang_translations": {
                                "zh": "<w>克兰普</w>先生是这个部门的新负责人。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "克兰普",
                                "target_lang_sense_clarification": "英语姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}