                                                "example_id": "6af420c0-eae0-4449-afac-2f662bc4df15",
                                                "sense_id": "9ee9ce32-9aef-3c3f-8b29-3a01fb38743b",
                                                "text": "La visualisation fait maintenant partie de l’entraînement de tout athlète de haut niveau."
