                    },
                    {
                        "form_id": "59ba2dd6-d30e-4451-9b95-ab63e56d5708",
                        "entry_id": "fc376b7f-1989-3f91-90c4-4f39bcd956e8",
                        "tags": [
                            "past"
                        ],
                        "form": "politicked"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a30d568-a5e4-3d7a-8d21-657e87fe2914",
                        "entry_id": "fc376b7f-1989-3f91-90c4-4f39bcd956e8",
                        "glosses": [
                            "Alternative spelling of politick."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "cf034e3a-bf4f-413b-a6e6-902a6494e3db",
                                "sense_id": "2a30d568-a5e4-3d7a-8d21-657e87fe2914",
                                "text": "That why you turned the Kanuyaq Land Trust into the IRS for using donations to politic instead of to buy land?"
                            },
                            {
                                "example_id": "8ff04283-1ea7-45eb-b78d-4af2cd48486b",
                                "sense_id": "2a30d568-a5e4-3d7a-8d21-657e87fe2914",
                                "text": "Residents of New York, Illinois and now New Hampshire have watched as their governors waffled, politicked and, in the case of Illinois, possibly broke the law carrying out their duties to appoint a new senator."
                            },
                            {
                                "example_id": "2b7ccd01-34f4-4849-b7a1-314ac44476e5",
                                "sense_id": "2a30d568-a5e4-3d7a-8d21-657e87fe2914",
                                "text": "His brother [Anthony], he politicked him so well, that even his [Jason's] attitude, all the scouts got away from [forgot about] his [bad] attitude because he was a good player."
                            },
                            {
                                "example_id": "5272b366-bf26-4005-bc26-27f11665bf3d",
                                "sense_id": "2a30d568-a5e4-3d7a-8d21-657e87fe2914",
                                "text": "He made errors, and they should have reversed him, but he politicked the thing through."
                            }
                        ]
                    }
                ],
