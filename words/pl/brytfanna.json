            "senses": [
                {
                    "sense_id": "1017af94-3983-3702-84a9-e9dd66dd6a96",
                    "sense_definition": "płaskie naczynie kuchenne przeznaczone do pieczenia mięsa lub ciast w piekarniku",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "naczynie kuchenne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Włożyła doprawionego kurczaka do żeliwnej <w>brytfanny</w> i wstawiła go do nagrzanego piekarnika.",
                            "target_lang_translations": {
                                "ru": "Она положила приправленную курицу в чугунную <w>жаровню</w> и поставила её в разогретую духовку."
                            }
                        },
                        {
                            "text": "Do upieczenia świątecznej pieczeni potrzebna nam będzie duża, głęboka <w>brytfanna</w>.",
                            "target_lang_translations": {
                                "ru": "Для праздничного жаркого нам понадобится большая, глубокая <w>форма для запекания</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bratfana"
                    ],
                    "common_phrases": [
                        "żeliwna brytfanna",
                        "brytfanna do pieczenia",
                        "piec w brytfannie"
                    ],
                    "target_lang_definitions": {
                        "ru": "кухонная посуда с бортиками для запекания мяса, птицы или выпечки в духовке"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жаровня",
                                "target_lang_sense_clarification": "посуда для запекания"
                            },
                            {
                                "target_lang_word": "противень",
                                "target_lang_sense_clarification": "с высокими бортиками"
                            },
                            {
                                "target_lang_word": "гусятница",
                                "target_lang_sense_clarification": "утятница, форма для запекания птицы или мяса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7f4e2cb-5c6e-35f6-8ec3-de15a269cd24",
                    "sense_definition": "chusta wiązana na głowie przez kobiety",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nakrycie głowy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Starsza kobieta poprawiła wełnianą <w>brytfannę</w> zawiązaną szczelnie pod brodą przed wyjściem na mróz.",
                            "target_lang_translations": {
                                "ru": "Пожилая женщина поправила шерстяной <w>платок</w>, плотно завязанный под подбородком, перед тем как выйти на мороз."
                            }
                        },
                        {
                            "text": "Na fotografiach z dawnych lat wiejskie dziewczęta nosiły na głowach kolorowe <w>brytfanny</w>.",
                            "target_lang_translations": {
                                "ru": "На старых фотографиях деревенские девушки носили на головах цветные <w>платки</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
