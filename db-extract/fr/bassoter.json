                        "entry_id": "e492c4a9-ad7a-3f16-9666-5fe119992f52",
                        "glosses": [
                            "Travailler mal et lentement ; faire un mauvais ouvrage."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "459232c0-083a-469b-99b1-303011999a1a",
                                "sense_id": "9aa604c4-25d4-3b69-a6f9-fc53ae90e732",
                                "text": "Celui-là, à l'atelier, il ne fait que bassoter !"
                            }
                        ]
                    },
                    {
                        "sense_id": "ba9c921d-f89c-3618-944b-95c43dd6f39e",
                        "entry_id": "e492c4a9-ad7a-3f16-9666-5fe119992f52",
                        "glosses": [
                            "Effectuer des tâches mineures, rapides, énervantes ou peu complexes"
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e0cb1412-9db6-4e29-a338-3b561d26fa81",
                                "sense_id": "ba9c921d-f89c-3618-944b-95c43dd6f39e",
                                "text": "Le maçon ne vient qu'à 15 heures, alors, en attendant, je bassote."
                            },
                            {
                                "example_id": "b568f55d-5881-45ed-bdad-0c4fb53a3069",
                                "sense_id": "ba9c921d-f89c-3618-944b-95c43dd6f39e",
                                "text": "Mais qu'est-ce que tu bassotes donc là-dedans ‽"
                            }
                        ]
                    }
