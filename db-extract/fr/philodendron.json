                ],
                "senses": [
                    {
                        "sense_id": "c1675697-aaae-3d0d-9e90-c65a8346821d",
                        "entry_id": "020568a0-896b-3104-94e9-49930c8ee7a1",
                        "glosses": [
                            "Philodendron, genre de lianes tropicales vivaces de la famille des aracées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c030d29-e87d-47c9-8098-817520ad6753",
                                "sense_id": "c1675697-aaae-3d0d-9e90-c65a8346821d",
                                "text": "Le philodendron est originaire des forêts de l’Amérique centrale et du Sud-Ouest du Mexique."
                            },
                            {
                                "example_id": "fb1d721d-a713-432b-8b64-a1ab8765c38a",
                                "sense_id": "c1675697-aaae-3d0d-9e90-c65a8346821d",
                                "text": "Très jeune, à 8 ans, il a commencé à s’intéresser à l’aquariophilie ainsi qu’aux plantes. Puis l’idée lui est venue de dépolluer ses aquariums avec des philodendrons et des cryptocorynes."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bf59117-b515-3a2a-97df-ead77c1133f3",
                        "entry_id": "020568a0-896b-3104-94e9-49930c8ee7a1",
                        "glosses": [
                            "Monstera deliciosa, espèce proche des philodendrons, très souvent cultivée comme ornementale."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "151a1d79-1488-43a7-b875-732cb93c3bc0",
                                "sense_id": "7bf59117-b515-3a2a-97df-ead77c1133f3",
                                "text": "Les philodendrons appartiennent à l’ancienne famille des Aroïdées de Jussieu, modifiée par le botaniste autrichien H. W. Schott (1794-1865)."
                            }
                        ]
                    }
