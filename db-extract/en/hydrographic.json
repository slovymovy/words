                                            {
                                                "example_id": "b9640f27-09a8-4422-ae4b-c53d75ce26f3",
                                                "sense_id": "48d1fdea-8718-33cd-b50a-cd192abafc17",
                                                "text": "Een 3D-geprinte plastic kat voor en na zijn hydrografische verfbad"
