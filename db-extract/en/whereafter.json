                                        "entry_id": "bc9b1775-88bc-3662-a1a1-c042ceb6d8e7",
                                        "glosses": [
                                            "auf was hin, wieso"
                                        ],
                                        "tags": [
                                            "interrogativ",
                                            "nachfragend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8fecb38-1e1a-4081-a93e-e47849dcf47d",
                                                "sense_id": "c93259af-13d3-37e7-b49d-5661c52e6935",
                                                "text": "Woraufhin hat er denn so böse reagiert?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "03fb474e-e36a-3e2f-a5ef-205201830a60",
                                        "entry_id": "bc9b1775-88bc-3662-a1a1-c042ceb6d8e7",
                                        "glosses": [
                                            "auf welches hin"
                                        ],
                                        "tags": [
                                            "relativ auf das Gesagte bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37122d01-9605-43a7-9760-7567dfbb2215",
                                                "sense_id": "03fb474e-e36a-3e2f-a5ef-205201830a60",
                                                "text": "Die Firma legte Referenzen vor, woraufhin sie den Auftrag sofort bekam."
                                            },
                                            {
                                                "example_id": "a870a8d3-ba60-4da6-9044-2911f02b3570",
                                                "sense_id": "03fb474e-e36a-3e2f-a5ef-205201830a60",
                                                "text": "„Nein“, sagte er, woraufhin sie entgegnete: „Doch!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b4b59e4-bab5-4b48-92fd-dc5226f3118d",
                        "source_entry_id": "e0c0af20-29fe-36e7-afb9-a67ff61ff28e",
                        "source_sense_id": "c4123f61-a477-393d-8c2f-42365bf58d76",
