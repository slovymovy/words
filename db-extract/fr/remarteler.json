                ],
                "senses": [
                    {
                        "sense_id": "c093cd73-c99c-3421-853e-512c55f06441",
                        "entry_id": "53c5ec29-a205-31b2-b786-868bb764b33a",
                        "glosses": [
                            "Battre une nouvelle fois à coups de marteau."
                        ],
                        "tags": [
                            "literally"
                        ],
                        "examples": [
                            {
                                "example_id": "cf566023-bd57-4a6f-9687-c982f7d94fa8",
                                "sense_id": "c093cd73-c99c-3421-853e-512c55f06441",
                                "text": "Les ressorts, trop bandés pendant quelque temps, ont perdu de leur flèche ; il faudra les démonter et les remarteler pour la leur rendre."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9734fc1-ac4b-3ae0-9748-a2928796febd",
                        "entry_id": "53c5ec29-a205-31b2-b786-868bb764b33a",
                        "glosses": [
                            "Appuyer sans cesse sur les mêmes choses."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "183455d1-db44-4df5-944d-96a1483a5a10",
                                "sense_id": "c9734fc1-ac4b-3ae0-9748-a2928796febd",
                                "text": "À cette façon de remarteler chaque geste ou chaque syllabe, de ralentir la diction, de se pétrifier peu à peu devant l’impensable, l’étrangeté de la folie devenait à la fois charnelle et familière."
                            }
                        ]
                    }
