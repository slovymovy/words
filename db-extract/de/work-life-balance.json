                "senses": [
                    {
                        "sense_id": "8456aa2c-2ea9-3418-b61f-a7c3af9ce37a",
                        "entry_id": "c02c0329-daf1-3974-a8ac-1cbcb43ea524",
                        "glosses": [
                            "gleichgewichtiges Verhältnis zwischen Berufs- und Privatleben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c11079c-08ab-4f21-93a7-3eed46b2b3b8",
                                "sense_id": "8456aa2c-2ea9-3418-b61f-a7c3af9ce37a",
                                "text": "„Menschen im ‚Familienalter‘ zwischen 35 und 44 Jahren sind am wenigsten zufrieden mit ihrer Work-Life-Balance.“"
                            },
                            {
                                "example_id": "0c2c8e4a-3d0a-4f75-9b11-82c28e501348",
                                "sense_id": "8456aa2c-2ea9-3418-b61f-a7c3af9ce37a",
                                "text": "„Nach einigen Jahren stressiger Projekte und unzähliger Nächte in Zügen, auf Flughäfen und in fremden Hotelbetten fühlten sich viele Berater verschlissen und versuchten in Form einer neuen Anstellung ihre Work-Life-Balance wieder geradezubiegen.“"
                            },
                            {
                                "example_id": "9fd0faaa-c9db-46d0-af6c-aabd62f47941",
                                "sense_id": "8456aa2c-2ea9-3418-b61f-a7c3af9ce37a",
                                "text": "„Am späten Nachmittag finden [in Schweden] selbstverständlich keine Meetings mehr statt und wenn der Chef spontan seine Kinder abholen muss, erntet er Anerkennung dafür, sich um seine Familie zu kümmern. Work-Life-Balance ist hier nicht nur ein Modewort, sondern gelebte Realität.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
