                ],
                "senses": [
                    {
                        "sense_id": "5e8df399-f33d-37b8-bccb-a437a3f922f3",
                        "entry_id": "b8a2079a-bf61-3f82-81ec-b910b49fc61d",
                        "glosses": [
                            "(Fachgebiet der) zielgerichtete(n) Verwendung mikroelektronischer Bauelemente beziehungsweise ein solches Bauelement selbst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "128509c2-b884-4915-ac58-e513453fdfa6",
                                "sense_id": "5e8df399-f33d-37b8-bccb-a437a3f922f3",
                                "text": "„Eine Topographie weist Eigenart auf, wenn sie das Ergebnis der eigenen geistigen Arbeit ihres Schöpfers und in der Halbleitertechnik nicht alltäglich ist.“"
                            },
                            {
                                "example_id": "781a28b6-4eb5-4b2a-9a67-fc6f54d0ea1b",
                                "sense_id": "5e8df399-f33d-37b8-bccb-a437a3f922f3",
                                "text": "„Größere Entwicklungssprünge, ohnehin bei großtechnischen Produktionstechniken kaum zu erwarten, werden bei Halbleitertechniken unwahrscheinlicher.“"
                            },
                            {
                                "example_id": "fd48e166-75f2-4baa-8d31-4be09673dec4",
                                "sense_id": "5e8df399-f33d-37b8-bccb-a437a3f922f3",
                                "text": "„Ein solcher Festkörpertunnelkontakt könnte in bestehende Halbleitertechniken integriert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
