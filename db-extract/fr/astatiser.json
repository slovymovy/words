                "senses": [
                    {
                        "sense_id": "11004f22-dd58-331b-befc-9835e9116dc8",
                        "entry_id": "5bde68a0-e707-3496-8bea-a621bb30e40a",
                        "glosses": [
                            "Rendre astatique, en particulier pour mieux mesurer la gravité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b6a9e20-9e35-44c5-b54c-4998d3ea61d2",
                                "sense_id": "11004f22-dd58-331b-befc-9835e9116dc8",
                                "text": "Si l’on veut astatiser l’instrument, on se sert du barreau compensateur (barreau d’Haüy) à la façon habituelle."
                            },
                            {
                                "example_id": "353e9852-f588-451e-af09-3695600b7f01",
                                "sense_id": "11004f22-dd58-331b-befc-9835e9116dc8",
                                "text": "Une méthode nouvelle pour magnétiser et astatiser les aiguilles de galvanomètre, p. 482-488."
                            },
                            {
                                "example_id": "cdacddb4-8719-4b25-844d-ee6c84ae3f3f",
                                "sense_id": "11004f22-dd58-331b-befc-9835e9116dc8",
                                "text": "En plus, si on prend un miroir fin pour du gain en poids et qu’il faut du contre-poids pour astatiser, je ne vois pas trop l’intérêt."
                            }
                        ]
                    }
