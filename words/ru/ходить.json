            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d8bfb4d1-d11d-3f7e-909d-bfc6dacf2ee8",
                    "sense_definition": "Перемещаться по поверхности, переставляя ноги.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Маленький ребёнок уже начал <w>ходить</w> самостоятельно.",
                            "target_lang_translations": {
                                "en": "The small child has already started to <w>walk</w> on their own."
                            }
                        },
                        {
                            "text": "Мы любим <w>ходить</w> пешком по парку в выходные.",
                            "target_lang_translations": {
                                "en": "We love to <w>walk</w> through the park on weekends."
                            }
                        }
                    ],
                    "synonyms": [
                        "шагать",
                        "ступать"
                    ],
                    "common_phrases": [
                        "ходить пешком"
                    ],
                    "target_lang_definitions": {
                        "en": "To move along a surface by taking steps with one's feet."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "walk",
                                "target_lang_sense_clarification": "To move on foot."
                            },
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "To move or travel."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9005d702-faa5-3b1d-bb5e-e36b239d7371",
                    "sense_definition": "Регулярно посещать какое-либо место или мероприятие.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "attendance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дети должны <w>ходить</w> в школу каждый день.",
                            "target_lang_translations": {
                                "en": "Children must <w>attend</w> school every day."
                            }
                        },
                        {
                            "text": "Студенты часто <w>ходят</w> на лекции по истории.",
                            "target_lang_translations": {
                                "en": "Students often <w>go</w> to history lectures."
                            }
                        }
                    ],
                    "synonyms": [
                        "посещать"
                    ],
                    "common_phrases": [
                        "ходить в школу"
                    ],
                    "target_lang_definitions": {
                        "en": "To regularly go to a specific place or event."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "attend",
                                "target_lang_sense_clarification": "To be present at an event or place."
                            },
                            {
                                "target_lang_word": "go",
                                "target_lang_sense_clarification": "To travel to a place for a purpose."
                            },
                            {
                                "target_lang_word": "visit",
                                "target_lang_sense_clarification": "To go to see a place or person."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1404e2f8-a711-3fb8-abda-b2e40f1eff90",
                    "sense_definition": "Быть одетым в какую-либо одежду или носить аксессуары.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wearing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зимой все <w>ходят</w> в тёплых шубах.",
                            "target_lang_translations": {
                                "en": "In winter, everyone <w>wears</w> warm fur coats."
                            }
                        },
                        {
                            "text": "Он постоянно <w>ходит</w> в очках из-за плохого зрения.",
                            "target_lang_translations": {
                                "en": "He constantly <w>wears</w> glasses because of poor eyesight."
                            }
                        }
                    ],
                    "synonyms": [
                        "носить"
                    ],
                    "common_phrases": [
                        "ходить в очках"
                    ],
                    "target_lang_definitions": {
                        "en": "To be wearing specific clothing or accessories."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wear",
                                "target_lang_sense_clarification": "To have clothing or accessories on the body."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92092b91-55d1-38f1-97c0-d8551774d1e5",
                    "sense_definition": "Заботиться о ком-то немощном или выполнять обязанности по уходу за животными.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Медсестра <w>ходит</w> за больным после сложной операции.",
                            "target_lang_translations": {
                                "en": "The nurse <w>cares for</w> the patient after a complex surgery."
                            }
                        },
                        {
                            "text": "Бабушка <w>ходит</w> за коровами на ферме.",
                            "target_lang_translations": {
                                "en": "Grandma <w>looks after</w> the cows on the farm."
                            }
                        }
                    ],
                    "synonyms": [
                        "ухаживать",
                        "заботиться"
                    ],
                    "common_phrases": [
                        "ходить за больным"
                    ],
                    "target_lang_definitions": {
                        "en": "To look after someone who is weak or to perform duties related to animal care."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "care for",
                                "target_lang_sense_clarification": "To look after someone or something."
                            },
                            {
                                "target_lang_word": "look after",
                                "target_lang_sense_clarification": "To take care of someone or something."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "279f9fa2-6685-318a-81e7-1741621702e9",
                    "sense_definition": "Регулярно курсировать по маршруту (о транспорте).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Автобусы до центра города <w>ходят</w> каждые десять минут.",
                            "target_lang_translations": {
                                "en": "Buses to the city center <w>run</w> every ten minutes."
                            }
                        },
                        {
                            "text": "Поезда в этом направлении <w>ходят</w> только по выходным.",
                            "target_lang_translations": {
                                "en": "Trains in this direction <w>run</w> only on weekends."
                            }
                        }
                    ],
                    "synonyms": [
                        "курсировать"
                    ],
                    "common_phrases": [
                        "поезда ходят"
                    ],
                    "target_lang_definitions": {
                        "en": "To travel regularly along a specific route (referring to transport)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "Of transport, to travel a route."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c0fed4d-871b-33a8-8d57-c53caa9419d6",
                    "sense_definition": "Совершать очередной ход в игре.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Теперь твоя очередь <w>ходить</w> в шахматах.",
                            "target_lang_translations": {
                                "en": "Now it is your turn to <w>move</w> in chess."
                            }
                        },
                        {
                            "text": "Игрок решил <w>ходить</w> с дамы, чтобы забрать взятку.",
                            "target_lang_translations": {
                                "en": "The player decided to <w>play</w> the queen to take the trick."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ходить с дамы"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a move in a game."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move",
                                "target_lang_sense_clarification": "To change position in a game."
                            },
                            {
                                "target_lang_word": "play",
                                "target_lang_sense_clarification": "To make a turn in a game."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2f5d626-9806-34b2-9ffc-ff7a54df4c83",
                    "sense_definition": "Работать, функционировать (о механизме, часах).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старые настенные часы перестали <w>ходить</w>.",
                            "target_lang_translations": {
                                "en": "The old wall clock stopped <w>working</w>."
                            }
                        },
                        {
                            "text": "Механизм <w>ходит</w> точно, если его вовремя заводить.",
                            "target_lang_translations": {
                                "en": "The mechanism <w>runs</w> accurately if you wind it on time."
                            }
                        }
                    ],
                    "synonyms": [
                        "работать"
                    ],
                    "antonyms": [
                        "стоять"
                    ],
                    "common_phrases": [
                        "часы ходят"
                    ],
                    "target_lang_definitions": {
                        "en": "To operate or function (referring to a mechanism or clock)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "work",
                                "target_lang_sense_clarification": "To function correctly."
                            },
                            {
                                "target_lang_word": "run",
                                "target_lang_sense_clarification": "To operate or function."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a10fb8e2-a4fa-3261-9685-83bdedceda2c",
                    "sense_definition": "Находиться в денежном обращении.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этой стране <w>ходят</w> только местные монеты.",
                            "target_lang_translations": {
                                "en": "Only local coins <w>circulate</w> in this country."
                            }
                        },
                        {
                            "text": "Старые купюры больше не <w>ходят</w> в магазинах.",
                            "target_lang_translations": {
                                "en": "Old banknotes no longer <w>circulate</w> in stores."
                            }
                        }
                    ],
                    "common_phrases": [
                        "деньги ходят"
                    ],
                    "target_lang_definitions": {
                        "en": "To be in circulation as currency."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "circulate",
                                "target_lang_sense_clarification": "To be in general use."
