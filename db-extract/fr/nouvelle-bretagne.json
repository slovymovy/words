        "fr-extract.jsonl": [
            {
                "entry_id": "5b1b1e56-d7bf-37fb-922e-d3703cf2c9d4",
                "word": "Nouvelle-Bretagne",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "afc21693-1e3d-38e1-9d12-6e641595118f",
                        "entry_id": "5b1b1e56-d7bf-37fb-922e-d3703cf2c9d4",
                        "glosses": [
                            "La plus grande des îles Bismarck, en Papouasie-Nouvelle-Guinée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c64ee4-b9a0-4f84-83f5-95296dea60f0",
                                "sense_id": "afc21693-1e3d-38e1-9d12-6e641595118f",
                                "text": "La Nouvelle-Bretagne se trouve entre la Nouvelle-Guinée et la Nouvelle-Irlande."
                            },
                            {
                                "example_id": "f03bdd56-32c5-4065-a843-cec87e3bd1e5",
                                "sense_id": "afc21693-1e3d-38e1-9d12-6e641595118f",
                                "text": "Il retourna ensuite à Timor, d’où il revint visiter les îles des Papous, longea la Nouvelle-Guinée, découvrit le passage qui porte son nom, appela Nouvelle-Bretagne la grande île qui forme ce détroit à l’est, et reprit sa course pour Timor le long de la Nouvelle-Guinée."
                            }
                        ]
                    },
                    {
                        "sense_id": "6942f736-eef0-3103-8223-609c75609e3e",
                        "entry_id": "5b1b1e56-d7bf-37fb-922e-d3703cf2c9d4",
                        "glosses": [
                            "Autre nom de ce qui est maintenant le Labrador, le Nouveau-Québec et le Nunavut, par opposition à la Nouvelle-France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "086b275a-a09b-4642-880c-6b96a9d70607",
                                "sense_id": "6942f736-eef0-3103-8223-609c75609e3e",
                                "text": "Le nom de Nouvelle-Bretagne, donné aux pays voisins de la baie d’Hudson et au Labrador, n’a pas été généralement adopté, mais on conserve assez généralement les noms donnés aux sous-divisions."
                            }
                        ]
                    },
                    {
                        "sense_id": "608c67e0-325d-3d57-99bd-176009994849",
                        "entry_id": "5b1b1e56-d7bf-37fb-922e-d3703cf2c9d4",
                        "glosses": [
                            "L’ensemble des possessions britanniques nord-américaines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2e24b57-6928-43d8-8d4f-c4ce60ab5c7f",
                                "sense_id": "608c67e0-325d-3d57-99bd-176009994849",
                                "text": "Reine-Charlotte (Détroit de la) ou Queen-Charlotte’s-Sound, détroit sur la côte occid. de l’Amérique septentrionale, dans la Nouvelle-Bretagne. Il sépare du continent les îles Galiano et Valdes, sitées près et au N. de l’extrémité N. O. de l’île de Quadra-et-Vancouver."
                            },
                            {
                                "example_id": "26ca5ca4-01f9-4157-903e-3017bf72c672",
                                "sense_id": "608c67e0-325d-3d57-99bd-176009994849",
                                "text": "L’immense étendue de terres comprises entre le 55° et le 142° longitude occidentale et le 42° et le 78° latitude boréale, désignée communément sous le nom de Nouvelle-Bretagne."
                            },
                            {
                                "example_id": "247d68ec-8a26-4f2f-a777-d36d9834a10b",
                                "sense_id": "608c67e0-325d-3d57-99bd-176009994849",
                                "text": "Nouvelle-Bretagne (archipel de la), voy. Bretagne (Nouvelle-) — On donne aussi le nom de Nouvelle-Bretagne à l’ensemble des possessions anglaises dans le nord de l’Amérique, qui sont le Canada, la Nouvelle-Écosse, le Nouveau-Brunswick, le Labrador, le Maine oriental, la Nouvelle-Galles, le Nouveau-Cornouailles, le Nouveau-Hanovre, ainsi que de vastes contrées sauvages. Voy. la plupart de ces noms."
                            },
                            {
                                "example_id": "d6819762-4595-4856-a34b-b0d9ae55c75a",
                                "sense_id": "608c67e0-325d-3d57-99bd-176009994849",
                                "text": "La Nouvelle-Bretagne appartient aux Anglais […]"
                            },
                            {
                                "example_id": "e67b5a73-7462-44e5-b6b5-ca0ad65986da",
                                "sense_id": "608c67e0-325d-3d57-99bd-176009994849",
                                "text": "Tous les pays qui avoisinent le cercle polaire, la Suède, la Norvège, la Russie, la Sibérie, le Groënland, la Nouvelle-Bretagne, eussent été ensevelis sous cinq lieues d’eau."
                            },
                            {
                                "example_id": "1c135e77-2896-432e-9b79-db33b6d2d44b",
                                "sense_id": "608c67e0-325d-3d57-99bd-176009994849",
                                "text": "Elle arrivait sur les territoires de la Nouvelle-Bretagne, qui avoisinaient le cap Bathurst."
                            },
                            {
                                "example_id": "bf0936ab-02ee-48f1-87a3-0a9f70a7cd81",
                                "sense_id": "608c67e0-325d-3d57-99bd-176009994849",
                                "text": "La Colombie anglaise fait partie de la Nouvelle-Bretagne"
                            }
                        ]
                    }
                ],
