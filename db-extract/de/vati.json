                                        "sense_id": "29dfb806-b532-3c15-bcd2-a9fd45b28954",
                                        "entry_id": "ee76a77d-cba5-3cbf-8ade-16785f18247c",
                                        "glosses": [
                                            "Père, nom par lequel un enfant appelle son père (y compris à l’âge adulte) pour le désigner affectueusement."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe635619-62f7-4500-9e17-1304e2d5602e",
                                                "sense_id": "29dfb806-b532-3c15-bcd2-a9fd45b28954",
                                                "text": "Née sous les châtaigniers de Faverges-de-la-Tour en Isère, cette maman chérie (disparue en 2019) a rencontré son papa, Louis, après la Seconde Guerre mondiale."
                                            },
                                            {
                                                "example_id": "911ec73f-adc5-4b8f-b054-90d35300a323",
                                                "sense_id": "29dfb806-b532-3c15-bcd2-a9fd45b28954",
                                                "text": "Il commence à parler, il dit déjà « papa » et « maman »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54f53b4f-e52d-3cf7-a717-e73b4988ceb3",
                                        "entry_id": "ee76a77d-cba5-3cbf-8ade-16785f18247c",
                                        "glosses": [
                                            "Homme d’un certain âge, qui a de la corpulence et un air de bonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a5cb30c-550a-43d1-86f0-f9b445687708",
                                                "sense_id": "54f53b4f-e52d-3cf7-a717-e73b4988ceb3",
                                                "text": "Vous avez fait aller les autres, papa, la petite vous tient et vous polissonne…"
                                            },
                                            {
                                                "example_id": "2c0d3043-97e1-431a-9c28-e64678940a41",
                                                "sense_id": "54f53b4f-e52d-3cf7-a717-e73b4988ceb3",
                                                "text": "Faire tout à la papa : Sans se hâter, sans se gêner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c91291fb-d836-3605-a900-8dae2df87a7c",
                                        "entry_id": "ee76a77d-cba5-3cbf-8ade-16785f18247c",
                                        "glosses": [
                                            "Homme ou garçon plus âgé que ceux qui parlent de lui."
                                        ],
                                        "tags": [
                                            "Récent"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
