                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "730cf3f8-ba6a-42e9-9535-1a3b0dcb3f39",
                                                "sense_id": "9282b7fc-c0b2-3e9d-bba3-4735700c9786",
                                                "text": "Z černé houšti skočí vlk a vyje, by mu žrát noc dala, neb je lačný."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cdda2bf-49b2-342b-bbd2-2e7e2f36796a",
                                        "entry_id": "f3984e48-147b-3d14-bf32-92e2ba5d2596",
                                        "glosses": [
                                            "(lačný + genitiv) toužící po něčem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a0d444a-391d-414c-ba3b-5dee868d308e",
                                                "sense_id": "7cdda2bf-49b2-342b-bbd2-2e7e2f36796a",
                                                "text": "Nenavštěvovala divadel, ani cirků, ani koncertů, ale jezdila na hony, lačná krve."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea111bec-d13d-4f87-b36b-1ad3115f8716",
