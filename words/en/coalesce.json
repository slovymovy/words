{
    "word_family": [
        "coalescence",
        "coalescent"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d8920c8-a0d3-3e42-9db5-e8d6d7a33b95",
                    "sense_definition": "To come together to form one mass or whole.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "merging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small droplets of rain began to <w>coalesce</w> into a single large puddle on the pavement.",
                            "target_lang_translations": {
                                "ru": "Маленькие капли дождя начали <w>сливаться</w> в одну большую лужу на тротуаре."
                            }
                        },
                        {
                            "text": "Over millions of years, clouds of gas and dust <w>coalesce</w> into stars due to gravity.",
                            "target_lang_translations": {
                                "ru": "На протяжении миллионов лет облака газа и пыли <w>соединяются</w> в звезды под действием гравитации."
                            }
                        }
                    ],
                    "synonyms": [
                        "merge",
                        "fuse",
                        "unite",
                        "blend",
                        "combine"
                    ],
                    "antonyms": [
                        "divide",
                        "segregate"
                    ],
                    "common_phrases": [
                        "coalesce into one",
                        "coalesce into a mass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединяться вместе, образуя единую массу или целое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сливаться",
                                "target_lang_sense_clarification": "о жидкостях или частицах"
                            },
                            {
                                "target_lang_word": "соединяться",
                                "target_lang_sense_clarification": "в единое целое"
                            },
                            {
                                "target_lang_word": "сплачиваться",
                                "target_lang_sense_clarification": "о физических объектах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a92dbd9-db70-31e1-a376-a3e0be7a9e43",
                    "sense_definition": "To combine or unite different elements, groups, or ideas into a single entity or movement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "merging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The various political factions struggled to <w>coalesce</w> around a single candidate before the election.",
                            "target_lang_translations": {
                                "ru": "Различные политические фракции изо всех сил пытались <w>объединиться</w> вокруг единого кандидата перед выборами."
                            }
                        },
                        {
                            "text": "Different artistic styles began to <w>coalesce</w> into a new movement during the late twentieth century.",
                            "target_lang_translations": {
                                "ru": "В конце двадцатого века различные художественные стили начали <w>сливаться</w> в новое направление."
                            }
                        }
                    ],
                    "synonyms": [
                        "amalgamate",
                        "consolidate",
                        "integrate",
                        "conflate",
                        "meld"
                    ],
                    "antonyms": [
                        "divide"
                    ],
                    "common_phrases": [
                        "coalesce around an alternative",
                        "coalesce into a movement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединять различные элементы, группы или идеи в единую структуру или движение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединяться",
                                "target_lang_sense_clarification": "вокруг идеи или лидера"
                            },
                            {
                                "target_lang_word": "сплотиться",
                                "target_lang_sense_clarification": "для совместных действий"
                            },
                            {
                                "target_lang_word": "сливаться",
                                "target_lang_sense_clarification": "о стилях или течениях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d544bd1d-0c79-317c-b6d7-0737109cedba",
                    "sense_definition": "To bond pieces of metal into a continuous whole by liquefying parts of each piece.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "merging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The intense heat caused the two metal plates to <w>coalesce</w> during the welding process.",
                            "target_lang_translations": {
                                "ru": "Сильный нагрев привел к тому, что две металлические пластины <w>сплавились</w> в процессе сварки."
                            }
                        },
                        {
                            "text": "Engineers must ensure the materials <w>coalesce</w> properly to maintain the structural integrity of the joint.",
                            "target_lang_translations": {
                                "ru": "Инженеры должны обеспечить правильное <w>сплавление</w> материалов для сохранения структурной целостности соединения."
                            }
                        }
                    ],
                    "synonyms": [
                        "fuse",
                        "alloy"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять куски металла в единое целое путем расплавления частей каждого куска."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сплавляться",
                                "target_lang_sense_clarification": "о металлах при нагреве"
                            },
                            {
                                "target_lang_word": "сливаться",
                                "target_lang_sense_clarification": "путем плавки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5f5c95c-09a3-3996-905b-48093e85ce63",
                    "sense_definition": "To convert a null or empty value to a defined value within a data set or expression.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "data_processing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can improve the database display by <w>coalescing</w> the ID columns to remove null entries.",
                            "target_lang_translations": {
                                "ru": "Вы можете улучшить отображение базы данных, <w>объединив</w> столбцы ID, чтобы удалить пустые записи."
                            }
                        },
                        {
                            "text": "The software will <w>coalesce</w> the missing data points by using the first available non-null value.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение будет <w>заменять</w> отсутствующие точки данных, используя первое доступное ненулевое значение."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Преобразовывать пустое значение (null) в определенное значение внутри набора данных или выражения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коалесцировать",
                                "target_lang_sense_clarification": "в контексте баз данных и SQL"
                            },
                            {
                                "target_lang_word": "объединять",
                                "target_lang_sense_clarification": "значения для устранения null"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}