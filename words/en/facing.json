                {
                    "sense_id": "34775dd7-2bdb-343e-8914-39f51fb6ec83",
                    "sense_definition": "The collar and cuffs of a military coat, commonly of a different colour from the rest of the coat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_uniforms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The regiment wore bright blue coats with yellow <w>facings</w> on the sleeves.",
                            "target_lang_translations": {
                                "ru": "Полк носил ярко-синие мундиры с желтыми <w>обшлагами</w> на рукавах."
                            }
