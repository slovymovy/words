    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "05279847-4061-3a1a-b64b-15f3381ef7b9",
                "word": "throatiness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5aafe0f4-e835-3006-a2ef-324baae6c18d",
                        "entry_id": "05279847-4061-3a1a-b64b-15f3381ef7b9",
                        "glosses": [
                            "The property of being throaty; roughness, coarseness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a6ba045b-790d-45a2-a141-f49843836dd8",
                                "sense_id": "5aafe0f4-e835-3006-a2ef-324baae6c18d",
                                "text": "Mademoiselle de Roissi’s voice […] is quite free from that throatiness of sound, an invariable characteristic of French voices, which, had we no evidence to the contrary, would lead us to suppose, that Mdlle. de Roissi had studied vocalization in Italy […]"
                            },
                            {
                                "example_id": "ed4ca4a5-f910-42b3-b1eb-feaa32d22873",
                                "sense_id": "5aafe0f4-e835-3006-a2ef-324baae6c18d",
                                "text": "Amazement took the throatiness out of his voice."
                            },
                            {
                                "example_id": "8c6b60e6-659b-4092-aaeb-3cf39599eeca",
                                "sense_id": "5aafe0f4-e835-3006-a2ef-324baae6c18d",
                                "text": "His eyes began to glow and his voice took on the throatiness he used in sermons."
                            }
                        ]
                    },
                    {
                        "sense_id": "1375736d-8e38-356c-bcdb-bf66114c3e07",
                        "entry_id": "05279847-4061-3a1a-b64b-15f3381ef7b9",
                        "glosses": [
                            "The property of having a dewlap or excess skin hanging under the neck."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b785d1f0-27c7-406b-9ef0-b36e47cedf6e",
                                "sense_id": "1375736d-8e38-356c-bcdb-bf66114c3e07",
                                "text": "We have before noticed, that a pendulous skin under the throat, what we term throatiness, is much esteemed, because it is supposed to denote a tendency both to wool and to a heavy fleece."
                            },
                            {
                                "example_id": "6a26a461-e574-469b-9ce6-fad99ece0859",
                                "sense_id": "1375736d-8e38-356c-bcdb-bf66114c3e07",
                                "text": "A variety was produced superior to the Merino in form, carrying less wool, but this more than compensated by its fineness. The excessive throatiness of the Paulars disappeared or was greatly diminished."
                            },
                            {
                                "example_id": "2a67f306-02b6-4552-92c0-9293c8fb7ea6",
                                "sense_id": "1375736d-8e38-356c-bcdb-bf66114c3e07",
                                "text": "1859, “Stonehenge” (John Henry Walsh), The Dog in Health and Disease, London: Longman, Green, Longman & Roberts, Chapter 3, p. 49,\nBoth, however, were large, bony hounds, with long falling ears, but the southern hounds had absolute dewlaps, or at all events such excessive throatiness as to make them rejected in the present day on that account alone."
                            },
                            {
                                "example_id": "fc02a5ad-3105-45d2-8ff1-2e03fb0c3ed9",
                                "sense_id": "1375736d-8e38-356c-bcdb-bf66114c3e07",
                                "text": "The neck [of the foxhound] must be long and clean, without the slightest throatiness."
                            }
                        ]
                    }
                ],
