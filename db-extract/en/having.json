                "senses": [
                    {
                        "sense_id": "fd9af5e4-fdcc-31bd-860e-35e1e288fdf9",
                        "entry_id": "68ffbc0a-00a8-36bf-8ca9-9e6d355ddec3",
                        "glosses": [
                            "The act of possessing; ownership."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4377cce1-4a2f-40f3-8874-3bbed1117853",
                                "sense_id": "fd9af5e4-fdcc-31bd-860e-35e1e288fdf9",
                                "text": "He thus came to think of perceiving as a complex of 'havings,' not a complex of 'havings' and 'doings.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "4de9c5db-2ca4-36e5-bf23-fd46ab39ebf0",
                        "entry_id": "68ffbc0a-00a8-36bf-8ca9-9e6d355ddec3",
                        "glosses": [
                            "Something owned; possession; goods; estate."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2767d9d4-d74f-4067-a147-40674ff46147",
                                "sense_id": "4de9c5db-2ca4-36e5-bf23-fd46ab39ebf0",
                                "text": "Out of my lean and low ability\nI’ll lend you something: my having is not much;\nI’ll make division of my present with you:\nHold, there’s half my coffer."
                            },
                            {
                                "example_id": "32147d9c-ea14-4998-9c6e-a09c469ef5d9",
                                "sense_id": "4de9c5db-2ca4-36e5-bf23-fd46ab39ebf0",
                                "text": "Your havings wasted by the scythe and spade—\nYour rights and charters hobnail’d into slush—"
                            }
                        ]
                    },
                    {
                        "sense_id": "0148c51c-260e-3cb5-80a9-048688b34b31",
