                        "source_sense_id": "c350b3d6-d810-30b4-911e-0f48ea0e4ba3",
                        "source_sense_description": "nur in Verbindung mit kommen oder bringen: in einen annehmbaren Zustand",
                        "target_lang_word": "manage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8654c99f-82c5-3bd1-9fd1-50da308d7353",
                                        "entry_id": "dfff0688-0c35-30c6-b146-7628ba27d7e6",
                                        "glosses": [
                                            "To direct or be in charge of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "606410d2-35ad-457a-b774-c300f01e9460",
                                                "sense_id": "8654c99f-82c5-3bd1-9fd1-50da308d7353",
                                                "text": "Even though Jack is a novice, he manages his team with great success."
                                            },
                                            {
                                                "example_id": "94e266f4-1ca9-4a80-aa80-4632a03c1968",
                                                "sense_id": "8654c99f-82c5-3bd1-9fd1-50da308d7353",
                                                "text": "Interlaken East station is jointly owned with the standard gauge Bern-Lötschberg-Simplon Railway from Bern and Thun and the Swiss Federal Railways metre-gauge Brünig line from Lucerne, but is managed and staffed by the Bernese Oberland group."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02c43aef-6cda-38eb-b241-8b3921a35138",
                                        "entry_id": "dfff0688-0c35-30c6-b146-7628ba27d7e6",
                                        "glosses": [
                                            "To handle or control (a situation, job)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38edafcd-97cb-40ac-9327-bedf6a1fa0d3",
                                                "sense_id": "02c43aef-6cda-38eb-b241-8b3921a35138",
                                                "text": "The government managed the inflation very poorly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50f5a794-16a6-3654-8fb2-63afa4823744",
                                        "entry_id": "dfff0688-0c35-30c6-b146-7628ba27d7e6",
                                        "glosses": [
                                            "To handle with skill, wield (a tool, weapon etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7d7c511-4f3f-4b0b-b35b-8e0239e80c93",
                                                "sense_id": "50f5a794-16a6-3654-8fb2-63afa4823744",
                                                "text": "It was so much his interest to manage his Protestant subjects."
                                            },
                                            {
                                                "example_id": "8fa95804-b3e1-40d1-8384-4806f56585db",
                                                "sense_id": "50f5a794-16a6-3654-8fb2-63afa4823744",
                                                "text": "The moſt vnruly, and the boldeſt boy,\n That euer warlike weapons menaged […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96700cbd-fd0b-3923-9bcf-3e0d723a7251",
                                        "entry_id": "dfff0688-0c35-30c6-b146-7628ba27d7e6",
                                        "glosses": [
                                            "To succeed at an attempt in spite of difficulty."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d494f54-ee28-4f6f-9941-a2df4ee262ea",
                                                "sense_id": "96700cbd-fd0b-3923-9bcf-3e0d723a7251",
                                                "text": "He managed to climb the tower."
                                            },
                                            {
                                                "example_id": "b8807348-93d9-412b-84c7-81a85fa242d9",
                                                "sense_id": "96700cbd-fd0b-3923-9bcf-3e0d723a7251",
                                                "text": "Old Applegate, in the stern, just set and looked at me, and Lord James, amidship, waved both arms and kept hollering for help. I took a couple of everlasting big strokes and managed to grab hold of the skiff's rail, close to the stern."
                                            },
                                            {
                                                "example_id": "8b9faec0-96b7-4132-b460-c2df5650b2f0",
                                                "sense_id": "96700cbd-fd0b-3923-9bcf-3e0d723a7251",
                                                "text": "Congratulations on managing to use the phrase “preponderant criterion” in a chart (“On your marks”, November 9th). Was this the work of a kakorrhaphiophobic journalist set a challenge by his colleagues, or simply an example of glossolalia?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85e66ee4-5ee5-3e61-abb4-10dc2dd23faf",
                                        "entry_id": "dfff0688-0c35-30c6-b146-7628ba27d7e6",
                                        "glosses": [
                                            "To succeed at an attempt in spite of difficulty.",
                                            "To end up doing something that could or should have been avoided."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38697e5b-2d64-4de0-ad40-651e59d3d024",
                                                "sense_id": "85e66ee4-5ee5-3e61-abb4-10dc2dd23faf",
                                                "text": "She somehow managed to sit on the wet paint."
                                            },
                                            {
                                                "example_id": "f3c352e5-7889-453a-9aba-a27eeb95c488",
                                                "sense_id": "85e66ee4-5ee5-3e61-abb4-10dc2dd23faf",
                                                "text": "Despite that, Swindon should have been level in stoppage time, but Mathieu Baudry somehow managed to put a free header over the crossbar from point-blank range."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74704140-780e-3ec2-8de2-24282525e9cd",
                                        "entry_id": "dfff0688-0c35-30c6-b146-7628ba27d7e6",
                                        "glosses": [
                                            "To achieve (something) without fuss, or without outside help."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f591316d-e9d8-43a4-a27d-4e79218c6a47",
                                                "sense_id": "74704140-780e-3ec2-8de2-24282525e9cd",
                                                "text": "It's a tough job, but I'll manage."
                                            },
                                            {
                                                "example_id": "267b6701-072e-4ecd-9721-ca47fc2e97d5",
                                                "sense_id": "74704140-780e-3ec2-8de2-24282525e9cd",
                                                "text": "Plastics are energy-rich substances, which is why many of them burn so readily. Any organism that could unlock and use that energy would do well in the Anthropocene. Terrestrial bacteria and fungi which can manage this trick are already familiar to experts in the field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2252ab43-d847-3a0e-97b3-dcfe971cb643",
                                        "entry_id": "dfff0688-0c35-30c6-b146-7628ba27d7e6",
                                        "glosses": [
                                            "To manage to say; to say while fighting back embarrassment, laughter, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa429431-af5e-437a-a916-80bbb256d630",
                                                "sense_id": "2252ab43-d847-3a0e-97b3-dcfe971cb643",
                                                "text": "\"That's nice, dear!\", she managed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b12273ae-03ad-3b8e-9a31-b5b9271e6183",
                                        "entry_id": "dfff0688-0c35-30c6-b146-7628ba27d7e6",
                                        "glosses": [
                                            "To train (a horse) in the manège; to exercise in graceful or artful action."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9d3e77e4-17e0-3697-b4a8-d9a1234f0d56",
                                        "entry_id": "dfff0688-0c35-30c6-b146-7628ba27d7e6",
                                        "glosses": [
                                            "To treat with care; to husband."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60fad5d4-356b-4b19-9276-1a6483b04f17",
                                                "sense_id": "9d3e77e4-17e0-3697-b4a8-d9a1234f0d56",
                                                "text": "[She] […]manages her last half-crown with care,\nAnd trudges to the Mall, on foot"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f40b77b1-e1fd-3b9b-bf4f-0f18b93ea9cf",
                                        "entry_id": "dfff0688-0c35-30c6-b146-7628ba27d7e6",
                                        "glosses": [
                                            "To bring about; to contrive."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "739cd588-944c-4e0d-9126-2d35aaace468",
                                                "sense_id": "f40b77b1-e1fd-3b9b-bf4f-0f18b93ea9cf",
                                                "text": "in a town of war,\nYet wild, the people's hearts brimful of fear,\nTo manage private and domestic quarrel,\nIn night, and on the court and guard of safety!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "manage",
                                "target_lang_code": "en",
                                "target_senses": [
