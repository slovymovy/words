                    ]
                },
                {
                    "sense_id": "bb8f3bfb-d438-3c3c-8bb9-b8c6eefe7f93",
                    "sense_definition": "Zeitweiliger Stillstand des Fristablaufs, während dessen die Verjährungsfrist nicht weiterläuft",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Verhandlungen zwischen den beiden Parteien führten zu einer vorübergehenden <w>Hemmung</w> der Verjährung."
                        },
                        {
                            "text": "Mit der Klageerhebung tritt eine gesetzliche <w>Hemmung</w> der Frist ein."
                        }
                    ],
                    "common_phrases": [
