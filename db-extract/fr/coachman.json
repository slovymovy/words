                        "sense_id": "a3f746fc-77b4-3e0d-ad78-ab93291f5f76",
                        "entry_id": "e1271220-4b09-30f5-861a-42400b68a20e",
                        "glosses": [
                            "Synonyme de cocher."
                        ],
                        "tags": [
                            "Anglicism",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "54595b1a-6326-4821-8d40-d5790be03f7c",
                                "sense_id": "a3f746fc-77b4-3e0d-ad78-ab93291f5f76",
                                "text": "Ernest descendit lentement de sa banquette en vrai coachman, sans prendre garde à Dick, sur le bras duquel il s’appuyait."
                            },
                            {
                                "example_id": "d40cb820-b857-45c5-99f2-bd7fb82ec253",
                                "sense_id": "a3f746fc-77b4-3e0d-ad78-ab93291f5f76",
                                "text": "Cet illustre coachman avait invité à déjeuner M. Boyer, valet de chambre de confiance du vicomte."
                            },
                            {
                                "example_id": "0b1fc6cd-9fe2-495e-92c0-465c634e14ff",
                                "sense_id": "a3f746fc-77b4-3e0d-ad78-ab93291f5f76",
                                "text": "Sous le fouet du coachman le break roulait rapidement, le long du littoral de l'Érié, et se dirigeait vers sa pointe sud-ouest."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc065cec-5be0-3f7d-9568-bd7b293e5405",
                        "entry_id": "e1271220-4b09-30f5-861a-42400b68a20e",
                        "glosses": [
                            "Type de paletot élégant porté à Paris entre 1847 et la fin du Second Empire."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9cca335b-80fa-433e-8f17-866ed18f92b8",
                                "sense_id": "cc065cec-5be0-3f7d-9568-bd7b293e5405",
                                "text": "L’uniforme prussien se compose d’une tunique très-courte, qui a beaucoup l’air d’un coachman à la mode, moins l’élégance."
                            },
                            {
                                "example_id": "99317b1a-b293-4436-b9d4-a064ceab6c88",
                                "sense_id": "cc065cec-5be0-3f7d-9568-bd7b293e5405",
                                "text": "Du temps que son coachman, pâle comme un navet,\nSe recourbait en plis tortueux, et n’avait\nPlus de collet d’aucune sorte …"
                            },
                            {
                                "example_id": "ca029ef3-5b1d-44f3-93ec-ba26945f8005",
                                "sense_id": "cc065cec-5be0-3f7d-9568-bd7b293e5405",
                                "text": "Il voulut remettre la missive dans sa poche, mais sa grosse main tremblait ; la lettre glissa entre le nankin de son coachman et le nankin de son gilet."
                            },
                            {
                                "example_id": "cfc720cc-af2c-442c-bb80-65903452cca6",
                                "sense_id": "cc065cec-5be0-3f7d-9568-bd7b293e5405",
                                "text": "Cependant, à sa façon d’entrer, de dire bonjour à la bonne femme, et d’accrocher son coachman et son chapeau dans le vestibule, on devinait qu’il était le maître de céans."
                            }
                        ]
                    }
                ],
