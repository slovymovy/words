                    },
                    {
                        "translation_id": "4090cf97-b911-47a7-8dec-87d9c4a0ff2a",
                        "source_entry_id": "4aa06623-f4f3-3942-9228-bc139e494683",
                        "source_sense_id": "33a54199-d6a2-385b-bfd6-528bd674accf",
                        "source_sense_description": "iemand die een apparaat op een goede manier laat functioneren",
                        "target_lang_word": "operator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "operator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b673a74f-252e-337e-b747-06595cae5d3f",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A person or organisation that operates a device, system, service, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eff1fb0-fb8a-426f-b0a9-1f1bd11eaf28",
                                                "sense_id": "b673a74f-252e-337e-b747-06595cae5d3f",
                                                "text": "The drone crashed because of operator error."
                                            },
                                            {
                                                "example_id": "bd82ed68-2e0f-46bf-acc8-6fa4a9541240",
                                                "sense_id": "b673a74f-252e-337e-b747-06595cae5d3f",
                                                "text": "The new bus operator has promised to improve the frequency of rural services."
                                            },
                                            {
                                                "example_id": "f3db9356-8be8-4e8b-9b5f-d760b17356e3",
                                                "sense_id": "b673a74f-252e-337e-b747-06595cae5d3f",
                                                "text": "The stories did not seem to me to touch life. […] They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46fa5d13-0c30-31b4-88cb-a80ed0766120",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A telecommunications facilitator whose job is to connect or otherwise assist callers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d726a8be-1ea0-4ce4-bcc3-231449abbd9e",
                                                "sense_id": "46fa5d13-0c30-31b4-88cb-a80ed0766120",
                                                "text": "To get an international line, you used to have to go through the operator."
                                            },
                                            {
                                                "example_id": "e722890d-f13e-417a-a4fa-a680bdf4c1f0",
                                                "sense_id": "46fa5d13-0c30-31b4-88cb-a80ed0766120",
                                                "text": "I kept getting \"number unobtainable\", so I called the operator to find out what was going on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7114d3a2-d57a-3930-a5b6-69b5c0f71367",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A member of a military special operations unit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e93bc7eb-fc86-35c2-912e-29fefd142b50",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "The game of Chinese whispers."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35aa7858-cdac-3bff-9a13-632afea2f679",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A person who is adept at making deals or getting results, especially one who uses questionable methods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b7de5c2-3bf8-40e0-896d-489c5fffb926",
                                                "sense_id": "35aa7858-cdac-3bff-9a13-632afea2f679",
                                                "text": "Francis Urquhart: I think Lord Billsborough is starting to lose touch a bit.\nTim Stamper: Shame. Used to be a hell of an operator in his day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cad28ed-dd23-3301-bef3-e9f76031ea02",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A function or other mapping that carries values defined on a domain into another value or set of values in a defined range."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "614cae83-8eaa-37f0-956a-a3ee1dcad9ce",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "The administrator of a channel or network on IRC."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a7960bd-9a7d-39f8-8385-d5dc3e174ff6",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A symbol that represents a construct in a programming language and differs from a normal function in its syntax."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cafd2ea-5d08-38e3-9aa2-3bafa37f64fc",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A kind of expression that enters into an a-bar movement dependency and is said to bind a variable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00a816e6-d84c-46df-9910-fa24a6c2b802",
                                                "sense_id": "3cafd2ea-5d08-38e3-9aa2-3bafa37f64fc",
                                                "text": "In the sentence \"What did Bill say he wants to buy?\", \"what\" is an operator, binding a phonetically empty variable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9037a4c8-06e6-3d57-b0aa-62be8682a5cb",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A bus driver."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39b51020-0203-3352-8ed8-35b69e1216ff",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "The company that operates a mine; often the same one that owns the mine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24a14393-a5a0-3e4d-86da-41dc14d06d81",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A thief or charlatan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "299cd4d8-9466-4df0-ae37-94ddacd42b58",
                                                "sense_id": "24a14393-a5a0-3e4d-86da-41dc14d06d81",
                                                "text": "Sir Ol. Sirrah! I got many a round Sum by it, when my Father wou'd not give me a Groat—Then, Sir, I was in with all the Top Gameſters, and when there was a fat Squire to be fleec'd; I had my Office among them too, and tho' I ſay it, was one of the neateſt Operators about Town."
                                            },
                                            {
                                                "example_id": "813bb06a-5271-4104-9bb9-6980f3274c0c",
                                                "sense_id": "24a14393-a5a0-3e4d-86da-41dc14d06d81",
                                                "text": "Hank was saying, \"Lyssa showed me the screenshots of Nate's accounts, so we know he's helping himself to Nate's money every month. The guy's a real operator.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b07564d-fe90-3a77-9e92-4c98f1f991f2",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A major criminal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc530beb-690f-47a0-9180-47894ac2b8ce",
                                                "sense_id": "1b07564d-fe90-3a77-9e92-4c98f1f991f2",
                                                "text": "He started bleating to me this morning aboot being stretched on this hippy stalk. A fuckin waste of time. Big operators flooding the city with smack and three-quarters of the cunts we bang up are daft schemies or students with a wee bit of hash or a few pills for their pals."
                                            },
                                            {
                                                "example_id": "2846ea56-2ac0-4d13-b66a-49ecc0e22a17",
                                                "sense_id": "1b07564d-fe90-3a77-9e92-4c98f1f991f2",
                                                "text": "The second thing is that smart operators like Cocky are only in it for the (huge amounts of) money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d4537b5-284e-3095-be92-faf775bcb5d1",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "Someone who is successful at pursuing women; a player."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fc1129b-0ceb-4122-afa6-da3112f644ea",
                                                "sense_id": "0d4537b5-284e-3095-be92-faf775bcb5d1",
                                                "text": "I give credit to men who are great operators, as we once called them, with the girls. Once I was interviewing one of the most beautiful girls in the world in her suite at the Hotel Plaza. While she was busily denying to me that there was anything serious in her relationship with Warren Beatty, who should be barging into the next room of the suite with a lot of clothes being removed from another suite, but Warren Beatty?"
                                            },
                                            {
                                                "example_id": "c0b23353-b047-4338-9bbe-90da1a80e4fc",
                                                "sense_id": "0d4537b5-284e-3095-be92-faf775bcb5d1",
                                                "text": "\"Of course you're right, but the Baron is unfortunately a bit of an operator, if you know what I mean. He likes the ladies,\" said Salvatore with a wicked grin. \"So he never gets in until two, sometimes even three in the morning, and that's because he goes dancing at the Mela; he's quite a playboy.\""
                                            },
                                            {
                                                "example_id": "12e79c97-f6ec-4bf7-81ff-7f57aad97cad",
                                                "sense_id": "0d4537b5-284e-3095-be92-faf775bcb5d1",
                                                "text": "Anyway, there's gonna be plenty of girls. Plenty of girls for an operator like you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ad019f0-4847-44bb-a462-a1f821061859",
                        "source_entry_id": "4aa06623-f4f3-3942-9228-bc139e494683",
                        "source_sense_id": "26f38c4a-d240-3367-a994-0a197ad4bbaf",
                        "source_sense_description": "iets of iemand die ervoor moet zorgen dat de wensen van een ander worden vervult",
                        "target_lang_word": "server",
                        "target_lang_code": "en",
