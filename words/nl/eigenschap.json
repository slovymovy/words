    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "95db9912-d551-32f2-9666-876c40a605a0",
                    "sense_definition": "Een kenmerk of kwaliteit die typisch is voor een bepaald persoon of voorwerp.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "characteristic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Geduld is een goede <w>eigenschap</w> voor een leraar.",
                            "target_lang_translations": {
                                "ru": "Терпение — это хорошее <w>качество</w> для учителя.",
                                "en": "Patience is a good <w>quality</w> for a teacher.",
                                "zh": "耐心是老师的一种良好<w>品质</w>。"
                            }
                        },
                        {
                            "text": "Hij heeft de vervelende <w>eigenschap</w> om mensen steeds te onderbreken.",
                            "target_lang_translations": {
                                "ru": "У него есть неприятная <w>черта</w> постоянно перебивать людей.",
                                "en": "He has the annoying <w>trait</w> of constantly interrupting people.",
                                "zh": "他有一个总是打断别人说话的坏<w>习惯</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "karakteristiek",
                        "kenmerk"
                    ],
                    "common_phrases": [
                        "goede eigenschap",
                        "slechte eigenschap",
                        "persoonlijke eigenschap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерная черта или качество, присущее определенному человеку или предмету.",
                        "en": "A characteristic or quality typical of a particular person or object.",
                        "zh": "某人或某物所特有的品质或特征。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "качество",
                                "target_lang_sense_clarification": "черта характера"
                            },
                            {
                                "target_lang_word": "черта",
                                "target_lang_sense_clarification": "особенность"
                            },
                            {
                                "target_lang_word": "свойство",
                                "target_lang_sense_clarification": "общий признак"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "quality",
                                "target_lang_sense_clarification": "personal attribute"
                            },
                            {
                                "target_lang_word": "trait",
                                "target_lang_sense_clarification": "character feature"
                            },
                            {
                                "target_lang_word": "characteristic",
                                "target_lang_sense_clarification": "distinguishing feature"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "品质",
                                "target_lang_sense_clarification": "指人的品格或素质"
                            },
                            {
                                "target_lang_word": "特征",
                                "target_lang_sense_clarification": "指事物可辨认的标志"
                            },
                            {
                                "target_lang_word": "特点",
                                "target_lang_sense_clarification": "指人或事物所具有的独特地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdf89e36-696f-3594-aea3-4d8b7ec08395",
                    "sense_definition": "Een specifiek, vaak technisch of wetenschappelijk kenmerk waardoor iets zich onderscheidt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "characteristic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water heeft de bijzondere <w>eigenschap</w> dat het uitzet als het bevriest.",
                            "target_lang_translations": {
                                "ru": "У воды есть особое <w>свойство</w> расширяться при замерзании.",
                                "en": "Water has the special <w>property</w> of expanding when it freezes.",
                                "zh": "水有一个特殊的<w>特性</w>，即结冰时会膨胀。"
                            }
                        },
                        {
                            "text": "Je kunt de <w>eigenschappen</w> van het bestand aanpassen in het menu.",
                            "target_lang_translations": {
                                "ru": "Вы можете изменить <w>свойства</w> файла в меню.",
                                "en": "You can adjust the file <w>properties</w> in the menu.",
                                "zh": "你可以在菜单中调整文件的<w>属性</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chemische eigenschappen",
                        "fysieke eigenschappen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфическая, часто техническая или научная характеристика, отличающая объект.",
                        "en": "A specific, often technical or scientific feature that distinguishes something.",
                        "zh": "事物本身所固有的性质，常用于科学或技术领域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свойство",
                                "target_lang_sense_clarification": "физическое или химическое"
                            },
                            {
                                "target_lang_word": "характеристика",
                                "target_lang_sense_clarification": "технический параметр"
                            }
                        ],
                        "en": [
