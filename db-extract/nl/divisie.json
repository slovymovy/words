                                    {
                                        "sense_id": "80fef304-cf06-39dc-b072-ce2bebd08c49",
                                        "entry_id": "af0d90a5-b3d6-3fdc-bd72-6aa7667fdd7e",
                                        "glosses": [
                                            "Vorgang des Dividierens/Teilens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e1b0998-66a8-4857-9da5-d149cc86fca7",
                                                "sense_id": "80fef304-cf06-39dc-b072-ce2bebd08c49",
                                                "text": "Die Division durch Null ist normalerweise nicht möglich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99c6d75f-5c40-3cd5-94d1-15afd4e38ff3",
                                        "entry_id": "af0d90a5-b3d6-3fdc-bd72-6aa7667fdd7e",
                                        "glosses": [
                                            "ein militärischer Großverband, der zur selbständigen Gefechtsführung fähig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "970d959c-38fe-4a22-92c9-81d8cc3644a3",
                                                "sense_id": "99c6d75f-5c40-3cd5-94d1-15afd4e38ff3",
                                                "text": "Die zweite Division war in der Schlacht erfolgreich."
                                            },
                                            {
                                                "example_id": "db1a03d7-bfe4-45f2-9a45-01fb422c2bbf",
                                                "sense_id": "99c6d75f-5c40-3cd5-94d1-15afd4e38ff3",
                                                "text": "„Wo die Amerikaner immer neue Divisionen heranführen konnten, alle voll ausgerüstet und in Kriegsstärke, ließen sich die Verluste an Menschen und Material auf deutscher Seite nicht mehr wettmachen.“"
                                            },
                                            {
                                                "example_id": "1667546d-37d4-4deb-957b-5dc43e2ab7bd",
                                                "sense_id": "99c6d75f-5c40-3cd5-94d1-15afd4e38ff3",
                                                "text": "„Zwei Offiziere von seiner Division setzten sich zu ihm.“"
                                            },
                                            {
                                                "example_id": "129439f5-a52a-481d-8a59-bc13c6df395c",
                                                "sense_id": "99c6d75f-5c40-3cd5-94d1-15afd4e38ff3",
                                                "text": "„Die Deutschen setzten 190 Divisionen ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dfa3e107-0f2c-3ddb-96b5-0978ca04fedb",
                                        "entry_id": "af0d90a5-b3d6-3fdc-bd72-6aa7667fdd7e",
                                        "glosses": [
                                            "Spielklasse"
                                        ],
                                        "tags": [
                                            "besonders in Frankreich und Großbritannien, zeitweise auch in Österreich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8341b02a-9053-4181-8346-5c6c71f94394",
                                                "sense_id": "dfa3e107-0f2c-3ddb-96b5-0978ca04fedb",
                                                "text": "„Durch die Aufstockung der Ersten Division von zehn auf 16 Teams, gelang unter dem jungen Trainer Ernst Dokupil im Jahr 1982 noch einmal die Rückkehr in die oberste Spielklasse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e52d0cc6-226a-3375-8ec7-65c69d0db55c",
                                        "entry_id": "af0d90a5-b3d6-3fdc-bd72-6aa7667fdd7e",
                                        "glosses": [
                                            "Geschäftsbereich, Sparte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7572dcd8-cfa6-4601-a353-6c3a7cd6810a",
                                                "sense_id": "e52d0cc6-226a-3375-8ec7-65c69d0db55c",
                                                "text": "„So komme laut Finanzkreisen mithilfe der US-Investmentbank JP Morgan eine Abspaltung oder ein Verkauf der Division Payment Services infrage; bis zu 2 Mrd. Fr. könnte ein solcher Schritt einbringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
