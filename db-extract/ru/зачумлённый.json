                        "target_lang_word": "pestiféré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pestiféré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe06421b-526f-3678-b25a-03b33a1e1e3b",
                                        "entry_id": "57fe3591-d870-3991-9291-0f51bb25f17b",
                                        "glosses": [
                                            "Qui est infecté de la peste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fcd693b-c4b1-4022-ba2a-80b42c193fd1",
                                                "sense_id": "fe06421b-526f-3678-b25a-03b33a1e1e3b",
                                                "text": "Il venait d’un lieu pestiféré."
                                            },
                                            {
                                                "example_id": "f57cc5a8-596f-4e2d-a8ec-bc987f1b6cc1",
                                                "sense_id": "fe06421b-526f-3678-b25a-03b33a1e1e3b",
                                                "text": "On brûla ces marchandises, comme pestiférées..."
                                            },
                                            {
                                                "example_id": "90f73c1f-79d4-466d-be34-d675ec3f9c99",
                                                "sense_id": "fe06421b-526f-3678-b25a-03b33a1e1e3b",
                                                "text": "Vous eussiez dit la Mort souriant au milieu d’une famille pestiférée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pestiféré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "596d56a8-e356-3437-8f8e-292230d837f1",
                                        "entry_id": "2402a753-a4c0-348a-8439-cf29fb48a4a8",
                                        "glosses": [
                                            "Personne qui est atteinte de la peste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a88a394-9ad7-4bfc-ae34-6fea703db33a",
                                                "sense_id": "596d56a8-e356-3437-8f8e-292230d837f1",
                                                "text": "Il fit vœu si Dieu lui rendait la vie de la consacrer au service des pestiférés."
                                            },
                                            {
                                                "example_id": "a28d8ee1-15f6-497b-85fa-f52053f40dd8",
                                                "sense_id": "596d56a8-e356-3437-8f8e-292230d837f1",
                                                "text": "Le pestiféré est d’abord un être qui subit les affres de la maladie (fièvres intenses, douleurs temporales, contorsions des corps) il est en proie à une épreuve extrême, avant la mort."
                                            },
                                            {
                                                "example_id": "bb69be9c-c549-4f9e-a9ae-b98ff6a25b0c",
                                                "sense_id": "596d56a8-e356-3437-8f8e-292230d837f1",
                                                "text": "Ainsi qu'ailleurs, par exemple au Mans et à Saint-Jacques de Paris, Reims construira un lazaret ou « bureau de santé » pour les pestiférés, et ce bureau sera tenu par les Capucins."
                                            }
                                        ]
                                    }
                                ]
                            },
