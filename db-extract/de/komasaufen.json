                        "sense_id": "c0c42150-f93e-3157-b362-25badde4e5ff",
                        "entry_id": "1e91d63c-1210-311a-9ad5-eedd9af2712b",
                        "glosses": [
                            "exzessives Trinken von Alkohol (auch bis zum Verlust des Bewusstseins)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f999f50f-ae20-4be0-ae71-1d245c5d9c5c",
                                "sense_id": "c0c42150-f93e-3157-b362-25badde4e5ff",
                                "text": "Auf der nächsten Party ist wieder Komasaufen angesagt."
                            },
                            {
                                "example_id": "f5c54fde-7f6f-4e0c-8d71-d12f4accbba8",
                                "sense_id": "c0c42150-f93e-3157-b362-25badde4e5ff",
                                "text": "„Gerade unter Jugendlichen tritt in den letzten Jahren vermehrt das Phänomen des »Komasaufens« auf. Manche Jugendliche kennen ihr Limit nicht oder wollen einfach mithalten. Wodka wird wie Wasser getrunken.“"
                            },
                            {
                                "example_id": "31bd483a-dd37-4a08-88c3-153e8812053b",
                                "sense_id": "c0c42150-f93e-3157-b362-25badde4e5ff",
                                "text": "„650 Dixie-Klos und Urinale sollen Wildpinkler stoppen, 30 Streetworker allein am Rheinufer Jugendliche vom Komasaufen abhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
