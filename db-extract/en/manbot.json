                        "entry_id": "2e8d1b2f-05b5-30ef-8844-9f189c0771c0",
                        "glosses": [
                            "A male or masculine robot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b0a0613-ab4e-4449-8d00-5cfa9da6d3b1",
                                "sense_id": "5fc5fb78-e8dc-3052-bb94-addea1602b2e",
                                "text": "It's the future and every home in the US owns a manbot or fembot—robots designed to make life easier and obey an owner's every command."
                            },
                            {
                                "example_id": "0190c40b-386d-4782-aeb2-232f3c285215",
                                "sense_id": "5fc5fb78-e8dc-3052-bb94-addea1602b2e",
                                "text": "She searched her memory banks but couldn't find anything that would have upset Bob about robots. In fact Bob had worked side by side with manbots at his first job, on an assembly line in Detroit, making jet sleds."
                            },
                            {
                                "example_id": "83527287-983d-49d1-8cd7-75fed521ba30",
                                "sense_id": "5fc5fb78-e8dc-3052-bb94-addea1602b2e",
                                "text": "“Manbots,” not a term used on the series, appear in the form of the Oscar robot who battles with Steve in “Kill Oscar, part 2” […]"
                            }
                        ]
                    }
