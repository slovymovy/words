                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b2cc1f7-371a-40e3-90b8-e0878ce582f0",
                                                "sense_id": "25d065f8-8dfe-3882-8d7d-f92fb4b6a570",
                                                "text": "In der Taufe bekam er die Namen Maik Lothar Maximilian."
                                            },
                                            {
                                                "example_id": "f34e389f-d8f0-47a6-95bc-05930877caa3",
                                                "sense_id": "25d065f8-8dfe-3882-8d7d-f92fb4b6a570",
                                                "text": "„Die Taufe fand wie meine Geburt in Quebec statt.“"
                                            }
                                        ],
