                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2aefb8a-842d-4931-932c-599af6ed806b",
                        "source_entry_id": "550e110f-b37c-366a-b8a2-38f498f9729a",
                        "source_sense_id": "4c6221af-b795-374e-9ce0-ef90034381f7",
                        "source_sense_description": "branch of botany dealing with algae",
                        "target_lang_word": "algologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "algologie",
