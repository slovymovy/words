                                "example_id": "18684925-6273-444a-8c96-77e6fad49bef",
                                "sense_id": "17b82abb-ffc8-3649-83cb-5bd09da46d81",
                                "text": "An unmetaphorical style you shall in vain seek for: is not your very Attention a Stretching-to?"
                            },
                            {
                                "example_id": "78f63169-af48-4864-b048-a94d937efa0c",
                                "sense_id": "17b82abb-ffc8-3649-83cb-5bd09da46d81",
                                "text": "A Little Night Music crosses Ingmar Bergman's randy Smiles of a Summer Night with Stephen Sondheim's typically chilly emotionalism; the result is a spectrum of romantic pathologies—including several shades of metaphorical incest and several more entirely unmetaphorical adulteries—played out against a background of summer vacation sensuality."
                            }
                        ]
