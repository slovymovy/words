                            {
                                "example_id": "0d30156e-30e9-48ef-abe5-53d094e6e471",
                                "sense_id": "ac952dc5-7e01-3adf-905b-1caa3c61c6f9",
                                "text": "Le décanat de M. Bronot aura ouvert largement la Sorbonne primaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb0b820d-fae9-3623-a422-a764bdbd09fd",
                        "entry_id": "7f0321cc-695c-3a9c-8e68-ba3d66db1bc4",
                        "glosses": [
                            "Territoire sous l'administration d'un doyen."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ca90fe60-31a0-4fe5-b736-936d8ee79ead",
                                "sense_id": "eb0b820d-fae9-3623-a422-a764bdbd09fd",
                                "text": "Une bénédiction de calvaire eut lieu, il n'y a pas encore un an , à Lez-Fontaine, décanat de Solre-le-Château, diocèse de Cambrai. Cette bénédiction fut faite par M. Gérard, doyen, curé de Solre-le-Château, qui prononça un discours dans l'église, trop petite pour contenir tout le monde accouru à cette cérémonie."
                            },
                            {
                                "example_id": "366b461f-d162-44ca-b388-528cc863e15f",
                                "sense_id": "eb0b820d-fae9-3623-a422-a764bdbd09fd",
                                "text": "On appelait décanats wallons, dans le diocèse de Trêves, quatre décanats où l'on parlait la langue wallonne, et qui ont fait l'objet de contestations très-sérieuses pendant longtemps entre la France et l'empire d'Allemagne."
                            }
                        ]
                    }
