                "senses": [
                    {
                        "sense_id": "ac1bf606-5479-3cec-8655-de1ea43ab395",
                        "entry_id": "0e698a74-a78b-3cfd-b6ea-e9e915bcdddf",
                        "glosses": [
                            "het belangrijkste feest van het christendom, waarbij de Opstanding van Jesus centraal staat"
                        ],
                        "tags": [
                            "feest"
                        ],
                        "examples": [
                            {
                                "example_id": "b33d0f58-d179-406b-8021-49eb472d9ff0",
                                "sense_id": "ac1bf606-5479-3cec-8655-de1ea43ab395",
                                "text": "Pasen wordt gevierd op de zondag na de eerste volle maan in de lente."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e505e866-5ca1-4811-a977-2e97c5f965a7",
                        "source_entry_id": "0e698a74-a78b-3cfd-b6ea-e9e915bcdddf",
                        "source_sense_id": "ac1bf606-5479-3cec-8655-de1ea43ab395",
                        "source_sense_description": "het belangrijkste feest van het christendom, waarbij de Opstanding van Jesus centraal staat",
                        "target_lang_word": "Ostern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ostern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ee3ad8ee-830f-3530-988b-b33e29893d95",
                                        "entry_id": "85e3d7a0-0da3-32cb-b34e-7db00d1e2db1",
                                        "glosses": [
                                            "Fest der Auferstehung Jesu Christi, beginnend zum Sonntag nach dem ersten Frühlingsvollmond"
                                        ],
                                        "tags": [
                                            "meist ohne Artikel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5bd62b0-b909-45ec-9944-159acb546e86",
                                                "sense_id": "ee3ad8ee-830f-3530-988b-b33e29893d95",
                                                "text": "In einer Woche ist Ostern."
                                            },
                                            {
                                                "example_id": "365e47ed-a523-4499-8fbe-d7ed08e97bb4",
                                                "sense_id": "ee3ad8ee-830f-3530-988b-b33e29893d95",
                                                "text": "„Das Interessanteste war noch der Wetterbericht, der für die Woche nach Ostern schlechtes Wetter im Norden vorhersagte.“"
                                            },
                                            {
                                                "example_id": "a79dc642-bfd2-441a-b0e9-8cdb077e95c9",
                                                "sense_id": "ee3ad8ee-830f-3530-988b-b33e29893d95",
                                                "text": "Wir fahren über Ostern nach Dänemark."
                                            },
                                            {
                                                "example_id": "fe4b2c29-71f4-4a62-ac6b-a1e343bedc5d",
                                                "sense_id": "ee3ad8ee-830f-3530-988b-b33e29893d95",
                                                "text": "Letzte Ostern waren wir in Bayern."
                                            },
                                            {
                                                "example_id": "b0a38761-bb6f-4dc6-8a8b-484bb68b2ec3",
                                                "sense_id": "ee3ad8ee-830f-3530-988b-b33e29893d95",
                                                "text": "schriftdeutsch: Bis 1966 wurde man in Deutschland zu Ostern eingeschult."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e8296eeb-4008-3f0d-b27a-28627ef3aa07",
                                        "entry_id": "85e3d7a0-0da3-32cb-b34e-7db00d1e2db1",
                                        "glosses": [
                                            "„zu Ostern“ oder „an Ostern“"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7091c351-f925-41ec-b8ed-f1f0ca23eae1",
                                                "sense_id": "e8296eeb-4008-3f0d-b27a-28627ef3aa07",
                                                "text": "umgangssprachlich: Bis 1966 wurde man in Deutschland Ostern eingeschult."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
