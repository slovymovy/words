                        "glosses": [
                            "skoczek spadochronowy, żołnierz lub sportowiec uprawiający skoki ze spadochronem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6ded93f-b161-4b90-886a-302979ab59f5",
                                "sense_id": "ccc3689d-ec28-3beb-8f2d-8f74dcd9bf5d",
                                "text": "Spadochroniarz opada ruchem prostoliniowym jednostajnym."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4e3b2abf-1cfe-3816-a335-37843e13da31",
                        "entry_id": "09149431-c363-3510-bd41-ee5ceaf8dfde",
                        "glosses": [
                            "uczeń powtarzający klasę"
                        ],
                        "tags": [
