                "senses": [
                    {
                        "sense_id": "302046b3-acd9-3b98-ada0-933bd22c8fb8",
                        "entry_id": "a2ab3fc8-b7ed-386d-8f83-3edb2a35f941",
                        "glosses": [
                            "(männliche) Person, die gefühlsblind ist, Gefühlslegasthenie hat"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e87fecae-ea4c-40ca-88d5-0f9c29cbfe29",
                                "sense_id": "302046b3-acd9-3b98-ada0-933bd22c8fb8",
                                "text": "„Anita schriebt bei 5.: Frank ist ein Arschloch, ein Gefühlslegastheniker, ein Eisblock, autistisch, völlig verlangsamt, ignorant, phlegmatisch, bequem, unfähig mir etwas entgegenzusetzen.“"
                            },
                            {
                                "example_id": "4cee56e4-4e34-4e04-bc81-bfd9e5f2c60b",
                                "sense_id": "302046b3-acd9-3b98-ada0-933bd22c8fb8",
                                "text": "„Gefühlslegastheniker: Betitelung für Menschen mit fehlender Empathie (sprich: Einfühlungsvermögen); wird häufig Männern unterstellt.“"
                            },
                            {
                                "example_id": "de49edce-6e92-4a54-9fed-65f4a6136b5d",
                                "sense_id": "302046b3-acd9-3b98-ada0-933bd22c8fb8",
                                "text": "Darin fand der Gefühlslegastheniker nur mühsam Worte, die seinen zerstörten Ziehsohn wieder auf Kurs bringen sollten."
                            },
                            {
                                "example_id": "4fee19f0-c471-4380-b862-effc84569401",
                                "sense_id": "302046b3-acd9-3b98-ada0-933bd22c8fb8",
                                "text": "Wenn Sie diesem Bild folgen, können Sie in etwa verstehen, wie ein Gefühlslegastheniker empfindet."
                            },
                            {
                                "example_id": "3a0199b4-16ed-4b6f-90f4-84d7b87d76bf",
                                "sense_id": "302046b3-acd9-3b98-ada0-933bd22c8fb8",
                                "text": "Auch wenn er sich noch nicht richtig darauf einlassen kann, aber so sind diese Gefühlslegastheniker eben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
