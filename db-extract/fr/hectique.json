                                "target_senses": [
                                    {
                                        "sense_id": "8f678968-5ac9-39da-b977-02d123b37ebf",
                                        "entry_id": "e2b84ce4-8981-34ea-88f0-3eb5870bfa49",
                                        "glosses": [
                                            "von nervöser Unruhe, nervöser Betriebsamkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d15c56d-2885-4b54-8b4f-8d75585f415b",
                                                "sense_id": "8f678968-5ac9-39da-b977-02d123b37ebf",
                                                "text": "Die Menschen im Marktgewusel stromerten hektisch von Stand zu Stand."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1a52b87a-984b-365c-8235-3b21e53f7a4a",
                                        "entry_id": "e2b84ce4-8981-34ea-88f0-3eb5870bfa49",
                                        "glosses": [
                                            "die Lungentuberkulose begleitend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25f14ba7-d997-4d33-9bb1-390f518cec5f",
                                                "sense_id": "1a52b87a-984b-365c-8235-3b21e53f7a4a",
                                                "text": "Er litt noch viele Tage vor seinem Tode am hektischen Husten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce474fa9-9bc9-4149-8e3b-4745c2513f16",
                        "source_entry_id": "34e53a53-40e5-3088-841f-0a4c5bb04862",
                        "target_lang_word": "hectic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hectic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "819ab937-ab9c-38ab-9c7d-9029af544ce4",
                                        "entry_id": "d7c4fb62-422a-3dc1-a432-ac700029f3c7",
                                        "glosses": [
                                            "Very busy with activity and confusion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "223fa43f-d607-402c-a4a1-c0a053524288",
                                                "sense_id": "819ab937-ab9c-38ab-9c7d-9029af544ce4",
                                                "text": "The city center is so hectic at 8 in the morning that I go to work an hour beforehand to avoid the crowds"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a05d6698-e3b2-3e42-adad-40bb8448125b",
                                        "entry_id": "d7c4fb62-422a-3dc1-a432-ac700029f3c7",
                                        "glosses": [
                                            "Denoting a type of fever accompanying consumption and similar wasting diseases, characterised by flushed cheeks and dry skin."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f92f8346-a561-4717-87e4-4554982bc1c4",
                                                "sense_id": "a05d6698-e3b2-3e42-adad-40bb8448125b",
                                                "text": "hectic fever"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8ba56df-d20b-32dc-9d5c-9f4e9ef621f5",
                                        "entry_id": "d7c4fb62-422a-3dc1-a432-ac700029f3c7",
                                        "glosses": [
                                            "Pertaining to or symptomatic of such a fever."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7f2d556-a8c1-40cb-b356-236290c124c9",
                                                "sense_id": "d8ba56df-d20b-32dc-9d5c-9f4e9ef621f5",
                                                "text": "Ann had a hectic cough, and many unfavourable prognostics […]."
                                            },
                                            {
                                                "example_id": "5152e1b2-ef3e-4352-b79e-2bfabd7c24f0",
                                                "sense_id": "d8ba56df-d20b-32dc-9d5c-9f4e9ef621f5",
                                                "text": "She never complained, but sleep and appetite fled from her, a slow fever preyed on her veins, her colour was hectic, and she often wept in secret […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hectic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a0b8243-b795-3dcb-8f1a-97067a2f0ea6",
                                        "entry_id": "f88b8480-296d-39c4-8e71-7714a8b2d864",
                                        "glosses": [
                                            "A hectic fever."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67aa29c0-24e5-460d-b1b9-d543e6f4303c",
                                                "sense_id": "7a0b8243-b795-3dcb-8f1a-97067a2f0ea6",
                                                "text": "[…] Do it England, / For like the Hecticke in my blood he rages, / And thou muſt cure me: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a46e9c12-a299-3608-9f11-0ffb92827cd7",
                                        "entry_id": "f88b8480-296d-39c4-8e71-7714a8b2d864",
                                        "glosses": [
                                            "A flush like one produced by such a fever."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "568232f5-5cca-4904-b89d-45ae91bd5304",
                                                "sense_id": "a46e9c12-a299-3608-9f11-0ffb92827cd7",
                                                "text": "The poor Franciscan made no reply: a hectic of a moment pass’d across his cheek, but could not tarry […]"
                                            },
                                            {
                                                "example_id": "97c9a619-3d53-4a99-8e70-961ae423c493",
                                                "sense_id": "a46e9c12-a299-3608-9f11-0ffb92827cd7",
                                                "text": "For still he lay, and on his thin worn cheek / A purple hectic played like dying day / On the snow-tops of distant hills […]"
                                            },
                                            {
                                                "example_id": "df481ee4-9df1-4b29-8136-b5158d4e67a7",
                                                "sense_id": "a46e9c12-a299-3608-9f11-0ffb92827cd7",
                                                "text": "an angry hectic in each cheek, a fierce flirt of her fan, and two or three short sniffs that betokened mischief"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
