                "senses": [
                    {
                        "sense_id": "86dfbc17-4236-3b84-bcab-8013a533893b",
                        "entry_id": "3c6cd2a9-8c45-3e02-a74a-8fcbad335b5b",
                        "glosses": [
                            "König des orientalischen Volkes der Perser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ea72ef8-7ae8-4ac9-b979-5933db9b405b",
                                "sense_id": "86dfbc17-4236-3b84-bcab-8013a533893b",
                                "text": "„Nach dem Feldzug des Perserkönigs Dareios I. gegen die Skythen in den Jahren 513 und 512 v. Chr. […] pflegten die Fürsten – wohl vorsorglich – gute Kontakte zu dem Großreich im Osten.“"
                            },
                            {
                                "example_id": "4d3bceb2-c375-4c0a-a86e-470311616281",
                                "sense_id": "86dfbc17-4236-3b84-bcab-8013a533893b",
                                "text": "„1739 fiel der turkstämmige Perserkönig Nadir Schah mit einem großen Heer in den Punjab ein und plünderte Delhi.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
