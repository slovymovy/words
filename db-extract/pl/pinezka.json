                    {
                        "sense_id": "cedad8db-5b6f-37b1-a3c2-89863dc1f07d",
                        "entry_id": "80de5e2d-d152-363e-891f-5b6986dd755d",
                        "glosses": [
                            "krótka szpilka z płaską lub kulistą główką"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e504bc4b-b201-4bfd-9c46-145b94a8520c",
                                "sense_id": "cedad8db-5b6f-37b1-a3c2-89863dc1f07d",
                                "text": "Nauczycielka pinezkami przypięła do tablicy ogłoszeń informację o sprawdzianach na koniec semestru."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
