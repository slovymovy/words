                    "sense_id": "483818a6-446f-3d09-8ed8-d49e57994b9e",
                    "sense_definition": "Een gebouw waar op grote schaal producten worden gemaakt met machines.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De arbeiders gingen iedere ochtend naar de <w>fabriek</w> om daar te werken.",
                            "target_lang_translations": {
                                "en": "The workers went to the <w>factory</w> every morning to work there.",
                                "ru": "Рабочие каждое утро ходили на <w>фабрику</w>, чтобы там работать.",
                                "de": "Die Arbeiter gingen jeden Morgen in die <w>Fabrik</w>, um dort zu arbeiten.",
                                "pl": "Robotnicy każdego ranka szli do <w>fabryki</w>, żeby tam pracować.",
                                "fr": "Les ouvriers se rendaient chaque matin à l'<w>usine</w> pour y travailler.",
                                "it": "Gli operai andavano ogni mattina in <w>fabbrica</w> per lavorare.",
                                "cs": "Dělníci chodili každé ráno do <w>továrny</w>, aby tam pracovali.",
                                "tr": "İşçiler her sabah çalışmak için <w>fabrikaya</w> gidiyorlardı.",
                                "es": "Los trabajadores iban cada mañana a la <w>fábrica</w> para trabajar allí.",
                                "zh": "工人们每天早上都去<w>工厂</w>工作。"
                            }
                        },
                        {
                            "text": "In de oude <w>fabriek</w> worden nu moderne appartementen gebouwd.",
                            "target_lang_translations": {
                                "en": "Modern apartments are now being built in the old <w>factory</w>.",
                                "ru": "В здании старого <w>завода</w> сейчас строят современные апартаменты.",
                                "de": "In der alten <w>Fabrik</w> werden jetzt moderne Wohnungen gebaut.",
                                "pl": "W starej <w>fabryce</w> budowane są teraz nowoczesne apartamenty.",
                                "fr": "Des appartements modernes sont maintenant construits dans l'ancienne <w>usine</w>.",
                                "it": "Nella vecchia <w>fabbrica</w> vengono ora costruiti appartamenti moderni.",
                                "cs": "Ve staré <w>továrně</w> se nyní staví moderní byty.",
                                "tr": "Eski <w>fabrikada</w> şimdi modern daireler inşa ediliyor.",
                                "es": "En la antigua <w>fábrica</w> se están construyendo ahora apartamentos modernos.",
                                "zh": "在那座旧<w>工厂</w>里，现在正在建造现代化的公寓。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in de fabriek",
                        "grote fabriek",
                        "oude fabriek"
                    ],
                    "target_lang_definitions": {
                        "en": "A building where products are made on a large scale with machines.",
                        "ru": "Здание, где в больших масштабах производятся товары с помощью машин.",
                        "de": "Ein Gebäude oder eine Anlage, in der Produkte in großem Maßstab mit Maschinen hergestellt werden.",
                        "pl": "Budynek, w którym produkty są wytwarzane na dużą skalę przy użyciu maszyn.",
                        "fr": "Un bâtiment où des produits sont fabriqués à grande échelle à l'aide de machines.",
                        "it": "Un edificio o impianto dove i prodotti vengono realizzati su larga scala utilizzando macchinari.",
                        "cs": "Budova, kde se ve velkém vyrábějí produkty pomocí strojů.",
                        "tr": "Ürünlerin makinelerle büyük ölçekte üretildiği bina veya tesis.",
                        "es": "Un edificio o instalación donde se producen bienes a gran escala mediante maquinaria.",
                        "zh": "一种利用机器大规模生产产品的建筑物。"
