                "translations": [
                    {
                        "translation_id": "c8143f06-fb35-48d7-aedb-22511eeb8bed",
                        "source_entry_id": "21048bd9-b4dc-3a39-b2aa-dc5d9aee7900",
                        "target_lang_word": "epiblast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epiblast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7589d8f-80d4-3f51-8d73-a76fc656ab2f",
                                        "entry_id": "91fb847e-613e-3067-a946-5959b263e3f1",
                                        "glosses": [
                                            "The outer layer of a blastula that, after gastrulation, becomes the ectoderm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2c59911-0733-4f50-a18d-03cb4e611682",
                                                "sense_id": "f7589d8f-80d4-3f51-8d73-a76fc656ab2f",
                                                "text": "1993, Oded Khaner, 5: Axis Determination in the Avian Embryo, Roger A. Pederson, Current Topics in Developmental Biology, Volume 28, Academic Press, page 171,\nHypoblasts from these stages were separated from the epiblasts and rotated 90 and 180°, relative to their posterior regions."
                                            },
                                            {
                                                "example_id": "52cac066-2c4c-4f22-8e4b-30d7e789f1d1",
                                                "sense_id": "f7589d8f-80d4-3f51-8d73-a76fc656ab2f",
                                                "text": "It has been demonstrated that the clonal descendants of individual epiblast cells could contribute to a variety of embryonic and extraembryonic tissues that are derived from all three germ layers (Lawson et al., 1991; Lawson and Pedersen, 1992)."
                                            },
                                            {
                                                "example_id": "5c4bdddc-715f-4bb3-b264-e71500a932ad",
                                                "sense_id": "f7589d8f-80d4-3f51-8d73-a76fc656ab2f",
                                                "text": "The cells of the primitive embryoblast differentiate into two layers, the epiblast and the hypoblast."
                                            },
                                            {
                                                "example_id": "248ab345-891a-4039-b85a-6bda38ec09e6",
                                                "sense_id": "f7589d8f-80d4-3f51-8d73-a76fc656ab2f",
                                                "text": "Shortly after the blastocyst implants, the epiblast elongates and begins receiving regionalized patterning signals that direct different compartments of it to differentiate into the definitive endoderm, the mesoderm, or the definitive ectoderm."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
