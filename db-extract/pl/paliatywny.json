                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fde37f8b-2700-43db-a057-baf3fef6e54f",
                                                "sense_id": "bd826d4c-0b80-31ba-a566-e089fc0ede98",
                                                "text": "The radiation and chemotherapy were only palliatives."
                                            },
                                            {
                                                "example_id": "e9a6337b-f22f-4572-94c8-89d68ae4b997",
                                                "sense_id": "bd826d4c-0b80-31ba-a566-e089fc0ede98",
                                                "text": "Mary heard with sorrow, and fear also, of the projected journey; but the altered expression of Isabella's countenance was a great palliative—dreadful as it was that her husband should love another..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
