                "senses": [
                    {
                        "sense_id": "e1722c7c-ded1-314a-bbbc-9ee4ec9c296d",
                        "entry_id": "cb3f79b3-9ad4-3ddd-8893-34936fa6c0de",
                        "glosses": [
                            "Tuch, das dazu dient, Schmutz zu entfernen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ce4b726-3bd9-4491-b30d-b0c5ffa6e64a",
                                "sense_id": "e1722c7c-ded1-314a-bbbc-9ee4ec9c296d",
                                "text": "„Sie hielt ihm einen Wischlappen vors Gesicht.“"
                            },
                            {
                                "example_id": "80704468-90f1-4e9a-824b-23e82fcbc192",
                                "sense_id": "e1722c7c-ded1-314a-bbbc-9ee4ec9c296d",
                                "text": "„Der Geruch hing in jedem Grashalm, und wenn jemand einen Wischlappen oder einen Pullover an der Wäscheleine vergessen hatte, dann nahmen auch der Lappen oder der Pullover diesen nebligen Petroleumgeruch an.“"
                            },
                            {
                                "example_id": "fbe3ce79-4e2e-4505-9117-8a57cf4753d6",
                                "sense_id": "e1722c7c-ded1-314a-bbbc-9ee4ec9c296d",
                                "text": "„Über den am wenigsten schmutzigen wurde ein Wischlappen gebreitet, damit Madame Bordin Platz nehmen konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
