                        ]
                    },
                    {
                        "translation_id": "0a7a46d5-9c25-4451-ab5e-f51717302a7c",
                        "source_entry_id": "41c99d6e-be97-38c2-841b-359aa6844243",
                        "source_sense_id": "e9767165-2377-3d6a-980b-16cee751a104",
                        "source_sense_description": "iemand die gloeiend metaal bewerkt met een hamer op een aambeeld",
                        "target_lang_word": "forgeron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "forgeron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f065f5d-33b5-3f0b-9416-af7cc4cbda06",
                                        "entry_id": "810d1129-0cc7-35aa-9113-74db234b902c",
                                        "glosses": [
                                            "Artisan qui travaille le fer au marteau, après l’avoir fait chauffer à la forge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce2381b9-0fa0-4a72-85f9-b37e613714af",
                                                "sense_id": "5f065f5d-33b5-3f0b-9416-af7cc4cbda06",
                                                "text": "Le forgeron qui doit battre le fer a la partie supérieure de son corps et les muscles des bras très-développés."
                                            },
                                            {
                                                "example_id": "4b2570ee-2424-42f6-999d-039b5f5adb69",
                                                "sense_id": "5f065f5d-33b5-3f0b-9416-af7cc4cbda06",
                                                "text": "À 10 heures j’avais trouvé un calfat, un charpentier et un forgeron, et les réparations commençaient."
                                            },
                                            {
                                                "example_id": "b1246776-0372-43f6-8d89-d0cf39e414b2",
                                                "sense_id": "5f065f5d-33b5-3f0b-9416-af7cc4cbda06",
                                                "text": "Les docteurs du Talmud ne donnaient-ils pas eux-mêmes l’exemple en exerçant, pour assurer leur gagne-pain, les métiers les plus humbles, tels que forgeron, ou savetier, ou fabricant d’épingles, etc. ?"
                                            },
                                            {
                                                "example_id": "51ab1f81-f843-4ae8-945e-eb7c6e64c7b9",
                                                "sense_id": "5f065f5d-33b5-3f0b-9416-af7cc4cbda06",
                                                "text": "Le forgeron, qui est aussi maréchal-ferrant, est un homme respecté du village. Il ferre les chevaux, répare les armures du seigneur. Il sait aussi redresser une faux ou fabriquer un soc de charrue, ces outils de fer si précieux."
                                            },
                                            {
                                                "example_id": "d6390ae0-bf87-48f3-8c32-176f551266c0",
                                                "sense_id": "5f065f5d-33b5-3f0b-9416-af7cc4cbda06",
                                                "text": "Jean Robin (Ad. Sénégal) fut ainsi dépanné un jour par un forgeron maure (un mallem) « qui, alors que je me trouvais en panne dans un village de brousse, parce que la camionnette à gazogène (c'était pendant la guerre) avait un cylindre fendu, le répara à l’aide d’un morceau de théière en étain. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45b38774-f4bd-3cc6-8787-04ecc481093e",
                                        "entry_id": "810d1129-0cc7-35aa-9113-74db234b902c",
                                        "glosses": [
                                            "Ouvrier travaillant à la fabrication des métaux dans une forge industrielle."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce19d7be-e664-35ad-963d-ffa90c66073a",
                                        "entry_id": "810d1129-0cc7-35aa-9113-74db234b902c",
                                        "glosses": [
                                            "Dans certaines cultures d’Afrique subsaharienne, membre d’un groupe dont l’activité traditionnelle est l’artisanat des métaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "725be348-454e-4784-996d-a5776c9be8e8",
                                                "sense_id": "ce19d7be-e664-35ad-963d-ffa90c66073a",
                                                "text": "En fin de parcours, un forgeron spécialisé procède aux circoncisions."
                                            },
                                            {
                                                "example_id": "c8496025-0c2f-43fd-9b81-469c38967d7c",
                                                "sense_id": "ce19d7be-e664-35ad-963d-ffa90c66073a",
                                                "text": "Dans cette société, le forgeron occupait une place importante dans la vie politique et socio-économique des populations. Il était l’artisan qui contribuait à la vie de toute la société par son savoir-faire et le pouvoir qu’il détenait grâce au travail du fer. Il était sur le plan social un homme de paix, un intercesseur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6462ab04-7bd3-34e9-8dd3-62e5f5002020",
                                        "entry_id": "810d1129-0cc7-35aa-9113-74db234b902c",
                                        "glosses": [
                                            "Meuble représentant un personnage exerçant le métier du même nom dans les armoiries."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed73cd98-7879-38df-9a3f-8ba355243da7",
                                        "entry_id": "810d1129-0cc7-35aa-9113-74db234b902c",
                                        "glosses": [
                                            "Poisson de mer de la famille des zéidés (Zeus faber)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "334892cd-8e18-4b0e-8bbc-290afc6c0cb8",
                                                "sense_id": "ed73cd98-7879-38df-9a3f-8ba355243da7",
                                                "text": "Il entendit le bruit nocturne du forgeron marin, et il mangea des cent cinquante-trois sortes de poissons qu’il y a dans la mer, et qui se trouvèrent tous dans le filet des apôtres quand ils pêchèrent par ordre du Seigneur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "forgeron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9707e64-c58f-3d32-b45b-ecf2bd4cffc9",
                                        "entry_id": "9175c1d3-871c-3888-956d-64e5904b458d",
                                        "glosses": [
                                            "Relatif à Forges-sur-Meuse, commune située dans le département de la Meuse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26471ef4-6f5f-31d6-b202-df5b79896773",
                                        "entry_id": "9175c1d3-871c-3888-956d-64e5904b458d",
                                        "glosses": [
                                            "Relatif à La Forge, commune située dans le département des Vosges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a96d848-6629-4fcd-b404-d33ab2283c24",
                                                "sense_id": "26471ef4-6f5f-31d6-b202-df5b79896773",
                                                "text": "Juste avant de partir pour les vacances d’hiver, les petits écoliers forgerons, au nombre de 28, ont fêté carnaval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c28f140b-78d6-317c-b527-d901bf7e874b",
                                        "entry_id": "9175c1d3-871c-3888-956d-64e5904b458d",
                                        "glosses": [
                                            "Relatif aux Forges, commune située dans le département des Vosges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f8c6d39-1e34-416d-96fb-6d7e6de2f015",
                                                "sense_id": "c28f140b-78d6-317c-b527-d901bf7e874b",
                                                "text": "Parallèlement, les agents communaux expérimentés que vous connaissez ainsi que les associations forgeronnes permettent le maintien des liens sociaux dans la commune et la poursuite d’un travail de qualité initié par mon prédécesseur, Yvon EUGE."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ba9e414-1e0f-397d-8f87-23ad3b5311be",
                                        "entry_id": "9175c1d3-871c-3888-956d-64e5904b458d",
                                        "glosses": [
                                            "Relatif aux Forges, commune située dans le département du Morbihan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb852cce-b3c3-4543-b1ba-c5211cebf67a",
                                                "sense_id": "7ba9e414-1e0f-397d-8f87-23ad3b5311be",
                                                "text": "La population forgeronne est venue nombreuse pour assister à cette cérémonie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
