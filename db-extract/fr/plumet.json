            {
                "entry_id": "14d0ba88-02a1-37f5-98a7-401280d2e6e1",
                "word": "plumet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7b3ced5f-61af-46cc-9ea1-c1023dba4f95",
                        "entry_id": "14d0ba88-02a1-37f5-98a7-401280d2e6e1",
                        "tags": [
                            "plural"
                        ],
                        "form": "plumets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d318b5be-359b-3e3c-8b3d-1b2860f11ca1",
                        "entry_id": "14d0ba88-02a1-37f5-98a7-401280d2e6e1",
                        "glosses": [
                            "Plume d’autruche, préparée et mise à un chapeau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11d34bd5-1762-46cc-9e9e-10e6d0681dc4",
                                "sense_id": "d318b5be-359b-3e3c-8b3d-1b2860f11ca1",
                                "text": "Beau Geste se leva et, beau comme un dieu avec sa pelisse écarlate à tresses jaunes, son shako noir à plumet, sa sabretache de cuir verni et sa ceinture cramoisie à olives jaunes, se mit à tonner :\n \"Aubergiste, à boire ou je tue le chien ! Donne à mes hussards ton meilleur vin de Moselle et descends pour nous dans la cave.\""
                            },
                            {
                                "example_id": "d3478647-d4d5-45be-9762-5d39d0243404",
                                "sense_id": "d318b5be-359b-3e3c-8b3d-1b2860f11ca1",
                                "text": "Porter un plumet."
                            },
                            {
                                "example_id": "c5a42d59-1971-4a6b-a97c-7f0f28664635",
                                "sense_id": "d318b5be-359b-3e3c-8b3d-1b2860f11ca1",
                                "text": "Il avait le plumet sur l’oreille."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9e1feb1-110a-33cd-987e-a6aae40f4e2e",
                        "entry_id": "14d0ba88-02a1-37f5-98a7-401280d2e6e1",
                        "glosses": [
                            "Bouquet de plumes qui sert d’ornement à certaines coiffures militaires."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0cd9d341-109e-36d2-8389-90ce04a2bb75",
                        "entry_id": "14d0ba88-02a1-37f5-98a7-401280d2e6e1",
                        "glosses": [
                            "Quelqu'un qui porte un plumet, un militaire."
                        ],
                        "tags": [
                            "metonymically",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "675ed0a5-f8b8-4393-8ee1-48d76212c9ad",
                                "sense_id": "0cd9d341-109e-36d2-8389-90ce04a2bb75",
                                "text": "L’assistance était composée de plumets, de spadassins, de filous, de laquais, de clercs, de quelques bourgeois naïfs conduits là par des filles, pauvres pigeons destinés à être plumés vifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "18966fbc-a255-34a5-b5a0-6a1831f3d9e0",
                        "entry_id": "14d0ba88-02a1-37f5-98a7-401280d2e6e1",
                        "glosses": [
                            "Bouquet de plumes qui orne les dais, les lits en dais, les corbillards."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "447078ff-dba5-3482-a2d9-8e8d97689b2a",
                        "entry_id": "14d0ba88-02a1-37f5-98a7-401280d2e6e1",
                        "glosses": [
                            "Synonyme de stipe pennée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "036e8bd9-61b5-3bad-82a5-8570cffa897f",
                        "entry_id": "14d0ba88-02a1-37f5-98a7-401280d2e6e1",
                        "glosses": [
                            "Inflorescence de certaines plantes."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "7d7bd65b-ef8b-41f8-9a44-28a0344bef9f",
                                "sense_id": "036e8bd9-61b5-3bad-82a5-8570cffa897f",
                                "text": "Des lavandes faisaient bordure devant une touffe de sauge, deux ou trois rosiers pomponnants et un épais buisson d'herbe de la pampa arborant ses plumets vaniteusement décoratifs."
                            }
                        ]
                    },
                    {
                        "sense_id": "169efaef-153c-37ab-92b1-d39cae4656fd",
                        "entry_id": "14d0ba88-02a1-37f5-98a7-401280d2e6e1",
                        "glosses": [
                            "Faisceau de plumes monté sur un petit morceau de liège qu’on laisse flotter pour voir d’où vient le vent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d689c622-2417-4f80-b87d-d9473a328a51",
                                "sense_id": "169efaef-153c-37ab-92b1-d39cae4656fd",
                                "text": "Plumets de pilote."
                            }
                        ]
                    },
                    {
                        "sense_id": "f52705ca-6e31-343c-9bc3-f34face56685",
                        "entry_id": "14d0ba88-02a1-37f5-98a7-401280d2e6e1",
                        "glosses": [
                            "Celui qui portait le charbon, aide charbonnier, souvent un jeune commis ou apprenti."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b77b879f-b46a-4858-b3cf-262f8e1c7048",
                                "sense_id": "f52705ca-6e31-343c-9bc3-f34face56685",
                                "text": "PLUMET ; nom donné au charbonnier porteur de charbon."
                            }
                        ]
                    }
