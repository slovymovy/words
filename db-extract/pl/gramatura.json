                                            "Papeterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e44f51c0-dd92-47c5-8407-c74e4a2ffd9e",
                                                "sense_id": "feafbc68-9d8d-3e58-9a75-1f121a7f7fd3",
                                                "text": "Vous n'auriez pas le même coloris mais dans un grammage un peu plus épais ?"
                                            },
                                            {
                                                "example_id": "92f3eec0-9a17-459c-8005-beaf9ffbcfbd",
                                                "sense_id": "feafbc68-9d8d-3e58-9a75-1f121a7f7fd3",
                                                "text": "J'aime sentir la qualité des livres, le grammage du papier s’il est agréable..."
                                            }
                                        ]
