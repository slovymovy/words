{
    "word_family": [
        "case"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1aa554f-b4d6-36b8-a93b-481ef36a2777",
                    "sense_definition": "A protective covering or outer shell that encloses something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Some people like to split the <w>casing</w> of a sausage before cooking so it does not burst.",
                            "target_lang_translations": {
                                "zh": "有些人喜欢在烹饪前把香肠的<w>肠衣</w>划开，以免它爆裂。"
                            }
                        },
                        {
                            "text": "The <w>casing</w> of the watch was made of solid gold to protect the delicate internal parts.",
                            "target_lang_translations": {
                                "zh": "这块手表的<w>外壳</w>由纯金打造，以保护其精密的内部零件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "covering",
                        "shell",
                        "enclosure"
                    ],
                    "common_phrases": [
                        "sausage casing",
                        "protective casing"
                    ],
                    "target_lang_definitions": {
                        "zh": "包裹或保护某物的外部壳体或覆盖物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "外壳",
                                "target_lang_sense_clarification": "指保护内部零件或结构的坚硬外层。"
                            },
                            {
                                "target_lang_word": "肠衣",
                                "target_lang_sense_clarification": "特指用于制作香肠的包裹层。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02314699-be86-3501-b588-41d1e3b3c956",
                    "sense_definition": "The decorative trim or frame installed around a door or window.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter carefully installed the wooden <w>casing</w> around the new bedroom door.",
                            "target_lang_translations": {
                                "zh": "木匠小心翼翼地在新卧室门周围安装了木质<w>门窗套</w>。"
                            }
                        },
                        {
                            "text": "We painted the window <w>casing</w> white to match the rest of the room trim.",
                            "target_lang_translations": {
                                "zh": "我们将窗户的<w>门窗套</w>漆成白色，以与房间的其他装饰相协调。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trim",
                        "frame"
                    ],
                    "common_phrases": [
                        "door casing",
                        "window casing"
                    ],
                    "target_lang_definitions": {
                        "zh": "安装在门窗周围的装饰性边框或饰条。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "门窗套",
                                "target_lang_sense_clarification": "建筑装修中指门窗周边的装饰性框架。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cb67065-529c-3a99-b391-4510fdc6e534",
                    "sense_definition": "The arrangement of uppercase and lowercase letters in a text.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software automatically corrected the <w>casing</w> of the file names to ensure consistency.",
                            "target_lang_translations": {
                                "zh": "该软件自动修正了文件名的<w>大小写</w>，以确保格式统一。"
                            }
                        },
                        {
                            "text": "Check the <w>casing</w> of your password because it is sensitive to capital letters.",
                            "target_lang_translations": {
                                "zh": "检查一下你密码的<w>大小写</w>，因为密码对字母大小写很敏感。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "correct casing",
                        "mixed casing"
                    ],
                    "target_lang_definitions": {
                        "zh": "文本中字母大小写的排版方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "大小写",
                                "target_lang_sense_clarification": "指字母书写格式的区分。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "edda0019-084e-3705-a1dd-1f5dbc9c4731",
                    "sense_definition": "A metal pipe used to line the borehole of a well.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers lowered the steel <w>casing</w> into the well to prevent the walls from collapsing.",
                            "target_lang_translations": {
                                "zh": "工人们将钢制<w>套管</w>放入井中，以防止井壁坍塌。"
                            }
                        },
                        {
                            "text": "A damaged <w>casing</w> can lead to groundwater contamination in deep wells.",
                            "target_lang_translations": {
                                "zh": "受损的<w>套管</w>可能会导致深井中的地下水受到污染。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "well casing"
                    ],
                    "target_lang_definitions": {
                        "zh": "用于加固井壁的金属管。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "套管",
                                "target_lang_sense_clarification": "工业或钻井中用于保护井壁的管状结构。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ede7bcf-05b0-3970-b542-cf480d1f5ff1",
                    "sense_definition": "A tire.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy-duty <w>casing</w> of the truck tire is designed to withstand extreme pressure.",
                            "target_lang_translations": {
                                "zh": "卡车<w>轮胎</w>的重型结构旨在承受极大的压力。"
                            }
                        },
                        {
                            "text": "Inspect the <w>casing</w> for any signs of wear or structural damage before a long trip.",
                            "target_lang_translations": {
                                "zh": "长途旅行前，请检查<w>轮胎</w>是否有磨损或结构损坏的迹象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tire"
                    ],
                    "target_lang_definitions": {
                        "zh": "轮胎的结构主体。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "轮胎",
                                "target_lang_sense_clarification": "指车辆的橡胶轮圈。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "92388883-4539-3000-9966-bd4e4a8bee66",
                    "sense_definition": "The present participle and gerund of <w>case</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thieves were <w>casing</w> the bank for several days before attempting the robbery.",
                            "target_lang_translations": {
                                "zh": "窃贼在试图抢劫前，已经对银行进行了好几天的<w>踩点</w>。"
                            }
                        },
                        {
                            "text": "He spent the afternoon <w>casing</w> the building to find the best entry point.",
                            "target_lang_translations": {
                                "zh": "他花了一下午时间在建筑物周围<w>踩点</w>，以寻找最佳的进入点。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "casing a joint"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the context of criminal activity."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "暗中观察或踩点（通常指犯罪前的准备活动）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "踩点",
                                "target_lang_sense_clarification": "口语，指为了实施犯罪而预先侦察目标地点。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}