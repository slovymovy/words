                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9f4508e-26f8-4895-bd1d-9bf9ee22c527",
                                                "sense_id": "530dafbf-b5aa-32bd-abd4-eb5328f5d27b",
                                                "text": "Hij doet beroep op de beeldspraak van de dodelijke vechtkunsten van de Assassins als een dans tussen de jageres en haar prooi."
                                            },
                                            {
                                                "example_id": "16fad77d-c0af-454e-adbc-7f369bf6e5e3",
                                                "sense_id": "530dafbf-b5aa-32bd-abd4-eb5328f5d27b",
                                                "text": "Rebecca Francis kwam deze week in het oog van de storm terecht toen komiek Ricky Gervais een oude foto op Twitter zette waarop ze poseert naast een giraf die ze doodschoot. De bekende jageres heeft echter geen spijt van haar daad. ‘Het beest ging toch sterven, en ik hielp de plaatselijke bevolking zo te overleven.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43c5c3e2-fde6-478b-9f78-c48f7346d0ff",
                        "source_entry_id": "519c58d4-ada3-3ddf-9884-20b93e6e626a",
                        "source_sense_id": "a950913b-e90b-3497-9f25-9c354b2049e3",
                        "source_sense_description": "female who hunts",
                        "target_lang_word": "chasseresse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chasseresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f602b3dd-5bba-390d-956e-e1adacd08006",
                                        "entry_id": "d444b266-72a7-37ec-8888-ecb2be8d2f5e",
                                        "glosses": [
                                            "Variante de chasseuse."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc780164-c678-4b8f-9692-47c58a30d3fc",
                                                "sense_id": "f602b3dd-5bba-390d-956e-e1adacd08006",
                                                "text": "Il est vrai que sa toilette de chasseresse lui allait à merveille ; elle avait un chapeau de feutre avec des plumes bleues, un surtout de velours gris perle et une jupe de satin bleu toute brodée d’argent. À ce surtout étincelaient les ferrets de diamants."
                                            },
                                            {
                                                "example_id": "29ed36da-08f9-475f-8365-c8baab8414f9",
                                                "sense_id": "f602b3dd-5bba-390d-956e-e1adacd08006",
                                                "text": "Elles en font des chasseresses audacieuses comme elles-mêmes, des guerrières qui se mesurent sans crainte avec les grands fauves, […]."
                                            },
                                            {
                                                "example_id": "1175d521-ff3e-4cad-a125-cced967ddaeb",
                                                "sense_id": "f602b3dd-5bba-390d-956e-e1adacd08006",
                                                "text": "Un cri ivre s’interrompait dans le bleu, et la chasseresse ramassait l’oiseau blessé, le serrait d’une main précautionneuse et, tout en caressant de ses lèvres les plumes chaudes, l’étouffait."
                                            },
                                            {
                                                "example_id": "60114968-053b-425e-bae2-7a9d385bcc24",
                                                "sense_id": "f602b3dd-5bba-390d-956e-e1adacd08006",
                                                "text": "Chasseresse de lions, elle n’admettait pas qu’un homme de génie, ou même de talent, traversât Philadelphie sans qu’elle le patronnât."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed4420a8-fb3f-3f17-85c8-14cf690c3f28",
                                        "entry_id": "d444b266-72a7-37ec-8888-ecb2be8d2f5e",
                                        "glosses": [
                                            "Variante de chasseuse."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e5a639a-1a69-4d2e-9321-e8ba9c0613a0",
                                                "sense_id": "ed4420a8-fb3f-3f17-85c8-14cf690c3f28",
                                                "text": "lorsque l’objet de la chasse est indiqué, nous utilisons « chasseuse ». Lorsqu’il n’y a pas de référence à l’objet, nous utilisons « chasseresse ».\nExemple : la chasseresse Yaeliura / une chasseuse de trolls"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chasseresse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b79877ef-ab29-3581-ad5d-2c0a4f48a7a9",
                                        "entry_id": "d908ef61-1a45-3c42-92f9-a628c5ed1a38",
                                        "glosses": [
                                            "Variante de chasseuse, féminin singulier de chasseur."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "form-of",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb013ca-5cb6-4282-9c6e-cedf44b7643f",
                                                "sense_id": "b79877ef-ab29-3581-ad5d-2c0a4f48a7a9",
                                                "text": "La ministre, ex-DRH de Danone puis patronne de l’agence Business France, est aussi, à ses heures, une photographe chasseresse d’oiseaux rares, qu’elle shoote en noir et blanc à travers le monde, de l’Afrique du Sud au Mexique, et de l’Indonésie au Japon…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a15fa03-2111-43fc-87f5-b519d6a21089",
                        "source_entry_id": "519c58d4-ada3-3ddf-9884-20b93e6e626a",
