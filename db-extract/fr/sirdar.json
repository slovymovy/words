                                "target_senses": [
                                    {
                                        "sense_id": "f91faf03-0474-3bf7-bd01-c52047808ea7",
                                        "entry_id": "d724c825-8d92-355d-8901-44eafb8a46d7",
                                        "glosses": [
                                            "A high-ranking person in India and other areas of west-central Asia; a chief, a headman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87a17567-f387-4205-a45d-42d9d1e66d12",
                                                "sense_id": "f91faf03-0474-3bf7-bd01-c52047808ea7",
                                                "text": "Only last week a paper on the question of early marriage in India was read by a young Sikh Sirdar of Kapurthala, in which this supremely important and delicate subject was treated with a tact and frankness which did him the utmost credit. […¶…¶…¶] During the discussion on Sirdar Arjun Sing’s paper, occasion was taken to protest against the erroneous view, too often taken in Europe, as to the abased position of Mahomedan women generally."
                                            },
                                            {
                                                "example_id": "65eec138-82f8-42b1-b5f6-05717c5a4e02",
                                                "sense_id": "f91faf03-0474-3bf7-bd01-c52047808ea7",
                                                "text": "Pottinger’s guide, who turned out to be married to the daughter of the Sirdar, or headman, insisted on entering the village first, explaining that it was customary with strangers in this dangerous region."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05aba96e-51af-322a-8514-427e3b3cfeef",
                                        "entry_id": "d724c825-8d92-355d-8901-44eafb8a46d7",
                                        "glosses": [
                                            "A rank assigned to the commander-in-chief of the Egyptian Army during the British occupation of Egypt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f211049c-acc0-4f94-b2ae-22bfe4878391",
                                                "sense_id": "05aba96e-51af-322a-8514-427e3b3cfeef",
                                                "text": "Sir Reginald, as Sirdar of the Egyptian Army, had been put in command of the British military side of the Arab adventure in place of Sir Henry McMahon"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "795de135-c615-304d-81a8-5839c3dd9efb",
                                        "entry_id": "d724c825-8d92-355d-8901-44eafb8a46d7",
                                        "glosses": [
                                            "The leader of a group of Sherpa mountain guides."
                                        ],
