                        "glosses": [
                            "Katakomben ähnelnd, wie Katakomben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3e2c346-3aca-4575-b78d-ec507627cbe8",
                                "sense_id": "038ef41c-5d2d-3234-b474-da49ddbd799e",
                                "text": "„Drinnen gab es eine echte Bar, angeblich aus Mahagoni, die 1919 aus einem Saloon in Knoxville geborgen worden war und dann in einer Wäscherei, einer Eisdiele und für kurze Zeit in einem katakombenhaften Etablissement Dienst getan hatte, das mehrere Kilometer von Red Branch entfernt an der Straße nach Knoxville lag und aufgrund eines versuchten Kompromisses zwischen Bestechung und Gerissenheit frühzeitig scheiterte.“"
                            }
                        ],
