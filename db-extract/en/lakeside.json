                        "source_sense_description": "the shore of a lake",
                        "target_lang_word": "Seeufer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seeufer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ec21df2-e109-3032-a50e-05f6930bcd77",
                                        "entry_id": "622332aa-f67d-3467-bc3e-803ae442fd9e",
                                        "glosses": [
                                            "das Ufer eines Sees"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5c76e18-6f73-45ba-817f-0b6258e03e2a",
                                                "sense_id": "9ec21df2-e109-3032-a50e-05f6930bcd77",
                                                "text": "„Gäste und Einwohner dürfen sich bald auf lange Spaziergänge am Seeufer und neue Erholungsbereiche am See freuen.“"
                                            },
                                            {
                                                "example_id": "6567ae68-442c-4d6b-9dbc-ea229aba0d63",
                                                "sense_id": "9ec21df2-e109-3032-a50e-05f6930bcd77",
                                                "text": "„Sie waren mit den Kindern am Seeufer unterwegs.“"
                                            },
                                            {
                                                "example_id": "b2458e39-cfd4-4317-910f-b85e9c3ae7d9",
                                                "sense_id": "9ec21df2-e109-3032-a50e-05f6930bcd77",
                                                "text": "„In einem Dorf am Seeufer waren uns die Leute feindlich gesinnt, und wir hatten einige Schwierigkeiten.“"
                                            },
                                            {
                                                "example_id": "207e0c48-3b7e-4448-b633-60a564043bd5",
                                                "sense_id": "9ec21df2-e109-3032-a50e-05f6930bcd77",
                                                "text": "„Ich nützte diese allgemeine Bereitschaft und bat die beiden betagten Verliebten um die Erlaubnis, mit den Mädchen einen Spaziergang im Garten am Seeufer zu machen; sie wurde mir aus übervollem Herzen gewährt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f0134cb-9d6e-4fad-9cdc-b725d3976080",
                        "source_entry_id": "36e3ede6-c5c5-3c92-8010-75da0b444f2f",
                        "source_sense_id": "7ab3c066-ed28-37a0-a532-8cc0ea2436ff",
