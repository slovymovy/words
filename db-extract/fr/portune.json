                ],
                "senses": [
                    {
                        "sense_id": "b1542f93-205b-378e-a119-680fd061879c",
                        "entry_id": "4d6abd7b-71f5-3b7c-87f5-3a668424253b",
                        "glosses": [
                            "Nom vernaculaire de crabes du genre Portunus ou de genres voisins, comme l’étrille, aux pattes postérieures aplaties en palettes natatoires."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3632c8b3-a66b-45e1-8d27-6579e44a1615",
                                "sense_id": "b1542f93-205b-378e-a119-680fd061879c",
                                "text": "Ceux de ces animaux qui nagent le mieux, ou qui ne vont point à terre, ont leurs tarses postérieurs, ou même un plus grand nombre, très-comprimés, ovales, en forme de feuillets natatoires : portune, matute, etc."
                            },
                            {
                                "example_id": "3c72ad3e-2b26-483e-bc3f-5c417d74612b",
                                "sense_id": "b1542f93-205b-378e-a119-680fd061879c",
                                "text": "Les portunes, que M. Cuvier désigne aussi sous le nom d’étrilles, ne diffèrent bien rigoureusement de certains crabes, et particulièrement des carcins de M. Léach, que par la manière dont se terminent leurs deux pattes postérieures."
                            },
                            {
                                "example_id": "829225f1-fcdd-46d7-9f45-30d6a3e9e98a",
                                "sense_id": "b1542f93-205b-378e-a119-680fd061879c",
                                "text": "Plusieurs portunes sont recherchés comme alimens^([sic]), notamment l’espèce qui est connue en France sous le nom d’Étrille."
                            }
                        ]
                    }
                ],
