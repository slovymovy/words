                    {
                        "translation_id": "f98df1e1-293a-4c1c-8f64-0f6d0569231d",
                        "source_entry_id": "b81f7585-2b99-3d5c-94bf-c65395bc4514",
                        "source_sense_description": "кривляться",
                        "target_lang_word": "grimace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grimace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22ecd450-2989-3549-8479-69840c25eae7",
                                        "entry_id": "2b3d89a2-2c52-3461-a765-9cda840fd618",
                                        "glosses": [
                                            "A contorted facial expression, often expressing contempt or pain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3d6d649-8eb9-47d6-a56f-8e9050375d12",
                                                "sense_id": "22ecd450-2989-3549-8479-69840c25eae7",
                                                "text": "Her face was twisted in a grimace of disgust."
                                            },
                                            {
                                                "example_id": "847ecff8-e47b-4fe6-bb70-8d177c6ed17d",
                                                "sense_id": "22ecd450-2989-3549-8479-69840c25eae7",
                                                "text": "I trundle off to bed, eyes brimming, face twisted into a grateful glistening grimace, and awaken the next day wondering what all the fuss was about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6939571-dd29-30f6-aafe-52cca89d5161",
                                        "entry_id": "2b3d89a2-2c52-3461-a765-9cda840fd618",
                                        "glosses": [
                                            "Affectation, pretence."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d1d314c-955c-4e30-b190-e94254654635",
                                                "sense_id": "c6939571-dd29-30f6-aafe-52cca89d5161",
                                                "text": "Zeluco considered all this as mere affectation and grimace, and was convinced that she would, in due time, unfold the particular mode in which she wished to be indemnified […]."
                                            },
                                            {
                                                "example_id": "c7552799-58f2-469f-bba3-d95173dce1b0",
                                                "sense_id": "c6939571-dd29-30f6-aafe-52cca89d5161",
                                                "text": "Charlotte was equally insensible to all his fashionable grimace, and indifferent to his conversation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grimace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c91c4ea-8242-3763-a63e-b8c0de8891b1",
                                        "entry_id": "5f34082c-5c0c-379e-8c6a-fa287c964516",
                                        "glosses": [
                                            "To make grimaces; to distort one's face; to make faces."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
