{
    "word_family": [
        "possession",
        "possesseur",
        "possessif",
        "déposséder",
        "dépossession"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df391019-afed-3a8f-981b-6dcaeafb70c7",
                    "sense_definition": "Avoir en sa possession un bien matériel, en être le propriétaire légitime.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "propriété",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette famille <w>possède</w> une grande maison au bord de la mer."
                        },
                        {
                            "text": "Il ne <w>possède</w> presque rien en dehors de ses livres."
                        }
                    ],
                    "synonyms": [
                        "détenir"
                    ],
                    "common_phrases": [
                        "posséder une maison",
                        "posséder des terres"
                    ]
                },
                {
                    "sense_id": "6b6b172c-febc-3ec8-8f5b-c76144595469",
                    "sense_definition": "Être pourvu ou doté d'une particularité, d'une qualité ou d'un attribut.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "caractéristique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet athlète <w>possède</w> une endurance physique tout à fait remarquable."
                        },
                        {
                            "text": "Le bâtiment <w>possède</w> une architecture typique du dix-neuvième siècle."
                        }
                    ],
                    "synonyms": [
                        "avoir",
                        "présenter"
                    ],
                    "common_phrases": [
                        "posséder un talent",
                        "posséder des qualités"
                    ]
                },
                {
                    "sense_id": "2bf29f42-e189-32d8-8a7d-d78c54f69896",
                    "sense_definition": "Maîtriser parfaitement un domaine, une discipline intellectuelle ou une langue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "connaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle <w>possède</w> plusieurs langues étrangères avec une grande aisance."
                        },
                        {
                            "text": "Le chercheur <w>possède</w> son sujet dans les moindres détails."
                        }
                    ],
                    "synonyms": [
                        "maîtriser",
                        "dominer"
                    ],
                    "antonyms": [
                        "ignorer"
                    ],
                    "common_phrases": [
                        "posséder une langue",
                        "posséder son sujet"
                    ]
                },
                {
                    "sense_id": "bba321b9-0311-3c6c-be8f-f4213c741d14",
                    "sense_definition": "Garder son calme, rester maître de ses réactions et de ses émotions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "maîtrise_de_soi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Même sous une vive pression, cet orateur se <w>possède</w> parfaitement."
                        },
                        {
                            "text": "Furieux de cette injustice, il ne se <w>possédait</w> plus de colère."
                        }
                    ],
                    "synonyms": [
                        "se contrôler",
                        "se dominer"
                    ],
                    "common_phrases": [
                        "ne plus se posséder"
                    ]
                },
                {
                    "sense_id": "90935a62-8680-3b01-bd01-57e9a7c915c6",
                    "sense_definition": "En parlant d'un esprit ou d'un démon, s'emparer du corps et de l'esprit d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette légende ancienne, un mauvais esprit <w>possède</w> le voyageur imprudent."
                        },
                        {
                            "text": "Les villageois croyaient fermement qu'un démon <w>possédait</w> la fille du meunier."
                        }
                    ],
                    "synonyms": [
                        "habiter",
                        "investir"
                    ],
                    "common_phrases": [
                        "être possédé par le démon"
                    ]
                },
                {
                    "sense_id": "f6a4eb49-9671-3da7-9fd1-5b184c8ec888",
                    "sense_definition": "En parlant d'un sentiment violent ou d'une passion, dominer entièrement l'esprit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une ambition dévorante le <w>possède</w> au point d'oublier ses proches."
                        },
                        {
                            "text": "Quelle folie te <w>possède</w> pour agir de manière si irréfléchie ?"
                        }
                    ],
                    "synonyms": [
                        "dévorer",
                        "animer"
                    ],
                    "common_phrases": [
                        "être possédé par une passion"
                    ]
                }
            ]
        }
    ]
}