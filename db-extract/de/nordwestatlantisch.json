                ],
                "senses": [
                    {
                        "sense_id": "79f0bc28-89ec-3388-a03f-2e2f0f6b71aa",
                        "entry_id": "3307499e-bb6d-352e-adb3-a9ad4837a0f7",
                        "glosses": [
                            "den nordwestlichen Teil des Atlantischen Ozeans betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87640faa-880f-4b98-8684-897f48b0401c",
                                "sense_id": "79f0bc28-89ec-3388-a03f-2e2f0f6b71aa",
                                "text": "„Von den Ländern, die demokratisch blieben, gehörten bis auf zwei, die Tschechoslowakei und die Schweiz, alle zum vergleichsweise reichen nordwestatlantischen Rand Europas.“"
                            },
                            {
                                "example_id": "50e6e6ad-12b6-4ee3-b867-bf8fd768ef9b",
                                "sense_id": "79f0bc28-89ec-3388-a03f-2e2f0f6b71aa",
                                "text": "„In den Sechzigern wurden jährlich über eine Million Tonnen nordwestatlantischer Kabeljau gefangen.“"
                            },
                            {
                                "example_id": "474ab790-50cb-4c69-860c-f21e1fad8bfa",
                                "sense_id": "79f0bc28-89ec-3388-a03f-2e2f0f6b71aa",
                                "text": "„Schätzen Sie die Wärmemenge ab, die der Golfstrom der nordwestatlantischen Region zuführt (besonders im Winter), und Vergleichen Sie mit der Gesamtsonneneinstrahlung auf dieses 10–20 Mill.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
