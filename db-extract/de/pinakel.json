                ],
                "senses": [
                    {
                        "sense_id": "09e614bc-79b1-3d09-8b91-db3f6de53c76",
                        "entry_id": "75fb02a1-a866-349d-b51b-455cea288a7a",
                        "glosses": [
                            "ein spitzes, gotisches Zierglied in der Form eines Türmchens, das oft als Bekrönung von Strebepfeilern verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6e40410-e0e3-45fd-8be1-b2b0a6326236",
                                "sense_id": "09e614bc-79b1-3d09-8b91-db3f6de53c76",
                                "text": "\"… Pinakel sind aus Stein gemeißelte, schlanke, spitz auslaufende Türmchen, die in der gotischen Architektur der Überhöhung von Wimpergen und Strebepfeilern dienten.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fbad8cc-027b-4f76-aaf8-d8447abba0cd",
                        "source_entry_id": "75fb02a1-a866-349d-b51b-455cea288a7a",
                        "source_sense_id": "09e614bc-79b1-3d09-8b91-db3f6de53c76",
                        "target_lang_word": "pinnacle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinnacle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50fdb9e3-18b6-326d-bd72-891cbddfb9a6",
                                        "entry_id": "c3360717-430a-39cf-82ed-2b2e29d9fd74",
                                        "glosses": [
                                            "The highest point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4dd6237-ca19-3ebc-b3a3-da97e5b32058",
                                        "entry_id": "c3360717-430a-39cf-82ed-2b2e29d9fd74",
                                        "glosses": [
                                            "A tall, sharp and craggy rock or mountain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4502b5cf-18bb-4756-942e-9784bb93024c",
                                                "sense_id": "c4dd6237-ca19-3ebc-b3a3-da97e5b32058",
                                                "text": "Kings, who remain in many respects the representatives of a vanished world, solitary pinnacles that topple over the rising waste of waters under which the past lies buried."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "787a0503-cdc3-30d5-b09f-7b508fc3189d",
                                        "entry_id": "c3360717-430a-39cf-82ed-2b2e29d9fd74",
                                        "glosses": [
                                            "An all-time high; a point of greatest achievement or success."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e27d7607-e4b2-4818-b5d8-417e674837d2",
                                                "sense_id": "787a0503-cdc3-30d5-b09f-7b508fc3189d",
                                                "text": "The pinnacle of the effort to fix restrictive meanings to a set of terminology can be found in two papers in American Speech by Feinsilver (1979, 1980)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb9b11b7-8d64-3c92-9a52-6934753f1015",
                                        "entry_id": "c3360717-430a-39cf-82ed-2b2e29d9fd74",
                                        "glosses": [
                                            "An upright member, generally ending in a small spire, used to finish a buttress, to constitute a part in a proportion, as where pinnacles flank a gable or spire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "800b8ba9-a390-4ecb-bb6f-3c5072b5b0c5",
                                                "sense_id": "bb9b11b7-8d64-3c92-9a52-6934753f1015",
                                                "text": "Some renowned metropolis / With glistering spires and pinnacles around."
                                            },
                                            {
                                                "example_id": "f2483ff8-99ef-4686-b98e-8218deb35cbb",
                                                "sense_id": "bb9b11b7-8d64-3c92-9a52-6934753f1015",
                                                "text": "In the city’s midst the gleaming marble of a thousand steps climbed to the citadel where arose four pinnacles beckoning to heaven, and midmost between the pinnacles there stood the dome, vast, as the gods had dreamed it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pinnacle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38600548-0440-36f8-816a-fe583cdcbca5",
                                        "entry_id": "ba88c2c4-682b-35c8-b24d-cf64ac44098d",
                                        "glosses": [
                                            "To place on a pinnacle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80a5cacb-1a41-43b6-8a20-1a1a32e12767",
                                                "sense_id": "38600548-0440-36f8-816a-fe583cdcbca5",
                                                "text": "And down this vast gulf upon which we were pinnacled the great draught dashed and roared, driving clouds and misty wreaths of vapour before it, till we were nearly blinded, and utterly confused."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5cb91ad-f65e-3c46-9f1c-012a90ee36c0",
                                        "entry_id": "ba88c2c4-682b-35c8-b24d-cf64ac44098d",
                                        "glosses": [
                                            "To build or furnish with a pinnacle or pinnacles."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ee3d67c-e613-4343-951b-53eddada68ca",
                                                "sense_id": "d5cb91ad-f65e-3c46-9f1c-012a90ee36c0",
                                                "text": "The pediment of the Southern Transept is pinnacled, not inelegantly, with a flourished cross"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0518e025-190b-4e48-a1c0-3d5109e0219c",
                        "source_entry_id": "75fb02a1-a866-349d-b51b-455cea288a7a",
                        "source_sense_id": "09e614bc-79b1-3d09-8b91-db3f6de53c76",
                        "target_lang_word": "pinacle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinacle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a62ac158-a956-3751-9881-ec3a15a8183f",
                                        "entry_id": "7c95f4d7-5a29-3e7e-af8c-019f586372fc",
                                        "glosses": [
                                            "Partie la plus élevée d’un édifice."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1a7815f-69bb-33f9-82d8-9aeae6127b0e",
                                        "entry_id": "7c95f4d7-5a29-3e7e-af8c-019f586372fc",
                                        "glosses": [
                                            "Clocheton élancé de forme conique ou pyramidale qui sert de couronnement à un contrefort, ou qui est érigé aux extrémités d'un fronton ou d'un gâble, dans les édifices gothiques ou de style gothique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c81e95ed-19ad-4d4a-86a7-85a14b8d1176",
                                                "sense_id": "e1a7815f-69bb-33f9-82d8-9aeae6127b0e",
                                                "text": "Le pinacle d'un arc-boutant."
                                            },
                                            {
                                                "example_id": "87e08459-473a-44dc-b677-6879edf368dd",
                                                "sense_id": "e1a7815f-69bb-33f9-82d8-9aeae6127b0e",
                                                "text": "De style ogival flamboyant, à ornementation très fouillée, surtout dans la façade et les tours, ses arcs-boutants, ses clochetons, ses pinacles gothiques sont remarquables."
                                            },
                                            {
                                                "example_id": "ff8d3289-cd2f-432c-9d06-2813e601b6d3",
                                                "sense_id": "e1a7815f-69bb-33f9-82d8-9aeae6127b0e",
                                                "text": "C’était toujours à lui [le clocher] qu’il fallait revenir, toujours lui qui dominait tout, sommant les maisons d’un pinacle inattendu, levé devant moi comme le doigt de Dieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebdd812f-efe0-39b0-aae1-581e41651acb",
                                        "entry_id": "7c95f4d7-5a29-3e7e-af8c-019f586372fc",
                                        "glosses": [
                                            "Position la plus élevée, la plus enviable ou la plus estimée, s’opposant au pilori."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e679b915-aea5-43ea-b09d-de4a5432c9e0",
                                                "sense_id": "ebdd812f-efe0-39b0-aae1-581e41651acb",
                                                "text": "Tu es jeune et jolie, je me charge de ta fortune à Bruxelles si tu veux ; j’y vais, c’est ma patrie ; en deux ans je te mets au pinacle, mais je t’avertis que ce ne sera point par les étroits sentiers de la vertu que je te conduirai à la fortune ; il faut à ton âge entreprendre plus d’un métier, et servir à plus d’une intrigue quand on veut faire promptement son chemin…"
                                            },
                                            {
                                                "example_id": "c93588fb-f9c9-45f1-9b30-b1c2b7f8cd3d",
                                                "sense_id": "ebdd812f-efe0-39b0-aae1-581e41651acb",
