                    }
                ],
                "senses": [
                    {
                        "sense_id": "a38a8648-41a7-3a24-8c05-2e83a7c7927e",
                        "entry_id": "70ed7574-c813-3c7b-a2a9-61d5d642e777",
                        "glosses": [
                            "Diminution de la sécrétion d'une ou de plusieurs des huit hormones normalement produites par l'hypophyse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3694ec0-2ab5-4d30-a36d-83de3dac5a1d",
                                "sense_id": "a38a8648-41a7-3a24-8c05-2e83a7c7927e",
                                "text": "L’hypopituitarisme est un trouble peu fréquent. Il peut être provoqué par plusieurs facteurs, tels que certains troubles inflammatoires, une tumeur hypophysaire ou encore un apport sanguin insuffisant au niveau de l’hypophyse."
                            },
                            {
                                "example_id": "b578189d-58fc-4972-b1c6-45891fd1595c",
                                "sense_id": "a38a8648-41a7-3a24-8c05-2e83a7c7927e",
                                "text": "Le déficit hypophysaire, ou hypopituitarisme, est défini par une insuffisance de synthèse d’une ou de plusieurs hormones antéhypophysaires (hormone de croissance, TSH, ACTH, LH-FSH, prolactine) associé ou non à un diabète insipide (déficit en ADH)."
                            },
                            {
                                "example_id": "d0546c55-987c-4658-b744-515d6ea1bdf9",
                                "sense_id": "a38a8648-41a7-3a24-8c05-2e83a7c7927e",
                                "text": "Il faut dire que la future star du ballon rond souffre d’hypopituitarisme qui provoque un déficit en hormone de croissance entraînant un retard global de croissance et une petite taille"
                            }
                        ]
                    }
                ],
