        "fr-extract.jsonl": [
            {
                "entry_id": "3d1a7e9e-7551-3403-887f-fa59575f9bea",
                "word": "fromagerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "134fd033-a7c5-4427-87a7-b1396951e215",
                        "entry_id": "3d1a7e9e-7551-3403-887f-fa59575f9bea",
                        "tags": [
                            "plural"
                        ],
                        "form": "fromageries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66ec42c6-7725-3924-a241-a2a2ad06a99f",
                        "entry_id": "3d1a7e9e-7551-3403-887f-fa59575f9bea",
                        "glosses": [
                            "Laiterie spécialisée dans la fabrication des fromages."
                        ],
                        "tags": [
                            "Caséologie"
                        ],
                        "examples": [
                            {
                                "example_id": "824ffee0-2a76-4fc4-98be-3a8e49f27912",
                                "sense_id": "66ec42c6-7725-3924-a241-a2a2ad06a99f",
                                "text": "La fromagerie YZ vous fait découvrir ses fromages AOC et terroir."
                            },
                            {
                                "example_id": "b5a9a2d1-3597-426a-a6aa-6a2f9240cf85",
                                "sense_id": "66ec42c6-7725-3924-a241-a2a2ad06a99f",
                                "text": "C’est vers la fin d’avril que le travail des fromageries commence ; c’est vers la mi-juin que les fromagers conduisent leurs vaches dans la montagne."
                            }
                        ]
                    },
                    {
                        "sense_id": "14cb274a-9030-33b1-a70c-0ea770ff2c8a",
                        "entry_id": "3d1a7e9e-7551-3403-887f-fa59575f9bea",
                        "glosses": [
                            "Magasin de fromages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b56da74-78e7-4b1f-8402-8e2b65e36b9a",
                                "sense_id": "14cb274a-9030-33b1-a70c-0ea770ff2c8a",
                                "text": "Après avoir œuvré chez Cellerier, la fameuse maison lyonnaise, cette Bourguignonne a ouvert sa fromagerie en 2011 à Bordeaux. Sa sélection fait bien entendu la part belle aux fromages bourguignons et rhônalpins : ici, chèvres (paillasse beaujolaise, crottin de la ferme de la Cruzille, etc.), saint-félicien et saint-marcellin sont rois !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a99091a8-a380-4c2d-a263-4a8f77e6ea7a",
                        "source_entry_id": "3d1a7e9e-7551-3403-887f-fa59575f9bea",
                        "target_lang_word": "Käseladen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Käseladen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "76e09f6f-42bf-394d-9df9-4886462d4823",
                                        "entry_id": "df19afa5-a8f5-3767-998d-c220ea3e2216",
                                        "glosses": [
                                            "Laden, in dem Käse verkauft wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f455856-c7b5-41e2-908b-d81fd14f8157",
                                                "sense_id": "76e09f6f-42bf-394d-9df9-4886462d4823",
                                                "text": "„›Du würdest die Gegend nicht mehr wiedererkennen. Teure kleine Boutiquen, Bistros mit Delikatessen und Tischen auf dem Bürgersteig, Wein- und Käseläden.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc9ef9d3-cf7f-4adc-964e-c285c6cdb4fe",
                        "source_entry_id": "3d1a7e9e-7551-3403-887f-fa59575f9bea",
                        "target_lang_word": "Käselager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Käselager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "070f151c-73c0-3ab1-a88d-9450578366c5",
                                        "entry_id": "c16c18c9-8c20-3c23-88c3-39ba150c7c19",
                                        "glosses": [
                                            "Gebäude oder Ort, wo Käse aufbewahrt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6e76f74-30c8-44e4-a794-1faadc81209c",
                                                "sense_id": "070f151c-73c0-3ab1-a88d-9450578366c5",
                                                "text": "„Zwischenzeitlich wurde die Mine als Käselager genutzt, heute vergnügen sich Touristen in der Tiefe: Im Boot können sie in einem unterirdischen See herumrudern, der bis zu acht Meter tief ist.“"
                                            },
                                            {
                                                "example_id": "d31a3c0a-0ef6-4607-bb74-d1190dfcd2fa",
                                                "sense_id": "070f151c-73c0-3ab1-a88d-9450578366c5",
                                                "text": "„Im gut gekühlten Käselager auf dem Hof von Michael und Claudia Storch in Dietershausen reifen Spezialitäten, die als duftende Visitenkarte Werbung für die Region machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
