                    {
                        "translation_id": "1d195cd3-1967-47f5-81de-5bfd78b89202",
                        "source_entry_id": "3bff08ad-4a47-3442-ab03-26a569271eb0",
                        "source_sense_id": "b2ff76ac-e62a-341a-b381-00c8165dc029",
                        "target_lang_word": "Handschuhfach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Handschuhfach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0cfc992-1b76-36bc-bc18-92aef86cef41",
                                        "entry_id": "7466cb02-0d42-3a1b-97dd-20d2d81a6c3a",
                                        "glosses": [
                                            "Ablage in dem Armaturenbrett der Beifahrerseite in Personen- oder Lastkraftwagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dccb3865-5b5a-47d6-ade2-793a3dd4f918",
                                                "sense_id": "b0cfc992-1b76-36bc-bc18-92aef86cef41",
                                                "text": "\"Handtaschen, Geldbörsen und andere Wertsachen haben im Urlaub nichts im Auto verloren. Zusätzlich abschrecken lassen sich Langfinger mit einem Schild «Keine Wertsachen im Auto». Ähnliche Funktion hat auch ein demonstrativ geöffnetes Handschuhfach.\""
                                            },
                                            {
                                                "example_id": "d384fd94-c8b0-4098-b347-5312fc779c3f",
                                                "sense_id": "b0cfc992-1b76-36bc-bc18-92aef86cef41",
                                                "text": "„Im Handschuhfach entdeckte er eine Taschenlampe, ein Fernglas, einen Schraubenzieher und eine alte Zeitung.“"
                                            },
                                            {
                                                "example_id": "43ed68ce-9d90-4517-b7a2-bf579e588b85",
                                                "sense_id": "b0cfc992-1b76-36bc-bc18-92aef86cef41",
                                                "text": "„Die dritte ging durch die Rückenlehne des Beifahrersitzes und machte ein Loch in die Klappe des Handschuhfachs.“"
                                            },
                                            {
                                                "example_id": "0c1ecf0c-54e6-4a09-bf24-9f7e02cca4ee",
                                                "sense_id": "b0cfc992-1b76-36bc-bc18-92aef86cef41",
                                                "text": "„Seltsamerweise hatte er vorher im Handschuhfach seinen Revolver gefunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb8459b8-3aa1-4e69-b9fc-29bf6c82e686",
                        "source_entry_id": "3bff08ad-4a47-3442-ab03-26a569271eb0",
                        "source_sense_id": "b2ff76ac-e62a-341a-b381-00c8165dc029",
                        "target_lang_word": "boîte à gants",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boîte à gants",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "593bd603-377c-39cd-bf2a-a2dc56b30fbc",
                                        "entry_id": "760794ba-28a5-3e4e-97eb-d230bf43e0c9",
                                        "glosses": [
                                            "Volume aménagé dans la console avant d’un véhicule, muni d’une porte et destiné au rangement de menus objets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a954bb4b-398a-4958-b624-7eaa445dc18e",
                                                "sense_id": "593bd603-377c-39cd-bf2a-a2dc56b30fbc",
                                                "text": "Puis, devant l’impassibilité de grand-père, elle entreprenait de colmater les brèches à l’aide de vieux chiffons qui traînaient dans la « boîte à gants » (une tablette sous le tableau de bord)."
                                            },
                                            {
                                                "example_id": "68433a02-fca5-4981-bb68-b5ac88029a5c",
                                                "sense_id": "593bd603-377c-39cd-bf2a-a2dc56b30fbc",
                                                "text": "Cette boîte à gants était pleine de clefs de rechange. Donc, je savais bien que ça allait finir par arriver. J’ai passé un marché avec moi-même. Qu’il serait temps d’arrêter les conneries quand il n’y aurait plus de clefs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "559f6f9e-6b56-3b70-8bfd-3913bd33ec23",
                                        "entry_id": "760794ba-28a5-3e4e-97eb-d230bf43e0c9",
                                        "glosses": [
                                            "Enceinte étanche et transparente qui est équipée de gants intégrés permettant la manipulation, sous atmosphère contrôlée, de substances nécessitant un confinement."
                                        ],
                                        "tags": [
                                            "Cycle du combustible nucléaire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
