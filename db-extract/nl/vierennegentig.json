                            {
                                "example_id": "622b8588-197a-44c0-96b6-942dde82d23d",
                                "sense_id": "969be11e-1ecd-3e5c-8894-e340a2a7ad30",
                                "text": "Het is weer de vierennegentig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "99cc9629-9e5a-4932-912f-13fb017afede",
                                "sense_id": "969be11e-1ecd-3e5c-8894-e340a2a7ad30",
                                "text": "Haar vijfennegentigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de vierennegentig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f0e04b2-f4e4-31b9-beec-2246f8bd0a3c",
                        "entry_id": "d73ad013-8d39-3061-a812-e884d90d5cc9",
