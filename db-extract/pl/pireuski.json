                "senses": [
                    {
                        "sense_id": "49112ea1-03da-38f3-8c61-8ad7ee997a60",
                        "entry_id": "8454ed53-ef9d-3e11-908e-00e8a5d1692d",
                        "glosses": [
                            "związany z Pireusem, dotyczący Pireusu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "464243a4-8b4c-4699-99c8-511a40286a00",
                                "sense_id": "49112ea1-03da-38f3-8c61-8ad7ee997a60",
                                "text": "Rozgłośnia Wolnej Grecji donosi że dnia 7 bm. rozpoczął się w Grecji 24-godzinny strajk robotników i urzędników ateńskich i pireuskich tramwajów oraz pracowników kolei elektrycznej, łączącej Ateny z Pireusem"
                            },
                            {
                                "example_id": "d19d72f5-29b3-4f04-b425-d6fa2f353dd4",
                                "sense_id": "49112ea1-03da-38f3-8c61-8ad7ee997a60",
                                "text": "Prokurator sądu apelacyjnego w Atenach poinformował, że proces byłego dyktatora Grecji, Jeorjosa Papadopulosa i jego najbliższych współpracowników, oskarżonych o zdradę stanu i dokonanie przewrotu wojskowego w 1967 roku, rozpocznie się 28 lipca w pireuskim więzieniu Koridalos"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
