                        "sense_id": "54394d44-2bdf-3d6f-9deb-a2930f209952",
                        "entry_id": "cd80b89d-36d4-3362-9f9a-bb7332e8c799",
                        "glosses": [
                            "entropy (quantity indicating the number of possible microstates)"
                        ],
                        "tags": [
                            "feminine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "005241d7-ea26-4a59-8695-cb4c4ac34afc",
                                "sense_id": "54394d44-2bdf-3d6f-9deb-a2930f209952",
                                "text": "In de thermodynamica wordt entropie vaak geassocieerd met de mate van wanorde.",
                                "translation": "In thermodynamics, entropy is often associated with the degree of disorder.",
                                "english": "In thermodynamics, entropy is often associated with the degree of disorder."
                            },
                            {
                                "example_id": "8d0963c5-f43f-4a1c-a370-36b491a907d5",
                                "sense_id": "54394d44-2bdf-3d6f-9deb-a2930f209952",
                                "text": "De entropie van een geïsoleerd systeem neemt altijd toe.",
                                "translation": "The entropy of an isolated system always increases.",
                                "english": "The entropy of an isolated system always increases."
                            },
                            {
                                "example_id": "e50631e8-9a64-4dab-99f1-167876e78a5f",
                                "sense_id": "54394d44-2bdf-3d6f-9deb-a2930f209952",
                                "text": "Om de totale entropie te berekenen, moeten we rekening houden met alle microtoestanden.",
                                "translation": "To calculate the total entropy, we must take into account all the microstates.",
                                "english": "To calculate the total entropy, we must take into account all the microstates."
                            }
                        ]
                    }
                ],
