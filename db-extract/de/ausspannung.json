                "senses": [
                    {
                        "sense_id": "e97048b2-b892-3ea2-b050-4ea28b20ee85",
                        "entry_id": "7d70a18b-40d7-39c0-ab82-5c9059577905",
                        "glosses": [
                            "längere Erholungsphase von der Arbeit oder dem Alltag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c68dbb7-8360-43d8-b99d-723664324bdc",
                                "sense_id": "e97048b2-b892-3ea2-b050-4ea28b20ee85",
                                "text": "„Es erwies sich oft als notwendig, in den Tragödien und in den Komödien Pausen eintreten zu lassen, um dem Schauspieler einige Ausspannung zu verschaffen und die Vorbereitungen für den weiteren Gang des Stückes zu treffen; diese Pausen füllte manchmal der Dichter künstlerisch aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "553b55ec-6497-30fd-aece-6499c2bd60f4",
                        "entry_id": "7d70a18b-40d7-39c0-ab82-5c9059577905",
                        "glosses": [
                            "das Abwerben eines Kunden vom Mitbewerber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b10f660-2b63-4774-ab58-9a67f72bc13e",
                                "sense_id": "553b55ec-6497-30fd-aece-6499c2bd60f4",
                                "text": "„Da die Ausspannung in der Lebensversicherung für die versicherten Personen in der Regel mit Nachteilen verbunden ist, soll diese unterbleiben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1e67b4d2-a4ff-33f5-afc0-34eb882b4eed",
                        "entry_id": "7d70a18b-40d7-39c0-ab82-5c9059577905",
                        "glosses": [
                            "ein Ort zur Erholung"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "49418eaa-131c-4dfb-aede-c711b9376c7c",
                                "sense_id": "1e67b4d2-a4ff-33f5-afc0-34eb882b4eed",
                                "text": "„Ein Fleischer besaß eine Gast- und Schankwirtschaft, ein Hufschmied versorgte neben dem Gewerbe noch eine Ausspannung.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "52665cb1-4ba8-3246-afb3-0fb2e6f741e1",
                        "entry_id": "7d70a18b-40d7-39c0-ab82-5c9059577905",
                        "glosses": [
                            "die Ausdehnung oder Ausbreitung"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "49ee8562-524f-41af-a4fc-4f5b80c6d752",
                                "sense_id": "52665cb1-4ba8-3246-afb3-0fb2e6f741e1",
                                "text": "„Auf diese Weise bewirke ich eine weit stärkere Ausspannung und wenn auch etwas Wasser aus dem Erweiterungsinstrumente herausgeht, so dehnt sich die comprimirte Luft aus, und erhält den gleichen Grad der Ausspannung.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
