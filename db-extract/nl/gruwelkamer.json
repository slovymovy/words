                                "target_senses": [
                                    {
                                        "sense_id": "8a4e692d-0a1a-3685-8f32-9168385bcb22",
                                        "entry_id": "d27a70fd-32e3-387d-8327-19990ba41e05",
                                        "glosses": [
                                            "An exhibition which displays horrific items, such as instruments of torture, frightful crimes being committed, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbf2ceb-f65d-4c8d-af62-27ed2571eeb4",
                                                "sense_id": "8a4e692d-0a1a-3685-8f32-9168385bcb22",
                                                "text": "“Screaming headlines in every paper in the country—damn all journalists, I say! Do you know there was a whole crowd staring in at the lodge gates this morning. Sort of Madame Tussaud’s chamber of horrors business that can be seen for nothing.”"
                                            }
