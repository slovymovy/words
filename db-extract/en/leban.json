                                        "sense_id": "b3908b9e-99c8-3215-98e0-110a2eaf7f82",
                                        "entry_id": "bd3dce24-cddd-376b-910f-dfb5cadac8a6",
                                        "glosses": [
                                            "auffallend große, schlanke männliche Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3571244c-0393-4ea4-91eb-66314676ade9",
                                                "sense_id": "b3908b9e-99c8-3215-98e0-110a2eaf7f82",
                                                "text": "„Er scheute sich nicht vor einer Prügelei mit dem längsten Laban des Dorfes.“"
                                            },
                                            {
                                                "example_id": "6432f0e1-396d-4064-bbb1-e155f8675070",
                                                "sense_id": "b3908b9e-99c8-3215-98e0-110a2eaf7f82",
                                                "text": "„Sie stammt aus Groß Partwitz, die kleine Hummel, dürfen wir nicht vergessen, und der Großvater, der lange Laban, stammt aus Klein Partwitz.“"
                                            },
                                            {
                                                "example_id": "cc2a6bc8-0666-4c52-9982-a7b1cfd6d6c8",
                                                "sense_id": "b3908b9e-99c8-3215-98e0-110a2eaf7f82",
                                                "text": "„Wie ernsthaft und drollig zugleich klang im Munde der Kleinen die dem langen Laban zugeschriebene Einladung an Elieser vor dem Tore“"
                                            }
