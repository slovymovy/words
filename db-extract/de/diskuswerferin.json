                "senses": [
                    {
                        "sense_id": "710894b2-920e-32a4-89ac-a605599602e5",
                        "entry_id": "a4adfc11-b251-3b1f-8e34-40469be12594",
                        "glosses": [
                            "weibliche Person, die das Diskuswerfen ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fc07aa0-b2d8-48b8-a518-590585791970",
                                "sense_id": "710894b2-920e-32a4-89ac-a605599602e5",
                                "text": "Bei der Olympiade gelang den Diskuswerferinnen kein Sieg."
                            },
                            {
                                "example_id": "b12590f4-b846-4fd2-88f4-c26982816015",
                                "sense_id": "710894b2-920e-32a4-89ac-a605599602e5",
                                "text": "„Die 27 Jahre alte Perkovic, die 2011 eine sechsmonatige Dopingsperre abgesessen hatte, ist die erste Diskuswerferin bei Weltmeisterschaften seit 26 Jahren, die über die 70-m-Marke warf.“"
                            },
                            {
                                "example_id": "f6bc8ba7-71fc-4d9a-9d51-23d3910ee8ba",
                                "sense_id": "710894b2-920e-32a4-89ac-a605599602e5",
                                "text": "„Diskuswerferin Julia Harting hat in der Qualifikation bei der Leichtathletik-WM mächtig bangen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
