                ],
                "senses": [
                    {
                        "sense_id": "20d75048-1bdb-32e0-a994-315a14048fff",
                        "entry_id": "e38d8a8c-6e4f-325b-a32c-0c9a5aa657f4",
                        "glosses": [
                            "grammatisches Morphem, das als Flexionsaffix (oder auch durch lautliche Änderung des Wortes) in Deklination, Konjugation oder Komparation dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27dfe084-2b90-4b44-9716-140c10682d8b",
                                "sense_id": "20d75048-1bdb-32e0-a994-315a14048fff",
                                "text": "„-st“ ist ein häufig verwendetes Flexiv für die 2. Person Singular von Verben."
                            },
                            {
                                "example_id": "d488cef6-9ebd-41dc-8ef6-8520a567c04b",
                                "sense_id": "20d75048-1bdb-32e0-a994-315a14048fff",
                                "text": "„Als Flexionsmittel (Flexive) verwendet das Deutsche zum einen unselbstständige Bausteine, zum anderen Verfahren, mit denen der Stamm abgewandelt wird - wobei die beiden Vorgehensweisen oft kombiniert werden.“"
                            },
                            {
                                "example_id": "32556b14-d6cf-4ec8-b403-8322ac95a92f",
                                "sense_id": "20d75048-1bdb-32e0-a994-315a14048fff",
                                "text": "„Überraschenderweise wird beim suffigierten bestimmten Artikel der Synkretismus der Substantivflexion im Nominativ/Akkusativ Plural durch die beiden Flexive {-nir} beziehungsweise {-nar} aufgehoben.“"
                            },
                            {
                                "example_id": "d260ec54-3cf0-4a66-8d6f-715eef3103f1",
                                "sense_id": "20d75048-1bdb-32e0-a994-315a14048fff",
                                "text": "„Die vokalisch anlautenden Flexive sind das historische Ergebnis der Verschmelzung des ehemaligen Themavokals mit den Primärendungen.“"
                            },
                            {
                                "example_id": "c74c5cec-ba8a-4ca2-bf55-392231b75201",
                                "sense_id": "20d75048-1bdb-32e0-a994-315a14048fff",
                                "text": "„Zu diesen zählen weiterhin die zwar ebenfalls minimalsignifikativen, aber nicht selbständigen Flexive (Flexionssuffixe, Flexionsgrammeme, Flexionsmorpheme) sowie die Derivative (Derivationsgrammeme, Wortbildungsmorpheme).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
