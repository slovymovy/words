                "senses": [
                    {
                        "sense_id": "078c2b1a-b7ec-3cd9-b997-add18b2a0a0f",
                        "entry_id": "2b25c8d2-da3d-3d36-b9fa-8d67753ea886",
                        "glosses": [
                            "биохим. биогенное высокомолекулярное соединение, встречающееся в природе в естественном виде и определяющее важнейшие процессы жизнедеятельности организма"
                        ],
                        "tags": [
                            "обычно мн. ч."
                        ],
                        "examples": [
                            {
                                "example_id": "45b839fa-d277-495b-af68-fc5eda81367a",
                                "sense_id": "078c2b1a-b7ec-3cd9-b997-add18b2a0a0f",
                                "text": "Биополимеры ― высокомолекулярные природные соединения ― белки, нуклеиновые кислоты, полисахариды и их производные"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d10c1a5e-72a0-4d9b-b590-b2416ab6d7b2",
                        "source_entry_id": "2b25c8d2-da3d-3d36-b9fa-8d67753ea886",
                        "source_sense_id": "078c2b1a-b7ec-3cd9-b997-add18b2a0a0f",
                        "target_lang_word": "biopolymer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biopolymer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64e028b4-4a6a-3e9a-bd11-def94cebdcda",
                                        "entry_id": "5876bd7e-19a0-3419-b385-2b65b789722d",
                                        "glosses": [
                                            "Any macromolecule of a living organism that is formed from the polymerization of smaller entities; a polymer that occurs in a living organism or results from life."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b53f2c09-380f-43e3-ad23-196ccb089e67",
                                                "sense_id": "64e028b4-4a6a-3e9a-bd11-def94cebdcda",
                                                "text": "There are three main classes of biopolymers: polynucleotides (such as RNA and DNA), polypeptides (such as collagen and actin), and polysaccharides (such as cellulose and starch)."
                                            },
                                            {
                                                "example_id": "1b985905-42d1-4b1d-a9d9-5b3bec4b90e1",
                                                "sense_id": "64e028b4-4a6a-3e9a-bd11-def94cebdcda",
                                                "text": "Products based on durable biopolymers have begun appearing in the marketplace."
                                            },
                                            {
                                                "example_id": "d399ae48-7273-4db5-ae53-a7fef07fe287",
                                                "sense_id": "64e028b4-4a6a-3e9a-bd11-def94cebdcda",
                                                "text": "CJ Biomaterials was the first company in the world to produce amorphous PHA, it says, which is a softer, rubberier version of PHA that offers fundamentally different performance characteristics than crystalline or semi-crystalline forms of the biopolymer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
