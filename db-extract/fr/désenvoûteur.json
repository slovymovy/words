                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0309e172-54da-44f3-8123-4abf6c29c7fa",
                                "sense_id": "ceb9f238-0253-3911-bfc2-cfb3e181352b",
                                "text": "Il se croyait possédé, il est donc allé voir le désenvoûteur."
                            },
                            {
