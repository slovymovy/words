                            {
                                "example_id": "c2471df1-907a-4e82-a5ed-60ddd78dfc95",
                                "sense_id": "e5929308-f697-37d9-bf11-0be0e1e59634",
                                "text": "»Ohne Seelenkunde kann allerdings heutzutage kein Kriminalist auskommen, aber ich sage mit Absicht ‘Seelenkunde’, um auszudrücken, daß es sich nach meiner Meinung um keine eigentliche Wissenschaft handelt, sondern um ein angeborenes Gefühl, man könnte es Genialität nennen. […]«",
                                "translation": "The Deruga Case",
                                "english": "The Deruga Case"
                            }
                        ]
