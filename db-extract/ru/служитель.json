                        "form": "служи́теле"
                    },
                    {
                        "form_id": "41a434e3-12ff-454c-8042-df09ceda995d",
                        "entry_id": "ff23dcbd-2d37-3080-8c9e-ba1318eef21d",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "служи́телях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f9f8813-e429-3da6-b942-068b5b1a8083",
                        "entry_id": "ff23dcbd-2d37-3080-8c9e-ba1318eef21d",
                        "glosses": [
                            "устар. то же, что слуга"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1466884f-ac9c-48f6-a706-026720f416f7",
                                "sense_id": "4f9f8813-e429-3da6-b942-068b5b1a8083",
                                "text": "Отсюда во время совета чинно и величественно выходил личный служитель профессора с бакенбардами, а за ним его жена, спокойная тощая старушка, и они разносили чай."
                            }
                        ]
                    },
                    {
                        "sense_id": "79baf2ee-74a2-3840-aba3-bf9f04c276b2",
                        "entry_id": "ff23dcbd-2d37-3080-8c9e-ba1318eef21d",
                        "glosses": [
                            "низший служащий в некоторых учреждениях"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b4ce7cc-c6b1-4749-8152-2874b62cd6ef",
                                "sense_id": "79baf2ee-74a2-3840-aba3-bf9f04c276b2",
                                "text": "Пройдя через всё здание (а путь этот оказался неблизким), мы подошли к одному из боковых входов, который нам собирался открыть ходивший вместе с нами служитель театра, у которого были ключи от всех дверей."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e00c0a9-f1fa-3066-92de-66c2fe9437d1",
                        "entry_id": "ff23dcbd-2d37-3080-8c9e-ba1318eef21d",
                        "glosses": [
                            "перен. тот, кто отдаёт себя служению чему-либо, работает во имя чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e82c4d7-832c-4343-a387-3b61edae5813",
                                "sense_id": "8e00c0a9-f1fa-3066-92de-66c2fe9437d1",
                                "text": "С бурым треухом на бурых, в косичку заплетённых волосах, облечённый в желтоватый нанковый кафтан, подпоясанный гораздо ниже тальи голубеньким обрывочком, служитель алтаря вышел своё «одоньишко» проведать — и, улицезрев Пантелея Еремеича, почёл долгом выразить ему своё почтение да кстати хоть что-нибудь у него выпросить."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4eab6be3-5dc0-471b-a3d4-8469f2174714",
                        "source_entry_id": "ff23dcbd-2d37-3080-8c9e-ba1318eef21d",
                        "target_lang_word": "attendant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attendant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a32734ec-e568-34c3-a55a-49cd554bd447",
                                        "entry_id": "88aa5977-f641-369b-9a94-e7f2d736c723",
                                        "glosses": [
                                            "One who attends; one who works with or watches over someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49b15829-86db-40ae-81d0-7499161cde0d",
                                                "sense_id": "a32734ec-e568-34c3-a55a-49cd554bd447",
                                                "text": "Give your keys to the parking attendants and they will park your car for you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dd2c8f4-da63-3ce3-a397-9d88d42705f4",
                                        "entry_id": "88aa5977-f641-369b-9a94-e7f2d736c723",
                                        "glosses": [
                                            "A servant or valet."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "48a14fe7-11f6-3c75-9de5-5577fb142b2d",
                                        "entry_id": "88aa5977-f641-369b-9a94-e7f2d736c723",
                                        "glosses": [
                                            "A visitor or caller; one who attends (is present at or regularly goes to) some event or place."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd753962-267c-41fd-83e6-891c012a38f1",
                                                "sense_id": "48a14fe7-11f6-3c75-9de5-5577fb142b2d",
                                                "text": "The most remarkable of all the attendants of the exhibition at the grove near Rockville, was the grace and loveliness of the young beauties, who, mingling with the crowd of farmers, were all intent and gazing upon the stock and other agricultural products, unconscious that they were themselves ‘the observed of all observers;’ […]"
                                            },
                                            {
                                                "example_id": "6b823251-908c-47ca-8e1d-29944be2db5c",
                                                "sense_id": "48a14fe7-11f6-3c75-9de5-5577fb142b2d",
                                                "text": "In early life our subject was an attendant of Public School No. 17 in Brooklyn, and after fitting himself for business he engaged in various occupations in New York city up to the year 1889, at which time he removed to the town of Hempstead, and during the succeeding six years followed fanning as an occupation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "390344fb-0a49-38cc-9f53-f5fa39a253e1",
                                        "entry_id": "88aa5977-f641-369b-9a94-e7f2d736c723",
                                        "glosses": [
                                            "That which accompanies or follows."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2c63df02-d770-3a20-b7c7-a2e1a8d2ed0a",
                                        "entry_id": "88aa5977-f641-369b-9a94-e7f2d736c723",
                                        "glosses": [
                                            "One who owes a duty or service to another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "attendant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa1f1f82-1389-3c32-a6d6-1a568d6c3964",
                                        "entry_id": "ba64218a-41ae-3222-9210-002449ae4f86",
                                        "glosses": [
                                            "Going with; associated; concomitant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2b766e0-00b7-468b-836c-8185e10d6176",
                                                "sense_id": "fa1f1f82-1389-3c32-a6d6-1a568d6c3964",
                                                "text": "They promoted him to supervisor, with all the attendant responsibilities and privileges."
                                            },
                                            {
                                                "example_id": "a1d76efe-e570-424b-a379-80db8fbbd5ec",
                                                "sense_id": "fa1f1f82-1389-3c32-a6d6-1a568d6c3964",
                                                "text": "The natural melancholy attendant upon his situation added to the gloom of the owner of the mansion."
                                            },
                                            {
                                                "example_id": "d63bed3c-6b2e-4e7a-b4c9-4605fc5c06ad",
                                                "sense_id": "fa1f1f82-1389-3c32-a6d6-1a568d6c3964",
                                                "text": "Both Carey Schofield's Jagger and Chet Flippo's On the Road with the Rolling Stones: Twenty Years of Lipstick, Handcuffs and Chemicals are glib, gonzo journalism about the world's favorite musical sex purveyors. Both avoid much mention of the homosexuality which has always been attendant to the group."
                                            },
                                            {
                                                "example_id": "e99c6003-a944-43b3-91f3-25cdba44efee",
                                                "sense_id": "fa1f1f82-1389-3c32-a6d6-1a568d6c3964",
                                                "text": "The applicants […] seek to argue that because of the dire prognosis attaching to their medical condition, they should have been allowed to assume the risks attendant on a potentially life‑saving experimental product."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82814e42-e441-3c9c-814a-cda455a4cf0b",
                                        "entry_id": "ba64218a-41ae-3222-9210-002449ae4f86",
                                        "glosses": [
                                            "Depending on, or owing duty or service to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd48e6ae-8dae-46af-a65a-6b3c60ea85ec",
                                                "sense_id": "82814e42-e441-3c9c-814a-cda455a4cf0b",
                                                "text": "the widow attendant to the heir"
                                            },
                                            {
                                                "example_id": "6f208037-3431-4f50-a87c-491c8e4472bf",
                                                "sense_id": "82814e42-e441-3c9c-814a-cda455a4cf0b",
                                                "text": "The tenant in dower[…]shall be attendant unto them by the rate and portion of the rent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e25acafe-f229-4d6d-9dbe-455d80276ff9",
                        "source_entry_id": "ff23dcbd-2d37-3080-8c9e-ba1318eef21d",
                        "target_lang_word": "servant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "servant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "One who is hired to perform regular household or other duties, and receives compensation. As opposed to a slave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa167449-f294-4b8f-85c0-49b7f4e9ab53",
                                                "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                                "text": "There are three servants in the household, the butler and two maids."
                                            },
                                            {
                                                "example_id": "02fcd083-c8b4-4ab2-8e64-44bb20c92184",
                                                "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                                "text": "In the great houses, servants out of livery help to the different plats, servants in livery holding the dishes, sauces, etc., and changing the plates."
                                            },
                                            {
                                                "example_id": "b5fca4fb-e3e2-45c4-9973-42512bba6b44",
                                                "sense_id": "193f1701-ff20-339a-acc1-430ff5608266",
                                                "text": "As a political system democracy seems to me extraordinarily foolish, but I would not go out of my way to protest against it. My servant is, so far as I am concerned, welcome to as many votes as he can get. I would very gladly make mine over to him if I could."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "619c002d-a6ba-3ec0-b950-4fd9636ce4ff",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "One who serves another, providing help in some manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13abde63-d56e-4485-8524-42183901b6eb",
                                                "sense_id": "619c002d-a6ba-3ec0-b950-4fd9636ce4ff",
                                                "text": "She is quite the humble servant, the poor in this city owe much to her but she expects nothing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44bde33a-0c90-3c7a-957e-4119b5234ad1",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "A person who dedicates themselves to God."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2feac311-ed3b-3625-b817-a70128c46a45",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "A professed lover."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6539be18-f0cc-3d86-8fc9-db97067fca82",
                                        "entry_id": "163f80aa-e3ee-355f-8925-48167b04ece9",
                                        "glosses": [
                                            "A person of low condition or spirit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "servant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e8b91d9-9014-3bca-b5e6-d14be59c6eb7",
                                        "entry_id": "2322f7e4-d925-3ea0-ac6b-fde55935be2a",
                                        "glosses": [
                                            "To subject."
                                        ],
                                        "tags": [
                                            "obsolete",
