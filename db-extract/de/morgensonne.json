                ],
                "senses": [
                    {
                        "sense_id": "137e665f-5c0f-3ca5-8e27-3cc9c41802f2",
                        "entry_id": "1ad3d6da-f6b4-3ed3-b739-88da6fb61324",
                        "glosses": [
                            "Sonnenschein am Morgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af04a9b8-59d4-462e-9559-1edfe8150223",
                                "sense_id": "137e665f-5c0f-3ca5-8e27-3cc9c41802f2",
                                "text": "„Die rötliche Morgensonne lässt die bunten Ostfenster hinter dem Hauptaltar der gotischen Kathedrale eindrucksvoll zur Geltung kommen.“"
                            },
                            {
                                "example_id": "53a1a7cc-7f76-460e-83c2-2ffd31da3b61",
                                "sense_id": "137e665f-5c0f-3ca5-8e27-3cc9c41802f2",
                                "text": "„Im Zimmer der Kleesberg waren die beiden Fenster geöffnet. Morgensonne lag auf den Gesimsen und ein leuchtender Streif zog sich über den Teppich gegen den Frühstückstisch.“"
                            },
                            {
                                "example_id": "839967f0-9968-42e4-8e18-918b120af47d",
                                "sense_id": "137e665f-5c0f-3ca5-8e27-3cc9c41802f2",
                                "text": "„Seine Wände sind aus weißem Stoff, durch den die Morgensonne schimmert und die Farben zum Leuchten bringt:…“"
                            },
                            {
                                "example_id": "b9ff1db5-dc70-438b-ba44-fb4d2b346afb",
                                "sense_id": "137e665f-5c0f-3ca5-8e27-3cc9c41802f2",
                                "text": "„Als die Morgensonne langsam über die Wipfel der Eukalyptusbäume klettert, erzählt der Gottesmann, was es mit der Quelle unterhalb seiner Kirche auf sich hat.“"
                            },
                            {
                                "example_id": "5a92c30f-7616-4743-8bc7-8cc9049ae1f6",
                                "sense_id": "137e665f-5c0f-3ca5-8e27-3cc9c41802f2",
                                "text": "„Die helle Morgensonne blendet ihn, als er über die Auffahrt zur Straße spaziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
