            {
                "entry_id": "bacb2cd2-1168-3939-96df-d8ef772c62e2",
                "word": "bouille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2620adac-1304-424d-b2b5-2aa5babab5f1",
                        "entry_id": "bacb2cd2-1168-3939-96df-d8ef772c62e2",
                        "tags": [
                            "plural"
                        ],
                        "form": "bouilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f48fe9a-3a86-304b-be05-4935a8b1188b",
                        "entry_id": "bacb2cd2-1168-3939-96df-d8ef772c62e2",
                        "glosses": [
                            "Visage, aspect, mine."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "897b879b-0fd3-4a3c-a0b8-318a06d4cc32",
                                "sense_id": "4f48fe9a-3a86-304b-be05-4935a8b1188b",
                                "text": "Et parmi tous ces jeunes gens aussi éclatants les uns que les autres, un homme d'âge mûr, à la bonne grosse bouille, aux lèvres sinueuses et aux yeux plissés."
                            },
                            {
                                "example_id": "5a188f08-321a-4e27-8782-1ee38a49b5d3",
                                "sense_id": "4f48fe9a-3a86-304b-be05-4935a8b1188b",
                                "text": "Cédric, le secrétaire, cheveux coupés à ras, a la bouille toute ronde de son démon favori qu’il porte tatoué sur le bras, la mascotte de sa voiture, une 306 aux couleurs de l’enfer, noire et rouge."
                            },
                            {
                                "example_id": "9ab7ccbd-1568-467f-95bd-4db639008bd8",
                                "sense_id": "4f48fe9a-3a86-304b-be05-4935a8b1188b",
                                "text": "De sa main inoccupée il lui empoigne le bas du visage. Fais voir ta bouille toi."
                            },
                            {
                                "example_id": "8a666941-d1d2-41dc-8334-b3789f44ae8e",
                                "sense_id": "4f48fe9a-3a86-304b-be05-4935a8b1188b",
                                "text": "Avec sa bonne bouille et ses oreilles toutes douces, en silicone alimentaire, Fabulapin a été conçu par le Français Erwan Leroux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6255a90a-7373-4998-88c0-4e00648170e0",
                        "source_entry_id": "bacb2cd2-1168-3939-96df-d8ef772c62e2",
                        "source_sense_id": "4f48fe9a-3a86-304b-be05-4935a8b1188b",
                        "target_lang_word": "Visage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Visage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15d81284-f5f9-3fdc-bfd3-cea234f222b0",
                                        "entry_id": "5379ab65-e3e0-3bee-a459-3a6335953185",
                                        "glosses": [
                                            "Gesicht eines Menschen oder auch seine Ausstrahlung (Ausdruck)"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6799417-a6d8-4fc0-9c5d-9fbe704c3c55",
                                                "sense_id": "15d81284-f5f9-3fdc-bfd3-cea234f222b0",
                                                "text": "„Es ist bloß Franz Biberkopf, der über die ganze Visage grinst.“"
                                            },
                                            {
                                                "example_id": "c98eba69-015e-4913-89e1-eb650da3daa2",
                                                "sense_id": "15d81284-f5f9-3fdc-bfd3-cea234f222b0",
                                                "text": "Eine Ordensschwester mit der Visage eines Raubvogels saß am Empfang."
                                            },
                                            {
                                                "example_id": "b8e2384c-7e4a-4ebe-89e5-ad66126a9d18",
                                                "sense_id": "15d81284-f5f9-3fdc-bfd3-cea234f222b0",
                                                "text": "„Irgendwann habe ich kapiert, dass meine edle Visage niemandem hilft.“"
                                            },
                                            {
                                                "example_id": "3aea59a9-12ef-4746-bce7-d80906031e6f",
                                                "sense_id": "15d81284-f5f9-3fdc-bfd3-cea234f222b0",
                                                "text": "„Lukas Piontek hat schon recht früh sein wahres Gesicht gezeigt: die Visage eines jähzornigen rücksichtslosen brutalen Egoisten.“"
                                            },
                                            {
                                                "example_id": "37964622-839e-4311-a0f5-d8126bb6fa09",
                                                "sense_id": "15d81284-f5f9-3fdc-bfd3-cea234f222b0",
                                                "text": "Was machst du denn für eine Visage?"
                                            },
                                            {
                                                "example_id": "2b0e3500-f4a4-4de6-b006-f0634e9b6488",
                                                "sense_id": "15d81284-f5f9-3fdc-bfd3-cea234f222b0",
                                                "text": "Hallo! Die Visage kenn ich doch!"
                                            },
                                            {
                                                "example_id": "c5ff3392-7e9f-434b-8f6e-44e56f003232",
                                                "sense_id": "15d81284-f5f9-3fdc-bfd3-cea234f222b0",
                                                "text": "Pass bloß auf, sonst polier ich dir die Visage!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
