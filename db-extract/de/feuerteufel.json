                        "entry_id": "fa245794-64b9-3336-a75b-072b73b4dc4a",
                        "glosses": [
                            "jemand, der zum Spaß oder wegen einer psychischen Störung Dinge in Brand setzt"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b987d79f-ac85-4923-bf4f-b3b63ab9af76",
                                "sense_id": "f49aa82a-f1a4-35b3-b276-91013e818b09",
                                "text": "Seit Monaten treibt ein Feuerteufel in dem kleinen Ort an der Saale sein Unwesen."
                            },
                            {
                                "example_id": "214ef221-6afe-4d84-b44c-e2bba9be4b22",
                                "sense_id": "f49aa82a-f1a4-35b3-b276-91013e818b09",
                                "text": "Die Polizei sucht nach dem Feuerteufel, der bereits drei Autos angezündet hat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
