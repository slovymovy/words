                "senses": [
                    {
                        "sense_id": "fc81d6e9-21f8-3fb4-9782-bf2d0700f130",
                        "entry_id": "0fe3d16a-07ae-3d09-a10b-c78ab6ed90f8",
                        "glosses": [
                            "lebensbedrohender Umstand, wenn zwei oder mehr Körperorgane zeitgleich ihre Tätigkeit einstellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22790408-ba52-4b2e-acf3-ad3d5731240b",
                                "sense_id": "fc81d6e9-21f8-3fb4-9782-bf2d0700f130",
                                "text": "„Häufig tritt das akute Lungenversagen zusammen mit dem Versagen anderer Organsysteme wie Nieren, Kreislauf, Blutgerinnung, Gehirn und Leber (Multiorganversagen) auf.“"
                            },
                            {
                                "example_id": "c3b9affb-ea02-4a74-bd2e-41ab66ab8bb9",
                                "sense_id": "fc81d6e9-21f8-3fb4-9782-bf2d0700f130",
                                "text": "„Ein Multiorganversagen weist eine hohe Letalität auf und erfordert deshalb eine intensivmedizinische Versorgung unter kontinuierlichem Monitoring der Vitalfunktionen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
