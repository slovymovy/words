                        "sense_id": "48cbaafc-400d-3f54-9366-b03aea95dda7",
                        "entry_id": "88017045-d186-38ad-9fdf-a66f25168e66",
                        "glosses": [
                            "synonyme de manchego, relatif à la Manche (région historique d’Espagne)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e1be2f6-48ed-4bf7-956e-64404f4c11ae",
                                "sense_id": "48cbaafc-400d-3f54-9366-b03aea95dda7",
                                "text": "Pour l’Andalousie, la différenciation des productions oléicoles sous appellation face à la production de masse est encore plus délicate à établir car, contrairement aux viticultures languedocienne ou manchègue, l’oléiculture de masse se maintient voire s’accroît au profit des principaux acteurs économiques de la filière oléicole qui souhaitent préserver cette production de masse."
                            },
                            {
                                "example_id": "49225fd5-9f6a-44b1-a0f7-1c9ff6971c42",
                                "sense_id": "48cbaafc-400d-3f54-9366-b03aea95dda7",
                                "text": "Don Quichotte, héros de la race manchègue, crée les circonstances qui deviendront sa propre mythologie."
                            },
                            {
                                "example_id": "f12c64ec-e701-4ff7-bba4-d8505e70d2ce",
                                "sense_id": "48cbaafc-400d-3f54-9366-b03aea95dda7",
                                "text": "Comme le héros manchègue, il cherche une Dulcinée : l’amour vrai."
                            }
                        ]
                    }
                ],
