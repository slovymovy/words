                ],
                "senses": [
                    {
                        "sense_id": "8de9e614-e6ca-3362-a9d2-a5652e05b04d",
                        "entry_id": "a10bab54-0e0a-3b39-aa38-475f6c62ef60",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4cd3690-ab36-4355-b8ae-9912e3379104",
                                "sense_id": "8de9e614-e6ca-3362-a9d2-a5652e05b04d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Altenberg kommt, geht der Herr Altenberg.“"
                            },
                            {
                                "example_id": "5e48af4e-5fe8-4072-911f-ddc31becc143",
                                "sense_id": "8de9e614-e6ca-3362-a9d2-a5652e05b04d",
                                "text": "Altenberg kommt und geht."
                            },
                            {
                                "example_id": "0ea08023-467d-40a6-8c66-7fdf31762638",
                                "sense_id": "8de9e614-e6ca-3362-a9d2-a5652e05b04d",
                                "text": "Frau Altenberg ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3050f9f0-7087-48c2-af51-ff827cc77100",
                                "sense_id": "8de9e614-e6ca-3362-a9d2-a5652e05b04d",
                                "text": "Herr Altenberg wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "08d6d700-29fc-4b18-b9c4-7dbdf11f4d24",
                                "sense_id": "8de9e614-e6ca-3362-a9d2-a5652e05b04d",
                                "text": "Die Altenbergs fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "3701262b-35e4-4069-8637-dc3f7c98a16c",
                                "sense_id": "8de9e614-e6ca-3362-a9d2-a5652e05b04d",
                                "text": "Der Altenberg trägt nie die Pullover, die die Altenberg ihm strickt."
                            },
                            {
                                "example_id": "b95b21de-eb9b-4f02-824d-a04d62ffce6e",
                                "sense_id": "8de9e614-e6ca-3362-a9d2-a5652e05b04d",
                                "text": "Altenbergs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
