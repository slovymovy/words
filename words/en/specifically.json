{
    "word_family": [
        "specific",
        "specification",
        "specificity",
        "specify"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "36277b08-0f8b-35a3-9d6e-701631d826c4",
                    "sense_definition": "In a detailed and exact way; clearly and precisely.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contract <w>specifically</w> states that payments must be made by the first of the month.",
                            "target_lang_translations": {
                                "ru": "В контракте <w>конкретно</w> указано, что платежи должны быть внесены до первого числа месяца.",
                                "zh": "合同中<w>明确</w>规定，付款必须在每月一日前完成。"
                            }
                        },
                        {
                            "text": "I <w>specifically</w> asked you to lock the door before we left the house.",
                            "target_lang_translations": {
                                "ru": "Я <w>специально</w> просил тебя запереть дверь перед тем, как мы вышли из дома.",
                                "zh": "我<w>明确</w>嘱咐过你，离开家之前要把门锁好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "explicitly",
                        "expressly",
                        "clearly",
                        "unambiguously",
                        "unequivocally",
                        "directly"
                    ],
                    "antonyms": [
                        "generally"
                    ],
                    "common_phrases": [
                        "specifically stated",
                        "specifically mentioned",
                        "specifically asked"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подробно, точно и недвусмысленно; ясно и определённо.",
                        "zh": "以详细且确切的方式；清晰且明确地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конкретно",
                                "target_lang_sense_clarification": "точно, в деталях"
                            },
                            {
                                "target_lang_word": "особо",
                                "target_lang_sense_clarification": "отдельно, подчёркнуто"
                            },
                            {
                                "target_lang_word": "специально",
                                "target_lang_sense_clarification": "намеренно, с акцентом на этом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "明确地",
                                "target_lang_sense_clarification": "指表达清晰、不含糊"
                            },
                            {
                                "target_lang_word": "具体地",
                                "target_lang_sense_clarification": "指细节详尽、确切"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "155634e6-0fbb-38c3-9706-1f3f0c2722a1",
                    "sense_definition": "For a particular purpose, person, or situation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These educational toys are designed <w>specifically</w> for children with learning disabilities.",
                            "target_lang_translations": {
                                "ru": "Эти развивающие игрушки разработаны <w>специально</w> для детей с трудностями в обучении.",
                                "zh": "这些益智玩具是<w>专门</w>为有学习障碍的儿童设计的。"
                            }
                        },
                        {
                            "text": "She bought this dress <w>specifically</w> for the wedding ceremony next week.",
                            "target_lang_translations": {
                                "ru": "Она купила это платье <w>именно</w> для свадебной церемонии на следующей неделе.",
                                "zh": "她买这条裙子就是<w>专门</w>为了下周的婚礼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "specially",
                        "particularly",
                        "especially"
                    ],
                    "antonyms": [
                        "generally"
                    ],
                    "common_phrases": [
                        "specifically for",
                        "specifically designed",
                        "specifically created"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исключительно для определённой цели, человека или ситуации.",
                        "zh": "为了特定的目的、人或情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "специально",
                                "target_lang_sense_clarification": "для конкретной цели"
                            },
                            {
                                "target_lang_word": "именно",
                                "target_lang_sense_clarification": "как раз, точно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "专门",
                                "target_lang_sense_clarification": "指为了特定目的而做"
                            },
                            {
                                "target_lang_word": "特地",
                                "target_lang_sense_clarification": "指为了某事而专门做某动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}