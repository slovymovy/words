                    {
                        "sense_id": "3e9acbe9-006e-3428-9d82-650ba2aeac5b",
                        "entry_id": "22bce37e-5334-3a7b-9968-f3c824f40d2a",
                        "glosses": [
                            "Stadt an der Küste der Halbinsel Yucatán im mexikanischen Bundesstaat Quintana Roo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68b35e56-bf3c-43af-8b86-33c444e0c071",
                                "sense_id": "3e9acbe9-006e-3428-9d82-650ba2aeac5b",
                                "text": "„›Spiders sicarios haben deinen amerikanischen Freund gestern geschnappt, als er versuchte, auf einem Kreuzfahrtschiff in Cancún einzuchecken.‹“"
                            },
                            {
                                "example_id": "ffc26441-34e3-4d6f-9fb4-a09385ed6bd1",
                                "sense_id": "3e9acbe9-006e-3428-9d82-650ba2aeac5b",
                                "text": "„Ein Wohnviertel in Cancún. Ein Kleintransporter, der seit ein paar Tagen in einer Straße abgestellt ist, kommt den Bewohnern so verdächtig vor, dass sie die Polizei rufen.“"
                            }
                        ],
