                    {
                        "sense_id": "186fab8a-c33d-3218-8868-a6092b4bd22b",
                        "entry_id": "08d2d576-9a1a-3fbb-9161-a593bd4a3a2f",
                        "glosses": [
                            "A physical lock on the case of a computer, preventing use of the keyboard until unlocked."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1d4dbe02-b212-4df7-bb6a-5f6a5cfcfad5",
                                "sense_id": "186fab8a-c33d-3218-8868-a6092b4bd22b",
                                "text": "We complained in our review of the PC AT that the problem with the keylock is that when you power up with the keylock on, you cannot continue until you unlock the system."
                            },
                            {
                                "example_id": "3f547e76-6a51-4f19-9b31-0ffeeb8f761b",
                                "sense_id": "186fab8a-c33d-3218-8868-a6092b4bd22b",
                                "text": "The keylock on the front of some more advanced PCs may be locked in the off position, grounding out the keyboard-to-motherboard circuit. Turn the key to the on position."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e1979dd-5897-3716-9a26-3713df7b0b6f",
                        "entry_id": "08d2d576-9a1a-3fbb-9161-a593bd4a3a2f",
                        "glosses": [
                            "A digital feature used by disc jockeys that locks a track to its original key regardless of changes made to the tempo."
