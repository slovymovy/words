                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "483ebca7-f0f3-4ab9-9bdc-b459c4ec416d",
                                                "sense_id": "0d754d8a-5daa-3c53-9458-21bc3d4187e1",
                                                "text": "Holonyms: mixture; whole"
                                            },
                                            {
                                                "example_id": "d3c3f717-e24a-491e-9511-d66d8176dfdd",
                                                "sense_id": "0d754d8a-5daa-3c53-9458-21bc3d4187e1",
                                                "text": "Near-synonyms: constituent, component"
                                            },
                                            {
                                                "example_id": "f3a18261-2409-4802-b4b1-3b5612e78474",
                                                "sense_id": "0d754d8a-5daa-3c53-9458-21bc3d4187e1",
                                                "text": "The ingredients of a Spanish omelette are potatoes, eggs, onion, and a little salt."
                                            },
                                            {
                                                "example_id": "ca2aad46-263c-43a3-9f56-39edfa906c06",
                                                "sense_id": "0d754d8a-5daa-3c53-9458-21bc3d4187e1",
                                                "text": "By way of analysis we may proceed from compounds to ingredients."
                                            },
                                            {
                                                "example_id": "718ad2e2-3509-48ef-a57a-b2163b38d0fe",
                                                "sense_id": "0d754d8a-5daa-3c53-9458-21bc3d4187e1",
                                                "text": "Water is the chief ingredient in all the animal fluids and solids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a271528d-f574-39c7-bca9-c19a6da9ee56",
                                        "entry_id": "61292dd1-b7c0-3a21-9530-35062e8264e9",
                                        "glosses": [
                                            "A necessary element to achieve a certain goal; a component."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d132453a-2436-4f56-986d-55291288cf49",
                                                "sense_id": "a271528d-f574-39c7-bca9-c19a6da9ee56",
                                                "text": "Holonym: end result"
                                            },
                                            {
                                                "example_id": "794acde7-8d1c-4675-8a0e-cc467c036e43",
                                                "sense_id": "a271528d-f574-39c7-bca9-c19a6da9ee56",
                                                "text": "Innovation is just one ingredient for continued growth."
                                            },
                                            {
                                                "example_id": "ae57666d-af79-4e01-94a8-0559cad3d619",
                                                "sense_id": "a271528d-f574-39c7-bca9-c19a6da9ee56",
                                                "text": "Patience and understanding are key ingredients for a long-lasting marriage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
