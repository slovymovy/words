                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9261b883-ede6-4307-baee-5750f3730595",
                                                "sense_id": "3e1b5b31-ec62-322a-8f77-1cb11abf9c36",
                                                "text": "„Je nach Erfolg erweist sich ein System auf Dauer als gut, schlecht, oder ausbaufähig.“"
                                            },
                                            {
                                                "example_id": "faf860c6-0414-4bc0-871d-eff194a8b343",
                                                "sense_id": "3e1b5b31-ec62-322a-8f77-1cb11abf9c36",
                                                "text": "„Diese Entwicklung zeigt eine Tendenz zur größeren Nutzung der Angebote, ist jedoch bezogen auf die Gesamtbevölkerung in Deutschland ausbaufähig.“"
                                            },
                                            {
                                                "example_id": "e8c09470-a9ea-4d0f-ac48-9a4cd8e7cfa5",
                                                "sense_id": "3e1b5b31-ec62-322a-8f77-1cb11abf9c36",
                                                "text": "„Die Kooperationen zwischen Kommunen und ihren Stakeholdern sind insgesamt betrachtet noch sehr ausbaufähig.“"
                                            },
                                            {
                                                "example_id": "a534dc14-2fee-41f8-a5a5-527b50d6aade",
                                                "sense_id": "3e1b5b31-ec62-322a-8f77-1cb11abf9c36",
                                                "text": "„Gerade dieses Vorgehen kann als große, jedoch noch ausbaufähige Chance für das Viertel und sein kulturelles Erbe gelten.“"
                                            },
                                            {
                                                "example_id": "60bd8560-4f40-49c1-9fda-9257a13f076e",
                                                "sense_id": "3e1b5b31-ec62-322a-8f77-1cb11abf9c36",
                                                "text": "„Dies ist eine stattliche, jedoch ausbaufähige Quote von 51% bezogen auf unsere Gesamtkundenanzahl.“"
                                            },
                                            {
                                                "example_id": "d28081a8-ae34-4660-9e1b-7dbf4987aa10",
                                                "sense_id": "3e1b5b31-ec62-322a-8f77-1cb11abf9c36",
                                                "text": "„Ich habe genug Geld verdient durch die Büffeljagd und anderswo, um eine kleine und ausbaufähige Ranch zu kaufen oder selbst eine aufzubauen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
