                    },
                    {
                        "translation_id": "c73969b9-ef78-4c89-a36e-1776b7ab16c1",
                        "source_entry_id": "9b05284d-852d-31a2-aec6-6375baa7e243",
                        "source_sense_id": "e9d767ce-0dc6-312b-be11-6d487d9728a7",
                        "target_lang_word": "erbarmungslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erbarmungslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d3c031f-34e8-3f6d-b8e4-c122a5e8012b",
                                        "entry_id": "6f25faee-2b11-3df8-8abb-0319d5a61f3e",
                                        "glosses": [
                                            "ohne Erbarmen; ohne Mitleid, Nachsicht zu zeigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a393f0af-952d-47aa-b6da-f7fc135d9b81",
                                                "sense_id": "6d3c031f-34e8-3f6d-b8e4-c122a5e8012b",
                                                "text": "Die Gefangenen wurden erbarmungslos vorangetrieben."
                                            },
                                            {
                                                "example_id": "85716a79-387d-48c1-99c6-c382ee4ce623",
                                                "sense_id": "6d3c031f-34e8-3f6d-b8e4-c122a5e8012b",
                                                "text": "Der Reiter schlug erbarmungslos auf sein Pferd ein."
                                            },
                                            {
                                                "example_id": "6b112e9f-d22e-4cb1-b154-c77e912c0bb7",
                                                "sense_id": "6d3c031f-34e8-3f6d-b8e4-c122a5e8012b",
                                                "text": "„Dann prügelte er die beiden erbarmungslos zusammen und - was noch schrecklicher war - entzog ihnen für Tage die Nahrung.“"
                                            },
                                            {
                                                "example_id": "9d7de7df-1626-4c55-85ad-ae5d490e4905",
                                                "sense_id": "6d3c031f-34e8-3f6d-b8e4-c122a5e8012b",
                                                "text": "„War er sich denn nicht der Tatsache bewusst, dass in dieser erbarmungslosen Gesellschaft, in der alles aufgenommen und fotografiert wurde, nicht einmal das kleinste Fehlbetragen oder missverständliche Wort unbemerkt blieben?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be373c26-2be9-47a6-8213-850e5e0da7a9",
                        "source_entry_id": "9b05284d-852d-31a2-aec6-6375baa7e243",
                        "source_sense_id": "e9d767ce-0dc6-312b-be11-6d487d9728a7",
                        "target_lang_word": "gnadenlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gnadenlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                        "entry_id": "a3bbf6c4-2d54-30be-a763-33743ea4a83d",
                                        "glosses": [
                                            "ohne Gnade, ohne Wohlwollen gegenüber einem Schwächeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e5d193e-2ddc-4554-a13b-eeebb61eff46",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Der König galt als gnadenlos, wenn es um die Verfolgung seiner Feinde ging."
                                            },
                                            {
                                                "example_id": "dd590e49-eb30-432b-8f0c-2ebdb159ee15",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Wir beuten Tiere gnadenlos aus, man denke nur an die Massentierhaltung und unseren Fleischkonsum."
                                            },
                                            {
                                                "example_id": "9c8dbf01-50f7-4326-8d78-b04e6f68a169",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "In Italien, das mit großem Einsatz Migranten aufnimmt, werden dieselben Migranten gnadenlos ausgebeutet. Große Teile der Landwirtschaft leben von diesen Ausgebeuteten."
                                            },
                                            {
                                                "example_id": "347cd810-4213-4a05-8ed7-8d9ab67fd3b5",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Syrische Kampfflugzeuge bombardieren die Rebellengebiete mit gnadenloser Härte."
                                            },
                                            {
                                                "example_id": "8c7cb036-beb9-41f9-95d2-7c5359285158",
                                                "sense_id": "a7a83ddd-66f7-302f-9ac3-f849d0d2b403",
                                                "text": "Oh, diese Vorstellung war wohl gnadenlos gut!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
