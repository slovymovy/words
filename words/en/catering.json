{
    "word_family": [
        "cater",
        "caterer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "869af21e-73ff-3e98-ac6f-e47042c6da13",
                    "sense_definition": "The business or activity of providing food and drink services, especially for social events or large gatherings.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They hired a local company to handle the <w>catering</w> for their wedding.",
                            "target_lang_translations": {
                                "ru": "Они наняли местную компанию, чтобы организовать <w>кейтеринг</w> на своей свадьбе."
                            }
                        },
                        {
                            "text": "She has worked in the <w>catering</w> industry for more than ten years.",
                            "target_lang_translations": {
                                "ru": "Она работает в индустрии <w>общественного питания</w> уже более десяти лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "foodservice"
                    ],
                    "common_phrases": [
                        "catering service",
                        "catering company",
                        "catering industry",
                        "wedding catering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность или сфера услуг по обеспечению питанием и напитками, особенно на мероприятиях или для больших групп людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кейтеринг",
                                "target_lang_sense_clarification": "выездное ресторанное обслуживание"
                            },
                            {
                                "target_lang_word": "общественное питание",
                                "target_lang_sense_clarification": "сфера или организация питания"
                            },
                            {
                                "target_lang_word": "организация питания",
                                "target_lang_sense_clarification": "процесс обеспечения едой и напитками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba52abf2-4f6f-3593-b088-66243ee5baf5",
                    "sense_definition": "The act of pandering or providing what is needed or desired, often to questionable tastes or demands.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician was criticized for constant <w>catering</w> to special interest groups.",
                            "target_lang_translations": {
                                "ru": "Политика критиковали за постоянное <w>потакание</w> группам с особыми интересами."
                            }
                        },
                        {
                            "text": "Such continuous <w>catering</w> to popular demand compromised the quality of their journalism.",
                            "target_lang_translations": {
                                "ru": "Такое непрерывное <w>угождение</w> вкусам публики негативно сказалось на качестве их журналистики."
                            }
                        }
                    ],
                    "synonyms": [
                        "pandering"
                    ],
                    "common_phrases": [
                        "catering to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угождение, потакание чьим-либо вкусам, прихотям или специфическим требованиям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потакание",
                                "target_lang_sense_clarification": "снисхождение к капризам или запросам"
                            },
                            {
                                "target_lang_word": "угождение",
                                "target_lang_sense_clarification": "стремление угодить чьим-либо вкусам или требованиям"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "62da6b6d-a668-3978-bbed-237f9e81a964",
                    "sense_definition": "present participle and gerund of <w>cater</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel is <w>catering</w> an important corporate lunch this afternoon.",
                            "target_lang_translations": {
                                "ru": "Сегодня днем отель <w>организует питание</w> для важного корпоративного обеда."
                            }
                        },
                        {
                            "text": "The new resort focuses on <w>catering</w> to families with young children.",
                            "target_lang_translations": {
                                "ru": "Новый курорт ориентирован на то, чтобы <w>удовлетворять потребности</w> семей с маленькими детьми."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени или герундий от глагола cater: обслуживать, обеспечивать питанием или угождать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обслуживающий",
                                "target_lang_sense_clarification": "предоставляющий питание или сервис"
                            },
                            {
                                "target_lang_word": "угождающий",
                                "target_lang_sense_clarification": "удовлетворяющий потребности или запросы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}