                                        "entry_id": "bd3577e9-51e7-3ad3-ba72-1d8b53a0b6a8",
                                        "glosses": [
                                            "One who is in charge of stores or goods of any kind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d950e61-bb36-4ae5-9c63-34b0a9a70880",
