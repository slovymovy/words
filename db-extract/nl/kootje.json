                    }
                ],
                "translations": [
                    {
                        "translation_id": "16300c8c-d517-4401-b635-b8b8542dc8b9",
                        "source_entry_id": "e4537899-2d10-34ba-9d68-60b4ef5b0766",
                        "source_sense_id": "4ac60fce-f185-3299-a928-15873994aa99",
                        "source_sense_description": "beentje van vinger of teen",
                        "target_lang_word": "Phalanx",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Phalanx",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ddda5537-1bfd-3dda-b0ca-2094f143878c",
                                        "entry_id": "d73d023b-d41d-3074-87e6-d6808c61af7c",
                                        "glosses": [
                                            "Schlachtaufstellung im alten Griechenland in mehreren Gliedern - lineare Formation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b687565-3f9e-4aa4-8914-b865e8ffbcdd",
                                                "sense_id": "ddda5537-1bfd-3dda-b0ca-2094f143878c",
                                                "text": "„Die Phalanx leitete im griechischen Altertum den Übergang von Einzel- zu Formationskämpfen ein. Die Phalanx wurde wahrscheinlich von den Spartanern im 7. Jahrhundert v. Chr. erfunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e87a8aaa-9682-3046-91d8-e7d39500ecb8",
                                        "entry_id": "d73d023b-d41d-3074-87e6-d6808c61af7c",
                                        "glosses": [
                                            "geschlossene, Widerstand leistende Front"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd9d93ea-1926-4e98-9fc9-0c9644276024",
                                                "sense_id": "e87a8aaa-9682-3046-91d8-e7d39500ecb8",
                                                "text": "„\"Internetabzocke und Telefonbetrug werden immer mehr zu einer Einkommensquelle kriminell agierender Personen\", stellte Jarolim fest, der die Justizministerin aufrief, \"der Phalanx gegen diese Verbrechen beizutreten\".“"
                                            },
                                            {
                                                "example_id": "765b9c2d-2899-4a5b-9983-af1608dd2c6a",
                                                "sense_id": "e87a8aaa-9682-3046-91d8-e7d39500ecb8",
                                                "text": "„In der Mitte zwischen den Regalen steht ein länglicher Tisch mit Stehlampe; seine relativ große Holzplatte bleibt gänzlich leer – bis auf die berühmte Phalanx penibel gespitzter Bleistifte, etwa ein gutes Dutzend oder mehr.“"
                                            },
                                            {
                                                "example_id": "159f4696-c8b6-4bf6-9b43-b5edc8cf0287",
                                                "sense_id": "e87a8aaa-9682-3046-91d8-e7d39500ecb8",
                                                "text": "„Drei breitbackige und mollige Buben, die ihn sofort an Heinrich, Eli und Gottfried, seine Brüder, erinnerten, schürzte sie wie eine mächtige Phalanx um sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "58b7c2aa-7dc5-383a-8e98-72ea6cedeae9",
                                        "entry_id": "d73d023b-d41d-3074-87e6-d6808c61af7c",
                                        "glosses": [
                                            "Finger- oder Zehenglied"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cebcee5e-770a-45d0-b937-81677d1ed581",
                                                "sense_id": "58b7c2aa-7dc5-383a-8e98-72ea6cedeae9",
                                                "text": "„Ist es zu stark extendiert, entsteht eine Druckstelle dorsal über dem IP-Gelenk oder über dem Zehennagel, bei Versteifung in zu starker Flexion entwickelt sich die Druckstelle planar an der Phalanx.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5b4c773-434e-4bd1-9041-4f120d28a717",
                        "source_entry_id": "e4537899-2d10-34ba-9d68-60b4ef5b0766",
                        "source_sense_id": "4ac60fce-f185-3299-a928-15873994aa99",
                        "source_sense_description": "beentje van vinger of teen",
                        "target_lang_word": "phalanx",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phalanx",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1581783-3a59-3d71-94bd-96bef12cb1cc",
                                        "entry_id": "a64fa36a-d5fb-39dc-b8f9-68faacbde004",
                                        "glosses": [
                                            "An ancient Greek and Macedonian military unit that consisted of several ranks and files (lines) of soldiers in close array with joined shields and long spears."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec904b03-d0c7-34a7-85e9-e0ecc688020b",
                                        "entry_id": "a64fa36a-d5fb-39dc-b8f9-68faacbde004",
                                        "glosses": [
                                            "A Fourierite utopian community; a phalanstery."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b798f08-d371-47c9-b73d-504720b70c95",
                                                "sense_id": "ec904b03-d0c7-34a7-85e9-e0ecc688020b",
                                                "text": "[Charles Fourier] calculated that if precisely 1,620 men, women and children were collected in a 6,000-acre phalanx, they would — all by merrily following their individual passions — end up satisfying all the phalanx’s essential needs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e008549a-3338-3eae-b3f1-f40551c871dd",
                                        "entry_id": "a64fa36a-d5fb-39dc-b8f9-68faacbde004",
                                        "glosses": [
                                            "A large group of people, animals or things, compact or closely massed, or tightly knit and united in common purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e4a453-18fc-4ac8-a520-57b9513db999",
                                                "sense_id": "e008549a-3338-3eae-b3f1-f40551c871dd",
                                                "text": "The monarch hath gone, but his rocky throne\nStill rests on its frowning base;\nIts motionless guards rise in phalanx lone,\nAnd nought save the winds through their helmets that moan,\nAnd none but those bosoms and hearts of stone\nSigh o'er a fallen race."
                                            },
                                            {
                                                "example_id": "e82a6170-0d48-4e6a-8f17-1399f638b46b",
                                                "sense_id": "e008549a-3338-3eae-b3f1-f40551c871dd",
                                                "text": "But there was no man to greet them in the market-place, and no woman's face appeared at the windows - only a bodiless voice went before them, calling: \"Fallen is Imperial Kôr! - fallen! - fallen! fallen!\" On, right through the city, marched those gleaming phalanxes, and the rattle of their bony tread echoed through the silent air as they pressed grimly on."
                                            },
                                            {
                                                "example_id": "a120af74-f7fd-426c-b833-a099b705e3ad",
                                                "sense_id": "e008549a-3338-3eae-b3f1-f40551c871dd",
                                                "text": "From Courbevoie to the Hôtel des Invalides, one walked through a hedge of elaborate decorations—of bees, eagles, crowns, N’s; of bucklers, banners, and wreaths bearing the names of famous victories; of urns blazing with incense; of rostral columns; masts bearing trophies of arms and clusters of flags; flaming tripods; allegorical statues; triumphal arches; great banks of seats draped in imperial purple and packed with spectators, and phalanges of soldiers."
                                            },
                                            {
                                                "example_id": "3cf76adb-f3dd-4036-9d73-e2303909a8e5",
                                                "sense_id": "e008549a-3338-3eae-b3f1-f40551c871dd",
                                                "text": "Broad phalanx of cars across the bridge moving slowly through the streaming snow."
                                            },
                                            {
                                                "example_id": "40835e2e-dcea-4b2b-8270-f28fb214156f",
                                                "sense_id": "e008549a-3338-3eae-b3f1-f40551c871dd",
                                                "text": "The Guardian today listed a phalanx of ministers who back the bill, including Tessa Jowell, the culture secretary, Tony McNulty, the policing minister, Andy Burnham, the junior health minister, Ian Pearson, the climate change minister, John Healey, the financial secretary to the Treasury, and Keith Hill, parliamentary private secretary to Tony Blair."
                                            },
                                            {
                                                "example_id": "81d52d61-a5d3-4a8a-9ec5-d0de109ce862",
                                                "sense_id": "e008549a-3338-3eae-b3f1-f40551c871dd",
                                                "text": "There, the Paisleyites were being held back by another phalanx of soldiers and policemen."
                                            },
                                            {
                                                "example_id": "725725cc-02e7-4b6b-942d-dd52c66ab9bf",
                                                "sense_id": "e008549a-3338-3eae-b3f1-f40551c871dd",
                                                "text": "For a short time the two phalanges of men faced each other at a distance apart."
                                            },
                                            {
                                                "example_id": "d58bc73f-0d91-4f34-a328-00be0950bcbc",
                                                "sense_id": "e008549a-3338-3eae-b3f1-f40551c871dd",
                                                "text": "The next day, phalanges of soldiers blocked all entrances to the city as rumours that Muslim workers from all around Calcutta would throng the venue of the meeting in protest reached the commissioner of the city Police."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd2201dd-1bed-3aae-be40-d4bbff0db832",
                                        "entry_id": "a64fa36a-d5fb-39dc-b8f9-68faacbde004",
                                        "glosses": [
                                            "One of the bones of the finger or toe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "608a873a-7ba0-3bfc-9c55-ebde3c6ceb51",
                                        "entry_id": "a64fa36a-d5fb-39dc-b8f9-68faacbde004",
                                        "glosses": [
                                            "A bundle of stamens, in diadelphous and polyadelphous flowers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e265fcae-d98a-4836-8a36-0a390fff7e7b",
                        "source_entry_id": "e4537899-2d10-34ba-9d68-60b4ef5b0766",
