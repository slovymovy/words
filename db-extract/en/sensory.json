                                "target_senses": [
                                    {
                                        "sense_id": "194dcead-6fc5-3dd4-8f30-4329929253a8",
                                        "entry_id": "ae70ff82-69fc-39bd-b048-63ddd3fa13a7",
                                        "glosses": [
                                            "vztahující se k smyslům či smyslu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50754b9e-6bfd-409e-99f9-1282a38318ca",
                                                "sense_id": "194dcead-6fc5-3dd4-8f30-4329929253a8",
                                                "text": "Pro Alše jest právě karakteristická intuitivnost jeho tvůrčí síly: pozorování, postřeh smyslový jsou u něho cosi druhotného, co sesiluje snad invenci nebo podpírá ji, ale nevytváří jí a nevyvozuje jí ze sebe."
                                            },
                                            {
                                                "example_id": "8493a123-e20f-4762-bee9-4a7bcb62277a",
                                                "sense_id": "194dcead-6fc5-3dd4-8f30-4329929253a8",
                                                "text": "Odstavíš-li však jedno z těchto očí prstem, uvidíš, jak se jeden pozorovaný předmět promění ve dva. (…) Již od svých nejranějších výzkumů smyslového vnímání se Leonardo při zkoumání zraku neomezoval jen na optiku oka, ale sledoval, jak smyslové vjemy putují prostřednictvím nervů do mozku."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "798227e3-7df0-41e7-80aa-c757fa92f7d1",
                        "source_entry_id": "bcf6cfc1-768a-3d86-896f-a2153fada3af",
