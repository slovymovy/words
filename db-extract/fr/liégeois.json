            {
                "entry_id": "2cd3cb99-c57c-3fcb-b6a0-1ddc73e44dd2",
                "word": "Liégeois",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2096c8ad-aa87-48f1-a79c-5c3beedbb7e5",
                        "entry_id": "2cd3cb99-c57c-3fcb-b6a0-1ddc73e44dd2",
                        "tags": [
