                    "sense_id": "e77a83c7-229e-39de-a11b-90c08843ca41",
                    "sense_definition": "Couper nettement ou séparer à l'aide d'un instrument acéré.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "couper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier utilise un couteau bien affûté pour <w>trancher</w> la viande rôtie."
                        },
                        {
                            "text": "D'un seul coup de hache, le bûcheron a <w>tranché</w> la corde qui retenait le tronc."
                        }
                    ],
                    "synonyms": [
