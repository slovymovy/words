                ],
                "senses": [
                    {
                        "sense_id": "28ff8efd-6f91-3d6f-b1a0-85c918a6d28b",
                        "entry_id": "5684ed91-6d82-355d-83e1-11b88c9f3af0",
                        "glosses": [
                            "Donner un caractère météorologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea4d1eb3-6dad-4ff8-8b44-fe2892c26ced",
                                "sense_id": "28ff8efd-6f91-3d6f-b1a0-85c918a6d28b",
                                "text": "Ainsi, l'astrophysicien Menzel « météorologise » de son côté l'observation d'Ezéchiel (1952 : 124-134)."
                            },
                            {
                                "example_id": "39416b55-547d-4aa7-8818-acb9d57e041e",
                                "sense_id": "28ff8efd-6f91-3d6f-b1a0-85c918a6d28b",
                                "text": "La main météorologise l'âme."
                            }
                        ]
                    },
                    {
                        "sense_id": "597ca8fb-2203-346b-8b37-1e161bac4fb2",
                        "entry_id": "5684ed91-6d82-355d-83e1-11b88c9f3af0",
                        "glosses": [
                            "Étudier la météo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb6953be-d179-41c7-8cb6-32ed341f279f",
                                "sense_id": "597ca8fb-2203-346b-8b37-1e161bac4fb2",
                                "text": "Un même personnage météorologise et se ramasse."
                            },
                            {
                                "example_id": "4dbe011d-f25b-4409-a0fc-d7dbc0fd459e",
                                "sense_id": "597ca8fb-2203-346b-8b37-1e161bac4fb2",
                                "text": "Ces éléments s'avéreront déterminants lorsque nous analyserons cette notion chez Aristophane et en particulier la comédie des Nuées où Socrate, à la manière d'un daimon s'envolant dans les airs pour « météorologiser », intervient sur l'âme des disciples de sa confrérie qui « socratisent » par parenté intellectuelle avec lui."
                            }
                        ]
                    }
