                "senses": [
                    {
                        "sense_id": "6933cae1-6fdb-343a-85a6-5dd561ed1ae1",
                        "entry_id": "c83b1e42-6efe-3e44-9e3f-c8fa7324f690",
                        "glosses": [
                            "обладающий большим талантом; чрезвычайно талантливый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36b810c5-0e84-421c-bdf8-b1c8019e99e1",
                                "sense_id": "6933cae1-6fdb-343a-85a6-5dd561ed1ae1",
                                "text": "Тут, в пещере, высеченной в дикой скале, поставлен её заботливой рукой памятник, под которым покоится прах высокоталантливого человека."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22bfe8a7-06ca-4daf-9071-1218ea822f62",
                        "source_entry_id": "c83b1e42-6efe-3e44-9e3f-c8fa7324f690",
                        "source_sense_id": "6933cae1-6fdb-343a-85a6-5dd561ed1ae1",
                        "target_lang_word": "highly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "highly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "972ec5d3-7ebc-3a4b-9e78-0d5b7281cd3f",
                                        "entry_id": "2c2101c1-929d-3a7f-b513-4289ad20c1af",
                                        "glosses": [
                                            "In a high or esteemed manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a9566f3-6e08-4ca7-9d55-708ca1b50b43",
                                                "sense_id": "972ec5d3-7ebc-3a4b-9e78-0d5b7281cd3f",
                                                "text": "He spoke highly of you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                        "entry_id": "2c2101c1-929d-3a7f-b513-4289ad20c1af",
                                        "glosses": [
                                            "Extremely; greatly; very much."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01ee1f4e-b78e-4dc7-a387-9cf4039fb45e",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "He is in a highly visible job."
                                            },
                                            {
                                                "example_id": "5a0826b4-0abc-4585-b96c-9019b2698eb6",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "The book was highly controversial yet sold unbelievably well."
                                            },
                                            {
                                                "example_id": "337e5178-3406-45b2-a5a6-96edd439480b",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "There are those who value a seat sufficiently highly that they prefer to make their daily journeys by the Western Region Vine Street line."
                                            },
                                            {
                                                "example_id": "723f4fdf-51cb-4e27-9b38-cb754c8af5e5",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, and individual plants are highly heterozygous and do not breed true. In addition, we are looking for rare alleles, so the more plants we try, the better."
                                            },
                                            {
                                                "example_id": "10075024-0d30-4850-ba81-5d58a7b4bc01",
                                                "sense_id": "cc337a98-e529-37c8-bde4-406b8cc55e2d",
                                                "text": "The highly anticipated all-American matchup between Taylor Fritz and Frances Tiafoe — marking the first US Open semifinals between two US men in nearly 20 years — will cost you quite a few Honey Deuces to attend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
