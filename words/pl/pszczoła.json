                    "frequency": "Middle",
                    "semantic_group_id": "owady",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie wszystkie gatunki <w>pszczół</w> zostały udomowione przez człowieka."
                        },
                        {
                            "text": "Naukowcy badają zachowania różnych gatunków należących do rodzaju <w>pszczoła</w>."
