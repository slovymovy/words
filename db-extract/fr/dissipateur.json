                    {
                        "form_id": "55a4705c-ffaf-4547-95b5-96190bc8bf49",
                        "entry_id": "22a3f964-dd81-3b5e-b943-afecc7cbdd26",
                        "tags": [
                            "feminine"
                        ],
                        "form": "dissipatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a37d3550-1a54-3fb5-8902-c0b73d9e596b",
                        "entry_id": "22a3f964-dd81-3b5e-b943-afecc7cbdd26",
                        "glosses": [
                            "Celui qui dépense beaucoup, avec prodigalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecdbbdb2-825d-4a59-9859-3280dd21a437",
                                "sense_id": "a37d3550-1a54-3fb5-8902-c0b73d9e596b",
                                "text": "Sa conception financière portait le cachet du talent qui guide les dissipateurs et les gens passionnés dans les fondrières, où tant d’accidents les font périr."
                            },
                            {
                                "example_id": "95b4d8bc-fd40-48d0-a2a6-3a5079a2e141",
                                "sense_id": "a37d3550-1a54-3fb5-8902-c0b73d9e596b",
                                "text": "Mon Dieu ! je quitterais la France avec moins de regrets si j’y laissais un homme aux yeux de qui je ne serais ni un demi-fripon, ni un dissipateur, ni un homme à illusions."
                            }
                        ]
                    },
                    {
                        "sense_id": "9189bfc8-6136-3664-ac26-3fe72599f598",
                        "entry_id": "22a3f964-dd81-3b5e-b943-afecc7cbdd26",
                        "glosses": [
                            "Appareil qui dissipe de l’énergie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6e374aa-5160-49ce-a460-fff07016463a",
                                "sense_id": "9189bfc8-6136-3664-ac26-3fe72599f598",
                                "text": "Les dissipateurs d'énergie peuvent être de deux types: coussin d’eau ou bassin d’amortissement noyé, et bassin d’amortissement avec contre-barrage."
                            }
                        ]
                    }
                ],
