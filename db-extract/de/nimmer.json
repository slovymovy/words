                                "sense_id": "90158ef4-d6b1-3561-9f7a-94f625df2894",
                                "text": "Liegt der Bauer tot im Zimmer, lebt er nimmer.",
                                "translation": "If the farmer lies dead in his room, he's alive no more.",
                                "english": "If the farmer lies dead in his room, he's alive no more."
                            }
                        ]
                    }
