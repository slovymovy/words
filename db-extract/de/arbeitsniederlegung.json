                    },
                    {
                        "translation_id": "5e789a86-226d-4261-a6d4-a42f2ed16bbb",
                        "source_entry_id": "1e13dc80-d714-3c05-b658-31e9ec9e149d",
                        "source_sense_id": "2d47573d-db8b-3890-a216-2ac6e49efeef",
                        "source_sense_description": "Weigerung von Arbeitnehmern, ihre Arbeit zu verrichten",
                        "target_lang_word": "cessation de travail",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b99573c6-a1b1-42c8-9e23-0a50af17b3eb",
                        "source_entry_id": "1e13dc80-d714-3c05-b658-31e9ec9e149d",
                        "source_sense_id": "2d47573d-db8b-3890-a216-2ac6e49efeef",
                        "source_sense_description": "Weigerung von Arbeitnehmern, ihre Arbeit zu verrichten",
                        "target_lang_word": "arrêt de travail",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arrêt de travail",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db3dfb5c-ef61-3541-8cd7-2b4dc011d226",
                                        "entry_id": "dcb24e18-19ce-3876-b7fe-9ae47514ca6c",
                                        "glosses": [
                                            "Suspension du contrat de travail, par suite d’un accident du travail, d’une grève ou d’un arrêt maladie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d35f20-2475-4fac-84a1-b53b2536514f",
                                                "sense_id": "db3dfb5c-ef61-3541-8cd7-2b4dc011d226",
                                                "text": "La prescription d’arrêt de travail est un acte médical à part entière. L’analyse des symptômes ou le diagnostic de la maladie ne suffit pas toujours à prendre une décision adaptée."
                                            },
                                            {
                                                "example_id": "90495413-93f0-460d-a10b-762e50db6eb4",
                                                "sense_id": "db3dfb5c-ef61-3541-8cd7-2b4dc011d226",
                                                "text": "La Dʳᵉ Galarneau a reconnu que les équipes travaillent à effectifs réduits, alors que plusieurs membres du personnel sont en arrêt de travail. La pression est forte sur ceux qui restent."
                                            },
                                            {
                                                "example_id": "42fc00ba-df85-4488-b45e-0a7bf417c385",
                                                "sense_id": "db3dfb5c-ef61-3541-8cd7-2b4dc011d226",
                                                "text": "Ceux qui ont tendance à se suraffirmer au détriment de leurs équipes engendrent souvent démotivation, procrastination, absence de remontées du terrain, rébellions, arrêts de travail fréquents, démissions, burn-out, voire pire."
                                            },
                                            {
                                                "example_id": "30d48fac-3511-4dbf-8e26-10928f8644bf",
                                                "sense_id": "db3dfb5c-ef61-3541-8cd7-2b4dc011d226",
                                                "text": "Le médecin m’examina et s’alarma de ma faiblesse, il me prescrivit des médicaments pour une forme sérieuse d’arthrose, des antidépresseurs, des anxiolytiques, des vitamines. Il me fit un arrêt de travail qui courait sur plusieurs mois, en m’enjoignant à l’envoyer à mon employeur pour signifier un congé de longue maladie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
