                        "glosses": [
                            "Clitoris créé ou reconstruit par chirurgie plastique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93482641-a0c6-4d44-8ed9-fbf21b94feb9",
                                "sense_id": "f134748b-f032-3984-bc6d-6e890bae8578",
                                "text": "Et l’attention porte sur la préservation des sensations, le « néo-clitoris » étant vascularisé de façon à « toujours remplir son rôle érogène »."
                            },
                            {
                                "example_id": "ac593f36-50d5-4a85-9f1c-05c2493d886a",
                                "sense_id": "f134748b-f032-3984-bc6d-6e890bae8578",
                                "text": "Une partie du gland est réséquée, et la partie restante est pédiculisée sur une partie du corps spongieux, en respectant la vascularisation et l’innervation. Le corps spongieux restant est plicaturé afin de fixer le néo-clitoris en position anatomique."
                            }
                        ]
                    }
