                "senses": [
                    {
                        "sense_id": "44935381-3c31-305e-9602-02b4a7cf83e3",
                        "entry_id": "98f621ea-ddc3-3884-85e8-4995d3546fef",
                        "glosses": [
                            "plötzlicher, starker Schmerz, die von einer spastischen Kontraktion eines Hohlorgans hervorgerufen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24e93241-c1ab-4579-9d98-d20e8aab9825",
                                "sense_id": "44935381-3c31-305e-9602-02b4a7cf83e3",
                                "text": "Der Arzt diagnostizierte eine Kolik."
                            },
                            {
                                "example_id": "4e248679-857b-404e-b01a-140e45376586",
                                "sense_id": "44935381-3c31-305e-9602-02b4a7cf83e3",
                                "text": "„Er hatte weitere Zähne verloren, und Woche für Woche plagten ihn Koliken.“"
                            },
                            {
                                "example_id": "73b12c20-b884-4d9f-aed1-fe991897a576",
                                "sense_id": "44935381-3c31-305e-9602-02b4a7cf83e3",
                                "text": "„Im Handumdrehen war ich ausgezogen, weckte mit durchdringendem Geschrei meinen Soldaten und befahl ihm, den Wundarzt zu holen, denn mir sei von einer Kolik sterbensübel.“"
                            },
                            {
                                "example_id": "fc4f6f71-83b1-4551-8147-e4074ffb58fe",
                                "sense_id": "44935381-3c31-305e-9602-02b4a7cf83e3",
                                "text": "„Aber Bouvards Koliken wurden immer schlimmer, und Germaine holte den Arzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fde458d4-4782-4659-bd34-704e3ff76f56",
