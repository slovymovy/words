                "senses": [
                    {
                        "sense_id": "35d29cba-012a-365b-9848-81179c19684e",
                        "entry_id": "d07f0b79-6c4b-3271-9243-ba446cb1f1a0",
                        "glosses": [
                            "хореогр. испанский парный танец, музыкальный размер ¾, сопровождаемый гитарой, барабаном, кастаньетами и пением танцующих"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65a37031-becb-4928-a4f1-7be17e90ce35",
                                "sense_id": "35d29cba-012a-365b-9848-81179c19684e",
                                "text": "Народ же обыкновенно танцует фанданго, болеро и сегидилью."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ea6b8e5-dbf3-37d6-a6a6-2bf9e3211e17",
                        "entry_id": "d07f0b79-6c4b-3271-9243-ba446cb1f1a0",
                        "glosses": [
                            "короткая облегающая безрукавка без застёжки, часть национального костюма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b9176e0-94c7-41e8-a10f-fd0aba4980f6",
                                "sense_id": "4ea6b8e5-dbf3-37d6-a6a6-2bf9e3211e17",
                                "text": "Маленькое болеро с большими отворотами из зелёной тафты."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9f044d4-5adf-4e67-952f-3329058a210a",
                        "source_entry_id": "d07f0b79-6c4b-3271-9243-ba446cb1f1a0",
                        "source_sense_description": "танец",
                        "target_lang_word": "bolero",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bolero",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97ce648b-2287-31c6-8661-ac4c00608dc2",
                                        "entry_id": "17988fca-d00c-3ae5-aaa9-8a0ff8604c09",
                                        "glosses": [
                                            "A lively Spanish dance in 3/4 time; also an unrelated slower-tempo dance of Cuban origin, in 2/4 time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f7c8278-45d6-4191-be41-5c647ccf5c21",
                                                "sense_id": "97ce648b-2287-31c6-8661-ac4c00608dc2",
                                                "text": "Edward's attention was at first rivetted on two dancers engaged in their graceful national dance, the bolero. What a blessing to a people is a climate that encourages out-of-door amusement!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d79a87c6-e1d4-3277-8fed-d2cf1752c21d",
                                        "entry_id": "17988fca-d00c-3ae5-aaa9-8a0ff8604c09",
                                        "glosses": [
                                            "A type of short, buttonless jacket or blouse, open or tied in front and ending at the diaphragm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fd0745d-6747-4d1e-a921-779de808bdf1",
                                                "sense_id": "d79a87c6-e1d4-3277-8fed-d2cf1752c21d",
                                                "text": "He took the bolero, which was made of soft angora, and rubbed it up and down his cheek."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bolero",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8afa3ed8-ebb3-3296-badb-df1fad2af69f",
                                        "entry_id": "7065c940-f66e-34a4-974d-f8a54b7f3752",
