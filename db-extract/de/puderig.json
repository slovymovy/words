                ],
                "senses": [
                    {
                        "sense_id": "130054bd-3286-3f5f-975a-f12e68445b63",
                        "entry_id": "40e4fc49-76cd-3cd6-86ba-4b7b1dee2f3a",
                        "glosses": [
                            "von pulverartiger Beschaffenheit; von sehr feiner Konsistenz; wie Puder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5f4a173-02e1-4923-b33c-cf4294fa0ce4",
                                "sense_id": "130054bd-3286-3f5f-975a-f12e68445b63",
                                "text": "„Der Schnee auf dem Dach rauschte hinab und verteilte sich puderig über die schwarzen Polster im Wagen.“"
                            },
                            {
                                "example_id": "5f313e3c-9224-413e-8610-914d3488056f",
                                "sense_id": "130054bd-3286-3f5f-975a-f12e68445b63",
                                "text": "„Schnee und Eis sehen mal puderig, mal glasiert, mal festgebacken und mal wässrig aus.“"
                            },
                            {
                                "example_id": "dfdd99ce-3940-490c-bc86-bf7d5ac13c26",
                                "sense_id": "130054bd-3286-3f5f-975a-f12e68445b63",
                                "text": "„Der puderig feine, weiße Sand brannte unter ihren Füßen, und sie beeilte sich, die große Decke zu erreichen, die sie am Strand ausgebreitet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
