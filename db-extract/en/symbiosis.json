                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2122c24-551e-4d36-ac81-7ccdfc1add28",
                        "source_entry_id": "5ac8fd00-fba9-3c5c-ae9c-21fc8051517a",
                        "source_sense_description": "relationship of mutual benefit",
                        "target_lang_word": "symbiose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "symbiose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d8fff5e-7136-3d19-bd67-de1117fa96bc",
                                        "entry_id": "8aeec766-d7af-354a-8169-149c6894e31c",
                                        "glosses": [
                                            "Association obligatoire de deux ou de plusieurs organismes différents, les symbiotes, avec bénéfice réciproque et qui leur permet de vivre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "067c9efa-6033-4804-bb21-4d3f45f10bec",
                                                "sense_id": "7d8fff5e-7136-3d19-bd67-de1117fa96bc",
                                                "text": "La symbiose est une association indissoluble et durable entre deux espèces dont chacune tire bénéfice."
                                            },
                                            {
                                                "example_id": "afc231dd-ae33-47f0-b072-268d66d8a95d",
                                                "sense_id": "7d8fff5e-7136-3d19-bd67-de1117fa96bc",
                                                "text": "C'est à ces deux derniers effets de l’AIA que nous nous intéresserons principalement ici puisqu'ils concernent les racines, siège de la symbiose mycorhizienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "486d91e7-21f0-38c0-a666-3f6731ef82b7",
                                        "entry_id": "8aeec766-d7af-354a-8169-149c6894e31c",
                                        "glosses": [
                                            "Relation étroite et harmonieuse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2942f9c7-2e82-45b4-87ab-d34fb69ca359",
                                                "sense_id": "486d91e7-21f0-38c0-a666-3f6731ef82b7",
                                                "text": "Nous devons tenter de vivre en symbiose avec la nature !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f429fb43-c021-41fb-98bc-c72bc1cdc7c4",
                        "source_entry_id": "5ac8fd00-fba9-3c5c-ae9c-21fc8051517a",
                        "source_sense_description": "relationship of mutual benefit",
                        "target_lang_word": "Symbiose",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Symbiose",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2694503-0a7e-3a07-ab1a-460866db8f24",
                                        "entry_id": "7aec0774-bcf5-35cb-9d10-1de267e157fa",
                                        "glosses": [
                                            "Zusammenleben von Organismen verschiedener Arten zu gegenseitigem Vorteil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "310d7a17-651f-4a6d-a3ef-f1b0d4891380",
                                                "sense_id": "c2694503-0a7e-3a07-ab1a-460866db8f24",
                                                "text": "Dieser zeigte, daß es die Milliarden Bazillen sind, welche die Symbiose mit gewissen Hülsenfrüchten den Stickstoff der Luft unmittelbar den Pflanzen zum Aufbau verschaffen."
                                            },
                                            {
                                                "example_id": "44885334-2d3a-4e51-9603-78ba2490ab07",
                                                "sense_id": "c2694503-0a7e-3a07-ab1a-460866db8f24",
                                                "text": "Flechten sind eine Symbiose aus Algen und Pilzen."
                                            },
                                            {
                                                "example_id": "60322b45-ed73-44a9-a723-e3d331ffd407",
                                                "sense_id": "c2694503-0a7e-3a07-ab1a-460866db8f24",
                                                "text": "„Während der letzten Wochen hatte jeder von uns beiden ohne den anderen auskommen müssen, darunter hatte die frühere Symbiose gelitten.“"
                                            },
                                            {
                                                "example_id": "f250984c-1bf3-4b00-8afc-67778e291a5d",
                                                "sense_id": "c2694503-0a7e-3a07-ab1a-460866db8f24",
                                                "text": "„Er hat sich in sie nicht verliebt, aber ist mit ihr in etwas wie eine Symbiose eingetreten.“"
                                            },
                                            {
                                                "example_id": "f1658994-ee4f-4498-9a4c-ece81c5d8bdd",
                                                "sense_id": "c2694503-0a7e-3a07-ab1a-460866db8f24",
                                                "text": "„Ein Vertrauensverhältnis entwickelt sich, fast eine Symbiose.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4897a3f9-c51a-318c-b6cc-fd571dc846bb",
                                        "entry_id": "7aec0774-bcf5-35cb-9d10-1de267e157fa",
                                        "glosses": [
                                            "das Zusammenwirken von mehreren Faktoren, die sich vielfach gegenseitig begünstigen"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87caece6-7cc5-4d59-908d-21c6ad9d0e57",
                                                "sense_id": "4897a3f9-c51a-318c-b6cc-fd571dc846bb",
                                                "text": "Hier aber war's die Sonne, die betäubende Symbiose von Fäulnis und Pracht, der Atem des Verlangens, der Duft und Gestank der Wollust, der laszive Wille der allgemeinen Hingabe, die das Blut würzig, überleicht und sprengkräftig machten, daß es wie ein glühendes rotes Gas durch die Adern pfiff."
                                            },
                                            {
                                                "example_id": "f17f0950-1e81-412a-a8c3-258cbac1d36d",
                                                "sense_id": "4897a3f9-c51a-318c-b6cc-fd571dc846bb",
                                                "text": "Vielleicht über die juristisch gewundene Form der Belehrung mit »bezüglich« und »Handhabung«, vielleicht über den dozierenden Ton, mit dem eine Anstalt in Schutz genommen wurde, die ihr blutloses Scheinleben außer in verstaubten Pandekten nur noch in den Köpfen von Männern führte, die aus Buchstaben Begriffe zusammenleimten, mit denen sie dann eine gespenstische Symbiose eingingen."
                                            },
                                            {
                                                "example_id": "61c45d36-c303-43e2-a213-7e4e5aed59c8",
                                                "sense_id": "4897a3f9-c51a-318c-b6cc-fd571dc846bb",
                                                "text": "„Ein Gefühl von Stabilität und Vertrauen in ihre Selbstständigkeit wurde ihr kaum vermittelt - wie auch, angesichts der vielen familiären Verlusterfahrungen, die nur in der Symbiose zu bewältigen zu sein schienen.“"
                                            },
                                            {
                                                "example_id": "a961fdf8-97c2-46b8-8fcc-7e0fc8c53272",
                                                "sense_id": "4897a3f9-c51a-318c-b6cc-fd571dc846bb",
                                                "text": "„Aus der alten Symbiose kann nur er sich trennen, die Mutter nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
