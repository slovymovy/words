                "senses": [
                    {
                        "sense_id": "facf290e-0ec3-3430-ada8-0916ee01fd32",
                        "entry_id": "9a1d8909-a6b9-3923-b479-73c825011c5b",
                        "glosses": [
                            "Cabinet d’aisance ; WC ; toilettes."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "a1628692-a444-4015-8de0-af558afd5fa3",
                                "sense_id": "facf290e-0ec3-3430-ada8-0916ee01fd32",
                                "text": "Réveillé 7 h 1/2. Ai été aux chiottes. Recouché."
                            },
                            {
                                "example_id": "8c53f83b-9ae6-4ccc-9457-a63d75cdc8a1",
                                "sense_id": "facf290e-0ec3-3430-ada8-0916ee01fd32",
                                "text": "Ce qui me conduisait à la cuisine était pourtant le contraire du recueillement que je n’ai pas honte d’éprouver aux chiottes."
                            },
                            {
                                "example_id": "32ebd71b-bf03-4f4c-95f9-7e4167748282",
                                "sense_id": "facf290e-0ec3-3430-ada8-0916ee01fd32",
                                "text": "Je cavale aux chiottes, une planche avec un trou hérissé de merde confite, j’ai que le temps, je dégueule tout le paquet, fouaff, et encore, et encore, à m’en arracher les boyaux."
                            },
                            {
                                "example_id": "390804bd-56eb-48ed-a320-28b09242592f",
                                "sense_id": "facf290e-0ec3-3430-ada8-0916ee01fd32",
                                "text": "Maintenant je me rappelle que j’ai de sérieux problèmes avec les chiottes parisiennes."
                            },
                            {
                                "example_id": "95224a24-2854-4a98-9aed-92cad43cf234",
                                "sense_id": "facf290e-0ec3-3430-ada8-0916ee01fd32",
                                "text": "L’intimité n’existe pas pour les Chinois. De la même façon qu’on partage les chiottes, on partage les chambres et la crasse."
                            },
                            {
                                "example_id": "8d050731-2295-4a09-a176-b7a21974db24",
                                "sense_id": "facf290e-0ec3-3430-ada8-0916ee01fd32",
                                "text": "— Je vais aux chiottes et après je t'invite à prendre une binouse pour fêter ça !\n— Il n'est même pas 9 heures ! C'est tôt pour une bière, rétorqua Maya."
                            },
                            {
                                "example_id": "b4a1cf75-fed8-4025-a364-71dc816134d7",
                                "sense_id": "facf290e-0ec3-3430-ada8-0916ee01fd32",
                                "text": "J’avais aussi une représentation à la Monty Python de Dieu le Père dans les cieux, mais mon œuvre préférée, c'était un chien qui coulait un bronze dans les chiottes."
                            }
                        ]
                    }
                ],
