                                                "sense_id": "966f354b-9513-3326-a9ba-fe1fe6fd06a6",
                                                "text": "A esses planos de reconquista e repovoamento, juntam-se os castelhanos, os asturianos e mesmo moçárabes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7a63459-e384-3364-a996-6bff37b1bce9",
                                        "entry_id": "9915decd-d063-3390-93bc-4ba96197945f",
                                        "glosses": [
                                            "conjunto de dialetos românicos falados por essa comunidade (código de língua ISO 639-3: mxi)"
                                        ],
                                        "tags": [],
                                        "examples": [
