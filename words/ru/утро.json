            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f9354a63-e825-3ac7-8878-f37afa0cece7",
                    "sense_definition": "Часть суток, сменяющая ночь и переходящая в день (обычно от рассвета до полудня)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я люблю пить горячий кофе каждое <w>утро</w>.",
                            "target_lang_translations": {
                                "en": "I like drinking hot coffee every <w>morning</w>.",
                                "zh": "我喜欢每天<w>早晨</w>喝杯热咖啡。"
                            }
                        },
                        {
                            "text": "Сегодня было очень холодное и пасмурное <w>утро</w>.",
                            "target_lang_translations": {
                                "en": "Today was a very cold and cloudy <w>morning</w>.",
                                "zh": "今天是一个非常寒冷且阴沉的<w>早晨</w>。"
                            }
                        },
                        {
                            "text": "Мы договорились встретиться завтра рано <w>утром</w>.",
                            "target_lang_translations": {
                                "en": "We agreed to meet early tomorrow <w>morning</w>.",
                                "zh": "我们约好明天<w>早晨</w>早点见面。"
                            }
                        }
                    ],
                    "antonyms": [
                        "вечер"
                    ],
                    "common_phrases": [
                        "доброе утро",
                        "раннее утро",
                        "каждое утро",
                        "с утра",
                        "к утру"
                    ],
                    "target_lang_definitions": {
                        "en": "The part of the day from dawn to noon",
                        "zh": "一天中从日出到中午的时间段"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "morning",
                                "target_lang_sense_clarification": "time of day"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "早晨",
                                "target_lang_sense_clarification": "指清晨时分"
                            },
                            {
                                "target_lang_word": "早上",
                                "target_lang_sense_clarification": "指早晨到上午的时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1792d81-ca62-3d06-8f86-fd5759b4c7db",
                    "sense_definition": "Начало, ранняя стадия развития чего-либо (переносное значение)",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Юность часто называют <w>утром</w> человеческой жизни.",
                            "target_lang_translations": {
                                "en": "Youth is often called the <w>morning</w> of human life.",
                                "zh": "青春常被称为人生的<w>黎明</w>。"
                            }
                        },
                        {
                            "text": "Это было <w>утро</w> новой эры в развитии технологий.",
                            "target_lang_translations": {
                                "en": "It was the <w>dawn</w> of a new era in technology development.",
                                "zh": "这是技术发展新时代的<w>黎明</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "весна"
                    ],
                    "antonyms": [
                        "закат"
                    ],
                    "common_phrases": [
