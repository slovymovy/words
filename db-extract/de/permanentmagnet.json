                "senses": [
                    {
                        "sense_id": "f55e70cd-eea4-3fd8-b0f4-802f5b721417",
                        "entry_id": "4f96b3fe-1fd4-31fd-820c-33375d4bcc26",
                        "glosses": [
                            "Material, das ohne Zufuhr von Energie seine magnetischen Eigenschaften (sein Magnetfeld) beibehält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5c99fda-7338-4fa2-a92a-709482e8a7ef",
                                "sense_id": "f55e70cd-eea4-3fd8-b0f4-802f5b721417",
                                "text": "„Direkt darunter residiert der metallfarbene Permanentmagnet-Elektromotor.“"
                            },
                            {
                                "example_id": "dd8c8c98-7bde-435a-bfe0-f2ef3fa87db4",
                                "sense_id": "f55e70cd-eea4-3fd8-b0f4-802f5b721417",
                                "text": "„Allein von den für Permanentmagnete wichtigen und als knappe Ressource eingestuften Elementen Neodym und Praseodym könnten aus dem Fen Carbonatite Complex mindestens 1,5 Millionen Tonnen gefördert werden, so die vorläufige Abschätzung.“"
                            }
                        ],
