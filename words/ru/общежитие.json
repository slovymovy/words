                {
                    "sense_id": "b7430cbb-2896-35b2-bbef-ae5ff6fa7d8c",
                    "sense_definition": "Здание или помещение с комнатами для временного проживания студентов, сотрудников предприятия или приезжих.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой брат живёт в студенческом <w>общежитии</w> недалеко от университета.",
                            "target_lang_translations": {
                                "en": "My brother lives in a student <w>dormitory</w> not far from the university.",
                                "pl": "Mój brat mieszka w <w>akademiku</w> niedaleko uniwersytetu."
                            }
                        },
                        {
                            "text": "Получить место в <w>общежитии</w> оказалось сложнее, чем мы думали.",
                            "target_lang_translations": {
                                "en": "Getting a place in the <w>dormitory</w> turned out to be harder than we thought.",
                                "pl": "Zdobycie miejsca w <w>akademiku</w> okazało się trudniejsze, niż myśleliśmy."
                            }
                        }
                    ],
                    "synonyms": [
                        "обща́га"
                    ],
                    "common_phrases": [
                        "студенческое общежитие",
                        "жить в общежитии",
                        "место в общежитии",
                        "комната в общежитии"
                    ],
                    "target_lang_definitions": {
                        "en": "A building providing accommodation for a large number of people, such as students or workers, usually with shared facilities.",
                        "pl": "Budynek lub pomieszczenie z pokojami przeznaczonymi do tymczasowego zamieszkania przez studentów, pracowników lub osoby przyjezdne."
                    },
                    "translations": {
