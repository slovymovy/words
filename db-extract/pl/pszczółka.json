                    {
                        "translation_id": "e03f4abf-ca09-4476-9b56-81440879ca45",
                        "source_entry_id": "4683af7b-0dec-3a64-af40-f2abd2bd8a91",
                        "source_sense_id": "6b5ff8ed-6afa-317e-b9d1-f1a69048d2a9",
                        "target_lang_word": "Bienchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bienchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67f2d489-94cc-36b3-a4de-0907772bb4a6",
                                        "entry_id": "e793717d-580f-3e7a-aae1-56c95670b08a",
                                        "glosses": [
                                            "kleine Biene"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "512ad1f7-d0b0-4b3e-aae9-abb525e778e9",
                                                "sense_id": "67f2d489-94cc-36b3-a4de-0907772bb4a6",
                                                "text": "Summ, summ, summ, Bienchen summ herum, … (ein Kinderlied)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "78d43b70-d239-31e6-8ba5-68c8b7eb5924",
                                        "entry_id": "e793717d-580f-3e7a-aae1-56c95670b08a",
                                        "glosses": [
                                            "Stempel in Form einer Biene als Belohnung für junge Schüler; Zeichen für gute Leistung"
                                        ],
                                        "tags": [
                                            "DDR"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f2cbad4-72a0-4a1d-9e04-632dddcea202",
                                                "sense_id": "78d43b70-d239-31e6-8ba5-68c8b7eb5924",
                                                "text": "„Das „Bienchen“ galt in der Schule als Symbol für gute Leistungen.“"
                                            },
                                            {
                                                "example_id": "be5f7c46-c14b-437b-854e-4e5426392d67",
                                                "sense_id": "78d43b70-d239-31e6-8ba5-68c8b7eb5924",
                                                "text": "„Wir hatten andere Träume. Ein paar Jahre Ausbildung und dann weg, vielleicht Verkäuferin oder Krippenerzieherin oder Sportstudium. Aber wir blieben in der Spinne. Wir mussten Bienchen sammeln für Erichen.“ (Erichen = Erich Honecker)"
                                            },
                                            {
                                                "example_id": "1fbdb309-4d65-446d-bb31-c1f28e08e02f",
                                                "sense_id": "78d43b70-d239-31e6-8ba5-68c8b7eb5924",
                                                "text": "„[…], wir müssen Bienchen sammeln für Erichen (sie lacht). Sag ich Dir ehrlich, hatten wir immer Punkteprogramm, das mußte geschafft werden, um am Jahresende ausgezeichnet zu werden als sozialistische Brigade.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
