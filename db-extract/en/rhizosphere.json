                    {
                        "translation_id": "a7cacdda-5274-4a57-a8f4-b04947b4c7f6",
                        "source_entry_id": "dfbff8a5-cfaa-3649-af76-ec1e761a2731",
                        "source_sense_id": "f7efcafb-0932-317d-bc91-ca87c2118d78",
                        "source_sense_description": "soil region influenced by plant roots",
                        "target_lang_word": "rhizosphère",
