                                        "glosses": [
                                            "Of or pertaining to the novelist and playwright Samuel Beckett (1906-1989) or his writings, noted for their bleak outlook and minimalism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86be1253-5f1d-4573-8fbd-640b87b0de44",
                                                "sense_id": "3e2acb87-e454-3cd6-9ff1-129e2f67b577",
                                                "text": "The Beckettian progression appears occasionally: while Miss Counihan (static) is an omnivorous reader and Murphy (transitional) a strict non-reader, Cooper is an analphabete."
                                            },
                                            {
                                                "example_id": "7b774ff4-1554-43d4-bc94-2f52a1678160",
                                                "sense_id": "3e2acb87-e454-3cd6-9ff1-129e2f67b577",
                                                "text": "This uncertainty often appears in Beckettian criticism—take the Scrutonian hesitation over Beckett's 'characters (if characters they can be called)', or John Pilling's admission that, in Beckett, character can become an 'impossibly complicated matter'."
                                            }
                                        ]
                                    }
