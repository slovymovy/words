                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81217a31-9f11-4dcf-8daf-66550211305a",
                                                "sense_id": "90b8c26e-0c81-3089-8aba-e3f65751ebad",
                                                "text": "„Der Hofjägermeister hielt eine Rede auf Gott, König und Vaterland der Agrarier, und Onkel Heinrich war gerührt.“"
                                            }
                                        ],
