                        "examples": [
                            {
                                "example_id": "82fdb953-1ec1-4f8b-af14-09d4713416b3",
                                "sense_id": "0c7b9d99-304d-3075-af7e-c0e974fd97c1",
                                "text": "In some eggs the markings are very dense towards the large end, in others they are pretty uniformly distributed over the whole surface; in some they are very minute and speckly, in others they average the tenth of an inch in diameter."
                            },
                            {
                                "example_id": "c39d6585-28dd-4f96-b1ca-556ad21b6c88",
                                "sense_id": "0c7b9d99-304d-3075-af7e-c0e974fd97c1",
                                "text": "The clouds hung unevenly over the climbing mountains, so that far snow-bestrewn headlands looked like the speckly backs of monsters stalking up into the sky."
                            },
                            {
                                "example_id": "09694216-0a03-4a7c-8872-038edfa95a9a",
                                "sense_id": "0c7b9d99-304d-3075-af7e-c0e974fd97c1",
                                "text": "April 3 2010, Huffington Post - Fresh Eggs, Grace, Rebirth, & Popovers\nSometimes they're just brown and speckly; sometimes they're pointy, sometimes petite. But always their yolks are plump and perky and marigold-yellow."
                            }
