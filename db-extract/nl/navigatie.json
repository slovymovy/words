                        ],
                        "examples": [
                            {
                                "example_id": "80318acd-7aa5-43b3-9142-e7ab9bbc9ed2",
                                "sense_id": "e7545dac-5a91-3c5f-bd1e-772a8a8e00e8",
                                "text": "De navigatie op de Middellandse Zee was indertijd zeer intensief."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b128b0b-28f5-32b9-8054-2899e035d8a0",
                        "entry_id": "f2cecf44-e489-37a1-b7c3-b41fa07c8d7d",
                        "glosses": [
                            "het bepalen van de positie (standplaats) en de bepaling van de richting om naar een gewenste positie te gaan"
                        ],
                        "tags": [
                            "ruimtevaart"
                        ],
                        "examples": [
                            {
                                "example_id": "393c0131-9105-4ea0-a11d-7e22c2d34fb2",
                                "sense_id": "6b128b0b-28f5-32b9-8054-2899e035d8a0",
                                "text": "De Atlantis had op z'n ruimtereis ook problemen met de navigatie door computerstoring."
                            }
                        ]
                    },
                    {
                        "sense_id": "90961bc8-a4bf-38d3-8f3b-550d23cab104",
                        "entry_id": "f2cecf44-e489-37a1-b7c3-b41fa07c8d7d",
                        "glosses": [
                            "het via de weg bereiken van een bestemming door middel van elektronische apparatuur en navigatiesatellieten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99247958-7d54-4b60-b99e-e13c9778d0b8",
                                "sense_id": "90961bc8-a4bf-38d3-8f3b-550d23cab104",
                                "text": "Onze chauffeurs beschikken over moderne technieken op het gebied van routeplanning en elektronische navigatie ."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f31d805-b43f-32fd-b7ac-c3b94c039177",
                        "entry_id": "f2cecf44-e489-37a1-b7c3-b41fa07c8d7d",
                        "glosses": [
                            "het vinden van de de weg in een informatiesysteem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bf6d0aa-52e4-45fc-bf23-93d8db62e02e",
                                "sense_id": "7f31d805-b43f-32fd-b7ac-c3b94c039177",
                                "text": "De nieuwe software maakt de navigatie op onze site stukken eenvoudiger."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e017786a-0949-46a0-bc01-8030eb744477",
                        "source_entry_id": "f2cecf44-e489-37a1-b7c3-b41fa07c8d7d",
                        "target_lang_word": "Navigation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
