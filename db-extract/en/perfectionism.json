                        "cross_references": [
                            {
                                "target_word": "perfectionisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f0495475-c11d-30dc-996e-7de6ae5a8928",
                                        "entry_id": "43bdeb4b-6d1e-310c-89fe-468d95f01f3a",
                                        "glosses": [
                                            "sterke behoefte om dingen volgens hoge standaarden foutloos te doen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5febf77a-72c7-4fe8-8494-1431e10fe5ce",
                                                "sense_id": "f0495475-c11d-30dc-996e-7de6ae5a8928",
                                                "text": "Volgens Matsumoto is schoonmaken heilzaam. „Van schoonmaken leer je perfectionisme overwinnen. Als je schoonmaakt met een bezem, en je ziet na het schoonmaken dat er een blaadje valt, wat dan? Je moet dat leren aanvaarden, dat doe ik iedere dag.”"
                                            },
                                            {
                                                "example_id": "32e5d57e-1106-4041-9141-b4dc9ead06b3",
                                                "sense_id": "f0495475-c11d-30dc-996e-7de6ae5a8928",
                                                "text": "Om het succes toe te lichten van de Duitse economie in crisistijd, beginnen we onder begeleiding door Wagner in de ‘glazen fabriek’ van Dresden waar Volkswagen met punctualiteit en perfectionisme zijn Phaetons in elkaar zet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8761bc1e-543f-3f87-8309-b545ab25e1bb",
                                        "entry_id": "43bdeb4b-6d1e-310c-89fe-468d95f01f3a",
                                        "glosses": [
                                            "leer die als kern heeft dat je in het leven zo goed mogelijk aan een bepaald hoger beginsel moet voldoen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e7f5b13-ce8d-42db-a04c-f67385b6da87",
                                                "sense_id": "8761bc1e-543f-3f87-8309-b545ab25e1bb",
                                                "text": "Enerzijds is er de geest van vernieuwing, die poogt het verloren contact met de wereld te herstellen, anderzijds een streven naar een geestelijk perfectionisme, dat zich wil opsluiten in een kring van zeloten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5c12311-30b3-36c0-abf4-ec3a38dacd6b",
                                        "entry_id": "43bdeb4b-6d1e-310c-89fe-468d95f01f3a",
                                        "glosses": [
                                            "overtuiging dat het al tijdens het leven op aarde mogelijk is om van alle zonden verlost te worden, die in de 19e eeuw opgang maakte in de Verenigde Staten"
                                        ],
                                        "tags": [
                                            "protestant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b2410f5-9968-4bef-b123-318d8fa674eb",
                                                "sense_id": "a5c12311-30b3-36c0-abf4-ec3a38dacd6b",
                                                "text": "Zijn oordeel over de Protestanten (‘met hun perfectionistische theorieën’) is meer van toepassing op de geestelijke situatie in Amerika dan op die van Europa; het Amerikaanse Protestantisme wordt voor een groot deel beheerst door een perfectionisme, dat van de secten uit de Hervormingstijd en van de Renaissance en de Aufklärung is overgeërfd."
                                            },
                                            {
                                                "example_id": "131f682a-edf8-430d-aed9-03f2c805c2d8",
                                                "sense_id": "a5c12311-30b3-36c0-abf4-ec3a38dacd6b",
                                                "text": "⧖ In de volkskerken heeft ieder individu zijn eigen belijdenis. Van naturalisme tot perfectionisme, van darbisme tot katholicisme, van brave Hendriks-geloof tot antinominianery, gij vindt dat alles in de hedendaagsche volkskerk in vollen bloei."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8915800b-db96-4d4b-af68-cea679c26ded",
                        "source_entry_id": "9f20197b-eac4-3869-af5e-9d43daae1428",
                        "source_sense_description": "unwillingness to settle for anything less than perfection",
                        "target_lang_word": "perfectionnisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
