                "senses": [
                    {
                        "sense_id": "c2629025-51f0-3e0d-a14a-553157433435",
                        "entry_id": "25c2747d-7fff-3391-9d0d-8472fcb40cc8",
                        "glosses": [
                            "Redonner un caractère puritain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "542192c2-5b57-44d6-aa24-6c2ccff11a92",
                                "sense_id": "c2629025-51f0-3e0d-a14a-553157433435",
                                "text": "Mais on peut pardonner ce qui serait un harcèlement sexuel intolérable, dans l’Amérique « repuritanisée » d’aujourd’hui, à une France où l’on sait bien que le cul est culturel."
                            },
                            {
                                "example_id": "4316fb50-6f87-4f3c-bfcc-c73e0c36012e",
                                "sense_id": "c2629025-51f0-3e0d-a14a-553157433435",
                                "text": "En Angleterre, c’est une lente tombée de Byron en discrédit dans une société utilitaire et repuritanisée, au moins extérieurement."
                            }
                        ]
                    }
