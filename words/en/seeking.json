{
    "word_family": [
        "seek",
        "seeker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70df66f4-1ac4-3992-b365-888cf8b8dff7",
                    "sense_definition": "Present participle and gerund of <w>seek</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is currently <w>seeking</w> new employees for the sales department.",
                            "target_lang_translations": {
                                "ru": "Компания в настоящее время <w>ищет</w> новых сотрудников в отдел продаж.",
                                "cs": "Společnost v současnosti <w>hledá</w> nové zaměstnance pro obchodní oddělení."
                            }
                        },
                        {
                            "text": "He is <w>seeking</w> advice from a financial expert before investing his money.",
                            "target_lang_translations": {
                                "ru": "Он <w>ищет</w> совета у финансового эксперта, прежде чем инвестировать свои деньги.",
                                "cs": "Před investicí svých peněz <w>hledá</w> radu u finančního experta."
                            }
                        }
                    ],
                    "synonyms": [
                        "searching",
                        "pursuing",
                        "looking for"
                    ],
                    "common_phrases": [
                        "seeking employment",
                        "seeking help",
                        "seeking asylum",
                        "seeking advice"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>seek</w>.",
                        "cs": "Přítomné příčestí a gerundium slovesa 'seek' (hledat)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ищущий",
                                "target_lang_sense_clarification": "причастие: тот, кто ищет"
                            },
                            {
                                "target_lang_word": "стремящийся",
                                "target_lang_sense_clarification": "причастие: тот, кто добивается чего-либо"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "hledající",
                                "target_lang_sense_clarification": "příčestí: ten, kdo hledá"
                            },
                            {
                                "target_lang_word": "usilující",
                                "target_lang_sense_clarification": "příčestí: ten, kdo se o něco snaží"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94c6c8d8-2012-3e00-8fe4-3d2a1ff7ca64",
                    "sense_definition": "The act of searching for something or a quest to find a specific thing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His lifelong <w>seeking</w> of knowledge led him to read thousands of books.",
                            "target_lang_translations": {
                                "ru": "Его пожизненный <w>поиск</w> знаний побудил его прочитать тысячи книг.",
                                "cs": "Jeho celoživotní <w>hledání</w> vědomostí ho vedlo k přečtení tisíců knih."
                            }
                        },
                        {
                            "text": "The constant <w>seeking</w> of approval from others can be detrimental to self-esteem.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>стремление</w> к одобрению со стороны других может пагубно сказаться на самооценке.",
                                "cs": "Neustálé <w>hledání</w> uznání od ostatních může být škodlivé pro sebevědomí."
                            }
                        }
                    ],
                    "synonyms": [
                        "search",
                        "quest",
                        "pursuit",
                        "hunt"
                    ],
                    "common_phrases": [
                        "seeking of truth",
                        "attention seeking",
                        "rent seeking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по поиску чего-либо или стремление найти определенную вещь.",
                        "cs": "Akt hledání něčeho nebo úsilí o nalezení určité věci."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поиск",
                                "target_lang_sense_clarification": "процесс разыскивания"
                            },
                            {
                                "target_lang_word": "стремление",
                                "target_lang_sense_clarification": "настойчивое желание достичь чего-либо"
                            },
                            {
                                "target_lang_word": "искание",
                                "target_lang_sense_clarification": "книжное: поиск, изыскание"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "hledání",
                                "target_lang_sense_clarification": "proces pátrání po něčem"
                            },
                            {
                                "target_lang_word": "snaha",
                                "target_lang_sense_clarification": "úsilí o dosažení cíle"
                            },
                            {
                                "target_lang_word": "pátrání",
                                "target_lang_sense_clarification": "intenzivní nebo systematické hledání"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "de644ce0-2138-3d03-82e7-4439dcb9842a",
                    "sense_definition": "Describing someone or something that is actively looking for a specified target or goal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heat-<w>seeking</w> sensor immediately detected the change in temperature.",
                            "target_lang_translations": {
                                "ru": "Тепло<w>наводящийся</w> датчик немедленно обнаружил изменение температуры.",
                                "cs": "Tepelně <w>naváděcí</w> senzor okamžitě detekoval změnu teploty."
                            }
                        },
                        {
                            "text": "She cast a <w>seeking</w> glance around the room, hoping to find a familiar face.",
                            "target_lang_translations": {
                                "ru": "Она бросила <w>ищущий</w> взгляд по комнате, надеясь найти знакомое лицо.",
                                "cs": "Rozhlédla se po místnosti <w>hledajícím</w> pohledem v naději, že uvidí známou tvář."
                            }
                        }
                    ],
                    "synonyms": [
                        "searching",
                        "inquisitive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает кого-то или что-то, что активно ищет указанную цель или объект.",
                        "cs": "Popisuje někoho nebo něco, co aktivně vyhledává určitý cíl."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ищущий",
                                "target_lang_sense_clarification": "выражающий поиск (о взгляде, виде)"
                            },
                            {
                                "target_lang_word": "поисковый",
                                "target_lang_sense_clarification": "предназначенный для поиска"
                            },
                            {
                                "target_lang_word": "наводящийся",
                                "target_lang_sense_clarification": "техническое: ориентирующийся на цель (например, на тепло)"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "hledající",
                                "target_lang_sense_clarification": "vyjadřující hledání (např. pohled)"
                            },
                            {
                                "target_lang_word": "naváděcí",
                                "target_lang_sense_clarification": "technické: zaměřený na cíl (např. tepelně naváděcí)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
