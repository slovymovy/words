                        "cross_references": [
                            {
                                "target_word": "facebooker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81aa899b-3a30-398f-9c2c-6a508828edb7",
                                        "entry_id": "96e648ee-2909-3c02-828d-caa2793485c6",
                                        "glosses": [
                                            "Utilisateur du réseau social Facebook."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b6d4a29-7468-4ded-b3f5-b49d9175df67",
                                                "sense_id": "81aa899b-3a30-398f-9c2c-6a508828edb7",
                                                "text": "D’année en année, l’âge moyen du facebooker croît, passant de 27 ans en 2008 à 44 ans en 2009 aux États-Unis."
                                            },
                                            {
                                                "example_id": "03e4ca9f-1052-45dc-b6ce-185c24233f49",
                                                "sense_id": "81aa899b-3a30-398f-9c2c-6a508828edb7",
                                                "text": "La facebookeuse, blogueuse et twitteuse Nathalie Kosciusko-Morizet s’est trouvé une mission : convertir les parlementaires aux joies de l’Internet participatif."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "facebooker",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f59ce5d-79f6-3bcb-a1c9-2dde1987fd2e",
                                        "entry_id": "a986e6a8-9de8-3aaa-b024-fb16b0357ba3",
                                        "glosses": [
                                            "Utiliser le réseau social Facebook."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c74bcff8-63d6-4a48-b937-b6ccdf393fcc",
                                                "sense_id": "7f59ce5d-79f6-3bcb-a1c9-2dde1987fd2e",
                                                "text": "Pour être branché, il faut facebooker !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb8e73ed-d680-4e1c-a4ab-446db335a22f",
                        "source_entry_id": "a494f73c-f647-3837-87b4-205853a74b98",
                        "source_sense_id": "cf90d7dd-1430-338a-8d0f-a403053012f9",
                        "target_lang_word": "facebookien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "facebookien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0e7cc73-02e2-3954-9ee8-d5f69150803e",
                                        "entry_id": "5a0cf45f-9d19-32ef-aac5-ba358a17417d",
                                        "glosses": [
                                            "Relatif au réseau social Facebook."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1c3d6c0-f6e9-4a69-95b2-cdf4ca1346d6",
                                                "sense_id": "b0e7cc73-02e2-3954-9ee8-d5f69150803e",
                                                "text": "J'adresse un clin d'œil tout particulier à Lili, pour nos discussions facebookiennes, qui m'auront permis de faire avancer certaines idées en les formulant sur le clavier. Merci aussi à Magalie l'Espitalier-Noël."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "facebookien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad1852e5-db03-31ad-afc1-6e772491d952",
                                        "entry_id": "11b25f9c-c4f7-3353-854c-1ce7dce2546a",
                                        "glosses": [
                                            "Utilisateur du réseau social Facebook."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0d7c969-e1c5-41d0-a9b9-7bf208ed87c9",
                                                "sense_id": "ad1852e5-db03-31ad-afc1-6e772491d952",
                                                "text": "Au vu de la consternante banalité des conversations électroniques sur le réseau social, un constat s'impose : le facebookien rejoint dans le néant de l'humain les candidats des émissions de téléréalité. L'exhibitionnisme du vide y triomphe."
                                            },
                                            {
                                                "example_id": "8fbd01c7-bb82-4257-9abe-9e7183ea8910",
                                                "sense_id": "ad1852e5-db03-31ad-afc1-6e772491d952",
                                                "text": "Alors que les twittos et facebookiens accèdent en permanence aux réseaux sociaux et y posent des questions, la commune n'est aujourd'hui organisée que pour y répondre du lundi au vendredi aux heures de bureau !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
