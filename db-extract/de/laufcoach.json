                "senses": [
                    {
                        "sense_id": "68de78b4-60a4-33f1-a73c-5f29fcca9179",
                        "entry_id": "61a3990d-28a0-3afe-b43c-6a880c2bfbb6",
                        "glosses": [
                            "(meist fachkundige oder erfahrene) Person, die Läufer (über einen längeren Zeitraum) beim Training begleitet, unterstützt und ihnen hilft, ihre Laufziele zu erreichen"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "2bd8b93a-c75b-44f1-b175-de077fd5538f",
                                "sense_id": "68de78b4-60a4-33f1-a73c-5f29fcca9179",
                                "text": "„Regelmäßige Trainingsbesprechungen und ständiger Austausch mit Deinem Laufcoach sichern Deinen Erfolg.“"
                            },
                            {
                                "example_id": "49ae9be6-1f23-4372-8c7d-37c1b6cb42de",
                                "sense_id": "68de78b4-60a4-33f1-a73c-5f29fcca9179",
                                "text": "„Wenn Du Schwierigkeiten hast, die richtigen Laufschuhe zu finden oder Dir unsicher bist, welche Laufschuhe gut zu Dir passen, kann es hilfreich sein, sich von einem erfahrenen Läufer oder einem Laufcoach beraten zu lassen.“"
                            },
                            {
                                "example_id": "8c2c94f7-670a-407a-83d0-b3a9ccae0b8e",
                                "sense_id": "68de78b4-60a4-33f1-a73c-5f29fcca9179",
                                "text": "„Persönliche Trainingspläne und ein Laufcoach helfen Ihnen zusätzlich, Ihre Ziele zu erreichen.“"
                            },
                            {
                                "example_id": "d634f4b5-4f7b-4909-bc77-329a0708492f",
                                "sense_id": "68de78b4-60a4-33f1-a73c-5f29fcca9179",
                                "text": "„Bucht mich als Laufcoach.“"
                            },
                            {
                                "example_id": "0d7ba689-afa3-4110-8272-7724a0a176a9",
                                "sense_id": "68de78b4-60a4-33f1-a73c-5f29fcca9179",
                                "text": "„Als professioneller Personal Trainer und Laufcoach ist es meine Leidenschaft, Läufer dabei zu unterstützen ihre persönlichen Ziele zu erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
