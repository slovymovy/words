                ],
                "senses": [
                    {
                        "sense_id": "b5464c4c-471e-3d02-8292-ca88c95e1825",
                        "entry_id": "76eb489f-9de8-394c-9f56-1f06691c268b",
                        "glosses": [
                            "nach einem Prozess übrig gebliebener Stoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad248c44-43ec-4aaa-968c-4b3faf01203d",
                                "sense_id": "b5464c4c-471e-3d02-8292-ca88c95e1825",
                                "text": "„Der Sauerstoff wird über die Lunge aufgenommen und an das Blut weitergeleitet. Gleichzeitig gibt das Blut den Abfallstoff Kohlendioxid wieder an die Lunge ab, die es in den Lungenbläschen zwischenspeichert.“"
                            },
                            {
                                "example_id": "eec10df4-3ba9-420e-a02e-ea2af536f256",
                                "sense_id": "b5464c4c-471e-3d02-8292-ca88c95e1825",
                                "text": "„Das Recycling hochwertiger Abfallstoffe wird, auch wenn der eine oder andere zeitgenössische Politiker gerne als Erfinder dieses Prinzips gelten würde, in der Natur schon seit einigen Milliarden Jahren praktiziert.“"
                            },
                            {
                                "example_id": "490ae22a-bb9f-4806-a44a-bd1156953c1e",
                                "sense_id": "b5464c4c-471e-3d02-8292-ca88c95e1825",
                                "text": "„Wegen ihrer Gefährlichkeit müssen die radioaktiven Abfallstoffe bis zu ihrem radioaktiven Zerfall sicher vom Biozyklus abgeschlossen werden.“"
                            },
                            {
                                "example_id": "8a7fe8fb-3c79-49da-a35b-efda936c2659",
                                "sense_id": "b5464c4c-471e-3d02-8292-ca88c95e1825",
                                "text": "„Die Nieren entfernen Abfallstoffe wie Harnstoff aus dem Blut, aber auch überschüssige Ionen wie Kochsalz oder Phosphate, die in bestimmten Mengen zwar notwendig sind, aber nicht im Übermaß auftreten dürfen.“"
                            },
                            {
                                "example_id": "490df81a-eaee-48f6-a0bf-5748eab1c142",
                                "sense_id": "b5464c4c-471e-3d02-8292-ca88c95e1825",
                                "text": "„Infolge einer Überschätzung der Verdünnungskraft der Meere wurde die Einleitung oder Einbringung von Abwässern und Abfallstoffen lange Zeit als rechtmäßige Nutzung der Gewässer angesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
