{
    "word_family": [
        "listen",
        "listening",
        "listenable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "757cf30a-837e-3981-8060-9f6e479574b0",
                    "sense_definition": "A person who listens, especially to a speech, a musical performance, or a radio broadcast.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radio host thanked every <w>listener</w> for tuning in to the morning show.",
                            "target_lang_translations": {
                                "ru": "Радиоведущий поблагодарил каждого <w>слушателя</w> за то, что они настроились на утреннее шоу."
                            }
                        },
                        {
                            "text": "She is a very good <w>listener</w> who always pays attention when others speak.",
                            "target_lang_translations": {
                                "ru": "Она очень хороший <w>слушатель</w>, который всегда внимателен, когда говорят другие."
                            }
                        }
                    ],
                    "synonyms": [
                        "hearer",
                        "auditor"
                    ],
                    "antonyms": [
                        "speaker",
                        "talker"
                    ],
                    "common_phrases": [
                        "good listener",
                        "radio listener",
                        "active listener",
                        "attentive listener"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который слушает, особенно речь, музыкальное выступление или радиопередачу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слушатель",
                                "target_lang_sense_clarification": "тот, кто воспринимает информацию на слух"
                            },
                            {
                                "target_lang_word": "собеседник",
                                "target_lang_sense_clarification": "в контексте умения слушать другого человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ebaf8b5-bc76-35a9-8621-8bff4253106d",
                    "sense_definition": "A function or piece of code that runs in response to a specific event, such as a mouse click.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer added an event <w>listener</w> to the button to handle user clicks.",
                            "target_lang_translations": {
                                "ru": "Разработчик добавил <w>слушатель</w> событий к кнопке для обработки кликов пользователя."
                            }
                        },
                        {
                            "text": "If the <w>listener</w> is not properly removed, it can cause a memory leak in the application.",
                            "target_lang_translations": {
                                "ru": "Если <w>обработчик</w> не будет удален должным образом, это может привести к утечке памяти в приложении."
                            }
                        }
                    ],
                    "synonyms": [
                        "event handler"
                    ],
                    "common_phrases": [
                        "event listener",
                        "click listener",
                        "add a listener"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Функция или фрагмент кода, который выполняется в ответ на определенное событие, например, щелчок мыши."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слушатель",
                                "target_lang_sense_clarification": "технический термин в программировании"
                            },
                            {
                                "target_lang_word": "обработчик",
                                "target_lang_sense_clarification": "обработчик событий"
                            },
                            {
                                "target_lang_word": "листенер",
                                "target_lang_sense_clarification": "профессиональный жаргон программистов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3271d47-4b71-3a75-821e-fb852ca93304",
                    "sense_definition": "A person's ear.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer landed a heavy blow right against his opponent's left <w>listener</w>.",
                            "target_lang_translations": {
                                "ru": "Боксер нанес тяжелый удар прямо в левое <w>ухо</w> своего противника."
                            }
                        },
                        {
                            "text": "He whispered the secret directly into her <w>listener</w> so no one else could hear.",
                            "target_lang_translations": {
                                "ru": "Он прошептал секрет прямо ей в <w>ухо</w>, чтобы никто другой не услышал."
                            }
                        }
                    ],
                    "synonyms": [
                        "ear"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "archaic boxing slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ухо человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухо",
                                "target_lang_sense_clarification": "орган слуха"
                            },
                            {
                                "target_lang_word": "локатор",
                                "target_lang_sense_clarification": "шутливый или сленговый синоним уха"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}