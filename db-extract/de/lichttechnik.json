                        "sense_id": "5e6d7547-8669-371d-a93e-dbb358c3046e",
                        "entry_id": "54392ee6-2db1-3686-a8f2-608c4b562738",
                        "glosses": [
                            "Fachgebiet, das sich mit Erzeugung, Anwendung und Bewertung (Messung) des Lichtes beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4f38435-571f-4d78-ab5a-2d6ea188bd04",
                                "sense_id": "5e6d7547-8669-371d-a93e-dbb358c3046e",
                                "text": "Die Lichttechnik kennt unterschiedliche Modelle, die die technischen Phänomene der Lichtstrahlung beschreiben."
