                "senses": [
                    {
                        "sense_id": "8f05ffa7-700d-33c6-9a2f-060ebc54a3f7",
                        "entry_id": "428b8ca1-0d41-309d-9c98-f769086c12da",
                        "glosses": [
                            "The quality or characteristic of being blue in color."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "279d83aa-f98d-49d1-ae36-62f3df538487",
                                "sense_id": "8f05ffa7-700d-33c6-9a2f-060ebc54a3f7",
                                "text": "In an atlas, too, the land is man's, and all coloured to show his claim to it — in vivid contrast to the universal independent blueness of the sea."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3310b65-7c68-3cd3-b0b3-bb41a8989778",
                        "entry_id": "428b8ca1-0d41-309d-9c98-f769086c12da",
                        "glosses": [
                            "Melancholy."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
