                "senses": [
                    {
                        "sense_id": "93f62d2f-bed9-3be8-bf4f-045b2fe88ebe",
                        "entry_id": "12d03baf-0d94-34ec-ae9a-e8673987ed6e",
                        "glosses": [
                            "Réseau social distribué de services fédérés utilisant des protocoles de communication ouverts."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "9cd00c06-bd8f-4390-be23-d4a471c9d46a",
                                "sense_id": "93f62d2f-bed9-3be8-bf4f-045b2fe88ebe",
                                "text": "C’est un concept très ancien (il y en avait déjà sur IRC) mais je vais me focaliser ici sur des bots participant au fédivers (également écrit fedivers, fediverse, féediverse, etc)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc29fa75-1dbd-4686-8ada-94cc155cebcb",
                        "source_entry_id": "12d03baf-0d94-34ec-ae9a-e8673987ed6e",
                        "source_sense_id": "93f62d2f-bed9-3be8-bf4f-045b2fe88ebe",
                        "target_lang_word": "Fediverse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fediverse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbea9a99-0aa9-3b01-bdb0-035fc05572a0",
                                        "entry_id": "b8a40c52-7c5a-307b-b32b-6920d6711cd7",
                                        "glosses": [
                                            "The distributed social media network of federated services using open standard communication protocols, especially ActivityPub and historically OStatus."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "187279ea-53ca-4cd5-b8d2-b1f54d76b237",
                                                "sense_id": "dbea9a99-0aa9-3b01-bdb0-035fc05572a0",
                                                "text": "While there is clearly a strong appetite amongst women to move away from the digital giants, Spinster is hardly free from their reach, or indeed from hostile men within the wider Fediverse network."
                                            },
                                            {
                                                "example_id": "abcc9f27-04ab-4f92-b46e-ef99d63366ea",
                                                "sense_id": "dbea9a99-0aa9-3b01-bdb0-035fc05572a0",
                                                "text": "The migration of Gab marked a major test for the Fediverse. Because no one authority controlled the policies of the network, it would be impossible to bar Gab with a single sweeping action, the way centralized social networks such as Facebook or Twitter might."
                                            },
                                            {
                                                "example_id": "fb98d1c6-3b6a-49ab-936d-94ff2c0f9773",
                                                "sense_id": "dbea9a99-0aa9-3b01-bdb0-035fc05572a0",
                                                "text": "Instead of creating a single unified platform, the the^([sic]) protocol that Mastodon uses, called ActivityPub, allows anyone to use open-source software to boot up a server that hosts a Twitter-style community with its own rules. Together those servers, and other, non-Mastodon ones, form a collective of interlinked communities dubbed the “Fediverse.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
