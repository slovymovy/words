                "senses": [
                    {
                        "sense_id": "92a001d0-255e-3bd0-8989-681a10e8829e",
                        "entry_id": "9620de51-b7bd-3418-b9b5-e738b59276c5",
                        "glosses": [
                            "rogue"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc424368-9257-43e4-bdda-2ceff9caf74d",
                                "sense_id": "92a001d0-255e-3bd0-8989-681a10e8829e",
                                "text": "Мы наперебо́й друг пе́ред дру́гом сказа́ли ему́, что хозя́ин наш вы́жига, жу́лик, злоде́й и мучи́тель, — всё, что мо́жно и ну́жно бы́ло сказа́ть о хозя́ине, но нельзя́ написа́ть здесь.",
                                "translation": "Vieing with one another, we told him that our \"boss\" was a rogue, a rascal, a villain, a tyrant, everything that could and ought to be said of our proprietor, but which cannot be repeated here.",
                                "english": "Vieing with one another, we told him that our \"boss\" was a rogue, a rascal, a villain, a tyrant, everything that could and ought to be said of our proprietor, but which cannot be repeated here."
                            }
                        ]
                    }
