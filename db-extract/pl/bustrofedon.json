                                    },
                                    {
                                        "sense_id": "c0de67b1-4cda-33fe-9a1c-39e0fa1dee70",
                                        "entry_id": "a5b47e67-57e9-3c86-9385-a493821bb998",
                                        "glosses": [
                                            "Changing direction, going back and forth."
