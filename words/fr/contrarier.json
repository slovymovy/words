    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c20bbc87-d4b0-378d-b87c-396771b20a4b",
                    "sense_definition": "Causer du dépit, du mécontentement ou de la déception à quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "affect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette mauvaise nouvelle risque de beaucoup la <w>contrarier</w> avant son départ."
                        },
                        {
                            "text": "Tes retards répétés <w>contrarient</w> beaucoup ton père, qui tient à la ponctualité."
                        }
                    ],
                    "synonyms": [
                        "chagriner",
                        "déranger",
                        "embêter",
                        "ennuyer",
                        "irriter"
                    ],
                    "common_phrases": [
