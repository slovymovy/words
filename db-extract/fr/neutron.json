        "fr-extract.jsonl": [
            {
                "entry_id": "34870931-9770-3131-90f5-ec5a51530fc5",
                "word": "neutron",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1baf490a-9173-4643-a7ef-f1e85d8d1566",
                        "entry_id": "34870931-9770-3131-90f5-ec5a51530fc5",
                        "tags": [
                            "plural"
                        ],
                        "form": "neutrons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4cc2104-3435-3c91-89b6-7bc275551576",
                        "entry_id": "34870931-9770-3131-90f5-ec5a51530fc5",
                        "glosses": [
                            "Particule sans charge électrique (neutre), composée d’un quark up et deux quarks down, qui constitue le noyau atomique avec le ou les protons."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "d7118b41-ab3b-4282-ba59-ecf22f0fc21d",
                                "sense_id": "b4cc2104-3435-3c91-89b6-7bc275551576",
                                "text": "Le noyau de deutérium est composé d’un proton et d’un neutron."
                            },
                            {
                                "example_id": "3c6843dc-762a-457b-be8e-082efcd4db25",
                                "sense_id": "b4cc2104-3435-3c91-89b6-7bc275551576",
                                "text": "Le neutron est une particule qui présente des caractéristiques très spécifiques par rapport aux autres rayonnements et autour duquel de nombreuses techniques insrtumentales ont été développées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f7ea4f4-84c7-44b5-852d-c0c2cdb1e220",
                        "source_entry_id": "34870931-9770-3131-90f5-ec5a51530fc5",
                        "source_sense_id": "b4cc2104-3435-3c91-89b6-7bc275551576",
                        "target_lang_word": "Neutron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neutron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e3f268c-a24a-39a7-8e4d-437304132ecc",
                                        "entry_id": "ee7d1c05-71c5-3b3f-b2a0-12b21dddb653",
                                        "glosses": [
                                            "ungeladenes Nukleon (ein Baustein des Atomkerns), bestehend aus einem Up- und zwei Downquarks (udd)"
                                        ],
                                        "tags": [
                                            "Quantenphysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f97684c9-53ba-41e0-a98a-615c8f164f51",
                                                "sense_id": "5e3f268c-a24a-39a7-8e4d-437304132ecc",
                                                "text": "Der Heliumkern besteht aus zwei Neutronen und zwei Protonen."
                                            },
                                            {
                                                "example_id": "230f8be6-3761-4291-94f8-5602cfded848",
                                                "sense_id": "5e3f268c-a24a-39a7-8e4d-437304132ecc",
                                                "text": "Der Beta-Zerfall bedeutet, dass ein Neutron (udd) in ein Proton (uud), ein Elektron und ein Antineutrino zerfällt."
                                            },
                                            {
                                                "example_id": "fe447a33-9338-4a30-b4aa-99a286c2f367",
                                                "sense_id": "5e3f268c-a24a-39a7-8e4d-437304132ecc",
                                                "text": "„Frédéric Joliot in Frankreich wies nach, daß sich beim Spaltungsprozeß des Urans aus dem sich teilenden Atomkern Neutronen lösen, die weitere Spaltungsprozesse einleiten können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
