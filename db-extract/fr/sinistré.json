                        "entry_id": "c3ac1fd3-7692-3cc6-9f9f-52b4cadfa4e4",
                        "glosses": [
                            "Qui a subi un sinistre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8212a48f-e636-4165-92c6-5df988a867a0",
                                "sense_id": "392c1e8f-5fa7-35a6-95fc-bae1f8a9e13d",
                                "text": "Je décline pour ne pas froisser Chaglaate. Je fais comme le plombier auquel la dame sinistrée proposait la botte et qui préférait un coup de rouge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd10b97f-9af8-4473-b3bc-bdd86230f243",
                        "source_entry_id": "c3ac1fd3-7692-3cc6-9f9f-52b4cadfa4e4",
                        "source_sense_id": "392c1e8f-5fa7-35a6-95fc-bae1f8a9e13d",
                        "target_lang_word": "geteisterd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geteisterd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1582c136-b636-3860-bf06-92af1a8a7a1e",
                                        "entry_id": "1a2e18ac-c277-3fc3-96b2-674ae39b0fbb",
                                        "glosses": [
                                            "voltooid deelwoord van teisteren"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76458c38-349d-4fc1-bae4-f7f3cff33382",
                                                "sense_id": "1582c136-b636-3860-bf06-92af1a8a7a1e",
                                                "text": "Lepra is een van de oudst bekende ziekten die de mensheid heeft geteisterd."
                                            },
                                            {
                                                "example_id": "2ad3e4cb-b28f-4c4d-9c9d-03a04db59db9",
                                                "sense_id": "1582c136-b636-3860-bf06-92af1a8a7a1e",
                                                "text": "Middelbare scholen worden geteisterd door geweldsincidenten."
                                            },
                                            {
                                                "example_id": "1845cefb-2540-463c-852d-1ee05c5659f5",
                                                "sense_id": "1582c136-b636-3860-bf06-92af1a8a7a1e",
                                                "text": "Het reddingswerk begint op gang te komen in het geteisterde gebied."
                                            },
                                            {
                                                "example_id": "6c958b28-bd18-4e6c-a098-69322ffde0f7",
                                                "sense_id": "1582c136-b636-3860-bf06-92af1a8a7a1e",
                                                "text": "Het zuiden van het land is recentelijk geteisterd door enorme branden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
