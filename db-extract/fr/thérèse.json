                    {
                        "translation_id": "b69bb612-8e40-4be8-9671-fadaf6034b60",
                        "source_entry_id": "9d50e27c-de3e-30d4-aaaa-cd4095f6df22",
                        "source_sense_description": "Prénom féminin",
                        "target_lang_word": "Teresa",
