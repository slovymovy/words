                ],
                "senses": [
                    {
                        "sense_id": "5842294f-f562-36c4-a749-e17ba3749d6c",
                        "entry_id": "49a8c72e-97a9-3c1e-a5f9-c508ad405c03",
                        "glosses": [
                            "Luft voller Dunst und Gerüchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46dbfc2d-bbbb-40ec-95d2-edbf2225b2f2",
                                "sense_id": "5842294f-f562-36c4-a749-e17ba3749d6c",
                                "text": "Was für ein höllischer Brodem quillt hier empor!"
                            },
                            {
                                "example_id": "25fbb3b3-547a-4d5b-9ff4-a2161e5f76fa",
                                "sense_id": "5842294f-f562-36c4-a749-e17ba3749d6c",
                                "text": "„Ein dicker Brodem von Körperlichkeit, ein Gestank nach schofelster Sinnlichkeit macht sich immer breiter.“"
                            },
                            {
                                "example_id": "868d69ed-4f1a-4c5f-aded-f0a200a07ff2",
                                "sense_id": "5842294f-f562-36c4-a749-e17ba3749d6c",
                                "text": "„Sobald das Wellfleisch fertig ist, werden die ersten Gäste betafelt, und der Brodem vom toten Schwein zieht ins Haus ein.“"
                            },
                            {
                                "example_id": "b345c78c-2969-4eee-b2ea-a228b8a44d63",
                                "sense_id": "5842294f-f562-36c4-a749-e17ba3749d6c",
                                "text": "„Der Rauch und Qualm, der wie ein dicker, stickiger Brodem über den Straßen liegt, wird von den tiefhängenden Wolken niedergehalten und in die Straßenzeilen zurückgedrückt.“"
                            },
                            {
                                "example_id": "e25dc402-7e23-4ef5-a44b-6e8db3fa3f6c",
                                "sense_id": "5842294f-f562-36c4-a749-e17ba3749d6c",
                                "text": "„In diesem gelbroten Brodem lag die Frau auf dem Bett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
