                "translations": [
                    {
                        "translation_id": "1f9a40bf-4683-4583-ba47-da99835282e0",
                        "source_entry_id": "baed25cd-8ef5-3827-ad6b-70911b71f11a",
                        "source_sense_id": "11eec7d3-0c24-33cc-9702-9384353028cb",
                        "target_lang_word": "watertight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "watertight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63373671-cf9e-36b6-8fb1-d84de18b8ddf",
                                        "entry_id": "188a6f7e-fd53-38aa-8dde-f5cdebe2a654",
                                        "glosses": [
                                            "So tightly made that water cannot enter or escape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5cabd313-b782-3be9-98be-29c0dce23e4b",
                                        "entry_id": "188a6f7e-fd53-38aa-8dde-f5cdebe2a654",
                                        "glosses": [
                                            "So devised or planned as to be impossible to defeat, evade or nullify."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "401b3ffb-025c-4a66-831d-a1479089a9d3",
                                                "sense_id": "5cabd313-b782-3be9-98be-29c0dce23e4b",
                                                "text": "a watertight contract; a watertight regulation"
                                            },
                                            {
                                                "example_id": "b09aab5b-d59f-409b-bbf9-8deb66c1daf2",
                                                "sense_id": "5cabd313-b782-3be9-98be-29c0dce23e4b",
                                                "text": "What if England's defence is finally examined to the full by class opposition at the Euros? Can this rearguard be trusted to remain watertight and protect what a high-quality attack can give them?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7642eb5e-131e-4f2d-9f34-abd0a5d63312",
                        "source_entry_id": "baed25cd-8ef5-3827-ad6b-70911b71f11a",
                        "source_sense_id": "11eec7d3-0c24-33cc-9702-9384353028cb",
                        "target_lang_word": "wasserdicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wasserdicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f4e915c-783d-367e-98ee-25aa3b78abbd",
                                        "entry_id": "4c90d381-30b8-3d45-a3bd-6d7ffac96c68",
                                        "glosses": [
                                            "undurchlässig für Wasser oder auch andere Flüssigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48bd9d30-af4b-45c9-88bf-1d8efdd81d6c",
                                                "sense_id": "5f4e915c-783d-367e-98ee-25aa3b78abbd",
                                                "text": "Diese billige Uhr ist nicht wasserdicht."
                                            },
                                            {
                                                "example_id": "2243ae95-af41-4258-b743-488a458135c7",
                                                "sense_id": "5f4e915c-783d-367e-98ee-25aa3b78abbd",
                                                "text": "[Die Inuit] nähen ihre Kleidung aus wasserdichter Robbenhaut."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e05b85b6-6e3e-3402-8361-4e8ed89bacd1",
                                        "entry_id": "4c90d381-30b8-3d45-a3bd-6d7ffac96c68",
                                        "glosses": [
                                            "ohne jegliche Zweifel, sicher"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd2a853-0534-45b2-9e17-335deea2d034",
                                                "sense_id": "e05b85b6-6e3e-3402-8361-4e8ed89bacd1",
                                                "text": "Jemand erblickte sie im Café, sie kann also nicht um diese Uhrzeit am Tatort gewesen sein, sie hat ein wasserdichtes Alibi."
                                            },
                                            {
                                                "example_id": "c78072e9-f52d-403d-9c31-413e9c14d14a",
                                                "sense_id": "e05b85b6-6e3e-3402-8361-4e8ed89bacd1",
                                                "text": "Wir sollten diesen Arbeitsvertrag juristisch wasserdicht formulieren."
                                            },
                                            {
                                                "example_id": "5313461d-a7b1-418d-8c4d-aaf638a5c9dc",
                                                "sense_id": "e05b85b6-6e3e-3402-8361-4e8ed89bacd1",
                                                "text": "Matthias Adrian: „[…] Dann brachte die NPD eine neue CD heraus, die nur strafrechtlich unbedenkliche Titel enthielt, von denen nur ein einziger, mit Ach und Krach, als jugendgefährdend eingestuft wurde. Dann gab es die zweite CD von der NPD, die dann aber strafrechtlich wasserdicht war. Es wurden nur zuvor bereits freigegebene Lieder veröffentlicht.“"
                                            },
                                            {
                                                "example_id": "24890fb5-f332-4620-b3b0-bce150e2283c",
                                                "sense_id": "e05b85b6-6e3e-3402-8361-4e8ed89bacd1",
                                                "text": "„Er machte sich jedoch keine Sorgen deswegen: Seine Tarnung war schließlich absolut wasserdicht.“"
                                            },
                                            {
                                                "example_id": "6d4e6e1b-5b07-4113-81aa-3fcc2df3c8c5",
                                                "sense_id": "e05b85b6-6e3e-3402-8361-4e8ed89bacd1",
                                                "text": "„Takada wollte die langsam mahlenden Mühlen der Justiz etwas antreiben und endlich für Gerechtigkeit sorgen, indem er Sekiguchi wasserdichte Beweise lieferte, damit dieser den Mörder festnageln und er dann den toten Endo gebührend ehren konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
