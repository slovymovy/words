                                        "sense_id": "f07dffa6-86ff-3e72-98e0-4e8ed62982ac",
                                        "entry_id": "ee569e7d-b576-3653-af1b-69f152dedddc",
                                        "glosses": [
                                            "A straw, often made of metal, ending in a filter and used for drinking maté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1524fb55-1b65-416e-8eb4-76b2a3f61927",
                                                "sense_id": "f07dffa6-86ff-3e72-98e0-4e8ed62982ac",
                                                "text": "The maté is then filled with yerva, after the bombilla has been placed in position. The bombilla is literally “a little pump,” that is, a sucking tube, ending in a perforated bulb, which performs the office of the perforated diaphragm in our teapot spouts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
