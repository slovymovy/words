                "senses": [
                    {
                        "sense_id": "308f500d-d53b-35ff-8b7f-412487c24ce0",
                        "entry_id": "30909ced-957d-361e-b30d-8795b9b2f1f4",
                        "glosses": [
                            "the crime of trespassing, the unlawful entry to, or presence in, a house etc."
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "49eccca4-ba80-4bf8-b255-3f21ad589b37",
                                "sense_id": "308f500d-d53b-35ff-8b7f-412487c24ce0",
                                "text": "Der ertappte Einbrecher wurde wegen Hausfriedensbruchs, Sachbeschädigung und versuchten Diebstahls angeklagt.",
                                "translation": "The burglar who had been caught in the act was indicted for trespassing, property damage, and attempted theft.",
                                "english": "The burglar who had been caught in the act was indicted for trespassing, property damage, and attempted theft."
                            },
                            {
                                "example_id": "9240965c-3dbe-4ab2-a8f3-aa8be97f2e0e",
                                "sense_id": "308f500d-d53b-35ff-8b7f-412487c24ce0",
                                "text": "Der Gast hatte sich trotz mehrfacher Aufforderung durch den Kneipenwirt geweigert, das Lokal zu verlassen. Daher wurde ein Verfahren wegen Hausfriedensbruchs gegen ihn eingeleitet.",
                                "translation": "The guest had refused to leave the premises in spite of repeated requests by the bar owner. Therefore proceedings for trespassing were opened against him.",
                                "english": "The guest had refused to leave the premises in spite of repeated requests by the bar owner. Therefore proceedings for trespassing were opened against him."
                            }
                        ]
                    }
