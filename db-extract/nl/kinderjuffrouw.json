                                                "sense_id": "0ae5beb1-6308-3549-9499-b8e0e90b0eb0",
                                                "text": "She believes that nursing her baby will make him strong and healthy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13534649-6d46-38fc-b501-d4e4cc9093a8",
