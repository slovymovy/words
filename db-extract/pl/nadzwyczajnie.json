                        "glosses": [
                            "w sposób niezwykły, nadzwyczajny, nieprzeciętny; bardzo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b84cf061-74df-471d-9d92-4d7e3ac69483",
                                "sense_id": "3d5a20ce-c997-36f6-9f9f-83bf42ad863f",
                                "text": "Ta opowieść jest nadzwyczajnie ciekawa!"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de07c881-bf53-4d39-886e-f4447d4c71a2",
                        "source_entry_id": "17ae78bb-478d-3a87-971a-7a0cf9e2fab6",
                        "source_sense_id": "3d5a20ce-c997-36f6-9f9f-83bf42ad863f",
                        "target_lang_word": "extraordinarily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extraordinarily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4758e80a-5a56-30f4-a58d-f33eba780fb8",
                                        "entry_id": "b3cd0739-9e38-3ccb-a858-de72249ffb80",
                                        "glosses": [
                                            "In an extraordinary manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deb33972-f1d0-4eaa-83fa-f7a2e82c91e6",
                                                "sense_id": "4758e80a-5a56-30f4-a58d-f33eba780fb8",
                                                "text": "All this was extraordinarily distasteful to Churchill. It was ugly, gross. Never before had he felt such repulsion when the vicar displayed his characteristic bluntness or coarseness of speech. In the present connexion […] such talk had been distressingly out of place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce864511-4540-4438-b981-6ea2e7c87a2b",
                        "source_entry_id": "17ae78bb-478d-3a87-971a-7a0cf9e2fab6",
                        "source_sense_id": "3d5a20ce-c997-36f6-9f9f-83bf42ad863f",
                        "target_lang_word": "非常",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "非常",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                        "entry_id": "0e2daf3a-9429-39fc-a1a2-babcdb5f82c1",
                                        "glosses": [
                                            "極其，很"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75f3caf2-5d79-49cb-a1a3-9d37c227f05b",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "非常感謝"
                                            },
                                            {
                                                "example_id": "eca99019-7d67-41f6-b1c5-77118343733c",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "非常感谢"
                                            },
                                            {
                                                "example_id": "78ec7af0-cd27-4d0c-b783-4a75078f60ec",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "非常努力地工作"
                                            },
                                            {
                                                "example_id": "03925368-38f1-4428-9c15-2a7f2d00c6ac",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "他在信中的用詞非常犀利。"
                                            },
                                            {
                                                "example_id": "70b7dc2b-da81-44c4-9b70-d9736a4dae56",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "他在信中的用词非常犀利。"
                                            },
                                            {
                                                "example_id": "e30fdba4-2a94-44bc-93eb-9bc8fc840c8a",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "他是有文化的人，說的話非常好聽。"
                                            },
                                            {
                                                "example_id": "05322b19-b8fe-456e-98bf-7191f59ce398",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "他是有文化的人，说的话非常好听。"
                                            },
                                            {
                                                "example_id": "18bdd89b-7fdc-4ab3-9e29-6bd0770f192f",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "他是一位胸懷十分豁達，並且意念非常堅強的領袖。"
                                            },
                                            {
                                                "example_id": "d6bd4c06-cd0b-436c-a82e-3fb8983c5502",
                                                "sense_id": "a6536e72-984c-3a67-ad28-5c72f345925c",
                                                "text": "他是一位胸怀十分豁达，并且意念非常坚强的领袖。"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "非常",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "c29a4ff4-ad87-39a8-baee-2dc7a0e06867",
                                        "entry_id": "3447a545-deaa-3202-a513-5582033c6b4c",
                                        "glosses": [
                                            "特別，非凡，異乎尋常"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4957893-99ef-46ef-b9bd-c704e4da9cf0",
                                                "sense_id": "c29a4ff4-ad87-39a8-baee-2dc7a0e06867",
                                                "text": "古者富貴而名磨滅，不可勝{shēng記，唯倜儻非常之人稱焉。",
                                                "translation": "古代富貴之人不計其數，但他們的名字卻已默默無聞。只有那些精明強幹的人，那些真正非凡的人，才有可能被人們銘記。"
                                            },
                                            {
                                                "example_id": "243f81fc-13d3-41eb-9d82-ba49b2c51bb8",
                                                "sense_id": "c29a4ff4-ad87-39a8-baee-2dc7a0e06867",
                                                "text": "古者富贵而名磨灭，不可胜{shēng记，唯倜傥非常之人称焉。",
                                                "translation": "古代富貴之人不計其數，但他們的名字卻已默默無聞。只有那些精明強幹的人，那些真正非凡的人，才有可能被人們銘記。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b755156-e78a-32f1-afd5-480dce84701b",
                                        "entry_id": "3447a545-deaa-3202-a513-5582033c6b4c",
                                        "glosses": [
                                            "突如其來的禍患"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab292e60-b07f-49bd-a0e8-d8863ce31a51",
                        "source_entry_id": "17ae78bb-478d-3a87-971a-7a0cf9e2fab6",
                        "source_sense_id": "3d5a20ce-c997-36f6-9f9f-83bf42ad863f",
                        "target_lang_word": "extraordinairement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extraordinairement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "10c6f73a-164c-32e4-bdd4-988234d10e04",
                                        "entry_id": "262a0b4b-a189-3863-aa94-62e2a4b02c42",
                                        "glosses": [
                                            "D’une façon contraire à l’usage, à la règle ordinaire, à l’ordre accoutumé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7776956-e641-44e5-a623-8eb2432520b2",
                                                "sense_id": "10c6f73a-164c-32e4-bdd4-988234d10e04",
                                                "text": "La commune de Nouan sur Loire, département de Loir et Cher , est autorisée à s'imposer extraordinairement, en centimes additionnels à ses contributions directes , la somme de huit cent soixante-six francs, pour être employée à réparer l'église et le presbytère."
                                            },
                                            {
                                                "example_id": "c6049734-0c27-48a3-a5b2-365a4e19ad91",
                                                "sense_id": "10c6f73a-164c-32e4-bdd4-988234d10e04",
                                                "text": "Les circonstances qui pourraient survenir extraordinairement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f56b0801-68b4-3586-9566-338fa2770238",
                                        "entry_id": "262a0b4b-a189-3863-aa94-62e2a4b02c42",
                                        "glosses": [
                                            "D’une façon extraordinaire, par extraordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbd4f334-8580-4dc8-8770-4fe874a583d2",
                                                "sense_id": "f56b0801-68b4-3586-9566-338fa2770238",
                                                "text": "Ceux qui ont reçu extraordinairement, doivent espérer extraordinairement."
                                            },
                                            {
                                                "example_id": "04817912-6a79-4f43-859a-1aef171ca173",
                                                "sense_id": "f56b0801-68b4-3586-9566-338fa2770238",
                                                "text": "Le jour de la fête de Vesta, le temple était ouvert extraordinairement [il n'y avait aucun endroit du temple où l’on ne pût entrer]."
                                            },
                                            {
                                                "example_id": "a52de4e6-ebe9-4128-928e-751e5aa84345",
                                                "sense_id": "f56b0801-68b4-3586-9566-338fa2770238",
                                                "text": "Tout ceci me paraît un songe, mais la vie humaine est-elle autre chose ? je rêve plus extraordinairement qu’un autre et voilà tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1f39fa2-76d8-3a0a-a300-6d840feeed03",
                                        "entry_id": "262a0b4b-a189-3863-aa94-62e2a4b02c42",
                                        "glosses": [
                                            "Extrêmement, au-delà de la mesure ordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26775638-d52b-4264-adfd-c491363ce810",
                                                "sense_id": "c1f39fa2-76d8-3a0a-a300-6d840feeed03",
                                                "text": "Le jeune homme déplut à Mme Moreau. Il mangea extraordinairement, il refusa d’assister le dimanche aux offices, il tenait des discours républicains ; enfin, elle crut savoir qu’il avait conduit son fils dans des lieux déshonnêtes."
                                            },
                                            {
                                                "example_id": "912cb6c8-2a8a-4870-b799-e5d582505b78",
                                                "sense_id": "c1f39fa2-76d8-3a0a-a300-6d840feeed03",
                                                "text": "Ce garçon-là m’aime extraordinairement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec324c46-9ae3-32c3-bd81-84bbe04120ef",
                                        "entry_id": "262a0b4b-a189-3863-aa94-62e2a4b02c42",
                                        "glosses": [
                                            "Extrêmement beaucoup de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfda7a04-618c-44f7-ac66-ced524a220a8",
                                                "sense_id": "ec324c46-9ae3-32c3-bd81-84bbe04120ef",
                                                "text": "Sans argent, beaucoup d’argent, extraordinairement d’argent, rien ne compte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6346f9e1-8c98-3c0e-84d8-bafe25928dce",
                                        "entry_id": "262a0b4b-a189-3863-aa94-62e2a4b02c42",
                                        "glosses": [
                                            "Bizarrement, d’une manière choquante."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc2dae8c-85fb-45e5-b8b7-16c253247ba3",
                                                "sense_id": "6346f9e1-8c98-3c0e-84d8-bafe25928dce",
                                                "text": "Elle est coiffée fort extraordinairement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
