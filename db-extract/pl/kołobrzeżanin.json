                "senses": [
                    {
                        "sense_id": "2b8dd254-8107-3a60-bf90-c21d2502904d",
                        "entry_id": "4e308a3c-3943-36fd-ac93-95a28ebd805b",
                        "glosses": [
                            "native or inhabitant of Kołobrzeg (usually male)"
                        ],
                        "tags": [
                            "masculine",
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "6e38cd2f-c3c1-4b1f-8cc1-58d84005f4fa",
                                "sense_id": "2b8dd254-8107-3a60-bf90-c21d2502904d",
                                "text": "Okazało się jednak, że kołobrzeżanie zdążyli już załadować wozy zdobyczą - teraz zaś ciągnęli żwawo w kierunku Bielic, aby zmylić pogoń.",
                                "translation": "But it appeared that the inhabitants of Kołobrzeg had already packed their wagons with the loot - and now they were moving quickly in the direction of Bielice to confuse the pursuit.",
                                "english": "But it appeared that the inhabitants of Kołobrzeg had already packed their wagons with the loot - and now they were moving quickly in the direction of Bielice to confuse the pursuit."
                            },
                            {
                                "example_id": "d8884512-42d1-4ff2-8ddb-a3cf734b86f7",
                                "sense_id": "2b8dd254-8107-3a60-bf90-c21d2502904d",
                                "text": "Coraz większa niemoc była wodą na młyn dla kołobrzeżan.",
                                "translation": "Further powerlessness was grist for the mill to the team from Kołobrzeg.",
                                "english": "Further powerlessness was grist for the mill to the team from Kołobrzeg."
                            }
                        ]
                    }
                ],
