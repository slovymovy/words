                "senses": [
                    {
                        "sense_id": "e2ffe728-472e-3eb7-83d1-6e47031cae3c",
                        "entry_id": "5fe4d310-546b-3ade-8962-fe0a4923739d",
                        "glosses": [
                            "drunkenness, heavy drinking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb4f107d-9613-4728-9890-d822088d08a2",
                                "sense_id": "e2ffe728-472e-3eb7-83d1-6e47031cae3c",
                                "text": "К пья́нице и пья́нству у ней бы́ло физиологи́ческое отвраще́ние.",
                                "translation": "Her aversion to alcoholics and drunkenness was almost physical.",
                                "english": "Her aversion to alcoholics and drunkenness was almost physical."
                            },
                            {
                                "example_id": "5cd7f098-1f28-4ab2-a268-dd24bf3544a6",
                                "sense_id": "e2ffe728-472e-3eb7-83d1-6e47031cae3c",
                                "text": "Когда́ Лигачёв боро́лся про́тив пья́нства, Ири́на научи́лась гнать самого́н отме́нного ка́чества.",
                                "translation": "Alexander Korzhakov",
                                "english": "Alexander Korzhakov"
                            }
                        ]
                    }
                ],
