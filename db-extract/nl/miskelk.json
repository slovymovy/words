                                                "sense_id": "0b8e9279-ef3a-3a49-8fd3-ed140b1b8691",
                                                "text": "No one is left to swing the battle-ax skyward. No man will ever again drink from this golden goblet!"
                                            },
                                            {
                                                "example_id": "8b08da69-3c34-48f4-b41e-703cacab1744",
                                                "sense_id": "0b8e9279-ef3a-3a49-8fd3-ed140b1b8691",
                                                "text": "At first Enkidu gags on the food, but then he grows to like the strong drink and takes seven goblets, until his face glows."
                                            }
                                        ]
