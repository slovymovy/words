                "senses": [
                    {
                        "sense_id": "4a4a39c1-3a52-3cd3-b6df-595746063dbd",
                        "entry_id": "b06f1bc0-14a8-3b81-ac83-4916b4d0c74e",
                        "glosses": [
                            "Augmenter le plus possible la quantité d’oxygène sanguin en faisant respirer au patient un air dénitrogéné afin de limiter les risques dus à une apnée prolongée dans le cadre de certaines opérations médicales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb34153e-41c0-45c2-bd3e-217494119989",
                                "sense_id": "4a4a39c1-3a52-3cd3-b6df-595746063dbd",
                                "text": "Dans la très grande majorité des cas, il convient de bien préoxygéner le patient."
                            },
                            {
                                "example_id": "6a886fc9-5104-480f-b9ec-515e59dd14c0",
                                "sense_id": "4a4a39c1-3a52-3cd3-b6df-595746063dbd",
                                "text": "Pour corriger ce problème, dégonfler l'éventuel ballonnet, retirer la sonde d'intubation et préoxygéner l'enfant avant de retenter une intubation."
                            }
                        ]
                    }
                ],
