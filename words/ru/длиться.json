                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Звук <длился> музыкантом искусственно для создания напряжения.",
                            "target_lang_translations": {
                                "en": "The sound was artificially <prolonged> by the musician to create tension.",
                                "de": "Der Ton wurde vom Musiker künstlich <verlängert>, um Spannung zu erzeugen."
                            }
                        },
                        {
                            "text": "Это состояние <длилось> врачами с помощью медикаментов.",
                            "target_lang_translations": {
