                        "entry_id": "cf02c687-15fb-3ce8-b02c-ef84cb5a9cb6",
                        "glosses": [
                            "to gather; to pick; to collect; to assemble; to take (a lot of)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be5f78d0-b322-4066-b282-587d97c24702",
                                "sense_id": "17b46f8e-eaf7-3490-8f43-8a3f49df4681",
                                "text": "набра́ть корзи́ну грибо́в",
                                "translation": "to gather a basket of mushrooms",
                                "english": "to gather a basket of mushrooms"
                            },
                            {
                                "example_id": "67dd260a-57fd-46d3-b850-923620c48176",
                                "sense_id": "17b46f8e-eaf7-3490-8f43-8a3f49df4681",
                                "text": "набра́ть зака́зов",
                                "translation": "to take a lot of orders",
                                "english": "to take a lot of orders"
                            },
                            {
                                "example_id": "f483d248-8c2e-432c-ab5e-8a9b81d7f5e8",
                                "sense_id": "17b46f8e-eaf7-3490-8f43-8a3f49df4681",
                                "text": "набра́ть угля",
                                "translation": "to take on coal",
                                "english": "to take on coal"
                            }
                        ]
                    },
                    {
                        "sense_id": "dc25d76b-c84e-3ffa-afcf-f96222714d48",
                        "entry_id": "cf02c687-15fb-3ce8-b02c-ef84cb5a9cb6",
                        "glosses": [
                            "to take on; to enlist, to recruit; to engage; to enrol, to make up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "956ca43e-5b9b-4eea-a75d-1780839815e3",
                                "sense_id": "dc25d76b-c84e-3ffa-afcf-f96222714d48",
                                "text": "набра́ть рабо́чих на заво́д",
                                "translation": "to take on workers at a factory",
                                "english": "to take on workers at a factory"
                            },
                            {
                                "example_id": "d9a21ce2-2bad-44bb-91cb-0f0325419824",
                                "sense_id": "dc25d76b-c84e-3ffa-afcf-f96222714d48",
                                "text": "набра́ть уча́щихся в те́хникум",
                                "translation": "to enrol students (for technical school)",
                                "english": "to enrol students (for technical school)"
                            },
                            {
                                "example_id": "0fadfe0f-f1ce-4396-95ed-53a711edcfe3",
                                "sense_id": "dc25d76b-c84e-3ffa-afcf-f96222714d48",
                                "text": "набра́ть тру́ппу",
                                "translation": "to make up a (e.g. theatre) company",
                                "english": "to make up a (e.g. theatre) company"
