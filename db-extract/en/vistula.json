                    {
                        "translation_id": "43cb94d8-1330-4f62-b102-235b22d30ffa",
                        "source_entry_id": "c724c9b7-c433-3e1a-a6e2-63a546b1af60",
                        "source_sense_id": "1b6be66a-95aa-3e4f-a1a3-3db478c334ff",
                        "source_sense_description": "Polish river",
                        "target_lang_word": "Vistule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vistule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4bdba5e1-0ee1-3f42-bae8-040d90b93984",
                                        "entry_id": "4df57d71-92c4-3992-8032-eaa23ec1bc98",
                                        "glosses": [
                                            "Grand fleuve qui se jette dans la mer Baltique après avoir traversé la Pologne."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1000ce68-c7bf-4864-a6fc-a9275856c310",
                                                "sense_id": "4bdba5e1-0ee1-3f42-bae8-040d90b93984",
                                                "text": "Les subsistances seront versées dans les lieux qui seront indiqués par l’intendant-général de l’armée, savoir : la moitié dans les places de l’Oder et de la Vistule, y compris Modelin, et l’autre moitié dans les places de la Prusse orientale et occidentale."
                                            },
                                            {
                                                "example_id": "6c9722d1-29df-4951-906f-ec86071cae92",
                                                "sense_id": "4bdba5e1-0ee1-3f42-bae8-040d90b93984",
                                                "text": "Pendant la nuit et pendant la journée du lendemain, nous fîmes vingt lieues en suivant les bords d'une de ces rivières sans nom qui viennent se jeter dans la Vistule."
                                            },
                                            {
                                                "example_id": "7366c3d8-9812-4d58-9471-ab5833789555",
                                                "sense_id": "4bdba5e1-0ee1-3f42-bae8-040d90b93984",
                                                "text": "Le premier Zaltz était une sorte de gavroche, comme disent les Français, le gavroche du shtetl, l’enfant terrible du Syndicat des casquettiers de Kulichow et, partant, de l’ensemble du mouvement ouvrier de Kulichow et ses environs - la grande industrie juive ayant délégué, pour d’obscurs motifs, à Kulichow et sa région le soin de casquetter tout ce qui se trouvait en fait de crâne juif de la Vistule au Niémen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dde28f7e-90a7-4a7b-9e49-f9b9a1f69cb5",
                        "source_entry_id": "c724c9b7-c433-3e1a-a6e2-63a546b1af60",
                        "source_sense_id": "1b6be66a-95aa-3e4f-a1a3-3db478c334ff",
                        "source_sense_description": "Polish river",
                        "target_lang_word": "Weichsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Weichsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1cfa9c05-b6fd-36b1-ae3e-a773d17048d4",
                                        "entry_id": "57013101-e497-35b6-879f-42963221d469",
                                        "glosses": [
                                            "Sauerkirsche (Prunus cerasus)"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "293d1d5d-6a02-4569-aac9-10cd0d780307",
                                                "sense_id": "1cfa9c05-b6fd-36b1-ae3e-a773d17048d4",
                                                "text": "Das ist eine Weichsel, keine Süßkirsche."
                                            },
                                            {
                                                "example_id": "509a810e-723f-4e54-8522-0fc14c7cde06",
                                                "sense_id": "1cfa9c05-b6fd-36b1-ae3e-a773d17048d4",
                                                "text": "Sauerkirsche (Weichsel). Die Früchte sind 10-25 mm groß, nierenförmig, flachrund oder länglich. Eine Unterteilung erfolgt in echte Sauerkirschen (Schattenmorellen, Strauchweichsel), Amarellen (Kreuzung aus Süß- und Sauerkirsche wie Glaskirschen und Baumweichsel) und dunklere Morellen (Süßweichsel)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Weichsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                        "entry_id": "75f4cbf5-dc2c-39e5-948d-276548fb9850",
                                        "glosses": [
                                            "osteuropäischer Fluss, Strom in Polen, der in die Ostsee mündet; deutsche Bezeichnung der Wisła"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ec6b7d-6788-46fa-995f-071c2dab8390",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "Das ist die Weichsel."
                                            },
                                            {
                                                "example_id": "6cf1cb6f-b091-4ad4-a122-585502f1c42f",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "„Seit Ende August biwakierten ihre Truppen an der Weichsel, aber es bestand kein Zweifel daran, dass sie dort nicht stehen bleiben würden.“"
                                            },
                                            {
                                                "example_id": "49dba8b3-6434-444c-acc3-56452c3f5443",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "„Die Weichsel wollte ich schon immer mal befahren.“"
                                            },
                                            {
                                                "example_id": "b8d9b838-8a3d-4c8b-a969-ea4d8a8b5436",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "Wir überquerten die Weichsel."
                                            },
                                            {
                                                "example_id": "85a59367-55f9-419f-a54d-c59d9afd773a",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "Die Kinder versuchten, in der Weichsel zu baden."
                                            },
                                            {
                                                "example_id": "68899824-1949-4d75-b0db-a45b17036ee3",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "„Die Hochzeitsreise ist eine Floßfahrt auf der Weichsel.“"
                                            },
                                            {
                                                "example_id": "3e4cede4-652d-4e6b-864b-87ff9d733475",
                                                "sense_id": "508f3782-e916-3d70-9242-b33e969aa078",
                                                "text": "„Wo der Treck über die Weichsel kam, erwähnt Else nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
