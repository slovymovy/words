    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "596eb719-001d-3cdc-a73a-f71fe1ebffd2",
                    "sense_definition": "Delightful for beauty, harmony, or grace.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "aesthetic_pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a <w>lovely</w> day for a walk in the park.",
                            "target_lang_translations": {
                                "ru": "Сегодня <w>чудесный</w> день для прогулки в парке.",
                                "zh": "今天是个<w>美好</w>的日子，适合去公园散步。"
                            }
                        },
                        {
                            "text": "She wore a <w>lovely</w> dress to the wedding reception.",
                            "target_lang_translations": {
                                "ru": "Она надела <w>красивое</w> платье на свадебный прием.",
                                "zh": "她穿了一件<w>美丽</w>的裙子去参加婚礼招待会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beautiful",
                        "charming",
                        "nice",
                        "pretty"
                    ],
                    "common_phrases": [
                        "a lovely day",
                        "look lovely",
                        "lovely view"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восхитительный своей красотой, гармонией или изяществом.",
                        "zh": "因美丽、和谐或优雅而令人愉悦的。"
                    },
