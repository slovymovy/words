                "senses": [
                    {
                        "sense_id": "945ea712-7e55-325c-ba87-4d9e0fe1dc8f",
                        "entry_id": "4e724a9e-6d33-39a5-ba04-bbe0dde24b3c",
                        "glosses": [
                            "Bohne, die an hohen Stangen gezogen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1c9683f-d547-46e2-aee3-9c4fab2918b7",
                                "sense_id": "945ea712-7e55-325c-ba87-4d9e0fe1dc8f",
                                "text": "„Ich aber war mit dem Akkordeon, das mich gehörig nach unten zog, in das dichte Spalier der Stangenbohnen geschlichen, einen grünen duftenden Bohnenwald.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c6d2cea5-2dcf-4609-997b-e25ce126a85e",
                        "source_entry_id": "4e724a9e-6d33-39a5-ba04-bbe0dde24b3c",
                        "source_sense_id": "945ea712-7e55-325c-ba87-4d9e0fe1dc8f",
                        "source_sense_description": "Bohne, die an hohen Stangen gezogen wird",
                        "target_lang_word": "string bean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "string bean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ec8502f-912b-34e9-9a7f-68a23a0ab8da",
                                        "entry_id": "ce271e55-015e-34f0-91ff-01ef988b8453",
                                        "glosses": [
                                            "Any long, slender green bean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80513657-3378-440f-99be-fca23751e0dd",
                                                "sense_id": "8ec8502f-912b-34e9-9a7f-68a23a0ab8da",
                                                "text": "Summer squashes almost in their golden blossom; cucumbers, now evincing a tendency to spread away from the main stock, and ramble far and wide; two or three rows of string-beans and as many more that were about to festoon themselves on poles;"
                                            },
                                            {
                                                "example_id": "902d0e01-655f-488f-b2e8-5afc823f728c",
                                                "sense_id": "8ec8502f-912b-34e9-9a7f-68a23a0ab8da",
                                                "text": "Well, I rung the fallout shelter bell / And I leaned my head and I gave a yell / “Give me a string bean, I’m a hungry man” / A shotgun fired and away I ran"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fafd490-5a94-3371-99ac-3a947c9c3e03",
                                        "entry_id": "ce271e55-015e-34f0-91ff-01ef988b8453",
                                        "glosses": [
                                            "Any long, slender green bean.",
                                            "A common bean (Phaseolus vulgaris)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a0a05fa9-bf0d-350f-9940-d61f52d3613d",
                                        "entry_id": "ce271e55-015e-34f0-91ff-01ef988b8453",
                                        "glosses": [
                                            "Any long, slender green bean.",
                                            "An immature runner bean (Phaseolus coccineus)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f871c79-b086-3bba-8ab1-3cb4d0a58264",
                                        "entry_id": "ce271e55-015e-34f0-91ff-01ef988b8453",
                                        "glosses": [
                                            "Any long, slender green bean.",
                                            "A yardlong bean (Vigna unguiculata subsp. sesquipedalis)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4969d2cc-f4f6-3ae1-9069-a52ab98b6b7f",
                                        "entry_id": "ce271e55-015e-34f0-91ff-01ef988b8453",
                                        "glosses": [
                                            "Any long, slender green bean.",
                                            "A hyacinth bean (Lablab purpureus)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9cc05e9-681a-39f0-9722-ed5c4e392f31",
                                        "entry_id": "ce271e55-015e-34f0-91ff-01ef988b8453",
                                        "glosses": [
                                            "A tall and thin person."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceae1b7f-6406-47d0-a17a-72359e070db9",
                                                "sense_id": "b9cc05e9-681a-39f0-9722-ed5c4e392f31",
                                                "text": "My way o’ doing things suits me, and I don’t figure on changing it for you or any other half-baked young string-bean."
                                            },
                                            {
                                                "example_id": "328a0514-e0fe-49f7-b4c5-0658fbad24b7",
                                                "sense_id": "b9cc05e9-681a-39f0-9722-ed5c4e392f31",
                                                "text": "She was once a tall stringbean of a girl whom the boys called “Red” in high school."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
