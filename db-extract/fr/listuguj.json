                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b9b6797-a82d-4394-8153-1bb222803c52",
                                "sense_id": "26deaad0-b897-3f66-916c-263228681a71",
                                "text": "Les bâtiments du conseil de bande de Listuguj sont fermés en raison du manque de pression d’eau, tout comme l'école de la communauté."
                            },
                            {
                                "example_id": "3b5ae513-869d-44c8-b667-5072bfbaa092",
                                "sense_id": "26deaad0-b897-3f66-916c-263228681a71",
                                "text": "Au cours des prochains jours, le Gouvernement Mi’gmaq de Listiguj offrira des services à ceux qui sont affectés, a dit M. Gray, par voie de communiqué."
                            },
                            {
                                "example_id": "fa9fae72-811c-4ea1-9f01-04d019ba4ce1",
                                "sense_id": "26deaad0-b897-3f66-916c-263228681a71",
                                "text": "Originaire de la communauté micmaque de Listuguj, en Gaspésie, elle dépose en 2017 sa thèse de doctorat en pédagogie à l'Université McGill."
                            }
