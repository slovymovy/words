                "senses": [
                    {
                        "sense_id": "09049a67-b102-3c78-9553-07613df04fb0",
                        "entry_id": "5d7ec621-58f4-30cb-a67b-1f4e87d6a63f",
                        "glosses": [
                            "ogół szklanych pozostałości po stłuczonych przedmiotach, recyklingowy surowiec szklarski"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1435f57-930f-4f33-8aa2-ebb66cd503bf",
                                "sense_id": "09049a67-b102-3c78-9553-07613df04fb0",
                                "text": "Stłuczkę szklaną można przetopić w hucie i ponownie wykorzystać."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "c9ba5ed4-b62d-3cc3-8026-3caf30194de8",
                        "entry_id": "5d7ec621-58f4-30cb-a67b-1f4e87d6a63f",
                        "glosses": [
                            "niegroźny wypadek, zazwyczaj samochodowy"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "38fe41a2-52c6-4b35-a07c-1fe28c5e5fee",
                                "sense_id": "c9ba5ed4-b62d-3cc3-8026-3caf30194de8",
                                "text": "Po tej stłuczce nigdy już nie wsiadła na motor."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5e1860ce-2acb-34c3-a405-aa052d22a2f3",
                        "entry_id": "5d7ec621-58f4-30cb-a67b-1f4e87d6a63f",
                        "glosses": [
                            "pęknięnte, stłuczone naczynie, zwykle w procesie produkcji szkła użytkowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40d2d18f-f0d2-4b15-a4dc-2481230a6e3d",
                                "sense_id": "5e1860ce-2acb-34c3-a405-aa052d22a2f3",
                                "text": "Pięć stłuczek na zmianę to górna dopuszczalna ilość."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "964bf077-b8d7-3e9a-aeff-8a322a8818ca",
                        "entry_id": "5d7ec621-58f4-30cb-a67b-1f4e87d6a63f",
                        "glosses": [
                            "pęknięnte, stłuczone jajko w procesie produkcji jaj spożywczych lub piskląt do chowu"
                        ],
                        "tags": [
                            "zootechn."
                        ],
                        "examples": [
                            {
                                "example_id": "fb5cfe18-9937-42fd-9c4b-19631993624b",
                                "sense_id": "964bf077-b8d7-3e9a-aeff-8a322a8818ca",
                                "text": "Odpowiednia zawartość wapnia i fosforu w karmie dla kur zmniejsza ilość stłuczek."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
