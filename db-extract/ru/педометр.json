                                        "entry_id": "caabd5ab-5dd2-30c9-b2c5-0fe989638e1a",
                                        "glosses": [
                                            "A device, often electronic, that measures the number of steps taken, and thus estimates the distance walked."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9256c78f-4874-4bb4-943e-9742301aa597",
                                                "sense_id": "c453c048-3df5-3d09-ae5f-130a66651c9a",
                                                "text": "He thought that buying a pedometer would spur him on to exercise."
                                            },
                                            {
                                                "example_id": "c0c8f9de-5c25-4548-9170-6f0cd094b413",
                                                "sense_id": "c453c048-3df5-3d09-ae5f-130a66651c9a",
                                                "text": "A smartphone is not the best camera, notebook, word processor, audio recorder, radio, MP3 player, map reader, pedometer and so on, but it is good enough replace numerous separate devices for most people most of the time."
                                            }
                                        ]
                                    }
