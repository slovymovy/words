{
    "word_family": [
        "divine",
        "divinely",
        "divination",
        "divinize"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6bc0f58e-df09-3fe0-8d61-0186b4467271",
                    "sense_definition": "The state, position, or fact of being a god or God.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "divine_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many ancient cultures believed in the absolute <w>divinity</w> of their kings and queens.",
                            "target_lang_translations": {
                                "ru": "Многие древние культуры верили в абсолютную <w>божественность</w> своих королей и королев."
                            }
                        },
                        {
                            "text": "The philosopher explored the <w>divinity</w> of nature and the universe in his latest book.",
                            "target_lang_translations": {
                                "ru": "В своей последней книге философ исследовал <w>божественность</w> природы и вселенной."
                            }
                        }
                    ],
                    "synonyms": [
                        "godhead",
                        "godhood",
                        "godliness",
                        "godship"
                    ],
                    "common_phrases": [
                        "absolute divinity",
                        "spark of divinity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, положение или факт бытия богом или Богом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "божественность",
                                "target_lang_sense_clarification": "свойство быть божественным"
                            },
                            {
                                "target_lang_word": "божественное начало",
                                "target_lang_sense_clarification": "природа божества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44efbe56-791d-3d42-8827-8df25e25380d",
                    "sense_definition": "A god or goddess; a being that is worshipped.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "supernatural_beings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The temple was built to honor a local <w>divinity</w> associated with the harvest.",
                            "target_lang_translations": {
                                "ru": "Храм был построен в честь местного <w>божества</w>, связанного с урожаем."
                            }
                        },
                        {
                            "text": "Ancient Greeks believed that every <w>divinity</w> had a specific role in governing the world.",
                            "target_lang_translations": {
                                "ru": "Древние греки верили, что каждое <w>божество</w> играет определенную роль в управлении миром."
                            }
                        }
                    ],
                    "synonyms": [
                        "deity",
                        "god"
                    ],
                    "common_phrases": [
                        "minor divinity",
                        "ancient divinity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бог или богиня; существо, которому поклоняются."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "божество",
                                "target_lang_sense_clarification": "объект поклонения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "433468e6-9959-3ca5-9a41-8dd729e78d6a",
                    "sense_definition": "The formal study of religion or religious beliefs.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "academic_study",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After finishing his undergraduate degree, he decided to study <w>divinity</w> at a prestigious university.",
                            "target_lang_translations": {
                                "ru": "После получения степени бакалавра он решил изучать <w>богословие</w> в престижном университете."
                            }
                        },
                        {
                            "text": "The professor of <w>divinity</w> gave a lecture on the history of religious texts.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>теологии</w> прочитал лекцию об истории религиозных текстов."
                            }
                        }
                    ],
                    "synonyms": [
                        "theology",
                        "godlore"
                    ],
                    "common_phrases": [
                        "doctor of divinity",
                        "divinity school"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное изучение религии или религиозных верований."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "богословие",
                                "target_lang_sense_clarification": "систематическое учение о Боге"
                            },
                            {
                                "target_lang_word": "теология",
                                "target_lang_sense_clarification": "академическая дисциплина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec416b33-4856-34d4-b16e-3e2e2f60e5a8",
                    "sense_definition": "A type of light, airy confectionery made with egg whites, corn syrup, and sugar.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother always makes homemade <w>divinity</w> during the winter holidays.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка всегда готовит домашнюю сладость <w>дивайнити</w> на зимние праздники."
                            }
                        },
                        {
                            "text": "The texture of the <w>divinity</w> was perfect, melting almost instantly on the tongue.",
                            "target_lang_translations": {
                                "ru": "Текстура <w>дивайнити</w> была идеальной, она таяла на языке почти мгновенно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "homemade divinity"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily Southern United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип легкого, воздушного кондитерского изделия, приготовленного из яичных белков, кукурузного сиропа и сахара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дивайнити",
                                "target_lang_sense_clarification": "вид американской сладости"
                            },
                            {
                                "target_lang_word": "нуга",
                                "target_lang_sense_clarification": "близкий по текстуре аналог"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}