                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3387d069-7cff-4c76-96ab-96b974772fac",
                                "sense_id": "66ebe18f-8720-309a-b105-169f47e9235e",
                                "text": "The box i is engrooved into the edge of the stock a b, so that it may move freely ..."
                            },
                            {
                                "example_id": "7b7f65d8-161e-475c-b321-3ddef893d7f2",
                                "sense_id": "66ebe18f-8720-309a-b105-169f47e9235e",
                                "text": "The boy had forgotten that the moor just here was broken by a narrow glen, engrooved with sliding water."
                            },
                            {
                                "example_id": "b84d46a4-8f5d-4c7a-9d4a-d440fd0f0089",
                                "sense_id": "66ebe18f-8720-309a-b105-169f47e9235e",
                                "text": "I would like sometimes to rest, to be at peace, to choose a nook, a love, and engroove myself in it — to make a final selection."
                            }
                        ]
                    }
