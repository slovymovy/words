                    {
                        "translation_id": "6c007241-db66-4696-8ccb-e13364dda908",
                        "source_entry_id": "36c3da34-9372-3bbd-98f1-73fc3fb7d797",
                        "source_sense_id": "d7c5a7fc-c1f0-3834-9edc-cb83e80d59d8",
                        "target_lang_word": "Ausdruck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausdruck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fb5e23e-5c5c-3166-b328-baa8267c7d9f",
                                        "entry_id": "34b527d0-189f-39c3-b730-085f198beb9f",
                                        "glosses": [
                                            "ein Wort oder eine Gruppierung von Worten"
                                        ],
                                        "tags": [
                                            "Sprachforschung",
                                            "Semiotik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5811d0e8-bc94-47d5-8f75-dfbb6af6ea26",
                                                "sense_id": "8fb5e23e-5c5c-3166-b328-baa8267c7d9f",
                                                "text": "Der Ausdruck \"Betrüger\" kann eine Beleidigung sein."
                                            },
                                            {
                                                "example_id": "5c310d72-b778-4566-b983-d349154d5f37",
                                                "sense_id": "8fb5e23e-5c5c-3166-b328-baa8267c7d9f",
                                                "text": "„Ich gebrauche seine Ausdrücke spontan wie meine eigenen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "55dd7d84-832e-3114-be26-7ec609e81023",
                                        "entry_id": "34b527d0-189f-39c3-b730-085f198beb9f",
                                        "glosses": [
                                            "eine bestimmte Aussage"
                                        ],
                                        "tags": [
                                            "Logik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4f30593-1dcf-4df5-8163-ab347f0c6b89",
                                                "sense_id": "55dd7d84-832e-3114-be26-7ec609e81023",
                                                "text": "Dieser Ausdruck ist immer richtig und wird Tautologie genannt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0045607a-2ced-3d3e-bf68-c6aa6aec35a0",
                                        "entry_id": "34b527d0-189f-39c3-b730-085f198beb9f",
                                        "glosses": [
                                            "ein syntaktisches Konstrukt"
                                        ],
                                        "tags": [
                                            "Programmierung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc362fb9-ed2d-4800-85d8-7135b570e234",
                                                "sense_id": "0045607a-2ced-3d3e-bf68-c6aa6aec35a0",
                                                "text": "Dieser Ausdruck kann nie ausgeführt werden, da es ein toter Kode ist und nie erreicht werden kann."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "215cda8f-ef7e-3313-8e79-61c916fdc49f",
                                        "entry_id": "34b527d0-189f-39c3-b730-085f198beb9f",
                                        "glosses": [
                                            "die Körperhaltung, Mimik, Miene, Gestik etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd0f9558-dd46-4a2d-9f68-6fd2229026e6",
                                                "sense_id": "215cda8f-ef7e-3313-8e79-61c916fdc49f",
                                                "text": "In ihrem Gesicht war ein Ausdruck der Verwunderung."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "95ad4278-46d2-3823-b100-6b86add2f840",
                                        "entry_id": "34b527d0-189f-39c3-b730-085f198beb9f",
                                        "glosses": [
                                            "ein Stil des Künstlers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21aad1ef-b4af-46d7-825d-288d7225c243",
                                                "sense_id": "95ad4278-46d2-3823-b100-6b86add2f840",
                                                "text": "Gefallen am Ausdruck von Aktionskünstlern wie Hermann Nitsch zu finden ist nicht jedermanns Sache."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "835ca0a4-fff4-368b-90bf-0bdd0bd56fbd",
                                        "entry_id": "34b527d0-189f-39c3-b730-085f198beb9f",
                                        "glosses": [
                                            "ein regulärer Ausdruck"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6dbeb258-e768-46e9-ba2b-d8ab9c6a269f",
                                                "sense_id": "835ca0a4-fff4-368b-90bf-0bdd0bd56fbd",
                                                "text": "„Mit dem Symbol ^ lassen sich Komplemente von Zeichenmengen bilden. Der reguläre Ausdruck [^0-9] beschreibt die Menge der Ein-Zeichen-Wörter, die nicht mit einem der Zeichen aus {0, 1, …, 8, 9} übereinstimmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "4d3b9352-e40f-3601-99c8-9ec63ae5da57",
                                        "entry_id": "34b527d0-189f-39c3-b730-085f198beb9f",
                                        "glosses": [
                                            "diejenige der Sprachfunktionen, die darin besteht, dass Menschen beim Sprechen etwas über sich preisgeben"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18eedb8b-d0f0-49ad-ba8f-60819771153e",
                                                "sense_id": "4d3b9352-e40f-3601-99c8-9ec63ae5da57",
                                                "text": "Ausdruck ist neben Appell und Darstellung eine der Sprachfunktionen, die wir vollziehen, sobald wir uns äußern."
                                            },
                                            {
                                                "example_id": "98ddf797-a35e-42c4-9db2-17ab407f268f",
                                                "sense_id": "4d3b9352-e40f-3601-99c8-9ec63ae5da57",
                                                "text": "Ausdruck meint die Informationen, die Sprecher beim Sprechen über sich selbst preisgeben, zum Beispiel, welchen Geschlechts sie sind, in welcher Stimmung sie sind usw."
                                            },
                                            {
                                                "example_id": "eedd63b9-abcb-4f77-9f30-fbffdc118b96",
                                                "sense_id": "4d3b9352-e40f-3601-99c8-9ec63ae5da57",
                                                "text": "„Wir nennen die semantische Relation des Lautzeichens zum Täter der Sprechtat den Ausdruck und die semantische Relation des Lautzeichens zum Adressaten den Appell.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "6b556d25-b5d5-3997-aab6-2b416e17fb59",
                                        "entry_id": "34b527d0-189f-39c3-b730-085f198beb9f",
                                        "glosses": [
                                            "die konkret realisierte Seite der Sprache (schriftlich, mündlich)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d052352-6a11-443b-bc29-672471d25c5d",
                                                "sense_id": "6b556d25-b5d5-3997-aab6-2b416e17fb59",
                                                "text": "Ein Zeichen hat zwei Seiten: Ausdruck und Inhalt. Der Ausdruck des sprachlichen Zeichens „Buch“ etwa sind dabei vor allem entweder die Buchstaben- oder die Lautfolge."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "f2c6430a-fa31-3214-8382-a01b156ad8c4",
                                        "entry_id": "34b527d0-189f-39c3-b730-085f198beb9f",
                                        "glosses": [
                                            "Symbol, Kennzeichen (häufig in Formulierungen wie Ausdruck von, für, Ausdruck mit Genitiv)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24eeb32c-cc34-468e-98f0-3d95b850d559",
                                                "sense_id": "f2c6430a-fa31-3214-8382-a01b156ad8c4",
                                                "text": "Sein Verhalten war ein deutlicher Ausdruck seiner Angst."
                                            },
                                            {
                                                "example_id": "07b44657-3ed1-47e3-9752-db5fa4d4da7d",
                                                "sense_id": "f2c6430a-fa31-3214-8382-a01b156ad8c4",
