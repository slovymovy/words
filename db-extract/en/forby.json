                    {
                        "sense_id": "58d2fae7-5e44-32a4-a2c1-141b546dd233",
                        "entry_id": "db646abd-f56b-385d-bc83-b14f10e1b8fa",
                        "glosses": [
                            "Besides; in addition to; as well as; not to mention."
                        ],
                        "tags": [
