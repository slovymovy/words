{
    "word_family": [
        "skeletal",
        "skeletonize",
        "exoskeleton",
        "endoskeleton",
        "musculoskeletal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0959e007-e686-3845-8420-029107dfc8ec",
                    "sense_definition": "The internal structure of bones and cartilage that supports the body of a human or animal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_bio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed a massive dinosaur <w>skeleton</w> in the main hall.",
                            "target_lang_translations": {
                                "ru": "В главном зале музея был выставлен огромный <w>скелет</w> динозавра.",
                                "tr": "Müze, ana salonda devasa bir dinozor <w>iskeleti</w> sergiledi."
                            }
                        },
                        {
                            "text": "Doctors examined the <w>skeleton</w> to determine the age of the remains.",
                            "target_lang_translations": {
                                "ru": "Врачи осмотрели <w>скелет</w>, чтобы определить возраст останков.",
                                "tr": "Doktorlar, kalıntıların yaşını belirlemek için <w>iskeleti</w> inceledi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "human skeleton",
                        "animal skeleton",
                        "dinosaur skeleton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренняя структура из костей и хрящей, поддерживающая тело человека или животного.",
                        "tr": "İnsan veya hayvan vücudunu destekleyen kemik ve kıkırdaklardan oluşan iç yapı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скелет",
                                "target_lang_sense_clarification": "анатомический"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "iskelet",
                                "target_lang_sense_clarification": "anatomik yapı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e43dd1f4-7106-35b1-a3cc-7b5923bf76fb",
                    "sense_definition": "A model, figure, or costume representing a skeleton, often used for decoration.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_bio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to dress up as a <w>skeleton</w> for the Halloween party.",
                            "target_lang_translations": {
                                "ru": "Она решила нарядиться <w>скелетом</w> на вечеринку в честь Хэллоуина.",
                                "tr": "Cadılar Bayramı partisi için <w>iskelet</w> kostümü giymeye karar verdi."
                            }
                        },
                        {
                            "text": "A plastic <w>skeleton</w> hung on the door to scare the visitors.",
                            "target_lang_translations": {
                                "ru": "Пластиковый <w>скелет</w> висел на двери, чтобы пугать посетителей.",
                                "tr": "Ziyaretçileri korkutmak için kapıda plastik bir <w>iskelet</w> asılıydı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plastic skeleton",
                        "skeleton costume"
                    ],
                    "target_lang_definitions": {
                        "ru": "Модель, фигура или костюм, изображающие скелет, часто используемые для украшения.",
                        "tr": "Genellikle dekorasyon amaçlı kullanılan, bir iskeleti temsil eden model, figür veya kostüm."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скелет",
                                "target_lang_sense_clarification": "макет или костюм"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "iskelet",
                                "target_lang_sense_clarification": "maketi veya kostümü"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9035e86-89ae-39c3-a8d9-1c685d78bd57",
                    "sense_definition": "The internal framework or core structure that supports a building, organization, or system.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steel <w>skeleton</w> of the skyscraper was visible from miles away.",
                            "target_lang_translations": {
                                "ru": "Стальной <w>каркас</w> небоскрёба был виден за много миль.",
                                "tr": "Gökdelenin çelik <w>iskeleti</w> kilometrelerce uzaktan görülebiliyordu."
                            }
                        },
                        {
                            "text": "We have the <w>skeleton</w> of the plan, but we need to fill in the details.",
                            "target_lang_translations": {
                                "ru": "У нас есть <w>костяк</w> плана, но нужно проработать детали.",
                                "tr": "Planın <w>iskeletini</w> oluşturduk ancak detayları doldurmamız gerekiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "backbone"
                    ],
                    "common_phrases": [
                        "steel skeleton",
                        "skeleton of the building"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренний каркас или основная структура, поддерживающая здание, организацию или систему.",
                        "tr": "Bir binayı, organizasyonu veya sistemi destekleyen iç çatı veya temel yapı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каркас",
                                "target_lang_sense_clarification": "здания или сооружения"
                            },
                            {
                                "target_lang_word": "остов",
                                "target_lang_sense_clarification": "основа конструкции"
                            },
                            {
                                "target_lang_word": "костяк",
                                "target_lang_sense_clarification": "основа плана или системы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "iskelet",
                                "target_lang_sense_clarification": "temel çatı"
                            },
                            {
                                "target_lang_word": "çatı",
                                "target_lang_sense_clarification": "yapısal temel"
                            },
                            {
                                "target_lang_word": "karkas",
                                "target_lang_sense_clarification": "bina iskeleti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbb7e3e7-502f-38c4-9afc-3836590ca50c",
                    "sense_definition": "The minimum number of people or things needed to keep a system or organization operating.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office ran on a <w>skeleton</w> staff during the holidays.",
                            "target_lang_translations": {
                                "ru": "В праздники в офисе работал <w>минимальный</w> штат сотрудников.",
                                "tr": "Tatil boyunca ofis <w>asgari</w> personelle çalıştı."
                            }
                        },
                        {
                            "text": "Due to the strike, the trains are operating a <w>skeleton</w> service.",
                            "target_lang_translations": {
                                "ru": "Из-за забастовки поезда ходят по <w>сокращённому</w> графику.",
                                "tr": "Grev nedeniyle trenler <w>kısıtlı</w> seferlerle çalışıyor."
                            }
                        }
                    ],
                    "common_phrases": [
                        "skeleton crew",
                        "skeleton staff",
                        "skeleton service"
                    ],
                    "target_lang_definitions": {
                        "ru": "Минимальное количество людей или вещей, необходимое для поддержания работы системы или организации.",
                        "tr": "Bir sistemin veya organizasyonun çalışmasını sürdürmek için gereken minimum insan veya kaynak sayısı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костяк",
                                "target_lang_sense_clarification": "основной состав"
                            },
                            {
                                "target_lang_word": "минимум",
                                "target_lang_sense_clarification": "минимальное количество"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "asgari kadro",
                                "target_lang_sense_clarification": "minimum personel"
                            },
                            {
                                "target_lang_word": "minimum hizmet",
                                "target_lang_sense_clarification": "kısıtlı operasyon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "043bfab6-edf1-3667-a90d-272d0d9747ff",
                    "sense_definition": "A very thin person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_bio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long illness, he looked like a walking <w>skeleton</w>.",
                            "target_lang_translations": {
                                "ru": "После долгой болезни он выглядел как ходячий <w>скелет</w>.",
                                "tr": "Uzun süren hastalıktan sonra yürüyen bir <w>iskelet</w> gibi görünüyordu."
                            }
                        },
                        {
                            "text": "She lost so much weight that she became a <w>skeleton</w>.",
                            "target_lang_translations": {
                                "ru": "Она так похудела, что превратилась в <w>скелет</w>.",
                                "tr": "O kadar çok kilo verdi ki <w>bir deri bir kemik</w> kaldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "thin person"
                    ],
                    "common_phrases": [
                        "walking skeleton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень худой человек.",
                        "tr": "Çok zayıf, bir deri bir kemik kalmış kişi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скелет",
                                "target_lang_sense_clarification": "об очень худом человеке"
                            },
                            {
                                "target_lang_word": "кожа да кости",
                                "target_lang_sense_clarification": "идиома"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bir deri bir kemik",
                                "target_lang_sense_clarification": "deyimsel ifade"
                            },
                            {
                                "target_lang_word": "iskelet gibi",
                                "target_lang_sense_clarification": "mecazi kullanım"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adcdb8ca-29b8-3c29-b91c-db5a3f1e2c7a",
                    "sense_definition": "A winter sport in which a person slides down a frozen track head-first on a small sled.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "group_sport",
                    "name_type": "game_or_sport_name",
                    "examples": [
                        {
                            "text": "She won a gold medal in <w>skeleton</w> at the Winter Olympics.",
                            "target_lang_translations": {
                                "ru": "Она завоевала золотую медаль в <w>скелетоне</w> на зимних Олимпийских играх.",
                                "tr": "Kış Olimpiyatları'nda <w>skeleton</w> dalında altın madalya kazandı."
                            }
                        },
                        {
                            "text": "The athlete prepared his sled for the final run of the <w>skeleton</w> competition.",
                            "target_lang_translations": {
                                "ru": "Спортсмен подготовил свои сани к финальному заезду соревнований по <w>скелетону</w>.",
                                "tr": "Sporcu, <w>skeleton</w> yarışmasının final koşusu için kızağını hazırladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "skeleton tobogganing"
                    ],
                    "common_phrases": [
                        "skeleton sled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зимний вид спорта, в котором человек спускается по ледяной трассе головой вперед на небольших санях.",
                        "tr": "Sporcunun küçük bir kızak üzerinde, buzlu bir pistte yüzüstü yatarak aşağı kaydığı bir kış sporu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скелетон",
                                "target_lang_sense_clarification": "вид спорта"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "skeleton",
                                "target_lang_sense_clarification": "kış sporu dalı"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65927688-6738-3456-b2ee-6aae52fa0be2",
                    "sense_definition": "The network of veins left in a leaf after the soft parts have decayed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The delicate <w>skeleton</w> of the leaf looked like lace.",
                            "target_lang_translations": {
                                "ru": "Хрупкий <w>скелет</w> листа был похож на кружево.",
                                "tr": "Yaprağın narin <w>damar yapısı</w> dantel gibi görünüyordu."
                            }
                        },
                        {
                            "text": "We found a perfect leaf <w>skeleton</w> on the forest floor.",
                            "target_lang_translations": {
                                "ru": "Мы нашли идеальный <w>скелет</w> листа на лесной подстилке.",
                                "tr": "Orman zemininde mükemmel bir yaprak <w>iskeleti</w> bulduk."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leaf skeleton"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сеть прожилок, оставшаяся в листе после разложения мягких тканей.",
                        "tr": "Yumuşak kısımları çürüdükten sonra yaprakta kalan damar ağı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скелет",
                                "target_lang_sense_clarification": "растения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yaprak damarları",
                                "target_lang_sense_clarification": "bitkisel yapı"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8002c907-02cf-3024-9252-fd65c3166f6e",
                    "sense_definition": "To reduce something to its essential parts or minimum structure.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "group_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor <w>skeletoned</w> the article down to the bare facts.",
                            "target_lang_translations": {
                                "ru": "Редактор <w>сократил</w> статью до голых фактов.",
                                "tr": "Editör, makaleyi sadece çıplak gerçeklere <w>indirgedi</w>."
                            }
                        },
                        {
                            "text": "The management decided to <w>skeleton</w> the workforce during the crisis.",
                            "target_lang_translations": {
                                "ru": "Руководство решило <w>сократить</w> штат во время кризиса.",
                                "tr": "Yönetim, kriz sırasında iş gücünü <w>asgari düzeye indirmeye</w> karar verdi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сводить что-либо к существенным частям или минимальной структуре.",
                        "tr": "Bir şeyi temel parçalarına veya minimum yapısına indirgemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сокращать",
                                "target_lang_sense_clarification": "до минимума"
                            },
                            {
                                "target_lang_word": "урезать",
                                "target_lang_sense_clarification": "уменьшать объём"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "indirgemek",
                                "target_lang_sense_clarification": "temel yapıya dönüştürmek"
                            },
                            {
                                "target_lang_word": "kısaltmak",
                                "target_lang_sense_clarification": "minimuma indirmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}