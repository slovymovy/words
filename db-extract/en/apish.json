                "translations": [
                    {
                        "translation_id": "f9b2e18d-518c-4cfc-a951-35d46c56ffe7",
                        "source_entry_id": "c17288ab-5210-3f7c-9215-211c91711f9b",
                        "source_sense_id": "e2f25a7a-962c-33a6-92e6-fe14ab6fa28c",
                        "source_sense_description": "resembling or characteristic of an ape",
                        "target_lang_word": "affig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "affig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fef6637-d99f-386b-82c8-c021a794f133",
                                        "entry_id": "c1c5e451-dc0c-3619-bb37-26b57ab5e788",
                                        "glosses": [
                                            "übertrieben auf das Äußere und die Wirkung auf andere Menschen bedacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30a26fdd-8036-4575-ac96-7c2ac3b13419",
                                                "sense_id": "6fef6637-d99f-386b-82c8-c021a794f133",
                                                "text": "Erik Göller als affig schöner Sigismund ist ein Schrei."
                                            },
                                            {
                                                "example_id": "ab729d45-a23f-4d3d-9818-dde6e44dc6a8",
                                                "sense_id": "6fef6637-d99f-386b-82c8-c021a794f133",
                                                "text": "Während aber Magenta und Max vor einer halben Ewigkeit mit viel Wiener Schmäh und einem mit losen Beinen baumelnden Plüsch-Taschen-Schaf ihr menschelnde \"TXO\"-Bleibe bezogen haben, ziehen die Traumjob-Kandidaten mit superkurzen Minis und affigem Imponiergehabe schwer bewaffnet in die Schlacht."
                                            },
                                            {
                                                "example_id": "241af7ba-47a6-4c57-bdb1-6a2078e869eb",
                                                "sense_id": "6fef6637-d99f-386b-82c8-c021a794f133",
                                                "text": "Mit bewundernswerter Chuzpe hat Hollywood die ganze Mainstream-Routine der kommenden Kinosaison in dieses Filmfestival gestopft: von Heath Ledger, der in Lasse Hallströms Casanova als affiger Seidenstrumpf-Verführer durch eine disneyfizierte Lagunenstadt tölpelt, …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d8864154-1b96-3864-9223-291573aab87a",
                                        "entry_id": "c1c5e451-dc0c-3619-bb37-26b57ab5e788",
                                        "glosses": [
                                            "töricht in der Handlungsweise oder lächerlich im Erscheinungsbild"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30be0483-f5c0-42b9-a21a-f992c4b11384",
                                                "sense_id": "d8864154-1b96-3864-9223-291573aab87a",
                                                "text": "Den Namen „Duden-Newsletter“ für einen Rundbrief über die deutsche Sprache affig zu nennen wäre eine Beleidigung für die Affen."
                                            },
                                            {
                                                "example_id": "0ab954de-4feb-47cf-bee4-e11f4df0bedb",
                                                "sense_id": "d8864154-1b96-3864-9223-291573aab87a",
                                                "text": "In den charaktertypischen Namen wie Hausarzt Bock (Erik Göller), Hausfreund Schön (Franz Solar), Idealist Horch (Dominik Warta mit affiger Perücke) und Witwe Zart (Monique Schwitter) klingt Nestroys ironische Etikettierung durch."
                                            },
                                            {
                                                "example_id": "a96e7186-32a8-47ea-92fa-bbe21a7a2dbc",
                                                "sense_id": "d8864154-1b96-3864-9223-291573aab87a",
                                                "text": "„Zu Hause erklärte er seiner Mutter, sie seien affig angezogen und er wolle nicht anders aussehen wie die andern Kinder, denn das wäre eine Schande.“"
                                            },
                                            {
                                                "example_id": "8c459e8a-8093-464c-906d-e3857d4be3d8",
                                                "sense_id": "d8864154-1b96-3864-9223-291573aab87a",
                                                "text": "„›Nein,‹ sagte Betti, ›wie kann ein Mensch so affig sein und den Franzosen solche Fratzen nachmachen wie Herr Kleines?‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a6a1cc86-b822-3d16-9082-d2182687c083",
                                        "entry_id": "c1c5e451-dc0c-3619-bb37-26b57ab5e788",
                                        "glosses": [
                                            "künstlich in der Art, Gefühle zu äußern oder darzustellen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09d24e9a-7a5c-4714-9f49-209ddbbc3166",
                                                "sense_id": "a6a1cc86-b822-3d16-9082-d2182687c083",
                                                "text": "Johannes Lang muss den affigen Schwulen mimen, ohne den es heute offenbar nicht mehr geht."
                                            },
                                            {
                                                "example_id": "4f3ea9ff-1d3b-4c01-b675-52ac4439e6b0",
                                                "sense_id": "a6a1cc86-b822-3d16-9082-d2182687c083",
                                                "text": "Bei Johns Freund Graham ist es die geradezu affige Geziertheit."
                                            },
                                            {
                                                "example_id": "584394d7-417c-47d0-8146-917583cc791a",
                                                "sense_id": "a6a1cc86-b822-3d16-9082-d2182687c083",
                                                "text": "„›Und nicht affig. Sie ist aufrichtig, sie paßt mir sehr gut.‹“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "68a31813-d026-3aad-aa35-ca9b1844da64",
                                        "entry_id": "c1c5e451-dc0c-3619-bb37-26b57ab5e788",
                                        "glosses": [
                                            "im Benehmen wie ein Affe"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93561da1-1b64-4032-ae7c-544d3f06d8f1",
                                                "sense_id": "68a31813-d026-3aad-aa35-ca9b1844da64",
                                                "text": "Sie halten Araber für affige Wilde, für unmündige Menschen dritter Klasse, an die man noch keine aufklärerisch-humanen Maßstäbe anlegen darf."
                                            },
                                            {
                                                "example_id": "9f084d36-e2f5-49ed-a375-01099deb836d",
                                                "sense_id": "68a31813-d026-3aad-aa35-ca9b1844da64",
                                                "text": "Wer jetzt keinen besitzt, kann nur noch kapitulieren oder darauf hoffen, dass auch diese Konsumhysterie alsbald vorüberziehen möge, mitsamt dieser ständigen Werbung mit den affig tanzenden Silhouetten und ihren weißen Drähten."
                                            },
                                            {
                                                "example_id": "43bb19a7-4fe4-4b25-add4-5de60996979e",
                                                "sense_id": "68a31813-d026-3aad-aa35-ca9b1844da64",
                                                "text": "Vielleicht ist auch einfach mehr Affiges im Menschen als Menschenähnliches im Affen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60884a8e-1ff3-422d-b497-41ef20dc4a75",
                        "source_entry_id": "c17288ab-5210-3f7c-9215-211c91711f9b",
                        "source_sense_id": "e2f25a7a-962c-33a6-92e6-fe14ab6fa28c",
                        "source_sense_description": "resembling or characteristic of an ape",
                        "target_lang_word": "äffisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "äffisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "454c23ed-cde2-360a-922c-97661d2158f4",
                                        "entry_id": "eca029a5-f5cc-3b08-8691-8a39b36f681a",
                                        "glosses": [
                                            "wie ein Affe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18de6d71-6889-4831-b4cd-e7a0cd365710",
                                                "sense_id": "454c23ed-cde2-360a-922c-97661d2158f4",
                                                "text": "Äffischer kann man sich ja kaum noch benehmen!"
                                            },
                                            {
                                                "example_id": "126ba692-5bb7-4fde-8443-81627d1040c2",
                                                "sense_id": "454c23ed-cde2-360a-922c-97661d2158f4",
                                                "text": "Dies sah aber bei dem feierlichen Ernst, den er annahm, so possierlich aus, zumal da er äffische Possenkleider an hatte, daß Männer und Frauen laut lachen mußten, so ernsthaft auch die Freude des Tages war."
                                            },
                                            {
                                                "example_id": "bfad1d9a-2281-4697-ab30-bd683cca8532",
                                                "sense_id": "454c23ed-cde2-360a-922c-97661d2158f4",
                                                "text": "Während diese auf \"menschliche\" Musik so gut wie nicht reagierten, führten die äffischen Kompositionen Teils zu den erwarteten Ergebnissen: Musik aus Angstlauten machte die Lisztaffen ängstlich und vice versa."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6428dced-58ba-3b9b-9729-7a9512c63d45",
                                        "entry_id": "eca029a5-f5cc-3b08-8691-8a39b36f681a",
                                        "glosses": [
                                            "(vor allem in der Evolutionsbiologie) auf den Affen bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de4f857c-82a4-40e8-bcba-c2b67e5cbe58",
                                                "sense_id": "6428dced-58ba-3b9b-9729-7a9512c63d45",
                                                "text": "Während diese auf \"menschliche\" Musik so gut wie nicht reagierten, führten die äffischen Kompositionen Teils zu den erwarteten Ergebnissen: Musik aus Angstlauten machte die Lisztaffen ängstlich und vice versa."
                                            },
                                            {
                                                "example_id": "16abaf20-25eb-45df-812b-59d9415f62de",
                                                "sense_id": "6428dced-58ba-3b9b-9729-7a9512c63d45",
                                                "text": "Die Affennatur raste, sich überkugelnd, aus mir hinaus und weg, so daß mein erster Lehrer selbst davon fast äffisch wurde, bald den Unterricht aufgeben und in eine Heilanstalt gebracht werden mußte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
