                        "entry_id": "dd009d35-b59b-3edf-878e-413229d9339b",
                        "glosses": [
                            "pierożek w tradycyjnej kuchni żydowskiej, z nadzieniem z wołową wątróbką, podawany w rosole lub barszczu, przygotowywany zwykle na Święto Szałasów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d1a487-6711-4686-a9e2-60e257b03da0",
                                "sense_id": "2ee49948-42aa-3f86-ad55-2884da26b2cb",
                                "text": "Kreplachy można przyrządzać na wiele sposobów – wybór farszu zależy od naszych upodobań"
                            },
                            {
                                "example_id": "ca06fbe4-ca04-4a8e-8040-d7e23b5c1bde",
                                "sense_id": "2ee49948-42aa-3f86-ad55-2884da26b2cb",
                                "text": "Pierogi żydowskie, nazywane również kreplachami, to tradycyjna potrawa kuchni żydowskiej"
                            }
                        ],
