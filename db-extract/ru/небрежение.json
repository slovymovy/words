                    {
                        "form_id": "5fca4498-532d-4552-b2ff-b8f839cc77bb",
                        "entry_id": "0de69c78-0fc9-3e21-b594-f3c67f1abeb3",
                        "tags": [
                            "singular",
                            "prepositional"
                        ],
                        "form": "небреже́нии"
                    },
                    {
                        "form_id": "2dfce0cf-bb7f-4380-b3f6-6524e9470bec",
                        "entry_id": "0de69c78-0fc9-3e21-b594-f3c67f1abeb3",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "небреже́ниях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7eed1354-b303-30e2-af58-4af1253ff4de",
                        "entry_id": "0de69c78-0fc9-3e21-b594-f3c67f1abeb3",
                        "glosses": [
                            "устар., книжн. нерадивое, недобросовестное отношение к чему-либо; небрежность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75ece666-8cbb-445e-9113-0b6f56ceebdc",
                                "sense_id": "7eed1354-b303-30e2-af58-4af1253ff4de",
                                "text": "Нил Павлович сперва лишь качал головою; потом стал пожимать плечами, а наконец без шуток начал журить Правина за его небрежение к службе."
                            },
                            {
                                "example_id": "82f2b377-9021-4b75-aab9-cf477cc72e36",
                                "sense_id": "7eed1354-b303-30e2-af58-4af1253ff4de",
                                "text": "Поэтому я никогда и не рассуждаю, а только огорчаюсь, когда вижу людей, относящихся к обязанностям своим с небрежением."
                            }
                        ]
                    },
                    {
                        "sense_id": "70e75b4f-305a-331b-afa3-ffdfc8874281",
                        "entry_id": "0de69c78-0fc9-3e21-b594-f3c67f1abeb3",
                        "glosses": [
                            "устар. невнимание, пренебрежение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43862733-2805-4759-9c01-6c47c79efa67",
                                "sense_id": "70e75b4f-305a-331b-afa3-ffdfc8874281",
                                "text": "Он на́скоро вы́хлебнул ча́шку, отказа́лся от второ́й и ушёл опя́ть за воро́та в како́м-то беспоко́йстве: явно бы́ло, что старика́ огорча́ло небреже́ние Печо́рина, и тем бо́лее, что он мне неда́вно говори́л о свое́й с ним дру́жбе и ещё час тому́ наза́д был уве́рен, что он прибежи́т, как то́лько услы́шит его́ и́мя."
                            },
                            {
                                "example_id": "e38f9dd6-33a7-459c-899f-c8790969ea10",
                                "sense_id": "70e75b4f-305a-331b-afa3-ffdfc8874281",
                                "text": "За такое небрежение к своему здоровью объявляю тебе строгий выговор…"
                            }
                        ]
                    },
                    {
                        "sense_id": "46ce4002-9a05-334f-b2b7-ad1ab86bb5b6",
                        "entry_id": "0de69c78-0fc9-3e21-b594-f3c67f1abeb3",
                        "glosses": [
                            "состояние запущенности, заброшенности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4593ed5-ff88-4a9e-b49a-0c6c9de638db",
                                "sense_id": "46ce4002-9a05-334f-b2b7-ad1ab86bb5b6",
                                "text": "Вошед в комнату, я тотчас узнал картинки, изображающие историю блудного сына; стол и кровать стояли на прежних местах; но на окнах уже не было цветов, и все кругом показывало ветхость и небрежение."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50ae4f5d-db82-44a5-81c7-51ea63c89740",
                        "source_entry_id": "0de69c78-0fc9-3e21-b594-f3c67f1abeb3",
                        "source_sense_description": "нерадивое, недобросовестное отношение",
                        "target_lang_word": "neglect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neglect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eef0f0ab-b8d9-342b-a658-02eafca6c3b6",
                                        "entry_id": "9de53191-581b-362f-b2f2-455eb2936788",
                                        "glosses": [
                                            "To fail to care for or attend to something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06a5a0be-ff33-49ed-82e9-782c71696a9e",
                                                "sense_id": "eef0f0ab-b8d9-342b-a658-02eafca6c3b6",
                                                "text": "to neglect duty or business;  to neglect to pay debts"
                                            },
                                            {
                                                "example_id": "4714ef76-43a7-4917-8b9e-f98f3c3cfe8a",
                                                "sense_id": "eef0f0ab-b8d9-342b-a658-02eafca6c3b6",
                                                "text": "I hope\n My absence doth neglect no great designs."
                                            },
                                            {
                                                "example_id": "3573f8ae-9458-41cd-ad48-d0c7d50a9acf",
                                                "sense_id": "eef0f0ab-b8d9-342b-a658-02eafca6c3b6",
                                                "text": "This, my long sufferance and my day of grace,\n Those who neglect and scorn, shall never taste."
                                            },
                                            {
                                                "example_id": "dad02e2f-efab-4d82-a321-af4a7b3392b9",
                                                "sense_id": "eef0f0ab-b8d9-342b-a658-02eafca6c3b6",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains.[…]But out of sight is out of mind. And that, together with the inherent yuckiness of the subject, means that many old sewers have been neglected and are in dire need of repair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e195d216-26f9-3f8d-ab6f-eabafcd201c3",
                                        "entry_id": "9de53191-581b-362f-b2f2-455eb2936788",
                                        "glosses": [
                                            "To omit to notice; to forbear to treat with attention or respect; to slight."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a34b57e-ee8f-47de-9f48-55f989fcc2af",
                                                "sense_id": "e195d216-26f9-3f8d-ab6f-eabafcd201c3",
                                                "text": "to neglect strangers"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caabf15c-01d3-3f6d-beb4-27ddf585cbaa",
                                        "entry_id": "9de53191-581b-362f-b2f2-455eb2936788",
                                        "glosses": [
                                            "To fail to do or carry out something due to oversight or carelessness."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcaaea1c-58b5-493a-ae30-8b26c75a31bb",
                                                "sense_id": "caabf15c-01d3-3f6d-beb4-27ddf585cbaa",
                                                "text": "A friend of mine who runs an intellectual magazine was grousing about his movie critic, complaining that though the fellow had liked The Godfather (page 58), he had neglected to label it clearly as a masterpiece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3686bace-4f37-3aba-8c2c-481e868808e1",
                                        "entry_id": "9de53191-581b-362f-b2f2-455eb2936788",
                                        "glosses": [
                                            "To ignore for the sake of simplifying calculations without significantly affecting accuracy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8944114-2196-44bf-97e5-0cb720233810",
                                                "sense_id": "3686bace-4f37-3aba-8c2c-481e868808e1",
                                                "text": "We can neglect this term, as it approaches zero in the limit anyway."
                                            },
                                            {
                                                "example_id": "64b8d441-f619-4330-8114-b922418ff89f",
                                                "sense_id": "3686bace-4f37-3aba-8c2c-481e868808e1",
                                                "text": "This problem says to neglect air resistance."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neglect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f301e6f-1370-3420-9b23-25669d959ef4",
                                        "entry_id": "db16befb-b3fc-33a1-92f3-02ea5b77e88d",
                                        "glosses": [
                                            "The act of neglecting."
                                        ],
                                        "tags": [
                                            "countable",
