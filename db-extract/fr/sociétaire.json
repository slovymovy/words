                        "sense_id": "72609398-9448-315b-8e43-4373b0243073",
                        "entry_id": "4b5f316f-d0a5-30e4-80ca-ef11ed4ff506",
                        "glosses": [
                            "Personne qui fait partie d’une société, en parlant de certaines sociétés littéraires, musicales, etc., de certaines entreprises dramatiques, ou de mutuelles (d’assurance ou de banque en particulier)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3b61e5b-5678-49ed-8ea1-175ff33db53e",
                                "sense_id": "72609398-9448-315b-8e43-4373b0243073",
                                "text": "Cet acteur n’est point sociétaire, il n’est que pensionnaire."
                            },
                            {
                                "example_id": "df75692a-4606-4410-ad1d-5e9b8485374d",
                                "sense_id": "72609398-9448-315b-8e43-4373b0243073",
                                "text": "La Société des Gens de lettres comprend des adhérents et des sociétaires."
                            },
                            {
                                "example_id": "091599e1-f5d3-403b-a721-aeb88579972c",
                                "sense_id": "72609398-9448-315b-8e43-4373b0243073",
                                "text": "Les sociétaires soumis à l’assurance obligatoire auront à supporter deux tiers du montant des cotisations, l'autre tiers est à la charge du patron."
                            },
                            {
                                "example_id": "e857697b-f0e2-410e-b657-792b5bd88838",
                                "sense_id": "72609398-9448-315b-8e43-4373b0243073",
                                "text": "Le front soudé à sa poitrine, je me laissais gagner, tout en l’étreignant, par une curieuse somnolence. Elle avait en effet cette blondeur confortable de certaines sociétaires de la Comédie-Française que je voyais jouer le dimanche en matinée."
                            }
                        ]
                    },
                    {
                        "sense_id": "c89e732c-b1a4-3d6f-84b2-7c8afa4ee120",
                        "entry_id": "4b5f316f-d0a5-30e4-80ca-ef11ed4ff506",
                        "glosses": [
                            "Membre d'un club (les clubs se nomment sociétés en Anjou). Se dit en particulier pour les membres des sociétés de boule de fort."
                        ],
                        "tags": [
                            "Anjou"
                        ],
                        "examples": []
                    }
                ],
