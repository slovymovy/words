                    "sense_id": "6378c0c0-0774-372a-a90b-0554cfd6d252",
                    "sense_definition": "Eén enkele keer; niet vaker.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft die vergissing slechts <w>eenmaal</w> gemaakt.",
                            "target_lang_translations": {
                                "en": "He made that mistake only <w>once</w>.",
                                "ru": "Он совершил эту ошибку всего <w>один раз</w>.",
                                "pl": "Popełnił ten błąd tylko <w>raz</w>.",
                                "de": "Er hat diesen Fehler nur <w>einmal</w> gemacht.",
                                "fr": "Il n'a fait cette erreur qu'<w>une fois</w>.",
                                "it": "Ha commesso quell'errore solo <w>una volta</w>.",
                                "cs": "Tuto chybu udělal pouze <w>jednou</w>.",
                                "tr": "O hatayı sadece <w>bir kez</w> yaptı.",
                                "es": "Cometió ese error solo <w>una vez</w>.",
                                "zh": "他那个错误只犯了<w>一次</w>。"
                            }
                        },
                        {
                            "text": "Ik ben slechts <w>eenmaal</w> in Parijs geweest.",
                            "target_lang_translations": {
                                "en": "I have been to Paris only <w>once</w>.",
                                "ru": "Я был в Париже всего <w>один раз</w>.",
                                "pl": "Byłem w Paryżu tylko <w>raz</w>.",
                                "de": "Ich bin nur <w>einmal</w> in Paris gewesen.",
                                "fr": "Je ne suis allé à Paris qu'<w>une fois</w>.",
                                "it": "Sono stato a Parigi solo <w>una volta</w>.",
                                "cs": "V Paříži jsem byl pouze <w>jednou</w>.",
                                "tr": "Paris'te sadece <w>bir kez</w> bulundum.",
                                "es": "He estado en París solo <w>una vez</w>.",
                                "zh": "我只去过巴黎<w>一次</w>。"
                            }
                        }
                    ],
                    "synonyms": [
