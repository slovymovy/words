                    {
                        "sense_id": "b0f951f0-4ed9-369e-a200-31f477daddc7",
                        "entry_id": "707b5283-d251-3050-afc6-a44ab4d71da8",
                        "glosses": [
                            "De couleur chair."
                        ],
                        "tags": [
                            "Fleuriste"
                        ],
                        "examples": [
                            {
                                "example_id": "9752c096-f837-467b-ac53-e608094a0b10",
                                "sense_id": "b0f951f0-4ed9-369e-a200-31f477daddc7",
                                "text": "Un œillet carné."
                            }
                        ]
                    },
                    {
                        "sense_id": "552c8a7f-2141-3587-a1d8-ba11da15a677",
                        "entry_id": "707b5283-d251-3050-afc6-a44ab4d71da8",
                        "glosses": [
                            "Qui se compose de viande (en parlant d'alimentation)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d28bb9d6-c52f-4df4-9ebe-f8921a07c0fb",
                                "sense_id": "552c8a7f-2141-3587-a1d8-ba11da15a677",
                                "text": "J’avais repoussé dès l’époque du sevrage tout élément carné ; mon père respecta ce refus. On me nourrit bien, mais autrement."
                            },
                            {
                                "example_id": "e00f00d9-b9ea-46ff-80c6-27e08079d4b8",
                                "sense_id": "552c8a7f-2141-3587-a1d8-ba11da15a677",
                                "text": "D'autres ont vu dans l'alimentation carnée un véritable enjeu éthique, et ce, dès l'Antiquité."
                            },
                            {
                                "example_id": "2fceb1bc-8585-4ecf-bed0-0d47ee7c303e",
                                "sense_id": "552c8a7f-2141-3587-a1d8-ba11da15a677",
                                "text": "La société pourrait décider d’un modèle alimentaire moins carné qui conduirait à réduire l’élevage, et à étendre en conséquence les surfaces céréalières et maraîchères."
                            }
                        ]
                    }
