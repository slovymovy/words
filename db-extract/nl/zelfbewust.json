                        "target_lang_word": "self-aware",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-aware",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b29d4e9e-6df2-3ac0-9e88-3e5f92c0cd9d",
                                        "entry_id": "080b78e9-064b-3b37-96ab-e2fa0073b223",
                                        "glosses": [
                                            "Aware of oneself as an individual that exists in the real world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd5b58ab-69b6-4999-90f1-9fb49637241b",
                                                "sense_id": "b29d4e9e-6df2-3ac0-9e88-3e5f92c0cd9d",
                                                "text": "The robot didn't just resemble a human girl: she was self-aware and conscious as well."
                                            },
                                            {
                                                "example_id": "0505c9e6-9307-48cd-a4a6-a0f13621c66a",
                                                "sense_id": "b29d4e9e-6df2-3ac0-9e88-3e5f92c0cd9d",
                                                "text": "The time has come. According to the Terminator clock, at 8:11 p.m. Tuesday, Skynet will become self-aware. And humanity will be screwed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0ac365-b64d-3dd3-9c94-21db0980cd86",
                                        "entry_id": "080b78e9-064b-3b37-96ab-e2fa0073b223",
                                        "glosses": [
                                            "Cognizant of one's appearances, shortcomings, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd5bcf33-23d8-4438-ae56-1208268c9a8c",
                                                "sense_id": "6e0ac365-b64d-3dd3-9c94-21db0980cd86",
                                                "text": "The video is a self-aware parody of the trend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
