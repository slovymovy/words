                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a9c8da-a455-4fb4-a0b7-b33fcf438b1e",
                                                "sense_id": "6cdc4ea3-3a71-3766-aac7-e7e2fbfd0884",
                                                "text": "W architekturze nowożytnej spotkać można również frontony stanowiące segment kręgu, półowalne, przerywane lub gierowane."
