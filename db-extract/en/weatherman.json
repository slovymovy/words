                                        "glosses": [
                                            "Laubfrosch, der in einem Glas gehalten wird und durch seine Position auf einer Leiter das Wetter vorhersagen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb19a495-41aa-424f-96b7-e4043444fce2",
                                                "sense_id": "da247b2f-63d8-318e-85af-45c915e0a652",
                                                "text": "Wetterfrösche sagen das Wetter nicht wirklich voraus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea655166-e4b3-3a09-ba2f-1768baefe887",
                                        "entry_id": "fdafa444-60d5-3e47-adee-8bbab406ec5d",
                                        "glosses": [
                                            "Meteorologe; Person, die eine Wettervorhersage moderiert oder sich für das Wetter interessiert"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9467fab1-d84e-4a7a-b8a3-1eb47ecf01ed",
                                                "sense_id": "ea655166-e4b3-3a09-ba2f-1768baefe887",
                                                "text": "Die Wetterfrösche im Fernsehen haben für das Wochenende Regen vorhergesagt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7863429-345e-47d5-a9de-c0dae3da5889",
                        "source_entry_id": "6f22183a-d4b5-39d1-a596-ae4c1f9fb3b8",
                        "source_sense_id": "27a1b2b8-0981-3a90-bd19-90b3cb9c15d6",
                        "source_sense_description": "weather forecaster",
                        "target_lang_word": "Meteorologe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meteorologe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                                        "entry_id": "f55dc01d-2448-327c-ba4b-386d5e6b84fe",
                                        "glosses": [
                                            "Person, die in der Meteorologie ausgebildet und bewandert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "559f58be-dd03-48e6-9ec9-6e7d9350d0bb",
                                                "sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                                                "text": "„Heute Abend warnte der Meteorologe vor einem drohenden Unwetter im Norden.“"
                                            },
                                            {
                                                "example_id": "f8936054-8c18-45d9-aae6-d7bb475a83bd",
                                                "sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                                                "text": "„Kreuzwinde, Sturm, Hagel, Seitenwinde, was Meteorologen lieben, Piloten spannend finden und Touristen hassen: All das gibt es hier, im minütlichen Wechsel.“"
                                            },
                                            {
                                                "example_id": "9fab8369-b9d8-44b7-bf1d-4e09db824e26",
                                                "sense_id": "9c6953f4-f065-3ed5-b26d-7034294a45fc",
                                                "text": "„Und als richtigen Eistag, an dem die Temperatur nicht über null Grad steigt, haben die Meteorologen nur einen einzigen Tag zu bieten, den 30. Januar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
