                                        "glosses": [
                                            "aus fünf Knochen bestehender sowie zwischen den Zehen und der Fußwurzel liegender mittlerer Teil des Fußes von Menschen und Wirbeltieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "597c645f-c84f-4f58-ab63-5529d85e118c",
                                                "sense_id": "bc0f710e-8dc2-31eb-a8f4-5ec3bfb4155b",
                                                "text": "Der Verteidiger des Heimmannschaft hat sich beim letzten Turnier den Mittelfuß gebrochen."
