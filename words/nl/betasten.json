                        "voorzichtig betasten"
                    ],
                    "target_lang_definitions": {
                        "en": "To touch someone's body or an object with the hands to feel it, often in an unwanted or intimate way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grope",
                                "target_lang_sense_clarification": "to touch someone sexually and inappropriately without consent"
                            },
                            {
                                "target_lang_word": "feel up",
                                "target_lang_sense_clarification": "to touch someone sexually in an unwanted or informal manner"
                            },
                            {
                                "target_lang_word": "pat down",
                                "target_lang_sense_clarification": "to search someone for weapons or contraband by running hands over their clothes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1100dfbe-af08-3057-9519-d2cf6fbd6d70",
                    "sense_definition": "Door tasten onderzoeken of voelen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
