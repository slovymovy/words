                                "example_id": "2ea0a8d6-fec3-4a78-aefc-8ec65cc97bd4",
                                "sense_id": "bc54bae1-4701-3fec-b7b9-2798afebc198",
                                "text": "„Er trug eine kleine Lederweste und eine merkwürdige Kopfbedeckung, die entfernt an eine Schiffermütze erinnerte.“"
                            }
