                        "entry_id": "2178d3bd-ddd2-3c3e-96ca-0fc0ebcbdc7e",
                        "glosses": [
                            "A list of people or things that are assigned to receive special attention or monitoring."
                        ],
                        "tags": [],
                        "examples": [
