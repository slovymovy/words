                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c596dae5-e08a-4af5-9dd8-2529336bb7e8",
                                "sense_id": "6159460f-11e7-326e-a896-c8a5f87836e3",
                                "text": "Mówiąc łachmaniarz, łachmyta, obdartus, łachudra, oberwaniec, obrzępała czy obszarpaniec wyrażamy dezaprobatę wobec źle, biednie lub brudno odzianych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
