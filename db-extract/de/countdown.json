                                    {
                                        "sense_id": "e321766d-e670-3eb1-8c33-25c40bc3f15f",
                                        "entry_id": "095751a3-7d4c-3d61-a260-d76706eb70a9",
                                        "glosses": [
                                            "A count backward in fixed units to the time of some event, especially the launch of a space vehicle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "905b557a-145d-36be-82e5-81495388d0b5",
                                        "entry_id": "095751a3-7d4c-3d61-a260-d76706eb70a9",
                                        "glosses": [
                                            "The acts of preparation carried out during this period."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5437b74-6cec-3d50-bdc9-aec747287fd5",
                                        "entry_id": "095751a3-7d4c-3d61-a260-d76706eb70a9",
                                        "glosses": [
                                            "A radio or television program counting down the top songs of a given week, usually in reverse order and ending with the number one song."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "countdown",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2dec3a03-a77e-3fd3-a575-52c5542aa9e3",
                                        "entry_id": "9bebc396-3779-3e09-9bf3-d54d2702dfbb",
                                        "glosses": [
                                            "To count down."
                                        ],
                                        "tags": [
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62564846-72c3-4a2b-862c-e13914d15499",
                                                "sense_id": "2dec3a03-a77e-3fd3-a575-52c5542aa9e3",
                                                "text": "This was accomplished in the old system by polling a software variable representing the number of prebleach bin and issuing a software command to trigger the AOM once the variable has countdowned to zero."
                                            },
                                            {
                                                "example_id": "37e5bf32-7cd6-4640-a9f5-7827da4c600e",
                                                "sense_id": "2dec3a03-a77e-3fd3-a575-52c5542aa9e3",
                                                "text": "Time measures itself out in a series of diminishing peristaltic ticks, countdowning slowly towards the miracle of Ignition."
                                            },
                                            {
                                                "example_id": "67d48382-f693-4432-ad8b-f340c0ffc118",
                                                "sense_id": "2dec3a03-a77e-3fd3-a575-52c5542aa9e3",
                                                "text": "Whole families stood gawking at the massive statue, countdowning the five remaining minutes to the big one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
