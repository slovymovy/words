                        "glosses": [
                            "Qualifie une couleur verte comme celle des bouteilles de vin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0d1c45d-9ca7-4619-82f7-f0808afaaffa",
                                "sense_id": "d8d3028d-1ef4-33f7-a13b-ca25e4c188d1",
                                "text": "Laurence avait une amazone vert-bouteille pour se promener à cheval, une robe en étoffe commune à canezou orné de brandebourgs pour aller à pied, et chez elle une robe de chambre en soie."
                            },
                            {
                                "example_id": "a14b0cb0-da7e-4428-9cfd-2e12aba86e04",
                                "sense_id": "d8d3028d-1ef4-33f7-a13b-ca25e4c188d1",
                                "text": "L’essai reste gris teinté de vert, vert-bouteille ou jaunâtre."
                            },
                            {
                                "example_id": "84686e8c-5e09-4238-a930-248c5da559ad",
                                "sense_id": "d8d3028d-1ef4-33f7-a13b-ca25e4c188d1",
                                "text": "C’est certainement très-joli, mais ça n’est pas chaud, la soie vert-bouteille."
                            }
                        ]
                    }
