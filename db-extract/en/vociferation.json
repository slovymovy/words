                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "e3131438-b4ee-3ddc-a1e1-6ce214692002",
                                        "entry_id": "35c7e782-f604-3bb1-a7bf-ee6c14cb3918",
                                        "glosses": [
                                            "głośne wołanie lub nieartykułowane dźwięki"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b86b7f-9bc6-47b3-b8f0-2d3a042282c1",
                                                "sense_id": "e3131438-b4ee-3ddc-a1e1-6ce214692002",
