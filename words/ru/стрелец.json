                {
                    "sense_id": "62f65e21-af36-3859-a779-456b8f6e804f",
                    "sense_definition": "Человек, родившийся под зодиакальным знаком Стрельца (с 22 ноября по 21 декабря).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "astrology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой брат — типичный <w>Стрелец</w>, он просто обожает путешествия и новые приключения.",
                            "target_lang_translations": {
                                "en": "My brother is a typical <w>Sagittarius</w>; he simply adores traveling and new adventures."
                            }
                        },
                        {
                            "text": "По гороскопу она родилась в декабре, поэтому считает себя настоящим <w>Стрельцом</w>.",
                            "target_lang_translations": {
                                "en": "According to the horoscope, she was born in December, so she considers herself a true <w>Sagittarius</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "типичный Стрелец",
                        "родился под знаком Стрельца"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление в астрологическом контексте"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person born under the astrological sign of Sagittarius (November 22 – December 21)."
