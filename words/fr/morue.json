                    "frequency": "VeryLow",
                    "semantic_group_id": "morue_insulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce garçon superficiel a osé affirmer que sa camarade de classe était une vraie <w>morue</w>."
