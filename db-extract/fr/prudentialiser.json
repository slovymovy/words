                "senses": [
                    {
                        "sense_id": "2a95ca39-2f92-3e4f-9fd7-3ad2595f1498",
                        "entry_id": "7209a5f4-3a24-3dc7-8825-eb34e3eb3122",
                        "glosses": [
                            "Donner un caractère prudentiel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dde43e8-c309-4434-89d7-047702881ea0",
                                "sense_id": "2a95ca39-2f92-3e4f-9fd7-3ad2595f1498",
                                "text": "Les enquêtes sur les ressources locales découvriront de nombreuses ressources pieusement remisées et beaucoup de perdues pour motif de concurrence monétaire. Elles amélioreront sans cesse les services offerts aux candidats entrepreneurs et s’évertueront à « prudentialiser » la fourniture de matériaux et d’énergie."
                            },
                            {
                                "example_id": "7a8bc231-84f4-4b71-96ca-1666db83ada2",
                                "sense_id": "2a95ca39-2f92-3e4f-9fd7-3ad2595f1498",
                                "text": "Ils ont dérégulé, flexibilisé, décloisonné, titrisé, prudentialisé, swapé, cac-quarantéisé."
                            },
                            {
                                "example_id": "c85e116a-b0e8-4b9a-8e74-7c3098a554f6",
                                "sense_id": "2a95ca39-2f92-3e4f-9fd7-3ad2595f1498",
                                "text": "Il a été dit que le métier d assureur est un métier qui consiste à vendre des promesses encadrées et prudentialisées."
                            }
                        ]
                    }
                ],
