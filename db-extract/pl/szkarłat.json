                                        "sense_id": "106f9b5c-ee5d-340e-be09-18c4e944ea57",
                                        "entry_id": "b44c281b-28fe-3186-968d-46183a02c522",
                                        "glosses": [
                                            "A brilliant red colour sometimes tinged with orange."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aef1ac6d-cbf1-4c7d-863d-cfc1b3e6882c",
                                                "sense_id": "106f9b5c-ee5d-340e-be09-18c4e944ea57",
                                                "text": "Biblical criteria of sexual seductiveness include a white skin, black hair, or henna-dyed, scarlet lips, a prominent nose, rosy temples, long straight neck, firm breasts, round thighs, an erect posture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e64e14c-60b8-31e9-8763-2a76547aa1de",
                                        "entry_id": "b44c281b-28fe-3186-968d-46183a02c522",
                                        "glosses": [
                                            "Cloth of a scarlet color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e2b5e00-1586-4453-874f-87516e5a86d5",
                                                "sense_id": "0e64e14c-60b8-31e9-8763-2a76547aa1de",
                                                "text": "All her household are clothed with scarlet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scarlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6783eac1-a006-3b7b-8c96-9851e53f0249",
                                        "entry_id": "a0ce2903-6a90-3d35-8ca8-e55553f3ba12",
                                        "glosses": [
                                            "Of a bright red colour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dc4d354-ab2a-4d8b-84a8-e34a3e3cf1e4",
                                                "sense_id": "6783eac1-a006-3b7b-8c96-9851e53f0249",
                                                "text": "Breezes blowing from beds of iris quickened her breath with their perfume; she saw the tufted lilacs sway in the wind, and the streamers of mauve-tinted wistaria swinging, all a-glisten with golden bees; she saw a crimson cardinal winging through the foliage, and amorous tanagers flashing like scarlet flames athwart the pines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02ce1dcb-5968-3a74-9d8e-1a864848627d",
                                        "entry_id": "a0ce2903-6a90-3d35-8ca8-e55553f3ba12",
                                        "glosses": [
                                            "Sinful or whorish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b92c0eb-ce01-4012-917d-8aa413f2f18a",
                                                "sense_id": "02ce1dcb-5968-3a74-9d8e-1a864848627d",
                                                "text": "a scarlet woman"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6652866-5661-319e-a8b6-1ceb604508b1",
                                        "entry_id": "a0ce2903-6a90-3d35-8ca8-e55553f3ba12",
                                        "glosses": [
                                            "Blushing; embarrassed or mortified."
                                        ],
                                        "tags": [
                                            "Ireland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3f38a2f-f4c4-43e9-8ee9-abc7db1ccdee",
                                                "sense_id": "f6652866-5661-319e-a8b6-1ceb604508b1",
                                                "text": "He signed off our correspondence, “Well thank God for facemasks, cos I’m scarlet”."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scarlet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af373bc2-a8ec-3ed2-a118-ae55bdae0e0b",
                                        "entry_id": "a34cfd53-3455-3903-a500-c3e991ee00df",
                                        "glosses": [
                                            "To dye or tinge (something) with scarlet."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "857cb07a-8da3-45e0-b333-02931f49c180",
                                                "sense_id": "af373bc2-a8ec-3ed2-a118-ae55bdae0e0b",
                                                "text": "Forbeare; the aſhy paleneſſe of my cheeke / Is ſcarletted in ruddy flakes of vvrath: […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48802526-128b-411f-9731-f2c7f3a16f27",
                        "source_entry_id": "04b92572-2f80-3eeb-b913-ca7bf3e5709c",
                        "source_sense_id": "fa8930ae-d21d-3b99-b385-5bddc5387d88",
                        "target_lang_word": "Scharlach",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scharlach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6c8d55e-441d-313e-ae9d-f6fd364582d6",
                                        "entry_id": "4f9c6f4a-48c2-3e84-b9dd-f47e57b6bef7",
                                        "glosses": [
                                            "hellrote Farbe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c16fb0e9-983e-4519-842b-007ef366aedc",
                                                "sense_id": "c6c8d55e-441d-313e-ae9d-f6fd364582d6",
                                                "text": "In meiner Palette fehlt noch Scharlach."
                                            },
                                            {
                                                "example_id": "d7a5a20c-2c54-4e57-91d6-5a0d728fc461",
                                                "sense_id": "c6c8d55e-441d-313e-ae9d-f6fd364582d6",
                                                "text": "„Ein paar goldene Ohrringe und Bracelets von demselben Metalle, Halbstiefeln von Scharlach und der Alligatorhaut vollendeten das zierliche Äußere dieser interessanten Gestalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ada2f195-b974-3e27-bbf8-34473616f45f",
                                        "entry_id": "4f9c6f4a-48c2-3e84-b9dd-f47e57b6bef7",
                                        "glosses": [
                                            "rot gefärbter Stoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "138d77db-8b26-4dbd-9c8d-6c1fcb736c3f",
                                                "sense_id": "ada2f195-b974-3e27-bbf8-34473616f45f",
                                                "text": "„Ein paar goldene Ohrringe und Bracelets von demselben Metalle, Halbstiefeln von Scharlach und der Alligatorhaut vollendeten das zierliche Äußere dieser interessanten Gestalt.“"
                                            },
                                            {
                                                "example_id": "7c970203-592e-4939-903d-7bae62505cdd",
                                                "sense_id": "ada2f195-b974-3e27-bbf8-34473616f45f",
                                                "text": "Manche Bürgerkleider waren noch in Scharlach."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Scharlach",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a30b1d6d-16ba-3d58-ba86-09252a0d42b7",
                                        "entry_id": "508a695b-6c5a-387b-bd1a-edaac67b33f0",
                                        "glosses": [
                                            "fiebrige Krankheit mit rotem Hautausschlag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab7820e-5401-45b2-852f-874e7f685de1",
                                                "sense_id": "a30b1d6d-16ba-3d58-ba86-09252a0d42b7",
                                                "text": "Für Kleinkinder ist Scharlach eine gefährliche Krankheit."
                                            },
                                            {
                                                "example_id": "d727368b-f0dd-4b8c-9700-8abbb828ae98",
                                                "sense_id": "a30b1d6d-16ba-3d58-ba86-09252a0d42b7",
                                                "text": "„Die Abgabe von Lebensmitteln aus Verkaufsstätten, Häusern oder erforderlichenfalls aus einzelnen Ortsgebieten, in denen Scharlach, Diphtherie, Abdominaltyphus, Paratyphus, Ruhr, Flecktyphus, Blattern, Asiatische Cholera, Pest oder Ägyptische Augenentzündung aufgetreten ist, kann untersagt oder von bestimmten Vorsichten abhängig gemacht werden.“"
                                            },
                                            {
                                                "example_id": "8e2fd5be-34b8-4ed0-bebc-311949744029",
                                                "sense_id": "a30b1d6d-16ba-3d58-ba86-09252a0d42b7",
                                                "text": "„Der wichtigste Grund, auch heute noch Penicillin zu benutzen, sind die Komplikationen bei Scharlach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
