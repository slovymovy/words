                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c636c2f-5ddf-38bb-8b9c-759e91fa8dcd",
                                        "entry_id": "4d149d6c-daa5-3de6-9d19-a458b8bb7a3f",
                                        "glosses": [
                                            "jemand, der dem Opportunismus folgt, sich also der jeweiligen Lage anpasst, auch in ideologischer Hinsicht (dort negativ gewertet)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6d6b43-27ca-421f-8d13-a923b88d2a19",
                                                "sense_id": "3c636c2f-5ddf-38bb-8b9c-759e91fa8dcd",
                                                "text": "Es ist schwierig, mit Opportunisten zusammenzuarbeiten. Man weiß nie, woran man mit ihnen ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8468b273-c0f5-3f3c-884d-ceccf27d4a59",
                                        "entry_id": "4d149d6c-daa5-3de6-9d19-a458b8bb7a3f",
                                        "glosses": [
                                            "ein Erreger, der nur aufgrund besonderer Umstände zu einer Krankheit führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f55f9a9c-71fd-496a-a4f7-01448c2ff28e",
                                                "sense_id": "8468b273-c0f5-3f3c-884d-ceccf27d4a59",
                                                "text": "Legionella pneumophila zählt zu den Opportunisten, den fakultativ pathogenen Erregern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f83f5724-bb94-3ac5-8330-ac72d797965b",
                                        "entry_id": "4d149d6c-daa5-3de6-9d19-a458b8bb7a3f",
                                        "glosses": [
                                            "Anlegertyp, der Trends für seine Kapitalanlageentscheidungen nutzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d39c7a2-ae6c-48f8-a344-b7a45e2e5e6e",
                                                "sense_id": "f83f5724-bb94-3ac5-8330-ac72d797965b",
                                                "text": "Jetzt, wo die Märkte sehr sprunghaft sind, ist das Klima günstig für Opportunisten, die sich an technischen Indikatoren orientieren."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "fbf73d7e-17ef-3235-8cd9-eddfe214f13b",
                                        "entry_id": "4d149d6c-daa5-3de6-9d19-a458b8bb7a3f",
                                        "glosses": [
                                            "Anhänger einer Strömung in der Arbeiterbewegung, dessen Haltung aus ideologischer Sicht bürgerliche/kapitalistische Einflüsse widerspiegelt, Anhänger des Opportunismus"
                                        ],
                                        "tags": [
                                            "Marxismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a252e91-6b91-4e01-b19c-21f81257d6e1",
                                                "sense_id": "fbf73d7e-17ef-3235-8cd9-eddfe214f13b",
                                                "text": "„In der Diskussion über das Agrarprogramm forderten die Opportunisten Eduard David und Max Quarck die Unterstützung der Kleinbetriebe durch den kapitalistischen Staat in Form von Reformen, die sie als sozialistisch ausgaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
