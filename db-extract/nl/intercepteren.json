        "nl-extract.jsonl": [
            {
                "entry_id": "e0ed6e0b-8f80-3630-906f-3d387ee66b94",
                "word": "intercepteren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "51d0c0bb-5e47-3f58-b9a2-6d534dd37a63",
                        "entry_id": "e0ed6e0b-8f80-3630-906f-3d387ee66b94",
                        "glosses": [
                            "van berichten dat als ze op weg naar de ontvanger zijn gelezen worden door iemand die niet de beoogde ontvanger is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82e6f97e-5d88-4734-8261-85fac2731253",
                                "sense_id": "51d0c0bb-5e47-3f58-b9a2-6d534dd37a63",
                                "text": "De Jong benadrukt dat dit wezenlijk anders is dan afluisteren. ,,Bij intercepteren hoef je bijvoorbeeld geen afluisterapparatuur in iemands huis te plaatsen. Dat gaat om berichten die gewoon over het internet of via satellieten gaan. In theorie kan het ook zo zijn dat mensen fysiek geobserveerd zijn.’’"
                            },
                            {
                                "example_id": "2228a477-0952-4c76-af98-3143672b2110",
                                "sense_id": "51d0c0bb-5e47-3f58-b9a2-6d534dd37a63",
                                "text": "⧖ De Marquis seer verblijdt zijnde sulcken soo florissante Armade te sien, alsmen, misschien by Menschen gedencken geen schoonder in Vlaendren had gesien (want sonder de Garnisoenen vande Frontier-plaetsen te reeckenen, soo maecktemen gissingh van dertigh duysent Man te Voet ende achtduysent Peerden) en liet daerom niet geduerigh in Actie te zijn, ende ghestadigh op zijn Belegeringe een waeckend oogh te houden; door alle middelen, poogende eenighe Brieven te intercepteren, om tijdinge van Prins Maurits aenslagen ende vande Belegherde te vernemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e71f0f8-d31f-3a6d-95c4-61096cbf16a5",
                        "entry_id": "e0ed6e0b-8f80-3630-906f-3d387ee66b94",
                        "glosses": [
                            "zorgen dat iets niet meer zijn weg kan vervolgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ba9ca94-be6f-4289-b2f3-a6e2a4fd6f75",
                                "sense_id": "5e71f0f8-d31f-3a6d-95c4-61096cbf16a5",
                                "text": "Twee Belgische F-16’s zijn maandagochtend vanop de luchtmachtbasis in Florennes opgestegen om Russische bommenwerpers te intercepteren die het Nederlandse luchtruim boven de Noordzee naderden. Dat gebeurde op Nederlands verzoek."
                            },
                            {
                                "example_id": "8e6cd2dc-7e6f-4d46-9d62-91390df63386",
                                "sense_id": "5e71f0f8-d31f-3a6d-95c4-61096cbf16a5",
                                "text": "Op 23/06 konden leden van de Politiezone K-L-M in Wolvertem, een voertuig intercepteren dat door de speurders al langere tijd in de gaten werd gehouden voor vermoedens van drughandel."
                            }
                        ]
                    }
