                "senses": [
                    {
                        "sense_id": "8163050e-4756-3d7b-9994-ede9570c0958",
                        "entry_id": "048aac09-ec37-3f16-9afc-10563ba76bc5",
                        "glosses": [
                            "L’ensemble des nègres."
                        ],
                        "tags": [
                            "collective",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "8d914126-7d22-41ea-87e5-b12c012fdc6c",
                                "sense_id": "8163050e-4756-3d7b-9994-ede9570c0958",
                                "text": "-Tu sens l’oignon frit, n’est-ce pas ? me dit-il avec une expressive contraction du nez.\n-Eh oui, sans doute, quelque chose comme ça !\n-Eh bien ! C’est la négraille qui a cette senteur-là, mon ami.\n-Quoi ! C’est ça l’odeur de nègre ?"
                            },
                            {
                                "example_id": "8785c0b4-9a3c-4560-8dbb-1b42eaad8453",
                                "sense_id": "8163050e-4756-3d7b-9994-ede9570c0958",
                                "text": "Vous savez qu’on nous observe et qu’on s’attend à ce que la négraille continue de faire rire, et plus fort qu’à l’accoutumée, à présent qu’aucune tutelle ne la maintient plus dans les limites de la décence…."
                            },
                            {
                                "example_id": "a86cf4f7-ccd0-45fe-949b-e4c0f4a092be",
                                "sense_id": "8163050e-4756-3d7b-9994-ede9570c0958",
                                "text": "Et elle est debout la négraille\nla négraille assise\ninattendument debout\ndebout dans la cale\ndebout dans les cabines"
                            }
                        ]
                    }
                ],
