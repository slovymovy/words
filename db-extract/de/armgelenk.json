                "senses": [
                    {
                        "sense_id": "67bfc5a2-5b05-3eef-b619-775d7dbebb0e",
                        "entry_id": "b5f6ffc0-0482-307d-9884-5be566d2f834",
                        "glosses": [
                            "zwischen Ober- und Unterarm befindliches Gelenk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33757ac2-bb8b-4660-8ab8-e2896e8c4438",
                                "sense_id": "67bfc5a2-5b05-3eef-b619-775d7dbebb0e",
                                "text": "„Gleichwohl führt der Stockeinsatz als solcher nicht zu geringeren Gelenksbelastungen im Vergleich zum normalen Gehen, wie Eberhard Schlömmer in einer wissenschaftlichen Untersuchung mit ausgefeilten Messmethoden mittels Drucksensoren am Fuss und Kraftsensoren am Armgelenk herausgefunden hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffb10158-d752-4c17-98f3-fcfe8335e191",
                        "source_entry_id": "b5f6ffc0-0482-307d-9884-5be566d2f834",
                        "source_sense_id": "67bfc5a2-5b05-3eef-b619-775d7dbebb0e",
