                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8abefa8-1499-46a3-bfc7-68a1755aa85b",
                                                "sense_id": "a019d1fb-953e-3386-bbde-29fe840d6496",
