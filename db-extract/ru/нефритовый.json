                    }
                ],
                "senses": [
                    {
                        "sense_id": "59cc7fc5-f6aa-3d5e-9fe0-3f9f42d86484",
                        "entry_id": "d1823ceb-e065-3898-942e-658f84c20c94",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным нефрит; свойственный, характерный для него"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a136a2f6-fd12-3494-89a8-33909d4eab8f",
                        "entry_id": "d1823ceb-e065-3898-942e-658f84c20c94",
                        "glosses": [
                            "сделанный из нефрита"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e683ed0-e230-488c-b118-4df084f097b2",
                                "sense_id": "a136a2f6-fd12-3494-89a8-33909d4eab8f",
                                "text": "Я здесь, например, видел впервые кораллового Амитаюса или среди чудных зеленых нефритовых табакерок ― табакерку из коралла, да ещё не одну, а целое собрание их. А сколько всякого рода нефритовых (зеленых, белых, светло-зеленых или, точнее, с зелеными прослойками, или молочного цвета), это просто не поддается описанию."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8eac9c2-806d-4f4f-8801-f0b73e39fe12",
                        "source_entry_id": "d1823ceb-e065-3898-942e-658f84c20c94",
                        "target_lang_word": "nephrite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nephrite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "932a0b39-af50-39d3-a291-33d952e17e55",
                                        "entry_id": "9f1ee4cb-83e6-36ef-97ed-bd95bf132ec6",
                                        "glosses": [
                                            "A semi-precious stone, one of the two types of stone commonly referred to as jade (the other being jadeite)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c229d799-1f4c-4f80-b568-25d26822b6b3",
                                                "sense_id": "932a0b39-af50-39d3-a291-33d952e17e55",
                                                "text": "Occurrences of nephrite are more numerous. China’s most important source throughout its history has been the region of Khotan (Ho-t‘ien) and Yarkand in Central Asia. In more recent times the Chinese have also imported nephrite from the neighbourhood of Lake Baikal in Eastern Siberia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aba830ec-5b6c-44b7-ab47-26edae6d7994",
                        "source_entry_id": "d1823ceb-e065-3898-942e-658f84c20c94",
                        "target_lang_word": "jade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0049d23d-be0c-3728-bdfb-5e54af90a891",
                                        "entry_id": "932dd731-0f57-326e-9356-97ecb3fe44b5",
                                        "glosses": [
                                            "A semiprecious stone, either nephrite or jadeite, generally green or white in color, often used for carving figurines."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0538e0f-3313-4490-b387-c5c5a4d49209",
                                                "sense_id": "0049d23d-be0c-3728-bdfb-5e54af90a891",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are diamond, ruby and sapphire, emerald and other gem forms of the mineral beryl, chrysoberyl, tanzanite, tsavorite, topaz and jade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e586fa3-d1b0-3483-80c4-9d27b483b214",
                                        "entry_id": "932dd731-0f57-326e-9356-97ecb3fe44b5",
                                        "glosses": [
                                            "A bright shade of slightly bluish or greyish green, typical of polished jade stones."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1bd7d82-feaa-3895-a93b-2a65da0cba1b",
                                        "entry_id": "932dd731-0f57-326e-9356-97ecb3fe44b5",
                                        "glosses": [
                                            "A succulent plant, Crassula ovata."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "jade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2868080-69b0-3d65-bc9e-ebba30f31c09",
                                        "entry_id": "7f5205e0-41a9-374d-a7ad-e7cb7ebe7e8e",
                                        "glosses": [
                                            "Of a grayish shade of green, typical of jade stones."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "jade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6036ff8c-fecf-3d1c-abed-302e6d8be100",
                                        "entry_id": "6e70a749-f716-3f73-ba4a-dc9be17587f5",
                                        "glosses": [
                                            "A horse too old to be put to work."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e005e8c-cb07-4723-9072-0de38f71e164",
                                                "sense_id": "6036ff8c-fecf-3d1c-abed-302e6d8be100",
                                                "text": "Shee hath more qualities then a Water-Spaniell, […] Shee can fetch and carry: why a horſe can doe no more; nay, a horſe cannot fetch, but onely carry, therefore is ſhee better then a Iade."
                                            },
                                            {
                                                "example_id": "bfa9c99e-6925-4689-ba1f-97b0c8795a12",
                                                "sense_id": "6036ff8c-fecf-3d1c-abed-302e6d8be100",
                                                "text": "[F]requent jot / Of his hard ſetting jade did ſo confound / The vvords that he by papyr-ſtealth had got, / That their loſt ſenſe the youngſter could not ſound, / Though he vvith mimical attention did abound."
                                            },
                                            {
                                                "example_id": "2848d0cb-37a9-48c2-b9ad-1604215cafce",
                                                "sense_id": "6036ff8c-fecf-3d1c-abed-302e6d8be100",
                                                "text": "Let that be as it may, as my purpoſe is to do exact juſtice to every creature brought upon the ſtage of this dramatic work,—I could not ſtifle this diſtinction in favour of Don Quixote’s horſe;—in all other points the parſon’s horſe, I ſay, was juſt ſuch another,—for he was as lean, and as lank, and as ſorry a jade, as Humility herſelf could have beſtrided."
                                            },
                                            {
                                                "example_id": "bb74c8a4-0ae6-4e0a-806f-123ae023ec7f",
                                                "sense_id": "6036ff8c-fecf-3d1c-abed-302e6d8be100",
                                                "text": "My horse would have trotted to Clifton within the hour, if left to himself, and I have almost broke my arm with pulling him in to that cursed broken-winded jade’s pace."
                                            },
                                            {
                                                "example_id": "5f940200-7e1b-4119-8b09-eb2bbb43c76d",
                                                "sense_id": "6036ff8c-fecf-3d1c-abed-302e6d8be100",
                                                "text": "The king had no other horse to give him but an old jade, for his six brothers and their men had taken all the other horses, but Ashiepattle did not mind that; he mounted the shabby old nag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16133124-002d-3a06-878e-4131710e4cde",
                                        "entry_id": "6e70a749-f716-3f73-ba4a-dc9be17587f5",
                                        "glosses": [
                                            "A bad-tempered or disreputable woman."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4eb88d0-7acb-43e4-87ea-2b9aadcc8905",
                                                "sense_id": "16133124-002d-3a06-878e-4131710e4cde",
                                                "text": "You alwayes end with a iades tricke, I knowe you of olde."
                                            },
                                            {
                                                "example_id": "710634b6-c5d4-405a-a824-87abaf86df97",
                                                "sense_id": "16133124-002d-3a06-878e-4131710e4cde",
                                                "text": "However, what ſhe withheld from the Infant, ſhe beſtowed with the utmoſt Profuſeneſs on the poor unknown Mother, whom ſhe called an impudent Slut, a wanton Huſſy, an audacious Harlot, a wicked Jade, a vile Strumpet, with every other Appellation with which the Tongue of Virtue never fails to laſh thoſe who bring a Diſgrace on the Sex."
                                            },
                                            {
                                                "example_id": "a49f04d0-e098-4238-84f6-8cb07498ff6f",
                                                "sense_id": "16133124-002d-3a06-878e-4131710e4cde",
                                                "text": "You shall pay me for the plague of having you eternally in my sight—do you hear, damnable jade?"
                                            },
                                            {
                                                "example_id": "5488da54-3a0a-49a2-9563-59cb33e92088",
                                                "sense_id": "16133124-002d-3a06-878e-4131710e4cde",
                                                "text": "Sir Pitt Crawley was a philosopher with a taste for what is called low life. His first marriage with the daughter of the noble Binkie had been made under the auspices of his parents; and as he often told Lady Crawley in her life-time she was such a confounded quarrelsome high-bred jade that when she died he was hanged if he would ever take another of her sort […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "660cd9ce-3507-311a-98ce-481a9e4e95fb",
                                        "entry_id": "724cbc6d-53a8-3506-a7cc-d75ea1b6123b",
                                        "glosses": [
                                            "To fatigue, tire, or weary (someone or something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9021168-68a0-47b9-a7d4-98236d4ee5e6",
                                                "sense_id": "660cd9ce-3507-311a-98ce-481a9e4e95fb",
                                                "text": "[T]he Mind once jaded by an attempt above its Power, it either is diſabl'd for the future, or elſe checks at any vigorous Undertaking ever after, at leaſt is very hardly brought to exert its Force again on any Subject that requires Thought and Meditation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8575ba0-1296-3f57-838e-702fda2b918d",
                                        "entry_id": "724cbc6d-53a8-3506-a7cc-d75ea1b6123b",
                                        "glosses": [
                                            "To treat (someone or something) like a jade; to spurn."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15d23bd1-7f66-490d-ad7c-c1690e2480ef",
                                                "sense_id": "c8575ba0-1296-3f57-838e-702fda2b918d",
                                                "text": "The nere-yet beaten Horſe of Parthia, / We haue iaded out o'th' Field."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df4fc7b6-82fe-30db-b418-7dbe635452db",
                                        "entry_id": "724cbc6d-53a8-3506-a7cc-d75ea1b6123b",
                                        "glosses": [
                                            "To make (someone or something) contemptible and ridiculous."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f75745ad-eb90-4f74-9418-311b4580c517",
                                                "sense_id": "df4fc7b6-82fe-30db-b418-7dbe635452db",
                                                "text": "I do not now foole my ſelfe, to let imagination iade mee; for euery reaſon excites to this, that my Lady loues me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
