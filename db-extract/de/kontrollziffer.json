                        "glosses": [
                            "Ziffer, durch deren Berechnung und Vergleich Eingabefehler erkannt werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e6bbd1-ba7a-45c8-8ed0-43325a21f26d",
                                "sense_id": "f3e72f3c-a52c-3849-9185-9cf578e25e1a",
                                "text": "„Die Nummer besteht aus folgenden Elementen: Geburtsdatum, Ordnungszahl, Kennzahl des Geschlechts und Kontrollziffer.“"
                            },
                            {
                                "example_id": "521b9c18-6519-484c-a0b1-a144ca6e71cb",
                                "sense_id": "f3e72f3c-a52c-3849-9185-9cf578e25e1a",
                                "text": "„Rechenkunst brauchte man aber nicht nur, um die Kontrollziffer auszuknobeln.“"
                            }
                        ],
