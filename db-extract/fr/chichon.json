                    },
                    {
                        "translation_id": "d596f066-5c45-4932-a597-460b943c137e",
                        "source_entry_id": "4724cd7c-1223-33fc-afde-df9b4c585a2b",
                        "source_sense_id": "53944a5e-7afc-3316-a43c-4bc284b1c2d6",
                        "source_sense_description": "umgangssprachlich: Gras, Haschisch, Hasch",
                        "target_lang_word": "Haschisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haschisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                        "entry_id": "de8a6f5d-c6d5-3a4e-8ded-6fd62b685740",
                                        "glosses": [
                                            "aus dem von den Drüsenhaaren an Blättern, Blüten und Stengeln (besonders der weiblichen Pflanzen) ausgeschiedenen harzartigen Sekret ursprünglich vor allem in Indien und im Orient (Naher Osten und Nordafrika) angebauter Sorten des Indischen Hanfs (Cannabis sativa indica) gewonnenes Mittel beziehungsweise Präparat, das bei Einnahme einen durch die im Sekret befindlichen ätherischen Öle (vor allem durch den darin enthaltenen psychoaktiven Wirkstoff Tetrahydrocannabinol) verursachten Rauschzustand bewirkt und deshalb als Ingredienz vor allem von Rauchwaren sowie Gebäck, Süßigkeiten und Getränken verwendet wird (und daher als Genussmittel, Mode- und Volksdroge zu psychischer [nicht physischer] Abhängigkeit führen und dessen Genuss sich somit als Einstiegsdroge zu stärkeren Rauschgiften auswirken kann, wodurch sich – international – eine Uneinigkeit bezüglich Tolerierung und Legalisierung des Besitzes, Konsums und Handels erklärt)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ace44b71-4224-4a7c-8b2e-c0ee638aa861",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "Sein Konsum von Haschisch nimmt bedenkliche Ausmaße an."
                                            },
                                            {
                                                "example_id": "43d703e3-5d98-4849-bca4-050662fd9a0e",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Urchan machte zuerſt vom Münzrechte Gebrauch, verlegte die Reſidenz von Jeniſchehr nach Bruſſa, eroberte 1327 Nikomedien, 1350 Nicäa, dehnte ſein Gebiet bis an den Bosporus, unterwarf auf der anderen Seite den aus dem Seldſchuckenreiche hervorgegangnen Zehnfürſten von Karaſi oder Myſien, ſtiftete Moſcheen, Schulen, Armenküchen und Karawanſerais und begünſtigte Gelehrte, Dichter und heilige Derwiſche, die trotz anachoretiſcher Strenge mit Opium und dem aus Hanf bereiteten Haſchiſch ſich begeiſterten, und keineswegs zu beſchaulichem Leben, ſondern zu Thatendurſt, zu Kampf und Sieg antrieben.“"
                                            },
                                            {
                                                "example_id": "ea65e95e-0705-430c-8a88-7bad90271445",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„So mochten ſie wol eine Viertelſtunde lang ſchweigend neben einander geſeſſen haben, als der Baron plötzlich ſagte:",
                                                "translation": "‚Weil ich nicht begreifen kann, wie es ein Menſch im neunzehnten Jahrhundert aushalten kann, ohne Taback oder Opium zu rauchen, Haſchiſch zu kauen oder ſonſt auf irgend eine Weiſe das katzenjämmerliche Gefühl ſeiner elenden Exiſtenz in etwas abzuſchwächen. Und gerade von Ihnen begreife ich es am wenigſten.‘“"
                                            },
                                            {
                                                "example_id": "e07d6630-82cf-41e8-abe7-8fdcc6203bfb",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Um überdies das Heimweh zu verſcheuchen und ſeine bittere Exiſtenz vergeſſen zu machen, genießt der aſiatiſche Soldat nach Kräften das verderbliche Haſchiſch oder Opium.“"
                                            },
                                            {
                                                "example_id": "eda81007-9d12-484c-9085-823032795a68",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Der Reiche verſündigt ſich bei Wein und gaumenkitzelnden Speiſen, der Arme raucht ſein Pfeifchen mit oder ohne Haſchiſch, trinkt verſchiedene Taſſen Kaffee und verzehrt das, was er ſonſt am Tage genießt, in der Nacht.“"
                                            },
                                            {
                                                "example_id": "5c371568-d88a-4bd7-b17a-f9deac7607a9",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Vor allem aber, und darauf leg’ ich den Haupt-Accent, brech’ ich von heut ab ein für allemal mit dem Thee, dieſem undeutſcheſten aller Getränke, das in ſeiner harmloſeren Geſtalt ein abſurdes Abſud von Hollunder und Johannisbrod, und in ſeiner perniciöſen Form ein türkiſch-orientaliſcher Haſchiſch iſt, an den ich nicht Luſt habe meine wiederhergeſtellten Nerven zu ſetzen.“"
                                            },
                                            {
                                                "example_id": "4a4be290-11fd-49da-a0d0-7ea7ff56fc2d",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Dieser Türke Mechmed nämlich, dessen Smoking ölig glänzte, dessen Aeusseres fadenscheinig war, besass ein Opiumlager, hier am Platz, auch Kokain und Haschisch, im beiläufigen Werte von vierzigtausend Franken, nur prima reine, unverfälschte Ware, erste Qualität, das er – je nun! – geschmuggelt hatte, und das er – verstehen Sie! – ohne Profit, nur weil es ihn behinderte, bereit war, bei konvenierender Gelegenheit abzustossen.“"
                                            },
                                            {
                                                "example_id": "221f0fe1-be32-40a4-80f0-b021aad1da66",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„In Gedanken bin ich immer per Du mit ihm. – Versuchen sollte man alles, – auch Haschisch. Der Marinefähnrich Brandel hat sich aus China, glaub’ ich, Haschisch mitgebracht. Trinkt man oder raucht man Haschisch? Man soll prachtvolle Visionen haben. Brandel hat mich eingeladen mit ihm Haschisch zu trinken oder – zu rauchen – Frecher Kerl. Aber hübsch.“"
                                            },
                                            {
                                                "example_id": "ca2e8434-46a6-4e4e-b409-0fc440d63f13",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Daß in der Schmuckstraße irgendwo Kokain, Morphium und Pervitin gehandelt wurden, gelegentlich auch Haschisch und Marijuana, war ihm schon mehrmals von seinen ‚Schmiermicheln‘ ‚gezinkt‘ worden.“"
                                            },
                                            {
                                                "example_id": "64463b6e-ef86-4646-ac5a-2d7381b57315",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„»Sehen Sie«, plauderte Louarment nachher mit angeregtem Ausdruck, während das Gift schon langsam zu wirken und ihn zu erheitern begann – »diese Laster: Morphium, Opium und Haschisch, zieht sich ein Kolonialapotheker wie das Trinken mit Leichtigkeit zu. Die Gelegenheit bietet sich mühelos und immer wieder an, und endlich gibt man nach. […]«“"
                                            },
                                            {
                                                "example_id": "09cacc2c-070e-4d0d-9461-6433a8b6a39f",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Ich hebe eine merkwürdige Pfeife vom Boden auf, deren Mundstück noch feucht von Speichel ist. Daneben liegt, in ein trockenes Blatt eingeschlagen, Haschisch, der betäubende Hanf, aus dem die Rauschgifthändler in Amerika auch die Marihuanazigaretten machen.“"
                                            },
                                            {
                                                "example_id": "fd8e8c18-9347-4cfc-a783-5e82a8782cce",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Solche Naturen, die die Neugier in Traumbereiche lockt, hat es immer gegeben: Poe (Opium), Musset und Wilde (Absinth), Baudelaire (Haschisch), Maupassant (Äther), von den großen Trinkern gar nicht zu reden.“"
                                            },
                                            {
                                                "example_id": "fc42f8d2-0bd6-42d3-930c-3feabd6e9836",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Die chronische Intoxikation mit Haschisch führt selten zu Schäden des zentralen Nervensystems, die bei chronischem Alkoholmißbrauch häufig auftreten. Es handelt sich um Hirn-Atrophien, die zu Gedächtnisstörungen und zur Verblödung führen. […] Haschisch bewirkt solche Schäden, wie gesagt, seltener, dagegen führt der regelmäßige Gebrauch nach fünf bis sechs Monaten verhältnismäßig häufig, das heißt in zwanzig bis dreißig Prozent der Fälle, zu Psychosen, die tage-, wochen-, manchmal auch monatelang anhalten.“"
                                            },
                                            {
                                                "example_id": "57662eb4-91c3-4134-a1a7-6670b7789ae6",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Sie erzählte, daß sie Haschisch probiert habe, und sagte: »Es sensibilisiert die Haut. Man merkt’s, wenn man gestreichelt wird. Aber das kann man auf andere Weise auch erreichen.«“"
                                            },
                                            {
                                                "example_id": "67a8edf3-5466-46c1-a599-4816c6b3d0d4",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Kessi erklärte mir, daß die Haschisch rauchten, und sagte mir, daß ich mich dazusetzen dürfe. Ich hatte keine große Ahnung, was Haschisch war. Ich wusste nur, daß es ein Rauschgift war und ungeheuer verboten.“"
                                            },
                                            {
                                                "example_id": "28657ba5-3bfe-4659-93d5-0118a91583be",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Danach leben in der Bundesrepublik rund 1,5 Millionen behandlungsbedürftige Alkoholkranke. Dazu kommen fast 50000 Drogenabhängige, die regelmäßig Haschisch, Marihuana, Heroin oder Kokain nehmen. Etwa 300000 bis 500000 Menschen mißbrauchen Medikamente, vor allem Beruhigungs-, Schmerz- und Aufputschmittel, darunter besonders viele Frauen. […] Zehn Prozent der jungen Menschen unter 24 Jahren, das seien rund 1,1 Millionen, hätten schon einmal Drogen – etwa Haschisch – probiert, doch nur etwa 46000 seien Dauerkonsumenten. “"
                                            },
                                            {
                                                "example_id": "1366c9e2-07d6-4ce9-b840-56ea6b0aeb92",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Zur ‚Operation Frühling‘ rückten tausend Beamte aus. Von Madrid bis Las Palmas wurden Verstecke für Haschisch, Kokain, Heroin und LSD ausgehoben.“"
                                            },
                                            {
                                                "example_id": "72e6cb1b-7738-4bd0-a2f6-115f3da2f739",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Besorgte Pädagogen, Ärzte und Mitarbeiter der DDR-Jugendhilfe melden bereits, daß sich in Ost-Berlin und in grenznahen Städten eine Drogenszene entwickelt. Noch gegen Ostmark haben Dealer aus dem Westen Haschisch oder Heroin in der DDR über Schulen, Jugendclubs und Kneipen verkauft, um sich für die Zeit nach der Währungsunion einen ersten Kundenstamm heranzuziehen, der nun gleichzeitig Multiplikator für das ganz große Geschäft in harter D-Mark ist.“"
                                            },
                                            {
                                                "example_id": "0c18278e-d871-4bda-9ddc-85436dde9df2",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„In Bayern können Staatsanwaltschaften und Gerichte im Einzelfall von einer Strafe absehen, wenn jemand ‚gelegentlich‘ zum Eigenkonsum eine geringe Menge Haschisch besitzt und Fremdgefährdung nicht vorliegt.“"
                                            },
                                            {
                                                "example_id": "b1abc7c3-e0e4-4bb3-84de-825a9a45e594",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Eine erste Leibesvisitation der Männer und die sich daran anschließende Durchsuchung ihres Gepäcks förderte jedoch zu meiner grenzenlosen Überraschung kein Haschisch zutage.“"
                                            },
                                            {
                                                "example_id": "c068e287-719c-4874-b711-231138053319",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Alkohol und Nikotin sind legal, der Besitz kleiner Mengen von Haschisch oder Marihuana ist verboten. Überzeugt Sie diese Aufteilung?“"
                                            },
                                            {
                                                "example_id": "11d26c8c-03e5-4f94-bc91-4277162c9e49",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Ich verehrte Mick Jagger. Ich rauchte Haschisch (gelegentlich) und schloß mein Zimmer ab und verbrachte Nachmittage mit meiner Freundin im Bett.“"
                                            },
                                            {
                                                "example_id": "3519d254-203d-4aed-9515-1ec2ab884771",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„»Macht nichts«, hat er gesagt, »komm trotzdem vorbei. Ich backe auch eine Erdbeertorte mit Haschisch.« Das wollte sie nicht. »Dann eben ohne Haschisch.« Typisch Ingo.“"
                                            },
                                            {
                                                "example_id": "430e85fd-8253-493e-8a10-cc9a116b8dfd",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Mein Kopf dreht sich, mein Zimmer dreht sich; es muss wohl der Haschisch sein, den ich in Schwarztee aufgelöst habe.“"
                                            },
                                            {
                                                "example_id": "4cc606ce-47e7-4aec-8592-bb27387a343c",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Als er einmal Joints mitbrachte und einen anzündete und mir reichte, gab ich ihn an Kamilja weiter. Warum ich nicht rauchte, wollte er wissen. Ich möge Haschisch nicht, erklärte ich.“"
                                            },
                                            {
                                                "example_id": "92cfc7c2-d1cd-450b-9b7c-84659a9f83cb",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Er begann, wie sie zu klauen und mit Haschisch zu dealen.“"
                                            },
                                            {
                                                "example_id": "bb759e01-08f2-4608-bfc8-35280b1d827e",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„So viel Haschisch gibt es auf der ganzen Welt nicht.“"
                                            },
                                            {
                                                "example_id": "15106e39-9e26-443b-80a7-3e72a4babb4a",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„Obwohl den Fremdenlegionären das in Nordafrika weitverbreitete Haschisch mit hoher Wahrscheinlichkeit zugänglich gewesen sein dürfte, setzen Jüngers Erfahrungen mit Drogen um einiges später, gegen Ende des Ersten Weltkriegs, ein.“"
                                            },
                                            {
                                                "example_id": "ec555c14-c4a2-4e9a-83e6-4095e4acdc0f",
                                                "sense_id": "a6984078-351f-39e9-a4ad-c4f0e80d7350",
                                                "text": "„»Überall muß man sich mit Giften betäuben: China hat sein Opium, der Islam den Haschisch, der Westen die Frau… Vielleicht ist ›Liebe‹ nichts als der verzweifelte Versuch des Westens, sich vom Zwange des Gegebenen, des der Menschheit Auferlegten, zu befreien«, schreibt Malraux in seinem Roman So lebt der Mensch; […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6103335-48c6-36b1-b3c9-529ea5ca5c6a",
                                        "entry_id": "de8a6f5d-c6d5-3a4e-8ded-6fd62b685740",
                                        "glosses": [
                                            "etwas, das den wachen Verstand so beeinträchtigt, dass kein klares Denken und Urteilen mehr möglich ist; etwas, das betäubend, einschläfernd wirkt"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "badf880e-8893-451d-ae6d-2b20d33c7bee",
                                                "sense_id": "b6103335-48c6-36b1-b3c9-529ea5ca5c6a",
                                                "text": "„Angesichts des Unfriedens und des Elends in der Welt empfänden viele zu Weihnachten eine tiefe innere Unzufriedenheit, und manche würden Weihnachten als ‚Geistliches Haschisch‘ und ‚bürgerlich verkitschte Romantik‘ ansehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a9a88ba-b312-470b-80d7-36e7c786917c",
                        "source_entry_id": "4724cd7c-1223-33fc-afde-df9b4c585a2b",
                        "source_sense_id": "53944a5e-7afc-3316-a43c-4bc284b1c2d6",
                        "source_sense_description": "umgangssprachlich: Gras, Haschisch, Hasch",
                        "target_lang_word": "Hasch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hasch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d649e6ed-13ef-36b9-8fd7-8c83adcc1422",
                                        "entry_id": "38cd9789-501b-38f2-a6be-9ce55d3ffc50",
                                        "glosses": [
                                            "aus dem von den Drüsenhaaren an Blättern, Blüten und Stengeln (besonders der weiblichen Pflanzen) ausgeschiedenen harzartigen Sekret ursprünglich vor allem in Indien und im Orient (Naher Osten und Nordafrika) angebauter Sorten des Indischen Hanfs (Cannabis sativa indica) gewonnenes Mittel beziehungsweise Präparat, das bei Einnahme einen durch die im Sekret befindlichen ätherischen Öle (vor allem durch den darin enthaltenen psychoaktiven Wirkstoff Tetrahydrocannabinol) verursachten Rauschzustand bewirkt und deshalb als Ingredienz vor allem von Rauchwaren sowie Gebäck, Süßigkeiten und Getränken verwendet wird (und daher als Genussmittel, Mode- und Volksdroge zu psychischer [nicht physischer] Abhängigkeit führen und dessen Genuss sich somit als Einstiegsdroge zu stärkeren Rauschgiften auswirken kann, wodurch sich – international – eine Uneinigkeit bezüglich Tolerierung und Legalisierung des Besitzes, Konsums und Handels erklärt)"
                                        ],
                                        "tags": [
                                            "casual",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75ee3baa-e877-4332-9c0c-2dadc8ddcdce",
                                                "sense_id": "d649e6ed-13ef-36b9-8fd7-8c83adcc1422",
                                                "text": "Seine Freunde rauchen alle Hasch."
                                            },
                                            {
                                                "example_id": "ce900df7-0c74-4912-8266-39d77e410bc1",
                                                "sense_id": "d649e6ed-13ef-36b9-8fd7-8c83adcc1422",
                                                "text": "„Es gibt zwei große Beatschuppen, in denen auch Hasch und andere Sachen gehandelt werden.“"
                                            },
                                            {
                                                "example_id": "aee914f3-978f-4cb1-bc89-00e1833d22bc",
                                                "sense_id": "d649e6ed-13ef-36b9-8fd7-8c83adcc1422",
                                                "text": "„Dieses poetisierte Prosit der Gemütlichkeit erzählt von einem Günthersburgallee-Bewohner, der sich an seinen ‚alten Schatz vom Merianplatz‘ und ‚an das Strandcafé und den Hasch im Tee‘ erinnert.“"
                                            },
                                            {
                                                "example_id": "650ab010-e47c-4cfe-b85b-effb93f41fe7",
                                                "sense_id": "d649e6ed-13ef-36b9-8fd7-8c83adcc1422",
                                                "text": "„Das war Quatsch, denn überall im Kino wurde getuschelt, gejohlt und geraschelt, außerdem stank es nach Hasch und es wurde viel und an den falschen Stellen gelacht.“"
                                            },
                                            {
                                                "example_id": "38dc46aa-fcf3-4a03-8fc9-2ecd84a02fad",
                                                "sense_id": "d649e6ed-13ef-36b9-8fd7-8c83adcc1422",
                                                "text": "„Wie ein Drogendealer, nur mit dem kleinen Unterschied, dass ich kein Hasch anbot, sondern Lunch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hasch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "60670b58-1f80-3d71-be9c-867b48059f7f",
                                        "entry_id": "b8b6bb37-c853-3a47-9f33-5c544ca5d035",
                                        "glosses": [
                                            "mit einem Gemisch aus Tabak und Haschisch gefüllte (zumeist selbst gedrehte) Zigarette"
                                        ],
                                        "tags": [
                                            "casual",
                                            "colloquial",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f408f53e-b072-4b3f-8d8f-193ed9b56885",
                                                "sense_id": "60670b58-1f80-3d71-be9c-867b48059f7f",
                                                "text": "„Nachmittags, beim Tischtennis hatte er zwei Haschs mitgeraucht, obgleich er in letzter Zeit den Eindruck hatte, dass die Mattigkeit nach dem Haschrauchen sich mit dem Älterwerden verstärkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
