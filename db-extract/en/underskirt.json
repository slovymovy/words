                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eb81bf2c-36ef-38ae-b633-11f91c4e4236",
                        "entry_id": "94f49cc4-d7ae-3308-8c35-6a5eac134e44",
                        "glosses": [
                            "Rock besetzt mit Rüschen und Spitzen, der unter einem meist bunten Rock getragen wird; Petticoat"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e399286b-efd7-4bdd-b6bf-89eef8f2d340",
                        "source_entry_id": "94f49cc4-d7ae-3308-8c35-6a5eac134e44",
                        "source_sense_id": "a0289a21-c28f-307e-9808-2442e547b586",
                        "source_sense_description": "Kleidungsstück, das unter einem Rock oder einem Kleid getragen wird",
                        "target_lang_word": "Unterrock",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterrock",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fe6dc7f-d8fb-36dd-ac10-bde357f9dfc7",
                                        "entry_id": "0b5cb637-551b-320f-a6c2-57f7a72b931a",
                                        "glosses": [
                                            "Rock, der unter einem normalen Rock als Unterbekleidung getragen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc5f50f5-b0f5-4e4f-813f-09b772edd572",
                                                "sense_id": "6fe6dc7f-d8fb-36dd-ac10-bde357f9dfc7",
                                                "text": "Meine Großmutter trägt immer scheußliche rosafarbene Unterröcke aus Dederon."
                                            },
                                            {
                                                "example_id": "a230a96e-f139-40b8-a62c-3e092b288cf7",
                                                "sense_id": "6fe6dc7f-d8fb-36dd-ac10-bde357f9dfc7",
                                                "text": "„Jetzt jedoch besaß er fürs Leben diese hübsche Frau, die er vergötterte. Für ihn ging das Weltall nicht über den seidigen Saum ihres Unterrocks hinaus; …“"
                                            },
                                            {
                                                "example_id": "06c52010-ec27-4eea-a986-cbebd19c0801",
                                                "sense_id": "6fe6dc7f-d8fb-36dd-ac10-bde357f9dfc7",
                                                "text": "„Stattdessen gerät er spürbar in Erregung, wenn auf Zelluloid ein Mieder eng geschnürt wird oder ein Unterrock aus Taft raschelt.“"
                                            },
                                            {
                                                "example_id": "d8c75212-d5e6-49e4-a82b-d22579c5eaff",
                                                "sense_id": "6fe6dc7f-d8fb-36dd-ac10-bde357f9dfc7",
                                                "text": "„Auf diese Frage hin schlüpfte das Weibsstück aus dem Kleid und dem Unterrock; wenn wir sie nicht gehindert hätten, hätte sie sich ganz nackt ausgezogen, in der Hoffnung, vom tierischen Verlangen zu erhalten, was sie von unserer Vernunft nicht erwarten konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7916105d-113a-4c3d-90fe-2cd7158d05cc",
                        "source_entry_id": "94f49cc4-d7ae-3308-8c35-6a5eac134e44",
                        "source_sense_id": "eb81bf2c-36ef-38ae-b633-11f91c4e4236",
                        "source_sense_description": "Rock besetzt mit Rüschen und Spitzen, der unter einem meist bunten Rock getragen wird",
                        "target_lang_word": "Petticoat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Petticoat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c5eadcc3-d2f5-3a6e-8483-42f6b2e782e5",
                                        "entry_id": "f1b99149-8b11-3e1f-81c9-22ba87dd39d3",
                                        "glosses": [
                                            "weiter, etwas steifer Unterrock"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b204daf2-c6fa-4b85-8eac-30c423b56c65",
                                                "sense_id": "c5eadcc3-d2f5-3a6e-8483-42f6b2e782e5",
                                                "text": "„In zwei Truhen transportierte die 45-Jährige ihre Petticoats, Korsetts und Hüte, aber auch Silber, Porzellan und Ölfarben.“"
                                            },
                                            {
                                                "example_id": "e4e32546-2ede-4c24-80ea-c4b5658c1559",
                                                "sense_id": "c5eadcc3-d2f5-3a6e-8483-42f6b2e782e5",
                                                "text": "„Zu der Zeit waren diese Röcke mit den zwei Pettycoats darunter in Mode. Die konnte man herumsausen lassen, wenn man den Jive tanzte — also tanzte ich eine Menge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
