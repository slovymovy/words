                "senses": [
                    {
                        "sense_id": "a9430ce2-b224-3586-a152-3649a7e4a3bd",
                        "entry_id": "829e4839-edf7-3583-930f-ed015a6e58ac",
                        "glosses": [
                            "Zeitspanne, die für eine Trainingseinheit oder für das Erreichen bestimmter Trainingsziele vorgesehen ist"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "1693a6fd-c5e3-42ab-8e9e-90514218c273",
                                "sense_id": "a9430ce2-b224-3586-a152-3649a7e4a3bd",
                                "text": "„Jetzt hast Du Kalorienzufuhr, Trainingsdauer und Gewicht praktisch in einer App, auf einen Blick.“"
                            },
                            {
                                "example_id": "1d933591-8542-4547-873b-2e80f91cc4be",
                                "sense_id": "a9430ce2-b224-3586-a152-3649a7e4a3bd",
                                "text": "„Die Trainingsdauer beträgt etwa acht bis zehn Stunden und wird erfahrungsgemäß – je nach Vorwissen – in ein bis zwei Wochen durchgearbeitet.“"
                            },
                            {
                                "example_id": "546b50f3-37df-4ab6-a07c-8869a9a3c19f",
                                "sense_id": "a9430ce2-b224-3586-a152-3649a7e4a3bd",
                                "text": "„Betrachtet man dieselbe Trainingsdauer, so werden in 30 Minuten intensivem Intervalltraining mehr Kalorien verbrannt als in 30 Minuten Dauerlauf.“"
                            },
                            {
                                "example_id": "8c087f0f-3c54-4376-b7b6-90c0c1631a70",
                                "sense_id": "a9430ce2-b224-3586-a152-3649a7e4a3bd",
                                "text": "„Es kommt nicht auf die genaue Trainingsdauer an, es macht also keinen Sinn, die Trainingsminuten zu zählen.“"
                            },
                            {
                                "example_id": "b97b3370-0b53-432e-aff7-b0cfa22e83f8",
                                "sense_id": "a9430ce2-b224-3586-a152-3649a7e4a3bd",
                                "text": "„Die Trainingsdauer richtet sich je nach Plan zwischen 40 und 70 Minuten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
