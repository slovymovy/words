                                "target_senses": [
                                    {
                                        "sense_id": "cc430d15-1a99-343f-997e-21c106e1be21",
                                        "entry_id": "6d21343f-9253-3e2e-9fa6-21f66287f3bd",
                                        "glosses": [
                                            "A person with an ugly face."
                                        ],
                                        "tags": [
                                            "colloquial",
