                                        "sense_id": "7c976526-10e4-3379-8f60-8c0a50357983",
                                        "entry_id": "512fa959-d7b2-3f6d-bf3a-6198aba54b15",
                                        "glosses": [
                                            "One who occupationally provides assistance by working with records, accounts, letters, etc.; an office worker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d70c6c2-85d6-4d6e-b0d1-12a0e3ec1556",
                                                "sense_id": "7c976526-10e4-3379-8f60-8c0a50357983",
                                                "text": "As office boy I made such a mark\nThat they gave me the post of a junior clerk."
                                            },
                                            {
                                                "example_id": "2454e2f7-3947-40ec-8087-fba84e13a5c6",
                                                "sense_id": "7c976526-10e4-3379-8f60-8c0a50357983",
                                                "text": "Thus, when he drew up instructions in lawyer language, he expressed the important words by an initial, a medial, or a final consonant, and made scratches for all the words between; his clerks, however, understood him very well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6eb08de-2f57-3420-b03f-4f248922a9c4",
                                        "entry_id": "512fa959-d7b2-3f6d-bf3a-6198aba54b15",
