                        "entry_id": "2f8ea276-ad4e-3fd3-a9c3-b4c94434097b",
                        "glosses": [
                            "grote binnenruimte waar men op een paard kan rijden"
                        ],
                        "tags": [
                            "paardrijden"
                        ],
                        "examples": [
                            {
                                "example_id": "25f4095b-1473-43ff-995d-5afe296eb1e2",
                                "sense_id": "7a13e443-c3e1-3dd0-9053-3c21605e6c3a",
                                "text": "De Raad is het juist eens met de weigering van de gemeente om een vergunning voor een rijhal van bijna 900 vierkante meter aan de Oude Enschedeseweg te verlenen, luidt de uitspraak."
                            },
                            {
                                "example_id": "6e6a35da-971f-4063-81c0-8d0e1bfa4311",
                                "sense_id": "7a13e443-c3e1-3dd0-9053-3c21605e6c3a",
                                "text": "Paarden- en manegehouder Peter Alblas had afgelopen juni zijn binnenmanege aan de Baanhoek in Sliedrecht al moeten sluiten. Dat blijkt uit een uitspraak van de Raad van State van gisteren. Deze stelde dat de tijdelijke bouwvergunning voor de rijhal van Alblas op 21 juni 2010, vijf jaar na begin van de bouw, afliep."
                            }
                        ]
                    }
