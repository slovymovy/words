                    {
                        "sense_id": "b8007fc0-9464-3540-b30b-3f244ae19c44",
                        "entry_id": "07ad4ebe-8d93-3908-8e0a-3daa1750eba3",
                        "glosses": [
                            "Personne employée par une association ou une œuvre de bienfaisance, pour collecter des fonds."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "0359c82f-6c19-4881-9529-9a5b86fec336",
                                "sense_id": "b8007fc0-9464-3540-b30b-3f244ae19c44",
                                "text": "Si le fundraiser n'est pas toujours directement concerné par le suivi comptable des projets, il doit cependant vérifier la clarté des procédures et la disponibilité des informations, afin de rendre compte à tout moment."
                            },
                            {
                                "example_id": "fe9101b8-4713-4587-a8e5-cd0c704cc716",
                                "sense_id": "b8007fc0-9464-3540-b30b-3f244ae19c44",
                                "text": "Le premier est celui d’Elsa B., une fundraiser d’une grande ONG humanitaire. Elle est fille d’un chef d’entreprise (« une usine bien polluante, une usine de détergents et de produits chimiques »), très impliqué à la Chambre de commerce de Lille."
                            },
                            {
                                "example_id": "6a3f7c22-507c-4bea-a9cd-4102fc93e379",
                                "sense_id": "b8007fc0-9464-3540-b30b-3f244ae19c44",
                                "text": "L'Association Française des Fundraisers (AFF) est l'association des professionnels de la collecte de fonds et du mécénat. Elle a pour but de former et d'informer les fundraisers tout en leur permettant d'accéder à un réseau de professionnels impliqués."
                            }
                        ]
                    }
