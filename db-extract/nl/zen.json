                "senses": [
                    {
                        "sense_id": "1448612d-7365-3038-9e4c-557393bd9154",
                        "entry_id": "5d13cfc0-9e72-3e34-8237-43e110ff9fdc",
                        "glosses": [
                            "vorm van boeddhisme die sterk de nadruk legt op concentratie-meditatie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde57ea5-ae9f-4df5-b02e-4fb6450a33c5",
                                "sense_id": "1448612d-7365-3038-9e4c-557393bd9154",
                                "text": "Toen ik de volgende morgen om halfzeven de trappen van het metrostation Belleville afliep, aan alle kanten ingeklemd door collega's, bedacht ik dat ik me moest laten gaan. Alle ik uit mezelf laten lopen. Het individu loslaten. Zen. Ga op in de massa."
                            },
                            {
                                "example_id": "08361fe6-60e0-4e2e-9c80-34095c76f616",
                                "sense_id": "1448612d-7365-3038-9e4c-557393bd9154",
                                "text": "Het is prachtig om lekker zen boven op de berg mooie voornemens te maken, maar hoe voer je die in het dagelijkse leven uit? Thuis probeerde ik bijvoorbeeld minder afwezig en met mijn gedachten bij mijn werk te zijn."
                            }
                        ]
                    }
                ],
