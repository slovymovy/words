                "senses": [
                    {
                        "sense_id": "9505dd71-d53b-384f-9335-bf5dbe2f9d8a",
                        "entry_id": "6e309f8c-4918-3f70-b0f2-b7af4f1742b7",
                        "glosses": [
                            "Verniedlichung für das Geräusch, welches durch den Austritt von Darmgasen am Anus erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6502037d-5fcc-46a8-b508-d5f8c40d6c78",
                                "sense_id": "9505dd71-d53b-384f-9335-bf5dbe2f9d8a",
                                "text": "„Pupsgeräusche oder Weihnachtslieder: Tesla ermöglicht veränderbare Hupe“"
                            },
                            {
                                "example_id": "39d04883-15b9-41cf-ba14-dbe83ad7c13f",
                                "sense_id": "9505dd71-d53b-384f-9335-bf5dbe2f9d8a",
                                "text": "„Weil normale Pupsgeräusche offenbar vielen nicht genug sind, gibt es auf Platz sieben nochmal den Skill „Megafurz“.“"
                            },
                            {
                                "example_id": "d2f98643-ee5f-42f5-b4c8-85c11b483ab8",
                                "sense_id": "9505dd71-d53b-384f-9335-bf5dbe2f9d8a",
                                "text": "„Ein knurrender Magen, peinliche Pupsgeräusche oder unkontrollierbares Niesen: Nicht immer sind Körpergeräusche harmlos“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
