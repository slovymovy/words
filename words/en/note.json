                        ],
                        "zh": [
                            {
                                "target_lang_word": "音符",
                                "target_lang_sense_clarification": "音乐符号"
                            },
                            {
                                "target_lang_word": "音",
                                "target_lang_sense_clarification": "乐音"
                            }
                        ]
                    }
