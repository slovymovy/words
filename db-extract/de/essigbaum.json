                        "sense_id": "5810a048-36db-3c80-842e-445d219ada02",
                        "entry_id": "74f98f5a-7022-3931-b4df-5f1ed2ab73b4",
                        "glosses": [
                            "aus dem östlichen Nordamerika stammender Baum aus der Familie der Sumachgewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b8709b-e4d0-4183-8084-1bee16a0837d",
                                "sense_id": "5810a048-36db-3c80-842e-445d219ada02",
                                "text": "„Sie kamen allerdings erst kurz nach Mittag an den Fluss. Aus der Richtung, aus der sie sich ihm näherten, war das Gelände offen; man konnte einige Essigbäume sehen, deren Blätter schon gelb wurden, und am Ufer darbten ein paar Buschweiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
