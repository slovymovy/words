                "senses": [
                    {
                        "sense_id": "02d61752-9fd0-3fe2-b4c9-56d52b6b3ac6",
                        "entry_id": "5199ce57-3c93-31d1-8eab-851977a83459",
                        "glosses": [
                            "Recht, bei sich kreuzenden Verkehrswegen seine Fahrt als Erster fortzusetzen"
                        ],
                        "tags": [
                            "Straßenverkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "9501b66a-7bdc-40c9-8300-9668497bb8f5",
                                "sense_id": "02d61752-9fd0-3fe2-b4c9-56d52b6b3ac6",
                                "text": "Du hast Vorfahrt."
                            },
                            {
                                "example_id": "7189b92d-6de6-4b4f-9bdf-3b0891ef0c26",
                                "sense_id": "02d61752-9fd0-3fe2-b4c9-56d52b6b3ac6",
                                "text": "Jemandem die Vorfahrt zu nehmen ist gefährlich und stellt eine Ordnungswidrigkeit dar."
                            },
                            {
                                "example_id": "21255e46-98db-46b1-b542-24da079f0e81",
                                "sense_id": "02d61752-9fd0-3fe2-b4c9-56d52b6b3ac6",
                                "text": "„Während Männer häufiger bei Fahrten unter Alkoholeinfluss auffällig werden, missachten Frauen eher die Vorfahrt.“"
                            },
                            {
                                "example_id": "d6d24da5-6b5f-47f3-9683-dbda27719025",
                                "sense_id": "02d61752-9fd0-3fe2-b4c9-56d52b6b3ac6",
                                "text": "„Er erzwingt sogar an den Pissoirbecken der Autobahn-Raststätten die Vorfahrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f2a02edc-4836-3aea-9e55-fe5dc6347b80",
                        "entry_id": "5199ce57-3c93-31d1-8eab-851977a83459",
                        "glosses": [
                            "Handlung, mit einem Fahrzeug zu einem bestimmten Punkt zu fahren und dort zu halten"
                        ],
                        "tags": [
                            "Straßenverkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "bfc2699b-f4af-49ca-84c2-fd23b7cbef8e",
                                "sense_id": "f2a02edc-4836-3aea-9e55-fe5dc6347b80",
                                "text": "Wir müssen einen Platz für die Vorfahrt der Kutsche freihalten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3af380a8-fb1a-3784-bd1a-80dfe58246f8",
                        "entry_id": "5199ce57-3c93-31d1-8eab-851977a83459",
                        "glosses": [
                            "Wegeabschnitt vor einem Gebäude, wo Fahrzeuge kurz anhalten können (zum Beispiel vor einem Hotel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3be04b56-0559-44f9-a2fc-7e0f759f91be",
                                "sense_id": "3af380a8-fb1a-3784-bd1a-80dfe58246f8",
                                "text": "Unser Hotel hat eine Vorfahrt, wo wir in Ruhe ausladen können."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b639c0c-db6b-413d-b1f2-8f164ff25cf8",
                        "source_entry_id": "5199ce57-3c93-31d1-8eab-851977a83459",
                        "source_sense_id": "02d61752-9fd0-3fe2-b4c9-56d52b6b3ac6",
                        "source_sense_description": "Straßenverkehr: Recht, bei sich kreuzenden Verkehrswegen seine Fahrt als Erster fortzusetzen",
                        "target_lang_word": "priority",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "priority",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2725557-7a9e-3f60-83cc-1cfbde8aafff",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "An item's relative importance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b91f3308-6e28-42ef-aeb2-3a7b8ee970d2",
                                                "sense_id": "f2725557-7a9e-3f60-83cc-1cfbde8aafff",
                                                "text": "He set his e-mail message's priority to high."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71ba40b5-de8e-3c89-ad9c-6c3ebe02e3bc",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "A goal of a person or an organisation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7db7fd2f-9c4a-4e96-8332-8e61e08fdecb",
                                                "sense_id": "71ba40b5-de8e-3c89-ad9c-6c3ebe02e3bc",
                                                "text": "She needs to get her priorities straight and stop playing games."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da14edcf-3263-3452-906e-6640ba80a8d4",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "The quality of being earlier or coming first compared to another thing; the state of being prior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34d29bbf-1aa4-40eb-8918-d2f1ecc4af84",
                                                "sense_id": "da14edcf-3263-3452-906e-6640ba80a8d4",
                                                "text": "In bankruptcy law, a business' debt to its employees has priority over its debt to a landlord, so the employees must be paid first."
                                            },
                                            {
                                                "example_id": "d4e810b0-735b-4934-b029-3b88110788db",
                                                "sense_id": "da14edcf-3263-3452-906e-6640ba80a8d4",
                                                "text": "But it's now platform extension work which will allow the station to handle LNER Azuma trains which needs to take priority, if a direct service to London King's Cross is to begin in 2021."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "705613fc-41e3-3a4d-984c-e267b4ed175e",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "A superior claim to use by virtue of being validly published at an earlier date."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcaa2689-d64e-4dc0-81d7-23e5523c44d6",
                                                "sense_id": "705613fc-41e3-3a4d-984c-e267b4ed175e",
                                                "text": "Neither [Jones][…] nor I (in 1966) could conceive of reducing our \"science\" to the ultimate absurdity of reading Finnish newspapers almost a century and a half old in order to establish \"priority.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "Precedence; superior rank."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac628060-3ec0-4b4c-87bd-b8ed87554a1e",
                                                "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                                "text": "Follow Cominius. We must follow you. / Right worthy you priority."
                                            },
                                            {
                                                "example_id": "d80b4eb4-21dd-4cc5-a3ae-afe378786bc0",
                                                "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                                "text": "Sozomen is not criticizing Constantine but rather asserting that bishops have priority over emperors, in case the readers might not have understood this […]"
                                            },
                                            {
                                                "example_id": "055b54b7-0afb-4c1d-a50d-8de51b3bea77",
                                                "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                                "text": "Who has priority, one's mother or one's wife? Question: To whom should a married man should give much preference, either his mother or wife?"
                                            },
                                            {
                                                "example_id": "a54bc13e-9c29-4ada-a1b3-18a4a9419250",
                                                "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                                "text": "The Holy Ghost is here and He has priority—remember that. The Holy Ghost has priority over your pastor, your church, your teachers—priority over every human thing. He is God, and being God, His voice has priority over all voices,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "334b610e-9bc3-3cef-b8f1-a5435da52d5b",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "Right of way; The right to pass (an intersection) before other road users."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b50e0650-e66c-40e2-b2c1-24587ad53b33",
                        "source_entry_id": "5199ce57-3c93-31d1-8eab-851977a83459",
                        "source_sense_id": "02d61752-9fd0-3fe2-b4c9-56d52b6b3ac6",
