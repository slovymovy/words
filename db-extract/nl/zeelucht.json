                        "examples": [
                            {
                                "example_id": "d2063749-2e4a-4461-869c-8dac5de81316",
                                "sense_id": "1699e651-21e3-3f3f-b219-126360d7112d",
                                "text": "Hij snoof de zilte zeelucht op."
                            },
                            {
                                "example_id": "f32fb9e6-d0fe-4837-aca6-beba214d7588",
                                "sense_id": "1699e651-21e3-3f3f-b219-126360d7112d",
                                "text": "Het was Baltische regen, uit het noorden, koud, met een zeelucht, pittig door het zout."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3df75450-9185-4a8a-8a40-67b237e57f59",
                        "source_entry_id": "e7b4a900-1951-3313-bfda-79d447f0df25",
                        "source_sense_id": "1d62a8af-1886-3d98-a772-28e9b4fa9ac4",
