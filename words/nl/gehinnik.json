                    "frequency": "Low",
                    "semantic_group_id": "geluid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Haar overdreven <w>gehinnik</w> om zijn flauwe grappen begon iedereen al snel te irriteren.",
                            "target_lang_translations": {
