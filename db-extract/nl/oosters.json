                                    {
                                        "sense_id": "65ea8663-b352-33d5-b6d8-d74534ea0675",
                                        "entry_id": "f1cfc599-d7bc-396c-b043-29af66cb66d0",
                                        "glosses": [
                                            "Of, facing, situated in, or related to the east."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84685918-6ba0-4494-8671-225511a6d3e7",
                                                "sense_id": "65ea8663-b352-33d5-b6d8-d74534ea0675",
                                                "text": "While De Anza was exploring the Bay of San Francisco, seeking a site for the presidio, the American colonists on the eastern seaboard, three thousand miles away, were celebrating the signing of the Declaration of Independence."
                                            },
                                            {
                                                "example_id": "852df5c8-cb6a-45d1-b425-ce9dc9a7b707",
                                                "sense_id": "65ea8663-b352-33d5-b6d8-d74534ea0675",
                                                "text": "The “little green men”—faces covered, wearing unmarked olive uniforms, speaking Russian and using Russian weapons—have played a significant role in both the occupation of Crimea and the civil war in eastern Ukraine.¹⁹⁶"
                                            },
                                            {
                                                "example_id": "228d7f50-ce61-41ca-805a-8f44d52df5db",
                                                "sense_id": "65ea8663-b352-33d5-b6d8-d74534ea0675",
                                                "text": "Another ANC splinter party, the uMkhonto weSizwe Party (MK), led by former President Jacob Zuma appears to be on course to do well in KwaZulu-Natal, the eastern coastal province where Durban is located."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9fb7e6f-2c4f-3f2a-a067-f314c8945a0d",
                                        "entry_id": "f1cfc599-d7bc-396c-b043-29af66cb66d0",
                                        "glosses": [
                                            "Blowing from the east; easterly."
                                        ],
