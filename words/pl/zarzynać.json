                    "sense_definition": "niszczyć przedmiot poprzez jego nieprawidłowe lub zbyt intensywne użytkowanie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "niszczenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kierowca <w>zarzyna</w> silnik, jeżdżąc ciągle na zbyt wysokich obrotach.",
                            "target_lang_translations": {
                                "ru": "Водитель <w>гробит</w> двигатель, постоянно ездя на слишком высоких оборотах."
                            }
                        },
                        {
                            "text": "Nie <w>zarzynaj</w> tego starego komputera, bo zaraz się zepsuje.",
                            "target_lang_translations": {
                                "ru": "Не <w>убивай</w> этот старый компьютер, а то он скоро сломается."
                            }
                        }
