                                "example_id": "c258b3c4-db3a-484b-9c70-52cb6fc9de9e",
                                "sense_id": "1b00b0cd-6dea-305e-ace1-0306625ad55e",
                                "text": "„Und er erzählt von Märkten, auf denen man statt mit Münzen mit Goldklumpen bezahle.“"
                            },
                            {
                                "example_id": "d5ae75bc-a8bd-4f10-9495-85f2ae84e301",
                                "sense_id": "1b00b0cd-6dea-305e-ace1-0306625ad55e",
                                "text": "„In der einen Hand hielt sie einen Goldklumpen von der Größe einer Wassermelone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
