                    }
                ],
                "senses": [
                    {
                        "sense_id": "c73b871c-afa4-319d-90e7-246ddd7850d8",
                        "entry_id": "34e173eb-7d73-35a9-83cc-a947f2d59a58",
                        "glosses": [
                            "узкая, длинная лодка у народов Центральной и Южной Америки и Океании, выдолбленная или выжженная из ствола дерева"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a762bb3c-29ea-4d83-b12d-50f821fe2f43",
                                "sense_id": "c73b871c-afa4-319d-90e7-246ddd7850d8",
                                "text": "— Пиро́га с туземцами! — раздался крик. Размахивая шляпами со страусовыми перьями и волоча за собой длинные плащи, открыватели новых земель бросились к подветренному борту."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81bbe969-68ec-4928-a02b-7151ac7f4e40",
                        "source_entry_id": "34e173eb-7d73-35a9-83cc-a947f2d59a58",
                        "source_sense_id": "c73b871c-afa4-319d-90e7-246ddd7850d8",
                        "target_lang_word": "pirogue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pirogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "354a3599-316e-3aeb-ba83-045cf4531621",
                                        "entry_id": "a1227de8-936a-304b-981d-0d09c2e7ce08",
                                        "glosses": [
                                            "A canoe of shallow draft, made by hollowing a log."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "580ee8ec-4059-3df8-b168-566d07aa46d2",
                                        "entry_id": "a1227de8-936a-304b-981d-0d09c2e7ce08",
                                        "glosses": [
                                            "A small flat-bottom boat of shallow draft."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd8b72aa-c174-3d8d-a704-f6afeaa446d4",
                                        "entry_id": "a1227de8-936a-304b-981d-0d09c2e7ce08",
                                        "glosses": [
                                            "A boat-shaped food that is stuffed with seafood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "700651aa-986e-48b8-b365-8855edb49f8a",
                                                "sense_id": "cd8b72aa-c174-3d8d-a704-f6afeaa446d4",
                                                "text": "There are even more elaborately prepared Cajun specialties, such as Bayou Bouillabaisse and pirogue of pasta and seafood."
                                            },
                                            {
                                                "example_id": "160dbe80-9bef-4606-b34f-074ab22dede2",
                                                "sense_id": "cd8b72aa-c174-3d8d-a704-f6afeaa446d4",
                                                "text": "The eggplant pirogue, a regional specialty, is especially good here."
                                            },
                                            {
                                                "example_id": "e45ab2c2-1746-4026-b7d5-dc5014f63447",
                                                "sense_id": "cd8b72aa-c174-3d8d-a704-f6afeaa446d4",
                                                "text": "Diners love the pirogue bread with crawfish tails, the barbecue shrimp with fiery tasso and the banana bread pudding."
                                            },
                                            {
                                                "example_id": "1e7e7771-7f54-4bf1-b778-07ad6f4e109c",
                                                "sense_id": "cd8b72aa-c174-3d8d-a704-f6afeaa446d4",
                                                "text": "She had ordered eggplant pirogue — a hollowed out eggplant, breaded, fried, and stuffed with shrimp, crawfish, and crab."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
