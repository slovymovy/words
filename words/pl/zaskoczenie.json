                    "frequency": "Middle",
                    "semantic_group_id": "zdarzenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przygotowaliśmy dla niej miłe <w>zaskoczenie</w> na urodziny.",
