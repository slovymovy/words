                "senses": [
                    {
                        "sense_id": "603ccfd8-367c-3f98-8502-1809be4abe9e",
                        "entry_id": "668e547e-7d73-3ae3-a8c0-6553ad679478",
                        "glosses": [
                            "Tacler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e953d1a8-8836-4351-88ff-1abb6a17dba0",
                                "sense_id": "603ccfd8-367c-3f98-8502-1809be4abe9e",
                                "text": "Je vais tacler, tacler et retacler encore."
                            },
                            {
                                "example_id": "ab40247d-65dc-4c38-a6df-0586a064a741",
                                "sense_id": "603ccfd8-367c-3f98-8502-1809be4abe9e",
                                "text": "D'ici que tu puisses retacler un jour, t'auras perdu ta liste. Au fait, t'as planifié pour quand la prochaine blessure?"
                            },
                            {
                                "example_id": "6f86793a-93d7-4c56-bea1-aeeb4f58b19c",
                                "sense_id": "603ccfd8-367c-3f98-8502-1809be4abe9e",
                                "text": "Le problème, il n'y en a qu'un, c'est que tu t'es permis de retacler comme un barbare alors que 5 minutes auparavant, je t'esquive en sautant de justesse"
                            }
                        ]
                    }
