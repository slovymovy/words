            "senses": [
                {
                    "sense_id": "b4929999-5e81-36ef-bf9e-8ab043c4dde5",
                    "sense_definition": "Saisir un objet avec la main ou le tenir.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "manipulation_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant <w>prend</w> la main de sa mère pour traverser la rue."
                        },
                        {
                            "text": "Il a <w>pris</w> le livre posé sur la table pour commencer sa lecture."
                        }
                    ],
                    "common_phrases": [
                        "prendre la main"
                    ]
                },
                {
                    "sense_id": "5f64d226-db31-379a-98b3-4eab16ddc795",
                    "sense_definition": "Manger, boire ou absorber un aliment, une boisson ou un médicament.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "consommation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous <w>prenons</w> un café chaud ensemble tous les matins au bureau."
                        },
                        {
                            "text": "Tu dois <w>prendre</w> ce médicament trois fois par jour après les repas."
                        }
                    ],
                    "common_phrases": [
                        "prendre un café",
                        "prendre un médicament",
                        "prendre son petit déjeuner"
                    ]
                },
                {
                    "sense_id": "60ae0dae-ed45-37be-a28f-cb80da4076fd",
                    "sense_definition": "Monter à bord d'un moyen de transport ou l'utiliser pour se déplacer.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>prends</w> le bus tous les jours pour aller à l'université."
                        },
                        {
                            "text": "Ils ont <w>pris</w> le train de huit heures pour arriver avant midi."
                        }
                    ],
                    "common_phrases": [
                        "prendre le train",
                        "prendre le bus",
                        "prendre l'avion"
                    ]
                },
                {
                    "sense_id": "36be21c8-840b-34c7-b590-42d2953bd809",
                    "sense_definition": "Emporter quelque chose avec soi par précaution ou par nécessité.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emporter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>prendre</w> un parapluie car le ciel est très menaçant."
                        },
                        {
                            "text": "Elle a <w>pris</w> ses clés de maison avant de refermer la porte."
                        }
                    ],
                    "common_phrases": [
