                        "sense_id": "d7cd2794-0090-3728-aa12-5a3330128c41",
                        "entry_id": "b204ebfb-4d52-39bd-8158-0f5d2ddf49c0",
                        "glosses": [
                            "Qui a la propriété de purger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39927a4c-e89c-43b5-8a0b-874edd8e6fbd",
                                "sense_id": "d7cd2794-0090-3728-aa12-5a3330128c41",
                                "text": "Remède purgatif."
                            },
                            {
                                "example_id": "161b7744-ed37-40fb-8a9a-0a032371cbae",
                                "sense_id": "d7cd2794-0090-3728-aa12-5a3330128c41",
                                "text": "Tisane, poudre purgative."
                            },
                            {
                                "example_id": "1f4a872b-a642-4ec3-b7ce-6b7c66bcc083",
                                "sense_id": "d7cd2794-0090-3728-aa12-5a3330128c41",
                                "text": "Cette plante a une vertu purgative."
                            },
                            {
                                "example_id": "0200eb6d-de97-42b9-9c46-b8052143ab74",
                                "sense_id": "d7cd2794-0090-3728-aa12-5a3330128c41",
                                "text": "Sganarelle : Pardonnez-moi Monsieur ; je viens seulement d'ici près. Je crois que cet habit est purgatif, et que c'est prendre médecine que de le porter."
                            }
                        ]
                    }
