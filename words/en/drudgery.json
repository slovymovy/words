                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Modern machines have helped to liberate people from the <w>drudgery</w> of daily household chores.",
                            "target_lang_translations": {
                                "de": "Moderne Maschinen haben dazu beigetragen, die Menschen von der <w>Plackerei</w> der täglichen Hausarbeit zu befreien."
                            }
                        },
                        {
                            "text": "He found the endless <w>drudgery</w> of his office job to be completely soul-destroying.",
                            "target_lang_translations": {
                                "de": "Er empfand die endlose <w>Schinderei</w> seines Bürojobs als völlig zermürbend."
                            }
                        }
                    ],
                    "synonyms": [
                        "chore",
                        "toil",
                        "drudgery",
                        "drudgework",
                        "scut",
                        "scutwork"
                    ],
                    "common_phrases": [
                        "daily drudgery",
                        "domestic drudgery"
                    ],
                    "target_lang_definitions": {
                        "de": "Anstrengende, langweilige und unangenehme Arbeit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Plackerei",
                                "target_lang_sense_clarification": "Bezeichnet eine sehr mühsame, körperlich oder geistig anstrengende Arbeit."
                            },
                            {
                                "target_lang_word": "Schinderei",
                                "target_lang_sense_clarification": "Betont die extreme Beanspruchung und das Gefühl, sich bei der Arbeit abzuquälen."
                            },
                            {
