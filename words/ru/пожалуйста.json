                {
                    "sense_id": "69b40deb-9fff-3a8f-bf8d-497333956ad6",
                    "sense_definition": "Выражает удивление, возмущение или иронию (обычно в сочетании со словами «скажите», «смотрите»).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скажите <w>пожалуйста</w>, какой он стал важный начальник!",
                            "target_lang_translations": {
                                "en": "<w>Well I never</w>, what an important boss he has become!",
                                "de": "Sagen Sie <w>bitte</w>, was für ein wichtiger Chef er geworden ist!",
                                "zh": "<w>你瞧</w>，他现在成了个多么了不起的领导啊！",
                                "nl": "<w>Zeg</w>, wat is hij een belangrijke baas geworden!",
                                "pl": "<w>Proszę</w> bardzo, jakim on się stał ważnym szefem!",
                                "fr": "<w>Dites donc</w>, quel important chef il est devenu !",
                                "it": "<w>Ma guarda</w> che capo importante è diventato!",
                                "cs": "<w>Prosím vás</w>, podívejte se, jaký je z něj důležitý šéf!",
                                "tr": "<w>Bak sen şuna</w>, ne kadar önemli bir şef olmuş!",
                                "es": "¡<w>Por favor</w>, qué jefe tan importante se ha vuelto!"
                            }
                        },
                        {
                            "text": "Смотрите <w>пожалуйста</w>, он опять всем недоволен.",
                            "target_lang_translations": {
                                "en": "<w>Just look at that</w>, he is dissatisfied with everything again.",
                                "de": "Schauen Sie <w>bitte</w>, er ist schon wieder mit allem unzufrieden.",
                                "zh": "<w>你瞧</w>，他又对什么都不满意了。",
                                "nl": "<w>Moet je kijken</w>, hij is weer overal ontevreden over.",
                                "pl": "<w>Proszę</w> bardzo, znowu jest ze wszystkiego niezadowolony.",
                                "fr": "<w>Regardez-moi ça</w>, il est encore mécontent de tout.",
                                "it": "<w>Guarda un po'</w>, è di nuovo scontento di tutto.",
                                "cs": "<w>Prosím vás</w>, podívejte se, zase je se vším nespokojený.",
                                "tr": "<w>Bak sen şuna</w>, yine her şeyden memnuniyetsiz.",
                                "es": "¡<w>Por favor</w>, mira que otra vez está descontento con todo!"
                            }
                        }
                    ],
                    "common_phrases": [
                        "скажите пожалуйста",
                        "смотрите пожалуйста"
                    ],
                    "traits": [
