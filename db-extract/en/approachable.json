                    },
                    {
                        "translation_id": "b4488ed3-a53a-4bae-bd0d-ac5274cd2605",
                        "source_entry_id": "e902d7c4-2ea5-3fae-95db-3035d33a0fdb",
                        "source_sense_id": "f9206355-6001-385e-ba55-43b545954a2b",
                        "source_sense_description": "easy to talk to",
                        "target_lang_word": "approchable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "approchable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbb5ed5f-2ce5-3248-9cdf-b179bfb82937",
                                        "entry_id": "fbb103bb-e75a-3520-91c4-c8b68a99b4db",
                                        "glosses": [
                                            "Que l’on peut approcher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b3996a2-84d9-499f-9683-d519e99a188b",
                                                "sense_id": "cbb5ed5f-2ce5-3248-9cdf-b179bfb82937",
                                                "text": "Car, je suis ton Pavois, dit l’Eternel à Abraham : l’Eternel, une essence infinie, une saincteté non approchable aux pecheurs, un feu consumant qui les devore …."
                                            },
                                            {
                                                "example_id": "f2966e2e-411f-4a4b-9e94-8fa1eb492a2f",
                                                "sense_id": "cbb5ed5f-2ce5-3248-9cdf-b179bfb82937",
                                                "text": "Que l'animal soit plus ou moins approchable, nous devons d’abord observer l’aspect général."
                                            },
                                            {
                                                "example_id": "5cd61607-53ad-45c1-8923-7a405fd38038",
                                                "sense_id": "cbb5ed5f-2ce5-3248-9cdf-b179bfb82937",
                                                "text": "Pour Georges Lemaître, « la » Vérité est approchable par la science ou par la foi..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2690bd5b-2f60-4e59-895b-f42dfdbfefd3",
                        "source_entry_id": "e902d7c4-2ea5-3fae-95db-3035d33a0fdb",
                        "source_sense_id": "f9206355-6001-385e-ba55-43b545954a2b",
                        "source_sense_description": "easy to talk to",
                        "target_lang_word": "abordable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abordable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b9b99d-38b1-376d-b304-c7d5ead911f4",
                                        "entry_id": "671b044e-5b81-39bb-8c1c-b291ffcfbe18",
                                        "glosses": [
                                            "Modéré, en parlant d'un prix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3f35a5-e08d-4035-9034-cb615f59fdfb",
                                                "sense_id": "c8b9b99d-38b1-376d-b304-c7d5ead911f4",
                                                "text": "Les produits alimentaires sont plus abordables en France qu’en Allemagne, et le choix est bien plus important, synthétise Ralid."
                                            },
                                            {
                                                "example_id": "d680ca68-b033-4c83-bf78-d1db8481b436",
                                                "sense_id": "c8b9b99d-38b1-376d-b304-c7d5ead911f4",
                                                "text": "Le ministre de l’Innovation, Navdeep Bains, a ajouté qu’il est aussi important que les Canadiens aient accès à des forfaits internet abordables, peu importe où ils se trouvent."
                                            },
                                            {
                                                "example_id": "11f7f707-2635-463b-b0ed-a1153c2ffc1c",
                                                "sense_id": "c8b9b99d-38b1-376d-b304-c7d5ead911f4",
                                                "text": "On veut permettre à toutes nos familles de comprendre que, la saine alimentation à prix abordable, c’est possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63b1be29-3f01-3edb-9f63-06ca1c96a6dd",
                                        "entry_id": "671b044e-5b81-39bb-8c1c-b291ffcfbe18",
                                        "glosses": [
                                            "Dont on peut envisager l'achat, à cause de son prix abordable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bd22518-3363-44d7-b3f8-c6bf17bc28c3",
                                                "sense_id": "63b1be29-3f01-3edb-9f63-06ca1c96a6dd",
                                                "text": "Ses toiles sont abordables, car il n'est pas encore très connu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "380ddc94-7a70-3e8c-a2b5-b8dbac589869",
                                        "entry_id": "671b044e-5b81-39bb-8c1c-b291ffcfbe18",
                                        "glosses": [
                                            "Qu’on peut aborder."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99f1d0d7-f1e7-4455-92fc-f40352113bd7",
                                                "sense_id": "380ddc94-7a70-3e8c-a2b5-b8dbac589869",
                                                "text": "Enfin le troisième groupe de ruines, c'est celui de la forteresse au sommet de la colline. […]. Au nord et à l'est, ce sont d'énormes et inaccessibles blocs ou boulders de granit superposés. L'ouest, le seul côté abordable, est fermé par une puissante muraille."
                                            },
                                            {
                                                "example_id": "37cb958b-2969-4e9c-88a7-d67aa90e3ae3",
                                                "sense_id": "380ddc94-7a70-3e8c-a2b5-b8dbac589869",
                                                "text": "Il devait y avoir, du côté du large, quelque fissure abordable pour les barques à certaines heures de la marée."
                                            },
                                            {
                                                "example_id": "af5a417a-fc9c-4229-8d9d-55a5ba026955",
                                                "sense_id": "380ddc94-7a70-3e8c-a2b5-b8dbac589869",
                                                "text": "Cette côte n’est pas abordable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1639484c-e31d-399c-9776-d51296ab11ec",
                                        "entry_id": "671b044e-5b81-39bb-8c1c-b291ffcfbe18",
                                        "glosses": [
                                            "Facile d'accès, en parlant d'une personne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b6e024c-fc62-4ba4-a9c1-e764e1fd4c80",
                                                "sense_id": "1639484c-e31d-399c-9776-d51296ab11ec",
                                                "text": "Cet homme est très abordable, n’est pas abordable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ec41a70-0aa7-4492-9c98-df7802cb4417",
                        "source_entry_id": "e902d7c4-2ea5-3fae-95db-3035d33a0fdb",
                        "source_sense_id": "f9206355-6001-385e-ba55-43b545954a2b",
                        "source_sense_description": "easy to talk to",
                        "target_lang_word": "zugänglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zugänglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                        "entry_id": "a04d1dbb-e85b-35ad-aec6-64e5eb66698c",
                                        "glosses": [
                                            "einen Zugang besitzend, so dass man eintreten und ein eventuelles dortiges Angebot nutzen kann"
                                        ],
                                        "tags": [
                                            "räumlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e13e1f8-ac52-486d-b637-914cb3b2c547",
                                                "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                                "text": "Der Buckingham Palace ist einmal im Jahr der Öffentlichkeit zugänglich."
                                            },
                                            {
                                                "example_id": "9616e2f2-6c6a-4842-8bf5-7d4aba142630",
                                                "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                                "text": "„Die christliche Grabeskirche war frei zugänglich von früh um sieben bis abends um sieben und meist überfüllt.“"
                                            },
                                            {
                                                "example_id": "b6ee9f28-9c70-4803-a12b-52c1dbb436e5",
                                                "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                                "text": "„Jeder glücklich erreichte Gipfel vermittelt das Bewusstsein, sich ein nicht jedermann zugängliches, dem Bergsteiger wichtiges Stück Bergwelt unseres Globus selbst erarbeitet und damit zu eigen gemacht zu haben.“"
                                            },
                                            {
                                                "example_id": "3c293610-6f1f-4006-94a1-8b83612ad7f2",
                                                "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                                "text": "Die Tiefen der Weltmeere sind nur wenigen Forschern zugänglich."
                                            },
                                            {
                                                "example_id": "43acfea1-2dc8-4ab8-b5fc-c0112c9d2598",
                                                "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                                "text": "Das Flugzeugwrack lag an einer schwer zugänglichen Stelle."
                                            },
                                            {
                                                "example_id": "2ca47779-3a04-4ae3-8846-9fcb0477bfa8",
                                                "sense_id": "1e1c5116-58fb-3562-b544-0aef7b5f24dd",
                                                "text": "„Dabei hängen Fotos, auf denen Leni Ottos griechischen Schwiegervater in Heldenpose porträtiert hat, durchaus an Gästen zugänglichen Stellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "af63bb2f-8776-3fcd-8c27-6955bb66980c",
                                        "entry_id": "a04d1dbb-e85b-35ad-aec6-64e5eb66698c",
                                        "glosses": [
                                            "sich gerne anderen (oder auch Themen) öffnend und kommunikationsbereit"
                                        ],
                                        "tags": [
                                            "über Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33094716-1a5c-4837-bc45-d9d156c9d6fe",
                                                "sense_id": "af63bb2f-8776-3fcd-8c27-6955bb66980c",
                                                "text": "Meine Oma war eine sehr zugängliche, gesellige und aufgeschlossene alte Dame."
                                            },
                                            {
                                                "example_id": "392abeb5-e70d-4e63-8464-4004b5bd2423",
                                                "sense_id": "af63bb2f-8776-3fcd-8c27-6955bb66980c",
                                                "text": "Sie ist allem Ästhetischen zugänglich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4925583f-be92-319c-880e-e6e8b36d3b09",
                                        "entry_id": "a04d1dbb-e85b-35ad-aec6-64e5eb66698c",
                                        "glosses": [
                                            "so, dass es verstanden und genutzt werden kann"
                                        ],
                                        "tags": [
                                            "über Information",
                                            "Wissen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e64b47b0-d02b-4b32-9612-92e6af438d18",
                                                "sense_id": "4925583f-be92-319c-880e-e6e8b36d3b09",
                                                "text": "Eine gute Übersetzung der fremdsprachigen Texte macht das Werk zugänglicher."
                                            },
                                            {
                                                "example_id": "4883ec91-7fe9-47b4-b5bf-9e6ff87988c6",
                                                "sense_id": "4925583f-be92-319c-880e-e6e8b36d3b09",
                                                "text": "Diese Informationen müssen wir unbedingt einer breiteren Öffentlichkeit zugänglich machen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
