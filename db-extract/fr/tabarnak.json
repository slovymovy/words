                        "examples": [
                            {
                                "example_id": "6b359b10-b299-4d17-a3de-2e3871f9b10a",
                                "sense_id": "194f9a46-d46f-3bbd-9e0b-85c7f9c964cc",
                                "text": "« Dans un coin tout sale\nd’la ville de Montréal\ns’a rue Clark\nse trouve la Palo\ntenue par un gros\nTabarnak… »"
                            }
                        ]
                    },
                    {
                        "sense_id": "2a92e7c6-c119-3fb3-a4cb-e326dac8bb6d",
                        "entry_id": "3fdd03a4-0590-381a-b4ca-14bda107df41",
                        "glosses": [
                            "Personne désignée dans un mouvement de colère ou de désespoir."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "f93d74f2-16c6-4b81-bf16-127dcf94cb9f",
                                "sense_id": "2a92e7c6-c119-3fb3-a4cb-e326dac8bb6d",
                                "text": "Tu crèveras pas toi aussi, mon tabarnak!"
                            }
                        ]
                    }
