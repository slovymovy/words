                    {
                        "sense_id": "33092c7f-bd46-3835-9312-7fd0533a7cc7",
                        "entry_id": "17a6c125-420a-3268-8488-aba48c509028",
                        "glosses": [
                            "Linge mouillé utilisé pour repasser à la vapeur. On place la pattemouille entre le fer et le tissu à repasser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9caabc2-3ef9-49cb-a4aa-35a61b8ff05a",
                                "sense_id": "33092c7f-bd46-3835-9312-7fd0533a7cc7",
                                "text": "Repassez la laine et le cachemire à l'envers, avec une pattemouille et sans appuyer."
                            },
                            {
                                "example_id": "d1b6e6b0-3d05-4a33-adb6-64be08673f4e",
                                "sense_id": "33092c7f-bd46-3835-9312-7fd0533a7cc7",
                                "text": "On se sert d’une pattemouille qui est un tissu humide intercalé entre le fer et le tissu à décatir."
                            },
                            {
                                "example_id": "7af92191-1829-44ab-a469-337a7bf5aee4",
                                "sense_id": "33092c7f-bd46-3835-9312-7fd0533a7cc7",
                                "text": "Comme le tissu noir marque facilement à la chaleur, utiliser une pattemouille évitera les miroitements indésirables."
                            }
                        ]
                    }
                ],
