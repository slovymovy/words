                                "target_senses": [
                                    {
                                        "sense_id": "b1589d24-08b5-305b-aa7a-c36fe98def4a",
                                        "entry_id": "e17ed71b-945d-32ff-913f-63a8d4d48156",
                                        "glosses": [
                                            "A person who diagnoses, especially a medical doctor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b097d19-f2fb-4ea8-8332-1567bff21067",
                                                "sense_id": "b1589d24-08b5-305b-aa7a-c36fe98def4a",
                                                "text": "Dr. Robert Leroy Hutton, a retired specialist in internal medicine and a well‐known diagnostician, died yesterday here."
                                            },
                                            {
                                                "example_id": "7a9767c7-5d4e-42ca-8e0d-163c5d3297fd",
                                                "sense_id": "b1589d24-08b5-305b-aa7a-c36fe98def4a",
                                                "text": "Dr Smith was many things — a mentor, a friend, a helpful colleague — but his highest calling may have been as a diagnostician, in which role he undoubtedly saved lives by breaking a logjam in many a challenging differential diagnosis."
                                            },
                                            {
                                                "example_id": "f5193601-70b0-4239-8a9d-137bffa6a89a",
                                                "sense_id": "b1589d24-08b5-305b-aa7a-c36fe98def4a",
                                                "text": "\"More and more, the shrewdest thinkers and artists are precocious archeologists of ... ruins-in-the-making, indignant or stoical diagnosticians of defeat, enigmatic choreographers of the complex spiritual movements useful for individual survival in an era or permanent apocalypse.\""
                                            }
                                        ]
                                    }
                                ]
