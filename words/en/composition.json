{
    "word_family": [
        "compose",
        "composer",
        "composite",
        "component",
        "decompose",
        "decomposition"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba3fb3d1-7058-3c8e-a5ea-a300bb6ed514",
                    "sense_definition": "A short essay or story written as a school assignment.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "creative_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our teacher asked us to write a <w>composition</w> about our summer holidays.",
                            "target_lang_translations": {
                                "ru": "Наш учитель попросил нас написать <w>сочинение</w> о наших летних каникулах.",
                                "zh": "老师让我们写一篇关于暑假的<w>作文</w>。"
                            }
                        },
                        {
                            "text": "I made a few spelling mistakes in my English <w>composition</w>.",
                            "target_lang_translations": {
                                "ru": "Я сделал несколько орфографических ошибок в своём <w>сочинении</w> по английскому языку.",
                                "zh": "我的英语<w>作文</w>里有几个拼写错误。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "write a composition",
                        "English composition"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "education"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое эссе или рассказ, написанный в качестве школьного задания.",
                        "zh": "作为学校作业写的短文或故事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочинение",
                                "target_lang_sense_clarification": "школьное задание"
                            },
                            {
                                "target_lang_word": "эссе",
                                "target_lang_sense_clarification": "творческая работа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作文",
                                "target_lang_sense_clarification": "学校布置的写作练习"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03edd302-2c9c-307a-b2f6-6ff25e93551a",
                    "sense_definition": "The way in which a whole is made up of different parts; the nature of its ingredients or constituents.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are studying the chemical <w>composition</w> of the soil.",
                            "target_lang_translations": {
                                "ru": "Учёные изучают химический <w>состав</w> почвы.",
                                "zh": "科学家们正在研究土壤的化学<w>成分</w>。"
                            }
                        },
                        {
                            "text": "The demographic <w>composition</w> of the city has changed significantly over the last decade.",
                            "target_lang_translations": {
                                "ru": "Демографический <w>состав</w> города значительно изменился за последнее десятилетие.",
                                "zh": "过去十年里，这座城市的人口<w>组成</w>发生了显著变化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "makeup",
                        "structure",
                        "constitution",
                        "configuration",
                        "form"
                    ],
                    "common_phrases": [
                        "chemical composition",
                        "social composition",
                        "composition of the population"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, из каких частей состоит целое; природа его ингредиентов или составляющих.",
                        "zh": "整体由不同部分构成的方式；其成分或组成要素的性质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состав",
                                "target_lang_sense_clarification": "строение, структура"
                            },
                            {
                                "target_lang_word": "структура",
                                "target_lang_sense_clarification": "внутреннее устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "成分",
                                "target_lang_sense_clarification": "构成事物的要素"
                            },
                            {
                                "target_lang_word": "组成",
                                "target_lang_sense_clarification": "整体的构成情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37ffe193-fdc7-3a16-a075-2c4032b7698b",
                    "sense_definition": "A creative work, especially a poem, piece of music, or painting.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "creative_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orchestra performed a famous <w>composition</w> by Mozart.",
                            "target_lang_translations": {
                                "ru": "Оркестр исполнил знаменитое <w>произведение</w> Моцарта.",
                                "zh": "管弦乐队演奏了莫扎特的一部著名<w>作品</w>。"
                            }
                        },
                        {
                            "text": "She played her own piano <w>composition</w> at the concert.",
                            "target_lang_translations": {
                                "ru": "Она сыграла свою собственную фортепианную <w>композицию</w> на концерте.",
                                "zh": "她在音乐会上演奏了自己创作的钢琴<w>乐曲</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arrangement"
                    ],
                    "common_phrases": [
                        "musical composition",
                        "original composition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Творческая работа, особенно музыкальное произведение, стихотворение или картина.",
                        "zh": "一种创造性的作品，尤指诗歌、乐曲或画作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "произведение",
                                "target_lang_sense_clarification": "результат творчества"
                            },
                            {
                                "target_lang_word": "композиция",
                                "target_lang_sense_clarification": "музыкальное произведение"
                            },
                            {
                                "target_lang_word": "сочинение",
                                "target_lang_sense_clarification": "опус"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "作品",
                                "target_lang_sense_clarification": "艺术创作的成果"
                            },
                            {
                                "target_lang_word": "乐曲",
                                "target_lang_sense_clarification": "音乐创作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e9b79559-b0c5-3757-8044-e0dcbfd4f323",
                    "sense_definition": "The artistic arrangement of the parts of a picture, photograph, or scene.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer adjusted the lighting to improve the <w>composition</w> of the shot.",
                            "target_lang_translations": {
                                "ru": "Фотограф настроил освещение, чтобы улучшить <w>композицию</w> кадра.",
                                "zh": "摄影师调整了灯光以改善画面的<w>构图</w>。"
                            }
                        },
                        {
                            "text": "This painting has a very dynamic <w>composition</w> that draws the eye to the center.",
                            "target_lang_translations": {
                                "ru": "У этой картины очень динамичная <w>композиция</w>, которая притягивает взгляд к центру.",
                                "zh": "这幅画的<w>构图</w>非常有动感，能将视线吸引到中心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "arrangement",
                        "form",
                        "configuration"
                    ],
                    "common_phrases": [
                        "balanced composition",
                        "color composition"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "art"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Художественное расположение частей картины, фотографии или сцены.",
                        "zh": "图画、照片或场景中各部分的艺术性布局。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "композиция",
                                "target_lang_sense_clarification": "построение, расположение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "构图",
                                "target_lang_sense_clarification": "视觉艺术中的布局"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26544d6f-d66e-3581-90f6-84a025172a0f",
                    "sense_definition": "The act or process of creating music, writing, or art.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "creative_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The date of <w>composition</w> for this poem is believed to be around 1800.",
                            "target_lang_translations": {
                                "ru": "Считается, что дата <w>написания</w> этого стихотворения — около 1800 года.",
                                "zh": "这首诗的<w>创作</w>日期被认为是在1800年左右。"
                            }
                        },
                        {
                            "text": "He devoted his entire life to the <w>composition</w> of opera.",
                            "target_lang_translations": {
                                "ru": "Он посвятил всю свою жизнь <w>сочинению</w> опер.",
                                "zh": "他毕生致力于歌剧的<w>创作</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "date of composition",
                        "process of composition",
                        "method of composition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс создания музыки, литературного произведения или предмета искусства.",
                        "zh": "创作音乐、文学作品或艺术品的行为或过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочинение",
                                "target_lang_sense_clarification": "процесс создания"
                            },
                            {
                                "target_lang_word": "написание",
                                "target_lang_sense_clarification": "создание текста"
                            },
                            {
                                "target_lang_word": "создание",
                                "target_lang_sense_clarification": "творческий процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创作",
                                "target_lang_sense_clarification": "艺术或文学的创造过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a535bc0-faae-39ea-a1bb-131ff915038b",
                    "sense_definition": "A mixture of ingredients or elements.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The material is a durable <w>composition</w> of plastic and wood fibers.",
                            "target_lang_translations": {
                                "ru": "Этот материал представляет собой прочную <w>смесь</w> пластика и древесных волокон.",
                                "zh": "这种材料是由塑料和木纤维组成的耐用<w>混合物</w>。"
                            }
                        },
                        {
                            "text": "This sauce is a complex <w>composition</w> of herbs and spices.",
                            "target_lang_translations": {
                                "ru": "Этот соус представляет собой сложную <w>композицию</w> из трав и специй.",
                                "zh": "这种酱汁是由草药和香料调配而成的复杂<w>混合物</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mixture",
                        "blend",
                        "composite",
                        "melange"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смесь ингредиентов или элементов.",
                        "zh": "成分或元素的混合物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смесь",
                                "target_lang_sense_clarification": "соединение веществ"
                            },
                            {
                                "target_lang_word": "композиция",
                                "target_lang_sense_clarification": "сложный состав"
                            },
                            {
                                "target_lang_word": "состав",
                                "target_lang_sense_clarification": "набор компонентов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混合物",
                                "target_lang_sense_clarification": "多种物质的结合"
                            },
                            {
                                "target_lang_word": "合成材料",
                                "target_lang_sense_clarification": "人工组合的物质"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}