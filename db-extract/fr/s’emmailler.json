                        "glosses": [
                            "Se prendre dans les mailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2daffe96-6546-4952-8cd6-080ff912c354",
                                "sense_id": "70287263-5b78-3fb2-bd46-c91b90a61604",
                                "text": "Nous les faisons tourner dans le labyrinthe, et dans leur propre filet s’emmailler et s’immobiliser."
                            },
                            {
                                "example_id": "05a0f438-5552-428b-8bf1-d309e2683b16",
                                "sense_id": "70287263-5b78-3fb2-bd46-c91b90a61604",
                                "text": "On le tend en lui faisant décrire des courbes dans lesquelles le poisson s’engage et où il ne tarde pas à s’emmailler par la tête."
                            }
                        ]
                    }
