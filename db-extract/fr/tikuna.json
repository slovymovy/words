                    {
                        "sense_id": "b67ed130-f232-3177-96bc-8ddfc734d4b1",
                        "entry_id": "7aa21b8c-c4af-370a-84c3-399497cd2199",
                        "glosses": [
                            "Langue amérindienne du Brésil, de Colombie et du Pérou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a6ee2fa-2ce2-4ff4-b59f-f0ba795d38be",
                                "sense_id": "b67ed130-f232-3177-96bc-8ddfc734d4b1",
                                "text": "La langue autochtone brésilienne la plus parlée est le tikuna, qui possède plus de trente mille locuteurs dans la région limitrophe de la Colombie et du Pérou."
                            },
                            {
                                "example_id": "61910544-cccd-46ad-a207-bb67a31698f9",
                                "sense_id": "b67ed130-f232-3177-96bc-8ddfc734d4b1",
                                "text": "Le tikuna est une langue amérindienne sans parenté connue parlée en Amazonie occidentale. Ses quelque 60 000 locuteurs, un nombre en apparence réduit, en font la langue indigène la plus parlée du bassin amazonien."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ca35c93b-09e2-35f5-aca2-1c56d7176373",
                "word": "Tikuna",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "103d0b9e-b88c-4606-8d83-3aa30f25dbec",
                        "entry_id": "ca35c93b-09e2-35f5-aca2-1c56d7176373",
                        "tags": [],
                        "form": "Ticuna"
