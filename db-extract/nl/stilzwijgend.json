                    {
                        "sense_id": "1b1dd808-2a9c-3922-8d0c-aa8062685da7",
                        "entry_id": "4e4d5b02-ff62-3593-896e-49b1b47c70d7",
                        "glosses": [
                            "zonder iets openlijk uitgesproken te hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6571325f-a94b-4656-9f09-a4500fa7b33f",
                                "sense_id": "1b1dd808-2a9c-3922-8d0c-aa8062685da7",
                                "text": "Met de stilzwijgende deal zou de nieuwe coalitie - met elf raadsleden net één zetel groter dan de oppositie - spotten met de regels van de lokale democratie."
                            },
                            {
                                "example_id": "75fa912c-fcb4-4f2b-9791-f65b7360643c",
                                "sense_id": "1b1dd808-2a9c-3922-8d0c-aa8062685da7",
                                "text": "Ze hebben al een stilzwijgende afspraak met elkaar gemaakt. Wat de uitslag ook wordt, morgenochtend is er hoe dan ook contact tussen vader en zoon. ,,De winnaar gaat bellen. Pa kan dus een telefoontje van mij verwachten,\" zo lacht Gino Bosz."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70e30e9e-1843-4bd6-9434-2d074e2c941a",
                        "source_entry_id": "4e4d5b02-ff62-3593-896e-49b1b47c70d7",
                        "source_sense_id": "1b1dd808-2a9c-3922-8d0c-aa8062685da7",
                        "source_sense_description": "zonder iets openlijk uitgesproken te hebben",
                        "target_lang_word": "stillschweigend",
