                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bae191e0-e176-38b0-953a-58d51b2d11ee",
                                        "entry_id": "b1e2f597-4c06-3fce-b4a5-62387599bccb",
                                        "glosses": [
                                            "A slight convexity, arching or curvature of a surface of a road, beam, roof, ship's deck etc., so that liquids will flow off the sides."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b771f509-2f99-484c-b6ca-e413048cdcad",
                                                "sense_id": "bae191e0-e176-38b0-953a-58d51b2d11ee",
                                                "text": "From end to end, just behind the houses, ran the broad gravel walk, with its emphatic camber and its metal-edged gutters where a child's ball would come to rest and the first few plane leaves, dusty but still green, were already falling, since the summer had been so hot and rainless all through."
                                            },
                                            {
                                                "example_id": "e5232cb6-6173-48d7-9c04-c108679deabf",
                                                "sense_id": "bae191e0-e176-38b0-953a-58d51b2d11ee",
                                                "text": "The track was stony with a grassy camber up the middle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15554404-d664-39f3-a328-c01a3ba0ede1",
                                        "entry_id": "b1e2f597-4c06-3fce-b4a5-62387599bccb",
                                        "glosses": [
                                            "The slope of a curved road created to minimize the effect of centrifugal force."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26e4540e-6b49-44fe-84fc-c10303b2808c",
                                                "sense_id": "15554404-d664-39f3-a328-c01a3ba0ede1",
                                                "text": "Again we were stricken of our palsy, slowed down, re-accelerated, and there, at last, were the few huts of a hamlet, with the lorry, lying at an angle in the road's camber, outside a tea-shop."
                                            },
                                            {
                                                "example_id": "b3ea11fe-ff34-4adc-85f7-df2184b70c16",
                                                "sense_id": "15554404-d664-39f3-a328-c01a3ba0ede1",
                                                "text": "Even a small camber one way caused the whole outfit to list alarmingly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00c9938a-aaf5-3c43-9112-06d698ed9e1a",
                                        "entry_id": "b1e2f597-4c06-3fce-b4a5-62387599bccb",
                                        "glosses": [
                                            "An upward concavity in the underside of a beam, girder, or lintel; also, a slight upward concavity in a straight arch."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7697c91-af57-3361-aef8-8305d491fb4e",
                                        "entry_id": "b1e2f597-4c06-3fce-b4a5-62387599bccb",
                                        "glosses": [
                                            "The alignment on the roll axis of the wheels of a road vehicle, where positive camber signifies that the wheels are closer together at the bottom than the top."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "615cd16b-faf3-3381-98f8-4753cf021b30",
                                        "entry_id": "b1e2f597-4c06-3fce-b4a5-62387599bccb",
                                        "glosses": [
                                            "The curvature of an airfoil."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7dcd257f-68e4-3918-8c2a-934fbf857ef4",
                                        "entry_id": "b1e2f597-4c06-3fce-b4a5-62387599bccb",
                                        "glosses": [
                                            "A small enclosed dock in which timber for masts (etc.) is kept to weather."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
