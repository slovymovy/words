        "fr-extract.jsonl": [
            {
                "entry_id": "6bd60286-0fe7-3fc8-b749-8fee71e59c6e",
                "word": "biome",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6e66ae2-f3f2-401c-9dab-26c6d9bee3bf",
                        "entry_id": "6bd60286-0fe7-3fc8-b749-8fee71e59c6e",
                        "tags": [
                            "plural"
                        ],
                        "form": "biomes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7a21f801-bfc4-3149-9842-fe9edf094cbd",
                        "entry_id": "6bd60286-0fe7-3fc8-b749-8fee71e59c6e",
                        "glosses": [
                            "Ensemble écologique présentant une très grande homogénéité sur une vaste surface."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f94a489-6b14-4e7d-96cb-562764736d4b",
                                "sense_id": "7a21f801-bfc4-3149-9842-fe9edf094cbd",
                                "text": "Les écotones, qui correspondent à des espaces où une partie des paramètres physiques et biologiques sont proches de seuils vitaux, sont affectés par des dynamiques temporelles et spatiales plus actives que le centre des grands biomes."
                            },
                            {
                                "example_id": "c558c8e6-1b60-4288-a0b7-dbe0766f1385",
                                "sense_id": "7a21f801-bfc4-3149-9842-fe9edf094cbd",
                                "text": "Bien entendu, l’élevage extensif nécessite de vastes espaces : jusqu'à 10 hectares par tête de gros bétail. La zone sahélienne est peu peuplée. Entre Dakar et le Darfour, les habitants de ce « biome » ne dépassent pas vingt millions d'habitants, soit 2 % de tout le continent africain (un milliard d'habitants), et toute la population des zones de sahel ne représente pas une province du Nigeria."
                            },
                            {
                                "example_id": "27bac991-39bf-4a40-8fb9-9fd3567bb033",
                                "sense_id": "7a21f801-bfc4-3149-9842-fe9edf094cbd",
                                "text": "Exemples de biomes : toundra, taïga, forêt tempérée, biome méditerranéen (matorral), steppe, savane, forêt équatoriale humide, désert, littoral, abysses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9acf056a-f6b1-4982-b4e2-52e4b55ba6b8",
                        "source_entry_id": "6bd60286-0fe7-3fc8-b749-8fee71e59c6e",
                        "source_sense_id": "7a21f801-bfc4-3149-9842-fe9edf094cbd",
                        "target_lang_word": "Biom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19c10643-b288-324a-b57f-3261a34a7967",
                                        "entry_id": "c16b653a-8020-3ab8-aa4d-cc005806fd59",
                                        "glosses": [
                                            "Lebensraum, der einer konkreten einheitlichen Landschaft entspricht; Begriff der Landschaftsökologie und der Bioökologie"
                                        ],
                                        "tags": [
                                            "Biogeographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "861c509c-c347-44d6-8d96-a6ae44614711",
                                                "sense_id": "19c10643-b288-324a-b57f-3261a34a7967",
                                                "text": "Die Zerstörung der Pampa geht langsamer als bei anderen Biomen in Brasilien voran."
                                            },
                                            {
                                                "example_id": "2c74eae3-864c-4319-a4fe-8055291eb9a0",
                                                "sense_id": "19c10643-b288-324a-b57f-3261a34a7967",
                                                "text": "Welches Biom darf es denn sein?"
                                            },
                                            {
                                                "example_id": "650f49b3-2476-4d0b-bdba-ed1918f8d06b",
                                                "sense_id": "19c10643-b288-324a-b57f-3261a34a7967",
                                                "text": "„Die tropischen Biome verengten sich von Norden und Süden her äquatorwärts, die offenen Savannengebiete breiteten sich aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
