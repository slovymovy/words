                "senses": [
                    {
                        "sense_id": "d26d4285-0bc8-329b-826a-18bade6888d8",
                        "entry_id": "a0bed2ea-9bc6-35f9-9e21-3cc55b25afbb",
                        "glosses": [
                            "Secrecy."
                        ],
                        "tags": [
