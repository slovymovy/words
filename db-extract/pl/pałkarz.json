                                    },
                                    {
                                        "sense_id": "32b47d85-a35a-3ee3-b041-bc76a25abe6e",
                                        "entry_id": "c68d8f9c-a15f-333f-a585-39f3905e20e0",
                                        "glosses": [
                                            "Any player selected for his or her team principally to bat, as opposed to a bowler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65fd8e82-f197-4486-93a3-519907428751",
                                                "sense_id": "32b47d85-a35a-3ee3-b041-bc76a25abe6e",
                                                "text": "It's hard to put this on his shoulders while the guy is so young, but I firmly believe Kane could go down as New Zealand's greatest ever batter."
                                            }
