                            {
                                "example_id": "31a53c2c-7ea8-4c0d-bb8d-aa99ef240a2a",
                                "sense_id": "bab8499b-57ee-3f3b-aae7-3c4b53711ad7",
                                "text": "„Ein Großteil der feinen Wandvertäfelung und des Leistenwerks war übermalt, zerschrammt und abgemeißelt oder mit billigen Papiertapeten überklebt worden.“"
                            },
                            {
                                "example_id": "4a234122-a875-491c-a4a6-0523825d7d3b",
                                "sense_id": "bab8499b-57ee-3f3b-aae7-3c4b53711ad7",
                                "text": "„Am Ende klebte er Papiertapeten an die Wände und strich sie in einer fröhlichen Farbe an.“"
                            }
                        ],
