                "senses": [
                    {
                        "sense_id": "86c2573f-05ab-369c-9f84-5f469767957f",
                        "entry_id": "ec40a986-5605-3d28-8e41-c1a16889e8c8",
                        "glosses": [
                            "Ausschluss durch Vertrag oder gesetzliche Bestimmung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2abac343-9e11-481f-a7e0-61fd472793a4",
                                "sense_id": "86c2573f-05ab-369c-9f84-5f469767957f",
                                "text": "Das Gericht strich die nichtige Abbedingung des Strafschadensersatzes."
                            },
                            {
                                "example_id": "e3f8d3d5-bbd3-4107-9b41-b6fb8af1c79f",
                                "sense_id": "86c2573f-05ab-369c-9f84-5f469767957f",
                                "text": "„Die völlige Abbedingung der Maklerpflichten wird damit in der Praxis nicht durchführbar sein. Möglich ist allerdings die Einschränkung der Haftung, […] die es dem Makler erlaubt, sich gegen Beratungsfehler effektiv und umfassend zu versichern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18014a20-18a4-480d-b01f-6c8891be92bc",
                        "source_entry_id": "ec40a986-5605-3d28-8e41-c1a16889e8c8",
                        "source_sense_id": "86c2573f-05ab-369c-9f84-5f469767957f",
