                "senses": [
                    {
                        "sense_id": "ecaae545-a9b0-3dab-b6c8-0072122e4131",
                        "entry_id": "94b4e470-e326-3879-b23d-bf29608fd4ba",
                        "glosses": [
                            "Fou."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "83f831cb-f561-4400-ab42-75a1bd3a0c3f",
                                "sense_id": "ecaae545-a9b0-3dab-b6c8-0072122e4131",
                                "text": "Ce type est trop ouf. – Ce type est complètement fou."
                            },
                            {
                                "example_id": "2d7f17d2-ec11-4d5d-97e6-fb88916746b6",
                                "sense_id": "ecaae545-a9b0-3dab-b6c8-0072122e4131",
                                "text": "Le concert était ouf ! – Le concert était génial !"
                            },
                            {
                                "example_id": "22bac377-355c-4586-892b-09ca06bf755a",
                                "sense_id": "ecaae545-a9b0-3dab-b6c8-0072122e4131",
                                "text": "Trop exposé au danger, je suis au bord du gouffre\nLes nerfs à vif, à cran, je pourrais devenir ouf."
                            },
                            {
                                "example_id": "c82e8aa4-89d5-4fbe-97a9-1b46fa9c3cee",
                                "sense_id": "ecaae545-a9b0-3dab-b6c8-0072122e4131",
                                "text": "C'est ouf !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "736e1f4d-4734-3f51-ab37-940d23aa040f",
                "word": "ouf",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a8a643ec-6c61-37cf-a6aa-a263fa0b7082",
                        "entry_id": "736e1f4d-4734-3f51-ab37-940d23aa040f",
                        "glosses": [
                            "Marque le soulagement ou le sentiment de chaud, après avoir subi une épreuve difficile ou désagréable, ou la satisfaction d’être délivré d’un fardeau, d’un travail, d’un ennui, d’une charge quelconque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c39b5529-4148-4315-be49-97fd8e6c05ec",
                                "sense_id": "a8a643ec-6c61-37cf-a6aa-a263fa0b7082",
                                "text": "— Mes cinq ans finis, je m’tire. Avec un ouf comme ça !"
                            },
                            {
                                "example_id": "bfb9e8a4-bf99-4c60-8a7c-6a137f67ac06",
                                "sense_id": "a8a643ec-6c61-37cf-a6aa-a263fa0b7082",
                                "text": "Cette disparition était pour lui une délivrance. Je l’ai entendu faire « ouf ! » non pas une fois, mais vingt fois."
                            },
                            {
                                "example_id": "ca058b14-871f-4ada-82e8-37f68893a238",
                                "sense_id": "a8a643ec-6c61-37cf-a6aa-a263fa0b7082",
                                "text": "Et ouf ! Elle pousse un soupir énorme, les deux bras au ciel !"
                            },
                            {
                                "example_id": "bbf9298f-89a4-4605-87d4-0a1abdf3eec4",
                                "sense_id": "a8a643ec-6c61-37cf-a6aa-a263fa0b7082",
                                "text": "L’élection de Warnock fait toutefois de Joe Biden le premier président depuis Franklin D. Roosevelt à ne perdre aucun sénateur après deux ans en poste. Ouf! Sweet Georgia!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23f88316-d15e-4678-b67e-c93507c16ecf",
                        "source_entry_id": "736e1f4d-4734-3f51-ab37-940d23aa040f",
                        "source_sense_id": "a8a643ec-6c61-37cf-a6aa-a263fa0b7082",
                        "target_lang_word": "puh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "puh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "011be560-fbbf-37a6-899a-637e85f8697b",
                                        "entry_id": "e8708e8d-9c0d-388b-aeab-d8c100db8c04",
                                        "glosses": [
                                            "Lautäußerung vor, während oder nach einer körperlichen oder geistigen Anstrengung oder bei dem Gedanken daran"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4f55740-09f3-4458-8f74-e45aae912399",
                                                "sense_id": "011be560-fbbf-37a6-899a-637e85f8697b",
                                                "text": "Puh, jetzt brauche ich erst Mal eine Pause!"
                                            },
                                            {
                                                "example_id": "4e4c2bbc-f164-44df-9a2c-b2ea84dfdc4c",
                                                "sense_id": "011be560-fbbf-37a6-899a-637e85f8697b",
                                                "text": "Puh! Und das soll ich alles ausrechnen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4bff02ba-3bce-31bf-86f9-f1b466721e2e",
                                        "entry_id": "e8708e8d-9c0d-388b-aeab-d8c100db8c04",
                                        "glosses": [
                                            "Ausruf des Missfallens oder Unbehagen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "221b74fd-da5b-478f-b683-a3250e88aac6",
                                                "sense_id": "4bff02ba-3bce-31bf-86f9-f1b466721e2e",
                                                "text": "Puh, ist das warm heute."
                                            },
                                            {
                                                "example_id": "d885f59b-7cfe-4115-b1c6-ecdb7ec7d0cb",
                                                "sense_id": "4bff02ba-3bce-31bf-86f9-f1b466721e2e",
                                                "text": "Puh, wie das hier stinkt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
