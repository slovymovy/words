{
    "word_family": [
        "incredulity",
        "incredibly",
        "credulous",
        "credulity",
        "incredible"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4bcdbc1c-5379-31b6-86c0-3fde17f899cd",
                    "sense_definition": "Feeling or showing a lack of belief; skeptical.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "skepticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave him an <w>incredulous</w> look when he claimed he had won the lottery.",
                            "target_lang_translations": {
                                "cs": "Když tvrdil, že vyhrál v loterii, vrhla na něj <w>nevěřící</w> pohled."
                            }
                        },
                        {
                            "text": "The audience was <w>incredulous</w> at the magician's impossible trick.",
                            "target_lang_translations": {
                                "cs": "Publikum bylo z kouzelníkova nemožného triku <w>skeptické</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "skeptical",
                        "disbelieving",
                        "doubtful"
                    ],
                    "antonyms": [
                        "credulous",
                        "believing"
                    ],
                    "common_phrases": [
                        "incredulous look",
                        "incredulous stare"
                    ],
                    "target_lang_definitions": {
                        "cs": "Pocit nebo projev nedostatku víry; skeptický."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nevěřící",
                                "target_lang_sense_clarification": "vyjadřující pochybnost nebo nedůvěru"
                            },
                            {
                                "target_lang_word": "skeptický",
                                "target_lang_sense_clarification": "pochybující o pravdivosti něčeho"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c84ccaa-fef6-386c-ab7c-cd953f3e206b",
                    "sense_definition": "Showing or reflecting a state of disbelief.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "skepticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>incredulous</w> tone suggested he did not trust the official report.",
                            "target_lang_translations": {
                                "cs": "Jeho <w>nedůvěřivý</w> tón naznačoval, že oficiální zprávě nevěří."
                            }
                        },
                        {
                            "text": "There was an <w>incredulous</w> silence in the room after the shocking announcement.",
                            "target_lang_translations": {
                                "cs": "Po šokujícím oznámení zavládlo v místnosti <w>pochybovačné</w> ticho."
                            }
                        }
                    ],
                    "synonyms": [
                        "unbelieving"
                    ],
                    "common_phrases": [
                        "incredulous tone",
                        "incredulous silence"
                    ],
                    "target_lang_definitions": {
                        "cs": "Projevující nebo odrážející stav nedůvěry."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nedůvěřivý",
                                "target_lang_sense_clarification": "vyjadřující pochybnost v tónu či postoji"
                            },
                            {
                                "target_lang_word": "pochybovačný",
                                "target_lang_sense_clarification": "vyjadřující nejistotu ohledně pravdivosti"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3b67990-99ee-3dad-8a0d-0a37c77ec9bd",
                    "sense_definition": "Hard to believe; highly unlikely.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "unbelievable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>incredulous</w> that such a simple mistake could cause a total system failure.",
                            "target_lang_translations": {
                                "cs": "Je <w>neuvěřitelné</w>, že taková jednoduchá chyba mohla způsobit úplné selhání systému."
                            }
                        },
                        {
                            "text": "The witness provided an <w>incredulous</w> account of the events that occurred that night.",
                            "target_lang_translations": {
                                "cs": "Svědek podal <w>nepravděpodobné</w> líčení událostí, které se tu noc staly."
                            }
                        }
                    ],
                    "synonyms": [
                        "incredible",
                        "implausible",
                        "unbelievable"
                    ],
                    "antonyms": [
                        "plausible",
                        "believable"
                    ],
                    "target_lang_definitions": {
                        "cs": "Těžko uvěřitelný; vysoce nepravděpodobný."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "neuvěřitelný",
                                "target_lang_sense_clarification": "takový, kterému lze jen stěží uvěřit"
                            },
                            {
                                "target_lang_word": "nepravděpodobný",
                                "target_lang_sense_clarification": "málo reálný, těžko představitelný"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}