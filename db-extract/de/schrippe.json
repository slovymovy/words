                    {
                        "translation_id": "b749632d-5a0e-4d10-b9db-fefac754ede0",
                        "source_entry_id": "d98ec0da-fc20-3f4b-b9d7-d30fdb8d7f79",
                        "source_sense_id": "8e0c3ce4-72bd-333d-8853-013c13b3b69a",
                        "source_sense_description": "besonders berlinisch: kleines, rundliches oder längliches aus Weißmehl hergestelltes Gebäck",
                        "target_lang_word": "petit pain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petit pain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f79dd5f-8c34-32b7-bfc4-cad2cefc3dae",
                                        "entry_id": "c0ad4e14-5e9b-3399-8c2c-0bd5865a9b4e",
                                        "glosses": [
                                            "Viennoiserie (non feuilletée) en forme de petit pain, au lait et sucré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb4e48c0-c461-4761-b1c6-5ec499e75974",
                                                "sense_id": "6f79dd5f-8c34-32b7-bfc4-cad2cefc3dae",
                                                "text": "Je vais chez le boulanger prendre un petit pain d’un sou où je mords comme un chien."
                                            },
                                            {
                                                "example_id": "b87547d7-2694-4931-8cf9-097ce8900224",
                                                "sense_id": "6f79dd5f-8c34-32b7-bfc4-cad2cefc3dae",
                                                "text": "Je sais aujourd’hui que c’étaient des albums d’images d’Épinal coloriées au pochoir, ils dataient au moins de Napoléon III, on les regardait en mangeant notre quatre-heures qu’on avait apporté dans notre petit panier à rabattants, moi c’était toujours un petit pain au lait avec une barre de chocolat à la crème, toujours."
                                            },
                                            {
                                                "example_id": "905982f8-c1de-4b94-931e-4d37550921f6",
                                                "sense_id": "6f79dd5f-8c34-32b7-bfc4-cad2cefc3dae",
                                                "text": "Je multiplie les petits pains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1bda476-1f9a-36de-939b-a17d71d52587",
                                        "entry_id": "c0ad4e14-5e9b-3399-8c2c-0bd5865a9b4e",
                                        "glosses": [
                                            "Pain au chocolat."
                                        ],
                                        "tags": [
                                            "Maroc",
                                            "Nord de la France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "649cf081-d818-49fc-8ad6-1b3ec586034d",
                                                "sense_id": "f1bda476-1f9a-36de-939b-a17d71d52587",
                                                "text": "« Ce matin (dimanche), mon épouse m’a demandé d’aller chercher du pain et des petits pains », commence Ludovic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
