        "fr-extract.jsonl": [
            {
                "entry_id": "b615127c-ea6e-39c3-9500-39abc1350cda",
                "word": "bonace",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "13b5382a-a1d3-404a-9fd2-8783fc329e49",
                        "entry_id": "b615127c-ea6e-39c3-9500-39abc1350cda",
                        "tags": [
                            "plural"
                        ],
                        "form": "bonaces"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f59a91d9-1e43-3e55-82c2-ead9e8d972f8",
                        "entry_id": "b615127c-ea6e-39c3-9500-39abc1350cda",
                        "glosses": [
                            "Calme, tranquillité de la mer après ou avant une tempête."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b4980b1-e230-4645-baa8-2fee450bcce8",
                                "sense_id": "f59a91d9-1e43-3e55-82c2-ead9e8d972f8",
                                "text": "J’ai vu fermenter les marais énormes, nasses\nOù pourrit dans les joncs tout un Léviathan !\nDes écroulements d’eaux au milieu des bonaces,\nEt les lointains vers les gouffres cataractant !"
                            }
                        ]
                    },
                    {
                        "sense_id": "41cc9e09-237a-348c-a695-ddbc184ed172",
                        "entry_id": "b615127c-ea6e-39c3-9500-39abc1350cda",
                        "glosses": [
                            "Tranquillité, repos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d23bf004-769b-4466-be09-47047db7679d",
                                "sense_id": "41cc9e09-237a-348c-a695-ddbc184ed172",
                                "text": "Donc, pour sauver ma vie ainsi que son honneur,\nEt me mettre avec elle au comble du bonheur,\nJe changeai d’un seul mot la tempête en bonace,\nEt fis ce que tout autre aurait fait en ma place."
                            },
                            {
                                "example_id": "a70b9347-7aef-4fa1-a0ce-12b08129f31d",
                                "sense_id": "41cc9e09-237a-348c-a695-ddbc184ed172",
                                "text": "Mon coeur outré d’ennuis n’ose rien espérer.\nUn orage si prompt qui trouble une bonace\nD’un naufrage certain nous porte la menace :\nJe n’en saurais douter, je péris dans le port."
                            },
                            {
                                "example_id": "3b4fcd71-8df3-4360-87d6-f4dd93f2c283",
                                "sense_id": "41cc9e09-237a-348c-a695-ddbc184ed172",
                                "text": "Je suis sûr que, malgré ma bonace charnelle, si je me trouvais en face de certaine femme dont la vue m’affole, je céderais."
                            },
                            {
                                "example_id": "4fd7a2ab-4a71-4a0e-86b5-c11dc79fa906",
                                "sense_id": "41cc9e09-237a-348c-a695-ddbc184ed172",
                                "text": "Ce qui subsista ensuite, ce fut seulement une pensée paisible qui ressemblait à de l’acceptation. Elle n’avait pas de couleur. C’était une émotion neutre, qui rappelait une bonace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9373e7bb-9ca3-4b94-969b-a4587f62e995",
                        "source_entry_id": "b615127c-ea6e-39c3-9500-39abc1350cda",
                        "source_sense_id": "f59a91d9-1e43-3e55-82c2-ead9e8d972f8",
                        "source_sense_description": "Calme, tranquillité de la mer.",
                        "target_lang_word": "lull",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "965ffa1a-3e35-3fe1-b7e6-8ff709c233cf",
                                        "entry_id": "3365ce6f-fe9c-39af-b13f-bf677ec9f6e1",
                                        "glosses": [
                                            "A period of rest or soothing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41eca79e-7034-3e1b-b89f-06ae765c7e82",
                                        "entry_id": "3365ce6f-fe9c-39af-b13f-bf677ec9f6e1",
                                        "glosses": [
                                            "A period of reduced activity; a respite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                                        "entry_id": "3365ce6f-fe9c-39af-b13f-bf677ec9f6e1",
                                        "glosses": [
                                            "A period without waves or wind."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c1683cc-d82e-415b-886b-a90aa909fcec",
                                                "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                                                "text": "[…] during the lull, wind shifted to S. E. […]"
                                            },
                                            {
                                                "example_id": "77369223-699a-443d-814b-80838a942a9f",
                                                "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                                                "text": "After the lull the wind does not appear to have blown with any great strength […]"
                                            },
                                            {
                                                "example_id": "d9017816-f1dc-4b24-a31a-e1ca711f0de6",
                                                "sense_id": "92d65073-bc46-30da-9c6e-b11f1d7b4cdb",
                                                "text": "The air under each cloud has spent time near the surface, has been slowed and backed by friction—it is a lull."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d274a94-d0fa-37bf-a31f-9071e79c0a16",
                                        "entry_id": "3365ce6f-fe9c-39af-b13f-bf677ec9f6e1",
                                        "glosses": [
                                            "An extended pause between sets of waves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2064f61-1eb9-4d8a-8b65-c54a78bbf676",
                                                "sense_id": "1d274a94-d0fa-37bf-a31f-9071e79c0a16",
                                                "text": "It is advisable to leave the surf zone during the lull between sets of larger waves, waiting outside the surf zone for a lull."
                                            },
                                            {
                                                "example_id": "bcc33ee5-86e7-490f-8dd4-61464ec0b522",
                                                "sense_id": "1d274a94-d0fa-37bf-a31f-9071e79c0a16",
                                                "text": "About 2 hours in, a long lull cleared everyone out, and then it started getting a little more consistent and pushing chest ta neck high."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                                        "entry_id": "c343b338-f2d4-3f39-b035-449beb7f2da8",
                                        "glosses": [
                                            "To cause to rest by soothing influences; to compose; to calm"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d070aad3-2f21-4000-9440-34a2a85df0c3",
                                                "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                                                "text": "To lull him soft a sleepe"
                                            },
                                            {
                                                "example_id": "e6740966-2645-4e2e-acfd-5073c1eac1ae",
                                                "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                                                "text": "Such ſweet compulſion doth in muſick ly, / To lull the daughers of Neceſſity,"
                                            },
                                            {
                                                "example_id": "6f049317-63e3-452b-b6b7-1e2845e8b9d1",
                                                "sense_id": "36f82b84-e30b-3839-9aa5-83d9fce1445f",
                                                "text": "To lull with song an aching heart"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e7cd12f-8ef6-3de9-8e55-91a8aa486f10",
                                        "entry_id": "c343b338-f2d4-3f39-b035-449beb7f2da8",
                                        "glosses": [
                                            "To become gradually calm; to subside; to cease or abate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30bc07a6-ce06-44f5-8ba3-747b72cb2c95",
                                                "sense_id": "6e7cd12f-8ef6-3de9-8e55-91a8aa486f10",
                                                "text": "The storm lulled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
