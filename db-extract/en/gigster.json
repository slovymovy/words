                        "examples": [
                            {
                                "example_id": "a9ff9623-9d28-4ba8-b52d-a66d7fb43cf0",
                                "sense_id": "4b50beb5-bfaa-3e90-b10c-0a38f62e27bb",
                                "text": "Of additional interest to dance band musicians was the opening that month [November 1935] of an extension to Manchester’s largest musical instrument store, Mameloks on Oxford Road. The store had a ballroom, café, lounge, and teaching rooms. The Dance Band and Variety booking agencies on its premises made it a center for ‘gigsters’."
                            },
                            {
                                "example_id": "29ac0468-38ba-4d51-913a-7fe053a76b8d",
                                "sense_id": "4b50beb5-bfaa-3e90-b10c-0a38f62e27bb",
                                "text": "Regular gigsters say it's a good venue to play and the promoters have worked hard, even if they have to stuff three bands on a night to make ends meet."
                            }
                        ]
                    }
