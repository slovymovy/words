    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9e1ac8a-0fab-31fa-8f2c-d439d3909dbe",
                    "sense_definition": "Perturbation atmosphérique violente accompagnée de vent, d'éclairs, de tonnerre et souvent de fortes pluies ou de grêle.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meteorologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ciel devient tout noir et un violent <w>orage</w> éclate au-dessus de la ville."
                        },
                        {
                            "text": "Nous devons rentrer rapidement avant que l'<w>orage</w> ne commence à gronder."
                        }
                    ],
                    "synonyms": [
                        "tempête",
                        "grain"
                    ],
                    "common_phrases": [
                        "orage d'été",
                        "temps d'orage",
                        "gros orage"
                    ]
                },
                {
                    "sense_id": "ce2cc034-033e-339a-9868-58ff1ef1ecb7",
                    "sense_definition": "Désaccord violent, conflit ou crise qui éclate soudainement entre plusieurs personnes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conflit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à la colère de son directeur, il a préféré garder le silence et laisser passer l'<w>orage</w>."
                        },
                        {
                            "text": "Leur discussion animée risquait de provoquer un véritable <w>orage</w> au sein de l'équipe."
                        }
                    ],
                    "synonyms": [
                        "tourmente"
                    ],
                    "common_phrases": [
                        "laisser passer l'orage",
                        "orage dans l'air"
                    ]
                },
                {
                    "sense_id": "f611598a-009f-39c1-be56-d89376a16841",
                    "sense_definition": "Trouble violent qui agite l'esprit ou les passions et détruit la paix intérieure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des années d'agitation, les <w>orages</w> de sa jeunesse ont enfin laissé place à la sérénité."
                        },
                        {
                            "text": "Ce poème émouvant exprime avec force les <w>orages</w> secrets de la passion humaine."
                        }
                    ],
                    "synonyms": [
                        "tourmente"
                    ],
                    "common_phrases": [
                        "orage des passions",
                        "orages du cœur"
                    ]
                },
                {
                    "sense_id": "0ad79137-de29-34ab-addc-613a09748ccb",
                    "sense_definition": "Dispositif ou jeu d'orgue destiné à produire une imitation du roulement du tonnerre.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'organiste a fait retentir l'<w>orage</w> pour impressionner le public à la fin du concert."
                        },
                        {
                            "text": "Dans cette pièce baroque, l'effet d'<w>orage</w> est produit par un groupe de touches enfoncées au pédalier."
                        }
                    ]
                }
            ]
        }
    ]
