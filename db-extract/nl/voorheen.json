                "forms": [],
                "senses": [
                    {
                        "sense_id": "d2f125e7-091a-33dc-8fca-1c6e48ddd10e",
                        "entry_id": "cc47f0e7-4155-32d7-831a-7bc00c1efbf7",
                        "glosses": [
                            "in het verleden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73043162-1e43-4193-8704-74d6378032f8",
                                "sense_id": "d2f125e7-091a-33dc-8fca-1c6e48ddd10e",
                                "text": "Deze regel gold voorheen wel, maar is sinds dit voorjaar afgeschaft."
                            },
                            {
                                "example_id": "7681375b-8337-46c0-b317-e7d42d624917",
                                "sense_id": "d2f125e7-091a-33dc-8fca-1c6e48ddd10e",
                                "text": "Bewoners van de Dokter Schräderlaan in het Brabantse Oisterwijk keken toch wat vreemd op, toen de werkzaamheden voor een nieuwe riolering waren voltooid. De lantaarnpaal die voorheen op het trottoir stond, staat nu plotseling op de rijbaan. Dat dat niet helemaal de bedoeling is, blijkt wel uit het feit dat de paal wordt afgeschermd door een rood-wit waarschuwingsbord. De gemeente Oisterwijk laat in een reactie weten dat het om een tijdelijke situatie gaat."
                            },
                            {
                                "example_id": "62e36d63-f19d-4bd0-8395-6290989b060d",
                                "sense_id": "d2f125e7-091a-33dc-8fca-1c6e48ddd10e",
                                "text": "De grappen waren even hard als voorheen, maar men werd wat zorgzamer voor elkaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c0464fb-22b4-496c-8da1-80d85e66d39e",
