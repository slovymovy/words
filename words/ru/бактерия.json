            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f4f2d9f-5787-340f-b466-024481522606",
                    "sense_definition": "одноклеточный микроорганизм, относящийся к прокариотам",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "микробиология",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врачи назначили антибиотики, чтобы уничтожить вредную <w>бактерию</w> в организме.",
                            "target_lang_translations": {
                                "en": "Doctors prescribed antibiotics to destroy the harmful <w>bacterium</w> in the body."
                            }
                        },
                        {
                            "text": "Учёные изучают, как <w>бактерии</w> приспосабливаются к новым условиям окружающей среды.",
                            "target_lang_translations": {
                                "en": "Scientists are studying how <w>bacteria</w> adapt to new environmental conditions."
                            }
                        }
                    ],
                    "synonyms": [
                        "эубактерия"
                    ],
                    "common_phrases": [
                        "вредная бактерия",
                        "полезная бактерия"
                    ],
                    "target_lang_definitions": {
                        "en": "A single-celled microorganism belonging to the prokaryotes."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bacterium",
                                "target_lang_sense_clarification": "a single-celled organism"
                            },
                            {
                                "target_lang_word": "bacteria",
                                "target_lang_sense_clarification": "the plural form, commonly used to refer to these organisms in general"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d30ade2e-50d9-37ac-a20d-29ce4efd804f",
                    "sense_definition": "домен безъядерных микроорганизмов",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "микробиология",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Современная биология выделяет три домена жизни: археи, эукариоты и <w>бактерии</w>.",
                            "target_lang_translations": {
                                "en": "Modern biology distinguishes three domains of life: archaea, eukaryotes, and <w>bacteria</w>."
                            }
                        },
                        {
                            "text": "Генетический анализ показывает, что <w>бактерии</w> представляют собой одну из древнейших групп организмов на Земле.",
                            "target_lang_translations": {
                                "en": "Genetic analysis shows that <w>bacteria</w> represent one of the oldest groups of organisms on Earth."
                            }
                        }
                    ],
                    "synonyms": [
                        "эубактерии"
                    ],
                    "target_lang_definitions": {
                        "en": "A domain of single-celled, prokaryotic microorganisms."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Bacteria",
                                "target_lang_sense_clarification": "the biological domain of life"
                            }
                        ]
                    }
                }
            ]
        }
    ]
