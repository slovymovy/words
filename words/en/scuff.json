{
    "word_family": [
        "scuffing",
        "scuffed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac3bfbb8-e309-3adb-81b5-36a3d8bec71c",
                    "sense_definition": "A mark or scratch left on a surface by scraping.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surface_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new wooden floor already has several <w>scuff</w> marks from the heavy furniture.",
                            "target_lang_translations": {
                                "nl": "De nieuwe houten vloer heeft al verschillende <w>schuurplekken</w> door het zware meubilair."
                            }
                        },
                        {
                            "text": "He tried to clean the black <w>scuff</w> off his white sneakers.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde de zwarte <w>kras</w> van zijn witte sneakers te poetsen."
                            }
                        }
                    ],
                    "synonyms": [
                        "scratch",
                        "scrape",
                        "mark"
                    ],
                    "common_phrases": [
                        "scuff mark"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een kras of beschadiging op een oppervlak door schuren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kras",
                                "target_lang_sense_clarification": "algemene term voor een beschadiging door schuren"
                            },
                            {
                                "target_lang_word": "schuurplek",
                                "target_lang_sense_clarification": "specifieke plek die is ontstaan door wrijving"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8cf1ac1-69da-3bdc-8d8b-79e522ede540",
                    "sense_definition": "The back part of the neck.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother cat picked up her kitten by the <w>scuff</w> of its neck.",
                            "target_lang_translations": {
                                "nl": "De moederpoes pakte haar kitten bij het <w>nekvel</w> op."
                            }
                        },
                        {
                            "text": "He grabbed the bully by the <w>scuff</w> of his shirt and pulled him away.",
                            "target_lang_translations": {
                                "nl": "Hij greep de pester bij het <w>nekvel</w> van zijn shirt en trok hem weg."
                            }
                        }
                    ],
                    "synonyms": [
                        "scruff"
                    ],
                    "common_phrases": [
                        "scuff of the neck"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het achterste deel van de nek."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "nekvel",
                                "target_lang_sense_clarification": "de huid in de nek, vaak gebruikt bij dieren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13b30a7f-222d-3541-9bee-2f35ece2f7fb",
                    "sense_definition": "The sound made by dragging feet or scraping an object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I heard the soft <w>scuff</w> of slippers moving across the hallway floor.",
                            "target_lang_translations": {
                                "nl": "Ik hoorde het zachte <w>geschuifel</w> van slippers over de gangvloer."
                            }
                        },
                        {
                            "text": "The rhythmic <w>scuff</w> of his boots against the pavement echoed in the quiet street.",
                            "target_lang_translations": {
                                "nl": "Het ritmische <w>geschuur</w> van zijn laarzen over het trottoir echode door de stille straat."
                            }
                        }
                    ],
                    "synonyms": [
                        "scrape"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het geluid dat wordt gemaakt door met de voeten te slepen of over een voorwerp te schuren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "geschuifel",
                                "target_lang_sense_clarification": "geluid van slepende voeten"
                            },
                            {
                                "target_lang_word": "geschuur",
                                "target_lang_sense_clarification": "geluid van wrijving tegen een oppervlak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06467a7f-5e12-38ae-bedc-052564b41df2",
                    "sense_definition": "A type of backless slipper.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "footwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She slipped into her comfortable <w>scuff</w> slippers after a long day at work.",
                            "target_lang_translations": {
                                "nl": "Ze stapte in haar comfortabele <w>muiltjes</w> na een lange werkdag."
                            }
                        },
                        {
                            "text": "He left his leather <w>scuff</w> by the front door.",
                            "target_lang_translations": {
                                "nl": "Hij liet zijn leren <w>instapper</w> bij de voordeur staan."
                            }
                        }
                    ],
                    "synonyms": [
                        "slipper"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een type slipper zonder hiel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "muiltje",
                                "target_lang_sense_clarification": "open schoen zonder hiel"
                            },
                            {
                                "target_lang_word": "instapper",
                                "target_lang_sense_clarification": "algemene term voor schoeisel waar je zo in stapt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e21d6b8-ff7d-38d2-afc7-19d7daff1303",
                    "sense_definition": "A light or brief shower of rain or mist.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were caught in a sudden <w>scuff</w> of rain while hiking up the mountain.",
                            "target_lang_translations": {
                                "nl": "We werden overvallen door een plotseling <w>buitje</w> tijdens het wandelen in de bergen."
                            }
                        },
                        {
                            "text": "Cold <w>scuff</w> of mist drifted down from the hills as the sun began to set.",
                            "target_lang_translations": {
                                "nl": "Een koude <w>nevel</w> dreef van de heuvels naar beneden toen de zon begon te zakken."
                            }
                        }
                    ],
                    "synonyms": [
                        "shower",
                        "drizzle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een lichte of korte regenbui of nevel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "motregen",
                                "target_lang_sense_clarification": "zeer fijne regen"
                            },
                            {
                                "target_lang_word": "buitje",
                                "target_lang_sense_clarification": "korte, lichte regenbui"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c8259ef-5539-3370-80c7-0c259ffb60fa",
                    "sense_definition": "A small scale or flake of skin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "skin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dry skin left a small <w>scuff</w> on his shoulder.",
                            "target_lang_translations": {
                                "nl": "De droge huid liet een klein <w>huidschilfertje</w> achter op zijn schouder."
                            }
                        },
                        {
                            "text": "He brushed the tiny <w>scuff</w> of dead skin from his collar.",
                            "target_lang_translations": {
                                "nl": "Hij veegde het kleine <w>huidschilfertje</w> van zijn kraag."
                            }
                        }
                    ],
                    "synonyms": [
                        "scale",
                        "flake"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een klein schilfertje of velletje van de huid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "huidschilfer",
                                "target_lang_sense_clarification": "klein losgekomen stukje huid"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e549575-1923-3b9e-acfb-3dcfb315466c",
                    "sense_definition": "To drag or scrape the feet along the ground while walking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please stop <w>scuffing</w> your feet when you walk down the hallway.",
                            "target_lang_translations": {
                                "nl": "Stop alsjeblieft met het <w>schuifelen</w> met je voeten als je door de gang loopt."
                            }
                        },
                        {
                            "text": "The tired child began to <w>scuff</w> his shoes against the pavement.",
                            "target_lang_translations": {
                                "nl": "Het vermoeide kind begon met zijn schoenen over het trottoir te <w>schuifelen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "shuffle",
                        "scrape"
                    ],
                    "target_lang_definitions": {
                        "nl": "Met de voeten over de grond slepen tijdens het lopen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schuifelen",
                                "target_lang_sense_clarification": "lopen met slepende voeten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ceaf602-6671-3519-8ce5-bb3ea915ef6b",
                    "sense_definition": "To damage the surface of an object by scraping it against something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surface_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>scuff</w> your new leather shoes on the concrete.",
                            "target_lang_translations": {
                                "nl": "Pas op dat je je nieuwe leren schoenen niet <w>beschadigt</w> op het beton."
                            }
                        },
                        {
                            "text": "He accidentally <w>scuffed</w> the paint on the wall while moving the chair.",
                            "target_lang_translations": {
                                "nl": "Hij <w>schuurde</w> per ongeluk de verf van de muur terwijl hij de stoel verplaatste."
                            }
                        }
                    ],
                    "synonyms": [
                        "scrape",
                        "scratch"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het oppervlak van een voorwerp beschadigen door ertegenaan te schuren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "beschadigen",
                                "target_lang_sense_clarification": "algemene term voor schade toebrengen"
                            },
                            {
                                "target_lang_word": "schuren",
                                "target_lang_sense_clarification": "door wrijving een kras maken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5420391f-3333-3cd3-9d0a-4b2cbbe5b743",
                    "sense_definition": "To hit a ball poorly, resulting in a weak or inaccurate shot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker <w>scuffed</w> his shot, and the ball rolled harmlessly to the goalkeeper.",
                            "target_lang_translations": {
                                "nl": "De spits <w>raakte de bal verkeerd</w> en de bal rolde ongevaarlijk naar de keeper."
                            }
                        },
                        {
                            "text": "He tried to kick the ball hard but <w>scuffed</w> it wide of the goal.",
                            "target_lang_translations": {
                                "nl": "Hij probeerde de bal hard te trappen, maar <w>raakte hem verkeerd</w> waardoor hij naast het doel ging."
                            }
                        }
                    ],
                    "synonyms": [
                        "mishit"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een bal slecht raken, wat resulteert in een zwak of onnauwkeurig schot."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verkeerd raken",
                                "target_lang_sense_clarification": "een bal niet zuiver raken"
                            },
                            {
                                "target_lang_word": "misslaan",
                                "target_lang_sense_clarification": "een bal niet goed raken bij een schot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11808e15-2f72-3c60-b5b3-78d3671a085c",
                    "sense_definition": "To touch or brush against something lightly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball <w>scuffed</w> the edge of the post before going out of play.",
                            "target_lang_translations": {
                                "nl": "De bal <w>schampte</w> de rand van de paal voordat hij uit het spel ging."
                            }
                        },
                        {
                            "text": "His hand <w>scuffed</w> the surface of the table as he reached for the glass.",
                            "target_lang_translations": {
                                "nl": "Zijn hand <w>streek langs</w> het oppervlak van de tafel toen hij naar het glas reikte."
                            }
                        }
                    ],
                    "synonyms": [
                        "graze",
                        "brush"
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets lichtjes aanraken of erlangs strijken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schampen",
                                "target_lang_sense_clarification": "iets lichtjes raken bij het passeren"
                            },
                            {
                                "target_lang_word": "langs strijken",
                                "target_lang_sense_clarification": "licht contact maken met een oppervlak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}