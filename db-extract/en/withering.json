                                        "sense_id": "910267d4-9332-39f1-a563-db76a472b39b",
                                        "entry_id": "21a028c6-8f85-389f-9dc0-9b1a74176000",
                                        "glosses": [
                                            "ausgestattet mit der Kraft zu vernichten oder real etwas vernichtend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98b04dd4-f0a3-42ce-b5ee-a7e55c79dcca",
                                                "sense_id": "910267d4-9332-39f1-a563-db76a472b39b",
                                                "text": "„Die Zahl der besonders zerstörerischen Supertaifune hat sich auf den Philippinen in den letzten Jahren vervielfacht.“"
                                            },
                                            {
                                                "example_id": "5278a3ac-47ff-4a56-a6c8-7bb15e52645e",
                                                "sense_id": "910267d4-9332-39f1-a563-db76a472b39b",
                                                "text": "„Wann sind Sanktionen zerstörerisch? Wenn sie in ihrer Maßlosigkeit nicht nachvollziehbar sind. Wenn sie andere Menschen willkürlich erniedrigen, missbrauchen, verbiegen oder ihre Persönlichkeit zerbrechen wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
