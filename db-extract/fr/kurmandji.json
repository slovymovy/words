                "senses": [
                    {
                        "sense_id": "2b0e40a4-b078-3ced-bb44-43a19844a262",
                        "entry_id": "6dee3adf-ee79-3006-8a69-325948b6f576",
                        "glosses": [
                            "Dialecte du kurde. Il est parlé par la majorité des habitants du nord du Kurdistan, plus précisément au sud-est de la Turquie, au nord-ouest de l’Iraq, au nord-ouest de l’Iran (à l’ouest et au nord-ouest du lac d’Ourmia) et au nord de la Syrie, ainsi que par les communautés kurdes de divers États de l’ancienne Union Soviétique (notamment l’Arménie)."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8ce0c2c9-e25b-49f8-9f1a-c349a1187b80",
                        "source_entry_id": "6dee3adf-ee79-3006-8a69-325948b6f576",
                        "source_sense_id": "2b0e40a4-b078-3ced-bb44-43a19844a262",
                        "target_lang_word": "Kurmanji",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kurmanji",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5db47dae-a24d-322e-a6e5-7078507c72a3",
                                        "entry_id": "4ed0bad4-e646-396e-aa6c-3b42f5daa9d4",
                                        "glosses": [
                                            "The Kurdish language with the largest number of speakers, spoken in Turkey, Syria, northernmost Iraq, and parts of Iran and Central Asia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2e9f6b5-83b2-48e5-9c84-b91d1854f315",
                        "source_entry_id": "6dee3adf-ee79-3006-8a69-325948b6f576",
                        "source_sense_id": "2b0e40a4-b078-3ced-bb44-43a19844a262",
                        "target_lang_word": "kurmancî",
                        "target_lang_code": "ku",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kurmancî",
                                "target_lang_code": "ku",
                                "target_senses": [
                                    {
                                        "sense_id": "8fc34fcd-926c-3607-89db-1da31214947f",
                                        "entry_id": "a3475e5d-a60c-366d-b4f4-80bfd8d4873f",
                                        "glosses": [
                                            "Zaravaya kurdî ya serekî ku li Bakurê Kurdistanê, Rojavayê Kurdistanê, bakurê Başûrê Kurdistanê, bakurê Rojhilata Kurdistanê, li Xorasanê û li herêmine Sovyetistana berê tê axivîn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04137d23-5858-4d97-81e6-27af7a21aae9",
                                                "sense_id": "8fc34fcd-926c-3607-89db-1da31214947f",
                                                "text": "Teqbîḥ nekin evan ṭifalan\nEv meywe eger ne abdar e\nKirmancî ye, ew qeder li kar e"
                                            },
                                            {
                                                "example_id": "7f2e45a2-87a4-4360-9970-778e2dc6a779",
                                                "sense_id": "8fc34fcd-926c-3607-89db-1da31214947f",
                                                "text": "Silîvî: Awayê kurmanciya herêma Silîvan e, ku li nîvroyê rojhelat ji kurmanciya Botan-Hekar-Behdînan û li nîvro û rojava jî ji ya Beriya Mêrdînê û rojavayê Qeredaxê bi hin awayan vediqete."
                                            },
                                            {
                                                "example_id": "c73e89c9-c539-45f8-bde6-a68c29627fee",
                                                "sense_id": "8fc34fcd-926c-3607-89db-1da31214947f",
                                                "text": "Wî berhemên Pûşkîn, Lêrmantov, Tolstoy, Nêksarov, Şêvçenko, Gorkî, Mayakovskî û şoreşger-helbestvanê bi eslê xwe kurd Fêrîk Polatbêkov ji rûsî wergerandine kurmanciyê."
                                            },
                                            {
                                                "example_id": "591ec61b-8644-4527-8ce4-a617863a1836",
                                                "sense_id": "8fc34fcd-926c-3607-89db-1da31214947f",
                                                "text": "Ergatîvî mohra kurmanciyê ye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "000bbb0c-7c3e-34a8-8191-009f3fc44a29",
                                        "entry_id": "a3475e5d-a60c-366d-b4f4-80bfd8d4873f",
                                        "glosses": [
                                            "Kurdî; hemî zaravayên kurdî, bi taybetî kurmancî (1) û soranî."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dddd9bfb-0fc5-4dc0-a3f9-39d63ed5f0db",
                                                "sense_id": "000bbb0c-7c3e-34a8-8191-009f3fc44a29",
                                                "text": "Van weşanên bi kurdî û osmanî, bi awayekî fireh, cih dan ziman, çand û berhemên edebiyata kurdî. Wan herdu zaravayên mezintirîn, kurmanciya jorê û kurmanciya jêrê esas girtin. Di nav van weşanan de, ya girîng, bêguman, Jîn e."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kurmancî",
                                "target_lang_code": "ku",
                                "target_senses": [
                                    {
                                        "sense_id": "b17c2840-c462-3f26-8d41-6d118e95afc3",
                                        "entry_id": "b871df06-e81d-3836-82c1-0def6f80af76",
                                        "glosses": [
                                            "Her tiştê bi kurmancî."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e25563a-a71f-42ca-a1d3-e7f454819072",
                                                "sense_id": "b17c2840-c462-3f26-8d41-6d118e95afc3",
                                                "text": "Stranên kurmancî; çîrokên kurmancî."
                                            },
                                            {
                                                "example_id": "62197256-aa7f-4a8c-be4d-119bf75c77d5",
                                                "sense_id": "b17c2840-c462-3f26-8d41-6d118e95afc3",
                                                "text": "Di alfabeya kurmancî ya latînî de 31 herf hene."
                                            },
                                            {
                                                "example_id": "0f3e339b-487c-479d-9a8c-de3238236c14",
                                                "sense_id": "b17c2840-c462-3f26-8d41-6d118e95afc3",
                                                "text": "Binêrin li şi‘ran heçî zaniye\nÇi terkîbekî serfê kurmancî ye"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
