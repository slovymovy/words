                        "cross_references": [
                            {
                                "target_word": "ribbon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39307008-9b7d-3bb8-bc61-b7802e92475f",
                                        "entry_id": "6c58d047-48e6-307b-bbcc-9f7f00930203",
                                        "glosses": [
                                            "A long, narrow strip of material used for decoration of clothing or the hair or gift wrapping."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f44da9bd-b3ea-4030-b36c-511933a092d8",
                                                "sense_id": "39307008-9b7d-3bb8-bc61-b7802e92475f",
                                                "text": "A Svveet diſorder in the dreſſe / Kindles in cloathes a vvantonneſſe: / […] / A Cuffe neglectfull, and thereby / Ribbands to flovv confuſedly: / […] / Do more bevvitch me, than vvhen Art / Is too preciſe in every part."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdc3d121-83ee-3704-b942-8c1ec6a25e03",
                                        "entry_id": "6c58d047-48e6-307b-bbcc-9f7f00930203",
                                        "glosses": [
                                            "An awareness ribbon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a56dcc2a-fd48-4b4a-8c7e-583075f405a6",
                                                "sense_id": "cdc3d121-83ee-3704-b942-8c1ec6a25e03",
                                                "text": "With Monday marking the beginning of October’s annual Breast Cancer Awareness Month observance, supporters will be donning their pink ribbons as a show of support for ongoing research for a cure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e9ba90-bbdc-3873-8153-68855d3205c8",
                                        "entry_id": "6c58d047-48e6-307b-bbcc-9f7f00930203",
                                        "glosses": [
                                            "An inked strip of material against which type is pressed to print letters in a typewriter or printer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b091dfdb-bcde-416c-980b-0bf209939559",
                                                "sense_id": "42e9ba90-bbdc-3873-8153-68855d3205c8",
                                                "text": "Late at night, in the typewriter light / Ripped his ribbon to shreds"
                                            },
                                            {
                                                "example_id": "73957b01-a058-4d39-9871-0ff2b2cfdda6",
                                                "sense_id": "42e9ba90-bbdc-3873-8153-68855d3205c8",
                                                "text": "They were single-shift, frontstroke, typebar typewriters with four-bank QWERTY keyboards, inked by a ribbon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c275c66-f4c0-3e64-b502-7bca4eccbe64",
                                        "entry_id": "6c58d047-48e6-307b-bbcc-9f7f00930203",
                                        "glosses": [
                                            "A narrow strip or shred."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3839627-c33f-4810-8c0a-94fce0aa3c4c",
                                                "sense_id": "2c275c66-f4c0-3e64-b502-7bca4eccbe64",
                                                "text": "a steel or magnesium ribbon"
                                            },
                                            {
                                                "example_id": "e75a800e-1c30-496c-b87f-603b15190d58",
                                                "sense_id": "2c275c66-f4c0-3e64-b502-7bca4eccbe64",
                                                "text": "sails torn to ribbons"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bfeb87d-ccfe-323a-8f14-caefe1b58e6a",
