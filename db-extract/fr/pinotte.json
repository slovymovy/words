                                        "glosses": [
                                            "crystal meth or speed."
                                        ],
                                        "tags": [
                                            "South-Africa",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d2b8a95-d690-4765-a2fb-374b8cbdacd0",
                                                "sense_id": "8ea475ea-2bbc-343a-a4d8-21db2d44e7fd",
                                                "text": "This Tuesday Special Assignment focuses on a deepening crisis in Cape Town. Many young adults and schoolchildren as young as 10 years are in the grip of a powerful drug called crystal methamphetamine – known locally as tik. It’s been on the fringes for several years but it is now catching on fast among the youth of the Western Cape."
                                            },
                                            {
                                                "example_id": "15ced798-a1bc-44ea-bd00-30a73af74100",
                                                "sense_id": "8ea475ea-2bbc-343a-a4d8-21db2d44e7fd",
                                                "text": "Over a third of all people seeking rehabilitation in the second half of 2005 reported that their primary problem was tik."
                                            },
                                            {
                                                "example_id": "db252c8b-c130-4e82-a5d6-02a3b51f3635",
                                                "sense_id": "8ea475ea-2bbc-343a-a4d8-21db2d44e7fd",
                                                "text": "Hardly a week goes by without news of a crime bust of some kind involving one of the buses travelling cross-country, with everything from mandrax to tik, marijuana and abalone finding its way on board."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
