                    },
                    {
                        "form_id": "9396043b-a21b-409d-8edc-90aab9b47afe",
                        "entry_id": "bc0ceb81-f4c1-340d-8b65-9b71ee7271f3",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most Rabelaisian"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f7608b40-a5cd-3d62-882a-b707ff5bcca3",
                        "entry_id": "bc0ceb81-f4c1-340d-8b65-9b71ee7271f3",
                        "glosses": [
                            "Pertaining to the works or period of Rabelais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f71f4893-f508-48d6-a4e8-c3b1873a1e2f",
                                "sense_id": "f7608b40-a5cd-3d62-882a-b707ff5bcca3",
                                "text": "In Italy, as in Rabelaisian France, the carnival entered not only elite theatrical performance and engravings but also the printed word."
                            }
                        ]
                    },
                    {
                        "sense_id": "d00694de-68dd-3234-ad5d-efad80f54b72",
                        "entry_id": "bc0ceb81-f4c1-340d-8b65-9b71ee7271f3",
                        "glosses": [
                            "Possessing a style of satirical humour characterized by exaggerated or grotesque characters and coarse jokes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d9a7983-2362-4dba-92f3-3766e2f1b5db",
                                "sense_id": "d00694de-68dd-3234-ad5d-efad80f54b72",
                                "text": "For although of unexceptionable morality, and addressed virginibus puerisque, the stories and illustrations with which this and others of these collections abound are frequently of a very Rabelaisian character."
                            },
                            {
                                "example_id": "a50668d7-e5f7-47c3-bfa2-8ba03a43058b",
                                "sense_id": "d00694de-68dd-3234-ad5d-efad80f54b72",
                                "text": "The smiths themselves were a grand lot of fellows, full of a robust, and sometimes Rabelaisian sense of humour, and between \"heats,\" they could be most entertaining."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5d04454e-bdca-48c6-aff7-2dcee49b9154",
                        "source_entry_id": "bc0ceb81-f4c1-340d-8b65-9b71ee7271f3",
                        "source_sense_description": "pertaining to the works or period of Rabelais",
                        "target_lang_word": "rabelaisien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rabelaisien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8dcf913a-80b0-3f73-b60b-93b3c9c776e7",
                                        "entry_id": "dfc63e4c-e71a-3961-bce6-8b7be1b3591f",
                                        "glosses": [
                                            "Qui se rapporte à François Rabelais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e19dab08-a55f-46f6-a2a5-7d49b3c71afc",
                                                "sense_id": "8dcf913a-80b0-3f73-b60b-93b3c9c776e7",
                                                "text": "Les héros rabelaisiens ont un boyau cullier prompt à se relâcher et, dans leurs conversations, la merde sous toutes ses formes est gentil lieu commun de rhétorique, terme obligé de comparaison."
                                            },
                                            {
                                                "example_id": "50991928-7c43-432c-aa58-b9e015ab8e74",
                                                "sense_id": "8dcf913a-80b0-3f73-b60b-93b3c9c776e7",
                                                "text": "Puisque le mot Baqbuq signifie en hébreu «bouteille», parler de la dive Bouteille Bacbuc revient à dire la dive Bouteille Bouteille, réduplication que l'on pourrait interpréter comme un ornement oriental, un feston linguistique ajouté à la polyglossie du texte rabelaisien."
                                            },
                                            {
                                                "example_id": "3cd1c08a-de03-48b3-bb5c-50f2a7e441f1",
                                                "sense_id": "8dcf913a-80b0-3f73-b60b-93b3c9c776e7",
                                                "text": "Ces mèches accompagnaient des joues martelées de couleurs violentes qui prouvaient l’habitude de vivre au grand air et peut-être un culte rabelaisien de la dive bouteille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c60bf76-97e4-3b1e-85a5-630a7b75dfe9",
                                        "entry_id": "dfc63e4c-e71a-3961-bce6-8b7be1b3591f",
                                        "glosses": [
                                            "Qui rappelle le genre de François Rabelais (généralement avec connotation de truculence, de libre-pensée, de plaisir et de jouissance)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d75f0338-247a-422a-857a-ffe7b545c037",
                                                "sense_id": "9c60bf76-97e4-3b1e-85a5-630a7b75dfe9",
                                                "text": "Une plaisanterie, une gaieté rabelaisienne."
                                            },
                                            {
                                                "example_id": "f6863f37-25c0-4dec-847d-b1db2e492942",
                                                "sense_id": "9c60bf76-97e4-3b1e-85a5-630a7b75dfe9",
                                                "text": "Deux ou trois portes s’ouvraient sur le palier dont le plafond en plâtre sale était enjolivé d’arabesques obscènes, de tire-bouchons et de mots plus que rabelaisiens tracés par la fumée des chandelles, fresques bien dignes d’une pareille bicoque."
                                            },
                                            {
                                                "example_id": "02b63209-442c-4654-940d-fb5c891d6984",
                                                "sense_id": "9c60bf76-97e4-3b1e-85a5-630a7b75dfe9",
                                                "text": "Rastignac les ramena chez Véry, renvoya sa voiture, et tous trois s’attablèrent en analysant la société présente et riant d’un rire rabelaisien."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rabelaisien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dadb467e-ef84-3d17-8776-cacc4531509c",
                                        "entry_id": "c6f89b78-111d-300f-bd8b-9aa4afb31b5b",
                                        "glosses": [
                                            "Personne rabelaisienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "921c41b5-e0fb-492a-bde7-165af4104be1",
                                                "sense_id": "dadb467e-ef84-3d17-8776-cacc4531509c",
                                                "text": "C’est un rabelaisien."
                                            },
                                            {
                                                "example_id": "313d92fd-c7cf-4898-9525-0931f661792e",
                                                "sense_id": "dadb467e-ef84-3d17-8776-cacc4531509c",
                                                "text": "Il m’a été difficile de me retrouver dans le Sept, souvent décrit comme le rabelaisien, le jouisseur des plaisirs et de la chair."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
