                {
                    "sense_id": "9453d7ac-36ed-39de-b177-5f5698fbad00",
                    "sense_definition": "На следующий день после сегодняшнего.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_rel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он обещал прийти <w>завтра</w> вечером.",
                            "target_lang_translations": {
                                "en": "He promised to come <w>tomorrow</w> evening.",
                                "zh": "他答应<w>明天</w>晚上过来。",
                                "de": "Er hat versprochen, <w>morgen</w> Abend zu kommen.",
                                "nl": "Hij beloofde <w>morgen</w>avond te komen.",
                                "pl": "Obiecał, że przyjdzie <w>jutro</w> wieczorem.",
                                "fr": "Il a promis de venir <w>demain</w> soir.",
                                "it": "Ha promesso di venire <w>domani</w> sera.",
                                "cs": "Sliboval, že přijde <w>zítra</w> večer.",
                                "tr": "<w>Yarın</w> akşam geleceğine söz verdi.",
                                "es": "Él prometió venir <w>mañana</w> por la noche."
                            }
                        },
                        {
                            "text": "Мы обязательно встретимся <w>завтра</w>.",
                            "target_lang_translations": {
                                "en": "We will definitely meet <w>tomorrow</w>.",
                                "zh": "我们<w>明天</w>一定会见面。",
                                "de": "Wir werden uns bestimmt <w>morgen</w> treffen.",
                                "nl": "We zullen elkaar zeker <w>morgen</w> ontmoeten.",
                                "pl": "Na pewno spotkamy się <w>jutro</w>.",
                                "fr": "Nous nous rencontrerons certainement <w>demain</w>.",
                                "it": "Ci incontreremo sicuramente <w>domani</w>.",
                                "cs": "Určitě se <w>zítra</w> setkáme.",
                                "tr": "<w>Yarın</w> mutlaka buluşacağız.",
                                "es": "Definitivamente nos encontraremos <w>mañana</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "вчера"
                    ],
                    "common_phrases": [
                        "до завтра",
                        "завтра утром",
                        "завтра днём",
                        "завтра вечером"
                    ],
                    "target_lang_definitions": {
                        "en": "The day following today.",
                        "zh": "今天之后的第二天。",
                        "de": "Der Tag nach dem heutigen Tag.",
                        "nl": "De dag die volgt op vandaag.",
                        "pl": "Dzień następujący po dniu dzisiejszym.",
                        "fr": "Le jour qui suit immédiatement aujourd'hui.",
                        "it": "Il giorno che segue immediatamente l'oggi.",
                        "cs": "Den následující po dnešku.",
                        "tr": "Bugünden sonra gelen ilk gün.",
                        "es": "El día siguiente al de hoy."
                    },
