                "senses": [
                    {
                        "sense_id": "600b3d8d-4bd3-315a-a891-06be69f0987d",
                        "entry_id": "37adec58-a15a-3ffa-b6f6-428a8b913bdf",
                        "glosses": [
                            "Verb, dessen Flexionsendung im Präsens direkt an die Wortwurzel trat (und nicht an ein Ableitungsmorphem)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b441283-7cd9-4cb7-a1a2-b48f7e6b7509",
                                "sense_id": "600b3d8d-4bd3-315a-a891-06be69f0987d",
                                "text": "„Die Hauptmasse der hier zu behandelnden Verben sind ererbte Wurzelverben, das heißt solche Verben, bei denen im Präsens die Endung unmittelbar an die Wurzel trat.“"
                            },
                            {
                                "example_id": "523cc2ca-360e-4677-a73f-c257e9e0cb40",
                                "sense_id": "600b3d8d-4bd3-315a-a891-06be69f0987d",
                                "text": "„Die Wurzelverben haben eine einsilbige Präsensform und enden in der 1. Singular Präsens Indikativ auf -n.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
