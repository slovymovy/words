    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5f9f3cea-190d-300e-b4dd-66b057244c04",
                "word": "baryon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f3cc61d6-4521-4f7e-83fd-7621e5fb5ad6",
                        "entry_id": "5f9f3cea-190d-300e-b4dd-66b057244c04",
                        "tags": [
                            "plural"
                        ],
                        "form": "baryons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "66261233-7869-30b8-bccc-b743a4ce37b9",
                        "entry_id": "5f9f3cea-190d-300e-b4dd-66b057244c04",
                        "glosses": [
                            "A heavy subatomic particle created by the binding of quarks by gluons; a hadron containing three quarks. Baryons have half-odd integral spin and are thus fermions. This category includes the common proton and neutron of the atomic nucleus."
                        ],
                        "tags": [
                            "particle"
                        ],
                        "examples": [
                            {
                                "example_id": "d54869bc-50f3-478f-815a-47f54edcc5ba",
                                "sense_id": "66261233-7869-30b8-bccc-b743a4ce37b9",
                                "text": "Without prejudging on the actual nature of the relationship between the V₁ and the nucleon it seems practical to have a collective name for these particles and other which possibly may still be discovered and which may also have to be taken along in the conservation principle just mentioned. It is proposed to use the fitting name \"baryon\" for this purpose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94ad8b31-41e5-4ca1-a092-43a2d75ea501",
                        "source_entry_id": "5f9f3cea-190d-300e-b4dd-66b057244c04",
                        "source_sense_id": "66261233-7869-30b8-bccc-b743a4ce37b9",
                        "source_sense_description": "heavy subatomic particle",
                        "target_lang_word": "baryon",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baryon",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0b7f373b-8486-39a3-b698-e7fee51ca758",
                                        "entry_id": "7f7fbec6-38e8-3904-b457-c0a44f27f598",
                                        "glosses": [
                                            "een uit drie quarks bestaand subatomair deeltje"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d7c8f30-53ac-48d8-8972-584cb640b806",
                                                "sense_id": "0b7f373b-8486-39a3-b698-e7fee51ca758",
                                                "text": "Neutronen en protonen zijn baryonen en als alle baryonen zijn ze daarom fermionen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae0162a1-79f2-4678-9ecb-2372b5dc2bbe",
                        "source_entry_id": "5f9f3cea-190d-300e-b4dd-66b057244c04",
                        "source_sense_id": "66261233-7869-30b8-bccc-b743a4ce37b9",
                        "source_sense_description": "heavy subatomic particle",
                        "target_lang_word": "baryon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baryon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06720d8f-a831-3251-8108-6ac1d663abd3",
                                        "entry_id": "2f6c306b-b5d3-3c6e-8848-d3653a2bcb4b",
                                        "glosses": [
                                            "Particule composée de trois quarks."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "799fff0e-c366-4c46-af56-129a20b49c6c",
                                                "sense_id": "06720d8f-a831-3251-8108-6ac1d663abd3",
                                                "text": "Le proton et le neutron sont des baryons."
                                            },
                                            {
                                                "example_id": "6ea41b78-48f0-46ab-a79d-e55e18402a22",
                                                "sense_id": "06720d8f-a831-3251-8108-6ac1d663abd3",
                                                "text": "Supposons que nous étudiions la diffusion d’un méson pseudoscalaire par un baryon."
                                            },
                                            {
                                                "example_id": "83ceea1e-2ca2-44d3-8efb-c07d140e7552",
                                                "sense_id": "06720d8f-a831-3251-8108-6ac1d663abd3",
                                                "text": "Les baryons forment une sous-classe des hadrons. Ce sont des particules massives sensibles à la force nucléaire forte, qui incluent notamment le proton et le neutron."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
