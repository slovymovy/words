                "senses": [
                    {
                        "sense_id": "7f197ec8-d596-3a10-a88f-ec8ef228a1c8",
                        "entry_id": "3be49cea-666d-3935-ab5b-5422d1221d0e",
                        "glosses": [
                            "französischer Astrologe im 16. Jahrhundert, der für seine Wahrsagungen bekannt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5789e6fe-ef8d-4ff8-a648-7d72141ca362",
                                "sense_id": "7f197ec8-d596-3a10-a88f-ec8ef228a1c8",
                                "text": "Er misst den Prophezeiungen des Nostradamus keine Bedeutung zu, da sie sehr vage und allgemein formuliert sind."
                            },
                            {
                                "example_id": "fde50bf9-f09d-4d1e-a720-8c963df6d23a",
                                "sense_id": "7f197ec8-d596-3a10-a88f-ec8ef228a1c8",
                                "text": "Manche Menschen meinen, Nostradamus hätte den Zweiten Weltkrieg oder die COVID-19-Pandemie vorhergesehen."
                            },
                            {
                                "example_id": "92ee8ec3-e3d1-49ff-be4d-83c8defae364",
                                "sense_id": "7f197ec8-d596-3a10-a88f-ec8ef228a1c8",
                                "text": "„Im Mittelalter prophezeite der französische Arzt und Astrologe Nostradamus alle möglichen Katastrophen.“"
                            },
                            {
                                "example_id": "40e98701-8a29-4b4f-9b13-d59826f9d451",
                                "sense_id": "7f197ec8-d596-3a10-a88f-ec8ef228a1c8",
                                "text": "„Kurz vor seinem Geburtstag hat er eine mysteriöse Botschaft mit einer astrologischen Darstellung des Zodiak, also des Sternzeichenkreises, erhalten, in dem eine der düsteren Prophezeiungen des Nostradamus geschrieben steht: ‚Die Kinder werden für die Verbrechen ihrer Eltern bezahlen.‘“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
