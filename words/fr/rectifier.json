    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd76c086-3e77-3e35-a726-b12cc2e52c8d",
                    "sense_definition": "Corriger ou améliorer quelque chose pour le rendre conforme, exact ou convenable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "correction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur a demandé à l'élève de <w>rectifier</w> cette erreur avant de rendre son devoir."
                        },
                        {
                            "text": "Avant de servir le potage, il faut souvent <w>rectifier</w> l'assaisonnement avec du poivre."
                        }
                    ],
                    "synonyms": [
                        "corriger"
                    ],
                    "common_phrases": [
                        "rectifier une erreur",
                        "rectifier le tir"
                    ]
                },
                {
