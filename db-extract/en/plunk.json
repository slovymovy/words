                        "entry_id": "656fc2f0-25f8-3795-a8d1-f46084051bc7",
                        "glosses": [
                            "A brief, dull sound, such as the sound of a string of a stringed instrument being plucked, or the thud of something landing on a surface."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f4a3428-eaa0-4937-9a49-eee43a085d11",
                                "sense_id": "9085b1f9-303a-349a-9606-bb5ea7a840bc",
                                "text": "They listened and could hear the steady plunk, plunk of an axe somewhere far above them."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a28670e-9655-32b9-ba91-375ee7cde0f8",
                        "entry_id": "656fc2f0-25f8-3795-a8d1-f46084051bc7",
                        "glosses": [
                            "A (heavy) blow or hit."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "95a7b2c6-9bbb-352a-a5c1-a673f4f5d986",
                        "entry_id": "656fc2f0-25f8-3795-a8d1-f46084051bc7",
                        "glosses": [
                            "A dollar."
                        ],
                        "tags": [
                            "US",
