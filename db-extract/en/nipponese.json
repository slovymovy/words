                                    {
                                        "sense_id": "53a28a83-ba99-3d56-a76b-7ccbd735c66e",
                                        "entry_id": "6498561a-e4ea-32a7-9316-92f2e2071c32",
                                        "glosses": [
                                            "Relatif au Japon."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76e9d310-34f9-415d-8145-459bcd81d9bf",
                                                "sense_id": "53a28a83-ba99-3d56-a76b-7ccbd735c66e",
                                                "text": "Derrière la politesse des agents nippons qu’il devait voir chaque semaine, et qui lui laissaient comprendre que ses efforts étaient onéreux, Norbert sentait beaucoup de mépris pour celui qu’ils achetaient, et de respect pour Saint-Didier."
                                            },
                                            {
                                                "example_id": "030d4e8c-eea4-41d4-95c5-b228c80c6935",
                                                "sense_id": "53a28a83-ba99-3d56-a76b-7ccbd735c66e",
                                                "text": "En outre, les difficultés de l’économie nipponne dans l’évaluation des effets de la crise ont été prises en compte."
                                            },
                                            {
                                                "example_id": "1f1cfe19-517c-4b47-b1ec-7b90429d8d02",
                                                "sense_id": "53a28a83-ba99-3d56-a76b-7ccbd735c66e",
                                                "text": "La récession a provoqué l’annonce par les grands groupes nippons de réductions spectaculaires de capacités et de résultats nets en forte baisse ou négatifs."
                                            },
                                            {
                                                "example_id": "64317a47-51b8-41a4-a0c3-156f5f75eb55",
                                                "sense_id": "53a28a83-ba99-3d56-a76b-7ccbd735c66e",
                                                "text": "L’opinion apprend avec stupeur que les armées nippones, loin d’avoir été accueillis [sic] en libératrices, se sont attiré la haine inexplicable des Chinois, des Coréens, des Philippins et de la plupart des populations conquises."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
