                    {
                        "translation_id": "bb0e889d-0e05-4100-83b5-c20613f354b6",
                        "source_entry_id": "e18d2ec7-83f2-3499-a48b-0051f224ae8d",
                        "source_sense_id": "8cf7a46f-5385-362c-9d69-8fc24a507362",
                        "target_lang_word": "hubbub",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hubbub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad34e8a1-033f-315a-a19a-14947175d5a8",
                                        "entry_id": "dd471b7d-55c2-33f5-97dd-b06c4b13f414",
                                        "glosses": [
                                            "A confused uproar, commotion, tumult or racket."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "650162da-baf5-4fdf-a247-0c4af748d381",
                                                "sense_id": "ad34e8a1-033f-315a-a19a-14947175d5a8",
                                                "text": "At length a universal hubbub wild\nOf stunning sounds and voices all confused,\nBorne through the hollow dark, assaults his ear\nWith loudest vehemence."
                                            },
                                            {
                                                "example_id": "c9363128-e772-46eb-b658-bdaab2f390ef",
                                                "sense_id": "ad34e8a1-033f-315a-a19a-14947175d5a8",
                                                "text": "What's all the hubbub, bub?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hubbub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bceb748c-d78a-3bf9-bfcd-5721e48c9704",
                                        "entry_id": "d7b39032-77c4-3447-80b3-98e15a050006",
                                        "glosses": [
                                            "To cause a tumult or racket."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaffba99-3c12-4d38-9341-abe638fdad8d",
                                                "sense_id": "bceb748c-d78a-3bf9-bfcd-5721e48c9704",
                                                "text": "It becomes a grotto, hubbubbing with more noise than any class on a school visit could make, the air mobbed by breathless chatter about life and the transfer window."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hubbub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff47de49-71d4-3dca-99ef-48e2529e2071",
                                        "entry_id": "ad73ea11-5db1-331e-9207-19e3dec53e88",
                                        "glosses": [
                                            "Synonym of bowl game (“Native American game of chance”)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "691d21e6-9848-460a-9b7c-2a2730248428",
                        "source_entry_id": "e18d2ec7-83f2-3499-a48b-0051f224ae8d",
                        "source_sense_id": "8cf7a46f-5385-362c-9d69-8fc24a507362",
                        "target_lang_word": "uproar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uproar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d5c685a-2bf1-33ee-bc9d-5a6f6708bcbb",
                                        "entry_id": "ebf32cb4-1abd-3f21-a253-c7bb74a0994c",
                                        "glosses": [
                                            "Tumultuous, noisy excitement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2297cb1a-6084-3eb4-9d79-1e778d5ebcd9",
                                        "entry_id": "ebf32cb4-1abd-3f21-a253-c7bb74a0994c",
                                        "glosses": [
                                            "Loud, confused noise, especially when coming from several sources."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d677ffbd-a280-3210-a5aa-c815cd6047a2",
                                        "entry_id": "ebf32cb4-1abd-3f21-a253-c7bb74a0994c",
                                        "glosses": [
                                            "A loud protest, controversy, or outrage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2986cac-35ad-41f4-9704-6c4ee1663bff",
                                                "sense_id": "d677ffbd-a280-3210-a5aa-c815cd6047a2",
                                                "text": "This highly-aggressive approach had results, but briefly caused a major uproar in parts of the United States, which was mitigated by the Webster–Ashburton Treaty in 1842, which formalised the U.S. Navy's contribution to the antislavery efforts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "uproar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7473b95-cbc8-3cd0-87a8-92cd6e23c67c",
                                        "entry_id": "863b5779-1f87-325a-a180-90e281c37da9",
                                        "glosses": [
                                            "To throw into uproar or confusion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46c6d92b-525b-41e2-8879-959bcc85cf57",
                                                "sense_id": "a7473b95-cbc8-3cd0-87a8-92cd6e23c67c",
                                                "text": "[…] had I power, I should\nPour the sweet milk of concord into hell,\nUproar the universal peace, confound\nAll unity on earth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e21ad669-5b01-3fc5-a92b-f060ef664500",
                                        "entry_id": "863b5779-1f87-325a-a180-90e281c37da9",
                                        "glosses": [
                                            "To make an uproar."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf0b9bfa-fabb-441d-82bf-55ae79f01d5d",
                                                "sense_id": "e21ad669-5b01-3fc5-a92b-f060ef664500",
                                                "text": "[…] through their Tumultuous Uproaring have they caused the peaceable and harmless to suffer […]"
                                            },
                                            {
                                                "example_id": "b92aa29d-11b9-4a25-a0b9-ec1e9af0b468",
                                                "sense_id": "e21ad669-5b01-3fc5-a92b-f060ef664500",
                                                "text": "[…] the landlady entering at this very time with news that his wife had been delivered of a dead child, he yielded to the most furious ebullitions; while, in accordance with him, all howled and shrieked, and bellowed and uproared, with double vigor."
                                            },
                                            {
                                                "example_id": "4ec39246-3b6e-4edd-a485-c17805d590cf",
                                                "sense_id": "e21ad669-5b01-3fc5-a92b-f060ef664500",
                                                "text": "When red-mouth’d cannons to the clouds uproar,\nAnd gasping hosts sleep shrouded in their gore,"
                                            },
                                            {
                                                "example_id": "bf958830-fa46-4dca-a792-bef263864250",
                                                "sense_id": "e21ad669-5b01-3fc5-a92b-f060ef664500",
                                                "text": "Officers, as well as men, now mingle in the uproaring strife, and snatching the weapons of the slain, swell the horrid carnage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
