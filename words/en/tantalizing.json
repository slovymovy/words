{
    "word_family": [
        "tantalize",
        "tantalization",
        "tantalizer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7d7a64e3-23d4-333e-9589-0f40347da5ed",
                    "sense_definition": "Teasing or tempting, especially something that is desirable but remains just out of reach.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tantalizing</w> aroma of fresh bread drifted from the bakery window.",
                            "target_lang_translations": {
                                "zh": "面包店窗户飘出阵阵<w>诱人</w>的面包香气。",
                                "cs": "<w>Lákavá</w> vůně čerstvého chleba se linula z okna pekárny."
                            }
                        },
                        {
                            "text": "She found the <w>tantalizing</w> prospect of a promotion hard to ignore.",
                            "target_lang_translations": {
                                "zh": "她发现升职这一<w>诱人</w>的前景让人难以忽视。",
                                "cs": "Přišlo jí těžké ignorovat <w>lákavou</w> vyhlídku na povýšení."
                            }
                        }
                    ],
                    "synonyms": [
                        "tempting",
                        "enticing",
                        "alluring"
                    ],
                    "common_phrases": [
                        "tantalizing prospect",
                        "tantalizing glimpse",
                        "tantalizing possibility"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容事物诱人但又难以得到，令人心痒。",
                        "cs": "Věc nebo situace, která je lákavá, ale zároveň nedosažitelná, což vyvolává touhu."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "诱人的",
                                "target_lang_sense_clarification": "指事物具有吸引力，让人渴望。"
                            },
                            {
                                "target_lang_word": "撩人的",
                                "target_lang_sense_clarification": "指引起人的欲望或兴趣，带有挑逗意味。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "lákavý",
                                "target_lang_sense_clarification": "něco, co přitahuje pozornost a vyvolává touhu"
                            },
                            {
                                "target_lang_word": "svůdný",
                                "target_lang_sense_clarification": "něco, co silně láká nebo pokouší"
                            },
                            {
                                "target_lang_word": "dráždivý",
                                "target_lang_sense_clarification": "něco, co vyvolává napětí nebo zvědavost"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6b6ca9ee-46ab-3268-b320-22791744771e",
                    "sense_definition": "The act or state of being teased by a temptation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "temptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He endured the <w>tantalizing</w> of the game while waiting for his turn.",
                            "target_lang_translations": {
                                "zh": "等着轮到自己的时候，他一直忍受着这个游戏的<w>诱惑</w>。",
                                "cs": "Během čekání na svůj tah musel snášet <w>pokušení</w> té hry."
                            }
                        },
                        {
                            "text": "The constant <w>tantalizing</w> of the offer made it difficult to stay focused.",
                            "target_lang_translations": {
                                "zh": "这份提议不断的<w>诱惑</w>让他很难集中注意力。",
                                "cs": "Neustálé <w>pokušení</w> té nabídky ztěžovalo soustředění."
                            }
                        }
                    ],
                    "synonyms": [
                        "temptation",
                        "teasing"
                    ],
                    "target_lang_definitions": {
                        "zh": "被诱惑或被戏弄的状态。",
                        "cs": "Stav, kdy je někdo vystaven pokušení nebo provokaci."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "诱惑",
                                "target_lang_sense_clarification": "指被某种事物吸引而产生的心理状态。"
                            },
                            {
                                "target_lang_word": "戏弄",
                                "target_lang_sense_clarification": "指通过展示诱人事物来捉弄他人。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pokušení",
                                "target_lang_sense_clarification": "vnitřní stav vyvolaný lákavou nabídkou"
                            },
                            {
                                "target_lang_word": "provokace",
                                "target_lang_sense_clarification": "jednání, které má za cíl někoho vyvést z míry nebo dráždit"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9551d2d-b470-3ccc-8c8b-8ee7b7e832f9",
                    "sense_definition": "Present participle and gerund of <w>tantalize</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temptation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>tantalizing</w> his brother by holding the toy just out of reach.",
                            "target_lang_translations": {
                                "zh": "他把玩具举得高高的，故意<w>逗引</w>他的弟弟。",
                                "cs": "Bratra <w>dráždil</w> tím, že hračku držel těsně mimo jeho dosah."
                            }
                        },
                        {
                            "text": "The cat spent the afternoon <w>tantalizing</w> the bird through the glass.",
                            "target_lang_translations": {
                                "zh": "那只猫整个下午都在隔着玻璃<w>逗引</w>那只鸟。",
                                "cs": "Kočka strávila odpoledne tím, že přes sklo <w>dráždila</w> ptáka."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "逗引，用诱人的事物让人心痒。",
                        "cs": "Činnost, při které někdo někoho dráždí tím, že mu ukazuje něco lákavého, co mu nechce dát."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "逗引",
                                "target_lang_sense_clarification": "指故意用诱人的东西吸引他人注意。"
                            },
                            {
                                "target_lang_word": "撩拨",
                                "target_lang_sense_clarification": "指挑逗或引起他人的欲望。"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "dráždění",
                                "target_lang_sense_clarification": "úmyslné vyvolávání touhy nebo napětí"
                            },
                            {
                                "target_lang_word": "škádlení",
                                "target_lang_sense_clarification": "hravé nebo zlomyslné dráždění někoho"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}