                ],
                "senses": [
                    {
                        "sense_id": "85e0d5c4-913d-39fd-be84-f6a27b242d6b",
                        "entry_id": "ebfc22c4-2738-35c6-8dde-5c91bf70d04c",
                        "glosses": [
                            "Faire revenir quelqu’un en arrière par rapport à sa conversion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91d2ee9c-9249-46f3-b746-ffbb5158866d",
                                "sense_id": "85e0d5c4-913d-39fd-be84-f6a27b242d6b",
                                "text": "Si tu veux m’en donner la permission, je te promets, tout malade que je suis, de déconvertir madame de Tenarre dans une nuit."
                            },
                            {
                                "example_id": "7ae9ce18-beda-4029-a04d-a477de3a326d",
                                "sense_id": "85e0d5c4-913d-39fd-be84-f6a27b242d6b",
                                "text": "Pour vivre intellectuellement, notre jeunesse académique serait plutôt tentée de se « déconvertir. »"
                            },
                            {
                                "example_id": "47e8c25a-38cd-4f3e-a97b-23a02d12ad62",
                                "sense_id": "85e0d5c4-913d-39fd-be84-f6a27b242d6b",
                                "text": "Déconvertis par leur convertisseur… oui, j’en ai connu plus d’un."
                            },
                            {
                                "example_id": "c83e263f-5641-4514-b09b-ce8e752b55ee",
                                "sense_id": "85e0d5c4-913d-39fd-be84-f6a27b242d6b",
                                "text": "Après la Libération, nombre d’intellectuels ont continué d’être séduits par la force de ce mouvement, tandis que je commençais à me déconvertir…"
                            }
                        ]
                    }
                ],
