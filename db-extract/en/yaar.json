                        ]
                    },
                    {
                        "translation_id": "03e8f488-fd74-49f5-bc78-b61c3b3f8678",
                        "source_entry_id": "1bdbce9f-9dc1-3277-8d33-7e1b34c487e8",
                        "source_sense_id": "c7409f13-4525-3572-a615-9db7d55a76d9",
                        "source_sense_description": "regional (Indien), umgangssprachlich, meist in direkter Anrede: Freund, Kumpel",
                        "target_lang_word": "Kumpel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kumpel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "749bc15e-2140-340d-8257-893dea34cee0",
                                        "entry_id": "af908805-a310-3c2e-a8be-15bc2c1e2c44",
                                        "glosses": [
                                            "Mensch, den man mag, mit dem man einiges (zum Beispiel Interessen oder Meinungen) teilt"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65b96e86-b64e-4620-af94-8f1ac42ea3da",
                                                "sense_id": "749bc15e-2140-340d-8257-893dea34cee0",
                                                "text": "Ich ging mit meinen Kumpels einkaufen."
                                            },
                                            {
                                                "example_id": "43964f15-72a4-408f-964a-3f45a45fd778",
                                                "sense_id": "749bc15e-2140-340d-8257-893dea34cee0",
                                                "text": "„Der Kumpel von damals war längst im Kulturressort der »Yomiuri Shinbun« gelandet, die ihnen früher als das reaktionäre Massenblatt überhaupt und gleichsam als Tor zur Hölle gegolten hatte.“"
                                            },
                                            {
                                                "example_id": "1962ef1e-d4a4-4973-8d2f-4afffe394f54",
                                                "sense_id": "749bc15e-2140-340d-8257-893dea34cee0",
                                                "text": "„Mein Kumpel Ralf drückte mir neulich einen Gutschein für ein Beauty-Center speziell für Männer in die Hand.“"
                                            },
                                            {
                                                "example_id": "88412cb2-9a1a-4074-b025-6c26aa112f62",
                                                "sense_id": "749bc15e-2140-340d-8257-893dea34cee0",
                                                "text": "„Er saß auf dem Rücksitz, weil er noch nicht alt genug war, um selbst zu fahren, sein Kumpel aber schon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aeabe465-5a81-3863-9672-d94ac1166272",
                                        "entry_id": "af908805-a310-3c2e-a8be-15bc2c1e2c44",
                                        "glosses": [
                                            "Bergmann"
                                        ],
                                        "tags": [
                                            "Bergmannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c972602d-1bd9-4949-8d28-6b76a234d10e",
                                                "sense_id": "aeabe465-5a81-3863-9672-d94ac1166272",
                                                "text": "Die Kumpel demonstrierten lange gegen die Schließung der Zeche."
                                            },
                                            {
                                                "example_id": "f0cdde40-0962-4aa9-9862-7dcdb8c2abc3",
                                                "sense_id": "aeabe465-5a81-3863-9672-d94ac1166272",
                                                "text": "„Maschinen gibt es nicht. Schlägel und Eisen, Schaufel und Hacke müssen genügen. Und manchmal, erzählt Kumpel Höllering, sind es „mehr Menschen als Hacken“. Arbeitskleidung und Geleucht fehlen.“"
                                            },
                                            {
                                                "example_id": "e3566319-0ab5-4551-8ca1-d171f2617de4",
                                                "sense_id": "aeabe465-5a81-3863-9672-d94ac1166272",
                                                "text": "„Aus sozialem Engagement wurde Paul Zech nach seinem Studium Kumpel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5ea5e0bd-2960-30f8-bbc0-3370eaed3d5f",
                                        "entry_id": "af908805-a310-3c2e-a8be-15bc2c1e2c44",
                                        "glosses": [
                                            "Arbeitskollege"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6287d191-fb48-495f-b207-b9f56d123023",
                                                "sense_id": "5ea5e0bd-2960-30f8-bbc0-3370eaed3d5f",
                                                "text": "Ich und meine Kumpels gehen öfters nach der Arbeit mal einen trinken."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
