{
    "word_family": [
        "годовой",
        "годичный",
        "годовалый",
        "ежегодно"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "015d26a4-063d-3877-9c01-ef26df443832",
                    "sense_definition": "Единица измерения времени, равная периоду обращения Земли вокруг Солнца, составляющая 365 или 366 дней.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом <w>году</w> мы планируем поехать в отпуск на море.",
                            "target_lang_translations": {
                                "en": "We are planning to go on vacation to the sea this <w>year</w>."
                            }
                        },
                        {
                            "text": "Прошло уже два <w>года</w> с момента нашей последней встречи.",
                            "target_lang_translations": {
                                "en": "It has already been two <w>years</w> since our last meeting."
                            }
                        }
                    ],
                    "common_phrases": [
                        "в этом году",
                        "каждый год"
                    ],
                    "target_lang_definitions": {
                        "en": "A unit of time equal to the period of the Earth's orbit around the Sun, consisting of 365 or 366 days."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "year",
                                "target_lang_sense_clarification": "A period of time corresponding to the Earth's orbit around the Sun."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40802293-3973-3968-be06-c5dce75bd12f",
                    "sense_definition": "Промежуток времени, отсчитываемый от момента рождения человека; возраст.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ребёнку исполнилось пять <w>лет</w> в прошлую субботу.",
                            "target_lang_translations": {
                                "en": "The child turned five <w>years old</w> last Saturday."
                            }
                        },
                        {
                            "text": "Ему сейчас двадцать один <w>год</w>.",
                            "target_lang_translations": {
                                "en": "He is twenty-one <w>years old</w> now."
                            }
                        }
                    ],
                    "synonyms": [
                        "возраст"
                    ],
                    "common_phrases": [
                        "пять лет",
                        "сколько лет"
                    ],
                    "target_lang_definitions": {
                        "en": "The length of time a person has lived; age."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "age",
                                "target_lang_sense_clarification": "The amount of time a being has been alive."
                            },
                            {
                                "target_lang_word": "years old",
                                "target_lang_sense_clarification": "Used to express a person's age."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ba54e8c-3307-3bdd-a807-f20fafd8f3b8",
                    "sense_definition": "Длительный период времени, состоящий из многих лет.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эти <w>годы</w> были самыми счастливыми в моей жизни.",
                            "target_lang_translations": {
                                "en": "These <w>years</w> were the happiest in my life."
                            }
                        },
                        {
                            "text": "За долгие <w>годы</w> работы он стал настоящим профессионалом.",
                            "target_lang_translations": {
                                "en": "Over many <w>years</w> of work, he has become a true professional."
                            }
                        }
                    ],
                    "common_phrases": [
                        "долгие годы",
                        "прошедшие годы"
                    ],
                    "target_lang_definitions": {
                        "en": "A long period of time consisting of many years."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "years",
                                "target_lang_sense_clarification": "A long duration of time."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}