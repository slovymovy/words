                                        "sense_id": "0de24778-edba-37df-bb0e-4aa50478bd11",
                                        "entry_id": "ee8d412e-5b5e-3fd7-8241-f7829f6a3b9a",
                                        "glosses": [
                                            "een vrouw die in horecagelegenheid klanten aan tafel bedient"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87cb8aa5-4ea3-4885-8d87-598bc0aa2bfb",
                                                "sense_id": "0de24778-edba-37df-bb0e-4aa50478bd11",
                                                "text": "Zij had een tijdje een bijbaantje als serveerster in dat restaurant."
                                            },
                                            {
                                                "example_id": "7691d82d-11b2-4669-9062-ae5575a2c0fe",
                                                "sense_id": "0de24778-edba-37df-bb0e-4aa50478bd11",
                                                "text": "'Dertig jaar geleden zat het hier helemaal vol', zegt Claudette Bonin (60), serveerster van het Relais des Routier in Dordives. Nu zijn een paar tafels bezet voor de lunch."
                                            },
                                            {
                                                "example_id": "8e70ef23-d5b5-4c4f-be55-5f5b8d5f56d3",
                                                "sense_id": "0de24778-edba-37df-bb0e-4aa50478bd11",
                                                "text": "Het leek alsof de stevige en weelderige serveerster de vraag had begrepen, want ze sloop op haar tenen rond de tafel en ruimde stilletjes de lege bierglazen af."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
