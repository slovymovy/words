                        ],
                        "examples": [
                            {
                                "example_id": "e586dd59-83d8-417c-b12c-8cac71a014dd",
                                "sense_id": "24922174-9885-3272-834a-da71a1b846ca",
                                "text": "The betting on my dog’s light, which is O. K. by me, since it means a juicy dividend on the few millies I sprinkle on her nose, if ——"
                            },
                            {
                                "example_id": "28eb7529-6552-4efe-b074-93af2ef9ee8e",
                                "sense_id": "24922174-9885-3272-834a-da71a1b846ca",
                                "text": "Sir David Attenborough has broken the record for the fastest time to reach one million followers on Instagram, reaching the milestone in just over four hours, according to the Guinness World Records. ¶ That means the 94-year-old naturalist has surpassed the previous record set by Aniston, who reached the one milly mark in five hours and 16 minutes."
                            }
                        ]
                    }
