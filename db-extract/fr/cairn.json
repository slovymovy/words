                                "target_senses": [
                                    {
                                        "sense_id": "138a8a1b-ec2e-31f2-b415-bf9fc87b79b6",
                                        "entry_id": "32e9733c-f30e-3ade-bcf3-3109dcb7835c",
                                        "glosses": [
                                            "A rounded or conical heap of stones erected by early inhabitants of the British Isles, apparently as a sepulchral monument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97cc19da-e0c0-498f-8fe0-7d79ecbe4bbe",
                                                "sense_id": "138a8a1b-ec2e-31f2-b415-bf9fc87b79b6",
                                                "text": "\"Now here let us place the gray stone of her cairn: / Why speak ye no word!\"—said Glenara the stern."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c7c9210-cfd7-321c-bf26-d18b8e31e49a",
                                        "entry_id": "32e9733c-f30e-3ade-bcf3-3109dcb7835c",
                                        "glosses": [
                                            "A pile of stones heaped up as a landmark, to guide travelers on land or at sea, or to arrest attention, as in surveying, or in leaving traces of an exploring party, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cadd73d-0f51-48dd-b026-9473096365e6",
                                                "sense_id": "8c7c9210-cfd7-321c-bf26-d18b8e31e49a",
                                                "text": "After fifteen minutes of this we were glad to reach a high saddle on which former travellers had piled little cairns of commemoration and thankfulness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c5b55f8-b16a-3867-a78e-03dcb215f38f",
                                        "entry_id": "32e9733c-f30e-3ade-bcf3-3109dcb7835c",
                                        "glosses": [
                                            "A cairn terrier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
