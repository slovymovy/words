                "senses": [
                    {
                        "sense_id": "504fde33-3bf4-34fa-a998-4aaf2d6c9ec9",
                        "entry_id": "4caef1b4-4aa0-3793-a69c-0c4d4fa346f5",
                        "glosses": [
                            "das Einziehen von Luft durch die Nase, wobei eine Droge aufgenommen wird"
                        ],
                        "tags": [
                            "Jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "962aee26-e619-4ca1-9c02-a2a79a95e292",
                                "sense_id": "504fde33-3bf4-34fa-a998-4aaf2d6c9ec9",
                                "text": "„Den Höhepunkt bildet ein Sniff Kokain, den er einer »Poison« betitelten Flasche entnimmt.“"
                            },
                            {
                                "example_id": "94f843bd-d27e-4cd4-8bbc-18e8065ca4b7",
                                "sense_id": "504fde33-3bf4-34fa-a998-4aaf2d6c9ec9",
                                "text": "„Ich leiste mir niemals Depressionen, ich nehme sie einfach nicht zur Kenntnis, bis ich sie an der Länge der Kokslinie abmessen kann, die ich auf den Spiegel gelegt habe, und dann ist es nur noch ein Sniff bis zum Abheben. »Und, welcher Film läuft heute?« fragt Harko, und zündet seinen Stoff an, während ich meine Mega-Line wegziehe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
