                        "examples": [
                            {
                                "example_id": "fd4ff031-1796-4063-b3bd-ea7914ca4031",
                                "sense_id": "bc07eab5-3a15-30ba-88c7-15f5f3823abb",
                                "text": "Mój kolega pracuje na spycharce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67d8ef8d-4076-49f7-935e-5319211e90e9",
                        "source_entry_id": "e48ddc6b-4f90-34be-87cd-16e1bc383f6a",
                        "source_sense_id": "bc07eab5-3a15-30ba-88c7-15f5f3823abb",
                        "target_lang_word": "bulldozer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bulldozer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c755614-ba5f-3866-b6e2-5d8a8065ec6d",
                                        "entry_id": "37c2e640-38b8-3d65-994b-92afa5345c0d",
                                        "glosses": [
                                            "A tractor with caterpillar tracks and an attached blade for pushing earth and building debris for coarse preliminary surface grading, demolishing building structures, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e2c0caf-7295-4d0d-8e57-f1afd776bd66",
                                                "sense_id": "9c755614-ba5f-3866-b6e2-5d8a8065ec6d",
                                                "text": "The bulldozer is a caterpillar tractor on the front of which is mounted a heavy steel blade which can be moved up and down by hydraulic gear. By sheer brute force it can push down trees and hedges, remove obstructions (including light brickwork) and level and consolidate newly-tipped banks."
                                            },
                                            {
                                                "example_id": "8647d150-e52a-4da7-8fa0-9c0eab2db3cd",
                                                "sense_id": "9c755614-ba5f-3866-b6e2-5d8a8065ec6d",
                                                "text": "Typically for the 'get-on-with-it' era, the railway and military worked like demons to restore the vital rail link. The crater was rapidly filled in and the earth tamped solid, the wreckage was removed by breakdown trains, new rails and sleepers were rushed forward by willing hands, and US Army bulldozers piled in. By 2020 on the same day, both tracks were open for traffic again where there had been a gaping pit just hours before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c02020f3-5a20-3dee-9b78-65ac56f41376",
                                        "entry_id": "37c2e640-38b8-3d65-994b-92afa5345c0d",
                                        "glosses": [
                                            "One who bulldozes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "930b74e6-e952-3b16-9a3b-4dbb0a5c4110",
                                        "entry_id": "37c2e640-38b8-3d65-994b-92afa5345c0d",
                                        "glosses": [
                                            "A member of a self-identified group of white US Southerners who colluded to influence outcomes of post-Reconstruction elections by intimidating, coercing and bullying black voters and legislators, including burning down houses and churches, flogging and murdering opponents."
                                        ],
                                        "tags": [
                                            "historical",
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20956675-994e-3a39-9bd7-e2bdad8685de",
                                        "entry_id": "37c2e640-38b8-3d65-994b-92afa5345c0d",
                                        "glosses": [
                                            "A bully; an overbearing individual."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bulldozer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1105fcac-e2a2-33a2-88e2-866efa805a6c",
                                        "entry_id": "8f5ff788-c387-370d-b443-0f0039ef3f63",
                                        "glosses": [
                                            "To bulldoze (demolish with a bulldozer)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37fd8e8b-5856-3537-89f1-5e8a7ca3876b",
                                        "entry_id": "8f5ff788-c387-370d-b443-0f0039ef3f63",
                                        "glosses": [
                                            "To bulldoze (push through forcefully)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "372a289e-3494-4246-93e2-4b384913af4f",
                                                "sense_id": "37fd8e8b-5856-3537-89f1-5e8a7ca3876b",
                                                "text": "They bulldozered through the crowd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9d38db9-9486-4dc7-ba0a-e5cb899b1ac1",
                        "source_entry_id": "e48ddc6b-4f90-34be-87cd-16e1bc383f6a",
                        "source_sense_id": "bc07eab5-3a15-30ba-88c7-15f5f3823abb",
                        "target_lang_word": "buldozer",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "161e584c-1596-4bc1-b09a-96197bb59d39",
                        "source_entry_id": "e48ddc6b-4f90-34be-87cd-16e1bc383f6a",
                        "source_sense_id": "bc07eab5-3a15-30ba-88c7-15f5f3823abb",
                        "target_lang_word": "bulldozer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bulldozer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90711654-0e3f-3ff6-a548-de50768c56ea",
                                        "entry_id": "0d0eefe1-327f-3bd3-9ff7-229866a78149",
                                        "glosses": [
                                            "Tracteur à roues ou à chenilles qui sert à repousser les matériaux excavés."
                                        ],
                                        "tags": [
                                            "Travaux publics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f26e20f6-088b-4591-bb8a-cb11fb5fe682",
                                                "sense_id": "90711654-0e3f-3ff6-a548-de50768c56ea",
                                                "text": "Les bulldozers, leur lame et leur ripper aux grosses dents fichées dans la boue, les draglines au godet béant, le cordon latéral de la terre déplacée par les pelles mécaniques devenaient notre seule guirlande sous le ciel noir éclairé par les phares des camions."
                                            },
                                            {
                                                "example_id": "d8816d3f-4030-4506-a600-8851438e6e60",
                                                "sense_id": "90711654-0e3f-3ff6-a548-de50768c56ea",
                                                "text": "Il était bulliste, conducteur de bulldozer. La puissance de son engin rejaillissait sur lui, il savait dominer les monstres des Blancs."
                                            },
                                            {
                                                "example_id": "cc58a70d-0a27-4195-920a-608c7cdfa8fc",
                                                "sense_id": "90711654-0e3f-3ff6-a548-de50768c56ea",
                                                "text": "Au cœur de ce combat, des hommes, évidemment invisibles. Sans eux, comment le bulldozer, la pelleteuse, la goudronneuse remporteraient cette infernale bataille?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "554288b8-f0bc-3a7f-821f-c68e8167b4b2",
                                        "entry_id": "0d0eefe1-327f-3bd3-9ff7-229866a78149",
                                        "glosses": [
                                            "Personne déterminée, énergique."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f660a82a-a27c-476a-8a2d-fc89bb282d84",
                                                "sense_id": "554288b8-f0bc-3a7f-821f-c68e8167b4b2",
                                                "text": "C'est un vrai bulldozer, ma sœur, quand elle a décidé quelque chose, rien ne l'arrête !"
                                            },
                                            {
                                                "example_id": "0d8df2ab-a7bd-4e1d-952b-72a07ef388b6",
                                                "sense_id": "554288b8-f0bc-3a7f-821f-c68e8167b4b2",
                                                "text": "Il fallait voir Lucile marcher dans la rue, à la fois si énergique et si mal assurée, son corps penché en avant, son sac plaqué contre sa hanche, cette manière de fendre la foule, d’aller droit au but, ses airs de bulldozer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bulldozer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25f9cbec-8b59-38c2-be84-ca4b53118484",
                                        "entry_id": "4ce66153-657b-3c90-bebc-7e73c11e14d2",
                                        "glosses": [
                                            "Passer le bulldozer."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2841d45-217b-4e5a-b34a-711d0affcec5",
                                                "sense_id": "25f9cbec-8b59-38c2-be84-ca4b53118484",
                                                "text": "Et pour être sûr qu'ils ne reviendront pas, on a tout bulldozé ! Les Indiens étaient fort attachés à ces maisons et quand ils en parlent encore aujourd'hui ils ont les larmes aux yeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0d61146-0c1b-3962-982c-6738aab9f37b",
                                        "entry_id": "4ce66153-657b-3c90-bebc-7e73c11e14d2",
                                        "glosses": [
                                            "Détruire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62882947-96fd-4077-b9e1-167220254807",
                                                "sense_id": "a0d61146-0c1b-3962-982c-6738aab9f37b",
                                                "text": "Ce que vous me dites sur la façon dont on a gentiment bulldozé la résolution concernant l'avortement ne me surprend hélas !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "175b1de2-60d4-4320-9a65-2d07705dbaa6",
                        "source_entry_id": "e48ddc6b-4f90-34be-87cd-16e1bc383f6a",
