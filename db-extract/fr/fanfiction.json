                    {
                        "translation_id": "56b4f03f-f1b1-42b2-9dbe-e992f453152a",
                        "source_entry_id": "35f60fea-dc86-325d-a5de-db6fec1ee391",
                        "source_sense_id": "da6230d1-c368-3d48-842e-a5cda145a49d",
                        "target_lang_word": "fanfictie",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fanfictie",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ebcfcb2e-a784-3d19-8482-01fa86a20818",
                                        "entry_id": "a2250656-7251-3ef9-b50b-2d04b964a68b",
                                        "glosses": [
                                            "boeken geschreven door fans over bepaalde bekende personages uit succesvolle boeken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da40ffd7-fdb0-4536-b82c-2c2d7fe679b7",
                                                "sense_id": "ebcfcb2e-a784-3d19-8482-01fa86a20818",
                                                "text": "Er was een tijd dat fans voor die beleving vooral op zichzelf aangewezen waren: Star Wars-adepten die eigen kostuums in elkaar flansten, Star Trek-liefhebbers die hun fanfictie op moeilijk vindbare internetfora publiceerden, ruilhandel van zeldzame superheldenfiguurtjes op nauwelijks bezochte beurzen. Tegenwoordig koesteren de mediabedrijven deze superfans."
                                            },
                                            {
                                                "example_id": "ff444e4b-a95d-465a-91bf-11c6d8a32481",
                                                "sense_id": "ebcfcb2e-a784-3d19-8482-01fa86a20818",
                                                "text": "Amazon wil mensen die fanfictie schrijven een manier geven om daar geld mee te verdienen zonder in slepende juridische conflicten verwikkeld te raken. Het internetbedrijf heeft daartoe Kindle Worlds in het leven geroepen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
