                "senses": [
                    {
                        "sense_id": "3f83ff17-20d8-3711-a465-171bccf8dd30",
                        "entry_id": "d6766ff3-5051-3f6b-b6a5-e9f7ad2d1e37",
                        "glosses": [
                            "Kugeln oder Zäpfchen aus zusammengepresstem Pulver oder Spänen von einigen Millimetern bis einigen Zentimetern Durchmesser/Länge"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "f5352dd5-f366-44c0-91fa-23c30a8a098c",
                                "sense_id": "3f83ff17-20d8-3711-a465-171bccf8dd30",
                                "text": "Viele Zwischen- und Nachprodukte in Mehl- und Schälmühlen werden zu Pellets verpresst."
                            },
                            {
                                "example_id": "b54a4536-5e05-4534-b5e2-c339db32291e",
                                "sense_id": "3f83ff17-20d8-3711-a465-171bccf8dd30",
                                "text": "Wenn die Pellets die Presse verlassen, sind sie weich, feucht und heiß. In diesem Zustand sind sie weder transport- noch lagerfähig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
