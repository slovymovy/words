                        "glosses": [
                            "прост. тяжело или резко опускаться во что либо; вваливаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9131f149-3b55-4b32-a746-774b1c9dd737",
                                "sense_id": "42590d7a-147c-382a-ad92-d55d12b2b446",
                                "text": "Берется спирт и в него вбухивается всякое…"
                            }
                        ]
                    },
                    {
                        "sense_id": "c39f56af-5af1-3a4c-a42d-1cf32b46eeb8",
                        "entry_id": "d2bef328-57cd-3bb8-9dd0-fb7835092ec5",
                        "glosses": [
                            "перен., прост. входить куда-либо с шумом или неожиданно; вваливаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1405e8a1-5cb9-41b5-a9e8-1e960e36fded",
                                "sense_id": "c39f56af-5af1-3a4c-a42d-1cf32b46eeb8",
                                "text": "Вбухиваюсь в автобус — едем."
                            }
                        ]
                    },
                    {
                        "sense_id": "e2637e5e-f0d2-3eef-b05a-5f18b6644e2a",
                        "entry_id": "d2bef328-57cd-3bb8-9dd0-fb7835092ec5",
                        "glosses": [
                            "страд. к вбухивать"
