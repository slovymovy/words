{
    "word_family": [
        "commentary",
        "commentator",
        "commentate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e24caa4-8c6a-39dc-8935-3403848e47f1",
                    "sense_definition": "A spoken or written remark expressing an opinion or reaction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "remark_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have no <w>comment</w> on that.",
                            "target_lang_translations": {
                                "ru": "У меня нет <w>комментариев</w> по этому поводу.",
                                "zh": "关于那件事，我无可<w>评论</w>。"
                            }
                        },
                        {
                            "text": "Please leave a <w>comment</w> below if you enjoyed the video.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, оставьте <w>комментарий</w> ниже, если вам понравилось видео.",
                                "zh": "如果你喜欢这个视频，请在下方留下<w>评论</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "no comment",
                        "make a comment",
                        "leave a comment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высказывание или письменная заметка, выражающая мнение или реакцию.",
                        "zh": "表达意见或反应的口头或书面言论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комментарий",
                                "target_lang_sense_clarification": "мнение или пояснение"
                            },
                            {
                                "target_lang_word": "замечание",
                                "target_lang_sense_clarification": "краткое суждение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "评论",
                                "target_lang_sense_clarification": "表达意见或看法"
                            },
                            {
                                "target_lang_word": "评语",
                                "target_lang_sense_clarification": "书面评价"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "707cb2b7-34a2-31b7-bbe6-b06ddf7e1d11",
                    "sense_definition": "A text note in computer code that is ignored by the program but helps humans understand it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer added a <w>comment</w> to explain the complex function.",
                            "target_lang_translations": {
                                "ru": "Программист добавил <w>комментарий</w>, чтобы объяснить сложную функцию.",
                                "zh": "程序员添加了一条<w>注释</w>来解释这个复杂的功能。"
                            }
                        },
                        {
                            "text": "This <w>comment</w> helps other developers understand the code logic.",
                            "target_lang_translations": {
                                "ru": "Этот <w>комментарий</w> помогает другим разработчикам понять логику кода.",
                                "zh": "这条<w>注释</w>有助于其他开发人员理解代码逻辑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "code comment",
                        "add a comment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Текстовая заметка в компьютерном коде, которая игнорируется программой, но помогает людям понять его.",
                        "zh": "计算机代码中被程序忽略但有助于人类理解的文本注释。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комментарий",
                                "target_lang_sense_clarification": "в программировании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注释",
                                "target_lang_sense_clarification": "编程术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "867cdd27-b0f5-3ae4-b614-e4c7bc934e23",
                    "sense_definition": "The action of expressing an opinion or explanation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "act_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The controversial decision passed without <w>comment</w> from the board.",
                            "target_lang_translations": {
                                "ru": "Спорное решение было принято без <w>комментариев</w> со стороны совета.",
                                "zh": "董事会对于这项有争议的决定没有发表任何<w>评论</w>。"
                            }
                        },
                        {
                            "text": "She listened to the accusations without <w>comment</w>.",
                            "target_lang_translations": {
                                "ru": "Она выслушала обвинения без <w>комментариев</w>.",
                                "zh": "她听着那些指控，没有做出任何<w>回应</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "without comment",
                        "pass without comment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по выражению мнения или объяснения.",
                        "zh": "表达意见或解释的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комментарий",
                                "target_lang_sense_clarification": "обычно во мн. числе"
                            },
                            {
                                "target_lang_word": "разъяснение",
                                "target_lang_sense_clarification": "пояснение ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "评论",
                                "target_lang_sense_clarification": "发表意见的行为"
                            },
                            {
                                "target_lang_word": "说明",
                                "target_lang_sense_clarification": "解释情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d7480d6-ea23-3057-b9c1-8dc4b616c24a",
                    "sense_definition": "The part of a sentence that provides new information regarding the current theme.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linguistics_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this sentence structure, the <w>comment</w> follows the topic.",
                            "target_lang_translations": {
                                "ru": "В этой структуре предложения <w>рема</w> следует за темой.",
                                "zh": "在这种句子结构中，<w>述题</w>位于主题之后。"
                            }
                        },
                        {
                            "text": "The <w>comment</w> provides the new information that the listener needs.",
                            "target_lang_translations": {
                                "ru": "<w>Рема</w> предоставляет новую информацию, необходимую слушателю.",
                                "zh": "<w>述题</w>提供了听者所需要的新信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rheme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть предложения, которая сообщает новую информацию относительно текущей темы.",
                        "zh": "句子中提供关于当前主题的新信息的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рема",
                                "target_lang_sense_clarification": "лингвистический термин"
                            },
                            {
                                "target_lang_word": "комментарий",
                                "target_lang_sense_clarification": "в актуальном членении предложения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "述题",
                                "target_lang_sense_clarification": "语言学中与主题相对的概念"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "435e466e-5aad-3502-a763-76bec96591d6",
                    "sense_definition": "To express an opinion or give a brief explanation about something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "remark_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>commented</w> about your proposal during the meeting.",
                            "target_lang_translations": {
                                "ru": "Он <w>прокомментировал</w> твое предложение во время встречи.",
                                "zh": "他在会议期间对你的提议进行了<w>评论</w>。"
                            }
                        },
                        {
                            "text": "The mayor refused to <w>comment</w> on the recent scandal.",
                            "target_lang_translations": {
                                "ru": "Мэр отказался <w>комментировать</w> недавний скандал.",
                                "zh": "市长拒绝就近期的丑闻<w>发表意见</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "comment on",
                        "comment about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать мнение или давать краткое пояснение по поводу чего-либо.",
                        "zh": "对某事表达意见或给出简短解释。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комментировать",
                                "target_lang_sense_clarification": "давать пояснения"
                            },
                            {
                                "target_lang_word": "высказываться",
                                "target_lang_sense_clarification": "выражать мнение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "评论",
                                "target_lang_sense_clarification": "发表看法"
                            },
                            {
                                "target_lang_word": "发表意见",
                                "target_lang_sense_clarification": "表达观点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3047cef5-3627-33a9-b855-56f1c8dddd8a",
                    "sense_definition": "To add explanatory notes to computer source code.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wish I had <w>commented</w> this complicated algorithm when I wrote it.",
                            "target_lang_translations": {
                                "ru": "Жаль, что я не <w>прокомментировал</w> этот сложный алгоритм, когда писал его.",
                                "zh": "我真希望当初写这个复杂算法时就给它加上<w>注释</w>。"
                            }
                        },
                        {
                            "text": "It is good practice to <w>comment</w> your code for future reference.",
                            "target_lang_translations": {
                                "ru": "Хорошая практика — <w>комментировать</w> свой код для будущего использования.",
                                "zh": "为了方便日后查阅，给代码加上<w>注释</w>是一个好习惯。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять пояснительные заметки к исходному коду программы.",
                        "zh": "在计算机源代码中添加解释性说明。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комментировать",
                                "target_lang_sense_clarification": "код программы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注释",
                                "target_lang_sense_clarification": "给代码添加说明"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}