                    "sense_definition": "Newly made, formed, or evolved; having no precedent.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "adj_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are working hard to understand the behavior of the <w>novel</w> virus.",
                            "target_lang_translations": {
                                "ru": "Ученые усердно работают, чтобы понять поведение <w>нового</w> вируса.",
                                "zh": "科学家们正在努力研究这种<w>新型</w>病毒的行为。"
                            }
                        },
                        {
                            "text": "The company introduced a <w>novel</w> technology that changed the industry.",
                            "target_lang_translations": {
                                "ru": "Компания представила <w>принципиально новую</w> технологию, которая изменила отрасль.",
                                "zh": "该公司推出了一项改变了整个行业的<w>全新</w>技术。"
