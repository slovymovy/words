                            },
                            {
                                "target_lang_word": "одолжила",
                                "target_lang_sense_clarification": "женский род, прошедшее время"
                            },
                            {
                                "target_lang_word": "одолжили",
                                "target_lang_sense_clarification": "множественное число, прошедшее время"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c0e1754-7640-3258-bc97-efc1049f87b7",
                    "sense_definition": "A period of the ecclesiastical year preceding Easter, traditionally involving temporary abstention from certain foods and pleasures.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people choose to give up sweets during <w>Lent</w>.",
                            "target_lang_translations": {
                                "ru": "Многие люди решают отказаться от сладостей во время <w>Великого поста</w>."
                            }
                        },
                        {
                            "text": "The church services are more solemn throughout the season of <w>Lent</w>.",
                            "target_lang_translations": {
                                "ru": "Церковные службы становятся более торжественными в течение всего <w>Великого поста</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Lenten season",
                        "Quadragesima"
                    ],
                    "common_phrases": [
                        "during Lent",
                        "for Lent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период церковного года перед Пасхой, традиционно включающий временный отказ от определенных продуктов и развлечений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Великий пост",
                                "target_lang_sense_clarification": "христианский период покаяния перед Пасхой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85b62cee-a559-373c-a292-b3ef224d1f01",
                    "sense_definition": "The academic term occurring during the spring, often associated with universities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final exams are scheduled for the end of the <w>Lent</w> term.",
                            "target_lang_translations": {
                                "ru": "Выпускные экзамены запланированы на конец <w>весеннего семестра</w>."
                            }
                        },
                        {
                            "text": "Students are very busy with their research projects during the <w>Lent</w> term.",
                            "target_lang_translations": {
                                "ru": "Студенты очень заняты своими исследовательскими проектами в течение <w>весеннего семестра</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Lent term"
                    ],
                    "common_phrases": [
                        "Lent term"
                    ],
                    "target_lang_definitions": {
                        "ru": "Академический семестр, приходящийся на весну, часто связанный с университетами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "весенний семестр",
                                "target_lang_sense_clarification": "академический период в университете"
                            }
                        ]
                    }
                }
            ]
        },
