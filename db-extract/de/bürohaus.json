                                "sense_id": "f929761e-63c6-3beb-b037-810d1ff376a5",
                                "text": "Unsere Firma hat kürzlich im fünften Stock eines Bürohauses neue Räume bezogen."
                            },
                            {
                                "example_id": "6676c345-5372-4819-a918-558515b18d7c",
                                "sense_id": "f929761e-63c6-3beb-b037-810d1ff376a5",
                                "text": "„Mitten in die Stille des gläsernen Bürohauses waren diese Worte geplatzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
