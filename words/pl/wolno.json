                                "zh": "在这个公园里不<w>可以</w>不拴狗绳遛狗。"
                            }
                        },
                        {
                            "text": "Czy <w>wolno</w> mi skorzystać z twojego telefonu?",
                            "target_lang_translations": {
                                "ru": "<w>Можно</w> ли мне воспользоваться твоим телефоном?",
                                "en": "Am I <w>allowed</w> to use your phone?",
                                "nl": "<w>Mag</w> ik je telefoon gebruiken?",
                                "de": "<w>Darf</w> ich dein Telefon benutzen?",
                                "fr": "<w>Puis-je</w> utiliser ton téléphone ?",
                                "it": "<w>Posso</w> usare il tuo telefono?",
                                "cs": "<w>Smím</w> použít tvůj telefon?",
                                "tr": "Telefonunu kullanmama <w>izin var mı</w>?",
                                "es": "¿<w>Puedo</w> usar tu teléfono?",
                                "zh": "<w>可以</w>借用一下你的手机吗？"
                            }
