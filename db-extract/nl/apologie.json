                "senses": [
                    {
                        "sense_id": "7b97377f-7033-3621-bbcd-4120d3ed0719",
                        "entry_id": "2abd05e3-b4b8-313d-93c6-a369dd2618be",
                        "glosses": [
                            "een mondelinge of schriftelijke verdediging van een persoon, zaak of leer tegen onrechtvaardige aanvallen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "67782c35-55e6-364e-a745-db0b8fea92bb",
                        "entry_id": "2abd05e3-b4b8-313d-93c6-a369dd2618be",
                        "glosses": [
                            "het verheerlijken, goedpraten, bagatelliseren of ontkennen van ernstige misdrijven zoals volkerenmoord of terreurdaden"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7cd23276-ca1d-441d-a714-1e3fe4682bcc",
                        "source_entry_id": "2abd05e3-b4b8-313d-93c6-a369dd2618be",
                        "source_sense_id": "7b97377f-7033-3621-bbcd-4120d3ed0719",
                        "source_sense_description": "een mondelinge of schriftelijke verdediging van een persoon, zaak of leer tegen onrechtvaardige aanvallen",
                        "target_lang_word": "Apologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f4aa6ad1-ffff-3e18-9a48-1124e13ac1ec",
                                        "entry_id": "7e6c9314-03a1-32e9-8605-96605d6bf5b1",
                                        "glosses": [
                                            "Verteidigung, Rechtfertigung"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53a4aa2d-958c-45c8-8fb0-92284b4a3cf6",
                                                "sense_id": "f4aa6ad1-ffff-3e18-9a48-1124e13ac1ec",
                                                "text": "„Schriftsteller sind Zusammenhangsuchekünstler, sie betreiben auf 200, 300 Seiten die große, geistreiche Apologie dessen, was nicht (mehr) zu ändern ist.“"
                                            },
                                            {
                                                "example_id": "c972f24d-5836-438b-affa-0a40b288a63a",
                                                "sense_id": "f4aa6ad1-ffff-3e18-9a48-1124e13ac1ec",
                                                "text": "„Aus der Distanz eines halben Jahrhunderts, nach dem Erlebnis des Zweiten Weltkrieges und angesichts der völlig veränderten politischen Verhältnisse in Europa und der Welt erscheint der Augenblick gekommen, zu einer unvoreingenommenen Betrachtung des Kriegsausbruchs von 1914 zu gelangen, gleicherweise frei von Anklage wie von Apologie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a49c626a-2fc7-3d11-9960-b36b8238d766",
                                        "entry_id": "7e6c9314-03a1-32e9-8605-96605d6bf5b1",
                                        "glosses": [
                                            "Rede oder Schrift, in der etwas verteidigt und gerechtfertigt wird"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f845f77c-783e-43f0-8fce-127e37ac8337",
                                                "sense_id": "a49c626a-2fc7-3d11-9960-b36b8238d766",
                                                "text": "„Der vorliegende Text enthält die Verteidigungsrede ( Apologie) des Philosophen Sokrates, der seitens Meletos angeklagt wird in Athen andere Götter einführen zu wollen und durch seine Dialoge die Jugend verderbe.“"
                                            },
                                            {
                                                "example_id": "a52403ac-4fbf-43ed-a6c2-b4e2885a8ad5",
                                                "sense_id": "a49c626a-2fc7-3d11-9960-b36b8238d766",
                                                "text": "„Nihm mirs nicht übel, lieber Blaarer, daß ich deine Apologie wieder ungedruckt zurückgehen lasse.“"
                                            },
                                            {
                                                "example_id": "796aaa01-3ccd-4150-bdda-6e6642f07215",
                                                "sense_id": "a49c626a-2fc7-3d11-9960-b36b8238d766",
                                                "text": "„Der zweite Brief ist ein letzter Appell an die Nachwelt, ein Adieu an seine Landsleute von jenseits des Grabes und eine Apologie an die Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed0bb837-1476-4dfa-b58d-ac64eb0b3628",
                        "source_entry_id": "2abd05e3-b4b8-313d-93c6-a369dd2618be",
                        "source_sense_id": "7b97377f-7033-3621-bbcd-4120d3ed0719",
                        "source_sense_description": "een mondelinge of schriftelijke verdediging van een persoon, zaak of leer tegen onrechtvaardige aanvallen",
                        "target_lang_word": "apology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dff6dfa7-e3a0-330d-bf7d-b4e83f2985e3",
                                        "entry_id": "be433687-9c43-355c-b151-7b00af6673af",
                                        "glosses": [
                                            "An expression of remorse or regret for having said or done something that harmed another: an instance of apologizing (saying that one is sorry)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e440391a-1bb5-4616-8e47-eba142947025",
                                                "sense_id": "dff6dfa7-e3a0-330d-bf7d-b4e83f2985e3",
                                                "text": "What he said really hurt my feelings, but his apology sounded so sincere that I couldn't help but forgive him."
                                            },
                                            {
                                                "example_id": "4893a22b-2bc7-4b7a-a3b9-444e9778351e",
                                                "sense_id": "dff6dfa7-e3a0-330d-bf7d-b4e83f2985e3",
                                                "text": "The CEO made a public apology for the scandal, and promised full cooperation with the authorities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "838813eb-a2fd-3d4a-b162-d4a88c90eb58",
                                        "entry_id": "be433687-9c43-355c-b151-7b00af6673af",
                                        "glosses": [
                                            "A formal justification, defence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fe05163-bf41-4d36-adab-ee22ea223b6e",
                                                "sense_id": "838813eb-a2fd-3d4a-b162-d4a88c90eb58",
                                                "text": "the Apology of Socrates"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "331caa2c-c36a-364b-953f-1193c703dad1",
                                        "entry_id": "be433687-9c43-355c-b151-7b00af6673af",
                                        "glosses": [
                                            "Anything provided as a substitute; a makeshift."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6fb20be-5a51-4e83-91d0-2c57fa904da6",
                                                "sense_id": "331caa2c-c36a-364b-953f-1193c703dad1",
                                                "text": "a poor apology for a hotel room"
                                            },
                                            {
                                                "example_id": "89e11b3a-fa4f-47c9-bc75-3d1184d917fd",
                                                "sense_id": "331caa2c-c36a-364b-953f-1193c703dad1",
                                                "text": "[He] goes to work devising apologies for window curtains."
                                            },
                                            {
                                                "example_id": "3306ef70-97a8-428f-b31e-9e7b5eff570f",
                                                "sense_id": "331caa2c-c36a-364b-953f-1193c703dad1",
                                                "text": "The response to firing is remarkable, and though the 280 lb. pressure seems more in the nature of a reserve for emergencies than a continuous working figure, even with the present-day apology for coal it seldom fell below 250 lb., and could always be brought up to blowing-off point with little difficulty. To this liveliness of steaming the thermic syphons are doubtless the chief contributory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d76677a4-d0ec-4d95-a5f8-06f1a9306bab",
                        "source_entry_id": "2abd05e3-b4b8-313d-93c6-a369dd2618be",
                        "source_sense_id": "7b97377f-7033-3621-bbcd-4120d3ed0719",
                        "source_sense_description": "een mondelinge of schriftelijke verdediging van een persoon, zaak of leer tegen onrechtvaardige aanvallen",
                        "target_lang_word": "apologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c833f8f0-1f6b-3b7a-84fe-fff7a945c069",
                                        "entry_id": "8fb6163f-f561-375a-a1fe-434516423793",
                                        "glosses": [
                                            "Paroles ou écrits destinés à justifier ou à défendre quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852bb901-d0c0-4f9d-a625-90a69ecc4467",
                                                "sense_id": "c833f8f0-1f6b-3b7a-84fe-fff7a945c069",
                                                "text": "Mme Surville n’a laissé sur son frère que quelques pages insignifiantes, une apologie froide, banale, où nous n'avons pas une seule note à prendre, pas un seul document à retenir."
                                            },
                                            {
                                                "example_id": "187747da-2b20-4fb8-b31b-25d6834c9fa4",
                                                "sense_id": "c833f8f0-1f6b-3b7a-84fe-fff7a945c069",
                                                "text": "Quelques jours plus tard, en réponse à une longue apologie du célibat et de la chasteté due à la plume de notre « Sphinx ariégeois » de plus en plus dégoûté de la vie, je répliquais :\n Toute femme est faite pour rivancher comme dit l'argot des barrières, et ensuite pour reproduire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
