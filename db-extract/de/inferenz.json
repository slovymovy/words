                        "glosses": [
                            "aus einem Regelsystem erzeugte Schlussfolgerung; in der Informatik vor allem aus einem formalen System automatisiert erstellte Folgerung"
                        ],
                        "tags": [
                            "Logik"
                        ],
                        "examples": [
