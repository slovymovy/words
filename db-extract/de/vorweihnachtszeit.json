                "senses": [
                    {
                        "sense_id": "208ff59f-da4a-3f6f-83fa-0327f769dbf5",
                        "entry_id": "ece35533-4770-3818-b7f5-5aa3d4170d99",
                        "glosses": [
                            "die Wochen vor Weihnachten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37fdc098-cb27-4f4f-899c-de681c6b954b",
                                "sense_id": "208ff59f-da4a-3f6f-83fa-0327f769dbf5",
                                "text": "Traditionell werden in der Vorweihnachtszeit die Häuser geschmückt."
                            },
                            {
                                "example_id": "1fe1ffb1-2046-429e-98b5-4a2c004fcacf",
                                "sense_id": "208ff59f-da4a-3f6f-83fa-0327f769dbf5",
                                "text": "„Windowshopping, da denkt man an das, was man anschauen, sich aber nicht leisten kann – und an die kommende Shopping-Hauptsaison, die Vorweihnachtszeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf3964d2-4769-433c-ac43-ec95e23fbaac",
                        "source_entry_id": "ece35533-4770-3818-b7f5-5aa3d4170d99",
                        "source_sense_id": "208ff59f-da4a-3f6f-83fa-0327f769dbf5",
                        "source_sense_description": "die Wochen vor Weihnachten",
                        "target_lang_word": "Avent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Avent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30ff490e-98f8-370d-8ea4-be8ed1660dda",
                                        "entry_id": "eb134fc2-eef7-3122-8288-9ef769a3d661",
                                        "glosses": [
                                            "Temps pendant lequel les chrétiens se préparent à célébrer la fête de Noël."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "472cf63b-919f-4929-bc5b-a6147a9291cc",
                                                "sense_id": "30ff490e-98f8-370d-8ea4-be8ed1660dda",
                                                "text": "Nous vîmes bien qu’elle ne pouvait se passer de lui ; elle n’y consentait que durant l’année scolaire qui était pour elle, j’imagine, un Avent liturgique, un temps de préparation à la venue de Simon…"
                                            },
                                            {
                                                "example_id": "a6126c78-79ac-4747-b024-bc1cf67a6056",
                                                "sense_id": "30ff490e-98f8-370d-8ea4-be8ed1660dda",
                                                "text": "Cette psalmodie parvint aux oreilles d’un petit campement de métis convertis, qui abattaient du bois. […] ils sortirent tout joyeux, s’attendant à un second Avent."
                                            },
                                            {
                                                "example_id": "5199aac1-a094-4aed-a6d4-3e1a15ec259f",
                                                "sense_id": "30ff490e-98f8-370d-8ea4-be8ed1660dda",
                                                "text": "La nouvelle « Traduction officielle liturgique » des textes bibliques est disponible depuis le mois de novembre 2013. Mais il a fallu attendre le premier dimanche de l’Avent pour disposer des lectionnaires, c’est-à-dire les livres qui donnent pour chaque dimanche ou pour chaque jour de la semaine, les textes choisis pour la liturgie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
