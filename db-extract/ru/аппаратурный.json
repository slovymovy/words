                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c92e887-82da-46da-9e79-e3e4e7af310f",
                                                "sense_id": "03c8ea5c-0e0d-3612-a2ce-e6fbcc3173ca",
                                                "text": "When the Lit. Mongers deign to notice his work, they dismiss him as a \"cult writer,\" another of their standard ploys. Purdy, not really bitter at the instrumented silence and sneers of the bookchat legions, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceb62fa3-3705-37bc-b71a-b610f2b15ef4",
                                        "entry_id": "9286f1fc-2db8-33b2-a2da-f0d53642f8be",
                                        "glosses": [
                                            "To perform upon an instrument; to prepare for an instrument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57bf9383-ee65-4694-b743-e7e77ace5e72",
                                                "sense_id": "ceb62fa3-3705-37bc-b71a-b610f2b15ef4",
                                                "text": "a sonata instrumented for orchestra"
                                            }
                                        ]
                                    }
                                ]
                            }
