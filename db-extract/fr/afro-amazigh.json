                        "glosses": [
                            "Relatif aux Afro-Amazighs et à leur identité autochtone et africaine."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "112aedcc-7b91-454b-8816-638219f245e1",
                                "sense_id": "fab04d9b-07ff-3cb9-8caf-f35aa97ffdc7",
                                "text": "Il y avait, d'une part, le camp afro-amazigh, dont les membres pensaient que le Maroc jouait pour les Imazighen (peuple amazigh indigène) et les Africains uniquement, et, d'autre part, le camp trans-arabiste, qui pensait que le Maroc représentait l'ensemble du monde arabophone."
                            }
                        ]
                    }
