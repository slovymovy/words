{
    "word_family": [
        "gewicht",
        "wichtig"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87d04b0f-0e21-3098-b2a1-8e654de5f55c",
                    "sense_definition": "een klein of hulpeloos kind, vaak gebruikt als verkleinwoord",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het arme <w>wicht</w> zat helemaal alleen in de kou te huilen op straat.",
                            "target_lang_translations": {
                                "en": "The poor <w>waif</w> was sitting all alone crying in the cold on the street."
                            }
                        },
                        {
                            "text": "De moeder wikkelde haar kleine <w>wicht</w> snel in een warme deken.",
                            "target_lang_translations": {
                                "en": "The mother quickly wrapped her <w>little one</w> in a warm blanket."
                            }
                        }
                    ],
                    "synonyms": [
                        "kind",
                        "koter"
                    ],
                    "common_phrases": [
                        "arm wicht"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Vaak gebruikt met mededogen of tederheid."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a small or helpless child, often used endearingly or with pity"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "waif",
                                "target_lang_sense_clarification": "a homeless, neglected, or abandoned child"
                            },
                            {
                                "target_lang_word": "little one",
                                "target_lang_sense_clarification": "small child, term of affection or pity"
                            },
                            {
                                "target_lang_word": "mite",
                                "target_lang_sense_clarification": "small child or creature, pitiable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "222004b4-a0f4-3aff-b52b-099a6f926fd6",
                    "sense_definition": "een jong meisje of een jonge vrouw",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het noorden van het land noemen ze een jong meisje soms nog een <w>wicht</w>.",
                            "target_lang_translations": {
                                "en": "In the north of the country, they sometimes still call a young girl a <w>lass</w>."
                            }
                        },
                        {
                            "text": "Het vrolijke <w>wicht</w> hielp haar ouders elke ochtend op de boerderij.",
                            "target_lang_translations": {
                                "en": "The cheerful <w>girl</w> helped her parents on the farm every morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "meisje"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Vooral gebruikelijk in noordelijke en oostelijke dialecten."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a young girl or young woman (dialectal/regional)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "girl",
                                "target_lang_sense_clarification": "young female"
                            },
                            {
                                "target_lang_word": "lass",
                                "target_lang_sense_clarification": "girl or young woman, regional/informal"
                            },
                            {
                                "target_lang_word": "wench",
                                "target_lang_sense_clarification": "young woman or country girl, archaic/dialectal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc52c3e0-eea0-38d4-b93d-3f45ffea5b59",
                    "sense_definition": "een domme, vervelende of onnozele vrouw",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een dom <w>wicht</w> is het toch om zulke leugens te verspreiden.",
                            "target_lang_translations": {
                                "en": "What a stupid <w>cow</w> she is to spread such lies."
                            }
                        },
                        {
                            "text": "Hij ergerde zich mateloos aan het arrogante <w>wicht</w> dat voordrong bij de kassa.",
                            "target_lang_translations": {
                                "en": "He was immensely annoyed by the arrogant <w>bitch</w> who jumped the queue at the checkout."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dom wicht"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Pejoratief gebruikt als scheldwoord."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a stupid, annoying, or silly woman or girl; derogatory term"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bitch",
                                "target_lang_sense_clarification": "spiteful, unpleasant, or disliked woman"
                            },
                            {
                                "target_lang_word": "silly cow",
                                "target_lang_sense_clarification": "foolish or irritating woman"
                            },
                            {
                                "target_lang_word": "chit",
                                "target_lang_sense_clarification": "insolent or silly young woman"
                            },
                            {
                                "target_lang_word": "bimbo",
                                "target_lang_sense_clarification": "foolish or vacuous woman"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6749e6ee-1fda-3f5c-9d07-c5a9ed4ab3b2",
                    "sense_definition": "een levend wezen of schepsel",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wezen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude volksverhalen wordt het dier beschreven als een wonderlijk en ongrijpbaar <w>wicht</w>.",
                            "target_lang_translations": {
                                "en": "In ancient folktales, the animal is described as a wondrous and elusive <w>wight</w>."
                            }
                        },
                        {
                            "text": "Elk levend <w>wicht</w> in het bos zocht bescherming tegen de naderende storm.",
                            "target_lang_translations": {
                                "en": "Every living <w>creature</w> in the forest sought shelter from the approaching storm."
                            }
                        }
                    ],
                    "synonyms": [
                        "creatuur",
                        "schepsel",
                        "wezen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Oorspronkelijke betekenis van een levend wezen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a living being or creature (archaic)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wight",
                                "target_lang_sense_clarification": "living being or human creature, archaic"
                            },
                            {
                                "target_lang_word": "creature",
                                "target_lang_sense_clarification": "living being"
                            },
                            {
                                "target_lang_word": "being",
                                "target_lang_sense_clarification": "living entity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e7d97e0-7b2f-3d26-a3da-6166fbdc3113",
                    "sense_definition": "een zwaar voorwerp of meeteenheid; synoniem van <w>gewicht</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gewicht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koopman plaatste een zwaar <w>wicht</w> op de weegschaal om het graan af te meten.",
                            "target_lang_translations": {
                                "en": "The merchant placed a heavy <w>weight</w> on the scale to measure the grain."
                            }
                        },
                        {
                            "text": "Het metalen <w>wicht</w> hield de papieren stevig op het bureau.",
                            "target_lang_translations": {
                                "en": "The metal <w>weight</w> held the papers firmly on the desk."
                            }
                        }
                    ],
                    "synonyms": [
                        "gewicht"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Verouderde vorm voor gewicht."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a heavy object or unit of measurement; weight (obsolete)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "weight",
                                "target_lang_sense_clarification": "heavy object or measurement piece"
                            }
                        ]
                    }
                }
            ]
        }
