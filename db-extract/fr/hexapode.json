                        "sense_id": "1d7ce797-aede-3b9a-a0fd-5589b84e044f",
                        "entry_id": "29b927a7-da45-3c9b-899f-b72dcc051256",
                        "glosses": [
                            "Invertébré du sous-embranchement des hexapodes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "102b3b10-0f8b-4bb3-bdce-ff350a28732e",
                                "sense_id": "1d7ce797-aede-3b9a-a0fd-5589b84e044f",
                                "text": "Un aboiement traversait de temps à autre la nuit, ou le long hurlement monocorde d’un hexapode."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d03cd79-b3d5-4413-b114-54476e44408c",
                        "source_entry_id": "29b927a7-da45-3c9b-899f-b72dcc051256",
                        "source_sense_id": "1d7ce797-aede-3b9a-a0fd-5589b84e044f",
                        "target_lang_word": "hexapod",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hexapod",
