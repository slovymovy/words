                    "sense_definition": "Person im öffentlichen Dienst, die in einem besonderen öffentlich-rechtlichen Dienst- und Treueverhältnis zum Staat steht",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "staatsdienst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als <w>Beamter</w> auf Lebenszeit genießt er bei der Behörde eine hohe Arbeitsplatzsicherheit."
                        },
                        {
                            "text": "Ein <w>Beamter</w> im öffentlichen Dienst übernimmt wichtige Aufgaben für den gesamten Staat."
                        }
                    ],
                    "synonyms": [
                        "Amtsträger",
                        "Staatsbediensteter",
                        "Staatsdiener"
                    ],
                    "antonyms": [
