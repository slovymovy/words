                    },
                    {
                        "form_id": "eca126e8-e635-49b3-8c1c-e36a455c9cba",
                        "entry_id": "7d54fb3d-4a1a-3703-86b0-0025cae4ec8e",
                        "tags": [
                            "feminine"
                        ],
                        "form": "tannante"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8f8d4d1-e994-3493-9068-bfb1ccaf2517",
                        "entry_id": "7d54fb3d-4a1a-3703-86b0-0025cae4ec8e",
                        "glosses": [
                            "Espiègle."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "note": "Se dit généralement d’un enfant, ou d’un adulte qu’on assimile à un enfant",
                        "examples": [
                            {
                                "example_id": "9fb51f59-3659-4bc5-9a53-5d46e620962f",
                                "sense_id": "a8f8d4d1-e994-3493-9068-bfb1ccaf2517",
                                "text": "Avec sa gestuelle expansive, son air coquin et son bagout, on devine qu’il devait être le tannant de la classe quand il était jeune."
                            },
                            {
                                "example_id": "ff15ed7c-73ea-4906-8158-9d917b86b4ff",
                                "sense_id": "a8f8d4d1-e994-3493-9068-bfb1ccaf2517",
                                "text": "Et nous voici ! De retour en confinement, punis comme des petits tannants qui n’ont pas écouté la maîtresse, comme des derniers de classe qui se demandent pourquoi ils sont en retenue."
                            }
                        ]
                    }
                ],
