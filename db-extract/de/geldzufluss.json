                        "tags": [],
                        "examples": [
                            {
                                "example_id": "680bfce7-bda0-4baf-acf4-8d47c6162b33",
                                "sense_id": "4b8c31be-e6b4-3da6-9ad6-5cb2d0e85e76",
                                "text": "„Von den 29 untersuchten mittleren und ganz kleinen Banken konnten 2016 nur 11 Institute überhaupt einen positiven Geldzufluss verzeichnen.“"
                            },
                            {
                                "example_id": "b47e8c78-df9e-4238-b10e-1f386dc5d6d3",
                                "sense_id": "4b8c31be-e6b4-3da6-9ad6-5cb2d0e85e76",
                                "text": "„Bleibt es bei dem unerwarteten Geldzufluss an die Stadt Neuss, muss diese im Folgejahr einen erheblichen Anteil der Mittel insbesondere an den Rhein-Kreis Neuss abführen.“"
                            }
                        ],
