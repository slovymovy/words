                                                "example_id": "537de6d9-fb3e-443c-97ce-37ac66f0161a",
                                                "sense_id": "bc437826-857b-3c1e-88e0-106bcfb59208",
                                                "text": "Andrew Carnegie kam aus Schottland."
                                            },
                                            {
                                                "example_id": "5b7c4f69-7be1-4405-8c78-268eb3ae4798",
                                                "sense_id": "bc437826-857b-3c1e-88e0-106bcfb59208",
                                                "text": "In Schottland ist man stolz auf seine besondere Kultur."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac2a364c-8254-4819-a45f-1341c75f6a58",
                        "source_entry_id": "fa5c8e5c-2dae-3e62-9e37-c27adaa1f0fe",
                        "source_sense_id": "390b704d-136d-30d8-b6a1-26a608694508",
                        "source_sense_description": "Schottland",
                        "target_lang_word": "Écosse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Écosse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0e853b0-d673-39e7-93a1-ebd0159772be",
                                        "entry_id": "0d3498a9-5206-3838-ad8e-459e3bd1e8b9",
                                        "glosses": [
                                            "Pays faisant partie du Royaume-Uni, bordé au nord et à l’ouest par l’océan Atlantique Nord, à l’est par la mer du Nord, au sud-ouest par la mer d’Irlande, et au sud-est par l’Angleterre. Sa capitale est Édimbourg. Son code de subdivision ISO 3166-2 est SCT."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e87b8051-c2fa-41d4-8a5d-ff8908a4ef9a",
                                                "sense_id": "e0e853b0-d673-39e7-93a1-ebd0159772be",
                                                "text": "Notre première escale après charbonnage à Stornoway en Écosse fut donc Sudéroë, l’île la plus au Sud de l’archipel des Féroë […]."
                                            },
                                            {
                                                "example_id": "cc7556eb-9780-4304-9099-608378e29875",
                                                "sense_id": "e0e853b0-d673-39e7-93a1-ebd0159772be",
                                                "text": "Le corbillard transportant la dépouille de la reine Élisabeth II est arrivé, dimanche, au palais d’Holyroodhouse, à Édimbourg (Écosse)."
                                            },
                                            {
                                                "example_id": "4e0c0aa2-7240-4181-b7e5-c58a25331ba1",
                                                "sense_id": "e0e853b0-d673-39e7-93a1-ebd0159772be",
                                                "text": "Entre la petite Écosse, pauvre, calviniste et profrançaise, et la puissante Angleterre, épiscopalienne et traditionnellement hostile à la France, les relations n’ont jamais été de tout repos."
                                            },
                                            {
                                                "example_id": "4f0d79f7-ce0e-44cf-89a1-a3a2edd8652b",
                                                "sense_id": "e0e853b0-d673-39e7-93a1-ebd0159772be",
                                                "text": "Intégrée à la Grande-Bretagne par suite d’un traité d’union arraché par la corruption à l’aristocratie écossaise qui renonça à l’indépendance du royaume en 1707, l’Écosse put conserver sous la souveraineté anglaise son droit propre, ses institutions d’enseignement, son Église établie et obtint le libre-échange et des places garanties au Parlement anglais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a33d24c6-0c49-3b8d-8034-35d790db0e6f",
                                        "entry_id": "0d3498a9-5206-3838-ad8e-459e3bd1e8b9",
                                        "glosses": [
                                            "L’ensemble des habitants de ce pays."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d3afa3d-94a1-45de-811e-f6a0650fc188",
                                                "sense_id": "a33d24c6-0c49-3b8d-8034-35d790db0e6f",
                                                "text": "L’Écosse l’attendait bouche bée. Il arriva à Glasgow vers une heure, et l’on raconte que le travail ne fut pas repris avant deux heures et demie dans les docks et les manufactures de cette ruche industrielle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
