                                        "examples": [
                                            {
                                                "example_id": "85b642ec-2184-422a-a437-22f3a012167c",
                                                "sense_id": "a9c03f10-3d7e-3da3-a1cd-5c3574f41794",
                                                "text": "Но мне больше нравится Шарик в конуре. И как он ни грязен, в copy, — я однако пойду играть с ним."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4273aacc-ac8c-4d1b-b70d-08261c70b5d6",
                        "source_entry_id": "e4c5c46a-2b78-3c02-99d6-5e97e1aa21b4",
                        "source_sense_description": "representative given name for a dog",
                        "target_lang_word": "Бо́бик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Бо́бик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2bd8abcb-0b56-3c95-85af-41ad524f785b",
                                        "entry_id": "3f390bc2-1aea-3fc6-8387-a37ccf43d625",
                                        "glosses": [
                                            "собачья кличка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9813ea9b-8b8a-4db1-a1b5-a39beff445d3",
                                                "sense_id": "2bd8abcb-0b56-3c95-85af-41ad524f785b",
                                                "text": "Около ног его, нервные от орудийного грохота, крутились две собаки: маленький, суетливый, с крючковатым хвостом Бобик — подарок детей — и здоровенный, с огромной мордой сенбернар Банзай, купленный щенком во время войны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24c51918-de14-33a2-9200-9cdece6e3da7",
                                        "entry_id": "3f390bc2-1aea-3fc6-8387-a37ccf43d625",
                                        "glosses": [
                                            "разг. уменьш.-ласк. к Борис"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca28bbae-e4fd-4259-b090-f82ebdc2988b",
                                                "sense_id": "24c51918-de14-33a2-9200-9cdece6e3da7",
                                                "text": "Сегодня мальчишечка проснулся утром и глядит на меня, и вдруг улыбнулся; значит, узнал. «Бобик, говорю, здравствуй! Здравствуй, милый!» А он смеется."
                                            },
                                            {
                                                "example_id": "5fd240f2-627d-4936-9203-f80ad460d39a",
                                                "sense_id": "24c51918-de14-33a2-9200-9cdece6e3da7",
                                                "text": "Мужа она звала Боб, Бобик и Бобочка."
                                            },
                                            {
                                                "example_id": "5f1132ad-2ffa-45ab-a627-d4df92dcef9f",
                                                "sense_id": "24c51918-de14-33a2-9200-9cdece6e3da7",
                                                "text": "Меня высадили у дома, и я немедленно набрала Бориса: — Бобик, привет!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
