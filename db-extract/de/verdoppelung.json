                                                "example_id": "2c0697fb-5a99-4ecf-8901-1a57e4ad4975",
                                                "sense_id": "eb591eea-7c7a-3943-9f4d-89283f9751cd",
                                                "text": "Malheureux et doublement malheureux Idoménée !"
                                            },
                                            {
                                                "example_id": "4b02144d-d566-4a3d-9c2e-5bba768d5963",
                                                "sense_id": "eb591eea-7c7a-3943-9f4d-89283f9751cd",
                                                "text": "Et donner à propos c’est donner doublement."
                                            }
