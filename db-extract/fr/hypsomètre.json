                "senses": [
                    {
                        "sense_id": "405f6ddf-fc04-364f-9192-d3e99bbe4e16",
                        "entry_id": "20f4bd2b-f384-34ed-a7c4-49fcfc4f9d78",
                        "glosses": [
                            "Appareil qui détermine l’altitude d’un lieu d’après la température à laquelle l’eau entre en ébullition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de2e316d-672b-454d-982c-45b407a3aa6a",
                                "sense_id": "405f6ddf-fc04-364f-9192-d3e99bbe4e16",
                                "text": "Pour suppléer au besoin au baromètre, le voyageur peut utilement aussi se munir d’un hypsomètre."
                            },
                            {
                                "example_id": "4f761ed9-ffd6-4683-9cc8-24ea7934de86",
                                "sense_id": "405f6ddf-fc04-364f-9192-d3e99bbe4e16",
                                "text": "Pour les travaux scientifiques nous emportâmes deux chronomètres, un baromètre de Parrot avec du mercure et des tubes de rechange, trois boussoles, six thermomètres centigrades, un hypsomètre et un psychromètre."
                            },
                            {
                                "example_id": "fc35ba67-041b-4697-a8b5-a472fcd8f5f7",
                                "sense_id": "405f6ddf-fc04-364f-9192-d3e99bbe4e16",
                                "text": "L’outillage scientifique de l’expédition consistait dans les accessoires suivants : une boussole Smalchalder, un podomètre, un chronomètre, deux baromètres anéroïdes, des hypsomètres, des thermomètres eau et air, un anémomètre, un marteau et un compas de géologue, une roulette de mesure, un appareil photographique, des cahiers, des crayons et du papier."
                            }
                        ]
                    }
                ],
