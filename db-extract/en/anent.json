    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "41226bb6-05a5-3ba4-9410-25c0a822a2c9",
                "word": "anent",
                "pos": "prep",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d824e81f-b10f-3773-8b19-fd8aacc93a82",
                        "entry_id": "41226bb6-05a5-3ba4-9410-25c0a822a2c9",
                        "glosses": [
                            "Concerning, with regard to, about, in respect to, as to, insofar as, inasmuch as, apropos."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "970d869b-6d94-4f9b-ba8a-70f1eebe143f",
                                "sense_id": "d824e81f-b10f-3773-8b19-fd8aacc93a82",
                                "text": "Mr Bloom and Stephen entered the cabman’s shelter, an unpretentious wooden structure, where, prior to then, he had rarely, if ever, been before; the former having previously whispered to the latter a few hints anent the keeper of it […]"
                            },
                            {
                                "example_id": "204367b5-0cf3-4ba4-aa03-7028efb5dd09",
                                "sense_id": "d824e81f-b10f-3773-8b19-fd8aacc93a82",
                                "text": "1937, L. Ron Hubbard, letter to Russell Hays, quoted in Literary Correspondence: Letters and Journals, p. 101,\nI have just found out something with which to repay that very kind favor of yours anent the \"lift\" angle on stories."
                            },
                            {
                                "example_id": "51e84c5c-c739-4a37-b801-387923681dde",
                                "sense_id": "d824e81f-b10f-3773-8b19-fd8aacc93a82",
                                "text": "The wings of the driver's Marlenesque nose shone, having shed or burned up their ration of powder, and she kept up an elegant monologue anent the local traffic, […]"
                            },
                            {
                                "example_id": "9a125cd8-5cf1-4462-8fa4-b30f8ceee849",
                                "sense_id": "d824e81f-b10f-3773-8b19-fd8aacc93a82",
                                "text": "This question remains a vital consideration anent the debate over the possibility of limiting nuclear war to military objectives, […]"
                            },
                            {
                                "example_id": "7ab36007-ffed-4b3d-8fc5-ce6318640092",
                                "sense_id": "d824e81f-b10f-3773-8b19-fd8aacc93a82",
                                "text": "The invasion of privacy anent banking and financial activities was mainly an outcome of the income tax and the Drug War"
                            }
                        ]
                    },
                    {
                        "sense_id": "3f042134-6576-3b35-a445-2bd1a58c982e",
                        "entry_id": "41226bb6-05a5-3ba4-9410-25c0a822a2c9",
                        "glosses": [
                            "In the opinion or judgment of."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "ece83be3-1e44-3882-bfb6-98dffa82fc4e",
                        "entry_id": "41226bb6-05a5-3ba4-9410-25c0a822a2c9",
                        "glosses": [
                            "Against, in front of, fronting; before; opposite; over against, on the other side."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "cf4ded27-cf86-42b9-a708-cff689226a1c",
                                "sense_id": "ece83be3-1e44-3882-bfb6-98dffa82fc4e",
                                "text": "[…] if Painter did ever abide in the old bark mill said to be anent his brother's freehold."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba7e3e53-30fc-3d68-97a2-0bf008aed928",
                        "entry_id": "41226bb6-05a5-3ba4-9410-25c0a822a2c9",
                        "glosses": [
                            "In a line with; side by side with; on a level with."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c4cfafcf-9cc7-4442-866c-1031c5ec8af5",
                                "sense_id": "ba7e3e53-30fc-3d68-97a2-0bf008aed928",
                                "text": "ANENT, opposite. Usually \"ovver-anent.\""
                            }
                        ]
                    }
