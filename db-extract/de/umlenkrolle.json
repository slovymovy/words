                "senses": [
                    {
                        "sense_id": "47c549c3-3310-3e0d-b766-42b458e82d74",
                        "entry_id": "c5c35658-5199-31f9-879c-a8f7b49b3704",
                        "glosses": [
                            "Rolle, mit der die Richtung der Kraft verändert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2adc8f18-763e-4398-afc8-5526ba0d695b",
                                "sense_id": "47c549c3-3310-3e0d-b766-42b458e82d74",
                                "text": "„Angeblich bestimmte James Watt die Leistung eines Pferdes in einem Kohlebergwerk, wo die Tiere in einem fort über eine Umlenkrolle Kohle aus der Tiefe an die Oberfläche zogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "154f53d0-ad9b-4c0c-8c7a-782e99fd6297",
                        "source_entry_id": "c5c35658-5199-31f9-879c-a8f7b49b3704",
                        "source_sense_id": "47c549c3-3310-3e0d-b766-42b458e82d74",
                        "source_sense_description": "Rolle, mit der die Richtung der Kraft verändert wird",
                        "target_lang_word": "pulley",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pulley",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d262eff6-36a5-3698-84b3-f13977a80163",
                                        "entry_id": "b496505c-2851-3e39-a892-80a8362a06e1",
                                        "glosses": [
                                            "One of the simple machines; a sheave, a wheel with a grooved rim, in which a pulled rope or chain lifts an object (more useful when two or more pulleys are used together, as in a block and tackle arrangement, such that a small force moving through a greater distance can exert a larger force through a smaller distance)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bd9f6b1-6bc6-4025-a3aa-53b33935fb1f",
                                                "sense_id": "d262eff6-36a5-3698-84b3-f13977a80163",
                                                "text": "These pulleys […] placed collaterally."
                                            },
                                            {
                                                "example_id": "f195e091-14ac-40f0-96d7-03d6851f169d",
                                                "sense_id": "d262eff6-36a5-3698-84b3-f13977a80163",
                                                "text": "Nine hundred of the ſtrongeſt Men were employed to draw up theſe Cords by many Pulleys faſtned on the Poles, and thus, in leſs than three Hours, I was raiſed and flung into the Engine, and there tyed faſt."
                                            },
                                            {
                                                "example_id": "b999a649-339f-44a4-b6ec-f335a35c1216",
                                                "sense_id": "d262eff6-36a5-3698-84b3-f13977a80163",
                                                "text": "The steel haulage ropes have a breaking strain of 50 tons, and another pair passing around a pulley at the bottom connect the lower ends of the cars and act as tail or balance ropes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91de4099-2905-36ba-86cb-cdfcf08372cc",
                                        "entry_id": "b496505c-2851-3e39-a892-80a8362a06e1",
                                        "glosses": [
                                            "Annular ligament of the finger."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pulley",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c28d0b1-f470-3b3b-92da-d7234ce28eba",
                                        "entry_id": "ad05e8e2-a94e-355b-b757-ecbcb0d3ec96",
                                        "glosses": [
                                            "To raise or lift by means of a pulley."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1524b955-dd49-4faa-b245-1892f769f184",
                                                "sense_id": "9c28d0b1-f470-3b3b-92da-d7234ce28eba",
                                                "text": "[a mine]is digg'd out with ease, being soft, and is between a white Clay and Chalk at first; but being pulley'd up with the open Air, it receives a crusty kind of hardness"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "884c67b3-47b8-4c28-a64f-1a1358500125",
                        "source_entry_id": "c5c35658-5199-31f9-879c-a8f7b49b3704",
                        "source_sense_id": "47c549c3-3310-3e0d-b766-42b458e82d74",
                        "source_sense_description": "Rolle, mit der die Richtung der Kraft verändert wird",
                        "target_lang_word": "poulie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poulie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2694be7f-9672-3183-a018-3dfc80f24b49",
                                        "entry_id": "56510697-f2ae-37d0-8a06-ff70fc59f2dc",
                                        "glosses": [
                                            "Accessoire formé d’une roue avec ou sans gorge, crantée ou non, rainurée ou non,tournant sur un axe et permettant sur sa jante le déplacement ou le renvoi d'une corde, d'un câble, d'une chaîne ou d'une courroie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9ed5f5-6ae9-4a2c-80a1-317c679435d5",
                                                "sense_id": "2694be7f-9672-3183-a018-3dfc80f24b49",
                                                "text": "De l’autre côté, au contraire, chaque matin, on entendait grincer la poulie ; c’était Silvère qui tirait pour tante Dide l’eau nécessaire au ménage.\nUn jour, la poulie se fendit. Le jeune charron tailla lui-même une belle et forte poulie de chêne qu’il posa le soir, après sa journée."
                                            },
                                            {
                                                "example_id": "ad5840b8-3b92-4278-b0d5-e0dff868d582",
                                                "sense_id": "2694be7f-9672-3183-a018-3dfc80f24b49",
                                                "text": "Les alimentaires et les scrolls de sortie, au départ du chariot, sont embrayés et la courroie est sur la poulie de petite torsion."
                                            },
                                            {
                                                "example_id": "aebd79fd-a8a2-4bfd-a681-7c2d9d6b962a",
                                                "sense_id": "2694be7f-9672-3183-a018-3dfc80f24b49",
                                                "text": "Les courroies ont l’avantage de glisser sur la poulie lorsque l’action de l’outil devient accidentellement trop forte : ce glissement fait éviter la rupture de l’outil ou des appareils de tour."
                                            },
                                            {
                                                "example_id": "4a292614-912e-44e3-b228-160e51dea211",
                                                "sense_id": "2694be7f-9672-3183-a018-3dfc80f24b49",
                                                "text": "Le volant balourdé est commandé par une courroie actionnée elle-même par une poulie motrice."
                                            }
                                        ]
                                    }
                                ]
                            },
