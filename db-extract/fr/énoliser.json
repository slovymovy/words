                "senses": [
                    {
                        "sense_id": "791a6da2-f546-312b-94b8-db1b77340892",
                        "entry_id": "0cb61db5-efec-3fe1-a050-7403c9890cae",
                        "glosses": [
                            "Transformer en énol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edfa6c74-8ddd-457d-8814-253bd658b6b1",
                                "sense_id": "791a6da2-f546-312b-94b8-db1b77340892",
                                "text": "Cette réaction semble générale et on a réussi à énoliser tous les aldéhydes qu’ils appartiennent au groupe R — CH2 — CHO (aldéhyde phénylacétique par exemple) ou au groupe R — CH(R’) — CHO comme le méthylnonylacétaldéhyde, à condition d’employer l’acétate de potassium qui est bien plus actif que l’acétate de sodium."
                            },
                            {
                                "example_id": "56e82461-accd-4d1b-ba2e-b5793ce34108",
                                "sense_id": "791a6da2-f546-312b-94b8-db1b77340892",
                                "text": "Le même résultat, que l’aldéhyde acétique peut s’énoliser, lut également obtenu en employant une autre base."
                            }
                        ]
                    }
                ],
