                },
                {
                    "sense_id": "7bf87d7e-797f-3d43-99f8-efa4b56405f6",
                    "sense_definition": "Gesamtheit der äußeren Rahmenbedingungen sowie der gesellschaftlichen oder wirtschaftlichen Verhältnisse",
