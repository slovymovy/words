                        ],
                        "examples": [
                            {
                                "example_id": "fbebea1c-6d33-48da-b6dc-a691d802a18d",
                                "sense_id": "423068fa-a4ea-3351-ae73-f29396439517",
                                "text": "не ве́рится",
                                "translation": "it is not to be believed",
                                "english": "it is not to be believed"
                            }
                        ]
                    },
                    {
                        "sense_id": "39a888ab-71bf-3777-9fef-0a3b82cd018e",
                        "entry_id": "01357d00-5e73-3f5d-9cf2-fe74f1fda173",
                        "glosses": [
                            "to believe"
                        ],
                        "tags": [
                            "imperfective",
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "bce058c3-e5b1-45d8-ae7b-e460e066539f",
                                "sense_id": "39a888ab-71bf-3777-9fef-0a3b82cd018e",
                                "text": "мне не ве́рится",
                                "translation": "I do not believe",
                                "english": "I do not believe"
                            },
                            {
                                "example_id": "741b468e-ac63-454a-a379-1e9673416e2d",
                                "sense_id": "39a888ab-71bf-3777-9fef-0a3b82cd018e",
                                "text": "Каждому, каждому в лучшее верится...\nКатится, катится голубой вагон.",
                                "translation": "Everyone, everyone believes in the better [yet to come]...\n[As] the blue railcar rolls on, rolls on.",
                                "english": "Everyone, everyone believes in the better [yet to come]...\n[As] the blue railcar rolls on, rolls on."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a6a7f67-167f-37bb-a7fc-c39840dd190e",
                        "entry_id": "01357d00-5e73-3f5d-9cf2-fe74f1fda173",
