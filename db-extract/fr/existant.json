                    {
                        "translation_id": "0669ca98-8cac-49df-9451-f287dcbc0a21",
                        "source_entry_id": "9893ea60-0fd3-3c93-afcc-1b166369cf61",
                        "source_sense_id": "7884fa9d-de70-3ac8-9093-65da0113bc80",
                        "target_lang_word": "extant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12a9c1c1-acce-3415-834a-116039b65f0b",
                                        "entry_id": "7309ccb3-1bb7-3ec8-a6bc-bf2f22258543",
                                        "glosses": [
                                            "Still in existence; not having disappeared."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d496b7ff-ea4c-4ca8-9909-5ca66de169c4",
                                                "sense_id": "12a9c1c1-acce-3415-834a-116039b65f0b",
                                                "text": "extant manuscripts of the Old Testament"
                                            },
                                            {
                                                "example_id": "8968ce3d-bcaf-40d6-b773-6b1da722f135",
                                                "sense_id": "12a9c1c1-acce-3415-834a-116039b65f0b",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "f0898fa8-d2c9-4f6d-97ba-9920af823716",
                                                "sense_id": "12a9c1c1-acce-3415-834a-116039b65f0b",
                                                "text": "This English Nation, will it get to know the meaning of its strange new Today? Is there sense enough extant, discoverable anywhere or anyhow, in our united twenty-seven million heads to discern the same; valour enough in our twenty-seven million hearts to dare and do the bidding thereof?"
                                            },
                                            {
                                                "example_id": "2fea0678-7875-4837-89dd-dbc8bb7aac22",
                                                "sense_id": "12a9c1c1-acce-3415-834a-116039b65f0b",
                                                "text": "There are many narrow-gauge systems still extant."
                                            },
                                            {
                                                "example_id": "44307e40-b183-432d-93ef-0c9e44fcfd29",
                                                "sense_id": "12a9c1c1-acce-3415-834a-116039b65f0b",
                                                "text": "Demetreius of Phalerum, a peripatetic philosopher of the fourth century B.C., wrote an amatory treatise entitled Eroticus - no longer, however, extant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4045f980-5ff8-38b3-bde4-dd5065907d43",
                                        "entry_id": "7309ccb3-1bb7-3ec8-a6bc-bf2f22258543",
                                        "glosses": [
                                            "Still alive; not extinct."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e572df9c-b5fa-4048-8e11-05c4cb20cc17",
                                                "sense_id": "4045f980-5ff8-38b3-bde4-dd5065907d43",
                                                "text": "extant birds"
                                            },
                                            {
                                                "example_id": "31500ccb-67bc-422e-9bca-c2a9596e548e",
                                                "sense_id": "4045f980-5ff8-38b3-bde4-dd5065907d43",
                                                "text": "I reckon that this one Duke of Weimar did more for the Culture of his Nation than all the English Dukes and Duces now extant, or that were extant since Henry the Eighth gave them the Church Lands to eat, have done for theirs![…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faadd460-e7df-3afa-afde-582f23bcc8f6",
                                        "entry_id": "7309ccb3-1bb7-3ec8-a6bc-bf2f22258543",
                                        "glosses": [
                                            "Standing out, or above the rest."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea6012df-34bf-417c-9463-a4e3c529d161",
                                                "sense_id": "faadd460-e7df-3afa-afde-582f23bcc8f6",
                                                "text": "[W]hereas in ſmall fragments or plates, the Ice, though it ſink not to the bottom of the water, will oftentimes ſink so low in it, as ſcarce to leave any part evidently extant above the ſurface of the water, in vaſt quantities of Ice, that extancy is ſometimes ſo conſpicuous, that Navigators in their Voyages to Iſland, Greenland, and other frozen Regions, complain of meeting with lumps, or rather floating rocks of Ice, as high as their main Maſts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
