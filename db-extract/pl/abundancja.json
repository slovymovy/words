                    {
                        "sense_id": "a549c1da-b38a-398f-99d8-59fd215cb408",
                        "entry_id": "2bcc2da8-b3ae-3789-a7a9-bbf01e1b185c",
                        "glosses": [
                            "Überfluss, Fülle"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73ff89c1-4360-4a91-928d-fe2c8e71abd4",
                        "source_entry_id": "2bcc2da8-b3ae-3789-a7a9-bbf01e1b185c",
                        "source_sense_id": "a549c1da-b38a-398f-99d8-59fd215cb408",
                        "source_sense_description": "veraltet: Überfluss, Fülle",
                        "target_lang_word": "Überfluss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Überfluss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                        "entry_id": "20878805-7ce1-3074-aca2-c47277cfa84a",
                                        "glosses": [
                                            "eine über den Bedarf vorhandene Menge an etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df166c37-ddca-4ef6-a704-f87c3cadb6d8",
                                                "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                                "text": "Denn hier findet sich der ganze Wahnsinn einer Industriegesellschaft wieder, die glaubt, fossile Energie im Überfluss zu haben."
                                            },
                                            {
                                                "example_id": "dded9fc2-39ea-4bc2-bd2b-b03aa81d904a",
                                                "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                                "text": "„Sonnenenergie ist mit dem Faktor 10.000 im Überfluss vorhanden“, so Hubert Fechner, Geschäftsfeldleiter für Erneuerbare Energietechnologien bei Arsenal Research."
                                            },
                                            {
                                                "example_id": "a94f12c7-d38e-419d-8aae-2067950b546c",
                                                "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                                "text": "Telekom-Guru George Gilder geht trotzdem davon aus, dass es Bandbreite auf Dauer im Überfluss gibt."
                                            },
                                            {
                                                "example_id": "2d11cd30-9e35-4dec-8076-d21e238b9a27",
                                                "sense_id": "11612c94-e356-3101-9a84-5b809b714661",
                                                "text": "„Auch Diogenes wurde von Seneca als weiser Mann bezeichnet, weil er dem Überfluss entsagte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4f852dea-4157-31f7-a783-458f793b2204",
                                        "entry_id": "20878805-7ce1-3074-aca2-c47277cfa84a",
                                        "glosses": [
                                            "eine Lebenslage, die mehr als das zum Leben Notwendige bietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef74b8d4-2d73-4b41-927a-30475726d9ac",
                                                "sense_id": "4f852dea-4157-31f7-a783-458f793b2204",
                                                "text": "\"Was krank macht, ist gut; was aus der Fülle, aus dem Überfluss, aus der Macht kommt, ist böse\" so empfindet der Gläubige."
                                            },
                                            {
                                                "example_id": "1b614335-8d16-4bd6-9ccc-02805a2311a8",
                                                "sense_id": "4f852dea-4157-31f7-a783-458f793b2204",
                                                "text": "Dem zufälligen Mangel in einer einzelnen Provinz wurde sofort durch den Überfluss ihrer begünstigteren Nachbarn abgeholfen."
                                            },
                                            {
                                                "example_id": "fb6912b6-8bf0-474e-a5e9-c5bdc8978c85",
                                                "sense_id": "4f852dea-4157-31f7-a783-458f793b2204",
                                                "text": "Ein Mann aber trat aus der Menge heraus und sprach voll Bitterkeit und sagte: \"Herr weißt du nicht, dass das Leben der Armen aus dem Überfluss des Reichen strömt? …\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "beaca296-8b42-44ca-a42b-d8485f8ea141",
                        "source_entry_id": "2bcc2da8-b3ae-3789-a7a9-bbf01e1b185c",
                        "source_sense_id": "a549c1da-b38a-398f-99d8-59fd215cb408",
                        "source_sense_description": "veraltet: Überfluss, Fülle",
                        "target_lang_word": "Fülle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fülle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3a15d72-8e6f-385f-85b7-eb8df4a923d1",
                                        "entry_id": "ad5a5f90-057f-3acc-883f-0bc83ee4038f",
                                        "glosses": [
                                            "große Menge"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1832d4ec-535b-4b94-b0d0-ff252039256f",
                                                "sense_id": "d3a15d72-8e6f-385f-85b7-eb8df4a923d1",
                                                "text": "Die Polizei erhielt eine Fülle an Hinweisen."
                                            },
                                            {
                                                "example_id": "8ce8901a-c085-4635-ba83-7a7708f586f9",
                                                "sense_id": "d3a15d72-8e6f-385f-85b7-eb8df4a923d1",
                                                "text": "„Zudem gibt es eine Fülle von ethnischen Minderheiten, die nur lokal verbreitet sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7b86833-c9ab-3786-ad54-bc5447ca1af1",
                                        "entry_id": "ad5a5f90-057f-3acc-883f-0bc83ee4038f",
                                        "glosses": [
                                            "Überfluss, das reichliche Vorhandensein von etwas"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfb63f43-b359-42a0-a221-b9f5574d231d",
                                                "sense_id": "f7b86833-c9ab-3786-ad54-bc5447ca1af1",
                                                "text": "Nahezu jede Bank bietet mittlerweile Tagesgeldkonten an. Um sich in dieser Fülle zurechtzufinden, ist es allemal ratsam, das bevorzugte Tagesgeldkonto im Zinsvergleich zu betrachten."
                                            },
                                            {
                                                "example_id": "be9ce213-171e-4ef1-a120-f5989258e29f",
                                                "sense_id": "f7b86833-c9ab-3786-ad54-bc5447ca1af1",
                                                "text": "„Frei und ungebunden steht er der Fülle des Lebens gegenüber und hat doch keine Ahnung, wo er ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b530c51f-84b4-3479-ba00-236b7c2fac59",
                                        "entry_id": "ad5a5f90-057f-3acc-883f-0bc83ee4038f",
                                        "glosses": [
                                            "das Dicksein, das Beleibtsein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "77baf33d-aebd-3d57-83f5-446ada39d030",
                                        "entry_id": "ad5a5f90-057f-3acc-883f-0bc83ee4038f",
                                        "glosses": [
                                            "Masse zum Füllen von Lebensmitteln (einer Gans oder Ähnlichem)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a79684c-ba12-4cb8-979f-0f8b3de7a1d5",
                                                "sense_id": "77baf33d-aebd-3d57-83f5-446ada39d030",
                                                "text": "„[Die] Gans tra[n]chieren, mit der in Scheiben geschnittenen Fülle, und dem Saftrel servieren.“"
                                            },
                                            {
                                                "example_id": "b8904eed-858e-4c99-9f07-8698c1d9fefd",
                                                "sense_id": "77baf33d-aebd-3d57-83f5-446ada39d030",
                                                "text": "„Aus dem aufgefangenen Blut wurde die Fülle für Blutwürste zubereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
