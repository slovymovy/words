                "senses": [
                    {
                        "sense_id": "33b36572-cf81-3608-84d2-29d7f12eb1dc",
                        "entry_id": "292663ef-9f95-313e-8fac-909a9e9fc9f5",
                        "glosses": [
                            "evolutionäre Strategie einer Tierart, ihr Aussehen einer zweiten Tierart anzupassen, so dass sie von dritten Arten nicht erkannt oder gemieden wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "434aca73-9b13-40ed-b0e1-a7f3e1529dce",
                                "sense_id": "33b36572-cf81-3608-84d2-29d7f12eb1dc",
                                "text": "Schwebfliegen ahmen mit ihrer Färbung Wespen nach, um nicht gefressen zu werden. Diese Strategie nennt man Mimikry."
                            },
                            {
                                "example_id": "fd10cb46-e232-46d0-bb42-c7d486c44cd3",
                                "sense_id": "33b36572-cf81-3608-84d2-29d7f12eb1dc",
                                "text": "Um zu Überleben setzt die Dreiecksnatter auf Mimikry."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "85665749-4482-333f-8d4b-f16e3d13638b",
                        "entry_id": "292663ef-9f95-313e-8fac-909a9e9fc9f5",
                        "glosses": [
                            "im übertragenen Wortsinn gleichbedeutend mit einer Anpassung zum eigenen Schutz oder zur Täuschung anderer"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "a9b584ee-b4b7-4376-a18d-7930588dc506",
                                "sense_id": "85665749-4482-333f-8d4b-f16e3d13638b",
                                "text": "Um den Anschein zu wahren, setzen viele leitende Angestellte mit Burnout-Syndrom die Mimikry der Geschäftskleidung ein."
                            },
                            {
                                "example_id": "5f58953a-5b1f-4f93-8045-a9677dea3e19",
                                "sense_id": "85665749-4482-333f-8d4b-f16e3d13638b",
                                "text": "„Was nach außen physisch als Gleichgültigkeit und psychisch als Phlegma in Erscheinung tritt, ist nichts anderes als eine Mimikry des Gehirns.“"
                            },
                            {
                                "example_id": "a1c73ef1-17d2-4381-ab10-b9652c2b22aa",
                                "sense_id": "85665749-4482-333f-8d4b-f16e3d13638b",
                                "text": "„Meine Mimikry hat sich verschlissen, ohne daß ich das richtig gemerkt hätte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "751fbd86-df85-3461-9150-2e7adfa12fb5",
                        "entry_id": "292663ef-9f95-313e-8fac-909a9e9fc9f5",
                        "glosses": [
                            "das Phänomen, dass Menschen andere Menschen unbewusst und automatisch nachahmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b45328f-881f-41f0-ba00-64fd55ac3290",
                                "sense_id": "751fbd86-df85-3461-9150-2e7adfa12fb5",
                                "text": "„Er ging von einer Mimikry zur anderen über: Für den aufgeblasenen Polizisten füllte er die Lungen mit Luft, für die Frau, die vor ihnen herging, wiegte er die Hüften im Tango.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10f3fe23-3915-412f-9d7d-f1889ea48073",
                        "source_entry_id": "292663ef-9f95-313e-8fac-909a9e9fc9f5",
                        "source_sense_id": "33b36572-cf81-3608-84d2-29d7f12eb1dc",
                        "target_lang_word": "mimicry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mimicry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33386152-654d-3024-87af-40662c75dee0",
                                        "entry_id": "bd95a54e-0cab-3a14-83b1-7710239c3674",
                                        "glosses": [
                                            "An act or ability to simulate or effect the appearance, characteristics, or behavior of someone or something else."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1703101-acba-4f29-b8ff-24c6726310d1",
                                                "sense_id": "33386152-654d-3024-87af-40662c75dee0",
                                                "text": "They say that mimicry is the sincerest form of flattery, but I still think I'm being mocked when he acts just like me."
                                            },
                                            {
                                                "example_id": "84711707-1225-41a2-b8d0-5cbba94cdd9b",
                                                "sense_id": "33386152-654d-3024-87af-40662c75dee0",
                                                "text": "When animal mimicry goes really wrong they don't just look like something that a predator would ignore, they look like lunch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b523785-6617-4d5a-9db1-06f8536df0d9",
                        "source_entry_id": "292663ef-9f95-313e-8fac-909a9e9fc9f5",
                        "source_sense_id": "33b36572-cf81-3608-84d2-29d7f12eb1dc",
                        "target_lang_word": "mimétisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mimétisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "140e1f47-feb4-3b02-9c1a-1603a9d186d6",
                                        "entry_id": "57adf36b-e592-3755-ad99-c2d9aa8f21de",
                                        "glosses": [
                                            "Propriété que possèdent ou paraissent posséder certains êtres vivants de se rendre semblables par l’apparence, et notamment par la couleur, au milieu où ils vivent (→ voir mimétisme environnemental)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70bb878a-0a10-3f0b-8f1e-575b0090a396",
                                        "entry_id": "57adf36b-e592-3755-ad99-c2d9aa8f21de",
                                        "glosses": [
                                            "Capacité d’un être vivant à se rendre semblable par l’apparence à un autre être vivant (→ voir mimétisme interspécifique)."
                                        ],
                                        "tags": [
                                            "Anatomie comparée"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34d645c1-f965-3f14-b604-e7ea0bb36400",
                                        "entry_id": "57adf36b-e592-3755-ad99-c2d9aa8f21de",
                                        "glosses": [
                                            "Mécanisme du comportement humain qui consiste, pour l’enfant en particulier et l’homme en général, à imiter son entourage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aad0a7a3-3fef-4752-8ae2-cd2d2894b7f8",
                                                "sense_id": "34d645c1-f965-3f14-b604-e7ea0bb36400",
                                                "text": "Semblable à beaucoup de ces entrepreneurs dopés à l’hyper-croissance, Cyborg génère par atavisme, mimétisme cupide, conviction idiote ou crainte pleutre, un comportement déviant auprès de ses plus proches cadres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
