        "fr-extract.jsonl": [
            {
                "entry_id": "3c9728e6-d666-3e4d-aa68-db83a58b9faa",
                "word": "électriquement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b218c777-e9ca-3dee-9915-8e51ee92a0bb",
                        "entry_id": "3c9728e6-d666-3e4d-aa68-db83a58b9faa",
                        "glosses": [
                            "Par voie électrique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26e8dc69-c187-4e4d-ac57-7ec484ba6777",
                                "sense_id": "b218c777-e9ca-3dee-9915-8e51ee92a0bb",
                                "text": "La capitale autrichienne possède maintenant des voitures d’omnibus éclairées électriquement."
                            },
                            {
                                "example_id": "c1dadf37-d693-4d93-9364-9b44b3f33fda",
                                "sense_id": "b218c777-e9ca-3dee-9915-8e51ee92a0bb",
                                "text": "Des boutefeux sont spécialement chargés du tir des mines. Ce tir se fait électriquement : les boutefeux. emportent avec eux la magnéto de tir, les fils de raccord et les amorces."
                            },
                            {
                                "example_id": "7dd5eced-241f-44ef-b765-ba27baa16730",
                                "sense_id": "b218c777-e9ca-3dee-9915-8e51ee92a0bb",
                                "text": "M. de Joly, architecte de l’Assemblée, a eu l’idée de faire allumer les becs électriquement au moment utile,"
                            },
                            {
                                "example_id": "bf20a6cb-a780-4624-8a36-68a1121608ae",
                                "sense_id": "b218c777-e9ca-3dee-9915-8e51ee92a0bb",
                                "text": "M. Cazaux adresse la description d’un système destiné à révéler électriquement un commencement d’incendie,"
                            },
                            {
                                "example_id": "784706ad-9fa9-4f3d-9fd6-a7cbc7a9c510",
                                "sense_id": "b218c777-e9ca-3dee-9915-8e51ee92a0bb",
                                "text": "Le concept a été formulé il y a des décennies : stimuler électriquement le cerveau pour qu'il \"voie\" des points lumineux ou \"phosphènes\", des sortes de pixels, mais avec de la profondeur en plus."
                            }
                        ]
                    },
                    {
                        "sense_id": "31ece401-db50-32b6-8b1f-fc4bac113dde",
                        "entry_id": "3c9728e6-d666-3e4d-aa68-db83a58b9faa",
                        "glosses": [
                            "Relativement à l'électricité ou aux charges électriques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3968a6eb-1bc2-491b-b0b0-3f914e2b80c6",
                                "sense_id": "31ece401-db50-32b6-8b1f-fc4bac113dde",
                                "text": "Un léger choc suffit toutefois à faire disparaître cette conductibilité d'emprunt, à « décohérer » la limaille qui redevient électriquement résistante."
                            },
                            {
                                "example_id": "f11367b6-6d50-4abb-81e0-67254a4fa757",
                                "sense_id": "31ece401-db50-32b6-8b1f-fc4bac113dde",
                                "text": "Le point isoélectrique est la valeur du pH pour laquelle le transport d’un protéide dans un champ électrique est nul, c’est-à-dire le pH pour lequel le protéide est électriquement neutre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fefb3d45-a96c-4fba-9106-c222b0b411b6",
                        "source_entry_id": "3c9728e6-d666-3e4d-aa68-db83a58b9faa",
                        "target_lang_word": "electrically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "electrically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a6755c7-41b4-3b0e-a2c6-bf7f34b17d64",
                                        "entry_id": "e289a790-44b5-3881-9798-d09d70ee7918",
                                        "glosses": [
                                            "By means of electricity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82c501fa-0919-4bd0-80c9-a358e7d7cfd7",
                                                "sense_id": "4a6755c7-41b4-3b0e-a2c6-bf7f34b17d64",
                                                "text": "Solar storms drive currents of millions of amps through the electrically conductive upper layer of our atmosphere (known as the ionosphere). These currents, which can fluctuate rapidly, drive powerful magnetic disturbances at the Earth's surface that in turn induce electrical currents in the planet's crust."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0f52fa0-9323-3ae8-ab8b-53ac0f67c110",
                                        "entry_id": "e289a790-44b5-3881-9798-d09d70ee7918",
                                        "glosses": [
                                            "In an electric manner."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7641eb22-a5fd-45e9-bc79-47cd1fba67b5",
                                                "sense_id": "d0f52fa0-9323-3ae8-ab8b-53ac0f67c110",
                                                "text": "The concert was electrically exciting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b06b3e1d-21c2-3671-a350-c14d8db12135",
                                        "entry_id": "e289a790-44b5-3881-9798-d09d70ee7918",
                                        "glosses": [
                                            "In terms of electrons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d33c6e-8fed-4be6-a4f9-266cb4e17d19",
                                                "sense_id": "b06b3e1d-21c2-3671-a350-c14d8db12135",
                                                "text": "an electrically symmetric atom"
                                            }
                                        ]
                                    }
                                ]
                            }
