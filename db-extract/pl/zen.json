                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "zen",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a0b5cb19-cb12-3c95-afe3-ec040748eaee",
                                        "entry_id": "f2cf2667-cf3b-3381-8549-fd93a4280a3f",
                                        "glosses": [
                                            "Tradition bouddhiste japonaise fondée principalement sur la pratique de la méditation et l’étude des koans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c40c6404-7a0a-41c2-a8ee-34d693ddde54",
                                                "sense_id": "a0b5cb19-cb12-3c95-afe3-ec040748eaee",
                                                "text": "Bien qu’il plonge ses racines dans le zen, le chanoyu ne prône donc pas de doctrine religieuse. Il faut plutôt le considérer comme l’amalgame d’un vaste ensemble d’idéaux philosophiques et esthétiques […]."
                                            }
                                        ]
                                    }
                                ]
                            },
