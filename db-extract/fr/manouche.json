                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15e267f5-b283-4c3e-bc57-ca1586166880",
                                "sense_id": "8107deef-8a38-30cf-afff-1f7cf7de0fe1",
                                "text": "Encore une caravane de ces fichus manouches!"
                            },
                            {
                                "example_id": "ebb068ff-8385-428c-b87d-4e47daed7eb1",
                                "sense_id": "8107deef-8a38-30cf-afff-1f7cf7de0fe1",
                                "text": "Les manouches roulent vitres ouvertes, d'un malheur l'autre. Entre les deux il y a la route et le ruban de cette musique si joyeuse qu'elle rend Dieu innocent de ses fautes."
                            },
                            {
                                "example_id": "f8802195-f632-4881-b797-649a3331bd6d",
                                "sense_id": "8107deef-8a38-30cf-afff-1f7cf7de0fe1",
                                "text": "– Ohé, le manouche, lança le surveillant à Dan."
                            }
                        ]
                    }
                ],
