                "senses": [
                    {
                        "sense_id": "45bf9103-5604-3f93-9e65-d8631dd97309",
                        "entry_id": "6931a6fe-4e9e-33e4-9754-2bceb0c9a4df",
                        "glosses": [
                            "of or relating to computation, computational"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b922fa3-e3bc-46ec-a101-065ffa7c07b4",
                                "sense_id": "45bf9103-5604-3f93-9e65-d8631dd97309",
                                "text": "Adopting (the additional computative burden imposed by it notwithstanding) Schönfeld's modification of Airy's formulae"
                            },
                            {
                                "example_id": "d438fe8c-fe53-4733-9322-77e7c6ece66e",
                                "sense_id": "45bf9103-5604-3f93-9e65-d8631dd97309",
                                "text": "The reckoning need not be genuinely computative (intellectual); it may take the form of motor adjustments"
                            }
                        ]
                    },
                    {
                        "sense_id": "ec011d28-d0ec-39a1-9401-cd3b71a834c1",
                        "entry_id": "6931a6fe-4e9e-33e4-9754-2bceb0c9a4df",
                        "glosses": [
                            "calculating, shrewdly or selfishly reckoning"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc60a9f4-aed2-4ade-adb1-c21e7c2e01c3",
                                "sense_id": "ec011d28-d0ec-39a1-9401-cd3b71a834c1",
                                "text": "What will please reckless, computative and vulgar persons."
                            },
                            {
                                "example_id": "b1ffecb9-d7f1-4801-adfb-b48dd3ee1fbc",
                                "sense_id": "ec011d28-d0ec-39a1-9401-cd3b71a834c1",
                                "text": "The demands of computative justice are thus unconsciously fulfilled by the last scions of a tainted stock."
                            }
                        ]
                    }
                ],
