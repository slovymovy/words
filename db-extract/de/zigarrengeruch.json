                ],
                "senses": [
                    {
                        "sense_id": "385b52f6-2304-3f81-9f5d-ae32dcec1056",
                        "entry_id": "813f111f-45e6-3114-b840-4b2071c87c66",
                        "glosses": [
                            "Wahrnehmung von Geruch in der Luft, an Materialien oder an sich selbst, der von abgebrannten Zigarren stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d448ded-7153-44e5-8847-5da239511806",
                                "sense_id": "385b52f6-2304-3f81-9f5d-ae32dcec1056",
                                "text": "„Santiago de Cuba. Schon nur bei diesen drei Wörtern hört man bereits die Eiswürfel im Rumglas klickern und schnuppert feinen Zigarrengeruch.“"
                            },
                            {
                                "example_id": "1b7f8aed-96aa-403c-982d-a41bed180bb2",
                                "sense_id": "385b52f6-2304-3f81-9f5d-ae32dcec1056",
                                "text": "„Der würzige Zigarrengeruch hing schwer in der Luft in seiner Villa Chesa Margi in Suvretta.“"
                            },
                            {
                                "example_id": "77bb78f8-5ef0-4427-95f0-9f73ee953fb7",
                                "sense_id": "385b52f6-2304-3f81-9f5d-ae32dcec1056",
                                "text": "„Es soll Hotelgäste geben, die nachts Zigarrengeruch wahrnehmen – oder Rosenduft; mir blieb das erspart.“"
                            },
                            {
                                "example_id": "c03a4af4-68cb-4778-b536-79ff80273068",
                                "sense_id": "385b52f6-2304-3f81-9f5d-ae32dcec1056",
                                "text": "„Neben dem typischen Lösungsmittelgeruch des Klebers („Manche riechen das gern, manche meinen, das stinkt - aber ich rieche es überhaupt nur, wenn ich frisch aus dem Urlaub komme!“) gehört in dieser Schusterwerkstatt der unverwechselbare Zigarrengeruch zur Atmosphäre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
