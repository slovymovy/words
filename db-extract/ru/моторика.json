                                "target_senses": [
                                    {
                                        "sense_id": "25fb6fac-dd28-3a1c-8470-93f1ee5f7ac4",
                                        "entry_id": "f28728af-c054-3622-811f-a25cdf05f805",
                                        "glosses": [
                                            "Fähigkeit des Körpers eines Tieres, eines Menschen oder deren Organe sich (durch das Gehirn gesteuert) zu bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fbf9838-f3f7-43df-a88e-7dbde23dc441",
                                                "sense_id": "25fb6fac-dd28-3a1c-8470-93f1ee5f7ac4",
                                                "text": "Patienten, die an Morbus Parkinson leiden, sind in ihrer Motorik beeinträchtigt."
                                            },
                                            {
                                                "example_id": "249f30cd-bef6-4862-ad3f-59e6fd30ebc3",
                                                "sense_id": "25fb6fac-dd28-3a1c-8470-93f1ee5f7ac4",
                                                "text": "„Meine Motorik wurde besser und besser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8a1d6e44-7fde-3689-95e4-0265f90dbc25",
                                        "entry_id": "f28728af-c054-3622-811f-a25cdf05f805",
