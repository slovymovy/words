        "de-extract.jsonl": [
            {
                "entry_id": "2b1523ea-2dbe-3160-b857-85cbd18be123",
                "word": "geschweige",
                "pos": "conj",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f9aa3c64-5303-389c-8366-1ba668c55ee3",
                        "entry_id": "2b1523ea-2dbe-3160-b857-85cbd18be123",
                        "glosses": [
                            "drückt nach einer verneinten oder einschränkenden Aussage aus, dass das Folgende noch weniger zutrifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8462e69-b3a1-4740-b765-2b23da79efd1",
                                "sense_id": "f9aa3c64-5303-389c-8366-1ba668c55ee3",
                                "text": "„Würde bei einem Projekt ein Bild zu bearbeiten sein, würde man nach einer Anleitung oder Tutorial suchen, es schnell finden, die Schritte anwenden und nicht so sehr das dahinterstehende Konzept erkennen, darüber nachdenken, es einordnen, geschweige sich Gedanken darüber machen, ob in anderen Programmen das auch so ist, oder abseits von Bildbearbeitungsprogrammen diese Idee auch zu finden ist, wo, ob es dort Unterschiede gibt, […] Dadurch wird bei Projekten oft viel Produktwissen, aber kaum Konzeptwissen gesammelt, geschweige darüber nachgedacht und es eingeordnet.“"
                            },
                            {
                                "example_id": "abc15cbe-7c6d-4582-b050-26060a662e97",
                                "sense_id": "f9aa3c64-5303-389c-8366-1ba668c55ee3",
                                "text": "„Niemand durfte sie auch nur berühren, geschweige denn ausleihen.“"
                            },
                            {
                                "example_id": "ab51d197-b745-4606-a64d-a488a4503732",
                                "sense_id": "f9aa3c64-5303-389c-8366-1ba668c55ee3",
                                "text": "„Nicht einmal die leblose schöne Natur, geschweige die lebende, athmende! nicht einen hellgeschliffenen Harnisch, geschweige ein blitzendes Auge; nicht eine blond hinwallende Haarlocke, geschweige ein ganzes majestätisches oder erhabenes Haupt.“"
                            },
                            {
                                "example_id": "d2652a8f-d459-4cab-8abc-2130c3cd8f46",
                                "sense_id": "f9aa3c64-5303-389c-8366-1ba668c55ee3",
                                "text": "„Die Zementfabrik produziert übrigens heute noch, doch niemand würde auf die Idee kommen, seinen Zement dort selbst abzuholen, geschweige denn dafür zusätzlich mit Wein und Lebensmitteln zu zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c59ac218-52ea-3b53-b7a2-51e2d868f196",
                        "entry_id": "2b1523ea-2dbe-3160-b857-85cbd18be123",
                        "glosses": [
                            "drückt nach einer verneinten oder einschränkenden Aussage aus, dass das Folgende noch weniger zutrifft",
                            "kann anstelle von noch in weder … noch stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b68988-d397-4211-ac5f-d74510056900",
                                "sense_id": "c59ac218-52ea-3b53-b7a2-51e2d868f196",
                                "text": "„Woran liegt es, dass solche ‚patientenfeindlichen‘ Haltungen und Ansichten, die weder in der theoretischen Ausbildung, geschweige denn durch Praxisanleitung vermittelt werden, Berufsstarter in diesem Ausmaß infizieren?“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "7114b185-e382-3c24-93f7-b0e21de5f65e",
                        "entry_id": "2b1523ea-2dbe-3160-b857-85cbd18be123",
                        "glosses": [
                            "drückt nach einer affirmativen Aussage aus, dass das Folgende noch mehr zutrifft"
                        ],
                        "tags": [
                            "outdated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d11950da-36f7-4548-b6e2-7fa9635ce730",
                                "sense_id": "7114b185-e382-3c24-93f7-b0e21de5f65e",
                                "text": "„Ew. Excell. verzeihen, wenn ich nicht persönlich aufwarte, aber ein Abschied in dieser Zeit ist schon peinigend im Begriff, geschweige in der Gegenwart.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6427bc2a-f571-4cfb-bd8f-32194b9f77bd",
                        "source_entry_id": "2b1523ea-2dbe-3160-b857-85cbd18be123",
                        "target_lang_word": "let alone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "let alone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5d6f47a-cedc-3d2f-9e0d-9a0b7d2fd940",
                                        "entry_id": "c832d83c-5c2e-3183-946e-320da4f60ae4",
                                        "glosses": [
                                            "Much less; to say nothing of; used after one negative clause to introduce another, usually broader and more important clause, whose negation is implied by the negation of the first. However either of these instances mentioned can be applied with the use of let alone."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c490177-2a18-44d6-bcf7-a6e16ba654a5",
                                                "sense_id": "e5d6f47a-cedc-3d2f-9e0d-9a0b7d2fd940",
                                                "text": "He couldn't boil water, let alone prepare a dinner for eight."
                                            },
                                            {
                                                "example_id": "b743f5e0-7ca4-4db3-88d7-c16c2f6df0e1",
                                                "sense_id": "e5d6f47a-cedc-3d2f-9e0d-9a0b7d2fd940",
                                                "text": "My last run this month is an amazing performance of an \"A2/3\" Pacific, No. 60524, Herringbone (could there possibly be a more infelicitous name for a locomotive than this, let alone for the unhappy horse which first had to bear it?), […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e037139b-dadc-3360-b269-645b250e126f",
                                        "entry_id": "c832d83c-5c2e-3183-946e-320da4f60ae4",
                                        "glosses": [
                                            "Not to mention, as well as; used after one item, to introduce a further item which is entailed by the first."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "735a518c-bd6a-4af8-8fba-9350a7d7aae7",
                                                "sense_id": "e037139b-dadc-3360-b269-645b250e126f",
                                                "text": "At the end of another ten years, let alone sixty, we are likely to see a very different pattern in the realm of British passenger locomotive power."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "let alone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e98c5fd5-03b5-3454-81b2-15547f70914f",
                                        "entry_id": "0d359dff-159f-3337-a9ef-5d2b72786816",
                                        "glosses": [
                                            "To leave alone, let be; to stop bothering."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a0a8ef-8a5d-48be-b3d4-268ceeabc5cb",
                                                "sense_id": "e98c5fd5-03b5-3454-81b2-15547f70914f",
                                                "text": "I wish he would let me alone so I could get some sleep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c62aa1dc-ace3-379b-991e-4f032f67409b",
                                        "entry_id": "0d359dff-159f-3337-a9ef-5d2b72786816",
                                        "glosses": [
                                            "To rely on (a person) to do something."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cadeba92-8136-4d3d-a2a6-1e96a8f9aa87",
                                                "sense_id": "c62aa1dc-ace3-379b-991e-4f032f67409b",
                                                "text": "Oh! let him alone for that. He's the boy that can get out of a scrape."
                                            },
                                            {
                                                "example_id": "6cb3971c-6436-49fa-8ec3-e4212aa30853",
                                                "sense_id": "c62aa1dc-ace3-379b-991e-4f032f67409b",
                                                "text": "\"It's not easy gettin' as good,\" rejoined the old woman, \"an' you ought to be very glad to win him, if you can.\"\n\"Let me alone for that,\" said Sally."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
