                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "346b4417-387f-3239-bef5-3657529c8867",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
                                        "glosses": [
                                            "The relative thickness of a drawn rule or painted brushstroke, line weight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ca12f14-1cf7-3fbc-abfc-a64268f2f350",
                                        "entry_id": "3f156c9d-2d3f-3dd3-857b-d6fe3fba0b29",
