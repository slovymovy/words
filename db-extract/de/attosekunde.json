                "senses": [
                    {
                        "sense_id": "c42fe57f-c46e-3ca8-9a32-0f2706bb32ac",
                        "entry_id": "08aaf0bc-fefb-3e65-b6aa-92c79694e3ee",
                        "glosses": [
                            "Trillionstel (10⁻¹⁸) einer Sekunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab129199-3c16-4510-b606-02933a4fca58",
                                "sense_id": "c42fe57f-c46e-3ca8-9a32-0f2706bb32ac",
                                "text": "„Möglich machen es hyperschnelle Lichtblitze, genauer, eine Attosekunde kurze Laserpulse.“"
                            },
                            {
                                "example_id": "2f672f95-6a15-48b3-b8b5-838a3ba0301b",
                                "sense_id": "c42fe57f-c46e-3ca8-9a32-0f2706bb32ac",
                                "text": "„Nur 80 Attosekunden dauerte der Lichtblitz - eine Trillionstelsekunde, 17 Nullen hinter dem Komma vor der Acht.“"
                            },
                            {
                                "example_id": "22c1d07f-fb8d-4674-9316-fe485affa456",
                                "sense_id": "c42fe57f-c46e-3ca8-9a32-0f2706bb32ac",
                                "text": "„Beispielsweise rast ein Elektron in gerade mal 250 Attosekunden einmal um den Atomkern - das ist die Winzigkeit von 0,00000000000000025 Sekunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e3eb306-3b32-4052-9f4b-7e2804b7d2b1",
                        "source_entry_id": "08aaf0bc-fefb-3e65-b6aa-92c79694e3ee",
                        "source_sense_id": "c42fe57f-c46e-3ca8-9a32-0f2706bb32ac",
                        "source_sense_description": "Trillionstel einer Sekunde",
                        "target_lang_word": "attosecond",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "attosecond",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c58acce-c1a3-3263-8cc3-a648953cfefb",
                                        "entry_id": "dd8955fd-f91e-3acb-af5c-dd540bd09777",
                                        "glosses": [
                                            "An SI unit of time equal to 10⁻¹⁸ seconds. Symbol: as"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d460daf-0843-41c0-a6c2-1e83f4625e39",
                                                "sense_id": "7c58acce-c1a3-3263-8cc3-a648953cfefb",
                                                "text": "Meronyms: quectosecond < rontosecond < yoctosecond < zeptosecond"
                                            },
                                            {
                                                "example_id": "508de74b-5f53-4f1c-ac2a-f1ae3292fefc",
                                                "sense_id": "7c58acce-c1a3-3263-8cc3-a648953cfefb",
                                                "text": "Holonyms: femtosecond < picosecond < nanosecond < microsecond < millisecond < centisecond < decisecond < second < decasecond < minute < hectosecond < kilosecond < hour < day < week < megasecond < fortnight < month < year < gigasecond < century < kiloannum, kiloyear, millennium < terasecond < mega-annum, megayear < petasecond < giga-annum, gigayear < exasecond < zettasecond < yottasecond < ronnasecond < quettasecond"
                                            },
                                            {
                                                "example_id": "75c6e722-a6c1-4ef7-ae79-db444b51734e",
                                                "sense_id": "7c58acce-c1a3-3263-8cc3-a648953cfefb",
                                                "text": "I can think at the speed of light, I can perceive events that last for less than an attosecond, I can run faster than time. What do I see when I run across the country, Superman? I see everything. And everyone."
                                            },
                                            {
                                                "example_id": "56b178a3-c5ce-4234-bcca-1fd5e96bfe6d",
                                                "sense_id": "7c58acce-c1a3-3263-8cc3-a648953cfefb",
                                                "text": "The observation and manipulation of electron dynamics in matter call for attosecond light pulses, routinely available from high-order harmonic generation driven by few-femtosecond lasers."
                                            },
                                            {
                                                "example_id": "c8acae2f-44af-4cc7-877b-a417d7d75476",
                                                "sense_id": "7c58acce-c1a3-3263-8cc3-a648953cfefb",
                                                "text": "Given the scales on which technology has operated in the first quarter of the 21st century, from lasers that flash for just a few attoseconds to the total amount of digital data in the world pushing past 160 zettabytes, it feels as if we may have let things lie for too long. I don't know if the future will have quettabit computer networks or rontometer-scale wormholes, but I'm pretty sure the large and small of it will be hella weird."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
