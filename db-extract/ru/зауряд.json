        "ru-extract.jsonl": [
            {
                "entry_id": "54ecf1af-0fd1-361b-9a46-d2e3eed91161",
                "word": "зауряд",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "35659ae9-4ee5-30da-a16a-fdbe8d25c2e6",
                        "entry_id": "54ecf1af-0fd1-361b-9a46-d2e3eed91161",
                        "glosses": [
                            "устар., разг. наряду, наравне"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4e8b048-f070-4587-880d-84be456f2515",
                                "sense_id": "35659ae9-4ee5-30da-a16a-fdbe8d25c2e6",
                                "text": "«Образ служения казакам свойственный» нарушен ― казаки зауряд с остальным населением отбывают повинность в красноармейских пеших и конных частях."
                            }
                        ]
                    },
                    {
                        "sense_id": "f86dba2d-bf8c-3a48-92ac-d8dadd377d54",
                        "entry_id": "54ecf1af-0fd1-361b-9a46-d2e3eed91161",
                        "glosses": [
                            "устар., разг. подряд, непрерывно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b761d089-4b71-4a20-aca2-4e37aaec86f5",
                                "sense_id": "f86dba2d-bf8c-3a48-92ac-d8dadd377d54",
                                "text": "Недавно всех нас зауряд, чуть-чуть не поголовно, злоумышленниками считали и так подтягивали крепко, что нельзя было и дохнуть."
                            },
                            {
                                "example_id": "255cff70-205f-4f9e-9221-fc685340ccad",
                                "sense_id": "f86dba2d-bf8c-3a48-92ac-d8dadd377d54",
                                "text": "Кутящая компания налетала на мещанский или купеческий дом, безобразничала там и потом отделывалась деньгами, подарками и, всякими правдами и неправдами, выходила чиста. Правда, что случалось не зауряд, однако всё-таки случалось."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
