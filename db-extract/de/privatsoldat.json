                "senses": [
                    {
                        "sense_id": "4a6480aa-7d55-3a4f-a514-4db63a4a6f78",
                        "entry_id": "acffbc6d-7488-381a-bd17-b43670fc4d20",
                        "glosses": [
                            "privat bezahlter Soldat"
