{
    "word_family": [
        "granule",
        "granulate",
        "granulation"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fbcf7bbd-97a5-3065-a6bb-771fbe6dcc1c",
                    "sense_definition": "Consisting of or resembling small grains or particles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>granular</w> texture of the sand felt rough against my bare feet.",
                            "target_lang_translations": {
                                "zh": "沙子<w>颗粒状的</w>质地让我的赤脚感到粗糙。"
                            }
                        },
                        {
                            "text": "Sugar has a <w>granular</w> consistency that dissolves quickly in hot water.",
                            "target_lang_translations": {
                                "zh": "糖具有<w>颗粒状的</w>稠度，在热水中溶解得很快。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grainy",
                        "particulate"
                    ],
                    "antonyms": [
                        "nongrainy",
                        "nonpowdery"
                    ],
                    "common_phrases": [
                        "granular texture",
                        "granular substance"
                    ],
                    "target_lang_definitions": {
                        "zh": "由小颗粒组成或类似小颗粒的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "颗粒状的",
                                "target_lang_sense_clarification": "形容物体表面或质地由细小颗粒构成。"
                            },
                            {
                                "target_lang_word": "粒状的",
                                "target_lang_sense_clarification": "指物质呈现出颗粒的形态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3de7c35a-e93a-3215-b851-bb75c6aa0900",
                    "sense_definition": "Characterized by a high level of detail or precise control.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "precision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new software provides a more <w>granular</w> level of control over user permissions.",
                            "target_lang_translations": {
                                "zh": "这款新软件对用户权限提供了更<w>精细的</w>控制。"
                            }
                        },
                        {
                            "text": "We need a <w>granular</w> analysis of the data to understand these specific trends.",
                            "target_lang_translations": {
                                "zh": "我们需要对数据进行<w>细致的</w>分析，以了解这些具体的趋势。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "granular control",
                        "granular analysis"
                    ],
                    "target_lang_definitions": {
                        "zh": "指具有高度细节或精确控制的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "细致的",
                                "target_lang_sense_clarification": "形容分析或控制非常深入、细致。"
                            },
                            {
                                "target_lang_word": "精细的",
                                "target_lang_sense_clarification": "指处理过程或数据分析非常精确、细化。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}