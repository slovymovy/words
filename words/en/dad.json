                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My <w>dad</w> drives me to school every morning.",
                            "target_lang_translations": {
                                "ru": "Мой <w>папа</w> отвозит меня в школу каждое утро.",
                                "zh": "我<w>爸爸</w>每天早上开车送我去学校。",
                                "nl": "Mijn <w>papa</w> brengt me elke ochtend met de auto naar school.",
                                "pl": "Mój <w>tata</w> odwozi mnie codziennie rano do szkoły.",
                                "de": "Mein <w>Papa</w> fährt mich jeden Morgen zur Schule.",
                                "fr": "Mon <w>papa</w> m'emmène à l'école tous les matins.",
                                "it": "Il mio <w>papà</w> mi accompagna a scuola ogni mattina.",
                                "cs": "Můj <w>táta</w> mě každé ráno vozí do školy.",
                                "tr": "<w>Babam</w> beni her sabah okula arabayla bırakır.",
                                "es": "Mi <w>papá</w> me lleva a la escuela todas las mañanas."
                            }
                        },
                        {
                            "text": "He loves being a <w>dad</w> and spending time with his children.",
                            "target_lang_translations": {
                                "ru": "Ему нравится быть <w>папой</w> и проводить время со своими детьми.",
                                "zh": "他很享受做<w>爸爸</w>，喜欢和孩子们待在一起。",
                                "nl": "Hij vindt het heerlijk om <w>vader</w> te zijn en tijd door te brengen met zijn kinderen.",
                                "pl": "Uwielbia być <w>tatą</w> i spędzać czas ze swoimi dziećmi.",
                                "de": "Er liebt es, <w>Vater</w> zu sein und Zeit mit seinen Kindern zu verbringen.",
                                "fr": "Il adore être <w>papa</w> et passer du temps avec ses enfants.",
                                "it": "Ama fare il <w>papà</w> e passare il tempo con i suoi figli.",
                                "cs": "Miluje roli <w>táty</w> a rád tráví čas se svými dětmi.",
                                "tr": "<w>Baba</w> olmayı ve çocuklarıyla vakit geçirmeyi seviyor.",
                                "es": "Le encanta ser <w>padre</w> y pasar tiempo con sus hijos."
                            }
