        "nl-extract.jsonl": [
            {
                "entry_id": "6b2bd504-9bf6-3581-8841-0548837d7c1d",
                "word": "zeewater",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "6fb64c82-1f7d-4836-aec7-a08c95e6c0e7",
                        "entry_id": "6b2bd504-9bf6-3581-8841-0548837d7c1d",
                        "tags": [
                            "plural"
                        ],
                        "form": "zeewateren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c6698120-3ff0-3ec2-8851-77749c6c5cd9",
                        "entry_id": "6b2bd504-9bf6-3581-8841-0548837d7c1d",
                        "glosses": [
                            "water waarin diverse zouten zijn opgelost en waarmee de zeeën gevuld zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e069c163-fde6-4f9f-b671-10d5790a0a13",
                                "sense_id": "c6698120-3ff0-3ec2-8851-77749c6c5cd9",
                                "text": "Zeebiologen waarschuwden begin vorig jaar al dat de aanhoudende recordtemperaturen van het zeewater tot grootschalige verbleking van het koraal zou leiden. Die hoge temperaturen zijn het gevolg van de klimaatverandering en het periodieke weerfenomeen El Niño, dat gepaard gaat met opwarming van het zeewater in de Stille Oceaan. De daarop volgende La Niña die op haar beurt voor afkoeling zorgt, duurde korter dan normaal, waardoor de riffen geen tijd hadden om te herstellen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96423b22-1056-4aef-ab3b-afc1f4eab593",
                        "source_entry_id": "6b2bd504-9bf6-3581-8841-0548837d7c1d",
                        "source_sense_id": "c6698120-3ff0-3ec2-8851-77749c6c5cd9",
                        "source_sense_description": "water waarin diverse zouten zijn opgelost en waarmee de zeeën gevuld zijn",
                        "target_lang_word": "Meerwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meerwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                        "entry_id": "c461ab2c-8b83-3a7c-973f-0a9decf422f9",
                                        "glosses": [
                                            "das salzhaltige Wasser, aus dem die Meere bestehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1007e9b3-994c-48da-b920-4df25ef86f7c",
                                                "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                                "text": "„Auf der frühen Erde wurden die Kontinente durch Vulkanausbrüche erschüttert und jeder komplexe chemische Stoff wäre auf dem Land bald zerstört worden. Meerwasser hingegen löst chemische Stoffe gut auf und ermöglicht es ihnen, zu reagieren.“"
                                            },
                                            {
                                                "example_id": "82f84503-87a1-4188-935e-aff999430789",
                                                "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                                "text": "„In größeren Mengen genossen führt das Meerwasser zu schweren gesundheitlichen Störungen, die bei verdurstenden Personen im Wahnsinn enden.“"
                                            },
                                            {
                                                "example_id": "06cec1b3-9d39-47d0-af15-d7d4aaacff7e",
                                                "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                                "text": "„Die Festung liegt am Rande der Stadt, direkt neben einer Dattelpalmenplantage, und sieht aus wie eine Sandburg, die jemand mit viel Ehrgeiz erbaut hat und über die schon etliche Wellen Meerwasser geschwappt sind.“"
                                            },
                                            {
                                                "example_id": "92443fbf-24e9-4be4-a3bf-ba5e04e0f74d",
                                                "sense_id": "f346a9b2-9731-3f0b-8dd3-743953f42a5d",
                                                "text": "„Das warme, salzhaltige Meerwasser hat bei ihr die Wirkung einer Heilquelle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aac44964-7620-4940-8e5b-4a91315e1c39",
                        "source_entry_id": "6b2bd504-9bf6-3581-8841-0548837d7c1d",
                        "source_sense_id": "c6698120-3ff0-3ec2-8851-77749c6c5cd9",
                        "source_sense_description": "water waarin diverse zouten zijn opgelost en waarmee de zeeën gevuld zijn",
                        "target_lang_word": "Seewasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seewasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00b0735c-9926-3841-9f2e-c1e5e184b97c",
                                        "entry_id": "ca20e222-efed-3bfe-84dd-a1673207ec2b",
                                        "glosses": [
                                            "Wasser des Meeres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "836f7a70-327e-4b3f-919f-7119a8e37e66",
                                                "sense_id": "00b0735c-9926-3841-9f2e-c1e5e184b97c",
                                                "text": "„Er atmete erleichtert und mußte sich alle Mühe geben, um nicht von dem Seewasser zu trinken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e392f081-bf19-3e1e-a036-fb9f5123e427",
                                        "entry_id": "ca20e222-efed-3bfe-84dd-a1673207ec2b",
                                        "glosses": [
                                            "Wasser eines Sees"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15efd692-d124-496f-8ba6-e2cba5d7a52f",
                                                "sense_id": "e392f081-bf19-3e1e-a036-fb9f5123e427",
                                                "text": "„Wie Seewasser anstelle der klimaschädlichen fossilen Brennstoffe genutzt werden kann, zeigen 35 Schweizer Anlagen.“"
                                            },
                                            {
                                                "example_id": "d0755187-aa24-4cd4-a25f-196991d1fe90",
                                                "sense_id": "e392f081-bf19-3e1e-a036-fb9f5123e427",
                                                "text": "„Von hier aus fliesst das Seewasser direkt zur Wärmepumpe.“"
                                            },
                                            {
                                                "example_id": "9d99cc05-7c6f-4cff-87ce-9812eeddae17",
                                                "sense_id": "e392f081-bf19-3e1e-a036-fb9f5123e427",
                                                "text": "„Die zum Transport des Seewassers installierten Leitungen bestehen aus duktilen Guss-Rohrsystemen, die sich dafür optimal eignen: Sie sind innen und außen gegen Korrosion geschützt und ihr großer hydraulischer Querschnitt hat niedrige Betriebskosten zur Folge.“"
                                            },
                                            {
                                                "example_id": "8437dd3f-6f58-49aa-9e94-92165e30baa7",
                                                "sense_id": "e392f081-bf19-3e1e-a036-fb9f5123e427",
                                                "text": "„Städte wie Basel, Genf oder Zürich produzieren aber auch Trinkwasser aus Fluss- oder Seewasser.“"
                                            },
                                            {
                                                "example_id": "90c23f16-db14-4ecd-9fe7-7a3a8c9657a1",
                                                "sense_id": "e392f081-bf19-3e1e-a036-fb9f5123e427",
                                                "text": "„Gelsenwasser muss in seinem Werk in Haltern immer mehr Aufwand betreiben, um trübes Seewasser in sauberes Trinkwasser umzuwandeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14806a59-f281-4495-801f-7d50ff55c318",
                        "source_entry_id": "6b2bd504-9bf6-3581-8841-0548837d7c1d",
