                        ]
                    },
                    {
                        "translation_id": "5ff7bb7c-c40f-45b3-9126-a49d9ff87df3",
                        "source_entry_id": "217c0908-67a6-37b0-bb60-26f59fd90dd3",
                        "source_sense_description": "person who protests",
                        "target_lang_word": "Protestant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Protestant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5df915f0-056f-33ef-a3c4-44355a574c42",
                                        "entry_id": "a2b8ac40-466c-3f5d-af50-c21e135d3a79",
                                        "glosses": [
                                            "Angehöriger einer christlichen Konfession, die durch die Reformation entstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7cd0544-1b96-44f1-8c0a-a0c763531611",
                                                "sense_id": "5df915f0-056f-33ef-a3c4-44355a574c42",
                                                "text": "In Nordirland herrschen Auseinandersetzungen zwischen Protestanten und Katholiken."
                                            },
                                            {
                                                "example_id": "932bd3d4-f48f-4a8c-b930-96913991b152",
                                                "sense_id": "5df915f0-056f-33ef-a3c4-44355a574c42",
                                                "text": "„In Versammlungen wie dem Reichstag nutzten die katholischen Fürsten zudem das Mehrheitswahlrecht, um die Protestanten kaltzustellen.“"
                                            },
                                            {
                                                "example_id": "2f228a0f-387c-4064-8056-d94cafa07ea7",
                                                "sense_id": "5df915f0-056f-33ef-a3c4-44355a574c42",
                                                "text": "„Meine Eltern, strenggläubige Protestanten, huldigten der Nachkriegsmode konfessioneller Versöhnlichkeit und schickten mich auf eine katholische Schule.“"
                                            },
                                            {
                                                "example_id": "0a95af5d-7765-45ca-ba34-39f840a016c0",
                                                "sense_id": "5df915f0-056f-33ef-a3c4-44355a574c42",
                                                "text": "„Der Protestant hat nur eine Kapelle, nüchterne Wände, einfache Fenster, und jetzt steht er neben dem katholischen Gottesmann wie ein armer Verwandter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85f89fa3-751f-36c4-b56e-10feefc3e9ff",
                                        "entry_id": "a2b8ac40-466c-3f5d-af50-c21e135d3a79",
                                        "glosses": [
                                            "Person, die gegen etwas protestiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "500e2fed-b4ec-402d-8990-a1345e31ae06",
                                                "sense_id": "85f89fa3-751f-36c4-b56e-10feefc3e9ff",
                                                "text": "Die Protestanten verhielten sich gegenüber den Polizisten friedlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1cf6984-64d2-4e8f-a847-544b501ca5f6",
                        "source_entry_id": "217c0908-67a6-37b0-bb60-26f59fd90dd3",
                        "source_sense_description": "person who protests",
                        "target_lang_word": "Protestierender",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Protestierender",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "441d5907-f830-34e2-a9b6-32c8edf69aa7",
                                        "entry_id": "03ebf290-940e-3efc-b9eb-2466cb40b727",
                                        "glosses": [
                                            "Person, die protestiert (zum Ausdruck bringt, dass sie mit etwas nicht einverstanden ist); an einem Protest teilnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db8baae-f220-43d7-8a07-40cbee6fb71b",
                                                "sense_id": "441d5907-f830-34e2-a9b6-32c8edf69aa7",
                                                "text": "„In Coburg kommt es bei Demonstrationen gegen die Ermordung Matthias Erzbergers zu blutigen Zusammenstößen zwischen der bayerischen Landespolizei und den Protestierenden.“"
                                            },
                                            {
                                                "example_id": "f2204d77-402f-4460-b5f8-8139eead674b",
                                                "sense_id": "441d5907-f830-34e2-a9b6-32c8edf69aa7",
                                                "text": "„Die Abschiedsvorlesung des Wirtschaftswissenschaftlers Bert Rürup an der Technischen Universität (TU) Darmstadt ist am Donnerstag wegen eines anhaltenden Pfeifkonzerts Protestierender abgebrochen worden.“"
                                            },
                                            {
                                                "example_id": "919fb0e9-6ad8-4d26-8762-a578e132052d",
                                                "sense_id": "441d5907-f830-34e2-a9b6-32c8edf69aa7",
                                                "text": "„Mehr als hunderttausend Protestierende haben am Samstag eine 120 Kilometer lange Menschenkette zwischen den AKW Krümmel und Brunsbüttel gebildet.“"
                                            },
                                            {
                                                "example_id": "62d172b3-9672-4dd5-9afc-fb81acc231d4",
                                                "sense_id": "441d5907-f830-34e2-a9b6-32c8edf69aa7",
                                                "text": "„Hunderte Demonstranten waren den schon seit Wochen vor dem Kabinettsgebäude Protestierenden zu Hilfe geeilt, als diese sich mit der Militärpolizei Straßenkämpfe lieferten.“"
                                            },
                                            {
                                                "example_id": "d45b4a47-e102-4799-8147-fcbf0faf5d43",
                                                "sense_id": "441d5907-f830-34e2-a9b6-32c8edf69aa7",
                                                "text": "„Manche der Protestierenden sind zu langsam oder haben keine Gasmasken, eine Frau liegt röchelnd auf dem nassen Pflaster.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
