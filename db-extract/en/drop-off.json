                                            {
                                                "example_id": "93207ada-bc9c-47e8-a8a0-9c95ee28026d",
                                                "sense_id": "53f563fe-bd9c-3011-90c2-2386f6861600",
                                                "text": "Die Abnahme der Temperatur steht im Zusammenhang mit den Schäden am Material."
                                            },
                                            {
                                                "example_id": "7f6ba313-698b-4a36-ae27-50a67b15b604",
                                                "sense_id": "53f563fe-bd9c-3011-90c2-2386f6861600",
                                                "text": "Die Abnahme des arktischen Eises findet hauptsächlich in den Monaten Mai bis Oktober statt."
                                            },
                                            {
                                                "example_id": "e5351cda-595a-414d-9fae-f9068c164546",
                                                "sense_id": "53f563fe-bd9c-3011-90c2-2386f6861600",
                                                "text": "Mit Sorge beobachtet der Internationale Gewerkschaftbund jedoch eine weltweite Abnahme der regulären Beschäftigung […]"
                                            },
                                            {
                                                "example_id": "d2621555-490e-494d-917d-ba8838db9fbe",
                                                "sense_id": "53f563fe-bd9c-3011-90c2-2386f6861600",
                                                "text": "\"[…] die Abnahme der Artenvielfalt und schädliche Einflüsse auf das Klima sind Folgen des Stickstoff-Überflusses\", sagt Christian Hey, Geschäftsführer des Sachverständigenrates."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0dbbecae-c213-3bb2-ad97-e10aa4ffaa20",
                                        "entry_id": "7d8e76fe-9500-372a-9d40-0d642e9ac3dc",
                                        "glosses": [
                                            "der Verlust von etwas durch jemand anderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad37646-df59-42b9-a5af-4b366bad0c4e",
                                                "sense_id": "0dbbecae-c213-3bb2-ad97-e10aa4ffaa20",
                                                "text": "Der alte Mann ließ sich die Abnahme seiner Tasche nicht einfach gefallen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "54bdd620-9a9c-379d-948a-38f5dc5a8670",
                                        "entry_id": "7d8e76fe-9500-372a-9d40-0d642e9ac3dc",
                                        "glosses": [
                                            "offizielle Akzeptanz eines Zustandes nach einer üblichen Überprüfung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "930246e4-6a08-4132-9c67-f2ab18f1a56c",
                                                "sense_id": "54bdd620-9a9c-379d-948a-38f5dc5a8670",
                                                "text": "Jetzt fehlt eigentlich nur noch die Abnahme der Stuben durch die Vorgesetzten."
                                            },
                                            {
                                                "example_id": "7ca5fa74-93eb-44cb-adc8-e56048015188",
                                                "sense_id": "54bdd620-9a9c-379d-948a-38f5dc5a8670",
                                                "text": "[ Dr. John Pombe Magufuli] verweigerte die Abnahme einer neugebauten Straße, die von der japanischen Regierung gesponsort worden war, weil sie nicht den Qualitätsstandards entsprach."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
