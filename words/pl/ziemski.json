                },
                {
                    "sense_id": "d23b38e9-6958-3bc7-a229-e7d89d8d9d45",
                    "sense_definition": "dotyczący życia doczesnego na tym świecie, w przeciwieństwie do sfery duchowej lub życia pozagrobowego",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "filozofia_religia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego żywot <w>ziemski</w> dobiegł końca po wielu latach ciężkiej pracy.",
                            "target_lang_translations": {
                                "en": "His <w>earthly</w> life came to an end after many years of hard work."
                            }
                        },
                        {
                            "text": "W obliczu wieczności wszelkie dobra <w>ziemskie</w> tracą na znaczeniu.",
                            "target_lang_translations": {
                                "en": "In the face of eternity, all <w>worldly</w> possessions lose their importance."
                            }
                        }
                    ],
                    "synonyms": [
                        "doczesny"
                    ],
                    "antonyms": [
                        "niebiański",
                        "nieziemski",
                        "pozagrobowy"
                    ],
                    "common_phrases": [
                        "żywot ziemski",
                        "wędrówka ziemska",
                        "dobra ziemskie"
                    ],
                    "target_lang_definitions": {
                        "en": "relating to mortal life in this world, as opposed to spiritual realms or the afterlife"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "earthly",
                                "target_lang_sense_clarification": "belonging to this mortal life, not heavenly"
                            },
                            {
                                "target_lang_word": "worldly",
                                "target_lang_sense_clarification": "secular or material rather than spiritual"
                            },
                            {
                                "target_lang_word": "temporal",
                                "target_lang_sense_clarification": "belonging to mortal time and physical reality"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82448920-7a38-30a8-9219-be8852e35db0",
                    "sense_definition": "związany z posiadaniem ziemi uprawnej lub majątku ziemskiego",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wlasnosc_rolnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W XIX wieku bogaci właściciele <w>ziemscy</w> posiadali ogromne połacie pól i lasów.",
                            "target_lang_translations": {
                                "en": "In the nineteenth century, wealthy <w>landed</w> proprietors owned vast tracts of fields and forests."
                            }
                        },
                        {
                            "text": "Ten dawny majątek <w>ziemski</w> został przekształcony w muzeum regionalne.",
                            "target_lang_translations": {
                                "en": "This former <w>landed</w> estate was converted into a regional museum."
                            }
