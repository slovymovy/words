                "senses": [
                    {
                        "sense_id": "a2163a91-5ce3-3bec-a58f-355fc7e14fa6",
                        "entry_id": "d8ce0069-d5c7-3b5b-9b0d-c638dc474cc9",
                        "glosses": [
                            "kolej miejska"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e89fe51-77e2-48c3-b6a4-250b9cc5951d",
                                "sense_id": "a2163a91-5ce3-3bec-a58f-355fc7e14fa6",
                                "text": "Die Berliner Stadtbahn ist eine Eisenbahnstrecke mitten durch das Zentrum Berlins.",
                                "translation": "Berlińska kolej miejska to trasa kolejowa (prowadząca) przez samo centrum Berlina."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "85c87c99-cdf1-3e21-80b1-5d2900b3d17a",
                        "entry_id": "d8ce0069-d5c7-3b5b-9b0d-c638dc474cc9",
                        "glosses": [
                            "kolej podmiejska"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd53f3fa-9e96-467b-a0c0-24b660f69236",
                                "sense_id": "85c87c99-cdf1-3e21-80b1-5d2900b3d17a",
                                "text": "Die Stadtbahn zählt als Bauwerk des späten Historismus und frühen Jugendstils zu den Sehenswürdigkeiten Wiens.",
                                "translation": "Jako obiekt budowlany późnego historyzmu i wczesnej secesji kolej miejska zalicza się do atrakcji turystycznych Wiednia."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "34b4235b-f75d-317d-960b-949053226c50",
                        "entry_id": "d8ce0069-d5c7-3b5b-9b0d-c638dc474cc9",
                        "glosses": [
                            "szybki tramwaj, premetro"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ddde49a-14a4-490a-a9b9-0922341527b1",
                                "sense_id": "34b4235b-f75d-317d-960b-949053226c50",
                                "text": "Neben den herkömmlichen Stadtbahnen mit Tunnelanlagen entstanden in jüngerer Zeit Stadtbahnen der neuen Generation.",
                                "translation": "Oprócz klasycznych szybkich tramwajów z tunelami powstają w ostatnich czasach szybkie tramwaje nowej generacji."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
