                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c88ad1c2-43f2-43cb-8bb1-86836b205281",
                                "sense_id": "6b54e686-081d-39dc-b708-4df9edd11a83",
                                "text": "Миша и рад был остаться, но мать умирает, и сценарий — навязшая в зубах тысячелетняя фабула — гонит его из дома, заставляет бомжить, пробираться в древнюю столицу, чтобы проповедовать в храме фарисеям и книжникам."
                            }
                        ]
                    }
