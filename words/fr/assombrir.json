                    "frequency": "Middle",
                    "semantic_group_id": "humeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette mauvaise nouvelle est venue <w>assombrir</w> l'humeur joyeuse de toute la famille réunie."
                        },
                        {
                            "text": "Les difficultés économiques récentes risquent d'<w>assombrir</w> l'avenir de cette jeune entreprise innovante."
                        }
                    ],
                    "synonyms": [
                        "rembrunir"
                    ],
                    "common_phrases": [
