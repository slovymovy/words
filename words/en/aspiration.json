{
    "word_family": [
        "aspire",
        "aspirant",
        "aspirational",
        "aspirator",
        "aspirate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fb3b3c88-88cc-39e5-982f-4a245a2f750c",
                    "sense_definition": "A strong desire, longing, or aim to achieve something great or high, such as a career goal or spiritual status.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ambition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a lifelong <w>aspiration</w> to become a doctor and help people in her community.",
                            "target_lang_translations": {
                                "ru": "У неё есть давнее <w>стремление</w> стать врачом и помогать людям в своём сообществе."
                            }
                        },
                        {
                            "text": "The young athlete's career <w>aspiration</w> is to compete in the next Olympic Games.",
                            "target_lang_translations": {
                                "ru": "Карьерная <w>амбиция</w> молодого атлета — выступить на следующих Олимпийских играх."
                            }
                        }
                    ],
                    "synonyms": [
                        "ambition",
                        "goal",
                        "aim",
                        "dream"
                    ],
                    "antonyms": [
                        "apathy",
                        "indifference"
                    ],
                    "common_phrases": [
                        "career aspiration",
                        "lofty aspiration",
                        "aspiration to become"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильное желание, стремление или цель достичь чего-то значительного или высокого, например, карьерного роста или духовного статуса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стремление",
                                "target_lang_sense_clarification": "настойчивое желание добиться чего-либо"
                            },
                            {
                                "target_lang_word": "амбиция",
                                "target_lang_sense_clarification": "энергичное стремление к честолюбивой цели"
                            },
                            {
                                "target_lang_word": "притязание",
                                "target_lang_sense_clarification": "претензия на достижение высокого положения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f7a7dde-2477-3181-97f2-f3438f1301a2",
                    "sense_definition": "The audible breath or burst of air that accompanies the release of certain consonant sounds.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "phonetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In English, the <w>aspiration</w> of the letter p is much stronger at the beginning of a word.",
                            "target_lang_translations": {
                                "ru": "В английском языке <w>придыхание</w> буквы p гораздо сильнее в начале слова."
                            }
                        },
                        {
                            "text": "The teacher explained how <w>aspiration</w> changes the way we perceive certain sounds in different languages.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил, как <w>аспирация</w> меняет наше восприятие определенных звуков в разных языках."
                            }
                        }
                    ],
                    "common_phrases": [
                        "phonetic aspiration"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слышимый выдох или поток воздуха, сопровождающий произнесение некоторых согласных звуков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придыхание",
                                "target_lang_sense_clarification": "акустический эффект при произнесении звука"
                            },
                            {
                                "target_lang_word": "аспирация",
                                "target_lang_sense_clarification": "лингвистический термин для шума при выдохе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "576c751b-fa2c-3dcf-a2ce-0c80bd8d32fd",
                    "sense_definition": "The medical procedure of removing fluids or gases from a body cavity using a suction device or needle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor performed a needle <w>aspiration</w> to test the fluid from the patient's cyst.",
                            "target_lang_translations": {
                                "ru": "Врач провел игольную <w>аспирацию</w>, чтобы проверить жидкость из кисты пациента."
                            }
                        },
                        {
                            "text": "The patient required immediate <w>aspiration</w> to clear the blockage from their lungs.",
                            "target_lang_translations": {
                                "ru": "Пациенту потребовалось немедленное <w>отсасывание</w>, чтобы очистить легкие от закупорки."
                            }
                        }
                    ],
                    "synonyms": [
                        "suction",
                        "withdrawal"
                    ],
                    "common_phrases": [
                        "needle aspiration",
                        "fine-needle aspiration"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинская процедура удаления жидкостей или газов из полости тела с помощью отсасывающего устройства или иглы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аспирация",
                                "target_lang_sense_clarification": "отсасывание жидкости или воздуха из полости тела"
                            },
                            {
                                "target_lang_word": "отсасывание",
                                "target_lang_sense_clarification": "процесс удаления жидкости медицинским прибором"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}