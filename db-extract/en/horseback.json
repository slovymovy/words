                        "source_entry_id": "432dbd39-cbfb-3fa8-8ee6-40976998aaf7",
                        "source_sense_description": "ridge of sand, gravel, and boulders",
                        "target_lang_word": "гре́бень",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гре́бень",
