{
    "word_family": [
        "suspect",
        "suspicious",
        "suspiciously",
        "suspiciousness",
        "unsuspicious"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f2e9e44-e742-3507-b85a-5a6428dd1018",
                    "sense_definition": "The feeling or belief that someone has done something wrong, illegal, or dishonest.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "distrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police had a strong <w>suspicion</w> that the man was lying about his whereabouts.",
                            "target_lang_translations": {
                                "ru": "У полиции было сильное <w>подозрение</w>, что мужчина лгал о своем местонахождении."
                            }
                        },
                        {
                            "text": "His sudden wealth aroused the <w>suspicion</w> of his neighbors and the local authorities.",
                            "target_lang_translations": {
                                "ru": "Его внезапное богатство вызвало <w>подозрение</w> у соседей и местных властей."
                            }
                        }
                    ],
                    "antonyms": [
                        "trust",
                        "confidence"
                    ],
                    "common_phrases": [
                        "arouse suspicion",
                        "under suspicion",
                        "confirm a suspicion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство или убеждение, что кто-то совершил что-то неправильное, незаконное или нечестное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подозрение",
                                "target_lang_sense_clarification": "предположение о виновности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44267bbe-abb1-34f8-b868-79967733ef34",
                    "sense_definition": "The act of imagining or believing something to be true without having firm evidence or proof.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a nagging <w>suspicion</w> that I have forgotten to lock the front door.",
                            "target_lang_translations": {
                                "ru": "Меня гложет <w>подозрение</w>, что я забыл запереть входную дверь."
                            }
                        },
                        {
                            "text": "She had a <w>suspicion</w> that they were planning a surprise party for her birthday.",
                            "target_lang_translations": {
                                "ru": "У нее было <w>предчувствие</w>, что они планируют вечеринку-сюрприз на ее день рождения."
                            }
                        }
                    ],
                    "synonyms": [
                        "inkling"
                    ],
                    "antonyms": [
                        "certainty",
                        "knowledge"
                    ],
                    "common_phrases": [
                        "have a suspicion",
                        "nagging suspicion",
                        "sneaking suspicion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предположение или вера во что-то без наличия твердых доказательств или подтверждений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подозрение",
                                "target_lang_sense_clarification": "догадка или предчувствие"
                            },
                            {
                                "target_lang_word": "предчувствие",
                                "target_lang_sense_clarification": "интуитивное ощущение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "062ab64f-b13e-3a56-b248-ade60f403a47",
                    "sense_definition": "A very small amount, trace, or slight indication of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "trace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was just a <w>suspicion</w> of a smile on her face as she watched them.",
                            "target_lang_translations": {
                                "ru": "На ее лице была лишь <w>тень</w> улыбки, когда она наблюдала за ними."
                            }
                        },
                        {
                            "text": "Add a <w>suspicion</w> of garlic to the sauce to enhance the overall flavor.",
                            "target_lang_translations": {
                                "ru": "Добавьте в соус <w>щепотку</w> чеснока, чтобы подчеркнуть общий вкус."
                            }
                        }
                    ],
                    "antonyms": [
                        "abundance",
                        "excess"
                    ],
                    "common_phrases": [
                        "suspicion of a smile",
                        "suspicion of butter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used with 'of'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень небольшое количество, след или легкий намек на что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "налет",
                                "target_lang_sense_clarification": "едва заметный признак"
                            },
                            {
                                "target_lang_word": "тень",
                                "target_lang_sense_clarification": "малейшее проявление"
                            },
                            {
                                "target_lang_word": "щепотка",
                                "target_lang_sense_clarification": "малое количество (о специях)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c497437-0885-3d90-bb13-66af8fbbfc9c",
                    "sense_definition": "To have a feeling of doubt or mistrust toward someone; to <w>suspect</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man began <w>suspicioning</w> that his business partner was stealing from the till.",
                            "target_lang_translations": {
                                "ru": "Старик начал <w>подозревать</w>, что его деловой партнер ворует из кассы."
                            }
                        },
                        {
                            "text": "I've been <w>suspicioning</w> for a while that they were the ones who leaked the secret.",
                            "target_lang_translations": {
                                "ru": "Я уже некоторое время <w>подозреваю</w>, что именно они выдали секрет."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily used in specific regional dialects"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать чувство сомнения или недоверия к кому-либо; подозревать (диалектное или разговорное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подозревать",
                                "target_lang_sense_clarification": "иметь сомнения в ком-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}