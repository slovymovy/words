                            {
                                "example_id": "5309ae89-a592-4d0d-bc9b-0c7a96fb1118",
                                "sense_id": "671e4f14-5092-3392-9ee0-da6839c75e0f",
                                "text": "For none of these I write, and none of these\nCould read the writing if they deigned to try;\nSo may they flourish in their due degrees,\nOn our sweet earth and in their unplaced sky."
                            },
                            {
                                "example_id": "aa9c7d8b-006a-46bd-a86e-79b52b3cbfd0",
                                "sense_id": "671e4f14-5092-3392-9ee0-da6839c75e0f",
                                "text": "Until more detailed phylogenetic work is done to elucidate their true relationships, it seems best to leave all these species unplaced."
                            }
                        ]
                    },
