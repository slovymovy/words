    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1db60cb0-1321-3f9b-bc1c-ca4beaa1c867",
                    "sense_definition": "In a pensive, serious, or reflective manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reflective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She paused for a long moment and stared <w>thoughtfully</w> out the window before answering.",
                            "target_lang_translations": {
                                "ru": "Она надолго замолчала и, прежде чем ответить, <w>задумчиво</w> посмотрела в окно."
                            }
                        },
                        {
                            "text": "The detective listened to our story, nodding <w>thoughtfully</w> as he took notes.",
                            "target_lang_translations": {
                                "ru": "Детектив слушал наш рассказ, <w>задумчиво</w> кивая и делая пометки."
                            }
                        }
                    ],
                    "synonyms": [
                        "pensively",
                        "reflectively",
                        "contemplatively"
                    ],
                    "antonyms": [
                        "thoughtlessly"
                    ],
                    "common_phrases": [
                        "nod thoughtfully",
                        "stare thoughtfully",
                        "gaze thoughtfully"
                    ],
                    "target_lang_definitions": {
                        "ru": "Задумчиво, с глубоким размышлением или погружением в свои мысли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задумчиво",
                                "target_lang_sense_clarification": "погрузившись в мысли"
                            },
                            {
                                "target_lang_word": "глубокомысленно",
                                "target_lang_sense_clarification": "с серьезным, глубоким видом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6e6744c4-4210-3cef-88a8-1276c396888e",
                    "sense_definition": "In a way that shows consideration, care, or kindness for other people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "considerate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Knowing that we were tired, he had <w>thoughtfully</w> prepared dinner for us.",
                            "target_lang_translations": {
                                "ru": "Зная, что мы устали, он <w>заботливо</w> приготовил для нас ужин."
                            }
                        },
                        {
                            "text": "The hotel staff <w>thoughtfully</w> provided umbrellas when the rain started.",
                            "target_lang_translations": {
                                "ru": "Персонал отеля <w>предусмотрительно</w> раздал зонтики, когда начался дождь."
                            }
                        }
                    ],
                    "synonyms": [
                        "considerately",
                        "attentively",
                        "kindly"
                    ],
                    "antonyms": [
                        "inconsiderately",
                        "thoughtlessly"
                    ],
                    "common_phrases": [
                        "thoughtfully provided"
                    ],
                    "target_lang_definitions": {
                        "ru": "С заботой, вниманием и чуткостью по отношению к другим людям."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заботливо",
                                "target_lang_sense_clarification": "проявляя заботу и предупредительность"
                            },
                            {
                                "target_lang_word": "внимательно",
                                "target_lang_sense_clarification": "с вниманием к потребностям других"
                            },
                            {
                                "target_lang_word": "предусмотрительно",
                                "target_lang_sense_clarification": "заранее подумав о комфорте или удобстве"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}