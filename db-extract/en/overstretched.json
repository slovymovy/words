                        "examples": [
                            {
                                "example_id": "849a2378-b6cb-4bdd-b486-3303d65efebc",
                                "sense_id": "60a4b5d1-d558-354e-b9f9-b26f578b9b42",
                                "text": "Software developer Amey Consulting has used it to identify issues elsewhere on the network, such as at East Croydon where platforms 3 and 4 were identified as causes of delay due to staff being overstretched at peak hours."
                            },
                            {
                                "example_id": "df07410d-6a23-442e-b45c-e88cff33bc0f",
                                "sense_id": "60a4b5d1-d558-354e-b9f9-b26f578b9b42",
                                "text": "Critics of MCEDs also warn that a deluge of test results could put additional pressure on already overstretched health services. A Galleri pilot screening programme in Arizona for firefighters missed many instances of cancer, raising questions about accuracy."
                            }
                        ]
