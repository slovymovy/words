                            {
                                "example_id": "3e2360ba-b2d7-424f-960c-f668ff81d428",
                                "sense_id": "fe25d6a5-d91e-35d3-97f4-c4ed2784a986",
                                "text": "Le trajet sans charge commence quand le traîneau à karbau se met en route et s'achève quand il est arrivé à la touffe."
                            },
                            {
                                "example_id": "0cf0eaaf-db67-41d5-8245-710dcc6d330c",
                                "sense_id": "fe25d6a5-d91e-35d3-97f4-c4ed2784a986",
                                "text": "Pour la première fois je vis ici, dans le Koutei, des karbaux (bœufs) qui paissaient dans les champs ainsi que des troupeaux de porcs qui erraient partout."
                            },
                            {
                                "example_id": "bc9a744f-1e3f-4085-ab1f-c2fb7143dbad",
                                "sense_id": "fe25d6a5-d91e-35d3-97f4-c4ed2784a986",
                                "text": "Joshua avait écrit une lettre dans laquelle il parlait des karbaus. Les bisons du Vietnam. Il les trouvait superbes. Extraordinaires."
                            }
                        ]
                    }
