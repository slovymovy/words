                "senses": [
                    {
                        "sense_id": "ad0d6d4c-d0da-3188-99d7-13c3acaa8b23",
                        "entry_id": "e2baf046-f0f2-3dea-a069-0d214034cd75",
                        "glosses": [
                            "Donner un caractère rappelant les stoïciens à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c0aac6-ca73-4ed0-bc51-ba3c22317640",
                                "sense_id": "ad0d6d4c-d0da-3188-99d7-13c3acaa8b23",
                                "text": "Quelquefois Sénèque a contribué à stoïciser la pensée chrétienne jusqu’à la fausser."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4681b6c-8b77-3dd4-96b9-3656529125bc",
                        "entry_id": "e2baf046-f0f2-3dea-a069-0d214034cd75",
                        "glosses": [
                            "Raisonner à la manière des stoïciens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efe81769-03ff-4299-8cb5-f3ea14d15454",
                                "sense_id": "c4681b6c-8b77-3dd4-96b9-3656529125bc",
                                "text": "Le stoïcisme a consisté à « stoïciser », c’est-à-dire à exprimer en langage stoïcien - en termes de destin et d’ordre rationnel cosmique - et donc à dogmatiser l’apport du passé."
                            }
                        ]
                    }
