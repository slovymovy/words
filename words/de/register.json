                    "semantic_group_id": "Druckwesen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bei einem hochwertigen Buchdruck müssen Vorderseite und Rückseite der bedruckten Seite genau <w>Register</w> halten."
                        },
                        {
                            "text": "Wenn der Druck nicht genau im <w>Register</w> liegt, wirken die Schriftzeilen auf dem Papier verschoben."
