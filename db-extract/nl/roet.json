                        "entry_id": "08a92ce4-6609-33ea-bb7e-f79b5f4f3763",
                        "glosses": [
                            "koolstofneerslag die ontstaat door onvolledige verbanding van koolstofhoudende stoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e461f3f4-b3c4-4f4d-8a87-f71026694c99",
                                "sense_id": "d29e64d7-22e1-31ee-80a5-b71ae58d0b97",
                                "text": "Een schoorsteenveger haalt roet uit de schoorsteen."
                            },
                            {
                                "example_id": "7110cd9c-b694-43b2-9ee9-b236898bc6f6",
                                "sense_id": "d29e64d7-22e1-31ee-80a5-b71ae58d0b97",
                                "text": "Zwart was hij door het roet van de hel. En natuurlijk moest hij zich door de schoorsteen ( de oudste offerplaats èn de verbinding van de geestenwereld met die der mensen ) laten zakken, om de cadeautjes bij de kinderschoenen te leggen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
