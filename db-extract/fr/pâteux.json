                        "entry_id": "fbfca513-2f0d-3c71-8b1f-39f59e61b94b",
                        "glosses": [
                            "Qualifie un style mou, lourd, filandreux."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
