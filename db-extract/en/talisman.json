                                    {
                                        "sense_id": "1301e3b7-c5ec-3c4d-8fe0-8018245ce349",
                                        "entry_id": "2db35b15-1a71-355d-9369-6c1d326482ee",
                                        "glosses": [
                                            "menší předmět, jenž má magicky ochraňovat svého nositele nebo mu jinak pomáhat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc4c4786-8739-4649-b2a8-707855ea515c",
                                                "sense_id": "1301e3b7-c5ec-3c4d-8fe0-8018245ce349",
                                                "text": "Mince s vyobrazením sv. Jiří na koni v boji s drakem (mansfeldský jiřský tolar) byly všeobecně oblíbeným amuletem vojáků, ochraňovaly před zraněním."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea95967e-f38a-4ebb-b337-0c49ad208d71",
                        "source_entry_id": "e265bbb4-ae1a-3af6-9b70-437761499586",
                        "source_sense_id": "4965e960-2e64-3993-a5e7-958c64701a08",
                        "source_sense_description": "magical protective charms",
                        "target_lang_word": "talisman",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talisman",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "98919db3-47e2-326b-a455-716f1ec4a316",
                                        "entry_id": "46f10f84-e6be-3138-9175-ed688a3d35ac",
                                        "glosses": [
                                            "voorwerp dat volgens bijgeloof op magische wijze tot gunstige resultaten kan leiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b63d2b4-fcd3-488d-8a26-e586a28a0986",
                                                "sense_id": "98919db3-47e2-326b-a455-716f1ec4a316",
                                                "text": "Een amulet is meer een beschermer tegen ongeluk terwijl een talisman vooral een brenger van geluk is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78872b72-ff32-4210-be32-83cd299ddfa7",
                        "source_entry_id": "e265bbb4-ae1a-3af6-9b70-437761499586",
                        "source_sense_id": "4965e960-2e64-3993-a5e7-958c64701a08",
                        "source_sense_description": "magical protective charms",
                        "target_lang_word": "talisman",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "talisman",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3bc27d2-a812-32ef-b27d-580f328212cb",
                                        "entry_id": "0aef0b83-9a59-3a91-980e-4a12e385934c",
                                        "glosses": [
                                            "Objet sur lequel sont gravés des figures, des signes, des caractères, auxquels on attribue des vertus magiques ou préservatrices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b3fb83e-0e96-4554-b960-2f8799c4db16",
                                                "sense_id": "e3bc27d2-a812-32ef-b27d-580f328212cb",
                                                "text": "Le talisman, le remède tout-puissant."
                                            },
                                            {
                                                "example_id": "e56aa04f-09a6-4daf-8e0d-085c9b5e86d9",
                                                "sense_id": "e3bc27d2-a812-32ef-b27d-580f328212cb",
                                                "text": "Elle allait courageusement seule à travers cette solitude, comme si son âge était un talisman qui dût la préserver de tout malheur."
                                            },
                                            {
                                                "example_id": "94c8e394-aab5-466f-9e56-d012f82e7ca4",
                                                "sense_id": "e3bc27d2-a812-32ef-b27d-580f328212cb",
                                                "text": "Pierre l’Ermite l’avait donné à Godefroy de Bouillon comme un talisman sacré auquel étaient attachées des propriétés miraculeuses."
                                            },
                                            {
                                                "example_id": "a6ee0166-a4b1-4705-a4fc-05b549f4da6a",
                                                "sense_id": "e3bc27d2-a812-32ef-b27d-580f328212cb",
                                                "text": "J’accepte, madame, dit le chasseur avec émotion en plaçant la croix sur sa poitrine auprès de son scapulaire, j’aurai un talisman à joindre à celui que m’a donné ma mère."
                                            },
                                            {
                                                "example_id": "2f1704b2-f62b-495c-bd8a-67446254ea88",
                                                "sense_id": "e3bc27d2-a812-32ef-b27d-580f328212cb",
                                                "text": "Lise, qui n’avait point acquis la précoce expérience de Mattia, et qui, heureusement pour elle, n’avait point été à l’école des élèves de Garofoli, était toute disposée à admettre que ceux qui étaient riches n’avaient qu’à être heureux en ce monde, et que la fortune était un talisman qui, comme dans les contes de fées, donnait instantanément tout ce qu’on pouvait désirer."
                                            },
                                            {
                                                "example_id": "04ed589c-0865-41a7-8279-ce00e4f22ea1",
                                                "sense_id": "e3bc27d2-a812-32ef-b27d-580f328212cb",
                                                "text": "C’était un plastron en flanelle rouge, l’un de ces talismans quasi hygiéniques qui, avec les pilules et les spécialités pharmaceutiques, remplacent, chez les peuples protestants de la chrétienté, les images et les reliques miraculeuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b11d247-0847-35b8-aef8-72e176bf963b",
                                        "entry_id": "0aef0b83-9a59-3a91-980e-4a12e385934c",
                                        "glosses": [
                                            "Objet sacré protecteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7cd8671-c8e0-49fd-82a3-444311f1a454",
                                                "sense_id": "2b11d247-0847-35b8-aef8-72e176bf963b",
                                                "text": "Puis, montrant la relique : − Voici de plus un talisman qui préserve des coups d'épée mieux que ne ferait une cotte de mailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0f436ee-30d3-3b14-93b0-8365ab7ab473",
                                        "entry_id": "0aef0b83-9a59-3a91-980e-4a12e385934c",
                                        "glosses": [
                                            "Synonyme de phalène anguleuse."
                                        ],
                                        "tags": [
                                            "Lépidoptérologie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9eb36f07-8e70-3e99-80f9-0fbeac707e57",
                                        "entry_id": "0aef0b83-9a59-3a91-980e-4a12e385934c",
                                        "glosses": [
                                            "Pièce maîtresse d’un objet qu’elle complète et achève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39d85659-8078-4c9c-a867-e227679eafaf",
                                                "sense_id": "9eb36f07-8e70-3e99-80f9-0fbeac707e57",
                                                "text": "Bien avant d’acquérir une connotation merveilleuse, le mot « talisman » signifiait « achèvement ». Dérivé du grec telesma, « complet »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "653c8d7f-75ba-45ee-aa2f-802e2abde401",
                        "source_entry_id": "e265bbb4-ae1a-3af6-9b70-437761499586",
                        "source_sense_id": "4965e960-2e64-3993-a5e7-958c64701a08",
                        "source_sense_description": "magical protective charms",
                        "target_lang_word": "Talisman",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Talisman",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ecd22062-73d2-344d-a4f9-84e333df0ac1",
                                        "entry_id": "5a3670fc-a1b5-3302-bcb7-d0cc0dc940f7",
                                        "glosses": [
                                            "Gegenstand, der Unheil abwenden beziehungsweise Glück bringen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7894759-be63-4bf3-bcc9-8c6eaae3fbb2",
                                                "sense_id": "ecd22062-73d2-344d-a4f9-84e333df0ac1",
                                                "text": "Talisman in Karneol, / Gläubgen bringt er Glück und Wohl; / Steht er gar auf Onyx' Grunde, / Küß ihn, mit geweihtem Munde! / Alles Übel treibt er fort, / Schützet dich und schützt den Ort: / Wenn das eingegrabne Wort / Allahs Namen rein verkündet, / Dich zu Lieb und Tat entzündet. / Und besonders werden Frauen / Sich am Talisman erbauen. / Amulette sind dergleichen / Auf Papier geschriebne Zeichen."
                                            },
                                            {
                                                "example_id": "2644d222-2a79-4509-901a-06043870468e",
                                                "sense_id": "ecd22062-73d2-344d-a4f9-84e333df0ac1",
                                                "text": "Er ist ein Talisman, der vor allen Gefahren schützt und sicher in das Reich des Zauberkönigs geleitet."
                                            },
                                            {
                                                "example_id": "46348af5-d79c-4402-8f58-fa30d3470aa5",
                                                "sense_id": "ecd22062-73d2-344d-a4f9-84e333df0ac1",
                                                "text": "Es war eine kleine Bernsteinpuppe mit menschenähnlichem Kopf, etwa zwei Zoll lang und der untere Teil in einen Fischschwanz auslaufend. Dieses Püppchen, das Leute, die zu Anfang dieses Jahrhunderts lebten, noch gesehen haben wollen, führte den Namen »Allerhühnchen« (Alräunchen) und galt als Talisman der Familie."
                                            },
                                            {
                                                "example_id": "3dfb0736-820a-45d4-92cf-783dad3c7472",
                                                "sense_id": "ecd22062-73d2-344d-a4f9-84e333df0ac1",
                                                "text": "„Es war zu dieser Zeit, dass er den Granatsplitter, den er wie einen Talisman in seinem Schrank im Internatszimmer aufbewahrte, nicht mehr in die Hand nahm.“"
                                            },
                                            {
                                                "example_id": "88b9e85c-b148-4e96-b292-ceb2ebbe6f71",
                                                "sense_id": "ecd22062-73d2-344d-a4f9-84e333df0ac1",
                                                "text": "„Die Falter spielten also die Rolle des Talismans.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
