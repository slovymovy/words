                        "translation_id": "0fe43609-51b0-434e-91cd-12c01b488844",
                        "source_entry_id": "167d1c48-b481-3ffd-a259-750a4b773c15",
                        "source_sense_id": "5e5209ee-5941-383e-ae9f-5da98ff461c9",
                        "source_sense_description": "To surpass something",
