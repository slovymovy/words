                    {
                        "translation_id": "2918f263-1b33-413d-a261-38b86d09c8cc",
                        "source_entry_id": "f8d4ff9c-8bec-36f2-ab1c-db99d32b39dc",
                        "source_sense_id": "2d86887a-3715-3332-8aa4-4bb32ebae429",
                        "source_sense_description": "de derde van de acht naamvallen van de Indo-Europese talen",
                        "target_lang_word": "дательный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "дательный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0c4576eb-998a-37d7-b32c-5252e60aec9f",
                                        "entry_id": "1fd84fad-e5da-392b-a0df-f306a685c034",
                                        "glosses": [
                                            "лингв. субстантивир. в ряде языков — относящийся к падежу, обозначающему действие, направленное к предмету"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7fff931-c7ea-4c75-93f8-2f8c23c46113",
                                                "sense_id": "0c4576eb-998a-37d7-b32c-5252e60aec9f",
                                                "text": "В дательном падеже существительные отвечают на вопросы «кому?», «чему?»."
                                            },
                                            {
                                                "example_id": "76cbd758-bd56-4927-9a9a-a33bf5e89ad5",
                                                "sense_id": "0c4576eb-998a-37d7-b32c-5252e60aec9f",
                                                "text": "В действительности подразумевалось, что слово «Нелли» стоит не в родительном, а в дательном падеже: стихи к Нелли, посвящённые Нелли."
                                            },
                                            {
                                                "example_id": "d68896dd-c834-4cda-8932-4acf5ec32a10",
                                                "sense_id": "0c4576eb-998a-37d7-b32c-5252e60aec9f",
                                                "text": "Определяя падеж существительных в словосочетаниях Ивану весело, сказать Ивану, пошёл к Ивану совершенно верно как дательный, мы упускаем из вида, что в первом примере так обозначен субъект состояния, во втором — адресат действия, а в третьем — направление движения."
                                            },
                                            {
                                                "example_id": "031ba4ee-983a-40bd-b154-042fbf4c0eda",
                                                "sense_id": "0c4576eb-998a-37d7-b32c-5252e60aec9f",
                                                "text": "Вместо винительнаго падежа часто пишут и говорят дательное, яко дай мне квасу вместо кваса."
                                            },
                                            {
                                                "example_id": "8bec4e80-a607-43a9-a65e-6e3bef8ac380",
                                                "sense_id": "0c4576eb-998a-37d7-b32c-5252e60aec9f",
                                                "text": "Девяносто из ста опрошенных школьниц уверены, что за дательным падежом сразу идёт родительный."
                                            },
                                            {
                                                "example_id": "da34f76b-3f40-4322-8d81-4d83e49cb360",
                                                "sense_id": "0c4576eb-998a-37d7-b32c-5252e60aec9f",
                                                "text": "Я — предложный, она — дательный, я — творительный, она — родительный, в чём же я винительный?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eb81a1b-f3b7-30ca-9a82-8a9144bd1b9d",
                                        "entry_id": "1fd84fad-e5da-392b-a0df-f306a685c034",
                                        "glosses": [
                                            "субстантивир. то же, что дательный падеж"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
