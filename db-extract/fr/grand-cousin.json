                                        "sense_id": "e1cc129f-0c25-3787-bc43-c175c71ce6ec",
                                        "entry_id": "2fa49d0f-a045-30d5-98c7-4858d47375a5",
                                        "glosses": [
                                            "Male first cousin of one's parent; one's male first cousin once removed in a higher generation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a957fc4-8480-4782-8a16-1d4250b07fc6",
                                                "sense_id": "e1cc129f-0c25-3787-bc43-c175c71ce6ec",
                                                "text": "Walter is my dad's first cousin. That makes Walter my cousin-uncle. Jack is my mother's first cousin, so for me he is another cousin-uncle."
                                            },
                                            {
                                                "example_id": "ab8fb16f-49cc-4ba2-b3d6-afbdb377cd6e",
                                                "sense_id": "e1cc129f-0c25-3787-bc43-c175c71ce6ec",
                                                "text": "For quotations using this term, see Citations:cousin-uncle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9f42b77-a581-4f4d-93e8-a7bca400ddb2",
                        "source_entry_id": "fba19c72-dac1-3510-8d86-4d9c16895e04",
                        "source_sense_id": "ace87150-0b21-3cb7-aa9a-33a334c08b74",
