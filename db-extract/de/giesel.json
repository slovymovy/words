                ],
                "senses": [
                    {
                        "sense_id": "216b31e8-d3c6-3260-94bf-f88198590136",
                        "entry_id": "0662bb7a-02a6-3320-ab79-05fba6b0a28c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bb290de-4b98-4236-8c48-757f4abf6a5e",
                                "sense_id": "216b31e8-d3c6-3260-94bf-f88198590136",
                                "text": "Frau Giesel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a66595ba-4e3d-4310-b01e-225651c38caa",
                                "sense_id": "216b31e8-d3c6-3260-94bf-f88198590136",
                                "text": "Herr Giesel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "53c45bed-931e-4225-b81d-773282c43e5a",
                                "sense_id": "216b31e8-d3c6-3260-94bf-f88198590136",
                                "text": "Die Giesels fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "142fcabe-fea2-4666-8ba2-a6cb03b84ec6",
                                "sense_id": "216b31e8-d3c6-3260-94bf-f88198590136",
                                "text": "Der Giesel trägt nie die Pullover, die die Giesel ihm strickt."
                            },
                            {
                                "example_id": "40dff7c9-47f9-49a6-b1e7-4ab907c0a08a",
                                "sense_id": "216b31e8-d3c6-3260-94bf-f88198590136",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Giesel kommt, geht der Herr Giesel.“"
                            },
                            {
                                "example_id": "0b237d71-5922-4605-81c6-8c18580ef617",
                                "sense_id": "216b31e8-d3c6-3260-94bf-f88198590136",
                                "text": "Giesel kommt und geht."
                            },
                            {
                                "example_id": "a392b83e-7bb8-4422-9359-ac271cfc6f23",
                                "sense_id": "216b31e8-d3c6-3260-94bf-f88198590136",
                                "text": "Giesels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
