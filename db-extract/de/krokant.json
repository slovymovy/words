                                        "sense_id": "fae0fa20-559f-3c21-adf6-d5092be8eadc",
                                        "entry_id": "d0dc2f02-c673-3cd2-88a5-76045288e16d",
                                        "glosses": [
                                            "Inflexible; liable to break, snap, or shatter easily under stress, pressure, or impact; crackly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "868220d4-4d71-4920-b880-31c962f59f58",
                                                "sense_id": "fae0fa20-559f-3c21-adf6-d5092be8eadc",
                                                "text": "Cast iron is much more brittle than forged iron."
                                            },
                                            {
                                                "example_id": "f39473cb-294a-4a50-b299-788d39d16c4d",
                                                "sense_id": "fae0fa20-559f-3c21-adf6-d5092be8eadc",
                                                "text": "A diamond is hard but brittle."
                                            },
                                            {
                                                "example_id": "21c15547-dab6-43f1-bfa5-6340e028779b",
                                                "sense_id": "fae0fa20-559f-3c21-adf6-d5092be8eadc",
                                                "text": "'Do you suppose our convent, and I too,\n Are insufficient, then, to pray for you?\n Thomas, that joke's not good. Your faith is brittle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c495bc2c-e052-380f-91c7-58a9ddee2c57",
                                        "entry_id": "d0dc2f02-c673-3cd2-88a5-76045288e16d",
                                        "glosses": [
                                            "Not physically tough or tenacious; apt to break or crumble when bending."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eba82590-b302-47d4-b8d9-c5c8fe02e5a8",
                                                "sense_id": "c495bc2c-e052-380f-91c7-58a9ddee2c57",
                                                "text": "Shortbread is my favorite cold pastry, yet being so brittle it crumbles easily, and a lot goes to waste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1511f93-ccc9-3946-ab04-69ff67b7759b",
                                        "entry_id": "d0dc2f02-c673-3cd2-88a5-76045288e16d",
                                        "glosses": [
                                            "Tending to fracture in a conchoidal way; capable of being knapped or flaked."
                                        ],
                                        "tags": [
                                            "of rocks"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "13ab8902-ff43-35a0-8380-6520dc2ee97f",
                                        "entry_id": "d0dc2f02-c673-3cd2-88a5-76045288e16d",
                                        "glosses": [
                                            "Emotionally fragile, easily offended."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2113365-0949-495b-94e2-4dc65ce4f9f2",
                                                "sense_id": "13ab8902-ff43-35a0-8380-6520dc2ee97f",
                                                "text": "What a brittle personality! A little misunderstanding and he's an emotional wreck."
                                            }
                                        ]
                                    },
