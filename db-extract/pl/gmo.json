                            {
                                "example_id": "88c56f4d-ded1-49a2-819d-a7b28b96c568",
                                "sense_id": "d9a5dda8-dca6-3104-add1-8813f607f810",
                                "text": "Farmerzy z Kanady czy USA, którzy do tej pory zmodyfikowane i zwykłe nasiona rzepaku zsypywali do jednego elewatora, teraz stanęli przed wyborem: albo zaczną nasiona segregować, co znacznie zwiększy koszty, bez pewności utrzymania eksportu, albo też zrezygnują z uprawy GMO"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
