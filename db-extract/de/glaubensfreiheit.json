                "senses": [
                    {
                        "sense_id": "fe3901ad-d677-3776-97ef-9a2e80951a06",
                        "entry_id": "a1c827df-7e33-336a-96db-71f46a2aaa57",
                        "glosses": [
                            "Grundrecht eines jeden Menschen, seine Religion frei zu wählen und diese auszuüben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da314842-1aa5-441c-9ce3-386cdd091d84",
                                "sense_id": "fe3901ad-d677-3776-97ef-9a2e80951a06",
                                "text": "„Die in der Mitte des 19. Jahrhunderts entworfenen liberalen Verfassungen in einigen schweizerischen Kantonen gewährleisteten die Glaubensfreiheit, aber auch die Rechte der evangelisch-reformierten Landeskirche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7876e309-98ee-4e99-85cf-b1b8b590a8a6",
                        "source_entry_id": "a1c827df-7e33-336a-96db-71f46a2aaa57",
                        "source_sense_id": "fe3901ad-d677-3776-97ef-9a2e80951a06",
                        "source_sense_description": "Grundrecht eines jeden Menschen, seine Religion frei zu wählen und diese auszuüben",
                        "target_lang_word": "freedom of religion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "freedom of religion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56cf62db-698b-3fe1-922f-bc03541e090f",
                                        "entry_id": "c34fa9b4-c353-30d6-ba44-20c42d16504a",
                                        "glosses": [
                                            "The right of people to hold any religious beliefs, or none, and to carry out any practices in accordance with those beliefs or with that absence of belief, so long as these practices do not interfere with other people's legal or civil rights, or any reasonable laws, without fear of harm or prosecution."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d522e719-6478-467a-b8f5-3c93d64e9ca4",
                        "source_entry_id": "a1c827df-7e33-336a-96db-71f46a2aaa57",
                        "source_sense_id": "fe3901ad-d677-3776-97ef-9a2e80951a06",
                        "source_sense_description": "Grundrecht eines jeden Menschen, seine Religion frei zu wählen und diese auszuüben",
                        "target_lang_word": "liberté de religion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "liberté de religion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6100d3b-619d-38e5-9b2a-73f61ff389d8",
                                        "entry_id": "fb1554d8-d412-354e-8a65-fd247639fcd9",
                                        "glosses": [
                                            "Droit pour une personne de choisir, de pratiquer une religion donnée ou aucune, et d’en changer, cet aspect essentiel de la liberté de conscience a été reconnu en France dès 1789 dans l’article 10 de la Déclaration des droits de l’homme et du citoyen : « Nul ne doit être inquiété pour ses opinions, même religieuses, pourvu que leur manifestation ne trouble pas l'ordre public établi par la loi »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "292e601e-e160-4342-9f25-2e9c0f4c6278",
                                                "sense_id": "f6100d3b-619d-38e5-9b2a-73f61ff389d8",
                                                "text": "La Convention internationale sur les droits de l'enfant, dite aussi « Convention de New York », adoptée par l'Organisation des Nations unies en 1989, reconnait aux enfants la liberté de religion ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
