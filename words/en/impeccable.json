{
    "word_family": [
        "impeccability",
        "impeccably"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6c927758-bb75-36b7-b56f-8536882f2747",
                    "sense_definition": "Perfect, without faults, flaws or errors",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "perfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student delivered an <w>impeccable</w> presentation that impressed all the professors.",
                            "target_lang_translations": {
                                "cs": "Student přednesl <w>bezchybnou</w> prezentaci, která udělala dojem na všechny profesory.",
                                "ru": "Студент выступил с <w>безупречной</w> презентацией, впечатлившей всех профессоров."
                            }
                        },
                        {
                            "text": "She is known for her <w>impeccable</w> taste in fashion and interior design.",
                            "target_lang_translations": {
                                "cs": "Je známá svým <w>dokonalým</w> vkusem v módě i interiérovém designu.",
                                "ru": "Она известна своим <w>безукоризненным</w> вкусом в моде и дизайне интерьеров."
                            }
                        }
                    ],
                    "synonyms": [
                        "flawless"
                    ],
                    "common_phrases": [
                        "impeccable taste",
                        "impeccable timing"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dokonalý, bezchybný, zcela bez vad či chyb",
                        "ru": "Идеальный, не имеющий изъянов, недостатков или ошибок"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bezchybný",
                                "target_lang_sense_clarification": "zcela bez vad či chyb"
                            },
                            {
                                "target_lang_word": "dokonalý",
                                "target_lang_sense_clarification": "perfektní v provedení či stylu"
                            },
                            {
                                "target_lang_word": "nepřekonatelný",
                                "target_lang_sense_clarification": "vynikající kvality"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "безупречный",
                                "target_lang_sense_clarification": "идеальный, не имеющий недостатков"
                            },
                            {
                                "target_lang_word": "безукоризненный",
                                "target_lang_sense_clarification": "не вызывающий нареканий, образцовый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "807ff103-546b-33ab-87ce-4fb2e1b77a55",
                    "sense_definition": "Incapable of wrongdoing or sin; immaculate",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "perfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The saint was considered to have an <w>impeccable</w> character throughout her entire life.",
                            "target_lang_translations": {
                                "cs": "Tato světice byla po celý svůj život považována za osobu s <w>bezúhonným</w> charakterem.",
                                "ru": "Считалось, что на протяжении всей своей жизни святая обладала поистине <w>непогрешимым</w> характером."
                            }
                        },
                        {
                            "text": "No human being is truly <w>impeccable</w> in their moral conduct.",
                            "target_lang_translations": {
                                "cs": "Žádný člověk není ve svém morálním jednání skutečně <w>bezúhonný</w>.",
                                "ru": "Ни один человек не является по-настоящему <w>безгрешным</w> в своем моральном поведении."
                            }
                        }
                    ],
                    "antonyms": [
                        "sinful",
                        "corrupt"
                    ],
                    "target_lang_definitions": {
                        "cs": "Neschopný hříchu nebo špatného jednání; mravně čistý a bezúhonný",
                        "ru": "Неспособный на дурные поступки или грех; морально чистый и непогрешимый"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bezúhonný",
                                "target_lang_sense_clarification": "mravně čistý, bez prohřešků"
                            },
                            {
                                "target_lang_word": "nehříšný",
                                "target_lang_sense_clarification": "neschopný hříchu"
                            },
                            {
                                "target_lang_word": "neposkvrněný",
                                "target_lang_sense_clarification": "morálně čistý, neposkvrněný vinou"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "непогрешимый",
                                "target_lang_sense_clarification": "не совершающий ошибок или грехов"
                            },
                            {
                                "target_lang_word": "безгрешный",
                                "target_lang_sense_clarification": "свободный от греха, чистый"
                            },
                            {
                                "target_lang_word": "безукоризненный",
                                "target_lang_sense_clarification": "безупречный с моральной точки зрения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}