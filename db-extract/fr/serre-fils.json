                "translations": [
                    {
                        "translation_id": "1c01f986-7f66-4457-879d-b3ef04e48d32",
                        "source_entry_id": "8d538151-4cc1-3dc8-b896-8e2c5de407c3",
                        "source_sense_id": "b61e1c77-26ff-3b9a-8a9c-1a250dab4039",
                        "target_lang_word": "Lüsterklemme",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lüsterklemme",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b935562-a861-3dfe-8d36-f1bb44f2063b",
                                        "entry_id": "f1fcceaf-02e5-3de2-a6f2-ec2e0300764e",
                                        "glosses": [
                                            "Bauteil zum Verbinden elektrischer Kabel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "374cc99a-12d9-473b-8a4f-a8671d991137",
                                                "sense_id": "8b935562-a861-3dfe-8d36-f1bb44f2063b",
                                                "text": "Tom brauchte eine Lüsterklemme, um seine Deckenlampe anzubringen."
                                            },
                                            {
                                                "example_id": "2163dab8-9d7e-4b2e-9a16-51e75dc8750f",
                                                "sense_id": "8b935562-a861-3dfe-8d36-f1bb44f2063b",
                                                "text": "„Er lacht und tippt mit dem Finger auf die kupferne Oberfläche meines Haarschmucks, der vor uns in der Lüsterklemme baumelt.“"
                                            },
                                            {
                                                "example_id": "5b75215e-566c-40f7-b962-344755a432c2",
                                                "sense_id": "8b935562-a861-3dfe-8d36-f1bb44f2063b",
                                                "text": "„Bei einem der getesteten Baumärkte empfahlen Verkäufer etwa, Starkstromleitungen mit Lüsterklemmen und Kabeln zu verlängern – was Laien aber niemals tun sollten.“"
                                            },
                                            {
                                                "example_id": "12cd29b2-efb8-4cca-bbcc-a81086593b4f",
                                                "sense_id": "8b935562-a861-3dfe-8d36-f1bb44f2063b",
                                                "text": "„Vor sich hat der 30-jährige Elektronikermeister und Ausbilder Zangen, Drähte, Schraubenzieher und Lüsterklemmen liegen.“"
                                            },
                                            {
                                                "example_id": "3916064f-43a8-4264-87ca-d23dee7323e7",
                                                "sense_id": "8b935562-a861-3dfe-8d36-f1bb44f2063b",
                                                "text": "„Neu dabei ist diesmal das Mint-Technikum, bei dem ‚Krabbelkäfer‘ aus Draht, Lüsterklemmen, einem kleinen Motor und Batterien gefertigt werden können.“"
                                            },
                                            {
                                                "example_id": "aee503d5-7934-486c-99c1-42a722c8fc90",
                                                "sense_id": "8b935562-a861-3dfe-8d36-f1bb44f2063b",
                                                "text": "„Wenn man etwas handwerklich begabt ist, so sollte ‚Improvisationsmaterial‘ wie Lüsterklemmen, Isolierband, Kaltmetallkleber, Blumendraht und Kabelbinder nicht fehlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
