                    {
                        "form_id": "b7b3e190-aa82-41cb-9b4a-c20a3f79ee56",
                        "entry_id": "77759a8e-c4c9-39e3-a191-b3013209df08",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Volksverhetzungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df874f2b-1b7c-3b64-ba5f-5c4901a3135b",
                        "entry_id": "77759a8e-c4c9-39e3-a191-b3013209df08",
                        "glosses": [
                            "die Bevölkerung/Teile der Bevölkerung mittels sprachlicher Mittel (Hetze, Verhetzung) aufstacheln, sich gegen eine Gruppe von Menschen zu wenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5bdfef4-8720-4322-a1f4-ca2b08219f1c",
                                "sense_id": "df874f2b-1b7c-3b64-ba5f-5c4901a3135b",
                                "text": "„Auch zahlreiche Strafanzeigen wegen Volksverhetzung gemäß § 130 Strafgesetzbuch blieben ohne Konsequenzen – die zuständige Staatsanwaltschaft Berlin hat das eingeleitete Ermittlungsverfahren eingestellt.“"
                            },
                            {
                                "example_id": "154e03b9-eab4-482d-97cd-ef3a44413e71",
                                "sense_id": "df874f2b-1b7c-3b64-ba5f-5c4901a3135b",
                                "text": "„Zur damaligen Zeit begann es ebenfalls mit haltlosen Volksverhetzungen, geboren aus unerfüllten Begehren der Menschen. Aus Arbeitslosigkeit, Armut und mangelndem Selbstvertrauen.“"
                            },
                            {
                                "example_id": "a301f515-4c40-423c-93fb-a1dcefd3804a",
                                "sense_id": "df874f2b-1b7c-3b64-ba5f-5c4901a3135b",
                                "text": "„Bei der Reaktion auf solche Beleidigungen und Volksverhetzungen und andere extreme Inhalte ist es geradezu zum Volkssport geworden, den Arbeitgeber des jeweiligen Großmauls zu unterrichten.“"
                            },
                            {
                                "example_id": "64ef2e06-8a08-4521-a9b3-e25866b5c0d9",
                                "sense_id": "df874f2b-1b7c-3b64-ba5f-5c4901a3135b",
                                "text": "„Dass die Richter, die auf fortgesetzte Volksverhetzung erkannten, bis an die Grenze dessen gingen, was ihnen auszuteilen erlaubt ist, fand allgemeinen Beifall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
