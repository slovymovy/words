                "senses": [
                    {
                        "sense_id": "cb58d1b5-99be-34af-b5ab-c10ef3c434b8",
                        "entry_id": "8030d14b-2872-34f8-835a-2f88cee4fc9f",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efb68fca-59a5-4179-98be-4f5849aac3a0",
                                "sense_id": "cb58d1b5-99be-34af-b5ab-c10ef3c434b8",
                                "text": "Puis on passe à la peinture du camo, que j'ai essayé de \"zénithaliser\", même si ça ne se voit pas trop sur les photos."
                            },
                            {
                                "example_id": "3aac2e89-7ae3-45f1-ad43-a39ff0ccdb3f",
                                "sense_id": "cb58d1b5-99be-34af-b5ab-c10ef3c434b8",
                                "text": "Allez, pour faire l'embêteur, un peu de lining çà et là pour zénithaliser le bouzin."
                            },
                            {
                                "example_id": "7be88577-1563-4fda-aba3-2d0163941f93",
                                "sense_id": "cb58d1b5-99be-34af-b5ab-c10ef3c434b8",
                                "text": "Pour la peau c'est clairement l'énorme plus de la figurine, parce qu'il s'agit d'une chose pour laquelle l'œil humain est très sensible(comme pour les traits du visage) là aussi il faut zénithaliser la chose pour la rendre réaliste et surtout trouver les bonnes teinte."
                            }
                        ]
                    }
