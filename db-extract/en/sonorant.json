                        "entry_id": "d22d6ebf-c219-3b67-81d3-d39c162fbb90",
                        "glosses": [
                            "A speech sound that is produced without turbulent airflow in the vocal tract; the generic term of vowel, approximant, nasal consonant, etc."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c4e88c6-b326-401f-aa28-b0111a2813be",
                        "source_entry_id": "d22d6ebf-c219-3b67-81d3-d39c162fbb90",
                        "source_sense_id": "d8e01b40-658b-3279-bf77-d598712d4b36",
                        "source_sense_description": "speech sound",
                        "target_lang_word": "Sonorant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sonorant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7fab191-9ab9-3551-b784-9fdb717161b7",
                                        "entry_id": "28daf04e-2cb5-320e-96f3-14b955b66b14",
                                        "glosses": [
                                            "stimmhafter Laut der Sprache, der den Silbengipfel bilden, also silbentragend/silbisch sein kann."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff879190-8764-42a4-ae91-ef541fc52afd",
                                                "sense_id": "d7fab191-9ab9-3551-b784-9fdb717161b7",
                                                "text": "In dem Plural \"die Sonoranten\" [zonoˈʀantn̩] ist [n̩] ein Sonorant."
                                            },
                                            {
                                                "example_id": "98267570-dc26-47a0-98fd-c394c452763b",
                                                "sense_id": "d7fab191-9ab9-3551-b784-9fdb717161b7",
                                                "text": "„Mit der Unterscheidung zwischen Obstruenten (…) und Sonoranten (…) werden die Laute, bei denen der Luftstrom ein Hemmnis überwinden muss, also die Frikative, Plosive und Affrikaten, von den Vokalen, Nasalen, Lateralen und Vibranten abgegrenzt, bei denen das nicht der Fall ist, weswegen die letzten drei auch Halbvokale genannt werden.“"
                                            },
                                            {
                                                "example_id": "2808ab9b-5e47-409b-82cc-b7ced5b45df4",
                                                "sense_id": "d7fab191-9ab9-3551-b784-9fdb717161b7",
                                                "text": "„Im Gegensatz dazu kann der Luftstrom bei den Sonoranten ungehindert ausströmen.“"
                                            },
                                            {
                                                "example_id": "5bebdf3e-9b17-4ea6-a6db-7cabe2bc3f80",
                                                "sense_id": "d7fab191-9ab9-3551-b784-9fdb717161b7",
                                                "text": "„Besonders die Sonoranten können auch Silbenkerne bilden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
