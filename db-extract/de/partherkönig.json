                "senses": [
                    {
                        "sense_id": "ef95d70c-7c27-3a2a-9bdf-1481036efc39",
                        "entry_id": "275282e1-94d3-353b-8be8-5244e8871b5d",
                        "glosses": [
                            "Oberhaupt des antiken iranischen Volkes der Parther"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c463794a-34a4-4f13-9134-aed71bb1f963",
                                "sense_id": "ef95d70c-7c27-3a2a-9bdf-1481036efc39",
                                "text": "„Nach der Unterwerfung der nördlichen Grenzvölker und dem Abkommen mit dem Partherkönig im Osten 20 v. Chr. schien der Friede des Reiches tatsächlich für immer gesichert.“"
                            },
                            {
                                "example_id": "074bba0e-241c-4fac-b09b-0e4f21dd1252",
                                "sense_id": "ef95d70c-7c27-3a2a-9bdf-1481036efc39",
                                "text": "„Er rüstete sein Land für einen neuen Krieg, schrieb gar an den Erzfeind der Römer, den Partherkönig Pacorus II.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
