                        "form": "die Idiotin"
                    },
                    {
                        "form_id": "51ff0f1a-a34c-4b7a-83ea-7f172b7c5002",
                        "entry_id": "37d55ed9-9d3d-3b4b-9d7d-cad7eeafd922",
                        "tags": [
                            "accusative",
