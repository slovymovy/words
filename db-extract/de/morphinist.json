                "senses": [
                    {
                        "sense_id": "b161dea7-dc28-3730-ad0a-a3d7f8f5b397",
                        "entry_id": "3be94dd2-f27c-3b0a-a7c0-795722e17966",
                        "glosses": [
                            "eine Person, die nach Morphium süchtig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "771a9ac1-a3ca-4479-a68f-af16a0c356d1",
                                "sense_id": "b161dea7-dc28-3730-ad0a-a3d7f8f5b397",
                                "text": "Unter Ärzten und deren Patienten gibt es nicht wenige langjährige Morphinisten."
                            },
                            {
                                "example_id": "ddbe3124-b60b-4027-9454-fcd1fdabe9aa",
                                "sense_id": "b161dea7-dc28-3730-ad0a-a3d7f8f5b397",
                                "text": "Als schließlich das Deutsche Reich 1929 das Internationale Opiumabkommen von 1912 unterschrieb, war schlagartig mit der Legalität Schluß, und die Morphinisten starben wie die Fliegen, falls es ihnen nicht gelang, sich illegal ihre tägliche Dosis zu besorgen."
                            },
                            {
                                "example_id": "aa2df947-57af-4975-85a1-9b15a92fee6e",
                                "sense_id": "b161dea7-dc28-3730-ad0a-a3d7f8f5b397",
                                "text": "„Er ist noch kein Morphinist, weit entfernt, er kommt manchmal fünf, sechs Tage ohne Morphium aus, aber wenn Schwierigkeiten auf seinem Lebenswege auftauchen, und diese Schwierigkeiten häufen sich jetzt während des Krieges immer mehr, so nimmt er Morphium.“"
                            },
                            {
                                "example_id": "99696cf1-5a0e-432b-9440-a48421712fd9",
                                "sense_id": "b161dea7-dc28-3730-ad0a-a3d7f8f5b397",
                                "text": "„Bei Morphinisten wurde Insulin gegen die Entziehungserscheinungen verwandt […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
