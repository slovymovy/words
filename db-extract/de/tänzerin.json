                        "form": "die Tänzerin"
                    },
                    {
                        "form_id": "d31cf223-b5da-4974-a71d-e6a09a98d78a",
                        "entry_id": "39c9e720-3f17-3194-9ec8-85649c0557e2",
                        "tags": [
                            "accusative",
