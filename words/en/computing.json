                {
                    "sense_id": "ce447a27-5d15-3184-aa72-9eabdc377e94",
                    "sense_definition": "The study of computers and computer programming.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "field",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to study <w>computing</w> at the university to become a programmer.",
                            "target_lang_translations": {
                                "ru": "Она решила изучать <w>информатику</w> в университете, чтобы стать программистом.",
                                "pl": "Zdecydowała się studiować <w>informatykę</w> na uniwersytecie, aby zostać programistką."
                            }
                        },
                        {
                            "text": "This course covers several major fields of <w>computing</w> and software design.",
                            "target_lang_translations": {
                                "ru": "Этот курс охватывает несколько основных областей <w>информатики</w> и разработки программного обеспечения.",
                                "pl": "Ten kurs obejmuje kilka głównych dziedzin <w>informatyki</w> oraz projektowania oprogramowania."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quantum computing",
                        "computing power",
                        "computing skills",
                        "scientific computing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наука о компьютерах и программировании.",
                        "pl": "Nauka zajmująca się komputerami i programowaniem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "информатика",
                                "target_lang_sense_clarification": "учебная дисциплина или наука"
