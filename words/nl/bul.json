{
    "word_family": [
        "bullendag"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "261232d8-2efb-366e-9fdc-0c97d19fa2d2",
                    "sense_definition": "Een mannelijk rund of een mannetje van bepaalde andere grote zoogdieren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dier_stier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De woedende <w>bul</w> rende achter de verzorger aan in de wei.",
                            "target_lang_translations": {
                                "en": "The enraged <w>bull</w> ran after the keeper in the pasture."
                            }
                        },
                        {
                            "text": "In de wei staat een hele grote <w>bul</w> tussen de koeien.",
                            "target_lang_translations": {
                                "en": "In the pasture stands a very large <w>bull</w> among the cows."
                            }
                        }
                    ],
                    "synonyms": [
                        "stier"
                    ],
                    "common_phrases": [
                        "een grote bul"
                    ],
                    "target_lang_definitions": {
                        "en": "A male bovine or male of certain other large mammals."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bull",
                                "target_lang_sense_clarification": "male animal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddc4205c-b5d1-38cc-b524-8d93ed55a528",
                    "sense_definition": "Een officieel diploma of oorkonde bij het behalen van een academische graad aan een universiteit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "document_oorkonde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na jaren van zwaar studeren mocht hij eindelijk zijn <w>bul</w> in ontvangst nemen.",
                            "target_lang_translations": {
                                "en": "After years of hard studying, he was finally able to receive his <w>diploma</w>."
                            }
                        },
                        {
                            "text": "Zij kregen gisteren formeel hun academische <w>bul</w> uitgereikt tijdens de ceremonie.",
                            "target_lang_translations": {
                                "en": "They were formally presented with their academic <w>degree certificate</w> during the ceremony yesterday."
                            }
                        }
                    ],
                    "common_phrases": [
                        "academische bul",
                        "zijn bul halen"
                    ],
                    "target_lang_definitions": {
                        "en": "An official diploma or certificate upon obtaining an academic degree at a university."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "degree certificate",
                                "target_lang_sense_clarification": "academic diploma"
                            },
                            {
                                "target_lang_word": "diploma",
                                "target_lang_sense_clarification": "academic certificate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c70f17f-d45f-3599-88a3-07c38de95bda",
                    "sense_definition": "Een gewichtig officieel bevelschrift of oorkonde uitgevaardigd door de paus.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "document_oorkonde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De paus vaardigde een belangrijke <w>bul</w> uit over de hervormingen binnen de kerk.",
                            "target_lang_translations": {
                                "en": "The pope issued an important <w>bull</w> regarding the reforms within the church."
                            }
                        },
                        {
                            "text": "In de pauselijke <w>bul</w> stonden strenge regels voor het hele bisdom geschreven.",
                            "target_lang_translations": {
                                "en": "Strict rules for the entire diocese were written in the papal <w>bull</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pauselijke bul"
                    ],
                    "target_lang_definitions": {
                        "en": "A formal official decree or charter issued by the Pope."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "papal bull",
                                "target_lang_sense_clarification": "official decree from the Pope"
                            },
                            {
                                "target_lang_word": "bull",
                                "target_lang_sense_clarification": "papal document"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee92008a-ea7b-3f8f-af2d-ff6800a2ff1c",
                    "sense_definition": "Een onvriendelijk, lomp of nukkerig persoon.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "persoon_karakter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Niemand praat graag met die oude <w>bul</w>, want hij is altijd chagrijnig.",
                            "target_lang_translations": {
                                "en": "Nobody likes talking to that old <w>bear</w>, because he is always grumpy."
                            }
                        },
                        {
                            "text": "Gedraag je niet zo als een <w>bul</w> en wees een beetje aardig voor de gasten.",
                            "target_lang_translations": {
                                "en": "Don't act like such a <w>churl</w> and be a little nice to the guests."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel scheldwoord of typering"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An unfriendly, rude, or grumpy person."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "churl",
                                "target_lang_sense_clarification": "rude or ungracious person"
                            },
                            {
                                "target_lang_word": "bear",
                                "target_lang_sense_clarification": "surly or disagreeable person"
                            },
                            {
                                "target_lang_word": "grouch",
                                "target_lang_sense_clarification": "grumpy person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}