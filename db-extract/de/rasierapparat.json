                "senses": [
                    {
                        "sense_id": "3672b854-2119-36d7-8801-e973f20d4c81",
                        "entry_id": "004c648f-80ad-306c-9a03-5962347641ef",
                        "glosses": [
                            "kleine elektrische Maschine, mit der man sich rasieren kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b41f2f32-d5dc-401f-b751-058bbde4959e",
                                "sense_id": "3672b854-2119-36d7-8801-e973f20d4c81",
                                "text": "„Im vorigen Jahr hatte sie vierzehn Lose gehabt und einen Rasierapparat gewonnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9970a961-8c79-3311-b01c-87903a5f95aa",
                        "entry_id": "004c648f-80ad-306c-9a03-5962347641ef",
                        "glosses": [
                            "Gerät aus einem Stiel und einer Halterung für die Rasierklinge zur Nassrasur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c4c0da8-36ac-4076-8300-9484c4f60265",
                                "sense_id": "9970a961-8c79-3311-b01c-87903a5f95aa",
                                "text": "Er legte die Klinge in den Rasierapparat ein."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "94a0f03f-f0fa-41c3-afd2-2661abb30811",
                        "source_entry_id": "004c648f-80ad-306c-9a03-5962347641ef",
                        "source_sense_id": "3672b854-2119-36d7-8801-e973f20d4c81",
                        "source_sense_description": "kleine elektrische Maschine, mit der man sich rasieren kann",
                        "target_lang_word": "rasoir électrique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rasoir électrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52f00015-fe1b-318d-b207-0ba7930c60ff",
                                        "entry_id": "eb8f49ff-71a2-31a6-85cb-47930f0af8fd",
                                        "glosses": [
                                            "Appareil de rasage utilisé généralement pour raser les poils de barbe. Il se compose d'un ensemble de lames derrière une grille d'une extrême finesse. Les lames sont animées soit d'un mouvement circulaire, soit d'un mouvement linéaire en va-et-vient, par un moteur électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de6fa070-d0af-4936-bd18-f4785a2d51c5",
                                                "sense_id": "52f00015-fe1b-318d-b207-0ba7930c60ff",
                                                "text": "En 1931, Schick lança le premier rasoir électrique. Son principe dérive de la tondeuse des coiffeurs : un bloc-couteaux animé d'un mouvement transversal sous une grille qui happe les poils en les redressant."
                                            },
                                            {
                                                "example_id": "9146e221-5987-450a-b8d0-02b3fb1ea88f",
                                                "sense_id": "52f00015-fe1b-318d-b207-0ba7930c60ff",
                                                "text": "Ces métaux se retrouvent aussi entre autres dans les brosses à dents et les rasoirs électriques, les écouteurs ou les câbles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
