                "senses": [
                    {
                        "sense_id": "cdebc9c6-4b11-3d2e-8e92-442bb1a30382",
                        "entry_id": "e93c38ed-cb13-34f6-8aa6-1b601920e9c5",
                        "glosses": [
                            "zwanghafte Wiederholung oder Nachahmung oder beobachteten Bewegungen einer anderen Person"
                        ],
                        "tags": [
                            "Psychiatrie"
                        ],
                        "examples": [
                            {
                                "example_id": "120f5de1-83f1-4c3b-99c8-33d66e454f74",
                                "sense_id": "cdebc9c6-4b11-3d2e-8e92-442bb1a30382",
                                "text": "Zu den möglichen Symptomen des Tourette-Syndroms gehört neben der Koprolalie, der Kopropraxie und der Echolalie auch die Echopraxie."
                            },
                            {
                                "example_id": "3f511c8b-3018-45e0-8536-4ee5f4a81880",
                                "sense_id": "cdebc9c6-4b11-3d2e-8e92-442bb1a30382",
                                "text": "Die Spiegelneurone können jedoch gebremst werden, so dass nicht jede vorgemachte Handlung aus ausgeführt wird. Bei Echopraxien scheint dieser Hemmmechanismus nicht zu funktionieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79d7b989-4138-41e9-a21f-e07b99586d19",
                        "source_entry_id": "e93c38ed-cb13-34f6-8aa6-1b601920e9c5",
                        "source_sense_id": "cdebc9c6-4b11-3d2e-8e92-442bb1a30382",
                        "source_sense_description": "Psychiatrie: zwanghafte Wiederholung oder Nachahmung oder beobachteten Bewegungen einer anderen Person",
                        "target_lang_word": "echopraxia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "echopraxia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae8d300c-29be-3000-bda7-813827ab4bff",
                                        "entry_id": "4ad6b2a5-aabc-39b8-a7c4-e79befecef12",
                                        "glosses": [
                                            "The involuntary repetition or imitation of the observed movements of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c6d0230-f280-4639-b8cf-74358857afce",
                                                "sense_id": "ae8d300c-29be-3000-bda7-813827ab4bff",
                                                "text": "For example, a tic is an automatic form of echopraxia, involving to some slight degree the emotions and the volition and having been originally acquired by suggestion and imitation."
                                            },
                                            {
                                                "example_id": "52e82ab1-464b-479a-bb81-60e51becc406",
                                                "sense_id": "ae8d300c-29be-3000-bda7-813827ab4bff",
                                                "text": "1964, Digest of Neurology and Psychiatry, Volumes 32-33, Institute of Living, page 260,\nEcholalia and echopraxia have been recognized as symptoms of seriously disturbed behavior in adults for over a century."
                                            },
                                            {
                                                "example_id": "c9791eed-a856-4b0f-a9fb-4ccb0b8f3a31",
                                                "sense_id": "ae8d300c-29be-3000-bda7-813827ab4bff",
                                                "text": "Several patients, after repeated experience of echopraxia and pantomime, had the delusion that they could communicate with others without using words—merely transmitting ideas by a bodily movement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2502996-ca16-45a3-a70d-f8a9b760575f",
                        "source_entry_id": "e93c38ed-cb13-34f6-8aa6-1b601920e9c5",
                        "source_sense_id": "cdebc9c6-4b11-3d2e-8e92-442bb1a30382",
                        "source_sense_description": "Psychiatrie: zwanghafte Wiederholung oder Nachahmung oder beobachteten Bewegungen einer anderen Person",
                        "target_lang_word": "échopraxie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "échopraxie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "521c4f08-e262-34dc-91b9-1e88ab7658b1",
                                        "entry_id": "0a82652d-f8fc-3d06-bb37-5d073a6e3c5a",
                                        "glosses": [
                                            "Trouble psychologique où le sujet reproduit les gestes de l’examinateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a87fdf4a-0f21-4874-b08a-2d48cafd7a6c",
                                                "sense_id": "521c4f08-e262-34dc-91b9-1e88ab7658b1",
                                                "text": "On constatait la lenteur de ses mouvements, sans maladresse appréciable, de l’écholalie et de l’échopraxie, ce qui la gênait beaucoup dans son travail."
                                            }
                                        ]
                                    }
                                ]
