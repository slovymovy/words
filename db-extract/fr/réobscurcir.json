                "senses": [
                    {
                        "sense_id": "285d2f58-a2d5-3a32-ad63-5c9b1e3995d8",
                        "entry_id": "1b6d4648-d91c-3017-84b2-12efde9be21d",
                        "glosses": [
                            "Obscurcir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "816de7de-5bbb-406a-b9a1-fadcfeb42888",
                                "sense_id": "285d2f58-a2d5-3a32-ad63-5c9b1e3995d8",
                                "text": "La théorie s'expose ainsi dans une métaphore pédagogique qui peut, dans certaines circonstances, en raison même de sa clarté, réobscurcir l'analyse (...)"
                            },
                            {
                                "example_id": "147d4f3e-d47a-43e5-be82-e765956585ba",
                                "sense_id": "285d2f58-a2d5-3a32-ad63-5c9b1e3995d8",
                                "text": "C'est que le sens de la Révolution russe, comme celui de la Révolution française, ne cessera de se modifier, se dévoiler, se réobscurcir, se transformer, en fonction des événements futurs dont l'une et l'autre révolution continuent d'être le germe, la matrice."
                            }
                        ]
                    }
