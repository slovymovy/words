                "translations": [
                    {
                        "translation_id": "952e3768-8ea1-487f-b9c9-92cc59f7240d",
                        "source_entry_id": "e0b96127-7ea0-3879-b794-9ff7dec293f6",
                        "source_sense_id": "4eab66a3-7fd9-3550-8621-d334067c324c",
                        "target_lang_word": "chevon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chevon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b83f2c2-8328-32c7-8a50-4596613bd229",
                                        "entry_id": "0449d4a8-6c34-373e-bfbb-ad568edf1949",
                                        "glosses": [
                                            "The meat of a goat."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da833959-4d19-4a37-af68-da24b583b747",
                                                "sense_id": "3b83f2c2-8328-32c7-8a50-4596613bd229",
                                                "text": "While goats are already established as a good source of meat (chevon) and milk, sheep are relatively new requiring further attention in terms of promotion."
                                            },
                                            {
                                                "example_id": "a2fda9f3-c251-4758-b355-afc260a7ad4f",
                                                "sense_id": "3b83f2c2-8328-32c7-8a50-4596613bd229",
                                                "text": "Chevon is the meat from the goat. Chevon is sold in finer restaurants as a delicacy for huge prices. It's been reported that chevon steaks can cost over $45 on the East Coast, yet many people refuse to taste is^([sic]) when it is served from our kitchen."
                                            },
                                            {
                                                "example_id": "63eaeb65-8ed3-4402-ab33-2aa43599620d",
                                                "sense_id": "3b83f2c2-8328-32c7-8a50-4596613bd229",
                                                "text": "If you cook chevon using too high of a heat setting, the meat will lose its moisture and become tough."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bbdde5c-648e-4f8b-a91e-4cff3e0196bf",
                        "source_entry_id": "e0b96127-7ea0-3879-b794-9ff7dec293f6",
                        "source_sense_id": "4eab66a3-7fd9-3550-8621-d334067c324c",
                        "target_lang_word": "Ziegenfleisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ziegenfleisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2339f963-7ee7-3e77-b8f5-cb353d443f6b",
                                        "entry_id": "58c08b3e-1045-33ed-b800-c41dee45d69a",
                                        "glosses": [
                                            "das als Nahrungsmittel verwendete Fleisch von Ziegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29944687-ad79-4532-af78-948a043c9728",
                                                "sense_id": "2339f963-7ee7-3e77-b8f5-cb353d443f6b",
                                                "text": "„Es muss ja nicht immer Osterlamm sein. Es gibt schließlich tolle Alternativen. Ziegenfleisch zum Beispiel. Anderswo ein Festmahl, wird es hierzulande stark unterschätzt. Dabei ist es mager, bekömmlich und äußerst schmackhaft.“"
                                            },
                                            {
                                                "example_id": "60333a02-58e0-415b-ba7c-9ce5743d986f",
                                                "sense_id": "2339f963-7ee7-3e77-b8f5-cb353d443f6b",
                                                "text": "„Am Montag verhängte die EU ein Exportverbot für Fleisch aus Großbritannien. Alle Ausfuhren von frischem Rind-, Schweine-, Schaf- und Ziegenfleisch wurden gestoppt.“"
                                            },
                                            {
                                                "example_id": "0c30ff21-76e0-463c-b26f-573c6bb643be",
                                                "sense_id": "2339f963-7ee7-3e77-b8f5-cb353d443f6b",
                                                "text": "„Jeder Bereich hatte auch fünf, sechs Stände, an denen man etwas trinken oder essen konnte: Schweine-, Ziegen-, Hühner- oder Hundefleisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
