                "senses": [
                    {
                        "sense_id": "f91690e4-f359-3ab0-9607-c2e17722ca94",
                        "entry_id": "f8356618-e133-3c4e-888c-99caa4673c5f",
                        "glosses": [
                            "с.-х. хлев, загон для овец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "551d6ab7-a0e2-45cb-9ce1-0c803c32f4fe",
                                "sense_id": "f91690e4-f359-3ab0-9607-c2e17722ca94",
                                "text": "Волк ночью, думая залезть в овчарню, // Попал на псарню."
                            },
                            {
                                "example_id": "4869f347-1e05-41af-91e6-dc66a42624f2",
                                "sense_id": "f91690e4-f359-3ab0-9607-c2e17722ca94",
                                "text": "Выпустить стадо из овчарни."
                            },
                            {
                                "example_id": "a82fc334-bcbd-4f9a-9521-84959180110e",
                                "sense_id": "f91690e4-f359-3ab0-9607-c2e17722ca94",
                                "text": "Загнать овец в овчарню."
                            }
                        ]
                    }
