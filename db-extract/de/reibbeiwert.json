                "senses": [
                    {
                        "sense_id": "4b577752-d209-3739-8571-0ff42830c729",
                        "entry_id": "1c825958-b547-3ed4-981b-39bf30b32a9d",
                        "glosses": [
                            "Verhältnis der Reibungs- zur Normalkraft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ccb2a92-550f-4e56-8e3e-32fa9a8de0a2",
                                "sense_id": "4b577752-d209-3739-8571-0ff42830c729",
                                "text": "„Bei diesem zunächst einfach erscheinenden Zusammenhang werden die komplizierten Vorgänge des Rollens und Haftens zwischen Rad und Schiene allein durch den Reibbeiwert μ berücksichtigt.“"
                            },
                            {
                                "example_id": "effca102-11b3-4a08-a134-ad0ef4b58bd1",
                                "sense_id": "4b577752-d209-3739-8571-0ff42830c729",
                                "text": "„Der zweite Effekt – der Widerstand beim Gleiten – wird üblicherweise durch den Reibbeiwert charakterisiert, welcher das Verhältnis zwischen dem Betrag der Reibkraft und dem Betrag der Normalkraft darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
