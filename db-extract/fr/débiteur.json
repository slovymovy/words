                    {
                        "translation_id": "50e4a1ee-85d4-48dd-a809-adb7fc1061f9",
                        "source_entry_id": "e3bb0466-aedb-3a10-8ce8-73aa3d67f21b",
                        "target_lang_word": "Schuldner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuldner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec5f554e-fb0d-38b4-ba54-638e23116d33",
                                        "entry_id": "c51d84b1-4cee-31ec-a0ba-eb64cc2d1a6a",
                                        "glosses": [
                                            "Person oder Organisation, die einem Gläubiger Geld schuldet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f21bd99-a24d-438c-b69f-2ad47761a1fe",
                                                "sense_id": "ec5f554e-fb0d-38b4-ba54-638e23116d33",
                                                "text": "Der Schuldner konnte das Geld nicht rechtzeitig auftreiben."
                                            },
                                            {
                                                "example_id": "e21efbcd-394e-4c86-babf-e4524b241180",
                                                "sense_id": "ec5f554e-fb0d-38b4-ba54-638e23116d33",
                                                "text": "„Statt der Bestnote AAA müssen sich die Vereinigten Staaten bei einer der US-Agenturen, die Schuldner bewerten, mit der Note »AA+« begnügen, gleichsam einer Eins minus.“"
                                            },
                                            {
                                                "example_id": "9dbb79e5-be18-4371-8f18-ea1c39776f16",
                                                "sense_id": "ec5f554e-fb0d-38b4-ba54-638e23116d33",
                                                "text": "„Für den Schecknehmer stellt sich die Frage, inwieweit er einen von seinem Schuldner erhaltenen Scheck einlösen kann und darf.“"
                                            },
                                            {
                                                "example_id": "cbe98692-39e7-47b8-b017-907ee11aea2a",
                                                "sense_id": "ec5f554e-fb0d-38b4-ba54-638e23116d33",
                                                "text": "„1523 und 1524 eskalierte er im Eisenacher Wucherstreit zu tumultartigen Auseinandersetzungen zwischen Schuldnern und Gläubigern, von denen die geistlichen Institutionen und Klöster besonderen Hass auf sich zogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0604ed92-b921-32f1-8837-d99ff4434297",
                                        "entry_id": "c51d84b1-4cee-31ec-a0ba-eb64cc2d1a6a",
                                        "glosses": [
                                            "ein Rechtssubjekt, das aufgrund eines Schuldverhältnisses dem Gläubiger eine Leistung erbringen muss"
                                        ],
                                        "tags": [
                                            "Rechtswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ce26d6a-8dd9-4368-b73f-951d28050fb4",
                                                "sense_id": "0604ed92-b921-32f1-8837-d99ff4434297",
                                                "text": "Kraft des Schuldverhältnisses ist der Gläubiger berechtigt, von dem Schuldner eine Leistung zu fordern. (§241 BGB)"
                                            },
                                            {
                                                "example_id": "92ee6fbb-7ab8-4fa6-9a48-5408f5743327",
                                                "sense_id": "0604ed92-b921-32f1-8837-d99ff4434297",
                                                "text": "„Diese Rechte erlöschen bei der Schuldübernahme, sie bleiben aber dann bestehen, wenn der ursprüngliche Schuldner damit einverstanden ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
