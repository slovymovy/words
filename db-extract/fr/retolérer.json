                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d38e887-feeb-4bfb-8a99-24604a902689",
                                "sense_id": "c38575b4-7330-32b9-8e9c-8ff942579ba5",
                                "text": "C'est profondément dégoûtant, ces deux femmes qui, après que l'une en est venue à une pareille extrémité, se revoient, se reparlent, se retolèrent comme auparavant..."
                            },
                            {
                                "example_id": "85d08ea1-cd0b-4c97-8a41-b5aa3ace6902",
                                "sense_id": "c38575b4-7330-32b9-8e9c-8ff942579ba5",
                                "text": "Si tu es intolérante au gluten, en l'évitant, tu peux aussi retolérer à nouveau les laitages au bout d'1 an ou 2 d'éviction."
                            },
                            {
                                "example_id": "bf492a5d-ccac-40d4-b756-29b3f0da5d63",
                                "sense_id": "c38575b4-7330-32b9-8e9c-8ff942579ba5",
                                "text": "Je peux même retolérer la vue des photos de Ludovic sur mon PC...."
                            }
                        ]
