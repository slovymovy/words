        "fr-extract.jsonl": [
            {
                "entry_id": "23cb6775-f290-30bf-90e4-103f5a1922d3",
                "word": "éclaircissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0383ac70-e5c6-4a6a-bd4f-49fe6b7dea40",
                        "entry_id": "23cb6775-f290-30bf-90e4-103f5a1922d3",
                        "tags": [
                            "plural"
                        ],
                        "form": "éclaircissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "17cecea0-ced8-341e-8e3d-9906afd03630",
                        "entry_id": "23cb6775-f290-30bf-90e4-103f5a1922d3",
                        "glosses": [
                            "Action de rendre moins serré, moins épais."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cd9a943-5a64-4d46-95f9-534400ce7e33",
                                "sense_id": "17cecea0-ced8-341e-8e3d-9906afd03630",
                                "text": "L’éclaircissement d’un bois."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                        "entry_id": "23cb6775-f290-30bf-90e4-103f5a1922d3",
                        "glosses": [
                            "Explication d’une chose obscure ou mal connue."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "655eb91c-3f16-49d0-9d3c-8d3741a242bb",
                                "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                "text": "Las de se casser la tête sur des énigmes, Hervé remit les éclaircissements au lendemain et regagna l'hôtel du Rhin."
                            },
                            {
                                "example_id": "083912c9-8592-45a8-8ae5-ce9220647875",
                                "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                "text": "A son retour, il publia sept lettres attribuées à Saint Antoine, qu’on n’avoit point encore imprimées. Théodore les avoit tirées de la bibliothèque des princes de la Mirande, Jean & François Pic. Symphorien Carpentier, médecin d’Antoine, duc de Lorraine, les accompagna de quelques remarques, qui servirent à leur donner de l’éclaircissement."
                            },
                            {
                                "example_id": "18c3d08b-ed4b-41eb-a714-94d0e9d7a144",
                                "sense_id": "1ae2e253-f1b2-338d-9111-7177fe3c01cb",
                                "text": "Déconverger le modèle social d’une communauté avec les individus qui la composent, bien que de la convergence, là aussi, naissent des éclaircissements."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a701e896-58ec-4b4c-a441-61050751f0c4",
                        "source_entry_id": "23cb6775-f290-30bf-90e4-103f5a1922d3",
                        "target_lang_word": "enlightenment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enlightenment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "040582c2-13de-3cf4-8dc1-b43fe9326857",
                                        "entry_id": "91466191-6fbf-37c7-8322-2ed61f3782e4",
                                        "glosses": [
                                            "An act of enlightening, or the state of being enlightened or instructed."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "693bde30-2b4a-3012-86c3-8b9048f4db09",
                                        "entry_id": "91466191-6fbf-37c7-8322-2ed61f3782e4",
                                        "glosses": [
                                            "A concept in spirituality, philosophy and psychology related to achieving clarity of perception, reason and knowledge."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c55ee04-06b7-43e9-a8a7-856b949fac76",
                                                "sense_id": "693bde30-2b4a-3012-86c3-8b9048f4db09",
                                                "text": "But the man who has attained enlightenment sees that the apparent reality is mere illusion, or, as was said a couple of thousand years later, that there is nothing good nor bad but thinking makes it so."
                                            },
                                            {
                                                "example_id": "91663a4c-fe4f-4d39-a22a-c093220aa027",
                                                "sense_id": "693bde30-2b4a-3012-86c3-8b9048f4db09",
                                                "text": "Thus Django becomes the carrier of the “public use of one's reason”—the Kantian road to enlightenment given to him by the German “Forty-Eighter” dentist–turned-bounty hunter Dr. “King” Schultz, and represents the fictive, allohistorical beginning of the battle against slavery and racism in the United States."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "428a860c-a474-4e9d-a310-a761149e4515",
                        "source_entry_id": "23cb6775-f290-30bf-90e4-103f5a1922d3",
                        "target_lang_word": "clarification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clarification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "821fcee2-bb36-3be0-ac6c-f841794e45be",
                                        "entry_id": "ac5e5fdc-7266-3a09-a935-683e171f1340",
                                        "glosses": [
                                            "The act of clarifying; the act or process of making clear or transparent by freeing visible impurities; particularly, the clearing or fining of liquid substances from impurities via the separation of the insoluble particles which prevent the liquid from being transparent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3e48853-1efb-4e91-b0e3-d12055a093c0",
                                                "sense_id": "821fcee2-bb36-3be0-ac6c-f841794e45be",
                                                "text": "The clarification of wine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8d3f33b-a6c5-36a0-a30e-4e6959f511f6",
                                        "entry_id": "ac5e5fdc-7266-3a09-a935-683e171f1340",
                                        "glosses": [
                                            "The act of freeing from obscurities; disambiguation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7753bbfc-0bd4-4ad3-959c-dd2c1ab9d299",
                                                "sense_id": "c8d3f33b-a6c5-36a0-a30e-4e6959f511f6",
                                                "text": "Your ideas deserve clarification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba16dd81-c9c1-3215-b255-0c365fecf2a6",
                                        "entry_id": "ac5e5fdc-7266-3a09-a935-683e171f1340",
                                        "glosses": [
                                            "An explanatory comment on, or question about, a point of obscurity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e31da40-55c4-4c6b-9fec-6df39f5398f1",
                                                "sense_id": "ba16dd81-c9c1-3215-b255-0c365fecf2a6",
                                                "text": "Let me make just one clarification: did he kiss her, or did she kiss him?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b07d52a-7ff6-3f71-b966-b0a4cca23a69",
                                        "entry_id": "ac5e5fdc-7266-3a09-a935-683e171f1340",
                                        "glosses": [
                                            "A small piece of writing supplemental to a previously published text, intended to disambiguate, explain away obscurities, but not contradict or emend the text (as would a correction)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ce5676f-ad50-3094-9d12-d55da8b82e24",
                                        "entry_id": "ac5e5fdc-7266-3a09-a935-683e171f1340",
                                        "glosses": [
                                            "Clarity, transparency, mutual understanding; to be clear."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6e65c5f-065f-49b4-a87c-030476c5708f",
                                                "sense_id": "1ce5676f-ad50-3094-9d12-d55da8b82e24",
                                                "text": "So, just for clarification, you're saying your Chihuahua ate your homework?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
