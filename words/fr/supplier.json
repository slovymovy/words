            "senses": [
                {
                    "sense_id": "c282f693-e31b-3d2f-8d6a-ac0a20adf952",
                    "sense_definition": "Demander quelque chose avec une insistance mêlée d'humilité, implorer ardemment quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prisonnier a <w>supplié</w> ses ravisseurs de lui laisser la vie sauve.",
                            "target_lang_translations": {
                                "en": "The prisoner <w>begged</w> his captors to spare his life.",
                                "ru": "Пленник <w>умолял</w> похитителей сохранить ему жизнь.",
                                "nl": "De gevangene <w>smeekte</w> zijn ontvoerders hem zijn leven te sparen.",
                                "de": "Der Gefangene <w>flehte</w> seine Entführer <w>an</w>, ihn am Leben zu lassen.",
                                "pl": "Więzień <w>błagał</w> porywaczy, żeby darowali mu życie.",
                                "it": "Il prigioniero ha <w>implorato</w> i rapitori di risparmiargli la vita.",
                                "cs": "Vězeň <w>prosil</w> své únosce, aby mu ušetřili život.",
                                "tr": "Tutsak, kaçıranlarına canını bağışlamaları için <w>yalvardı</w>.",
                                "es": "El prisionero <w>suplicó</w> a sus secuestradores que le perdonaran la vida.",
                                "zh": "囚犯<w>哀求</w>绑匪饶他一命。"
                            }
                        },
                        {
                            "text": "Je vous en <w>supplie</w>, écoutez mes explications avant de prendre une décision.",
                            "target_lang_translations": {
                                "en": "I <w>beg</w> you, please listen to my explanation before making a decision.",
                                "ru": "<w>Умоляю</w> вас, выслушайте мои объяснения, прежде чем принять решение.",
                                "nl": "Ik <w>smeek</w> u, luister naar mijn uitleg voordat u een besluit neemt.",
                                "de": "Ich <w>flehe</w> Sie <w>an</w>: Hören Sie sich meine Erklärung an, bevor Sie eine Entscheidung treffen.",
                                "pl": "<w>Błagam</w> was, wysłuchajcie moich wyjaśnień, zanim podejmiecie decyzję.",
                                "it": "Vi <w>scongiuro</w>, ascoltate le mie spiegazioni prima di prendere una decisione.",
                                "cs": "<w>Prosím</w> vás, vyslechněte mé vysvětlení, než se rozhodnete.",
                                "tr": "Size <w>yalvarıyorum</w>, bir karar vermeden önce açıklamalarımı dinleyin.",
                                "es": "Se lo <w>suplico</w>, escuche mis explicaciones antes de tomar una decisión.",
                                "zh": "我<w>恳求</w>您，在做决定之前先听听我的解释。"
                            }
                        }
                    ],
                    "synonyms": [
                        "implorer",
                        "adjurer",
                        "prier"
                    ],
                    "antonyms": [
                        "exiger",
                        "ordonner",
                        "sommer"
                    ],
                    "common_phrases": [
                        "supplier à genoux",
                        "supplier en vain"
                    ],
                    "target_lang_definitions": {
                        "en": "To ask for something with humble urgency, earnestly pleading with someone.",
                        "ru": "Настойчиво и униженно просить кого-либо о чём-либо, горячо умоляя.",
                        "nl": "Met aandrang en nederigheid om iets vragen, iemand vurig smeken.",
                        "de": "Jemanden mit demütiger Dringlichkeit und großem Ernst um etwas bitten.",
                        "pl": "Prosić kogoś o coś z pokorną natarczywością, gorąco go błagając.",
                        "it": "Chiedere qualcosa con insistenza e umiltà, implorare qualcuno con grande fervore.",
                        "cs": "Žádat někoho o něco s pokornou naléhavostí, úpěnlivě ho prosit.",
                        "tr": "Alçakgönüllü bir ısrarla bir şey istemek, birine ateşli biçimde yalvarmak.",
                        "es": "Pedir algo con insistencia y humildad, suplicando con fervor a alguien.",
                        "zh": "以谦卑而迫切的语气请求某事，恳切地哀求某人。"
                    },
