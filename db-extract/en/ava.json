                    {
                        "sense_id": "6ffdb4bd-43c4-3a84-be6e-0d021b881ac3",
                        "entry_id": "e7375c6c-fdd2-3565-942c-2a8ea97430ea",
                        "glosses": [
                            "A female given name from Hebrew, a variant of Eva."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1836bec9-9a77-4bdf-92fa-7d0c463e1a5b",
                                "sense_id": "6ffdb4bd-43c4-3a84-be6e-0d021b881ac3",
                                "text": "Ava Haynes, the oldest daughter, was a warm friend of Lillie Calhoun, whom she soon sought and led quickly into the conservatory."
                            },
                            {
                                "example_id": "c6f624d0-340e-4c7c-9a45-daf423e18e63",
                                "sense_id": "6ffdb4bd-43c4-3a84-be6e-0d021b881ac3",
                                "text": "My mother named me Ava because she liked how the English letters looked - the big A a beak pointed upward, the v a sharp slash of wings, the small a round and flat as a parrot's eye."
                            }
                        ]
                    },
