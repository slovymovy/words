            "senses": [
                {
                    "sense_id": "c9f371ef-22d9-31a7-9c21-9ed74bb96817",
                    "sense_definition": "fragt nach der örtlichen Herkunft oder der Richtung, aus der etwas oder jemand kommt",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "Herkunft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Guten Tag, <w>woher</w> kommen Sie eigentlich?"
                        },
                        {
                            "text": "Ich möchte gerne wissen, <w>woher</w> dieser schöne Wein stammt."
                        }
                    ],
                    "antonyms": [
                        "wohin"
                    ],
                    "common_phrases": [
                        "woher kommen"
                    ]
                },
                {
                    "sense_id": "4b87be87-9206-3644-bdb4-341ca496faae",
                    "sense_definition": "fragt im übertragenen Sinne nach der Quelle von Informationen oder dem Grund für ein Wissen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "Quelle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Woher</w> weißt du eigentlich schon von diesem neuen Plan?"
                        },
                        {
                            "text": "<w>Woher</w> soll ich das denn jetzt so genau wissen?"
                        }
                    ],
                    "common_phrases": [
                        "woher wissen"
                    ]
                },
                {
                    "sense_id": "21ea816a-bf6f-38a8-b2fb-920d0956ddea",
                    "sense_definition": "leitet einen Nebensatz ein und bezeichnet den Ausgangspunkt oder die Herkunft",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Relativ",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie kehrte schließlich wieder in die Stadt zurück, <w>woher</w> sie ursprünglich stammte."
                        },
                        {
                            "text": "Ganz egal, <w>woher</w> du kommst, hier bist du immer herzlich willkommen."
                        }
                    ]
                }
            ]
