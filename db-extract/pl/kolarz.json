                "translations": [
                    {
                        "translation_id": "94ed29b8-ab5d-4cc9-932b-b55505ff71da",
                        "source_entry_id": "dc6517c3-3521-331c-9348-791a5482b82d",
                        "source_sense_id": "42f00539-ba66-3d50-9d10-074b83d0709f",
                        "target_lang_word": "cyclist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyclist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a77c9781-627f-3e08-ac92-01fef39824e8",
                                        "entry_id": "c7301625-fd05-33f0-9735-d0e2ecc79011",
                                        "glosses": [
                                            "A person who rides a cycle, especially a bicycle, or who habitually engages in cycling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86b53b58-04a3-480f-a9f8-dea89db7059c",
                                                "sense_id": "a77c9781-627f-3e08-ac92-01fef39824e8",
                                                "text": "A solitary cyclist was coming towards us. His head was down and his shoulders rounded, as he put every ounce of energy that he possessed on to the pedals. He was flying like a racer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9a0e9d0-82a9-3827-9d42-2dee0701ff30",
                                        "entry_id": "c7301625-fd05-33f0-9735-d0e2ecc79011",
                                        "glosses": [
                                            "A motorcyclist."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8382e2db-c5f5-4929-9754-a8eb64110c1e",
                                                "sense_id": "e9a0e9d0-82a9-3827-9d42-2dee0701ff30",
                                                "text": "Most of the cyclists were members of the Pagans' Motorcycle Club of Washington."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a05370c3-a09d-4af7-b17f-1984f99227e5",
                        "source_entry_id": "dc6517c3-3521-331c-9348-791a5482b82d",
                        "source_sense_id": "42f00539-ba66-3d50-9d10-074b83d0709f",
                        "target_lang_word": "bicyclist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bicyclist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "971dd4fb-1093-39ba-a8b7-4a1dfc666121",
                                        "entry_id": "78ea4dd8-3d16-3659-8b6e-f62cbad43391",
                                        "glosses": [
                                            "Rare form of cyclist."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "faf80c2b-19ba-44d8-8bdf-d1b7565c8b6b",
                                                "sense_id": "971dd4fb-1093-39ba-a8b7-4a1dfc666121",
                                                "text": "“Yes, that is true, professor. I believe I’ve been guilty of doing so myself; but look here, Miss Eunice,” and he turned suddenly to the professor’s daughter, “they tell me that you are an enthusiastic bicyclist.”"
                                            },
                                            {
