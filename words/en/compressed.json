{
    "word_family": [
        "compress",
        "compression",
        "compressor",
        "compressible",
        "compressibility",
        "decompression"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3236dee4-f6aa-3463-aa10-4241b21f0ff4",
                    "sense_definition": "Pressed tightly together or reduced in volume by pressure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scuba diver carried a tank of <w>compressed</w> air to breathe underwater.",
                            "target_lang_translations": {
                                "ru": "Аквалангист нес баллон со <w>сжатым</w> воздухом, чтобы дышать под водой.",
                                "zh": "潜水员带着一罐<w>压缩</w>空气在水下呼吸。",
                                "es": "El buceador llevaba un tanque de aire <w>comprimido</w> para respirar bajo el agua."
                            }
                        },
                        {
                            "text": "The <w>compressed</w> spring released a lot of energy when it was finally let go.",
                            "target_lang_translations": {
                                "ru": "<w>Сжатая</w> пружина высвободила много энергии, когда ее наконец отпустили.",
                                "zh": "当<w>压缩</w>的弹簧最终被松开时，它释放出了巨大的能量。",
                                "es": "El resorte <w>comprimido</w> liberó mucha energía cuando finalmente fue soltado."
                            }
                        }
                    ],
                    "synonyms": [
                        "condensed",
                        "compacted",
                        "squeezed"
                    ],
                    "antonyms": [
                        "expanded",
                        "dilated"
                    ],
                    "common_phrases": [
                        "compressed air",
                        "compressed gas",
                        "highly compressed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно сжатый или уменьшенный в объеме под воздействием давления.",
                        "zh": "通过压力使物体紧密结合或体积减小。",
                        "es": "Presionado firmemente o reducido en volumen mediante presión."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжатый",
                                "target_lang_sense_clarification": "находящийся под давлением"
                            },
                            {
                                "target_lang_word": "уплотненный",
                                "target_lang_sense_clarification": "сделанный более плотным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压缩",
                                "target_lang_sense_clarification": "指物体受压后体积变小"
                            },
                            {
                                "target_lang_word": "受压",
                                "target_lang_sense_clarification": "处于被挤压的状态"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "comprimido",
                                "target_lang_sense_clarification": "que ha sido sometido a presión"
                            },
                            {
                                "target_lang_word": "compactado",
                                "target_lang_sense_clarification": "hecho más denso o apretado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7efc0eeb-5342-3179-a8a3-ea952428f898",
                    "sense_definition": "Flattened or made smaller in size, especially along its length or in a digital format.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should send a <w>compressed</w> file because the original is too large for an email attachment.",
                            "target_lang_translations": {
                                "ru": "Вам следует отправить <w>сжатый</w> файл, так как оригинал слишком велик для вложения в электронное письмо.",
                                "zh": "你应该发送一个<w>压缩</w>文件，因为原文件太大，无法作为电子邮件附件发送。",
                                "es": "Deberías enviar un archivo <w>comprimido</w> porque el original es demasiado grande para un archivo adjunto de correo electrónico."
                            }
                        },
                        {
                            "text": "The fossil was found in a <w>compressed</w> layer of ancient rock.",
                            "target_lang_translations": {
                                "ru": "Окаменелость была найдена в <w>спрессованном</w> слое древней породы.",
                                "zh": "这块化石是在一层<w>压实</w>的古老岩石中发现的。",
                                "es": "El fósil fue encontrado en una capa <w>comprimida</w> de roca antigua."
                            }
                        }
                    ],
                    "synonyms": [
                        "flattened",
                        "zipped"
                    ],
                    "antonyms": [
                        "uncompressed"
                    ],
                    "common_phrases": [
                        "compressed file",
                        "compressed data",
                        "compressed format"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сплющенный или уменьшенный в размере, особенно в длину или в цифровом формате.",
                        "zh": "变平或尺寸减小，常用于数字文件或地质层。",
                        "es": "Aplanado o reducido en tamaño, especialmente en su longitud o en formato digital."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжатый",
                                "target_lang_sense_clarification": "о файлах или данных"
                            },
                            {
                                "target_lang_word": "сплющенный",
                                "target_lang_sense_clarification": "деформированный давлением"
                            },
                            {
                                "target_lang_word": "архивированный",
                                "target_lang_sense_clarification": "о компьютерных файлах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压缩",
                                "target_lang_sense_clarification": "指数字文件大小减小"
                            },
                            {
                                "target_lang_word": "压实",
                                "target_lang_sense_clarification": "指物质被挤压得更紧密"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "comprimido",
                                "target_lang_sense_clarification": "referido a archivos o datos digitales"
                            },
                            {
                                "target_lang_word": "aplastado",
                                "target_lang_sense_clarification": "deformado por presión física"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c178cc64-bf3a-3137-8574-4c4f3c3a2c57",
                    "sense_definition": "Simple past and past participle of <w>compress</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine <w>compressed</w> the old car into a small metal cube.",
                            "target_lang_translations": {
                                "ru": "Машина <w>спрессовала</w> старый автомобиль в небольшой металлический куб.",
                                "zh": "机器把那辆旧车<w>压缩</w>成了一个小金属方块。",
                                "es": "La máquina <w>comprimió</w> el coche viejo hasta convertirlo en un pequeño cubo de metal."
                            }
                        },
                        {
                            "text": "She <w>compressed</w> her lips together and refused to say another word.",
                            "target_lang_translations": {
                                "ru": "Она <w>сжала</w> губы и отказалась произнести больше ни слова.",
                                "zh": "她<w>紧抿</w>着嘴唇，拒绝再说一个字。",
                                "es": "Ella <w>comprimió</w> sus labios y se negó a decir una palabra más."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «сжимать».",
                        "zh": "动词 compress 的过去式和过去分词，意为挤压或压缩。",
                        "es": "Pasado simple y participio pasado del verbo comprimir."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сжал",
                                "target_lang_sense_clarification": "действие в прошлом"
                            },
                            {
                                "target_lang_word": "сдавил",
                                "target_lang_sense_clarification": "сильно прижал"
                            },
                            {
                                "target_lang_word": "спрессовал",
                                "target_lang_sense_clarification": "с помощью техники"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "压缩",
                                "target_lang_sense_clarification": "挤压成较小体积"
                            },
                            {
                                "target_lang_word": "紧抿",
                                "target_lang_sense_clarification": "特指嘴唇紧闭"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "comprimió",
                                "target_lang_sense_clarification": "acción en pasado"
                            },
                            {
                                "target_lang_word": "apretó",
                                "target_lang_sense_clarification": "presionó fuertemente"
                            }
                        ]
                    }
                }
            ]
        }
    ]
