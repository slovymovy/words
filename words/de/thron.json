                    "frequency": "Middle",
                    "semantic_group_id": "herrschaft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der alte König saß während der Zeremonie feierlich auf seinem goldenen <w>Thron</w>."
                        },
                        {
                            "text": "Schon seit vielen Jahrhunderten dienen kunstvoll verzierte <w>Throne</w> den Herrschern als wichtiges Statussymbol."
                        }
                    ],
                    "synonyms": [
