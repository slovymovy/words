{
    "word_family": [
        "inquire",
        "inquiry",
        "inquisitiveness",
        "inquisitively",
        "inquisition"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "30066d9c-20b0-3241-b204-050aa7132d0c",
                    "sense_definition": "Eager to acquire knowledge and learn about many different things.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "curiosity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher encouraged her <w>inquisitive</w> students to ask as many questions as they liked.",
                            "target_lang_translations": {
                                "ru": "Учитель поощрял своих <w>любознательных</w> учеников задавать столько вопросов, сколько им хотелось.",
                                "zh": "老师鼓励她那些<w>好学</w>的学生尽可能多地提问。"
                            }
                        },
                        {
                            "text": "Having an <w>inquisitive</w> mind is essential for anyone pursuing a career in scientific research.",
                            "target_lang_translations": {
                                "ru": "Наличие <w>пытливого</w> ума необходимо для любого, кто строит карьеру в научных исследованиях.",
                                "zh": "对于任何从事科学研究的人来说，拥有一个<w>好奇</w>的头脑是必不可少的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inquiring"
                    ],
                    "antonyms": [
                        "uninterested",
                        "indifferent"
                    ],
                    "common_phrases": [
                        "inquisitive mind",
                        "inquisitive nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стремящийся к получению знаний и изучению множества различных вещей.",
                        "zh": "渴望获取知识并乐于学习各种新事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любознательный",
                                "target_lang_sense_clarification": "стремящийся к знаниям"
                            },
                            {
                                "target_lang_word": "пытливый",
                                "target_lang_sense_clarification": "о глубоком интересе, уме"
                            },
                            {
                                "target_lang_word": "любопытный",
                                "target_lang_sense_clarification": "проявляющий интерес к новому"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好学",
                                "target_lang_sense_clarification": "指人热爱学习，求知欲强"
                            },
                            {
                                "target_lang_word": "好奇",
                                "target_lang_sense_clarification": "指对新事物有浓厚兴趣"
                            },
                            {
                                "target_lang_word": "求知欲强",
                                "target_lang_sense_clarification": "形容一个人有强烈的学习愿望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5eb9d9d-cb60-38c7-ae74-e39cc8fdba97",
                    "sense_definition": "Showing too much curiosity about other people's private lives; being nosy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "curiosity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do not want to seem <w>inquisitive</w>, but I could not help noticing the moving truck outside your house.",
                            "target_lang_translations": {
                                "ru": "Не хочу показаться <w>любопытным</w>, но я не мог не заметить грузовик для переезда у вашего дома.",
                                "zh": "我不想显得太<w>爱打听</w>，但我还是忍不住注意到了你家门外的搬家卡车。"
                            }
                        },
                        {
                            "text": "The <w>inquisitive</w> neighbors were always peeking through their curtains to see who was visiting.",
                            "target_lang_translations": {
                                "ru": "<w>Любопытные</w> соседи вечно подглядывали из-за штор, чтобы увидеть, кто пришел в гости.",
                                "zh": "那些<w>爱打听</w>的邻居总是透过窗帘偷看谁来访。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inquiring"
                    ],
                    "antonyms": [
                        "unobtrusive",
                        "discreet"
                    ],
                    "common_phrases": [
                        "inquisitive neighbors",
                        "too inquisitive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий чрезмерное любопытство к частной жизни других людей; назойливый.",
                        "zh": "对他人私生活表现出过分的好奇心；爱打听隐私。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любопытный",
                                "target_lang_sense_clarification": "чрезмерно интересующийся чужим"
                            },
                            {
                                "target_lang_word": "назойливый",
                                "target_lang_sense_clarification": "бестактно любопытный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爱打听",
                                "target_lang_sense_clarification": "指喜欢探听别人的私事"
                            },
                            {
                                "target_lang_word": "多管闲事",
                                "target_lang_sense_clarification": "指对不该关心的事表现出过分兴趣"
                            },
                            {
                                "target_lang_word": "八卦",
                                "target_lang_sense_clarification": "口语中指喜欢探听并传播他人隐私"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}