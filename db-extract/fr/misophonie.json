                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "19b72e64-7484-4352-a77f-a4b05c867c6f",
                        "entry_id": "4b9b334d-a9a6-33ba-8aaa-7a609ad4faa9",
                        "tags": [
                            "plural"
                        ],
                        "form": "misophonies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b78d1ae-66fe-3a5d-b716-aadfc119df4d",
                        "entry_id": "4b9b334d-a9a6-33ba-8aaa-7a609ad4faa9",
                        "glosses": [
                            "Trouble qui déclenche la colère ou le dégoût face à certains bruits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5617ebda-6a79-4860-984c-5f092c59c0d6",
                                "sense_id": "7b78d1ae-66fe-3a5d-b716-aadfc119df4d",
                                "text": "La misophonie décrirait une détestation très ciblée de certains sons, entraînant une détresse psychologique et un évitement des situations ou des personnes associées à ce bruit."
                            },
                            {
                                "example_id": "33b5bf63-22ba-48bf-80b8-3d3ef580fd1d",
                                "sense_id": "7b78d1ae-66fe-3a5d-b716-aadfc119df4d",
                                "text": "M. Jastreboff explique que la misophonie est un problème acquis. «C’est une réaction au son. On commence à associer le son à quelque chose de très déplaisant.»"
                            },
                            {
                                "example_id": "d8ab95b6-e3e9-47de-aad1-e9eee6d89bdb",
                                "sense_id": "7b78d1ae-66fe-3a5d-b716-aadfc119df4d",
                                "text": "Inconvénient : des bruits de mastication dégoûtants ou grincements de couverts stridents non atténués. Soit pour toute personne atteinte de misophonie (phobie des sons, de bouche, de table…), la définition de l’enfer. Montez le son !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16ee6c1f-ff0f-4ff8-9afa-1e429ac45534",
                        "source_entry_id": "4b9b334d-a9a6-33ba-8aaa-7a609ad4faa9",
                        "source_sense_id": "7b78d1ae-66fe-3a5d-b716-aadfc119df4d",
                        "target_lang_word": "misophonia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "misophonia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e916842-1906-3e43-bcfa-ab2b28ed72cd",
                                        "entry_id": "4216decd-d018-3376-be54-30e637a9a72a",
                                        "glosses": [
                                            "A neurological disorder in which negative experiences, such as anger or disgust, are triggered by specific sounds."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df24b561-7165-4bcd-a238-298d08b52949",
                                                "sense_id": "2e916842-1906-3e43-bcfa-ab2b28ed72cd",
                                                "text": "The misophonia patients shared a similar pattern of symptoms in which an auditory or visual stimulus provoked an immediate aversive physical reaction with anger, disgust and impulsive aggression."
                                            },
                                            {
                                                "example_id": "72b2f24d-6fae-496c-835b-d074bed3f16c",
                                                "sense_id": "2e916842-1906-3e43-bcfa-ab2b28ed72cd",
                                                "text": "Misophonia is suspected of having also triggered at least two episodes of what the newspapers termed “cinema rage”. In Riga, Latvia, in 2011, during a screening of Black Swan, a 23-year-old man shot the person sitting next to him apparently for eating popcorn."
                                            }
                                        ]
                                    }
                                ]
                            }
