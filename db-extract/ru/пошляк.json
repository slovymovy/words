                                            {
                                                "example_id": "1df296b1-0f78-4c98-9ad3-62f2fb71d4b9",
                                                "sense_id": "7197bfcf-c83e-3752-8789-d382cdae9a4f",
                                                "text": "Myśli trudno było jednak zebrać, albowiem zamykający kawalkadę Rymbaba i Kuno Wittram nieustannie ryczeli pieśni pijackie i sprośne"
                                            },
