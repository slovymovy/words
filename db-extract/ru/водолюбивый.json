                ],
                "senses": [
                    {
                        "sense_id": "55ff0dca-6906-3d42-a952-515b227a05b3",
                        "entry_id": "95f43ea1-178c-3d44-a6d7-47d208ee2c34",
                        "glosses": [
                            "произрастающий преимущественно в сырых, влажных местах (о растениях)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28861097-0212-40d9-89f6-82bce727788d",
                                "sense_id": "55ff0dca-6906-3d42-a952-515b227a05b3",
                                "text": "Кроме водолюбивых ив, которые сами выбрали речку, ещё были посажены берёзы рядком и ели."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cba0070-d021-4e29-9d5d-6b3b73f8b2af",
                        "source_entry_id": "95f43ea1-178c-3d44-a6d7-47d208ee2c34",
                        "source_sense_id": "55ff0dca-6906-3d42-a952-515b227a05b3",
                        "target_lang_word": "hydrophilic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrophilic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39754797-53ee-3810-aeef-7d45d2832f0d",
                                        "entry_id": "84142e95-b4cd-3f11-9df6-92997e4426fe",
                                        "glosses": [
                                            "Having an affinity for water; able to absorb, or be wetted by water; water-loving."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e3b57ce-0d48-4e95-a0e2-4831c389d1dd",
                        "source_entry_id": "95f43ea1-178c-3d44-a6d7-47d208ee2c34",
                        "source_sense_id": "55ff0dca-6906-3d42-a952-515b227a05b3",
                        "target_lang_word": "water-loving",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "water-loving",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20ee2743-28d3-3f41-a2c4-0644adc3b2f4",
                                        "entry_id": "5d6ebe36-97e7-3884-8b28-3e9f2b6c6739",
                                        "glosses": [
                                            "Having an affinity for water; hydrophilic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b6d4c5-7a19-408e-ac5e-9e5f18e7b469",
                                                "sense_id": "20ee2743-28d3-3f41-a2c4-0644adc3b2f4",
                                                "text": "To prepare a cotton that would swell like linen, we decided to attach water-loving groups to the cellulose chain"
                                            },
                                            {
                                                "example_id": "f2320683-7741-4682-af72-32893999d731",
                                                "sense_id": "20ee2743-28d3-3f41-a2c4-0644adc3b2f4",
                                                "text": "The trouble is that calcium, magnesium, and iron react with the water-loving ends of the molecule to form insoluble […]"
                                            },
                                            {
                                                "example_id": "9a0e017f-0f34-40f7-a4bb-c00969ff5a1f",
                                                "sense_id": "20ee2743-28d3-3f41-a2c4-0644adc3b2f4",
                                                "text": "This is made of fatty acids, molecules that are characterized by having a water-loving end and a water-hating end."
                                            },
                                            {
                                                "example_id": "3a00fd65-5d43-4e8f-8e46-2f6e10322963",
                                                "sense_id": "20ee2743-28d3-3f41-a2c4-0644adc3b2f4",
                                                "text": "Since it accomodates both the water-hating and water-loving properties of modified diglycerides ..."
                                            },
                                            {
                                                "example_id": "c9fb4183-8072-430a-bb6d-6eb6bca926c1",
                                                "sense_id": "20ee2743-28d3-3f41-a2c4-0644adc3b2f4",
                                                "text": "a barrier consisting of cells that prevent bacteria and large or water-loving molecules from crossing into the central nervous system"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1db5b659-6ab4-4cd6-bd2f-85e54b27df6e",
                        "source_entry_id": "95f43ea1-178c-3d44-a6d7-47d208ee2c34",
                        "source_sense_id": "55ff0dca-6906-3d42-a952-515b227a05b3",
                        "target_lang_word": "hygrophile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hygrophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4870af99-3940-382c-b418-d5782139bc14",
                                        "entry_id": "ecb0f764-9f5b-34a1-86fc-3de5972f28fa",
                                        "glosses": [
                                            "Qualifie les végétaux qui croissent dans les lieux humides, et plus particulièrement dans les milieux soumis à une inondation se comptant en semaines (mais non en mois, dans ce cas voir : hydrophile)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98253da8-9270-4bf1-ac1f-ffb475e8f732",
                                                "sense_id": "4870af99-3940-382c-b418-d5782139bc14",
                                                "text": "Bien souvent d’ailleurs et très obligeamment, BONATI fils […] me procura d’intéressants renseignements sur la flore hygrophile de la vallée moyenne."
                                            },
                                            {
                                                "example_id": "f79e0032-c3c6-464e-aba1-2c8b630fa59c",
                                                "sense_id": "4870af99-3940-382c-b418-d5782139bc14",
                                                "text": "Groupement hygrophile à Pinus patula, sous climat tropical humide dans les Sierras hidalgenses, de Queretaro et de Puebla."
                                            },
                                            {
                                                "example_id": "9ef83c43-0411-4fa3-af13-444a901ba88a",
                                                "sense_id": "4870af99-3940-382c-b418-d5782139bc14",
                                                "text": "Cette espèce hygrophile se naturalise de préférence dans les moliniaies et les pelouses humides (Euffigneix, Poinson) et dans les endroits frais au bord des chemins (Bourbonne, Chambroncourt)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a7c8bb0-efbf-30ae-9879-4234f7968ff7",
                                        "entry_id": "ecb0f764-9f5b-34a1-86fc-3de5972f28fa",
                                        "glosses": [
                                            "Qualifie les animaux qui vivent dans les lieux humides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85cf746e-d4a6-4063-a7ed-d5339048daa7",
                                                "sense_id": "9a7c8bb0-efbf-30ae-9879-4234f7968ff7",
                                                "text": "Ce n’est point la clarté qu’il redoute, mais la sécheresse : il est hygrophile plutôt que lucifuge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d991a31-14bc-3bfb-9422-88f8752bccdc",
                                        "entry_id": "ecb0f764-9f5b-34a1-86fc-3de5972f28fa",
                                        "glosses": [
                                            "Qualifie les substances qui absorbent l’humidité de l’air."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
