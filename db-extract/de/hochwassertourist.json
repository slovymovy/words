                "senses": [
                    {
                        "sense_id": "061a4f78-c738-3d6d-9b47-c12506c30afb",
                        "entry_id": "57f5b9c1-8af7-3e73-8cc5-a1055e911e11",
                        "glosses": [
                            "Person, die in ein von einer Flut betroffenes Gebiet reisen, um die Überflutungen anzuschauen, aber ohne aktiv zu helfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5eebf5af-a70d-4805-bdc4-97ac3d3504ce",
                                "sense_id": "061a4f78-c738-3d6d-9b47-c12506c30afb",
                                "text": "„Hochwassertouristen machen der Polizei und den Einsatzkräften in der Elberegion Meckenburg-Vorpommerns zu schaffen.“"
                            },
                            {
                                "example_id": "25c06f5e-ab92-477c-9e65-faa71383db8d",
                                "sense_id": "061a4f78-c738-3d6d-9b47-c12506c30afb",
                                "text": "„Während sich die Feuerwehr in Frankfurt am Sonntag auf die erwartete zweite Hochwasserwelle vorbereitete, machten Hunderte von Hochwassertouristen den Helfern die Arbeit schwer.“"
                            },
                            {
                                "example_id": "46bc637c-0d8a-4e85-935c-d8741f3475b3",
                                "sense_id": "061a4f78-c738-3d6d-9b47-c12506c30afb",
                                "text": "„Ein paar tausend Hochwassertouristen waren am Wochenende in Lüchow-Dannenberg an der Elbe unterwegs.“"
                            },
                            {
                                "example_id": "de12098a-7a89-4c54-bba3-27ce9cc6d87b",
                                "sense_id": "061a4f78-c738-3d6d-9b47-c12506c30afb",
                                "text": "„Eine eindeutige Warnung schickte Burkhard Zscheischler vom Krisenstab im sächsischen Innenministerium an alle Gaffer: Hochwassertouristen, die keinen plausiblen Grund dafür angeben könnten, warum sie in die gefährdeten Stadtteile führen, müssten damit rechnen, dass sie ihr Fahrzeug an Ort und Stelle verlassen und zu Fuß nach Hause gehen müssten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
