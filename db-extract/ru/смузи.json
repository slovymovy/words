                ],
                "senses": [
                    {
                        "sense_id": "98b59ef3-2373-39c0-a277-646df4a7f945",
                        "entry_id": "66f6b680-10ea-3007-8123-0cccdb926ab8",
                        "glosses": [
                            "кулин. густой напиток в виде смешанных в блендере или миксере ягод или фруктов с добавлением кусочков льда, сока или молока"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc088779-60ab-4543-8065-d5495ebb607c",
                        "source_entry_id": "66f6b680-10ea-3007-8123-0cccdb926ab8",
                        "source_sense_id": "98b59ef3-2373-39c0-a277-646df4a7f945",
                        "target_lang_word": "smoothie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smoothie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4977fb76-d77f-3a87-8f71-2e1bb6b0f079",
                                        "entry_id": "f422af00-37bc-3cd5-b455-51b776c7fcf2",
                                        "glosses": [
                                            "A smooth-talking person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "741c7657-e000-432a-801b-1f302c6f83a9",
                                                "sense_id": "4977fb76-d77f-3a87-8f71-2e1bb6b0f079",
                                                "text": "True to their reputations, Paul was a smoothie who put a public relations gloss on everything he said, and John was abrasive and sarcastic, speaking his mind and letting the chips fall where they may."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27032b09-1bae-3223-bca4-4e9d19c6db94",
                                        "entry_id": "f422af00-37bc-3cd5-b455-51b776c7fcf2",
                                        "glosses": [
                                            "A drink made from whole fruit, thus thicker than fruit juice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b5b69ca-0acb-4a83-9179-8196628e5972",
                                                "sense_id": "27032b09-1bae-3223-bca4-4e9d19c6db94",
                                                "text": "Sometimes he brings her smoothies from his favourite place on Judd Street. He has a weakness for these glutinous confections that are supposed to extend his life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b396bf1e-91f6-3ad3-a197-9433ca062928",
                                        "entry_id": "f422af00-37bc-3cd5-b455-51b776c7fcf2",
                                        "glosses": [
                                            "A blending of different things, a mishmash"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd6d29ff-f246-4a93-967a-0837ee539cdb",
                                                "sense_id": "b396bf1e-91f6-3ad3-a197-9433ca062928",
                                                "text": "He shook his head and cleared the pentup anger and sadness that mixed his mind into a smoothie of emotions he bottled up inside, then scolded himself for allowing the outburst."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e060f34-ec7c-3214-9cc7-92d1a6b50fca",
                                        "entry_id": "f422af00-37bc-3cd5-b455-51b776c7fcf2",
                                        "glosses": [
                                            "A member of the mod subculture who is relatively non-violent and wears expensive clothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52df37dd-5bb9-4cc3-af4e-7863b9e908e8",
                                                "sense_id": "0e060f34-ec7c-3214-9cc7-92d1a6b50fca",
                                                "text": "1987, John Irwin (quoting Piri Thomas), The Felon\nThe decision to cool myself made the next two years the hardest I had done because it meant being a smoothie and staying out of trouble, which in prison is difficult, […]"
                                            },
                                            {
                                                "example_id": "87a4124c-52a9-4da8-845d-50e665fee1da",
                                                "sense_id": "0e060f34-ec7c-3214-9cc7-92d1a6b50fca",
                                                "text": "Film Comment's David Chute described him as: \"small, stringy and intense, but he's better dressed and groomed (than Ferrara), less of a punk and more of a smoothie.\""
                                            },
                                            {
                                                "example_id": "fdbb87b2-f3e4-4134-8dbc-769a2972cfa7",
                                                "sense_id": "0e060f34-ec7c-3214-9cc7-92d1a6b50fca",
                                                "text": "2011, Gerard DeGroot (quoting Brown), Seventies Unplugged\n[…] mods, skins, suedes, smoothies, punks, skunks, rude boys, soul boys and headbangers […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74549be6-111a-3bcb-8570-5092907c7e3c",
                                        "entry_id": "f422af00-37bc-3cd5-b455-51b776c7fcf2",
                                        "glosses": [
                                            "A person with shaven body hair, especially pubic hair."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef5a2b6a-6770-407b-a010-5f3667b37caf",
                                                "sense_id": "74549be6-111a-3bcb-8570-5092907c7e3c",
                                                "text": "Smoothies seem much more acceptable now. Back in the \"good old days\" it [pubic hair] was almost essential for pics etc."
                                            },
                                            {
                                                "example_id": "ea424026-8d39-48d4-b9e2-201e76b0fac7",
                                                "sense_id": "74549be6-111a-3bcb-8570-5092907c7e3c",
                                                "text": "These new smoothies are everywhere. The \"Body for Life\" fitness program asks people to spend six weeks getting into shape and then send in before-and-after pictures. The men in the \"after\" shots invariably have shaved chests."
                                            },
                                            {
                                                "example_id": "d7d24775-113c-4481-81c9-8306491705b3",
                                                "sense_id": "74549be6-111a-3bcb-8570-5092907c7e3c",
                                                "text": "not a wisp of pubic hair peeking out of even the tiniest thongs and bikini briefs and jockstraps. they should hire, oh, zak spears. he'd blow these smoothies off the page."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
