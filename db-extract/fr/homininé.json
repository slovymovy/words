                                "target_senses": [
                                    {
                                        "sense_id": "d9b73a37-a93d-33d0-a6f6-84dda6e846c5",
                                        "entry_id": "fe37fcca-87c4-3506-a4a1-9c92d993521d",
                                        "glosses": [
                                            "Of or relating to the Homininae, a subfamily of Hominidae that includes humans, gorillas, chimpanzees, and some extinct relatives."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hominine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab468cf8-c27e-3e86-b5b9-e011ec5b8bcd",
                                        "entry_id": "37446a2a-38ea-3b8b-86d6-a51f2c5c968f",
                                        "glosses": [
                                            "Any member of the subfamily Homininae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da41b633-0dc7-4c26-b291-0a328f9dd6b8",
                                                "sense_id": "ab468cf8-c27e-3e86-b5b9-e011ec5b8bcd",
                                                "text": "To judge from its sinuses, Hispanopithecus crusafonti is the earliest known hominine (the group including all great apes except orangs)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
