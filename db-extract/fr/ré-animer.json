                "senses": [
                    {
                        "sense_id": "88ebd7a3-30ee-325b-8157-5cbbba051b91",
                        "entry_id": "34b1c298-47ad-3137-9ea9-2c80e934629f",
                        "glosses": [
                            "Animer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97ac7b43-6d32-41d5-b8e1-c95d740f03af",
                                "sense_id": "88ebd7a3-30ee-325b-8157-5cbbba051b91",
                                "text": "Cette discussion nous a amené à rappeler tous les enjeux psychiques de travail de mise en rêve de ces plaintes corporelles, jusqu'à la création, aux fins de ré-animer, ré-humaniser, ré-objectaliser le sujet, tant par l'accueil de ces plaintes par les cure- et caregivers que par l’accueil spécifique d’un psychologue clinicien."
                            },
                            {
                                "example_id": "6a2cd43e-5fb6-4aa7-b005-e397a69938fc",
                                "sense_id": "88ebd7a3-30ee-325b-8157-5cbbba051b91",
                                "text": "Il paraît qu’ils vont ré-animer le Christ !"
                            },
                            {
                                "example_id": "b156e619-7676-4306-8bd0-ef9c1dd2beb6",
                                "sense_id": "88ebd7a3-30ee-325b-8157-5cbbba051b91",
                                "text": "Nous avons tenté de saisir la vivacité de la relation et de l’animer, ou plutôt de la ré-animer, à notre manière."
                            }
                        ]
                    }
