                "senses": [
                    {
                        "sense_id": "54db4f7d-603a-362b-be35-6a05d4eae512",
                        "entry_id": "588200d7-5b1d-3f8e-af52-8d826f7e05bd",
                        "glosses": [
                            "Injure pour désigner un Juif."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d0ce619a-f267-443e-94ee-4d57a84b5e42",
                                "sense_id": "54db4f7d-603a-362b-be35-6a05d4eae512",
                                "text": "Tout le ban, le fin fond de la Critique, au sacré complet, calotins, maçons, youtrons, rombiers et rombières, binocleux, chuchoteux, athlètes, gratte-culs, toute la légion, toute là debout, hagarde, déconnante l’écume !"
                            },
                            {
                                "example_id": "ddf0e289-b526-474a-ae46-66e8aacf7e41",
                                "sense_id": "54db4f7d-603a-362b-be35-6a05d4eae512",
                                "text": "Carrément injurieux... « Intellectuel ! » Pire insulte y en a pas pour moi. Qu'on me traite oisif, inutile, concupiscent, nazi, youtron, sauvage, qu'on tartine mon blase des péchés mortels, qu'on me dore de l'immoralité la plus noire, ça me dérange mie, mais qu'on me traite d’intellectuel, ah ! je me sens insulté."
                            }
                        ]
                    }
                ],
