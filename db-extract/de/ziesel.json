                                        "entry_id": "4e4ca5d8-a429-3c30-8861-0bd6255065cf",
                                        "glosses": [
                                            "Any of a number of medium-sized squirrel-like burrowing rodents of the tribe Marmotini (i.e., excluding the smaller chipmunks and the larger marmots and prairie dogs)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd4cc02e-4b52-4496-9f3e-5bd86314d784",
                                                "sense_id": "bd2663af-c308-323e-b0cc-a505f93b068f",
                                                "text": "Earely antelopes are seen, but wolves, rabbits, and sundry ground squirrels abound."
                                            },
                                            {
                                                "example_id": "69b79ddc-1f68-471f-8344-5d27b8f57283",
                                                "sense_id": "bd2663af-c308-323e-b0cc-a505f93b068f",
                                                "text": "Many ground squirrels sit up and look like prairie dogs, but a ground squirrel can be recognized by its longer face and tall."
                                            },
                                            {
                                                "example_id": "be1b24ec-9717-4537-890f-3b21bbc4c46b",
                                                "sense_id": "bd2663af-c308-323e-b0cc-a505f93b068f",
                                                "text": "2003, University of California Agriculture and Natural Resources, Integrated Pest Management for Walnuts, UCANR Publication 3270, page 23,\nIn some areas, ground squirrels may present a potential health problem because they carry ectoparasites that may transmit diseases such as bubonic plague to humans.\nThe adult California ground squirrel has a head and body 9 to 11 inches (23-28 cm) long and a somewhat bushy tail that is about as long as the body."
                                            },
                                            {
                                                "example_id": "62f0eccf-dc06-4262-8d50-f013a35d7e85",
                                                "sense_id": "bd2663af-c308-323e-b0cc-a505f93b068f",
                                                "text": "Pocket gophers appear to be abundant in the APWRA on both sides of Altamont Pass Road, whereas ground squirrels appear to be abundant only on the north side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47da438c-6a7f-3966-af11-5db7455665d2",
                                        "entry_id": "4e4ca5d8-a429-3c30-8861-0bd6255065cf",
                                        "glosses": [
                                            "Any of the other squirrel-like borrowing rodents of the subfamily Marmotinae."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
