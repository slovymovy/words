                        "cross_references": [
                            {
                                "target_word": "silvery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77e6883b-ed9e-3b8c-baee-3ba58605ef99",
                                        "entry_id": "4fbc124f-4b20-3a84-b41a-d7f0a7804068",
                                        "glosses": [
                                            "Resembling silver in color, shiny white."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5536a05e-2007-45b1-9c8f-d6740a791f4d",
                                                "sense_id": "77e6883b-ed9e-3b8c-baee-3ba58605ef99",
                                                "text": "OF all th' enamell'd race, whose silvery wing / Waves to the tepid zephyrs of the spring."
                                            },
                                            {
                                                "example_id": "7b0dff36-bf81-41bd-b067-b5683c568beb",
                                                "sense_id": "77e6883b-ed9e-3b8c-baee-3ba58605ef99",
                                                "text": "Nothing was to be seen save flat meadows, cows feeding unconcernedly for the most part, and silvery pollard willows motionless in the warm sunlight."
                                            },
                                            {
                                                "example_id": "c8fbb6b5-3632-4857-b703-5bd26bdc1e2c",
                                                "sense_id": "77e6883b-ed9e-3b8c-baee-3ba58605ef99",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese, a silvery metal, began to totter, slur their speech and behave like someone inebriated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffd7d021-6d1d-3909-8b08-800ba3bed9b6",
                                        "entry_id": "4fbc124f-4b20-3a84-b41a-d7f0a7804068",
                                        "glosses": [
                                            "Sprinkled or covered with silver."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9b5d7ce3-5762-3bf2-b459-95190a1aabae",
                                        "entry_id": "4fbc124f-4b20-3a84-b41a-d7f0a7804068",
                                        "glosses": [
                                            "Having the clear, musical tone of silver; soft and clear in sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc103cc4-4fb3-488e-96be-60df7a7d7d58",
                                                "sense_id": "9b5d7ce3-5762-3bf2-b459-95190a1aabae",
                                                "text": "a silvery laugh"
                                            },
                                            {
                                                "example_id": "ce551ab9-6e17-4b8a-a5ee-866cf5b12e51",
                                                "sense_id": "9b5d7ce3-5762-3bf2-b459-95190a1aabae",
                                                "text": "The hand grasped the curtain, and drew it aside, and as it did so I heard a voice, I think the softest and yet most silvery voice I ever heard."
                                            }
                                        ]
                                    }
                                ]
