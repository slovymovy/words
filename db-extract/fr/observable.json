                ],
                "senses": [
                    {
                        "sense_id": "9e046f2f-1d63-3be2-9e2b-6e7d69838fbe",
                        "entry_id": "ef3221fc-48fb-36b1-86c4-e380461d2c49",
                        "glosses": [
                            "Qui peut être observé."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "3e060055-783d-469d-adec-e320b4e228aa",
                                "sense_id": "9e046f2f-1d63-3be2-9e2b-6e7d69838fbe",
                                "text": "Faciès anthropogène à Polygonum sp. pl. observable dans les zones plus ou moins fangeuses fréquentées par les bestiaux et où s’installent des espèces nitratophiles […]"
                            },
                            {
                                "example_id": "772146c2-15c2-43b4-b7ae-6627d546cd15",
                                "sense_id": "9e046f2f-1d63-3be2-9e2b-6e7d69838fbe",
                                "text": "Un service est tout d’abord intangible, pas directement observable, par rapport à un produit qui a une forme, est visible, solide, peut être palpé et a fait l'objet d'une série de transformations physiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a26cc40a-8748-4a75-9440-6d8c4553c320",
                        "source_entry_id": "ef3221fc-48fb-36b1-86c4-e380461d2c49",
                        "source_sense_id": "9e046f2f-1d63-3be2-9e2b-6e7d69838fbe",
                        "target_lang_word": "observable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "observable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a1c7b8a-8833-3e0d-bf5c-85a1093b33d2",
                                        "entry_id": "73e0e115-1f73-319e-9212-ad00315a2dd1",
                                        "glosses": [
                                            "Able to be observed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eafa446-6a0d-44a1-a431-17c09b38e784",
                                                "sense_id": "0a1c7b8a-8833-3e0d-bf5c-85a1093b33d2",
                                                "text": "The strange new star was at the edge of the observable universe."
                                            },
                                            {
                                                "example_id": "67be79db-9f1d-43bf-bd88-b54f15e307d1",
                                                "sense_id": "0a1c7b8a-8833-3e0d-bf5c-85a1093b33d2",
                                                "text": "In 1913, in the same year that Mother's Day became a nationally observable holiday, the American people passed another milestone: for the first time in American history more than one person in one thousand was divorced."
                                            },
                                            {
                                                "example_id": "e05c5eba-6af1-43aa-8c8c-1c89fde1ce4a",
                                                "sense_id": "0a1c7b8a-8833-3e0d-bf5c-85a1093b33d2",
                                                "text": "Although intellectual property rights, such as patents, are highly observable, they are mostly limited to product technologies. Process technologies, or the routines endemic in the firm's production, are not readily observable, and thus cannot be easily imitated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18686935-64e6-3fea-bd0a-079b574857c5",
                                        "entry_id": "73e0e115-1f73-319e-9212-ad00315a2dd1",
                                        "glosses": [
                                            "Deserving to be observed; worth regarding; remarkable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "observable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d452ef5f-de21-30e4-9440-635c16e4ea26",
                                        "entry_id": "8609f91c-1806-30c3-8095-18ef5833e512",
                                        "glosses": [
                                            "Any physical property that can be observed and measured directly and not derived from other properties"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4366e4d5-8027-4818-a5c9-66653d0cb81e",
                                                "sense_id": "d452ef5f-de21-30e4-9440-635c16e4ea26",
                                                "text": "Temperature is an observable but entropy is derived."
                                            },
                                            {
                                                "example_id": "40f5db30-74a0-4481-a6bb-3a5fd8058716",
                                                "sense_id": "d452ef5f-de21-30e4-9440-635c16e4ea26",
                                                "text": "In quantum mechanics, observables correspond to Hermitian operators. Also, they act a lot like random variables. Taking their expected value one may recover something resembling a classical observable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
