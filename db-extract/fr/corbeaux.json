                        "entry_id": "f7494bf3-1572-3ff5-9f2a-707e2899a76b",
                        "glosses": [
                            "Peuple siouen, apparenté aux Gros Ventres, et vivant dans les États américains actuels du Montana et du Wyoming."
                        ],
                        "tags": [
                            "collectively"
                        ],
                        "examples": [
                            {
                                "example_id": "35232399-c8d1-44cf-8f01-820bcc87458f",
                                "sense_id": "d2103c06-1dd8-3508-90e9-0ddc4557083c",
                                "text": "Il s'avère qu'il a des reproches à formuler : les Blancs, se plaint-il, trappent le castor dans le territoire des Corbeaux sans autorisation et en épuisant les ressources."
                            }
                        ]
                    }
