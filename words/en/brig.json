{
    "word_family": [
        "brigantine"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "606c5614-5cbf-35e9-84e7-8d34aa7bcb60",
                    "sense_definition": "A military prison or detention cell, especially on a naval ship or military base.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor was sent to the <w>brig</w> for refusing to obey the captain's orders.",
                            "target_lang_translations": {
                                "es": "El marinero fue enviado al <w>calabozo</w> por negarse a obedecer las órdenes del capitán."
                            }
                        },
                        {
                            "text": "Security guards quickly escorted the unruly officer down to the ship's <w>brig</w>.",
                            "target_lang_translations": {
                                "es": "Los guardias de seguridad escoltaron rápidamente al oficial revoltoso hasta el <w>calabozo</w> del barco."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the brig"
                    ],
                    "target_lang_definitions": {
                        "es": "Prisión o celda militar, especialmente a bordo de un barco de guerra o en una base militar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "calabozo",
                                "target_lang_sense_clarification": "prisión militar o de barco"
                            },
                            {
                                "target_lang_word": "celda de castigo",
                                "target_lang_sense_clarification": "en el ámbito militar o naval"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81793294-2c9b-3308-9603-f47d2bd4386f",
                    "sense_definition": "A traditional sailing ship with two masts, both square-rigged.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vessel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant fleet was protected by an armed <w>brig</w> as it entered hostile waters.",
                            "target_lang_translations": {
                                "es": "La flota mercante fue protegida por un <w>bergantín</w> armado al entrar en aguas hostiles."
                            }
                        },
                        {
                            "text": "They sailed a wooden <w>brig</w> across the Atlantic in search of trade.",
                            "target_lang_translations": {
                                "es": "Navegaron por el Atlántico en un <w>bergantín</w> de madera en busca de comercio."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Embarcación tradicional de vela con dos palos aparejados con velas cuadradas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "bergantín",
                                "target_lang_sense_clarification": "barco de vela de dos mástiles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ee5c52c-ef72-37c8-8cef-493f7eba5aae",
                    "sense_definition": "A bridge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked across the old stone <w>brig</w> to reach the other side of the river.",
                            "target_lang_translations": {
                                "es": "Cruzamos el viejo <w>puente</w> de piedra para llegar al otro lado del río."
                            }
                        },
                        {
                            "text": "The horse hesitated before stepping onto the narrow <w>brig</w> over the stream.",
                            "target_lang_translations": {
                                "es": "El caballo vaciló antes de poner una pata sobre el estrecho <w>puente</w> sobre el arroyo."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Used in Scottish and Northern English dialects"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Scotland and Northern England"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Puente (forma dialectal en Escocia y norte de Inglaterra)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "puente",
                                "target_lang_sense_clarification": "dialectal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1e174c0-c40e-36f0-912c-fcba9d321d5b",
                    "sense_definition": "A brigadier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers stood at attention when the <w>brig</w> walked into the inspection hall.",
                            "target_lang_translations": {
                                "es": "Los soldados se pusieron firmes cuando el <w>brigadier</w> entró en la sala de inspección."
                            }
                        },
                        {
                            "text": "Everyone listened carefully whenever the retired <w>brig</w> gave his opinion on tactics.",
                            "target_lang_translations": {
                                "es": "Todos escuchaban con atención siempre que el <w>general de brigada</w> retirado daba su opinión sobre táctica."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Military abbreviation"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal shortened form"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Forma abreviada y coloquial de brigadier o general de brigada."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "brigadier",
                                "target_lang_sense_clarification": "abreviatura militar"
                            },
                            {
                                "target_lang_word": "general de brigada",
                                "target_lang_sense_clarification": "rango militar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c96aab5-a40a-37a8-abfd-b9406d3b06e9",
                    "sense_definition": "To confine someone to a military prison or cell.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confinement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The commanding officer threatened to <w>brig</w> anyone who continued fighting.",
                            "target_lang_translations": {
                                "es": "El oficial al mando amenazó con <w>mandar al calabozo</w> a cualquiera que siguiera peleando."
                            }
                        },
                        {
                            "text": "They had to <w>brig</w> the suspect overnight until military police arrived.",
                            "target_lang_translations": {
                                "es": "Tuvieron que <w>encerrar en el calabozo</w> al sospechoso durante la noche hasta que llegó la policía militar."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Encerrar a alguien en un calabozo o prisión militar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "encerrar en el calabozo",
                                "target_lang_sense_clarification": "en el ámbito militar o naval"
                            },
                            {
                                "target_lang_word": "encarcelar",
                                "target_lang_sense_clarification": "militarmente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0690c4a5-e7cf-3808-aa59-0d3f7e3049af",
                    "sense_definition": "To pretend to be busy in order to avoid actual work; to dawdle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of completing his assigned duties, he decided to <w>brig</w> all afternoon.",
                            "target_lang_translations": {
                                "es": "En vez de cumplir con sus tareas asignadas, decidió <w>hacer el vago</w> toda la tarde."
                            }
                        },
                        {
                            "text": "The manager noticed that several workers would <w>brig</w> whenever supervision was lax.",
                            "target_lang_translations": {
                                "es": "El encargado notó que varios trabajadores <w>holgazaneaban</w> cada vez que la supervisión se relajaba."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Hacerse el ocupado para evitar trabajar; haraganear o perder el tiempo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "hacerse el loco",
                                "target_lang_sense_clarification": "para eludir el trabajo"
                            },
                            {
                                "target_lang_word": "holgazanear",
                                "target_lang_sense_clarification": "fingiendo estar ocupado"
                            },
                            {
                                "target_lang_word": "hacer el vago",
                                "target_lang_sense_clarification": "evitar tareas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "1058c799-f203-38a3-b945-e070f18a1bd5",
                    "sense_definition": "A historic town in the canton of Valais, Switzerland.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "swiss_location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Many tourists change trains in <w>Brig</w> before heading up into the mountains.",
                            "target_lang_translations": {
                                "es": "Muchos turistas hacen transbordo de tren en <w>Brig</w> antes de subir a las montañas."
                            }
                        },
                        {
                            "text": "We stayed at a small hotel near the historic castle in <w>Brig</w>.",
                            "target_lang_translations": {
                                "es": "Nos alojamos en un pequeño hotel cerca del histórico castillo de <w>Brig</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Brigue"
                    ],
                    "target_lang_definitions": {
                        "es": "Ciudad histórica en el cantón del Valais, Suiza."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "Brig",
                                "target_lang_sense_clarification": "ciudad suiza"
                            },
                            {
                                "target_lang_word": "Briga",
                                "target_lang_sense_clarification": "nombre tradicional en español"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b146774-ef60-364b-91d4-a736dd0b3700",
                    "sense_definition": "A district located in the canton of Valais, Switzerland.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "swiss_location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The administrative district of <w>Brig</w> encompasses several Alpine villages.",
                            "target_lang_translations": {
                                "es": "El distrito administrativo de <w>Brig</w> abarca varias aldeas alpinas."
                            }
                        },
                        {
                            "text": "Several local officials met in the district of <w>Brig</w> to discuss transport.",
                            "target_lang_translations": {
                                "es": "Varios funcionarios locales se reunieron en el distrito de <w>Brig</w> para debatir sobre el transporte."
                            }
                        }
                    ],
                    "synonyms": [
                        "Brigue"
                    ],
                    "target_lang_definitions": {
                        "es": "Distrito situado en el cantón del Valais, Suiza."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "Brig",
                                "target_lang_sense_clarification": "distrito de Suiza"
                            },
                            {
                                "target_lang_word": "Briga",
                                "target_lang_sense_clarification": "distrito de Suiza en español"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}