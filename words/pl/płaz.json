{
    "word_family": [
        "płazina",
        "płazowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b6da1db-11dd-3fa8-99c7-079a4b60c230",
                    "sense_definition": "zwierzę z gromady kręgowców ziemnowodnych",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zwierzęta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Z tego względu <w>płazy</w> wymagają do rozrodu środowiska wodnego.",
                            "target_lang_translations": {
                                "ru": "По этой причине <w>земноводные</w> требуют водной среды для размножения."
                            }
                        },
                        {
                            "text": "Żaba to najbardziej znany <w>płaz</w> w naszym kraju.",
                            "target_lang_translations": {
                                "ru": "Лягушка — самое известное <w>земноводное</w> в нашей стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "amfibia"
                    ],
                    "common_phrases": [
                        "gromada płazów",
                        "ochrona płazów"
                    ],
                    "target_lang_definitions": {
                        "ru": "животное из класса позвоночных, обитающее как в воде, так и на суше"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "земноводное",
                                "target_lang_sense_clarification": "биологический термин для обозначения амфибий"
                            },
                            {
                                "target_lang_word": "амфибия",
                                "target_lang_sense_clarification": "синоним, часто используемый в научном контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a318a28d-69fe-384f-b4c4-4d220d19afb6",
                    "sense_definition": "człowiek płaszczący się przed kimś, uległy",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "osoba",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie bądź takim <w>płazem</w> i powiedz wreszcie szefowi, co o tym myślisz.",
                            "target_lang_translations": {
                                "ru": "Не будь такой <w>тряпкой</w> и скажи наконец начальнику, что ты об этом думаешь."
                            }
                        },
                        {
                            "text": "Ten <w>płaz</w> zrobi wszystko, żeby tylko przypodobać się swojemu przełożonemu.",
                            "target_lang_translations": {
                                "ru": "Этот <w>подхалим</w> сделает всё, лишь бы угодить своему начальнику."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w odniesieniu do osoby uległej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек, который ведет себя подобострастно, унижается перед кем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подхалим",
                                "target_lang_sense_clarification": "человек, который льстит ради выгоды"
                            },
                            {
                                "target_lang_word": "тряпка",
                                "target_lang_sense_clarification": "разговорное обозначение бесхарактерного, уступчивого человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8f8f584-86e2-31bd-89f8-801858b8f306",
                    "sense_definition": "rodzaj belki budowlanej o zaokrąglonych krawędziach",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "budownictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fundament z skalnych odłamów, z <w>płazów</w> świerkowych chata.",
                            "target_lang_translations": {
                                "ru": "Фундамент из каменных обломков, хата из еловых <w>лафетов</w>."
                            }
                        },
                        {
                            "text": "Stara chata została zbudowana z grubych <w>płazów</w>.",
                            "target_lang_translations": {
                                "ru": "Старая хата была построена из толстых <w>лафетов</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chata z płazów"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "często używane w kontekście budownictwa góralskiego"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "вид строительного бревна, обтесанного с двух сторон"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лафет",
                                "target_lang_sense_clarification": "бревно, опиленное с двух противоположных сторон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be8f2587-fde5-3124-9be2-093d59507af7",
                    "sense_definition": "szeroka, płaska strona przedmiotu, zwłaszcza broni siecznej",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "przedmioty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uderzył przeciwnika <w>płazem</w> miecza, aby go tylko ogłuszyć.",
                            "target_lang_translations": {
                                "ru": "Он ударил противника <w>плашмя</w> мечом, чтобы только оглушить его."
                            }
                        },
                        {
                            "text": "Ostrze miecza ma dwie ostre krawędzie oraz szeroki <w>płaz</w>.",
                            "target_lang_translations": {
                                "ru": "Клинок меча имеет две острые кромки и широкую <w>голомень</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "płaz miecza"
                    ],
                    "target_lang_definitions": {
                        "ru": "широкая плоская сторона клинка холодного оружия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плашмя",
                                "target_lang_sense_clarification": "наречие, описывающее удар плоской стороной меча"
                            },
                            {
                                "target_lang_word": "голомень",
                                "target_lang_sense_clarification": "технический термин для обозначения плоской стороны клинка"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}