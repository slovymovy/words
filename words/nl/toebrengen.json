                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inflict",
                                "target_lang_sense_clarification": "to cause suffering or harm, often intentionally"
                            },
                            {
                                "target_lang_word": "wreak",
                                "target_lang_sense_clarification": "to cause great damage or destruction"
