                        "cross_references": []
                    },
                    {
                        "translation_id": "216c58ca-9c9e-422c-bd5e-4ffbb289c50d",
                        "source_entry_id": "0de77db9-c3af-3ff3-b79b-d427909fbdd3",
                        "source_sense_id": "c7b96d6f-e774-38ca-bebf-e19af0429f35",
                        "source_sense_description": "in a patient manner",
