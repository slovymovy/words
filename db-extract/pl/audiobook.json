                        "glosses": [
                            "książka mówiona; nagranie dźwiękowe zawierające tekst publikacji książkowej odczytany przez lektora"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98418f24-4842-4820-80c7-ee3eac5f09dc",
                                "sense_id": "4c859030-7d6e-3a4a-bd47-6fb71ef263d5",
                                "text": "Po wynalezieniu e-booków i audiobooków nastąpił zmierzch popularności papierowych książek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "020e1013-b12a-4c2a-bd4d-f05ab041f09b",
                        "source_entry_id": "89d540c2-b632-3920-b4a5-941d7d0bf23a",
                        "source_sense_id": "4c859030-7d6e-3a4a-bd47-6fb71ef263d5",
                        "target_lang_word": "audiobook",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "audiobook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e70e1ac-e2dc-3d11-9113-10bed77d77dd",
                                        "entry_id": "b5571acd-9d0b-34aa-9d9b-fff9b7078380",
                                        "glosses": [
                                            "A recording, usually made available for sale, of a reading of the full text or of an abridgement of a book."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53420cd8-d6fe-47ce-bfcc-ec15aca55784",
                                                "sense_id": "8e70e1ac-e2dc-3d11-9113-10bed77d77dd",
                                                "text": "Trump’s take on his relationship with Kim – and his admission that he didn’t have a broader strategy behind the threats he made about having a “much bigger” nuclear button – are part of a new audiobook that Woodward is releasing."
                                            },
                                            {
                                                "example_id": "6c6e1b77-286f-4a96-bf27-dd8b949712eb",
                                                "sense_id": "8e70e1ac-e2dc-3d11-9113-10bed77d77dd",
                                                "text": "Matt Semrad is an avid reader and devours audiobooks from the library — about one a week. He also spends several hours each day walking his two black doodles, Sirius and Sonny."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9edb981-f7c7-40b5-a4fe-467e378d2b23",
                        "source_entry_id": "89d540c2-b632-3920-b4a5-941d7d0bf23a",
                        "source_sense_id": "4c859030-7d6e-3a4a-bd47-6fb71ef263d5",
                        "target_lang_word": "audiokniha",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a363f183-2d9d-47d8-abbd-71aab2af6fc1",
                        "source_entry_id": "89d540c2-b632-3920-b4a5-941d7d0bf23a",
                        "source_sense_id": "4c859030-7d6e-3a4a-bd47-6fb71ef263d5",
                        "target_lang_word": "livre audio",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "livre audio",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8da8edaa-c325-3e97-8adb-b329b9e859d0",
                                        "entry_id": "5d284b57-8e82-3fbb-b12c-ec7deb5153e7",
                                        "glosses": [
                                            "Enregistrement de la lecture à haute voix d’un livre."
                                        ],
                                        "tags": [
                                            "Livre",
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b9a6ee9-bb8e-45dd-bfa6-ad3c0f575dc5",
                                                "sense_id": "8da8edaa-c325-3e97-8adb-b329b9e859d0",
                                                "text": "Selon cette étude, basée sur des questionnaires adressés à des lecteurs ayant lu le même livre soit au format audio soit au format papier, lire un livre audio activerait plutôt des mécanismes de réception basés sur l’instinctif et l’intuition, alors que lire au format papier permettrait une compréhension plutôt basée sur l’analyse et une potentielle réfutation"
                                            },
                                            {
                                                "example_id": "365793b3-bc3e-4abb-a91b-2cde6b7b80c4",
                                                "sense_id": "8da8edaa-c325-3e97-8adb-b329b9e859d0",
                                                "text": "Consacré aux plus de 7 ans, le Flam créé par les éditions Lunii, leur permet de se projeter dans de véritables jeux de rôles, à travers des livres audio personnalisables."
                                            },
                                            {
                                                "example_id": "0e151978-6d6f-4308-a270-c3818772d140",
                                                "sense_id": "8da8edaa-c325-3e97-8adb-b329b9e859d0",
                                                "text": "Allouer 5 millions de cette somme à la production de livres audio québécois permettrait d’augmenter notre catalogue d’au moins 800 livres d’ici !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a378ca7-2122-4f83-acd1-9a173fcf6c11",
                        "source_entry_id": "89d540c2-b632-3920-b4a5-941d7d0bf23a",
                        "source_sense_id": "4c859030-7d6e-3a4a-bd47-6fb71ef263d5",
                        "target_lang_word": "Hörbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hörbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b69366c-4407-3f82-8466-50f9ea26de20",
                                        "entry_id": "74efd1b6-32f9-3d89-adba-ae9f209d4f03",
                                        "glosses": [
                                            "von einem Sprecher vertontes und auf einem Speichermedium gespeichertes Buch (= Lesung), Hörspiel oder Feature, das auf Kassette oder CD publiziert wurde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b43b180e-12dc-4366-a1d2-61723a4370b3",
                                                "sense_id": "2b69366c-4407-3f82-8466-50f9ea26de20",
                                                "text": "Melchior Schedler's Hörspiel \"Cordoba oder die Kunst des Badens\" ist auch als Hörbuch erhältlich."
                                            },
                                            {
                                                "example_id": "ac785493-02e5-4d66-b403-dd3b65892467",
                                                "sense_id": "2b69366c-4407-3f82-8466-50f9ea26de20",
                                                "text": "Mit Hörbuchern kann man akustisch auf Reisen gehen.http://www.zeit.de/2011/17/Reisen-Hoerbuecher"
                                            },
                                            {
                                                "example_id": "f9808eaa-f5d9-4c27-be01-b78653c6ab01",
                                                "sense_id": "2b69366c-4407-3f82-8466-50f9ea26de20",
                                                "text": "„Einmal bin ich um die Insel gefahren, mit meiner Freundin im Auto, und wir haben Hörbücher gehört.“"
                                            },
                                            {
                                                "example_id": "9f8215d4-b547-4a8b-980f-f763dba94909",
                                                "sense_id": "2b69366c-4407-3f82-8466-50f9ea26de20",
                                                "text": "„Allabendlich – der Kontrast hätte nicht größer sein können – schlief meine kleine Tochter zu Hörbüchern über die griechische Mythologie ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
