                    {
                        "translation_id": "d1b53bea-b828-48ec-b58a-09332a699f7a",
                        "source_entry_id": "cc7b84cf-cba4-3dea-8741-c95ad53b796e",
                        "source_sense_id": "c6c8dc90-7bd5-32ef-b4b8-1b26d449b177",
