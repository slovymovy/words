                        "translation_id": "dbf0171f-bb55-4177-9fcd-c7ac01bad5e7",
                        "source_entry_id": "b7045896-4c97-3926-9010-ee0feb3ed670",
                        "source_sense_id": "5c675b60-a64f-3234-8a3e-ca9998680443",
