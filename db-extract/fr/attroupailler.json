                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd956f30-4a96-4f11-8908-7a2e53d25acc",
                                "sense_id": "1ce31325-a93b-3916-b5ab-2fe07853caa8",
                                "text": "Tout Couscous s’était attroupaillé devant notre case, pustuleux et chantant, chacun traînant son petit nuage de poussière qu’il secouait en cadence."
                            },
                            {
                                "example_id": "d7c37c9f-c423-4c9e-8ab9-3d0fd994f8a9",
                                "sense_id": "1ce31325-a93b-3916-b5ab-2fe07853caa8",
                                "text": "Sans lui laisser le temps d’attroupailler des mots dans sa tête, je me concentrai sur les oignons que j’épluchais."
                            }
                        ]
                    }
