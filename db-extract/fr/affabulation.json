                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5ff5b48-1a3c-4231-9792-20f89c4689c5",
                        "source_entry_id": "5a526e05-8e0a-33aa-8558-62de1415d338",
                        "source_sense_description": "3. Récit mensonger.",
                        "target_lang_word": "Fabel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eef9727a-4874-344c-b69f-70ded568a028",
                                        "entry_id": "3fcf41ed-b7ca-30f7-a90d-8b61771e4b9c",
                                        "glosses": [
                                            "eine Form der Erzählung, in der menschliche Verhaltensweisen auf Tiere (seltener auf Pflanzen oder Dinge) übertragen werden, um so auf unterhaltsame Weise eine bestimmte Moral zu vermitteln"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56ccbfd8-8f48-4787-ab04-08db8291399d",
                                                "sense_id": "eef9727a-4874-344c-b69f-70ded568a028",
                                                "text": "Lies mir doch nochmal die Fabel vom Fuchs und den Trauben vor, die er als sauer verschmäht, nur weil sie ihm zu hoch hängen."
                                            },
                                            {
                                                "example_id": "7e59029e-b35b-4f06-aad4-1e3e80101548",
                                                "sense_id": "eef9727a-4874-344c-b69f-70ded568a028",
                                                "text": "„In meiner sozialistischen Schule mussten wir mindestens drei dieser Fabeln auswendig lernen.“"
                                            },
                                            {
                                                "example_id": "bc6f78b7-bb51-4278-acff-c7e7a2ddaa38",
                                                "sense_id": "eef9727a-4874-344c-b69f-70ded568a028",
                                                "text": "„Mir schienen diese Fabeln etwas von Affen und Katzen, die Käse wogen, erzählen zu wollen.“"
                                            },
                                            {
                                                "example_id": "b7eee087-c8dd-40c9-903a-d5cb5b6d4251",
                                                "sense_id": "eef9727a-4874-344c-b69f-70ded568a028",
                                                "text": "„Eine sehr beliebte Gattung der Unterhaltungsliteratur waren Fabeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d10e77a3-660a-3997-99be-ac4c964602c3",
                                        "entry_id": "3fcf41ed-b7ca-30f7-a90d-8b61771e4b9c",
                                        "glosses": [
                                            "eine erfundene, erlogene Geschichte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25e04f7a-b9e9-416a-b37c-4c27ce624393",
                                                "sense_id": "d10e77a3-660a-3997-99be-ac4c964602c3",
                                                "text": "Die Frauengeschichten, mit denen er immer prahlt, gehören wohl eher ins Reich der Fabel."
                                            },
                                            {
                                                "example_id": "c511c20c-edc9-432f-8b30-434411ad3dfb",
                                                "sense_id": "d10e77a3-660a-3997-99be-ac4c964602c3",
                                                "text": "Ach, hör doch auf, solche Fabeln aufzutischen! Du hast die Arbeit schlicht und einfach nicht erledigt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ab34fde6-801f-32c8-98b9-ea075846541c",
                                        "entry_id": "3fcf41ed-b7ca-30f7-a90d-8b61771e4b9c",
                                        "glosses": [
                                            "der Verlauf der Handlung, eines Ereignisses in einem literarischen Werk"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a965a66-d723-4bc6-8688-7454a399d137",
                                                "sense_id": "ab34fde6-801f-32c8-98b9-ea075846541c",
                                                "text": "Die Fabel dieses Romans ist einfach gestrickt: Ein böser Mensch wird durch das Wunder der Liebe nach Anfangsschwierigkeiten zum Guten bekehrt."
                                            },
                                            {
                                                "example_id": "85369db4-a394-4b5d-8fea-def280f13409",
                                                "sense_id": "ab34fde6-801f-32c8-98b9-ea075846541c",
                                                "text": "„Die Fabel ist ein erotisches Intrigenstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Fabel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59a995ee-5c01-30c1-bcc0-57d456b47d78",
                                        "entry_id": "826b75be-3836-342b-89cf-e68b53411b2b",
                                        "glosses": [
                                            "deutschsprachiger Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcade27e-4916-47ed-a5b4-1cff45c42e24",
                                                "sense_id": "59a995ee-5c01-30c1-bcc0-57d456b47d78",
                                                "text": "Frau Fabel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "5125aed9-60d3-48bc-bdf1-53dc29003b3d",
                                                "sense_id": "59a995ee-5c01-30c1-bcc0-57d456b47d78",
                                                "text": "Herr Fabel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "1a05ad22-b1fd-4d83-a2db-ecc313f69efc",
                                                "sense_id": "59a995ee-5c01-30c1-bcc0-57d456b47d78",
                                                "text": "Die Fabels fliegen heute nach Sri Lanka."
                                            },
                                            {
                                                "example_id": "0ce50d82-8892-4bf3-acd1-a3c18092ec4d",
                                                "sense_id": "59a995ee-5c01-30c1-bcc0-57d456b47d78",
                                                "text": "Der Fabel trägt nie die Pullover, die die Fabel ihm strickt."
                                            },
                                            {
                                                "example_id": "b891613d-af5c-4712-a5de-1a54deb47045",
                                                "sense_id": "59a995ee-5c01-30c1-bcc0-57d456b47d78",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fabel kommt, geht der Herr Fabel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df8e3cd3-2d62-45db-b310-ac68e2ed9320",
                        "source_entry_id": "5a526e05-8e0a-33aa-8558-62de1415d338",
                        "source_sense_description": "3. Récit mensonger.",
                        "target_lang_word": "tale",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tale",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4306c952-04b6-30d6-8b64-c587274e0db6",
                                        "entry_id": "ce9ba394-ed5b-3810-a79a-18c3926ce802",
                                        "glosses": [
                                            "A rehearsal of what has occurred; narrative; discourse; statement; history; story."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ea980d1-e62e-49ad-899e-a7e53bfb87a0",
                                                "sense_id": "4306c952-04b6-30d6-8b64-c587274e0db6",
                                                "text": "the Canterbury Tales"
                                            },
                                            {
                                                "example_id": "e48cccaa-0461-42e5-b23b-9bd4f9609b4d",
                                                "sense_id": "4306c952-04b6-30d6-8b64-c587274e0db6",
                                                "text": "And every shepherd tells his tale\nUnder the hawthorn in the dale."
                                            },
                                            {
                                                "example_id": "bd5edc6a-a8fa-4934-922e-a4d4e1919a1a",
                                                "sense_id": "4306c952-04b6-30d6-8b64-c587274e0db6",
                                                "text": "But can you guess what there was in the box? Why, it was a calf's tail, and if the calf's tail had been longer this tale would have been longer too."
                                            },
                                            {
                                                "example_id": "53bc314d-76c7-465d-84cb-fa09ce254171",
                                                "sense_id": "4306c952-04b6-30d6-8b64-c587274e0db6",
                                                "text": "Barla Von: What's this? One of the Earth-clan? Ah, a very famous one, yes? You are the one called Shepard.\nBarla Von: The tale of how you survived the great tragedy on Akuze is truly remarkable. I am amazed each time I hear it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c2f0864-bd87-32cb-a965-f1f615417312",
                                        "entry_id": "ce9ba394-ed5b-3810-a79a-18c3926ce802",
                                        "glosses": [
                                            "A number told or counted off; a reckoning by count; an enumeration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1220ff7-dee1-49a3-941c-df51e6d4feac",
                                                "sense_id": "4c2f0864-bd87-32cb-a965-f1f615417312",
                                                "text": "the ignorant, […] who measure by tale, and not by weight"
                                            },
                                            {
                                                "example_id": "cde98f63-7e56-489c-aa13-eb217a467d5f",
                                                "sense_id": "4c2f0864-bd87-32cb-a965-f1f615417312",
                                                "text": "In packing, they keep a just tale of the number that every hogshead containeth ..."
                                            },
                                            {
                                                "example_id": "575874cf-e8e9-4248-ac1b-1e11496a3439",
                                                "sense_id": "4c2f0864-bd87-32cb-a965-f1f615417312",
                                                "text": "They proceeded with some rigour, these Custodiars; took written inventories, clapt-on seals, exacted everywhere strict tale and measure"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8b40e7e-3bc4-3b78-a12e-f2e9a3666be0",
                                        "entry_id": "ce9ba394-ed5b-3810-a79a-18c3926ce802",
                                        "glosses": [
                                            "The fraudulent opportunity presented by a confidence man to the mark or victim."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "125be562-19ec-38ec-9d7b-bb7369d35ef2",
                                        "entry_id": "ce9ba394-ed5b-3810-a79a-18c3926ce802",
                                        "glosses": [
                                            "An account of an asserted fact or circumstance; a rumour; a report, especially an idle or malicious story; a piece of gossip or slander; a lie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46231d09-eee3-4aaf-9766-7fcfcc61c477",
                                                "sense_id": "125be562-19ec-38ec-9d7b-bb7369d35ef2",
                                                "text": "Don't tell tales!"
                                            },
                                            {
                                                "example_id": "2238efc0-c739-48ff-8d92-a8dfb73402f3",
                                                "sense_id": "125be562-19ec-38ec-9d7b-bb7369d35ef2",
                                                "text": "“A very welcome, kind, useful present, that means to the parish. By the way, Hopkins, let this go no further. We don't want the tale running round that a rich person has arrived. Churchill, my dear fellow, we have such greedy sharks, and wolves in lamb's clothing.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71858c3a-5507-37ba-906d-915051808ff6",
                                        "entry_id": "ce9ba394-ed5b-3810-a79a-18c3926ce802",
                                        "glosses": [
                                            "Number; tally; quota."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "265a9710-36fc-4db7-afef-288c5241f1b4",
                                                "sense_id": "71858c3a-5507-37ba-906d-915051808ff6",
                                                "text": "And the tale of the bricks, which they did make heretofore, ye shall lay upon them; ye shall not diminish ought thereof: for they be idle; therefore they cry, saying, Let us go and sacrifice to our God."
                                            },
                                            {
                                                "example_id": "6f4772e0-5527-4d5b-a4ee-90c252cde0a3",
                                                "sense_id": "71858c3a-5507-37ba-906d-915051808ff6",
                                                "text": "Both number twice a day the milky dams\nAnd once she takes the tale of all the lambs."
                                            },
                                            {
                                                "example_id": "659fdcb2-3e87-4ea4-b2ac-e7f84c7af01c",
                                                "sense_id": "71858c3a-5507-37ba-906d-915051808ff6",
                                                "text": "To appease the angry god, two hundred children of the noblest families were picked out for sacrifice, and the tale of victims was swelled by not less than three hundred more who volunteered to die for the fatherland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acd430a0-c372-3321-a1a9-fb74c151c000",
                                        "entry_id": "ce9ba394-ed5b-3810-a79a-18c3926ce802",
                                        "glosses": [
                                            "Account; estimation; regard; heed."
                                        ],
