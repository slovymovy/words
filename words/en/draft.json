                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was the first overall pick in the basketball <w>draft</w> this year.",
                            "target_lang_translations": {
                                "ru": "Он был выбран под первым номером на баскетбольном <w>драфте</w> в этом году."
                            }
                        },
                        {
                            "text": "The team is looking for a new quarterback in the upcoming sports <w>draft</w>.",
                            "target_lang_translations": {
                                "ru": "Команда ищет нового квотербека на предстоящем спортивном <w>драфте</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "draft pick",
                        "sports draft"
                    ],
