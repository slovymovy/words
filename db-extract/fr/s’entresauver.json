                "senses": [
                    {
                        "sense_id": "7288b918-2767-35e4-8ec6-269215c75e3b",
                        "entry_id": "dce2dec6-9b5f-3165-9f2e-3731d7c24de4",
                        "glosses": [
                            "Se sauver mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00b1ac03-45d3-4cd2-a98c-04dc837c258e",
                                "sense_id": "7288b918-2767-35e4-8ec6-269215c75e3b",
                                "text": "Les rencontres au sommet sont des clubs de dirigeants essayant de s'entresauver."
                            },
                            {
                                "example_id": "c52fdc35-3122-4ab9-96f7-f1f50dbe1789",
                                "sense_id": "7288b918-2767-35e4-8ec6-269215c75e3b",
                                "text": "Les LG peuvent tranquillement s'entresauver et les villageois perdre beaucoup plus d'éléments si ce n'est pas beaucoup discuté."
                            },
                            {
                                "example_id": "7e5b3c05-1cb9-4ff3-8e72-4399d53a8105",
                                "sense_id": "7288b918-2767-35e4-8ec6-269215c75e3b",
                                "text": "Un profond merci à vous, chers amis, d'unir votre prière à la nôtre, en donnant chacun un peu de notre temps pour nous entraider, nous entraimer, nous \"entresauver\"..."
                            }
                        ]
