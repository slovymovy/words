                "senses": [
                    {
                        "sense_id": "cf11f130-7075-3755-98cc-63eb8fb0ea30",
                        "entry_id": "88a80e4c-9e8a-3034-9150-0ad5d88a1612",
                        "glosses": [
                            "относящийся к гостиному двору, связанный с ним"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a5fd599-6415-40ca-8a58-a7e9823d4af9",
                                "sense_id": "cf11f130-7075-3755-98cc-63eb8fb0ea30",
                                "text": "Для меня несносен этот гостинодворский обычай зазывать в лавку."
                            },
                            {
                                "example_id": "d0564768-c483-48e3-9947-d2d13f966588",
                                "sense_id": "cf11f130-7075-3755-98cc-63eb8fb0ea30",
                                "text": "Как-то раз случайно столкнулись в гостинодворской книжной лавке: тогда он сухо ответил на мой поклон, с трудом признав во мне знакомого."
                            }
                        ]
                    }
