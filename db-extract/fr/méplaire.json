                "senses": [
                    {
                        "sense_id": "1f54da26-31f8-36a9-b571-20ad73bb1bb0",
                        "entry_id": "e64dd2fa-52b4-3ede-ba66-ca0e42a53a43",
                        "glosses": [
                            "Déplaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63b6bb41-8529-4dfb-a767-409e5c44f6be",
                                "sense_id": "1f54da26-31f8-36a9-b571-20ad73bb1bb0",
                                "text": "Pour un Russe soviétisé il peut méplaire (il me déplaît à moi) de voir un homme de valeur risquer sa vie pour un tendron."
                            },
                            {
                                "example_id": "37a3ef80-fac7-4326-9232-a7b3eb586f01",
                                "sense_id": "1f54da26-31f8-36a9-b571-20ad73bb1bb0",
                                "text": "Je comprends fort bien que vous n’êtes pas fâché (vous me l’aviez dit) et qu’il ne peut vous méplaire d’aider qui le mérite."
                            }
                        ]
                    }
