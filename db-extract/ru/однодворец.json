                                        "entry_id": "292b2559-cbb2-3d9a-a4b6-dc3affab3ed5",
                                        "glosses": [
                                            "A person who owns or runs a smallholding (small farm): a minor independent farmer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c8350c6-5cd0-3911-b258-6361190e8a19",
                                        "entry_id": "292b2559-cbb2-3d9a-a4b6-dc3affab3ed5",
                                        "glosses": [
                                            "A small slaveholder: a person who owns a smallholding (small plantation with slavery)."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d222cdc-82bb-4999-91d2-2ea6e8023186",
                                                "sense_id": "0c8350c6-5cd0-3911-b258-6361190e8a19",
                                                "text": "[…] planters and smallholders alike controlled far more than their equitable share of the political power and economic resources in their communities. Because small slaveholders aspired to be planters, they did not often align themselves with the political and economic interests of nonslaveholders."
                                            }
                                        ]
                                    }
                                ]
                            }
