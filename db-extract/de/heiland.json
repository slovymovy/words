                        ],
                        "form": "den Heiland"
                    },
                    {
                        "form_id": "7eca211e-49a4-4e4c-ab90-aea8f938ae53",
                        "entry_id": "d76de35d-1e62-3af0-9cb5-5b899942cf8f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Heilande"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ff8196b-b3bb-3d98-be5e-4fc6f73db7a4",
                        "entry_id": "d76de35d-1e62-3af0-9cb5-5b899942cf8f",
                        "glosses": [
                            "Beiname für Jesus Christus"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "4e3a0b40-4519-4cb1-b1e6-08c5332d7dd3",
                                "sense_id": "7ff8196b-b3bb-3d98-be5e-4fc6f73db7a4",
                                "text": "„Trotz aller Verbrechen […] sei der Heiland in diese Welt geboren worden, unterstrich Meisner in seiner Weihnachtspredigt am Freitag im Kölner Dom.“"
                            },
                            {
                                "example_id": "c765c29d-56e1-4c2b-a730-40e2da284480",
                                "sense_id": "7ff8196b-b3bb-3d98-be5e-4fc6f73db7a4",
                                "text": "„Die glänzend gespielten Rührseligkeiten der Geschichte bearbeiteten mich, die Erzählstränge legten sich um mich wie Schlangen und zogen sich in Erwartung des Heilandes enger und enger zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "acb2b2fd-df2c-303b-a255-f7ca781dc528",
                        "entry_id": "d76de35d-1e62-3af0-9cb5-5b899942cf8f",
                        "glosses": [
                            "eine in Not helfende Person, Retter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30cd65dd-a6ed-4eda-b000-30d28fa5a0e0",
                                "sense_id": "acb2b2fd-df2c-303b-a255-f7ca781dc528",
                                "text": "„In der Sehnsucht Brasiliens nach einem neuen Heiland wurde Romario zum Nachfolger Garrinchas erkoren, jener Heldenfigur, die mit ihren krummen Beinen 1958 und 1962 die Europäer schwindlig gedribbelt hatte.“"
                            },
                            {
                                "example_id": "e3ab0dd7-3782-4e16-a9db-f8b494e03b61",
                                "sense_id": "acb2b2fd-df2c-303b-a255-f7ca781dc528",
                                "text": "„Von falschen Heilanden erwartet das Volk Rettung, nicht von eigener Erkenntnis, eigener Arbeit, eigener Verantwortung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
