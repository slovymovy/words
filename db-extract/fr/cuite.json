    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6e96f594-3efb-37f0-bf16-1314dc12e28f",
                "word": "cuite",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "84116605-4505-485c-a08e-1f3e4bf984ca",
                        "entry_id": "6e96f594-3efb-37f0-bf16-1314dc12e28f",
                        "tags": [
                            "plural"
                        ],
                        "form": "cuites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "845e3758-3628-3a5b-9bf9-233ad23bcbdb",
                        "entry_id": "6e96f594-3efb-37f0-bf16-1314dc12e28f",
                        "glosses": [
                            "batch of ore, porcelain or the like for smelting; viewed economically, the time an occurrence of smelting takes"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "360bf1b9-8bf2-4456-abf7-4ab14d8e3261",
                                "sense_id": "845e3758-3628-3a5b-9bf9-233ad23bcbdb",
                                "text": "Lorsque les grandes cuves sont pleines de lessive, on en commence les cuites. La premiere n’étant que de lessive sauvage, dure vingt-six à trente heures; mais lorsqu’on on peut remplir avec de la lessive qui a déja fourni du vitriol, alors la cuite ne dure que dix-huit à vingt heures."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a3667c7-0de6-34aa-a43d-c7e38bf65ad4",
                        "entry_id": "6e96f594-3efb-37f0-bf16-1314dc12e28f",
                        "glosses": [
                            "piss-up (UK), bender (US)"
                        ],
                        "tags": [
                            "feminine",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "f8db51b2-e8ea-4b8b-8070-2e5f971151c4",
                                "sense_id": "3a3667c7-0de6-34aa-a43d-c7e38bf65ad4",
                                "text": "J'ai pris une cuite hier soir.",
                                "translation": "I got plastered last night.",
                                "english": "I got plastered last night."
                            },
                            {
                                "example_id": "6f56bb05-e2a8-4760-9f65-9bcce6d8995c",
                                "sense_id": "3a3667c7-0de6-34aa-a43d-c7e38bf65ad4",
                                "text": "Tiens. Tu t'es déjà tapé une cuite ?"
                            },
                            {
                                "example_id": "0efcc888-ec30-41b1-8e84-16ff68e1b6ce",
                                "sense_id": "3a3667c7-0de6-34aa-a43d-c7e38bf65ad4",
                                "text": "Un café qui, comme la plupart, depuis que la ville avait été privatisée, n’était plus du tout un lieu de braillades, de petits vieux, d’échanges ou de cuites complices mais un ersatz de bureau pour travailleurs auto-entrepris.",
                                "translation": "A café which, like most of them since the city had been privatized, was no longer a place for shouting matches, little old men, conversations or people getting plastered together, but an ersatz office for self-employed workers.",
                                "english": "A café which, like most of them since the city had been privatized, was no longer a place for shouting matches, little old men, conversations or people getting plastered together, but an ersatz office for self-employed workers."
                            },
                            {
                                "example_id": "9d0f7ab1-e62f-410e-be81-adc600b3a321",
                                "sense_id": "3a3667c7-0de6-34aa-a43d-c7e38bf65ad4",
                                "text": "Longtemps j'ai cru que la vie était une fête ; passé la cinquantaine, la vie est un interminable lendemain de cuite."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
