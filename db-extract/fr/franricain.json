                    }
                ],
                "senses": [
                    {
                        "sense_id": "ada9dc22-693b-37e9-aee1-b63f54ddf9d2",
                        "entry_id": "5dba4174-65e3-3382-9cb9-641fa41a5be5",
                        "glosses": [
                            "Façon de parler qui consiste à mélanger le français et des termes ou expressions issus de la variété d’anglais parlée aux États-Unis, souvent de manière spontanée ou informelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c77705e-0d3b-467d-85cd-8a862cc3e8b6",
                                "sense_id": "ada9dc22-693b-37e9-aee1-b63f54ddf9d2",
                                "text": "Dans les quartiers multiculturels de Montréal, on entend souvent un mélange de français et d'anglais qu'on pourrait qualifier de franricain."
                            },
                            {
                                "example_id": "7c427304-ddad-49ef-b43f-58834d9e074b",
                                "sense_id": "ada9dc22-693b-37e9-aee1-b63f54ddf9d2",
                                "text": "Le franricain est souvent perçu comme une manifestation linguistique de l'influence culturelle nord-américaine sur les jeunes francophones."
                            },
                            {
                                "example_id": "780ef51a-8512-4fd0-b018-8ba079a2e089",
                                "sense_id": "ada9dc22-693b-37e9-aee1-b63f54ddf9d2",
                                "text": "Mon cousin parle un franricain bizarre depuis qu’il vit à Miami : 'Je vais driver ma car au store'."
                            }
                        ]
                    }
                ],
