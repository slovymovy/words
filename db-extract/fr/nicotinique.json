        "fr-extract.jsonl": [
            {
                "entry_id": "098317c1-7889-3cde-9156-abc9bf8c39b4",
                "word": "nicotinique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "42c76991-21d9-442c-9b1d-bbafa3eb0d08",
                        "entry_id": "098317c1-7889-3cde-9156-abc9bf8c39b4",
                        "tags": [
                            "plural",
                            "masculine",
