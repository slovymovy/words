                        "procession silencieuse"
                    ]
                },
                {
                    "sense_id": "b1035eda-b30f-33b6-bd59-2a71ebafad49",
                    "sense_definition": "Arrivée ou passage ininterrompu de personnes qui se succèdent à intervalles rapprochés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis ce matin, c'est une véritable <w>procession</w> de voisins venus féliciter les jeunes mariés."
                        },
                        {
                            "text": "Le médecin a vu une <w>procession</w> de patients inquiets défiler toute la journée dans son cabinet."
