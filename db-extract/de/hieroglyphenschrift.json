                ],
                "senses": [
                    {
                        "sense_id": "fe462f81-06bc-3db1-a461-8bcf9825abe0",
                        "entry_id": "1a9ed195-9eb9-3a51-a5d4-df402d6bbd1d",
                        "glosses": [
                            "Schrift, bestehend aus Hieroglyphen, das heißt überwiegend aus Zeichen in Form von schematischen Bildern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b71295-dc43-4979-b86a-794e16515e71",
                                "sense_id": "fe462f81-06bc-3db1-a461-8bcf9825abe0",
                                "text": "Die ägyptische Hieroglyphenschrift wurden vor etwa 3000 v. Chr. in Ägypten sowie Nubien eingeführt."
                            },
                            {
                                "example_id": "156c3289-513a-4e6f-89df-a4b3c1d09a2d",
                                "sense_id": "fe462f81-06bc-3db1-a461-8bcf9825abe0",
                                "text": "„Entziffert wurde die Hieroglyphenschrift mit Hilfe des Steins von Rosette, der 1799 im Nildelta ausgegraben wurde.“"
                            },
                            {
                                "example_id": "5649b022-84c0-476c-9855-281dba779121",
                                "sense_id": "fe462f81-06bc-3db1-a461-8bcf9825abe0",
                                "text": "„Die Geschichte des Alten Ägypten wäre wohl zum größten Teil unbekannt gebllieben, hätten nicht Jean-François Champollion und die Ägyptologen das Geheimnis der Hieroglyphenschrift gelüftet.“"
                            },
                            {
                                "example_id": "151ecef8-782d-4b0c-b01c-78a7c7ab9855",
                                "sense_id": "fe462f81-06bc-3db1-a461-8bcf9825abe0",
                                "text": "„Die Zerstörung des Serapeums signalisierte das Ende des heidnischen Ägypten und bedeutete gleichzeitig das Ende der Hieroglyphenschrift.“"
                            },
                            {
                                "example_id": "e70cfbf4-3e41-41d6-85f3-8228cc6c4c30",
                                "sense_id": "fe462f81-06bc-3db1-a461-8bcf9825abe0",
                                "text": "„Als in den ersten Jahrhunderten unserer Zeitrechnung in Ägypten, das mittlerweile zu einer Provinz des römischen Imperiums hinabgesunken war, das Christentum Einzug hielt, geriet mit der alten Religion auch die Hieroglyphenschrift in Vergessenheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
