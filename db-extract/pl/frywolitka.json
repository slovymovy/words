                    {
                        "translation_id": "ba649316-d0fb-4c98-88e7-b4a4ea87e28a",
                        "source_entry_id": "32a0a066-ce8d-37f5-a8f0-3ee664fffe8e",
                        "source_sense_id": "88c3549d-7f50-3e15-b00b-b536a7d56646",
                        "target_lang_word": "lace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02cc42e9-d616-3e58-9e54-a2d7003562e2",
                                        "entry_id": "cc711a89-735a-3233-9f69-3fb0016e77f1",
                                        "glosses": [
                                            "A light fabric containing patterns of holes, usually built up from a single thread."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01658309-042b-4ffb-b730-775650747c1b",
                                                "sense_id": "02cc42e9-d616-3e58-9e54-a2d7003562e2",
                                                "text": "c. 1620, Francis Bacon, letter of advice to Sir George Villiers\nOur English dames are much given to the wearing of very fine and costly laces."
                                            },
                                            {
                                                "example_id": "170987c4-df3a-4d96-b84e-f3bfef0a07f6",
                                                "sense_id": "02cc42e9-d616-3e58-9e54-a2d7003562e2",
                                                "text": "She was a fat, round little woman, richly apparelled in velvet and lace, […]; and the way she laughed, cackling like a hen, the way she talked to the waiters and the maid,[…]—all these unexpected phenomena impelled one to hysterical mirth, and made one class her with such immortally ludicrous types as Ally Sloper, the Widow Twankey, or Miss Moucher."
                                            },
                                            {
                                                "example_id": "35994a06-74cd-4566-9692-a64ecb636415",
                                                "sense_id": "02cc42e9-d616-3e58-9e54-a2d7003562e2",
                                                "text": "Mind you, clothes were clothes in those days. […] Frills, ruffles, flounces, lace, complicated seams and gores: not only did they sweep the ground and have to be held up in one hand elegantly as you walked along, but they had little capes or coats or feather boas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c7fb9d5-a026-3559-ad82-bdb7cd2955a1",
                                        "entry_id": "cc711a89-735a-3233-9f69-3fb0016e77f1",
                                        "glosses": [
                                            "A cord or ribbon passed through eyelets in a shoe or garment, pulled tight and tied to fasten the shoe or garment firmly."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1f54ad6-041b-45a7-98c5-ca5cfe28beb8",
                                                "sense_id": "0c7fb9d5-a026-3559-ad82-bdb7cd2955a1",
                                                "text": "your laces are untied, do them up!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "194c893f-3415-3b69-a1b5-f55257505686",
                                        "entry_id": "cc711a89-735a-3233-9f69-3fb0016e77f1",
                                        "glosses": [
                                            "A snare or gin, especially one made of interwoven cords; a net."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6577eb23-e755-4f19-9291-482df4e36b3d",
                                                "sense_id": "194c893f-3415-3b69-a1b5-f55257505686",
                                                "text": "The king had ſnared been in loues ſtrong lace, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ccb5b34-784d-3431-9100-053503ec37c3",
                                        "entry_id": "cc711a89-735a-3233-9f69-3fb0016e77f1",
                                        "glosses": [
                                            "Spirits added to coffee or another beverage."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52052966-7645-4d3e-8098-6931ce5c0990",
                                                "sense_id": "3ccb5b34-784d-3431-9100-053503ec37c3",
                                                "text": "He is forced every Morning to drink his Dish of Coffee by itself, without the Addition of the Spectator, that used to be better than Lace to it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
