                        "entry_id": "bb3af822-2b28-3213-8209-e4856b7092fd",
                        "glosses": [
                            "Clade de tétrapodes bipèdes comprenant la quasi-totalité des dinosaures prédateurs et l'unique clade actuel des oiseaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d928da38-113b-4443-a0c2-f06906c8f657",
                                "sense_id": "ffd58f7b-55e4-3b5c-a821-aa4792cc4cd0",
                                "text": "Le paléontologue Rodrigo Müller et ses collègues de l’Universidade Federal de Santa Maria ont mis au jour le fémur d’un théropode prédateur qui vivait il y a entre 233 et 225 millions d'années."
                            },
                            {
                                "example_id": "459c6f0b-fcdf-4bf9-aaf4-8ec9d75f1af8",
                                "sense_id": "ffd58f7b-55e4-3b5c-a821-aa4792cc4cd0",
                                "text": "Le Musée national de Rio de Janeiro a annoncé jeudi la découverte d'une nouvelle espèce de dinosaure « très rare », un théropode sans dents qui vivait dans le sud du Brésil il y a 70 à 80 millions d'années."
                            }
                        ]
                    }
