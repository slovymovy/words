                        "entry_id": "38b72a42-da6a-3677-ab1c-762b0a095094",
                        "glosses": [
                            "The condition of being deniable."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "699252f9-754b-47c6-9059-9edab38fd907",
                                "sense_id": "1c1e0652-8572-3289-8eb9-3f196277e03d",
                                "text": "No longer is plausible deniability acceptable, either for boards or for management. Corporate and nonprofit boards alike are expected to know of problems that are brewing deep within their organizations."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee445b1b-80ce-3c56-bc5d-a1b5b5f69664",
                        "entry_id": "38b72a42-da6a-3677-ab1c-762b0a095094",
                        "glosses": [
                            "The extent to which something is deniable."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "b0e2e4f8-14e0-40cb-8e74-ab5dd798a5bc",
                                "sense_id": "ee445b1b-80ce-3c56-bc5d-a1b5b5f69664",
                                "text": "These infamous little green men appeared during the decisive seizures or buildings and facilities, only to disappear when associated militias and local troops arrived to consolidate the gains. In this way they provided a measure of deniability—however superficial or implausible—for Moscow.⁴⁰"
                            }
                        ]
                    }
