                "senses": [
                    {
                        "sense_id": "6a097659-673f-31ea-91e8-0797cdde7b1c",
                        "entry_id": "4536480b-75fa-3475-8108-457d5fb42b56",
                        "glosses": [
                            "Späher im Ausguck auf dem Mast eines Schiffes; Segelsetzer"
                        ],
                        "tags": [
                            "allgemeiner"
                        ],
                        "examples": [
                            {
                                "example_id": "33d42067-8313-4379-b657-770ace96169f",
                                "sense_id": "6a097659-673f-31ea-91e8-0797cdde7b1c",
                                "text": "„Die Mannschaft war mit der Festmachung der Segel beschäftigt, als der Marsgast, der das Nockrohr des Steuerbordshauptmarssegels zu befestigen hatte, das Gleichgewicht verlor.“"
                            },
                            {
                                "example_id": "ca07dd5d-8328-4e36-bd39-361340b0ad5b",
                                "sense_id": "6a097659-673f-31ea-91e8-0797cdde7b1c",
                                "text": "„Beim heftig stampfenden Schiff mussten die Offiziere die Marsgasten unter Androhung strenger Strafen in die Wanten treiben.“"
                            },
                            {
                                "example_id": "e06a3082-cb6b-4bb4-aa1f-b17a386d8898",
                                "sense_id": "6a097659-673f-31ea-91e8-0797cdde7b1c",
                                "text": "„Sie schauten hoch in den Hauptmast und erkannten, dass es der Marsgast war, der dort oben im Mastkorb mit den Armen winkte.“"
                            },
                            {
                                "example_id": "5578b2f0-cb49-4611-8938-2b9b2385cc16",
                                "sense_id": "6a097659-673f-31ea-91e8-0797cdde7b1c",
                                "text": "„Der Marsgast im Krähennest schreit sich die Stimme heiser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
