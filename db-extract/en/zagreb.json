                    {
                        "translation_id": "4a457265-2eeb-46a7-b0b8-a0a698435054",
                        "source_entry_id": "ed59dc0a-66ec-3110-922b-8317d0a17ce2",
                        "source_sense_description": "capital of Croatia",
                        "target_lang_word": "За́греб",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "За́греб",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5ef5d46c-a175-3d47-a5a6-c22ba253b709",
                                        "entry_id": "b9d27c9f-07ac-37e4-ada5-9c212bbc16a7",
                                        "glosses": [
                                            "столица Хорватии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e20ece6a-9561-4a6d-9454-e98b2584bf20",
                                                "sense_id": "5ef5d46c-a175-3d47-a5a6-c22ba253b709",
                                                "text": "По справедливости оценив перспективы хорватских курортов и понимая, что рейсовых самолетов в Загреб может быть недостаточно, многие российские турфирмы и авиакомпании заказывают в Хорватию чартерные рейсы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a02aca4-3cc0-3f96-9948-742a0bf86ad6",
                                        "entry_id": "b9d27c9f-07ac-37e4-ada5-9c212bbc16a7",
                                        "glosses": [
                                            "перен. полит. правительство Хорватии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "891a883f-1cb3-4a63-b048-e2157041e286",
                                                "sense_id": "3a02aca4-3cc0-3f96-9948-742a0bf86ad6",
                                                "text": "Официальный Загреб, впрочем, пытается сгладить ситуацию. Министр иностранных дел Хорватии Весна Пусич, в частности, сославшись на информацию, полученную по дипломатическим каналам, сообщила, что отсутствие Меркель на торжествах не вызвано политическими причинами."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
