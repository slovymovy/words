    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "241bbd9c-c8c6-3abd-a45c-f69379208893",
                "word": "companionable",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e9e1543a-4fc7-4811-925c-36571ad719d1",
                        "entry_id": "241bbd9c-c8c6-3abd-a45c-f69379208893",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more companionable"
                    },
                    {
                        "form_id": "ed2e0e61-461f-49d8-8690-c37e6b880ccb",
                        "entry_id": "241bbd9c-c8c6-3abd-a45c-f69379208893",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most companionable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9297a1c7-a217-37c7-b43c-27d20c17ff17",
                        "entry_id": "241bbd9c-c8c6-3abd-a45c-f69379208893",
                        "glosses": [
                            "Having the characteristics of a worthy companion; friendly and sociable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72c2eae3-a1aa-4ce6-bc50-2782392d5127",
                                "sense_id": "9297a1c7-a217-37c7-b43c-27d20c17ff17",
                                "text": "She returned presently, bringing a smoking basin and a basket of work; and, having placed the former on the hob, drew in her seat, evidently pleased to find me so companionable."
                            },
                            {
                                "example_id": "8af16e75-038f-49e4-9e01-c4740431379c",
                                "sense_id": "9297a1c7-a217-37c7-b43c-27d20c17ff17",
                                "text": "I love to be alone. I never found the companion that was so companionable as solitude."
                            },
                            {
                                "example_id": "693b75c8-9af6-4cbc-bbaf-91f42bfb6cb0",
                                "sense_id": "9297a1c7-a217-37c7-b43c-27d20c17ff17",
                                "text": "All the disagreeable circumstances of my prison had become, as it were, to me friendly and companionable; not one of them gave me annoyance."
                            },
                            {
                                "example_id": "e4f2400e-7bd1-4086-abda-056b07af4233",
                                "sense_id": "9297a1c7-a217-37c7-b43c-27d20c17ff17",
                                "text": "Then he strolled back again, kicking his heels carelessly, and a companionable silence fell between the three men."
                            },
                            {
                                "example_id": "ead8af3b-3d30-4183-90d4-79e91e1bdfb2",
                                "sense_id": "9297a1c7-a217-37c7-b43c-27d20c17ff17",
                                "text": "They are a companionable food; they make a pleasant, crunching noise when they are bitten, and so, when one is eating carrots, one can listen to the sound of one's eating and make a story from it."
                            },
                            {
                                "example_id": "da90e7c7-857c-461a-a3ea-0307d648fa25",
                                "sense_id": "9297a1c7-a217-37c7-b43c-27d20c17ff17",
                                "text": "Bottles of rye, purgative waters and eaux for every conceivable toilette made a companionable click in his worn carpet bag."
                            },
                            {
                                "example_id": "eac62dee-fa56-4144-85f5-48f0323dfe60",
                                "sense_id": "9297a1c7-a217-37c7-b43c-27d20c17ff17",
                                "text": "The up and down lines ran next to each other in vault-like tunnels, whereas the Tube trains would occupy their own tunnels. That's why the cut-and-cover lines are more human than the Tubes. They are more companionable. You can see people going the other way - your perspective is broadened."
                            }
                        ]
                    }
                ],
