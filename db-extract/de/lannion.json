                                "target_senses": [
                                    {
                                        "sense_id": "6d5e6984-35d3-3c49-8876-76e6cf8a60bd",
                                        "entry_id": "c413286e-c4f0-3183-b279-920da04c8676",
                                        "glosses": [
                                            "Commune française, située dans le département des Côtes-d’Armor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a02fcac-e908-4ede-8d36-5362678c0b6d",
                                                "sense_id": "6d5e6984-35d3-3c49-8876-76e6cf8a60bd",
                                                "text": "Mais, comme disaient les gens de Lannion, c’était trop beau pour durer."
                                            },
                                            {
                                                "example_id": "a36e5784-8b33-4a9f-94c2-c7f62d8d4447",
                                                "sense_id": "6d5e6984-35d3-3c49-8876-76e6cf8a60bd",
                                                "text": "Lannion avec le bruit, dans son silence villageois, du coche suivi de la mouche."
                                            },
                                            {
                                                "example_id": "a7484ce8-f1b2-4335-8dab-7aad6402de5e",
                                                "sense_id": "6d5e6984-35d3-3c49-8876-76e6cf8a60bd",
                                                "text": "Dans cette formule « one way », il est possible de louer son vélo à Morlaix et de le laisser à Lannion, Roscoff, Saint-Brieuc, Brest, Quimper ou Pontivy."
                                            },
                                            {
                                                "example_id": "5f7aa001-bd0c-4256-a7b7-390c075921c5",
                                                "sense_id": "6d5e6984-35d3-3c49-8876-76e6cf8a60bd",
                                                "text": "Vers Locquirec, Guimaëc et Lanmeur, les voyageurs peuvent emprunter la ligne 30, qui dessert aussi Lannion (sept allers-retours)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdcf449d-6578-3235-9f0b-8f8a98d8be37",
