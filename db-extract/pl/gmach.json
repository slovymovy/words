                "senses": [
                    {
                        "sense_id": "5c24d673-7f01-342a-afac-c5b043bd3a11",
                        "entry_id": "afac3518-0f7c-30ce-8961-4f789f90bd5a",
                        "glosses": [
                            "okazały budynek w którym znajduje się zwykle ważna instytucja"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "043230ee-8e04-41f5-ba4e-b89dc52411fb",
                                "sense_id": "5c24d673-7f01-342a-afac-c5b043bd3a11",
                                "text": "Na rogu naszej ulicy znajduje się okazały gmach sądu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8ce7c9be-1ef7-3b44-ba97-f73603b9c42f",
                        "entry_id": "afac3518-0f7c-30ce-8961-4f789f90bd5a",
                        "glosses": [
                            "o zjawiskach społecznych lub abstrakcyjnych: ogromna, złożona struktura"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "527e137a-79eb-3622-a95a-f4cf125fc0b1",
                        "entry_id": "afac3518-0f7c-30ce-8961-4f789f90bd5a",
                        "glosses": [
                            "podniośle o budowie, konstrukcji, dziele"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "f4844e2f-d242-43e4-bcd0-da83c7fe0000",
                                "sense_id": "527e137a-79eb-3622-a95a-f4cf125fc0b1",
                                "text": "Fundamentem tego gmachu duchownego jest rozmyślanie; bo jako fundament utrzymuje i dźwiga budynek cały, tak to rozmyślanie utrzymuje i dźwiga cały gmach duchowny"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "4cea3970-6b0e-3cde-a0da-cd49fd5e724d",
                        "entry_id": "afac3518-0f7c-30ce-8961-4f789f90bd5a",
                        "glosses": [
                            "każda izba lub mieszkanie"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c66f742a-9335-4046-a3da-dd0ad007aa18",
                        "source_entry_id": "afac3518-0f7c-30ce-8961-4f789f90bd5a",
                        "source_sense_id": "5c24d673-7f01-342a-afac-c5b043bd3a11",
