                "senses": [
                    {
                        "sense_id": "6210b9a7-1f11-305b-aa07-cab47885dddd",
                        "entry_id": "e81de621-e153-346a-b31d-35f437fe6185",
                        "glosses": [
                            "Utiliser l'internet, surfer sur l'internet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34757b86-bb05-4a19-8131-756d8999cbe2",
                                "sense_id": "6210b9a7-1f11-305b-aa07-cab47885dddd",
                                "text": "S'il s'agit d'une ligne ADSL non dégroupée, il est encore possible simultanément d'interneter et de télécopier par la voie « téléphone », c'est à dire en aval des filtres ADSL, comme avec tout bon combiné téléphonique."
                            },
                            {
                                "example_id": "85573ee0-0c76-4bf3-bece-88b994798205",
                                "sense_id": "6210b9a7-1f11-305b-aa07-cab47885dddd",
                                "text": "Super Stéph va faire quelques courses et interneter."
                            },
                            {
                                "example_id": "2a537b0c-8cbc-440f-88e8-45668aaae19d",
                                "sense_id": "6210b9a7-1f11-305b-aa07-cab47885dddd",
                                "text": "Au fait, on peut \"interneter\" à l'hosto :?:"
                            },
                            {
                                "example_id": "2adf16ba-c27a-4c73-a861-99f4598df730",
                                "sense_id": "6210b9a7-1f11-305b-aa07-cab47885dddd",
                                "text": "Loisirs: dur comme question... manger, dormir, interneter!"
                            }
                        ]
                    },
