                                ]
                            },
                            {
                                "target_word": "trigo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d5b27b7-9b9c-3688-816a-42d579498885",
                                        "entry_id": "12119148-d5d2-3b65-9a58-70c3e4e957ae",
                                        "glosses": [
                                            "Abréviation de trigonométrie."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "268a57f3-66dd-4a63-a64c-61fb9d52330f",
                                                "sense_id": "0d5b27b7-9b9c-3688-816a-42d579498885",
                                                "text": "« Il faudra tout de même que je finisse mon problème de trigo », se dit-il. Et il s’efforça de ne plus penser qu’à son travail."
                                            },
                                            {
                                                "example_id": "4dbdeae0-ba36-4cf0-a267-db8e77213138",
                                                "sense_id": "0d5b27b7-9b9c-3688-816a-42d579498885",
                                                "text": "– Tu prépareras les exercices de trigo que je t’ai indiqués."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
