    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f86373ce-7a53-3d5a-b0b9-591557002268",
                "word": "toom",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8350c520-e016-45b7-b012-27f2ea8c0ea0",
                        "entry_id": "f86373ce-7a53-3d5a-b0b9-591557002268",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more toom"
                    },
                    {
                        "form_id": "f6399b23-eb63-497d-a820-a09dd2c9e186",
                        "entry_id": "f86373ce-7a53-3d5a-b0b9-591557002268",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most toom"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "db730970-1a8f-3526-a625-c6feda5ec439",
                        "entry_id": "f86373ce-7a53-3d5a-b0b9-591557002268",
                        "glosses": [
                            "Empty; bare."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland",
                            "dialectal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f7aa34ad-9ec0-4560-8313-6add7e8d29ee",
                                "sense_id": "db730970-1a8f-3526-a625-c6feda5ec439",
                                "text": "Gin she was toom afore, she's toomer now,\nHer heart was like to loup out at her mou'."
                            },
                            {
                                "example_id": "33cd4d12-f87f-4908-b5b0-63749492e775",
                                "sense_id": "db730970-1a8f-3526-a625-c6feda5ec439",
                                "text": "Then hie to the Custom House, add to your pleasures, Now you're well cover'd, so toom the new measures: It ne'er will be finish'd, I'll wager a groat, Till they've cut a canal te admit five-men boats!"
                            },
                            {
                                "example_id": "d044209e-bddb-4cd7-8265-2d5c61dfc12c",
                                "sense_id": "db730970-1a8f-3526-a625-c6feda5ec439",
                                "text": "Every time Gavin's cup went to his lips Nanny calculated (correctly) how much he had drunk, and yet, when the right moment arrived, she asked in the English voice that is fashionable at ceremonies, \"if his cup was toom.\""
                            },
                            {
                                "example_id": "ddfdadd5-d86d-4d1f-ae23-39c2b5951bb8",
                                "sense_id": "db730970-1a8f-3526-a625-c6feda5ec439",
                                "text": "\"You saw it was toom. The lamp had gone out itself, or else — what's that?\""
                            },
                            {
                                "example_id": "25c5c77d-b8d3-4d6b-aab7-27b6e1d680a5",
                                "sense_id": "db730970-1a8f-3526-a625-c6feda5ec439",
                                "text": "It seemed to him that his soul had gone from him, and he was as toom as a hazel shell."
                            },
                            {
                                "example_id": "6d00a090-58bc-40cf-85a6-8a27eb3eaa7a",
                                "sense_id": "db730970-1a8f-3526-a625-c6feda5ec439",
                                "text": "Bare is much better. 'When she got there, the cupboard was bare' does call up the distress of those with naked larders. 'The cupboard was empty' would not be poignant at all. But 'the cupboard was toom' would utter the voice of real despair."
                            },
                            {
                                "example_id": "96743e23-7afe-4ab0-912b-0f1d388245f4",
                                "sense_id": "db730970-1a8f-3526-a625-c6feda5ec439",
                                "text": "His tabard was 'toom' — bare or empty — and Balliol, the unmade king, became 'Toom Tabard'."
                            }
                        ]
                    }
                ],
