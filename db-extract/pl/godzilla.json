                        "entry_id": "5805d3a1-327a-3d10-bab9-bd27ba378f9e",
                        "glosses": [
                            "gigantyczny, fantastyczny potwór z japońskiej serii komiksów i filmów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89dce11d-441d-43e7-b3b6-a64b53584456",
                                "sense_id": "3d083760-2e27-319e-a819-d8e1ce2ce80c",
                                "text": "Pojawił się potwór! To Godzilla!"
                            },
                            {
                                "example_id": "e94cdc2f-d2e1-4a21-bfc1-c50614c36be4",
                                "sense_id": "3d083760-2e27-319e-a819-d8e1ce2ce80c",
                                "text": "Popełniliśmy błąd pięćdziesiąt lat temu, kiedy próby jądrowe stworzyły Godzillę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
