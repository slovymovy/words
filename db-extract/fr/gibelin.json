                "senses": [
                    {
                        "sense_id": "662880c3-0ad4-3a4e-aacf-87eb8199c6fb",
                        "entry_id": "a2123f3e-abc0-304d-a02e-0202992ba59c",
                        "glosses": [
                            "Qui soutient l’empereur d'Allemagne, et s’oppose aux Guelfes partisans du pape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f5af0e5-0037-45c3-b26d-2e771d06cb10",
                                "sense_id": "662880c3-0ad4-3a4e-aacf-87eb8199c6fb",
                                "text": "Qu’on interroge la poésie, le premier chant de la muse nationale fut l’épopée gibeline de Dante, et, depuis, la littérature, au-delà des monts, se développa en maudissant les papes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bb22b9a-09c4-4afb-a4e0-e5399a093a04",
                        "source_entry_id": "a2123f3e-abc0-304d-a02e-0202992ba59c",
                        "source_sense_id": "662880c3-0ad4-3a4e-aacf-87eb8199c6fb",
                        "target_lang_word": "staufisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "staufisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "40047b13-b7d5-334c-a66d-98ad772d4cf6",
                                        "entry_id": "f2fae130-8f16-33ae-b936-7cc9e2885c85",
                                        "glosses": [
                                            "das Adelsgeschlecht der Staufer betreffend, zur Familie der Staufer gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05849800-8346-49dc-b98f-0361458c83e6",
                                                "sense_id": "40047b13-b7d5-334c-a66d-98ad772d4cf6",
                                                "text": "„Als Kaiserin war es ihr nach langem Warten endlich vergönnt, ihre Aufgabe zu erfüllen, dem kaiserlichen Gemahl einen Thronfolger zu bescheren, in dem der normannische Großvater Roger und der staufische Großvater Friedrich Barbarossa wiederaufleben sollten.“"
                                            },
                                            {
                                                "example_id": "00e2cb6e-0723-4619-b433-e55f5502a773",
                                                "sense_id": "40047b13-b7d5-334c-a66d-98ad772d4cf6",
                                                "text": "„Die Geschichte der staufischen Herrscher hat nicht nur die deutschen Mittelalterhistoriker im 19. Jahrhundert mächtig bewegt, sondern auch viele Dichter und Schriftsteller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
