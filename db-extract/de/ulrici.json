                "senses": [
                    {
                        "sense_id": "2a0a3cf1-3a77-3ef1-960d-0568c1dd25b7",
                        "entry_id": "eda5e59f-4d8c-3ba4-9772-8b84636fceeb",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bcbaa7b-27c8-4f41-9456-89076d63d1dd",
                                "sense_id": "2a0a3cf1-3a77-3ef1-960d-0568c1dd25b7",
                                "text": "Frau Ulrici ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ca09fc25-127e-46b2-b62f-917ac6d053c2",
                                "sense_id": "2a0a3cf1-3a77-3ef1-960d-0568c1dd25b7",
                                "text": "Herr Ulrici wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "055291b1-cd49-4801-a01f-da467172c000",
                                "sense_id": "2a0a3cf1-3a77-3ef1-960d-0568c1dd25b7",
                                "text": "Die Ulricis fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "81807d30-2d36-451a-8fec-2d2679d2f3ec",
                                "sense_id": "2a0a3cf1-3a77-3ef1-960d-0568c1dd25b7",
                                "text": "Der Ulrici trägt nie die Schals, die die Ulrici ihm strickt."
                            },
                            {
                                "example_id": "b70208d0-ae51-40b5-b6ba-7c3a16ec2e45",
                                "sense_id": "2a0a3cf1-3a77-3ef1-960d-0568c1dd25b7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ulrici kommt, geht der Herr Ulrici.“"
                            },
                            {
                                "example_id": "62b08b43-5b0c-4b90-9ae9-f7513cd88baa",
                                "sense_id": "2a0a3cf1-3a77-3ef1-960d-0568c1dd25b7",
                                "text": "Ulrici kommt und geht."
                            },
                            {
                                "example_id": "b40b2fdc-0eca-408a-8dd0-cb16102492a7",
                                "sense_id": "2a0a3cf1-3a77-3ef1-960d-0568c1dd25b7",
                                "text": "Ulricis kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
