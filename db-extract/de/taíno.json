                "senses": [
                    {
                        "sense_id": "eef2da22-4d6b-35fd-98fe-8a2db54c2922",
                        "entry_id": "c00a4211-4da4-3300-83ed-f30d72e53395",
                        "glosses": [
                            "ausgestorbene Sprache, die vom gleichnamigen Volk auf den Karibischen Inseln gesprochen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed78089e-12ac-47b8-ac37-b2a11dc887d2",
                                "sense_id": "eef2da22-4d6b-35fd-98fe-8a2db54c2922",
                                "text": "„Zudem gibt es auch wichtige Begriffe aus dem Náhuatl, so wie cacao, chocolate und tomate, und aus dem Taíno, der Sprache der Taíno-indígenas, die ursprünglich aus dem Gebiet des heutigen Venezuela kamen, sich dann aber hauptsächlich auf den karibischen Antillen niederließen. Aus dieser Sprache kommen Wörter wie batata (Süßkartoffel), maíz, und tiburón (Hai)“"
                            },
                            {
                                "example_id": "eab8daac-01b4-4201-8cfc-625201fece8d",
                                "sense_id": "eef2da22-4d6b-35fd-98fe-8a2db54c2922",
                                "text": "Barbecue ist von einem Wort im Taíno entlehnt, das „Holzrost“ bedeutet."
                            }
                        ],
