                                "target_senses": [
                                    {
                                        "sense_id": "2e4c0714-f38d-31d8-a0e5-6dc079c4e263",
                                        "entry_id": "7eb66826-362d-3983-9029-3015b6820847",
                                        "glosses": [
                                            "The act of reserving, withholding or keeping back."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4057045-3210-45ce-90b4-eaf53903560a",
                                                "sense_id": "2e4c0714-f38d-31d8-a0e5-6dc079c4e263",
                                                "text": "The committee authorised the reservation of funds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bfee036-890e-3000-9508-49a9363b1e29",
                                        "entry_id": "7eb66826-362d-3983-9029-3015b6820847",
                                        "glosses": [
                                            "The act of reserving, withholding or keeping back.",
                                            "The practice of reserving part of the consecrated bread of the Eucharist for the communion of the sick."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c07ecab-fb12-3981-a053-1b2062bef9e2",
                                        "entry_id": "7eb66826-362d-3983-9029-3015b6820847",
                                        "glosses": [
                                            "The act of reserving, withholding or keeping back.",
                                            "The act of the pope to reserve to himself the right to nominate to certain benefices."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c961225b-f252-30c5-b316-0c09887dfb3b",
                                        "entry_id": "7eb66826-362d-3983-9029-3015b6820847",
                                        "glosses": [
                                            "Something that is withheld or kept back."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8dde3b1-8286-33cc-8395-e29719e993b6",
                                        "entry_id": "7eb66826-362d-3983-9029-3015b6820847",
                                        "glosses": [
                                            "A limiting qualification regarding certainty or risk; a doubt or concern."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08cbbb95-ea28-46b7-9b60-a97a714f98be",
                                                "sense_id": "b8dde3b1-8286-33cc-8395-e29719e993b6",
                                                "text": "I have reservations about your intentions."
                                            },
                                            {
                                                "example_id": "f267f2c4-db56-4097-a4f6-f99fcbd95e1a",
                                                "sense_id": "b8dde3b1-8286-33cc-8395-e29719e993b6",
                                                "text": "I have some reservations about cosigning a loan for him."
                                            },
                                            {
                                                "example_id": "cc5fdeff-8d77-4200-ac66-456f8429a951",
                                                "sense_id": "b8dde3b1-8286-33cc-8395-e29719e993b6",
                                                "text": "Apart from the problemette with the punchy bits, I've got only one reservation with the game and that's that the tie-in element is a bit shaky to say the least."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c28dc879-2f62-3c54-b7f9-8d1c038d0e94",
                                        "entry_id": "7eb66826-362d-3983-9029-3015b6820847",
                                        "glosses": [
                                            "A tract of land set apart by the US government for the use of a Native American people, such as the Hopi Reservation or the Navajo Nation's territory."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5df8bc38-a46b-388b-9df3-2638d2375b66",
                                        "entry_id": "7eb66826-362d-3983-9029-3015b6820847",
                                        "glosses": [
                                            "An arrangement by which accommodation or transport arrangements are secured in advance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14e3363f-4526-4208-af7a-30323d5b71d0",
                                                "sense_id": "5df8bc38-a46b-388b-9df3-2638d2375b66",
                                                "text": "I have a hotel reservation in the name of Mr Smith."
                                            },
                                            {
                                                "example_id": "36cecef2-9acf-49ee-a919-4ae7a5fcaec9",
                                                "sense_id": "5df8bc38-a46b-388b-9df3-2638d2375b66",
                                                "text": "I haven't booked, so I don't have a clue as to whether the service will be busy or not. Supposedly, reservations are compulsory, but I want to find out what would happen if you just turn up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25ca5151-af3e-3dcc-8195-e3f38511ba45",
                                        "entry_id": "7eb66826-362d-3983-9029-3015b6820847",
                                        "glosses": [
                                            "The area which separates opposing lanes of traffic on a divided motorway or dual carriageway."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99525433-7402-4138-a7b5-f8646174dff6",
                                                "sense_id": "25ca5151-af3e-3dcc-8195-e3f38511ba45",
                                                "text": "A vehicle crashed through the central reservation into the path of oncoming traffic."
                                            },
                                            {
                                                "example_id": "1d47ddbf-cd22-444e-a826-17f2ec07cb4e",
                                                "sense_id": "25ca5151-af3e-3dcc-8195-e3f38511ba45",
                                                "text": "A three-lane motorway can be up to (or even more than) 35 metres wide, with a hard shoulder on either side and a central reservation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffe5482b-b067-3346-bbd2-36a2dda09979",
                                        "entry_id": "7eb66826-362d-3983-9029-3015b6820847",
                                        "glosses": [
                                            "The setting aside of a certain percentage of vacancies in government institutions for members of backward and underrepresented communities (defined primarily by caste and tribe)."
                                        ],
                                        "tags": [
                                            "India",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b0a0950-bb78-3e32-b135-4d9ececd2c8d",
                                        "entry_id": "7eb66826-362d-3983-9029-3015b6820847",
                                        "glosses": [
                                            "A power of an overseeing authority to suspend legislation in the jurisdiction being overseen pending the approval of a higher authority. Such as a provincial/state governor reserving a bill passed by the state/provincial legislature from assent, pending approval of the federal government; or a federal bill passed by federal parliament being reserved by the viceroy pending approval by the crown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
