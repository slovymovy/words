                "senses": [
                    {
                        "sense_id": "8218d113-5cff-303c-99b8-8e970b11085e",
                        "entry_id": "4f223284-a3d9-389b-9449-a51ae1ae955a",
                        "glosses": [
                            "zwei Orte verbindender Schienenweg"
                        ],
                        "tags": [
                            "Eisenbahnwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "fb2a837e-41c7-4ac4-a1f7-4ec9ddacb0c1",
                                "sense_id": "8218d113-5cff-303c-99b8-8e970b11085e",
                                "text": "„Auch die Menschen entlang der Bahnstrecke lassen sich nicht mit deutschen Sehgewohnheiten kategorisieren.“"
                            },
                            {
                                "example_id": "50153a99-49d4-412d-b2c6-7ee5103cc1dc",
                                "sense_id": "8218d113-5cff-303c-99b8-8e970b11085e",
                                "text": "„So können auf einer Strecke mehrere Bahnlinien oder eine Bahnlinie auf mehreren Strecken verkehren“"
                            },
                            {
                                "example_id": "5bb1c4db-7a55-4bb4-9861-3090677c7a5a",
                                "sense_id": "8218d113-5cff-303c-99b8-8e970b11085e",
                                "text": "„Der Bahnhof des kleinen Orts Bichl auf der Bahnstrecke von Tutzing nach Kochel wurde völlig zerstört, wahrscheinlich wegen eines Anschlussgleises zur unterirdischen Sprengstofffabrik in Wolfratshausen.“"
                            },
                            {
                                "example_id": "a46b4e0f-0d8c-4fe6-a563-df3a5c3d25f1",
                                "sense_id": "8218d113-5cff-303c-99b8-8e970b11085e",
                                "text": "„Nach einer tagelangen Sperrung auf der Bahnstrecke zwischen Hamburg und Hannover ermittelt die Bundespolizei gegen zwei Hobbygärtner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
