    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8bd9de1e-2d59-316c-a18e-9dc8d5720f76",
                "word": "hedgerow",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "987d2c71-4539-4f8f-bffe-d37c4c453c77",
                        "entry_id": "8bd9de1e-2d59-316c-a18e-9dc8d5720f76",
                        "tags": [
                            "plural"
                        ],
                        "form": "hedgerows"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "204434dd-d07d-32a0-9ba6-122d5320a2ba",
                        "entry_id": "8bd9de1e-2d59-316c-a18e-9dc8d5720f76",
                        "glosses": [
                            "A row of closely planted bushes or trees forming a hedge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee1c8fdf-221b-4a51-acff-c07c3d762229",
                                "sense_id": "204434dd-d07d-32a0-9ba6-122d5320a2ba",
                                "text": "He had a suit of summer mufti, and a broad-brimmed blue beaver hat looped with leaves broken from the hedgerows in the lanes, and a Leander scarf tucked full of flowers: loosestrife, meadowrue, orchis, ragged-robin."
                            },
                            {
                                "example_id": "31c56006-c6a5-4490-adf7-f6cbadd34e9a",
                                "sense_id": "204434dd-d07d-32a0-9ba6-122d5320a2ba",
                                "text": "If there's a bustle in your hedgerow, don't be alarmed now, it's just a spring clean for the may queen"
                            },
                            {
                                "example_id": "4431c008-44e7-4066-b8d3-39d3d71c2c6d",
                                "sense_id": "204434dd-d07d-32a0-9ba6-122d5320a2ba",
                                "text": "In fact, a railway lined with hedgerows and shrubs would be perfect for reliability and biodiversity. Hawthorn, for example, can take a good cut and grow back strongly, while still providing shelter for creatures and acting as a natural fence line."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97cd9fc3-e522-48d1-b1ee-3ef1504a6c38",
                        "source_entry_id": "8bd9de1e-2d59-316c-a18e-9dc8d5720f76",
                        "source_sense_id": "204434dd-d07d-32a0-9ba6-122d5320a2ba",
                        "source_sense_description": "a row of closely planted bushes or trees forming a hedge",
                        "target_lang_word": "haie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b158ad5-ee59-354e-b9e9-5e922659b15b",
                                        "entry_id": "14480c27-2d87-3788-a01a-909fb19c3f9a",
                                        "glosses": [
                                            "Ensemble linéaire, naturel ou artificiel, de végétaux (dont parfois des arbres), ligneux, semi-ligneux, herbacés, plus ou moins homogène (taille, espèces, etc.) et servant parfois de clôture, de limite entre deux parcelles cadastrales ou de protection contre la vue et le vent ou simplement dans un but purement décoratif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c906600b-8d55-4191-9f4c-4c6f4761be7f",
                                                "sense_id": "0b158ad5-ee59-354e-b9e9-5e922659b15b",
                                                "text": "Au bas, le long du sentier, régnait un rustique palis, perdu dans une haie d’aubépine et de ronce."
                                            },
                                            {
                                                "example_id": "3fd6199e-2afb-4787-974d-47f7a9b2bdb2",
                                                "sense_id": "0b158ad5-ee59-354e-b9e9-5e922659b15b",
                                                "text": "Les Cactées pour la confection des clôtures. — Les Cactées, grâce aux épines dont elles sont garnies sont fréquemment usitées au Mexique, dans les territoires à sécheresses prolongées pour faire des haies; elles opposent aussi une barrière à la propagation des incendies. Ces haies se font par boutures."
                                            },
                                            {
                                                "example_id": "c25ce623-3e88-4cc9-b40a-62fffc108713",
                                                "sense_id": "0b158ad5-ee59-354e-b9e9-5e922659b15b",
                                                "text": "Selon Kaempfer, les camélias sauvages poussaient au Japon dans les haies et il existait également des variétés cultivées."
                                            },
                                            {
                                                "example_id": "63a283f0-f755-4949-9273-ce197df60178",
                                                "sense_id": "0b158ad5-ee59-354e-b9e9-5e922659b15b",
                                                "text": "En régulant l’écoulement des eaux de pluie, la haie retient l’humidité dans le sol. Elle abrite et nourrit une faune variée : oiseaux (fauvettes et merles, notamment), insectes, petits animaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1eacb6c-d27d-3372-8eb3-1efcbe1a1856",
                                        "entry_id": "14480c27-2d87-3788-a01a-909fb19c3f9a",
                                        "glosses": [
                                            "Obstacle qui doit être franchi par le concurrent qui participe à une course."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db468dee-bf76-4be7-90c3-0c731f9129a8",
                                                "sense_id": "e1eacb6c-d27d-3372-8eb3-1efcbe1a1856",
                                                "text": "Course du 110 mètres haies."
                                            },
                                            {
                                                "example_id": "c301fea0-21d8-4993-8215-8483eceb3959",
                                                "sense_id": "e1eacb6c-d27d-3372-8eb3-1efcbe1a1856",
                                                "text": "La haie est un obstacle difficile à franchir pour certains chevaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ced8effa-974e-3611-82fd-399efb022948",
                                        "entry_id": "14480c27-2d87-3788-a01a-909fb19c3f9a",
                                        "glosses": [
                                            "Se dit d’un obstacle empêchant le passage, comme un long banc d’écueils."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f8e699f-04af-42d4-b558-ed5f0040e298",
                                                "sense_id": "ced8effa-974e-3611-82fd-399efb022948",
                                                "text": "On trouve une haie de rochers non loin de la côte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f332304b-1498-399c-af65-b20200adbbd5",
                                        "entry_id": "14480c27-2d87-3788-a01a-909fb19c3f9a",
                                        "glosses": [
                                            "Disposition donnée aux briques que l’on souhaite faire sécher."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f6fb2db-659d-3d7b-81eb-61c50b0f2453",
                                        "entry_id": "14480c27-2d87-3788-a01a-909fb19c3f9a",
                                        "glosses": [
                                            "File de personnes (soldats, gardes, curieux, etc.) bordant une voie pour laisser le passage à quelqu’un ou à un cortège."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cf99111-3a12-47a6-a04a-ee7cecf302a7",
                                                "sense_id": "6f6fb2db-659d-3d7b-81eb-61c50b0f2453",
                                                "text": "Il y avait foule. Derrière la haie de soldats qui s’effrangeaient devant le carré réservé à l'échafaud commença à s'élever un brouhaha."
                                            },
                                            {
                                                "example_id": "55e663ff-ef56-4347-960f-55b046f9369b",
                                                "sense_id": "6f6fb2db-659d-3d7b-81eb-61c50b0f2453",
                                                "text": "Au lieu de combattre, elles allaient donc en être réduites à fournir des escortes d'apparat et à faire la haie ! C'est un véritable désenchantement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8dd20b2-b51d-3519-97b4-628421bcb436",
                                        "entry_id": "14480c27-2d87-3788-a01a-909fb19c3f9a",
                                        "glosses": [
                                            "Age de la charrue."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f50e65b1-bc67-3a8a-9ecb-18d9173c1178",
                                        "entry_id": "14480c27-2d87-3788-a01a-909fb19c3f9a",
                                        "glosses": [
                                            "Meuble représentant une clôture avec ou sans arbustes dans les armoiries. Elle est composée de piquets reliés par des fils ou des branches. À rapprocher de barrière et palissade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "923cc988-7a31-408b-9863-0c6f2d544a29",
                                                "sense_id": "f50e65b1-bc67-3a8a-9ecb-18d9173c1178",
                                                "text": "D’argent à la haie de sinople, les potelets et les liens d'or, soutenue par une champagne de gueules, qui est de la commune d’Hecken du Haut-Rhin → voir illustration « armoiries avec une haie »"
                                            },
                                            {
                                                "example_id": "34428458-2a2c-467f-b3e1-7ee59eee9c96",
                                                "sense_id": "f50e65b1-bc67-3a8a-9ecb-18d9173c1178",
                                                "text": "D’azur à la haie circulaire d’or, au chef cousu de gueules semé d’étoiles aussi d’or, qui est de la commune de Le Plessis-Trévise du Val-de-Marne → voir illustration « armoiries avec une haie »"
                                            }
                                        ]
                                    }
                                ]
                            },
