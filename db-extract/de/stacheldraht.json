                        "source_sense_id": "ce5d4dac-c6c5-3a37-8855-2b944e06a20b",
                        "source_sense_description": "Draht, an dem sich Stacheln oder Klingen befinden",
                        "target_lang_word": "prikkeldraad",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prikkeldraad",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "87dd4f12-31e9-3515-bb93-432c2cb01e44",
                                        "entry_id": "9e84e1d3-1b39-3ce7-83dd-fc8a314b9814",
                                        "glosses": [
                                            "materiaal bestaande uit een dubbele, in elkaar gedraaide metalen draad, op regelmatige afstand voorzien van twee korte in elkaar gedraaide spiralen met elk twee scherpe punten"
                                        ],
                                        "tags": [
                                            "neuter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89bd3257-f273-4059-963d-fccf96f9406d",
                                                "sense_id": "87dd4f12-31e9-3515-bb93-432c2cb01e44",
                                                "text": "Ze moesten een noordoostelijke lijn volgen, daar op tweehonderd meter wat doorknippen, vervolgens naar de tweede rij prikkeldraad kruipen, een blik werpen en terugkeren met de woorden dat alles in orde was, omdat er nu eenmaal niets te zien was."
                                            },
                                            {
                                                "example_id": "a0bdd373-e8dc-42a3-b7b1-8d36ba7e59c9",
                                                "sense_id": "87dd4f12-31e9-3515-bb93-432c2cb01e44",
                                                "text": "De uitvinding van het prikkeldraad leidde tot een grondige verandering van het Noord-Amerikaanse landschap."
                                            }
