                "senses": [
                    {
                        "sense_id": "5b40122f-98a5-32ef-a642-d4a83d72ce8f",
                        "entry_id": "a0ef8521-7f2e-33bb-b647-da7387308387",
                        "glosses": [
                            "von zum Beispiel einer Feile verursachter Abrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86ac82ff-b65e-424f-a6db-8306ff47d5e4",
                                "sense_id": "5b40122f-98a5-32ef-a642-d4a83d72ce8f",
                                "text": "„Die Feilen werden dem Steine zuerst der Quere nach dargeboten, bis sie ganz blank sind, dann aber der Länge nach, um den ersten Schleifstrich wegzunehmen.“"
                            },
                            {
                                "example_id": "c56dd5ca-354e-4fd9-a55b-bc6948a78a75",
                                "sense_id": "5b40122f-98a5-32ef-a642-d4a83d72ce8f",
                                "text": "„Der einfache Schleifstrich durch die Blaumarke kennzeichnete seit etwa 1760, nachweislich seit 1766, die Weißware.“"
                            },
                            {
                                "example_id": "f22c351a-64fd-47d0-bfd3-d7cb72eb4de6",
                                "sense_id": "5b40122f-98a5-32ef-a642-d4a83d72ce8f",
                                "text": "„Diese zarten Pulver können den Schleifstrich nicht vertilgen, stumpfen ihn jedoch ab, und verleihen der Feile einen starken Glanz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
