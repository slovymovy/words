                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "2c5de370-cb09-4d71-8e2e-32e038bbd75f",
                                "sense_id": "f9995995-7a45-3b60-80e2-ed783fa6df84",
                                "text": "Ich trinke gerne einen kalten Apfelmost."
                            }
                        ],
                        "sense_index_json": "\"2\""
