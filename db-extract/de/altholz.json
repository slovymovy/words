                "senses": [
                    {
                        "sense_id": "954d4f42-7cd5-3002-b0f0-6763fb89f223",
                        "entry_id": "55b4358a-e33d-3e04-b2f6-5b4641bf58c3",
                        "glosses": [
                            "„Holz, das bereits einem Verwendungszweck zugeführt worden war und als Abfall zur Altholzentsorgung oder als Sekundärrohstoff bereitsteht“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24093784-2ebb-47c7-8ade-70d0654a55bb",
                                "sense_id": "954d4f42-7cd5-3002-b0f0-6763fb89f223",
                                "text": "„Der überwiegende Teil des Altholzes wird separat gesammelt und entsorgt.“"
                            },
                            {
                                "example_id": "d466c4b4-b3bf-489a-b914-ec81aacae43a",
                                "sense_id": "954d4f42-7cd5-3002-b0f0-6763fb89f223",
                                "text": "„Die Nutzung von Altholz kann sowohl energetisch als auch stofflich erfolgen […].“"
                            },
                            {
                                "example_id": "6a246713-bc19-4e23-973d-400b04e2707a",
                                "sense_id": "954d4f42-7cd5-3002-b0f0-6763fb89f223",
                                "text": "„Spanplatten stellen die wichtigste stoffliche Nutzung für Altholz dar.“"
                            }
                        ],
