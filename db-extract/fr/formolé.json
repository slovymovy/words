                        "glosses": [
                            "Qui fait penser au formol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "193f7e78-ef46-4bc9-a1be-c7a50e904659",
                                "sense_id": "9148383d-ef85-305d-914d-11eac4930103",
                                "text": "L’ambiance silencieuse et formolée de cet ultime réduit lui semblait moins pesante que celle des antichambres de la mort qu’il venait de traverser."
                            },
                            {
                                "example_id": "14e26d4e-87cc-4313-9cdc-72622fa1d4bd",
                                "sense_id": "9148383d-ef85-305d-914d-11eac4930103",
                                "text": "Elle presse sa main sur sa bouche pour étouffer un rire aigu, et part dans un nuage de parfum de supermarché qui masque furtivement l’odeur formolée du couloir où traînent les pantoufles fatiguées des pensionnaires encore valides."
                            }
                        ]
                    }
