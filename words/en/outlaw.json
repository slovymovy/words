{
    "word_family": [
        "outlawry",
        "outlawed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c8b537e-043c-3dc2-b8f7-fc7aadfb9695",
                    "sense_definition": "To officially declare something illegal or to prohibit it by law.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "prohibition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>outlaw</w> smoking in all public indoor spaces.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>запретить</w> курение во всех общественных помещениях."
                            }
                        },
                        {
                            "text": "New legislation will <w>outlaw</w> selling certain types of dangerous weapons to minors.",
                            "target_lang_translations": {
                                "ru": "Новое законодательство <w>объявит вне закона</w> продажу определенных видов опасного оружия несовершеннолетним."
                            }
                        }
                    ],
                    "antonyms": [
                        "legalize",
                        "permit"
                    ],
                    "common_phrases": [
                        "outlaw selling",
                        "outlaw smoking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально объявить что-либо незаконным или запретить законом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объявлять вне закона",
                                "target_lang_sense_clarification": "официально запрещать"
                            },
                            {
                                "target_lang_word": "запрещать",
                                "target_lang_sense_clarification": "накладывать правовой запрет"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bae9335-26bd-307b-90ab-3e241ca99dc4",
                    "sense_definition": "To deprive a person of the benefit and protection of the law.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient times, the king could <w>outlaw</w> anyone who refused to pay their taxes.",
                            "target_lang_translations": {
                                "ru": "В древние времена король мог <w>объявить вне закона</w> любого, кто отказывался платить налоги."
                            }
                        },
                        {
                            "text": "The rebel leader was <w>outlawed</w> by the state, meaning he had no legal rights.",
                            "target_lang_translations": {
                                "ru": "Лидер повстанцев был <w>лишен прав</w> государством, что означало отсутствие у него каких-либо законных прав."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily used in historical or formal legal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишать человека защиты и покровительства закона."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объявлять вне закона",
                                "target_lang_sense_clarification": "лишать юридических прав"
                            },
                            {
                                "target_lang_word": "лишать прав",
                                "target_lang_sense_clarification": "ставить в положение изгоя"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0b03e997-5035-3920-a213-7203dfb854a5",
                    "sense_definition": "A person who has broken the law and is hiding from the authorities.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "criminal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>outlaw</w> hid in the mountains to avoid being captured by the sheriff.",
                            "target_lang_translations": {
                                "ru": "<w>Преступник</w> скрывался в горах, чтобы избежать поимки шерифом."
                            }
                        },
                        {
                            "text": "Stories about the famous <w>outlaw</w> Robin Hood have been told for centuries.",
                            "target_lang_translations": {
                                "ru": "Истории о знаменитом <w>разбойнике</w> Робин Гуде рассказываются на протяжении веков."
                            }
                        }
                    ],
                    "synonyms": [
                        "fugitive",
                        "absconder",
                        "bandit"
                    ],
                    "common_phrases": [
                        "famous outlaw",
                        "notorious outlaw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, нарушивший закон и скрывающийся от властей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преступник",
                                "target_lang_sense_clarification": "скрывающийся от правосудия"
                            },
                            {
                                "target_lang_word": "разбойник",
                                "target_lang_sense_clarification": "бандит, часто в историческом контексте"
                            },
                            {
                                "target_lang_word": "беглец",
                                "target_lang_sense_clarification": "скрывающийся от закона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6beb269b-a251-350f-8134-f269c4cc0d1c",
                    "sense_definition": "A person who refuses to follow established customs or social norms.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "social_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a bit of an <w>outlaw</w> in the academic world, always challenging traditional theories.",
                            "target_lang_translations": {
                                "ru": "Он был своего рода <w>бунтарем</w> в академическом мире, всегда бросая вызов традиционным теориям."
                            }
                        },
                        {
                            "text": "The artist lived like an <w>outlaw</w>, ignoring the expectations of polite society.",
                            "target_lang_translations": {
                                "ru": "Художник жил как <w>изгой</w>, игнорируя ожидания приличного общества."
                            }
                        }
                    ],
                    "synonyms": [
                        "anti-hero",
                        "deviant"
                    ],
                    "antonyms": [
                        "conformist"
                    ],
                    "common_phrases": [
                        "social outlaw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который отказывается следовать установленным обычаям или социальным нормам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бунтарь",
                                "target_lang_sense_clarification": "идущий против системы"
                            },
                            {
                                "target_lang_word": "изгой",
                                "target_lang_sense_clarification": "человек вне общества"
                            },
                            {
                                "target_lang_word": "отверженный",
                                "target_lang_sense_clarification": "не принятый обществом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08f908a4-9c06-386a-8188-e9273c7a1308",
                    "sense_definition": "A humorous or informal term for a relative by marriage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'm spending the weekend with my <w>outlaws</w> while my wife is away on business.",
                            "target_lang_translations": {
                                "ru": "Я провожу выходные со своей <w>родней</w>, пока жена в командировке."
                            }
                        },
                        {
                            "text": "He jokingly refers to his sister's husband as his favorite <w>outlaw</w>.",
                            "target_lang_translations": {
                                "ru": "Он в шутку называет мужа своей сестры своим любимым <w>родственником</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "a pun on 'in-law'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутливое или неформальное обозначение родственника со стороны супруга или супруги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "родня со стороны жены или мужа",
                                "target_lang_sense_clarification": "ироничная игра слов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cadb97f8-28cb-3e26-a810-22c0bc52406d",
                    "sense_definition": "An English surname derived from a nickname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The chef Nathan <w>Outlaw</w> is well-known for his expertise in cooking seafood.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар Натан <w>Аутло</w> хорошо известен своим мастерством в приготовлении морепродуктов."
                            }
                        },
                        {
                            "text": "We studied the works of a writer named <w>Outlaw</w> in our literature class.",
                            "target_lang_translations": {
                                "ru": "На уроке литературы мы изучали произведения писателя по фамилии <w>Аутло</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, происходящая от прозвища."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Аутло",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}