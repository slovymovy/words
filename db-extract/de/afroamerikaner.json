                "senses": [
                    {
                        "sense_id": "45a5b8f2-5d43-3600-9422-d3121863cd91",
                        "entry_id": "ac85178a-2115-3164-8a04-12a7faf87fa0",
                        "glosses": [
                            "dunkelhäutiger Amerikaner, dessen Vorfahren aus Schwarzafrika stammen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7733729e-30a7-481b-a810-cc85750d52d1",
                                "sense_id": "45a5b8f2-5d43-3600-9422-d3121863cd91",
                                "text": "„Die US-amerikanische Demokratie als solche und die sie tragenden Werte wurden als die eigentliche Ursache für die fortlaufende Unterdrückung der Afroamerikaner ausgemacht, weshalb die Afroamerikaner sich aus freiem Entschluss aus dieser Gesellschaft lösen sollten.“"
                            },
                            {
                                "example_id": "d3f1bf82-a131-46ab-8696-bb245a027189",
                                "sense_id": "45a5b8f2-5d43-3600-9422-d3121863cd91",
                                "text": "„Es gab sogar Clubs, die Afroamerikanern gehörten und wo schwarze Jazzmusiker eine musikalische Heimat fanden.“"
                            },
                            {
                                "example_id": "c5194cca-a2ca-4eae-a59f-23177a04a074",
                                "sense_id": "45a5b8f2-5d43-3600-9422-d3121863cd91",
                                "text": "„Der gegen 1851 als Sklave geborene Afroamerikaner besaß eine beeindruckende Bildung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fcc0d52-f009-4404-ada0-2318571d35f4",
                        "source_entry_id": "ac85178a-2115-3164-8a04-12a7faf87fa0",
                        "source_sense_id": "45a5b8f2-5d43-3600-9422-d3121863cd91",
                        "source_sense_description": "dunkelhäutiger Amerikaner, dessen Vorfahren aus Schwarzafrika stammen",
                        "target_lang_word": "Afro-American",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Afro-American",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35451e21-3bd2-3cce-adcb-1745090fc654",
                                        "entry_id": "d32a69d9-ca67-3bad-8a08-023bdaf9ce91",
                                        "glosses": [
                                            "A native or resident of the United States (an American) who is of African heritage."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d388da02-6dc3-475a-9938-c0af439623e3",
                                                "sense_id": "35451e21-3bd2-3cce-adcb-1745090fc654",
                                                "text": "That great battle was won, not because the victim of slavery was a negro, mulatto, or an Afro-American, but because the victim of slavery was a man and a brother to all other men, a child of God, and could claim with all mankind a common Father, and therefore should be recognized as an accountable being, a subject of government, and entitled to justice, liberty and equality before the law, and every where else."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Afro-American",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc264365-8fdd-3691-acf1-1f0105645a97",
                                        "entry_id": "5ec9cc1f-5dd5-3482-ad94-110db17d3542",
                                        "glosses": [
                                            "Of African-American heritage or culture"
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20a8e45b-4e7b-4d83-9a4a-8a25fd850f0b",
                                                "sense_id": "dc264365-8fdd-3691-acf1-1f0105645a97",
                                                "text": "I inadvertently gave the afro-american delivery boi a $5 tip probably due to the fact that I had pickled a few brain cells."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e46e263-503b-496b-bffa-757f19f3db45",
                        "source_entry_id": "ac85178a-2115-3164-8a04-12a7faf87fa0",
