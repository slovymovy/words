                ],
                "senses": [
                    {
                        "sense_id": "492a26b4-1e7a-3fda-b0a5-37b2ab9d787d",
                        "entry_id": "0ae60d63-c7b8-3f53-be97-2cb9dc2e87f6",
                        "glosses": [
                            "vor dem Backen mit Natriumhydroxidlösung (Natronlauge) benetzte Brötchen"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "64f7ed7e-f489-4550-9e3f-639d473ae19d",
                                "sense_id": "492a26b4-1e7a-3fda-b0a5-37b2ab9d787d",
                                "text": "„Joachim holte die Rote Wurst aus seiner Tasche und aß sie kalt mit dem Laugenwecken dazu.“"
                            },
                            {
                                "example_id": "bb801fb1-df88-4e29-993e-0a47338a6d3c",
                                "sense_id": "492a26b4-1e7a-3fda-b0a5-37b2ab9d787d",
                                "text": "„Levin hatte früher ein halbes Semester im Ruhrgebiet studiert, aber da es dort weder Zwiebelkuchen noch Laugenwecken gab, hatte er rasch die Rückkehr eingeleitet.“"
                            },
                            {
                                "example_id": "05266bab-8521-49b6-96f0-9fb2993bdcf4",
                                "sense_id": "492a26b4-1e7a-3fda-b0a5-37b2ab9d787d",
                                "text": "„Ich mach jetzt nur kurz eine kleine Pause, dann marschiere ich los und besorg uns frische Laugenwecken und ein paar Eier.“"
                            },
                            {
                                "example_id": "7805dc97-82d9-4c8e-9fe7-53095afc641a",
                                "sense_id": "492a26b4-1e7a-3fda-b0a5-37b2ab9d787d",
                                "text": "„Er brach ein Stück seines Laugenweckens ab und tauchte es tief in die rote Soße seiner Currywurst ein.“"
                            },
                            {
                                "example_id": "19e208f8-a21a-451b-92a8-0e6df7448d69",
                                "sense_id": "492a26b4-1e7a-3fda-b0a5-37b2ab9d787d",
                                "text": "„Ich hole die Rote Wurst aus der Tasche und esse sie kalt, den Laugenwecken dazu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
