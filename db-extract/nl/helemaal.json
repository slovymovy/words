                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "932a673a-a85d-3bd2-b42f-6dd6d68fa144",
                        "entry_id": "a5bea68f-ae3e-30fd-aa57-cee5f214530b",
                        "glosses": [
                            "completely"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e20abb16-ac09-421a-9b7a-b71de6a2ab60",
                                "sense_id": "932a673a-a85d-3bd2-b42f-6dd6d68fa144",
                                "text": "Je zit er helemaal naast.",
                                "translation": "You are completely wrong.",
                                "english": "You are completely wrong."
                            },
                            {
                                "example_id": "4778f161-0f9e-46e8-825a-4ed690e2cd4e",
                                "sense_id": "932a673a-a85d-3bd2-b42f-6dd6d68fa144",
                                "text": "Ik heb het helemaal zelf gedaan.",
                                "translation": "I did it all by myself.",
                                "english": "I did it all by myself."
                            }
                        ]
                    },
                    {
                        "sense_id": "03f7cc2d-7a11-3f7e-895d-cb71d30153b6",
                        "entry_id": "a5bea68f-ae3e-30fd-aa57-cee5f214530b",
                        "glosses": [
                            "all the way, the whole way"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8138f1a-cb74-4627-9605-b607a4ea6b62",
                                "sense_id": "03f7cc2d-7a11-3f7e-895d-cb71d30153b6",
                                "text": "Ik ben helemaal naar huis gelopen.",
                                "translation": "I walked all the way home",
                                "english": "I walked all the way home"
                            }
                        ]
                    },
                    {
                        "sense_id": "8753956b-a391-3664-ab43-a03613c77306",
                        "entry_id": "a5bea68f-ae3e-30fd-aa57-cee5f214530b",
                        "glosses": [
                            "especially, even more so"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0818f39b-d3c7-41cb-bc8f-abb4a413b9fa",
                                "sense_id": "8753956b-a391-3664-ab43-a03613c77306",
                                "text": "Kauwgom is dus schadelijk, al helemaal als het niet suiker-vrij is.",
                                "translation": "Chewing gum is therefore harmful, especially if it is not sugar-free.",
                                "english": "Chewing gum is therefore harmful, especially if it is not sugar-free."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e7260a2-6a9b-3288-a42f-7a7be19a525a",
                        "entry_id": "a5bea68f-ae3e-30fd-aa57-cee5f214530b",
                        "glosses": [
                            "anyway"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7d5012a4-b574-4143-bfa2-2fb133e85c39",
                                "sense_id": "0e7260a2-6a9b-3288-a42f-7a7be19a525a",
                                "text": "Wie ben jij nu helemaal?",
                                "translation": "Who are you anyway?",
                                "english": "Who are you anyway?"
                            }
                        ]
                    }
                ],
