                    {
                        "translation_id": "45a13a67-3c72-4b73-a009-363b1ca27488",
                        "source_entry_id": "4c7c39ee-a54b-3009-9127-b17c69a253a3",
                        "source_sense_description": "ancient city in Greece",
                        "target_lang_word": "Olympie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Olympie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e45db08-8d4b-3f54-9ebc-cfe4fe78890e",
                                        "entry_id": "bdf4ca33-3b99-3006-a956-a9e7b650f004",
                                        "glosses": [
                                            "Centre religieux de la Grèce antique, dans le Péloponnèse, situé dans la plaine de l’Élide, sur la rive droite de l’Alphée et au pied du Mont Cronion et où se déroulaient, tous les quatre ans, les Jeux olympiques."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da746f46-ce1d-46fe-a1cb-375101ff4ed0",
                                                "sense_id": "8e45db08-8d4b-3f54-9ebc-cfe4fe78890e",
                                                "text": "Allumée à Olympie (photo) — comme le veut la tradition — elle arrivera par bateau, le 8 mai, à Marseille."
                                            },
                                            {
                                                "example_id": "01aa429a-cdb6-43ef-8f84-c327e0a3f272",
                                                "sense_id": "8e45db08-8d4b-3f54-9ebc-cfe4fe78890e",
                                                "text": "Olympie était un sanctuaire dédié à Zeus, uniquement habité par le personnel des temples et les prêtres du culte. Sur le site du sanctuaire se tenaient des Jeux, tous les quatre ans à partir de 776 avant J.-C., date de la paix entre Lycurgue, roi et législateur de Sparte, et le roi Iphitos, en Élide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e7c46f5-955f-3413-90b2-3d8004ce7c76",
                                        "entry_id": "bdf4ca33-3b99-3006-a956-a9e7b650f004",
                                        "glosses": [
                                            "Petite ville grecque de 1,500 habitants, située à proximité immédiate du sanctuaire d’Olympie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e21cbb95-5bad-3b4b-8ee0-c40a65ccbc0d",
                                        "entry_id": "bdf4ca33-3b99-3006-a956-a9e7b650f004",
                                        "glosses": [
                                            "Lieu où se déroulent des jeux renommés."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cecb0c3-757a-48d2-a497-0d353aa350fe",
                                                "sense_id": "e21cbb95-5bad-3b4b-8ee0-c40a65ccbc0d",
                                                "text": "Il y a, dans le département de l’Aube, à la lisière de la Marne, un tout petit village, l’Abbaye-sous-Plancy, où l’arrochage était plus florissant que partout ailleurs. C’était l’Olympie de la région. On n’y arrochait, d’ailleurs, que l’oie, gibier plus noble […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Olympie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2938831d-2bdb-3f6f-9aad-ba39cac62dd7",
                                        "entry_id": "a0b233e1-73a4-3537-81dc-3e596934df8c",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "189bf9b5-c55b-44d7-abfd-39833713da0a",
                                                "sense_id": "2938831d-2bdb-3f6f-9aad-ba39cac62dd7",
                                                "text": "Alexandre le Grand était le fils de Philippe II de Macédoine et d’Olympie (aussi appelée Olympias)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
