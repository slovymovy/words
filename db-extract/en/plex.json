                "senses": [
                    {
                        "sense_id": "8c3906d0-5c88-3ea7-91f0-e45207edbf64",
                        "entry_id": "e9c22dfc-5958-3067-8984-b3416cd87d4b",
                        "glosses": [
                            "A building, such as a duplex or triplex, with a number of apartments (typically two to four) that all open directly to the outside."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "c676892f-bef8-42a9-8321-9c356132116c",
                                "sense_id": "8c3906d0-5c88-3ea7-91f0-e45207edbf64",
                                "text": "Most new housing has taken the form of single-family dwellings, not plexes, and levels of home ownership have risen steadily."
                            },
                            {
                                "example_id": "8d2c6ca7-f8c3-43cf-8223-ac9c02c90104",
                                "sense_id": "8c3906d0-5c88-3ea7-91f0-e45207edbf64",
                                "text": "English-style terraced houses or the cheaper type of Montreal plexes that opened directly onto the street made such a way of life possible, but just barely."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf6bed9a-e0e9-37bc-9510-20d2d2a32701",
                        "entry_id": "e9c22dfc-5958-3067-8984-b3416cd87d4b",
                        "glosses": [
                            "A designated portion of a disk, usually set up to mirror some of the contents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7e7d78b-3e02-48c4-9d8e-27414af9f66b",
                                "sense_id": "bf6bed9a-e0e9-37bc-9510-20d2d2a32701",
                                "text": "Striped volumes of mirrored plexes can survive failure of up to half of their disks."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b629494-14e1-3efa-a865-16d6e5039f55",
                        "entry_id": "e9c22dfc-5958-3067-8984-b3416cd87d4b",
                        "glosses": [
                            "A tree-like structure in which each child can have multiple parents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2a17642-462b-4e13-8dbe-f6116e8bd941",
                                "sense_id": "7b629494-14e1-3efa-a865-16d6e5039f55",
                                "text": "If a child in a data relationship has more than one parent, the relationship cannot be described as a tree or hierarchical structure. Instead it is described as a ... plex structure."
                            }
                        ]
                    },
