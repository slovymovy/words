                "senses": [
                    {
                        "sense_id": "f85c58d1-951d-3062-a19c-c47e5ee344f3",
                        "entry_id": "eeadf66a-4a26-3d79-9372-002111a24326",
                        "glosses": [
                            "Mediziner, der Sportlern verbotene leistungssteigernde Mittel bereitstellt und/oder Strategien entwickelt, den Einsatz dieser Mittel zu verschleiern"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "43f7abf6-4fed-4c84-b3b2-d2d046d268b7",
                                "sense_id": "f85c58d1-951d-3062-a19c-c47e5ee344f3",
                                "text": "„Dopingärzte hätten in der DDR im staatlichen Auftrag gehandelt, die DDR existiere nicht mehr – und für diesen juristischen Komplex sei eine Rechtsnachfolge der DDR durch die Bundesrepublik Deutschland nicht gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bfc8994f-b972-38cb-a9b3-1b8ac486b2d3",
                        "entry_id": "eeadf66a-4a26-3d79-9372-002111a24326",
                        "glosses": [
                            "Mediziner, der im Rahmen von Anti-Doping-Kontrollen tätig ist"
                        ],
                        "tags": [
                            "colloquial",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5697dc79-d1f9-41f3-8b76-ad16f01e03f9",
                                "sense_id": "bfc8994f-b972-38cb-a9b3-1b8ac486b2d3",
                                "text": "„In Mannschaftswettbewerben müssen nicht alle Spieler beim Dopingarzt erscheinen, sondern nur ein oder zwei, durch ein Los bestimmte, Teammitglieder.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
