                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98c6ca0f-7345-4638-866f-bf57230b79be",
                                "sense_id": "ca5041ab-7a8a-38dd-b8d9-8743a92ad7f6",
                                "text": "„Ich betrachtete die historischen Gebäude, die hohen Kirchen, die verspielten Türme und die bunt verzierten Häuserfassaden.“"
                            },
                            {
                                "example_id": "10edcfad-0cc9-4218-8164-ccdf0a3139dc",
                                "sense_id": "ca5041ab-7a8a-38dd-b8d9-8743a92ad7f6",
                                "text": "„Als sie vor der toten Häuserfassade stand, trat sie nicht in die Haustür, sondern in eine danebenliegende kleine Öffnung, die er vorher nicht wahrgenommen hatte.“"
                            }
                        ],
