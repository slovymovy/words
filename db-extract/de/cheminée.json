                        "sense_id": "22a7416a-20e7-3af6-a31d-3e7c12e66a90",
                        "entry_id": "172242e0-f6e5-38a1-af88-7342dd589f3c",
                        "glosses": [
                            "fireplace"
                        ],
                        "tags": [
                            "Switzerland",
