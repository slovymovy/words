                        "target_lang_word": "salt cellar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salt cellar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5284b3a2-8842-3557-bee8-a92db8922974",
                                        "entry_id": "072a9641-6b97-35cb-aa28-c4b1d70886eb",
                                        "glosses": [
                                            "A small open container holding salt for use in the kitchen or on a dining table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a30b7641-3c05-4abc-bd30-4a0c84777f8f",
                                                "sense_id": "5284b3a2-8842-3557-bee8-a92db8922974",
                                                "text": "Soon afterwards, Biddy, Joe, and I, had a cold dinner together; but we dined in the best parlour, not in the old kitchen, and Joe was so exceedingly particular what he did with his knife and fork and the saltcellar and what not, that there was great restraint upon us."
                                            },
                                            {
                                                "example_id": "ae72271a-6dc3-441d-b7b6-bad55b2fd05c",
                                                "sense_id": "5284b3a2-8842-3557-bee8-a92db8922974",
                                                "text": "And she had no love for the sea specially, regarding all winds as nuisances excepting such as had been raised by her own efforts, and thinking that salt from a saltcellar was more convenient than that brought to her on the breezes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5723a86-59d7-3859-8f5c-92a60315571d",
                                        "entry_id": "072a9641-6b97-35cb-aa28-c4b1d70886eb",
                                        "glosses": [
                                            "Synonym of salt shaker (“a closed container with perforated lid for sprinkling salt”)."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ebea214-bb53-4dd6-8379-e3e25acee02c",
                        "source_entry_id": "499b1d90-6635-371a-917e-aff87d0a3f28",
                        "source_sense_id": "fd8000cf-0963-3d1e-af76-096c702f7548",
