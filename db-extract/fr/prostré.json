                            {
                                "target_word": "prostrate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ffabf15-843f-3d1c-9926-530137857d33",
                                        "entry_id": "a3711d96-5bb5-3b42-a6ea-0b6b07e7ad0f",
                                        "glosses": [
                                            "To lie flat or face-down."
                                        ],
                                        "tags": [
                                            "often",
                                            "reflexive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d861fe1c-7056-333f-a29f-38c5fdf211d1",
                                        "entry_id": "a3711d96-5bb5-3b42-a6ea-0b6b07e7ad0f",
                                        "glosses": [
                                            "To throw oneself down in submission."
                                        ],
                                        "tags": [
                                            "also",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bb16765-a7ed-49eb-aef2-bacad612469f",
                                                "sense_id": "d861fe1c-7056-333f-a29f-38c5fdf211d1",
                                                "text": "Those who had the privilege of approaching him, had to prostrate themselves before him in profound humility[…]"
                                            },
                                            {
                                                "example_id": "c691ce4c-18f4-43be-9655-e18ba64d886b",
                                                "sense_id": "d861fe1c-7056-333f-a29f-38c5fdf211d1",
                                                "text": "But I take the view that the statue is a cheap and cynical stunt by ministers with scant knowledge of history, whose only interest lies in greasing up to modern Indian politicians. With little or no dignity, they shamelessly prostrate themselves in the most craven way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d3ac9c0-b9ba-357c-ad9e-3f305c788560",
                                        "entry_id": "a3711d96-5bb5-3b42-a6ea-0b6b07e7ad0f",
                                        "glosses": [
                                            "To cause to lie down, to flatten."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f474fc8-c9ab-4479-803f-b3620ff661f4",
                                                "sense_id": "3d3ac9c0-b9ba-357c-ad9e-3f305c788560",
                                                "text": "How many of these mighty pines were to be prostrated under that approaching tempest!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "992e6689-7e8b-38be-925f-cecea7d1f77f",
                                        "entry_id": "a3711d96-5bb5-3b42-a6ea-0b6b07e7ad0f",
                                        "glosses": [
                                            "To overcome or overpower."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcb31b0c-3db7-48e9-8706-892a9c3d869f",
                                                "sense_id": "992e6689-7e8b-38be-925f-cecea7d1f77f",
                                                "text": "Why this very minute she's prostrated with grief."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
