                                "en": "On July 3rd I am going to <marry> my girlfriend.",
                                "ru": "3 июля я <женюсь> на своей девушке.",
                                "de": "Am 3. Juli werde ich meine Freundin <heiraten>.",
                                "pl": "3 lipca <w>żenię się</w> z moją dziewczyną.",
                                "fr": "Le 3 juillet, je vais me <marier> avec ma petite amie.",
                                "it": "Il 3 luglio mi <w>sposerò</w> con la mia ragazza.",
                                "cs": "3. července se budu <ženit> se svou přítelkyní.",
                                "tr": "3 Temmuz'da kız arkadaşımla <evleneceğim>.",
                                "es": "El 3 de julio me voy a <casar> con mi novia."
                            }
                        },
                        {
                            "text": "Mijn ouders zijn al dertig jaar <getrouwd>.",
                            "target_lang_translations": {
                                "en": "My parents have been <married> for thirty years.",
                                "ru": "Мои родители <женаты> уже тридцать лет.",
                                "de": "Meine Eltern sind schon seit dreißig Jahren <verheiratet>.",
                                "pl": "Moi rodzice są już od trzydziestu lat <w>małżeństwem</w>.",
                                "fr": "Mes parents sont <mariés> depuis déjà trente ans.",
                                "it": "I miei genitori sono <w>sposati</w> già da trent'anni.",
                                "cs": "Moji rodiče jsou už třicet let <sví>.",
                                "tr": "Annemle babam otuz yıldır <evli>.",
                                "es": "Mis padres llevan treinta años <casados>."
                            }
