{
    "word_family": [
        "gêne",
        "gêner"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fbcd7a1b-4d23-3eed-bb65-98b5487a36c2",
                    "sense_definition": "Qui met mal à l'aise ou provoque un sentiment d'embarras.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "embarrassant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il y a eu un long silence <w>gênant</w> après sa remarque particulièrement maladroite.",
                            "target_lang_translations": {
                                "en": "There was a long <w>awkward</w> silence after his particularly tactless remark.",
                                "ru": "После его особенно неуклюжего замечания повисло долгое <w>неловкое</w> молчание.",
                                "de": "Nach seiner besonders ungeschickten Bemerkung entstand ein langes <w>peinliches</w> Schweigen.",
                                "es": "Hubo un largo silencio <w>embarazoso</w> tras su comentario particularmente torpe.",
                                "zh": "他刚才那句特别欠考虑的话之后，场面陷入了一段漫长而<w>尴尬</w>的沉默。"
                            }
                        },
                        {
                            "text": "Arrête de me fixer avec insistance, je trouve cette attitude très <w>gênante</w>.",
                            "target_lang_translations": {
                                "en": "Stop staring at me so persistently, I find this behaviour very <w>awkward</w>.",
                                "ru": "Перестань так упорно на меня смотреть, это поведение кажется мне очень <w>неловким</w>.",
                                "de": "Hör auf, mich so beharrlich anzustarren, dieses Verhalten finde ich sehr <w>unangenehm</w>.",
                                "es": "Deja de mirarme con tanta insistencia, me parece una actitud muy <w>incómoda</w>.",
                                "zh": "别再这样一直盯着我看了，你这种做法让我觉得很<w>尴尬</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "embarrassant",
                        "inconfortable"
                    ],
                    "antonyms": [
                        "rassurant",
                        "confortable"
                    ],
                    "common_phrases": [
                        "silence gênant",
                        "situation gênante",
                        "moment gênant",
                        "question gênante"
                    ],
                    "target_lang_definitions": {
                        "en": "Causing discomfort or embarrassment in social situations.",
                        "ru": "Вызывающий неловкость или чувство смущения в общении.",
                        "de": "Ein Gefühl von Verlegenheit oder Unbehagen in sozialen Situationen auslösend.",
                        "es": "Que causa incomodidad o vergüenza en situaciones sociales.",
                        "zh": "使人感到不自在或窘迫的，常指社交场合中令人尴尬的情形。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "awkward",
                                "target_lang_sense_clarification": "uncomfortable social situations, silences"
                            },
                            {
                                "target_lang_word": "embarrassing",
                                "target_lang_sense_clarification": "causing shame or self-consciousness"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "неловкий",
                                "target_lang_sense_clarification": "неловкие паузы, ситуации"
                            },
                            {
                                "target_lang_word": "смущающий",
                                "target_lang_sense_clarification": "вызывающий стыд, смущение"
                            }
                        ],
                        "de": [
