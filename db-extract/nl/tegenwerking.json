                "translations": [
                    {
                        "translation_id": "968071f4-2bac-43e2-85f8-435b69a7b859",
                        "source_entry_id": "9f186e3b-25df-3327-a8a0-d13461fd34b1",
                        "source_sense_id": "66bfe73e-af4f-32a2-a1d2-6124f887f6ea",
