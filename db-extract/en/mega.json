                "entry_id": "94c5103a-03b0-3213-a372-82f7f109f9eb",
                "word": "mega",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e521c373-4cd9-3ecb-8b06-4ecd9c3827a9",
                        "entry_id": "94c5103a-03b0-3213-a372-82f7f109f9eb",
                        "glosses": [
                            "Very large."
                        ],
                        "tags": [
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "1a5d8501-6509-43fb-aecc-27bd3bc7dd02",
                                "sense_id": "e521c373-4cd9-3ecb-8b06-4ecd9c3827a9",
                                "text": "Follow those in the know to the fifth floor of Sega's Joy Polis, a mega indoor amusement park that's part of the Odaiba Decks Tokyo Bay entertainment complex near Tange's Fuji Television building."
                            }
                        ]
                    },
                    {
                        "sense_id": "07e27f73-f441-35c0-af14-1fae82126a52",
                        "entry_id": "94c5103a-03b0-3213-a372-82f7f109f9eb",
                        "glosses": [
                            "Great; excellent."
                        ],
                        "tags": [
                            "not-comparable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2bd68850-a449-47db-9ec2-83f87a0c5f26",
                                "sense_id": "07e27f73-f441-35c0-af14-1fae82126a52",
                                "text": "We had a mega time until Peter fell in the fish pond and cut his leg."
                            },
                            {
                                "example_id": "196166a5-04a9-4cab-a76a-2d352dc9134b",
                                "sense_id": "07e27f73-f441-35c0-af14-1fae82126a52",
                                "text": "It was totally mega. The audience clapped and cheered when Teasel had finally finished. So did I."
                            },
                            {
                                "example_id": "7fc68408-d044-4ba5-b5f2-527c51c14986",
                                "sense_id": "07e27f73-f441-35c0-af14-1fae82126a52",
                                "text": "July 15, 2011, Liam Gallagher, quoted at the launch of the new Manchester City F.C. kit\nI've been a City fan since I was a kid, so to be involved with the launch of a new kit is colossal. Manchester City fans are known for having a lot of style and the new shirt looks mega."
                            }
                        ]
                    }
                ],
