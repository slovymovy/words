                                                "sense_id": "094ef667-ce73-3d15-bd36-4be4139e0f23",
                                                "text": "Botches and blaines muſt all his fleſh imboſs,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f07ef0e-9825-3fe6-9335-c0efe81a05cb",
                                        "entry_id": "c605511b-28bc-36f9-a87c-b24ccbc848b9",
                                        "glosses": [
                                            "A case or outbreak of boils or sores."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08a9ab75-04c9-4806-a700-1d1d57610625",
                                                "sense_id": "5f07ef0e-9825-3fe6-9335-c0efe81a05cb",
                                                "text": "The Lord wil smite thee with the botch of Egypt, and with the emerods, and with the scabbe, and with the itch, whereof thou canst not bee healed."
                                            }
                                        ]
