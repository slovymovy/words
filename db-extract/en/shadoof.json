                                        "entry_id": "4a756260-f6ab-324c-9124-e27cc0bf3b9c",
                                        "glosses": [
                                            "Grus, duży ptak o długiej szyi i nogach z charakterystycznym ogonem w formie pióropusza należący do podrodziny żurawi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d69101-5f48-4766-99f0-72d0498855eb",
                                                "sense_id": "e06f7ee4-08b9-33b2-b420-e95ecbcf1be7",
                                                "text": "Żurawie szukają pożywienia na bagnach i łąkach."
                                            },
                                            {
                                                "example_id": "f636d2b6-6605-4400-a8a2-ef055304d90c",
                                                "sense_id": "e06f7ee4-08b9-33b2-b420-e95ecbcf1be7",
                                                "text": "Po wyjściu księdza Barbara krążyła po celi. Zobaczyła w zakratowanym oknie klucz żurawi, powracających do cieplejszych krajów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "żuraw",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "2d737efe-762b-3ad6-882f-9420f24969d0",
                                        "entry_id": "62489490-0acb-39a5-a482-4fe719caacdc",
                                        "glosses": [
                                            "urządzenie dźwignicowe z kolumną i wysięgnikiem służące do podnoszenia i przenoszenia ciężarów na niewielkie odległości"
                                        ],
                                        "tags": [],
