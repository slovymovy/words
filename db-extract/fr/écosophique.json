                            {
                                "example_id": "3a0a331e-a88a-42b8-b939-8d248dcef92c",
                                "sense_id": "75aa8292-1a53-3d58-9c8f-e9912a05d594",
                                "text": "Je conçois l’objet écosophique comme articulé selon quatre dimensions : celles de flux, de machine, de valeur et de territoire existentiel."
                            },
                            {
                                "example_id": "242cd438-aef7-46ba-9d67-1f36ee26df8a",
                                "sense_id": "75aa8292-1a53-3d58-9c8f-e9912a05d594",
                                "text": "C’est l’enjeu de ce livre que de repérer les courants qui silencieusement animent la nature en question. Ce que l’on nomme ici sensibilité écosophique."
                            }
                        ]
