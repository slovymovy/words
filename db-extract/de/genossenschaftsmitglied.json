                "senses": [
                    {
                        "sense_id": "117f4976-7c7e-3679-8d5b-6308daff9ef0",
                        "entry_id": "fa456e66-b97d-35ea-92ad-414b3cb10ea5",
                        "glosses": [
                            "jemand, die Mitglied einer Genossenschaft ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d962ece2-52cb-4000-afbe-219f475fbb8b",
                                "sense_id": "117f4976-7c7e-3679-8d5b-6308daff9ef0",
                                "text": "Die Genossenschaftsmitglieder trafen sich zu einer Sitzung."
                            },
                            {
                                "example_id": "a8cc67b5-6eef-47e8-a24a-0377aee9e406",
                                "sense_id": "117f4976-7c7e-3679-8d5b-6308daff9ef0",
                                "text": "„In den sieben Standorten Leoben, Trofaiach, Kapfenberg, Bruck, Pernegg und Niklasdorf könne man auf 37.000 Kunden und 22.000 Genossenschaftsmitglieder verweisen.“"
                            },
                            {
                                "example_id": "5790c2c7-f9a6-4adb-ab4e-cd43ee4acc38",
                                "sense_id": "117f4976-7c7e-3679-8d5b-6308daff9ef0",
                                "text": "„Die Kostenersparnis, so die Argumentation der OeNB in einem Brief an die Genossenschaftsmitglieder der Sparvereine vom 9. April sinngemäß, habe es ermöglicht, den Notenbankern Konditionen anzubieten wie es Kommerzbanken für ihre Mitarbeiter tun.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
