{
    "word_family": [
        "interiority",
        "interiorize",
        "interiormost"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5ec72512-ddc4-35dc-bac7-e87fe7fd2d6a",
                    "sense_definition": "The inside of a building, container, cavern, or other enclosed structure.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inside_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>interior</w> of the house was decorated with modern furniture and bright colors.",
                            "target_lang_translations": {
                                "ru": "<w>Интерьер</w> дома был обставлен современной мебелью и оформлен в ярких тонах.",
                                "zh": "房子的<w>内部</w>装饰着现代家具和明亮的色彩。"
                            }
                        },
                        {
                            "text": "She spent the whole afternoon painting the <w>interior</w> walls of her new apartment.",
                            "target_lang_translations": {
                                "ru": "Она провела весь день, раскрашивая <w>внутренние</w> стены своей новой квартиры.",
                                "zh": "她整个下午都在粉刷新公寓的<w>内墙</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "exterior"
                    ],
                    "common_phrases": [
                        "house interior",
                        "car interior",
                        "building interior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренняя часть здания, контейнера, пещеры или другого закрытого сооружения.",
                        "zh": "建筑物、容器、洞穴或其他封闭结构的内部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интерьер",
                                "target_lang_sense_clarification": "внутреннее пространство здания или помещения"
                            },
                            {
                                "target_lang_word": "внутренность",
                                "target_lang_sense_clarification": "пространство внутри чего-либо"
                            },
                            {
                                "target_lang_word": "внутренняя часть",
                                "target_lang_sense_clarification": "общая характеристика"
                            },
                            {
                                "target_lang_word": "салон",
                                "target_lang_sense_clarification": "внутреннее пространство автомобиля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内部",
                                "target_lang_sense_clarification": "建筑物、房间、容器等的里面"
                            },
                            {
                                "target_lang_word": "里面",
                                "target_lang_sense_clarification": "某物的里面，较口语"
                            },
                            {
                                "target_lang_word": "内饰",
                                "target_lang_sense_clarification": "车辆内部的装饰和配置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fe80826-021b-38fc-80ce-a3f8da157329",
                    "sense_definition": "The inside regions of a country, distanced from the borders or coasts.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers traveled deep into the African <w>interior</w> to find the source of the river.",
                            "target_lang_translations": {
                                "ru": "Исследователи отправились вглубь африканских <w>внутренних районов</w>, чтобы найти исток реки.",
                                "zh": "探险者深入非洲<w>内陆</w>，寻找这条河的源头。"
                            }
                        },
                        {
                            "text": "Many small villages in the <w>interior</w> region lack access to modern medical facilities.",
                            "target_lang_translations": {
                                "ru": "Многие небольшие деревни в <w>глубинке</w> не имеют доступа к современным медицинским учреждениям.",
                                "zh": "许多位于<w>内陆地区</w>的小村庄缺乏现代医疗设施。"
                            }
                        }
                    ],
                    "antonyms": [
                        "exterior"
                    ],
                    "common_phrases": [
                        "country interior",
                        "deep interior",
                        "explore the interior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внутренние районы страны, удаленные от границ или побережья.",
                        "zh": "一个国家内部、远离边境或海岸的地区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренние районы",
                                "target_lang_sense_clarification": "территории вдали от границ"
                            },
                            {
                                "target_lang_word": "глубинка",
                                "target_lang_sense_clarification": "удаленные от центра или моря части страны"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内陆",
                                "target_lang_sense_clarification": "远离海岸或边境的地区"
                            },
                            {
                                "target_lang_word": "内陆地区",
                                "target_lang_sense_clarification": "国家或地区内部较偏远的地方"
                            },
                            {
                                "target_lang_word": "腹地",
                                "target_lang_sense_clarification": "书面语，指内地深处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "acdbb38a-e9b0-3a93-9ab3-f9d3f53037cd",
                    "sense_definition": "The set of all interior points of a set.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In topology, the <w>interior</w> of a set consists of all points that are not on its boundary.",
                            "target_lang_translations": {
                                "ru": "В топологии <w>внутренность</w> множества состоит из всех точек, не лежащих на его границе.",
                                "zh": "在拓扑学中，一个集合的<w>内部</w>由所有不在其边界上的点组成。"
                            }
                        },
                        {
                            "text": "The professor explained how to calculate the <w>interior</w> of a closed disk in a metric space.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил, как вычислить <w>внутренность</w> замкнутого диска в метрическом пространстве.",
                                "zh": "教授讲解了如何计算度量空间中闭圆盘的<w>内部</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "exterior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Множество всех внутренних точек данного множества.",
                        "zh": "一个集合全部内点所构成的集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренность",
                                "target_lang_sense_clarification": "математический термин в топологии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内部",
                                "target_lang_sense_clarification": "拓扑学中指一个集合所有内点组成的部分"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9ac66be1-7e28-303e-9bca-f31ee71e3734",
                    "sense_definition": "Located within any limits, enclosure, or substance; inside; internal.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "inside_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>interior</w> design of the office focuses on creating a collaborative environment.",
                            "target_lang_translations": {
                                "ru": "<w>Внутренний</w> дизайн офиса ориентирован на создание среды для совместной работы.",
                                "zh": "办公室的<w>室内</w>设计注重营造协作环境。"
                            }
                        },
                        {
                            "text": "The <w>interior</w> surface of the bowl was smooth and polished to a high shine.",
                            "target_lang_translations": {
                                "ru": "<w>Внутренняя</w> поверхность чаши была гладкой и отполированной до блеска.",
                                "zh": "碗的<w>内侧</w>表面光滑，并且被打磨得非常光亮。"
                            }
                        }
                    ],
                    "antonyms": [
                        "exterior"
                    ],
                    "common_phrases": [
                        "interior design",
                        "interior walls",
                        "interior lighting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный внутри каких-либо границ, ограждений или вещества; внутренний.",
                        "zh": "位于某种界限、围护物或物体内部的；内部的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "находящийся внутри"
                            },
                            {
                                "target_lang_word": "интерьерный",
                                "target_lang_sense_clarification": "относящийся к дизайну помещений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内部的",
                                "target_lang_sense_clarification": "位于里面的；内部的"
                            },
                            {
                                "target_lang_word": "室内",
                                "target_lang_sense_clarification": "指房间、建筑内部的，常用于设计等"
                            },
                            {
                                "target_lang_word": "内侧",
                                "target_lang_sense_clarification": "物体朝里的那一面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12030b17-bac1-3e9a-9c8e-3f0fa87dbf90",
                    "sense_definition": "Remote from the limits, frontier, or shore; inland.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>interior</w> parts of the continent are much drier than the coastal areas.",
                            "target_lang_translations": {
                                "ru": "<w>Внутренние</w> части континента гораздо суше, чем прибрежные районы.",
                                "zh": "大陆<w>内陆</w>地区比沿海地区干燥得多。"
                            }
                        },
                        {
                            "text": "They moved to an <w>interior</w> province to escape the humid weather of the coast.",
                            "target_lang_translations": {
                                "ru": "Они переехали во <w>внутреннюю</w> провинцию, чтобы спастись от влажной погоды на побережье.",
                                "zh": "为了躲开海边潮湿的天气，他们搬到了一个<w>内陆的</w>省份。"
                            }
                        }
                    ],
                    "antonyms": [
                        "exterior"
                    ],
                    "common_phrases": [
                        "interior regions",
                        "interior provinces"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удаленный от границ, рубежей или берега; находящийся в глубине страны.",
                        "zh": "远离边界、边疆或海岸的；位于内地的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внутренний",
                                "target_lang_sense_clarification": "относящийся к глубине материка"
                            },
                            {
                                "target_lang_word": "материковый",
                                "target_lang_sense_clarification": "удаленный от моря"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "内陆的",
                                "target_lang_sense_clarification": "远离海岸、边界的；在内地的"
                            },
                            {
                                "target_lang_word": "内地的",
                                "target_lang_sense_clarification": "位于国家或大陆内部的"
                            }
                        ]
                    }
                }
            ]
        },
        {
