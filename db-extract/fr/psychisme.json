        "fr-extract.jsonl": [
            {
                "entry_id": "2c6ea41f-32b1-3da8-91e1-5bbb5c088469",
                "word": "psychisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aeaa75d1-020c-4a08-aff0-91de2c4594a8",
                        "entry_id": "2c6ea41f-32b1-3da8-91e1-5bbb5c088469",
                        "tags": [
                            "plural"
                        ],
                        "form": "psychismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb6c6c70-cd74-3548-8b73-f1182145fdad",
                        "entry_id": "2c6ea41f-32b1-3da8-91e1-5bbb5c088469",
                        "glosses": [
                            "Esprit ou psyché, en particulier considéré dans sa globalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b50ba02e-577d-4e7c-997b-8c2ec7bd9316",
                                "sense_id": "fb6c6c70-cd74-3548-8b73-f1182145fdad",
                                "text": "Le psychisme désigne ce qui n’est pas somatique, il est attaché au corps mais jusqu’à une certaine limite."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c3f3779-8641-3c77-9ca6-eeaf2e08d77f",
                        "entry_id": "2c6ea41f-32b1-3da8-91e1-5bbb5c088469",
                        "glosses": [
                            "Vie de l'esprit : ensemble de phénomènes participant à l’activité psychique, consciente ou inconsciente, considérée globalement ou partiellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a066d956-c990-4946-b776-f26dc1ef7c6b",
                                "sense_id": "8c3f3779-8641-3c77-9ca6-eeaf2e08d77f",
                                "text": "C’est une sorte de psychisme, tout comme l’agora-phobie ou la crampe des écrivains, devenue après l’emploi de la machine à écrire, la crampe des dactylographes."
                            },
                            {
                                "example_id": "65146dbe-c322-47e1-b76d-e0840d13e408",
                                "sense_id": "8c3f3779-8641-3c77-9ca6-eeaf2e08d77f",
                                "text": "Cet ego, les maîtres hindous parlant anglais l'appellent parfois tout simplement mind : un monde de conceptions, d'idées, d'émotions, de comparaisons, de goûts et de références au passé, que nous traduirons mieux par psychisme que par mental bien que le latin mens dérive du sanskrit manas."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7be106e-d052-38ed-ba65-6ae90fb0ed0c",
                        "entry_id": "2c6ea41f-32b1-3da8-91e1-5bbb5c088469",
                        "glosses": [
                            "Ensemble particulier de phénomènes psychiques formant un tout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c90eaa81-30db-46e8-a302-d79c9a5b67b7",
                                "sense_id": "b7be106e-d052-38ed-ba65-6ae90fb0ed0c",
                                "text": "Le psychisme inconscient, animal, morbide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5852b703-fc82-4835-8c21-e87a0fa52720",
                        "source_entry_id": "2c6ea41f-32b1-3da8-91e1-5bbb5c088469",
                        "source_sense_id": "fb6c6c70-cd74-3548-8b73-f1182145fdad",
                        "source_sense_description": "(Psychologie) Ensemble, conscient ou inconscient des phénomènes, des processus relevant de l’esprit et constituant la vie psychique",
                        "target_lang_word": "psyche",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psyche",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c99e9c32-da3a-3595-981f-a1d608a76f58",
                                        "entry_id": "92bae6c5-a1d1-3710-85a2-f27215b0a0b5",
                                        "glosses": [
                                            "The human soul, mind, or spirit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a61cc1f9-13ec-46d6-b575-0634e0922eb2",
                                                "sense_id": "c99e9c32-da3a-3595-981f-a1d608a76f58",
                                                "text": "I've been driving in L.A. / And the world, it feels too big / Like a floating ball that's bound to break / Snap my psyche like a twig"
                                            },
                                            {
                                                "example_id": "66df2769-c70a-4e03-a492-22cdf8cb40e2",
                                                "sense_id": "c99e9c32-da3a-3595-981f-a1d608a76f58",
                                                "text": "We feel we have been victimised over the centuries. It’s part of our psyche – underneath it all we side with the underdog.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96c71145-0a7b-3de1-9342-e13ee8953a40",
                                        "entry_id": "92bae6c5-a1d1-3710-85a2-f27215b0a0b5",
                                        "glosses": [
                                            "The human mind as the central force in thought, emotion, and behavior of an individual."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
