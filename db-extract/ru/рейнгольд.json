                                    {
                                        "sense_id": "98dffa6e-cbdf-39e0-a6b9-7daa8bc26909",
                                        "entry_id": "5106e94f-403e-3fbf-b3ab-709b561a9f73",
                                        "glosses": [
                                            "A male given name from the Germanic languages, today more popular in the forms Reginald and Ronald. Modern use is partly transferred from the surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "57188648-d85b-32ee-bcc7-d0a0f3f69450",
