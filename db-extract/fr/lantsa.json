                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d64ab95-3b6e-3648-a0f3-037f7fe369f3",
                        "entry_id": "63397f0a-ec09-3f2c-a94f-a15be2664b3e",
                        "glosses": [
                            "Relatif ou propre au lantsa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86b6ebfb-f390-4d1e-838b-eccecb9312fa",
                                "sense_id": "7d64ab95-3b6e-3648-a0f3-037f7fe369f3",
                                "text": "Yuling, le tombeau de l’empereur mandchou Qianlong (r.1736-1796) construit entre 1743 et 1752, est tout à fait remarquable, et pour l’instant unique en son genre, en ce que ses voûtes et ses murs sont décorés de représentations bouddhiques et d’inscriptions en tibétain et en écriture lantsa (plus de 30 000 caractères)."
                            },
                            {
                                "example_id": "5187161c-acad-404b-92ce-9a1b418086d7",
                                "sense_id": "7d64ab95-3b6e-3648-a0f3-037f7fe369f3",
                                "text": "La couverture de chaque volume, en bois laqué d’or, porte son titre sculpté en caractères lantsa."
                            },
                            {
                                "example_id": "28db515a-afeb-46b5-9448-8e849e1df9f9",
                                "sense_id": "7d64ab95-3b6e-3648-a0f3-037f7fe369f3",
                                "text": "Cet alphabet randja ou lantsa, est une variété du Devanagari ; il est surtout usité pour écrire en sanscrit les sentences mystiques, Dhāranis, qui doivent être reproduites sans aucune altération pour conserver leur efficacité ; bien que l’alphabet tibétain ait été adapté à leur reproduction exacte, l’alphabet randja est pourtant préféré dans beaucoup de cas."
                            }
                        ]
                    }
                ],
