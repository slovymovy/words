                                    {
                                        "sense_id": "1913fe4a-1e4a-320b-9fab-55d14b73a336",
                                        "entry_id": "0391a0b8-10d9-3baa-a16e-589d17148b32",
                                        "glosses": [
                                            "That or those belonging to you; the possessive second-person singular pronoun used without a following noun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bafa980e-6141-459b-a1c5-a0f90a881e8c",
                                                "sense_id": "1913fe4a-1e4a-320b-9fab-55d14b73a336",
                                                "text": "If this edit is mine, the other must be yours."
                                            },
                                            {
                                                "example_id": "550bca22-4e1e-4f3a-a53a-04483ea9aaf8",
                                                "sense_id": "1913fe4a-1e4a-320b-9fab-55d14b73a336",
                                                "text": "Their encyclopedia is good, but yours is even better."
                                            },
                                            {
                                                "example_id": "65a094b6-aae1-40fb-8f7b-b9c4a845c396",
                                                "sense_id": "1913fe4a-1e4a-320b-9fab-55d14b73a336",
                                                "text": "Are all these socks yours?"
                                            },
                                            {
                                                "example_id": "582d1984-60e8-4353-9119-bfbefd5e2bbe",
                                                "sense_id": "1913fe4a-1e4a-320b-9fab-55d14b73a336",
                                                "text": "The socks of yours are a bit niffy."
                                            },
                                            {
                                                "example_id": "b3d40817-bf5a-4232-be2a-9b96b531e249",
                                                "sense_id": "1913fe4a-1e4a-320b-9fab-55d14b73a336",
                                                "text": "“Heavens!” exclaimed Nina, “the blue-stocking and the fogy!—and yours are pale blue, Eileen!—you’re about as self-conscious as Drina—slumping there with your hair tumbling à la Mérode! Oh, it's very picturesque, of course, but a straight spine and good grooming is better.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be106e17-ba01-33a6-8ed0-17a9f581ec6b",
                                        "entry_id": "0391a0b8-10d9-3baa-a16e-589d17148b32",
                                        "glosses": [
                                            "Your house or home."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71652cda-12bc-4418-afed-4eecc3a4a2da",
                                                "sense_id": "be106e17-ba01-33a6-8ed0-17a9f581ec6b",
                                                "text": "Let's go over to yours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e2b16fd-7be1-389d-9ce5-49a9200221e6",
                                        "entry_id": "0391a0b8-10d9-3baa-a16e-589d17148b32",
                                        "glosses": [
                                            "Written at the end of a letter, before the signature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2890bfc-4fa9-4d23-981b-85eb7c32d0b6",
                                                "sense_id": "6e2b16fd-7be1-389d-9ce5-49a9200221e6",
                                                "text": "Yours sincerely,  Yours faithfully,  Yours,  Sincerely yours,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
