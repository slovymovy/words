            {
                "entry_id": "5881d833-e1ae-3823-b45b-cf08633243d9",
                "word": "post-vérité",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2a48edfb-ec9b-30c0-aaa9-b621a3d1e661",
                        "entry_id": "5881d833-e1ae-3823-b45b-cf08633243d9",
                        "glosses": [
                            "Qualifie une situation ou une stratégie dans lesquelles la réalité des faits et la véracité des propos sont secondaires, la priorité étant donnée aux émotions et aux opinions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a96fdbe3-4d9e-459b-8a11-6791208e3e42",
                                "sense_id": "2a48edfb-ec9b-30c0-aaa9-b621a3d1e661",
                                "text": "Les médias dans l’ère « de la politique post-vérité »"
                            },
                            {
                                "example_id": "e49b8f14-1fca-4453-a7ed-65c9cbdebd4a",
                                "sense_id": "2a48edfb-ec9b-30c0-aaa9-b621a3d1e661",
                                "text": "Toute expertise de « l'ère post-vérité » est accompagnée d'une image de Donald Trump (voir par exemple, sur BBC News Online ou dans le Guardian) ou encore d'une photo de ses partisans (The Spectator )."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "77b4ab4e-bfa1-4fe2-bbd3-f5dc6e90a72a",
                        "source_entry_id": "5881d833-e1ae-3823-b45b-cf08633243d9",
                        "source_sense_id": "2a48edfb-ec9b-30c0-aaa9-b621a3d1e661",
                        "target_lang_word": "postfaktisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postfaktisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5aae3367-e4ce-3b27-b06b-a273b9db59d7",
                                        "entry_id": "05b84d48-6437-3c6e-a1cd-274c1d95fbc2",
                                        "glosses": [
                                            "auf Gefühlen, nicht auf Tatsachen beruhend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23cc86cb-a976-4fc1-bb9a-e890f77dd5fe",
                                                "sense_id": "5aae3367-e4ce-3b27-b06b-a273b9db59d7",
                                                "text": "„Merkel stellte sich vors Mikro und sagte: ‚Es heißt ja neuerdings, wir lebten in postfaktischen Zeiten. Das soll wohl heißen, die Menschen interessieren sich nicht mehr für Fakten, sie folgen allein den Gefühlen.‘“"
                                            },
                                            {
                                                "example_id": "f18913ed-4b49-4bcc-9107-e73a619e8838",
                                                "sense_id": "5aae3367-e4ce-3b27-b06b-a273b9db59d7",
                                                "text": "„Der Schweizer Physiker und Philosoph Eduard Kaeser sieht im postfaktischen Zeitalter die Gefahr einer ‚Demokratie der Nichtwissenwollengesellschaft‘ – als Folge der Informationsflut in der digitalen Welt, die zentrale Standards wie Objektivität und Wahrheit auswäscht.“"
                                            },
                                            {
                                                "example_id": "22452d69-24e7-4b04-a912-0ee2a83f13a0",
                                                "sense_id": "5aae3367-e4ce-3b27-b06b-a273b9db59d7",
                                                "text": "„Trumps Politikstil wird oft als postfaktischer Politikstil (englisch: post-truth politics) konzeptionalisiert.“"
                                            },
                                            {
                                                "example_id": "ee621836-b580-4a0b-80c1-9c1722388dbc",
                                                "sense_id": "5aae3367-e4ce-3b27-b06b-a273b9db59d7",
                                                "text": "„‚Die Medien hatten einen derart großen Einfluss darauf, wie wir diesen Fall wahrgenommen haben‘, kritisiert Blackhurst, und McGinn ergänzt: ‚Wir befinden uns mittlerweile im Zeitalter der postfaktischen Demokratie, in der Tragödien wie diese mit Entertainment verschmelzen.‘“"
                                            },
                                            {
                                                "example_id": "ffb73c6a-8791-4033-9d3a-f12fe00a992a",
                                                "sense_id": "5aae3367-e4ce-3b27-b06b-a273b9db59d7",
                                                "text": "„Das postfaktische Zeitalter lässt sich nun einfach dadurch charakterisieren, dass in ihm das Szenario der Wahrheit gegenüber den beiden anderen Szenarien immer mehr an Gewicht verliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "501d3268-e170-4b28-b3da-2eb4d8dca722",
                        "source_entry_id": "5881d833-e1ae-3823-b45b-cf08633243d9",
                        "source_sense_id": "2a48edfb-ec9b-30c0-aaa9-b621a3d1e661",
                        "target_lang_word": "post-truth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "post-truth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0244f04a-d751-38a3-af17-fc424d6e2977",
                                        "entry_id": "7cb575ed-578e-3ec1-8331-f55de78a446c",
                                        "glosses": [
                                            "Beyond or superseding the importance of truth; pertaining to an era or situation when truth is no longer significant, relevant, or expected; (usually derogatory) not caring about factual accuracy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76df74c8-c5fe-414b-bcc3-db442ccdc3fd",
                                                "sense_id": "0244f04a-d751-38a3-af17-fc424d6e2977",
                                                "text": "He is, he claims, post-God, post-reality, post-truth, post-meaning, post- history, post-world, post-Western […]"
                                            },
                                            {
                                                "example_id": "dd12c351-410b-47dd-848b-78f04f138562",
                                                "sense_id": "0244f04a-d751-38a3-af17-fc424d6e2977",
                                                "text": "Victims or exiles should not repeat any longer what everybody already knows in the new 'post-truth' world order – that they are among numerous contemporary victims of war crimes and military violence […]"
                                            },
                                            {
                                                "example_id": "b2a75d2b-19a5-4877-a3b0-be73c9892542",
                                                "sense_id": "0244f04a-d751-38a3-af17-fc424d6e2977",
                                                "text": "Clearly quite a lot of journalism is post-truth . . . More important, perhaps, is journalism's post-truth tendency . . . to make no propositions for which there is a possible 'true/false' response."
                                            },
                                            {
                                                "example_id": "636a627a-7526-4d7f-95ad-d45298e2e102",
                                                "sense_id": "0244f04a-d751-38a3-af17-fc424d6e2977",
                                                "text": "In the post-truth world, the people are saturated by a plurality of discourses that are struggling for the consent of the audience, the difference being that the explosion of messages that characterises modernity is no longer stamped with the 'authority' of their authors."
                                            },
                                            {
                                                "example_id": "bc453c81-7817-4352-a559-d4628ca20471",
                                                "sense_id": "0244f04a-d751-38a3-af17-fc424d6e2977",
                                                "text": "In Christianity Today, columnist Charles Colson bemoaned our “post-truth society,” which produces liars such as Tawana Brawley, David Brock, and Stephen Ambrose."
                                            },
                                            {
                                                "example_id": "d0e4b80e-259c-4d0c-a4d4-a95eb225f510",
                                                "sense_id": "0244f04a-d751-38a3-af17-fc424d6e2977",
                                                "text": "Avoiding a cacophony is a worthy objective, because Australia has managed to largely sidestep the post-truth hellscape the US has endured during the pandemic because politicians, by and large, have chosen to inhabit a universe of shared facts and common messages."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "post-truth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91d80ae0-7cf2-34ea-8ffe-9c6199f8076f",
                                        "entry_id": "9b77a77c-2650-34c1-a515-a5d3a6495379",
                                        "glosses": [
                                            "The fact or state of being post-truth; a time period or situation in which facts have become less important than emotional persuasion."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb95a8b-fac1-49d9-a850-45d01e5494dc",
                                                "sense_id": "91d80ae0-7cf2-34ea-8ffe-9c6199f8076f",
                                                "text": "Post-truth has also been abetted by the evolution of the media."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
