                                        "entry_id": "1817cf70-0eba-3d2b-bdaa-ee189a825171",
                                        "glosses": [
                                            "Propriété de certains matériaux transparents vis-à-vis de la lumière qui est de diviser en deux un rayon lumineux qui les pénètre."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc27629-5899-4c38-a297-252239fd9ee1",
                                                "sense_id": "8b9ea34f-a4fa-31e2-a705-8650cb8f547e",
                                                "text": "Son examen à la lumière polarisée y révèle une biréfringence qui est, d'ailleurs, commune aux substances visqueuses étirées en fils."
                                            }
                                        ]
