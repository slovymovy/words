                    },
                    {
                        "translation_id": "e3ef0df5-3dd3-4987-8a63-92cd25103d4a",
                        "source_entry_id": "5a022867-9417-314c-ab8a-bda4af0737cc",
                        "source_sense_description": "a goal that equalizes the score",
                        "target_lang_word": "Ausgleich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausgleich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1bbb4f41-0b6f-304e-be12-126779f7cd55",
                                        "entry_id": "ec75af1a-3d7d-3d68-89be-f6be100c7299",
                                        "glosses": [
                                            "ein Gleichgewicht zustande bringen; Aufheben von Unterschieden durch Anpassung beider Seiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a28137a8-5075-4cbf-898c-682319e88831",
                                                "sense_id": "1bbb4f41-0b6f-304e-be12-126779f7cd55",
                                                "text": "„Auch als Ausgleich war die Schule wichtig. Wenn man über Jahre hinweg immer wieder die gleichen Abläufe trainiert, nur über Höhen und Wettkämpfe nachdenkt, verblödet man irgendwann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4e860899-5886-3ce0-9003-4dc70fcf2f40",
                                        "entry_id": "ec75af1a-3d7d-3d68-89be-f6be100c7299",
                                        "glosses": [
                                            "ein Gleichgewicht zustande bringen; das Lösen eines Streits"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67426737-17e4-4e84-9118-8ceed04c578a",
                                                "sense_id": "4e860899-5886-3ce0-9003-4dc70fcf2f40",
                                                "text": "„Papandreou und Fischer gratulierten dem Mann und rühmten ihn für sein tägliches Werk des Ausgleichs, der Völkerbegegnung und des Friedens.“"
                                            },
                                            {
                                                "example_id": "bc612ad4-9088-415d-bbe6-528faf18de47",
                                                "sense_id": "4e860899-5886-3ce0-9003-4dc70fcf2f40",
                                                "text": "„Eger (Cheb), die alte Reichsstadt, an den böhmischen König nur verpfändet und fest in deutscher Hand, war eine Hochburg des Widerstands gegen die Ausgleiche aller Art, wie die Wiener Regierungen zwischen Tschechen und Deutschen zu organisieren versuchten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "58074c15-d919-33be-b594-1de9a84a689e",
                                        "entry_id": "ec75af1a-3d7d-3d68-89be-f6be100c7299",
                                        "glosses": [
                                            "Sache, die etwas ersetzt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f193397-da0e-4895-a228-f202376b1313",
                                                "sense_id": "58074c15-d919-33be-b594-1de9a84a689e",
                                                "text": "Wenn Du mir eine Pizza ausgibst, erkläre ich dir als Ausgleich die Matheaufgaben."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "39beab38-8a62-37ef-8d17-373721f21cfb",
                                        "entry_id": "ec75af1a-3d7d-3d68-89be-f6be100c7299",
                                        "glosses": [
                                            "Geldbetrag, der Haben und Soll eines Konto auf gleichen Betrag bringt"
                                        ],
                                        "tags": [
                                            "Bankwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2972243-06a5-46e6-9939-0dbbf1e54a08",
                                                "sense_id": "39beab38-8a62-37ef-8d17-373721f21cfb",
                                                "text": "Auf dem Konto „Grundstücke“ „fehlt“ ein Betrag in Höhe von 200.000 Euro im Haben. Diesen Saldo buchen wir ein und bringen so das Konto zum Ausgleich."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1b117277-a868-30b2-b138-8728b36e5ce7",
                                        "entry_id": "ec75af1a-3d7d-3d68-89be-f6be100c7299",
                                        "glosses": [
                                            "Treffer oder Punkt, durch den zwei Mannschaften denselben Punktestand haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc6e7e15-4879-41ae-a036-c2cd262d5123",
                                                "sense_id": "1b117277-a868-30b2-b138-8728b36e5ce7",
                                                "text": "Gestern haben viele Angst gehabt, dass die russische Mannschaft noch den Ausgleich erzielt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "9e59167e-baaf-32a3-9a49-93e302db12c4",
                                        "entry_id": "ec75af1a-3d7d-3d68-89be-f6be100c7299",
                                        "glosses": [
