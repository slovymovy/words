                "senses": [
                    {
                        "sense_id": "2d0feaff-8699-3d6f-b712-eebb38a7470f",
                        "entry_id": "1138ae81-f561-34dd-a746-7cf3c0c9e53a",
                        "glosses": [
                            "(Économie) (Énergie) (Distribution) Qui subit l’influence des conditions météorologiques (ou des conditions météo) ; dont l’état, le fonctionnement ou la demande varient avec la météo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c77e042-2052-4a64-8cc0-422ab9b9d269",
                                "sense_id": "2d0feaff-8699-3d6f-b712-eebb38a7470f",
                                "text": "Aux États-Unis, en 1998, le secrétaire au Commerce William Dalley estimait déjà qu’un trillion de dollars de l’économie américaine était météo-sensible."
                            },
                            {
                                "example_id": "5f66f6a6-b0b8-4fc1-9c7f-3e6ad2864f89",
                                "sense_id": "2d0feaff-8699-3d6f-b712-eebb38a7470f",
                                "text": "Conséquence directe de ces études, Walmart adapte les affichages physiques et les publicités digitales dans les régions où ces conditions existent, avec des gains de 18 à 300 % sur les ventes de ce produit « météo-sensible »."
                            },
                            {
                                "example_id": "30e5a94a-2656-477f-8bda-bb65475e4915",
                                "sense_id": "2d0feaff-8699-3d6f-b712-eebb38a7470f",
                                "text": "Êtes-vous météo-sensible ?"
                            }
                        ]
                    }
