                    {
                        "translation_id": "fc2bd759-52b5-40a4-9b1e-262edf670111",
                        "source_entry_id": "c54de9ce-0355-38f3-bd8a-072dc9fc6335",
                        "source_sense_id": "16150c8f-da69-37e9-9400-ebbb1ebfa54d",
