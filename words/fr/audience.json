    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c6f33da-8a00-3c6c-a1f3-bd16c466f999",
                    "sense_definition": "Ensemble des personnes qui suivent un média, une émission ou un contenu culturel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle émission de télévision a réuni une très large <w>audience</w> dès sa première diffusion."
                        },
                        {
                            "text": "Le journal cherche à élargir son <w>audience</w> auprès d'un public plus jeune sur internet."
                        }
                    ],
                    "common_phrases": [
                        "forte audience",
                        "large audience",
                        "part d'audience"
                    ]
                },
                {
                    "sense_id": "d380328a-0ee6-342f-bbef-c72473a23800",
                    "sense_definition": "Séance au cours de laquelle un tribunal écoute les plaidoiries et examine une affaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a décidé de suspendre l'<w>audience</w> pendant une demi-heure avant de rendre sa décision."
                        },
                        {
                            "text": "Les journalistes ont été autorisés à assister à l'<w>audience</w> publique du procès."
                        }
                    ],
                    "synonyms": [
                        "séance"
                    ],
                    "common_phrases": [
                        "audience publique",
                        "lever l'audience",
                        "tenir audience"
                    ]
                },
                {
                    "sense_id": "79a5e0bc-4828-37ba-939f-d062ed5e9ebc",
                    "sense_definition": "Entrevue formelle accordée par une haute personnalité à une personne pour l'écouter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef de l'État a accordé une <w>audience</w> privée à la délégation étrangère ce matin."
                        },
                        {
                            "text": "L'ambassadeur a sollicité une <w>audience</w> auprès du ministre pour discuter de la situation."
                        }
                    ],
                    "synonyms": [
                        "entretien"
                    ],
                    "common_phrases": [
