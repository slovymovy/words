                        "glosses": [
                            "deel van een (inktjet)printer dat het af te drukken materiaal op een ondergrond aanbrengt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9df7ba59-7fe7-4818-88cf-9706cc11abb0",
                                "sense_id": "529ede26-4519-3d7b-a2dd-382465eeb565",
                                "text": "De betonprinter lijkt op een bovenloop-hijskraan, met in plaats van een hijskabel, een op en neer beweegbare en draaibare printkop voor beton. Daar wordt via een slang beton naartoe gebracht."
                            },
                            {
                                "example_id": "258a0315-0363-4de2-aec1-4c4f602d938f",
                                "sense_id": "529ede26-4519-3d7b-a2dd-382465eeb565",
                                "text": "De ‘printkop’ kan verf aanbrengen op driedimensionale oppervlakken zonder ‘overspray’, waardoor complexe vormen, zoals een vingerafdruk, feilloos kunnen worden gecreëerd."
                            }
                        ]
                    }
