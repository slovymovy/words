                    {
                        "sense_id": "224eee2c-9ff9-3186-a4f6-8d4e6c9491c3",
                        "entry_id": "24c3ec8e-af67-3410-aa94-dd6697d6aba4",
                        "glosses": [
                            "adellijke titel, in rang tussen jonkheer en burggraaf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "206293d7-b546-4d07-8894-3a0197a0d0e5",
                                "sense_id": "224eee2c-9ff9-3186-a4f6-8d4e6c9491c3",
                                "text": "Haar vader de baron verlangde een welgestelde schoonzoon en dat was een onmogelijke eis."
                            },
                            {
                                "example_id": "42033e27-7ae7-4551-bd0e-5bfb2db92f11",
                                "sense_id": "224eee2c-9ff9-3186-a4f6-8d4e6c9491c3",
                                "text": "De baron van Münchhausen is een bekende romanfiguur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bcbe9c0-724b-41c3-b482-c2c018767316",
                        "source_entry_id": "24c3ec8e-af67-3410-aa94-dd6697d6aba4",
                        "source_sense_id": "224eee2c-9ff9-3186-a4f6-8d4e6c9491c3",
                        "source_sense_description": "adellijke titel, in rang tussen jonkheer en burggraaf",
                        "target_lang_word": "Baron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab52e940-88a2-3694-8046-50a630a3ea5f",
                                        "entry_id": "668f9aa3-9073-3fbc-907d-f4df1fd6d92b",
                                        "glosses": [
                                            "französischer Adelstitel, der gleichwertig mit dem deutschen Freiherr ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5461ae05-c167-482c-a337-30462b0de1e3",
                                                "sense_id": "ab52e940-88a2-3694-8046-50a630a3ea5f",
                                                "text": "Ein Baron ist ein Adeliger."
                                            },
                                            {
                                                "example_id": "49593bb3-ef3b-476a-a5ae-204462412578",
                                                "sense_id": "ab52e940-88a2-3694-8046-50a630a3ea5f",
                                                "text": "„Der alte Baron war kein besonderer Landwirt und überließ die Landwirtschaft ganz seinem Inspektor, und was der ihm riet, das tat er.“"
                                            },
                                            {
                                                "example_id": "f98099b2-899c-4557-951e-1325061dce72",
                                                "sense_id": "ab52e940-88a2-3694-8046-50a630a3ea5f",
                                                "text": "„Der feine Baron hatte eine Geliebte, die sich auf eine Hängematte legte und dabei ihre Beine senkrecht nach oben streckte.“"
                                            },
                                            {
                                                "example_id": "0c00f0d8-3c7d-49d9-98b0-130fa8ab9580",
                                                "sense_id": "ab52e940-88a2-3694-8046-50a630a3ea5f",
                                                "text": "„Diese Barone sind zwar in der vielköpfigen hinterpommerschen Sippe der Puttkamers eigentlich Außenseiter; nicht ihnen gehören die Güter.“"
                                            },
                                            {
                                                "example_id": "c6fa93f0-8b17-448c-b4d7-2573e139cdc2",
                                                "sense_id": "ab52e940-88a2-3694-8046-50a630a3ea5f",
                                                "text": "„Beim Souper machte man mich zum Baron.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d3603284-3590-3031-9e87-2a4af3d5c081",
                                        "entry_id": "668f9aa3-9073-3fbc-907d-f4df1fd6d92b",
                                        "glosses": [
                                            "eine Rebsorte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "238cd2d4-deb1-4342-b5e7-e98dd87b0e48",
                                                "sense_id": "d3603284-3590-3031-9e87-2a4af3d5c081",
                                                "text": "Baron trotzt dem Pilzbefall besser als andere Weinsorten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "695e9583-3297-49a4-af96-4be560b6efa2",
                        "source_entry_id": "24c3ec8e-af67-3410-aa94-dd6697d6aba4",
                        "source_sense_id": "224eee2c-9ff9-3186-a4f6-8d4e6c9491c3",
                        "source_sense_description": "adellijke titel, in rang tussen jonkheer en burggraaf",
                        "target_lang_word": "Freiherr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freiherr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e25fb3cb-0664-36a4-a268-dcf10bf84b70",
                                        "entry_id": "83d76e4e-7989-3bbe-827a-7260d899417a",
                                        "glosses": [
                                            "Adelstitel"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6a7d3db-0f56-42e3-8108-0434a060c46a",
                                                "sense_id": "e25fb3cb-0664-36a4-a268-dcf10bf84b70",
                                                "text": "Der Adelstitel „Freiherr“ bezeichnet einen Angehörigen des niederen Adels und ist Bestandteil des Familiennamens, er steht nach dem Vornamen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50845da9-d1f5-3949-b076-aacc2f82aa2d",
                                        "entry_id": "83d76e4e-7989-3bbe-827a-7260d899417a",
                                        "glosses": [
                                            "Träger dieses Adelstitels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "033f020a-4d87-411d-9b69-03ed2485939e",
                                                "sense_id": "50845da9-d1f5-3949-b076-aacc2f82aa2d",
                                                "text": "„Dem Freiherrn selber jedoch war die Popularität als Lügenbaron eher peinlich, zudem erwies sich sein zweifelhafter Ruf bei einem späteren Scheidungsprozess, der ihn finanziell ruinierte, als wenig vorteilhaft.“"
                                            },
                                            {
                                                "example_id": "a5193121-40b6-4fe6-a698-8fa6d891e68f",
                                                "sense_id": "50845da9-d1f5-3949-b076-aacc2f82aa2d",
                                                "text": "„Auch wenn die meisten Gutsherren in den 1930er Jahren keine Grafen und Freiherrn mehr waren, verhielten sie sich oft so.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d39fb7f-0db6-43c5-a700-180a43e6d4bb",
                        "source_entry_id": "24c3ec8e-af67-3410-aa94-dd6697d6aba4",
                        "source_sense_id": "224eee2c-9ff9-3186-a4f6-8d4e6c9491c3",
                        "source_sense_description": "adellijke titel, in rang tussen jonkheer en burggraaf",
                        "target_lang_word": "baron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ee56649-2534-3a5b-9ab0-92d1096aec50",
                                        "entry_id": "9c61688d-f2bb-3593-8200-84219ae552dd",
                                        "glosses": [
                                            "The male ruler of a barony."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0f177b4d-1e95-3510-b377-892a389ceba9",
                                        "entry_id": "9c61688d-f2bb-3593-8200-84219ae552dd",
                                        "glosses": [
                                            "A male member of the lowest rank of English nobility (the equivalent rank in Scotland is lord)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f112af9-93dd-3736-b3ff-52d88622cb3f",
                                        "entry_id": "9c61688d-f2bb-3593-8200-84219ae552dd",
                                        "glosses": [
                                            "A person of great power in society, especially in business and politics."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f996348a-aff9-4f6f-a108-413df8f8fbe9",
                                                "sense_id": "1f112af9-93dd-3736-b3ff-52d88622cb3f",
                                                "text": "There were a few exotics among them — some South American boys, sons of Argentine beef barons, one or two Russians, and even a Siamese prince, or someone who was described as a prince."
                                            },
                                            {
                                                "example_id": "e19bf30c-d8e3-48ec-b07b-b2e0bf04bcbf",
                                                "sense_id": "1f112af9-93dd-3736-b3ff-52d88622cb3f",
                                                "text": "British journalists shun complete respectability, feeling a duty to be ready to savage the mighty, or rummage through their bins. Elsewhere in Europe, government contracts and subsidies ensure that press barons will only defy the mighty so far."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6a92b22-ff81-3b80-969b-b8f3cff4c495",
                                        "entry_id": "9c61688d-f2bb-3593-8200-84219ae552dd",
                                        "glosses": [
                                            "A prisoner who gains power and influence by lending or selling goods such as tobacco."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c4614e2-2670-4fbf-b52d-c4a66b07cd75",
                                                "sense_id": "d6a92b22-ff81-3b80-969b-b8f3cff4c495",
                                                "text": "The first thing a baron does is to accumulate a supply of tobacco. He spends every penny he can earn on laying it in […]"
                                            },
                                            {
                                                "example_id": "e21d2120-8333-4aa5-894e-c42faabfb6e3",
                                                "sense_id": "d6a92b22-ff81-3b80-969b-b8f3cff4c495",
                                                "text": "Nevertheless, from my own agonies of the first few months, after which I did not miss smoking at all, I could appreciate the need of others. It was in this atmosphere of craving that the 'barons' thrived. Barons are prisoners who lend tobacco."
                                            },
                                            {
                                                "example_id": "bff0ff14-ed9c-4171-8dce-39f134393b19",
                                                "sense_id": "d6a92b22-ff81-3b80-969b-b8f3cff4c495",
                                                "text": "In British prisons tobacco still remains the gold standard which is made to back every transaction and promise. The official allowance is barely sufficient for individual smoking needs, but tobacco may expensively be borrowed or bought from a baron, possibly through his runner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bde39a7-2617-39e1-9808-98280289bf80",
                                        "entry_id": "9c61688d-f2bb-3593-8200-84219ae552dd",
                                        "glosses": [
                                            "A baron of beef, a cut made up of a double sirloin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf150dd-1327-47ac-a294-868cfb4f3e06",
                                                "sense_id": "7bde39a7-2617-39e1-9808-98280289bf80",
                                                "text": "Such portentous appetites had Queequeg and Tashtego, that to fill out the vacancies made by the previous repast, often the pale Dough-Boy was fain to bring on a great baron of salt-junk, seemingly quarried out of the solid ox."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14c336c8-8c7b-301c-bed5-b1ff01fb9378",
                                        "entry_id": "9c61688d-f2bb-3593-8200-84219ae552dd",
                                        "glosses": [
                                            "Any of various nymphalid butterflies of the genus Euthalia."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ea13a04-ebd5-3453-ae04-f0b3786cf54e",
                                        "entry_id": "9c61688d-f2bb-3593-8200-84219ae552dd",
                                        "glosses": [
                                            "A husband."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91fe56a4-7780-4cfe-a266-f3f6a00ca289",
                                                "sense_id": "7ea13a04-ebd5-3453-ae04-f0b3786cf54e",
                                                "text": "baron and femme",
                                                "translation": "husband and wife",
                                                "english": "husband and wife"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41511a28-4b62-428e-ba96-ed9507319a39",
                        "source_entry_id": "24c3ec8e-af67-3410-aa94-dd6697d6aba4",
                        "source_sense_id": "224eee2c-9ff9-3186-a4f6-8d4e6c9491c3",
                        "source_sense_description": "adellijke titel, in rang tussen jonkheer en burggraaf",
                        "target_lang_word": "baron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99d92272-67f5-335b-86f4-1e4439d1d0df",
                                        "entry_id": "b0aac729-84e5-39db-86be-1d4ac624821c",
                                        "glosses": [
                                            "Grand seigneur du royaume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef05ac32-d528-437b-a88e-22a63b380f2e",
                                                "sense_id": "99d92272-67f5-335b-86f4-1e4439d1d0df",
                                                "text": "Le roi assembla ses barons."
                                            },
                                            {
                                                "example_id": "ce95c229-f200-4a43-91a2-fca1a3a85c76",
                                                "sense_id": "99d92272-67f5-335b-86f4-1e4439d1d0df",
                                                "text": "Les hauts barons, les principaux d’entre les seigneurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb7a4b1-0a59-3c21-b9ca-607969bd5e1d",
                                        "entry_id": "b0aac729-84e5-39db-86be-1d4ac624821c",
                                        "glosses": [
                                            "Noble possédant une terre avec titre de baronnie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fea82715-a386-4ad4-a04c-6e0148b45e16",
                                                "sense_id": "dfb7a4b1-0a59-3c21-b9ca-607969bd5e1d",
                                                "text": "La société enrichie la veille par des spéculations, honnêtes ou non, joignait à ses richesses des titres nobiliaires ; chacun s’improvisait comte, marquis ou baron."
                                            },
                                            {
                                                "example_id": "e8c5974c-9dd5-45fa-958b-c8e3c0167c8e",
                                                "sense_id": "dfb7a4b1-0a59-3c21-b9ca-607969bd5e1d",
                                                "text": "L’autre est venu se présenter, en disant : « Je suis le baron des Acates », et M. le comte a dit : « Je vous croyais baron d’Agneau. » L’autre est parti sans dire un mot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2895941d-0ab1-3c0e-84f6-1dd30e9d6ab3",
                                        "entry_id": "b0aac729-84e5-39db-86be-1d4ac624821c",
                                        "glosses": [
                                            "Homme puissant dans son domaine."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fac3a196-0644-43fa-b28b-447ccc5a4fed",
                                                "sense_id": "2895941d-0ab1-3c0e-84f6-1dd30e9d6ab3",
                                                "text": "Malgré sa chute et celle d'autres barons de la drogue, la Colombie reste le premier producteur mondial de cocaïne et les États-Unis son plus grand marché."
                                            },
                                            {
                                                "example_id": "614341f0-fd86-40db-a53c-0aa3ff431e4a",
                                                "sense_id": "2895941d-0ab1-3c0e-84f6-1dd30e9d6ab3",
                                                "text": "Les hauts barons de la finance, de l’industrie, les financiers, les industriels les plus riches et les plus puissants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f051395f-fc81-34e4-b427-ce3ea9c1989a",
                                        "entry_id": "b0aac729-84e5-39db-86be-1d4ac624821c",
                                        "glosses": [
                                            "Mari."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eabe5376-ba5e-444a-9d93-4869762d32db",
                                                "sense_id": "f051395f-fc81-34e4-b427-ce3ea9c1989a",
                                                "text": "Il fallait encore qu’une femme fût autorisée par son baron, c’est-à-dire son mari, pour appeler ; mais sans cette autorité elle pouvait être appelée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62ac400b-21ef-3d4d-b26a-3e99f52e631f",
                                        "entry_id": "b0aac729-84e5-39db-86be-1d4ac624821c",
                                        "glosses": [
                                            "Faux client complice du vendeur qui achète un produit dans le but d’inciter de façon subliminale les gens à acheter aussi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37a7f77b-a14a-4c02-9d89-ec72adfa42f9",
                                                "sense_id": "62ac400b-21ef-3d4d-b26a-3e99f52e631f",
                                                "text": "Le voilà donc qui fait le baron et ramasse un peu de fric, ça nous fait de quoi se payer plein de gâteaux ou aller tirer un coup au claque."
                                            },
