                            {
                                "example_id": "1caaeec2-fe4e-4a56-9c96-61724e9296f3",
                                "sense_id": "8ae8ab0f-d8b5-31b9-98db-e7e3118cb4e5",
                                "text": "Nach den Meutereien im französischen Heer 1917 kam es zu vielen Füsilladen."
                            }
                        ],
                        "sense_index_json": "\"1\""
