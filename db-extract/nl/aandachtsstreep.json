                        "source_sense_id": "875e62a4-de3f-364c-99cd-2ac0b379a785",
                        "source_sense_description": "een streepje als leesteken om een tussenzin af te scheiden",
                        "target_lang_word": "tiret",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
