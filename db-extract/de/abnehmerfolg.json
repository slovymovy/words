                "senses": [
                    {
                        "sense_id": "afb3fa65-7306-339e-af20-c6ab819788fb",
                        "entry_id": "b36223b9-34e4-3871-8d41-2b790d86fc6f",
                        "glosses": [
                            "erfolgreiches Reduzieren des Körpergewichts (Erreichen eines gewünschten Gewichtsverlusts oder langfristige Aufrechterhaltung eines reduzierten Gewichts)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c87b734-6f52-4e82-bd55-1ada86dfab09",
                                "sense_id": "afb3fa65-7306-339e-af20-c6ab819788fb",
                                "text": "„Um einen nachhaltigen Abnehmerfolg zur erzielen und den Jojo-Effekt zu vermeiden, empfehlen wir unter Anwendung von formoline L112 eine schrittweise Reduzierung Ihres Körpergewichtes von circa 0,5 Kilogramm pro Woche.“"
                            },
                            {
                                "example_id": "39e2d187-ff32-446b-b934-1d7d802c1636",
                                "sense_id": "afb3fa65-7306-339e-af20-c6ab819788fb",
                                "text": "„Wird die Muskelmasse und dadurch der Grundumsatz erhöht, ermöglichst Du langfristig einen dauerhaften Abnehmerfolg.“"
                            },
                            {
                                "example_id": "fb6f3040-9623-4f14-a97a-b8bce3af73ec",
                                "sense_id": "afb3fa65-7306-339e-af20-c6ab819788fb",
                                "text": "„Ein dauerhafter Abnehmerfolg stellt sich nur ein, wenn das geänderte Essverhalten gut in Ihren individuellen Alltag passt und Ihre persönliche Essvorlieben berücksichtigt.“"
                            },
                            {
                                "example_id": "f8f2c951-3c97-4729-8981-9d0abf496e7f",
                                "sense_id": "afb3fa65-7306-339e-af20-c6ab819788fb",
                                "text": "„Die Hypnose steigert also den Abnehmerfolg und sorgt dafür, dass man nicht in das alte Verhaltensmuster zurückfällt.“"
                            },
                            {
                                "example_id": "e9ca5dd2-bc25-4250-89c3-6a3a20afcc54",
                                "sense_id": "afb3fa65-7306-339e-af20-c6ab819788fb",
                                "text": "„Bevor man mit dem Abnehmen anfängt, ist es sinnvoll, den persönlichen Grundumsatz zu kennen, um daraus dann einen möglichst genauen Kalorienbedarf zu errechnen, welches zum Abnehmerfolg maßgebend beiträgt.“"
                            },
                            {
                                "example_id": "a65b502e-6610-4eaa-ac6e-6b99c4c662fa",
                                "sense_id": "afb3fa65-7306-339e-af20-c6ab819788fb",
                                "text": "„Durch die beanstandeten Werbeaussagen bringe die Beklagte aber nicht zum Ausdruck, dass der Abnehmerfolg auch bei Rückkehr zur Normalkost erhalten bleibe.“"
                            },
                            {
                                "example_id": "5435b1e0-7da3-49a0-bba5-7de4bea293c1",
                                "sense_id": "afb3fa65-7306-339e-af20-c6ab819788fb",
                                "text": "„Auch die Ausführungen des Beamten, wonach er mit Einverständnis des Mitarbeiters XXXX in einer Teambesprechung dessen Abnehmerfolg besprochen hat, werden durch Zeugenbefragung zu überprüfen sein.“"
                            },
                            {
                                "example_id": "5bfe9ec6-dfaf-4f5d-a957-41994e108d64",
                                "sense_id": "afb3fa65-7306-339e-af20-c6ab819788fb",
                                "text": "„Auch hier sei das Plateau noch nicht erreicht, so dass längerfristig noch größere Abnehmerfolge denkbar seien, hieß es.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
