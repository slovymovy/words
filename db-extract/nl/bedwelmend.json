                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5d529aa4-2f48-31cf-9f9c-40e3922af49a",
                        "entry_id": "16d29e31-fc11-339c-bfb1-be7d8b23cd1f",
                        "glosses": [
                            "van iets dat men erdoor in slaap valt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7445bcc-311e-4a90-861f-fb383b8f2189",
                                "sense_id": "5d529aa4-2f48-31cf-9f9c-40e3922af49a",
                                "text": "De scheermessen zijn behoedzaam gegaard, een paar tellen in de braadpan, zodat ze hun zachte, bedwelmende en in de nasmaak wat zoetige karakter hebben behouden."
                            },
                            {
                                "example_id": "c3157192-f72d-4f39-b8fe-a32ff6d5d6a7",
                                "sense_id": "5d529aa4-2f48-31cf-9f9c-40e3922af49a",
                                "text": "Allemaal zouden ze het slachtoffer zijn geworden van bedwelmende drugs en zijn grijpgrage handjes."
                            },
                            {
                                "example_id": "636c230a-6939-4b45-957e-5aefe68ccda1",
                                "sense_id": "5d529aa4-2f48-31cf-9f9c-40e3922af49a",
                                "text": "Ze mocht zich in een hoekje van Olives zolderkamer installeren, waar ze penselen en kleren sorteerde, een bedwelmend genot dat op de wapenstilstand volgde."
                            }
                        ]
                    }
