                                                "example_id": "303ba1cc-93b4-4cdf-ab45-7320f837c58c",
                                                "sense_id": "9653f82a-122b-301f-bfc2-e722089f248f",
                                                "text": "Alte Brötchen in feine Scheibchen schneiden, altes Brot bröckeln und in eine feuerfeste Form geben."
                                            },
                                            {
                                                "example_id": "5dbcf5fe-8a3a-4c53-a125-2d239d525455",
                                                "sense_id": "9653f82a-122b-301f-bfc2-e722089f248f",
                                                "text": "Schokolade bröckeln und in einem Topf mit etwas Wasser und 1/2 Teelöffel Butter schmelzen, ständig rühren, bis das Wasser verdampft ist, beiseite stellen, warm halten."
                                            },
                                            {
                                                "example_id": "ae8683d0-493a-4914-a33b-6399aca3de71",
                                                "sense_id": "9653f82a-122b-301f-bfc2-e722089f248f",
                                                "text": "Mehl und Mondamin in eine Schüssel sieben, in die Mitte in eine Vertiefung die Hefe bröckeln und mit lauwarmer Milch und etwas Mehl und Mondamin verrühren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "027f61e3-8bd7-48c9-9a5f-478980b60934",
                        "source_entry_id": "2cddac23-9563-3e65-9f10-3c1619837610",
                        "source_sense_id": "74e12861-9696-3500-9927-b562461368a3",
                        "target_lang_word": "zerbröckeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zerbröckeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e5fcbf1-f2a4-338c-a259-b7129e95e25c",
                                        "entry_id": "4e39ddbd-0b9d-3410-aa0c-463775f444ac",
                                        "glosses": [
                                            "in kleine Teile (Brocken, Bröckchen) zerbrechen"
                                        ],
                                        "tags": [
                                            "auxiliary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b7bbac8-cf27-45ad-8d53-65a780d92d00",
                                                "sense_id": "6e5fcbf1-f2a4-338c-a259-b7129e95e25c",
                                                "text": "Sie zerbröckelte das trockene Brot und verfütterte es an die Enten."
                                            },
                                            {
                                                "example_id": "fc8a8d16-8ad3-4c51-9577-a8a0e2dfa1cb",
                                                "sense_id": "6e5fcbf1-f2a4-338c-a259-b7129e95e25c",
                                                "text": "Man zerbröckelt die Kekse vorsichtig mit den Fingern."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0ecea282-1455-3071-99e2-fc657975cf74",
                                        "entry_id": "4e39ddbd-0b9d-3410-aa0c-463775f444ac",
                                        "glosses": [
                                            "Risse bekommen, (von selbst) auseinanderfallen"
                                        ],
                                        "tags": [
                                            "auxiliary verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04674003-5429-4476-9ac0-83900d2cdcfb",
                                                "sense_id": "0ecea282-1455-3071-99e2-fc657975cf74",
                                                "text": "Der Lehm zerbröckelt zwischen den Fingern."
                                            },
                                            {
                                                "example_id": "d24d6cbe-bfa5-489b-bbf9-b26cbe252336",
                                                "sense_id": "0ecea282-1455-3071-99e2-fc657975cf74",
                                                "text": "Im permanenten Wüstenwind zerbröckeln die Mauern."
                                            },
                                            {
                                                "example_id": "5e52ce09-33f3-42fc-aee0-322d6bdaa478",
                                                "sense_id": "0ecea282-1455-3071-99e2-fc657975cf74",
                                                "text": "„Aber die deutsche Front zerbröckelt, und der Krieg geht langsam zu Ende.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
