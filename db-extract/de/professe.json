                "senses": [
                    {
                        "sense_id": "6d13e3b5-b5ef-3f1b-b175-7bb299be121b",
                        "entry_id": "4567baab-0255-39ea-bdf1-254613aa93be",
                        "glosses": [
                            "weibliche Person, die mit dem Ablegen der Ordensgelübde einem Orden beitritt"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "32197717-850d-4fb3-8336-124a6faee82d",
                                "sense_id": "6d13e3b5-b5ef-3f1b-b175-7bb299be121b",
                                "text": "„Im Einzelnen verspricht der oder die Professe den im Matthäusevangelium genannten Räten der Armut, der ehelosen Keuschheit und des Gehorsams zu folgen und sich für einen bestimmten Zeitraum (zeitliche Profess) oder dauerhaft (ewige Profess) an die Ordernsgemeinschaft zu binden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
