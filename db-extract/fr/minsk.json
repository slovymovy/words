                        ]
                    },
                    {
                        "translation_id": "f83d4f61-8693-4b45-b92a-74b654eebb22",
                        "source_entry_id": "749411a3-0a23-3315-b808-c18f60066b8b",
                        "source_sense_description": "capitale biélorusse",
