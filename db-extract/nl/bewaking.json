                                    {
                                        "sense_id": "cb5df153-fa1a-3355-b3a2-69f32592a195",
                                        "entry_id": "c7decca2-4e14-3b8d-9d18-5d7c47ec7a1f",
                                        "glosses": [
                                            "Handlung, jemand oder etwas unter Beaufsichtigung/Beobachtung zu halten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3a6795f-2862-402c-a700-ed5b817cbd6a",
                                                "sense_id": "cb5df153-fa1a-3355-b3a2-69f32592a195",
                                                "text": "„Als Haftort wurde der riesige Komplex des Spandauer Gefängnisses eingerichtet, wo sich die Siegermächte im monatlichen Wechsel bei der Bewachung ablösten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "169dc311-ba8d-3713-94a2-beb9370b2767",
                                        "entry_id": "c7decca2-4e14-3b8d-9d18-5d7c47ec7a1f",
                                        "glosses": [
                                            "Person/Gruppe, die [1] durchführt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e42d5594-d3dd-4001-9a6b-2984d4ed6257",
                                                "sense_id": "169dc311-ba8d-3713-94a2-beb9370b2767",
                                                "text": "„Unten hören sie mit harten Schritten die Patrouille auf und ab marschieren, aber diese Bewachung schreckt sie nicht, denn sie wissen, unter dieser Sansculottenuniform schlagen befreundete Herzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e4c70ca-b8c5-427d-acdb-9670673022ad",
                        "source_entry_id": "79845993-1cfa-3afa-b37e-6b223f54901b",
                        "target_lang_word": "surveillance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surveillance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66c83986-6d97-3d79-9aa7-b39439af05ea",
                                        "entry_id": "5e3977b7-63b3-3b4c-9cf4-16ee844eb1c4",
                                        "glosses": [
                                            "Close observation of an individual or group; person or persons under suspicion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f34799e-f447-3f02-9768-c1ae6c85f938",
                                        "entry_id": "5e3977b7-63b3-3b4c-9cf4-16ee844eb1c4",
                                        "glosses": [
                                            "Continuous monitoring of disease occurrence for example."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d36993fd-ba3f-4b60-8062-82032435a148",
                                                "sense_id": "6f34799e-f447-3f02-9768-c1ae6c85f938",
                                                "text": "Lady Anne appeared in a week or two to have greatly recovered her appetite, and she talked much of the benefit derived from her native air, in order to gain which, she constantly drove out in Lord Rotheles's carriages, and appeared to derive comfort from her admiration of his beautiful bays; beyond this Helen could not perceive that her airings were useful, as her cough increased exceedingly, and all the visitants at the castle expressed surprise \"that she did not place herself under the surveillance of one or other of the great physicians of the metropolis.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8341e4e2-8611-3999-8e15-891acd51f321",
                                        "entry_id": "5e3977b7-63b3-3b4c-9cf4-16ee844eb1c4",
                                        "glosses": [
                                            "Systematic observation of places and people by visual, aural, electronic, photographic or other means."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88a8d9ae-b5f4-4ba4-ae06-6ce8811e978b",
                                                "sense_id": "8341e4e2-8611-3999-8e15-891acd51f321",
                                                "text": "The threat of terrorism to the British lies in the overreaction to it of British governments. Each one in turn clicks up the ratchet of surveillance, intrusion and security. Each one diminishes liberty."
                                            },
                                            {
                                                "example_id": "b2aa126f-a5da-4cdd-b700-6de58809a9a4",
                                                "sense_id": "8341e4e2-8611-3999-8e15-891acd51f321",
                                                "text": "Cook was making an impassioned plea to end the technology industry’s collection and sale of user data. “This is surveillance,” he continued."
                                            },
                                            {
                                                "example_id": "60fa570a-8799-494b-a7bb-689b0f1a0718",
                                                "sense_id": "8341e4e2-8611-3999-8e15-891acd51f321",
                                                "text": "And that sight will become more common in the coming years, as the city’s police pursue an ambitious campaign to install thousands of cameras to elevate their surveillance capabilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9d1b5d5-c47a-371f-b565-bc9fe32433c0",
                                        "entry_id": "5e3977b7-63b3-3b4c-9cf4-16ee844eb1c4",
                                        "glosses": [
                                            "In criminal law, an investigation process by which police gather evidence about crimes, or suspected crime, through continued observation of persons or places."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22e80571-92cd-463d-959d-9cf57b2eef8e",
                        "source_entry_id": "79845993-1cfa-3afa-b37e-6b223f54901b",
                        "target_lang_word": "surveillance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surveillance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db5b70c3-c3cf-3615-ae59-a29ad2b1b3a2",
                                        "entry_id": "c3832cbe-7627-3cfe-a7e4-7ec96d68bf4d",
                                        "glosses": [
                                            "Action de surveiller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c123a508-921d-4595-9663-6f13c0c1654e",
                                                "sense_id": "db5b70c3-c3cf-3615-ae59-a29ad2b1b3a2",
                                                "text": "[…] ; au temps de la République cléricale, la Société de Saint-Vincent-de-Paul était une belle officine de surveillance sur les fonctionnaires de tout ordre et de tout grade ; […]."
                                            },
                                            {
                                                "example_id": "3d07237c-6b89-414a-a0e0-81e312b74d73",
                                                "sense_id": "db5b70c3-c3cf-3615-ae59-a29ad2b1b3a2",
                                                "text": "À cette époque, la surveillance que la police exerçait sur la vaste population polyglotte de Staten Island s’était beaucoup relâchée, […]."
                                            },
                                            {
                                                "example_id": "aa368910-65b6-4dfe-a958-208fc6f54769",
                                                "sense_id": "db5b70c3-c3cf-3615-ae59-a29ad2b1b3a2",
                                                "text": "Le général Sarrail […] interdit aux militaires sous ses ordres d'envoyer leurs lettres par la poste. Toutes les correspondances doivent être remises au vaguemestre. La surveillance est ainsi plus facile."
                                            },
                                            {
                                                "example_id": "6f53dd47-6c32-41a1-a061-182b2dbf7c5b",
                                                "sense_id": "db5b70c3-c3cf-3615-ae59-a29ad2b1b3a2",
                                                "text": "La rue de Jérusalem, entendez la police, tient ces garnis à l’œil : hôtes de passage, ouvriers journaliers ou escarpes n'échappent pas à sa surveillance […]."
                                            },
                                            {
                                                "example_id": "41bb8294-1957-4756-b00e-f650fa56990f",
                                                "sense_id": "db5b70c3-c3cf-3615-ae59-a29ad2b1b3a2",
                                                "text": "Certains répondants n'hésitent pas à parler même de « flicage » pour décrire le contrôle renforcé de leurs activités par des technologies qui associent une surveillance directe, par le biais notamment du téléphone mobile, et une surveillance indirecte par la traçabilité."
                                            },
                                            {
                                                "example_id": "2157140d-8be5-4868-a51a-c9c22e4ad00b",
                                                "sense_id": "db5b70c3-c3cf-3615-ae59-a29ad2b1b3a2",
                                                "text": "Croulant sous le poids de charges trop lourdes pour son effectif squelettique, Mont-Mesly regrette de ne pouvoir multiplier à l’infini ses surveillances nocturnes."
                                            },
                                            {
                                                "example_id": "98b27116-cd4d-4cd0-b8b3-d31acd8d91a1",
                                                "sense_id": "db5b70c3-c3cf-3615-ae59-a29ad2b1b3a2",
                                                "text": "Il y a trois types de surveillance dans la société : la surveillance de l’État sur la population ; la surveillance de la société contre elle-même — les citoyennes et citoyens se surveillent les uns les autres — ; et la surveillance qui part des citoyennes et citoyens vers le haut, l’État."
                                            },
                                            {
                                                "example_id": "48761042-96b7-4b80-8a70-0b09bd6861b8",
                                                "sense_id": "db5b70c3-c3cf-3615-ae59-a29ad2b1b3a2",
                                                "text": "Nos imaginaires de la surveillance sont, eux aussi, façonnés par nos environnements sociopolitiques, culturels et économiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
