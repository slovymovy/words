                        "cross_references": [
                            {
                                "target_word": "consumériste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69572b85-ee54-3ae8-81f1-66ef6be295c1",
                                        "entry_id": "1857db49-df0f-3658-8095-1a579e9f7e3e",
                                        "glosses": [
                                            "Qui prône le consumérisme, qui se comporte en consommateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f46a2bd2-7158-445d-ac80-14c9bd3d67b8",
                                                "sense_id": "69572b85-ee54-3ae8-81f1-66ef6be295c1",
                                                "text": "Il a une conception consumériste des relations amoureuses et sociales."
                                            },
                                            {
                                                "example_id": "da71ea30-480c-4181-9f3d-76178c3ae4f8",
                                                "sense_id": "69572b85-ee54-3ae8-81f1-66ef6be295c1",
                                                "text": "Il faut également élaborer une réponse au défi que représentent toutes ces mutations anthropologiques tendant à transformer les masses populaires en masses consuméristes, désagrégées, en proie à toutes les dérives possibles."
                                            },
                                            {
                                                "example_id": "f6f706c9-7986-4aa3-87eb-b099060a0f86",
                                                "sense_id": "69572b85-ee54-3ae8-81f1-66ef6be295c1",
                                                "text": "À la question posée rituellement à la caise « Est-ce que vous avez la carte de fidélité ? » je répondais tout aussi rituellement « Je ne suis fidèle à personne ! », ce qui est très exagéré. Je ne voulais simplement pas me soumettre à la stratégie d’incitation consumériste pratiquée par toutes les grandes surface."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consumériste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ae36252-a8aa-3f04-a6fb-87b361049104",
                                        "entry_id": "5dd2e999-9c1c-3592-9d1e-c6218d188994",
                                        "glosses": [
                                            "Partisan du consumérisme, personne qui est pour la défense des consommateurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d558789-121b-41c2-b216-9d7f7990ef5f",
                                                "sense_id": "0ae36252-a8aa-3f04-a6fb-87b361049104",
                                                "text": "Le consumériste Ralph Nader se présente pour la quatrième fois consécutive à l'élection présidentielle des États-Unis d'Amérique en novembre 2008."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
