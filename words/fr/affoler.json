                {
                    "sense_id": "daa31588-01b8-32f0-b956-31979da5d78e",
                    "sense_definition": "Troubler passionnément les sens ou la raison de quelqu'un, le séduire à l'excès.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
