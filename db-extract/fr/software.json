                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d5bec004-d120-41cc-bbf3-9c58d5222524",
                                "sense_id": "97707f9b-072e-349a-8eec-d3a0f3768a19",
                                "text": "L’ID.3 est une voiture moins impactante pour l’environnement et évolutive, grâce à des mises à jour software (fonctionnalités, gestion de la batterie, etc.), qui lui permettent de garder sa jeunesse (et sa valeur)."
                            },
                            {
                                "example_id": "1e4ddf52-466d-46d7-9469-66f6340bf2b8",
                                "sense_id": "97707f9b-072e-349a-8eec-d3a0f3768a19",
                                "text": "Cela permet de livrer de nouveaux software pour véhicules en moins de deux ans, réduisant considérablement le délai de mise sur le marché et d’améliorer la qualité des produits."
                            }
                        ]
                    }
