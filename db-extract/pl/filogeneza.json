                                        "entry_id": "bbdb7c93-9c5c-3932-83ed-586152101cbf",
                                        "glosses": [
                                            "Variante orthographique de phylogenèse."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd26a755-6f34-46dd-a23c-e59d6be06820",
                                                "sense_id": "c93f2c94-5d3e-3e8b-b256-1d8fd174c69e",
                                                "text": "L’Ulothrix est, par conséquent, une forme extraordinairement importante au point de vue de la phylogénèse de l’orthobionte du Végétal."
                                            },
                                            {
                                                "example_id": "43bb86a2-1673-49fc-bbe5-45dfe8308fc8",
                                                "sense_id": "c93f2c94-5d3e-3e8b-b256-1d8fd174c69e",
                                                "text": "La phylogénèse se présente comme un ordonnancement successif d'innombrables ontogénèses; les ontogénèses, quant à elles, sont soumises au continuel changement phylogénique."
                                            }
                                        ]
                                    }
                                ]
