                        "examples": [
                            {
                                "example_id": "36157831-a36c-4229-89ff-6d54d040c446",
                                "sense_id": "75a4ff65-03c0-398a-b6fb-a1a741f24440",
                                "text": "[A]uch ein ein angesehener Muslim, ʿAbdallah ibn Ḫabbâb, dessen Vater ein Gefährter Mohammeds gewesen war, befand sich unter den Getödteten."
                            },
                            {
                                "example_id": "6ec4d057-7d8a-4944-9fac-882babfbc583",
                                "sense_id": "75a4ff65-03c0-398a-b6fb-a1a741f24440",
                                "text": "Dasselbe [Gespenst] hauste an der Stelle, wo ein Gefährter des Odysseus, Namens Lybas, eines Verbrechens gegen die Sittlichkeit wegen, gesteinigt worden war, [...]."
                            },
                            {
                                "example_id": "d01bfb36-7ab3-4611-8905-80304c059688",
                                "sense_id": "75a4ff65-03c0-398a-b6fb-a1a741f24440",
                                "text": "Hr. Huber und Hr. Ritter waren Gefährte dieser Reise, sie gieng über Toffen, Frutigen, Taubensee ins Wallis, [...]."
                            }
                        ]
                    }
