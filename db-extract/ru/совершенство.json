                                            {
                                                "example_id": "dae065ee-3db6-470e-9f3c-84517b7fb5f2",
                                                "sense_id": "4faf3934-f952-3a11-bdbd-fb11227cdab0",
                                                "text": "Le quiétisme […] érigeait en système et posait avec franchise comme suprême perfection l’état d'immobilité et d’impuissance où l'âme parvient à la longue quand elle abdique son activité."
                                            },
                                            {
                                                "example_id": "28a90498-592f-4b0b-b3c6-3c10e688deac",
                                                "sense_id": "4faf3934-f952-3a11-bdbd-fb11227cdab0",
                                                "text": "Nous croyons avoir assez fait comprendre quʼil y a de sortes de perfections pour la langue internationale : l’une vraie, faite des qualités qui répondent amplement au rôle de l’organe. Celle-là, l’Esperanto la possède, et la pratique le prouve tous les jours. L’autre, fictive et trompeuse, loin de répondre à la fin de l’idiome, y nuit au contraire plus ou moins, selon qu’elle s’éloigne peu ou beaucoup des qualités que la langue internationale doit posséder pour tous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d729a356-4af6-3daa-af27-1ea5ac596e48",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "Qualités excellentes, soit de l’âme, soit du corps."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4bdeea-94a9-483b-93ad-e8cfdf9ac0f4",
                                                "sense_id": "d729a356-4af6-3daa-af27-1ea5ac596e48",
                                                "text": "Être doué de toute sorte de perfections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce07108f-66cf-34cd-87da-03fe712483a0",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "État parfait."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3edd1fc-25f8-4da4-822f-18c2185f63b2",
                                                "sense_id": "ce07108f-66cf-34cd-87da-03fe712483a0",
                                                "text": "Les perfections divines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a9997cf-1683-3cf4-8015-92a1f8dd6c5c",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "Être, chose qui a toutes les qualités."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e56d26a-26ed-4d86-9953-991797bc7fd0",
                                                "sense_id": "8a9997cf-1683-3cf4-8015-92a1f8dd6c5c",
                                                "text": "Cette personne est une perfection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "474f900f-c7e6-3b6d-be42-54b548d1f138",
                                        "entry_id": "9c53b9e1-ff24-35a6-8f4b-ab5340221cea",
                                        "glosses": [
                                            "Achèvement."
                                        ],
                                        "tags": [
                                            "Quelquefois"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60d594d7-2c65-477e-af2e-8987cfc6ddbe",
                                                "sense_id": "474f900f-c7e6-3b6d-be42-54b548d1f138",
                                                "text": "Il faut porter cet ouvrage à sa perfection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
