                    },
                    {
                        "translation_id": "2337b876-a029-47ad-ab35-e891c5e38641",
                        "source_entry_id": "f568cb1b-fc93-3806-8a3b-e81bf3f67306",
                        "source_sense_id": "3d618b8f-15d7-3aef-9308-d31a4b524431",
