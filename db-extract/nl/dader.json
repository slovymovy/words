                "senses": [
                    {
                        "sense_id": "11b4eb86-27ee-3656-8b1d-43bb369d5bfb",
                        "entry_id": "2d43610b-c2dd-3424-b076-213ee3c3b9a1",
                        "glosses": [
                            "iemand die iets (slechts) gedaan heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dc681c3-ee6f-444a-af2e-0c416acab306",
                                "sense_id": "11b4eb86-27ee-3656-8b1d-43bb369d5bfb",
                                "text": "Vervolgens laat men wel even de dader naar het bureau komen om met hem te praten."
                            },
                            {
                                "example_id": "3f7a96ba-feb6-403c-9754-1909704929c2",
                                "sense_id": "11b4eb86-27ee-3656-8b1d-43bb369d5bfb",
                                "text": "Ze voelde zich gelijktijdig slachtoffer en dader."
                            },
                            {
                                "example_id": "2e461835-5f7b-4d4b-ae70-de342c80174e",
                                "sense_id": "11b4eb86-27ee-3656-8b1d-43bb369d5bfb",
                                "text": "Zolang het binnen de fatsoensnormen bleef, lachte hij vriendelijk maar bescheiden met de daders mee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "975c3ace-eda8-4cc5-ba6b-e9632ae91522",
                        "source_entry_id": "2d43610b-c2dd-3424-b076-213ee3c3b9a1",
                        "source_sense_id": "11b4eb86-27ee-3656-8b1d-43bb369d5bfb",
                        "source_sense_description": "iemand die iets (slechts) gedaan heeft",
                        "target_lang_word": "Täter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Täter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                        "entry_id": "a96ec9ae-2bc6-32df-b83e-94bed09890aa",
                                        "glosses": [
                                            "jemand, der etwas getan hat, womit fast immer eine verwerfliche Tat gemeint ist; häufig im juristischen Zusammenhang gebraucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8388af51-fdb5-43ce-8678-0487467e0cf4",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "Lehrerin: „Hier hat jemand ein sehr hässliches Bild von Carola an die Tafel gemalt. Wer war der Täter?“"
                                            },
                                            {
                                                "example_id": "68ade528-29da-4ac5-ae35-48458733dce4",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "„Mancher Kriminalfall hat nur deshalb Berühmtheit erlangt, weil der Täter durch eine neuartige medizinische oder naturwissenschaftliche Methode überführt werden konnte.“"
                                            },
                                            {
                                                "example_id": "8c9ec2a6-5de8-470f-b1c5-4aff92ed3cfb",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "„So führen sie die Tradition der Blutrache fort und legen fest, dass die Familie eines Ermordeten den Täter töten darf.“"
                                            },
                                            {
                                                "example_id": "6d3c9e80-b349-4501-a04c-df9d5cfb4ef1",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "Zu den bizarren Pointen der furchtbaren Terrorserie in Frankreich zählt aber auch die Tatsache, dass Muslime nicht nur Täter und Opfer, sondern auch Helden geworden sind. Am Mittwoch war es der Polizist Ahmed Merabet, ein 42-jähriger muslimischer Familienvater, den die terroristischen Kouachi-Brüder brutal ermordeten."
                                            },
                                            {
                                                "example_id": "92bd71e6-232a-4894-aa0e-81fc5f4bc2bf",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "Nach über 30 Jahren tauchten nun neue Beweise gegen den Täter auf, doch weil sein Freispruch rechtskräftig ist, ist es fast unmöglich, wieder gegen ihn zu ermitteln."
                                            },
                                            {
                                                "example_id": "950ce7c7-3964-482c-a638-d30a35c980fc",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "Dieses Jubliäum könne nur deshalb gefeiert werden, weil das Land der Opfer [Israel] dem der Täter [Deutschland] die Hand gereicht habe. \"Für uns Deutsche wie ein Wunder\", betonte der Außenminister."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bdb3695-315a-424c-ad30-5af4c963fbaa",
                        "source_entry_id": "2d43610b-c2dd-3424-b076-213ee3c3b9a1",
                        "source_sense_id": "11b4eb86-27ee-3656-8b1d-43bb369d5bfb",
                        "source_sense_description": "iemand die iets (slechts) gedaan heeft",
                        "target_lang_word": "culprit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "culprit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c18ac657-64ca-3c4f-8d0a-ffe4bbffbd00",
                                        "entry_id": "b7471197-5d67-36b0-9ddd-99d120bb3093",
                                        "glosses": [
                                            "The person or thing at fault for a problem or crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "311e6cd6-26ab-4912-843c-257ba4fed09a",
                                                "sense_id": "c18ac657-64ca-3c4f-8d0a-ffe4bbffbd00",
                                                "text": "I have tightened the loose bolt that was the culprit; it should work now."
                                            },
                                            {
                                                "example_id": "a5e571ed-cef3-479d-b229-10bffdc7a5f9",
                                                "sense_id": "c18ac657-64ca-3c4f-8d0a-ffe4bbffbd00",
                                                "text": "Another sits beneath the purple canopy—a lady, but alone. The diadem is on her cold and haughty brow; there is no pity in her stern aspect, and the smile on her lip bodes death. Before her stands the lovely culprit, whose fatal beauty, and still more fatal love, are about to be dearly requited."
                                            },
                                            {
                                                "example_id": "e7c2e780-a289-4aa9-be74-226ca593fed3",
                                                "sense_id": "c18ac657-64ca-3c4f-8d0a-ffe4bbffbd00",
                                                "text": "But the Dutch dominated only to waste numerous efforts, with Arjen Robben and Robin van Persie the main culprits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38891665-25b2-345f-aef3-e08e1191b0c8",
                                        "entry_id": "b7471197-5d67-36b0-9ddd-99d120bb3093",
                                        "glosses": [
                                            "A prisoner accused but not yet tried."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
