{
    "word_family": [
        "venality",
        "venally"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d0af4cd7-7139-3562-b33d-11ffc3c6dec7",
                    "sense_definition": "Willing to act dishonestly or do corrupt deeds in exchange for money; open to bribery.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigative journalist exposed several <w>venal</w> politicians who regularly accepted cash from powerful corporate lobbyists.",
                            "target_lang_translations": {
                                "zh": "这名调查记者曝光了几位经常收受大型企业说客现金的<w>贪污受贿的</w>政客。"
                            }
                        },
                        {
                            "text": "Citizens grew tired of living under a regime run by <w>venal</w> officials who demanded bribes for basic services.",
                            "target_lang_translations": {
                                "zh": "民众厌倦了生活在一个由<w>贪婪腐败的</w>官员掌权的政权之下，这些官员提供基本服务都要索取贿赂。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crooked"
                    ],
                    "antonyms": [
                        "honest",
                        "straight",
                        "uncorrupt"
                    ],
                    "common_phrases": [
                        "venal politicians",
                        "venal judge",
                        "venal officials"
                    ],
                    "target_lang_definitions": {
                        "zh": "贪财的；唯利是图的；可被贿赂的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "贪污受贿的",
                                "target_lang_sense_clarification": "指官员或个人受贿索贿"
                            },
                            {
                                "target_lang_word": "贪财的",
                                "target_lang_sense_clarification": "指人为利益不择手段"
                            },
                            {
                                "target_lang_word": "腐败的",
                                "target_lang_sense_clarification": "指道德或行为堕落受贿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96f1a693-25a7-3458-9bf6-ca81f44a8fdf",
                    "sense_definition": "Characterized by corruption or motivated purely by monetary gain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "corruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He criticized the <w>venal</w> practices of modern media outlets that prioritize advertising profits over the truth.",
                            "target_lang_translations": {
                                "zh": "他批评了现代媒体机构<w>唯利是图的</w>做法，即把广告利润置于真相之上。"
                            }
                        },
                        {
                            "text": "The entire system collapsed under the weight of decades of <w>venal</w> administration and neglect.",
                            "target_lang_translations": {
                                "zh": "整个体系在数十年来<w>腐败不堪的</w>管理与怠慢重压之下崩溃了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crooked"
                    ],
                    "antonyms": [
                        "honest",
                        "uncorrupt"
                    ],
                    "common_phrases": [
                        "venal motives",
                        "venal practices"
                    ],
                    "target_lang_definitions": {
                        "zh": "充满铜臭的；唯利是图的；腐败的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "唯利是图的",
                                "target_lang_sense_clarification": "形容行为、动机纯粹受金钱利益驱使"
                            },
                            {
                                "target_lang_word": "腐败的",
                                "target_lang_sense_clarification": "指体系或做法充斥舞弊与贿赂"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "034afdb5-05b4-38d4-b5a2-8fdee4c25156",
                    "sense_definition": "Of an office or position: obtainable or transferable through purchase rather than earned by merit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the eighteenth century, military commissions were treated as <w>venal</w> posts sold exclusively to the wealthiest nobles.",
                            "target_lang_translations": {
                                "zh": "在18世纪，军衔被视为专供最富有贵族花钱购买的<w>可买卖的</w>职位。"
                            }
                        },
                        {
                            "text": "The monarchy raised emergency funds by creating a series of <w>venal</w> offices within the royal court.",
                            "target_lang_translations": {
                                "zh": "王室通过在宫廷内设立一系列<w>可花钱买到的</w>官职来筹措应急资金。"
                            }
                        }
                    ],
                    "synonyms": [
                        "purchasable"
                    ],
                    "common_phrases": [
                        "venal office",
                        "venal post"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "used primarily in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（官职或职位）可以花钱买卖的，用金钱谋取的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可花钱买到的",
                                "target_lang_sense_clarification": "指职位可以通过金钱购得"
                            },
                            {
                                "target_lang_word": "买卖的",
                                "target_lang_sense_clarification": "常用于指官职的鬻卖"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e42aba42-8d32-30d2-a4fc-a297db487c3f",
                    "sense_definition": "Available for sale or purchase.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In that chaotic port town, virtually every commodity and service was readily <w>venal</w>.",
                            "target_lang_translations": {
                                "zh": "在那个混乱的港口小镇，几乎每一种商品和服务都是明码标价、<w>可以买卖的</w>。"
                            }
                        },
                        {
                            "text": "He cynically believed that human loyalty was inherently <w>venal</w> if the offered price was high enough.",
                            "target_lang_translations": {
                                "zh": "他愤世嫉俗地认为，只要给出的价码足够高，人性的忠诚本质上都是<w>可以出卖的</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "purchasable"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "archaic in the literal sense of merely being for sale"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "可出卖的；公开出售的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可出卖的",
                                "target_lang_sense_clarification": "指商品、劳务乃至原则忠诚可被金钱收买"
                            },
                            {
                                "target_lang_word": "可买卖的",
                                "target_lang_sense_clarification": "指可以作为商品进行出售"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b12b6a92-265c-3021-885a-6c331479b625",
                    "sense_definition": "Pertaining to veins; venous.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early medical treatises frequently made reference to <w>venal</w> blood flow before modern terminology was standardized.",
                            "target_lang_translations": {
                                "zh": "在现代术语标准化之前，早期医学论文经常提及<w>静脉</w>血流。"
                            }
                        },
                        {
                            "text": "The anatomist described the delicate structure of the <w>venal</w> valves in his historical notes.",
                            "target_lang_translations": {
                                "zh": "解剖学家在其历史笔记中描述了<w>静脉</w>瓣膜的精细结构。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "venal blood"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "superseded by venous"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古旧）静脉的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "静脉的",
                                "target_lang_sense_clarification": "医学古旧用法，同 venous"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}