                        "glosses": [
                            "Bagger, der sich auf (luftgefüllten) Reifen fortbewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c7067eb-dc97-43e7-957e-6ccfb5a730b2",
                                "sense_id": "c3321527-a128-3c3c-82b9-6ab04e4754bf",
                                "text": "„Bei einem Unfall in Riegersburg im Bezirk Südoststeiermark ist am Mittwoch ein Arbeiter schwer verletzt worden: Der 27-Jährige hatte sich mit seinem Radbagger überschlagen.“"
                            },
                            {
                                "example_id": "6f224335-894a-4a0c-bada-0587f66d7e74",
                                "sense_id": "c3321527-a128-3c3c-82b9-6ab04e4754bf",
                                "text": "„Beim Auskundschaften entdeckten sie einen auf einer Baustelle abgestellten Radbagger.“"
                            }
                        ],
