        "fr-extract.jsonl": [
            {
                "entry_id": "f77394b3-1306-3688-8773-4ef3e3f6cec2",
                "word": "indignité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e7e4cc08-32a8-445b-9a48-7c5983b29618",
                        "entry_id": "f77394b3-1306-3688-8773-4ef3e3f6cec2",
                        "tags": [
                            "plural"
                        ],
                        "form": "indignités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1135565f-c060-3622-877a-d1a300474312",
                        "entry_id": "f77394b3-1306-3688-8773-4ef3e3f6cec2",
                        "glosses": [
                            "Ce qui rend quelqu’un indigne d’une grâce, d’un emploi, d’un héritage, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8891c59-1d0d-44bc-858d-9a5bacaf37a6",
                                "sense_id": "1135565f-c060-3622-877a-d1a300474312",
                                "text": "Le suffrage universel ne comporte donc d'exceptions que pour ceux qui sont privés de leurs droits civils ou politiques, que pour les indignités prononcées par les lois ! En dehors de ces indignités, tous les citoyens ont le droit d'élire: hors de cette règle le suffrage universel n'existe plus!..."
                            },
                            {
                                "example_id": "88725632-c44a-4769-a207-f67747fd5b59",
                                "sense_id": "1135565f-c060-3622-877a-d1a300474312",
                                "text": "4 octobre 1940 – Cette journée de gloire usurpée, ces applaudissements que je ne méritais pas, me laissèrent un pénible souvenir d’indignité."
                            }
                        ]
                    },
                    {
                        "sense_id": "bae4b451-2c80-3102-9a21-71056a87dca2",
                        "entry_id": "f77394b3-1306-3688-8773-4ef3e3f6cec2",
                        "glosses": [
                            "Ce qui rend une action odieuse, condamnable, ou cette action elle-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1302025a-622c-4547-96ae-095d389ad051",
                                "sense_id": "bae4b451-2c80-3102-9a21-71056a87dca2",
                                "text": "L’indignité de cette action, de ce procédé, de cette conduite souleva tout le monde contre lui."
                            },
                            {
                                "example_id": "cc004772-e07e-4df7-b5a1-adc5e802b888",
                                "sense_id": "bae4b451-2c80-3102-9a21-71056a87dca2",
                                "text": "Quelle indignité !"
                            },
                            {
                                "example_id": "01ba2182-8812-4d83-afe8-fae3782b951a",
                                "sense_id": "bae4b451-2c80-3102-9a21-71056a87dca2",
                                "text": "C’est une indignité!"
                            },
                            {
                                "example_id": "d3f199f1-3a8a-4504-8ecf-fdf137e2875b",
                                "sense_id": "bae4b451-2c80-3102-9a21-71056a87dca2",
                                "text": "Commettre, faire des indignités."
                            }
                        ]
                    },
                    {
                        "sense_id": "46c112e0-ec15-3bdf-a719-a90197be0306",
                        "entry_id": "f77394b3-1306-3688-8773-4ef3e3f6cec2",
                        "glosses": [
                            "Il se dit particulièrement pour outrage, affront."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88cf4430-3f1b-4889-98b7-ed95f65a1493",
                                "sense_id": "46c112e0-ec15-3bdf-a719-a90197be0306",
                                "text": "Traiter avec indignité."
                            },
                            {
                                "example_id": "39d2a0f7-6b3d-4509-bda9-780a1e91e1b5",
                                "sense_id": "46c112e0-ec15-3bdf-a719-a90197be0306",
                                "text": "On lui a fait mille indignités."
                            },
                            {
                                "example_id": "6c550501-3f56-44d6-9605-6e1041ece2a5",
                                "sense_id": "46c112e0-ec15-3bdf-a719-a90197be0306",
                                "text": "Souffrir des indignités."
                            },
                            {
                                "example_id": "fcc9dfa0-2e5c-4f6f-82c6-f89d8c735eca",
                                "sense_id": "46c112e0-ec15-3bdf-a719-a90197be0306",
                                "text": ". Et – comble d’indignité – une femme européenne le dénudait, rasait les poils de sa jambe blessée. La souffrance de l’opération ne compta point pour lui auprès de ce déshonneur."
                            }
                        ]
                    },
                    {
                        "sense_id": "99c1d695-df55-3475-9c4b-435c96df0f8a",
                        "entry_id": "f77394b3-1306-3688-8773-4ef3e3f6cec2",
                        "glosses": [
                            "État de déchéance dans lequel l’on se trouve."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1c9169d-204f-4454-a044-184a202086d9",
                                "sense_id": "99c1d695-df55-3475-9c4b-435c96df0f8a",
                                "text": "Avec leurs familles, ils ne sont pas accueillis, et pour beaucoup sont parqués dans des camps, des hameaux de forestage, dans des conditions où la précarité le disputait à l’indignité."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c95d2a0-e1cf-319d-a7fd-5ef3b6cb4a65",
                        "entry_id": "f77394b3-1306-3688-8773-4ef3e3f6cec2",
                        "glosses": [
                            "Sentiment de déchéance ou d’absence de mérite."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
