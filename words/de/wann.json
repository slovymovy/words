{
    "word_family": [
        "irgendwann"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1a0a2ab4-d7c2-331a-952d-484b3ca9feba",
                    "sense_definition": "leitet eine direkte oder indirekte Frage nach einem genauen Zeitpunkt oder einer Uhrzeit ein",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "zeitpunkt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wann</w> beginnt die nächste Vorstellung in diesem Kino?"
                        },
                        {
                            "text": "Ich weiß leider überhaupt nicht, <w>wann</w> unser Zug heute ankommt."
                        }
                    ],
                    "common_phrases": [
                        "seit wann",
                        "bis wann",
                        "von wann bis wann"
                    ]
                },
                {
                    "sense_id": "c0c1fb44-4f7e-3c17-9047-21e1be443983",
                    "sense_definition": "fragt nach einem Zeitraum, einer Zeitspanne oder einer historischen Epoche",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "zeitspanne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wann</w> genau wurde das alte Rathaus in dieser Stadt erbaut?"
                        },
                        {
                            "text": "Im Geschichtsunterricht fragte der Lehrer, <w>wann</w> die Mauer gefallen ist."
                        }
                    ]
                },
                {
                    "sense_id": "1915725a-f06d-3bed-a754-6f60d1d10184",
                    "sense_definition": "fragt nach den Bedingungen, Voraussetzungen oder Umständen, unter denen etwas geschieht",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bedingung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wann</w> darf man eigentlich die Fahrbahn mit dem Fahrrad benutzen?"
                        },
                        {
                            "text": "Die Verordnung regelt genau, <w>wann</w> eine Rückerstattung des Kaufpreises möglich ist."
                        }
                    ]
                },
                {
                    "sense_id": "18d6ef95-4a09-3d2c-b21b-6c21a31f70a8",
                    "sense_definition": "zu einem unbestimmten Zeitpunkt in der Zukunft oder Vergangenheit",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "indefinit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir sollten uns mal <w>wann</w> treffen und gemeinsam zu Mittag essen."
                        },
                        {
                            "text": "Hast du vielleicht mal <w>wann</w> Zeit für ein kurzes Gespräch?"
                        }
                    ],
                    "synonyms": [
                        "irgendwann"
                    ],
                    "common_phrases": [
                        "mal wann"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "umgangssprachlich verkürzt aus irgendwann"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "088eb8a3-a291-3f0c-a68f-1967611f21a0",
                    "sense_definition": "leitet einen Konditional- oder Temporalsatz ein",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "konjunktion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wann</w> du morgen früh Zeit hast, besuche mich doch im Büro."
                        },
                        {
                            "text": "Komm einfach bei uns vorbei, <w>wann</w> du mit der Arbeit fertig bist."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "dialektal oder regional statt wenn"
                        }
                    ],
                    "synonyms": [
