                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "514800f5-49f3-488f-8ed5-3da59b638359",
                                                "sense_id": "e6d84869-45da-38a3-96c9-0987e5c3828d",
                                                "text": "Tuben haben einen Tonumfang von mehr als vier Oktaven."
                                            },
                                            {
                                                "example_id": "d6c5b8bc-2381-411b-ae3a-5eee37e0be1b",
                                                "sense_id": "e6d84869-45da-38a3-96c9-0987e5c3828d",
                                                "text": "Ich spiele Tuba im örtlichen Blasorchester."
                                            },
                                            {
                                                "example_id": "c7db69d7-e126-4ef6-a1a9-7f854ce481ba",
                                                "sense_id": "e6d84869-45da-38a3-96c9-0987e5c3828d",
                                                "text": "„Aber wer will schon einen Romeo, der wie eine Tuba durch die Nase bläst, wenn er erschüttert ist?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27124591-2d3c-4ba2-8fe2-4c13129becd5",
                        "source_entry_id": "e031a8a1-1678-359d-9e1f-4f1a64f901e8",
                        "source_sense_id": "5a67df6a-a6ba-37b1-87a8-258bec3622df",
                        "source_sense_description": "een koperen blaasinstrument met lage toon",
                        "target_lang_word": "tuba",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tuba",
