                                "example_id": "fe2102fd-4393-4d5f-99ce-91eff1c0284a",
                                "sense_id": "d1a19ca0-d653-3a7a-a1cf-b637e8c14028",
                                "text": "Jams en compotes (appelmoes). Niet uitscheppen. Schimmels kunnen giftige mycotoxinen produceren."
                            }
                        ]
