                    {
                        "translation_id": "69873714-cedb-461f-b0c8-782b8cd6b04d",
                        "source_entry_id": "ec80addb-24e0-3738-8e78-0a5c74cffa12",
                        "source_sense_id": "349a954e-1674-3c72-bf6c-38145fd549fc",
