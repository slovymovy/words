                        "glosses": [
                            "Inspirer l’esprit de cléricalisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "067e6c74-f849-48b8-91f9-1bd403b68757",
                                "sense_id": "752135df-f11e-371f-b490-1149209070b8",
                                "text": "Le prince Gortchakof l’a dit, il regarde avec curiosité si la France sera définitivement cléricalisée ;… si à droite il y a de naïfs fanatiques qui veulent absolument cléricaliser la France malgré elle…"
                            },
                            {
                                "example_id": "9a4e5dde-dd7d-4d4b-ac8f-89a8c10ea748",
                                "sense_id": "752135df-f11e-371f-b490-1149209070b8",
                                "text": "À cette date aussi [en 1827], on voulut cléricaliser l’armée"
                            },
                            {
                                "example_id": "41afdd5f-aeef-4f22-9422-edd3d932fac0",
                                "sense_id": "752135df-f11e-371f-b490-1149209070b8",
                                "text": "Disons le mot, vous avez tenté de cléricaliser la Belgique (M. Bara, à la Chambre belge)."
                            }
                        ]
                    }
