                                        "sense_id": "b9362174-9527-3d9d-ba3b-0f3a53c93ea9",
                                        "entry_id": "9cd9bf0c-a994-30a0-a78e-bb8522605dba",
                                        "glosses": [
                                            "A kitchen utensil used to turn foodstuffs (commonly, burgers and omelettes) in a frying pan; a spatula."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d11b0407-a2cc-49f9-8d1c-b6cbc220168a",
                                                "sense_id": "b9362174-9527-3d9d-ba3b-0f3a53c93ea9",
                                                "text": "Would you pass me that fish slice, please; I'm making a mess trying to turn this omelette."
                                            },
                                            {
                                                "example_id": "6f0a0005-2f1c-41dd-be1f-b404f377fba3",
                                                "sense_id": "b9362174-9527-3d9d-ba3b-0f3a53c93ea9",
                                                "text": "Truly the sign of an evolved person who has their shit together is that they’ve graduated beyond using a fish slice for everything (which they erroneously call a spatula)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
