                        "glosses": [
                            "État caractérisé par une forte charge de nutriments dans les corps d'eau douce ou dans le sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "011ea2f5-2abb-4160-86e6-b8ab399f9d58",
                                "sense_id": "f5d668db-3dcd-3714-a63a-9d97601c2b5b",
                                "text": "Une forte charge de nutriments dans les corps d'eau douce provoque l'eutrophisme qui implique une plus grande quantité d'algues."
                            },
                            {
                                "example_id": "c21d27d7-fa44-4543-80e3-734cf87e2701",
                                "sense_id": "f5d668db-3dcd-3714-a63a-9d97601c2b5b",
                                "text": "L’eutrophisme bactérien de certains lacs existe, quand il y a surabondance d'anions phosphate et sulfate disponibles en solution."
                            }
                        ]
                    }
