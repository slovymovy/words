                "senses": [
                    {
                        "sense_id": "bb8278c1-1856-38e8-b921-6ab57c29955e",
                        "entry_id": "5da83588-1139-3d63-8db6-5770cc85c45a",
                        "glosses": [
                            "gezielte Absaugung einer Tischplatte oder einer ebenen Fläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "210f1869-19f9-4092-8faa-00ca1b4b0302",
                                "sense_id": "bb8278c1-1856-38e8-b921-6ab57c29955e",
                                "text": "„Mit seiner ersten versenkbaren Tischlüftung präsentiert Siemens ein neues Konzept für den Dunstabzug.“"
                            },
                            {
                                "example_id": "46def0a8-9062-4c7d-9a4c-aff43a7b75e2",
                                "sense_id": "bb8278c1-1856-38e8-b921-6ab57c29955e",
                                "text": "„Die Tischlüftung wird auf der Arbeitsplatte montiert und kann mit einem oder mehreren Kochfeldern kombiniert werden.“"
                            },
                            {
                                "example_id": "12c66826-d3e3-4eb8-81a5-b66ede028b97",
                                "sense_id": "bb8278c1-1856-38e8-b921-6ab57c29955e",
                                "text": "„Vor allem für Wohnküchen, in denen man gerne Kochinseln integriert und trotzdem jederzeit eine freie, offene Sicht haben will, ist eine versenkbare Tischlüftung die optimale Lösung.“"
                            },
                            {
                                "example_id": "74c28ac8-e145-4c25-9100-a1037fdc37fc",
                                "sense_id": "bb8278c1-1856-38e8-b921-6ab57c29955e",
                                "text": "„Ein integriertes LED-Flächenlicht blendet beim Ein- und Ausschalten der Tischlüftung sanft auf und ab und kann zusätzlich zur Ausleuchtung des Kochfeldes auch manuell gedimmt werden.“"
                            },
                            {
                                "example_id": "b744f6a4-bc3a-459b-89a7-7cbd5babba9c",
                                "sense_id": "bb8278c1-1856-38e8-b921-6ab57c29955e",
                                "text": "„Die Tischlüftung AT 400 arbeitet laut Hersteller im Umluftbetrieb so effizient und leise wie bisher nur hochwertige Abluftsysteme, und das mit einer maximalen Luftleistung von 750 m3/h.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
