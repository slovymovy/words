                    {
                        "translation_id": "e61d9b2c-adf6-4b91-b50d-b9e0ab0def48",
                        "source_entry_id": "562d7c18-060f-34dd-b906-745f9f702658",
                        "source_sense_id": "857afa39-aaf7-39c0-94e7-3e5253f13983",
                        "source_sense_description": "bepaalde soort eenjarige groene plant, Portulaca oleracea",
                        "target_lang_word": "pourpier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pourpier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b0f6900-1243-34be-86c5-c732d4de44de",
                                        "entry_id": "76d84904-94cd-30dd-bb61-1e32176f208e",
                                        "glosses": [
                                            "Nom usuel donné au diverses plantes du genre Portulaca, plantes à feuilles épaisses et à tige couchée de la famille des Portulacacées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dae7871-e339-413e-a843-3c0fcef64803",
                                                "sense_id": "9b0f6900-1243-34be-86c5-c732d4de44de",
                                                "text": "Cela fit, avec quelques plants de pourpier qui croissaient au fond d’un ravin, tout le déjeuner du 22."
                                            },
                                            {
                                                "example_id": "f9e4f75e-54fb-4ab1-8552-9a0038847728",
                                                "sense_id": "9b0f6900-1243-34be-86c5-c732d4de44de",
                                                "text": "Le pâturin a envahi les allées. Devant le parloir, des pourpiers qui se sont échappés, sans doute, des grands pots d’orangers où on les avait plantés, rampent et fleurissent entre les pavés."
                                            },
                                            {
                                                "example_id": "75cf182f-8f5c-4421-843e-41fe7e1ee312",
                                                "sense_id": "9b0f6900-1243-34be-86c5-c732d4de44de",
                                                "text": "Il en était de même à Saint-Tropez, quand nous attendions, sous la dense glycine, que le vent de ponant et le soleil, conjugués, éveillassent la mer, les cigales, les convolvulus bleus et le pourpier à quatre couleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84315b98-d567-3ed4-af41-467b0bf71d56",
                                        "entry_id": "76d84904-94cd-30dd-bb61-1e32176f208e",
                                        "glosses": [
                                            "Portulaca oleracea, le pourpier potager ou pourpier sauvage, que l’on cultive comme plante potagère."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08b7f943-fb56-4534-b87c-d5da14582d73",
                                                "sense_id": "84315b98-d567-3ed4-af41-467b0bf71d56",
                                                "text": "Une couche de pourpier."
                                            },
                                            {
                                                "example_id": "83155593-cfc0-4767-aaae-d159049f1b42",
                                                "sense_id": "84315b98-d567-3ed4-af41-467b0bf71d56",
                                                "text": "Gregory Cobwell avait terminé son solitaire repas composé de salade de pourpier et d’oignons frits, cuisiné dans un infâme petit réduit qu’il dénommait pompeusement \"office\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afc8684e-4100-37d0-8787-256e7a6efc1e",
                                        "entry_id": "76d84904-94cd-30dd-bb61-1e32176f208e",
                                        "glosses": [
                                            "Portulaca grandiflora, le pourpier à grandes fleurs."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e25e41f-056c-3b5f-a475-ca25a7529d65",
                                        "entry_id": "76d84904-94cd-30dd-bb61-1e32176f208e",
                                        "glosses": [
                                            "Nom donné à diverses plantes qui ressemblent au genre Portulaca mais sont d'autres genres, comme par exemples : Atriplex, Lythrum, Sesuvium, Tallinum, etc., certains de ces genres étaient anciennement classés dans la famille des Portulacaeae, celle des pourpiers."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
