                        "examples": [
                            {
                                "example_id": "777f8e4c-aae3-482b-bb1c-5c011274853e",
                                "sense_id": "0d72b682-3292-3c86-9e4e-c8a76a4adec3",
                                "text": "Dans leur logique, ils vont devoir s'auto-braquer."
                            },
                            {
                                "example_id": "c88fd5a3-6eed-4db2-b559-3ff98153a1f7",
                                "sense_id": "0d72b682-3292-3c86-9e4e-c8a76a4adec3",
                                "text": "Ainsi, l'idée de s'auto-braquer est exceptionnelle car cela leur permettrait d'accéder à la propre richesse qui les habite."
                            },
                            {
                                "example_id": "9e959766-71e3-40aa-88f2-a93fb77d6633",
                                "sense_id": "0d72b682-3292-3c86-9e4e-c8a76a4adec3",
                                "text": "Mais cette fois-ci, il y a un suspect idéal : le tenancier lui-même, qui a déjà eu par le passé la brillante idée de s'auto-braquer."
                            }
                        ]
                    }
