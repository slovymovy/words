            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e7c5a565-fe61-36f3-a0c3-e63a0eb44404",
                    "sense_definition": "Parcourir un pays, une région peu connue ou inconnue pour en faire la découverte ou l'étude.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "decouverte_geographique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques ont décidé d'<w>explorer</w> cette jungle isolée afin d'y répertorier de nouvelles espèces animales."
                        },
                        {
                            "text": "Durant leur jeunesse, ils aimaient <w>explorer</w> des îles désertes et cartographier les côtes."
                        }
                    ],
                    "synonyms": [
                        "parcourir",
                        "arpenter"
                    ],
                    "common_phrases": [
                        "explorer le monde",
                        "explorer une région"
                    ]
                },
                {
                    "sense_id": "6806ace2-fa63-3670-9bbf-49b9496857c2",
                    "sense_definition": "Examiner méthodiquement un sujet, une idée ou un domaine pour mieux le comprendre ou trouver des solutions.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "recherche_analyse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe de recherche doit <w>explorer</w> toutes les options possibles avant de choisir une solution définitive."
                        },
                        {
                            "text": "Nous <w>explorons</w> actuellement plusieurs pistes sérieuses pour tenter d'améliorer les performances de notre application."
                        }
                    ],
                    "synonyms": [
                        "analyser",
                        "étudier",
                        "examiner",
                        "sonder"
                    ],
                    "common_phrases": [
                        "explorer une piste",
                        "explorer des possibilités"
                    ]
                },
                {
                    "sense_id": "d294c8f4-6486-32ad-9746-0c518a6d1c5a",
                    "sense_definition": "Examiner une partie interne du corps humain ou animal au moyen d'instruments ou d'examens spécialisés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medecine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chirurgien a utilisé une caméra miniature pour <w>explorer</w> l'articulation du genou sans pratiquer d'incision majeure."
                        },
                        {
                            "text": "Cet examen médical permet d'<w>explorer</w> minutieusement les voies digestives d'un patient."
