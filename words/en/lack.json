{
    "word_family": [
        "lackluster"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d24e9c12-373c-3b47-87e9-85b0523c1c96",
                    "sense_definition": "The state of not having something that is necessary, desirable, or expected, or not having enough of it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deficiency_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project failed due to a total <w>lack</w> of funding.",
                            "target_lang_translations": {
                                "ru": "Проект провалился из-за полного <w>отсутствия</w> финансирования.",
                                "tr": "Proje, tam bir fon <w>eksikliği</w> nedeniyle başarısız oldu.",
                                "zh": "由于完全<w>缺乏</w>资金，该项目失败了。"
                            }
                        },
                        {
                            "text": "She could not finish the test for <w>lack</w> of time.",
                            "target_lang_translations": {
                                "ru": "Она не смогла закончить тест из-за <w>нехватки</w> времени.",
                                "tr": "Zaman <w>yokluğu</w> nedeniyle testi bitiremedi.",
                                "zh": "由于时间<w>不足</w>，她没能完成考试。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shortage",
                        "deficiency",
                        "scarcity",
                        "insufficiency",
                        "inadequacy",
                        "dearth",
                        "want",
                        "deficit",
                        "absence"
                    ],
                    "antonyms": [
                        "surplus",
                        "excess",
                        "glut",
                        "plethora",
                        "adequacy"
                    ],
                    "common_phrases": [
                        "lack of time",
                        "lack of interest",
                        "for lack of",
                        "complete lack of",
                        "total lack of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние отсутствия чего-либо необходимого, желательного или ожидаемого, либо недостаточное количество этого.",
                        "tr": "Gerekli, arzulanan veya beklenen bir şeyin bulunmaması ya da yeterli miktarda olmaması durumu.",
                        "zh": "指缺乏某种必要、理想或预期的事物，或其数量不足的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нехватка",
                                "target_lang_sense_clarification": "недостаточное количество чего-либо"
                            },
                            {
                                "target_lang_word": "отсутствие",
                                "target_lang_sense_clarification": "полное неимение чего-либо"
                            },
                            {
                                "target_lang_word": "недостаток",
                                "target_lang_sense_clarification": "дефицит, малое количество"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "eksiklik",
                                "target_lang_sense_clarification": "bir şeyin yeterli olmaması ya da bulunmaması"
                            },
                            {
                                "target_lang_word": "yokluk",
                                "target_lang_sense_clarification": "bir şeyin hiç bulunmaması durumu"
                            },
                            {
                                "target_lang_word": "yoksunluk",
                                "target_lang_sense_clarification": "mahrum olma durumu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺乏",
                                "target_lang_sense_clarification": "指不足或没有"
                            },
                            {
                                "target_lang_word": "不足",
                                "target_lang_sense_clarification": "指数量不够"
                            },
                            {
                                "target_lang_word": "缺失",
                                "target_lang_sense_clarification": "指完全没有"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad7357e3-3577-3e1a-bd33-30ecdd6303cc",
                    "sense_definition": "A personal failing, fault, or imperfection.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deficiency_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His only real <w>lack</w> is his inability to listen to others.",
                            "target_lang_translations": {
                                "ru": "Его единственный настоящий <w>недостаток</w> — это неумение слушать других.",
                                "tr": "Ona ait tek gerçek <w>kusur</w>, başkalarını dinleyememesidir.",
                                "zh": "他唯一的真正<w>缺点</w>就是无法倾听他人。"
                            }
                        },
                        {
                            "text": "Despite his genius, he was aware of his moral <w>lack</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свою гениальность, он осознавал свой моральный <w>изъян</w>.",
                                "tr": "Dehasına rağmen ahlaki <w>eksikliğinin</w> farkındaydı.",
                                "zh": "尽管他是个天才，但他意识到了自己道德上的<w>瑕疵</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shortcoming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Личный недостаток, вина или несовершенство характера.",
                        "tr": "Kişisel bir eksiklik, kusur veya yetersizlik.",
                        "zh": "个人的缺点、过失或不完美之处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недостаток",
                                "target_lang_sense_clarification": "изъян в характере или поведении"
                            },
                            {
                                "target_lang_word": "изъян",
                                "target_lang_sense_clarification": "несовершенство"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kusur",
                                "target_lang_sense_clarification": "kişisel eksiklik veya noksanlık"
                            },
                            {
                                "target_lang_word": "eksiklik",
                                "target_lang_sense_clarification": "karakter veya yetenekteki yetersizlik"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺点",
                                "target_lang_sense_clarification": "性格或行为上的不足"
                            },
                            {
                                "target_lang_word": "瑕疵",
                                "target_lang_sense_clarification": "不完美之处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c505e387-633d-3229-8048-898aad247b6b",
                    "sense_definition": "An archaic spelling of lakh, referring to the number one hundred thousand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant claimed to have a <w>lack</w> of rupees in his vault.",
                            "target_lang_translations": {
                                "ru": "Торговец утверждал, что в его хранилище есть <w>лакх</w> рупий.",
                                "tr": "Tüccar, kasasında bir <w>lak</w> rupi olduğunu iddia etti.",
                                "zh": "商人声称他的金库里有<w>十万</w>卢比。"
                            }
                        },
                        {
                            "text": "They demanded a <w>lack</w> of gold coins for the ransom.",
                            "target_lang_translations": {
                                "ru": "Они потребовали <w>лакх</w> золотых монет в качестве выкупа.",
                                "tr": "Fidye olarak bir <w>lak</w> altın para talep ettiler.",
                                "zh": "他们要求<w>十万</w>枚金币作为赎金。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "form",
                            "comment": "variant spelling of lakh"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшее написание слова «lakh», обозначающего число сто тысяч (в индийской системе счисления).",
                        "tr": "Hint sayı sisteminde yüz bin anlamına gelen 'lakh' sözcüğünün eski yazılışı.",
                        "zh": "“lakh”的古旧拼写，指十万（印度计数单位）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лакх",
                                "target_lang_sense_clarification": "сто тысяч (индийская мера)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "lak",
                                "target_lang_sense_clarification": "yüz bin anlamına gelen Hint birimi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "十万",
                                "target_lang_sense_clarification": "印度计数单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a9aeb9b-0d7d-3527-9ded-191ebc6de41b",
                    "sense_definition": "To not have something that is needed, desirable, or required.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "missing_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soup tastes bland because it <w>lacks</w> salt.",
                            "target_lang_translations": {
                                "ru": "Суп безвкусный, потому что в нем <w>не хватает</w> соли.",
                                "tr": "Çorbanın tadı yavan çünkü tuzu <w>eksik</w>.",
                                "zh": "汤尝起来很淡，因为<w>缺少</w>盐。"
                            }
                        },
                        {
                            "text": "He has plenty of enthusiasm, but he <w>lacks</w> experience.",
                            "target_lang_translations": {
                                "ru": "У него полно энтузиазма, но ему <w>недостает</w> опыта.",
                                "tr": "Coşkusu bol ama tecrübeden <w>yoksun</w>.",
                                "zh": "他很有热情，但<w>缺乏</w>经验。"
                            }
                        }
                    ],
                    "synonyms": [
                        "need"
                    ],
                    "common_phrases": [
                        "lack confidence",
                        "lack the ability",
                        "lack experience"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не иметь чего-либо необходимого, желательного или требуемого.",
                        "tr": "Gerekli, arzulanan veya ihtiyaç duyulan bir şeye sahip olmamak.",
                        "zh": "没有某种被需要、被期望或被要求的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не хватать",
                                "target_lang_sense_clarification": "обычно используется в безличных конструкциях (кому-то не хватает)"
                            },
                            {
                                "target_lang_word": "недоставать",
                                "target_lang_sense_clarification": "быть в недостаточном количестве"
                            },
                            {
                                "target_lang_word": "отсутствовать",
                                "target_lang_sense_clarification": "не иметься в наличии"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yoksun olmak",
                                "target_lang_sense_clarification": "bir şeye sahip olmamak, mahrum olmak"
                            },
                            {
                                "target_lang_word": "eksik olmak",
                                "target_lang_sense_clarification": "bulunmamak veya yetersiz olmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺乏",
                                "target_lang_sense_clarification": "没有或不够"
                            },
                            {
                                "target_lang_word": "缺少",
                                "target_lang_sense_clarification": "不足"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b71ffc5-78fa-39e8-8f6a-d5be9826a6b8",
                    "sense_definition": "To be in need of something; to have an insufficient amount of something (usually followed by 'for').",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "missing_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With such a large inheritance, she will never <w>lack</w> for money.",
                            "target_lang_translations": {
                                "ru": "С таким большим наследством она никогда не будет <w>нуждаться</w> в деньгах.",
                                "tr": "Böyle büyük bir mirasla asla para <w>sıkıntısı çekmeyecek</w>.",
                                "zh": "有了这么大一笔遗产，她永远不会<w>短缺</w>钱财。"
                            }
                        },
                        {
                            "text": "The guests did not <w>lack</w> for food or drink at the party.",
                            "target_lang_translations": {
                                "ru": "Гости не <w>испытывали недостатка</w> в еде и напитках на вечеринке.",
                                "tr": "Partide konuklar yiyecek veya içecek <w>eksikliği çekmedi</w>.",
                                "zh": "客人在聚会上不<w>匮乏</w>食物和饮料。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "lack for nothing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нуждаться в чем-либо; иметь недостаточное количество чего-либо (обычно с предлогом 'for').",
                        "tr": "Bir şeye ihtiyaç duymak; bir şeyin eksikliğini çekmek (genellikle 'for' ile kullanılır).",
                        "zh": "需要某物；某物数量不足。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нуждаться",
                                "target_lang_sense_clarification": "испытывать потребность в чем-либо"
                            },
                            {
                                "target_lang_word": "испытывать недостаток",
                                "target_lang_sense_clarification": "фразовый эквивалент"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "eksikliğini çekmek",
                                "target_lang_sense_clarification": "bir şeyin yokluğunu hissetmek"
                            },
                            {
                                "target_lang_word": "muhtaç olmak",
                                "target_lang_sense_clarification": "ihtiyaç duymak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "短缺",
                                "target_lang_sense_clarification": "物资匮乏"
                            },
                            {
                                "target_lang_word": "匮乏",
                                "target_lang_sense_clarification": "极度缺乏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e141bf08-5849-3f8c-9f52-1c53775dba24",
                    "sense_definition": "To be caught unprepared, off guard, or not paying attention.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You have to stay alert because you don't want to get caught <w>lacking</w>.",
                            "target_lang_translations": {
                                "ru": "Нужно быть начеку, потому что не хочется оказаться <w>неподготовленным</w>.",
                                "tr": "Uyanık olmalısın çünkü <w>hazırlıksız yakalanmak</w> istemezsin.",
                                "zh": "你必须保持警惕，因为你不想被<w>毫无准备</w>地抓个正着。"
                            }
                        },
                        {
                            "text": "The opposing team caught the defender <w>lacking</w> and scored an easy goal.",
                            "target_lang_translations": {
                                "ru": "Команда противника поймала защитника, когда тот <w>расслабился</w>, и забила легкий гол.",
                                "tr": "Rakip takım savunmacıyı <w>gafil avladı</w> ve kolay bir gol attı.",
                                "zh": "对方球队抓住了后卫的<w>疏忽</w>，轻松进了一球。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "caught lacking"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть застигнутым врасплох, неподготовленным или потерявшим бдительность.",
                        "tr": "Hazırlıksız, gafil veya dikkatsiz yakalanmak.",
                        "zh": "指被抓个正着、毫无准备或注意力不集中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть неподготовленным",
                                "target_lang_sense_clarification": "оказаться не готовым к ситуации"
                            },
                            {
                                "target_lang_word": "расслабляться",
                                "target_lang_sense_clarification": "терять бдительность (сленг)"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hazırlıksız yakalanmak",
                                "target_lang_sense_clarification": "gafil avlanmak, dikkatsiz bulunmak"
                            },
                            {
                                "target_lang_word": "gafil avlanmak",
                                "target_lang_sense_clarification": "dikkat etmiyorken yakalanmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毫无准备",
                                "target_lang_sense_clarification": "未做好应对"
                            },
                            {
                                "target_lang_word": "疏忽",
                                "target_lang_sense_clarification": "注意力不集中"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}