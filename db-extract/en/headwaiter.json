                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0241f7cb-8b40-477b-adb0-97de6623e474",
                                                "sense_id": "0e9d61a7-665a-38ae-b84b-f955b48b6f81",
                                                "text": "„Auch die Oberkellnerin und der Personalchef hätten ihm nicht weitergeholfen.“"
                                            },
                                            {
                                                "example_id": "5b29f5c9-10e1-4013-96f8-2533a3f20937",
                                                "sense_id": "0e9d61a7-665a-38ae-b84b-f955b48b6f81",
                                                "text": "„Michaela Schulz, erste Oberkellnerin des Hotels Bayerischer Hof, agiert hierbei in enger Absprache mit uns.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
