                "translations": [
                    {
                        "translation_id": "1861c85b-cb2d-4b85-ac1c-2d2336977f7d",
                        "source_entry_id": "42693bc8-2286-396c-910b-14a924213478",
                        "source_sense_id": "15b73081-d89c-34af-aba1-06a2c4acf489",
                        "target_lang_word": "acquaintance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acquaintance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee2d6858-d40d-3eee-b4af-adb577d7584d",
                                        "entry_id": "329dd357-b206-3be5-a729-87243d0ec104",
                                        "glosses": [
                                            "A state of being acquainted with a person; originally indicating friendship, intimacy, but now suggesting a slight knowledge less deep than that of friendship; acquaintanceship."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07c90bd7-715c-474c-bb07-50be25c1844d",
                                                "sense_id": "ee2d6858-d40d-3eee-b4af-adb577d7584d",
                                                "text": "I know of the man; but have no acquaintance with him."
                                            },
                                            {
                                                "example_id": "e6c47470-f2d0-427f-8e1e-4aa9742cf391",
                                                "sense_id": "ee2d6858-d40d-3eee-b4af-adb577d7584d",
                                                "text": "Contract no friendſhip, or even acquaintance, with a guileful man : he reſembles a coal, which when hot burneth the hand, and when cold blacketh it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08abc13d-b8c9-303c-bb0d-5c04ea76efda",
                                        "entry_id": "329dd357-b206-3be5-a729-87243d0ec104",
                                        "glosses": [
                                            "A person or persons with whom one is acquainted."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "800cf5f7-03ae-4cf1-a3cf-3240fb423cff",
                                                "sense_id": "08abc13d-b8c9-303c-bb0d-5c04ea76efda",
                                                "text": "Montgomery was an old acquaintance of Ferguson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd9e461d-0c7c-3a30-8c27-f563cbd47303",
                                        "entry_id": "329dd357-b206-3be5-a729-87243d0ec104",
                                        "glosses": [
                                            "Such people collectively; one's circle of acquaintances (with plural concord)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2dc6d8fe-1b31-4c2d-b82d-a1ba91491047",
                                                "sense_id": "bd9e461d-0c7c-3a30-8c27-f563cbd47303",
                                                "text": "Having therefore conſulted with my Wife, and ſome of my Acquaintance, I determined to go again to Sea."
                                            },
                                            {
                                                "example_id": "1dec4db0-c45d-4743-92aa-6e6b1af24591",
                                                "sense_id": "bd9e461d-0c7c-3a30-8c27-f563cbd47303",
                                                "text": "Their mother […] was busy in the mean time in keeping up her connections, as she termed a numerous acquaintance, lest her girls should want a proper introduction into the great world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fca0d120-0062-3830-9c53-3ff305d83612",
                                        "entry_id": "329dd357-b206-3be5-a729-87243d0ec104",
                                        "glosses": [
                                            "Personal knowledge (with a specific subject etc.)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd475233-6f9a-46b4-a38c-d81d56e957ca",
                                                "sense_id": "fca0d120-0062-3830-9c53-3ff305d83612",
                                                "text": "The words of these songs were either without meaning, or derived from an idiom with which Watt, a very fair linguist, had no acquaintance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
