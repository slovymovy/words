{
    "word_family": [
        "rozmaity",
        "rozmaicie"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd810c11-807a-3ede-9359-d7f7b1f19cc1",
                    "sense_definition": "cecha tego, co składa się z wielu różnych elementów",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "różnorodność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym sklepie panuje ogromna <w>rozmaitość</w> towarów.",
                            "target_lang_translations": {
                                "ru": "В этом магазине представлено огромное <w>разнообразие</w> товаров."
                            }
                        },
                        {
                            "text": "Klienci doceniają dużą <w>rozmaitość</w> dostępnych produktów.",
                            "target_lang_translations": {
                                "ru": "Клиенты ценят большое <w>разнообразие</w> доступных продуктов."
                            }
                        }
                    ],
                    "synonyms": [
                        "różnorodność"
                    ],
                    "common_phrases": [
                        "ogromna rozmaitość"
                    ],
                    "target_lang_definitions": {
                        "ru": "свойство того, что состоит из множества различных элементов; разнообразие"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разнообразие",
                                "target_lang_sense_clarification": "общее понятие наличия многих различных элементов"
                            },
                            {
                                "target_lang_word": "разнородность",
                                "target_lang_sense_clarification": "акцент на различии составляющих элементов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6f9758b-825a-3206-8164-3eb264717ecf",
                    "sense_definition": "duża liczba różnych rzeczy lub zjawisk",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "różnorodność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na stole leżała <w>rozmaitość</w> owoców z całego świata.",
                            "target_lang_translations": {
                                "ru": "На столе лежало <w>множество</w> фруктов со всего мира."
                            }
                        },
                        {
                            "text": "W ogrodzie można spotkać wielką <w>rozmaitość</w> kwiatów.",
                            "target_lang_translations": {
                                "ru": "В саду можно встретить огромное <w>разнообразие</w> цветов."
                            }
                        }
                    ],
                    "synonyms": [
                        "różnorodność"
                    ],
                    "target_lang_definitions": {
                        "ru": "большое количество различных вещей или явлений"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "множество",
                                "target_lang_sense_clarification": "большое количество чего-либо"
                            },
                            {
                                "target_lang_word": "разнообразие",
                                "target_lang_sense_clarification": "широкий выбор или ассортимент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aaf3df43-6a8c-3668-b78e-39cddaf3f805",
                    "sense_definition": "zbiór drobnych, różniących się od siebie przedmiotów",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "różnorodność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W szufladzie trzymał dziwną <w>rozmaitość</w> starych kluczy i śrubek.",
                            "target_lang_translations": {
                                "ru": "В ящике он хранил странную <w>всякую всячину</w> из старых ключей и винтиков."
                            }
                        },
                        {
                            "text": "Pudełko zawierało <w>rozmaitość</w> drobiazgów zebranych podczas wakacji.",
                            "target_lang_translations": {
                                "ru": "Коробка содержала <w>разнообразие</w> мелочей, собранных во время отпуска."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "набор мелких, отличающихся друг от друга предметов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всякая всячина",
                                "target_lang_sense_clarification": "разнородные мелкие предметы"
                            },
                            {
                                "target_lang_word": "разнообразие",
                                "target_lang_sense_clarification": "набор различных мелочей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe3b4ab1-0461-3f15-9fd0-e198082d4735",
                    "sense_definition": "wielowymiarowe uogólnienie pojęć krzywej i powierzchni w matematyce",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "matematyka",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W topologii bada się właściwości geometryczne obiektów zwanych <w>rozmaitość</w>.",
                            "target_lang_translations": {
                                "ru": "В топологии изучаются геометрические свойства объектов, называемых <w>многообразиями</w>."
                            }
                        },
                        {
                            "text": "Każda gładka <w>rozmaitość</w> posiada określoną strukturę lokalną.",
                            "target_lang_translations": {
                                "ru": "Каждое гладкое <w>многообразие</w> обладает определенной локальной структурой."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "многомерное обобщение понятий кривой и поверхности в математике"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многообразие",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}