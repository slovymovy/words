                        "glosses": [
                            "Person, die sich mit Dämonologie beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65df203c-8cf0-4573-8da6-480e01558a4c",
                                "sense_id": "190692c3-9383-38da-b6ef-d50de7285600",
                                "text": "„Die Sprache, die diese Gestalt benutzte, war jene niedere Form des Latein, das die gebildeteren Menschen des Mittelalters gebraucht hatten und mir durch meine Studien der Werke alter Alchemisten und Dämonologen vertraut war.“"
                            },
                            {
                                "example_id": "98cc019d-6909-4acf-8e63-bc0c62993137",
                                "sense_id": "190692c3-9383-38da-b6ef-d50de7285600",
                                "text": "„Nur allzu gut kannten wir die düsteren Zeilen, die der alte arabische Dämonologe niedergeschrieben hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
