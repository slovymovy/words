        "fr-extract.jsonl": [
            {
                "entry_id": "0ef93c0d-781c-3b71-a2b8-288226d803c7",
                "word": "arbalète",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "628a9d39-1cb3-40c6-93ad-a77150ad8051",
                        "entry_id": "0ef93c0d-781c-3b71-a2b8-288226d803c7",
                        "tags": [
                            "plural"
                        ],
                        "form": "arbalètes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d91387f4-0a6a-3cb4-ba1b-4e4f599f8054",
                        "entry_id": "0ef93c0d-781c-3b71-a2b8-288226d803c7",
                        "glosses": [
                            "Arme de trait, arc (généralement d’acier) monté sur un fût et qui se bande à la main ou à l’aide de divers mécanismes selon sa force."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d09250e-f2fa-4d85-a618-b0f3f1174b04",
                                "sense_id": "d91387f4-0a6a-3cb4-ba1b-4e4f599f8054",
                                "text": "Il avait la ceinture pleine de dagues et de poignards, une grande épée au flanc, une arbalète rouillée à sa gauche, et un vaste broc de vin devant lui."
                            },
                            {
                                "example_id": "d7393a77-cbda-4181-9a77-5aa2c03701a6",
                                "sense_id": "d91387f4-0a6a-3cb4-ba1b-4e4f599f8054",
                                "text": "Ce ne fut, dit Hallam, ni la noblesse d’Angleterre, ni ses vassaux qui gagnèrent les batailles de Crécy, de Poitiers et d’Azincourt : […] ; mais ce furent les yeomans qui tiraient l’arbalète d’un bras sûr et nerveux, […]."
                            },
                            {
                                "example_id": "97fd5691-45b2-4ce0-9913-b237afbf6449",
                                "sense_id": "d91387f4-0a6a-3cb4-ba1b-4e4f599f8054",
                                "text": "Tantôt il attache un pétard à un poil de ma barbe, tantôt il me décoche de son arbalète un trait de feu dans mon manteau."
                            },
                            {
                                "example_id": "9e5f5ad4-a838-4a9a-85a2-cf83ea547340",
                                "sense_id": "d91387f4-0a6a-3cb4-ba1b-4e4f599f8054",
                                "text": "Cette muraille est à portée d’arbalète des tours 11, 12 et 40 et est commandée par celles-ci."
                            },
                            {
                                "example_id": "bfeca302-55ac-48e3-bc01-171c1d3d2467",
                                "sense_id": "d91387f4-0a6a-3cb4-ba1b-4e4f599f8054",
                                "text": "Il devait se défendre contre les assauts d’une imposante armée d’un seigneur du royaume voisin. Grâce à l’arbalète magique offerte par un génie de tortue, il arriva à la défaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c69deb9-e539-385a-a1f1-7df6d153abc7",
                        "entry_id": "0ef93c0d-781c-3b71-a2b8-288226d803c7",
                        "glosses": [
                            "Divers instruments en forme d’arc."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b1b2ba1a-e6e2-38db-837a-6eecbce00aa5",
                        "entry_id": "0ef93c0d-781c-3b71-a2b8-288226d803c7",
                        "glosses": [
                            "Meuble représentant l’arme du même nom dans les armoiries. Elle est généralement représentée en pal, fût vers la pointe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dad93d68-6226-4dae-ae02-53112ecb9570",
                                "sense_id": "b1b2ba1a-e6e2-38db-837a-6eecbce00aa5",
                                "text": "D’azur à la barque à l’antique d’argent naviguant sur une rivière du même mouvant de la pointe, au chef de gueules chargé d’une arbalète en pal, accostée de deux dauphins, celui de dextre contourné, le tout d’argent, qui est de Villeneuve-la-Garenne → voir illustration « armoiries avec une arbalète »"
                            }
                        ]
                    },
                    {
                        "sense_id": "bc66e0eb-f109-3533-a904-dedb826e5af7",
                        "entry_id": "0ef93c0d-781c-3b71-a2b8-288226d803c7",
                        "glosses": [
                            "Défaut de tissage occasionné par des fils de chaine collés ensemble."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbdc60ef-b8a8-4bba-934a-a899205c66c7",
                        "source_entry_id": "0ef93c0d-781c-3b71-a2b8-288226d803c7",
                        "target_lang_word": "Armbrust",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Armbrust",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70170860-7d81-3b7f-add6-adcedc84f6e5",
                                        "entry_id": "ec7e7bb8-dec3-33d4-b2bb-954d2aefc9a1",
                                        "glosses": [
                                            "(Schusswaffe) Gerät zum Abschießen von Pfeilen; der Bogen ist hierbei an einer Auflage für die Pfeile befestigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "842dc7ea-3416-4fee-8686-fb48107dcde9",
                                                "sense_id": "70170860-7d81-3b7f-add6-adcedc84f6e5",
                                                "text": "Die Armbrust bedeutete einen erheblichen Vorteil gegenüber dem einfachen Bogen."
                                            },
                                            {
                                                "example_id": "3e2b565b-5a6c-415d-986a-0b51d50e6b18",
                                                "sense_id": "70170860-7d81-3b7f-add6-adcedc84f6e5",
                                                "text": "„Das Johannis-Schießen müsse traditionsgemäß mit Armbrüsten stattfinden, fordert Schestawitscha, der Oppositionelle, aber die Radfahrer hören nicht auf ihn, sie werden mit einem Tesching und Sechs-Millimeter-Munition nach der Scheibe schießen.“"
                                            },
                                            {
                                                "example_id": "1ac57a86-2b09-4d21-a69b-5ac2925c61c7",
                                                "sense_id": "70170860-7d81-3b7f-add6-adcedc84f6e5",
                                                "text": "„Dann lernte er den CIC-Agenten »Mister Smith« kennen, jenen tierliebenden Herrn, der tatsächlich mit der Armbrust auf die Jagd ging.“"
                                            },
                                            {
                                                "example_id": "c3242aaa-853c-4634-8fc4-4ac32282aa2d",
                                                "sense_id": "70170860-7d81-3b7f-add6-adcedc84f6e5",
                                                "text": "„Hakenbüchse und Armbrust bleiben parallel im Einsatz, erst die Einführung der Musketen seit Mitte des 16. Jahrhunderts wird die Armbrustschützen verdrängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
