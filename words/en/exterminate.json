{
    "word_family": [
        "exterminator",
        "extermination"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97016bb2-b287-3dde-8a17-d1c077fb4574",
                    "sense_definition": "To kill or permanently eliminate an entire population of pests or unwanted organisms.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kill",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company hired a professional to <w>exterminate</w> the rats in the basement.",
                            "target_lang_translations": {
                                "zh": "公司雇了一位专业人员来<w>消灭</w>地下室里的老鼠。"
                            }
                        },
                        {
                            "text": "Farmers often use chemicals to <w>exterminate</w> insects that destroy their crops.",
                            "target_lang_translations": {
                                "zh": "农民经常使用化学药剂来<w>消灭</w>破坏庄稼的昆虫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "annihilate",
                        "eradicate",
                        "uproot",
                        "stamp out"
                    ],
                    "common_phrases": [
                        "exterminate pests",
                        "exterminate rats"
                    ],
                    "target_lang_definitions": {
                        "zh": "指彻底消灭或清除某种害虫或有害生物的种群。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "消灭",
                                "target_lang_sense_clarification": "指彻底消灭害虫或有害生物。"
                            },
                            {
                                "target_lang_word": "灭绝",
                                "target_lang_sense_clarification": "指使某种生物彻底消失。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06beeef4-f9eb-3e51-aff7-f56dc0323718",
                    "sense_definition": "To bring a definite end to something completely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "end",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy failed to <w>exterminate</w> the long-standing corruption in the department.",
                            "target_lang_translations": {
                                "zh": "这项新政策没能<w>根除</w>该部门长期存在的腐败问题。"
                            }
                        },
                        {
                            "text": "It is nearly impossible to <w>exterminate</w> bad habits once they have become deeply ingrained.",
                            "target_lang_translations": {
                                "zh": "坏习惯一旦根深蒂固，就几乎不可能将其<w>根除</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eradicate",
                        "stamp out"
                    ],
                    "target_lang_definitions": {
                        "zh": "指彻底根除或终结某种事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "根除",
                                "target_lang_sense_clarification": "指彻底铲除某种弊端或习惯。"
                            },
                            {
                                "target_lang_word": "杜绝",
                                "target_lang_sense_clarification": "指彻底制止某种不良现象。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}