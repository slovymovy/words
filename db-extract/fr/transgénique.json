                ],
                "senses": [
                    {
                        "sense_id": "03c77256-312e-3575-bc06-40c569031d21",
                        "entry_id": "f62101c3-fc02-333b-af78-0172cae504e5",
                        "glosses": [
                            "Qualifie un être vivant issu d’une cellule dans laquelle a été introduit un ADN étranger."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "e8dc8f74-5c8a-47cf-941e-455e9ca85b74",
                                "sense_id": "03c77256-312e-3575-bc06-40c569031d21",
                                "text": "Ainsi, les promesses chimériques de maïs transgéniques capables de pousser sans eau, voire dans les déserts, sont sans doute techniquement réalisables à terme, mais ces plantes ultra-sobres et ultra-tolérantes ne produiront alors que quelques kilos de grains."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed45eccd-1bee-4028-9383-f1d4c7737368",
                        "source_entry_id": "f62101c3-fc02-333b-af78-0172cae504e5",
                        "source_sense_id": "03c77256-312e-3575-bc06-40c569031d21",
                        "target_lang_word": "transgenic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transgenic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cad6ccfd-2ff3-38c4-8bae-e92f2ac2ce37",
                                        "entry_id": "29fc594e-b901-3af1-9524-746c0799ed8e",
                                        "glosses": [
                                            "Of, or pertaining to an organism whose genome has been changed by the addition of a gene from another species; (of an organism) whose genome has been changed by such addition, genetically modified."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "befe3467-4372-43d9-89a3-35d01ff51b82",
                                                "sense_id": "cad6ccfd-2ff3-38c4-8bae-e92f2ac2ce37",
                                                "text": "The third type are human transgenic embryos, made by injecting a segment of animal DNA into a human egg."
                                            },
                                            {
                                                "example_id": "385d57bb-8594-454c-b65f-b13d3c91746b",
                                                "sense_id": "cad6ccfd-2ff3-38c4-8bae-e92f2ac2ce37",
                                                "text": "Common ingredients like corn, vegetable oil, maltodextrin, soy protein, lecithin, monosodium glutamate, cornstarch, yeast extract, sugar and corn syrup are almost always produced from transgenic crops."
                                            }
                                        ]
                                    }
                                ]
                            },
