                "senses": [
                    {
                        "sense_id": "1beacb5c-0139-3de3-8101-0a38e02863b8",
                        "entry_id": "7db5c30b-74a0-3021-9538-ef2fc159caf0",
                        "glosses": [
                            "Désarticuler, démonter, défaire."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e989adb4-f3ca-4753-8133-e31016f075c7",
                                "sense_id": "1beacb5c-0139-3de3-8101-0a38e02863b8",
                                "text": "Donc on attaque à démiauler la cloison vitrée."
                            },
                            {
                                "example_id": "6db4aae1-1223-4561-af9b-3cf46ba988db",
                                "sense_id": "1beacb5c-0139-3de3-8101-0a38e02863b8",
                                "text": "Chambre toujours impeccable grâce à un personnel pléthorique, qui vous fera découvrir (ô surprise en rentrant le soir…) ses \"créations originales\" faites à l’aide des serviettes du bord […]. Bon, le problème c’est qu’il faut tout démiauler pour utiliser les dites serviettes, au grand désespoir des enfants."
                            },
                            {
                                "example_id": "093d3499-6bf8-4c9a-9f39-725eddfa3199",
                                "sense_id": "1beacb5c-0139-3de3-8101-0a38e02863b8",
                                "text": "De mon côté, tout se passe bien à part qu’hier matin je me suis démiaulée quatre cervicales en baillant."
                            }
                        ]
                    }
                ],
