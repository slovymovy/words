                                "target_senses": [
                                    {
                                        "sense_id": "fb7a3785-fd73-32ef-bc9a-1f7db5a33861",
                                        "entry_id": "cc2d160f-b838-3c37-b57f-4128fb0cf0f1",
                                        "glosses": [
                                            "Possible to do; feasible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8342b810-e26e-42de-a72d-5730d17f0cb6",
                                                "sense_id": "fb7a3785-fd73-32ef-bc9a-1f7db5a33861",
                                                "text": "\"I think this is embarrassing for the rail industry to put out non-workable options in a major public consultation that lots of people have given plenty of time to for then, at this stage, for us to be told that none of it was doable in the first place."
                                            },
                                            {
                                                "example_id": "1d76e089-c899-458d-b02f-fe09a5fd0276",
                                                "sense_id": "fb7a3785-fd73-32ef-bc9a-1f7db5a33861",
                                                "text": "The work will, for now, continue in a different, disparate form. “It’s doable but it is disruptive,” said Kate Marvel, a climate scientist at GISS."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0217cd1-9978-320a-9727-fd893b8ae7c7",
                                        "entry_id": "cc2d160f-b838-3c37-b57f-4128fb0cf0f1",
                                        "glosses": [
                                            "Worthy of sexual conquest."
