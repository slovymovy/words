                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e28d9f6-cd38-48cf-a3ff-9855d21a2e45",
                        "source_entry_id": "a3078ebc-4b7d-3de2-93cf-84efd4833e5a",
                        "source_sense_description": "охватывая всех, каждого; распространяясь на всех",
                        "target_lang_word": "one and all",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "one and all",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c56c1099-93e2-3913-bc2b-5743300929a4",
                                        "entry_id": "a61a9ab7-c62b-3194-9784-77c71fb70803",
                                        "glosses": [
                                            "The entire set of persons or things within a given domain, considered both as separate individuals and collectively."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6f5b6fc-aa0b-4a8d-aa02-ef4487514f73",
                                                "sense_id": "c56c1099-93e2-3913-bc2b-5743300929a4",
                                                "text": "Therefore my friends, stand to it one and all, refuse this filthy trash."
                                            },
                                            {
                                                "example_id": "3e5d9189-3449-4d7d-823c-1fab24b385cf",
                                                "sense_id": "c56c1099-93e2-3913-bc2b-5743300929a4",
                                                "text": "Now this doubloon was of purest, virgin gold […] and however wanton in their sailor ways, one and all, the mariners revered it as the white whale's talisman."
                                            },
                                            {
                                                "example_id": "50c75a2f-a000-4e56-a4b4-5649b46bd96f",
                                                "sense_id": "c56c1099-93e2-3913-bc2b-5743300929a4",
                                                "text": "[M]en of every condition […] had laid their hearts at her feet. One and all, they had been compelled to pick them up and take them elsewhere."
                                            },
                                            {
                                                "example_id": "6548aab7-d92d-4ca9-b662-b0e5b3dbc725",
                                                "sense_id": "c56c1099-93e2-3913-bc2b-5743300929a4",
                                                "text": "Later American literary stars like Hemingway, Faulkner, Sinclair Lewis and John Steinbeck, Nobel Prize-winners one and all, never had more than a spoonful of the great gouts of fame that Twain — and Mrs. Stowe, for that matter — enjoyed everywhere in the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17bac3e4-52bd-49f3-a304-852d15830b10",
                        "source_entry_id": "a3078ebc-4b7d-3de2-93cf-84efd4833e5a",
                        "source_sense_description": "охватывая всех, каждого; распространяясь на всех",
                        "target_lang_word": "totalmente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "totalmente",
