                    {
                        "translation_id": "cff5fd0c-c7d0-445e-8aa3-fe734057446a",
                        "source_entry_id": "7fe4c1ff-cb1f-31e1-bfd8-9b9c3b40c63d",
                        "source_sense_id": "c768fff3-1135-3079-9b86-bd1651efa21d",
                        "source_sense_description": "relating to a paramilitary",
                        "target_lang_word": "paramilitaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paramilitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35e5efc3-dcee-38f3-81e3-cc7e75b1ff00",
                                        "entry_id": "a3bf2c7e-0e84-3c74-8836-3b415b045d41",
                                        "glosses": [
                                            "Qui est entrainé à l’activité militaire mais ne fait pas partie de l’armée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09990c26-9e13-4ec9-b5df-c3ed31d26f1b",
                                                "sense_id": "35e5efc3-dcee-38f3-81e3-cc7e75b1ff00",
                                                "text": "Le 19 octobre, le patron du groupe paramilitaire Wagner, Evguéni Prigojine, a annoncé la construction de ce dispositif, hérissé de « dents de dragon » antichars, dans la région de Lougansk."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paramilitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14b23b5c-fb15-3394-9cdb-ff7d73775df7",
                                        "entry_id": "b985a42f-1e55-310c-8b97-02c14c32f100",
                                        "glosses": [
                                            "Personne appartenant à un groupe paramilitaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b77ff7-3035-45f3-aa94-04081ac33b44",
                                                "sense_id": "14b23b5c-fb15-3394-9cdb-ff7d73775df7",
                                                "text": "Il a par ailleurs réussi à faire démobiliser plusieurs milliers de paramilitaires sans que cela ait signifié la fin des activités de ce groupe terroriste."
                                            },
                                            {
                                                "example_id": "ac100388-a1f6-4cf1-b450-74966d04a03e",
                                                "sense_id": "14b23b5c-fb15-3394-9cdb-ff7d73775df7",
                                                "text": "Les policiers et les paramilitaires tirent sur les manifestants."
                                            },
                                            {
                                                "example_id": "e83acb02-1c6d-4f3b-b19d-b9a255638833",
                                                "sense_id": "14b23b5c-fb15-3394-9cdb-ff7d73775df7",
                                                "text": "Comble de l’ironie pour un paramilitaire endurci comme lui, il ne pouvait s’empêcher de trembler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
