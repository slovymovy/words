                    {
                        "translation_id": "8f0cbec5-3348-4075-b714-1654eba32c38",
                        "source_entry_id": "62a8a664-8393-32b6-8017-4e9cafe5eab6",
                        "source_sense_id": "1abdf53c-029e-370f-a3d2-2b0c04b8ba00",
