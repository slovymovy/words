                            {
                                "example_id": "9a2366fc-f717-4996-8d27-ea1b948d9315",
                                "sense_id": "f6c46156-3f38-36e2-b8d4-35e13d5aa44b",
                                "text": "De definitie van lastenverzwaringen is \"een verhoging van de inkomsten van de overheid door middel van belastingen en sociale premies\". Als de overheid bijvoorbeeld zou besluiten liggeld in ziekenhuizen in te voeren, is dat officieel geen lastenverhoging, maar kan dat mensen wel raken, erkennen VVD-Kamerlid Harbers en zijn PvdA-collega Nijboer."
                            },
                            {
                                "example_id": "b7b897e8-76dc-4a15-879d-cf50d0076806",
                                "sense_id": "f6c46156-3f38-36e2-b8d4-35e13d5aa44b",
                                "text": "Daar zou dan wel een andere lastenverhoging voor in de plaats moeten komen. Binnenkort wordt een besluit verwacht."
                            }
                        ]
                    }
