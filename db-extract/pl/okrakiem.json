                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62d07dd1-1f3c-31a5-830a-3a266d392ae2",
                                        "entry_id": "744b620c-9073-3f36-bb40-8a25025d5ef4",
                                        "glosses": [
                                            "With one’s legs on either side."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "403fc1fb-cbdd-4b50-81b2-14d86c65835c",
                                                "sense_id": "62d07dd1-1f3c-31a5-830a-3a266d392ae2",
                                                "text": "The men ride their horses astride."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "astride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcf55a4a-a0d6-3ceb-a675-cd8f2c974cc7",
                                        "entry_id": "d40ed0a1-9f96-35da-96c6-9377d6b4f99d",
                                        "glosses": [
                                            "With one’s legs on either side of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b46581b-d6e5-4501-bdd8-b4659607a34e",
                                                "sense_id": "fcf55a4a-a0d6-3ceb-a675-cd8f2c974cc7",
                                                "text": "The boy sat astride his father’s knee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95b62da0-b8e1-33b8-aa98-11f872e3ca93",
                                        "entry_id": "d40ed0a1-9f96-35da-96c6-9377d6b4f99d",
                                        "glosses": [
                                            "Extending across (something)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c8a85c1-a58a-45c6-9d48-ae80e9da88a7",
                                                "sense_id": "95b62da0-b8e1-33b8-aa98-11f872e3ca93",
                                                "text": "Chʻung-ming, an island astride the mouth of the Yangtze, had been captured against quite stiff opposition from the Chinese River Defense Force and was being developed into an advance naval and air base."
                                            },
                                            {
                                                "example_id": "56fbc85a-a7a6-4358-9759-fbaecaf5f5bc",
                                                "sense_id": "95b62da0-b8e1-33b8-aa98-11f872e3ca93",
                                                "text": "The units have transverse seats, two and three astride the passageway with single or double longitudinal seats alongside the two entrance vestibules in each car."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b3822f6-5406-4edd-bc89-33ec79d49eaf",
                        "source_entry_id": "b31727ef-379c-3b8a-b733-2a55742e4905",
                        "source_sense_id": "777ec165-718b-38ca-8a68-a7771d86463e",
                        "target_lang_word": "à califourchon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à califourchon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b359186f-e7b1-3ec1-9444-89535bfefcb8",
                                        "entry_id": "6175c98a-5d8e-3ec0-b98b-de5fa8fb5dee",
                                        "glosses": [
                                            "À la manière d’une fourche : une jambe d’un côté, l’autre jambe de l’autre côté, comme quand on est à cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cb2f2bc-3ae8-4da4-8a2a-0323b734e768",
                                                "sense_id": "b359186f-e7b1-3ec1-9444-89535bfefcb8",
                                                "text": "Mais déjà sorciers et sorcières s’étaient envolés par la cheminée à califourchon, qui sur un balai, qui sur les pincettes, et Maribas sur la queue de la poêle."
                                            },
                                            {
                                                "example_id": "ee07a953-d3e7-43c4-ae73-7f3ad75db710",
                                                "sense_id": "b359186f-e7b1-3ec1-9444-89535bfefcb8",
                                                "text": "Elle était formée par deux filles à califourchon sur des juments arabes de robe blanche et à longue queue."
                                            },
                                            {
                                                "example_id": "53e76d40-d15d-49f3-82e9-97335c2a32ba",
                                                "sense_id": "b359186f-e7b1-3ec1-9444-89535bfefcb8",
                                                "text": "Une fois même, on rencontra une charrette attelée d’un cheval et une autre fois un adolescent à califourchon sur un destrier noir, en butte aux lazzis des passants."
                                            },
                                            {
                                                "example_id": "527d8b57-4d26-4df5-84ae-e86f1ded2019",
                                                "sense_id": "b359186f-e7b1-3ec1-9444-89535bfefcb8",
                                                "text": "Il tira une chaise, s’installa à califourchon et son regard fit le tour de la chambre avec une lippe dédaigneuse et apitoyée."
                                            },
                                            {
                                                "example_id": "c199225d-543c-4002-ac89-022b907e7b1d",
                                                "sense_id": "b359186f-e7b1-3ec1-9444-89535bfefcb8",
                                                "text": "Longtemps j’ai envié les concierges de la rue Lacépède, quand le soir et l’été les font sortir sur le trottoir, à califourchon sur leurs chaises : leurs yeux innocents voyaient sans avoir mission de regarder."
                                            },
                                            {
                                                "example_id": "c405611c-9946-480d-826b-3c701039d0e8",
                                                "sense_id": "b359186f-e7b1-3ec1-9444-89535bfefcb8",
                                                "text": "Il n’offrit même pas un siège au commissaire qui, sans plus de gêne, s’installa à califourchon sur une chaise, virevoltée en un tournemain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
