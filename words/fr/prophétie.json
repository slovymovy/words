                        "faire des prophéties"
                    ]
                },
                {
                    "sense_id": "c6bf8089-f339-3ac0-b904-b048f1195495",
                    "sense_definition": "Prédiction faite par un devin ou un charlatan abusant de la crédulité publique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "divination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'astrologue de foire attirait la foule avec sa prétendue <w>prophétie</w>."
                        },
                        {
                            "text": "Il refusait de dépenser son argent pour écouter les <w>prophéties</w> d'un charlatan."
                        }
                    ],
                    "synonyms": [
                        "divination",
                        "bonne aventure"
                    ]
                },
                {
                    "sense_id": "b154b33a-0b7d-3745-a02e-2caef74d21a6",
                    "sense_definition": "Recueil ou livre consignant les prédictions et paroles d'un prophète.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce passage théologique est directement extrait de la <w>prophétie</w> d'Isaïe."
                        },
                        {
                            "text": "Le moine a passé plusieurs années à copier les <w>prophéties</w> bibliques."
                        }
                    ]
                }
            ]
