                "senses": [
                    {
                        "sense_id": "78964303-b1b7-3c19-bfef-9c2963d6faf6",
                        "entry_id": "4f683df7-e9dc-3d26-8fd6-a3fb153f3c1e",
                        "glosses": [
                            "het hoogste punt van een heuvel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e81d0be1-e765-4518-978e-e1f62341a093",
                                "sense_id": "78964303-b1b7-3c19-bfef-9c2963d6faf6",
                                "text": "Zijn contragewicht in de roman is Josip Tudjman, veteraan uit de Tweede Wereldoorlog en beheerder van de kabelspoorbaan die van het slaperige Kroatische stadje naar de heuveltop leidt. Boven stond vroeger de orthodoxe kerk maar nu het heldenmonument van de socialistische heilstaat."
                            },
                            {
                                "example_id": "c2b2dcc1-34ee-44ed-b740-645c483c7829",
                                "sense_id": "78964303-b1b7-3c19-bfef-9c2963d6faf6",
                                "text": "Het leger veroverde de afgelopen uren het westelijke deel van Palmyra en de citadel op de heuveltop naast de stad. Vandaag wordt volgens het observatorium de stad onderzocht op de aanwezigheid van mijnen."
                            }
                        ]
                    }
                ],
                "translations": [
