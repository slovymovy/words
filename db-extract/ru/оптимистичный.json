                        "cross_references": [
                            {
                                "target_word": "optimistisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8b609a8e-511e-3507-a7a1-dd858f475c12",
                                        "entry_id": "ec051335-5ac9-3599-b0f2-38899a5a249b",
                                        "glosses": [
                                            "van het positieve uitgaand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146d9595-5737-4e5c-a543-cce71c30dbd3",
                                                "sense_id": "8b609a8e-511e-3507-a7a1-dd858f475c12",
                                                "text": "De oplevering van het gebouw was in november of december van dit jaar gepland. Na de kerstvakantie moesten de leerlingen erin kunnen. De school houdt rekening met vertraging, maar de wethouder is optimistisch: \"Er is geen reden om aan te nemen dat dat niet gaat lukken.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a43b9494-69c5-4e9a-a1f8-3aa8aaea7b3d",
                        "source_entry_id": "9ed60436-2cda-3732-9fd1-f0a1dd991278",
                        "source_sense_id": "64215cc9-256a-3cf2-8db2-ea4b8fde73e7",
                        "target_lang_word": "optymistyczny",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "optymistyczny",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "be63ec80-9167-3926-8263-9fa148132196",
                                        "entry_id": "9923a651-7f85-31fc-96a1-6bcabf806227",
                                        "glosses": [
                                            "pełen optymizmu, właściwy optymiście; dostrzegający pozytywne strony czegoś, wierzący w powodzenie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63547cc9-a6c3-4a53-8e10-5cf8c7def9e1",
                                                "sense_id": "be63ec80-9167-3926-8263-9fa148132196",
                                                "text": "Ludzie urodzeni pod znakiem Strzelca są optymistyczni i otwarci."
                                            },
                                            {
                                                "example_id": "1ae63ec9-6382-492d-b7a6-3275deeb1348",
                                                "sense_id": "be63ec80-9167-3926-8263-9fa148132196",
                                                "text": "Jeśli uda mi się wykazać, że w ludzkim mózgu znajdują się optymistyczne i pesymistyczne komórki mózgowe, […] będzie to stanowiło dużą zmianę w naszym rozumieniu układu dopaminowego."
                                            },
                                            {
                                                "example_id": "6183c6c0-38d0-4357-9ffa-596bbf3e6f7f",
                                                "sense_id": "be63ec80-9167-3926-8263-9fa148132196",
                                                "text": "Zwykle po takich spotkaniach prezydent i uczestnicy konferencji składali optymistyczne oświadczenia, zapowiadając szybką poprawę koniunktury. Były to jednak słowa bez pokrycia."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8e4ff4c3-d976-425d-8521-2593f53f2001",
                        "source_entry_id": "9ed60436-2cda-3732-9fd1-f0a1dd991278",
                        "source_sense_id": "64215cc9-256a-3cf2-8db2-ea4b8fde73e7",
                        "target_lang_word": "optimiste",
