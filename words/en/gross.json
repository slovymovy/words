                },
                {
                    "sense_id": "c495367d-30d7-3ad9-9a5b-b97b6e57f210",
                    "sense_definition": "Representing the total amount before any deductions like taxes or expenses are taken away.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financial_total",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your <w>gross</w> income is higher than what you actually take home each month.",
                            "target_lang_translations": {
                                "ru": "Ваш <w>валовой</w> доход выше того, что вы на самом деле получаете на руки каждый месяц.",
                                "zh": "你的<w>总</w>收入比你每月实际到手的钱要高。"
                            }
                        },
                        {
                            "text": "The <w>gross</w> weight of the truck includes both the vehicle and its cargo.",
                            "target_lang_translations": {
                                "ru": "Вес <w>брутто</w> грузовика включает как само транспортное средство, так и его груз.",
                                "zh": "卡车的<w>毛</w>重包括车辆本身及其装载的货物。"
                            }
