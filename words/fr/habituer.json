            "senses": [
                {
                    "sense_id": "38f87434-28b0-35f9-8e55-d549bffc5d5b",
                    "sense_definition": "Prendre une habitude, s'adapter à une nouvelle situation ou à un nouvel environnement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "accoutumance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut du temps pour s'<w>habituer</w> au climat de cette région."
                        },
                        {
                            "text": "Elle s'<w>habitue</w> rapidement à son nouveau travail et à ses collègues."
                        }
                    ],
                    "common_phrases": [
                        "s'habituer au changement",
                        "s'habituer au froid"
                    ]
                },
                {
                    "sense_id": "009a057c-478e-30b9-89c8-b7a7bf9eba4b",
                    "sense_definition": "Faire prendre une habitude à quelqu'un, l'amener à trouver une chose normale ou familière.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accoutumance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parents doivent <w>habituer</w> les enfants à ranger leurs jouets après le jeu."
                        },
                        {
                            "text": "Ce professeur sait <w>habituer</w> ses élèves à lire chaque soir un chapitre."
                        }
                    ],
                    "synonyms": [
                        "accoutumer"
                    ],
                    "common_phrases": [
                        "habituer les enfants",
                        "habituer son corps"
                    ]
                },
                {
                    "sense_id": "92faa3b3-a399-3d59-9129-8e8ac20c23bf",
                    "sense_definition": "S'établir de façon permanente dans un endroit, s'y fixer.",
