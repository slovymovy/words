                    {
                        "sense_id": "ff3d7d05-4f49-3b8a-99a7-f7033562463b",
                        "entry_id": "a1b092d4-e499-321a-bf65-c1ce706f943b",
                        "glosses": [
                            "Eigenname von Plätzen, Straßenname (in Deutschland in 16 Orten)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c8678a-aa1e-46b9-9311-44cb6d146d44",
                                "sense_id": "ff3d7d05-4f49-3b8a-99a7-f7033562463b",
                                "text": "„Der Lessingplatz ist ein sehr stark frequentierter Platz, insbesondere die Kinder aus der angrenzenden Wohnbebauung nutzen diesen Platz – die Spielgeräte – intensiv. …“"
                            },
                            {
                                "example_id": "5ee33542-33fa-48de-b3f4-2a7bfbff72c5",
                                "sense_id": "ff3d7d05-4f49-3b8a-99a7-f7033562463b",
                                "text": "Der Lessingplatz im Leipziger Stadtteil Böhlitz-Ehrenberg ist am Montag nach Abschluss der Bauarbeiten wieder freigegeben worden."
                            },
                            {
                                "example_id": "dba73b6b-4d5c-499d-b342-fbb45b73ca9a",
                                "sense_id": "ff3d7d05-4f49-3b8a-99a7-f7033562463b",
                                "text": "Der Lessingplatz ist eine von Bäumen gesäumte Oase im dicht bebauten Oberbilk."
                            },
                            {
                                "example_id": "5385c27f-dc63-4c95-9055-762f488368ba",
                                "sense_id": "ff3d7d05-4f49-3b8a-99a7-f7033562463b",
                                "text": "Der heutige Lessingplatz entstand eigentlich aus ursprünglich zwei Plätzen, dem alten, sogenannten „kleinen“ Lessingplatz um das Lessing-Denkmal herum und dem größeren, südlicher gelegenen ehemaligen „Siegesplatz“."
                            },
                            {
                                "example_id": "c166efe2-d4bf-4410-8f2c-6ad8b8b6c096",
                                "sense_id": "ff3d7d05-4f49-3b8a-99a7-f7033562463b",
                                "text": "Die Herzog August Bibliothek in Wolfenbüttel befindet sich am Lessingplatz 1."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
