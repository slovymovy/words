{
    "word_family": [
        "masse",
        "massification",
        "massifier",
        "massivité"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "87a9a6ba-93a2-310e-ab7e-ff909a6108ee",
                    "sense_definition": "Qui présente une apparence très lourde, imposante et compacte.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ancienne forteresse est un bâtiment très <w>massif</w> qui domine toute la vallée."
                        },
                        {
                            "text": "Le sculpteur a taillé une silhouette <w>massive</w> dans un bloc de granit."
                        }
                    ],
                    "synonyms": [
                        "épais",
                        "gros",
                        "lourd",
                        "mastoc",
                        "pesant"
                    ],
                    "common_phrases": [
                        "bâtiment massif"
                    ]
                },
                {
                    "sense_id": "8963420c-3b34-32b5-82f6-b54ddcedeb30",
                    "sense_definition": "En menuiserie, fait de bois plein d'un seul tenant, par opposition au placage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons acheté une table fabriquée entièrement en chêne <w>massif</w> pour la salle à manger."
                        },
                        {
                            "text": "Le prix des meubles en bois <w>massif</w> est souvent plus élevé que le contreplaqué."
                        }
                    ],
                    "synonyms": [
                        "plein"
                    ],
                    "common_phrases": [
                        "bois massif",
                        "chêne massif"
                    ]
                },
                {
                    "sense_id": "f6f5b3f1-c99e-34ed-8779-c24dd07b7c39",
                    "sense_definition": "Composé entièrement du métal précieux désigné, sans être creux ni simplement plaqué.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a reçu en héritage une jolie bague en or <w>massif</w> ornée d'un rubis."
                        },
                        {
                            "text": "Les cuillères de cette ancienne ménagère de luxe sont en argent <w>massif</w>."
                        }
                    ],
                    "synonyms": [
                        "plein"
                    ],
                    "common_phrases": [
                        "or massif",
                        "argent massif"
                    ]
                },
                {
                    "sense_id": "5c3d31ce-be90-3b62-9b31-fb5a5687d225",
                    "sense_definition": "Qui se produit en grande quantité ou concerne un nombre très élevé d'éléments.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'entreprise fait face à un départ <w>massif</w> d'employés mécontents de la nouvelle politique."
                        },
                        {
                            "text": "Le gouvernement a annoncé des investissements <w>massifs</w> dans la recherche et la santé publique."
                        }
                    ],
                    "common_phrases": [
                        "départ massif",
                        "soutien massif",
                        "investissements massifs"
                    ]
                },
                {
                    "sense_id": "78d7df17-a4f2-3620-a239-1298e0f5e54e",
                    "sense_definition": "En linguistique, qualifie un nom qui désigne une matière ou une notion continue et non dénombrable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mot eau est un nom <w>massif</w> car il ne peut pas se compter directement sans unité."
                        },
                        {
                            "text": "Les grammairiens étudient l'opposition entre un nom <w>massif</w> et un nom comptable."
                        }
                    ],
                    "synonyms": [
                        "massique",
                        "non-comptable"
                    ],
                    "antonyms": [
                        "comptable"
                    ],
                    "common_phrases": [
                        "nom massif"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "22797e32-4926-3661-a089-640ea21e3d2b",
                    "sense_definition": "Grand ensemble de montagnes formant un bloc continu et homogène.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont passé deux semaines à faire de la randonnée dans ce <w>massif</w> montagneux."
                        },
                        {
                            "text": "Le <w>massif</w> des Alpes attire des skieurs du monde entier durant tout l'hiver."
                        }
                    ],
                    "synonyms": [
                        "bloc"
                    ],
                    "common_phrases": [
                        "massif montagneux",
                        "massif alpin"
                    ]
                },
                {
                    "sense_id": "612a3c63-5c72-3c31-a9ec-3eb943301063",
                    "sense_definition": "Groupe de fleurs ou de petites plantes agencées de manière décorative dans un jardin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vegetation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier arrose chaque matin le grand <w>massif</w> de fleurs devant la maison."
                        },
                        {
                            "text": "Elle a planté des tulipes colorées au centre du <w>massif</w> principal."
                        }
                    ],
                    "synonyms": [
                        "corbeille",
                        "parterre"
                    ],
                    "common_phrases": [
                        "massif de fleurs",
                        "massif de roses"
                    ]
                },
                {
                    "sense_id": "ff502cdd-3955-36e5-ba0e-ef0c12a92d2d",
                    "sense_definition": "Étendue dense et continue formée par un groupe d'arbres ou d'arbustes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vegetation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un incendie dévastateur a détruit une grande partie de ce vaste <w>massif</w> forestier."
                        },
                        {
                            "text": "Les animaux sauvages trouvent refuge dans le <w>massif</w> d'arbres situé au bord du parc."
                        }
                    ],
                    "synonyms": [
                        "forêt"
                    ],
                    "common_phrases": [
                        "massif forestier",
                        "massif d'arbres"
                    ]
                },
                {
                    "sense_id": "621f79d0-feff-375f-8510-3d83058a7f84",
                    "sense_definition": "Gros bloc de maçonnerie ou de béton destiné à supporter un édifice ou à servir d'ancrage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers coulent un <w>massif</w> de béton pour soutenir les piliers du viaduc."
                        },
                        {
                            "text": "Ce câble en acier est fermement relié à un <w>massif</w> d'ancrage souterrain."
                        }
                    ],
                    "synonyms": [
                        "ancrage"
                    ],
                    "common_phrases": [
                        "massif de béton",
                        "massif de fondation"
                    ]
                }
            ]
        }
    ]
}