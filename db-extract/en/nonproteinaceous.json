                        "glosses": [
                            "Not proteinaceous."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "714335ed-5c3e-4539-a0db-d08e065bf9d1",
                                "sense_id": "4a65a7c1-022f-38d9-bbec-932abf29151a",
                                "text": "By taking a price of $5.00 per ton for cane molasses, the most economical local nonproteinaceous feed, the value of each pound of nonprotein nutrients is determined to be $0.0042."
                            },
                            {
                                "example_id": "1a809b71-709b-4254-b0ce-91443567fa61",
                                "sense_id": "4a65a7c1-022f-38d9-bbec-932abf29151a",
                                "text": "In the meantime, it remains unclear whether a nonproteinaceous constituent in wheat also acts as an allergen. Unlike proteinaceous allergens, some nonproteinaceous substances would be more stable in the body, possibly acting as a remaining allergen to cause a longer-lasting allergic reaction."
                            },
                            {
                                "example_id": "c16005bd-6c90-45d2-b1a4-13eccb99d706",
                                "sense_id": "4a65a7c1-022f-38d9-bbec-932abf29151a",
                                "text": "In principle, all of the indicators discussed in Section 6.4.2 can also be employed to visualize biomolecules that are nonproteinaceous (e.g., lipids, nucleic acids, sugars)."
                            }
                        ]
                    }
