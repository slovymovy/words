                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses explications ne <w>cadrent</w> pas du tout avec les faits constatés par la police."
                        },
                        {
                            "text": "Cette nouvelle proposition <w>cadre</w> parfaitement avec nos priorités pour l'année à venir."
                        }
                    ],
                    "synonyms": [
