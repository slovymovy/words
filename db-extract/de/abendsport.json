                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e997e80-f4c5-4da4-9fee-4aadd9223fd8",
                                "sense_id": "271033e3-d44c-32e7-8e0c-6b179e69fbd7",
                                "text": "„Allgemein beeinträchtige Abendsport - also Sport weniger als vier Stunden vorm Zubettgehen - den Schlaf nicht.“"
                            },
                            {
                                "example_id": "b74bab9d-fe5e-4ac6-bb28-f498b6867e3f",
                                "sense_id": "271033e3-d44c-32e7-8e0c-6b179e69fbd7",
                                "text": "„Nicht zuletzt betont auch die Studie selbst, dass beim Menschen die Ernährung einen weiteren großen Einflussfaktor auf die körperlichen Prozesse beim Morgen- bzw. Abendsport sei, welche in weiteren Untersuchungen genauer beleuchtet werden kann.“"
                            },
                            {
                                "example_id": "0b49c87b-4cda-4d6a-9b75-ccea4cdac0b9",
                                "sense_id": "271033e3-d44c-32e7-8e0c-6b179e69fbd7",
                                "text": "„Ob Morgen- oder Abendsport angesagt ist, hängt von der Art der Bewegung ab und von den Trainingszielen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
