                                        "sense_id": "49140408-7c1b-365c-94d8-9bd6f0adc651",
                                        "entry_id": "ca6acd69-17f5-3ae9-99d5-cf1c2cc60f84",
                                        "glosses": [
                                            "übertrieben oder extrem"
                                        ],
                                        "tags": [
                                            "umgangssprachlich für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a74556ee-9e4e-4489-a5f0-6a9b59c34401",
                                                "sense_id": "49140408-7c1b-365c-94d8-9bd6f0adc651",
                                                "text": "Diesen Winter war es teuflisch kalt."
