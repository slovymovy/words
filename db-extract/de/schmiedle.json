                ],
                "senses": [
                    {
                        "sense_id": "1137140f-4806-34ff-9ca1-3350dab0b8da",
                        "entry_id": "16565a6c-435e-367e-a569-03e37c5e93c0",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab7cb0b1-4b8b-4ed9-a1bd-437048c1ad0d",
                                "sense_id": "1137140f-4806-34ff-9ca1-3350dab0b8da",
                                "text": "Frau Schmiedle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a7126f79-a9e4-4dc0-a84a-54c8bdecc7c8",
                                "sense_id": "1137140f-4806-34ff-9ca1-3350dab0b8da",
                                "text": "Herr Schmiedle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "371afae0-247e-4aed-a5a7-db7600a26a88",
                                "sense_id": "1137140f-4806-34ff-9ca1-3350dab0b8da",
                                "text": "Die Schmiedles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "8eb710fa-a874-4747-81bb-82b1a20a08a2",
                                "sense_id": "1137140f-4806-34ff-9ca1-3350dab0b8da",
                                "text": "Der Schmiedle trägt nie die Pullover, die die Schmiedle ihm strickt."
                            },
                            {
                                "example_id": "c65cda0d-547d-46c2-8aa4-54446ff14f29",
                                "sense_id": "1137140f-4806-34ff-9ca1-3350dab0b8da",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schmiedle kommt, geht der Herr Schmiedle.“"
                            },
                            {
                                "example_id": "9b4fe3b7-47d6-4cf0-82a1-556a88cb92d0",
                                "sense_id": "1137140f-4806-34ff-9ca1-3350dab0b8da",
                                "text": "Schmiedle kommt und geht."
                            },
                            {
                                "example_id": "bf3151e0-12b8-49be-9a4e-7dfb2cf4a933",
                                "sense_id": "1137140f-4806-34ff-9ca1-3350dab0b8da",
                                "text": "Schmiedles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
