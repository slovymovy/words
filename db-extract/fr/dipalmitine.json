                "senses": [
                    {
                        "sense_id": "9db57e9e-e3b0-3119-8b60-074ad32cacf9",
                        "entry_id": "e72d2790-7261-3648-8043-91ea0c8230a4",
                        "glosses": [
                            "Diglycéride de l'acide palmitique, i.e. ester formé par la combinaison d'une molécule de glycérine avec deux molécules d'acide palmitique."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f6238515-d6c9-4b58-9dc7-474483683474",
                                "sense_id": "9db57e9e-e3b0-3119-8b60-074ad32cacf9",
                                "text": "Dans la nomenclature courante, la dipalmitine est le 1,2-dipalmitoylglycérol ou le 1,3-dipalmitoylglycérol, selon la position de l'acide gras sur la molécule de glycérol (un triol)."
                            },
                            {
                                "example_id": "9bb01b89-7d96-4990-bb10-ffcb5f0abd41",
                                "sense_id": "9db57e9e-e3b0-3119-8b60-074ad32cacf9",
                                "text": "On obtient la dipalmitine en chauffant l’acide palmitique en excès avec de la glycérine pendant 114 heures à 100°, ou encore en chauffant de la monopalmiline avec de l’acide palmitique à 260°."
                            }
                        ]
                    }
                ],
