                "senses": [
                    {
                        "sense_id": "5a844856-39f3-39f3-bf7a-7afd5d4df329",
                        "entry_id": "07841ee9-94e6-3dd3-883f-fbd74b4f7bb8",
                        "glosses": [
                            "Zierpflanze (Dianthus barbatus) aus der Familie der Nelkengewächse (Caryophyllaceae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e776f987-9544-4e4d-aae2-02936619b0ff",
                                "sense_id": "5a844856-39f3-39f3-bf7a-7afd5d4df329",
                                "text": "Bartnelken sind hervorragende Beet- und Schnittblumen."
                            },
                            {
                                "example_id": "a1a7166c-7534-4aa0-baf5-4263f5d74d17",
                                "sense_id": "5a844856-39f3-39f3-bf7a-7afd5d4df329",
                                "text": "Als Wildpflanze findet man die Bartnelke vom Tiefland bis in die Höhenlagen."
                            },
                            {
                                "example_id": "52d58e74-104f-4da5-91ff-68ec31f55c3c",
                                "sense_id": "5a844856-39f3-39f3-bf7a-7afd5d4df329",
                                "text": "„Die heiße Sommerluft roch nach dem frisch gemähten Gras und den Bartnelken, die unter unseren vorderen Fenstern blühten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d0f6cef-f992-4caa-b6ad-49b80733e7ef",
