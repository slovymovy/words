                ],
                "senses": [
                    {
                        "sense_id": "cc6d88af-dece-3e71-b7bc-94a7d24d7bf2",
                        "entry_id": "37675224-966f-36b8-a872-9371cc06fb46",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "327ac5ad-24be-458b-8198-a61a72b9baa3",
                                "sense_id": "cc6d88af-dece-3e71-b7bc-94a7d24d7bf2",
                                "text": "Frau Hässle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "59e8568c-fe59-4ba2-ae05-5ff537a617cc",
                                "sense_id": "cc6d88af-dece-3e71-b7bc-94a7d24d7bf2",
                                "text": "Herr Hässle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e7337485-36e5-4b9a-a0ee-84aed783746c",
                                "sense_id": "cc6d88af-dece-3e71-b7bc-94a7d24d7bf2",
                                "text": "Die Hässles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "c0b257cb-0b2c-4c24-972c-776f4fc85114",
                                "sense_id": "cc6d88af-dece-3e71-b7bc-94a7d24d7bf2",
                                "text": "Der Hässle trägt nie die Pullover, die die Hässle ihm strickt."
                            },
                            {
                                "example_id": "4d9ba45a-cdf0-4c40-9b74-7b6efcdc3cc1",
                                "sense_id": "cc6d88af-dece-3e71-b7bc-94a7d24d7bf2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hässle kommt, geht der Herr Hässle.“"
                            },
                            {
                                "example_id": "32f02ee4-0732-41d4-8e55-a10921582176",
                                "sense_id": "cc6d88af-dece-3e71-b7bc-94a7d24d7bf2",
                                "text": "Hässle kommt und geht."
                            },
                            {
                                "example_id": "585ff735-1ade-4faa-9cfb-dee18a9de93b",
                                "sense_id": "cc6d88af-dece-3e71-b7bc-94a7d24d7bf2",
                                "text": "Hässles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
