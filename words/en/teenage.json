                    "sense_definition": "Of or relating to an age between thirteen and nineteen years old.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fred's <w>teenage</w> years were the most difficult of times.",
                            "target_lang_translations": {
                                "ru": "<w>Подростковые</w> годы Фреда были самым трудным временем.",
                                "zh": "弗雷德的<w>青少年</w>时期是他最艰难的时光。"
                            }
                        },
                        {
                            "text": "She is a typical <w>teenage</w> girl who loves listening to pop music.",
                            "target_lang_translations": {
                                "ru": "Она типичная девочка-<w>подросток</w>, которая любит слушать поп-музыку.",
                                "zh": "她是一个典型的<w>青少年</w>女孩，喜欢听流行音乐。"
                            }
