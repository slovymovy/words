    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5aace1bf-47df-303c-9d29-cafa680365b1",
                    "sense_definition": "Наложить повязку на рану или больное место.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач должен был <w>перевязать</w> глубокую рану на руке пациента.",
                            "target_lang_translations": {
                                "de": "Der Arzt musste die tiefe Wunde am Arm des Patienten <w>verbinden</w>."
                            }
                        },
                        {
                            "text": "Медсестра помогла <w>перевязать</w> рану после операции.",
                            "target_lang_translations": {
                                "de": "Die Krankenschwester half dabei, die Wunde nach der Operation zu <w>verbinden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "забинтовать"
                    ],
                    "common_phrases": [
                        "перевязать рану"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Verband anlegen, um eine Wunde oder eine verletzte Stelle zu versorgen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verbinden",
                                "target_lang_sense_clarification": "allgemeiner Begriff für das Anlegen eines Verbandes"
                            },
                            {
                                "target_lang_word": "verband anlegen",
                                "target_lang_sense_clarification": "medizinischer Vorgang des Verbindens"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f172fbf5-d212-3151-96f9-40252c120fe8",
                    "sense_definition": "Распустить вязаное изделие и связать его заново или иначе.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "knitting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне не понравился фасон, поэтому пришлось <w>перевязать</w> свитер.",
                            "target_lang_translations": {
                                "de": "Mir gefiel der Schnitt nicht, deshalb musste ich den Pullover <w>neu stricken</w>."
                            }
                        },
                        {
                            "text": "Мама решила <w>перевязать</w> старую кофту, чтобы сделать из неё шарф.",
                            "target_lang_translations": {
                                "de": "Mama beschloss, die alte Strickjacke <w>umzustricken</w>, um daraus einen Schal zu machen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "перевязать свитер"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein gestricktes Kleidungsstück auftrennen und neu oder anders stricken."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "neu stricken",
                                "target_lang_sense_clarification": "etwas noch einmal stricken"
                            },
                            {
                                "target_lang_word": "umstricken",
                                "target_lang_sense_clarification": "etwas in eine andere Form stricken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67fab304-8462-3da7-82d1-87e43796ec7a",
                    "sense_definition": "Стянуть или скрепить что-либо веревкой, лентой или нитью.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нужно <w>перевязать</w> стопку газет бечевкой перед отправкой.",
                            "target_lang_translations": {
                                "de": "Man muss den Zeitungsstapel vor dem Versand mit einer Schnur <w>verschnüren</w>."
                            }
                        },
                        {
                            "text": "Она решила <w>перевязать</w> подарок красивой атласной лентой.",
                            "target_lang_translations": {
                                "de": "Sie beschloss, das Geschenk mit einem schönen Satinband zu <w>umwickeln</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "обвязать",
                        "связать"
                    ],
                    "antonyms": [
                        "развязать"
                    ],
                    "common_phrases": [
                        "перевязать лентой"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas mit einem Seil, Band oder Faden zusammenbinden oder befestigen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verschnüren",
                                "target_lang_sense_clarification": "mit einer Schnur fest zusammenbinden"
                            },
                            {
                                "target_lang_word": "zubinden",
                                "target_lang_sense_clarification": "mit einem Band oder Knoten verschließen"
                            },
                            {
                                "target_lang_word": "umwickeln",
                                "target_lang_sense_clarification": "mit einem Band umwickeln"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8862455-9499-3961-b614-ae2292e69c28",
                    "sense_definition": "Развязать что-либо и завязать снова или другим способом.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Узел затянулся, пришлось <w>перевязать</w> шнурки на ботинках.",
                            "target_lang_translations": {
                                "de": "Der Knoten hatte sich festgezogen, ich musste die Schnürsenkel an den Schuhen <w>neu binden</w>."
                            }
                        },
                        {
                            "text": "Бантик на коробке помялся, нужно <w>перевязать</w> его аккуратнее.",
                            "target_lang_translations": {
                                "de": "Die Schleife auf der Schachtel war zerknittert, man muss sie ordentlicher <w>neu binden</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "перевязать шнурки"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas lösen und erneut oder auf eine andere Weise festbinden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "neu binden",
                                "target_lang_sense_clarification": "einen Knoten oder eine Schleife erneut machen"
                            },
                            {
                                "target_lang_word": "neu schnüren",
                                "target_lang_sense_clarification": "speziell für Schnürsenkel"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}