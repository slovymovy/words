                ],
                "senses": [
                    {
                        "sense_id": "cf3d1bc8-5f3d-3ad4-968e-c704d0f3ffc4",
                        "entry_id": "ca1a7fe6-a005-331b-b55c-c9c4d52343f3",
                        "glosses": [
                            "разг. сокр. от квартирная плата"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "af2ca92f-437f-4e49-9674-3f6a8922aba9",
                                "sense_id": "cf3d1bc8-5f3d-3ad4-968e-c704d0f3ffc4",
                                "text": "Квартплата и вправду завышена: двухкомнатная хрущёвка на троих человек обходится ежемесячно в 156 тысяч; двухкомнатная со всеми удобствами — в 200–250 тысяч."
                            },
                            {
                                "example_id": "9c0b129e-32b6-4987-8b48-5e5cba16d22b",
                                "sense_id": "cf3d1bc8-5f3d-3ad4-968e-c704d0f3ffc4",
                                "text": "Перед тем, как вопрос о выселении будет рассматриваться в судебном заседании, должнику пришлют копию искового заявления и обязательно разберутся, почему квартплата не была внесена своевременно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9eb80f07-a908-4af3-889c-7cae3a7edec3",
                        "source_entry_id": "ca1a7fe6-a005-331b-b55c-c9c4d52343f3",
                        "source_sense_id": "cf3d1bc8-5f3d-3ad4-968e-c704d0f3ffc4",
                        "target_lang_word": "rent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b69acd47-8c1e-377e-91a5-7ece492f566a",
                                        "entry_id": "0b34d534-1c3a-37ac-a676-da76d6ef808f",
                                        "glosses": [
                                            "A payment made by a tenant at intervals in order to lease a property."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4c19c77-0380-4686-8ee9-65efa4a2a6ac",
                                                "sense_id": "b69acd47-8c1e-377e-91a5-7ece492f566a",
                                                "text": "I am asking £300 a week rent."
                                            },
                                            {
                                                "example_id": "aef436fd-6a86-4e99-94fb-cd4c249c359a",
                                                "sense_id": "b69acd47-8c1e-377e-91a5-7ece492f566a",
                                                "text": "This time was most dreadful for Lilian. Thrown on her own resources and almost penniless, she maintained herself and paid the rent of a wretched room near the hospital by working as a charwoman, sempstress, anything."
                                            },
                                            {
                                                "example_id": "4c918a88-5523-43cf-8b8c-6d5bdffef982",
                                                "sense_id": "b69acd47-8c1e-377e-91a5-7ece492f566a",
                                                "text": "We never ever argue, we never calculate / The currency we've spent / I love you, you pay my rent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ccc7169-9a35-394d-be16-ae818891827e",
                                        "entry_id": "0b34d534-1c3a-37ac-a676-da76d6ef808f",
                                        "glosses": [
                                            "A similar payment for the use of a product, equipment or a service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5386c1a3-9832-3191-9e48-ed2d894fa7aa",
                                        "entry_id": "0b34d534-1c3a-37ac-a676-da76d6ef808f",
                                        "glosses": [
                                            "A profit from possession of a valuable right, as a restricted license to engage in a trade or business."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d86d2d6c-f036-421f-9ea9-c79e9556d76d",
                                                "sense_id": "5386c1a3-9832-3191-9e48-ed2d894fa7aa",
                                                "text": "A New York city taxicab license earns more than $10,000 a year in rent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34d744f6-67ea-3e9b-a228-f1e5a901c599",
                                        "entry_id": "0b34d534-1c3a-37ac-a676-da76d6ef808f",
                                        "glosses": [
                                            "An object for which rent is charged or paid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f566749-295a-3aa0-b18a-8d6d3229d7b1",
                                        "entry_id": "0b34d534-1c3a-37ac-a676-da76d6ef808f",
                                        "glosses": [
                                            "Income; revenue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12bc8c1c-13c6-4e2a-924e-a3f10c80cd92",
                                                "sense_id": "6f566749-295a-3aa0-b18a-8d6d3229d7b1",
                                                "text": "So bought an annual rent or two, / And liv'd, just as you see I do."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82e04032-8a39-3f95-a066-81cf0b058a0a",
                                        "entry_id": "0b34d534-1c3a-37ac-a676-da76d6ef808f",
                                        "glosses": [
                                            "An amount of virtual currency paid by a player to preserve their character, inventory, etc. between gameplay sessions in a multi-user dungeon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9dd485b-0651-3655-9bc5-dcb8a2ff5fa5",
                                        "entry_id": "b8f9e00d-15e1-3456-8720-603e0b6d2f3b",
                                        "glosses": [
                                            "To take a lease of premises in exchange for rent."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ddf80c1-161e-4940-acc2-b42ca0578eea",
                                                "sense_id": "f9dd485b-0651-3655-9bc5-dcb8a2ff5fa5",
                                                "text": "I rented a house from my friend's parents for a year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3b908cf-a344-349d-9862-22bbbe8d3803",
                                        "entry_id": "b8f9e00d-15e1-3456-8720-603e0b6d2f3b",
                                        "glosses": [
                                            "To grant a lease in return for rent."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d74d0a3b-c720-42de-a6cd-b2a9dffb8777",
                                                "sense_id": "f3b908cf-a344-349d-9862-22bbbe8d3803",
                                                "text": "We rented our house to our son's friend for a year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38204072-36fa-3803-9b8a-c0106fa010f7",
                                        "entry_id": "b8f9e00d-15e1-3456-8720-603e0b6d2f3b",
                                        "glosses": [
                                            "To obtain or have temporary possession of an object (e.g. a movie) in exchange for money."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "897ce8bf-fa7a-37a5-9dcd-6846c7028e96",
                                        "entry_id": "b8f9e00d-15e1-3456-8720-603e0b6d2f3b",
                                        "glosses": [
                                            "To be leased or let for rent."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "540e773d-8969-4a7a-9d14-c634adb846c1",
                                                "sense_id": "897ce8bf-fa7a-37a5-9dcd-6846c7028e96",
                                                "text": "The house rents for five hundred dollars a month."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4510985-66ea-3f71-9e21-8731ee5b8b7f",
                                        "entry_id": "5fccf090-eb5c-39d8-acca-23896d60233b",
                                        "glosses": [
                                            "A tear or rip in some surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd668d97-dc30-4709-bf3a-2826efa2c561",
                                                "sense_id": "d4510985-66ea-3f71-9e21-8731ee5b8b7f",
                                                "text": "[O]ne streak of copper-coloured light made a narrow rent between sea and sky."
                                            },
                                            {
                                                "example_id": "608a4261-731e-4991-9522-4c1a41bdc394",
                                                "sense_id": "d4510985-66ea-3f71-9e21-8731ee5b8b7f",
                                                "text": "The brown paint on the door was so old that the naked wood showed between the rents."
                                            },
                                            {
                                                "example_id": "23b2d829-7cdf-4b22-ac98-d7d8c7de315d",
                                                "sense_id": "d4510985-66ea-3f71-9e21-8731ee5b8b7f",
                                                "text": "The oscillations were getting so severe that painters on the bridge learned to tie down their tins before a train passed. They found holes and rents in the iron but never reported them as they were never asked, and it wasn't their job. These were deferential times, and few wanted to talk out of turn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "597761df-cdd8-39e5-a33a-5379779bb53a",
                                        "entry_id": "5fccf090-eb5c-39d8-acca-23896d60233b",
                                        "glosses": [
                                            "A division or schism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f835cd8-bef1-4c74-a309-54811697f3a4",
                                                "sense_id": "597761df-cdd8-39e5-a33a-5379779bb53a",
                                                "text": "[T]he White House was considering sending Vice President Humphrey to Cairo to patch up the many rents in U.S.—Egyptian relations."
                                            }
                                        ]
                                    }
                                ]
                            },
