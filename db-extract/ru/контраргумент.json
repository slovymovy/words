                "senses": [
                    {
                        "sense_id": "071b8674-71d1-38f1-9326-02b1a83e24bc",
                        "entry_id": "685046c8-bfac-3b20-91a5-6c9a0ffcacf8",
                        "glosses": [
                            "книжн. встречный аргумент; довод, опровергающий довод противника (в споре, в судебном разбирательстве и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e760b66d-8335-4c77-a643-ab9185d1f098",
                                "sense_id": "071b8674-71d1-38f1-9326-02b1a83e24bc",
                                "text": "Основной контраргумент высокопоставленных военных при внедрении средств динамической защиты в практику ведения танкового боя звучал следующим образом: «А если солдат кованным сапогом по вашим коробочкам?»"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "446530ed-b5c3-4f82-a8ff-2df04ef3a312",
                        "source_entry_id": "685046c8-bfac-3b20-91a5-6c9a0ffcacf8",
                        "source_sense_id": "071b8674-71d1-38f1-9326-02b1a83e24bc",
                        "target_lang_word": "Gegenargument",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegenargument",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b3cf433-2fcc-3e97-b1df-475dce914d3a",
                                        "entry_id": "58b7ed0d-f4f6-3e25-89fa-b6495ba06bda",
                                        "glosses": [
                                            "Argument gegen ein anderes, gegen etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9fa863c-cc1d-48a6-a396-6a5b5390934d",
                                                "sense_id": "4b3cf433-2fcc-3e97-b1df-475dce914d3a",
                                                "text": "„Er hatte weder bestimmte Anhaltspunkte noch tröstliche Gegenargumente.“"
                                            },
                                            {
                                                "example_id": "d1fd03a0-9013-4550-b70b-1c1a186a0927",
                                                "sense_id": "4b3cf433-2fcc-3e97-b1df-475dce914d3a",
                                                "text": "„Auch die Präsidin war um Gegenargumente verlegen.“"
                                            },
                                            {
                                                "example_id": "f49a4b19-4a17-4a0f-a763-d0f579238f41",
                                                "sense_id": "4b3cf433-2fcc-3e97-b1df-475dce914d3a",
                                                "text": "„Und Bilibin zog die Haut wieder auseinander, überzeugt, dass dieses Dilema durch keine Gegenargumente aus der Welt geschafft werden könne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
