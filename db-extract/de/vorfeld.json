                        ],
                        "form": "die Vorfelder"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "314a4e6c-ed53-3564-aa9b-81cefaa9dc75",
                        "entry_id": "4fc93824-43e3-3125-948d-3b3551f76023",
                        "glosses": [
                            "allgemein: der Bereich (Gelände oder Zeitabschnitt), der vor jemand/etwas liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c3a7c0-822e-4422-bf54-e833e2e52609",
                                "sense_id": "314a4e6c-ed53-3564-aa9b-81cefaa9dc75",
                                "text": "Das Vorfeld konnte gut beobachtet werden."
                            },
                            {
                                "example_id": "19ee3064-8bfd-4d57-8f41-1c37e4447225",
                                "sense_id": "314a4e6c-ed53-3564-aa9b-81cefaa9dc75",
                                "text": "Viele Fragen konnten schon im Vorfeld geklärt werden."
                            },
                            {
                                "example_id": "3ae7a8a9-0921-47a9-8901-b1c142d19085",
                                "sense_id": "314a4e6c-ed53-3564-aa9b-81cefaa9dc75",
                                "text": "„Im gesamten Land verhinderten Sicherheitskräfte Protestaktionen im Vorfeld, indem sie Zufahrtswege sperrten oder Menschen in Gewahrsam nahmen.“"
                            },
                            {
                                "example_id": "052d4fff-ce25-4a8b-babc-a9bbb9800241",
                                "sense_id": "314a4e6c-ed53-3564-aa9b-81cefaa9dc75",
                                "text": "„Schon im Vorfeld des Treffens hatte die Kanzlerin auf die Bedeutung der kulturellen Angebote hingewiesen.“"
                            },
                            {
                                "example_id": "0cdc64fe-56ab-496b-9d05-1f85cc5aea13",
                                "sense_id": "314a4e6c-ed53-3564-aa9b-81cefaa9dc75",
                                "text": "„Während sie dies alles in ihrer lebhaften Art erzählte, waren die beiden von der Verkehrsstraße in das Gartengelände der Erbsiedlung eingebogen, das im Vorfeld der Stadt lag.“"
                            },
                            {
                                "example_id": "768b9ea7-d968-403d-8190-9faeefc91537",
                                "sense_id": "314a4e6c-ed53-3564-aa9b-81cefaa9dc75",
                                "text": "„Bereits 1518 im Vorfeld der Leipziger Disputation zwischen Luther und Eck tat sich Karlstadt mit Cranach zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8f8e9344-2859-3ebb-9d11-cb7432c7e1cf",
                        "entry_id": "4fc93824-43e3-3125-948d-3b3551f76023",
                        "glosses": [
                            "im Aussagesatz die Wortstellungen, die sich vor der Satzklammer befinden"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "17c439d2-d7db-4000-81ce-58bbf4ced99d",
                                "sense_id": "8f8e9344-2859-3ebb-9d11-cb7432c7e1cf",
                                "text": "In dem Satz \"Hans ist gestern zu uns zu Besuch gekommen\" steht \"Hans\" im Vorfeld."
                            },
                            {
                                "example_id": "61f304dc-ba6e-424a-889f-5fe904fac7df",
                                "sense_id": "8f8e9344-2859-3ebb-9d11-cb7432c7e1cf",
                                "text": "„Bekanntlich kann im Vorfeld jedes Satzglied stehen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b293999-8b29-4491-9fa8-f0e28c2855a1",
                        "source_entry_id": "4fc93824-43e3-3125-948d-3b3551f76023",
                        "source_sense_id": "314a4e6c-ed53-3564-aa9b-81cefaa9dc75",
                        "source_sense_description": "allgemein: der Bereich (Gelände oder Zeitabschnitt), der vor jemand/etwas liegt",
                        "target_lang_word": "run-up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "run-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68e05b17-6580-3a9e-a8fa-ec79215be64d",
                                        "entry_id": "d4bb171c-fdf8-3629-abfe-e70419eed3dc",
                                        "glosses": [
                                            "The approach run of a bowler before delivering the ball."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "290855df-87e9-4e73-a4e5-d68c9fdb6019",
                                                "sense_id": "68e05b17-6580-3a9e-a8fa-ec79215be64d",
                                                "text": "Jasprit Bumrah has the most unique run-up in the history of cricket."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42223b5c-a28e-347a-93b9-1138f4cd90cd",
                                        "entry_id": "d4bb171c-fdf8-3629-abfe-e70419eed3dc",
                                        "glosses": [
                                            "The approach run of a high jumper or other athlete in order to gather speed or momentum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1079e8d7-13a0-466c-b897-d6a93bd6a3ca",
                                                "sense_id": "42223b5c-a28e-347a-93b9-1138f4cd90cd",
                                                "text": "But he still saw his side produce a rousing display which owed much to their lauded prowess from set-pieces, despite Uefa regulations meaning the pitch had to be widened and, in the process, the run-up area for Delap's long throws reduced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "479de232-351f-3e8e-b9ba-b1f4c50c4f6e",
                                        "entry_id": "d4bb171c-fdf8-3629-abfe-e70419eed3dc",
                                        "glosses": [
                                            "A period of time just before an important event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbc330b-8931-4cf7-8c05-1cc8e7459a19",
                                                "sense_id": "479de232-351f-3e8e-b9ba-b1f4c50c4f6e",
                                                "text": "The candidates were very nervous in the run-up to the election."
                                            },
                                            {
                                                "example_id": "de49d407-ec1d-4801-932a-c04bd211f689",
                                                "sense_id": "479de232-351f-3e8e-b9ba-b1f4c50c4f6e",
                                                "text": "Politicians on TikTok will no longer be able to use the app tipping tools, nor access advertising features on the social network, as the company tightens its policies around political issues in the run-up to the US midterm elections in six weeks’ time."
                                            },
                                            {
                                                "example_id": "65fa8eaf-12db-4204-9b6e-ba7879856e2a",
                                                "sense_id": "479de232-351f-3e8e-b9ba-b1f4c50c4f6e",
                                                "text": "Further trials and commissioning of the newly laid track will take place in the run-up to the launch of passenger services in June."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7873f1e-59ff-3396-85b9-3dc694c4b896",
                                        "entry_id": "d4bb171c-fdf8-3629-abfe-e70419eed3dc",
                                        "glosses": [
                                            "An increase in the value or amount of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f143359a-070e-46fa-9e85-2fd220453298",
                                                "sense_id": "c7873f1e-59ff-3396-85b9-3dc694c4b896",
                                                "text": "Economists expect a run-up of long-term interest rates."
                                            },
                                            {
                                                "example_id": "086ad8f9-d4d2-43ce-8afe-4ea8e580094a",
                                                "sense_id": "c7873f1e-59ff-3396-85b9-3dc694c4b896",
                                                "text": "A Price Run-Up for Run-Down Communes [title]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f961709-ee0d-3d4c-b0a3-33cc74a2bfb9",
                                        "entry_id": "d4bb171c-fdf8-3629-abfe-e70419eed3dc",
                                        "glosses": [
                                            "The extent of a wave's reach onto land as the result of a tsunami or storm such as a cyclone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdd3f80c-1948-4da7-80d8-ed6573627d88",
                                                "sense_id": "3f961709-ee0d-3d4c-b0a3-33cc74a2bfb9",
                                                "text": "I found sand pushed all the way to the edge of my home by the run-up of Wednesday's tsunami."
                                            },
                                            {
                                                "example_id": "2a0be3e5-5086-46d4-83c3-f920bb33e592",
                                                "sense_id": "3f961709-ee0d-3d4c-b0a3-33cc74a2bfb9",
                                                "text": "Historical records of tsunamis in this region are available for the last 400 years, and the run-up heights of historical tsunamis at Koyadori were estimated and measured\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efed7400-cfe5-3179-bcd1-b70f47ed187a",
                                        "entry_id": "d4bb171c-fdf8-3629-abfe-e70419eed3dc",
