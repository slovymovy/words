                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b61e302-8596-468b-8bbd-b927439c353f",
                                                "sense_id": "3b9da3ab-055e-3136-95da-f5b69c5d00c0",
                                                "text": "The father is a cotton lord, and they all have loads of tin, you know"
                                            },
                                            {
                                                "example_id": "80d59440-342b-4974-bc8e-313b363202b5",
                                                "sense_id": "3b9da3ab-055e-3136-95da-f5b69c5d00c0",
                                                "text": "When all your tin is gone and spent, / And you've not a mag for bread or rent"
