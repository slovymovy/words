                    {
                        "translation_id": "2f1975f5-38b7-40e1-a638-cf98cd9398fe",
                        "source_entry_id": "4f639948-d6e2-32dd-ad5f-eb0d296a9922",
                        "source_sense_id": "66c7d8fa-06a7-3519-b5e0-b5b2dea0fd17",
