                        "sense_id": "c6bdda09-6ff8-3d7e-8378-d9d680164280",
                        "entry_id": "1fb65173-2156-3194-9276-c5c1acf84da4",
                        "glosses": [
                            "Tourismus, der durch viele Eheschließungen in einer Region entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89bc1cf4-e047-460d-b2fb-2726eb3d10f6",
                                "sense_id": "c6bdda09-6ff8-3d7e-8378-d9d680164280",
                                "text": "„Neuburg hat sich darum bemüht, Hochzeitsstadt zu werden und damit auch den Hochzeitstourismus angekurbelt.“"
                            },
                            {
                                "example_id": "ac4a9da2-a940-4842-a8b4-e3f807ce01b7",
                                "sense_id": "c6bdda09-6ff8-3d7e-8378-d9d680164280",
                                "text": "„Nach dem Einkaufs- kommt nun auch noch der Hochzeitstourismus: Seit der Franken gegenüber dem Euro in die Höhe geschossen ist, feiern deutlich mehr Schweizer Paare ihre Heirat im grenznahen Ausland.“"
                            },
                            {
                                "example_id": "8b76e571-197b-428e-a413-9215e97b3f2e",
                                "sense_id": "c6bdda09-6ff8-3d7e-8378-d9d680164280",
                                "text": "„Um auch am Wochenende Gäste nach Baden zu locken, könnte man laut den Bündner Studenten auf den Hochzeitstourismus setzen.“"
                            }
                        ],
