                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect <w>patterned</w> the ceiling with intricate geometric shapes.",
                            "target_lang_translations": {
                                "ru": "Архитектор <w>украсил</w> потолок замысловатыми геометрическими фигурами."
                            }
                        },
                        {
                            "text": "He has <w>patterned</w> his career on his father's achievements in the legal field.",
                            "target_lang_translations": {
                                "ru": "Он <w>строил</w> свою карьеру, ориентируясь на достижения своего отца в области юриспруденции."
                            }
                        }
                    ],
                    "traits": [
