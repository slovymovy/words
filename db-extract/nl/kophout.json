                        "entry_id": "f26242e9-a4d9-3bdd-8690-46c25e369f0d",
                        "glosses": [
                            "elk van de twee uitgeholde houten steunen waarop een vat of ton ligt, zodat het op zijn plaats blijft liggen en geheel vrij blijft van de grond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3588a54e-000a-4c90-804d-6e9c37235cef",
                                "sense_id": "d4ed23bc-7890-3b06-a293-35c08a28e840",
                                "text": "Door het voorste kophout onder het wijnvat weg te halen kwam het scheef kwam te liggen zodat het laatste restje wijn eruit getapt kon worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab669464-3a34-3787-9826-78db58f902b2",
                        "entry_id": "f26242e9-a4d9-3bdd-8690-46c25e369f0d",
                        "glosses": [
                            "eenvoudige houten stut in een mijn, al dan niet afgedekt met een rond of halfrond hout"
                        ],
                        "tags": [],
                        "examples": []
                    },
