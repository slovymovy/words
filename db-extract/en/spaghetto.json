                                                "sense_id": "00fc7b53-a170-3c1b-b5f0-90e4a918d982",
                                                "text": "V sáčku zbyla už jen jediná špageta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37e760d8-53b1-3d02-9f52-0e34c3db00d4",
