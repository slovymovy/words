                                    {
                                        "sense_id": "6b71008b-7a8e-3cdb-b35d-8f1fac9c9507",
                                        "entry_id": "7799f17c-91c3-3860-8130-ad7388b2885f",
                                        "glosses": [
                                            "Vegetation unique to the Cape Floral Kingdom, largely scrub, exceptionally biodiverse, including particularly large numbers of species of Proteaceae, Restionaceae, and Ericaceae."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2107cbf-aa95-423c-ac0d-02a30dc6d035",
                                                "sense_id": "6b71008b-7a8e-3cdb-b35d-8f1fac9c9507",
                                                "text": "The southern and western Cape is the home of a unique type of vegetation known as fynbos. Covering around 90 000 square kilometers of often harsh terrain, fynbos is made up of approximately 6 000 different plant species."
                                            }
                                        ]
                                    }
                                ]
