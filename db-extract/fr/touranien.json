                                        "entry_id": "fb175c31-2e7b-3f23-b95f-6b5e56c7811c",
                                        "glosses": [
                                            "Of or pertaining to Turan."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "722ffabf-05e9-4b3a-8bfe-30a5c7af009d",
                                                "sense_id": "9d0108c4-7d0a-3347-b5e0-eb9351d1ca0c",
                                                "text": "The first written book which has come down to us in the Japanese, or indeed in any Turanian tongue, is the Kojiki or “Records of Ancient Matters,” which was completed A.D. 712."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f9f592f-91bd-3b44-a368-fb75ccaffd40",
                                        "entry_id": "fb175c31-2e7b-3f23-b95f-6b5e56c7811c",
                                        "glosses": [
                                            "Of or pertaining to the Turanians."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04e81911-502f-4ce2-b029-3deef47be215",
                                                "sense_id": "0f9f592f-91bd-3b44-a368-fb75ccaffd40",
                                                "text": "The Esthonians of Russia, who, like the Magyars, belong to the great Turanian family of mankind."
                                            }
                                        ]
                                    }
                                ]
                            },
