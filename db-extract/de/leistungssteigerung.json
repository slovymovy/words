                    {
                        "form_id": "f3190006-5b31-4892-b90b-97b98119f2b1",
                        "entry_id": "c6e5d777-7133-327b-93ab-57404aac2838",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Leistungssteigerungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c4f9ba49-b649-3ec1-af8f-491d5b0882a3",
                        "entry_id": "c6e5d777-7133-327b-93ab-57404aac2838",
                        "glosses": [
                            "Erhöhung/Verbesserung der Leistungsfähigkeit (eines Geräts, Systems oder Ähnliches)"
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "4a699493-5b56-4585-a96a-8b88a3d19281",
                                "sense_id": "c4f9ba49-b649-3ec1-af8f-491d5b0882a3",
                                "text": "„Holografische Speicher sollen gegenüber hergebrachten Techniken enorme Leistungssteigerungen hinsichtlich Speicherdichte und Transferraten bringen.“"
                            },
                            {
                                "example_id": "f27eaadf-7ac5-4b7b-8818-282571429934",
                                "sense_id": "c4f9ba49-b649-3ec1-af8f-491d5b0882a3",
                                "text": "„Fachleute erwarten vom schnelleren Systembus eine Leistungssteigerung von mindestens 20, bei Grafikanwendungen sogar bis zu 40 Prozent.“"
                            },
                            {
                                "example_id": "8fcd545d-92b4-4a7f-8256-3b6eafadef3d",
                                "sense_id": "c4f9ba49-b649-3ec1-af8f-491d5b0882a3",
                                "text": "„In einem Jahr erwartet der Analyst eine Leistungssteigerung der CPUs auf 60 MIPS je Prozessor gegenüber derzeit 45 MIPS.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "24910be8-866f-3452-a764-4fe7dfb5af9c",
                        "entry_id": "c6e5d777-7133-327b-93ab-57404aac2838",
                        "glosses": [
                            "Erhöhung/Verbesserung der erbrachten Leistungen (in zum Beispiel Arbeitsprozessen oder Trainingsmethoden), die häufig zu besseren Endergebnissen führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8193ea8f-ada6-4a23-9460-125d95e3ec6c",
                                "sense_id": "24910be8-866f-3452-a764-4fe7dfb5af9c",
                                "text": "„Druck von oben bewirkt bekanntlich keine Leistungssteigerung, sondern Demotivation – und die kann Trauerwein auf gar keinen Fall brauchen.“"
                            },
                            {
                                "example_id": "281fb2ae-143e-4c92-b245-04e8720181a2",
                                "sense_id": "24910be8-866f-3452-a764-4fe7dfb5af9c",
                                "text": "Denn mit diesen Werkzeugen kann in der Programmierung eine Leistungssteigerung und größere Transparenz erreicht werden.“"
                            },
                            {
                                "example_id": "4817d352-5c76-4986-a097-d6139022feb1",
                                "sense_id": "24910be8-866f-3452-a764-4fe7dfb5af9c",
                                "text": "„Das Steroid wird von Athleten in der Leichtathletik und im Bodybuilding zur Leistungssteigerung verwendet.“"
                            },
                            {
                                "example_id": "37aa35ba-6da8-4c0f-aa10-815cdabd13c4",
                                "sense_id": "24910be8-866f-3452-a764-4fe7dfb5af9c",
                                "text": "„Die 1954 in der DDR eingeführte Sportklassifizierung orientierte sich an dem in der Sowjetunion vorhandenen System und sollte mit normierten Anforderungen Ansporn für die sportliche Leistungssteigerung auf der Grundlage eines gezielten und regelmäßigen Trainings sein.“"
                            },
                            {
                                "example_id": "64687ed8-5615-4cf6-a820-8edf140f906f",
                                "sense_id": "24910be8-866f-3452-a764-4fe7dfb5af9c",
                                "text": "„Ab 2006 zeigte sich eine Leistungssteigerung in Singapurs Turnierteilnahmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
