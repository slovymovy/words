                ],
                "senses": [
                    {
                        "sense_id": "ef889568-0db8-3fb4-8739-0068b2810449",
                        "entry_id": "37a5dd57-68da-3664-bea2-e488e9d51e71",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "386d1a9d-56cc-4095-bc4d-bc37aafe9d61",
                                "sense_id": "ef889568-0db8-3fb4-8739-0068b2810449",
                                "text": "Frau Meinold ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "65c6787e-323c-4b88-ba2d-c1918c0923ae",
                                "sense_id": "ef889568-0db8-3fb4-8739-0068b2810449",
                                "text": "Herr Meinold wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "76d33601-284e-417e-bfd3-e638934e4700",
                                "sense_id": "ef889568-0db8-3fb4-8739-0068b2810449",
                                "text": "Die Meinolds fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8e7b773f-8c2d-4b16-8cd4-43a4a1a5e73a",
                                "sense_id": "ef889568-0db8-3fb4-8739-0068b2810449",
                                "text": "Der Meinold trägt nie die Schals, die die Meinold ihm strickt."
                            },
                            {
                                "example_id": "3792d605-58e2-4cf3-9ae9-f9df50b1bc89",
                                "sense_id": "ef889568-0db8-3fb4-8739-0068b2810449",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Meinold kommt, geht der Herr Meinold.“"
                            },
                            {
                                "example_id": "3f35e5a3-d3cc-45b9-9699-2c1d98070329",
                                "sense_id": "ef889568-0db8-3fb4-8739-0068b2810449",
                                "text": "Meinold kommt und geht."
                            },
                            {
                                "example_id": "5ab69be1-ceb2-4a62-822a-7e489d0c027e",
                                "sense_id": "ef889568-0db8-3fb4-8739-0068b2810449",
                                "text": "Meinolds kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
