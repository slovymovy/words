                    {
                        "sense_id": "76aced72-f4dc-33b9-8d76-b9b29f3c7293",
                        "entry_id": "b57721df-f252-3839-bdae-b3806ecc7b06",
                        "glosses": [
                            "een keten van ten minste twee koolstofatomen en een carboxylgroep"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b3ce562-c45d-4161-b7e0-204409dbed83",
                                "sense_id": "76aced72-f4dc-33b9-8d76-b9b29f3c7293",
                                "text": "Vet is een verbinding van glycerol en drie vetzuren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "73327ab3-9ce0-41a7-a7e2-e45df318d085",
                        "source_entry_id": "b57721df-f252-3839-bdae-b3806ecc7b06",
                        "source_sense_id": "76aced72-f4dc-33b9-8d76-b9b29f3c7293",
                        "source_sense_description": "een keten van ten minste twee koolstofatomen en een carboxylgroep",
                        "target_lang_word": "Fettsäure",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fettsäure",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d16317f-99fc-3450-b138-84083978cd51",
                                        "entry_id": "187c3c56-2ffd-35ec-b20f-7274d4acbc1e",
                                        "glosses": [
                                            "aus einer unverzweigten Kohlenwasserstoffkette und einer Carboxylgruppe bestehendes Molekül"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3991ea4c-7202-41c4-b366-61775cf4df7d",
                                                "sense_id": "6d16317f-99fc-3450-b138-84083978cd51",
                                                "text": "Der Chemiker analysierte die Fettsäuren des Präparats."
                                            },
                                            {
                                                "example_id": "efac97af-4aed-459b-b511-550a206bcfab",
                                                "sense_id": "6d16317f-99fc-3450-b138-84083978cd51",
                                                "text": "„Die Namensgebung Fettsäure ist einerseits bedingt durch die chemischen Eigenschaften dieser Stoffgruppe, die durch ihre Carboxylgruppe sauer reagiert. Andererseits geht der Name auf die Entdeckungsgeschichte dieser Alkancarbonsäuren als Bestandteil natürlicher Fette zurück.“"
                                            },
                                            {
                                                "example_id": "348271a7-dc9a-40a6-bb76-4d3a209dc415",
                                                "sense_id": "6d16317f-99fc-3450-b138-84083978cd51",
                                                "text": "„Das flüssige Olein wurde durch Auspressen von den beiden anderen Fettsäuren getrennt, Margarin und Stearin waren die Ausgangsprodukte der Kerzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b38a58e9-b8bd-497f-8cd0-48caf3e4c180",
                        "source_entry_id": "b57721df-f252-3839-bdae-b3806ecc7b06",
                        "source_sense_id": "76aced72-f4dc-33b9-8d76-b9b29f3c7293",
                        "source_sense_description": "een keten van ten minste twee koolstofatomen en een carboxylgroep",
                        "target_lang_word": "fatty acid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fatty acid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd15d74e-842e-3a7f-9414-37a510052393",
                                        "entry_id": "e8c1154a-3989-3dc4-bdaf-d7326774351b",
                                        "glosses": [
                                            "Any of a class of aliphatic carboxylic acids, of general formula CₙH₂ₙ₊₁COOH, that occur combined with glycerol as animal or vegetable oils and fats. Only those with an even number of carbon atoms are normally found in natural fats."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f621395c-cc56-492b-b5cb-363080ef6a09",
                        "source_entry_id": "b57721df-f252-3839-bdae-b3806ecc7b06",
                        "source_sense_id": "76aced72-f4dc-33b9-8d76-b9b29f3c7293",
                        "source_sense_description": "een keten van ten minste twee koolstofatomen en een carboxylgroep",
                        "target_lang_word": "acide gras",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acide gras",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32b1c46e-6ec4-3ea2-bb4a-9799bc262d68",
                                        "entry_id": "639c93f1-e420-3e95-84f7-caf910f723d9",
                                        "glosses": [
                                            "Molécule organique qui entre dans la composition des graisses animales et végétales et possède une longue chaîne carbonée, le plus souvent linéaire, terminée par une fonction acide carboxylique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc50ae25-eedd-463a-ac75-6a6275640266",
                                                "sense_id": "32b1c46e-6ec4-3ea2-bb4a-9799bc262d68",
                                                "text": "Les corps gras sont des éthers composés ou glycérides tertiaires formés par la glycérine et divers acides gras à teneur élevée en carbone. Les glycérides les plus répandus sont ceux des acides stéarique, palmitique et oléique."
                                            },
                                            {
                                                "example_id": "eeda4208-7b23-4c46-aea0-42c1a0036df7",
                                                "sense_id": "32b1c46e-6ec4-3ea2-bb4a-9799bc262d68",
                                                "text": "Les corps gras naturels animaux ou végétaux sont des éthers de la glycérine avec certains acides appelés acides gras."
                                            },
                                            {
                                                "example_id": "f2219408-efc2-4b2e-9a0e-0d8e82f1da03",
                                                "sense_id": "32b1c46e-6ec4-3ea2-bb4a-9799bc262d68",
                                                "text": "Il existe une association très, très forte entre le fait d’avoir de grandes quantités de ces acides gras sur la peau et le fait d’être un aimant à moustiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "541aeba2-271d-3e1d-9b92-cf5ef11d48e0",
                                        "entry_id": "639c93f1-e420-3e95-84f7-caf910f723d9",
                                        "glosses": [
                                            "Tout acide carboxylique linéaire, indépendamment de la longueur de la chaîne carbonée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "208fcf10-4544-4735-975b-9534e48dbded",
                                                "sense_id": "541aeba2-271d-3e1d-9b92-cf5ef11d48e0",
                                                "text": "Il a été récemment démontré que le séthoxydime ainsi que ses analogues (le cycloxydime et le cléthodime), inhibent la synthèse des acides gras dans des chloroplastes isolés de graminées, par exemple de blé, d’avoine et de maïs (Kobek et al, 1988)"
                                            },
                                            {
                                                "example_id": "9d35e199-45f3-4755-a612-2f2233de0d91",
                                                "sense_id": "541aeba2-271d-3e1d-9b92-cf5ef11d48e0",
                                                "text": "Les carnitines aident au transport des acides gras à longue chaîne du cytoplasme aux mitochondries, ce qui peut augmenter la production d'énergie dans les cellules et combattre la fatigue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "66ab39d5-5628-4d04-a9f7-eb126b218159",
                        "source_entry_id": "b57721df-f252-3839-bdae-b3806ecc7b06",
                        "source_sense_id": "76aced72-f4dc-33b9-8d76-b9b29f3c7293",
