                                    },
                                    {
                                        "sense_id": "959cd1ea-84aa-39e2-ae23-1309e09ee919",
                                        "entry_id": "365b88b7-c920-3606-a055-2921a97de4bb",
                                        "glosses": [
                                            "A group of people who are looked after, mentored, or trained in one place or for a particular purpose or profession."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78e23050-daef-3ed9-9f57-d81d8c7fc32a",
                                        "entry_id": "365b88b7-c920-3606-a055-2921a97de4bb",
                                        "glosses": [
                                            "A coherent or consistent set of things (typically abstract) available or presented; array."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecea0a70-8b29-4219-ac14-98ff47872f72",
                                                "sense_id": "78e23050-daef-3ed9-9f57-d81d8c7fc32a",
                                                "text": "This Article argues that to date, the Supreme Court has drawn from a narrow stable of arguments to create a fairly standard, yet coarse, analysis to consider when to apply proximate cause to statutes."
                                            },
                                            {
                                                "example_id": "701f90ce-b943-4267-94b4-979510b2d8bd",
                                                "sense_id": "78e23050-daef-3ed9-9f57-d81d8c7fc32a",
                                                "text": "Built into the popular conception of the genius mythos in the sciences is something more than mere intelligence; the solitary free-thinking scientist is also expected to showcase a proclivity for eccentricity, rule breaking, and unconventional thinking and behavior. But when it comes to the abuse of scientific power for sexual predation, this stable of behaviors represents a slippery slope."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "016c2f4b-faf2-3c48-9e55-2807907f1037",
                                        "entry_id": "132bb607-6a9a-378b-a635-5a637a9ee6c4",
                                        "glosses": [
                                            "To put or keep (an animal) in a stable."
