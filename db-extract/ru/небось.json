                                "sense_id": "c24dd92d-25e5-3263-956b-e8ec9a22cedf",
                                "text": "У вас там небо́сь снег идёт.",
                                "translation": "I suppose it's snowing there at your place.",
                                "english": "I suppose it's snowing there at your place."
                            }
