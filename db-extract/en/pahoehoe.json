                    {
                        "sense_id": "1c248fea-f0cb-3e77-8840-6852faf4ed9f",
                        "entry_id": "41a361ab-6594-3b43-a874-2f6e7d490589",
                        "glosses": [
                            "A form of lava flow of basaltic rock, usually dark-colored with a smooth or ropey surface. It is one of two chief forms of lava flow emitted from volcanoes of the Hawaiian type, the other form being aa."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c27fe024-a522-4986-8f37-5686c3bc9990",
                                "sense_id": "1c248fea-f0cb-3e77-8840-6852faf4ed9f",
                                "text": "We [...] saw ‘pahoihoi’ or solid lava forming, and also ‘aa’ or clinkers."
                            },
                            {
                                "example_id": "2c30e260-10dc-4e8e-a1b0-213e5b677c3c",
                                "sense_id": "1c248fea-f0cb-3e77-8840-6852faf4ed9f",
                                "text": "The twisty, ropy kind that personifies flow – all congealed motion – is called pahoehoe."
                            }
                        ]
                    }
                ],
