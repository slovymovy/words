{
    "word_family": [
        "contemptible",
        "contemptuous",
        "contemptuously",
        "contemn"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e29a46b0-f808-3bb0-88fb-7c93c9ae464d",
                    "sense_definition": "The feeling that a person or a thing is beneath consideration, worthless, or deserving scorn.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disdain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke with extreme <w>contempt</w> of the dense stupidity exhibited on all occasions by the working classes.",
                            "target_lang_translations": {
                                "ru": "Он говорил с крайним <w>презрением</w> о непроходимой глупости, которую рабочий класс проявлял при каждом удобном случае."
                            }
                        },
                        {
                            "text": "The politician showed utter <w>contempt</w> for the rules by ignoring the safety warnings.",
                            "target_lang_translations": {
                                "ru": "Политик проявил полное <w>пренебрежение</w> к правилам, проигнорировав предупреждения о безопасности."
                            }
                        }
                    ],
                    "synonyms": [
                        "disdain",
                        "scorn"
                    ],
                    "antonyms": [
                        "respect",
                        "honor",
                        "reverence"
                    ],
                    "common_phrases": [
                        "utter contempt",
                        "show contempt",
                        "feel contempt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство, что человек или вещь не заслуживают внимания, бесполезны или достойны насмешки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "презрение",
                                "target_lang_sense_clarification": "чувство крайнего неуважения"
                            },
                            {
                                "target_lang_word": "пренебрежение",
                                "target_lang_sense_clarification": "высокомерное отношение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "896cd3bb-a3f6-33c5-82af-51ac821c1c0e",
                    "sense_definition": "The offense of being disobedient to or disrespectful of a court of law and its officers.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_disrespect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge found the witness in <w>contempt</w> of court after he refused to answer the questions.",
                            "target_lang_translations": {
                                "ru": "Судья признал свидетеля виновным в <w>неуважении</w> к суду после того, как тот отказался отвечать на вопросы."
                            }
                        },
                        {
                            "text": "The panel voted to recommend charging the official with criminal <w>contempt</w> for defying the subpoena.",
                            "target_lang_translations": {
                                "ru": "Комиссия проголосовала за то, чтобы рекомендовать предъявить чиновнику обвинение в уголовном <w>оскорблении</w> суда за игнорирование повестки."
                            }
                        }
                    ],
                    "common_phrases": [
                        "contempt of court",
                        "criminal contempt",
                        "held in contempt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Правонарушение, заключающееся в неподчинении или неуважении к суду и его должностным лицам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуважение",
                                "target_lang_sense_clarification": "к суду"
                            },
                            {
                                "target_lang_word": "оскорбление",
                                "target_lang_sense_clarification": "суда"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cfe7a73-2c05-3eb9-a648-ae875f94dadb",
                    "sense_definition": "The state of being despised or dishonored; a condition of disgrace.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disgrace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fallen leader lived the rest of his life in <w>contempt</w> and isolation.",
                            "target_lang_translations": {
                                "ru": "Свергнутый лидер прожил остаток своей жизни в <w>презрении</w> и изоляции."
                            }
                        },
                        {
                            "text": "To fall into such <w>contempt</w> among one's peers is a heavy burden to bear.",
                            "target_lang_translations": {
                                "ru": "Впасть в такой <w>позор</w> среди равных себе — тяжелое бремя."
                            }
                        }
                    ],
                    "antonyms": [
                        "honor",
                        "veneration"
                    ],
                    "common_phrases": [
                        "fall into contempt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, когда человека презирают или лишают чести; положение позора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "позор",
                                "target_lang_sense_clarification": "унизительное положение"
                            },
                            {
                                "target_lang_word": "бесчестие",
                                "target_lang_sense_clarification": "утрата чести"
                            },
                            {
                                "target_lang_word": "презрение",
                                "target_lang_sense_clarification": "состояние отверженности обществом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}