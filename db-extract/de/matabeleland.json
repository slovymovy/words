                "senses": [
                    {
                        "sense_id": "7c342694-5ca1-3bed-8f0b-ca2ba05274a4",
                        "entry_id": "d625a59c-4639-3654-814e-7e5b60a18119",
                        "glosses": [
                            "geographische Region in Simbabwe, welche das Hauptsiedlungsgebiet der Matabele darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "867383cc-7965-4799-924b-e063777b0e26",
                                "sense_id": "7c342694-5ca1-3bed-8f0b-ca2ba05274a4",
                                "text": "„Die Partei erhielt 57 der 80 für die schwarze Bevölkerung reservierten Mandate, Nkomos ZAPU weitere 20, wobei seine Wahlerfolge auf den Westen, nämlich Matabeleland, beschränkt blieben.“"
                            },
                            {
                                "example_id": "c5690fd5-e114-43ad-b6c4-747f4b2c36ec",
                                "sense_id": "7c342694-5ca1-3bed-8f0b-ca2ba05274a4",
                                "text": "„In den späten 1880er-Jahren war die British South Africa Company vom Süden her in das Matabeleland im heutigen Simbabwe vorgedrungen.“"
                            },
                            {
                                "example_id": "7372f701-5b7a-4de8-afec-33deb5ca944b",
                                "sense_id": "7c342694-5ca1-3bed-8f0b-ca2ba05274a4",
                                "text": "„Er hatte seine heiß begehrte Konzession - ein Erfolg, der ein Jahr später mit einer Royal Charter für seine British South African Company gekrönt wurde, das heißt, mit der praktischen Souveränität über Matabeleland und Mashonaland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
