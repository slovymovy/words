                    "frequency": "Low",
                    "semantic_group_id": "mischief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The twinkle in his eye revealed a hint of <w>roguery</w> before he pulled another playful prank.",
                            "target_lang_translations": {
                                "de": "Das Funkeln in seinen Augen verriet eine Spur von <w>Schelmerei</w>, bevor er sich den nächsten spielerischen Streich erlaubte."
                            }
                        },
                        {
                            "text": "Her childhood was filled with harmless <w>roguery</w> that always made her grandparents laugh.",
                            "target_lang_translations": {
                                "de": "Ihre Kindheit war voller harmloser <w>Spitzbübereien</w>, über die ihre Großeltern stets lachen mussten."
                            }
                        }
                    ],
