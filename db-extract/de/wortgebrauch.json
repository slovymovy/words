                        "examples": [
                            {
                                "example_id": "e7e5688f-a8ee-4312-9b53-24847ef30f38",
                                "sense_id": "63180c77-9fc7-3f42-9d45-02f4aff0fca8",
                                "text": "„Zum einen schwankt der Wortgebrauch sehr stark mit Thematik, Zeit, Ort und Stilebene, um nur die vier wichtigsten Dimensionen der Variation zu nennen.“"
                            },
                            {
                                "example_id": "da60c7c0-0294-460e-88b4-ed6e5beb43ce",
                                "sense_id": "63180c77-9fc7-3f42-9d45-02f4aff0fca8",
                                "text": "„Schwedische Kinder lernen, von Anfang an auf diese sozialen Beziehungen zu achten, wenn sie den normgerechten Wortgebrauch erwerben.“"
                            }
                        ],
