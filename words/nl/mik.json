{
    "word_family": [
        "mikken",
        "gemik"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ac19df9-9f75-3150-874f-360fcdbc24bd",
                    "sense_definition": "Een soort brood, vaak een fijn witbrood of een traditioneel roggebrood.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "brood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bakker verkocht vroeger elke ochtend vers gebakken <w>mik</w> aan de buurtbewoners.",
                            "target_lang_translations": {
                                "en": "In the past, the baker sold freshly baked <w>bread</w> to the local residents every morning.",
                                "ru": "Раньше пекарь каждое утро продавал местным жителям свежеиспеченный <w>хлеб</w>."
                            }
                        },
                        {
                            "text": "Zij sneed een dikke plak van de <w>mik</w> en besmeerde die met roomboter.",
                            "target_lang_translations": {
                                "en": "She cut a thick slice from the <w>loaf</w> and spread it with butter.",
                                "ru": "Она отрезала толстый ломтик от <w>булки</w> и намазала его сливочным маслом."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk in zuidelijke provincies gebruikt voor brood."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A type of bread, often a fine white bread or a traditional rye bread.",
                        "ru": "Сорт хлеба, часто изысканный белый хлеб или традиционный ржаной хлеб (в основном на юге Нидерландов)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "white bread",
                                "target_lang_sense_clarification": "traditional fine white loaf"
                            },
                            {
                                "target_lang_word": "rye bread",
                                "target_lang_sense_clarification": "traditional regional rye loaf"
                            },
                            {
                                "target_lang_word": "loaf of bread",
                                "target_lang_sense_clarification": "regional term for bread"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "булка",
                                "target_lang_sense_clarification": "белый хлеб"
                            },
                            {
                                "target_lang_word": "хлеб",
                                "target_lang_sense_clarification": "традиционный или ржаной хлеб"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34fe0b6e-751c-3a02-b84c-3c24b55912e2",
                    "sense_definition": "De mond of het gezicht (plat of informeel gebruikt).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lichaamsdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hou je <w>mik</w> nou eens een keertje dicht tijdens de film!",
                            "target_lang_translations": {
                                "en": "Shut your <w>trap</w> for once during the movie!",
                                "ru": "Закрой свой <w>рот</w> хоть раз во время фильма!"
                            }
                        },
                        {
                            "text": "Hij kreeg een harde klap recht op zijn <w>mik</w> tijdens de ruzie.",
                            "target_lang_translations": {
                                "en": "He got a hard blow right to his <w>face</w> during the argument.",
                                "ru": "Во время ссоры он получил сильный удар прямо по <w>физиономии</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hou je mik"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Plat of informeel taalgebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The mouth or face (used colloquially or informally).",
                        "ru": "Рот или лицо (грубо-разговорное или неформальное употребление)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trap",
                                "target_lang_sense_clarification": "slang for mouth"
                            },
                            {
                                "target_lang_word": "gob",
                                "target_lang_sense_clarification": "slang for mouth"
                            },
                            {
                                "target_lang_word": "face",
                                "target_lang_sense_clarification": "informal or slang"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рот",
                                "target_lang_sense_clarification": "в значении замолчать"
                            },
                            {
                                "target_lang_word": "харя",
                                "target_lang_sense_clarification": "грубое обозначение лица"
                            },
                            {
                                "target_lang_word": "физиономия",
                                "target_lang_sense_clarification": "разговорное обозначение лица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d82ec8e3-969b-32af-b0e4-11e17b7d90fb",
                    "sense_definition": "De <w>maag</w> of de buik.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lichaamsdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het zware eten lag hem behoorlijk op de <w>mik</w>.",
                            "target_lang_translations": {
                                "en": "The heavy food was really sitting heavily on his <w>stomach</w>.",
                                "ru": "Тяжелая еда изрядно давила ему на <w>желудок</w>."
                            }
                        },
                        {
                            "text": "Met een lege <w>mik</w> kun je niet goed werken op het land.",
                            "target_lang_translations": {
                                "en": "You can't work well on the land with an empty <w>belly</w>.",
                                "ru": "С пустым <w>брюхом</w> в поле хорошо не поработаешь."
                            }
                        }
                    ],
                    "synonyms": [
                        "maag"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informeel of dialectaal."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The stomach or belly.",
                        "ru": "Желудок или живот (разговорное или диалектное)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stomach",
                                "target_lang_sense_clarification": "informal or dialectal"
                            },
                            {
                                "target_lang_word": "belly",
                                "target_lang_sense_clarification": "informal"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "желудок",
                                "target_lang_sense_clarification": "орган пищеварения"
                            },
                            {
                                "target_lang_word": "пузо",
                                "target_lang_sense_clarification": "разговорное обозначение живота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "026923f3-162d-3740-9741-e9fac328fd66",
                    "sense_definition": "Een verzameling spullen, rommel of een hele boel zaken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "boel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik weet echt niet wat ik met deze hele <w>mik</w> aanmoet.",
                            "target_lang_translations": {
                                "en": "I really don't know what to do with this whole <w>lot</w>.",
                                "ru": "Я действительно не знаю, что мне делать со всей этой <w>кучей</w>."
                            }
                        },
                        {
                            "text": "Gooi die oude <w>mik</w> nu eindelijk eens een keer weg.",
                            "target_lang_translations": {
                                "en": "Throw that old <w>clutter</w> away once and for all.",
                                "ru": "Выброси ты наконец этот старый <w>хлам</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de hele mik"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informeel gebruikt voor een boel spullen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A collection of things, clutter, or a whole bunch of stuff.",
                        "ru": "Куча вещей, хлам или вся совокупность каких-то предметов."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lot",
                                "target_lang_sense_clarification": "the whole lot, bunch of things"
                            },
                            {
                                "target_lang_word": "clutter",
                                "target_lang_sense_clarification": "mess of things"
                            },
                            {
                                "target_lang_word": "stuff",
                                "target_lang_sense_clarification": "informal collection of items"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "хлам",
                                "target_lang_sense_clarification": "ненужные вещи"
                            },
                            {
                                "target_lang_word": "куча",
                                "target_lang_sense_clarification": "нагромождение вещей"
                            },
                            {
                                "target_lang_word": "вся компания",
                                "target_lang_sense_clarification": "в выражении 'de hele mik' (вся банда, вся орава)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "214f13fa-99a0-3785-a274-a7c0fc379c72",
                    "sense_definition": "Een houten of metalen gaffelvormige steun waarop een gestreken mast of giek rust.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scheepvaart",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In gestreken stand rust de mast netjes in de <w>mik</w>.",
                            "target_lang_translations": {
                                "en": "When lowered, the mast rests neatly in the <w>crutch</w>.",
                                "ru": "В опущенном положении мачта аккуратно лежит на <w>опоре</w>."
                            }
                        },
                        {
                            "text": "Zorg ervoor dat je de giek stevig in de <w>mik</w> legt voor we vertrekken.",
                            "target_lang_translations": {
                                "en": "Make sure you place the boom securely in the <w>crutch</w> before we depart.",
                                "ru": "Перед отправлением убедись, что гик надежно уложен в <w>мик</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A wooden or metal fork-shaped support on which a lowered mast or boom rests.",
                        "ru": "Деревянная или металлическая вилкообразная опора (мик), на которую укладывается опущенная мачта или гик."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crutch",
                                "target_lang_sense_clarification": "mast or boom support in sailing"
                            },
                            {
                                "target_lang_word": "gallows",
                                "target_lang_sense_clarification": "boom support frame"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мик",
                                "target_lang_sense_clarification": "морской термин, опора для мачты"
                            },
                            {
                                "target_lang_word": "опора-рогулька",
                                "target_lang_sense_clarification": "вилкообразная подставка"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "18a8d848-2fee-3966-8606-983bb1a1b317",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>mikken</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>mik</w> de bal precies in de basket.",
                            "target_lang_translations": {
                                "en": "I <w>aim</w> the ball precisely into the basket.",
                                "ru": "Я <w>целюсь</w> мячом точно в корзину."
                            }
                        },
                        {
                            "text": "Als ik goed <w>mik</w>, raak ik het doelwit.",
                            "target_lang_translations": {
                                "en": "If I <w>aim</w> well, I will hit the target.",
                                "ru": "Если я хорошо <w>прицелюсь</w>, то попаду в мишень."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present tense of 'mikken' (to aim, to throw).",
                        "ru": "Форма первого лица единственного числа настоящего времени глагола 'mikken' (целиться, бросать)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aim",
                                "target_lang_sense_clarification": "first-person singular present"
                            },
                            {
                                "target_lang_word": "throw",
                                "target_lang_sense_clarification": "first-person singular present, toss"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "целюсь",
                                "target_lang_sense_clarification": "направляю в цель"
                            },
                            {
                                "target_lang_word": "кидаю",
                                "target_lang_sense_clarification": "бросаю, целясь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "233aee69-d1f3-3165-894c-a2d2de414d24",
                    "sense_definition": "Gebiedende wijs van <w>mikken</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Mik</w> op de roos als je de pijl afschiet!",
                            "target_lang_translations": {
                                "en": "<w>Aim</w> for the bullseye when you shoot the arrow!",
                                "ru": "<w>Целься</w> в яблочко, когда выпускаешь стрелу!"
                            }
                        },
                        {
                            "text": "Niet zomaar gooien, <w>mik</w> eerst goed!",
                            "target_lang_translations": {
                                "en": "Don't just throw, <w>aim</w> carefully first!",
                                "ru": "Не бросай просто так, сначала хорошенько <w>прицелься</w>!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of 'mikken' (to aim, to throw).",
                        "ru": "Повелительное наклонение глагола 'mikken' (целиться, бросать)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "aim",
                                "target_lang_sense_clarification": "imperative"
                            },
                            {
                                "target_lang_word": "throw",
                                "target_lang_sense_clarification": "imperative, toss"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "целься",
                                "target_lang_sense_clarification": "повелительная форма"
                            },
                            {
                                "target_lang_word": "кидай",
                                "target_lang_sense_clarification": "бросай, целясь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}