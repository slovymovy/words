            "senses": [
                {
                    "sense_id": "d383418f-462e-3ef4-a88c-8e23791ad13c",
                    "sense_definition": "met de vuist of elleboog een harde stoot toebrengen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_actie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bokser bleef maar <w>stompen</w> tot zijn tegenstander opgaf.",
                            "target_lang_translations": {
                                "fr": "Le boxeur a continué à <w>donner des coups de poing</w> jusqu'à ce que son adversaire abandonne."
                            }
                        },
                        {
                            "text": "Hij <w>stompte</w> hem per ongeluk in de ribben toen hij zich omdraaide.",
                            "target_lang_translations": {
                                "fr": "Il lui a accidentellement <w>donné un coup</w> dans les côtes en se retournant."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoten",
                        "slaan"
                    ],
                    "target_lang_definitions": {
                        "fr": "Donner un coup violent avec le poing ou le coude"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "donner des coups de poing",
                                "target_lang_sense_clarification": "frapper avec le poing"
                            },
                            {
                                "target_lang_word": "boxer",
                                "target_lang_sense_clarification": "frapper à coups de poing"
                            },
                            {
                                "target_lang_word": "cogner",
                                "target_lang_sense_clarification": "frapper violemment"
                            },
                            {
                                "target_lang_word": "donner un coup de coude",
                                "target_lang_sense_clarification": "frapper avec le coude"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97f6fea3-d419-35fc-b71c-4f8cac6a9296",
                    "sense_definition": "onscherp of bot maken of worden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het zware werk begon de beitel langzaam te <w>stompen</w>.",
                            "target_lang_translations": {
                                "fr": "À cause du travail pénible, le ciseau a commencé à lentement <w>s'émousser</w>."
                            }
                        },
                        {
                            "text": "Het harde hout <w>stompte</w> het lemmet van zijn mes binnen enkele minuten.",
                            "target_lang_translations": {
                                "fr": "Le bois dur a <w>émoussé</w> la lame de son couteau en quelques minutes."
                            }
                        }
                    ],
                    "synonyms": [
                        "afstompen",
                        "bot worden"
                    ],
                    "antonyms": [
                        "slijpen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Rendre ou devenir émoussé, perdre son tranchant"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "émousser",
                                "target_lang_sense_clarification": "rendre moins tranchant"
                            },
                            {
                                "target_lang_word": "s'émousser",
                                "target_lang_sense_clarification": "perdre son tranchant"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bfc577e8-f793-3d8e-8352-a3125ed4a4e4",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>stomp</w>",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het pas gekapte bos zagen we alleen nog de kale <w>stompen</w> van de bomen staan.",
                            "target_lang_translations": {
                                "fr": "Dans la forêt fraîchement coupée, nous ne voyions plus que les <w>souches</w> nues des arbres."
                            }
                        },
                        {
                            "text": "Na de hevige storm staken de <w>stompen</w> van de afgebroken takken scherp af tegen de lucht.",
                            "target_lang_translations": {
                                "fr": "Après la violente tempête, les <w>moignons</w> des branches brisées se découpaient nettement contre le ciel."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Pluriel de « stomp » : parties restantes d'un arbre, d'un membre, etc."
                    },
                    "translations": {
