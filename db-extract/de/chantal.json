                                "sense_id": "ba918112-c02f-33aa-ab42-02e82cc9d521",
                                "text": "Nach ihrem Studium hat Chantal mit ihren Freundinnen Cindy und Jacqueline eine Steuerberatersozietät aufgemacht."
                            },
                            {
                                "example_id": "779c4a97-6b62-4330-a5fc-9c053e7e6f8b",
                                "sense_id": "ba918112-c02f-33aa-ab42-02e82cc9d521",
                                "text": "„Sie tranken Calvados und spielten Schallpatten, und Chantal war in einer fast unglaublichen Weise anschmiegsam, sentimental und weich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
