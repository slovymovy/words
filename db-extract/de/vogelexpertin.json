                "senses": [
                    {
                        "sense_id": "c2f4b3cd-7d28-3fb5-910f-0e08109ffa5b",
                        "entry_id": "94a8f9aa-f45f-34cd-a965-2e0ad319f5d7",
                        "glosses": [
                            "weibliche Person, die sich mit dem Thema Vögel besonders gut auskennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a22f3d42-ff70-45a2-b33f-b486c4d6f66f",
                                "sense_id": "c2f4b3cd-7d28-3fb5-910f-0e08109ffa5b",
                                "text": "„Ich bin keine Vogelexpertin, aber zufällig weiß ich Bescheid, was Buchfinken anbelangt.“"
                            },
                            {
                                "example_id": "9111a992-4882-4dd5-b040-fa45e6e3b2c9",
                                "sense_id": "c2f4b3cd-7d28-3fb5-910f-0e08109ffa5b",
                                "text": "„Gesa, die Vogelexpertin der Familie, meinte, es müsse sich um eine Art Schockmauser handeln – wie der plötzliche Federabwurf bei Vögeln zur Flucht vor einem Angreifer, der nur Federreste zurückbehält.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
