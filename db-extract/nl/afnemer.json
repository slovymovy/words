                "entry_id": "ff5b8b7c-5715-3c41-b1f3-01705411fcac",
                "word": "afnemer",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "3db5e228-57f4-4b0a-9e1a-9026e871fc24",
                        "entry_id": "ff5b8b7c-5715-3c41-b1f3-01705411fcac",
                        "tags": [
                            "plural"
                        ],
                        "form": "afnemers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee369df1-0df6-37d0-8ef2-2ad728b4b543",
                        "entry_id": "ff5b8b7c-5715-3c41-b1f3-01705411fcac",
                        "glosses": [
                            "customer, client, buyer (of goods or services)"
                        ],
                        "tags": [
                            "masculine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "878fda63-4e10-4091-9154-e348c5c7a15e",
                                "sense_id": "ee369df1-0df6-37d0-8ef2-2ad728b4b543",
                                "text": "De winkel heeft veel tevreden afnemers die regelmatig terugkomen voor hun producten.",
                                "translation": "The store has many satisfied customers who come back regularly for their products.",
                                "english": "The store has many satisfied customers who come back regularly for their products."
                            },
                            {
                                "example_id": "7961115d-3dcd-4a1e-bc2e-112f8efa0b6d",
                                "sense_id": "ee369df1-0df6-37d0-8ef2-2ad728b4b543",
                                "text": "Als afnemer van hun diensten, ben ik altijd onder de indruk van de kwaliteit.",
                                "translation": "As a client of their services, I am always impressed with the quality.",
                                "english": "As a client of their services, I am always impressed with the quality."
                            },
                            {
                                "example_id": "3454b6a4-a6dc-41a8-b3d5-2ff7fc963ee9",
                                "sense_id": "ee369df1-0df6-37d0-8ef2-2ad728b4b543",
                                "text": "De fabrikant levert zijn producten aan afnemers over de hele wereld.",
                                "translation": "The manufacturer supplies its products to buyers all over the world.",
                                "english": "The manufacturer supplies its products to buyers all over the world."
                            }
                        ]
                    },
                    {
                        "sense_id": "368b66f9-5bd8-3642-9398-802f32d7bbc7",
                        "entry_id": "ff5b8b7c-5715-3c41-b1f3-01705411fcac",
                        "glosses": [
                            "buyer, purchaser, one who is busy with procurement professionally"
                        ],
                        "tags": [
                            "masculine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "74f03ebd-4693-423b-bce5-7d1a929f9419",
                                "sense_id": "368b66f9-5bd8-3642-9398-802f32d7bbc7",
                                "text": "Als afnemer bij een groot bedrijf moet je de beste deals sluiten voor de benodigde materialen.",
                                "translation": "As a buyer at a large company, you need to negotiate the best deals for the required materials.",
                                "english": "As a buyer at a large company, you need to negotiate the best deals for the required materials."
                            },
                            {
                                "example_id": "82aa4546-5e64-4c49-8817-981abf0e2d80",
                                "sense_id": "368b66f9-5bd8-3642-9398-802f32d7bbc7",
                                "text": "De afnemer van dit project is verantwoordelijk voor de inkoop van alle benodigde apparatuur.",
                                "translation": "The purchaser for this project is responsible for procuring all the necessary equipment.",
                                "english": "The purchaser for this project is responsible for procuring all the necessary equipment."
                            },
                            {
                                "example_id": "230541d3-9ad5-4dc7-85a5-a26be25c037d",
                                "sense_id": "368b66f9-5bd8-3642-9398-802f32d7bbc7",
                                "text": "Als professionele afnemer is het belangrijk om goede relaties op te bouwen met leveranciers.",
                                "translation": "As a professional procurement officer, it is important to build good relationships with suppliers.",
                                "english": "As a professional procurement officer, it is important to build good relationships with suppliers."
                            }
                        ]
                    }
                ],
