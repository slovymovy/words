                            {
                                "example_id": "b0273a67-06cb-4a1e-a5c0-e0bdb3cd1335",
                                "sense_id": "652fa860-af6f-3746-96de-277686a9da12",
                                "text": "There is no deadman to be found at Deadman's Curve."
                            }
                        ]
                    },
                    {
                        "sense_id": "115ac766-fd7a-3c00-94c4-6faf633606a5",
                        "entry_id": "87fc55eb-057b-3488-9502-d420f1052e15",
                        "glosses": [
                            "A long object, often a timber or log, buried to serve as an anchor for a wall or for stays."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95b7d097-66bb-438a-ae6d-2fe708134dd1",
                                "sense_id": "115ac766-fd7a-3c00-94c4-6faf633606a5",
                                "text": "The building code requires deadmen for retaining walls."
                            }
                        ]
                    },
                    {
                        "sense_id": "310c67ea-eb06-3c68-89ee-f9442b3035b5",
                        "entry_id": "87fc55eb-057b-3488-9502-d420f1052e15",
                        "glosses": [
                            "A cutout device that operates in the event that an operator releases the control handles, leaves the operator's seat, or otherwise seems to be no longer present and alert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7e9a9f5-b975-420f-be9d-e6e3f009be32",
                                "sense_id": "310c67ea-eb06-3c68-89ee-f9442b3035b5",
                                "text": "a deadman device"
                            },
                            {
                                "example_id": "6d798ebe-1089-44c9-a732-a08e6742a16b",
                                "sense_id": "310c67ea-eb06-3c68-89ee-f9442b3035b5",
                                "text": "[...] a Brown-Boveri deadman's control; [...]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fff1316a-2120-4862-ac74-0024da9aeae4",
                        "source_entry_id": "87fc55eb-057b-3488-9502-d420f1052e15",
                        "source_sense_description": "a corpse",
                        "target_lang_word": "труп",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "труп",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "28b44d64-c500-3653-b4ae-8008ede4f8d9",
                                        "entry_id": "83ef874d-3878-330a-975a-32bee48388a6",
                                        "glosses": [
                                            "тело мёртвого человека или животного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c0b224-ff7f-41de-afdb-53c2f358a96f",
                                                "sense_id": "28b44d64-c500-3653-b4ae-8008ede4f8d9",
                                                "text": "В один такой шпацир мы наткнулись на берегу моря на труп дельфина."
                                            },
                                            {
                                                "example_id": "f4c342c0-095a-4fb0-9534-48b824662654",
                                                "sense_id": "28b44d64-c500-3653-b4ae-8008ede4f8d9",
                                                "text": "В третьем часу ночи дежурный по городу сообщил нам, что в Коптеве найден труп юноши лет семнадцати, зарезан ножом."
                                            },
                                            {
                                                "example_id": "6c9daa0b-be3f-4edd-9a90-c6a44c5b107a",
                                                "sense_id": "28b44d64-c500-3653-b4ae-8008ede4f8d9",
                                                "text": "На площади какие-то люди уже грузили на тачку собачий труп."
                                            },
                                            {
                                                "example_id": "997cbd52-047a-4ed6-a316-13d0ad39fe33",
                                                "sense_id": "28b44d64-c500-3653-b4ae-8008ede4f8d9",
                                                "text": "Мой друг! ты знаешь ту поляну; // Там труп мой хладный ты зарой, // Когда дышать я перестану!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17b74314-77a3-35e8-82a7-210f3e14b462",
                                        "entry_id": "83ef874d-3878-330a-975a-32bee48388a6",
                                        "glosses": [
                                            "перен. разрушенный, испорченный предмет, не могущий быть использованным по назначению"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d3f08e7-6950-464c-acec-418ef1cc6d78",
                                                "sense_id": "17b74314-77a3-35e8-82a7-210f3e14b462",
                                                "text": ".. двинутая мною контратака .. нашла только провалившиеся во льду орудия. Мне особенно было жалко двух лёгких: замки и панорамы были унесены красными и остались трупы орудий."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
