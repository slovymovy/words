                "senses": [
                    {
                        "sense_id": "d9a7a0f3-5f19-3bbb-9f34-99cc10a3053a",
                        "entry_id": "6c07b621-692f-3518-b60e-4e32f646ae4b",
                        "glosses": [
                            "kleines, tragbares Gerät für Sprechfunk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60fb68e3-5a6e-4931-83a8-2ebb3af4c6d3",
                                "sense_id": "d9a7a0f3-5f19-3bbb-9f34-99cc10a3053a",
                                "text": "„Er fuchtelt hektisch mit einem Walkie-Talkie herum.“"
                            },
                            {
                                "example_id": "440fe706-000b-4276-ad64-db0da831d0bc",
                                "sense_id": "d9a7a0f3-5f19-3bbb-9f34-99cc10a3053a",
                                "text": "„In den Händen halten sie altmodische Walkie-talkies, ihre Jacken sind an den richtigen Stellen ausgebeult.“"
                            },
                            {
                                "example_id": "4249eb9a-51f1-4606-8192-371040854444",
                                "sense_id": "d9a7a0f3-5f19-3bbb-9f34-99cc10a3053a",
                                "text": "„Finnisches Militär campiert in den Wäldern, einzelne Uniformierte mit Walkie-Talkies – laufen und liegen an allen Ufern herum – bewachen die Anlegestellen, schlafend, rauchend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7d918a0-8aec-4f95-bb14-21b9a0ea7a15",
                        "source_entry_id": "6c07b621-692f-3518-b60e-4e32f646ae4b",
                        "source_sense_id": "d9a7a0f3-5f19-3bbb-9f34-99cc10a3053a",
                        "source_sense_description": "Technik: kleines, tragbares Gerät für Sprechfunk",
                        "target_lang_word": "walkie-talkie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "walkie-talkie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ef153eb-2415-33d9-b6a6-6548be90761a",
                                        "entry_id": "75e890a9-71c0-3665-abcf-958a8dc5490a",
                                        "glosses": [
                                            "A portable, bidirectional radio transceiver, usually one of a pair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bcaacf9-4ba1-4b87-adff-26b38730fbdc",
                                                "sense_id": "7ef153eb-2415-33d9-b6a6-6548be90761a",
                                                "text": "It is intended to equip the yard foremen and shunters with \"walkie-talkie\" apparatus to keep them in close touch with the control office."
                                            },
                                            {
                                                "example_id": "dc643fd1-2cee-4b46-b92d-db8bc796362a",
                                                "sense_id": "7ef153eb-2415-33d9-b6a6-6548be90761a",
                                                "text": "A walkie-talkie is a handheld, portable, two-way radio transceiver. It includes a half-duplex channel (only one radio transmits at a time, though any number can listen) and a push-to-talk switch that starts transmission."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88b76599-bfe7-31c7-aebb-5b2ec6724269",
                                        "entry_id": "75e890a9-71c0-3665-abcf-958a8dc5490a",
                                        "glosses": [
                                            "A walk and talk."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "269474f6-365b-48bf-b341-38127490738b",
                                                "sense_id": "88b76599-bfe7-31c7-aebb-5b2ec6724269",
                                                "text": "It could be that her walkie-talkie with Naylor had concerned a private matter not connected with what was about to happen to him, ..."
                                            },
                                            {
                                                "example_id": "2c9119a6-e3ac-4ebe-9390-6687bab5a31c",
                                                "sense_id": "88b76599-bfe7-31c7-aebb-5b2ec6724269",
                                                "text": "Go on a walkie-talkie. Everyone goes on a 15-minute brisk walk and talks about their day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61dbdb8a-dfcd-4988-8209-41e50cc21d79",
                        "source_entry_id": "6c07b621-692f-3518-b60e-4e32f646ae4b",
                        "source_sense_id": "d9a7a0f3-5f19-3bbb-9f34-99cc10a3053a",
