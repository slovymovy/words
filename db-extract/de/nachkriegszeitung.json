                "senses": [
                    {
                        "sense_id": "bb2287c9-4081-3eba-930f-9eab74f2ac7b",
                        "entry_id": "335d32f9-0607-3e57-ad7e-4f52ce8203f0",
                        "glosses": [
                            "Zeitung aus der Nachkriegszeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fef4602-cb4a-4445-9671-b9fe18ff0aba",
                                "sense_id": "bb2287c9-4081-3eba-930f-9eab74f2ac7b",
                                "text": "„Aufgrund einer voreiligen Entscheidung des britischen Stadtkommandanten erscheint die Bremervörder Zeitung am Freitag, 22. Juni 1945 für einen Tag als inoffiziell erste Nachkriegszeitung in den westlichen Besatzungsgebieten, was ihr einen Eintrag im Guinness Buch der Rekorde verschafft.“"
                            },
                            {
                                "example_id": "296c35db-6c33-464c-b720-7ee48340db82",
                                "sense_id": "bb2287c9-4081-3eba-930f-9eab74f2ac7b",
                                "text": "„Am 1. August hatte die \"FR\" ihren 60. Geburtstag gefeiert. Sie war die erste Zeitung in der US-kontrollierten Zone und die zweite Nachkriegszeitung überhaupt in Deutschland.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
