                        "tags": [],
                        "examples": [
                            {
                                "example_id": "483c0dd3-c6e2-464d-b2d2-a09a82a2f95f",
                                "sense_id": "8f009e19-96e7-3219-9f63-4db7b5cedf7f",
                                "text": "I have always argued that change becomes stressful and overwhelming only when you've lost any sense of the constancy of your life. You need firm ground to stand on. From there, you can deal with that change."
                            },
                            {
                                "example_id": "7004a224-482c-482d-a05c-07de2c537fa2",
                                "sense_id": "8f009e19-96e7-3219-9f63-4db7b5cedf7f",
                                "text": "Whether you need to recover from a stressful day, a strenuous workout or even an injury or surgery, restorative yoga may be just the thing for you."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf206569-0382-3fa9-b647-8b1d5991d042",
                        "entry_id": "597fb00d-f808-3596-9ed6-3a672b1bdb2c",
                        "glosses": [
                            "Mentally taxing."
                        ],
                        "tags": [
                            "of a task"
                        ],
                        "examples": []
                    }
