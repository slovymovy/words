                                        "examples": [
                                            {
                                                "example_id": "350936ab-43bb-40bf-b3a3-2c898966d62b",
                                                "sense_id": "3e947f34-e9bc-3ef2-86b6-6cfd2725774c",
                                                "text": "Die Wehr ist bis an die Elbe gestreift."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1b0bcba1-de1c-3aab-9154-306c2b7386e4",
                                        "entry_id": "75873c86-68f3-3db0-b619-af5f5a914876",
                                        "glosses": [
                                            "Waffe"
                                        ],
                                        "tags": [
                                            "literary",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "539e20ff-7d03-4fcf-9f0e-3bc497cbdac5",
                                                "sense_id": "1b0bcba1-de1c-3aab-9154-306c2b7386e4",
                                                "text": "„Wer jetzt die Wehr ergreift, ergreift sie, mich (die Religion) zu schützen.“"
                                            },
                                            {
                                                "example_id": "9fd54f01-171d-4332-ab4d-ddbcdba0d542",
                                                "sense_id": "1b0bcba1-de1c-3aab-9154-306c2b7386e4",
                                                "text": "„Zum Gefecht wird die Wehr erhoben oder geschwungen.“"
                                            },
                                            {
                                                "example_id": "efa0f50e-ff81-4b56-9069-0036d0abb39b",
                                                "sense_id": "1b0bcba1-de1c-3aab-9154-306c2b7386e4",
                                                "text": "„Der Männer alle, so kühn sie sich mühten, / die Wehr sich keiner gewann; / Gäste kamen und Gäste gingen, / die stärksten zogen am Stahl – / keinen Zoll entwich er dem Stamm: / dort haftet schweigend das Schwert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
