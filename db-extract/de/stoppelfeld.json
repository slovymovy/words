                "senses": [
                    {
                        "sense_id": "9d3df858-35db-3740-a0da-1d9d22df4e11",
                        "entry_id": "b037cbc8-dfc0-3947-a52d-1370ac96deb2",
                        "glosses": [
                            "abgeerntetes Getreidefeld, auf dem noch die kurzen Strünke der Pflanzen stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34647dd-77d5-4cb9-9e3c-83b78fb353e5",
                                "sense_id": "9d3df858-35db-3740-a0da-1d9d22df4e11",
                                "text": "„Ein Mann, klein, kräftig, in einer braunen Jacke, läuft über ein Stoppelfeld.“"
                            },
                            {
                                "example_id": "40fa8a50-22da-43e4-99bd-7d1f54fc2575",
                                "sense_id": "9d3df858-35db-3740-a0da-1d9d22df4e11",
                                "text": "„In Jorate gingen die Sensen durchs Korn, die weißen Tücher der Binderinnen hoben und senkten sich, auf den Stoppelfeldern sammelten sich die Störche.“"
                            },
                            {
                                "example_id": "d74d17b3-77dd-4332-a803-2d4bcb359c28",
                                "sense_id": "9d3df858-35db-3740-a0da-1d9d22df4e11",
                                "text": "„In dem Augenblick, in welchem sie nach der allgemeinen Erwartung den Hasen packen musste, schlug er wieder einen Haken und sprang auf den Grenzrain zwischen der Wintersaat und dem Stoppelfelde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
