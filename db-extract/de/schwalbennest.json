                "senses": [
                    {
                        "sense_id": "439c9b93-04f9-3c4e-8583-e973dbecfe98",
                        "entry_id": "dc396480-01aa-3ca9-9043-4d7903425683",
                        "glosses": [
                            "der Bau von Schwalben, in dem sie ihre Eier ablegen und ausbrüten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cbb8fd2-c879-4a00-9fb8-2cb457464eb7",
                                "sense_id": "439c9b93-04f9-3c4e-8583-e973dbecfe98",
                                "text": "Im Pferdestall befinden sich mehrere Schwalbennester."
                            },
                            {
                                "example_id": "2b940007-712a-4cde-8008-742f198b2879",
                                "sense_id": "439c9b93-04f9-3c4e-8583-e973dbecfe98",
                                "text": "„Da die Weibchen wählerisch sind, sucht jedes Männchen verschiedene Nistplätze aus: zwischen Wurzeln, im Gebüsch, in einem Holzstoß, zwischen Mauersteinen, am Bachufer, im Efeu einer Hauswand, unter der Dachtraufe, im Gebälk eines Stalles, im leeren Schwalbennest oder in der Nestunterlage eines Weißstorchpaares auf dem Scheunendach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
