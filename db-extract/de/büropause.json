                "senses": [
                    {
                        "sense_id": "f9193e6b-fdf6-3e22-9389-43e17bc9ea84",
                        "entry_id": "85672608-153f-30aa-89da-dc036c1cac95",
                        "glosses": [
                            "Arbeitspause von Angestellten in einem Büro"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b750670b-33c1-430f-afe5-dd2840d5c705",
                                "sense_id": "f9193e6b-fdf6-3e22-9389-43e17bc9ea84",
                                "text": "„Irgendwann kurz nach dem ersten Septemberwochenende ist der ganz große Rummel schlagartig wieder vorbei: Spanien ist wieder bei der Arbeit, und in den Chiringuitos ist nur noch in der Büropause während der mittäglichen Siesta und an den Wochenenden etwas los.“"
                            },
                            {
                                "example_id": "abed5ca9-bfa9-4eea-bc4b-9d809e3ace3e",
                                "sense_id": "f9193e6b-fdf6-3e22-9389-43e17bc9ea84",
                                "text": "„Man sieht dort Mädchencliquen, Kumpels, die während der Büropause gemeinsam essen wollen, oder auch Familien.“"
                            },
                            {
                                "example_id": "9366e5d1-7eb7-4c33-a18b-960fb48c9b9f",
                                "sense_id": "f9193e6b-fdf6-3e22-9389-43e17bc9ea84",
                                "text": "„Nichts trinkt der Deutsche so gerne wie Kaffee. Dazu womöglich ein Schuss Milch, vielleicht auch noch ein, zwei Löffel Zucker, fertig ist der Trunk zum Frühstück, für die Büropause zwischendurch, für unterwegs oder für das österliche Familien-Kränzchen.“"
                            },
                            {
                                "example_id": "43639798-f039-4fc8-8580-5b7787afb9c6",
                                "sense_id": "f9193e6b-fdf6-3e22-9389-43e17bc9ea84",
                                "text": "„Wer sich in der Straßenbahn oder in den Büropausen die Zeit vertreiben will, braucht etwas Handliches, das er bei sich tragen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
