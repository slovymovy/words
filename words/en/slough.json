{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1fe40155-edd5-3895-800c-d4b25b91af4d",
                    "sense_definition": "A muddy, boggy, or marshy area of land.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wetland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy rain turned the dirt road into a muddy <w>slough</w>.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь превратил грунтовую дорогу в грязную <w>трясину</w>."
                            }
                        },
                        {
                            "text": "They had to pull the tractor out of a deep <w>slough</w> in the field.",
                            "target_lang_translations": {
                                "ru": "Им пришлось вытаскивать трактор из глубокой <w>топи</w> на поле."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трясина, болотистое или топкое место, грязь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трясина",
                                "target_lang_sense_clarification": "топкое болотистое место"
                            },
                            {
                                "target_lang_word": "топь",
                                "target_lang_sense_clarification": "болото, зыбкое место"
                            },
                            {
                                "target_lang_word": "грязь",
                                "target_lang_sense_clarification": "вязкая слякоть, распутица"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78a428b1-a891-3e73-8be4-3e6af60bd008",
                    "sense_definition": "A swamp, shallow backwater, or sluggish channel branching from a river.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wetland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We paddled our canoe slowly under the trees through the quiet <w>slough</w>.",
                            "target_lang_translations": {
                                "ru": "Мы медленно вели каноэ под деревьями по тихой <w>старице</w>."
                            }
                        },
                        {
                            "text": "Migratory birds often feed in the protected waters of the <w>slough</w>.",
                            "target_lang_translations": {
                                "ru": "Перелётные птицы часто кормятся в защищённых водах этого <w>затона</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "principally North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Болотистый затон, старица или медленно текущая речная протока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старица",
                                "target_lang_sense_clarification": "старое русло реки"
                            },
                            {
                                "target_lang_word": "затон",
                                "target_lang_sense_clarification": "неглубокий речной рукав или заводь"
                            },
                            {
                                "target_lang_word": "протока",
                                "target_lang_sense_clarification": "медленный болотистый рукав"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "835a01a5-e82c-31de-9b01-b28782459aab",
                    "sense_definition": "A secondary tidal channel in a river delta.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wetland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The delta contains a winding <w>slough</w> that is flushed regularly by the tide.",
                            "target_lang_translations": {
                                "ru": "В дельте есть извилистая <w>протока</w>, регулярно промываемая приливом."
                            }
                        },
                        {
                            "text": "Local fishers often navigate through the <w>slough</w> during high water.",
                            "target_lang_translations": {
                                "ru": "Местные рыбаки часто ходят на лодках по этой <w>протоке</w> во время половодья."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Второстепенная приливная протока или рукав в дельте реки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приливная протока",
                                "target_lang_sense_clarification": "рукав дельты, подверженный приливам"
                            },
                            {
                                "target_lang_word": "рукав",
                                "target_lang_sense_clarification": "ответвление реки в дельте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8bd8c22-45d6-365b-88e0-5a75ea0e5586",
                    "sense_definition": "A small wetland pond, especially one formed by glacial potholes on the plains.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wetland",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each glacial <w>slough</w> across the prairie supports vital nesting waterfowl.",
                            "target_lang_translations": {
                                "ru": "Каждое ледниковое <w>болотце</w> в прерии служит важным местом гнездования водоплавающих птиц."
                            }
                        },
                        {
                            "text": "The alkaline water of the <w>slough</w> evaporated under the hot summer sun.",
                            "target_lang_translations": {
                                "ru": "Щелочная вода <w>озерца</w> испарилась под жарким летним солнцем."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "North American"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой заболоченный водоём или озерцо на равнине, обычно ледникового происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болотце",
                                "target_lang_sense_clarification": "небольшое степное или равнинное озерцо"
                            },
                            {
                                "target_lang_word": "мочажина",
                                "target_lang_sense_clarification": "влажная низина или лужа в прерии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8b8624c-baf6-3b4d-857a-44d535e70a69",
                    "sense_definition": "The dead outer skin shed by a snake or other reptile.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "skin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We found the dry <w>slough</w> of a rattlesnake resting on the stone path.",
                            "target_lang_translations": {
                                "ru": "На каменной дорожке мы нашли сухой <w>выползок</w> гремучей змеи."
                            }
                        },
                        {
                            "text": "The reptile emerged shiny and bright after casting off its old <w>slough</w>.",
                            "target_lang_translations": {
                                "ru": "Рептилия стала блестящей и яркой после того, как сбросила свою старую <w>кожу</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Омертвевшая кожа, сброшенная змеёй или другой рептилией при линьке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выползок",
                                "target_lang_sense_clarification": "сброшенная змеиная кожа"
                            },
                            {
                                "target_lang_word": "выползина",
                                "target_lang_sense_clarification": "кожа, сброшенная при линьке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a513a5ae-1e6b-3ed9-b973-67ba022d73ff",
                    "sense_definition": "A mass of dead tissue that separates from living skin on a wound or sore.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "skin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon carefully removed the thick yellow <w>slough</w> covering the ulcer.",
                            "target_lang_translations": {
                                "ru": "Хирург осторожно удалил плотный жёлтый <w>струп</w>, покрывавший язву."
                            }
                        },
                        {
                            "text": "Healing slowed until the wound bed was completely cleared of necrotic <w>slough</w>.",
                            "target_lang_translations": {
                                "ru": "Заживление замедлилось, пока дно раны не было полностью очищено от омертвевших <w>струпьев</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слой омертвевшей ткани, отторгающийся от живой кожи на ране или язве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "струп",
                                "target_lang_sense_clarification": "некротическая корка или отторгающаяся ткань"
                            },
                            {
                                "target_lang_word": "короста",
                                "target_lang_sense_clarification": "засохшая корка на ране"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d219e5e-ccde-3fbc-804d-4091fe29a993",
                    "sense_definition": "A state of deep dejection or lingering depression.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He struggled for weeks to pull himself out of that dark emotional <w>slough</w>.",
                            "target_lang_translations": {
                                "ru": "Он неделями изо всех сил пытался выбраться из этой тёмной душевной <w>трясины</w>."
                            }
                        },
                        {
                            "text": "The prolonged economic crisis plunged the entire town into a <w>slough</w> of despair.",
                            "target_lang_translations": {
                                "ru": "Затяжной экономический кризис поверг весь город в <w>пучину</w> отчаяния."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние глубокого уныния, подавленности или затяжной депрессии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавленность",
                                "target_lang_sense_clarification": "тяжёлое угнетённое состояние"
                            },
                            {
                                "target_lang_word": "пучина",
                                "target_lang_sense_clarification": "перен. бездна или омут тоски и отчаяния"
                            },
                            {
                                "target_lang_word": "омут",
                                "target_lang_sense_clarification": "перен. глубокая печаль, уныние"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b07452e1-5d02-3b56-aea4-c7080ac8982c",
                    "sense_definition": "To cast off or shed an outer layer, such as skin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Snakes regularly <w>slough</w> their skin as they grow larger.",
                            "target_lang_translations": {
                                "ru": "Змеи регулярно <w>сбрасывают</w> кожу по мере роста."
                            }
                        },
                        {
                            "text": "The body began to <w>slough</w> the dead tissue after the burn.",
                            "target_lang_translations": {
                                "ru": "Организм начал <w>отторгать</w> омертвевшую ткань после ожога."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбрасывать наружный слой, например кожу или омертвевшую ткань."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбрасывать",
                                "target_lang_sense_clarification": "кожу при линьке, отмершие слои"
                            },
                            {
                                "target_lang_word": "сбросить",
                                "target_lang_sense_clarification": "лишиться старой кожи или ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "934e251c-6e98-349d-8170-7b027775561b",
                    "sense_definition": "To separate, drop off, or crumble away as an outer layer.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "shed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wet soil began to <w>slough</w> from the hillside after the torrential rain.",
                            "target_lang_translations": {
                                "ru": "Влажная земля начала <w>оползать</w> со склона холма после проливного дождя."
                            }
                        },
                        {
                            "text": "Damaged skin will naturally <w>slough</w> away during the healing process.",
                            "target_lang_translations": {
                                "ru": "Повреждённая кожа будет естественным образом <w>сходить</w> в процессе заживления."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отслаиваться, опадать, шелушиться или осыпаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходить",
                                "target_lang_sense_clarification": "отслаиваться о коже, грунте"
                            },
                            {
                                "target_lang_word": "отслаиваться",
                                "target_lang_sense_clarification": "отделяться пластами или кусочками"
                            },
                            {
                                "target_lang_word": "осыпаться",
                                "target_lang_sense_clarification": "падать пластами, например об оползающей земле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd4a1d53-6f23-3b6d-8907-8ab739bca69c",
                    "sense_definition": "To discard an unwanted card, especially when unable to follow suit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Having no trumps left in hand, she chose to <w>slough</w> a low diamond.",
                            "target_lang_translations": {
                                "ru": "Не имея больше козырей на руках, она решила <w>сбросить</w> младшую бубну."
                            }
                        },
                        {
                            "text": "The defender decided to <w>slough</w> an irrelevant club on that trick.",
                            "target_lang_translations": {
                                "ru": "Защитник решил <w>скинуть</w> ненужную трефу на этой взятке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбрасывать ненужную карту в карточной игре, особенно при отсутствии масти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбрасывать",
                                "target_lang_sense_clarification": "избавляться от карты не в масть"
                            },
                            {
                                "target_lang_word": "сбросить",
                                "target_lang_sense_clarification": "положить ненужную карту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3ccf2792-f744-35db-872b-7a01f036162f",
                    "sense_definition": "To skip school or play truant without permission.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teenagers decided to <w>slough</w> their afternoon science class to go to the mall.",
                            "target_lang_translations": {
                                "ru": "Подростки решили <w>прогулять</w> дневной урок естествознания и пойти в торговый центр."
                            }
                        },
                        {
                            "text": "He got caught trying to <w>slough</w> morning lessons behind the gym.",
                            "target_lang_translations": {
                                "ru": "Его поймали, когда он пытался <w>прогулять</w> утренние уроки за спортзалом."
                            }
                        }
                    ],
                    "synonyms": [
                        "ditch"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "regional"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прогуливать школу или занятия без разрешения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогуливать",
                                "target_lang_sense_clarification": "не ходить на уроки"
                            },
                            {
                                "target_lang_word": "прогулять",
                                "target_lang_sense_clarification": "пропустить занятие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "020497f5-e059-331d-9d6f-d956554894d0",
                    "sense_definition": "A large town and borough in Berkshire, England, located west of London.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Many major companies keep their regional offices in <w>Slough</w>.",
                            "target_lang_translations": {
                                "ru": "Многие крупные компании держат свои региональные офисы в <w>Слау</w>."
                            }
                        },
                        {
                            "text": "The train makes a brief stop in <w>Slough</w> before reaching central London.",
                            "target_lang_translations": {
                                "ru": "Поезд делает короткую остановку в <w>Слау</w>, прежде чем прибыть в центр Лондона."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупный город в графстве Беркшир, Англия, расположенный к западу от Лондона."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Слау",
                                "target_lang_sense_clarification": "город в Великобритании"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}