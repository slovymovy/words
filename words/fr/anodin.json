                {
                    "sense_id": "d41d694b-d2ac-390f-9d69-1a00baeb7577",
                    "sense_definition": "Qui manque d'intérêt, de force ou de saveur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "qualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur nous livre une pièce plutôt <w>anodine</w> qui ne parvient jamais à captiver son public."
                        },
                        {
                            "text": "Le critique a qualifié ces poèmes de vers <w>anodins</w> et totalement dénués d'émotion."
