                        ],
                        "form": "plenums"
                    },
                    {
                        "form_id": "7f03dad9-bcd9-4595-b9f2-ed6ef285d887",
                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                        "tags": [
                            "plural"
                        ],
                        "form": "plena"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b05330dd-a7b0-391b-b203-95e82cf9ff4a",
                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                        "glosses": [
                            "A space that is completely filled with matter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c19f28-502b-4b86-8e61-908e1e9a5a40",
                                "sense_id": "b05330dd-a7b0-391b-b203-95e82cf9ff4a",
                                "text": "The idea was that a thing could only move into an empty place, and that, in a plenum, there are no empty places."
                            },
                            {
                                "example_id": "265cce1d-703b-43ed-850d-13fda4268ea9",
                                "sense_id": "b05330dd-a7b0-391b-b203-95e82cf9ff4a",
                                "text": "The key to understanding medieval interpretations of motion in hypothetically void space is to realize that medieval natural philosophers analyzed the same bodies in the void that they discussed in the plenum of their ordinary world."
                            }
                        ]
                    },
                    {
                        "sense_id": "522ef952-ae26-3049-8221-500329e9f959",
                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                        "glosses": [
                            "A state of fullness, a great quantity (of something)."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "22ec0962-d8d4-4ba5-b049-308a746b12b0",
                                "sense_id": "522ef952-ae26-3049-8221-500329e9f959",
                                "text": "He lay on the long stone slant down to the slapping waves, his denim shorts, sneakers, and socks under his head for a pillow, feeling the splendour of distance in all directions, the liquid silence, the plenum of aloneness."
                            }
                        ]
                    },
                    {
                        "sense_id": "48e6b077-8942-34f5-ac76-fe807e5b4645",
                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                        "glosses": [
                            "A legislative meeting (especially of the Communist Party) in which all members are present."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "451c0fc7-d487-3c91-ba14-19273cdff5cc",
                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                        "glosses": [
                            "An enclosed space having greater than atmospheric pressure."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c3fa8e73-4d00-3e34-9486-23f64f21a255",
                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                        "glosses": [
                            "The space above a false ceiling used for cables, ducts etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6f6be2f1-3fbf-3dd1-89e9-82cdada1111a",
                        "entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                        "glosses": [
                            "A type of network cabling which satisfies plenum-ratings issued by the National Electrical Code. These cables produce less smoke and fumes in the event of fire."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e86d6d0-3e55-477f-8c62-f002ca5b338b",
                        "source_entry_id": "5a3b1db3-d303-3bb5-8d05-61c81d6e3abf",
                        "source_sense_description": "a state of fullness, a great quantity (of something)",
                        "target_lang_word": "полнота́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "полнота́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1cbd88b5-557e-3e7d-b3c1-b849a27e32bb",
                                        "entry_id": "218220eb-ff28-3ba3-8e72-d0335bc8a8f7",
                                        "glosses": [
                                            "свойство по значению прилагательного полный; наполненность, достаточное наличие чего-либо; полная мера, полный состав, предельное количество || исчерпанность, обстоятельность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ede76f2-25a1-40e4-90a1-0bdeba5ed186",
                                                "sense_id": "1cbd88b5-557e-3e7d-b3c1-b849a27e32bb",
                                                "text": "По роже видно, что для полноты её счастья не хватает только присутствия в ящике «его», отца её детей, которому она так беззаветно отдалась!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ec57a6b-6c16-3d9f-8de2-432cf4861c03",
                                        "entry_id": "218220eb-ff28-3ba3-8e72-d0335bc8a8f7",
                                        "glosses": [
                                            "наличие разнообразия, множества свойств в чём-либо; насыщенность, содержательность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "446ced9b-56c1-462a-a3f7-c436c274aadb",
                                                "sense_id": "2ec57a6b-6c16-3d9f-8de2-432cf4861c03",
                                                "text": "Так как от невежества мы ушли, но к цивилизации, слава богу, ещё не дошли, а обретаемся на золотой середине, то этот языческий праздник сохранился и до нашего времени во всей своей полноте."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "348d61c4-ec4e-3160-a24a-4aec3e5e2659",
                                        "entry_id": "218220eb-ff28-3ba3-8e72-d0335bc8a8f7",
                                        "glosses": [
                                            "тучность, толщина тела"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7f02157-6697-4aeb-87ff-cf9a3f239211",
                                                "sense_id": "348d61c4-ec4e-3160-a24a-4aec3e5e2659",
                                                "text": "Как он ни разглядывал её, как ни пытал, с какой стороны ни заходил, а всё видел пока только, что Марфенька была свежая, белокурая, здоровая, склонная к полноте девушка, живая и весёлая."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de63e3d6-e338-3fca-b8c7-31d43de510c2",
                                        "entry_id": "218220eb-ff28-3ba3-8e72-d0335bc8a8f7",
                                        "glosses": [
                                            "округлость, пышность какой-либо части тела"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70d5535d-2940-4bd4-8354-0f8f781b2274",
                                                "sense_id": "de63e3d6-e338-3fca-b8c7-31d43de510c2",
                                                "text": "Полнота и свежесть щёк её и пышность груди подтверждали обещание насчёт детей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33103c20-45e3-327e-b133-6911dc2cf953",
                                        "entry_id": "218220eb-ff28-3ba3-8e72-d0335bc8a8f7",
                                        "glosses": [
                                            "спец. характеристика размера одежды по объёму"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c4eca22-5faf-3e76-a26a-83d5eed679b0",
                                        "entry_id": "218220eb-ff28-3ba3-8e72-d0335bc8a8f7",
                                        "glosses": [
                                            "спец. характеристика размера обуви по ширине стопы"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
