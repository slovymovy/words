                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b2e2a8a-470f-4344-a330-6275598625ba",
                                "sense_id": "48e77582-a2ae-37e9-afd3-93ff806e2271",
                                "text": "Podczas kontroli biletów zorientowałam się, że zapomniałam migawki."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "15fa17f0-7e7a-3f1f-a761-2ee0056bde5a",
                        "entry_id": "fc3dd49b-cd9f-3c41-9db5-b45606368069",
