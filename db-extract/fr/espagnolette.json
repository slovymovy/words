        "fr-extract.jsonl": [
            {
                "entry_id": "b12d1ccb-eca2-378e-b467-4ad36625f500",
                "word": "espagnolette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3f87dc58-dc9b-4a74-8aa0-cec395680c63",
                        "entry_id": "b12d1ccb-eca2-378e-b467-4ad36625f500",
                        "tags": [
                            "plural"
                        ],
                        "form": "espagnolettes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b72fd8d-d01b-3b42-8bee-9db371d51f2c",
                        "entry_id": "b12d1ccb-eca2-378e-b467-4ad36625f500",
                        "glosses": [
                            "Ferrure à poignée tournante servant à fermer et à ouvrir les châssis d’une fenêtre."
                        ],
                        "tags": [
                            "Serrurerie"
                        ],
                        "examples": [
                            {
                                "example_id": "d5341d78-c777-45f3-b619-95838d8a918b",
                                "sense_id": "0b72fd8d-d01b-3b42-8bee-9db371d51f2c",
                                "text": "Les malles allaient être faites, lorsqu’il voulut rouvrir un volet, que le vent venait de rabattre ; mais, par la fenêtre entrebâillée, ce fut un tel engouffrement, qu’elle dut accourir à son secours. Ils pesèrent de tout leur poids, ils purent enfin tourner l’espagnolette."
                            },
                            {
                                "example_id": "259304f0-2480-461a-ae77-efc4433bacad",
                                "sense_id": "0b72fd8d-d01b-3b42-8bee-9db371d51f2c",
                                "text": "Depuis une demi-heure je me trempais jusqu’aux os d’une radée qui ne décessait pas, quand j’entends le bruit d’une espagnolette."
                            },
                            {
                                "example_id": "1f67880a-133b-4a24-bf13-8110f6a3cd60",
                                "sense_id": "0b72fd8d-d01b-3b42-8bee-9db371d51f2c",
                                "text": "À peine avait-il eu le temps de se refourrer dans sa cachette d’ombre, que l’espagnolette de la fenêtre grinça, puis celle de la persienne, qui s’ouvrit toute grande."
                            },
                            {
                                "example_id": "dcaaead0-e49c-4018-bc4d-f7369b7ff5df",
                                "sense_id": "0b72fd8d-d01b-3b42-8bee-9db371d51f2c",
                                "text": "Il rentra son revolver et tourna l’espagnolette de la fenêtre."
                            },
                            {
                                "example_id": "984c6c87-93dd-4e80-8950-f6095ba73934",
                                "sense_id": "0b72fd8d-d01b-3b42-8bee-9db371d51f2c",
                                "text": "Le machin en fer où s’enfonce la tige de l’espagnolette lui tient lieu d’enclume, et d’enclume bien commode, même, grâce au trou qu’il y a au milieu."
                            }
                        ]
                    },
                    {
                        "sense_id": "b7bb73f3-5c00-3aff-8847-86207b4c3df1",
                        "entry_id": "b12d1ccb-eca2-378e-b467-4ad36625f500",
                        "glosses": [
                            "Sorte de ratine fine, anciennement fabriquée en Espagne, qui a été imitée en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "409f9d7a-4e27-421c-843c-2d6e020c580b",
                                "sense_id": "b7bb73f3-5c00-3aff-8847-86207b4c3df1",
                                "text": "L’espagnolette est l’étoffe des redingotes et des manteaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e9960a2-6ecb-33fd-be7b-45e66609cf78",
                        "entry_id": "b12d1ccb-eca2-378e-b467-4ad36625f500",
                        "glosses": [
                            "Jeune fille espagnole."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fcf6ffd2-fbe7-4a3f-8559-5be3dd58ed52",
                                "sense_id": "7e9960a2-6ecb-33fd-be7b-45e66609cf78",
                                "text": "Comment, petite espagnolette, ne savez-vous pas que nous avons condamné à la déportation tous les saints et toutes les saintes du paradis ?"
                            }
                        ]
                    }
