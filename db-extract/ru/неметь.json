                "senses": [
                    {
                        "sense_id": "d4409165-e52a-33ae-8184-01fd92d8030c",
                        "entry_id": "24aaea24-83e2-3e93-a134-9388929090e9",
                        "glosses": [
                            "терять способность говорить, становиться немым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff89c649-629e-4756-8f99-3f574f02cc39",
                                "sense_id": "d4409165-e52a-33ae-8184-01fd92d8030c",
                                "text": "Люди начинали неметь в странных обстоятельствах."
                            }
                        ]
                    },
                    {
                        "sense_id": "aeee2383-42af-3a1f-8625-f7e4a95b006d",
                        "entry_id": "24aaea24-83e2-3e93-a134-9388929090e9",
                        "glosses": [
                            "перен. терять дар речи, умолкать, застывать в молчании от восторга или страха"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84820a7d-07f2-4f27-aaeb-6c27eb5270d3",
                                "sense_id": "aeee2383-42af-3a1f-8625-f7e4a95b006d",
                                "text": "Обязанность для меня дело священное, закон — я немею перед законом."
                            }
                        ]
                    },
                    {
                        "sense_id": "6571456c-3f56-36d4-8718-be12e3ac7084",
                        "entry_id": "24aaea24-83e2-3e93-a134-9388929090e9",
                        "glosses": [
                            "утрачивать чувствительность"
                        ],
                        "tags": [
                            "о предмете, части тела"
                        ],
                        "examples": [
                            {
                                "example_id": "4b90ef66-cc89-4acc-b366-e3244189aba0",
                                "sense_id": "6571456c-3f56-36d4-8718-be12e3ac7084",
                                "text": "Его члены сладко немеют от наступившего сна."
                            },
                            {
                                "example_id": "fd6f6131-5b44-4f81-845a-278106215c56",
                                "sense_id": "6571456c-3f56-36d4-8718-be12e3ac7084",
                                "text": "Пальцы от холода немеют."
                            }
                        ]
                    }
                ],
