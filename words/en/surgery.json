{
    "word_family": [
        "surgeon",
        "surgical",
        "surgically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "138140ba-0ed0-36e7-a7b9-a04f559547b5",
                    "sense_definition": "A medical procedure involving incisions to remove, repair, or replace a part of a body.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medical_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor said that <w>surgery</w> is the only option to fix his injured knee.",
                            "target_lang_translations": {
                                "ru": "Врач сказал, что <w>операция</w> — единственный вариант вылечить его травмированное колено.",
                                "zh": "医生说，做<w>手术</w>是修复他受伤膝盖的唯一选择。"
                            }
                        },
                        {
                            "text": "She is recovering well after undergoing major heart <w>surgery</w> last week.",
                            "target_lang_translations": {
                                "ru": "Она хорошо восстанавливается после перенесенной на прошлой неделе серьезной <w>операции</w> на сердце.",
                                "zh": "她上周接受了大型心脏<w>手术</w>，目前恢复得很好。"
                            }
                        }
                    ],
                    "synonyms": [
                        "operation",
                        "procedure"
                    ],
                    "common_phrases": [
                        "major surgery",
                        "minor surgery",
                        "cosmetic surgery",
                        "undergo surgery",
                        "heart surgery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медицинская процедура, включающая разрезы для удаления, восстановления или замены части тела.",
                        "zh": "一种通过切开身体部位来进行移除、修复或替换的医疗程序。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "операция",
                                "target_lang_sense_clarification": "медицинская процедура"
                            },
                            {
                                "target_lang_word": "хирургическое вмешательство",
                                "target_lang_sense_clarification": "формальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手术",
                                "target_lang_sense_clarification": "医疗程序"
                            },
                            {
                                "target_lang_word": "外科手术",
                                "target_lang_sense_clarification": "正式术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44f85e35-ce7b-36ba-a4dd-12ce043e303a",
                    "sense_definition": "The branch of medicine that deals with surgical procedures.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_field",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to specialize in <w>surgery</w> after finishing medical school.",
                            "target_lang_translations": {
                                "ru": "Он решил специализироваться на <w>хирургии</w> после окончания медицинского института.",
                                "zh": "他从医学院毕业后，决定专攻<w>外科学</w>。"
                            }
                        },
                        {
                            "text": "Advances in modern <w>surgery</w> have saved countless lives over the years.",
                            "target_lang_translations": {
                                "ru": "Достижения современной <w>хирургии</w> спасли бесчисленное количество жизней за эти годы.",
                                "zh": "多年来，现代<w>外科学</w>的进步挽救了无数生命。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "general surgery",
                        "plastic surgery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздел медицины, занимающийся хирургическими процедурами.",
                        "zh": "医学中专门研究外科手术的分支学科。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хирургия",
                                "target_lang_sense_clarification": "область медицины"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外科学",
                                "target_lang_sense_clarification": "医学领域"
                            },
                            {
                                "target_lang_word": "外科",
                                "target_lang_sense_clarification": "医学科室"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0282e060-2d91-3d76-be5e-468156c49d80",
                    "sense_definition": "A place where a doctor or dentist treats patients; a clinic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please call the <w>surgery</w> to make an appointment with Dr. Smith.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, позвоните в <w>клинику</w>, чтобы записаться на прием к доктору Смиту.",
                                "zh": "请致电<w>诊所</w>预约史密斯医生。"
                            }
                        },
                        {
                            "text": "The dental <w>surgery</w> is closed on weekends and public holidays.",
                            "target_lang_translations": {
                                "ru": "<w>Стоматологический кабинет</w> закрыт по выходным и праздникам.",
                                "zh": "这家牙科<w>诊所</w>在周末和公共假期不营业。"
                            }
                        }
                    ],
                    "synonyms": [
                        "office"
                    ],
                    "common_phrases": [
                        "doctor's surgery",
                        "dental surgery"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где врач или стоматолог принимает пациентов; клиника или кабинет.",
                        "zh": "医生或牙医为病人看病的地方；诊所。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кабинет врача",
                                "target_lang_sense_clarification": "место приема"
                            },
                            {
                                "target_lang_word": "клиника",
                                "target_lang_sense_clarification": "медицинское учреждение"
                            },
                            {
                                "target_lang_word": "приемная",
                                "target_lang_sense_clarification": "помещение для приема"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诊所",
                                "target_lang_sense_clarification": "医疗机构"
                            },
                            {
                                "target_lang_word": "医生办公室",
                                "target_lang_sense_clarification": "医生诊室"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "686c33c4-bfa8-35c2-96a8-7ca39cdbb74a",
                    "sense_definition": "A room or department in a hospital where operations are performed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was wheeled down to the <w>surgery</w> for the emergency procedure.",
                            "target_lang_translations": {
                                "ru": "Пациента отвезли в <w>операционную</w> для проведения экстренной процедуры.",
                                "zh": "病人被推往<w>手术室</w>进行紧急处理。"
                            }
                        },
                        {
                            "text": "Only authorized medical personnel are allowed inside the <w>surgery</w>.",
                            "target_lang_translations": {
                                "ru": "Только уполномоченный медицинский персонал допускается внутрь <w>операционной</w>.",
                                "zh": "只有获得授权的医务人员才允许进入<w>手术室</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "operating room",
                        "operating theatre"
                    ],
                    "common_phrases": [
                        "in surgery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помещение или отделение в больнице, где проводятся операции.",
                        "zh": "医院内进行手术的房间或部门。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "операционная",
                                "target_lang_sense_clarification": "помещение"
                            },
                            {
                                "target_lang_word": "хирургическое отделение",
                                "target_lang_sense_clarification": "отделение больницы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手术室",
                                "target_lang_sense_clarification": "手术房间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "111cb8e1-0cb2-36a6-9812-8ad4a846d213",
                    "sense_definition": "A scheduled time when a politician meets with local people to discuss their problems.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local MP holds a <w>surgery</w> every Friday morning to listen to constituents.",
                            "target_lang_translations": {
                                "ru": "Местный депутат проводит <w>прием избирателей</w> каждую пятницу утром, чтобы выслушать их.",
                                "zh": "当地议员每周五上午都会举行<w>选民接待日</w>，倾听选民的意见。"
                            }
                        },
                        {
                            "text": "I went to the <w>surgery</w> to complain about the lack of streetlights in our area.",
                            "target_lang_translations": {
                                "ru": "Я пошел на <w>прием</w>, чтобы пожаловаться на отсутствие уличного освещения в нашем районе.",
                                "zh": "我去参加了<w>选民接待日</w>，投诉我们社区缺乏路灯的问题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold a surgery"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Запланированное время, когда политик встречается с местными жителями для обсуждения их проблем.",
                        "zh": "政客与当地民众会面讨论问题的预定时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прием избирателей",
                                "target_lang_sense_clarification": "встреча с населением"
                            },
                            {
                                "target_lang_word": "приемные часы",
                                "target_lang_sense_clarification": "время приема"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选民接待日",
                                "target_lang_sense_clarification": "政治活动"
                            },
                            {
                                "target_lang_word": "接见选民",
                                "target_lang_sense_clarification": "动词短语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41a1a55c-991a-3d5f-b99c-2781ee9cc9f5",
                    "sense_definition": "Drastic changes or corrections made to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor had to perform major <w>surgery</w> on the first draft of the book.",
                            "target_lang_translations": {
                                "ru": "Редактору пришлось выполнить серьезную <w>переработку</w> первого черновика книги.",
                                "zh": "编辑不得不对书稿初稿进行了<w>大改</w>。"
                            }
                        },
                        {
                            "text": "This old computer code needs some serious <w>surgery</w> to work with the new system.",
                            "target_lang_translations": {
                                "ru": "Этот старый компьютерный код требует серьезного <w>вмешательства</w>, чтобы работать с новой системой.",
                                "zh": "这段旧的计算机代码需要进行<w>彻底整顿</w>才能与新系统兼容。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Радикальные изменения или исправления, вносимые во что-либо.",
                        "zh": "对某事物进行的剧烈改变或修正。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капитальная переделка",
                                "target_lang_sense_clarification": "метафора"
                            },
                            {
                                "target_lang_word": "серьезное вмешательство",
                                "target_lang_sense_clarification": "метафора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大改",
                                "target_lang_sense_clarification": "彻底的修改"
                            },
                            {
                                "target_lang_word": "彻底整顿",
                                "target_lang_sense_clarification": "大幅度调整"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}