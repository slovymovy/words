                                "target_lang_sense_clarification": "suggesting a deeper meaning"
                            },
                            {
                                "target_lang_word": "telling",
                                "target_lang_sense_clarification": "revealing or effective"
                            },
                            {
                                "target_lang_word": "pregnant",
                                "target_lang_sense_clarification": "full of meaning, as in a pregnant pause"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7f333802-2200-3c25-972c-d95195d7e2e3",
                    "sense_definition": "op een manier die veel duidelijk maakt zonder woorden te gebruiken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expressie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij knikte <w>veelbetekenend</w> naar zijn vrouw die precies begreep wat hij bedoelde.",
                            "target_lang_translations": {
                                "en": "He nodded <w>knowingly</w> to his wife, who understood exactly what he meant."
                            }
                        },
                        {
                            "text": "De trein begon <w>veelbetekenend</w> af te remmen toen we het station naderden.",
                            "target_lang_translations": {
                                "en": "The train began to slow down <w>significantly</w> as we approached the station."
                            }
                        }
                    ],
                    "synonyms": [
                        "betekenisvol",
                        "sprekend"
                    ],
                    "common_phrases": [
                        "veelbetekenend knikken",
                        "veelbetekenend kijken"
                    ],
                    "target_lang_definitions": {
                        "en": "In a manner that makes much clear without using words."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "meaningfully",
                                "target_lang_sense_clarification": "in a way that conveys significance"
