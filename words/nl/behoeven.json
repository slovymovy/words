                                "target_lang_sense_clarification": "to have a requirement for"
                            },
                            {
                                "target_lang_word": "call for",
                                "target_lang_sense_clarification": "to demand or necessitate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf389df9-0062-3c18-a6c9-7d957edf62b4",
                    "sense_definition": "naar eigen inzicht of volgens de persoonlijke noodzaak handelen",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "vereiste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt de software naar <w>behoeven</w> aanpassen aan je eigen wensen.",
                            "target_lang_translations": {
                                "en": "You can adjust the software <w>as needed</w> to your own wishes."
