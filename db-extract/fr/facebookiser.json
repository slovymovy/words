                "senses": [
                    {
                        "sense_id": "57978775-35ed-3d4f-bf49-a66ea7b3961d",
                        "entry_id": "8a9b93bf-598b-3f3c-9a76-04299803fc9c",
                        "glosses": [
                            "Donner à quelque chose un caractère rappelant Facebook."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b3cd316-3aae-4549-adbf-15aae5783817",
                                "sense_id": "57978775-35ed-3d4f-bf49-a66ea7b3961d",
                                "text": "Facebookiser le réseau ou le risque de tuer l'oiseau rare."
                            },
                            {
                                "example_id": "374e6c39-1e05-4a2a-9fe5-fe5485e5c019",
                                "sense_id": "57978775-35ed-3d4f-bf49-a66ea7b3961d",
                                "text": "Mais si Twitter a tendance à se « facebookiser », l'inverse est également vrai."
                            },
                            {
                                "example_id": "797fe01a-91f7-41a7-b7b0-9a59ca218564",
                                "sense_id": "57978775-35ed-3d4f-bf49-a66ea7b3961d",
                                "text": "Twitter est condamné à se \"facebookiser\" pour survivre."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe5a502b-f48b-31a8-8b54-a7e63b528df1",
                        "entry_id": "8a9b93bf-598b-3f3c-9a76-04299803fc9c",
                        "glosses": [
                            "Rechercher sur Facebook."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ba677d0-f41b-4f7e-82a4-1ba5b9a4463b",
                                "sense_id": "fe5a502b-f48b-31a8-8b54-a7e63b528df1",
                                "text": "Je l’ai googueulisé, twittorisé, facebookisé, yahootisé même...: aucune trace de lui nulle part !"
                            }
                        ]
