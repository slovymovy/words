                "senses": [
                    {
                        "sense_id": "abae4cba-3db9-3f98-81bc-4feddcf60a92",
                        "entry_id": "b20ad846-99c4-32d7-bdfe-310b9a434bf4",
                        "glosses": [
                            "(männliche) Person, welche das Wissen der Bevölkerung außerhalb des klassischen (Hoch-)Schulwesens mehrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6352481c-6cce-48da-9cdb-39a8fee17cae",
                                "sense_id": "abae4cba-3db9-3f98-81bc-4feddcf60a92",
                                "text": "„Nach dem Kunsthistoriker und Volksbildner wurden der Eduard-Leisching-Hof im 5. und die Leischinggasse im 13. und 14. Gemeindebezirk benannt.“"
                            },
                            {
                                "example_id": "6d436604-1aa8-463c-a8f5-6269ed3fe2fd",
                                "sense_id": "abae4cba-3db9-3f98-81bc-4feddcf60a92",
                                "text": "„[John Ruskin] begründete die akademische Kunstgeschichte, er war der wichtigste Kritiker der zeitgenössischen britischen Kunst jener Zeit, er wirkte als Volksbildner, Zeichenlehrer und Sozialreformer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
