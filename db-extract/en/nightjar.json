                    {
                        "translation_id": "a3344616-34d2-4b9a-b065-6ec9de2b75dd",
                        "source_entry_id": "0c7e0dd2-0591-3621-88d6-52aa7a33b24f",
                        "source_sense_id": "b1eaa59b-3e71-349a-8633-40505469ed0b",
                        "source_sense_description": "nocturnal bird of the family Caprimulgidae",
                        "target_lang_word": "engoulevent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engoulevent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d39011ba-628b-3d36-9e0f-aa0039154beb",
                                        "entry_id": "217e327a-c725-32c1-b2d4-b1207aea616f",
                                        "glosses": [
                                            "Passereau insectivore qui vole le bec largement ouvert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33b13a81-dc51-4fe7-9bd5-bf6b2b02f2c7",
                                                "sense_id": "d39011ba-628b-3d36-9e0f-aa0039154beb",
                                                "text": "C'est un engoulevent, répondit Bénédict. Il est caché dans le tronc pourri de cet arbre."
                                            },
                                            {
                                                "example_id": "7da591ce-c65a-4f09-aa99-b82aaf502958",
                                                "sense_id": "d39011ba-628b-3d36-9e0f-aa0039154beb",
                                                "text": "À trois reprises, devant Anne, rasant le sol, le bizarre oiseau qu’on nomme l’engoulevent passa. Il annonce toujours la nuit."
                                            },
                                            {
                                                "example_id": "6ccd6560-d207-4737-bb54-289c79ea7329",
                                                "sense_id": "d39011ba-628b-3d36-9e0f-aa0039154beb",
                                                "text": "Les heures de la nuit vinrent, chantées par deux loups amoureux, et par le mélancolique « Bois pourri ! Bois pourri ! » d’un engoulevent."
                                            },
                                            {
                                                "example_id": "004d5ec5-8506-4f65-86bb-d876b08f8b15",
                                                "sense_id": "d39011ba-628b-3d36-9e0f-aa0039154beb",
                                                "text": "Les enfants, ardents à terminer une partie de marelle, mêlaient leurs cris aux premiers coups de flûte de l'engoulevent."
                                            },
                                            {
                                                "example_id": "808cbd57-3d6e-40c7-ae6d-1e4c16f9cc95",
                                                "sense_id": "d39011ba-628b-3d36-9e0f-aa0039154beb",
                                                "text": "Découragé, l’engoulevent se met à redescendre en chancelant, et puis il tourne encore quatre fois dans le ciel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f186c1ee-cdbc-4c3f-bdef-bb0ab42fb658",
                        "source_entry_id": "0c7e0dd2-0591-3621-88d6-52aa7a33b24f",
                        "source_sense_id": "b1eaa59b-3e71-349a-8633-40505469ed0b",
                        "source_sense_description": "nocturnal bird of the family Caprimulgidae",
                        "target_lang_word": "Ziegenmelker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ziegenmelker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b216a3c2-ff15-3a2e-ac52-622d6cec93a6",
                                        "entry_id": "3d74cc59-25ca-3e1d-a9ad-3c2943dc172b",
                                        "glosses": [
                                            "Vertreter der Vogelgattung Caprimulgus aus der Familie der Nachtschwalben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "622a7d5e-1c0d-4945-b2ec-55e8a5581634",
                                                "sense_id": "b216a3c2-ff15-3a2e-ac52-622d6cec93a6",
                                                "text": "In Europa kommen die Ziegenmelker in zwei Arten vor."
                                            },
                                            {
                                                "example_id": "02a8f81f-b4d9-487a-b538-fbc989156662",
                                                "sense_id": "b216a3c2-ff15-3a2e-ac52-622d6cec93a6",
                                                "text": "„Am Himmel blitzten einzelne Sterne wie aus einem matten Schleier herab, vom nahen Ufer trug dann und wann ein starker Luftzug das Quaken der Frösche und den einsamen Ruf des Ziegenmelkers herüber.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "102d40a7-0dcb-3a66-a85d-ec54ddedade8",
                                        "entry_id": "3d74cc59-25ca-3e1d-a9ad-3c2943dc172b",
                                        "glosses": [
                                            "Speziell die Art Caprimulgus europaeus, ein einheimischer Vogel, mit rindenmusterartig gefärbtem Gefieder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "219f3e20-c28d-47c1-882c-7613c154e058",
                                                "sense_id": "102d40a7-0dcb-3a66-a85d-ec54ddedade8",
                                                "text": "„Am Himmel blitzten einzelne Sterne wie aus einem matten Schleier herab, vom nahen Ufer trug dann und wann ein starker Luftzug das Quaken der Frösche und den einsamen Ruf des Ziegenmelkers herüber.“"
                                            },
                                            {
                                                "example_id": "cd89901e-61d7-4740-bd0b-562e7f970774",
                                                "sense_id": "102d40a7-0dcb-3a66-a85d-ec54ddedade8",
                                                "text": "Der vor allem des Nachts zu hörende langdauernde Gesang des Ziegenmelkers, klingt schnurrend, ähnlich wie „errör“."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b303c72-fc68-4afe-ac47-1033b4aa82ca",
                        "source_entry_id": "0c7e0dd2-0591-3621-88d6-52aa7a33b24f",
                        "source_sense_id": "b1eaa59b-3e71-349a-8633-40505469ed0b",
                        "source_sense_description": "nocturnal bird of the family Caprimulgidae",
                        "target_lang_word": "Nachtschwalbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtschwalbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ceb6325c-9382-3f05-8a6d-7d3f3a3371f9",
                                        "entry_id": "01f2061b-d1ba-3346-b7fb-2b663d327925",
                                        "glosses": [
                                            "weltweit verbreitete Vogelart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25ea6776-0111-4601-9753-e3a87c65bfec",
                                                "sense_id": "ceb6325c-9382-3f05-8a6d-7d3f3a3371f9",
                                                "text": "„Die Nachtschwalben, die in jenen Stunden über den Hügeln kreisten, stießen eigentümlich erwartungsvolle Schreie aus, als rechneten sie damit, die Seele eines Sterbenden abzuholen.“"
                                            },
                                            {
                                                "example_id": "eecbb63d-447f-47b1-8343-42b718eb7594",
                                                "sense_id": "ceb6325c-9382-3f05-8a6d-7d3f3a3371f9",
                                                "text": "„Der Gesang einer Nachtschwalbe drang unheimlich aus den schwarzen Schatten entlang des schmalen, sich windenden Bachs herüber.“"
                                            },
                                            {
                                                "example_id": "e5bd38a5-5f14-493e-969b-1b94cd999989",
                                                "sense_id": "ceb6325c-9382-3f05-8a6d-7d3f3a3371f9",
                                                "text": "„Die Sonne war gerade untergegangen; im Westen dehnten sich blutrote Wolkenriffe, aus denen kleine Nachtschwalben aufstoben, als wären sie auf der Flucht vor einer Feuersbrunst am Ende der Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
