                "senses": [
                    {
                        "sense_id": "d15c2ffd-262b-3ab7-909c-4d2db4585ee4",
                        "entry_id": "a8d35906-6e65-3c98-a5c5-719564460c8f",
                        "glosses": [
                            "zur Gattung der Kiefern gehörender Nadelbaum mit typischer schirmartiger Krone; (wissenschaftlicher Name: Pinus pinea)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e0231e2-9b12-4387-a612-166a0056168c",
                                "sense_id": "d15c2ffd-262b-3ab7-909c-4d2db4585ee4",
                                "text": "„Nun saß sie in dem weitläufigen Garten unter einem Pinienbaum mit Blick auf das blau glitzernde Meer.“"
                            },
                            {
                                "example_id": "2cc1ce58-fced-40e4-8ebd-03ea5506cd88",
                                "sense_id": "d15c2ffd-262b-3ab7-909c-4d2db4585ee4",
                                "text": "„Mit aller Kraft schleppte er den Burschen fort und zerrte ihn auf einen Pinienbaum hinauf, wo er starb.“"
                            },
                            {
                                "example_id": "a2e74160-bba5-45c7-b478-6de12f870331",
                                "sense_id": "d15c2ffd-262b-3ab7-909c-4d2db4585ee4",
                                "text": "„Der Tag war schnell vorbei und in der Abendsonne unter einem schattigen Pinienbaum sprachen sie über die Liebe.“"
                            },
                            {
                                "example_id": "e71c6a53-06d5-4fed-9a22-3f8cf92076dc",
                                "sense_id": "d15c2ffd-262b-3ab7-909c-4d2db4585ee4",
                                "text": "„Doch statt Lucia eilt Nonna auf den Kinderwagen zu, der unter einem Pinienbaum steht.“"
                            },
                            {
                                "example_id": "2f5b462e-de4e-4f7e-9f7a-b0262b750013",
                                "sense_id": "d15c2ffd-262b-3ab7-909c-4d2db4585ee4",
                                "text": "„Er hielt nur einmal an, um seinen harten Schädel gegen einen Pinienbaum zu schmettern und die herunterfallenden Pinienzapfen zu fressen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
