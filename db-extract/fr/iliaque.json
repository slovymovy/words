        "fr-extract.jsonl": [
            {
                "entry_id": "941bd352-0761-3c5c-a293-374404b08557",
                "word": "iliaque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ad26caff-dae0-4e1b-9e4a-aef16394c00f",
                        "entry_id": "941bd352-0761-3c5c-a293-374404b08557",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "iliaques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92fc280d-72dd-3304-ba45-3e8cb09f86ab",
                        "entry_id": "941bd352-0761-3c5c-a293-374404b08557",
                        "glosses": [
                            "Qui a rapport aux hanches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3769f18-9afe-4f41-8cc9-2febe800b2d0",
                                "sense_id": "92fc280d-72dd-3304-ba45-3e8cb09f86ab",
                                "text": "Quelle que soit l'époque de la grossesse à laquelle on examine le ventre par la plessimétrie, on trouve presque toujours que très en dehors, une étendue plus ou moins grande des régions iliaques est occupée par le cœcum et par l’S iliaque."
                            },
                            {
                                "example_id": "5947d7b7-c732-4794-a33a-aced4b851e5e",
                                "sense_id": "92fc280d-72dd-3304-ba45-3e8cb09f86ab",
                                "text": "Os iliaques, Os des iles. ou os coxal."
                            },
                            {
                                "example_id": "5409109a-b79e-4367-b694-5465640ea454",
                                "sense_id": "92fc280d-72dd-3304-ba45-3e8cb09f86ab",
                                "text": "On appelle fosses iliaques, crête iliaque, les fosses, la crête des os iliaques."
                            },
                            {
                                "example_id": "fe6be067-7ce3-4722-8759-fb5377669ad2",
                                "sense_id": "92fc280d-72dd-3304-ba45-3e8cb09f86ab",
                                "text": "Muscle iliaque, Muscle qui sert à faire mouvoir l’os de la cuisse sur le bassin."
                            },
                            {
                                "example_id": "69cbd125-7633-4ea2-b886-100fec3083d5",
                                "sense_id": "92fc280d-72dd-3304-ba45-3e8cb09f86ab",
                                "text": "Artères iliaques, artères qui sont formées par la bifurcation de l’aorte descendante."
                            },
                            {
                                "example_id": "4a6a6241-596e-4294-b62e-72f0f625a47c",
                                "sense_id": "92fc280d-72dd-3304-ba45-3e8cb09f86ab",
                                "text": "Veines iliaques, veines qui ramènent le sang des membres inférieurs et qui par leur réunion forment la veine cave inférieure."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba8b5fe5-e85f-326f-9d28-d83e89e263c2",
                        "entry_id": "941bd352-0761-3c5c-a293-374404b08557",
                        "glosses": [
                            "Qui a rapport à l’iléus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39c528b0-0c52-4d84-9749-33a8919d7111",
                                "sense_id": "ba8b5fe5-e85f-326f-9d28-d83e89e263c2",
                                "text": "Passion iliaque."
                            }
                        ]
                    },
