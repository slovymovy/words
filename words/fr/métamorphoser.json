{
    "word_family": [
        "métamorphose",
        "métamorphique",
        "métamorphisme"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f52c9b12-3243-3f38-ae7b-c3de45b85b47",
                    "sense_definition": "Changer profondément la nature, l'aspect ou les caractéristiques de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les nouveaux travaux d'urbanisme vont <w>métamorphoser</w> la ville en un espace piétonnier moderne."
                        },
                        {
                            "text": "Une simple couche de peinture fraîche a suffi à <w>métamorphoser</w> cette vieille maison abandonnée."
                        }
                    ],
                    "synonyms": [
                        "transformer",
                        "transfigurer",
                        "modifier"
                    ],
                    "antonyms": [
                        "conserver",
                        "maintenir"
                    ],
                    "common_phrases": [
                        "métamorphoser la ville",
                        "métamorphoser le paysage"
                    ]
                },
                {
                    "sense_id": "e8ef22f3-eae1-3043-93d4-6ae48aa295d0",
                    "sense_definition": "Transformer radicalement l'apparence physique, la tenue ou le comportement d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une nouvelle coupe de cheveux et un costume élégant ont réussi à le <w>métamorphoser</w>."
                        },
                        {
                            "text": "Depuis qu'elle fait du théâtre, sa grande confiance l'a totalement <w>métamorphosée</w>."
                        }
                    ],
                    "synonyms": [
                        "transformer",
                        "changer"
                    ],
                    "common_phrases": [
                        "se métamorphoser complètement"
                    ]
                },
                {
                    "sense_id": "2d35741e-c9ea-33d6-8346-92ed903ae9d9",
                    "sense_definition": "Faire changer un être de forme corporelle par magie ou intervention divine, dans les mythes et contes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "magie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce mythe grec, Zeus décide de se <w>métamorphoser</w> en cygne pour approcher Léda."
                        },
                        {
                            "text": "La sorcière utilise sa puissante baguette pour <w>métamorphoser</w> le prince courageux en crapaud."
                        }
                    ],
                    "synonyms": [
                        "transformer",
                        "muter"
                    ],
                    "common_phrases": [
                        "se métamorphoser en animal"
                    ]
                },
                {
                    "sense_id": "857f4ec7-d174-3208-ad9a-eb49d027f4d1",
                    "sense_definition": "Faire passer un animal d'un stade larvaire à sa forme adulte lors de son développement biologique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La chenille s'enferme dans son cocon protecteur avant de se <w>métamorphoser</w> en papillon."
                        },
                        {
                            "text": "Au terme de sa croissance aquatique, la larve commence à se <w>métamorphoser</w> rapidement."
                        }
                    ],
                    "synonyms": [
                        "muer"
                    ],
                    "common_phrases": [
                        "se métamorphoser en papillon"
                    ]
                }
            ]
        }
    ]
}