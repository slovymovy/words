                        "examples": [
                            {
                                "example_id": "97008561-4a31-42b3-8e53-b57e2d0ed7fb",
                                "sense_id": "84a55769-1389-3598-a69d-075b18cb552e",
                                "text": "Profitons de l'observation : si l'universel absolu nous échappe, c'est que seule la particularité existe concrètement."
                            },
                            {
                                "example_id": "e790cd69-311c-4b75-8dd9-5e406aca7982",
                                "sense_id": "84a55769-1389-3598-a69d-075b18cb552e",
                                "text": "Le 23 juin, le vote d’une majorité de Britanniques en faveur d’une sortie de l’UE consacre la métamorphose de l’UE, en la révélant, conformément aux textes (article 50 du Traité sur l’Union), concrètement susceptible de se « désélargir »."
                            }
                        ]
