    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fc034a3e-ad6e-3a25-9e4f-b3e0f6f0641c",
                    "sense_definition": "To officially forbid an action or prohibit someone from doing something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "prohibition_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school decided to <w>ban</w> mobile phones during lessons.",
                            "target_lang_translations": {
                                "ru": "Школа решила <w>запретить</w> мобильные телефоны во время уроков.",
                                "zh": "学校决定在课堂上<w>禁止</w>使用手机。",
                                "pl": "Szkoła zdecydowała się <w>zakazać</w> używania telefonów komórkowych podczas lekcji."
                            }
                        },
                        {
                            "text": "He was <w>banned</w> from driving for two years after the accident.",
                            "target_lang_translations": {
                                "ru": "Ему <w>запретили</w> управлять автомобилем в течение двух лет после аварии.",
                                "zh": "事故发生后，他被<w>禁止</w>驾驶两年。",
                                "pl": "Po wypadku otrzymał dwuletni <w>zakaz</w> prowadzenia pojazdów."
                            }
                        }
                    ],
                    "synonyms": [
                        "forbid",
                        "prohibit",
                        "disallow",
                        "bar",
                        "outlaw"
                    ],
                    "antonyms": [
                        "allow",
                        "permit"
                    ],
                    "common_phrases": [
                        "ban from",
                        "permanently ban",
                        "effectively ban"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально запрещать действие или не разрешать кому-либо что-либо делать.",
                        "zh": "官方禁止某项行为或不准某人做某事。",
                        "pl": "Oficjalnie zabraniać jakiegoś działania lub nie pozwalać komuś na coś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрещать",
                                "target_lang_sense_clarification": "не разрешать"
                            },
                            {
                                "target_lang_word": "запретить",
                                "target_lang_sense_clarification": "совершенный вид"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "禁止",
                                "target_lang_sense_clarification": "明令不准"
                            },
                            {
                                "target_lang_word": "取缔",
                                "target_lang_sense_clarification": "明令取消或禁止"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zakazywać",
                                "target_lang_sense_clarification": "proces zabraniania"
                            },
                            {
                                "target_lang_word": "zabraniać",
                                "target_lang_sense_clarification": "nie pozwalać na coś"
                            },
                            {
                                "target_lang_word": "zbanować",
                                "target_lang_sense_clarification": "blokada użytkownika w Internecie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e1a0e10-3923-3d64-90b9-4a6429e373b7",
                    "sense_definition": "To curse or condemn someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "curse_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wizard began to <w>ban</w> his enemies with loud shouts.",
                            "target_lang_translations": {
                                "ru": "Старый волшебник начал <w>проклинать</w> своих врагов громкими криками.",
                                "zh": "老巫师大声叫喊着开始<w>诅咒</w>他的敌人。",
                                "pl": "Stary czarodziej zaczął głośno <w>przeklinać</w> swoich wrogów."
                            }
                        },
                        {
                            "text": "In the story, the witch would <w>ban</w> anyone who stole from her garden.",
                            "target_lang_translations": {
                                "ru": "В сказке ведьма <w>проклинала</w> любого, кто крал из её сада.",
                                "zh": "故事里，女巫会<w>诅咒</w>任何从她花园里偷东西的人。",
                                "pl": "W tej historii czarownica <w>przeklinała</w> każdego, kto okradał jej ogród."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": "Literary context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проклинать или осуждать кого-либо.",
                        "zh": "诅咒或谴责某人。",
                        "pl": "Rzucać klątwę lub potępiać kogoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проклинать",
                                "target_lang_sense_clarification": "насылать проклятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诅咒",
                                "target_lang_sense_clarification": "祈求鬼神降祸于人"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przeklinać",
                                "target_lang_sense_clarification": "rzucać klątwę"
                            },
                            {
                                "target_lang_word": "potępiać",
                                "target_lang_sense_clarification": "wyrażać surową dezaprobatę"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1da16db3-ac7c-392e-8024-55e09454be8a",
                    "sense_definition": "An official order that prevents something from happening or being used.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "prohibition_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government imposed a <w>ban</w> on smoking in public places.",
                            "target_lang_translations": {
                                "ru": "Правительство ввело <w>запрет</w> на курение в общественных местах.",
                                "zh": "政府颁布了公共场所的吸烟<w>禁令</w>。",
                                "pl": "Rząd wprowadził <w>zakaz</w> palenia w miejscach publicznych."
                            }
                        },
                        {
                            "text": "They called for a total <w>ban</w> on the export of these goods.",
                            "target_lang_translations": {
                                "ru": "Они призвали к полному <w>запрету</w> на экспорт этих товаров.",
                                "zh": "他们呼吁全面<w>禁止</w>这些商品的出口。",
                                "pl": "Wezwali do całkowitego <w>zakazu</w> eksportu tych towarów."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ban on",
                        "lift a ban",
                        "impose a ban",
                        "total ban"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный приказ, который предотвращает что-либо или запрещает использование чего-либо.",
                        "zh": "防止某事发生或禁止使用某物的官方命令。",
                        "pl": "Oficjalny nakaz, który uniemożliwia coś lub zabrania używania czegoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрет",
                                "target_lang_sense_clarification": "официальное ограничение"
                            },
                            {
                                "target_lang_word": "запрещение",
                                "target_lang_sense_clarification": "процесс или результат запрета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "禁令",
