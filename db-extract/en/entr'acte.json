                        "entry_id": "be6e4f45-a10e-3e39-b3c4-81c322301bd5",
                        "glosses": [
                            "An interval between two acts of a play or opera."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "db7929ff-ad4b-398e-b84d-8730c9cd068f",
                        "entry_id": "be6e4f45-a10e-3e39-b3c4-81c322301bd5",
                        "glosses": [
                            "Another performance, such as a piece of music or a dance, during this."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b09a747-c084-4d0b-9a9b-a87bf4b5973c",
                        "source_entry_id": "be6e4f45-a10e-3e39-b3c4-81c322301bd5",
                        "source_sense_description": "interval between two acts",
                        "target_lang_word": "entracte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entracte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf9fd16e-1518-34f2-ba9d-0f2ef6e8204d",
                                        "entry_id": "17594ce1-30aa-3ba6-9f02-9b9f78dc0f21",
                                        "glosses": [
                                            "Intervalle qui, dans la représentation d’une pièce de théâtre, sépare un acte d’un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93a38d30-11ce-49ce-b997-cd8913a981ef",
                                                "sense_id": "cf9fd16e-1518-34f2-ba9d-0f2ef6e8204d",
                                                "text": "Cette fois, un signe de madame Danglars indiqua clairement à Albert que la baronne désirait avoir sa visite dans l’entracte suivant."
                                            },
                                            {
                                                "example_id": "e9a9149d-a98c-4a19-a390-2afc4f14fde0",
                                                "sense_id": "cf9fd16e-1518-34f2-ba9d-0f2ef6e8204d",
                                                "text": "Une sonnette grêle informait les spectateurs que l’entracte s’achevait."
                                            },
                                            {
                                                "example_id": "cb2ab0c5-6f0b-44d5-a525-247797e578a5",
                                                "sense_id": "cf9fd16e-1518-34f2-ba9d-0f2ef6e8204d",
                                                "text": "Il y a plusieurs événements que l’on suppose s’être passés pendant les entractes."
                                            },
                                            {
                                                "example_id": "77ddb31e-24f0-4a9a-aa1e-45e0b0c250c6",
                                                "sense_id": "cf9fd16e-1518-34f2-ba9d-0f2ef6e8204d",
                                                "text": "— Les entractes d’une vie politique, d’une vie publique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "425fc925-57f2-3b5f-8ad4-a0f29f85e2ee",
                                        "entry_id": "17594ce1-30aa-3ba6-9f02-9b9f78dc0f21",
                                        "glosses": [
                                            "Intervalle qui sépare les diverses parties d’un concert, d’un spectacle quelconque."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf24fdf7-eae2-42cd-a0a1-b8cc0635dde1",
                                                "sense_id": "425fc925-57f2-3b5f-8ad4-a0f29f85e2ee",
                                                "text": "On annonça l’entracte, tous se ruèrent à nouveau dehors vers la cabane aux sucreries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15fe6098-34eb-36bf-a900-4510d279a37e",
                                        "entry_id": "17594ce1-30aa-3ba6-9f02-9b9f78dc0f21",
                                        "glosses": [
                                            "Petit spectacle qui ne fait pas partie de la pièce principale et qui se donne entre les actes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c00d6762-506e-4297-9fc0-c162ef6d90e1",
                                                "sense_id": "15fe6098-34eb-36bf-a900-4510d279a37e",
                                                "text": "Il y avait des danses pour entractes."
                                            },
                                            {
                                                "example_id": "a67670e9-0e82-4dc3-8922-5f58c9d87150",
                                                "sense_id": "15fe6098-34eb-36bf-a900-4510d279a37e",
                                                "text": "Le premier entracte était une noce de village."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9a1cce9-5375-445a-a172-4617c89fe979",
