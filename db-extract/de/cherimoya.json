                "translations": [
                    {
                        "translation_id": "64411473-a7e7-46e2-8d10-2d3155cef898",
                        "source_entry_id": "4207e2c6-9194-3357-8da0-836007f24ac0",
                        "source_sense_id": "594ecd04-b518-3c55-87b3-74d465af3edc",
                        "source_sense_description": "Botanik: ein baumförmiges Anemonengewächs",
                        "target_lang_word": "秘魯番荔枝",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4328afae-0b46-4943-a63c-759186bb2a7f",
                        "source_entry_id": "4207e2c6-9194-3357-8da0-836007f24ac0",
                        "source_sense_id": "594ecd04-b518-3c55-87b3-74d465af3edc",
                        "source_sense_description": "Botanik: ein baumförmiges Anemonengewächs",
                        "target_lang_word": "cherimoya",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cherimoya",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c04db80-1cd5-389f-a0e7-29c917787781",
                                        "entry_id": "a4aaf47f-6ed1-31d3-826d-74a82c3259eb",
                                        "glosses": [
                                            "A subtropical tree, of species Annona cherimola, native to mountainous areas of South America."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4b250ba-3cda-3dd5-98b1-8dcffaa04c11",
                                        "entry_id": "a4aaf47f-6ed1-31d3-826d-74a82c3259eb",
                                        "glosses": [
                                            "A conical fruit with white flesh from that tree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b9011e0-3b64-43cb-b38e-1f4676af721a",
                                                "sense_id": "b4b250ba-3cda-3dd5-98b1-8dcffaa04c11",
                                                "text": "To some it tastes like a pina colada without rum; to others, a cross between a strawberry and a pineapple. For natives of the Caribbean the cherimoya is a fruit that can be plucked from backyard trees for nothing."
                                            },
                                            {
                                                "example_id": "41df886b-2e3f-4a55-a9c7-031d39241168",
                                                "sense_id": "b4b250ba-3cda-3dd5-98b1-8dcffaa04c11",
                                                "text": "Mark Twain called the cherimoya \"deliciousness itself,\" though others have described this heart-shaped, fist-sized fruit with pale-green leathery skin as \"reptilian,\" like a \"fossil artichoke\" or \"the finial for a giant four-poster bed.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
