            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90e4d4c8-165a-3268-bddb-eedfd65a2a1b",
                    "sense_definition": "twee delen over een naad of lijn naar elkaar toe buigen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vouwen_actie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>vouwen</w> van papier is in Japan een echte kunstvorm.",
                            "target_lang_translations": {
                                "en": "The <w>folding</w> of paper is a true art form in Japan.",
                                "fr": "Le <w>pliage</w> du papier est un véritable art au Japon."
                            }
                        },
                        {
                            "text": "Zou je de schone was netjes willen <w>vouwen</w> en in de kast leggen?",
                            "target_lang_translations": {
                                "en": "Would you mind <w>folding</w> the clean laundry neatly and putting it in the closet?",
                                "fr": "Pourrais-tu soigneusement <w>plier</w> le linge propre et le ranger dans l'armoire ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "plooien"
                    ],
                    "antonyms": [
                        "ontvouwen",
                        "uitvouwen"
                    ],
                    "common_phrases": [
                        "papier vouwen",
                        "was vouwen",
                        "dubbelvouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "to bend two parts toward each other along a seam or line",
                        "fr": "courber ou rabattre deux parties l'une sur l'autre le long d'une ligne ou d'une pliure"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fold",
                                "target_lang_sense_clarification": "to bend material like paper or cloth"
                            },
                            {
                                "target_lang_word": "crease",
                                "target_lang_sense_clarification": "to make a fold or line in something"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "plier",
                                "target_lang_sense_clarification": "rabattre du papier, du linge, etc."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e69b8d3-c4ea-3ffd-a58b-062401d83ab1",
                    "sense_definition": "iemand met geweld meenemen of gevangenzetten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie besloot de verdachte direct te <w>vouwen</w> na de overval.",
                            "target_lang_translations": {
                                "en": "The police decided to <w>bust</w> the suspect immediately after the robbery.",
                                "fr": "La police a décidé de <w>serrer</w> le suspect immédiatement après le braquage."
                            }
                        },
                        {
                            "text": "Ze hebben die crimineel gisteravond eindelijk kunnen <w>vouwen</w>.",
                            "target_lang_translations": {
                                "en": "They were finally able to <w>nab</w> that criminal last night.",
                                "fr": "Ils ont enfin réussi à <w>coffrer</w> ce criminel hier soir."
                            }
                        }
                    ],
                    "synonyms": [
                        "arresteren",
                        "oppakken",
                        "rekenen"
                    ],
                    "antonyms": [
                        "vrijlaten"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informeel gebruik in de context van politie of criminaliteit"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to take someone by force or imprison them",
                        "fr": "arrêter quelqu'un, le coffrer de manière musclée ou par la police"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bust",
                                "target_lang_sense_clarification": "slang for arresting someone"
                            },
                            {
                                "target_lang_word": "nab",
                                "target_lang_sense_clarification": "to catch or arrest someone"
                            },
                            {
                                "target_lang_word": "arrest",
                                "target_lang_sense_clarification": "to take into police custody"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "coffrer",
                                "target_lang_sense_clarification": "argot pour incarcérer ou arrêter quelqu'un"
                            },
                            {
                                "target_lang_word": "serrer",
                                "target_lang_sense_clarification": "argot pour appréhender ou arrêter un suspect"
                            },
                            {
                                "target_lang_word": "arrêter",
                                "target_lang_sense_clarification": "mettre en état d'arrestation"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8627c8f2-4d6d-3c83-9368-d423a902ac2d",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>vouw</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zitten diepe <w>vouwen</w> in je nieuwe overhemd.",
                            "target_lang_translations": {
                                "en": "There are deep <w>creases</w> in your new shirt.",
                                "fr": "Il y a de faux <w>plis</w> marqués sur ta chemise neuve."
                            }
                        },
                        {
                            "text": "Door de vele <w>vouwen</w> was de kaart bijna onleesbaar geworden.",
                            "target_lang_translations": {
                                "en": "Because of the many <w>folds</w>, the map had become almost illegible.",
                                "fr": "À cause des nombreux <w>plis</w>, la carte était devenue presque illisible."
                            }
                        }
                    ],
                    "synonyms": [
                        "plooien"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "pluralis"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'fold'",
                        "fr": "pluriel du nom 'vouw' ; lignes ou marques formées en rabattant une surface"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "folds",
                                "target_lang_sense_clarification": "multiple bends in material"
                            },
                            {
                                "target_lang_word": "creases",
                                "target_lang_sense_clarification": "multiple lines or wrinkles in fabric or paper"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "plis",
