                    },
                    {
                        "form_id": "7b3c8d97-c3b3-4e48-bf2f-b384c14ddd4e",
                        "entry_id": "e04612e2-9c22-33d3-8696-2fe325882893",
                        "tags": [
                            "accusative",
                            "plural"
