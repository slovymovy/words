                "senses": [
                    {
                        "sense_id": "f337a28b-d488-3868-88ab-a241852a06c6",
                        "entry_id": "d35161d0-965c-39f0-8855-096ea5cf38f5",
                        "glosses": [
                            "meist seichtes, wichtigtuerisches Dahingesagtes während eines Stammtischs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ed5d6b-ef6d-4fc7-882c-4ab9e5cfb155",
                                "sense_id": "f337a28b-d488-3868-88ab-a241852a06c6",
                                "text": "„Die gesamte Sendung besteht aus einer Reproduktion der misogynen, rassistischen, LGBTQ+-feindlichen Stammtischsprüche.“"
                            },
                            {
                                "example_id": "8a244ad9-62bc-4c9e-a60a-d61e679dc2cd",
                                "sense_id": "f337a28b-d488-3868-88ab-a241852a06c6",
                                "text": "„Im Rahmen einer Lehrerfortbildung und zweier Klassenworkshops gaben sie Tipps und Tricks im Umgang mit Stammtischsprüchen an das pädagogische Personal weiter.“"
                            },
                            {
                                "example_id": "d2dca666-253c-419e-b909-45ee84f86a50",
                                "sense_id": "f337a28b-d488-3868-88ab-a241852a06c6",
                                "text": "„Wenn ich als Reaktion auf einen Stammtischspruch ausfallend werde, sehen mich die Umstehenden als Aggressor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
