                "senses": [
                    {
                        "sense_id": "9e8dee33-bd77-38c3-b262-ee75c6c0aeb6",
                        "entry_id": "a5ef2f4f-21ec-3c13-ae0c-3454dd154d87",
                        "glosses": [
                            "Straße, auf der man an Kreuzungen und Einmündungen bevorrechtigt ist, also nicht anhalten muss, um andere Verkehrsteilnehmer einbiegen oder queren zu lassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8abece2-a4e6-44f2-b46b-1b1a654f6eb4",
                                "sense_id": "9e8dee33-bd77-38c3-b262-ee75c6c0aeb6",
                                "text": "Wir folgen der Vorfahrtsstraße und fahren bis in die nächste Ortschaft."
                            },
                            {
                                "example_id": "8307436d-2917-41c7-a29c-186e67c08fce",
                                "sense_id": "9e8dee33-bd77-38c3-b262-ee75c6c0aeb6",
                                "text": "Bei der nächsten Gelegenheit verlassen wir die Vorfahrtsstraße."
                            },
                            {
                                "example_id": "ecb9a656-aed3-452d-ad8e-67276ab90775",
                                "sense_id": "9e8dee33-bd77-38c3-b262-ee75c6c0aeb6",
                                "text": "Der Fahrer fuhr auf die Vorfahrtsstraße auf, ohne den herannahenden Querverkehr zu beachten."
                            },
                            {
                                "example_id": "787512d7-c42b-4687-b048-c1617acb7151",
                                "sense_id": "9e8dee33-bd77-38c3-b262-ee75c6c0aeb6",
                                "text": "Die Verkehrsregelung in der Innenstadt wurde geändert. Die Bahnhofstraße ist nun Vorfahrtsstraße."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
