                        "entry_id": "1537da72-2d61-35e6-841a-ff0ab9b0adae",
                        "glosses": [
                            "Désigne un arbre vendu abattu, ébranché… prêt à être enlevé sur un grumier."
                        ],
                        "tags": [
                            "Exploitation forestière"
                        ],
                        "examples": [
                            {
                                "example_id": "06c99f20-10cb-4f13-8ad5-7fa68a053548",
                                "sense_id": "0e57852e-37ba-3d62-8511-05618b8f02c2",
                                "text": "Le contrat de vente porte sur des bois vendus en bloc et façonnés, à charge pour l’acheteur de les payer et de les enlever, en totalité et dans les délais convenus."
                            }
                        ]
                    }
