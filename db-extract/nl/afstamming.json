                            {
                                "example_id": "4996e25b-885c-4036-b445-373dc841ffa1",
                                "sense_id": "d739ccf3-9dfa-3ac0-a2e3-5a52cd982d5c",
                                "text": "De afstamming van de zoogdierorden is dankzij DNA-onderzoek een stuk duidelijker geworden."
