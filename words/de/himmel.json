                    ]
                },
                {
                    "sense_id": "d7a71a0e-dcef-304b-b207-177b10c61898",
                    "sense_definition": "Zeltartiger Stoffbehang oder Überdachung über einem Bett, Thron oder Altar",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ueberdachung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das antike Bett war mit einem prächtigen <w>Himmel</w> aus Seide verziert."
                        },
                        {
                            "text": "Über dem Altar spannte sich ein reich bestickter <w>Himmel</w>."
