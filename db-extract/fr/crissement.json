                "forms": [],
                "senses": [
                    {
                        "sense_id": "5ccbdf24-7cf5-32b3-9fdb-196cde2c1ce8",
                        "entry_id": "acfa014a-2498-3993-a433-c8f3e18583fa",
                        "glosses": [
                            "Vachement, tellement."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "c29b3d98-394e-4510-8027-9753096c4502",
                                "sense_id": "5ccbdf24-7cf5-32b3-9fdb-196cde2c1ce8",
                                "text": "Elle a crissement bien joué."
                            },
                            {
                                "example_id": "11aaf1c0-45e9-4162-aef6-d11623cdcb70",
                                "sense_id": "5ccbdf24-7cf5-32b3-9fdb-196cde2c1ce8",
                                "text": "« On fait semblant qu’on est revenu en arrière », avait-elle dit. Elle n’avait pas ce pouvoir, personne n’a ce pouvoir. Non seulement nous n’étions pas revenus en arrière, mais nous avions crissement fait un bond en avant."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "3d2254d2-a298-4a22-8639-ec9159a51d5c",
                        "source_entry_id": "acfa014a-2498-3993-a433-c8f3e18583fa",
                        "source_sense_ids": [
                            "5ccbdf24-7cf5-32b3-9fdb-196cde2c1ce8"
                        ],
                        "linkage_type": "synonyms",
                        "word": "câlissement"
                    }
                ]
            },
            {
                "entry_id": "698c7e98-7362-3d97-b340-4cd2c6e115cd",
