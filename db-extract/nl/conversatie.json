        "nl-extract.jsonl": [
            {
                "entry_id": "06908aa7-6879-3a1c-bbbe-71db726040bf",
                "word": "conversatie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a0f15f66-82ea-4a06-b8ad-f7758634ee9d",
                        "entry_id": "06908aa7-6879-3a1c-bbbe-71db726040bf",
                        "tags": [
                            "plural"
                        ],
                        "form": "conversaties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e16aafd-5c6a-3908-896f-937cf42f9a45",
                        "entry_id": "06908aa7-6879-3a1c-bbbe-71db726040bf",
                        "glosses": [
                            "gesprek als onderdeel van de sociale omgang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc511a61-6e25-4f9c-9e44-9290013bf17e",
                                "sense_id": "9e16aafd-5c6a-3908-896f-937cf42f9a45",
                                "text": "Het voeren van een conversatie over koetjes en kalfjes is een favoriet tijdverdrijf van oude mensen."
                            },
                            {
                                "example_id": "4fd96a61-ed8f-40d0-819b-eb9d452a15d6",
                                "sense_id": "9e16aafd-5c6a-3908-896f-937cf42f9a45",
                                "text": "Omdat Montebello, wie niets ontging, moet hebben gemerkt dat de conversatie niet wilde vlotten, begon hij uit zijn hoofd in het Frans poëzie te citeren, waarvan ik vermoedde dat het haar woorden waren."
                            },
                            {
                                "example_id": "fdbce701-66e7-4d23-8d37-4a47ff27f137",
                                "sense_id": "9e16aafd-5c6a-3908-896f-937cf42f9a45",
                                "text": "Ze wilden met hun snorkelspullen de Nijl gaan onderzoeken. Tenminste, uit opgevangen flarden van hun drukke conversatie trok hij die conclusie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90c1c9b9-7d86-401e-afa1-3195f739e475",
                        "source_entry_id": "06908aa7-6879-3a1c-bbbe-71db726040bf",
                        "source_sense_id": "9e16aafd-5c6a-3908-896f-937cf42f9a45",
                        "target_lang_word": "conversation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conversation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74cb8980-e6e7-31da-a144-dc2dbd6c9992",
                                        "entry_id": "3fc33872-8e21-3b78-bad2-38ee0f6cb37c",
                                        "glosses": [
                                            "Expression and exchange of individual ideas through talking with other people; also, a set instance or occasion of such talking."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a63777ce-53b0-4463-be05-dd42d236c520",
                                                "sense_id": "74cb8980-e6e7-31da-a144-dc2dbd6c9992",
                                                "text": "I had an interesting conversation with Nicolas yesterday about how much he's getting paid."
                                            },
                                            {
                                                "example_id": "10aec2e4-885b-4764-821c-ac43db4f76ad",
                                                "sense_id": "74cb8980-e6e7-31da-a144-dc2dbd6c9992",
                                                "text": "You need to improve conversation in foreign languages."
                                            },
                                            {
                                                "example_id": "76ec8f08-3918-4530-9dad-cc94fcdd723e",
                                                "sense_id": "74cb8980-e6e7-31da-a144-dc2dbd6c9992",
                                                "text": "Study gives strength to the mind; conversation, grace: the first apt to give stiffness, the other suppleness: one gives substance and form to the statue, the other polishes it."
                                            },
                                            {
                                                "example_id": "a189c280-0281-4f5f-a06b-26f82b159ce3",
                                                "sense_id": "74cb8980-e6e7-31da-a144-dc2dbd6c9992",
                                                "text": "M. Nioche pressed his finger-tips together and slowly raised his shoulders. “A little conversation!” / “Conversation—that’s it!” murmured Mademoiselle Noémie, who had caught the word. “The conversation of the best society.” / “Our French conversation is famous, you know,” M. Nioche ventured to continue."
                                            },
                                            {
                                                "example_id": "0e229715-e403-4e6e-a75f-6d5a47f23627",
                                                "sense_id": "74cb8980-e6e7-31da-a144-dc2dbd6c9992",
                                                "text": "When this conversation was repeated in detail within the hearing of the young woman in question, and undoubtedly for his benefit, Mr. Trevor threw shame to the winds and scandalized the Misses Brewster then and there by proclaiming his father to have been a country storekeeper."
                                            },
                                            {
                                                "example_id": "ad0fd75b-d2b2-40cb-b980-bf274a01cf95",
                                                "sense_id": "74cb8980-e6e7-31da-a144-dc2dbd6c9992",
                                                "text": "All this was extraordinarily distasteful to Churchill.[…]Never before had he felt such repulsion when the vicar displayed his characteristic bluntness or coarseness of speech. In the present connexion—or rather as a transition from the subject that started their conversation—such talk had been distressingly out of place."
                                            },
                                            {
                                                "example_id": "4cc36a53-f9d0-4247-8b09-b87bdda9f25e",
                                                "sense_id": "74cb8980-e6e7-31da-a144-dc2dbd6c9992",
                                                "text": "A little less conversation, a little more action please / All this aggravation ain't satisfactioning me"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4f6c1c9-e5c3-3a06-843f-3240f167fe8b",
                                        "entry_id": "3fc33872-8e21-3b78-bad2-38ee0f6cb37c",
                                        "glosses": [
                                            "The back-and-forth play of the blades in a bout."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa1235de-ed73-3b98-b80a-1d52a50162f9",
                                        "entry_id": "3fc33872-8e21-3b78-bad2-38ee0f6cb37c",
                                        "glosses": [
                                            "The protocol-based interaction between systems processing a transaction."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db01bc82-dce8-3d3b-8150-2ec38456ec19",
                                        "entry_id": "3fc33872-8e21-3b78-bad2-38ee0f6cb37c",
                                        "glosses": [
                                            "Interaction; commerce or intercourse with other people; dealing with others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92ab24d5-3648-49f5-8c8f-fa4a3a413d0b",
                                                "sense_id": "db01bc82-dce8-3d3b-8150-2ec38456ec19",
                                                "text": "Yt chaunſed thatt a whole yere they had their converſacion with the congregacion there / and taught moche people in ſomoche thatt the diſciples off Antioche wer the fyrſt that wer called Chriſten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06edbe70-8344-3ada-9fa8-0356c18e3314",
                                        "entry_id": "3fc33872-8e21-3b78-bad2-38ee0f6cb37c",
                                        "glosses": [
                                            "Behaviour, the way one conducts oneself; a person's way of life."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d235de2-5129-4dc5-a0ed-d59c1a5de5d4",
                                                "sense_id": "06edbe70-8344-3ada-9fa8-0356c18e3314",
                                                "text": "Let your conversation be without covetousness; and be content with such things as ye have: for he hath said, I will never leave thee, nor forsake thee."
                                            },
                                            {
                                                "example_id": "e88cbf1b-faff-4e83-9e37-b014527fe7d1",
                                                "sense_id": "06edbe70-8344-3ada-9fa8-0356c18e3314",
                                                "text": "There are many that take no heed what happeneth to others by bad conversation, and therefore overthrow themselves in the same manner through their own fault, not foreseeing dangers manifest."
                                            },
                                            {
                                                "example_id": "9ab9575e-b205-477f-b018-b0e034f118be",
                                                "sense_id": "06edbe70-8344-3ada-9fa8-0356c18e3314",
                                                "text": "I have desired him to inquire after Lovelace's life and conversation in town."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f8e8d09-8126-3523-97ca-f0bc5f86f370",
                                        "entry_id": "3fc33872-8e21-3b78-bad2-38ee0f6cb37c",
                                        "glosses": [
                                            "Sexual intercourse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a4dc175-5e30-448f-8571-a893d2e3510a",
                                                "sense_id": "9f8e8d09-8126-3523-97ca-f0bc5f86f370",
                                                "text": "criminal conversation"
                                            },
                                            {
                                                "example_id": "6aac3daf-bad2-42b3-bcd2-d0719a6af827",
                                                "sense_id": "9f8e8d09-8126-3523-97ca-f0bc5f86f370",
                                                "text": "Ariadne[…]quitted her Lover Theseus, for the tumultuous Conversation of Bacchus."
                                            },
                                            {
                                                "example_id": "1cb26327-2cb7-4467-a3e2-58a969e85dbc",
                                                "sense_id": "9f8e8d09-8126-3523-97ca-f0bc5f86f370",
                                                "text": "Our travellers had happened to take up their residence at a house of exceeding good repute, whither Irish ladies of strict virtue, and many northern lasses of the same predicament, were accustomed to resort in their way to Bath. The landlady therefore would by no means have admitted any conversation of a disreputable kind to pass under her roof. Indeed, so foul and contagious are all such proceedings, that they contaminate the very innocent scenes where they are committed, and give the name of a bad house, or of a house of ill repute, to all those where they are suffered to be carried on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0b68cf3-0df9-39a2-a6c1-732a0deda50e",
                                        "entry_id": "3fc33872-8e21-3b78-bad2-38ee0f6cb37c",
                                        "glosses": [
                                            "Engagement with a specific subject, idea, field of study etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d309e325-5f70-4d7c-85e2-2e3f1cd89d35",
                                                "sense_id": "a0b68cf3-0df9-39a2-a6c1-732a0deda50e",
                                                "text": "So grosse is our conuersation, and dull is our apprehension: while mortall Sense, in vs, ruleth the common wealth of our litle world."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conversation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "329cbf5e-1b97-3027-8544-f809d8fe962d",
                                        "entry_id": "35a249e9-fe8e-3ef3-a0d8-f7b2a3f2b572",
                                        "glosses": [
                                            "To engage in conversation (with)."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c56bef1-3ac9-425f-ad66-39418ef0d7d2",
                                                "sense_id": "329cbf5e-1b97-3027-8544-f809d8fe962d",
                                                "text": "Gone now are the \"high-minded\" style, the \"adapted from literature\" feel, the voice-over narration, and the abstract conversationing about ideas, values..."
                                            },
                                            {
                                                "example_id": "fb9f2a69-892d-44de-be7c-4d90947bcf0a",
                                                "sense_id": "329cbf5e-1b97-3027-8544-f809d8fe962d",
                                                "text": "...he has breakfasted me, dined me, conversationed me, absolutely caressed me. He has been really most kind and paternal..."
                                            },
                                            {
                                                "example_id": "185f9472-e987-46b0-9dea-f4194da76f23",
                                                "sense_id": "329cbf5e-1b97-3027-8544-f809d8fe962d",
                                                "text": "After all this conversationing, Scottie, my usual dance partner, was getting antsy and wanted to dance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d08695d-1533-442c-9d23-aeb5c34a0588",
                        "source_entry_id": "06908aa7-6879-3a1c-bbbe-71db726040bf",
                        "source_sense_id": "9e16aafd-5c6a-3908-896f-937cf42f9a45",
                        "target_lang_word": "Konversation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konversation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2a27dcc3-1c32-310b-a6d6-a9c60e11e309",
                                        "entry_id": "11dbd3bf-afcb-367c-be79-ad684c6ff6c3",
                                        "glosses": [
                                            "leichte Unterhaltung zwecks Geselligkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40149f8d-4026-4c19-807b-e05ef3ea2429",
                                                "sense_id": "2a27dcc3-1c32-310b-a6d6-a9c60e11e309",
                                                "text": "Wir haben nur ein bisschen Konversation getrieben."
                                            },
                                            {
                                                "example_id": "65254855-70cd-484a-a2ac-22c62061db4d",
                                                "sense_id": "2a27dcc3-1c32-310b-a6d6-a9c60e11e309",
                                                "text": "„Für Konversation war es schon zu spät geworden.“"
                                            },
                                            {
                                                "example_id": "5c3d0c64-9a06-44db-ac60-c01225a5d7b3",
                                                "sense_id": "2a27dcc3-1c32-310b-a6d6-a9c60e11e309",
                                                "text": "„Keenan (1974) beobachtete die Konversationen ihrer Zwillingssöhne (2;9) und fand, daß sie – entgegen der durch Piaget beeinflußten Ansicht – sehr wohl im Stande waren, einen fortdauernden Dialog zu führen und auf die wechselseitigen Äußerungen einzugehen.“"
                                            },
                                            {
                                                "example_id": "5d162760-42c3-49d1-b26c-d9fe6622088b",
                                                "sense_id": "2a27dcc3-1c32-310b-a6d6-a9c60e11e309",
                                                "text": "„Diese leichte Konversation unterhielt uns bis zum Nachtisch, einer katalanischen Creme mit Zimt; dann tranken wir einen Anisschnaps.“"
                                            },
                                            {
                                                "example_id": "309d71c4-58b6-4d3b-854f-f6773a70b7fd",
                                                "sense_id": "2a27dcc3-1c32-310b-a6d6-a9c60e11e309",
                                                "text": "„Das ist eine Konversation für das neunzehnte Jahrhundert, als Tod noch die Konsequenz von Krankheit war, – nicht von Bomben, Artillerie und politischer und Vernichtungsmoral.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57e25819-b1cb-4413-89c8-b1818d303fd3",
                        "source_entry_id": "06908aa7-6879-3a1c-bbbe-71db726040bf",
                        "source_sense_id": "9e16aafd-5c6a-3908-896f-937cf42f9a45",
                        "target_lang_word": "Gespräch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gespräch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cec7e8b4-7dc0-31c0-82ff-f363003a71c3",
                                        "entry_id": "6c6169ee-1709-31ca-8eaf-d7e6d552007f",
                                        "glosses": [
                                            "mündliche Kommunikation zwischen zwei oder mehreren Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df8eadce-2361-4d91-9b41-8022f20eb4e2",
                                                "sense_id": "cec7e8b4-7dc0-31c0-82ff-f363003a71c3",
                                                "text": "Sie führten ein langes Gespräch."
                                            },
                                            {
                                                "example_id": "ff584a19-dc69-4fc2-b01e-c5ac01f71c4d",
                                                "sense_id": "cec7e8b4-7dc0-31c0-82ff-f363003a71c3",
                                                "text": "„Das Kleingruppengespräch ist die prototypische Form des Gesprächs.“"
                                            },
                                            {
                                                "example_id": "6f160d11-e16e-487c-8156-3b59e48410ad",
                                                "sense_id": "cec7e8b4-7dc0-31c0-82ff-f363003a71c3",
                                                "text": "„Das Gespräch hat stattgefunden, als Dincklage noch nicht in Erscheinung getreten war.“"
                                            },
                                            {
                                                "example_id": "a10d49f3-1e45-4825-838f-aa7f32801bab",
                                                "sense_id": "cec7e8b4-7dc0-31c0-82ff-f363003a71c3",
                                                "text": "„Alle drei, so soll man es wohl deuten, sind hier am Rheinufer miteinander vereint, in einem Gespräch oder Schweigen.“"
                                            },
                                            {
                                                "example_id": "d2fe25c5-8c63-49a1-9ddb-4403a4dc9012",
                                                "sense_id": "cec7e8b4-7dc0-31c0-82ff-f363003a71c3",
                                                "text": "„Es kam weder ein sinnvolles Gespräch noch eine belanglose Plauderei in Gang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d9ef72f-65bc-3f42-a9a3-6ef5adf36819",
                                        "entry_id": "6c6169ee-1709-31ca-8eaf-d7e6d552007f",
                                        "glosses": [
                                            "Form gesprochener Sprache, bei der das Rederecht wechselt (Sprecherwechsel)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c501ab4-da12-44a4-9d70-59d7d9c64119",
                                                "sense_id": "3d9ef72f-65bc-3f42-a9a3-6ef5adf36819",
                                                "text": "„Das Gespräch ist die Grundeinheit menschlicher Rede.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b4a6cca-26bc-4e30-a3c7-a038a9211841",
                        "source_entry_id": "06908aa7-6879-3a1c-bbbe-71db726040bf",
                        "source_sense_id": "9e16aafd-5c6a-3908-896f-937cf42f9a45",
                        "target_lang_word": "conversation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conversation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d69ebc1-2010-3b1d-94f1-b73e9ed355cd",
                                        "entry_id": "937f9afe-b7b5-379e-832d-b2a9d06c7087",
                                        "glosses": [
                                            "Action pour deux ou plusieurs personnes de discuter ensemble dans une optique dénuée de confrontation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55c21cb1-cc70-4e18-a75d-ce81bb1b7696",
                                                "sense_id": "6d69ebc1-2010-3b1d-94f1-b73e9ed355cd",
                                                "text": "Bien écouter et bien répondre est une des plus grandes perfections que l’on puisse avoir dans la conversation."
                                            },
                                            {
                                                "example_id": "d9313a8a-ce9b-4530-bf58-2504c65874a1",
                                                "sense_id": "6d69ebc1-2010-3b1d-94f1-b73e9ed355cd",
                                                "text": "Une conversation s'établit alors entre la marquise et le jeune homme, qui, suivant l'usage, abordèrent en un moment une multitude de sujets : la peinture, la musique, la littérature, la politique, les hommes, les événements et les choses."
                                            },
                                            {
                                                "example_id": "820fe8ad-8a2f-4624-bdcc-1821b3cdbdef",
                                                "sense_id": "6d69ebc1-2010-3b1d-94f1-b73e9ed355cd",
                                                "text": "Nous parlions comme on parle dans une barque, sur une rivière. Il y a une conversation de rivière et une conversation de terrasse, une autre de salon, une autre encore, de voiture."
                                            },
                                            {
                                                "example_id": "448c90ca-61ab-4d34-9d4f-b2bff654af59",
                                                "sense_id": "6d69ebc1-2010-3b1d-94f1-b73e9ed355cd",
                                                "text": "De mon côté, j'étais le genre de conversationniste qu'il lui fallait. Adepte d'une conversation théâtrale, tout ouïe et de l'instant, une conversation divertissante mais, plus encore, divertissable, une conversation qui se nourrissait de la conversation, une conversation qui écoutait la conversation."
                                            },
                                            {
                                                "example_id": "334c66ba-e131-43f0-b68c-9595c56a6c29",
                                                "sense_id": "6d69ebc1-2010-3b1d-94f1-b73e9ed355cd",
                                                "text": "À 19 h 20, après avoir dîné, les Washington ont entamé une partie de mistigri en écoutant de vieux succès de l'ère doo-wop. La conversation, en partie masquée par la musique, était banale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d60388a-7385-36da-a679-d7b95e91bc8a",
                                        "entry_id": "937f9afe-b7b5-379e-832d-b2a9d06c7087",
                                        "glosses": [
                                            "À l'échelle d'une société, échange de points de vue respectueux et convenus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1355d920-9092-42c6-8296-7d332180b8c9",
                                                "sense_id": "2d60388a-7385-36da-a679-d7b95e91bc8a",
                                                "text": "Mot cher à Justin Trudeau, à Mélanie Joly et aux animateurs de Radio-Canada. La conversation n'est pas une discussion amicale, mais un geste métaphorique. Les grands enjeux sont abordés de la manière la plus désincarnée possible, de façon soft, dans un langage détaché de la réalité. C'est en fait l'envers d'une discussion réelle; c'est parler pour ne rien dire d'un manière policée. À côté d'une conversation, les consignes enregistrées diffusées dans les aéroports ont l'air de débats endiablés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bef4abb-a6af-3148-9f96-d4afe2651563",
                                        "entry_id": "937f9afe-b7b5-379e-832d-b2a9d06c7087",
                                        "glosses": [
                                            "Meuble constitué de deux fauteuils en sens inverse destinés à converser. Lorsque ceux-ci sont attachés entre eux en forme de S, il s'agit d'un confident, lequel peut d'ailleurs comprendre aussi trois sièges et se nomme alors un indiscret."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b6ec862b-d847-369b-8947-a3fc9548c4a6",
                                        "entry_id": "937f9afe-b7b5-379e-832d-b2a9d06c7087",
                                        "glosses": [
                                            "Échange d’informations entre au moins deux individus au travers des canaux IRC."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf017d4d-5874-4ac0-893a-285c82917cbb",
                                                "sense_id": "b6ec862b-d847-369b-8947-a3fc9548c4a6",
                                                "text": "Manon aime bien discuter avec ses amis le soir sur son ordinateur. Elle connait bien comme eux tous les lol, mdr et autres smileys/émoticônes. Elle utilise Windows Live Messenger et arrive à suivre une dizaine de conversations sans problème."
                                            },
                                            {
                                                "example_id": "4dcf6113-081f-4f2a-b6d8-83e484d05378",
                                                "sense_id": "b6ec862b-d847-369b-8947-a3fc9548c4a6",
                                                "text": "Au vu de la consternante banalité des conversations électroniques sur le réseau social, un constat s'impose : le facebookien rejoint dans le néant de l'humain les candidats des émissions de téléréalité. L'exhibitionnisme du vide y triomphe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b2aa162-714f-3162-8d46-19addfb6abfa",
                                        "entry_id": "937f9afe-b7b5-379e-832d-b2a9d06c7087",
                                        "glosses": [
                                            "échange entre une machine et une personne qui lui répond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e2d2ddc-6fdf-40ef-961b-14faced0990b",
                                                "sense_id": "2b2aa162-714f-3162-8d46-19addfb6abfa",
                                                "text": "Salesforce définit une conversation comme l'envoi par un client d'au moins un message ou la sélection d'au moins une option de menu ou d'un choix autre que « mettre fin à la discussion » au cours d'une période de 24 heures. Ce modèle tarifaire à la conversation peut inclure de nombreuses interactions entre un client et Agentforce, explique Ryan Shellack, directeur principal du marketing des produits d'IA chez Salesforce. L'éditeur se concentre sur la tarification à l'usage, avec une seule licence d'administrateur nécessaire, ajoute-t-il."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
