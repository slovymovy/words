                        ]
                    },
                    {
                        "translation_id": "f7da1c00-8947-43ac-a169-7807599019a7",
                        "source_entry_id": "fb1e6725-3ab3-3af4-ba57-88e5e6f23873",
                        "target_lang_word": "Atlantik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atlantik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                        "entry_id": "7d794cc7-232e-3814-bf05-e0517d9c9597",
                                        "glosses": [
                                            "Ozean zwischen Afrika, Europa, Nordamerika und Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fda425c-2da5-4314-b584-e3a9b06bcb3b",
                                                "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                                "text": "Mit der Beherrschung des Atlantiks begann die Globalisierung."
                                            },
                                            {
                                                "example_id": "5fb1d6c9-0137-47e0-8bb3-2f39dffc7bca",
                                                "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                                "text": "„Sechs Wochen waren damals auf dem Atlantik eine lange Zeit, wenn die nächsten sechs Stunden oder gar sechs Minuten ihnen die Katastrophe bringen konnten.“"
                                            },
                                            {
                                                "example_id": "4db842d5-063f-44e6-acbf-54df2295373b",
                                                "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                                "text": "„Seit Jahrzehnten schon schaffte man ständig Nachschub über den Atlantik und den Indischen Ozean in die älteren Kolonien.“"
                                            },
                                            {
                                                "example_id": "1c3ba32b-48f4-4694-933a-e92b9663a853",
                                                "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                                "text": "„Während der kurzen Regenzeit wird das Tal von mitreißenden Regenfluten überschwemmt, die sich donnernd in den Atlantik ergießen.“"
                                            },
                                            {
                                                "example_id": "1a7ff1c2-305a-484a-8046-b109084b1d7a",
                                                "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                                "text": "„Die Sterne wanderten langsam in ihren gekrümmten Bögen über den Himmel, und der Andere trieb unmerklich im Atlantik nirgendwohin.“"
                                            },
                                            {
                                                "example_id": "5de052f7-9819-4109-8241-5b22c6ee4c28",
                                                "sense_id": "a821e95e-7688-30e1-9c43-f99241ca5c6c",
                                                "text": "„An den immergrünen Hängen der erkalteten Vulkane grasen die schönsten Kühe des Atlantik und dort befindet sich Europas einzige Teeplantage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "865d7540-1359-4c8b-8687-b9b90093e2e2",
                        "source_entry_id": "fb1e6725-3ab3-3af4-ba57-88e5e6f23873",
                        "target_lang_word": "Atlantique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Atlantique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c5fc97b-d320-30ce-bfa0-05dbc41e1121",
                                        "entry_id": "4b7596e0-04cd-3b98-b5a1-f74612af3b90",
                                        "glosses": [
                                            "Océan qui s'étend de l’océan Arctique au nord jusqu’à l'Antarctique, bordé à l’ouest par les Amériques, et à l’est par l’Europe, l’Afrique et l’océan Indien (selon l'Organisation hydrographique internationale)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba37636-5a4f-4e6e-8fe4-5ae66888760b",
                                                "sense_id": "0c5fc97b-d320-30ce-bfa0-05dbc41e1121",
                                                "text": "Après avoir laissé derrière nous les Orcades, nous entrâmes en plein Atlantique, et la mer s’enfla prodigieusement."
                                            },
                                            {
                                                "example_id": "4e2f61bf-4707-42cc-b361-602ae6c35b11",
                                                "sense_id": "0c5fc97b-d320-30ce-bfa0-05dbc41e1121",
                                                "text": "Quatre ans auparavant, sur un yacht de vingt tonneaux, il avait traversé l’Atlantique de Nouvelle-Écosse à Cowes en vingt-deux jours, ce qui constitue un record pour une embarcation de ce tonnage."
                                            },
                                            {
                                                "example_id": "629374cb-3e91-4be7-9d6b-3ceb3869cfd0",
                                                "sense_id": "0c5fc97b-d320-30ce-bfa0-05dbc41e1121",
                                                "text": "La mer des Sargasses est formées d’algues brunes, appelées sargasses, arrachées aux côtes du Golfe du Mexique et qui sont portées par les courants jusqu’au milieu de l’Atlantique."
                                            },
                                            {
                                                "example_id": "b90ec7a2-25e4-4f71-b13e-0c8ed4d55c9a",
                                                "sense_id": "0c5fc97b-d320-30ce-bfa0-05dbc41e1121",
                                                "text": "Mon père, ayant pris l’auto, était parti de bonne heure pour La Rochelle. Nous deux, la route de Royan en side-car, comme chaque matin. Au port, j’ai détaché mon bateau, neuf heures sonnaient quand nous doublions la jetée. Béatitude bleue de l’Atlantique ; la brise du large nous fit croiser doucement dans l’estuaire."
                                            },
                                            {
                                                "example_id": "4390c584-e22d-446f-98e7-665b999d1c1b",
                                                "sense_id": "0c5fc97b-d320-30ce-bfa0-05dbc41e1121",
                                                "text": "[…], ils achetèrent aussi ses actions du canal de Suez au khédive Isma’il, afin de contrôler la nouvelle voie d’eau reliant la mer Rouge et l’océan Indien à la Méditerranée et à l’Atlantique."
                                            },
                                            {
                                                "example_id": "cb0656d4-83f1-4aed-a98b-4eec4cd54eb6",
                                                "sense_id": "0c5fc97b-d320-30ce-bfa0-05dbc41e1121",
                                                "text": "On ne peut imaginer le Mexique sans l’ombre portée, omniprésente, du grand frère américain. Les deux nations partagent une « impossible frontière » de plus de 3 000 km, pour l'essentiel de déserts, entre le Pacifique et l’Atlantique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bb27d35-00e4-3d2b-8455-e06b88c60e30",
                                        "entry_id": "4b7596e0-04cd-3b98-b5a1-f74612af3b90",
                                        "glosses": [
                                            "Région du Canada regroupant les provinces du Nouveau-Brunswick, de la Nouvelle-Écosse, de l'Île-du-Prince-Édouard et de Terre-Neuve-et-Labrador."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e6134f8-40a6-419e-969d-1a390c39dfb2",
                                                "sense_id": "5bb27d35-00e4-3d2b-8455-e06b88c60e30",
                                                "text": "Environnement Canada a aussi diffusé une série d'avertissements météorologiques pour la région de l'Atlantique, où la tempête hivernale devrait entraîner un mélange de neige, de pluie, de pluie verglaçante et de vents forts mardi et mercredi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b8e002e-5200-3f91-b54f-82b9e319d5a8",
                                        "entry_id": "4b7596e0-04cd-3b98-b5a1-f74612af3b90",
                                        "glosses": [
                                            "Département du Bénin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
