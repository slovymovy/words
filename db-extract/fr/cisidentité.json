                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9160f2c3-71af-4333-a33b-b0557ae9949f",
                        "source_entry_id": "6c7f3411-4f62-33a3-8d79-b4d3e679bf4c",
                        "source_sense_id": "0d9d51ea-6d35-3690-a6d2-72a1547a89cc",
                        "target_lang_word": "cisness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cisness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30461765-0a7b-3caa-a84a-661011c8373f",
                                        "entry_id": "aa08a38f-5fea-3ba7-8716-fcfd319d8eea",
                                        "glosses": [
                                            "The quality of being cisgender."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c4b9f3a-3ac2-47d1-aa81-9acef7f65a2d",
                                                "sense_id": "30461765-0a7b-3caa-a84a-661011c8373f",
                                                "text": "What's more, the assumed cisness of children during that century means that alongside Val and the other trans children in this book were countless, unnamed others whose experience is still hidden from view."
                                            },
                                            {
                                                "example_id": "3cd9567a-eb49-4a38-8a2f-eb31353eb393",
                                                "sense_id": "30461765-0a7b-3caa-a84a-661011c8373f",
                                                "text": "Cisgender is assumed to be the “default” identity; mainstream culture is saturated with cisness and cisnormativity."
                                            },
                                            {
                                                "example_id": "f331efad-f057-447c-a7b9-9454b471c45d",
                                                "sense_id": "30461765-0a7b-3caa-a84a-661011c8373f",
                                                "text": "But inevitably, my cisness crumbled, and with it, my belief in the usefulness of gender itself."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
