                        "glosses": [
                            "Apporter de l’iode à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73cd9c73-0caa-4c5d-a779-cec929917a97",
                                "sense_id": "ef3e3b04-8fd5-3b76-9ac3-110615cffe2f",
                                "text": "Mettre une plaque collodionnée tout la nuit pour iodiser."
                            },
                            {
                                "example_id": "d0e74f00-bd92-4845-930d-6680d0152d5c",
                                "sense_id": "ef3e3b04-8fd5-3b76-9ac3-110615cffe2f",
                                "text": "C'est pourquoi, au lieu d'être japonisé, il est préférable de iodiser sa thyroide."
                            },
                            {
                                "example_id": "72dd971b-6c61-493b-b3fb-b0399d865227",
                                "sense_id": "ef3e3b04-8fd5-3b76-9ac3-110615cffe2f",
                                "text": "Enfin un long weekend ensoleillé qui nous a permis de partir s'iodiser à la mer, direction Narbonne Plage."
                            }
