                        ]
                    },
                    {
                        "translation_id": "6f671753-b883-4fb1-813b-da55597e00ea",
                        "source_entry_id": "ca71e91e-9e92-31dd-962b-f7bdf58f41af",
                        "source_sense_id": "174ef05e-f056-33f9-9bf6-faf3cbfdde7b",
                        "target_lang_word": "Rekursivität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rekursivität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d378be17-bf7e-3ff6-927f-c4d42a476456",
                                        "entry_id": "38a14e34-4043-38d7-95c9-5461a7610631",
                                        "glosses": [
                                            "Eigenschaft einer Grammatik, mit dort formulierten Regeln (unendlich viele) Sätze bilden zu können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af77c8b-92c4-4ee3-81d7-8029790b6f5d",
                                                "sense_id": "d378be17-bf7e-3ff6-927f-c4d42a476456",
                                                "text": "„Dieses zentrale Prinzip der Sprache wird technisch genauer als «Rekursivität» gefaßt. Es handelt sich dabei um die Möglichkeit, eine (syntaktische) Regel immer wieder anzuwenden, so daß unendlich viele und unendlich lange Sätze entstehen können.“"
                                            },
                                            {
                                                "example_id": "a09efb2d-a8b2-423e-b5a3-1710e92d4aef",
                                                "sense_id": "d378be17-bf7e-3ff6-927f-c4d42a476456",
                                                "text": "„Hier ist S unter NP Quelle von Rekursivität, obwohl Regel (11) nicht in dem oben definierten Sinne rekursiv ist: Es erscheint nicht rechts und links vom Pfeil in einundderselben Regel dasselbe Symbol.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fc1516a2-c44a-39f4-adf7-404ef05ed02f",
                                        "entry_id": "38a14e34-4043-38d7-95c9-5461a7610631",
                                        "glosses": [
                                            "Rückbezüglichkeit einer Handlung, eines Verhaltens"
                                        ],
                                        "tags": [
                                            "Management",
                                            "Kybernetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24bbffaa-36f8-483f-aec7-b40fed4b53a5",
                                                "sense_id": "fc1516a2-c44a-39f4-adf7-404ef05ed02f",
                                                "text": "„Eine weitere und aus konstruktivistischen Perspektiven zentrale Möglichkeit ist Rekursivität (Rückbezüglichkeit), nach denen Gesetze und Randbedingungen von dem Beobachteten abhängen können.“"
                                            },
                                            {
                                                "example_id": "aacfbe9e-a8db-48e8-ba4e-f06f353b970d",
                                                "sense_id": "fc1516a2-c44a-39f4-adf7-404ef05ed02f",
                                                "text": "„Kommunikationen werden weiterhin geprägt durch Rekursivität: Das Subjekt steht nicht mehr der Gesellschaft oder dem sozialen System gegenüber, sondern ist Teil von beidem.“"
                                            },
                                            {
                                                "example_id": "ccd9663e-83f9-4b97-bcf4-375c66557935",
                                                "sense_id": "fc1516a2-c44a-39f4-adf7-404ef05ed02f",
                                                "text": "„Autopoietisch ausgedrückt, sagt er: Wir sind, weil wir informieren, kommunizieren und verstehen (Zirkularität). Und weil wir dies tun, entsteht Rekursivität (Rückbezüglichkeit), d. h. wir lernen voneinander, ent-wickeln uns und geben unser Wissen und unsere Fähigkeiten erzieherisch und genetisch an die nächste Generation weiter.“"
                                            },
                                            {
                                                "example_id": "cab56c99-f4ba-41cc-aa2d-549bc32bc636",
                                                "sense_id": "fc1516a2-c44a-39f4-adf7-404ef05ed02f",
                                                "text": "„Die neuen Ordnungszustände wirken im Sinne einer zirkulären Kausalität oder Rekursivität wiederum auf das System zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
