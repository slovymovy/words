                "senses": [
                    {
                        "sense_id": "1aec30ba-f22c-3589-9a9e-2d3bc6e3db42",
                        "entry_id": "c0ecedbd-6ed1-3d10-b29d-52e3a5d0a3aa",
                        "glosses": [
                            "A cheat or swindle; a rip-off."
                        ],
                        "tags": [
                            "derogatory",
                            "offensive",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "b72504a1-9671-4f0b-abcc-4e9620f11a6f",
                                "sense_id": "1aec30ba-f22c-3589-9a9e-2d3bc6e3db42",
                                "text": "Why do we have to buy this new edition of the textbook when there’s almost no difference between it and the previous one? What a gyp!"
                            }
                        ]
                    },
                    {
                        "sense_id": "a5c5279e-346e-3ce3-a613-3e862c59f29c",
