                "senses": [
                    {
                        "sense_id": "aea9afee-f4dd-376d-a3b8-45c71930351e",
                        "entry_id": "75cb0e20-d458-3048-a1c1-ac32cf43e8a1",
                        "glosses": [
                            "Relatif à la Micronésie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db7afada-17a4-4754-a6f4-65e797fd1901",
                                "sense_id": "aea9afee-f4dd-376d-a3b8-45c71930351e",
                                "text": "Le palau est loin d'être un cas isolé, même parmi les langues austronésiennes et plus spécifiquement par rapport aux langues micronésiennes dont il est le voisin géographique : yap, kusaïen, mokil (dialecte ponapéen), mais il est une des langues de la famille où ces faits sont les plus frappants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6d96d09-418d-4adf-8dad-dfdc87b95085",
                        "source_entry_id": "75cb0e20-d458-3048-a1c1-ac32cf43e8a1",
                        "source_sense_id": "aea9afee-f4dd-376d-a3b8-45c71930351e",
                        "target_lang_word": "Micronesian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Micronesian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c44dd58-5f25-331f-9690-f620250b6c64",
                                        "entry_id": "bb860a2a-595c-378b-9c3b-c46727f22470",
                                        "glosses": [
                                            "A person from Micronesia or of Micronesian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e295f3a-2486-44ad-bfd7-8bcec04af3dd",
                                                "sense_id": "2c44dd58-5f25-331f-9690-f620250b6c64",
                                                "text": "The researchers also concluded that the genetic data showed that the Polynesians and Micronesians were most closely related to Taiwan Aborigines and East Asians."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Micronesian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "038f0364-d5ec-3838-95ca-9e2e0f8a6d96",
                                        "entry_id": "7f80b492-fff1-3d87-9e53-4acccdd51dc4",
                                        "glosses": [
                                            "Of, from or pertaining to Micronesia or the Micronesian people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc21e98b-2eee-4cdb-9c64-6fe1906f17ae",
                                                "sense_id": "038f0364-d5ec-3838-95ca-9e2e0f8a6d96",
                                                "text": "He felt having a Micronesian navigator meant he needed a pureblooded Polynesian, preferably a Hawaiian, as captain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
