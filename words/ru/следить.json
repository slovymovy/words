                                "target_lang_sense_clarification": "track movement with eyes"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "observar",
                                "target_lang_sense_clarification": "mirar fijamente con atención"
                            },
                            {
                                "target_lang_word": "seguir con la mirada",
                                "target_lang_sense_clarification": "acompañar el movimiento con los ojos"
                            }
                        ],
                        "fr": [
