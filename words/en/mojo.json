                },
                {
                    "sense_id": "6d555b1b-120d-3328-8211-3bb8b8628f13",
                    "sense_definition": "A magic spell or hex.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The folklore described a powerful <w>mojo</w> meant to ward off enemies.",
                            "target_lang_translations": {
                                "ru": "В фольклоре описывалось могущественное <w>заклинание</w>, призванное отгонять врагов."
                            }
