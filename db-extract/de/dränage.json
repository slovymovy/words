                ],
                "senses": [
                    {
                        "sense_id": "8c2b2c0b-82f8-3109-9dba-8a6aae1d24c1",
                        "entry_id": "d2d60fe2-7e89-33c2-804f-5aca0d298434",
                        "glosses": [
                            "System von Gräben, Rigolen oder Rohren zur Entwässerung des Bodens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3794804-8bb0-4fbe-840c-ae46c37d439a",
                                "sense_id": "8c2b2c0b-82f8-3109-9dba-8a6aae1d24c1",
                                "text": "Eine Drainage bzw. Dränage bezeichnet Maßnahmen und technische Einrichtungen, die der Entwässerung des Bodens in einem bestimmten Bereich dienen."
                            },
                            {
                                "example_id": "ca56235d-a8db-478e-8644-2550ac0108bc",
                                "sense_id": "8c2b2c0b-82f8-3109-9dba-8a6aae1d24c1",
                                "text": "Eine Dränage gehört ebenfalls zum System, wenn an den Fußballplatz Ansprüche gestellt werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eb6d9cd8-4741-34a1-97eb-fccf353da076",
                        "entry_id": "d2d60fe2-7e89-33c2-804f-5aca0d298434",
                        "glosses": [
                            "therapeutische Ableitung einer pathologischen Ansammlung von Flüssigkeit oder Gas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "264dba8e-0086-47f9-a9ee-f8c3b3ab883e",
                                "sense_id": "eb6d9cd8-4741-34a1-97eb-fccf353da076",
                                "text": "Bei einer Dränage, auch Drainage geschrieben, handelt es sich um eine medizinische Methode zur Ableitung von Wundflüssigkeiten aus Körperhöhlen, Wunden oder Abszessen."
                            },
                            {
                                "example_id": "e0821291-b84e-439f-8d4b-56957f53f037",
                                "sense_id": "eb6d9cd8-4741-34a1-97eb-fccf353da076",
                                "text": "Nach Reinigung der Wunden und Abklingen der Allgemeinsymptome erfolgt eine lockere Sekundärnaht mit ausreichender Dränage."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5b93c517-abd5-32bb-8ef6-e30fb68439be",
                        "entry_id": "d2d60fe2-7e89-33c2-804f-5aca0d298434",
                        "glosses": [
                            "Verdrängung von Wasser durch die besondere Beschaffenheit von Reifen und Fahrbahn"
                        ],
                        "tags": [
                            "Fahrtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "54aa7d63-693e-4b35-bcb9-c275307b6c87",
                                "sense_id": "5b93c517-abd5-32bb-8ef6-e30fb68439be",
                                "text": "Das Reifenprofil fungiert auf nasser Fahrbahn als Dränage, da über die Profilrillen das vom Reifendruck verdrängte Wasser aufgenommen und abgeleitet wird."
                            },
                            {
                                "example_id": "812c219c-a34a-4c24-935f-7e5745b15037",
                                "sense_id": "5b93c517-abd5-32bb-8ef6-e30fb68439be",
                                "text": "Außerdem muss eine ausreichende Dränage für Luft und Wasser an der Oberfläche vorhanden sein."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a35191a-2ae5-4e00-916a-55a449bd4e67",
                        "source_entry_id": "d2d60fe2-7e89-33c2-804f-5aca0d298434",
                        "source_sense_id": "8c2b2c0b-82f8-3109-9dba-8a6aae1d24c1",
                        "source_sense_description": "System von Gräben, Rigolen oder Rohren zur Entwässerung des Bodens",
                        "target_lang_word": "drainage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drainage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12cadd84-2310-303b-8615-b283526f8f56",
                                        "entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                                        "glosses": [
                                            "A natural or artificial means for the removal of fluids from a given area by its draining away."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f677bd-6796-4fcf-b1d6-3d7843e0accb",
                                                "sense_id": "12cadd84-2310-303b-8615-b283526f8f56",
                                                "text": "It should move NR away from previous examples of repairs that have treated the symptoms (fixing the landslip) but not fixed the underlying cause (poor drainage), with the result that a second slip followed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89583c24-9dab-30d1-8d1d-7ff36c3d5ef4",
                                        "entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                                        "glosses": [
                                            "A system of drains."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f9c99cb-bd03-3d5b-808c-099be30fb7d8",
                                        "entry_id": "8c873e0d-01f6-3ae2-92d7-e1ffc1529ff9",
                                        "glosses": [
                                            "A downward wind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ebc4d8-22f6-404d-81a0-a624ab2dda2e",
                                                "sense_id": "6f9c99cb-bd03-3d5b-808c-099be30fb7d8",
                                                "text": "In the forward part of the cyclone, drainage katabasis is checked; but its highest intensity is observed in the rear part of the cyclone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d761cbe7-f4cc-4f78-8bd5-ea34ef003a21",
                        "source_entry_id": "d2d60fe2-7e89-33c2-804f-5aca0d298434",
                        "source_sense_id": "8c2b2c0b-82f8-3109-9dba-8a6aae1d24c1",
                        "source_sense_description": "System von Gräben, Rigolen oder Rohren zur Entwässerung des Bodens",
                        "target_lang_word": "drainage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drainage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c0307fd-68e1-3b97-901b-9c13b20c39d4",
                                        "entry_id": "a281eadf-f493-3db8-8c9a-0fd76b71f70b",
                                        "glosses": [
                                            "Action de drainer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e86ccf91-baef-4cce-97d1-b022cfdce7d9",
                                                "sense_id": "6c0307fd-68e1-3b97-901b-9c13b20c39d4",
                                                "text": "Tous les bons effets du drainage sont si bien appréciés que la plus grande partie des terrains argileux, à sous-sol compacte et humide, du département ont été drainés, et partout les cultivateurs ont eu à se louer de opération."
                                            },
                                            {
                                                "example_id": "0949a2e4-dcbb-4273-be47-d5dccb592863",
                                                "sense_id": "6c0307fd-68e1-3b97-901b-9c13b20c39d4",
                                                "text": "Habituellement les terrains mouilleux qu’on veut planter sont assainis au préalable et le creusement des fossés de drainage sert à faire des buttes ou des remblais."
                                            },
                                            {
                                                "example_id": "cd3aec10-6818-42e9-b605-7b02906222ff",
                                                "sense_id": "6c0307fd-68e1-3b97-901b-9c13b20c39d4",
                                                "text": "Le seul exutoire des eaux du marais étant le Petit-Morin au pont de Saint-Prix, il apparaît évident que l'entretien de cette rivière (faucardage et curage) doit être régulier, sinon le drainage serait insuffisant et l'eau stagnerait sur les terres voisines, rendant ainsi toute culture impossible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb435e36-2f2e-35c3-a574-efaa5108efdb",
                                        "entry_id": "a281eadf-f493-3db8-8c9a-0fd76b71f70b",
                                        "glosses": [
                                            "Le drainage du rein."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e595cbba-4211-30ac-92e8-abd4e7672e35",
                                        "entry_id": "a281eadf-f493-3db8-8c9a-0fd76b71f70b",
                                        "glosses": [
                                            "Le drainage des capitaux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
