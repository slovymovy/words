                                        "entry_id": "592095c4-0a11-36ec-b998-7ce48a773aba",
                                        "glosses": [
                                            "zodiakalny gwiazdozbiór nieba północnego, w Polsce widoczny jesienią i zimą"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6aa9fc8-97b5-44c5-9deb-cb87227a31aa",
                                                "sense_id": "1eda0d01-ad7f-3afa-82e9-93ab33f2f391",
                                                "text": "Baran bywa w legendach identyfikowany z cudownym barankiem o złotym runie, na którym Fryksos i Helle uciekli do Kolchidy."
                                            },
                                            {
                                                "example_id": "1b09237b-44c6-4ecb-89ab-04b71fc7a59e",
                                                "sense_id": "1eda0d01-ad7f-3afa-82e9-93ab33f2f391",
                                                "text": "Najjaśniejszą gwiazdą w gwiazdozbiorze Barana jest Hamal."
                                            },
                                            {
                                                "example_id": "bab54182-0cc4-4dea-b5bb-484920e9e482",
                                                "sense_id": "1eda0d01-ad7f-3afa-82e9-93ab33f2f391",
                                                "text": "Konstelacja Barana góruje o północy w listopadzie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "05a17fe7-8c6d-3e0e-b757-a6da396c031f",
                                        "entry_id": "592095c4-0a11-36ec-b998-7ce48a773aba",
                                        "glosses": [
                                            "pierwszy znak zodiaku, w którym Słońce znajduje się od 21 marca do 19 (20) kwietnia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5418bca-2251-47e4-9325-d31f7e78e7b5",
                                                "sense_id": "05a17fe7-8c6d-3e0e-b757-a6da396c031f",
                                                "text": "Baran to jeden ze znaków zodiaku, który występuje po Rybach, a przed Bykiem."
                                            },
                                            {
                                                "example_id": "0bc3ea41-5880-455f-ae7f-3bf975272be9",
                                                "sense_id": "05a17fe7-8c6d-3e0e-b757-a6da396c031f",
                                                "text": "Pod koniec marca Słońce wchodzi w znak Barana."
                                            },
                                            {
                                                "example_id": "4fee7f01-f6b9-4c7e-a928-ab8ef19df219",
                                                "sense_id": "05a17fe7-8c6d-3e0e-b757-a6da396c031f",
                                                "text": "Wejściu Słońca w znak Barana (ok. 21 III) towarzyszy równonoc wiosenna."
                                            },
                                            {
                                                "example_id": "88f392d6-23c9-4cb1-856f-8281d984749b",
                                                "sense_id": "05a17fe7-8c6d-3e0e-b757-a6da396c031f",
                                                "text": "Baranem, jednym z wiosennych, ognistych i kardynalnych znaków zodiaku, rządzi planeta Mars."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Barań",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
